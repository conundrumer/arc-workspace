{
  "includeGitInstructions": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "P=\"$CLAUDE_PROJECT_DIR/tools/console/kill_note.py\"; [ -f \"$P\" ] || exit 0; python3 \"$P\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "P=\"$CLAUDE_PROJECT_DIR/tools/console/ref_note.py\"; [ -f \"$P\" ] || exit 0; python3 \"$P\""
          }
        ]
      }
    ]
  }
}
