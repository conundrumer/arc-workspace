    (NOT (&same_set.equal (:pattern Key))))
  (QUERY &q (&same_set.equal) (NOT (&left_only)) (&right_only))
  (gives &q))

(fragment (groups-overlap (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the first and the second relation hold a set of cells in common, and each holds a set that the other lacks."
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
