    (&right_ids.class (:a ?others) (:Id *Key))
    (&right_box.box (:key ?others) (:B *Box))
    (relative (:Base Box) (:X ?b) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&right_placed *Key *X_rel))
    (observed ((:observed Key) (:m X_rel))
      (&left_placed *Key *X_rel)))
  (QUERY &left_only
    (&left_ids.class (:Id *Key))
    (NOT (&same_set.equal (:observed Key))))
  (QUERY &right_only
    (&right_ids.class (:Id *Key))
    (NOT (&same_set.equal (:pattern Key))))
  (QUERY &q (&same_set.equal) (NOT (&left_only)) (&right_only))
  (gives &q))

(fragment (shapes-overlap (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the first and the second relation hold a shape of cells in common, up to a move, and each holds a shape that the other lacks."
