  (QUERY &right_placed
    (?S (?others *) (?b *))
    (&right_ids.class (:a ?others) (:Id *Key))
    (&right_box.box (:key ?others) (:B *Box))
    (relative (:Base Box) (:X ?b) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&right_placed *Key *X_rel))
    (observed ((:observed Key) (:m X_rel))
      (&left_placed *Key *X_rel)))
  (QUERY &q (&left_ids.class) (&right_ids.class) (NOT (&same_set.equal)))
  (gives &q))

(fragment (colors-agree-every (?L relation) (?S relation) (?p column ?L) (?x column ?L) (?q column ?S) (?y column ?S))
  "Whether, at each cell that both relations hold, they give the same set of colors, and some cell is held by both."
  (INIT &in_first Order
    (member ((:t ?p))
      (?L (?p *))))
  (INIT &in_second Order
    (member ((:t ?q))
      (?S (?q *))))
  (INIT &sets Inclusion
    (pattern ((:pattern ?q) (:m ?y))
      (?S (?q *) (?y *)))
    (observed ((:observed ?p) (:m ?x))
      (?L (?p *) (?x *))))
  (QUERY &shared
    (&in_first.minimal (:t *Cell))
    (&in_second.minimal (:t Cell)))
  (QUERY &same (&sets.equal (:observed *Cell) (:pattern Cell)))
  (QUERY &differ
    (&shared *Cell)
    (NOT (&same Cell)))
  (QUERY &q (&shared) (NOT (&differ)))
  (gives &q))

(fragment (colors-agree-none (?L relation) (?S relation) (?p column ?L) (?x column ?L) (?q column ?S) (?y column ?S))
  "Whether, at each cell that both relations hold, they give different sets of colors, and some cell is held by both."
  (INIT &in_first Order
    (member ((:t ?p))
      (?L (?p *))))
  (INIT &in_second Order
    (member ((:t ?q))
      (?S (?q *))))
  (INIT &sets Inclusion
    (pattern ((:pattern ?q) (:m ?y))
      (?S (?q *) (?y *)))
    (observed ((:observed ?p) (:m ?x))
      (?L (?p *) (?x *))))
  (QUERY &shared
    (&in_first.minimal (:t *Cell))
    (&in_second.minimal (:t Cell)))
  (QUERY &same (&sets.equal (:observed *Cell) (:pattern Cell)))
  (QUERY &q (&shared) (NOT (&same)))
  (gives &q))

(fragment (colors-agree-some (?L relation) (?S relation) (?p column ?L) (?x column ?L) (?q column ?S) (?y column ?S))
  "Whether, at some cells that both relations hold, they give the same set of colors, and at some others different sets."
  (INIT &in_first Order
    (member ((:t ?p))
      (?L (?p *))))
  (INIT &in_second Order
    (member ((:t ?q))
      (?S (?q *))))
  (INIT &sets Inclusion
    (pattern ((:pattern ?q) (:m ?y))
      (?S (?q *) (?y *)))
    (observed ((:observed ?p) (:m ?x))
      (?L (?p *) (?x *))))
  (QUERY &shared
    (&in_first.minimal (:t *Cell))
    (&in_second.minimal (:t Cell)))
  (QUERY &same (&sets.equal (:observed *Cell) (:pattern Cell)))
  (QUERY &differ
    (&shared *Cell)
    (NOT (&same Cell)))
  (QUERY &q (&same) (&differ))
  (gives &q))

(fragment (least-distance (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "The fewest eight-direction steps from a column's cells of the first relation to a column's cells of the second."
  (INIT &frame Frame
    (extent (A N)
      (?L (?a *))
      (frame_extent (:P ?a) *A *N)))
  (INIT &from_first CellDistance
    (node ((:P Free))
      (&frame.cell (:P *Free)))
    (source ((:P ?a))
      (?L (?a *)))
    (step ((:Delta V))
      (step_offset *V)))
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &near Order
    (member ((:t K))
      (&from_first.distance (:P *Cell) (:K *K))
      (&in_second.minimal (:t Cell)))
    (score ((:t K) (:S K))
      (&from_first.distance (:P *Cell) (:K *K))
      (&in_second.minimal (:t Cell))))
  (QUERY &q (&near.minimal (:t *K)))
  (gives &q))

(fragment (on-boundary (?R relation) (?S relation) (?p column ?R) (?b column ?S))
  "The first relation's rows whose cell is a cell of the second relation with a cardinal neighbor outside it."
  (INIT &set Boundary
    (cell ((:P ?b))
      (?S (?b *))))
  (QUERY &q (?R (*others ?R)) (&set.boundary (:P ?p)))
  (gives &q))

(fragment (neighbors-in (?R relation) (?S relation) (?p column ?R) (?b column ?S))
  "Each row of the first relation with each neighbor of its cell that the second relation holds."
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (QUERY &next
    (?R (?p *))
    (neighbor (:P ?p) (:D *Toward) (:Q *Cell))
    (&in_second.minimal (:t Cell)))
  (QUERY &q (?R (*others ?R)) (&next ?p (:Cell (*new Q ?R))))
  (gives &q))

(fragment (on-border (?R relation) (?S relation) (?p column ?R) (?b column ?S))
  "The first relation's rows whose cell is in a box of the second relation and on that box's border."
  (QUERY &met
    (?R (?p *))
    (?S (?b *))
    (inside (:A ?p) (:B ?b))
    (NOT (interior (:A ?p) (:B ?b))))
  (QUERY &q (?R (*others ?R)) (&met ?p))
  (gives &q))

(fragment (ray-meets (?R relation) (?S relation) (?p column ?R) (?d column ?R) (?b column ?S))
  "The first relation's rows whose ray from the cell toward the direction meets a cell of the second relation."
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (INIT &rays Ray
    (key ((?R (?p ^) (?d ^)))
      (source ((:P ?p))
        (?R ?p ?d)))
    (node ((:P Free))
      (&frame.cell (:P *Free))))
  (QUERY &met
    (?R (?p *) (?d *))
    (&rays.ray (:key ?p ?d) (:P *Hit) (:K *Step))
    (&in_second.minimal (:t Hit))
    (> Step 0))
  (QUERY &q (?R (*others ?R)) (&met ?p ?d))
  (gives &q))

(fragment (most-colors-under (?R relation) (?p column ?R) (?G grid))
  "The colors that a grid has most often under a relation's cells. Under a tie, every tied color."
  (INIT &cells Order
    (member ((:t ?p))
      (?R (?p *))))
  (INIT &counts Cardinality
    (key ((?G (:P *Under) (:Col ^Col)) (&cells.minimal (:t Under)))
      (member ((:m Cell))
        (?G (:Col Col) (:P *Cell))
        (&cells.minimal (:t Cell)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &q (&order.maximal (:t *Col)))
  (gives &q))

(fragment (boxes-holding (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "The first relation's rows whose box holds a cell of the second."
  (QUERY &met
    (?L (?a *))
    (?S (?b *))
    (inside (:A ?b) (:B ?a)))
  (QUERY &q (?L (*others ?L)) (&met ?a))
  (gives &q))

(fragment (same-shape (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "The keys of a relation whose cells are, up to a move, the cells of some key of a second relation."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &left_cells Order
    (member ((:t ?keys (:Cell ?a)))
      (?L (?keys *) (?a *))))
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?L (?keys *))))
  (INIT &left_box BoundingBox
    (key ((?L (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&left_cells.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &left_placed
    (?L (?keys *) (?a *))
    (&left_ids.class (:a ?keys) (:Id *Key))
    (&left_box.box (:key ?keys) (:B *Box))
    (relative (:Base Box) (:X ?a) *X_rel))
  (INIT &right_cells Order
    (member ((:t ?others (:Cell ?b)))
      (?S (?others *) (?b *))))
  (INIT &right_ids Quotient
    (equivalent ((:a ?others) (:b ?others))
      (?S (?others *))))
  (INIT &right_box BoundingBox
    (key ((?S (?others ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&right_cells.minimal (:t ?others (:Cell *Cell))))))
  (QUERY &right_placed
    (?S (?others *) (?b *))
    (&right_ids.class (:a ?others) (:Id *Key))
    (&right_box.box (:key ?others) (:B *Box))
    (relative (:Base Box) (:X ?b) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&right_placed *Key *X_rel))
    (observed ((:observed Key) (:m X_rel))
      (&left_placed *Key *X_rel)))
  (INIT &matched Cardinality
    (key ((?L (?keys ^)) (&whole ^Whole) (&left_ids.class (:a ?keys) (:Id *Key)) (&same_set.equal (:observed Key)))))
  (QUERY &q (?L (?keys *)) (&matched.size (:key ?keys)))
  (gives &q))

(fragment (same-shape-d4 (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "The keys of a relation whose cells are, up to a move, a rotation or a reflection, the cells of some key of a second relation."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &left_cells Order
    (member ((:t ?keys (:Cell ?a)))
      (?L (?keys *) (?a *))))
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?L (?keys *))))
  (INIT &left_box BoundingBox
    (key ((?L (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&left_cells.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &left_placed
    (?L (?keys *) (?a *))
    (&left_ids.class (:a ?keys) (:Id *Key))
    (&left_box.box (:key ?keys) (:B *Box))
    (relative (:Base Box) (:X ?a) *X_rel))
  (INIT &right_cells Order
    (member ((:t ?others (:Cell ?b)))
      (?S (?others *) (?b *))))
  (INIT &right_ids Quotient
    (equivalent ((:a ?others) (:b ?others))
      (?S (?others *))))
  (INIT &right_box BoundingBox
    (key ((?S (?others ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&right_cells.minimal (:t ?others (:Cell *Cell))))))
  (QUERY &right_placed
    (?S (?others *) (?b *))
    (&right_ids.class (:a ?others) (:Id *Key))
    (&right_box.box (:key ?others) (:B *Box))
    (relative (:Base Box) (:X ?b) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&right_placed *Key *X_rel))
    (observed ((:observed Key D) (:m Image))
      (&left_placed *Key *X_rel)
      (d4_elem *D)
      (apply D (:P X_rel) (:P_out *Image))))
  (INIT &matched Cardinality
    (key ((?L (?keys ^)) (&whole ^Whole) (&left_ids.class (:a ?keys) (:Id *Key)) (&same_set.equal (:observed Key)))))
  (QUERY &q (?L (?keys *)) (&matched.size (:key ?keys)))
  (gives &q))

(fragment (determines-jointly (?R relation) (?p column ?R) (?v column ?R) (?w column ?R))
  "Whether two columns together give the output color at a relation's cells, where neither does alone."
  (QUERY &cells
    (?R (?p *) (?v *) (?w *))
    (output (:P ?p) (:Col *Out)))
  (INIT &both Singleton
    (key ((?R (?v ^) (?w ^)))
      (member ((:v Out))
        (&cells ?v ?w *Out))))
  (INIT &first Singleton
    (key ((?R (?v ^)))
      (member ((:v Out))
        (&cells ?v *Out))))
  (INIT &second Singleton
    (key ((?R (?w ^)))
      (member ((:v Out))
        (&cells ?w *Out))))
  (QUERY &some_both (&both.plural))
  (QUERY &q
    (&first.plural)
    (&second.plural)
    (NOT (&some_both)))
  (gives &q))
