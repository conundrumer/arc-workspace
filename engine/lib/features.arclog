(fragment (shapes-disjoint (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether both relations hold a shape of cells, up to a move, and no shape of the first is a shape of the second."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &left_cells Order
    (member ((:t ?keys (:Cell ?a)))
      (?L (?keys *) (?a *))))
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?L (?keys *))))
  (INIT &left_box BoundingBox
