(fragment (shapes-equal (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the shapes of the cell sets that the keys of the first relation hold, up to a move, are the shapes that the keys of the second hold."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &left_cells Order
    (member ((:t ?keys (:Cell ?a)))
      (?L (?keys *) (?a *))))
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?L (?keys *))))
  (INIT &left_box BoundingBox
    (key ((?L (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&left_cells.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &left_placed
    (?L (?keys *) (?a *))
    (&left_ids.class (:a ?keys) (:Id *Key))
    (&left_box.box (:key ?keys) (:B *Box))
    (relative (:Base Box) (:X ?a) *X_rel))
  (INIT &right_cells Order
    (member ((:t ?others (:Cell ?b)))
      (?S (?others *) (?b *))))
  (INIT &right_ids Quotient
    (equivalent ((:a ?others) (:b ?others))
      (?S (?others *))))
  (INIT &right_box BoundingBox
    (key ((?S (?others ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&right_cells.minimal (:t ?others (:Cell *Cell))))))
  (QUERY &right_placed
    (?S (?others *) (?b *))
    (&right_ids.class (:a ?others) (:Id *Key))
    (&right_box.box (:key ?others) (:B *Box))
    (relative (:Base Box) (:X ?b) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&right_placed *Key *X_rel))
    (observed ((:observed Key) (:m X_rel))
      (&left_placed *Key *X_rel)))
  (QUERY &left_only
    (&left_ids.class (:Id *Key))
    (NOT (&same_set.equal (:observed Key))))
  (QUERY &right_only
    (&right_ids.class (:Id *Key))
    (NOT (&same_set.equal (:pattern Key))))
  (QUERY &q (&same_set.equal) (NOT (&left_only)) (NOT (&right_only)))
  (gives &q))

(fragment (shapes-subset (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the shapes of the cell sets that the keys of the first relation hold, up to a move, are shapes that the keys of the second hold, and the second holds a shape more."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &left_cells Order
