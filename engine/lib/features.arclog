;; The feature library: compositions of the expander's primitives, which
;; `engine/arclog-encoder` reads. A `fragment` gives a relation with one label
;; per column, which its `gives` names. A `feature` ends in `EXPORT`.

;; A ratio is two numbers, each from its own atom.

(feature (cardinality-ratio (?A relation) (?B relation))
  "The ratio of two relations' counts of rows, as those two counts."
  (INIT &a Cardinality
    (member ((:m (others ?A)))
      (?A (*others ?A))))
  (INIT &b Cardinality
    (member ((:m (others ?B)))
      (?B (*others ?B))))
  (EXPORT (&a.size ^N) (&b.size (:N ^N_2))))

(fragment (join-label (?R relation) (?p column ?R) (?grid grid))
  "A relation's rows with a grid's color at a column of cells."
  (QUERY &q
    (?R (?p *) (*others ?R ?p))
    (?grid (:P ?p) (:Col (*new Col ?R))))
  (gives &q))

(fragment (group-sizes (?R relation) (?x column ?R))
  "The rows per value of a column."
  (INIT &c Cardinality
    (key ((?R (?x ^)))
      (member ((:m (others ?R ?x)))
        (?R ?x (*others ?R ?x)))))
  (QUERY &sizes (&c.size (:key (?x *)) (:N (*new N ?R))))
  (gives &sizes))

;; Parts of one grid, which a call gives as a hole: `(color-counts input)`.

(fragment (color-counts (?G grid))
  "Each color of a grid with its count of cells."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (QUERY &q (&counts.size (:key *Col) *N))
  (gives &q))

(fragment (most-colors (?G grid))
  "The colors with the most cells. Under a tie, every tied color."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &q (&order.maximal (:t *Col)))
  (gives &q))

(fragment (least-colors (?G grid))
  "The colors with the fewest cells. Under a tie, every tied color."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &q (&order.minimal (:t *Col)))
  (gives &q))

(fragment (background-cells (?G grid))
  "The cells of the colors with the most cells."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &q (?G (:P *P) (:Col *Col)) (&background Col))
  (gives &q))

(fragment (foreground (?G grid))
  "The cells off the colors with the most cells."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (QUERY &q (&foreground *P *Col))
  (gives &q))

(fragment (components (?G grid))
  "The 8-connected pieces of each color."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (QUERY &q (&pieces *P *Col *Id))
  (gives &q))

(fragment (foreground-components (?G grid))
  "The 8-connected pieces of the foreground, across colors."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &parts Connectivity
    (node (P)
      (&foreground *P))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &q (&parts.component *P *Id))
  (gives &q))

(fragment (component-boxes (?G grid))
  "The box of each piece of each color."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &boxes BoundingBox
    (key ((&pieces (:Id ^Id)))
      (cell (P)
        (&pieces *P Id))))
  (QUERY &q (&pieces *Col *Id) (&boxes.box (:key Id) *B))
  (gives &q))

(fragment (full-lines-of (?G grid))
  "The rows and columns of one color."
  (INIT &line_colors Singleton
    (key ((?G (:P *P)) (split P ^A ^Along))
      (member ((:v Col))
        (?G (:P *P) (:Col *Col))
        (split P A Along))))
  (QUERY &q (&line_colors.value (:key *A *Along) (:v *Col)))
  (gives &q))

(fragment (extents (?G grid))
  "The grid's extent along each axis."
  (QUERY &per_cell (?G (:P *P)) (frame_extent P *A *N))
  (QUERY &q (&per_cell *A *N))
  (gives &q))

(fragment (area (?G grid))
  "The grid's count of cells."
  (INIT &c Cardinality
    (member ((:m P))
      (?G (:P *P))))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (color-count (?G grid))
  "The grid's count of colors."
  (INIT &c Cardinality
    (member ((:m Col))
      (?G (:Col *Col))))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (longer-side (?G grid))
  "The greatest of the grid's extents."
  (QUERY &per_cell (?G (:P *P)) (frame_extent P *A *N))
  (QUERY &ns (&per_cell *N))
  (INIT &most Order
    (member ((:t N))
      (&ns *N))
    (score ((:t N) (:S N))
      (&ns *N)))
  (QUERY &q (&most.maximal (:t *N)))
  (gives &q))

(fragment (shorter-side (?G grid))
  "The least of the grid's extents."
  (QUERY &per_cell (?G (:P *P)) (frame_extent P *A *N))
  (QUERY &ns (&per_cell *N))
  (INIT &most Order
    (member ((:t N))
      (&ns *N))
    (score ((:t N) (:S N))
      (&ns *N)))
  (QUERY &q (&most.minimal (:t *N)))
  (gives &q))

(fragment (cells-boundary (?G grid))
  "The cells with a cardinal neighbor off their color, or off the grid."
  (INIT &b Boundary
    (key ((?G (:Col ^Col)))
      (cell (P)
        (?G (:Col Col) (:P *P)))))
  (QUERY &q (&b.boundary *P))
  (gives &q))

(fragment (cells-box-corner (?G grid))
  "The cells of a piece at a corner of the piece's box."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &boxes BoundingBox
    (key ((&pieces (:Id ^Id)))
      (cell (P)
        (&pieces *P Id))))
  (QUERY &placed
    (&pieces *P *Id)
    (&boxes.box (:key Id) *B))
  (QUERY &corner (&placed *P *B) (same_corner *D (:P1 P) (:P2 B)))
  (QUERY &q (&corner *P))
  (gives &q))

(fragment (cells-box-center (?G grid))
  "The cells of a piece at the center of the piece's box."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &boxes BoundingBox
    (key ((&pieces (:Id ^Id)))
      (cell (P)
        (&pieces *P Id))))
  (QUERY &placed
    (&pieces *P *Id)
    (&boxes.box (:key Id) *B))
  (QUERY &center (&placed *P *B) (relative (:Base B) (:X P) *X_rel) (centered (:P X_rel)))
  (QUERY &q (&center *P))
  (gives &q))

(fragment (cells-tip (?G grid))
  "The cells with exactly one neighbor of their color."
  (QUERY &same
    (?G (:P *P) (:Col *Col))
    (neighbor P *D *Q)
    (?G (:P Q) (:Col Col)))
  (INIT &one Singleton
    (key ((&same ^P))
      (member ((:v D))
        (&same P *D))))
  (QUERY &q (&one.value (:key *P)))
  (gives &q))

(fragment (cells-single-cell (?G grid))
  "The cells with no neighbor of their color."
  (QUERY &same
    (?G (:P *P) (:Col *Col))
    (neighbor P *D *Q)
    (?G (:P Q) (:Col Col)))
  (QUERY &q (?G (:P *P)) (NOT (&same P)))
  (gives &q))

(fragment (cells-full-line (?G grid))
  "The cells on a row or a column of one color."
  (INIT &line_colors Singleton
    (key ((?G (:P *P)) (split P ^A ^Along))
      (member ((:v Col))
        (?G (:P *P) (:Col *Col))
        (split P A Along))))
  (QUERY &full (&line_colors.value (:key *A *Along)))
  (QUERY &on_line
    (?G (:P *P))
    (split P *A *Along)
    (&full A Along))
  (QUERY &q (&on_line *P))
  (gives &q))

(fragment (cells-grid-edge (?G grid))
  "The cells on an edge of the grid."
  (QUERY &at_edge
    (?G (:P *P) (:Col *Col))
    (margin (:B P) *D (:K 0)))
  (QUERY &q (&at_edge *P))
  (gives &q))

(fragment (cells-grid-corner (?G grid))
  "The cells at a corner of the grid."
  (QUERY &at_corner (?G (:P *P)) (corner_dist P *Diag (:K 0)))
  (QUERY &q (&at_corner *P))
  (gives &q))

(fragment (cells-next-to-foreground (?G grid))
  "The cells off the foreground with a foreground neighbor."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (QUERY &near
    (?G (:P *P))
    (NOT (&foreground P))
    (neighbor P *D *Q)
    (&foreground (:P Q)))
  (QUERY &q (&near *P))
  (gives &q))

(fragment (cells-enclosed-by-foreground (?G grid))
  "The cells off the foreground that no cardinal walk off the foreground reaches from the grid's edge."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (QUERY &free (?G (:P *P)) (NOT (&foreground P)))
  (INIT &e Enclosure
    (cell (P)
      (&free *P)))
  (QUERY &q (&e.enclosed *P))
  (gives &q))

(fragment (cells-between-foreground (?G grid))
  "The cells off the foreground with foreground on two opposite sides, on their row or column."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (QUERY &seen
    (?G (:P *P))
    (NOT (&foreground P))
    (dir_elem *D)
    (&foreground (:P *Q))
    (gap D P Q *K))
  (QUERY &sides (&seen *P *D))
  (QUERY &both (&sides *P *D) (opposite D *Opp) (&sides P (:D Opp)))
  (QUERY &q (&both *P))
  (gives &q))

(fragment (cells-crossing (?G grid))
  "The cells whose row and column are both wholly foreground."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (QUERY &whole
    (?G (:P *P))
    (axis_elem *A)
    (ALL ((?G (:P *Q)) (same_line A P Q))
      ((&foreground (:P Q)))))
  (QUERY &cross (&whole *P *A) (perp A *A2) (&whole P (:A A2)))
  (QUERY &q (&cross *P))
  (gives &q))

(fragment (cells-breaks-period (?G grid))
  "The cells off the most frequent color of their class, where a class is the cells that the least approximate period on each axis takes onto each other. Under a tie, every tied color stays."
  (INIT &periods Periods
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &found (&periods.approximate_period *A *K))
  (INIT &least Order
    (key ((&found ^A))
      (member ((:t K))
        (&found A *K))
      (score ((:t K) (:S K))
        (&found A *K))))
  (QUERY &moves (&least.minimal (:key *A) (:t *K)) (axis_of *D A) (jump_offset D K *V))
  (INIT &classes Connectivity
    (node (P)
      (?G (:P *P)))
    (step ((:Delta V))
      (&moves *V)))
  (QUERY &in_class (&classes.component *P *Id) (?G (:P P) (:Col *Col)))
  (INIT &class_counts Cardinality
    (key ((&in_class ^Id ^Col))
      (member ((:m P))
        (&in_class *P Id Col))))
  (INIT &class_order Order
    (key ((&in_class ^Id))
      (member ((:t Col))
        (&in_class Id *Col))
      (score ((:t Col) (:S N))
        (&class_counts.size (:key Id *Col) *N))))
  (QUERY &top (&class_order.maximal (:key *Id) (:t *Col)))
  (QUERY &off (&in_class *P *Id *Col) (NOT (&top Id Col)))
  (QUERY &q (&off *P))
  (gives &q))

(fragment (colors-whole-lines (?G grid))
  "The colors whose every cell lies on a row or a column of one color."
  (INIT &line_colors Singleton
    (key ((?G (:P *P)) (split P ^A ^Along))
      (member ((:v Col))
        (?G (:P *P) (:Col *Col))
        (split P A Along))))
  (QUERY &full (&line_colors.value (:key *A *Along)))
  (QUERY &on_line
    (?G (:P *P))
    (split P *A *Along)
    (&full A Along))
  (QUERY &q (?G (:Col *Col)) (ALL ((?G (:P *P) (:Col Col))) ((&on_line P))))
  (gives &q))

(fragment (colors-single-cells (?G grid))
  "The colors whose every piece is one cell."
  (QUERY &same
    (?G (:P *P) (:Col *Col))
    (neighbor P *D *Q)
    (?G (:P Q) (:Col Col)))
  (QUERY &q (?G (:Col *Col)) (NOT (&same Col)))
  (gives &q))

(fragment (colors-one-component (?G grid))
  "The colors of one piece."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &one Singleton
    (key ((&pieces ^Col))
      (member ((:v Id))
        (&pieces Col *Id))))
  (QUERY &q (&one.value (:key *Col)))
  (gives &q))

(fragment (colors-every-edge (?G grid))
  "The colors with a cell on every edge."
  (QUERY &at_edge
    (?G (:P *P) (:Col *Col))
    (margin (:B P) *D (:K 0)))
  (QUERY &q (?G (:Col *Col)) (ALL ((dir_elem *D)) ((&at_edge Col D))))
  (gives &q))

(fragment (colors-no-edge (?G grid))
  "The colors with no cell on an edge."
  (QUERY &at_edge
    (?G (:P *P) (:Col *Col))
    (margin (:B P) *D (:K 0)))
  (QUERY &q (?G (:Col *Col)) (NOT (&at_edge Col)))
  (gives &q))

(fragment (colors-encloses (?G grid))
  "The colors that enclose a cell."
  (INIT &enclosure Enclosure
    (key ((?G (:Col ^Col)))
      (cell (P)
        (?G (:P *P) (:Col *Other))
        (!= Other Col))))
  (QUERY &q (&enclosure.enclosed (:key *Col)))
  (gives &q))

(fragment (colors-enclosed (?G grid))
  "The colors whose every cell another color encloses."
  (INIT &enclosure Enclosure
    (key ((?G (:Col ^Col)))
      (cell (P)
        (?G (:P *P) (:Col *Other))
        (!= Other Col))))
  (QUERY &within
    (?G (:Col *Col))
    (&enclosure.enclosed (:key (:Col *Other)))
    (!= Other Col)
    (ALL ((?G (:P *P) (:Col Col)))
      ((&enclosure.enclosed (:key (:Col Other)) P))))
  (QUERY &q (&within *Col))
  (gives &q))

(fragment (colors-fills-boxes (?G grid))
  "The colors whose every piece fills its box."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &boxes BoundingBox
    (key ((&pieces (:Id ^Id)))
      (cell (P)
        (&pieces *P Id))))
  (QUERY &unfilled
    (&boxes.box (:key *Id) *B)
    (?G (:P *Q))
    (inside (:A Q) B)
    (NOT (&pieces (:P Q) Id)))
  (QUERY &q (?G (:Col *Col)) (ALL ((&pieces Col *Id)) ((NOT (&unfilled Id)))))
  (gives &q))

(fragment (colors-largest-component (?G grid))
  "The foreground colors with a piece of the most cells among foreground pieces. Under a tie, every tied color."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &sizes Cardinality
    (key ((&pieces ^Id))
      (member ((:m P))
        (&pieces *P Id))))
  (QUERY &foreground_sizes
    (&pieces *Col *Id)
    (NOT (&background Col))
    (&sizes.size (:key Id) *N))
  (QUERY &ns (&foreground_sizes *N))
  (INIT &most Order
    (member ((:t N))
      (&ns *N))
    (score ((:t N) (:S N))
      (&ns *N)))
  (QUERY &top (&most.maximal (:t *N)))
  (QUERY &with (&foreground_sizes *Col *N) (&top N))
  (QUERY &q (&with *Col))
  (gives &q))

(fragment (colors-most-components (?G grid))
  "The colors with the most pieces. Under a tie, every tied color."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &per_color Cardinality
    (key ((&pieces ^Col))
      (member ((:m Id))
        (&pieces Col *Id))))
  (INIT &o Order
    (member ((:t Col))
      (&per_color.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&per_color.size (:key *Col) *N)))
  (QUERY &q (&o.maximal (:t *Col)))
  (gives &q))

(fragment (colors-symmetric (?G grid))
  "The colors whose cell set a symmetry other than the identity maps onto itself, up to a move."
  (INIT &color_box BoundingBox
    (key ((?G (:Col ^Col)))
      (cell (P)
        (?G (:Col Col) (:P *P)))))
  (QUERY &rel
    (?G (:P *P) (:Col *Col))
    (&color_box.box (:key Col) *B)
    (relative (:Base B) (:X P) *X_rel))
  (INIT &agree Agreement
    (key ((&rel ^Col))
      (source ((:P X_rel) (:v Col))
        (&rel Col *X_rel))
      (target ((:P X_rel) (:v Col))
        (&rel Col *X_rel))))
  (QUERY &keeps
    (&rel *Col)
    (d4_elem *D)
    (NOT (&agree.mismatch (:key Col) D))
    (d4_compose (:A D) (:B D) *C)
    (!= C D))
  (QUERY &q (&keeps *Col))
  (gives &q))

(fragment (foreground-count (?G grid))
  "The count of foreground cells."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &c Cardinality
    (member ((:m P))
      (&foreground *P)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (foreground-component-count (?G grid))
  "The count of foreground pieces."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &parts Connectivity
    (node (P)
      (&foreground *P))
    (step ((:Delta V))
      (step_offset *V)))
  (INIT &c Cardinality
    (member ((:m Id))
      (&parts.component *Id)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (component-count (?G grid))
  "The count of pieces of each color together."
  (INIT &pieces_of Connectivity
    (key ((?G (:Col ^Col)))
      (node (P)
        (?G (:Col Col) (:P *P))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &pieces (&pieces_of.component *P (:key *Col) *Id))
  (INIT &c Cardinality
    (member ((:m Id))
      (&pieces *Id)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (foreground-box (?G grid))
  "The box of the foreground."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &b BoundingBox
    (cell (P)
      (&foreground *P)))
  (QUERY &q (&b.box *B))
  (gives &q))

(fragment (foreground-box-margins (?G grid))
  "The margins of the foreground's box."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &b BoundingBox
    (cell (P)
      (&foreground *P)))
  (QUERY &m (&b.box *B) (margin (:B B) *D *K))
  (QUERY &q (&m *D *K))
  (gives &q))

(fragment (foreground-box-extents (?G grid))
  "The extents of the foreground's box."
  (INIT &counts Cardinality
    (key ((?G (:Col ^Col)))
      (member ((:m P))
        (?G (:Col Col) (:P *P)))))
  (INIT &order Order
    (member ((:t Col))
      (&counts.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&counts.size (:key *Col) *N)))
  (QUERY &background (&order.maximal (:t *Col)))
  (QUERY &foreground
    (?G (:P *P) (:Col *Col))
    (NOT (&background Col)))
  (INIT &b BoundingBox
    (cell (P)
      (&foreground *P)))
  (QUERY &e (&b.box *B) (?G (:P *P)) (box_extent B P *A *N))
  (QUERY &q (&e *A *N))
  (gives &q))

(fragment (symmetries (?G grid))
  "The elements of D4 that take the grid onto itself."
  (INIT &agree Agreement
    (source ((:P P) (:v Col))
      (?G (:P *P) (:Col *Col)))
    (target ((:P P) (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &q (d4_elem *D) (NOT (&agree.mismatch D)))
  (gives &q))

;; Parts of a pair, which read both of its grids: `(changed)`.

(fragment (changed)
  "The cells whose color differs between a pair's grids, with both colors."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (QUERY &q (&changed *P *Col *Col_2))
  (gives &q))

(fragment (kept)
  "The cells whose color is the same in a pair's grids."
  (QUERY &kept
    (input *P *Col)
    (output P Col))
  (QUERY &q (&kept *P *Col))
  (gives &q))

(fragment (changed-components)
  "The 8-connected pieces of the changed cells."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &parts Connectivity
    (node (P)
      (&changed *P))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &q (&parts.component *P *Id))
  (gives &q))

(fragment (colors-added)
  "The colors of the output and not of the input."
  (QUERY &q (output *Col) (NOT (input Col)))
  (gives &q))

(fragment (colors-dropped)
  "The colors of the input and not of the output."
  (QUERY &q (input *Col) (NOT (output Col)))
  (gives &q))

(fragment (colors-changed-from)
  "The colors that a changed cell has in the input."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (QUERY &q (&changed *Col))
  (gives &q))

(fragment (colors-changed-to)
  "The colors that a changed cell has in the output."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (QUERY &q (&changed (:Col_2 *Col)))
  (gives &q))

(fragment (changed-box)
  "The box of the changed cells."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &box BoundingBox
    (cell (P)
      (&changed *P)))
  (QUERY &q (&box.box *B))
  (gives &q))

(fragment (changed-box-margins)
  "The margins of the changed cells' box."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &box BoundingBox
    (cell (P)
      (&changed *P)))
  (QUERY &m (&box.box *B) (margin (:B B) *D *K))
  (QUERY &q (&m *D *K))
  (gives &q))

(fragment (changed-box-extents)
  "The extents of the changed cells' box."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &box BoundingBox
    (cell (P)
      (&changed *P)))
  (QUERY &e (&box.box *B) (input *P) (box_extent B P *A *N))
  (QUERY &q (&e *A *N))
  (gives &q))

(fragment (changed-component-boxes)
  "The box of each piece of the changed cells."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &parts Connectivity
    (node (P)
      (&changed *P))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &cells (&parts.component *P *Id))
  (INIT &boxes BoundingBox
    (key ((&cells ^Id))
      (cell (P)
        (&cells *P Id))))
  (QUERY &q (&boxes.box (:key *Id) *B))
  (gives &q))

(fragment (changed-count)
  "The count of changed cells, where a cell changed."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &c Cardinality
    (key ((&changed)))
    (member ((:m P))
      (&changed *P)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (changed-component-count)
  "The count of pieces of the changed cells, where a cell changed."
  (QUERY &changed
    (input *P *Col)
    (output P (:Col *Col_2))
    (!= Col Col_2))
  (INIT &parts Connectivity
    (node (P)
      (&changed *P))
    (step ((:Delta V))
      (step_offset *V)))
  (INIT &c Cardinality
    (key ((&changed)))
    (member ((:m Id))
      (&parts.component *Id)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (kept-count)
  "The count of kept cells, where a cell is kept."
  (QUERY &kept
    (input *P *Col)
    (output P Col))
  (INIT &c Cardinality
    (key ((&kept)))
    (member ((:m P))
      (&kept *P)))
  (QUERY &q (&c.size *N))
  (gives &q))

(fragment (input-output-images)
  "The elements of D4 that take the input onto the output."
  (INIT &agree Agreement
    (source ((:P P) (:v Col))
      (input *P *Col))
    (target ((:P P) (:v Col))
      (output *P *Col)))
  (QUERY &q (d4_elem *D) (NOT (&agree.mismatch D)))
  (gives &q))

(fragment (output-in-input)
  "Each place where the output occurs in the input."
  (INIT &o Occurrences
    (cell (P (:v Col))
      (input *P *Col))
    (shape (P (:v Col))
      (output *P *Col)))
  (QUERY &q (&o.occurrence (:P *B)))
  (gives &q))

(fragment (input-in-output)
  "Each place where the input occurs in the output."
  (INIT &o Occurrences
    (cell (P (:v Col))
      (output *P *Col))
    (shape (P (:v Col))
      (input *P *Col)))
  (QUERY &q (&o.occurrence (:P *B)))
  (gives &q))

(fragment (output-in-input-d4)
  "Each place and element of D4 where the output's image occurs in the input."
  (INIT &o Occurrences
    (cell (P (:v Col))
      (input *P *Col))
    (shape (P (:v Col))
      (output *P *Col))
    (transform (D)
      (d4_elem *D)))
  (QUERY &q (&o.occurrence *D (:P *B)))
  (gives &q))

(fragment (input-in-output-d4)
  "Each place and element of D4 where the input's image occurs in the output."
  (INIT &o Occurrences
    (cell (P (:v Col))
      (output *P *Col))
    (shape (P (:v Col))
      (input *P *Col))
    (transform (D)
      (d4_elem *D)))
  (QUERY &q (&o.occurrence *D (:P *B)))
  (gives &q))

(fragment (scale-up)
  "Each output cell with the input cell whose block holds it, with both colors."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_outer *P_in) (:P *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) (:Col *Col_2)))
  (gives &q))

(fragment (scale-up-kept)
  "The cells of `scale-up` whose two colors are the same."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_outer *P_in) (:P *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) Col))
  (gives &q))

(fragment (scale-up-changed)
  "The cells of `scale-up` whose two colors differ."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_outer *P_in) (:P *P_out)))
  (QUERY &q
    (&cells *P_in *P_out)
    (input (:P P_in) *Col)
    (output (:P P_out) (:Col *Col_2))
    (!= Col Col_2))
  (gives &q))

(fragment (tile)
  "Each output cell with the input cell at its place in a copy of the input, with both colors."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (side (A (:K N))
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_inner *P_in) (:P *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) (:Col *Col_2)))
  (gives &q))

(fragment (tile-kept)
  "The cells of `tile` whose two colors are the same."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (side (A (:K N))
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_inner *P_in) (:P *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) Col))
  (gives &q))

(fragment (tile-changed)
  "The cells of `tile` whose two colors differ."
  (QUERY &per_cell (input *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (output *P))
    (side (A (:K N))
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P_inner *P_in) (:P *P_out)))
  (QUERY &q
    (&cells *P_in *P_out)
    (input (:P P_in) *Col)
    (output (:P P_out) (:Col *Col_2))
    (!= Col Col_2))
  (gives &q))

(fragment (scale-down)
  "Each input cell with the output cell whose block holds it, with both colors."
  (QUERY &per_cell (output *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (input *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P *P_in) (:P_outer *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) (:Col *Col_2)))
  (gives &q))

(fragment (scale-down-kept)
  "The cells of `scale-down` whose two colors are the same."
  (QUERY &per_cell (output *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (input *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P *P_in) (:P_outer *P_out)))
  (QUERY &q (&cells *P_in *P_out) (input (:P P_in) *Col) (output (:P P_out) Col))
  (gives &q))

(fragment (scale-down-changed)
  "The cells of `scale-down` whose two colors differ."
  (QUERY &per_cell (output *P) (frame_extent P *A *N))
  (QUERY &extents (&per_cell *A *N))
  (INIT &d Division
    (cell (P)
      (input *P))
    (parts (A N)
      (&extents *A *N)))
  (QUERY &cells (&d.tile (:P *P_in) (:P_outer *P_out)))
  (QUERY &q
    (&cells *P_in *P_out)
    (input (:P P_in) *Col)
    (output (:P P_out) (:Col *Col_2))
    (!= Col Col_2))
  (gives &q))

(fragment (d4-identity)
  "The element of D4 that composes with itself to give itself."
  (QUERY &q (d4_elem *D) (d4_compose (:A D) (:B D) (:C D)))
  (gives &q))

;; Parts with holes over a relation. A list of key columns can be empty.

(fragment (cells-on (?R relation) (?p column ?R) (?G grid))
  "A relation's cells at a column that lie on a grid."
  (QUERY &q (?R (?p *)) (?G (:P ?p)))
  (gives &q))

(fragment (colors-under (?R relation) (?p column ?R) (?G grid))
  "A grid's colors under a relation's cells."
  (QUERY &under (?R (?p *)) (?G (:P ?p) (:Col *Col)))
  (QUERY &q (&under *Col))
  (gives &q))

(fragment (around (?R relation) (?p column ?R))
  "The cells next to a relation's cells and not among them, on the frame."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &next
    (?R (?p *))
    (neighbor (:P ?p) (:D *Toward) (:Q *Cell))
    (ALL ((margin (:B Cell) (:D *Edge) (:K *Away)))
      ((>= Away 0))))
  (QUERY &free (&next *Cell) (NOT (&have.minimal (:t Cell))))
  (QUERY &q (&free (:Cell (*new Q ?R))))
  (gives &q))

(fragment (neighbors (?R relation) (?p column ?R))
  "Each row with each neighbor of its cell on the frame."
  (QUERY &next
    (?R (?p *))
    (neighbor (:P ?p) (:D *Toward) (:Q *Cell))
    (ALL ((margin (:B Cell) (:D *Edge) (:K *Away)))
      ((>= Away 0))))
  (QUERY &q (?R (*others ?R)) (&next ?p (:Toward (*new D ?R)) (:Cell (*new Q ?R))))
  (gives &q))

(fragment (split (?R relation) (?p column ?R))
  "Each row with the row and the column of its cell."
  (QUERY &q (?R (*others ?R)) (split (:P ?p) (:A (*new A ?R)) (:Along (*new Along ?R))))
  (gives &q))

(fragment (margin (?R relation) (?p column ?R))
  "Each row with its cell's margin on each edge."
  (QUERY &q (?R (*others ?R)) (margin (:B ?p) (:D (*new D ?R)) (:K (*new K ?R))))
  (gives &q))

(fragment (corner-dist (?R relation) (?p column ?R))
  "Each row with the sum of its cell's margins at each corner."
  (QUERY &q (?R (*others ?R)) (corner_dist (:P ?p) (:Diag (*new Diag ?R)) (:K (*new K ?R))))
  (gives &q))

(fragment (parity (?R relation) (?p column ?R))
  "Each row with the remainder of its cell's distance from each corner, over the count of axes."
  (INIT &axes Cardinality
    (member ((:m A))
      (axis_elem *A)))
  (QUERY &remainders
    (?R (?p *))
    (corner_dist (:P ?p) (:Diag *Corner) (:K *Away))
    (&axes.size (:N *Side))
    (divide (:T Away) (:Side Side) (:Gap 0) (:Remainder *Left)))
  (QUERY &q (?R (*others ?R)) (&remainders ?p (:Corner (*new Diag ?R)) (:Left (*new K ?R))))
  (gives &q))

(fragment (border-distance (?R relation) (?p column ?R))
  "Each row with the least margin of its cell."
  (INIT &least Order
    (key ((?R (?p ^)))
      (member ((:t Away))
        (margin (:B ?p) (:K *Away)))
      (score ((:t Away) (:S Away))
        (margin (:B ?p) (:K *Away)))))
  (QUERY &q (?R (*others ?R)) (&least.minimal (:key ?p) (:t (*new K ?R))))
  (gives &q))

(fragment (pieces (?R relation) (?keys columns ?R) (?p column ?R))
  "The 8-connected pieces of each key's cells."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &pieces Connectivity
    (key ((?R (?keys ^)) (&whole ^Whole))
      (node ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &q (?R (?keys *) (?p *)) (&pieces.component (:key ?keys) (:P ?p) (:Id (*new Id ?R))))
  (gives &q))

(fragment (pieces4 (?R relation) (?keys columns ?R) (?p column ?R))
  "The 4-connected pieces of each key's cells."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &pieces Connectivity
    (key ((?R (?keys ^)) (&whole ^Whole))
      (node ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &q (?R (?keys *) (?p *)) (&pieces.component (:key ?keys) (:P ?p) (:Id (*new Id ?R))))
  (gives &q))

(fragment (box-of (?R relation) (?keys columns ?R) (?p column ?R))
  "The box of each key's cells."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &q (?R (?keys *)) (&box.box (:key ?keys) (:B (*new B ?R))))
  (gives &q))

(fragment (cells-in-box (?R relation) (?keys columns ?R) (?p column ?R))
  "Each key's cells relative to its box."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (INIT &rel Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t Rel))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (&box.box (:key ?keys) (:B *Box))
        (relative (:Base Box) (:X Cell) (:X_rel *Rel)))))
  (QUERY &q (?R (?keys *)) (&rel.minimal (:key ?keys) (:t (*new X_rel ?R))))
  (gives &q))

(fragment (count (?R relation) (?keys columns ?R))
  "The rows per value of the key columns."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &c Cardinality
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:m (others ?R ?keys)))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (QUERY &q (?R (?keys *)) (&c.size (:key ?keys) (:N (*new N ?R))))
  (gives &q))

(fragment (one-value (?R relation) (?keys columns ?R) (?f column ?R))
  "The keys with one value of a column, with that value."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &s Singleton
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:v ?f))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (QUERY &q (?R (?keys *) (?f *)) (&s.value (:key ?keys) (:v ?f)))
  (gives &q))

(fragment (several (?R relation) (?keys columns ?R) (?f column ?R))
  "The keys with more than one value of a column."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &s Singleton
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:v ?f))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (QUERY &q (?R (?keys *)) (&s.plural (:key ?keys)))
  (gives &q))

(fragment (determines (?R relation) (?keys columns ?R) (?f column ?R))
  "Whether each key has one value of a column."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &s Singleton
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:v ?f))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (QUERY &q (ALL ((?R (?keys *))) ((&s.value (:key ?keys)))))
  (gives &q))

(fragment (greatest (?R relation) (?n column ?R))
  "The greatest value of a number column."
  (INIT &o Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (QUERY &q (?R (?n *)) (&o.maximal (:t ?n)))
  (gives &q))

(fragment (least (?R relation) (?n column ?R))
  "The least value of a number column."
  (INIT &o Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (QUERY &q (?R (?n *)) (&o.minimal (:t ?n)))
  (gives &q))

(fragment (greatest-by (?R relation) (?keys columns ?R) (?v column ?R) (?n column ?R))
  "Each key's values of a column at the greatest of a number column. Under a tie, every tied value."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &scores Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t ?n))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))
      (score ((:t ?n) (:S ?n))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (INIT &values Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t ?v))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys)))
        (&scores.maximal (:key ?keys) (:t ?n)))))
  (QUERY &q (?R (?keys *) (?v *)) (&values.minimal (:key ?keys) (:t ?v)))
  (gives &q))

(fragment (least-by (?R relation) (?keys columns ?R) (?v column ?R) (?n column ?R))
  "Each key's values of a column at the least of a number column. Under a tie, every tied value."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &scores Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t ?n))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))
      (score ((:t ?n) (:S ?n))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys))))))
  (INIT &values Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t ?v))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys)))
        (&scores.minimal (:key ?keys) (:t ?n)))))
  (QUERY &q (?R (?keys *) (?v *)) (&values.minimal (:key ?keys) (:t ?v)))
  (gives &q))

(fragment (class-of (?R relation) (?keys columns ?R))
  "A class per set of a key's other columns."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &key_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?R (?keys *))))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m (others ?R ?keys)))
      (?R (?keys *) (*others ?R ?keys))
      (&key_ids.class (:a ?keys) (:Id *Key)))
    (observed ((:observed Key) (:m (others ?R ?keys)))
      (?R (?keys *) (*others ?R ?keys))
      (&key_ids.class (:a ?keys) (:Id *Key))))
  (QUERY &equal (&same_set.equal (:observed *Key) (:pattern *Key_2)))
  (INIT &class Quotient
    (equivalent ((:a Key) (:b Key_2))
      (&equal *Key *Key_2)))
  (INIT &class_of Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t Class))
        (&whole Whole)
        (&key_ids.class (:a ?keys) (:Id *Key))
        (&class.class (:a Key) (:Id *Class)))))
  (QUERY &q (?R (?keys *)) (&class_of.minimal (:key ?keys) (:t (*new Id ?R))))
  (gives &q))

(fragment (neighborhood-class (?R relation) (?p column ?R) (?G grid))
  "A class per cell's color with the color of its neighbor at each direction."
  (INIT &cell_names Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &named_around
    (?G (:P *Cell) (:Col *Own))
    (&cell_names.minimal (:t Cell))
    (neighbor (:P Cell) *D *Q)
    (?G (:P Q) (:Col *Near)))
  (INIT &same_set Inclusion
    (pattern ((:pattern Cell) (:m Own D Near))
      (&named_around *Cell *Own *D *Near))
    (observed ((:observed Cell) (:m Own D Near))
      (&named_around *Cell *Own *D *Near)))
  (QUERY &equal (&same_set.equal (:observed *Cell) (:pattern *Cell_2)))
  (INIT &class Quotient
    (equivalent ((:a Cell) (:b Cell_2))
      (&equal *Cell *Cell_2)))
  (QUERY &q (?R (?p *)) (&class.class (:a ?p) (:Id (*new Id ?R))))
  (gives &q))

(fragment (neighbor-color-class (?R relation) (?p column ?R) (?G grid))
  "A class per multiset of a cell's neighbors' colors."
  (INIT &cell_names Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &named_around
    (?G (:P *Cell) (:Col *Own))
    (&cell_names.minimal (:t Cell))
    (neighbor (:P Cell) *D *Q)
    (?G (:P Q) (:Col *Near)))
  (INIT &near_counts Cardinality
    (key ((&named_around ^Cell ^Near))
      (member ((:m D))
        (&named_around Cell *D Near))))
  (INIT &same_set Inclusion
    (pattern ((:pattern Cell) (:m Near N))
      (&near_counts.size (:key *Cell *Near) *N))
    (observed ((:observed Cell) (:m Near N))
      (&near_counts.size (:key *Cell *Near) *N)))
  (QUERY &equal (&same_set.equal (:observed *Cell) (:pattern *Cell_2)))
  (INIT &class Quotient
    (equivalent ((:a Cell) (:b Cell_2))
      (&equal *Cell *Cell_2)))
  (QUERY &q (?R (?p *)) (&class.class (:a ?p) (:Id (*new Id ?R))))
  (gives &q))

(fragment (same-color-neighbors (?R relation) (?p column ?R) (?G grid))
  "A cell's color on a grid, and how many neighbors share it."
  (INIT &same Cardinality
    (key ((?R (?p ^)) (?G (:P ?p)))
      (member ((:m D))
        (?G (:P ?p) (:Col *Own))
        (neighbor (:P ?p) *D *Q)
        (?G (:P Q) (:Col Own)))))
  (QUERY &q (?R (?p *)) (?G (:P ?p) (:Col (*new Col ?R))) (&same.size (:key ?p) (:N (*new N ?R))))
  (gives &q))

(fragment (most-frequent-rows (?R relation) (?keys columns ?R) (?f column ?R))
  "The rows whose value of a column has the most rows of their key. Under a tie, every tied value."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &per_value Cardinality
    (key ((?R (?keys ^) (?f ^)))
      (member ((:m (others ?R ?keys ?f)))
        (&rows.minimal (:t ?keys ?f (*others ?R ?keys ?f))))))
  (INIT &top Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t ?f))
        (&whole Whole)
        (&per_value.size (:key ?keys (?f *))))
      (score ((:t ?f) (:S Rows))
        (&whole Whole)
        (&per_value.size (:key ?keys (?f *)) (:N *Rows)))))
  (QUERY &q (?R (*others ?R)) (&top.maximal (:key ?keys) (:t ?f)))
  (gives &q))

(fragment (determines-flag (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?b column ?S))
  "Whether each key's rows all have a match in a second relation, or none do."
  (INIT &others_have Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &matched Cardinality
    (key ((?L (?keys ^) (?a *)) (&others_have.minimal (:t ?a)))))
  (INIT &unmatched Cardinality
    (key ((?L (?keys ^) (?a *)) (NOT (&others_have.minimal (:t ?a))))))
  (QUERY &q
    (ALL ((?L (?keys *)))
      ((OR ((NOT (&matched.size (:key ?keys))))
           ((NOT (&unmatched.size (:key ?keys))))))))
  (gives &q))

(fragment (shape-class (?R relation) (?keys columns ?R) (?p column ?R))
  "A class per set of a key's cells, up to a move."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &key_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?R (?keys *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &placed
    (?R (?keys *) (?p *))
    (&key_ids.class (:a ?keys) (:Id *Key))
    (&box.box (:key ?keys) (:B *Box))
    (relative (:Base Box) (:X ?p) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&placed *Key *X_rel))
    (observed ((:observed Key) (:m Image))
      (&placed *Key (:X_rel *Image))))
  (QUERY &equal (&same_set.equal (:observed *Key) (:pattern *Key_2)))
  (INIT &class Quotient
    (equivalent ((:a Key) (:b Key_2))
      (&equal *Key *Key_2)))
  (INIT &class_of Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t Class))
        (&whole Whole)
        (&key_ids.class (:a ?keys) (:Id *Key))
        (&class.class (:a Key) (:Id *Class)))))
  (QUERY &q (?R (?keys *)) (&class_of.minimal (:key ?keys) (:t (*new Id ?R))))
  (gives &q))

(fragment (shape-class-d4 (?R relation) (?keys columns ?R) (?p column ?R))
  "A class per set of a key's cells, up to a move, a rotation or a reflection."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &key_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?R (?keys *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &placed
    (?R (?keys *) (?p *))
    (&key_ids.class (:a ?keys) (:Id *Key))
    (&box.box (:key ?keys) (:B *Box))
    (relative (:Base Box) (:X ?p) *X_rel))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m X_rel))
      (&placed *Key *X_rel))
    (observed ((:observed Key D) (:m Image))
      (&placed *Key *X_rel)
        (d4_elem *D)
        (apply D (:P X_rel) (:P_out *Image))))
  (QUERY &equal (&same_set.equal (:observed *Key) (:pattern *Key_2)))
  (INIT &class Quotient
    (equivalent ((:a Key) (:b Key_2))
      (&equal *Key *Key_2)))
  (INIT &class_of Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t Class))
        (&whole Whole)
        (&key_ids.class (:a ?keys) (:Id *Key))
        (&class.class (:a Key) (:Id *Class)))))
  (QUERY &q (?R (?keys *)) (&class_of.minimal (:key ?keys) (:t (*new Id ?R))))
  (gives &q))

(fragment (holes (?R relation) (?keys columns ?R) (?p column ?R))
  "The count of parts of each key's frame that the key's cells enclose."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &frame Frame
    (key ((?R (?keys ^)) (&whole ^Whole))
      (extent (A N)
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (frame_extent (:P Cell) *A *N))))
  (INIT &enclosed Enclosure
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Free))
        (&whole Whole)
        (&frame.cell (:key ?keys) (:P *Free))
        (NOT (&cells_of.minimal (:t ?keys (:Cell Free)))))))
  (INIT &n Cardinality
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:m Part))
        (&whole Whole)
        (&enclosed.enclosed (:key ?keys) (:Id *Part)))))
  (QUERY &q (?R (?keys *)) (&n.size (:key ?keys) (:N (*new N ?R))))
  (gives &q))

(fragment (symmetry (?R relation) (?keys columns ?R) (?p column ?R))
  "The count of elements of D4 that map a key's cells onto themselves, up to a move."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (INIT &agree Agreement
    (key ((?R (?keys ^)) (&whole ^Whole))
      (source ((:P Rel) (:v Box))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (&box.box (:key ?keys) (:B *Box))
        (relative (:Base Box) (:X Cell) (:X_rel *Rel)))
      (target ((:P Rel) (:v Box))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (&box.box (:key ?keys) (:B *Box))
        (relative (:Base Box) (:X Cell) (:X_rel *Rel)))))
  (INIT &n Cardinality
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:m D))
        (&whole Whole)
        (d4_elem *D)
        (NOT (&agree.mismatch (:key ?keys) D)))))
  (QUERY &q (?R (?keys *)) (&n.size (:key ?keys) (:N (*new N ?R))))
  (gives &q))

(fragment (touches-edge (?R relation) (?keys columns ?R) (?p column ?R))
  "The keys with a cell on an edge."
  (INIT &keys_on Cardinality
    (key ((?R (?keys ^) (?p *)) (margin (:B ?p) (:K 0)))))
  (QUERY &q (?R (?keys *)) (&keys_on.size (:key ?keys)))
  (gives &q))

(fragment (fills-box (?R relation) (?keys columns ?R) (?p column ?R))
  "The keys whose cells fill their box."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (INIT &frame Frame
    (key ((?R (?keys ^)) (&whole ^Whole))
      (extent (A N)
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (frame_extent (:P Cell) *A *N))))
  (INIT &unfilled Cardinality
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:m Free))
        (&whole Whole)
        (&frame.cell (:key ?keys) (:P *Free))
        (&box.box (:key ?keys) (:B *Box))
        (inside (:A Free) (:B Box))
        (NOT (&cells_of.minimal (:t ?keys (:Cell Free)))))))
  (QUERY &q (?R (?keys *)) (&unfilled.size (:key ?keys) (:N 0)))
  (gives &q))

(fragment (inside (?R relation) (?b column ?R) (?G grid))
  "Each row with a grid's cells inside its box."
  (QUERY &in
    (?R (?b *))
    (?G (:P *Cell) (:Col *Color))
    (inside (:A Cell) (:B ?b)))
  (QUERY &q (?R (*others ?R)) (&in ?b (:Cell (*new P ?R)) (:Color (*new Col ?R))))
  (gives &q))

(fragment (box-extent (?R relation) (?b column ?R) (?G grid))
  "Each row with its box's extent on each axis, by a grid's extents."
  (QUERY &e
    (?R (?b *))
    (?G (:P *Cell))
    (box_extent (:B ?b) (:P Cell) (:A *Axis) (:N *Long))
    (ALL ((box_extent (:B ?b) (:P Cell) (:A *Other) (:N *Length)))
      ((> Length 0))))
  (QUERY &q (?R (*others ?R)) (&e ?b (:Axis (*new A ?R)) (:Long (*new N ?R))))
  (gives &q))

(fragment (box-margin (?R relation) (?b column ?R))
  "Each row with its box's margin on each edge."
  (QUERY &q (?R (*others ?R)) (margin (:B ?b) (:D (*new D ?R)) (:K (*new K ?R))))
  (gives &q))

(fragment (frame-extent (?R relation) (?p column ?R))
  "The extents of the frames of a column's cells."
  (QUERY &e (?R (?p *)) (frame_extent (:P ?p) *A *N))
  (QUERY &q (&e *A *N))
  (gives &q))

(fragment (displacement (?R relation) (?p column ?R) (?x column ?R))
  "Each row with the move from one cell to another of its frame."
  (QUERY &q
    (?R (*others ?R))
    (relative (:Base ?p) (:X ?x) (:X_rel (*new V ?R)))
    (ALL ((frame_extent (:P ?p) (:A *Axis) (:N *Long)))
      ((frame_extent (:P ?x) (:A Axis) (:N Long)))))
  (gives &q))

(fragment (full-lines (?R relation) (?keys columns ?R) (?p column ?R))
  "A key's whole rows and columns, by the frame of its cells."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &on_line Cardinality
    (key ((?R (?keys ^) (?p *)) (split (:P ?p) (:A ^Axis) (:Along ^Line)))
      (member ((:m Cell))
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (split (:P Cell) (:A Axis) (:Along Line)))))
  (INIT &whole Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t (:Axis Axis) (:Line Line)))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (split (:P Cell) (:A *Axis) (:Along *Line))
        (perp (:A Axis) (:A2 *Across))
        (frame_extent (:P Cell) (:A Across) (:N *Long))
        (&on_line.size (:key ?keys Axis Line) (:N Long)))))
  (QUERY &q (?R (?keys *)) (&whole.minimal (:key ?keys) (:t (:Axis (*new A ?R)) (:Line (*new Along ?R)))))
  (gives &q))

(fragment (box-sides (?R relation) (?keys columns ?R) (?p column ?R))
  "The extent of the box of each key's cells on each axis."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (INIT &sides Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t (:Axis Axis) (:Long Long)))
        (&whole Whole)
        (&box.box (:key ?keys) (:B *Box))
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (box_extent (:B Box) (:P Cell) (:A *Axis) (:N *Long)))))
  (QUERY &q (?R (?keys *)) (&sides.minimal (:key ?keys) (:t (:Axis (*new A ?R)) (:Long (*new N ?R)))))
  (gives &q))

(fragment (box-margins (?R relation) (?keys columns ?R) (?p column ?R))
  "The margin of the box of each key's cells on each edge."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &box BoundingBox
    (key ((?R (?keys ^)) (&whole ^Whole))
      (cell ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (INIT &margins Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t (:Edge Edge) (:Margin Margin)))
        (&whole Whole)
        (&box.box (:key ?keys) (:B *Box))
        (margin (:B Box) (:D *Edge) (:K *Margin)))))
  (QUERY &q (?R (?keys *)) (&margins.minimal (:key ?keys) (:t (:Edge (*new D ?R)) (:Margin (*new K ?R)))))
  (gives &q))

;; What the boxes of a column say together in a frame. The frame is the one of
;; the cells of a column of a second relation: that relation's cell column
;; `?f`, or the cells of a grid. Each measure has a value only where the
;; second relation has a cell.

(fragment (frame-cells (?R relation) (?p column ?R))
  "Every cell of the frame of a column's cells."
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (QUERY &cells (&frame.cell (:P *Free)))
  (QUERY &q (&cells (:Free (*new P ?R))))
  (gives &q))

(fragment (one-box-cells (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The cells of the frame inside the box of a column, where the column has one box."
  (INIT &one Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (INIT &frame Frame
    (extent (A N)
      (?F (?f *))
      (frame_extent (:P ?f) *A *N)))
  (QUERY &in
    (&one.value (:v *Box))
    (&frame.cell (:P *P))
    (inside (:A P) (:B Box)))
  (QUERY &q (&in *P))
  (gives &q))

(fragment (boxes-least-margin (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The least margin that a box of a column has on any edge."
  (INIT &least Order
    (member ((:t Margin))
      (?R (?b *))
      (?F (?f *))
      (margin (:B ?b) (:D *Edge) (:K *Margin)))
    (score ((:t Margin) (:S Margin))
      (?R (?b *))
      (?F (?f *))
      (margin (:B ?b) (:D *Edge) (:K *Margin))))
  (QUERY &q (&least.minimal (:t *N)))
  (gives &q))

(fragment (boxes-edges-touched-max (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The most edges that one box of a column touches."
  (INIT &touched Cardinality
    (key ((?R (?b ^)) (?F (?f *)))
      (member ((:m Edge))
        (margin (:B ?b) (:D *Edge) (:K 0)))))
  (INIT &most Order
    (member ((:t N))
      (&touched.size (:key (?b *)) (:N *N)))
    (score ((:t N) (:S N))
      (&touched.size (:key (?b *)) (:N *N))))
  (QUERY &q (&most.maximal (:t *N)))
  (gives &q))

(fragment (boxes-edges-touched-min (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The fewest edges that one box of a column touches."
  (INIT &touched Cardinality
    (key ((?R (?b ^)) (?F (?f *)))
      (member ((:m Edge))
        (margin (:B ?b) (:D *Edge) (:K 0)))))
  (INIT &fewest Order
    (member ((:t N))
      (&touched.size (:key (?b *)) (:N *N)))
    (score ((:t N) (:S N))
      (&touched.size (:key (?b *)) (:N *N))))
  (QUERY &q (&fewest.minimal (:t *N)))
  (gives &q))

(fragment (boxes-centered-axes-max (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The most axes on which one box of a column has equal margins at its two edges."
  (INIT &centered Cardinality
    (key ((?R (?b ^)) (?F (?f *)))
      (member ((:m Axis))
        (dist_pair (:P ?b) (:D *Edge) (:K *Margin) (:K2 Margin))
        (axis_of (:D Edge) (:A *Axis)))))
  (INIT &most Order
    (member ((:t N))
      (&centered.size (:key (?b *)) (:N *N)))
    (score ((:t N) (:S N))
      (&centered.size (:key (?b *)) (:N *N))))
  (QUERY &q (&most.maximal (:t *N)))
  (gives &q))

(fragment (boxes-shorter-side-min (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The least extent of a box of a column on an axis, over the boxes that hold a cell on each axis."
  (INIT &least Order
    (member ((:t Length))
      (?R (?b *))
      (?F (?f *))
      (box_extent (:B ?b) (:P ?f) (:A *Axis) (:N *Length))
      (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
        ((> Each 0))))
    (score ((:t Length) (:S Length))
      (?R (?b *))
      (?F (?f *))
      (box_extent (:B ?b) (:P ?f) (:A *Axis) (:N *Length))
      (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
        ((> Each 0)))))
  (QUERY &q (&least.minimal (:t *N)))
  (gives &q))

(fragment (boxes-longer-side-max (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "The greatest extent of a box of a column on an axis, over the boxes that hold a cell on each axis."
  (INIT &most Order
    (member ((:t Length))
      (?R (?b *))
      (?F (?f *))
      (box_extent (:B ?b) (:P ?f) (:A *Axis) (:N *Length))
      (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
        ((> Each 0))))
    (score ((:t Length) (:S Length))
      (?R (?b *))
      (?F (?f *))
      (box_extent (:B ?b) (:P ?f) (:A *Axis) (:N *Length))
      (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
        ((> Each 0)))))
  (QUERY &q (&most.maximal (:t *N)))
  (gives &q))

(fragment (boxes-aligned (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether more than one box of a column has, on some axis, the same margins at both edges."
  (INIT &boxes Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (INIT &margin_at Singleton
    (key ((dir_elem (:D ^D)))
      (member ((:v Margin))
        (?R (?b *))
        (?F (?f *))
        (margin (:B ?b) (:D D) (:K *Margin)))))
  (QUERY &axes
    (axis_elem (:A *A))
    (ALL ((axis_of (:D *D) (:A A)))
      ((&margin_at.value (:key D)))))
  (QUERY &q (&boxes.plural) (&axes))
  (gives &q))

(fragment (boxes-one-size (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether more than one box of a column is given and every box that holds a cell on each axis has one extent on each axis."
  (INIT &boxes Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (INIT &extent_at Singleton
    (key ((axis_elem (:A ^A)))
      (member ((:v Length))
        (?R (?b *))
        (?F (?f *))
        (box_extent (:B ?b) (:P ?f) (:A A) (:N *Length))
        (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
          ((> Each 0))))))
  (QUERY &sized
    (&boxes.plural)
    (ALL ((axis_elem (:A *A)))
      ((&extent_at.value (:key A)))))
  (QUERY &q (&sized))
  (gives &q))

(fragment (boxes-some-overlap (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether two boxes of a column hold one cell of the frame."
  (INIT &frame Frame
    (extent (A N)
      (?F (?f *))
      (frame_extent (:P ?f) *A *N)))
  (INIT &holders Singleton
    (key ((&frame.cell (:P ^Cell)))
      (member ((:v ?b))
        (?R (?b *))
        (inside (:A Cell) (:B ?b)))))
  (QUERY &shared (&holders.plural (:key *Cell)))
  (QUERY &q (&shared))
  (gives &q))

(fragment (boxes-nested (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether one box of a column lies in another box of it, over the boxes that hold a cell on each axis."
  (QUERY &inner
    (?R (?b *))
    (?F (?f *))
    (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
      ((> Each 0)))
    (= *Inner ?b))
  (QUERY &outer
    (?R (?b *))
    (?F (?f *))
    (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
      ((> Each 0)))
    (= *Outer ?b))
  (QUERY &within
    (&inner *Inner)
    (&outer *Outer)
    (!= Inner Outer)
    (inside (:A Inner) (:B Outer)))
  (QUERY &q (&within))
  (gives &q))

(fragment (boxes-cover-frame (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether more than one box of a column is given and every cell of the frame is in one."
  (INIT &boxes Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (INIT &frame Frame
    (extent (A N)
      (?F (?f *))
      (frame_extent (:P ?f) *A *N)))
  (QUERY &covered
    (&boxes.plural)
    (ALL ((&frame.cell (:P *Cell)))
      ((?R (?b *))
       (inside (:A Cell) (:B ?b)))))
  (QUERY &q (&covered))
  (gives &q))

(fragment (boxes-evenly-spaced (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether the boxes of a column that hold a cell on each axis lie on three or more distinct lines along an axis, no two of them overlapping there, with one gap between each line and the next."
  (QUERY &bands
    (?R (?b *))
    (?F (?f *))
    (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
      ((> Each 0)))
    (split (:P ?b) (:A *Axis) (:Along *Band)))
  (INIT &along Order
    (key ((dir_elem (:D ^D)))
      (member ((:t Band))
        (axis_of (:D D) (:A *Axis))
        (&bands (:Axis Axis) (:Band *Band)))
      (before ((:a X) (:b Y))
        (axis_of (:D D) (:A *Axis))
        (&bands (:Axis Axis) (:Band *X))
        (&bands (:Axis Axis) (:Band *Y))
        (nearer (:D D) (:P X) (:Q Y)))))
  (QUERY &gaps
    (&along.successor (:key *D) (:a *X) (:b *Y))
    (?F (?f *))
    (axis_of (:D D) (:A *Axis))
    (box_extent (:B X) (:P ?f) (:A Axis) (:N *Long))
    (opposite (:D D) (:Opp *Away))
    (jump_offset (:D Away) (:K Long) (:V *Move))
    (compose (:A X) (:B Move) (:C *Moved))
    (relative (:Base Moved) (:X Y) (:X_rel *Between))
    (margin (:B Between) (:D D) (:K *Gap)))
  (INIT &steady Singleton
    (key ((dir_elem (:D ^D)))
      (member ((:v Gap))
        (&gaps (:D D) (:Gap *Gap)))))
  (QUERY &overlapping (&gaps *D *Gap) (< Gap 0))
  (QUERY &chain
    (&along.successor (:key *D) (:a *X) (:b *Y))
    (&along.successor (:key D) (:a Y) (:b *Z)))
  (QUERY &even
    (&steady.value (:key *D) (:v *Gap))
    (&chain D)
    (NOT (&overlapping D)))
  (QUERY &q (&even))
  (gives &q))

(fragment (boxes-every-square (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether a box of a column holds a cell on each axis and every such box has one extent on both axes."
  (INIT &side Singleton
    (key ((?R (?b ^))
          (?F (?f *))
          (ALL ((box_extent (:B ?b) (:P ?f) (:A *Other) (:N *Each)))
            ((> Each 0))))
      (member ((:v Length))
        (?F (?f *))
        (box_extent (:B ?b) (:P ?f) (:A *Axis) (:N *Length)))))
  (QUERY &square (&side.value (:key (?b *))))
  (QUERY &skew (&side.plural (:key (?b *))))
  (QUERY &q (&square) (NOT (&skew)))
  (gives &q))

(fragment (boxes-more-than-one-cell (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether a column has one box and it is longer than one cell on each axis."
  (INIT &one Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (QUERY &long
    (&one.value (:v *Box))
    (?F (?f *))
    (ALL ((axis_elem (:A *Axis)))
      ((box_extent (:B ?f) (:P ?f) (:A Axis) (:N *Cell))
       (box_extent (:B Box) (:P ?f) (:A Axis) (:N *Length))
       (> Length Cell))))
  (QUERY &q (&long))
  (gives &q))

(fragment (boxes-whole-frame (?R relation) (?b column ?R) (?F relation) (?f column ?F))
  "Whether a column has one box and it has margin 0 on every edge."
  (INIT &one Singleton
    (member ((:v ?b))
      (?R (?b *))))
  (QUERY &whole
    (&one.value (:v *Box))
    (?F (?f *))
    (ALL ((dir_elem (:D *Edge)))
      ((margin (:B Box) (:D Edge) (:K 0)))))
  (QUERY &q (&whole))
  (gives &q))

(fragment (complement-parts (?R relation) (?p column ?R))
  "The count of parts, by four steps, of the cells of a column's frame that it does not hold."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (INIT &parts Connectivity
    (node ((:P Free))
      (&frame.cell (:P *Free))
      (NOT (&have.minimal (:t Free)))))
  (INIT &c Cardinality
    (member ((:m Id))
      (&parts.component *Id)))
  (QUERY &held (?R (?p *)))
  (QUERY &q (&held) (&c.size *N))
  (gives &q))

(fragment (every-part-straight (?R relation) (?p column ?R))
  "Whether each part of a column's cells, by eight steps, lies on one row, column or diagonal."
  (INIT &parts Connectivity
    (node ((:P ?p))
      (?R (?p *)))
    (step ((:Delta V))
      (step_offset *V)))
  (INIT &off Cardinality
    (key ((&parts.component (:Id ^Part)) (axis4_elem (:A ^Line)))
      (member ((:m (:X X) (:Y Y)))
        (&parts.component (:Id Part) (:P *X))
        (&parts.component (:Id Part) (:P *Y))
        (NOT (same_line (:A Line) (:P X) (:Q Y))))))
  (INIT &on Cardinality
    (key ((&parts.component (:Id ^Part)) (axis4_elem (:A *Line)) (&off.size (:key Part Line) (:N 0)))))
  (QUERY &q
    (ALL ((&parts.component (:Id *Part)))
      ((&on.size (:key Part)))))
  (gives &q))

(fragment (outlines-box (?R relation) (?p column ?R))
  "Whether the cells of a column are the cells of the outline of their box."
  (INIT &box BoundingBox
    (cell ((:P ?p))
      (?R (?p *))))
  (INIT &drawn Outlines
    (node ((:P ?p))
      (?R (?p *))))
  (QUERY &outline
    (&box.box (:B *Box))
    (&drawn.box (:B Box))
    (ALL ((?R (?p *)))
      ((NOT (interior (:A ?p) (:B Box))))))
  (QUERY &q (&outline))
  (gives &q))

(fragment (line-spacings (?R relation) (?p column ?R))
  "On each axis, how many distinct offsets lie between each line that holds a cell of a column and the next line."
  (QUERY &lines
    (?R (?p *))
    (split (:P ?p) (:A *Axis) (:Along *Line)))
  (INIT &along Order
    (key ((dir_elem (:D ^D)))
      (member ((:t Line))
        (axis_of (:D D) (:A *Axis))
        (&lines (:Axis Axis) (:Line *Line)))
      (before ((:a X) (:b Y))
        (axis_of (:D D) (:A *Axis))
        (&lines (:Axis Axis) (:Line *X))
        (&lines (:Axis Axis) (:Line *Y))
        (nearer (:D D) (:P X) (:Q Y)))))
  (QUERY &steps
    (&along.successor (:key *D) (:a *X) (:b *Y))
    (relative (:Base X) (:X Y) (:X_rel *Step)))
  (INIT &spacings Cardinality
    (key ((axis_of (:D ^D) (:A ^A)) (&lines (:Axis A)))
      (member ((:m Step))
        (&steps (:D D) (:Step *Step)))))
  (QUERY &q (&spacings.size (:key (:A *A)) (:N *N)))
  (gives &q))

(fragment (directions-on-one-axis (?R relation) (?d column ?R))
  "Whether the directions of a column lie on one axis."
  (INIT &axes Singleton
    (member ((:v Axis))
      (?R (?d *))
      (axis4_of (:D ?d) (:A *Axis))))
  (QUERY &one (&axes.value (:v *Axis)))
  (QUERY &q (&one))
  (gives &q))

(fragment (directions-opposite-pair (?R relation) (?d column ?R))
  "Whether a column has two directions that are opposite."
  (INIT &have Order
    (member ((:t ?d))
      (?R (?d *))))
  (QUERY &met
    (&have.minimal (:t *Dir))
    (dir8_opposite (:D Dir) (:D2 *Opp))
    (&have.minimal (:t Opp)))
  (QUERY &q (&met))
  (gives &q))

(fragment (offsets-one-length (?R relation) (?v column ?R))
  "Whether every offset of a column has the same length, the greater of its two moves."
  (INIT &length Order
    (key ((?R (?v ^)))
      (member ((:t Margin))
        (margin (:B ?v) (:D *Edge) (:K *Margin)))
      (score ((:t Margin) (:S Margin))
        (margin (:B ?v) (:D *Edge) (:K *Margin)))))
  (INIT &lengths Singleton
    (member ((:v Margin))
      (?R (?v *))
      (&length.maximal (:key ?v) (:t *Margin))))
  (QUERY &one (&lengths.value (:v *Margin)))
  (QUERY &q (&one))
  (gives &q))

(fragment (values-consecutive (?R relation) (?n column ?R))
  "Whether each distinct value of a number column is one more than the value before it, with at least two values."
  (INIT &have Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (QUERY &q
    (ALL ((&have.successor (:a *Low) (:b *High)))
      ((dir_elem (:D *Toward))
       (jump_offset (:D Toward) (:K Low) (:V *Before))
       (step_offset (:D Toward) (:V *Step))
       (compose (:A Before) (:B Step) (:C *After))
       (jump_offset (:D Toward) (:K High) (:V After)))))
  (gives &q))

(fragment (values-arithmetic (?R relation) (?n column ?R))
  "Whether three or more distinct values of a number column are each the same step from the value before."
  (INIT &have Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (QUERY &chain
    (&have.successor (:a *First) (:b *Second))
    (&have.successor (:a Second) (:b *Third)))
  (INIT &gaps Singleton
    (key ((dir_elem (:D ^Toward)))
      (member ((:v Gap))
        (&have.successor (:a *Low) (:b *High))
        (jump_offset (:D Toward) (:K Low) (:V *Before))
        (jump_offset (:D Toward) (:K High) (:V *After))
        (relative (:Base Before) (:X After) (:X_rel *Gap)))))
  (QUERY &steady (&gaps.value (:key *Toward) (:v *Gap)))
  (QUERY &q (&chain) (&steady))
  (gives &q))

(fragment (extents-distinct (?R relation) (?p column ?R))
  "The count of distinct extents of the frames of a column's cells."
  (INIT &frames Cardinality
    (key ((axis_elem (:A ^A)) (?R (?p *)))
      (member ((:m N1 N2))
        (?R (?p *))
        (axis_extents (:P ?p) (:A A) (:N1 *N1) (:N2 *N2)))))
  (QUERY &q (&frames.size (:N *N)))
  (gives &q))

(fragment (line-counts (?R relation) (?keys columns ?R) (?p column ?R))
  "Each key's cells on each of its rows and columns."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &on_line Cardinality
    (key ((?R (?keys ^) (?p *)) (split (:P ?p) (:A ^Axis) (:Along ^Line)))
      (member ((:m Cell))
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))
        (split (:P Cell) (:A Axis) (:Along Line)))))
  (QUERY &q (?R (?keys *)) (&on_line.size (:key ?keys (:Axis (*new A ?R)) (:Line (*new Along ?R))) (:N (*new N ?R))))
  (gives &q))

(fragment (complement (?R relation) (?p column ?R))
  "The cells of a column's frame that it does not hold."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (QUERY &free (&frame.cell (:P *Free)) (NOT (&have.minimal (:t Free))))
  (QUERY &q (&free (:Free (*new P ?R))))
  (gives &q))

(fragment (straight-axis (?R relation) (?keys columns ?R) (?p column ?R))
  "Each key with an axis whose line holds all its cells."
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &off Cardinality
    (key ((?R (?keys ^)) (axis_elem (:A ^Line)))
      (member ((:m (:X X) (:Y Y)))
        (&cells_of.minimal (:t ?keys (:Cell *X)))
        (&cells_of.minimal (:t ?keys (:Cell *Y)))
        (NOT (same_line (:A Line) (:P X) (:Q Y))))))
  (QUERY &q (?R (?keys *)) (&off.size (:key ?keys (:Line (*new A ?R))) (:N 0)))
  (gives &q))

(fragment (cell-count (?R relation) (?keys columns ?R) (?p column ?R))
  "The distinct cells per value of the key columns."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &c Cardinality
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:m Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell))))))
  (QUERY &q (?R (?keys *)) (&c.size (:key ?keys) (:N (*new N ?R))))
  (gives &q))

(fragment (group-gap (?R relation) (?keys columns ?R) (?p column ?R))
  "The fewest eight-neighbor steps from each key's cells to a cell of the column that the key does not hold."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (INIT &d CellDistance
    (key ((?R (?keys ^)) (&whole ^Whole))
      (node ((:P Free))
        (&whole Whole)
        (&frame.cell (:P *Free)))
      (source ((:P Cell))
        (&whole Whole)
        (&cells_of.minimal (:t ?keys (:Cell *Cell)))))
    (step ((:Delta V))
      (step_offset *V)))
  (INIT &every_cell Order
    (member ((:t ?p))
      (?R (?p *))))
  (INIT &near Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t K))
        (&whole Whole)
        (&every_cell.minimal (:t *Other))
        (&d.distance (:key ?keys) (:P Other) *K)
        (NOT (&cells_of.minimal (:t ?keys (:Cell Other)))))
      (score ((:t K) (:S K))
        (&whole Whole)
        (&every_cell.minimal (:t *Other))
        (&d.distance (:key ?keys) (:P Other) *K)
        (NOT (&cells_of.minimal (:t ?keys (:Cell Other)))))))
  (QUERY &q (?R (?keys *)) (&near.minimal (:key ?keys) (:t (*new N ?R))))
  (gives &q))

(fragment (box-cells (?R relation) (?p column ?R))
  "The cells of a column's frame inside the box of its cells."
  (INIT &box BoundingBox
    (cell ((:P ?p))
      (?R (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (QUERY &in
    (&frame.cell (:P *Free))
    (&box.box *B)
    (inside (:A Free) (:B B)))
  (QUERY &q (&in (:Free (*new P ?R))))
  (gives &q))

(fragment (outside-box (?R relation) (?p column ?R))
  "The cells of a column's frame outside the box of its cells."
  (INIT &box BoundingBox
    (cell ((:P ?p))
      (?R (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (QUERY &out
    (&frame.cell (:P *Free))
    (&box.box *B)
    (NOT (inside (:A Free) (:B B))))
  (QUERY &q (&out (:Free (*new P ?R))))
  (gives &q))

(fragment (hole-cells (?R relation) (?p column ?R))
  "The cells of a column's frame that its cells enclose."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (INIT &frame Frame
    (extent (A N)
      (?R (?p *))
      (frame_extent (:P ?p) *A *N)))
  (INIT &enclosed Enclosure
    (cell ((:P Free))
      (&frame.cell (:P *Free))
      (NOT (&have.minimal (:t Free)))))
  (QUERY &q (&enclosed.enclosed (:P (*new P ?R))))
  (gives &q))

(fragment (product (?R relation) (?keys columns ?R))
  "Whether a relation's rows are each key with each value of its other columns, with at least two of each."
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &key_values Singleton
    (member ((:v ?keys))
      (?R (?keys *))))
  (INIT &other_values Singleton
    (member ((:v (others ?R ?keys)))
      (?R (*others ?R ?keys))))
  (QUERY &q
    (&key_values.plural)
    (&other_values.plural)
    (ALL ((?R (?keys *)) (?R (*others ?R ?keys)))
      ((&rows.minimal (:t ?keys (others ?R ?keys))))))
  (gives &q))

(fragment (straight (?R relation) (?keys columns ?R) (?p column ?R))
  "The keys whose cells lie on one row, one column or one diagonal."
  (INIT &cells_of Order
    (member ((:t ?keys (:Cell ?p)))
      (?R (?keys *) (?p *))))
  (INIT &off Cardinality
    (key ((?R (?keys ^)) (axis4_elem (:A ^Line)))
      (member ((:m (:X X) (:Y Y)))
        (&cells_of.minimal (:t ?keys (:Cell *X)))
        (&cells_of.minimal (:t ?keys (:Cell *Y)))
        (NOT (same_line (:A Line) (:P X) (:Q Y))))))
  (INIT &on Cardinality
    (key ((?R (?keys ^)) (axis4_elem (:A *Line)) (&off.size (:key ?keys Line) (:N 0)))))
  (QUERY &q (?R (?keys *)) (&on.size (:key ?keys)))
  (gives &q))

(fragment (occurs (?R relation) (?keys columns ?R) (?p column ?R) (?v column ?R) (?G grid))
  "The moves that take a key's colored cells into a grid."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &o Occurrences
    (key ((?R (?keys ^)) (&whole ^Whole))
      (shape ((:P ?p) (:v ?v))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys)))))
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &q (?R (?keys *)) (&o.occurrence (:key ?keys) (:P (*new V ?R))))
  (gives &q))

(fragment (occurs-d4 (?R relation) (?keys columns ?R) (?p column ?R) (?v column ?R) (?G grid))
  "The moves that take an image of a key's colored cells into a grid."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &rows Order
    (member ((:t (others ?R)))
      (?R (*others ?R))))
  (INIT &o Occurrences
    (key ((?R (?keys ^)) (&whole ^Whole))
      (shape ((:P ?p) (:v ?v))
        (&whole Whole)
        (&rows.minimal (:t ?keys (*others ?R ?keys)))))
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col)))
    (transform (D)
      (d4_elem *D)))
  (INIT &moves Order
    (key ((?R (?keys ^)) (&whole ^Whole))
      (member ((:t Move))
        (&whole Whole)
        (&o.occurrence (:key ?keys) (:P *Move)))))
  (QUERY &q (?R (?keys *)) (&moves.minimal (:key ?keys) (:t (*new V ?R))))
  (gives &q))

(fragment (shared-line (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "The first relation's rows with a cell of the second on a row or a column."
  (QUERY &met
    (?L (?a *))
    (?S (?b *))
    (axis_elem (:A *Axis))
    (same_line (:A Axis) (:P ?a) (:Q ?b)))
  (QUERY &q (?L (*others ?L)) (&met ?a))
  (gives &q))

(fragment (distance (?R relation) (?p column ?R) (?G grid))
  "The fewest eight-neighbor steps from a relation's cells over a grid."
  (INIT &d CellDistance
    (node (P)
      (?G (:P *P)))
    (source ((:P ?p))
      (?R (?p *))
      (?G (:P ?p)))
    (step ((:Delta V))
      (step_offset *V)))
  (QUERY &q (&d.distance *P *K))
  (gives &q))

(fragment (box-kept (?R relation) (?b column ?R))
  "A column of boxes read against the two grids: each input cell of a box whose color stands at its place in the output."
  (QUERY &read
    (?R (?b *))
    (input (:P *Cell) (:Col *Col))
    (inside (:A Cell) (:B ?b))
    (relative (:Base ?b) (:X Cell) (:X_rel *Place))
    (output (:P Place) (:Col *Col_2)))
  (QUERY &q
    (?R (?b *))
    (&read ?b (:Cell (*new P ?R)) (:Place (*new X_rel ?R)) *Col (:Col_2 Col)))
  (gives &q))

(fragment (box-changed (?R relation) (?b column ?R))
  "A column of boxes read against the two grids: each input cell of a box whose color differs at its place in the output."
  (QUERY &read
    (?R (?b *))
    (input (:P *Cell) (:Col *Col))
    (inside (:A Cell) (:B ?b))
    (relative (:Base ?b) (:X Cell) (:X_rel *Place))
    (output (:P Place) (:Col *Col_2)))
  (QUERY &q
    (?R (?b *))
    (&read ?b (:Cell (*new P ?R)) (:Place (*new X_rel ?R)) *Col *Col_2)
    (!= Col Col_2))
  (gives &q))

(fragment (box-frame-kept (?R relation) (?b column ?R) (?x column ?R))
  "As `box-kept`, on a column of cells of a box's frame."
  (QUERY &read
    (?R (?b *) (?x *))
    (output (:P ?x) (:Col *Col_2))
    (compose (:A ?x) (:B ?b) (:C *Place))
    (input (:P Place) (:Col *Col)))
  (QUERY &q
    (?R (?b *) (?x *))
    (&read ?b ?x (:Place (*new P ?R)) *Col (:Col_2 Col)))
  (gives &q))

(fragment (box-frame-changed (?R relation) (?b column ?R) (?x column ?R))
  "As `box-changed`, on a column of cells of a box's frame."
  (QUERY &read
    (?R (?b *) (?x *))
    (output (:P ?x) (:Col *Col_2))
    (compose (:A ?x) (:B ?b) (:C *Place))
    (input (:P Place) (:Col *Col)))
  (QUERY &q
    (?R (?b *) (?x *))
    (&read ?b ?x (:Place (*new P ?R)) *Col *Col_2)
    (!= Col Col_2))
  (gives &q))

(fragment (box-cell-kept (?R relation) (?b column ?R) (?x column ?R))
  "As `box-kept`, on a column of input cells."
  (QUERY &read
    (?R (?b *) (?x *))
    (input (:P ?x) (:Col *Col))
    (relative (:Base ?b) (:X ?x) (:X_rel *Place))
    (output (:P Place) (:Col *Col_2)))
  (QUERY &q
    (?R (?b *) (?x *))
    (&read ?b ?x (:Place (*new X_rel ?R)) *Col (:Col_2 Col)))
  (gives &q))

(fragment (box-cell-changed (?R relation) (?b column ?R) (?x column ?R))
  "As `box-changed`, on a column of input cells."
  (QUERY &read
    (?R (?b *) (?x *))
    (input (:P ?x) (:Col *Col))
    (relative (:Base ?b) (:X ?x) (:X_rel *Place))
    (output (:P Place) (:Col *Col_2)))
  (QUERY &q
    (?R (?b *) (?x *))
    (&read ?b ?x (:Place (*new X_rel ?R)) *Col *Col_2)
    (!= Col Col_2))
  (gives &q))

;; A pair's diff: the cells of one grid that the other does not hold with their color.

(fragment (output-diff)
  "The output's cells that the input does not hold with their color."
  (QUERY &q (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (gives &q))

(fragment (on-output-diff (?R relation) (?p column ?R))
  "A relation's rows whose cell is in the output's diff."
  (QUERY &diff (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (QUERY &q (?R (*others ?R)) (&diff (:P ?p)))
  (gives &q))

(fragment (off-output-diff (?R relation) (?p column ?R))
  "A relation's rows whose cell is not in the output's diff."
  (QUERY &diff (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (QUERY &q (?R (*others ?R)) (NOT (&diff (:P ?p))))
  (gives &q))

(fragment (output-diff-on (?R relation) (?p column ?R))
  "The cells of the output's diff at a relation's cells."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &diff (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (QUERY &q (&diff *P *Col) (&have.minimal (:t P)))
  (gives &q))

(fragment (output-diff-off (?R relation) (?p column ?R))
  "The cells of the output's diff off a relation's cells."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &diff (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (QUERY &q (&diff *P *Col) (NOT (&have.minimal (:t P))))
  (gives &q))

(fragment (input-diff)
  "The input's cells that the output does not hold with their color."
  (QUERY &q (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (gives &q))

(fragment (on-input-diff (?R relation) (?p column ?R))
  "A relation's rows whose cell is in the input's diff."
  (QUERY &diff (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (QUERY &q (?R (*others ?R)) (&diff (:P ?p)))
  (gives &q))

(fragment (off-input-diff (?R relation) (?p column ?R))
  "A relation's rows whose cell is not in the input's diff."
  (QUERY &diff (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (QUERY &q (?R (*others ?R)) (NOT (&diff (:P ?p))))
  (gives &q))

(fragment (input-diff-on (?R relation) (?p column ?R))
  "The cells of the input's diff at a relation's cells."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &diff (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (QUERY &q (&diff *P *Col) (&have.minimal (:t P)))
  (gives &q))

(fragment (input-diff-off (?R relation) (?p column ?R))
  "The cells of the input's diff off a relation's cells."
  (INIT &have Order
    (member ((:t ?p))
      (?R (?p *))))
  (QUERY &diff (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (QUERY &q (&diff *P *Col) (NOT (&have.minimal (:t P))))
  (gives &q))

(fragment (groups-off-output-diff (?R relation) (?keys columns ?R) (?p column ?R))
  "The keys of a relation with no cell in the output's diff."
  (QUERY &diff (output (:P *P) (:Col *Col)) (NOT (input (:P P) (:Col Col))))
  (INIT &touching Cardinality
    (key ((?R (?keys ^) (?p *)) (&diff (:P ?p)))))
  (QUERY &q (?R (?keys *)) (NOT (&touching.size (:key ?keys))))
  (gives &q))

(fragment (groups-off-input-diff (?R relation) (?keys columns ?R) (?p column ?R))
  "The keys of a relation with no cell in the input's diff."
  (QUERY &diff (input (:P *P) (:Col *Col)) (NOT (output (:P P) (:Col Col))))
  (INIT &touching Cardinality
    (key ((?R (?keys ^) (?p *)) (&diff (:P ?p)))))
  (QUERY &q (?R (?keys *)) (NOT (&touching.size (:key ?keys))))
  (gives &q))

;; On grids of one extent, how the changed cells of the input stand to those of the output, and the periods of a grid.

(fragment (diff-moves)
  "Each move with the count of the input's changed cells that it lands on changed output cells of their color."
  (QUERY &from (input (:P *P) (:Col *Col)) (output (:P P) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &to (output (:P *Q) (:Col *Col)) (input (:P Q) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &moved (&from *P *Col) (&to *Q Col) (relative (:Base P) (:X Q) *X_rel))
  (INIT &counts Cardinality
    (key ((&moved (:X_rel ^V)))
      (member ((:m P))
        (&moved *P (:X_rel V)))))
  (QUERY &q (&counts.size (:key *V) *N))
  (gives &q))

(fragment (best-moves)
  "The moves that land the most of the input's changed cells. Under a tie, every tied move."
  (QUERY &from (input (:P *P) (:Col *Col)) (output (:P P) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &to (output (:P *Q) (:Col *Col)) (input (:P Q) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &moved (&from *P *Col) (&to *Q Col) (relative (:Base P) (:X Q) *X_rel))
  (INIT &counts Cardinality
    (key ((&moved (:X_rel ^V)))
      (member ((:m P))
        (&moved *P (:X_rel V)))))
  (INIT &order Order
    (member ((:t V))
      (&counts.size (:key *V)))
    (score ((:t V) (:S N))
      (&counts.size (:key *V) *N)))
  (QUERY &q (&order.maximal (:t *V)))
  (gives &q))

(fragment (best-move-landed)
  "The count of changed cells that a best move lands."
  (QUERY &from (input (:P *P) (:Col *Col)) (output (:P P) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &to (output (:P *Q) (:Col *Col)) (input (:P Q) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &moved (&from *P *Col) (&to *Q Col) (relative (:Base P) (:X Q) *X_rel))
  (INIT &counts Cardinality
    (key ((&moved (:X_rel ^V)))
      (member ((:m P))
        (&moved *P (:X_rel V)))))
  (QUERY &landed (&counts.size *N))
  (INIT &most Order
    (member ((:t N))
      (&landed *N))
    (score ((:t N) (:S N))
      (&landed *N)))
  (QUERY &q (&most.maximal (:t *N)))
  (gives &q))

(fragment (best-move-size)
  "How far a best move goes: the greatest count of steps along an axis."
  (QUERY &from (input (:P *P) (:Col *Col)) (output (:P P) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &to (output (:P *Q) (:Col *Col)) (input (:P Q) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &moved (&from *P *Col) (&to *Q Col) (relative (:Base P) (:X Q) *X_rel))
  (INIT &counts Cardinality
    (key ((&moved (:X_rel ^V)))
      (member ((:m P))
        (&moved *P (:X_rel V)))))
  (INIT &order Order
    (member ((:t V))
      (&counts.size (:key *V)))
    (score ((:t V) (:S N))
      (&counts.size (:key *V) *N)))
  (QUERY &steps (&order.maximal (:t *V)) (margin (:B V) *K))
  (INIT &most Order
    (member ((:t K))
      (&steps *K))
    (score ((:t K) (:S K))
      (&steps *K)))
  (QUERY &q (&most.maximal (:t *K)))
  (gives &q))

(fragment (best-move-cells)
  "The input's changed cells that a best move lands, with the move."
  (QUERY &from (input (:P *P) (:Col *Col)) (output (:P P) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &to (output (:P *Q) (:Col *Col)) (input (:P Q) (:Col *Col_2)) (!= Col Col_2))
  (QUERY &moved (&from *P *Col) (&to *Q Col) (relative (:Base P) (:X Q) *X_rel))
  (INIT &counts Cardinality
    (key ((&moved (:X_rel ^V)))
      (member ((:m P))
        (&moved *P (:X_rel V)))))
  (INIT &order Order
    (member ((:t V))
      (&counts.size (:key *V)))
    (score ((:t V) (:S N))
      (&counts.size (:key *V) *N)))
  (QUERY &q (&moved *P *Col (:X_rel *V)) (&order.maximal (:t V)))
  (gives &q))

(fragment (periods (?G grid))
  "The moves along an axis that take the grid onto itself, wherever both cells exist."
  (INIT &periods Periods
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &q (&periods.period *A *K))
  (gives &q))

(fragment (fundamental-periods (?G grid))
  "The least period along each axis."
  (INIT &periods Periods
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &q (&periods.fundamental_period *A *K))
  (gives &q))

(fragment (approximate-periods (?G grid))
  "The moves along an axis that break no more line pairs than they keep."
  (INIT &periods Periods
    (cell (P (:v Col))
      (?G (:P *P) (:Col *Col))))
  (QUERY &q (&periods.approximate_period *A *K))
  (gives &q))

(fragment (shared-periods)
  "The periods that the two grids share along an axis."
  (INIT &in Periods
    (cell (P (:v Col))
      (input (:P *P) (:Col *Col))))
  (INIT &out Periods
    (cell (P (:v Col))
      (output (:P *P) (:Col *Col))))
  (QUERY &q (&in.period *A *K) (&out.period A K))
  (gives &q))

(fragment (shared-fundamental-periods)
  "The lengths that are a least period of each grid, along any axis of it."
  (INIT &in Periods
    (cell (P (:v Col))
      (input (:P *P) (:Col *Col))))
  (INIT &out Periods
    (cell (P (:v Col))
      (output (:P *P) (:Col *Col))))
  (QUERY &q (&in.fundamental_period *K) (&out.fundamental_period K))
  (gives &q))

;; How two tables of a state stand to each other.

(fragment (same-values (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether a column of each of two relations holds the same values."
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &in_first Order
    (member ((:t ?a))
      (?L (?a *))))
  (QUERY &q
    (ALL ((?L (?a *)))
      ((&in_second.minimal (:t ?a))))
    (ALL ((?S (?b *)))
      ((&in_first.minimal (:t ?b)))))
  (gives &q))

(fragment (inside-boxes (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "The first relation's rows with a cell inside a box of the second."
  (QUERY &met
    (?L (?a *))
    (?S (?b *))
    (inside (:A ?a) (:B ?b)))
  (QUERY &q (?L (*others ?L)) (&met ?a))
  (gives &q))

;; How two relations stand to each other as sets of values, as counts of rows, as groups of cells, and in the cells that both hold.

(fragment (set-subset (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether every value of a column of the first relation is a value of a column of the second, which has a value more."
  (INIT &in_first Order
    (member ((:t ?a))
      (?L (?a *))))
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (QUERY &extra
    (?S (?b *))
    (NOT (&in_first.minimal (:t ?b))))
  (QUERY &q
    (ALL ((?L (?a *)))
      ((&in_second.minimal (:t ?a))))
    (&extra))
  (gives &q))

(fragment (set-overlap (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether two relations' columns share a value, and each has a value that the other lacks."
  (INIT &in_first Order
    (member ((:t ?a))
      (?L (?a *))))
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (QUERY &only_first
    (?L (?a *))
    (NOT (&in_second.minimal (:t ?a))))
  (QUERY &only_second
    (?S (?b *))
    (NOT (&in_first.minimal (:t ?b))))
  (QUERY &shared
    (?L (?a *))
    (&in_second.minimal (:t ?a)))
  (QUERY &q (&only_first) (&only_second) (&shared))
  (gives &q))

(fragment (set-disjoint (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether the first relation has a row and no value of its column is a value of a column of the second."
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (QUERY &q
    (ALL ((?L (?a *)))
      ((NOT (&in_second.minimal (:t ?a))))))
  (gives &q))

(fragment (cells-disjoint (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether two columns of cells share no cell and leave a cell of the first column's frame in neither."
  (INIT &in_first Order
    (member ((:t ?a))
      (?L (?a *))))
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &frame Frame
    (extent (A N)
      (?L (?a *))
      (frame_extent (:P ?a) *A *N)))
  (QUERY &free
    (&frame.cell (:P *Free))
    (NOT (&in_first.minimal (:t Free)))
    (NOT (&in_second.minimal (:t Free))))
  (QUERY &q
    (ALL ((?L (?a *)))
      ((NOT (&in_second.minimal (:t ?a)))))
    (&free))
  (gives &q))

(fragment (cells-complement (?L relation) (?S relation) (?a column ?L) (?b column ?S))
  "Whether two columns of cells share no cell and every cell of the first column's frame is in one of them."
  (INIT &in_first Order
    (member ((:t ?a))
      (?L (?a *))))
  (INIT &in_second Order
    (member ((:t ?b))
      (?S (?b *))))
  (INIT &frame Frame
    (extent (A N)
      (?L (?a *))
      (frame_extent (:P ?a) *A *N)))
  (QUERY &free
    (&frame.cell (:P *Free))
    (NOT (&in_first.minimal (:t Free)))
    (NOT (&in_second.minimal (:t Free))))
  (QUERY &q
    (ALL ((?L (?a *)))
      ((NOT (&in_second.minimal (:t ?a)))))
    (NOT (&free)))
  (gives &q))

(fragment (count-less (?L relation) (?S relation))
  "Whether the first relation has fewer rows than the second."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &first Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?L)))
        (&whole Whole)
        (?L (*others ?L)))))
  (INIT &second Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?S)))
        (&whole Whole)
        (?S (*others ?S)))))
  (QUERY &fewer
    (&first.size (:key *Whole) (:N *Few))
    (&second.size (:key Whole) (:N *Many))
    (< Few Many))
  (QUERY &q (&fewer))
  (gives &q))

(fragment (count-equal (?L relation) (?S relation))
  "Whether the first relation has as many rows as the second."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &first Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?L)))
        (&whole Whole)
        (?L (*others ?L)))))
  (INIT &second Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?S)))
        (&whole Whole)
        (?S (*others ?S)))))
  (QUERY &same
    (&first.size (:key *Whole) (:N *Count))
    (&second.size (:key Whole) (:N Count)))
  (QUERY &q (&same))
  (gives &q))

(fragment (greatest-less-count (?R relation) (?n column ?R) (?S relation))
  "Whether the greatest value of a number column is below the count of the second relation's rows."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &o Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (INIT &rows Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?S)))
        (&whole Whole)
        (?S (*others ?S)))))
  (QUERY &below
    (&o.maximal (:t *Most))
    (&rows.size (:key *Whole) (:N *Count))
    (< Most Count))
  (QUERY &q (&below))
  (gives &q))

(fragment (greatest-equal-count (?R relation) (?n column ?R) (?S relation))
  "Whether the greatest value of a number column is the count of the second relation's rows."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &o Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (INIT &rows Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?S)))
        (&whole Whole)
        (?S (*others ?S)))))
  (QUERY &same
    (&o.maximal (:t *Most))
    (&rows.size (:key *Whole) (:N Most)))
  (QUERY &q (&same))
  (gives &q))

(fragment (greatest-more-count (?R relation) (?n column ?R) (?S relation))
  "Whether the greatest value of a number column is above the count of the second relation's rows."
  (QUERY &whole (d4_elem (:D *Whole)) (d4_compose (:A Whole) (:B Whole) (:C Whole)))
  (INIT &o Order
    (member ((:t ?n))
      (?R (?n *)))
    (score ((:t ?n) (:S ?n))
      (?R (?n *))))
  (INIT &rows Cardinality
    (key ((&whole ^Whole))
      (member ((:m (others ?S)))
        (&whole Whole)
        (?S (*others ?S)))))
  (QUERY &above
    (&o.maximal (:t *Most))
    (&rows.size (:key *Whole) (:N *Count))
    (> Most Count))
  (QUERY &q (&above))
  (gives &q))

(fragment (groups-equal (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the sets of cells that the keys of the first relation hold are the sets of cells that the keys of the second hold."
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
      (?L (?keys *))))
  (INIT &right_ids Quotient
    (equivalent ((:a ?others) (:b ?others))
      (?S (?others *))))
  (QUERY &left_cells
    (?L (?keys *) (?a *))
    (&left_ids.class (:a ?keys) (:Id *Key))
    (= *Cell ?a))
  (QUERY &right_cells
    (?S (?others *) (?b *))
    (&right_ids.class (:a ?others) (:Id *Key))
    (= *Cell ?b))
  (INIT &same_set Inclusion
    (pattern ((:pattern Key) (:m Cell))
      (&right_cells *Key *Cell))
    (observed ((:observed Key) (:m Cell))
      (&left_cells *Key *Cell)))
  (QUERY &left_only
    (&left_ids.class (:Id *Key))
    (NOT (&same_set.equal (:observed Key))))
  (QUERY &right_only
    (&right_ids.class (:Id *Key))
    (NOT (&same_set.equal (:pattern Key))))
  (QUERY &q (&same_set.equal) (NOT (&left_only)) (NOT (&right_only)))
  (gives &q))

(fragment (groups-subset (?L relation) (?S relation) (?keys columns ?L) (?a column ?L) (?others columns ?S) (?b column ?S))
  "Whether the sets of cells that the keys of the first relation hold are sets that the keys of the second hold, and the second holds a set more."
  (INIT &left_ids Quotient
    (equivalent ((:a ?keys) (:b ?keys))
