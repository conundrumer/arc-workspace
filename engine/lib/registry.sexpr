;; Generated catalogue: uv run python scripts/generate_study_meanings.py
;; Item prose uses ;;; comments.

;;; @general_contract
;;; Every type, fact, relation, component and proposer a program can read, other than the rare items.
;;;
;;; A relation is `name(Column: Type, ...)`. A site names one of these columns. `needs` lists the columns an earlier atom of the clause must bind. A relation with no `needs` can enumerate every column.
;;;
;;; A component lists its inputs, then its outputs. Each has a first column `key`, apart from an input marked shared, which every key reads, and the unshared relations of Inclusion and Quotient, whose first column has another name. An input marked from the key holds the key's own values when the instance writes no clause for it, only where the key has one label of each type the input needs. Where the key has two labels of one type, write the clause.
;;; @end

;;; @proposer_context
;;; "Every input" counts the test inputs too. "Every train output" counts the train outputs only.
;;;
;;; A domain gives every value of its column's type that the grids it reads admit. In a DET, as in `(DET &a AxisDomain)`, it reads every grid of the task: the train inputs, the train outputs and the test inputs. `&a` is one axis, not the set of axes, and a pair domain's DET holds one pair at each assignment. In a RULE, as in `(RULE &a AxisDomain)`, a domain reads the input of each example alone and holds every value at once, one row each: `&a` is AXIS_V and AXIS_H. `ColorDomain` gives the colors of that input, and `NumberDomain` the numbers from 0 to that input's largest extent.
;;;
;;; A clause names a domain as its proposer. A body atom can't read one: write `(RULE &a AxisDomain)`, then read `&a`.
;;; @end

;; The lib registry of the arclog engine. Its forms and their meaning: the
;; module comment of engine/arclog/src/registry.rs.

;; Types: the type names of engine/arclog/src/read/spelling.rs.
;;; @rare
;;; Another spelling of `Int`.
(type number)
;;; A signed whole number: it can be below 0. A column that holds a count is declared `Nat`.
(type Int)
;;; A whole number from 0 up. A `Nat` label fills an `Int` column.
(type Nat)
;;; A color.
(type Color)
;;; One example of the task, train or test, in a DET. It is the example's index.
(type Example)
;;; @rare
;;; The type of a value with no fields. An arcdata `param` form may name it. No lib relation has a `Unit` column.
(type Unit)
;;; A rectangle of the grid, given by its margin at each edge. A margin below 0 reaches past the edge. `Position` and `Offset` are types under `Box`, and either stands at a Box column. The values of a Box or Position column stand in a frame: the grids that each value is a place in, each grid being the input or the output of the current example, or of the example that an Example column holds. Some lib relations and component outputs make a new frame, which has no grid. [Frames](arclog.md#frames) gives how a column gets its frame.
(type Box)
;;; A Box of one cell. A label at a Box column and a Position column is a Position. A label never stands at a Position column and an Offset column.
(type Position)
;;; A Box that moves another Box. An Offset column has no frame.
(type Offset)
;;; A label of one thing, such as one object. It holds nothing but the thing's identity. An `Ident` column has one source: the `INIT` form and output that makes it, or the `DET` form of a proposer that makes it. A label stands at `Ident` columns of one source only, so the checker refuses a join, a `NOT`, an `=` or `!=`, a union and a type parameter that meet two sources.
(type Ident)
;;; The four turns: D4_ID, D4_CW, D4_HT and D4_CC. A type under `D4`.
(type C4)
;;; The eight symmetries of a square. D4_ID is the identity. D4_CW, D4_HT and D4_CC are the quarter turn clockwise, the half turn and the quarter turn counterclockwise. D4_LR swaps the left and the right (a reflection across the vertical axis), and D4_TB the top and the bottom. D4_DG and D4_AD reflect across the diagonals of those names.
(type D4)
;;; The four edges of the grid: DIR_T, DIR_B, DIR_L and DIR_R. A type under `Dir8`.
(type Dir)
;;; The four corners of the grid: DIAG_TL, DIAG_TR, DIAG_BL and DIAG_BR. A type under `Dir8`.
(type DiagDir)
;;; An edge or a corner: a `Dir` or a `DiagDir`.
(type Dir8)
;;; AXIS_V, the vertical axis, on which DIR_T and DIR_B lie, and AXIS_H, the horizontal axis, on which DIR_L and DIR_R lie. A type under `Axis4`.
(type Axis)
;;; DAXIS_DG, the diagonal through DIAG_TL and DIAG_BR, and DAXIS_AD, the diagonal through DIAG_TR and DIAG_BL. A type under `Axis4`.
(type DiagAxis)
;;; An axis or a diagonal: an `Axis` or a `DiagAxis`.
(type Axis4)
;;; A symmetry group, a set of D4 elements. SYM_1 is the identity alone, SYM_D4 is all eight, and SYM_C4 is the four turns. SYM_BOX is D4_ID, D4_LR, D4_TB and D4_HT. SYM_X is D4_ID, D4_HT, D4_DG and D4_AD. SYM_LR, SYM_TB, SYM_HT, SYM_DG and SYM_AD each hold the identity and the element they are named after.
(type Sym)
;;; SENSE_CW and SENSE_CC, the two senses of a turn.
(type Sense)

;; Relations: the modes of programs/lib/box.dl.
;;; C is A plus B, margin by margin. With B an offset, C is A moved by B.
(relation compose (columns (A Box) (B Box) (C Box)) (modes (A B))
  (types
    (when ((A Position) (B Offset)) (C Position))
    (when ((A Offset) (B Position)) (C Position))
    (when ((A Offset) (B Offset)) (C Offset))))
;;; X_rel is X less Base, margin by margin. For two cells in one frame, X_rel is the offset that moves Base onto X. For a box Base, X_rel is X as a cell of Base's own frame.
(relation relative (columns (Base Box) (X Box) (X_rel Box)) (modes (Base X)) (frames (X_rel (new (of Base) (size X))))
  (types
    (when ((Base Offset) (X Offset)) (X_rel Offset))
    (when ((Base Offset) (X Position)) (X_rel Position))
    (when ((Base Position) (X Position) (same-frame Base X)) (X_rel Offset))))
;;; The grid with K lines cut from edge D.
(relation edge_inset (columns (D Dir) (K Int) (B Box)) (modes (K)))
;;; K cells lie between B and edge D.
(relation margin (columns (B Box) (D Dir) (K Int)) (modes (B)))
;;; P_out is P's image when the whole grid undergoes D.
(relation apply (columns (D D4) (P Box) (P_out Box)) (modes (P)) (frames (P_out (new (size P (by D)))))
  (types
    (when ((P Offset)) (P_out Offset))))
;;; The sum of P's margins on the two edges of corner Diag.
(relation corner_dist (columns (P Box) (Diag DiagDir) (K Int)) (modes (P)))
;;; The grid has N cells along axis A.
(relation frame_extent (columns (P Position) (A Axis) (N Int)) (modes (P)))
;;; V is one step toward D.
(relation step_offset (columns (D Dir8) (V Offset)))
;;; Each K from 1 to one less than the grid's extent along A.
(relation sub_extent (columns (P Position) (A Axis) (K Nat)) (modes (P)))
;;; Q is ahead of P toward D, on P's line, with K cells strictly between them.
(relation gap (columns (D Dir8) (P Position) (Q Position) (K Nat)) (modes (P Q)))
;;; Along a row of parts of Side cells with Gap cells between each two, the cell T cells from the start is in part Part, Remainder cells into it. Part and Remainder count from 0. A cell in a gap gives no row. T is not tested against an end.
(relation divide (columns (T Nat) (Side Nat) (Gap Int) (Part Nat) (Remainder Nat)) (modes (T Side Gap)))
;;; @rare
;;; N tiles of K cells, with G cells between each two, fill Ext cells exactly: K is Ext less the N - 1 gaps, divided by N. A row stands only where that difference is positive and N divides it evenly.
(relation tile_size (columns (Ext Nat) (N Nat) (G Int) (K Nat)) (modes (Ext N G) (K N G)))
(relation dir_elem (columns (D Dir)))
(relation axis_elem (columns (A Axis)))
(relation diag_dir_elem (columns (D DiagDir)))
(relation diag_axis_elem (columns (Da DiagAxis)))
(relation d4_elem (columns (D (pose-or D4))))
(relation c4_elem (columns (D C4)))
(relation sense_elem (columns (S Sense)))
;;; @rare
(relation sym_elem (columns (S Sym)))
(relation dir8_elem (columns (D Dir8)))
(relation axis4_elem (columns (A Axis4)))
(relation sym_member (columns (S Sym) (D D4)))
(relation axis_of (columns (D Dir) (A Axis)))
(relation diag_axis_of (columns (D DiagDir) (Da DiagAxis)))
(relation axis4_of (columns (D Dir8) (A Axis4)))
;;; Corner C's edge on axis A is D.
(relation corner_dir (columns (C DiagDir) (A Axis) (D Dir)))
(relation opposite (columns (D Dir) (Opp Dir)))
(relation diag_opposite (columns (D DiagDir) (Opp DiagDir)))
(relation dir8_opposite (columns (D Dir8) (D2 Dir8)))
(relation perp (columns (A Axis) (A2 Axis)))
(relation diag_perp (columns (Da DiagAxis) (Da2 DiagAxis)))
;;; A quarter turn in sense S takes D to D2.
(relation turn (columns (S Sense) (D Dir) (D2 Dir)))
;;; T is the quarter turn in sense S.
(relation c4_turn (columns (S Sense) (T C4)))
;;; T is the reflection across the line along A.
(relation reflection (columns (A Axis4) (T D4)))
;;; T is the reflection that swaps the two directions on A and keeps the other two.
(relation axis_inversion (columns (A Axis4) (T D4)))
;;; C is B, then A.
(relation d4_compose (columns (A D4) (B D4) (C D4)))
;;; @rare
(relation d4_inverse (columns (D D4) (D_inv D4)))
;;; @rare
(relation d4_identity (columns (D D4)))
;;; @rare
;;; A and B are poses of one `RIGID_DET` assembly, each a placement of it. D takes the placement at pose A onto the placement at pose B.
(relation pose_difference (columns (A shared-pose) (B shared-pose) (D D4)))

;; Components.
;;; The count of each key's members.
;;; - `domain`: the keys to count. A key with no member counts 0.
(component Cardinality construction (type-parameters Key Member)
  (inputs (member (key Key) (m Member))
    (domain (key Key) from-key))
  (outputs (size (key Key) (N Nat)
    (copies (either (member) (domain))))))
;;; For each key, how many more members the plus set has than the minus set, where that is more than 0.
(component Excess construction (type-parameters Key Member)
  (inputs (plus (key Key) (m Member))
    (minus (key Key) (m Member)))
  (outputs (excess (key Key) (N Nat)
    (copies (plus)))))
;;; The one value of each key's members.
;;; - `value`: the value, where every member has it.
;;; - `plural`: the members have more than one value.
(component Singleton construction (type-parameters Key Val)
  (inputs (member (key Key) (v Val)))
  (outputs (value (key Key) (v Val)
      (copies (member (v v))))
    (plural (key Key)
      (copies (member)))))
;;; Each observed set against each pattern set, by their members.
;;; - `superset`: the observed set holds every member of the pattern.
;;; - `equal`: the two sets have the same members.
;;; - A pair of sets that share no member has no row.
(component Inclusion construction (type-parameters Key Pat Member)
  (inputs (pattern (pattern Pat) (m Member))
    (observed (observed Key) (m Member)))
  (outputs (superset (observed Key) (pattern Pat)
      (copies (observed (observed observed)) (pattern (pattern pattern))))
    (equal (observed Key) (pattern Pat)
      (copies (observed (observed observed)) (pattern (pattern pattern))))))
;;; One label per class of an equivalence. A row of `equivalent` or `edge` puts a and b in one class, and the classes are closed over chains of rows.
;;; - `class`: a's class. An element in neither input has no class; `equivalent(a, a)` gives it a class of its own.
(component Quotient construction (type-parameters T)
  (inputs (equivalent (a T) (b T))
    (edge (a T) (b T)))
  (outputs (class (a T) (Id Ident)
    (copies (either (equivalent (a a)) (equivalent (b a)) (edge (a a)) (edge (b a)))))))
;;; Each member's rank, from a strict order or from a score.
;;; - `before`: a comes before b, for every such pair and not only neighbors, and never a before a.
;;; - `score`: a number per member. A lower score comes first, and equal scores tie.
;;; - `secondary_score`: a number that orders the members within each tie of `score`. A member with a `score` and no `secondary_score` comes before the members of its tie that have one.
;;; - Give `before`, or `score` with `secondary_score`, not both. A key with both, or with two `score` rows or two `secondary_score` rows for one member, has no output.
;;; - A member with no `score` row is related to no member: it has rank 0 and dual rank 0, and it is minimal and maximal.
;;; - `probe`: an element ranked against the members, and not counted among them. It takes its place from its own `score` or `before` rows.
;;; - `rank`: R members come before t, so the first has rank 0. Ties share a rank, and the next rank counts every tied member: scores 1, 1, 2 give ranks 0, 0, 2.
;;; - `dual_rank`: R members come after t.
;;; - `minimal`: the members nothing comes before. Under a tie, every tied member.
;;; - `maximal`: the members nothing comes after. Under a tie, every tied member.
;;; - `successor`: b comes next after a. Under ties, each member of one score level is followed by each member of the next, and tied members don't follow each other.
;;; - `cyclic_successor`: `successor`, with the first after the last.
(component Order construction (type-parameters Key T)
  (inputs (member (key Key) (t T))
    (before (key Key) (a T) (b T))
    (score (key Key) (t T) (S Int))
    (secondary_score (key Key) (t T) (S Int))
    (probe (key Key) (t T)))
  (outputs (rank (key Key) (t T) (R Nat)
      (copies (either (member (t t)) (probe (t t)))))
    (dual_rank (key Key) (t T) (R Nat)
      (copies (either (member (t t)) (probe (t t)))))
    (minimal (key Key) (t T)
      (copies (member (t t))))
    (maximal (key Key) (t T)
      (copies (member (t t))))
    (successor (key Key) (a T) (b T)
      (copies (member (t a)) (member (t b))))
    (cyclic_successor (key Key) (a T) (b T)
      (copies (member (t a)) (member (t b))))))
;;; The member a count of steps along a successor relation reaches.
;;; - `walk`: N steps from p0 reach p, for every N from 0 to the greatest N of `steps`. A walk starts only at a member that has a successor, and a walk that runs out of successors has no row past its end.
(component Walk construction (type-parameters Key T)
  (inputs (successor (key Key) (p T) (p_next T))
    (steps (key Key) (N Int)))
  (outputs (walk (key Key) (p0 T) (N Nat) (p T)
    (copies (successor (p p0)) (either (successor (p p)) (successor (p_next p)))))))
;;; @rare
;;; The items taken and left at each state of a walk over states.
;;; - `conflict`: when item is taken, item2 leaves the untaken items without being taken.
;;; - `score`: with a score, the item taken at a state is the untaken item of least score.
;;; - `step`: a step from t to t2 takes one item.
;;; - `skip`: a step from t to t2 takes none.
;;; - The input `take` is the item taken at t. The output `take` has a row where `score` gives it.
;;; - With `score`, a tie forks the walk. An item taken on one branch and left on another is in both `taken` and `untaken` at a state both branches reach.
(component Unfold construction (type-parameters Key T Item)
  (inputs (start (key Key) (t T))
    (initial_taken (key Key) (item Item))
    (initial_untaken (key Key) (item Item))
    (conflict (key Key) (item Item) (item2 Item))
    (score (key Key) (t T) (item Item) (S Int))
    (step (key Key) (t T) (t2 T) reads-outputs)
    (skip (key Key) (t T) (t2 T) reads-outputs)
    (take (key Key) (t T) (item Item) reads-outputs))
  (outputs (taken (key Key) (t T) (item Item))
    (untaken (key Key) (t T) (item Item))
    (excluded (key Key) (t T) (item Item))
    (take (key Key) (t T) (item Item))))
;;; The nodes reached by forward chaining.
;;; - `source`: the nodes reached at the start.
;;; - `edge`: b is reached once a is.
(component Propagation construction (type-parameters Key Node)
  (inputs (source (key Key) (n Node) from-key)
    (edge (key Key) (a Node) (b Node))
    (join (key Key) (a Node) (b Node) (c Node)))
  (outputs (reached (key Key) (n Node)
    (copies (either (source (n n)) (edge (b n)) (join (c n)))))))
;;; The least cost from a source to each node of a graph.
;;; - `edge`: a step from a to b, of cost 1.
;;; - `weight`: a step from a to b, of cost W.
;;; - `source`: a node at cost 0.
;;; - `source_distance`: a node at start cost K.
(component Distance construction (type-parameters Key Node)
  (inputs (edge (key Key) (a Node) (b Node))
    (weight (key Key) (a Node) (b Node) (W Int))
    (source (key Key) (n Node) from-key)
    (source_distance (key Key) (n Node) (K Int)))
  (outputs (distance (key Key) (n Node) (K Int)
      (copies (either (source (n n)) (source_distance (n n)) (edge (b n)) (weight (b n)))))
    (predecessor (key Key) (b Node) (a Node)
      (copies (either (edge (a a) (b b)) (weight (a a) (b b)))))))
;;; The parts of a cell set that no walk through the set reaches from the grid's edge. The walk starts at the set's cells on the grid's edge and takes the four cardinal steps.
;;; - `enclosed`: each enclosed part under its own label.
(component Enclosure construction (type-parameters Key)
  (inputs (cell (key Key) (P Position)))
  (outputs (enclosed (key Key) (P Position) (Id Ident)
    (copies (cell (P P))))))
;;; The cells of a set that face out of it.
;;; - `exposed`: no cell of the set lies one step from P toward D. Off the grid counts as no cell.
;;; - `boundary`: P is exposed toward some direction.
(component Boundary construction (type-parameters Key)
  (inputs (cell (key Key) (P Position))
    (dir (D Dir8) (default (DIR_T) (DIR_B) (DIR_L) (DIR_R))))
  (outputs (boundary (key Key) (P Position)
      (copies (cell (P P))))
    (exposed (key Key) (P Position) (D Dir8)
      (copies (cell (P P)) (dir (D D))))))
;;; The least box that holds a set.
(component BoundingBox construction (type-parameters Key (Point Box))
  (inputs (cell (key Key) (P Point) from-key))
  (outputs (box (key Key) (B Box)
    (copies (cell)))))
;;; Two valued cell sets compared under D4 transforms.
;;; - `mismatch`: D is in `transform`, and for some source cell P, the cell `apply` of D to P gives is not a target cell of P's value: no target cell is there, or one of another value.
;;; - `conflict`: for some source cell, its image is a target cell of another value. A missing target cell is no conflict.
;;; - A D in `transform` with no `mismatch` row takes the source into the target. Target cells that are no source cell's image are not tested.
(component Agreement construction (type-parameters Key Val)
  (inputs (source (key Key) (P Box) (v Val))
    (target (key Key) (P Box) (v Val))
    (transform (D D4) (default (D4_ID) (D4_CW) (D4_HT) (D4_CC) (D4_LR) (D4_TB) (D4_DG) (D4_AD))))
  (outputs (mismatch (key Key) (D D4)
      (copies (transform (D D)) (source)))
    (conflict (key Key) (D D4)
      (copies (transform (D D)) (source) (target)))))
;;; A frame built from copies of an inner frame at outer positions.
;;; - `outer`: the frame of copies.
;;; - `inner`: the frame of one copy.
;;; - `gap`: G cells between each two copies along A. An axis with no row has gap 0.
;;; - `cell`: P is the cell P_inner of the copy at P_outer.
(component Tiling construction (type-parameters Key)
  (inputs (outer (key Key) (P Position))
    (inner (key Key) (P Position))
    (gap (key Key) (A Axis) (G Int)))
  (outputs (cell (key Key) (P_outer Position) (P_inner Position) (P Position)
    (copies (outer (P P_outer)) (inner (P P_inner)))
    (frames (P new)))))
;;; The cells of a frame of given extents.
;;; - `extent`: N cells along A. An axis with no row has extent 1 where the other axis has a row. A key with no row on either axis has no cell.
(component Frame construction (type-parameters Key)
  (inputs (extent (key Key) (A Axis) (N Int) from-key))
  (outputs (cell (key Key) (P Position)
    (frames (P new)))))
;;; The rectangles drawn in a cell set.
;;; - `box`: every cell of B's outline is in the set. B is at least two cells long on each axis, and its interior may hold any cells.
(component Outlines detector (type-parameters Key)
  (inputs (node (key Key) (P Position)))
  (outputs (box (key Key) (B Box)
    (copies (node)))))
;;; Where a shape appears among valued cells.
;;; - `candidate`: P is an offset, and D is in `transform`. For at least one shape cell S of value v, the cell that `apply` of D to S, then `compose` with P, gives is a `cell` row of value v. Every occurrence is a candidate.
;;; - `occurrence`: as `candidate`, for every shape cell S of value v. P moves the D-image of the shape onto the cells.
;;; - Only the cells `cell` holds count.
(component Occurrences detector (type-parameters Key Val)
  (inputs (cell (key Key) (P Position) (v Val))
    (shape (key Key) (P Box) (v Val))
    (transform (D D4) (default (D4_ID))))
  (outputs (candidate (key Key) (D D4) (P Box)
      (copies (transform (D D)) (cell) (shape))
      (frames (P (of cell.P))))
    (occurrence (key Key) (D D4) (P Box)
      (copies (transform (D D)) (cell) (shape))
      (frames (P (of cell.P))))))
;;; The translations along an axis that leave valued cells unchanged.
;;; - `period`: a move of K along A takes every cell onto a cell of the same value, wherever both cells exist. K runs from 1 to one less than the extent. A K with no pair of cells to compare is a period.
;;; - `fundamental_period`: the least period along A that compares at least one pair of cells.
;;; - `approximate_period`: a period read through damage: the line pairs the move breaks do not outnumber those it keeps.
(component Periods detector (type-parameters Key Val)
  (inputs (cell (key Key) (P Position) (v Val)))
  (outputs (period (key Key) (A Axis) (K Nat)
      (copies (cell)))
    (fundamental_period (key Key) (A Axis) (K Nat)
      (copies (cell)))
    (approximate_period (key Key) (A Axis) (K Nat)
      (copies (cell)))))
;;; @rare
;;; The equal divisions a frame's extent admits.
;;; - `division`: along A, N parts of K cells with G cells between each two fill the extent exactly. N is 2 or more and K is 1 or more. G can be less than 0, down to 1 less K: then two neighboring parts share that many lines.
(component ExtentDivisions detector (type-parameters Key)
  (inputs (frame (key Key) (P Position)))
  (outputs (division (key Key) (A Axis) (N Nat) (K Nat) (G Int)
    (copies (frame)))))
;;; @rare
;;; The symmetries of a periodic valued pattern.
;;; - `transform`: the D4 elements to test. It has no default.
;;; - `cell`: the pattern's cells.
;;; - `grid`: the frame's cells.
;;; - `period`: the pattern's period along A, at most one per axis, more than 0. An axis with no row has none. A key with two periods on an axis, or a period of 0, has no output.
;;; - `symmetry`: D, then the shift Delta, takes some cell onto another cell and no cell onto a cell of another value. Cells outside `grid` are ignored. One D has a row for each shift that differs by a multiple of the period and lands in the frame. Delta is 0 on an axis with no period. So the identity has a row only where a period exists.
;;; - `action`: a symmetry or a period move takes the frame cell P onto the frame cell Q.
(component Wallpaper detector (type-parameters Key Val)
  (inputs (transform (D D4))
    (cell (key Key) (P Position) (v Val))
    (grid (key Key) (P Position))
    (period (key Key) (A Axis) (K Int)))
  (outputs (symmetry (key Key) (D D4) (Delta Offset)
      (copies (transform (D D)) (cell)))
    (action (key Key) (P Position) (Q Position)
      (copies (grid (P P)) (grid (P Q))))))
;;; @rare
;;; The rules a demonstrated pair confirms. An input of a nested task holds pairs that demonstrate a rule, and an object that the same rule completes.
;;; - `value`: object o holds v at index i.
;;; - `prediction`: rule c predicts that the object paired with o holds v at i.
;;; - `demonstration`: a demonstrated pair, o and its partner o2.
;;; - `counterexample`: c's prediction for o is not o2.
;;; - `consistent`: c's prediction for o is o2.
;;; - A prediction holds every index of the object it predicts. An index it leaves out counts as one that object lacks.
;;; - `unconfirmed`: c fails some demonstrated pair.
;;; - `confirmed`: c predicts every demonstrated pair.
;;; - A rule that predicts nothing for any object is in neither.
(component DemonstrationConsistency task-structure (type-parameters Key Demonstrated Object Index Value)
  (inputs (value (key Key) (o Object) (i Index) (v Value))
    (prediction (key Key) (c Demonstrated) (o Object) (i Index) (v Value))
    (demonstration (key Key) (o Object) (o2 Object)))
  (outputs (counterexample (key Key) (c Demonstrated) (o Object) (o2 Object))
    (consistent (key Key) (c Demonstrated) (o Object) (o2 Object))
    (unconfirmed (key Key) (c Demonstrated))
    (confirmed (key Key) (c Demonstrated))))
;;; The cells a walk through the set reaches from a source.
;;; - `step`: the steps that join two cells. The default is the four cardinal steps.
;;; - A source outside `node` reaches nothing.
(component Flood construction (type-parameters Key)
  (inputs (node (key Key) (P Position))
    (source (key Key) (P Position) from-key)
    (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
  (outputs (reached (key Key) (P Position)
    (copies (node (P P))))))
;;; The fewest steps through the set from a source to each cell.
;;; - `step`: as in `Flood`.
;;; - `distance`: K steps from the nearest source reach P. A source is at 0. A source outside `node` is at 0 and reaches nothing.
(component CellDistance construction (type-parameters Key)
  (inputs (node (key Key) (P Position))
    (source (key Key) (P Position))
    (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
  (outputs (distance (key Key) (P Position) (K Nat)
      (copies (either (node (P P)) (source (P P)))))
    (predecessor (key Key) (Q Position) (P Position)
      (copies (node (P Q)) (node (P P))))))
;;; The connected pieces of a cell set.
;;; - `step`: as in `Flood`. To join cells that touch at a corner too, the clause gives all eight steps.
(component Connectivity construction (type-parameters Key)
  (inputs (node (key Key) (P Position))
    (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
  (outputs (component (key Key) (P Position) (Id Ident)
      (copies (node (P P))))
    (adjacent (key Key) (P Position) (Q Position)
      (copies (node (P P)) (node (P Q))))))
;;; The straight path from a source toward a direction.
;;; - `source`: where each path starts. A source on the grid and outside `node` gives only its own row at K = 0.
;;; - `node`: the cells a path may step onto. A path stops before its first step off them.
;;; - `ray`: P is K steps from Origin toward D. Each source is on its own path at K = 0.
;;; - `end`: the path's last cell.
(component Ray construction (type-parameters Key (Point Box))
  (inputs (source (key Key) (P Point))
    (node (key Key) (P Point))
    (dir (key Key) (D Dir8) from-key))
  (outputs (ray (key Key) (P Point) (D Dir8) (K Nat) (Origin Point)
      (copies (dir (D D)) (source (P Origin))))
    (end (key Key) (P Point) (D Dir8) (K Nat) (Origin Point)
      (copies (dir (D D)) (source (P Origin))))))
;;; The frame cut into equal parts on each axis.
;;; - `parts`: N parts along A.
;;; - `side`: parts of K cells along A, in place of `parts`. An axis with neither is one part.
;;; - `gap`: G cells between each two parts along A. An axis with no row has gap 0.
;;; - `tile`: P is the cell P_inner of the part at P_outer. P_outer is a cell of the frame of parts.
;;; - A cell in a gap, or in a leftover shorter than a part, has no row. Where the parts and gaps don't fill an extent exactly, no cell has a row.
(component Division construction (type-parameters Key)
  (inputs (cell (key Key) (P Position))
    (parts (key Key) (A Axis) (N Int))
    (side (key Key) (A Axis) (K Int))
    (gap (key Key) (A Axis) (G Int)))
  (outputs (tile (key Key) (P Position) (P_outer Position) (P_inner Position)
    (copies (cell (P P)))
    (frames (P_outer new) (P_inner (new (of cell.P)))))))

;; Constants: the #define lines of programs/lib/orientation.dl, in their order within each type, and the C4 constants of its c4_elem facts.
(constants Dir DIR_T DIR_B DIR_L DIR_R)
(constants Axis AXIS_V AXIS_H)
(constants DiagDir DIAG_TL DIAG_TR DIAG_BL DIAG_BR)
(constants DiagAxis DAXIS_DG DAXIS_AD)
(constants D4 D4_ID D4_CW D4_HT D4_CC D4_LR D4_TB D4_DG D4_AD)
(constants Sense SENSE_CW SENSE_CC)
(constants Sym SYM_1 SYM_LR SYM_TB SYM_HT SYM_DG SYM_AD SYM_BOX SYM_X SYM_C4 SYM_D4)
(constants C4 D4_ID D4_CW D4_HT D4_CC)

;; Facts: docs/arclog/arclog.md#program.
;;; Each cell of the input and its color.
(fact input (columns (P Position) (Col Color)))
;;; Each cell of each example's input, train and test. DET only.
(fact ex_input (columns (E Example) (P Position) (Col Color)))
;;; Each cell of each train output. DET only.
(fact ex_output (columns (E Example) (P Position) (Col Color)))

;; Macros, in the names of the lib.
;;; A lies in B, its sides included.
(macro inside (columns (A A Box) (B B Box)) (modes (A B))
  (relative (:Base *B) (:X *A) (:X_rel *R))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B R) (:D D1) (:K *K1))
  (>= K1 0)
  (margin (:B R) (:D O1) (:K *K2))
  (>= K2 0)
  (margin (:B R) (:D D2) (:K *K3))
  (>= K3 0)
  (margin (:B R) (:D O2) (:K *K4))
  (>= K4 0))
;;; A lies in B and touches none of B's sides.
(macro interior (columns (A A Box) (B B Box)) (modes (A B))
  (relative (:Base *B) (:X *A) (:X_rel *R))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B R) (:D D1) (:K *K1))
  (> K1 0)
  (margin (:B R) (:D O1) (:K *K2))
  (> K2 0)
  (margin (:B R) (:D D2) (:K *K3))
  (> K3 0)
  (margin (:B R) (:D O2) (:K *K4))
  (> K4 0))
;;; P1 and P2 have the same margin on edge D.
(macro same_dist (columns (D D Dir) (P1 P1 Box) (P2 P2 Box)) (modes (P1 P2))
  (margin (:B *P1) *D *K)
  (margin (:B *P2) D K))
;;; P and Q are on one line along A: a column, a row, or a diagonal.
(macro same_line (columns (A A Axis4) (P P Box) (Q Q Box)) (modes (P Q))
  (OR ((perp *A *A2) (axis_of *D (:A A2)) (margin (:B *P) D *K) (margin (:B *Q) D K)) ((diag_perp (:Da A) (:Da2 A2)) (diag_axis_of D (:Da A2)) (corner_dist P (:Diag D) K) (corner_dist (:P Q) (:Diag D) K))))
;;; P1 and P2 have the same margins on both edges of corner D.
(macro same_corner (columns (D Diag DiagDir) (P1 P1 Box) (P2 P2 Box)) (modes (P1 P2))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2))
  (margin (:B *P1) (:D D1) (:K *K1))
  (margin (:B *P2) (:D D1) (:K K1))
  (margin (:B P1) (:D D2) (:K *K2))
  (margin (:B P2) (:D D2) (:K K2)))
;;; @rare
;;; P1 and P2 have the same margin on edge D, and the same two margins on the other axis.
(macro same_slab (columns (D D Dir) (P1 P1 Box) (P2 P2 Box)) (modes (P1 P2))
  (margin (:B *P1) *D *K)
  (margin (:B *P2) D K)
  (axis_of D *A)
  (perp A *A2)
  (axis_of (:D *E) (:A A2))
  (opposite (:D E) (:Opp *E2))
  (margin (:B P1) (:D E) (:K *K1))
  (margin (:B P2) (:D E) (:K K1))
  (margin (:B P1) (:D E2) (:K *K2))
  (margin (:B P2) (:D E2) (:K K2)))
;;; P is strictly nearer edge D than Q is. For a corner, the distances compared are `corner_dist`.
(macro nearer (columns (D D Dir8) (P P Box) (Q Q Box)) (modes (P Q))
  (OR ((dir_elem *D) (margin (:B *P) D (:K *K1)) (margin (:B *Q) D (:K *K2)) (< K1 K2)) ((diag_dir_elem D) (corner_dist P (:Diag D) (:K K1)) (corner_dist (:P Q) (:Diag D) (:K K2)) (< K1 K2))))
;;; P's two margins on each axis are equal. On an axis of even extent, no cell is centered.
(macro centered (columns (P P Box)) (modes (P))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B *P) (:D D1) (:K *K1))
  (margin (:B P) (:D O1) (:K K1))
  (margin (:B P) (:D D2) (:K *K2))
  (margin (:B P) (:D O2) (:K K2)))
;;; P's margins on edge D (K) and on the opposite edge (K2).
(macro dist_pair (columns (P P Box) (D D Dir) (K K Int) (K2 K2 Int)) (modes (P))
  (opposite *D (:Opp *O))
  (margin (:B *P) D *K)
  (margin (:B P) (:D O) (:K *K2)))
;;; P's margin K1 on the edge of corner Diag that lies on axis A, and K2 on the corner's other edge.
(macro diag_dist (columns (P P Box) (Diag Diag DiagDir) (A A Axis) (K1 K1 Int) (K2 K2 Int)) (modes (P))
  (diag_dirs (:D *Diag) *A *D1 *D2)
  (margin (:B *P) (:D D1) (:K *K1))
  (margin (:B P) (:D D2) (:K *K2)))
;;; The grid's extent along A (N1) and along the other axis (N2).
(macro axis_extents (columns (P P Position) (A A Axis) (N1 N1 Int) (N2 N2 Int)) (modes (P))
  (perp *A *A2)
  (frame_extent *P A (:N *N1))
  (frame_extent P (:A A2) (:N *N2)))
;;; B is N cells long along A. P is any cell of the grid, and gives only the grid's extent.
(macro box_extent (columns (B B Box) (P P Position) (A A Axis) (N N Int)) (modes (B P))
  (axis_elem *A)
  (relative (:Base *B) (:X *P) (:X_rel *R))
  (frame_extent (:P R) A *N))
;;; The grid with K1 lines cut from edge D and K2 from the opposite edge.
(macro axis_inset (columns (D D Dir) (K1 K1 Int) (K2 K2 Int) (B B Box)) (modes (K1 K2))
  (opposite *D (:Opp *O))
  (edge_inset D (:K *K1) (:B *B1))
  (edge_inset (:D O) (:K *K2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
;;; The grid with K lines cut from every edge.
(macro uniform_inset (columns (K K Int) (B B Box)) (modes (K))
  (axis_of (:D *D1) (:A *A1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (axis_inset (:D D1) (:K1 *K) (:K2 K) (:B *B1))
  (axis_inset (:D D2) (:K1 K) (:K2 K) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
;;; @rare
;;; The grid with K lines cut from each edge of corner Diag.
(macro corner_inset (columns (Diag Diag DiagDir) (K K Int) (B B Box)) (modes (K))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2))
  (edge_inset (:D D1) *K (:B *B1))
  (edge_inset (:D D2) K (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
;;; @rare
;;; The grid with K lines added past edge D.
(macro edge_outset (columns (D D Dir) (K K Int) (B B Box)) (modes (K))
  (edge_inset *D *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
;;; @rare
;;; The grid with K lines added past each edge of corner Diag.
(macro corner_outset (columns (Diag Diag DiagDir) (K K Int) (B B Box)) (modes (K))
  (corner_inset *Diag *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
;;; @rare
;;; The grid with K1 lines added past edge D and K2 past the opposite edge.
(macro axis_outset (columns (D D Dir) (K1 K1 Int) (K2 K2 Int) (B B Box)) (modes (K1 K2))
  (axis_inset *D *K1 *K2 (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
;;; The grid with K lines added past every edge.
(macro uniform_outset (columns (K K Int) (B B Box)) (modes (K))
  (uniform_inset *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
;;; Q is K steps from P toward D. Q can lie off the grid.
(macro jump (columns (P P Box) (D D Dir8) (K K Int) (Q Q Box)) (modes (P K))
  (jump_offset *D *K *V)
  (compose (:A *P) (:B V) (:C *Q)))
;;; V is K steps toward D.
(macro jump_offset (columns (D D Dir8) (K K Int) (V V Offset)) (modes (K))
  (OR ((dir_elem *D) (opposite D (:Opp *O)) (edge_inset (:D O) *K (:B *I)) (edge_outset D K (:B *U)) (compose (:A I) (:B U) (:C *V)))
    ((diag_dir_elem D) (diag_opposite D (:Opp O)) (corner_inset (:Diag O) K (:B I)) (corner_outset (:Diag D) K (:B U)) (compose (:A I) (:B U) (:C V)))))
;;; @rare
;;; V is K steps along A, for each K that `sub_extent` gives. Each K has two rows, one toward each edge of A.
(macro frame_offset (columns (P P Position) (A A Axis) (K K Nat) (V V Offset)) (modes (P))
  (sub_extent *P *A *K)
  (axis_of *D A)
  (jump_offset D K *V))
;;; Q is one step from P toward D. Q can lie off the grid.
(macro neighbor (columns (P P Box) (D D Dir8) (Q Q Box)) (modes (P))
  (step_offset *D *V)
  (compose (:A *P) (:B V) (:C *Q)))
;;; Along has P's margins on axis A and 0 on the other axis, so for A = AXIS_V it is P's whole row, and for A = AXIS_H P's whole column. Across is P less Along.
(macro split (columns (P P Box) (A A Axis) (Along Along Box) (Across Across Box)) (modes (P))
  (frames (Across (new (of P) (size P))))
  (types
    (when ((P Position)) (Across Position))
    (when ((P Offset)) (Across Offset)))
  (axis_of *D *A)
  (opposite D (:Opp *O))
  (margin (:B *P) D (:K *K1))
  (margin (:B P) (:D O) (:K *K2))
  (axis_inset D K1 K2 (:B *Along))
  (relative (:Base Along) (:X P) (:X_rel *Across)))
;;; D2 is an edge on the other axis from D.
(macro perp_dir (columns (D D Dir) (D2 D2 Dir))
  (axis_of *D *A)
  (perp A *A2)
  (axis_of (:D *D2) (:A A2)))
;;; Corner D's edge on axis A is D1, and its edge on the other axis is D2.
(macro diag_dirs (columns (D Diag DiagDir) (A A Axis) (D1 D1 Dir) (D2 D2 Dir))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2)))
(macro apply_dir (columns (D T D4) (Dir D Dir) (Dir_out D2 Dir))
  (d4_elem (:D *T))
  (dir_elem *D)
  (dir_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))
(macro apply_diag_dir (columns (D T D4) (Dir D DiagDir) (Dir_out D2 DiagDir))
  (d4_elem (:D *T))
  (diag_dir_elem *D)
  (diag_dir_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))
;;; @rare
(macro apply_dir8 (columns (D T D4) (Dir D Dir8) (Dir_out D2 Dir8))
  (d4_elem (:D *T))
  (dir8_elem *D)
  (dir8_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))

;; Proposers: the type-domain proposers of docs/arclog/arclog.md#program, then the components of programs/proposers.dl, each with the columns of its propose relation, apart from PanelCombine, whose columns are those of a set-keyed table, one row for each panel of each entry: the entry's id, the entry's output color, the panel's place in the arrangement's frame, and the color of the panel's cell.
(proposer AxisDomain native domain (columns (A Axis)))
(proposer ColorDomain native domain (columns (C Color)))
(proposer D4Domain native domain (columns (D D4)))
(proposer DiagAxisDomain native domain (columns (Da DiagAxis)))
(proposer DiagDirDomain native domain (columns (D DiagDir)))
(proposer DirDomain native domain (columns (D Dir)))
(proposer NumberDomain native domain (columns (N Nat)))
(proposer SenseDomain native domain (columns (S Sense)))
(proposer SymDomain native domain (columns (S Sym)))
;;; @rare
(proposer ColorColorDomain native domain (columns (C_from Color) (C_to Color)))
;;; @rare
(proposer DiagDirAxisDomain native domain (columns (D DiagDir) (A Axis)))
;;; @rare
(proposer NumberDirDomain native domain (columns (N Nat) (D Dir)))
;;; A color in every input.
(proposer SharedColor arclog (columns C))
;;; A color with the most cells in every input.
(proposer DominantColor native (columns (C Color)))
;;; A color with the fewest cells in every input.
(proposer RarestColor native (columns (C Color)))
;;; @rare
;;; A color in every train output and no input.
(proposer OutNewColor arclog (columns C))
;;; A color in some train output and no input.
(proposer AnyOutNewColor arclog (columns C))
;;; A color in every input and no train output.
(proposer VanishedColor arclog (columns C))
;;; A color that every one of its cells loses in the output, each input cell compared with the output cell at the same place. Where a pair's input and output differ in size, a cell outside the smaller grid keeps no color.
(proposer ChangedColor arclog (columns C))
;;; A color that every one of its cells keeps in the output, the cells compared as `ChangedColor` compares them.
(proposer UnchangedColor arclog (columns C))
;;; @rare
;;; A color map: each cell that changes gives its input color and its output color.
(proposer ChangedPairs arclog (columns C_from C_to))
;;; @rare
;;; A color map read off whole examples: each input color an output lacks, with each output color its input lacks.
(proposer VanishedNewPairs arclog (columns C_from C_to))
;;; Along some axis, each output extent is K times its input extent. K can be 1.
(proposer ScaleRatio native (columns (K Nat)))
;;; @rare
;;; As `ScaleRatio`, with its axis A.
(proposer ScaleRatioAxis native (columns (A Axis) (K Nat)))
;;; Along some axis, each input extent is K times its output extent.
(proposer DivisorRatio native (columns (K Nat)))
;;; @rare
;;; As `DivisorRatio`, with its axis A.
(proposer DivisorRatioAxis native (columns (A Axis) (K Nat)))
;;; @rare
;;; Along some axis, each output extent differs from its input extent by D, more or less.
(proposer DimDiff native (columns (D Nat)))
;;; An extent of every input.
(proposer ConstInDim native (columns (N Int)))
;;; @rare
;;; An extent of every input, with its axis.
(proposer ConstInDimAxis native (columns (A Axis) (N Int)))
;;; An extent of every train output.
(proposer ConstOutDim native (columns (N Int)))
;;; An extent of every train output, with its axis.
(proposer ConstOutDimAxis native (columns (A Axis) (N Int)))
;;; N tiles, with a gap of 0 to 3 between each two, fill an axis of every input. N is 2 to 8. `TileDim` is found apart, so an N and a D need not come from one tiling.
(proposer TileCount native (columns (N Nat)))
;;; Tiles of D cells, with a gap of 0 to 3 between each two, fill an axis of every input. There are 2 to 8 tiles.
(proposer TileDim native (columns (D Nat)))
;;; @rare
;;; On each axis, the least move under which every input repeats. An axis with no common period gives none.
(proposer Period native (columns (K Nat)))
;;; Along some axis, N parts fill the axis, with G lines between each two. Each line in a gap holds one color, the same in every input. N is 2 to 8, and G is 1 to 3. The lines are rows along AXIS_V, columns along AXIS_H.
(proposer SepTileCount native (columns (N Nat)))
;;; `SepTileCount`'s N with its axis A, and also the other axis with N = 1 where no input has such a tiling on it.
(proposer SepTileCountAxis native (columns (A Axis) (N Nat)))
;;; @rare
;;; As `SepTileCount`, with parts of D cells in place of N parts.
(proposer SepTileDim native (columns (D Nat)))
;;; The G of `SepTileCount`: the number of lines between each two parts.
(proposer SepThickness native (columns (G Nat)))
;;; @rare
;;; The colors of the inputs ranked by cell count: R colors have fewer cells than C. Ties share a rank, and a row is kept only where every input gives it.
(proposer CountRankAsc native (columns (C Color) (R Nat)))
;;; @rare
;;; As `CountRankAsc`, with R the number of colors that have more cells than C.
(proposer CountRankDesc native (columns (C Color) (R Nat)))
;;; In every pair, the output is a whole number of input-sized copies along each axis, and is not the input's size. Pt is a copy's place in the frame of copies, and the copy at Pt is the input under T. A T that swaps the axes is tried only for a square input. A Pt has several rows where the input is symmetric.
(proposer TileD4 native (columns (Pt Position) (T D4)))
;;; The input is two panels of the output's size along one axis, with any number of separator lines between. Each output cell has the cell at the same place in each panel. An entry Id has two rows, one per panel, that share C_out: P is the panel's place as a cell of the frame of two parts along that axis, C is the color of that panel's cell, and C_out is the output cell's color. There is one entry per combination of the two panel colors and the output color in the train pairs.
(proposer PanelCombine native (columns (Id Ident) (C_out Color) (P Position) (C Color)))
