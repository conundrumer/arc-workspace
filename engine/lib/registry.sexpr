;; The lib registry of the arclog engine. Its forms and their meaning: the
;; module comment of engine/arclog/src/registry.rs.

;; Relations: the modes of programs/lib/box.dl.
(relation compose (columns (A Box) (B Box) (C Box)) (modes (A B)))
(relation relative (columns (Base Box) (X Box) (X_rel Box)) (modes (Base X)))
(relation edge_inset (columns (D Dir) (K number) (B Box)) (modes (K)))
(relation margin (columns (B Box) (D Dir) (K number)) (modes (B)))
(relation apply (columns (D D4) (P Box) (P_out Box)) (modes (P)))
(relation corner_dist (columns (P Box) (Diag DiagDir) (K number)) (modes (P)))
(relation frame_extent (columns (P Position) (A Axis) (N number)) (modes (P)))
(relation step_offset (columns (D Dir8) (V Offset)))
(relation sub_extent (columns (P Position) (A Axis) (K number)) (modes (P)))
(relation gap (columns (D Dir8) (P Position) (Q Position) (K number)) (modes (P Q)))
(relation divide (columns (T number) (Side number) (Gap number) (Part number) (Remainder number)) (modes (T Side Gap)))
(relation dir_elem (columns (D Dir)))
(relation axis_elem (columns (A Axis)))
(relation diag_dir_elem (columns (D DiagDir)))
(relation diag_axis_elem (columns (Da DiagAxis)))
(relation d4_elem (columns (D (pose-or D4))))
(relation c4_elem (columns (D C4)))
(relation sense_elem (columns (S Sense)))
(relation sym_elem (columns (S Sym)))
(relation dir8_elem (columns (D Dir8)))
(relation axis4_elem (columns (A Axis4)))
(relation sym_member (columns (S Sym) (D D4)))
(relation axis_of (columns (D Dir) (A Axis)))
(relation diag_axis_of (columns (D DiagDir) (Da DiagAxis)))
(relation axis4_of (columns (D Dir8) (A Axis4)))
(relation corner_dir (columns (C DiagDir) (A Axis) (D Dir)))
(relation opposite (columns (D Dir) (Opp Dir)))
(relation diag_opposite (columns (D DiagDir) (Opp DiagDir)))
(relation dir8_opposite (columns (D Dir8) (D2 Dir8)))
(relation perp (columns (A Axis) (A2 Axis)))
(relation diag_perp (columns (Da DiagAxis) (Da2 DiagAxis)))
(relation turn (columns (S Sense) (D Dir) (D2 Dir)))
(relation c4_turn (columns (S Sense) (T C4)))
(relation reflection (columns (A Axis4) (T D4)))
(relation axis_inversion (columns (A Axis4) (T D4)))
(relation d4_compose (columns (A D4) (B D4) (C D4)))
(relation d4_inverse (columns (D D4) (D_inv D4)))
(relation d4_identity (columns (D D4)))
(relation pose_difference (columns (A shared-pose) (B shared-pose) (D D4)))

;; Components.
(component Cardinality construction (type-parameters Key Member)
  (inputs (member (key Key) (m Member))
    (domain (key Key)))
  (outputs (size (key Key) (N number))))
(component Excess construction (type-parameters Key Member)
  (inputs (plus (key Key) (m Member))
    (minus (key Key) (m Member)))
  (outputs (excess (key Key) (N number))))
(component Singleton construction (type-parameters Key Val)
  (inputs (member (key Key) (v Val)))
  (outputs (value (key Key) (v Val))
    (plural (key Key))))
(component Inclusion construction (type-parameters Key Pat Member)
  (inputs (pattern (pattern Pat) (m Member))
    (observed (observed Key) (m Member)))
  (outputs (superset (observed Key) (pattern Pat))
    (equal (observed Key) (pattern Pat))))
(component Quotient construction (type-parameters T)
  (inputs (equivalent (a T) (b T))
    (edge (a T) (b T)))
  (outputs (class (a T) (Id Ident))))
(component Order construction (type-parameters Key T)
  (inputs (member (key Key) (t T))
    (before (key Key) (a T) (b T))
    (score (key Key) (t T) (S number))
    (probe (key Key) (t T)))
  (outputs (rank (key Key) (t T) (R number))
    (dual_rank (key Key) (t T) (R number))
    (minimal (key Key) (t T))
    (maximal (key Key) (t T))
    (successor (key Key) (a T) (b T))
    (cyclic_successor (key Key) (a T) (b T))))
(component Walk construction (type-parameters Key T)
  (inputs (successor (key Key) (p T) (p_next T))
    (steps (key Key) (N number)))
  (outputs (walk (key Key) (p0 T) (N number) (p T))))
(component Unfold construction (type-parameters Key T Item)
  (inputs (start (key Key) (t T))
    (initial_taken (key Key) (item Item))
    (initial_untaken (key Key) (item Item))
    (conflict (key Key) (item Item) (item2 Item))
    (score (key Key) (t T) (item Item) (S number))
    (step (key Key) (t T) (t2 T) reads-outputs)
    (skip (key Key) (t T) (t2 T) reads-outputs)
    (take (key Key) (t T) (item Item) reads-outputs))
  (outputs (taken (key Key) (t T) (item Item))
    (untaken (key Key) (t T) (item Item))
    (excluded (key Key) (t T) (item Item))
    (take (key Key) (t T) (item Item))))
(component Propagation construction (type-parameters Key Node)
  (inputs (source (key Key) (n Node))
    (edge (key Key) (a Node) (b Node))
    (join (key Key) (a Node) (b Node) (c Node)))
  (outputs (reached (key Key) (n Node))))
(component Distance construction (type-parameters Key Node)
  (inputs (edge (key Key) (a Node) (b Node))
    (weight (key Key) (a Node) (b Node) (W number))
    (source (key Key) (n Node))
    (source_distance (key Key) (n Node) (K number)))
  (outputs (distance (key Key) (n Node) (K number))
    (predecessor (key Key) (b Node) (a Node))))
(component Enclosure construction (type-parameters Key)
  (inputs (cell (key Key) (P Position)))
  (outputs (enclosed (key Key) (P Position) (Id Ident))))
(component Boundary construction (type-parameters Key)
  (inputs (cell (key Key) (P Position))
    (dir (D Dir8) (default (DIR_T) (DIR_B) (DIR_L) (DIR_R))))
  (outputs (boundary (key Key) (P Position))
    (exposed (key Key) (P Position) (D Dir8))))
(component BoundingBox construction (type-parameters Key)
  (inputs (cell (key Key) (P Box)))
  (outputs (box (key Key) (B Box))))
(component Agreement construction (type-parameters Key Corr Index Val)
  (inputs (source (key Key) (i Index) (v Val))
    (target (key Key) (i Index) (v Val))
    (correspondence (key Key) (m Corr) (i Index) (j Index)))
  (outputs (mismatch (key Key) (m Corr))
    (conflict (key Key) (m Corr))))
(component Tiling construction (type-parameters Key)
  (inputs (outer (key Key) (P Position))
    (inner (key Key) (P Position))
    (gap (key Key) (A Axis) (G number)))
  (outputs (cell (key Key) (P_outer Position) (P_inner Position) (P Position))))
(component Frame construction (type-parameters Key)
  (inputs (extent (key Key) (A Axis) (N number)))
  (outputs (cell (key Key) (P Position))))
(component Outlines detector (type-parameters Key)
  (inputs (node (key Key) (P Position)))
  (outputs (box (key Key) (B Box))))
(component Occurrences detector (type-parameters Key Val)
  (inputs (cell (key Key) (P Position) (v Val))
    (shape (key Key) (P Position) (v Val))
    (transform (D D4) (default (D4_ID))))
  (outputs (candidate (key Key) (D D4) (P Position))
    (occurrence (key Key) (D D4) (P Position))))
(component Periods detector (type-parameters Key Val)
  (inputs (cell (key Key) (P Position) (v Val)))
  (outputs (period (key Key) (A Axis) (K number))
    (fundamental_period (key Key) (A Axis) (K number))
    (approximate_period (key Key) (A Axis) (K number))))
(component ExtentDivisions detector (type-parameters Key)
  (inputs (frame (key Key) (P Position)))
  (outputs (division (key Key) (A Axis) (N number) (K number) (G number))))
(component Wallpaper detector (type-parameters Key Val)
  (inputs (transform (D D4))
    (cell (key Key) (P Position) (v Val))
    (grid (key Key) (P Position))
    (period (key Key) (A Axis) (K number)))
  (outputs (symmetry (key Key) (D D4) (Delta Offset))
    (action (key Key) (P Position) (Q Position))))
(component DemonstrationConsistency task-structure (type-parameters Key Demonstrated Object Index Value)
  (inputs (value (key Key) (o Object) (i Index) (v Value))
    (prediction (key Key) (c Demonstrated) (o Object) (i Index) (v Value))
    (demonstration (key Key) (o Object) (o2 Object)))
  (outputs (counterexample (key Key) (c Demonstrated) (o Object) (o2 Object))
    (consistent (key Key) (c Demonstrated) (o Object) (o2 Object))
    (unconfirmed (key Key) (c Demonstrated))
    (confirmed (key Key) (c Demonstrated))))

;; Derivations: docs/arclog/arcdata.md#params.
(derivation Frame (fields (A Axis) (N number)) (columns (P Position)))
(derivation Division (fields (A Axis) (Count number) (Size number) (Gap number)) (columns (P Position) (P_outer Position) (P_inner Position)))

;; Constants: the #define lines of programs/lib/orientation.dl, in their order within each type, and the C4 constants of its c4_elem facts.
(constants Dir DIR_T DIR_B DIR_L DIR_R)
(constants Axis AXIS_V AXIS_H)
(constants DiagDir DIAG_TL DIAG_TR DIAG_BL DIAG_BR)
(constants DiagAxis DAXIS_DG DAXIS_AD)
(constants D4 D4_ID D4_CW D4_HT D4_CC D4_LR D4_TB D4_DG D4_AD)
(constants Sense SENSE_CW SENSE_CC)
(constants Sym SYM_1 SYM_LR SYM_TB SYM_HT SYM_DG SYM_AD SYM_BOX SYM_X SYM_C4 SYM_D4)
(constants C4 D4_ID D4_CW D4_HT D4_CC)

;; Facts: docs/arclog/arclog.md#program.
(fact input (columns (P Position) (Col Color)))
(fact ex_input (columns (E Example) (P Position) (Col Color)))
(fact ex_output (columns (E Example) (P Position) (Col Color)))

;; Macros, in the names of the lib.
(macro inside (columns (A A) (B B))
  (relative (:Base *B) (:X *A) (:X_rel *R))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B R) (:D D1) (:K *K1))
  (>= K1 0)
  (margin (:B R) (:D O1) (:K *K2))
  (>= K2 0)
  (margin (:B R) (:D D2) (:K *K3))
  (>= K3 0)
  (margin (:B R) (:D O2) (:K *K4))
  (>= K4 0))
(macro interior (columns (A A) (B B))
  (relative (:Base *B) (:X *A) (:X_rel *R))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B R) (:D D1) (:K *K1))
  (> K1 0)
  (margin (:B R) (:D O1) (:K *K2))
  (> K2 0)
  (margin (:B R) (:D D2) (:K *K3))
  (> K3 0)
  (margin (:B R) (:D O2) (:K *K4))
  (> K4 0))
(macro same_dist (columns (D D) (P1 P1) (P2 P2))
  (margin (:B *P1) *D *K)
  (margin (:B *P2) D K))
(macro same_line (columns (A A) (P P) (Q Q))
  (OR ((perp *A *A2) (axis_of *D (:A A2)) (margin (:B *P) D *K) (margin (:B *Q) D K)) ((diag_perp (:Da A) (:Da2 A2)) (diag_axis_of D (:Da A2)) (corner_dist P (:Diag D) K) (corner_dist (:P Q) (:Diag D) K))))
(macro same_corner (columns (D Diag) (P1 P1) (P2 P2))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2))
  (margin (:B *P1) (:D D1) (:K *K1))
  (margin (:B *P2) (:D D1) (:K K1))
  (margin (:B P1) (:D D2) (:K *K2))
  (margin (:B P2) (:D D2) (:K K2)))
(macro same_slab (columns (D D) (P1 P1) (P2 P2))
  (margin (:B *P1) *D *K)
  (margin (:B *P2) D K)
  (axis_of D *A)
  (perp A *A2)
  (axis_of (:D *E) (:A A2))
  (opposite (:D E) (:Opp *E2))
  (margin (:B P1) (:D E) (:K *K1))
  (margin (:B P2) (:D E) (:K K1))
  (margin (:B P1) (:D E2) (:K *K2))
  (margin (:B P2) (:D E2) (:K K2)))
(macro nearer (columns (D D) (P P) (Q Q))
  (OR ((dir_elem *D) (margin (:B *P) D (:K *K1)) (margin (:B *Q) D (:K *K2)) (< K1 K2)) ((diag_dir_elem D) (corner_dist P (:Diag D) (:K K1)) (corner_dist (:P Q) (:Diag D) (:K K2)) (< K1 K2))))
(macro centered (columns (P P))
  (axis_of (:D *D1) (:A *A1))
  (opposite (:D D1) (:Opp *O1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B *P) (:D D1) (:K *K1))
  (margin (:B P) (:D O1) (:K K1))
  (margin (:B P) (:D D2) (:K *K2))
  (margin (:B P) (:D O2) (:K K2)))
(macro dist_pair (columns (P P) (D D) (K K) (K2 K2))
  (opposite *D (:Opp *O))
  (margin (:B *P) D *K)
  (margin (:B P) (:D O) (:K *K2)))
(macro diag_dist (columns (P P) (Diag Diag) (A A) (K1 K1) (K2 K2))
  (diag_dirs (:D *Diag) *A *D1 *D2)
  (margin (:B *P) (:D D1) (:K *K1))
  (margin (:B P) (:D D2) (:K *K2)))
(macro axis_extents (columns (P P) (A A) (N1 N1) (N2 N2))
  (perp *A *A2)
  (frame_extent *P A (:N *N1))
  (frame_extent P (:A A2) (:N *N2)))
(macro box_extent (columns (B B) (P P) (A A) (N N))
  (axis_elem *A)
  (relative (:Base *B) (:X *P) (:X_rel *R))
  (frame_extent (:P R) A *N))
(macro axis_inset (columns (D D) (K1 K1) (K2 K2) (B B))
  (opposite *D (:Opp *O))
  (edge_inset D (:K *K1) (:B *B1))
  (edge_inset (:D O) (:K *K2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
(macro uniform_inset (columns (K K) (B B))
  (axis_of (:D *D1) (:A *A1))
  (perp (:A A1) *A2)
  (axis_of (:D *D2) (:A A2))
  (axis_inset (:D D1) (:K1 *K) (:K2 K) (:B *B1))
  (axis_inset (:D D2) (:K1 K) (:K2 K) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
(macro corner_inset (columns (Diag Diag) (K K) (B B))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2))
  (edge_inset (:D D1) *K (:B *B1))
  (edge_inset (:D D2) K (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))
(macro edge_outset (columns (D D) (K K) (B B))
  (edge_inset *D *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
(macro corner_outset (columns (Diag Diag) (K K) (B B))
  (corner_inset *Diag *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
(macro axis_outset (columns (D D) (K1 K1) (K2 K2) (B B))
  (axis_inset *D *K1 *K2 (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
(macro uniform_outset (columns (K K) (B B))
  (uniform_inset *K (:B *I))
  (relative (:Base I) (:X 0) (:X_rel *B)))
(macro jump (columns (P P) (D D) (K K) (Q Q))
  (jump_offset *D *K *V)
  (compose (:A *P) (:B V) (:C *Q)))
(macro jump_offset (columns (D D) (K K) (V V))
  (OR ((dir_elem *D) (opposite D (:Opp *O)) (edge_inset (:D O) *K (:B *I)) (edge_outset D K (:B *U)) (compose (:A I) (:B U) (:C *V)))
    ((diag_dir_elem D) (diag_opposite D (:Opp O)) (corner_inset (:Diag O) K (:B I)) (corner_outset (:Diag D) K (:B U)) (compose (:A I) (:B U) (:C V)))))
(macro frame_offset (columns (P P) (A A) (K K) (V V))
  (sub_extent *P *A *K)
  (axis_of *D A)
  (jump_offset D K *V))
(macro neighbor (columns (P P) (D D) (Q Q))
  (step_offset *D *V)
  (compose (:A *P) (:B V) (:C *Q)))
(macro split (columns (P P) (A A) (Along Along) (Across Across))
  (axis_of *D *A)
  (opposite D (:Opp *O))
  (margin (:B *P) D (:K *K1))
  (margin (:B P) (:D O) (:K *K2))
  (axis_inset D K1 K2 (:B *Along))
  (relative (:Base Along) (:X P) (:X_rel *Across)))
(macro perp_dir (columns (D D) (D2 D2))
  (axis_of *D *A)
  (perp A *A2)
  (axis_of (:D *D2) (:A A2)))
(macro diag_dirs (columns (D Diag) (A A) (D1 D1) (D2 D2))
  (corner_dir (:C *Diag) *A (:D *D1))
  (perp A *A2)
  (corner_dir (:C Diag) (:A A2) (:D *D2)))
(macro apply_dir (columns (D T) (Dir D) (Dir_out D2))
  (d4_elem (:D *T))
  (dir_elem *D)
  (dir_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))
(macro apply_diag_dir (columns (D T) (Dir D) (Dir_out D2))
  (d4_elem (:D *T))
  (diag_dir_elem *D)
  (diag_dir_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))
(macro apply_dir8 (columns (D T) (Dir D) (Dir_out D2))
  (d4_elem (:D *T))
  (dir8_elem *D)
  (dir8_elem (:D *D2))
  (step_offset D (:V *S))
  (apply (:D T) (:P S) (:P_out *S2))
  (step_offset (:D D2) (:V S2)))
(macro Flood
  (component Flood construction (type-parameters Key)
    (inputs (node (key Key) (P Position))
      (source (key Key) (P Position))
      (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
    (outputs (reached (key Ky) (P P))))
  (INIT &propagation Propagation
    (source ((:key Ky) (:n P))
      (self.source (:key *Ky) *P)
      (self.node (:key Ky) P))
    (edge ((:key Ky) (:a P) (:b Q))
      (self.node (:key *Ky) *P)
      (self.step *Delta)
      (compose (:A P) (:B Delta) (:C *Q))
      (self.node (:key Ky) (:P Q))))
  (output reached
    (&propagation.reached (:key *Ky) (:n *P))))
(macro CellDistance
  (component CellDistance construction (type-parameters Key)
    (inputs (node (key Key) (P Position))
      (source (key Key) (P Position))
      (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
    (outputs (distance (key Ky) (P P) (K K))
      (predecessor (key Ky) (Q Q) (P P))))
  (INIT &distance Distance
    (source ((:key Ky) (:n P))
      (self.source (:key *Ky) *P))
    (edge ((:key Ky) (:a P) (:b Q))
      (self.node (:key *Ky) *P)
      (self.step *Delta)
      (compose (:A P) (:B Delta) (:C *Q))
      (self.node (:key Ky) (:P Q))))
  (output distance
    (&distance.distance (:key *Ky) (:n *P) *K))
  (output predecessor
    (&distance.predecessor (:key *Ky) (:b *Q) (:a *P))))
(macro Connectivity
  (component Connectivity construction (type-parameters Key)
    (inputs (node (key Key) (P Position))
      (step (Delta Offset) (default (grid
        (_ 1 _)
        (1 @_ 1)
        (_ 1 _)))))
    (outputs (component (key Ky) (P P) (Id Id))
      (connected (key Ky) (P P) (Q Q))
      (adjacent (key Ky) (P P) (Q Q))))
  (INIT &quotient Quotient
    (edge ((:a Ky P) (:b Ky (:P Q)))
      (OR ((self.node (:key *Ky) *P) (= *Q P))
        ((&adjacent_node Ky P Q)))))
  (RULE &adjacent_node
    (self.node (:key *Ky) *P)
    (self.step *Delta)
    (compose (:A P) (:B Delta) (:C *Q))
    (self.node (:key Ky) (:P Q)))
  (output component
    (&quotient.class (:a *Ky *P) *Id))
  (output connected
    (&quotient.class (:a *Ky *P) *Id)
    (&quotient.class (:a Ky (:P *Q)) Id))
  (output adjacent
    (&adjacent_node *Ky *P *Q)))
(macro Ray
  (component Ray construction (type-parameters Key)
    (inputs (source (key Key) (P Position))
      (node (key Key) (P Position))
      (dir (key Key) (D Dir8)))
    (outputs (ray (key Ky) (P P) (D D) (K K) (Origin Origin))
      (end (key Ky) (P P) (D D) (K K) (Origin Origin))))
  (INIT &distance Distance
    (key ((self.source (:key ^Ky) (:P ^Origin)) (self.dir (:key Ky) ^D))
      (source ((:n Origin)))
      (edge ((:a P) (:b Q))
        (OR ((= *P Origin))
          ((OR ((axis_of D *A)) ((diag_dir_elem D) (axis_elem A))) (sub_extent (:P Origin) A *K) (jump (:P Origin) D K (:Q P)) (self.node (:key Ky) P)))
        (neighbor P D *Q)
        (self.node (:key Ky) (:P Q)))))
  (output ray
    (&distance.distance (:key *Ky *D *Origin) (:n *P) *K))
  (output end
    (&distance.distance (:key *Ky *D *Origin) (:n *P) *K)
    (neighbor P D *Q)
    (NOT (&distance.distance (:key Ky D Origin) (:n Q)))))
(macro Division
  (component Division construction (type-parameters Key)
    (inputs (cell (key Key) (P Position))
      (parts (key Key) (A Axis) (N number))
      (side (key Key) (A Axis) (K number))
      (gap (key Key) (A Axis) (G number)))
    (outputs (tile (key Ky) (P P) (P_outer P_outer) (P_inner P_inner))))
  (INIT &divisions ExtentDivisions
    (frame ((:key Ky) P)
      (self.parts (:key *Ky))
      (self.cell (:key Ky) *P)))
  (RULE &counted_side
    (self.parts (:key *Ky) *A *N)
    (&divisions.division (:key Ky) A N *K *G))
  ;; The axes whose `parts` row counts one part, the extent of the
  ;; P_outer of a part that spans the axis.
  (RULE &whole_side
    (self.parts (:key *Ky) *A *N)
    (axis_of *D A)
    (axis_inset D (:K1 0) (:K2 0) (:B *P_whole))
    (frame_extent (:P P_whole) A N))
  (RULE &axis_divided
    (self.cell (:key *Ky) *P)
    (axis_elem *A)
    (OR ((self.gap (:key Ky) A *G))
      ((NOT (self.gap (:key Ky) A)) (= G 0)))
    (OR ((self.side (:key Ky) A *K))
      ((&counted_side Ky A K G))
      ((&whole_side Ky A) (frame_extent P A (:N K))))
    (axis_of *D A)
    (opposite D (:Opp *O))
    (margin (:B P) D (:K *T))
    (margin (:B P) (:D O) (:K *T2))
    (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
    (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
    (axis_inset D (:K1 I) (:K2 I2) (:B *P_outer))
    (axis_inset D (:K1 R) (:K2 R2) (:B *P_inner))
    (frame_extent (:P P_inner) A (:N K)))
  (RULE &axis_tile
    (OR ((&axis_divided *Ky *P *A *P_outer *P_inner))
      ((self.cell (:key Ky) P)
       (axis_elem A)
       (NOT (self.parts (:key Ky) A))
       (NOT (self.side (:key Ky) A))
       (split P A (:Along P_inner))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
  (output tile
    (&axis_tile *Ky *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&axis_tile Ky P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner))))

;; Proposers: the domain proposers of docs/arclog/arclog.md#program, then the components of programs/proposers.dl, each with the columns of its propose relation, apart from PanelCombine, whose columns are those of a set-keyed table, one row for each panel of each entry: the entry's id, the entry's output color, the panel's place in the arrangement's frame, and the color of the panel's cell.
(proposer AxisDomain native (columns (A Axis)))
(proposer BoxDomain native (columns (B Box)))
(proposer ColorDomain native (columns (C Color)))
(proposer D4Domain native (columns (D D4)))
(proposer DiagAxisDomain native (columns (Da DiagAxis)))
(proposer DiagDirDomain native (columns (D DiagDir)))
(proposer DirDomain native (columns (D Dir)))
(proposer NumberDomain native (columns (N number)))
(proposer PositionDomain native (columns (P Position)))
(proposer SenseDomain native (columns (S Sense)))
(proposer SymDomain native (columns (S Sym)))
(proposer ColorColorDomain native (columns (C_from Color) (C_to Color)))
(proposer DiagDirAxisDomain native (columns (D DiagDir) (A Axis)))
(proposer NumberDirDomain native (columns (N number) (D Dir)))
(proposer SharedColor arclog (columns C))
(proposer DominantColor native (columns (C Color)))
(proposer RarestColor native (columns (C Color)))
(proposer OutNewColor arclog (columns C))
(proposer AnyOutNewColor arclog (columns C))
(proposer VanishedColor arclog (columns C))
(proposer ChangedColor arclog (columns C))
(proposer UnchangedColor arclog (columns C))
(proposer ChangedPairs arclog (columns C_from C_to))
(proposer VanishedNewPairs arclog (columns C_from C_to))
(proposer ScaleRatio native (columns (K number)))
(proposer DivisorRatio native (columns (K number)))
(proposer DimDiff native (columns (D number)))
(proposer ConstInDim arclog (columns N))
(proposer ConstOutDim arclog (columns N))
(proposer ConstOutDimAxis arclog (columns A N))
(proposer TileCount native (columns (N number)))
(proposer TileDim native (columns (D number)))
(proposer Period native (columns (K number)))
(proposer SepTileCount native (columns (N number)))
(proposer SepTileCountAxis native (columns (A Axis) (N number)))
(proposer SepTileDim native (columns (D number)))
(proposer SepThickness native (columns (G number)))
(proposer TileD4 native (columns (Pt Position) (T D4)))
(proposer PanelCombine native (columns (Id Ident) (C_out Color) (P Position) (C Color)))
