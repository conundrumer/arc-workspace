//! The check of the pooled and lifted reads, the walk of a form's reads
//! that the checks of reads share, and the decision of which relations of a
//! checked program have an Example column.

use super::types::result;
use super::{Check, CheckId, CheckInput, CheckResult, Prefix, PrefixResult, Refusal, CheckCacheKey, KeyInput};
use crate::hash::StableHashSet;
use crate::program::canonical::{prediction, relation_of, CanonicalOrder, SearchBudget};
use crate::program::path::{node_at, NodePath, NodeRef};
use crate::program::{Atom, ColumnName, FactRelation, Form, Site, SiteArg};
use crate::resolver::{DependencyKind, GraphNodeIndex, Resolution, ResolvedProgram, Side};
use crate::types::each_site_label;

/// [`CheckId::PooledAndLiftedReads`].
pub struct PooledAndLiftedReadsCheck;

impl Check for PooledAndLiftedReadsCheck {
    fn id(&self) -> CheckId {
        CheckId::PooledAndLiftedReads
    }

    fn cache_key(&self, at: &KeyInput<'_>) -> Option<CheckCacheKey> {
        Some(at.base(self.id()))
    }

    /// Refuses each read that `docs/arclog/arclog.md#program` does not let
    /// its form make: a per-input form's read of `ex_input` or `ex_output`, a
    /// task-wide form's read of `input`, and a per-input form's read at a
    /// site on a column that holds an Example of the relation it reads, as
    /// [`ResolvedProgram::example_columns`] gives. A read of a form's own
    /// nodes, as an `Unfold` instance's of its outputs, is no read of another
    /// side.
    fn check(&self, input: &CheckInput<'_>) -> CheckResult {
        let program = input.scope.program;
        let mut order = None;
        let mut refusals = Vec::new();
        for read in form_reads(input.form, input.path) {
            let Some((node, false)) = read.node(program, input.path) else { continue };
            let Some(side) = program.form_side(&read.form) else { continue };
            let Some(message) = refused_read(program, side, node, read.atom) else { continue };
            let order = order.get_or_insert_with(|| CanonicalOrder::of(input.form, &mut SearchBudget::new()));
            refusals.push(Refusal { message: message.text().into(), at: order.canonical_path(&read.at) });
        }
        result(refusals)
    }

    /// Refuses each read of the partial form that [`Self::check`] refuses,
    /// where its atom is complete, and where it is open, a read that no
    /// later token undoes: a fact relation that the form's side does not let
    /// it read, and a site on a column that holds an Example of the relation
    /// the per-input form reads, at that site, whether or not the site holds
    /// a label yet. A refusal that rests on the per-input side, a read of
    /// `ex_input` or `ex_output`, a read at a site on such a column, stands
    /// only where [`side_is_final`] says that side is final, since a later
    /// token can still make the form task-wide. A refusal that rests on the
    /// task-wide side, a read of `input`, stands whatever the form is: that
    /// read is a per-input read, so the form is task-wide only by what no
    /// later token removes. The refusals stand at their paths in the partial
    /// form.
    fn check_prefix(&self, prefix: &Prefix<'_>) -> PrefixResult {
        let program = prefix.scope.program;
        let mut refusals = Vec::new();
        for read in form_reads(prefix.partial, prefix.path) {
            let Some((node, false)) = read.node(program, prefix.path) else { continue };
            let Some(side) = program.form_side(&read.form) else { continue };
            if side == Side::PerInput && !side_is_final(prefix, &read.form) {
                continue;
            }
            let refused = refused_read(program, side, node, read.atom);
            let early = prefix.is_open(&read.at) && side == Side::PerInput && !matches!(refused, Some(Refused::ExFact));
            let site = if early { example_site(program, node, read.atom) } else { None };
            let (message, at) = match (site, refused) {
                (Some(site), _) => (Refused::ExampleColumn, read.at.join(&site)),
                (None, Some(message)) => (message, read.at.clone()),
                (None, None) => continue,
            };
            refusals.push(Refusal { message: message.text().into(), at });
        }
        super::prefix::refused(refusals)
    }
}

/// Why a form may not make a read.
enum Refused {
    /// A per-input form reads `ex_input` or `ex_output`.
    ExFact,
    /// A task-wide form reads `input`.
    InputFact,
    /// A per-input form reads the Example column of a relation.
    ExampleColumn,
}

impl Refused {
    fn text(&self) -> &'static str {
        match self {
            Refused::ExFact => "a per-input form reads `ex_input` or `ex_output`, which only a task-wide form reads",
            Refused::InputFact => "a task-wide form reads `input`, which only a per-input form reads",
            Refused::ExampleColumn => "a per-input form reads the Example column of a relation, which it reads only pooled, with no site on that column",
        }
    }
}

/// Why a form of side `side` may not make `atom`, its read of `node`, or
/// `None` where it may.
fn refused_read(program: &ResolvedProgram, side: Side, node: GraphNodeIndex, atom: &Atom) -> Option<Refused> {
    let fact = match program.graph.nodes[node.0 as usize].kind {
        DependencyKind::Fact(fact) => Some(fact),
        _ => None,
    };
    match (side, fact) {
        (Side::PerInput, Some(FactRelation::ExInput | FactRelation::ExOutput)) => Some(Refused::ExFact),
        (Side::TaskWide, Some(FactRelation::Input)) => Some(Refused::InputFact),
        (Side::PerInput, None) if reads_example(program.example_columns(node, crate::resolver::output_of(&atom.relation)), atom) => {
            Some(Refused::ExampleColumn)
        }
        _ => None,
    }
}

/// Whether no later token of the prefix can change the side of the form at
/// `form`, a path in the program: a clause takes the side of its keyword,
/// and every other form, as `Sides::form` of the resolver gives, takes
/// the side its deciding form gives, which is complete once the prefix does
/// not hold it open. The deciding form is the form itself, but for the
/// `&prediction` clause of a `DEMO_RULE`, whose deciding form is the
/// `DEMONSTRATED` form that holds the rule.
fn side_is_final(prefix: &Prefix<'_>, form: &NodePath) -> bool {
    let within = NodePath(form.0[prefix.path.0.len()..].into());
    let deciding = match node_at(NodeRef::from(prefix.partial), &within) {
        Some(NodeRef::Clause(clause)) => {
            let rule = within.0.len().checked_sub(1).and_then(|len| node_at(NodeRef::from(prefix.partial), &NodePath(within.0[..len].into())));
            if relation_of(&clause.derives) == prediction() && matches!(rule, Some(NodeRef::DemoRule(_))) {
                NodePath(within.0[..within.0.len() - 2].into())
            } else {
                return true;
            }
        }
        Some(NodeRef::RigidDet(_)) => return true,
        _ => within,
    };
    !prefix.is_open(&deciding)
}

/// Whether a site of `atom` stands on a column of `examples`, at any depth
/// of the site.
fn reads_example(examples: &[crate::resolver::ExamplePath], atom: &Atom) -> bool {
    let mut found = false;
    for site in atom.sites.iter() {
        each_site_label(site, &mut Vec::new(), &mut |_, path| {
            found |= examples.iter().any(|example| path.starts_with(example));
        });
    }
    found
}

/// The path, relative to `atom`, of the first site of `atom` whose column
/// path starts with a column of an Example of the relation the atom reads,
/// whether or not the site holds a label yet.
fn example_site(program: &ResolvedProgram, node: GraphNodeIndex, atom: &Atom) -> Option<NodePath> {
    let examples = program.example_columns(node, crate::resolver::output_of(&atom.relation));
    fn walk(site: &Site, column: &mut Vec<ColumnName>, at: NodePath, examples: &[crate::resolver::ExamplePath]) -> Option<NodePath> {
        column.push(site.column.clone());
        let found = if examples.iter().any(|example| column.starts_with(example)) {
            Some(at.clone())
        } else {
            let mut fields = site.value.args.iter().zip(0u32..);
            fields.find_map(|(arg, index)| match arg {
                SiteArg::Field(field) => walk(field, column, at.child(index), examples),
                _ => None,
            })
        };
        column.pop();
        found
    }
    let mut sites = atom.sites.iter().zip(0u32..);
    sites.find_map(|(site, index)| walk(site, &mut Vec::new(), NodePath::default().child(index), examples))
}

/// One read of a form: the atom, its path relative to the form the check
/// reads, and the path in the program of the innermost form that holds it,
/// a form of a `DEMO_RULE` included, whose side the read takes.
pub(super) struct FormRead<'a> {
    pub atom: &'a Atom,
    pub at: NodePath,
    pub form: NodePath,
}

impl FormRead<'_> {
    /// The node of the graph that the read reads, where it reads one, with
    /// whether the read's own form is one of that node's forms, as an
    /// `Unfold` instance's read of its outputs is. `path` is the path in the
    /// program of the form the check reads.
    pub(super) fn node(&self, program: &ResolvedProgram, path: &NodePath) -> Option<(GraphNodeIndex, bool)> {
        let Some(Resolution::Node(node)) = program.resolution(&path.join(&self.at)) else { return None };
        Some((*node, program.forms_of(*node).contains(&self.form)))
    }
}

/// Each read of `form`, the form at `path` in the program, and of each form
/// it holds, in the order of the forms' paths.
pub(super) fn form_reads<'a>(form: &'a Form, path: &NodePath) -> Vec<FormRead<'a>> {
    fn walk<'a>(node: NodeRef<'a>, at: NodePath, form: &NodePath, out: &mut Vec<FormRead<'a>>) {
        if let Some(atom) = node.atom() {
            return out.push(FormRead { atom, at, form: form.clone() });
        }
        for (child, index) in node.children().into_iter().zip(0u32..) {
            if !is_form(child) {
                walk(child, at.child(index), form, out);
            }
        }
    }
    let mut out = Vec::new();
    for (at, node) in forms_within(form) {
        walk(node, at.clone(), &path.join(&at), &mut out);
    }
    out
}

/// `form` and each form of a `DEMO_RULE` it holds, with its path relative
/// to `form`, in the order of the paths.
pub(super) fn forms_within(form: &Form) -> Vec<(NodePath, NodeRef<'_>)> {
    fn walk<'a>(node: NodeRef<'a>, at: NodePath, out: &mut Vec<(NodePath, NodeRef<'a>)>) {
        if is_form(node) {
            out.push((at.clone(), node));
        }
        if matches!(node, NodeRef::Demonstrated(_) | NodeRef::DemoRule(_)) {
            for (child, index) in node.children().into_iter().zip(0u32..) {
                walk(child, at.child(index), out);
            }
        }
    }
    let mut out = Vec::new();
    walk(NodeRef::from(form), NodePath::default(), &mut out);
    out
}

/// Whether `node` is a form whose reads take its own side.
fn is_form(node: NodeRef<'_>) -> bool {
    matches!(node, NodeRef::Clause(_) | NodeRef::Instance(_) | NodeRef::Choose(_) | NodeRef::RigidDet(_) | NodeRef::Demonstrated(_))
}

/// The relations of `program` that have an Example column: `ex_input`,
/// `ex_output`, and each node of the dependency graph a column of which holds
/// an Example, as [`ResolvedProgram::example_columns`] gives. A per-input relation that a task-wide form reads lifted
/// has none of its own (`docs/arclog/arclog.md#program`).
pub fn example_relations(program: &ResolvedProgram) -> StableHashSet<GraphNodeIndex> {
    let nodes = (0..program.graph.nodes.len() as u32).map(GraphNodeIndex);
    let has_example = |node: &GraphNodeIndex| match program.graph.nodes[node.0 as usize].kind {
        DependencyKind::Fact(FactRelation::ExInput | FactRelation::ExOutput) => true,
        _ => !program.example_columns(*node, None).is_empty(),
    };
    nodes.filter(has_example).collect()
}
