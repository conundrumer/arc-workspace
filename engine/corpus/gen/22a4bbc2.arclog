;; 22a4bbc2

(DET &bg UnchangedColor)

(DET &mark AnyOutNewColor)

;; Counting edge: ranks run from this edge; its axis stacks the bars.
(DET &dir DirDomain)

;; The mark pattern along the bar sequence: mark_len marked bars, then mark_gap unmarked, repeating.
(DET &mark_len DivisorRatio)

(DET &mark_gap TileCount)

(RULE &cell_row
  (input *P)
  (&dir *D)
  (axis_of D *A)
  (split P A (:Along *R)))

(RULE &row
  (&cell_row *R))

(RULE &row_cell
  (&cell_row *P *R)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &row_color
  (&row_cell *R *P)
  (input P *Col))

(RULE &boundary
  (&row_color *R *Col)
  (&dir *D)
  (neighbor (:P R) D (:Q *R2))
  (NOT (&row_color (:R R2) Col)))

(RULE &run_of_blocked
  (&row (:R *P))
  (OR ((&boundary (:R P)))
      ((NOT (&row_cell (:R P))))))

;; Rows of the run each boundary starts: it carries on away from the counting
;; edge until the next boundary or a row with no ink.
(INIT &run_of Ray
  (source ((:P R))
    (&boundary *R))
  (node (P)
    (input *P)
    (NOT (&run_of_blocked P)))
  (dir ((:D O))
    (&dir *D)
    (opposite D (:Opp *O))))

(INIT &seq Order
  (member ((:t K))
    (&boundary *R)
    (&dir *D)
    (margin (:B R) D *K))
  (score ((:t K) (:S K))
    (&boundary *R)
    (&dir *D)
    (margin (:B R) D *K)))

(ALTS $choice "what a bar is" $Run
  (ALT $Object
    (INIT &comps Connectivity
      (key ((input *P ^Col)
            (NOT (&bg (:C Col))))
        (node (P)
          (input *P Col)
          (NOT (&bg (:C Col))))))

    (INIT &obj_box BoundingBox
      (key ((&comps.component *P ^Id))
        (cell (P)
          (&comps.component *P Id))))

    (RULE &obj_margin
      (&dir *D)
      (&obj_box.box (:key *Id) *B)
      (margin B D *K))

    (INIT &seq Order
      (member ((:t K))
        (&obj_margin *K))
      (score ((:t K) (:S K))
        (&obj_margin *K)))

    (RULE &mark_cell
      (&mark_margin *K)
      (&obj_margin *Id K)
      (&comps.component *P Id))))

(RULE &mark_margin
  (&seq.rank (:t *K) *R)
  (&mark_len (:K *N))
  (&mark_gap (:N *G))
  (divide (:T R) (:Side N) (:Gap G)))

(RULE &mark_cell
  (&mark_margin *K)
  (&dir *D)
  (&boundary (:R *R_top))
  (margin (:B R_top) D K)
  (&run_of.ray (:P *R) (:Origin R_top))
  (&row R)
  (&row_cell R *P))

(RULE &output
  (OR ((&mark_cell *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&mark_cell P)))))
