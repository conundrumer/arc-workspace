;; 78e78cff

(INIT &palette_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &palette Order
  (member ((:t Col))
    (&palette_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&palette_count.size (:key *Col) *N)))

;; The lone cell of its color.
(INIT &lone Singleton
  (key ((input *P ^Col))
    (member ((:v P))
      (input *P Col))))

(RULE &seed
  (&lone.value (:key *Col) (:v *P)))

(RULE &frame
  (input *P *Col)
  (NOT (&palette.maximal (:t Col)))
  (NOT (&seed Col)))

(INIT &bbox BoundingBox
  (cell (P)
    (&frame *P)))

(RULE &box_cell
  (&bbox.box *B)
  (input *P)
  (inside (:A P) B))

(INIT &flood Flood
  (node (P)
    (&box_cell *P)
    (NOT (&frame P)))
  (source (P)
    (&seed *P)))

(INIT &leak Ray
  (source (P)
    (&flood.reached *P))
  (node (P)
    (input *P)
    (NOT (&frame P)))
  (dir (D)
    (dir_elem *D)))

(RULE &fill
  (&leak.ray *P))

(ALTS $choice "how the fill escapes the box; the cases diverge only where a frame cell lies on the seed's row or column inside the box" $Leak
  (ALT $Crosshair
    (RULE &cross_blocked
      (axis_elem (:A *Key))
      (&frame *P))

    ;; Keyed by the cast axis: a mark on the seed's line of one axis casts
    ;; along the other.
    (INIT &cross Ray
      (key ((OR ((&box_cell *P)
                 (NOT (&frame P))
                 (&seed (:P *S))
                 (same_line (:A *A_seed) P (:Q S))
                 (perp (:A A_seed) (:A2 ^A)))
                ((axis_of *D A))))
        (source (P)
          (&box_cell *P)
          (NOT (&frame P))
          (&seed (:P *S))
          (same_line (:A *A_seed) P (:Q S))
          (perp (:A A_seed) (:A2 A)))
        (node (P)
          (axis_of *D A)
          (input *P)
          (NOT (&cross_blocked (:Key A) P)))
        (dir (D)
          (axis_of *D A))))

    (RULE &cross_cell
      (axis_elem (:A *Key))
      (input *P))

    (RULE &fill
      (&cross.ray (:key (:A *Ky)) *P)
      (&cross_cell (:Key Ky) P))))

(RULE &output
  (OR ((&fill *P)
       (&seed *Col))
      ((input P Col)
       (NOT (&fill P)))))
