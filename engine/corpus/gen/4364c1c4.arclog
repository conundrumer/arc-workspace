;; 4364c1c4

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The slide distance.
(DET &shift DivisorRatio)

(DET &sense SenseDomain)

;; The field is the commonest color; the parts are what it leaves.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &bg
  (&field.maximal (:t *Col)))

;; A part: one color's touching cells. A cell holds one color, so the
;; parts' cell sets are disjoint and the label alone names the part.
(INIT &comps Connectivity
  (key ((input *P ^Col)
        (NOT (&bg Col)))
    (node (P)
      (input *P Col)
      (NOT (&bg Col)))))

(RULE &part
  (&comps.component (:key *Col) *P *Id))

(RULE &side
  (&part *Id *P)
  (dir_elem (:D *D2))
  (neighbor P (:D D2) *Q)
  (&part (:Id *Id2) (:P Q))
  (!= Id2 Id)
  (opposite (:D D2) (:Opp *D)))

(RULE &slide_dir
  (&sense *S)
  (turn S *D (:D2 *D_out)))

(ALTS $choice "what fixes the slide direction" $Turn
  (ALT $Table
    ;; Where each part seats on its example's output: the translations that
    ;; carry every cell of the part onto an output cell of its color.
    (INIT &seating Occurrences
      (key ((OR ((&part ^E ^Id *P *Col))
                ((&part E Id)
                 (ex_output E P Col))))
        (cell (P (:v Col))
          (&part E Id)
          (ex_output E *P *Col))
        (shape (P (:v Col))
          (&part E Id *P *Col))))

    (DET &slide_map
      (&side *E *Id *D)
      (&seating.occurrence (:key E Id) (:P *M))
      (&shift *K)
      (dir_elem (:D *D_out))
      (jump_offset (:D D_out) K (:V M)))

    (RULE &slide_dir
      (&slide_map *D *D_out))))

(RULE &moved
  (&part *Id (:P *P2) *Col)
  (&side Id (:D *D_side))
  (&slide_dir (:D D_side) (:D_out *D))
  (&shift *K)
  (jump (:P P2) D K (:Q *P)))

(RULE &output
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (&bg Col))))
