;; 5ffb2104

(DET &bg DominantColor)

(DET &grav DirDomain)

(INIT &obj Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(INIT &settle Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj.component *P *Id)
    (&grav *D)
    (&obj.component (:P *P2) (:Id *Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (&obj.component *P *Id)
    (&grav *D)
    (margin (:B P) D *K)))

(RULE &fallen
  (&obj.component (:key *Col) (:P *P2) *Id)
  (&settle.distance (:n Id) *K)
  (&grav *D)
  (jump_offset D K (:V *Delta))
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (NOT (&fallen P))
       (&bg (:C Col)))))
