;; 3b4c2228

(DET &out_diag DiagDirDomain)

(DET &out_pos Frame)

(RULE &diag_diagonal
  (&out_pos *P)
  (&out_diag *D)
  (diag_dist P (:Diag D) (:K1 *Ring) (:K2 Ring)))

(DET &block_color VanishedColor)

(DET &block_shape Frame)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(RULE &on
  (input *P *Col)
  (&block_color (:C Col)))

(INIT &comps Connectivity
  (node (P)
    (&on *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(INIT &same Inclusion
  (pattern ((:m P))
    (&block_shape *P))
  (observed ((:observed O) (:m P_inner))
    (&bbox.cell (:key (:Id *O)) *P)
    (&bbox.box (:key (:Id O)) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &block
  (&same.equal (:observed *Id)))

(INIT &blocks Cardinality
  (member ((:m Id))
    (&block *Id))
  (domain ()
    (input)))

(RULE &total
  (&blocks.size *N))

(ALTS $detect "how the block shape's occurrences are found" $Object
  (ALT $Placement
    (INIT &occ Occurrences
      (cell (P)
        (&on *P))
      (shape (P)
        (&block_shape *P)))

    (INIT &placements Cardinality
      (member ((:m P))
        (&occ.occurrence *P)))

    (RULE &total
      (&placements.size *N))))

(ALTS $render "how the count renders" $Tally
  (ALT $Lookup
    (DET &lookup_grid
      (&blocks.size *E *N)
      (ex_output E *P *Col))

    (RULE &output
      (&total *N)
      (&lookup_grid N *P *Col))))

(RULE &marked
  (&diag_diagonal *P (:Ring *K))
  (&total *N)
  (< K N))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((&out_pos P)
       (&total)
       (NOT (&marked P))
       (&bg (:C Col)))))
