;; e98196ab

(DET &bg DominantColor)

(DET &tile_decompose Division)

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(RULE &decompose
  (&tile_decompose *P *P_outer *P_inner))

(ALTS $choice "out's choice column (decompose)" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (DET &tile_dim ConstOutDimAxis)

    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&tile_dim A (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(RULE &ink
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&decompose (:P P_grid) (:P_inner *P)))

(RULE &output
  (OR ((&ink *P *Col))
      ((&decompose (:P_inner P))
       (NOT (&ink P))
       (&bg (:C Col)))))
