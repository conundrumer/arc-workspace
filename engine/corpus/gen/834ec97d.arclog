;; 834ec97d

(DET &period TileCount)

(DET &dir DirDomain)

(DET &bg DominantColor)

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The marker's row, walked outward from the marker.
(INIT &row Ray
  (source (P)
    (&marker *P))
  (node (P)
    (input *P))
  (dir ((:D D2))
    (&dir *D)
    (perp_dir D *D2)))

;; A whole number of jumps out.
(RULE &beam
  (&row.ray *P *K)
  (&period (:N *W))
  (divide (:T K) (:Side W) (:Gap 0) (:Remainder 0)))

(RULE &rays_dir
  (&dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(DET &fill AnyOutNewColor)

(RULE &moved
  (&marker (:P *P2))
  (&dir *D)
  (neighbor (:P P2) D (:Q *P)))

(ALTS $choice "how the alternating columns are picked; coincide at period 2" $Period
  (ALT $Parity
    ;; An even distance out: a cell of the row lies midway.
    (RULE &beam
      (&row.ray (:P *M) (:D *D2) *K)
      (jump (:P M) (:D D2) K (:Q *P))
      (input P))))

;; The filled region: each beam cell and its column toward the edge opposite
;; the move.
(INIT &rays Ray
  (source (P)
    (&beam *P))
  (node (P)
    (&rays_dir)
    (input *P))
  (dir (D)
    (&rays_dir *D)))

(RULE &rays_cell
  (&beam)
  (input *P))

(RULE &rays_ray
  (&rays.ray *P *D *K (:Origin *Src))
  (&rays_cell P))

(RULE &output
  (OR ((&rays.ray *P)
       (&rays_cell P)
       (&fill (:C *Col)))
      ((&moved P)
       (&marker Col))
      ((input P)
       (NOT (&rays_ray P))
       (NOT (&moved P))
       (&bg (:C Col)))))
