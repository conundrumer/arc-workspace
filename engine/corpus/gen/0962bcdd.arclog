;; 0962bcdd

(DET &bg DominantColor)

(DET &radius SepThickness)

(RULE &arm
  (input *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &marker
  (input *P (:Col *C_center))
  (&arm P (:Col *C_arm))
  (ALL ((dir_elem *D))
       ((&arm P D (:Col C_arm)))))

(RULE &arm_dir
  (&marker (:P *Key))
  (dir_elem *D))

;; One cast per kind, keyed by the marker cell.
(INIT &arm2 Ray
  (key ((OR ((&marker (:P ^Pm)))
            ((&arm_dir (:Key Pm) *D))
            ((&arm_dir (:Key Pm))
             (input *P))))
    (source ((:P Pm))
      (&marker (:P Pm)))
    (node (P)
      (&arm_dir (:Key Pm))
      (input *P))
    (dir (D)
      (&arm_dir (:Key Pm) *D))))

(RULE &arm_cell
  (&marker (:P *Key))
  (input *P))

(RULE &diag_dir
  (&marker (:P *Key))
  (diag_dir_elem *D))

(INIT &diag Ray
  (key ((OR ((&marker (:P ^Pm)))
            ((&diag_dir (:Key Pm) *D))
            ((&diag_dir (:Key Pm))
             (input *P))))
    (source ((:P Pm))
      (&marker (:P Pm)))
    (node (P)
      (&diag_dir (:Key Pm))
      (input *P))
    (dir (D)
      (&diag_dir (:Key Pm) *D))))

(RULE &diag_cell
  (&marker (:P *Key))
  (input *P))

(RULE &paint
  (&radius (:G *R))
  (OR ((&arm2.ray (:key *Pm) *P *K)
       (&arm_cell (:Key Pm) P)
       (&marker (:P Pm) (:C_arm *Col)))
      ((&diag.ray (:key Pm) P K)
       (&diag_cell (:Key Pm) P)
       (&marker (:P Pm) (:C_center Col))))
  (!= K 0)
  (<= K R))

(ALTS $choice "how the marker's growth is drawn" $Ray
  (ALT $Lookup
    (DET &star
      (ex_output *E *P *Col)
      (NOT (&bg (:C Col))))

    (INIT &comps Connectivity
      (key ((&star ^E *P))
        (node (P)
          (&star E *P)))
      (step ((:Delta S))
        (diag_dir_elem *D)
        (step_offset D (:V *S))))

    (DET &star_marker
      (&marker *E *P *C_center *C_arm)
      (&comps.component (:key E) P *Id))

    (DET &star_cell
      (&comps.component (:key *E) *P *Id)
      (&star E P *Col)
      (&star_marker E Id (:P *Pm))
      (relative (:Base Pm) (:X P) (:X_rel *Delta)))

    (DET &template_arm
      (&star_marker *E *Id (:C_arm *Ca))
      (&star_cell E Id *Delta (:Col Ca)))

    (DET &template_center
      (&star_marker *E *Id (:C_center *Cc))
      (&star_cell E Id *Delta (:Col Cc)))

    (RULE &paint
      (&marker (:P *C) (:C_center *Cc) (:C_arm *Ca))
      (OR ((&template_arm (:Delta *V))
           (= *Col Ca))
          ((&template_center (:Delta V))
           (= Col Cc)))
      (compose (:A C) (:B V) (:C *P))
      (input P))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
