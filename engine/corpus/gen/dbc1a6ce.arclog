;; dbc1a6ce

(DET &bg DominantColor)

(INIT &spans Ray
  (source ((:P Q))
    (input (:P *Q) *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P))
  (dir (D)
    (axis_elem *A)
    (axis4_of *D A)))

(RULE &spans_between
  (input *P (:Col *Bg))
  (&bg (:C Bg))
  (axis_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&spans.ray P D)
  (&spans.ray P (:D O)))

(DET &fill AnyOutNewColor)

(RULE &output
  (OR ((&spans_between *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&spans_between P)))))
