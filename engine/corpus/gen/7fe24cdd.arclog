;; 7fe24cdd

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tile_d4 (:Pt *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_in))
    (&tile_d4 (:T *D))
    (apply D (:P P_in) (:P_out *P_intile))))

(ALTS $choice "how each tile's rotation is set" $Table
  (ALT $Spin
    (DET &anchor PositionDomain)

    (INIT &output_tiling2 Tiling
      (outer ((:P P_tile))
        (&anchor (:P *P_anchor))
        (c4_elem (:D *R))
        (apply (:D R) (:P P_anchor) (:P_out *P_tile)))
      (inner ((:P P_intile))
        (input (:P *P_in))
        (c4_elem (:D *R))
        (apply (:D R) (:P P_in) (:P_out *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&anchor (:P *P_anchor))
      (c4_elem (:D *R))
      (apply (:D R) (:P P_anchor) (:P_out *P_tile))
      (apply (:D R) (:P P_in) (:P_out *P_intile))
      (&output_tiling2.cell (:P_outer P_tile) (:P_inner P_intile) *P))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
