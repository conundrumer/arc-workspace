;; 9772c176

(DET &bg DominantColor)

;; the wedges' color
(DET &cap AnyOutNewColor)

(RULE &shape
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &obj Connectivity
  (node (P)
    (&shape *P)))

(RULE &member
  (&obj.component *P *Id))

(INIT &edge Boundary
  (key ((&member ^Id *P))
    (cell (P)
      (&member Id *P))))

(RULE &base
  (dir_elem *D)
  (&edge.exposed (:key *Id) *P D))

(ALTS $choice "what the wedge's base holds" $Rim
  (ALT $Extreme
    (INIT &hull BoundingBox
      (key ((&member ^Id *P))
        (cell (P)
          (&member Id *P))))

    (RULE &base
      (&member *Id *P)
      (&hull.box (:key Id) *B)
      (inside (:A P) B)
      (same_dist *D (:P1 P) (:P2 B))))
  (ALT $Widest
    ;; The object's lines along axis a, each keyed by its coordinate on the other axis.
    (INIT &line BoundingBox
      (key ((&member ^Id *P)
            (axis_elem ^A)
            (perp A *A2)
            (split P (:A A2) (:Along ^L)))
        (cell (P)
          (&member Id *P)
          (axis_elem A)
          (perp A *A2)
          (split P (:A A2) (:Along L)))))

    (INIT &longest Order
      (key ((&line.box (:key ^Id ^A *L) *B)
            (&line.cell (:key Id A L) *P)
            (box_extent B P A *N))
        (member ((:t (:V L) (:S N)))
          (&line.box (:key Id A *L) *B)
          (&line.cell (:key Id A L) *P)
          (box_extent B P A *N))
        (score ((:t (:V L) (:S N)) (:S N))
          (&line.box (:key Id A *L) *B)
          (&line.cell (:key Id A L) *P)
          (box_extent B P A *N))))

    (RULE &base
      (axis_of *D *A)
      (&longest.maximal (:key *Id A) (:t (:V *L)))
      (&line.box (:key Id A L) *B)
      (&member Id *P)
      (inside (:A P) B)
      (same_dist D (:P1 P) (:P2 B)))))

;; A side's base cells cast the two diagonals that lead away from that side.
(INIT &spread Ray
  (key ((OR ((&base ^Id ^D *P))
            ((&base Id D)
             (corner_dir (:C *Dg) D))))
    (source (P)
      (&base Id D *P))
    (node (P)
      (&base Id D)
      (corner_dir (:C *Dg) D)
      (input *P))
    (dir ((:D Dg))
      (&base Id D)
      (corner_dir (:C *Dg) D))))

(RULE &cap_cell
  (&spread.ray (:key *Id *D) *P (:D *Dg1))
  (NOT (&shape P))
  (&spread.ray (:key Id D) P (:D *Dg2))
  (!= Dg1 Dg2))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&cap_cell P)))
      ((&cap_cell P)
       (&cap (:C Col)))))
