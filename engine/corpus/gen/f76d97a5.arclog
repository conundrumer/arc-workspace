;; f76d97a5

(DET &marker SharedColor)

(DET &bg AnyOutNewColor)

(RULE &main
  (input *Col)
  (NOT (&marker (:C Col))))

(RULE &output
  (OR ((input *P (:Col *Col2))
       (&marker (:C Col2))
       (&main *Col))
      ((input P (:Col *Col22))
       (NOT (&marker (:C Col22)))
       (&bg (:C Col)))))
