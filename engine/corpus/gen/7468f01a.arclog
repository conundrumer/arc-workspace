;; 7468f01a

(DET &bg DominantColor)

(DET &transform D4Domain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &output
  (&ink (:P *P2) *Col)
  (&bbox.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P_inner))
  (&transform *D)
  (apply D (:P P_inner) (:P_out *P)))
