;; 292dd178

(DET &wall RarestColor)

(DET &fill AnyOutNewColor)

(RULE &wall_cell
  (input *P *Col)
  (&wall (:C Col)))

(INIT &comp Connectivity
  (node (P)
    (&wall_cell *P)))

(INIT &bbox BoundingBox
  (key ((&comp.component *P ^Id))
    (cell (P)
      (&comp.component *P Id))))

(RULE &hole
  (&bbox.box *B)
  (input *P)
  (interior (:A P) B))

(INIT &flow Ray
  (source (P)
    (&hole *P))
  (node (P)
    (input *P)
    (NOT (&wall_cell P)))
  (dir (D)
    (dir_elem *D)))

(RULE &painted
  (&flow.ray *P))

(ALTS $choice "how the fill reaches outside the box through the break" $Flow
  (ALT $Cast
    (INIT &cast Ray
      (key ((OR ((&bbox.box *B)
                 (input *P)
                 (inside (:A P) B)
                 (same_dist ^D (:P1 P) (:P2 B))
                 (NOT (&wall_cell P)))
                ((dir_elem D))))
        (source (P)
          (&bbox.box *B)
          (input *P)
          (inside (:A P) B)
          (same_dist D (:P1 P) (:P2 B))
          (NOT (&wall_cell P)))
        (node (P)
          (dir_elem D)
          (input *P))
        (dir (D)
          (dir_elem D))))

    (RULE &cast_cell
      (dir_elem (:D *Key))
      (input *P))

    (RULE &painted
      (OR ((&hole *P))
          ((&cast.ray (:key (:D *Ky)) P)
           (&cast_cell (:Key Ky) P))))))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
