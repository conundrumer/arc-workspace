;; 09629e4f

(DET &bg ColorDomain)

(DET &gap DivisorRatio)

(DET &tile_dim SepTileCount)

(INIT &tile_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A K)
    (axis_elem *A)
    (&tile_dim (:N *K)))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(RULE &tile
  (&tile_division.tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(INIT &sparse_count Cardinality
  (key ((&tile (:P_grid *P) (:P_tile ^T))
        (input P *Col)
        (&bg (:C Col)))
    (member ((:m P))
      (&tile (:P_grid *P) (:P_tile T))
      (input P *Col)
      (&bg (:C Col)))))

(INIT &sparse Order
  (member ((:t T))
    (&sparse_count.size (:key *T)))
  (score ((:t T) (:S N))
    (&sparse_count.size (:key *T) *N)))

(RULE &template
  (&sparse.maximal (:t *P_tile)))

(ALTS $choice "what tells the template apart" $Sparse
  (ALT $Marker
    (DET &marker ChangedColor)

    (RULE &has_marker
      (&tile (:P_grid *P) *P_tile)
      (input P *Col)
      (&marker (:C Col)))

    (RULE &template
      (&tile *P_tile)
      (NOT (&has_marker P_tile)))))

(RULE &output
  (OR ((&tile (:P_grid *P) *P_tile)
       (&template (:P_tile *Q))
       (&tile (:P_grid *P_src) (:P_tile Q) (:P_intile P_tile))
       (input (:P P_src) *Col))
      ((input P Col)
       (NOT (&tile (:P_grid P))))))
