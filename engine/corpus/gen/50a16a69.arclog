;; 50a16a69

(DET &move_dir DirDomain)

;; The filler color is the one that fills whole grid lines.
(INIT &line Singleton
  (key ((input *P *Col)
        (axis_elem *A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem *A)
      (split P A (:Along L)))))

(RULE &pattern
  (input *P *Col)
  (NOT (&line.value (:v Col))))

(INIT &si Periods
  (cell (P (:v Col))
    (&pattern *P *Col)))

(RULE &phase
  (input *P)
  (dir_elem *D)
  (margin (:B P) D (:K *T))
  (axis_of D *A)
  (OR ((&si.fundamental_period A *K)
       (divide T (:Side K) (:Gap 0) (:Remainder *J)))
      ((NOT (&si.fundamental_period A))
       (= J T))))

(RULE &output
  (axis_of (:D *D1) *A)
  (perp A *A2)
  (axis_of (:D *D2) (:A A2))
  (&phase *P (:D D1) (:J *J1))
  (&phase P (:D D2) (:J *J2))
  (&phase (:P *Q) (:D D1) (:J J1))
  (&phase (:P Q) (:D D2) (:J J2))
  (&pattern (:P *R) *Col)
  (&move_dir *D)
  (neighbor (:P R) D Q))
