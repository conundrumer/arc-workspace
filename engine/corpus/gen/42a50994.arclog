;; 42a50994

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &grouped
  (&ink *P)
  (dir8_elem *D)
  (neighbor P D (:Q *P2))
  (&ink (:P P2)))

(ALTS $choice "each pair's dots share one color, which hides what counts as a companion" $Ink
  (ALT $Self
    (RULE &grouped
      (&ink *P *Col)
      (dir8_elem *D)
      (neighbor P D (:Q *P2))
      (&ink (:P P2) Col))))

(RULE &output
  (OR ((&grouped *P)
       (input P *Col))
      ((input P)
       (NOT (&grouped P))
       (&bg (:C Col)))))
