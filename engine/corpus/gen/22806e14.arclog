;; 22806e14

(DET &bg DominantColor)

(INIT &comps Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &cell
  (&comps.component *P *Id))

(INIT &bbox BoundingBox
  (key ((&cell ^Id *P))
    (cell (P)
      (&cell Id *P))))

(RULE &marker
  (input *P)
  (&bbox.box (:key *Id) *B)
  (inside (:A P) B)
  (NOT (&cell Id P)))

(RULE &marker_cell
  (&marker *Id)
  (&cell Id *P))

(RULE &rect
  (&cell *Id)
  (NOT (&marker Id)))

(RULE &center
  (&rect *Id)
  (input *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (centered (:P P_inner)))

(RULE &mark
  (&center *P))

(INIT &size_cmp Excess
  (plus ((:m P))
    (&marker_cell *P))
  (minus ((:m P))
    (&mark *P)))

(RULE &erase
  (&size_cmp.excess))

(ALTS $choice "what counts as enough marks" $MarkerSize
  (ALT $Majority
    (INIT &rect_cmp Excess
      (plus ((:m Id))
        (&center *Id))
      (minus ((:m Id))
        (&rect *Id)
        (NOT (&center Id))))

    (RULE &erase
      (NOT (&rect_cmp.excess)))))

(RULE &gone
  (&erase)
  (&marker_cell *P))

(RULE &output
  (OR ((&mark *P)
       (&marker_cell (:P *Q))
       (input (:P Q) *Col))
      ((&gone P)
       (&bg (:C Col)))
      ((input P Col)
       (NOT (&mark P))
       (NOT (&gone P)))))
