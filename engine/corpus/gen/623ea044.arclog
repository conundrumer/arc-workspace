;; 623ea044

(DET &bg DominantColor)

(INIT &diag Ray
  (source (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P))
  (dir (D)
    (diag_dir_elem *D)))

(RULE &output
  (input *P)
  (OR ((&diag.ray P (:Origin *Src))
       (input (:P Src) *Col))
      ((NOT (&diag.ray P))
       (&bg (:C Col)))))
