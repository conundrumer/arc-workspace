;; ce9e57f2

(DET &bar RarestColor)

(DET &mark AnyOutNewColor)

(DET &base DirDomain)

;; Bars keyed by their line's across position.
(INIT &bars BoundingBox
  (key ((input *P *Col)
        (&bar (:C Col))
        (&base *D)
        (axis_of D *A)
        (split P A (:Across ^Ac)))
    (cell (P)
      (input *P *Col)
      (&bar (:C Col))
      (&base *D)
      (axis_of D *A)
      (split P A (:Across Ac)))))

(RULE &marked
  (&bars.cell (:key *Ac) *P)
  (&bars.box (:key Ac) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&base *D)
  (dist_pair (:P P_inner) D *K *K2)
  (< K K2))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&marked P)))))
