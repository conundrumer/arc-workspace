;; 1e0a9b12

(DET &grav DirDomain)

(DET &bg DominantColor)

;; Each ink cell travels toward the gravity edge and stops against the ink
;; already packed ahead of it.
(INIT &pack Distance
  (weight ((:a P2) (:b P) (:W K))
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (&grav *D)
    (input (:P *P2) (:Col *Col2))
    (NOT (&bg (:C Col2)))
    (!= P P2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n P) K)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (&grav *D)
    (margin (:B P) D *K)))

(RULE &fallen
  (input (:P *P2) *Col)
  (&pack.distance (:n P2) *K)
  (&grav *D)
  (jump_offset D K *V)
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&fallen P)))))
