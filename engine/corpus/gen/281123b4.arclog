;; 281123b4

(DET &gap DivisorRatio)

(DET &panel_axis AxisDomain)

(DET &panels ConstOutDim)

(INIT &tile_cell_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (&panel_axis *A)
    (&panels *N))
  (gap (A G)
    (&panel_axis *A)
    (&gap (:K *G))))

(DET &bg DominantColor)

(RULE &tile_cell
  (input (:P *P_grid) *Col)
  (&tile_cell_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $d "find the panels" $Count
  (ALT $Size
    (DET &panel_size ConstOutDim)

    (INIT &tile_cell_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A (:K Kp))
        (&panel_axis *A)
        (&panel_size (:N *Kp)))
      (gap (A G)
        (&panel_axis *A)
        (&gap (:K *G))))

    (RULE &tile_cell
      (input (:P *P_grid) *Col)
      (&tile_cell_division2.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $c "combine the contributions — each panel keeps one ink in every pair, so spatial and chromatic precedence are indistinguishable" $Order
  (ALT $Ink
    (DET &ink_rank
      (&tile_ink (:P_tile *T) *Col)
      (&prio (:P T) *R))

    ;; Each cell's winning contribution: the best-ranked one present there.
    (INIT &best Order
      (key ((&ink_at ^P *Col)
            (&ink_rank Col *R))
        (member ((:t (:V Col) (:S R)))
          (&ink_at P *Col)
          (&ink_rank Col *R))
        (score ((:t (:V Col) (:S R)) (:S R))
          (&ink_at P *Col)
          (&ink_rank Col *R)))))
  (ALT $Lookup
    (DET &contrib
      (&tile_cell *E (:P_tile *P) (:P_intile *K_p) *Col))

    (INIT &same Inclusion
      (pattern ((:pattern (:E K_e) (:P K_p)) (:m (:P P_tile) Col))
        (&contrib (:E *K_e) *K_p (:P *P_tile) *Col))
      (observed ((:observed (:E K_e) (:P K_p)) (:m (:P P_tile) Col))
        (&contrib (:E *K_e) *K_p (:P *P_tile) *Col)))

    (INIT &entry Quotient
      (equivalent ((:a (:E K_e) (:P K_p)) (:b (:E K2_e) (:P K2_p)))
        (&same.equal (:observed (:E *K_e) (:P *K_p)) (:pattern (:E *K2_e) (:P *K2_p)))))

    (DET &combine_member
      (&entry.class (:a (:E *K_e) (:P *K_p)) *Id)
      (&contrib (:E K_e) K_p *P *Col))

    (INIT &combine Inclusion
      (pattern ((:pattern Id) (:m (:P P_tile) Col))
        (&combine_member *Id (:P *P_tile) *Col))
      (observed ((:observed P_intile) (:m (:P P_tile) Col))
        (&tile_cell *P_tile *P_intile *Col)))

    (DET &combine_out
      (&entry.class (:a *E *P) *Id)
      (ex_output E P *Col))

    (RULE &output
      (&combine_out *Id *Col)
      (&combine.equal (:observed *P) (:pattern Id)))))

(RULE &tile_ink
  (&tile_cell *P_tile (:P_intile *P) *Col)
  (NOT (&bg (:C Col))))

(RULE &ink_at
  (&tile_ink *P *Col))

(DET &beats
  (&tile_ink *E *P_tile *P *Col)
  (&tile_ink E (:P_tile *P_tile2) P (:Col *Col2))
  (!= Col Col2)
  (ex_output E P Col))

(INIT &order Order
  (member ((:t T))
    (&tile_ink (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&beats (:P_tile *T) (:P_tile2 *T2))))

(DET &prio
  (&order.rank (:t *P) *R))

;; Each cell's winning contribution: the best-ranked one present there.
(INIT &best Order
  (key ((&tile_ink (:P_tile *T) ^P *Col)
        (&prio (:P T) *R))
    (member ((:t (:V Col) (:S R)))
      (&tile_ink (:P_tile *T) P *Col)
      (&prio (:P T) *R))
    (score ((:t (:V Col) (:S R)) (:S R))
      (&tile_ink (:P_tile *T) P *Col)
      (&prio (:P T) *R))))

(RULE &output
  (OR ((&tile_cell (:P_intile *P))
       (NOT (&ink_at P))
       (&bg (:C *Col)))
      ((&best.minimal (:key P) (:t (:V Col))))))
