;; 6cf79266

(DET &bg RarestColor)

(DET &fill AnyOutNewColor)

(DET &shape Frame)

;; Windows: placements where the shape lands all-bg.
(INIT &occ Occurrences
  (cell (P)
    (input *P *Col)
    (&bg (:C Col)))
  (shape (P)
    (&shape *P)))

(RULE &painted
  (&occ.occurrence (:P *M))
  (&shape (:P *S))
  (compose (:A M) (:B S) (:C *P)))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
