;; 2a28add5

(DET &bg DominantColor)

(DET &marker VanishedColor)

(DET &fill ColorDomain)

(DET &axis AxisDomain)

(RULE &marker_at
  (input (:P *M) *Col)
  (&marker (:C Col))
  (&axis *A)
  (split (:P M) A (:Across *P_across)))

(RULE &ink_at
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&axis *A)
  (split P A (:Across *P_across)))

;; Each ink cell travels toward its line's marker and stops against the marker
;; or against the ink already packed ahead of it.
(INIT &pack Distance
  (key ((OR ((&ink_at (:P_across ^Across) *P)
             (&marker_at (:P_across Across) *M)
             (nearer ^D (:P M) (:Q P))
             (&marker_at (:P_across Across))
             (&axis *A)
             (axis_of D A)
             (margin (:B P) D *K))
            ((&ink_at (:P_across Across) P)
             (&marker_at (:P_across Across) M)
             (nearer D (:P M) (:Q P))
             (&marker_at (:P_across Across))
             (&axis A)
             (axis_of D A)
             (&marker_at (:P_across Across) (:M *M2))
             (&axis (:A *A2))
             (axis_of D (:A A2))
             (gap D P (:Q M2) K))
            ((&ink_at (:P_across Across) P)
             (&marker_at (:P_across Across) M)
             (nearer D (:P M) (:Q P))
             (&marker_at (:P_across Across))
             (&axis A)
             (axis_of D A)
             (&ink_at (:P_across Across) (:P *P2))
             (&marker_at (:P_across Across) (:M *M22))
             (nearer D (:P M22) (:Q P2))
             (!= P P2)
             (gap D P (:Q P2) K))))
    (weight ((:a P2) (:b P) (:W K))
      (&ink_at (:P_across Across) *P)
      (&marker_at (:P_across Across) *M)
      (nearer D (:P M) (:Q P))
      (&marker_at (:P_across Across))
      (&axis *A)
      (axis_of D A)
      (&ink_at (:P_across Across) (:P *P2))
      (&marker_at (:P_across Across) (:M *M2))
      (nearer D (:P M2) (:Q P2))
      (!= P P2)
      (gap D P (:Q P2) *K))
    (source_distance ((:n P) K)
      (OR ((&ink_at (:P_across Across) *P)
           (&marker_at (:P_across Across) *M)
           (nearer D (:P M) (:Q P))
           (&marker_at (:P_across Across))
           (&axis *A)
           (axis_of D A)
           (margin (:B P) D *K))
          ((&ink_at (:P_across Across) P)
           (&marker_at (:P_across Across) (:M *M3))
           (nearer D (:P M3) (:Q P))
           (&marker_at (:P_across Across))
           (&axis (:A *A3))
           (axis_of D (:A A3))
           (&marker_at (:P_across Across) (:M *M2))
           (&axis (:A *A2))
           (axis_of D (:A A2))
           (gap D P (:Q M2) K))))))

(RULE &pack_dir
  (&marker_at *P_across)
  (&axis *A)
  (axis_of *D A))

(RULE &packed
  (OR ((&marker_at (:M *P)))
      ((&pack.distance (:key (:Across *Ky_p_across) (:D *Ky_d)) (:n *P2) *K)
       (&pack_dir (:P_across Ky_p_across) (:D Ky_d))
       (jump_offset (:D Ky_d) K *V)
       (compose (:A P2) (:B V) (:C P)))))

(RULE &output
  (OR ((&packed *P)
       (&fill (:C *Col)))
      ((input P)
       (NOT (&packed P))
       (&bg (:C Col)))))
