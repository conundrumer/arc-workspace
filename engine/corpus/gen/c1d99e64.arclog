;; c1d99e64

(DET &bg RarestColor)

(DET &line AnyOutNewColor)

(RULE &on_bg_line
  (input *P)
  (axis_elem *A)
  (split P A (:Across *P_across))
  (ALL ((input (:P *Pm) *Col)
        (split (:P Pm) A (:Across P_across)))
       ((&bg (:C Col)))))

(RULE &output
  (OR ((&on_bg_line *P)
       (&line (:C *Col)))
      ((input P Col)
       (NOT (&on_bg_line P)))))
