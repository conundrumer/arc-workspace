;; 17cae0c1

(DET &bg ChangedColor)

(DET &tile_axis AxisDomain)

;; A panel is square and spans the strip, so its width is the strip's
;; extent across the tiling axis.
(DET &size2
  (ex_input *E *P)
  (&tile_axis *A)
  (perp A *A2)
  (frame_extent P (:A A2) (:N *K)))

(INIT &panel_division2 Division
  (key ((OR ((ex_input ^E (:P *P_grid)))
            ((&tile_axis *A)
             (&size2 E (:K *Sz)))))
    (cell ((:P P_grid))
      (ex_input E (:P *P_grid)))
    (side (A (:K Sz))
      (&tile_axis *A)
      (&size2 E (:K *Sz)))))

(DET &panel2
  (&panel_division2.tile (:key *E) (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &mark2
  (ex_input *E (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&panel2 E P_grid *P_tile *P_intile))

(DET &panel_mark
  (&mark2 *E (:P_tile *Tile) (:P_intile *P)))

;; Panels carrying the same glyph share a catalog entry.
(INIT &same Inclusion
  (pattern ((:pattern (:E Ep_e) (:Tile Ep_tile)) (:m P))
    (&panel_mark (:E *Ep_e) (:Tile *Ep_tile) *P))
  (observed ((:observed (:E Ep_e) (:Tile Ep_tile)) (:m P))
    (&panel_mark (:E *Ep_e) (:Tile *Ep_tile) *P)))

(INIT &entry Quotient
  (equivalent ((:a (:E Ep_e) (:Tile Ep_tile)) (:b (:E Ep2_e) (:Tile Ep2_tile)))
    (&same.equal (:observed (:E *Ep_e) (:Tile *Ep_tile)) (:pattern (:E *Ep2_e) (:Tile *Ep2_tile)))))

(DET &glyph_member
  (&entry.class (:a (:E *Ep_e) (:Tile *Ep_tile)) *Id)
  (&panel_mark (:E Ep_e) (:Tile Ep_tile) *P))

(RULE &tile_size
  (&tile_axis *A)
  (&glyph_member *P)
  (frame_extent P A (:N *K)))

(RULE &size
  (&tile_size *K))

(INIT &panel_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A (:K Sz))
    (&tile_axis *A)
    (&size (:K *Sz))))

(RULE &panel
  (&panel_division.tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &mark
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&panel P_grid *P_tile *P_intile))

(INIT &glyph Inclusion
  (pattern ((:pattern Id) (:m P))
    (&glyph_member *Id *P))
  (observed ((:observed P_tile) (:m P))
    (&mark *P_tile (:P_intile *P))))

(DET &glyph_color
  (&entry.class (:a *E (:Tile *P_tile)) *Id)
  (ex_output E (:P *P_grid) *Col)
  (&panel2 E P_grid P_tile))

(RULE &output
  (&panel (:P_grid *P) *P_tile)
  (&glyph.equal (:observed P_tile) (:pattern *Id))
  (&glyph_color Id *Col))
