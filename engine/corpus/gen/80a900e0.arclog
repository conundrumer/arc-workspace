;; 80a900e0

(DET &bg SharedColor)

(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &object
  (&objs.component (:key *Col) *P *Id))

(RULE &aligned
  (&object *Id *P)
  (&object Id (:P *Q))
  (diag_axis_elem *Da)
  (same_line (:A Da) P Q))

(RULE &segment
  (&object *Id *P)
  (&object Id (:P *Q))
  (!= P Q)
  (diag_axis_elem *Da)
  (ALL ((&object Id (:P *Pm))
        (&object Id (:P *Qm)))
       ((&aligned Id Da (:P Pm) (:Q Qm)))))

(INIT &rim Boundary
  (key ((&object ^Id *P))
    (cell (P)
      (&object Id *P)))
  (dir (D)
    (dir8_elem *D)))

(RULE &end
  (&segment *Id *Da)
  (diag_axis_of *D Da)
  (&rim.exposed (:key Id) *P D))

(RULE &across
  (&segment *Id *Da)
  (diag_perp Da *Da2)
  (diag_axis_of *D (:Da Da2)))

(RULE &rays_blocked
  (&end (:P *Key))
  (&object *P))

(RULE &rays_dir
  (&end *Id (:P *Key))
  (&across Id *D))

(RULE &rays_cell
  (&end (:P *Key))
  (input *P *Col)
  (&bg (:C Col)))

(ALTS $choice "which directions each end casts, and where a ray stops" $Halt
  (ALT $Away
    (RULE &rays_dir
      (&end *Id (:P *Key))
      (&across Id *D)
      (diag_opposite D (:Opp *D_in))
      (neighbor (:P Key) (:D D_in) *Q)
      (&object (:P Q)))

    (INIT &rays Ray
      (key ((OR ((&end (:P ^P_end)))
                ((&rays_dir (:Key P_end) *D))
                ((&rays_dir (:Key P_end))
                 (input *P))))
        (source ((:P P_end))
          (&end (:P P_end)))
        (node (P)
          (&rays_dir (:Key P_end))
          (input *P))
        (dir (D)
          (&rays_dir (:Key P_end) *D))))))

(INIT &rays Ray
  (key ((OR ((&end (:P ^P_end)))
            ((&rays_dir (:Key P_end) *D))
            ((&rays_dir (:Key P_end))
             (input *P)
             (NOT (&rays_blocked (:Key P_end) P)))))
    (source ((:P P_end))
      (&end (:P P_end)))
    (node (P)
      (&rays_dir (:Key P_end))
      (input *P)
      (NOT (&rays_blocked (:Key P_end) P)))
    (dir (D)
      (&rays_dir (:Key P_end) *D))))

(RULE &painted
  (&rays.ray (:key *P_end) *P)
  (&rays_cell (:Key P_end) P)
  (&object (:P P_end) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
