;; 973e499e

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(INIT &output_tiling2 Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg AnyOutNewColor)

(RULE &output
  (OR ((input (:P *P_tile) *Col)
       (input (:P *P_intile) Col)
       (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
      ((input (:P *P_tile2) (:Col *Col_m))
       (input (:P *P_intile2) (:Col *Col_i))
       (!= Col_m Col_i)
       (&bg (:C Col))
       (&output_tiling2.cell (:P_outer P_tile2) (:P_inner P_intile2) P))))
