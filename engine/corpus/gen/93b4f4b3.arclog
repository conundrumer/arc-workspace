;; 93b4f4b3

(DET &bg DominantColor)

;; The holes: the background regions closed off from the grid edge.
(INIT &closed Enclosure
  (cell (P)
    (input *P *Col)
    (&bg (:C Col))))

(RULE &hole
  (&closed.enclosed *P (:Id *H)))

(RULE &panel
  (&hole *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(INIT &panel_box BoundingBox
  (cell (P)
    (input *P *Col)
    (&panel Col)))

(RULE &shape
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&panel Col)))

(INIT &hole_box BoundingBox
  (key ((&hole ^H *P))
    (cell (P)
      (&hole H *P))))

(INIT &shape_box BoundingBox
  (key ((&shape ^Col *P))
    (cell (P)
      (&shape Col *P))))

;; Same footprint: the two sets fill their boxes alike.
(INIT &fits Inclusion
  (pattern ((:pattern Col) (:m P_inner))
    (&shape *Col *P)
    (&shape_box.box (:key Col) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner)))
  (observed ((:observed H) (:m P_inner))
    (&hole *H *P)
    (&hole_box.box (:key H) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &output
  (&panel_box.box *B)
  (OR ((input (:P *P2) *Col)
       (&panel Col))
      ((&hole *H (:P P2))
       (&fits.equal (:observed H) (:pattern Col))))
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))
