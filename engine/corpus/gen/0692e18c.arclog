;; 0692e18c

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg SharedColor)

(RULE &cell
  (&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))

(RULE &active
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &stamped
  (&cell *P_grid *P_tile *P_intile)
  (&active (:P P_tile))
  (NOT (&active (:P P_intile))))

(RULE &output
  (OR ((&stamped (:P_grid *P) *P_tile)
       (input (:P P_tile) *Col))
      ((&cell (:P_grid P))
       (&bg (:C Col))
       (NOT (&stamped (:P_grid P))))))
