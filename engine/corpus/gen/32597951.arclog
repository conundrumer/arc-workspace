;; 32597951

(DET &marker RarestColor)

(DET &to AnyOutNewColor)

(DET &from SharedColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&marker (:C Col))))

(RULE &recolor
  (input *P *Col)
  (&from (:C Col))
  (&bbox.box *B)
  (inside (:A P) B))

(ALTS $choice "which cells qualify" $From
  (ALT $Ink
    (RULE &recolor
      (input *P *Col)
      (NOT (&marker (:C Col)))
      (&bbox.box *B)
      (inside (:A P) B))))

(RULE &output
  (OR ((&recolor *P)
       (&to (:C *Col)))
      ((input P Col)
       (NOT (&recolor P)))))
