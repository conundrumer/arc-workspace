;; 64a7c07e

(DET &bg DominantColor)

(DET &move_dir DirDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A blob holds together through diagonal contact.
(INIT &blob Connectivity
  (node (P)
    (&ink *P))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(INIT &bbox BoundingBox
  (key ((&blob.component *P ^Id))
    (cell (P)
      (&blob.component *P Id))))

(RULE &landed
  (&blob.component (:P *P2) *Id)
  (&ink (:P P2) *Col)
  (&move_dir *D)
  (axis_of D *A)
  (&bbox.box (:key Id) *B)
  (box_extent B (:P P2) A *N)
  (jump (:P P2) D (:K N) (:Q *P)))

(RULE &output
  (input *P)
  (OR ((&landed P *Col))
      ((NOT (&landed P))
       (&bg (:C Col)))))
