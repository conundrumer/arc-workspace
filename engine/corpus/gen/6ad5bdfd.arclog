;; 6ad5bdfd

(DET &bg DominantColor)

(DET &wall UnchangedColor)

(RULE &wall2
  (input *P (:Col *W))
  (&wall (:C W)))

(INIT &obj Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col)))
        (NOT (&wall (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))
      (NOT (&wall (:C Col))))))

(INIT &settle Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj.component *P *Id)
    (dir_elem *D)
    (ALL ((&wall2 (:P *Pm)))
         ((margin (:B Pm) D (:K 0))))
    (&obj.component (:P *P2) (:Id *Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&obj.component *P *Id)
         (dir_elem *D)
         (ALL ((&wall2 (:P *Pm)))
              ((margin (:B Pm) D (:K 0))))
         (margin (:B P) D *K))
        ((&obj.component (:P *P3) Id)
         (dir_elem (:D *D2))
         (ALL ((&wall2 (:P *Pm2)))
              ((margin (:B Pm2) (:D D2) (:K 0))))
         (&wall2 (:P *P2))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &settle_dir
  (dir_elem *D)
  (ALL ((&wall2 *P))
       ((margin (:B P) D (:K 0)))))

(RULE &fallen
  (&obj.component (:key *Col) (:P *P2) *Id)
  (&settle.distance (:n Id) *K)
  (&settle_dir *D)
  (jump_offset D K (:V *Delta))
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((&wall2 P)
       (input P Col))
      ((input P)
       (NOT (&fallen P))
       (NOT (&wall2 P))
       (&bg (:C Col)))))
