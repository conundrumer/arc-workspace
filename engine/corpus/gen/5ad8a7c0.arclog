;; 5ad8a7c0

;; The axis a pair spans.
(DET &axis AxisDomain)

(DET &mark RarestColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(INIT &cast_full Ray
  (source (P)
    (&mark_cell *P))
  (node (P)
    (input *P))
  (dir (D)
    (&axis *A)
    (axis_of *D A)))

;; Each mark casts along the task's axis and halts at the next mark.
(INIT &cast Ray
  (source (P)
    (&mark_cell *P))
  (node (P)
    (input *P)
    (NOT (&mark_cell P)))
  (dir (D)
    (&axis *A)
    (axis_of *D A)))

(RULE &span
  (&cast.end (:P *E) *D (:Origin *Src))
  (neighbor (:P E) D (:Q *P))
  (&cast_full.ray P D *K (:Origin Src)))

(RULE &span_cell
  (&span *Src *D)
  (&cast.ray *P D *K (:Origin Src))
  (!= K 0))

(INIT &closest Order
  (member ((:t K))
    (&span *K))
  (score ((:t K) (:S K))
    (&span *K)))

(RULE &fill
  (&span *Src *D *K)
  (&closest.minimal (:t K))
  (&span_cell Src D *P))

(ALTS $choice "which spans fill" $Shortest
  (ALT $Clear
    (RULE &crossed
      (&span_cell *Src *D *P)
      (&mark_cell (:P *Q))
      (&axis *A)
      (perp A *A2)
      (same_line (:A A2) P Q))

    (RULE &fill
      (&span_cell *Src *D *P)
      (NOT (&crossed Src D)))))

(RULE &output
  (OR ((&fill *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&fill P)))))
