;; 6f8cd79b

(DET &border AnyOutNewColor)

(RULE &is_border
  (input *P)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(ALTS $choice "how the interior is filled" $Passthrough
  (ALT $Repaint
    (DET &bg DominantColor)

    (RULE &output
      (OR ((&is_border *P)
           (&border (:C *Col)))
          ((input P)
           (interior (:A P) (:B 0))
           (&bg (:C Col)))))))

(RULE &output
  (OR ((&is_border *P)
       (&border (:C *Col)))
      ((input P Col)
       (interior (:A P) (:B 0)))))
