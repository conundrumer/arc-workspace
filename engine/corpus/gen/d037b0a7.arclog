;; d037b0a7

(DET &bg DominantColor)

(DET &dir DirDomain)

(RULE &flow_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &flow Ray
  (source (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P)
    (NOT (&flow_blocked P)))
  (dir (D)
    (&dir *D)))

(RULE &output
  (OR ((&flow.ray *P (:Origin *P_mark))
       (input (:P P_mark) *Col))
      ((input P Col)
       (NOT (&flow.ray P)))))
