;; 0b148d64

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &ink_slice
  (&ink *P)
  (axis_elem *A)
  (split P A *Along))

(RULE &sep_cell
  (input *P)
  (axis_elem *A)
  (split P A *Along)
  (NOT (&ink_slice Along)))

(INIT &sep Ray
  (source (P)
    (&sep_cell *P))
  (node (P)
    (input *P))
  (dir (D)
    (dir_elem *D)))

(RULE &side
  (input *P)
  (opposite *D *Opp)
  (NOT (&sep.ray P (:D Opp))))

(RULE &panel
  (diag_dirs (:D *Q) *D1 *D2)
  (&side *P (:D D1))
  (&side P (:D D2)))

;; The panel a color belongs to; a color two panels share belongs to neither.
(INIT &color_panel Singleton
  (key ((&panel *P *Q)
        (&ink P ^Col))
    (member ((:v Q))
      (&panel *P *Q)
      (&ink P Col))))

(RULE &odd_panel
  (&color_panel.value (:v *Q)))

(INIT &view BoundingBox
  (cell (P)
    (&odd_panel *Q)
    (&panel *P Q)))

(ALTS $choice "what the crop's box is" $Panel
  (ALT $Ink
    (INIT &view BoundingBox
      (cell (P)
        (&odd_panel *Q)
        (&panel *P Q)
        (&ink P)))

    (RULE &viewed
      (input *P))))

(RULE &viewed
  (&view.cell *P))

(RULE &output
  (&viewed (:P *P2))
  (&view.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P))
  (input (:P P2) *Col))
