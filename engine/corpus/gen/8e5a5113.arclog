;; 8e5a5113

(DET &axis AxisDomain)

(DET &gap DivisorRatio)

(DET &tile_n ConstInDim)

(INIT &tile_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (&axis *A)
    (&tile_n *N))
  (gap (A G)
    (&axis *A)
    (&gap (:K *G))))

(DET &cell
  (ex_output *E *P))

(INIT &tile_division2 Division
  (cell ((:P P_grid))
    (&cell (:P *P_grid)))
  (parts (A N)
    (&axis *A)
    (&tile_n *N))
  (gap (A G)
    (&axis *A)
    (&gap (:K *G))))

(DET &bg ChangedColor)

(DET &flow_dir DirDomain)

(DET &tile2
  (&cell *E (:P *P_grid))
  (&tile_division2.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &tile
  (input (:P *P_grid))
  (&tile_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &tile_cell
  (&tile *P_grid *P_tile *P_intile))

(RULE &flow_dir2
  (&flow_dir *D))

(DET &out_cell
  (ex_output *E (:P *P_grid) *Col)
  (&tile2 E P_grid *P_tile *P_intile))

(DET &flow_pair
  (&out_cell *E (:P_tile *T1))
  (&flow_dir *D)
  (neighbor (:P T1) D (:Q *T2))
  (&out_cell E (:P_tile T2)))

;; Each tile's content must map onto its flow-neighbor's.
(INIT &step Agreement
  (key ((OR ((&flow_pair ^E ^T1)
             (&out_cell E (:P_tile T1) (:P_intile *P) *Col))
            ((&flow_pair E T1 *T2)
             (&out_cell E (:P_tile T2) (:P_intile P) Col))))
    (source ((:i P) (:v Col))
      (&flow_pair E T1)
      (&out_cell E (:P_tile T1) (:P_intile *P) *Col))
    (target ((:i P) (:v Col))
      (&flow_pair E T1 *T2)
      (&out_cell E (:P_tile T2) (:P_intile *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&flow_pair E T1)
      (&out_cell E (:P_tile T1) (:P_intile *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(DET &step_broken
  (&step.mismatch (:key *E (:T1 *T)) (:m *D))
  (&out_cell E (:P_tile T)))

(DET &rot
  (&out_cell)
  (d4_elem *D)
  (NOT (&step_broken D)))

(ALTS $choice "data-equivalent on this task" $StepCount
  (ALT $StepSize
    (DET &tile_size
      (&tile *P_intile)
      (&axis *A)
      (frame_extent (:P P_intile) A (:N *K)))

    (INIT &size_tile_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A (:K Sz))
        (&axis *A)
        (&tile_size (:K *Sz)))
      (gap (A G)
        (&axis *A)
        (&gap (:K *G))))

    (RULE &size_tile
      (input (:P *P_grid))
      (&size_tile_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

    (RULE &tile_cell
      (&size_tile *P_grid *P_tile *P_intile)))
  (ALT $Lookup
    ;; TODO no-det-plan: &tile_d4: the plan gives no verdict
    (DET &tile_d4)

    (RULE &output
      (OR ((&src (:P_intile *P_src) *Col)
           (&tile_d4 (:P *P_tile) *D)
           (apply D (:P P_src) (:P_out *P_intile))
           (&tile_cell (:P_grid *P) P_tile P_intile))
          ;; Separator passthrough — cells the divide leaves undecomposed.
          ((input P Col)
           (NOT (&tile_cell (:P_grid P))))))))

(RULE &src
  (&tile_cell *P_grid *P_tile *P_intile)
  (input (:P P_grid) *Col)
  (NOT (&bg (:C Col))))

;; The tiles counted off from the pattern's toward flow_dir.
(INIT &flow Ray
  (source ((:P T))
    (&src (:P_tile *T)))
  (node (P)
    (&flow_dir2)
    (input *P))
  (dir (D)
    (&flow_dir2 *D)))

(RULE &flow_cell
  (&tile_cell (:P_tile *P)))

;; A cell of the pattern under k turns by &rot.
(INIT &turns Walk
  (successor ((:p P1) (:p_next P2))
    (&tile_cell (:P_intile *P1))
    (&rot (:D *R))
    (apply (:D R) (:P P1) (:P_out *P2)))
  (steps ((:N K))
    (&flow.ray *P *K)
    (&flow_cell P)))

(RULE &output
  ;; Separator passthrough — cells the divide leaves undecomposed.
  (OR ((input *P *Col)
       (NOT (&tile_cell (:P_grid P))))
      ;; The k-th tile on carries the pattern turned k times.
      ((&src (:P_tile *T0) (:P_intile *P0) Col)
       (&flow.ray (:P *T) *K (:Origin T0))
       (&flow_cell (:P T))
       (&turns.walk (:p0 P0) (:N K) (:p *P_intile))
       (&tile_cell (:P_grid P) (:P_tile T) P_intile))))
