;; 89565ca0

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &piece Connectivity
  (key ((&ink *P ^Col))
    (node (P)
      (&ink *P Col))))

(INIT &scattered_count Cardinality
  (key ((&piece.component (:key ^Col) *Id))
    (member ((:m Id))
      (&piece.component *Id))))

;; The chart's layout: rows counted from rank_dir, bars growing from the edge a quarter turn away.
(DET &rank_dir DirDomain)

(DET &bar_sense SenseDomain)

;; The specks are the color that lies in the most pieces.
(INIT &scattered Order
  (member ((:t Col))
    (&scattered_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&scattered_count.size (:key *Col) *N)))

(RULE &speck
  (&scattered.maximal (:t *Col)))

(RULE &frame
  (&ink *Col)
  (NOT (&speck Col)))

(RULE &run_on_blocked
  (&frame (:Col *F))
  (dir_elem *D)
  (input *P *Col)
  (&bg (:C Col)))

;; A line of frame f runs on toward d from a cell of f with another cell of f
;; behind it, over hidden cells, until background stops it.
(INIT &run_on Ray
  (key ((&frame (:Col ^F))
        (dir_elem ^D))
    (source (P)
      (&ink *P (:Col F))
      (opposite D (:Opp *O))
      (neighbor P (:D O) *Q)
      (&ink (:P Q) (:Col F)))
    (node (P)
      (input *P)
      (NOT (&run_on_blocked F D P)))))

(RULE &run_on_cell
  (&frame (:Col *F))
  (dir_elem *D)
  (input *P))

(RULE &line
  (OR ((&frame (:Col *F))
       (&ink *P (:Col F)))
      ((&run_on.ray (:key F) P)
       (&run_on_cell F P))))

;; The space a frame's lines leave.
(INIT &closed Enclosure
  (key ((&frame (:Col ^F)))
    (cell (P)
      (input *P)
      (NOT (&line F P)))))

(INIT &size Cardinality
  (key ((OR ((&closed.enclosed (:key ^F) *Id))
            ((&frame (:Col F)))))
    (member ((:m Id))
      (&closed.enclosed *Id))
    (domain ()
      (&frame (:Col F)))))

(RULE &bar_dir
  (&rank_dir (:D *D3))
  (&bar_sense *S)
  (turn S (:D D3) (:D2 *D)))

(INIT &frames Cardinality
  (member ((:m F))
    (&frame (:Col *F))))

(INIT &widest Order
  (member ((:t N))
    (&size.size *N))
  (score ((:t N) (:S N))
    (&size.size *N)))

(INIT &chart Frame
  (extent (A N)
    (OR ((&rank_dir *D)
         (axis_of D *A)
         (&frames.size *N))
        ((&bar_dir (:D *D2))
         (axis_of (:D D2) A)
         (&widest.maximal (:t N))))))

(RULE &row
  (&chart.cell *P)
  (&rank_dir *D)
  (margin (:B P) D *K))

(INIT &fewer Order
  (member ((:t F))
    (&frame (:Col *F)))
  (before ((:a F1) (:b F2))
    (&size.size (:key (:F *F1)) (:N *N1))
    (&size.size (:key (:F *F2)) (:N *N2))
    (< N1 N2)))

(RULE &ties
  (&row *K)
  (&fewer.rank (:t *F) *R)
  (<= R K)
  (ONE K)
  (ONE F))

(RULE &output
  (&chart.cell *P)
  (&rank_dir *D)
  (margin (:B P) D *K)
  (&ties *F K)
  (&size.size (:key F) *N)
  (&bar_dir (:D *Db))
  (margin (:B P) (:D Db) (:K *K2))
  (OR ((>= K2 N)
       (&speck *Col))
      ((< K2 N)
       (= Col F))))
