;; 5034a0b5

(RULE &corner
  (input *P)
  (corner_dist P (:K 0)))

(RULE &inner_cell
  (input *P)
  (interior (:A P) (:B 0)))

(RULE &bg
  (input *P *Col)
  (&corner P))

(RULE &side_color
  (input *P *Col)
  (dir_elem *D)
  (margin (:B P) D (:K 0))
  (NOT (&corner P)))

(RULE &heading
  (input *P *Col)
  (&inner_cell P)
  (&side_color *D Col))

(RULE &faces_frame
  (&heading *P *D)
  (neighbor P D *Q)
  (NOT (&inner_cell (:P Q))))

(RULE &blocked
  (&faces_frame *P))

(ALTS $choice "what takes the step" $Cell
  (ALT $Object
    (INIT &obj Connectivity
      (key ((&heading *P ^Col))
        (node (P)
          (&heading *P Col)))
      (step ((:Delta S))
        (diag_dir_elem *D)
        (step_offset D (:V *S))))

    (RULE &blocked
      (&obj.connected *P (:Q *P2))
      (&faces_frame (:P P2)))))

(RULE &move
  (&heading *P *D *Col)
  (neighbor P D *Q)
  (NOT (&blocked P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&move (:Q P) *Col))
      ((&move P)
       (NOT (&move (:Q P)))
       (&bg Col))
      ((NOT (&move (:Q P)))
       (NOT (&move P))
       (= Col Col_in))))
