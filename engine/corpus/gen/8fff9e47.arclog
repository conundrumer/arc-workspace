;; 8fff9e47

(DET &block_size TileCount)

(INIT &block_division Division
  (cell ((:P P_grid_in))
    (input (:P *P_grid_in)))
  (side (A K)
    (axis_elem *A)
    (&block_size (:N *K))))

(RULE &block
  (input (:P *P_grid_in) *Col)
  (&block_division.tile (:P P_grid_in) (:P_outer *P_tile) (:P_inner *P_intile)))

;; One ring per block.
(INIT &rings Cardinality
  (member ((:m P_tile))
    (&block *P_tile)))

;; A quarter is one cell per ring wide.
(INIT &quarter Frame
  (extent (A N)
    (axis_elem *A)
    (&rings.size *N)))

(INIT &out_frame_tiling Tiling
  (outer ((:P P_intile))
    (&block *P_intile))
  (inner ((:P P_inner))
    (&quarter.cell (:P *P_inner))))

(RULE &out_frame
  (&out_frame_tiling.cell (:P_outer *P_intile) (:P *P_grid_out)))

;; The output frame peels into concentric rings.
(INIT &peel Boundary
  (cell (P)
    (&out_frame (:P_grid_out *P))))

(INIT &peel_depth CellDistance
  (node (P)
    (&out_frame (:P_grid_out *P)))
  (source (P)
    (&peel.boundary *P)))

;; The order the blocks nest in, outermost first.
(DET &corner DiagDirDomain)

(DET &axis AxisDomain)

;; The blocks in nesting order: rank 0 is the outermost ring.
(INIT &nesting Order
  (member ((:t P_tile))
    (&block *P_tile))
  (before ((:a P_tile) (:b P_tile2))
    (&block *P_tile)
    (&block (:P_tile *P_tile2))
    (&corner *D)
    (&axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (nearer (:D D2) (:P P_tile) (:Q P_tile2)))
        ((diag_dirs D A (:D1 D2) (:D2 *D22))
         (same_dist (:D D2) (:P1 P_tile) (:P2 P_tile2))
         (nearer (:D D22) (:P P_tile) (:Q P_tile2))))))

(RULE &output
  (&peel_depth.distance *P *K)
  (&nesting.rank (:t *P_tile) (:R K))
  (&out_frame *P_intile (:P_grid_out P))
  (&block P_tile P_intile *Col))
