;; 469497ad

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &palette Cardinality
  (member ((:m Col))
    (&ink *Col))
  (domain ()))

(INIT &intile Frame
  (extent (A N)
    (axis_elem *A)
    (&palette.size *N)))

(INIT &scaled_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&intile.cell (:P *P_intile))))

(DET &beam AnyOutNewColor)

(RULE &scaled
  (input (:P *P_tile) *Col)
  (&scaled_tiling.cell (:P_outer P_tile) (:P *P_grid)))

(RULE &broken
  (input *P *Col)
  (&bg (:C Col))
  (axis_elem *A)
  (split P A *Across))

(INIT &block BoundingBox
  (cell ((:P P_grid))
    (&scaled *P_grid *P_tile)
    (&ink (:P P_tile))
    (ALL ((axis_elem *A)
          (split (:P P_tile) A *Across))
         ((&broken Across)))))

(RULE &diag_mark
  (&block.cell *P)
  (&block.box *B)
  (inside (:A P) B)
  (same_corner (:D *Key) (:P1 P) (:P2 B)))

(INIT &diag Ray
  (key ((OR ((&diag_mark (:Key ^Ky) *P))
            ((diag_dir_elem (:D Ky)))))
    (source (P)
      (&diag_mark (:Key Ky) *P))
    (node (P)
      (diag_dir_elem (:D Ky))
      (input *P)
      (ALL ((&scaled (:P_grid P) *Col))
           ((&bg (:C Col)))))
    (dir ((:D Ky))
      (diag_dir_elem (:D Ky)))))

(RULE &diag_cell
  (diag_dir_elem (:D *Key))
  (&scaled (:P_grid *P) *Col)
  (&bg (:C Col)))

(RULE &beam_cell
  (&diag.ray (:key *Ky) *P)
  (&diag_cell (:Key Ky) P))

(ALTS $choice "what a beam meets when it crosses non-bg ink" $Halt
  (ALT $Through
    (INIT &diag_full Ray
      (key ((OR ((&diag_mark (:Key ^Ky) *P))
                ((diag_dir_elem (:D Ky)))))
        (source (P)
          (&diag_mark (:Key Ky) *P))
        (node (P)
          (diag_dir_elem (:D Ky))
          (input *P))
        (dir ((:D Ky))
          (diag_dir_elem (:D Ky)))))

    (RULE &beam_cell
      (&diag_full.ray (:key *Ky) *P)
      (&diag_cell (:Key Ky) P))))

(RULE &output
  (OR ((&beam_cell *P)
       (&beam (:C *Col)))
      ((&scaled (:P_grid P) Col)
       (NOT (&beam_cell P)))))
