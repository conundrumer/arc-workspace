;; 73c3b0d8

(DET &bg DominantColor)

(DET &mark ChangedColor)

(DET &wall UnchangedColor)

(DET &move_dir DirDomain)

(RULE &splash_dir
  (&move_dir (:D *D2))
  (opposite (:D D2) (:Opp *Back))
  (diag_dirs *D (:D1 Back)))

(RULE &landed
  (input (:P *P2) *Col)
  (&mark (:C Col))
  (&move_dir *D)
  (neighbor (:P P2) D (:Q *P)))

(RULE &hit
  (&landed *P)
  (&move_dir *D)
  (neighbor P D *Q)
  (input (:P Q) *Col)
  (&wall (:C Col)))

(INIT &splash Ray
  (source (P)
    (&hit *P))
  (node (P)
    (input *P))
  (dir ((:D Dg))
    (&splash_dir (:D *Dg))))

(RULE &painted
  (OR ((&landed *P))
      ((&splash.ray P))))

(RULE &output
  (input *P (:Col *C_in))
  (OR ((&painted P)
       (&mark (:C *Col)))
      ((NOT (&painted P))
       (&mark (:C C_in))
       (&bg (:C Col)))
      ((NOT (&painted P))
       (NOT (&mark (:C C_in)))
       (= Col C_in))))
