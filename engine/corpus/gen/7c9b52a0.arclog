;; 7c9b52a0

(INIT &frame_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(DET &bg SharedColor)

;; The frame color: what covers the grid outside the panels.
(INIT &frame Order
  (member ((:t Col))
    (&frame_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&frame_count.size (:key *Col) *N)))

(INIT &panels Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&frame.maximal (:t Col)))))

(INIT &panel BoundingBox
  (key ((&panels.component *P ^Id))
    (cell (P)
      (&panels.component *P Id))))

(RULE &canvas
  (&panel.cell (:key *Id) (:P *P_grid))
  (&panel.box (:key Id) *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_frame)))

(RULE &ink
  (&canvas *P_grid (:P_frame *P))
  (input (:P P_grid) *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (&canvas (:P_frame *P))
  (OR ((&ink P *Col))
      ((NOT (&ink P))
       (&bg (:C Col)))))
