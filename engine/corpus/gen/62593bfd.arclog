;; 62593bfd

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; Where a partnered blob goes.
(DET &paired_dir DirDomain)

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(INIT &blobs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg_mode.maximal (:t Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg_mode.maximal (:t Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(INIT &size Cardinality
  (key ((&blobs.component *P ^Id))
    (member ((:m P))
      (&blobs.component *P Id))))

(RULE &paired
  (&size.size (:key *Id) *N)
  (&size.size (:key (:Id *Id2)) N)
  (!= Id Id2))

(ALTS $choice "what makes two blobs partners" $Size
  (ALT $Shape
    (INIT &bbox BoundingBox
      (key ((&blobs.component *P ^Id))
        (cell (P)
          (&blobs.component *P Id))))

    (RULE &blob_inner
      (&blobs.component *P *Id)
      (&bbox.box (:key Id) *B)
      (inside (:A P) B)
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    ;; Each ordered pair of blobs, both seen from their own boxes.
    (INIT &shape_map Agreement
      (key ((OR ((&blob_inner ^Id *P_inner)
                 (&blobs.component (:Id ^Id2))
                 (!= Id Id2))
                ((&blob_inner (:Id Id2) P_inner)
                 (&blobs.component Id)
                 (!= Id Id2))))
        (source ((:i P_inner))
          (&blob_inner Id *P_inner)
          (&blobs.component (:Id Id2))
          (!= Id Id2))
        (target ((:i P_inner))
          (&blob_inner (:Id Id2) *P_inner)
          (&blobs.component Id)
          (!= Id Id2))
        (correspondence ((:m D) (:i P_inner) (:j Q))
          (&blob_inner Id *P_inner)
          (&blobs.component (:Id Id2))
          (!= Id Id2)
          (d4_elem *D)
          (apply D (:P P_inner) (:P_out *Q)))))

    (RULE &shape_map_src
      (&blob_inner (:Id *A) (:P_inner *P))
      (&blobs.component (:Id *B))
      (!= A B))

    (RULE &shape_map_dst
      (&blob_inner (:Id *B) (:P_inner *P))
      (&blobs.component (:Id *A))
      (!= A B))

    (RULE &onto
      (&shape_map_src *A *B)
      (d4_elem *D)
      (NOT (&shape_map.mismatch (:key (:Id A) (:Id2 B)) (:m D)))
      (ALL ((&shape_map_dst A B (:P *Q))
            (d4_inverse D (:D_inv *D_back))
            (apply (:D D_back) (:P Q) (:P_out *P)))
           ((&shape_map_src A B P))))

    (RULE &paired
      (&onto (:A *Id)))))

(RULE &dest
  (&blobs.component *Id)
  (&paired_dir (:D *D_paired))
  (OR ((NOT (&paired Id))
       (opposite (:D D_paired) (:Opp *D)))
      ((&paired Id)
       (= D D_paired))))

;; The blob slides until it touches the destination edge.
(INIT &slide Distance
  (key ((&blobs.component *P ^Id)
        (&dest Id *D)
        (margin (:B P) D *K))
    (source_distance (K)
      (&blobs.component *P Id)
      (&dest Id *D)
      (margin (:B P) D *K))))

(RULE &slide_dir
  (&dest (:Id *Key) *D))

(RULE &paint
  (&blobs.component (:key *Col) (:P *P2) *Id)
  (&slide.distance (:key Id) *K)
  (&slide_dir (:Key Id) *D)
  (jump_offset D K *V)
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (&bg_mode.maximal (:t Col))
       (NOT (&paint P)))))
