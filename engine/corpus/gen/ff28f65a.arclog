;; ff28f65a

(DET &out_pos Frame)

(RULE &diag_diagonal
  (&out_pos *P)
  (diag_dir_elem *D)
  (diag_dist P (:Diag D) (:K1 *Ring) (:K2 Ring)))

(DET &block_color ChangedColor)

(DET &block_shape Frame)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(DET &lex_corner DiagDirDomain)

(DET &lex_axis AxisDomain)

(RULE &on
  (input *P (:Col *C))
  (&block_color C))

(INIT &comps Connectivity
  (node (P)
    (&on *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(INIT &same Inclusion
  (pattern ((:m P))
    (&block_shape *P))
  (observed ((:observed O) (:m P_inner))
    (&bbox.cell (:key (:Id *O)) *P)
    (&bbox.box (:key (:Id O)) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(INIT &blocks Cardinality
  (member ((:m Id))
    (&same.equal (:observed *Id))))

(RULE &total
  (&blocks.size *N))

(INIT &lex Order
  (member ((:t P))
    (&diag_diagonal *P))
  (before ((:a P) (:b P2))
    (&diag_diagonal *P)
    (&diag_diagonal (:P *P2))
    (&lex_corner *D)
    (&lex_axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (nearer (:D D2) P (:Q P2)))
        ((diag_dirs D A (:D1 D2) (:D2 *D22))
         (same_dist (:D D2) (:P1 P) P2)
         (nearer (:D D22) P (:Q P2))))))

(ALTS $detect "two models detect the blocks" $Object
  (ALT $Placement
    (INIT &occ Occurrences
      (cell (P)
        (&on *P))
      (shape (P)
        (&block_shape *P)))

    (INIT &placements Cardinality
      (member ((:m P))
        (&occ.occurrence *P)))

    (RULE &total
      (&placements.size *N))))

(ALTS $render "the count renders two ways" $Fill
  (ALT $Lookup
    (DET &lookup_grid
      (&blocks.size *E *N)
      (ex_output E *P *Col))

    (RULE &output
      (&total *N)
      (&lookup_grid N *P *Col))))

;; Mark along that order, as far as the count reaches.
(RULE &marked
  (&lex.rank (:t *P) (:R *K))
  (&total *N)
  (< K N))

(RULE &output
  (&out_pos *P)
  (&total)
  (IF ((&marked P))
      ((&mark (:C *Col)))
      ((&bg (:C Col)))))
