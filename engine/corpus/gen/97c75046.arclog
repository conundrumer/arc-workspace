;; 97c75046

(DET &bg DominantColor)

(DET &shape UnchangedColor)

(DET &marker ChangedColor)

(RULE &shape_cell
  (input *P *Col)
  (&shape (:C Col)))

(RULE &marker_cell
  (input *P *Col)
  (&marker (:C Col)))

(RULE &contact
  (input *P *Col)
  (&bg (:C Col))
  (dir_elem *D)
  (neighbor P D *Q)
  (&shape_cell (:P Q)))

(INIT &travel Ray
  (source (P)
    (&marker_cell *P))
  (node (P)
    (input *P)
    (NOT (&shape_cell P)))
  (dir (D)
    (dir_elem *D)))

(RULE &landing
  (&travel.end (:P *E) *D)
  (neighbor (:P E) D *Q)
  (input (:P Q))
  (dir_elem D)
  (opposite D (:Opp *O))
  (neighbor (:P Q) (:D O) (:Q *P)))

(INIT &slide Ray
  (source (P)
    (&contact *P))
  (node (P)
    (&contact *P))
  (dir ((:D Dg))
    (&landing *D)
    (corner_dir (:C *Dg) D)))

(RULE &dest
  (&landing (:P *P2))
  (OR ((&slide.end *P (:K *N) (:Origin P2))
       (> N 0))
      ((ALL ((&slide.end (:P *V3m) (:D *V2m) (:K *Nmm) (:Origin P2)))
            ((<= Nmm 0)))
       (= P P2))))

(RULE &cleared
  (OR ((input *P *Col)
       (NOT (&marker_cell P)))
      ((&marker_cell P)
       (&bg (:C Col)))))

(RULE &output
  (OR ((&dest *P)
       (&marker (:C *Col)))
      ((&cleared P Col)
       (NOT (&dest P)))))
