;; 5adee1b2

(DET &bg DominantColor)

;; The edge the legend stands on.
(DET &legend_dir DirDomain)

(RULE &legend_entry
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&legend_dir *D)
  (margin (:B P) D (:K 0))
  (opposite D (:Opp *D2))
  (neighbor P (:D D2) (:Q *P_border))
  (input (:P P_border) (:Col *Col_border)))

(RULE &border_color
  (&legend_entry *Col *Col_border))

(INIT &shapes Connectivity
  (key ((&border_color ^Col))
    (node (P)
      (input *P Col)
      (NOT (&legend_entry P))
      (NOT (&legend_entry (:P_border P))))))

(RULE &shape_cell
  (&shapes.component *P (:Id *S)))

(INIT &bbox BoundingBox
  (key ((&shape_cell ^S *P))
    (cell (P)
      (&shape_cell S *P))))

(RULE &grown_box
  (&bbox.box (:key *S) *B)
  (input (:P *P2))
  (inside (:A P2) B)
  (OR ((dir8_elem *D)
       (neighbor (:P P2) D (:Q *P))
       (input P))
      ((= P P2))))

(RULE &outside_node
  (&shape_cell *S)
  (input *P)
  (NOT (&shape_cell S P)))

;; What the shape leaves open to the grid edge.
(INIT &outside Flood
  (key ((&outside_node ^S *P))
    (node (P)
      (&outside_node S *P))
    (source (P)
      (&outside_node S *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0)))))

(RULE &painted
  (&grown_box *S *P)
  (input P (:Col *Col_in))
  (&bg (:C Col_in))
  (&outside.reached (:key S) P)
  (&shapes.component (:key (:Col *Col_s)) (:Id S))
  (&border_color (:Col Col_s) (:Col_border *Col)))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
