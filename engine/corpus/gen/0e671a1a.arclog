;; 0e671a1a

(DET &bg DominantColor)

;; The axis the half leaving the source runs along.
(DET &axis AxisDomain)

(DET &path AnyOutNewColor)

(DET &cell
  (ex_output *E *P *Col)
  (NOT (&path (:C Col))))

(DET &mark2
  (&cell *E *P *Col)
  (NOT (&bg (:C Col))))

(DET &elbow2
  (&mark2 *E (:Col *Src) (:P *P_src))
  (&mark2 E (:Col *Dst) (:P *P_dst))
  (!= Src Dst)
  (&axis *A)
  (split (:P P_dst) A *Along)
  (split (:P P_src) A *Across)
  (compose (:A Along) (:B Across) (:C *P)))

(DET &refuted
  (&elbow2 *E *Src *Dst *P)
  (ex_output E P *Col)
  (NOT (&path (:C Col))))

(DET &leg
  (&elbow2 *Src *Dst)
  (NOT (&refuted Src Dst)))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &elbow
  (&mark (:Col *Src) (:P *P_src))
  (&mark (:Col *Dst) (:P *P_dst))
  (!= Src Dst)
  (&axis *A)
  (split (:P P_dst) A *Along)
  (split (:P P_src) A *Across)
  (compose (:A Along) (:B Across) (:C *P)))

;; Each half of a leg spans two of its three points: source to elbow down one
;; line, elbow to destination along the other. The domain is background only,
;; so every mark keeps its own color.
(INIT &span Ray
  (key ((&leg (:Src ^S) (:Dst ^D)))
    (source (P)
      (OR ((&mark (:Col S) *P))
          ((&mark (:Col D) P))
          ((&elbow (:Src S) (:Dst D) P)))))
  (node (P)
    (axis_elem *A)
    (input *P))
  (dir ((:D D2))
    (axis_elem *A)
    (axis4_of (:D *D2) A)))

(RULE &span_between
  (&leg *Src *Dst)
  (input *P *Col)
  (&bg (:C Col))
  (axis_elem *A)
  (axis4_of (:D *D2) A)
  (dir8_opposite (:D D2) (:D2 *O))
  (&span.ray (:key (:S Src) (:D Dst)) P (:D D2))
  (&span.ray (:key (:S Src) (:D Dst)) P (:D O)))

(RULE &output
  (OR ((&span_between *P)
       (&path (:C *Col)))
      ((input P Col)
       (NOT (&span_between P)))))
