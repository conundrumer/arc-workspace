;; 44d8ac46

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &shape Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &shape_box BoundingBox
  (key ((&shape.component *P ^Id))
    (cell (P)
      (&shape.component *P Id))))

(INIT &boxed Connectivity
  (node (P)
    (&shape_box.box *B)
    (&bg_cell *P)
    (inside (:A P) B)))

(RULE &hole
  (&boxed.component *P (:Id *H)))

;; The output's fill cells; their components are the filled holes.
(INIT &regions Connectivity
  (key ((ex_output ^E *P *Col)
        (&fill (:C Col)))
    (node (P)
      (ex_output E *P *Col)
      (&fill (:C Col)))))

(ALTS $r "what a hole is" $Box
  (ALT $Enclose
    (INIT &closed Enclosure
      (cell (P)
        (&bg_cell *P)))

    (RULE &hole
      (&closed.enclosed *P (:Id *H)))))

(ALTS $t "which holes take the fill" $Block
  (ALT $Sym
    (RULE &sym_src
      (&cell *Key (:P *P2))
      (&bbox.box (:key (:Id Key)) *B)
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P)))

    (INIT &sym Agreement
      (key ((OR ((&cell (:Key ^Id) *P)
                 (&bbox.box (:key Id) *B)
                 (inside (:A P) B)
                 (relative (:Base B) (:X P) (:X_rel *P_inner)))
                ((&sym_src (:Key Id) P))))
        (source ((:i P_inner))
          (&cell (:Key Id) *P)
          (&bbox.box *B)
          (inside (:A P) B)
          (relative (:Base B) (:X P) (:X_rel *P_inner)))
        (target ((:i P))
          (&sym_src (:Key Id) *P))
        (correspondence ((:m D) (:i P_inner) (:j Q))
          (&cell (:Key Id) *P)
          (&bbox.box *B)
          (inside (:A P) B)
          (relative (:Base B) (:X P) (:X_rel *P_inner))
          (d4_elem *D)
          (apply D (:P P_inner) (:P_out *Q)))))

    ;; The transforms every filled hole survives, named as a subgroup.
    (INIT &named Inclusion
      (pattern ((:pattern S) (:m D))
        (sym_member *S *D))
      (observed ((:m D))
        (d4_elem *D)
        (NOT (&sym.mismatch (:m D)))))

    (DET &hole_sym
      (&named.equal (:pattern *S)))

    (RULE &sym_gap
      (&hole_sym *S)
      (sym_member S *D)
      (&sym.mismatch (:key (:Id *H)) (:m D)))

    (RULE &filled
      (&hole *H)
      (NOT (&sym_gap H)))))

(RULE &cell
  (&hole (:H *Key) *P))

(INIT &bbox BoundingBox
  (key ((&cell (:Key ^Id) *P))
    (cell (P)
      (&cell (:Key Id) *P))))

(RULE &filled
  (&hole *H *P)
  (&bbox.box (:key (:Id H)) *B)
  (box_extent B P *A *N)
  (perp A *A2)
  (box_extent B P (:A A2) N)
  (ALL ((&bbox.box (:key (:Id H)) (:B *Bm))
        (input (:P *Pm))
        (inside (:A Pm) (:B Bm)))
       ((&hole H (:P Pm)))))

(RULE &painted
  (&hole (:H *Id) *P)
  (&filled (:H Id)))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
