;; 445eab21

(DET &bg DominantColor)

(DET &out_dim ConstOutDim)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (key ((&ink *P ^Col))
    (cell (P)
      (&ink *P Col))))

;; What each color closes off from the grid edge.
(INIT &closed Enclosure
  (key ((&ink ^Col))
    (cell (P)
      (input *P (:Col *Col2))
      (!= Col2 Col))))

;; $Enclose, $Box and $Area count a cell set.
(INIT &measure Cardinality
  (key ((&closed.enclosed (:key ^Col) *P))
    (member ((:m P))
      (&closed.enclosed *P))))

(INIT &canvas Frame
  (extent (A N)
    (axis_elem *A)
    (&out_dim *N)))

(ALTS $choice "what \"bigger\" measures" $Enclose
  (ALT $Box
    ;; $Enclose, $Box and $Area count a cell set.
    (INIT &measure Cardinality
      (key ((&bbox.box (:key ^Col) *B)
            (input *P (:Col *Col2))
            (&bg (:C Col2))
            (inside (:A P) B))
        (member ((:m P))
          (&bbox.box *B)
          (input *P (:Col *Col2))
          (&bg (:C Col2))
          (inside (:A P) B)))))
  (ALT $Area
    ;; $Enclose, $Box and $Area count a cell set.
    (INIT &measure Cardinality
      (key ((&bbox.box (:key ^Col) *B)
            (input *P)
            (inside (:A P) B))
        (member ((:m P))
          (&bbox.box *B)
          (input *P)
          (inside (:A P) B)))))
  (ALT $Extent
    (DET &axis AxisDomain)

    (INIT &winner Order
      (member ((:t (:V Col) (:S N)))
        (OR ((&measure.size (:key *Col) *N))
            ((&axis *A)
             (&bbox.cell (:key Col) *P)
             (&bbox.box (:key Col) *B)
             (box_extent B P A N))))
      (score ((:t (:V Col) (:S N)) (:S N))
        (OR ((&measure.size (:key *Col) *N))
            ((&axis *A)
             (&bbox.cell (:key Col) *P)
             (&bbox.box (:key Col) *B)
             (box_extent B P A N)))))))

(INIT &winner Order
  (member ((:t (:V Col) (:S N)))
    (&measure.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&measure.size (:key *Col) *N)))

(RULE &output
  (&canvas.cell *P)
  (&winner.maximal (:t (:V *Col))))
