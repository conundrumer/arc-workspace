;; 45737921

(DET &bg DominantColor)

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &obj Connectivity
  (node (P)
    (&figure *P)))

(RULE &obj_color
  (&obj.component *P *Id)
  (&figure P *Col))

(RULE &swap
  (&obj_color *Id *Col)
  (&obj_color Id (:Col *Col2))
  (!= Col Col2))

(RULE &output
  (OR ((&obj.component *P *Id)
       (&figure P (:Col *C))
       (&swap Id (:Col C) (:Col2 *Col)))
      ((input P Col)
       (&bg (:C Col)))))
