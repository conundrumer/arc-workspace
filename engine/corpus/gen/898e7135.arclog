;; 898e7135

(DET &bg DominantColor)

(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &object
  (&objs.component (:key *Col) *P *Id))

;; What each object closes off: the cells outside it that cannot reach the
;; grid edge.
(INIT &closed Enclosure
  (key ((&object ^Id))
    (cell (P)
      (input *P)
      (NOT (&object Id P)))))

(RULE &board
  (&closed.enclosed (:key *Id)))

(INIT &piece_box BoundingBox
  (key ((&object (:Id ^O) *P)
        (NOT (&board (:Id O))))
    (cell (P)
      (&object (:Id O) *P)
      (NOT (&board (:Id O))))))

(RULE &piece_cell
  (&piece_box.cell (:key *O) *P)
  (&piece_box.box (:key O) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &scale_cand
  (&piece_cell *P_inner)
  (axis_elem *A)
  (OR ((frame_extent (:P P_inner) A (:N *K)))
      ((sub_extent (:P P_inner) A K))))

;; The block a cell becomes at each scale.
(INIT &block Frame
  (key ((&scale_cand ^K))
    (extent (A (:N K))
      (axis_elem *A))))

(RULE &hole
  (&closed.enclosed *P (:Id *H)))

;; Each hole's own box.
(INIT &hole_box BoundingBox
  (key ((&hole ^H *P))
    (cell (P)
      (&hole H *P))))

(RULE &hole_cell
  (&hole *H *P)
  (&hole_box.box (:key H) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &hole_scaled_tiling Tiling
  (outer ((:P P_hole))
    (&hole_cell (:P_inner *P_hole)))
  (inner ((:P P_blk))
    (&block.cell (:P *P_blk))))

;; The box the board spans, holes included.
(INIT &board_box BoundingBox
  (key ((&board ^Id))
    (cell (P)
      (&object Id *P))))

(RULE &hole_scaled
  (&hole_cell *H (:P_inner *P_hole))
  (&block.cell (:key *K) (:P *P_blk))
  (&hole_scaled_tiling.cell (:P_outer P_hole) (:P_inner P_blk) *P))

(INIT &congruent Inclusion
  (pattern ((:pattern O) (:m P_piece))
    (&piece_cell *O (:P_inner *P_piece)))
  (observed ((:observed H K D) (:m P_turned))
    (&hole_scaled *H *K (:P *P_scaled))
    (d4_elem *D)
    (apply D (:P P_scaled) (:P_out *P_turned))))

(RULE &fit
  (&congruent.equal (:observed *H *K) (:pattern *O)))

(RULE &scale
  (&scale_cand *K)
  (ALL ((&hole *H))
       ((&fit H K))))

(INIT &output_tiling Tiling
  (outer ((:P P_board))
    (&board_box.box (:key *Id) *B)
    (&object Id *P)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_board)))
  (inner ((:P P_blk))
    (&scale *K)
    (&block.cell (:key K) (:P *P_blk))))

(INIT &output_tiling2 Tiling
  (outer ((:P P_board))
    (&board_box.box *B)
    (&hole *P)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_board)))
  (inner ((:P P_blk))
    (&scale *K)
    (&block.cell (:key K) (:P *P_blk))))

(RULE &output
  (OR ((&output_tiling.cell (:P_outer *P_board) *P)
       (&board_box.box (:key *Id) *B)
       (&object Id *Col (:P *P2))
       (inside (:A P2) B)
       (relative (:Base B) (:X P2) (:X_rel P_board)))
      ((&scale *K)
       (&block.cell (:key K) (:P *P_blk))
       (&board_box.box (:key (:Id *Id2)) (:B *B2))
       (&output_tiling2.cell (:P_outer *P_board2) (:P_inner P_blk) P)
       (&hole *H (:P *P22))
       (inside (:A P22) (:B B2))
       (relative (:Base B2) (:X P22) (:X_rel P_board2))
       (&fit H K *O)
       (&object (:Id O) Col))))
