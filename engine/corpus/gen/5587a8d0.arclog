;; 5587a8d0

(DET &bg DominantColor)

(RULE &patch_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; One id per patch.
(INIT &patch Quotient
  (equivalent ((:a P) (:b Q))
    (&patch_cell *P *Col)
    (&patch_cell (:P *Q) Col)))

(ALTS $choice "what a patch is, data-equivalent on this task since each color forms one blob in every pair; a color lying in two blobs would separate the cases" $ByColor
  (ALT $ByObject
    (INIT &blob Connectivity
      (key ((&patch_cell *P ^Col))
        (node (P)
          (&patch_cell *P Col))))

    ;; One id per patch.
    (INIT &patch Quotient
      (equivalent ((:a P) (:b Q))
        (OR ((&patch_cell *P *Col)
             (&patch_cell (:P *Q) Col))
            ((&blob.connected P Q)))))))

(RULE &patch_of
  (&patch.class (:a *P) *Id))

(INIT &tally Cardinality
  (key ((&patch_of *P ^Id))
    (member ((:m P))
      (&patch_of *P Id))))

(RULE &patch_size
  (&patch_of *Id)
  (&tally.size (:key Id) *N))

(INIT &nest Order
  (member ((:t Id))
    (&patch_size *Id))
  (before ((:a Id) (:b Id2))
    (&patch_size *Id *N)
    (&patch_size (:Id *Id2) (:N *N2))
    (> N N2)))

(RULE &center
  (&nest.maximal (:t *Id))
  (&nest.rank (:t Id) *R)
  (uniform_inset (:K R) (:B *P)))

;; The output square, the frame the center sits in.
(INIT &square Frame
  (extent (A N)
    (&center (:P *C))
    (axis_elem *A)
    (frame_extent (:P C) A *N)))

;; The square's rings, from its edge inward.
(INIT &ring Boundary
  (cell (P)
    (&square.cell *P)))

(INIT &ring_depth CellDistance
  (node (P)
    (&square.cell *P))
  (source (P)
    (&ring.boundary *P)))

(RULE &patch_color
  (&patch_of *P *Id)
  (&patch_cell P *Col))

;; Each patch draws the ring as deep as the count of larger patches.
(RULE &output
  (&ring_depth.distance *P *K)
  (&nest.rank (:t *Id) (:R K))
  (&patch_color Id *Col))
