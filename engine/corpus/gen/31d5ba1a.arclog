;; 31d5ba1a

(DET &tile_decompose Division)

(DET &divide_axis AxisDomain)

(DET &combine PanelCombine)

(RULE &decompose
  (&tile_decompose *P *P_outer *P_inner))

(ALTS $d "how the grid decomposes into the two tiles" $Table
  (ALT $Count
    (DET &divisor DivisorRatio)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor (:K *N))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (DET &frame_dim ConstOutDimAxis)

    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&frame_dim A (:N *K))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(ALTS $b "how the two tiles' colors combine into the output color" $Lookup
  (ALT $Xor
    (DET &frame Frame)

    (DET &bg DominantColor)

    (DET &out_fill AnyOutNewColor)

    (DET &fill_at ScaleRatio)

    (INIT &filled Cardinality
      (key ((OR ((input (:P *P_grid_in) *Col)
                 (NOT (&bg (:C Col)))
                 (&decompose (:P P_grid_in) (:P_inner ^P_grid_out)))
                ((&frame (:P P_grid_out)))))
        (member ((:m P_grid_in))
          (input (:P *P_grid_in) *Col)
          (NOT (&bg (:C Col)))
          (&decompose (:P P_grid_in) (:P_inner P_grid_out)))
        (domain ()
          (&frame (:P P_grid_out)))))

    (RULE &output
      (&filled.size (:key (:P_grid_out *P)) *N)
      (IF ((&fill_at (:K N)))
          ((&out_fill (:C *Col)))
          ((&bg (:C Col)))))))

(INIT &combine_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_outer) (:Col C)))
    (&combine *Id (:P *P_outer) *C))
  (observed ((:observed P_grid_out) (:m (:P P_tile) (:Col C)))
    (&decompose (:P *P_grid_in) (:P_outer *P_tile) (:P_inner *P_grid_out))
    (input (:P P_grid_in) (:Col *C))))

(RULE &output
  (&combine *Id (:C_out *Col))
  (&combine_match.equal (:observed *P) (:pattern Id)))
