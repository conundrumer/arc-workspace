;; bc93ec48

(param &background Color (7))
(param &sense Sense (SENSE_CW))
(param &corner_d4 D4 (D4_CW))
(param &corner_target (DiagDir DiagDir)
  (DIAG_TL DIAG_TR)
  (DIAG_TR DIAG_BR)
  (DIAG_BR DIAG_BL)
  (DIAG_BL DIAG_TL))
(param &precedence (Ident DiagDir number)
  (0 DIAG_TL 0)
  (0 DIAG_TR 1)
  (0 DIAG_BR 2)
  (0 DIAG_BL 3)
  (1 DIAG_TL 0)
  (1 DIAG_TR 1)
  (1 DIAG_BL 2)
  (1 DIAG_BR 3)
  (2 DIAG_TL 0)
  (2 DIAG_BR 1)
  (2 DIAG_TR 2)
  (2 DIAG_BL 3)
