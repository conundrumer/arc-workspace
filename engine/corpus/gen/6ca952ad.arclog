;; 6ca952ad

(DET &bg DominantColor)

(DET &grav DirDomain)

;; Least cell count of an object that falls.
(DET &heavy TileCount)

(INIT &obj Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &size Cardinality
  (key ((&obj.component *P ^Id))
    (member ((:m P))
      (&obj.component *P Id))))

(RULE &falls
  (&size.size (:key *Id) *N)
  (&heavy (:N *K))
  (>= N K))

(INIT &fall Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj.component *P *Id)
    (&falls Id)
    (&grav *D)
    (&obj.component (:P *P2) (:Id *Id2))
    (&falls (:Id Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&obj.component *P *Id)
         (&falls Id)
         (&grav *D)
         (margin (:B P) D *K))
        ((&obj.component (:P *P3) Id)
         (&falls Id)
         (&grav (:D *D2))
         (&obj.component (:P *P2) (:Id *Id2))
         (NOT (&falls (:Id Id2)))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &fallen
  (input (:P *P2) *Col)
  (&obj.component (:P P2) *Id)
  (OR ((&fall.distance (:n Id) *K)
       (&grav *D)
       (jump_offset D K (:V *Delta))
       (compose (:A P2) (:B Delta) (:C *P)))
      ((NOT (&falls Id))
       (= P P2))))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (NOT (&fallen P))
       (&bg (:C Col)))))
