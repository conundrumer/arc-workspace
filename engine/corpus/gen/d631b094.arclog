;; d631b094

(DET &bg SharedColor)

(DET &bar_axis AxisDomain)

(RULE &on
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &total Cardinality
  (member ((:m P))
    (&on *P)))

(INIT &bar Frame
  (key ((&bar_axis ^A))
    (extent (A N)
      (&total.size *N))))

(RULE &output
  (&bar.cell *P)
  (&on *Col))
