;; 50846271

(DET &mark RarestColor)

(DET &fill AnyOutNewColor)

(DET &bg UnchangedColor)

(RULE &mark2
  (input *P *Col)
  (&mark (:C Col)))

(INIT &line Ray
  (source (P)
    (input *P))
  (node (P)
    (input *P))
  (dir (D)
    (dir_elem *D)))

(RULE &arm
  (input *P)
  (axis_elem *A)
  (sub_extent P A *K))

(RULE &plus
  (&arm *K)
  (&line.ray *P (:K *J) (:Origin *C))
  (<= J K))

(RULE &covers
  (&plus *K *C (:P *M))
  (&mark2 (:P M)))

(RULE &off
  (&plus *K *C *P)
  (input P *Col)
  (&bg (:C Col)))

(RULE &place
  (&covers *K *C)
  (NOT (&off K C)))

(ALTS $choice "which placements are the crosses, and where a plus may lie" $Backed
  (ALT $Packed
    (RULE &packing_item
      (&place *K *C)
      (&covers K C *M))

    ;; The placements every exact cover of the marks holds, arm by arm.
    (CHOOSE &packing
      (for ((&packing_item ^K ^M))
        (from (&packing_item K M *C)))
      (never
        (&packing_item *K *M *C)
        (&packing_item K (:M *M2) (:C *C2))
        (&packing_item K (:M M2) C)
        (!= C C2)))

    (RULE &cross
      (&packing *K *C)))
  (ALT $Free
    (RULE &place
      (&covers *K *C))

    (INIT &shortest Order
      (member ((:t K))
        (&arm *K)
        (NOT (&orphan K)))
      (score ((:t K) (:S K))
        (&arm *K)
        (NOT (&orphan K))))

    (RULE &span
      (&shortest.minimal (:t *K)))))

(RULE &rival
  (&place *K *C)
  (&covers K C *M)
  (&place K (:C *C2))
  (&covers K (:C C2) M)
  (!= C C2))

(RULE &unmatched
  (&rival *K *C *C2)
  (&covers K C *M)
  (NOT (&covers K (:C C2) M)))

(RULE &dominated
  (&rival *K *C *C2)
  (NOT (&unmatched K C C2))
  (&unmatched K (:C C2) (:C2 C)))

(RULE &cross
  (&place *K *C)
  (NOT (&dominated K C)))

(INIT &owner Singleton
  (key ((&cross ^K *C)
        (&covers K C ^M))
    (member ((:v C))
      (&cross K *C)
      (&covers K C M))))

(RULE &orphan
  (&arm *K)
  (&mark2 (:P *M))
  (NOT (&owner.value (:key K M))))

(RULE &span
  (&arm *K)
  (NOT (&orphan K)))

(RULE &completed
  (&span *K)
  (&cross K *C)
  (&plus K C *P)
  (NOT (&mark2 P)))

(RULE &output
  (OR ((input *P *Col)
       (&span)
       (NOT (&completed P)))
      ((&completed P)
       (&fill (:C Col)))))
