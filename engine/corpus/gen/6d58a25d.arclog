;; 6d58a25d

(DET &bg DominantColor)

(DET &dir DirDomain)

;; The shape's color forms one object; the marker color scatters into many.
(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &shape_color
  (&objs.node (:key *Col))
  (ALL ((&objs.component (:key Col) *Id)
        (&objs.component (:key Col) (:Id *Id2)))
       ((= Id Id2))))

;; From each shape cell toward &dir, over the cells past the shape.
(INIT &cast Ray
  (source (P)
    (input *P *Col)
    (&shape_color Col))
  (node (P)
    (input *P))
  (dir (D)
    (&dir *D)))

(RULE &cast_cell
  (input *P *Col)
  (NOT (&shape_color Col)))

(RULE &fill
  (&cast.ray *P *D (:Origin *Src))
  (&cast_cell P)
  (&cast.ray (:P *Q) D (:Origin Src))
  (&cast_cell (:P Q))
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))
