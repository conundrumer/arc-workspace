;; 42f83767

;; Blank line between a strip's blocks.
(DET &gap TileDim)

;; The strips run along this axis.
(DET &strip_axis AxisDomain)

;; The stencils' color.
(DET &stencil VanishedColor)

(INIT &stencils BoundingBox
  (cell (P)
    (input *P *Col)
    (&stencil (:C Col))))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stencil (:C Col))))

(RULE &legend_cell
  (&ink *P)
  (&stencils.box *B)
  (&strip_axis *A)
  (split (:P B) A (:Across *B_slab))
  (inside (:A P) (:B B_slab)))

(INIT &legend BoundingBox
  (cell (P)
    (&legend_cell *P)))

(RULE &strip_box
  (OR ((&stencils.box *B))
      ((&legend.box B))))

(INIT &block_cell_division Division
  (key ((OR ((&strip_box ^B)
             (input ^P)
             (inside (:A P) B)
             (relative (:Base B) (:X P) (:X_rel *P_strip)))
            ((&strip_box B)
             (input P)
             (inside (:A P) B)
             (&strip_axis *A)
             (perp A *A2)
             (box_extent B P (:A A2) (:N *K)))
            ((&strip_box B)
             (input P)
             (&strip_axis (:A *A3))
             (&gap (:D *G)))))
    (cell ((:P P_strip))
      (&strip_box B)
      (input P)
      (inside (:A P) B)
      (relative (:Base B) (:X P) (:X_rel *P_strip)))
    (side (A K)
      (&strip_box B)
      (input P)
      (inside (:A P) B)
      (&strip_axis *A)
      (perp A *A2)
      (box_extent B P (:A A2) (:N *K)))
    (gap (A G)
      (&strip_box B)
      (input P)
      (&strip_axis *A)
      (&gap (:D *G)))))

(INIT &composition BoundingBox
  (cell (P)
    (&ink *P)
    (NOT (&legend_cell P))))

(RULE &block_cell
  (&block_cell_division.tile (:key *B *P) (:P_outer *P_block) (:P_inner *P_intile)))

(RULE &stencil_cell
  (&stencils.box *B)
  (&block_cell B *P *P_block *P_intile)
  (input P *Col))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&composition.box *B)
    (&composition.cell *P)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_tile)))
  (inner ((:P P_intile))
    (&stencil_cell *P_intile)))

(RULE &legend_color
  (&legend.box *B)
  (&block_cell B *P *P_block)
  (&legend_cell P)
  (input P *Col))

(RULE &output
  (&composition.box *B)
  (&composition.cell (:P *P2))
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P_tile))
  (input (:P P2) (:Col *Col_tile))
  (&legend_color *P_block (:Col Col_tile))
  (&stencil_cell P_block *P_intile (:Col *T))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P)
  (OR ((NOT (&stencil (:C T)))
       (&bg (:C *Col)))
      ((&stencil (:C T))
       (= Col Col_tile))))
