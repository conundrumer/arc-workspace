;; 42a15761

(DET &gap DivisorRatio)

(DET &order_dir DirDomain)

(DET &panel_size SepTileDim)

(INIT &panel_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A K)
    (&order_dir *D)
    (axis_of D *A)
    (&panel_size (:D *K)))
  (gap (A G)
    (&order_dir *D)
    (axis_of D *A)
    (&gap (:K *G))))

(DET &mark RarestColor)

(RULE &panel
  (&panel_division.tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &tile
  (&panel *P_tile))

;; Marks per panel; a panel carrying none counts 0.
(INIT &marks Cardinality
  (key ((OR ((&tile ^P_tile))
            ((&panel *P_grid P_tile)
             (input (:P P_grid) *Col)
             (&mark (:C Col)))))
    (member ((:m P_grid))
      (&panel *P_grid P_tile)
      (input (:P P_grid) *Col)
      (&mark (:C Col)))
    (domain ()
      (&tile P_tile))))

;; Dense rank over the distinct mark counts, fewest first.
(INIT &count_order Order
  (member ((:t N))
    (&marks.size *N))
  (score ((:t N) (:S N))
    (&marks.size *N)))

(RULE &place
  (&marks.size (:key (:P_tile *P_src_tile)) *N)
  (&count_order.rank (:t N) *R)
  (&tile (:P_tile *P_dst_tile))
  (&order_dir *D)
  (margin (:B P_dst_tile) D (:K R)))

(RULE &output
  (OR ((&panel (:P_grid *P) (:P_tile *P_dst_tile) *P_intile)
       (&place *P_src_tile P_dst_tile)
       (&panel (:P_grid *P_grid_in) (:P_tile P_src_tile) P_intile)
       (input (:P P_grid_in) *Col))
      ((input P Col)
       (NOT (&panel (:P_grid P))))))
