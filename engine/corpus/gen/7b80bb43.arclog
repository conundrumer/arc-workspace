;; 7b80bb43

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The pair's dominant color is the background.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg Col)))

(RULE &flanked
  (&ink *P)
  (opposite *D (:Opp *D_opp))
  (neighbor P D *Q)
  (&ink (:P Q))
  (neighbor P (:D D_opp) (:Q *Q2))
  (&ink (:P Q2)))

(RULE &chain
  (&ink *P)
  (NOT (&flanked P))
  (diag_dir_elem *D)
  (neighbor P D *Q)
  (&ink (:P Q))
  (NOT (&flanked (:P Q))))

(RULE &straight
  (&chain *P)
  (opposite *D (:Opp *D_in))
  (neighbor P (:D D_in) *Q)
  (&ink (:P Q)))

(INIT &cast Ray
  (key ((OR ((&straight *P ^D))
            ((dir_elem D))))
    (source (P)
      (&straight *P D))
    (node (P)
      (dir_elem D)
      (input *P)
      (ALL ()
           ((&chain P))))
    (dir (D)
      (dir_elem D))))

(RULE &cast_stop
  (&cast.end (:key (:D *Key)) (:P *E) *D (:Origin *Src))
  (neighbor (:P E) D (:Q *P))
  (&cast.ray (:key (:D Key)) P D *K (:Origin Src)))

(RULE &cast_cell
  (dir_elem (:D *Key))
  (input *P))

(RULE &fill
  (&cast.ray (:key *D) *P *K (:Origin *Src))
  (&cast_cell (:Key D) P)
  (!= K 0)
  (&cast.end (:key D) (:P *E) (:D *D_2) (:Origin Src))
  (neighbor (:P E) (:D D_2) (:Q *P_2))
  (input (:P P_2))
  (input (:P Src) *Col))

(RULE &cleared
  (&chain *P)
  (NOT (&cast_stop (:Src P))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&fill P *Col))
      ((NOT (&fill P))
       (&cleared P)
       (&bg Col))
      ((NOT (&fill P))
       (NOT (&cleared P))
       (= Col Col_in))))
