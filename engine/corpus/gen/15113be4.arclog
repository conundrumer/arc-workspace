;; 15113be4

(DET &cand
  (ex_input *P)
  (axis_elem *A)
  (sub_extent P A (:K *N)))

;; Separator thickness.
(DET &gap DivisorRatio)

(INIT &cut_division Division
  (key ((&cand ^N))
    (parts (A N)
      (axis_elem *A)))
  (cell (P)
    (ex_input *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &cut
  (ex_input *E *P)
  (&cut_division.tile (:key *N) P))

(DET &bg SharedColor)

(DET &ink SharedColor)

(DET &sep SharedColor)

(RULE &key_color
  (input *Col)
  (NOT (&bg (:C Col)))
  (NOT (&ink (:C Col)))
  (NOT (&sep (:C Col))))

;; The key's interior — what its separator border encloses.
(INIT &key Flood
  (node (P)
    (input *P *Col)
    (NOT (&sep (:C Col))))
  (source (P)
    (input *P *Col)
    (&key_color Col)))

(DET &key_block
  (OR ((&key.reached *E *P))
      ((&key.reached E (:P *P2))
       (dir8_elem *D)
       (neighbor (:P P2) D (:Q P))
       (ex_input E P))))

(DET &defect
  (&cand *N)
  (ex_input *E *P *Col)
  (NOT (&key_block E P))
  (OR ((NOT (&cut E N P))
       (NOT (&sep (:C Col))))
      ((&cut E N P)
       (&sep (:C Col)))))

(DET &cell_count
  (&cand *N)
  (NOT (&defect N)))

(INIT &cell_at_division Division
  (cell (P)
    (input *P))
  (parts (A N)
    (axis_elem *A)
    (&cell_count *N))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(RULE &cell_at
  (&cell_at_division.tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

(INIT &key_box BoundingBox
  (cell (P)
    (&key.reached *P)))

(ALTS $choice "what the cut reads" $Count
  (ALT $Size
    ;; A cell's extent.
    (DET &dim SepTileCount)

    (INIT &cell_at_division2 Division
      (cell (P)
        (input *P))
      (side (A K)
        (axis_elem *A)
        (&dim (:N *K)))
      (gap (A G)
        (axis_elem *A)
        (&gap (:K *G))))

    (RULE &cell_at
      (&cell_at_division2.tile *P (:P_outer *P_tile) (:P_inner *P_intile)))))

(RULE &cell_dim
  (&cell_at *P_intile)
  (axis_elem *A)
  (frame_extent (:P P_intile) A *N))

(INIT &footprint_division Division
  (key ((&cell_dim ^N))
    (parts (A N)
      (axis_elem *A)))
  (cell ((:P P_inner))
    (input *P *Col)
    (&key_color Col)
    (&key_box.cell P)
    (&key_box.box *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &footprint
  (&footprint_division.tile (:P_outer *P_intile)))

;; The footprint against each cell's ink, both in cell frame.
(INIT &cover Inclusion
  (pattern ((:m P_intile))
    (&footprint *P_intile))
  (observed ((:observed P_tile) (:m P_intile))
    (&cell_at *P *P_tile *P_intile)
    (input P *Col)
    (&ink (:C Col))))

(RULE &stamp
  (&cell_at *P *P_tile *P_intile)
  (&cover.superset (:observed P_tile))
  (&footprint P_intile))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&stamp P)))
      ((&stamp P)
       (&key_color Col))))
