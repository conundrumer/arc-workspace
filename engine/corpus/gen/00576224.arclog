;; 00576224

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tile_d4 (:Pt *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_in))
    (&tile_d4 (:T *D))
    (apply D (:P P_in) (:P_out *P_intile))))

(DET &arr_pos Frame)

;; Bands stack along band_axis; plain bands at both stack ends.
(DET &band_axis AxisDomain)

(RULE &anchor
  (&band_axis *A)
  (axis_of *D A))

(DET &tf D4Domain)

(ALTS $choice "three models of the tile arrangement, data-equivalent on this task" $Lookup
  (ALT $Alt
    ;; The input transformed by &tf once per band step away from the
    ;; anchor edge: the anchor-edge band is plain, and each band step applies
    ;; &tf once more.
    (INIT &alternate Walk
      (successor ((:p P) (:p_next P_img))
        (input *P)
        (&tf (:D *F))
        (apply (:D F) P (:P_out *P_img)))
      (steps ((:N K))
        (&arr_pos (:P *T))
        (&anchor *D)
        (margin (:B T) D *K)))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (&arr_pos (:P *T)))
      (inner ((:P P_intile))
        (&alternate.walk (:p *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&output_tiling2.cell (:P_outer *T) (:P_inner *P_intile) *P)
      (&anchor *D)
      (margin (:B T) D *K)
      (&alternate.walk (:p0 P_in) (:N K) (:p P_intile))))
  (ALT $Mid
    (INIT &output_tiling3 Tiling
      (outer ((:P T))
        (&arr_pos (:P *T)))
      (inner ((:P P_intile))
        (input (:P *P_in))
        (&tf (:D *F))
        (apply (:D F) (:P P_in) (:P_out *P_intile))))

    (INIT &output_tiling4 Tiling
      (outer ((:P T))
        (&arr_pos (:P *T)))
      (inner ((:P P_in))
        (input (:P *P_in))))

    (RULE &output
      (OR ((input (:P *P_in) *Col)
           (&output_tiling3.cell (:P_outer *T) (:P_inner *P_intile) *P)
           (&anchor *D)
           (dist_pair (:P T) D *K (:K2 K))
           (&tf (:D *F))
           (apply (:D F) (:P P_in) (:P_out P_intile)))
          ((input (:P *P_in2) Col)
           (&output_tiling4.cell (:P_outer *T2) (:P_inner P_in2) P)
           (&anchor (:D *D2))
           (dist_pair (:P T2) (:D D2) (:K *K1) *K2)
           (!= K1 K2))))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
