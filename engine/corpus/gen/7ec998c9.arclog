;; 7ec998c9

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The Z's color.
(DET &line AnyOutNewColor)

;; The axis of the mark's own line, the stem of the Z.
(DET &axis AxisDomain)

;; The checkerboard's anchor corner, and the sense its shade turns by. Every grid is square, so the pairs do not separate DIAG_TL from DIAG_BR.
(DET &corner DiagDirDomain)

(DET &corner_sense SenseDomain)

;; The field is the commonest color; the mark is the cell that differs.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &mark
  (input *P *Col)
  (NOT (&field.maximal (:t Col))))

(RULE &corner_steps
  (&mark *P)
  (&corner (:D *Diag))
  (corner_dist P Diag *K))

;; The checkerboard: the anchor corner cell takes &corner_sense, and
;; each unit step swaps sense.
(INIT &checker Walk
  (successor ((:p S) (:p_next S2))
    (sense_elem *S)
    (sense_elem (:S *S2))
    (!= S S2))
  (steps ((:N K))
    (&corner_steps *K)))

(RULE &shade
  (&corner_steps *K)
  (&corner_sense (:S *S0))
  (&checker.walk (:p0 S0) (:N K) (:p *S)))

(RULE &stem_dir
  (&axis *A)
  (axis_of (:D *Key) A))

;; The Z's stem: rays from the mark both ways along the axis, keyed by their
;; cast direction.
(INIT &stem Ray
  (key ((OR ((&stem_dir (:Key ^D))
             (&mark *P))
            ((&axis *A)
             (axis_of D A))))
    (source (P)
      (&stem_dir (:Key D))
      (&mark *P))
    (node (P)
      (&axis *A)
      (axis_of D A)
      (input *P))
    (dir (D)
      (&axis *A)
      (axis_of D A))))

(RULE &stem_cell
  (&stem_dir *Key)
  (input *P)
  (NOT (&mark P)))

;; The Z's arms: each casts from the stem's end on the edge, in the direction
;; the mark's shade turns to.
(INIT &arm Ray
  (key ((OR ((&mark (:P *M))
             (&stem.ray (:key *D) *P D (:Origin M))
             (margin (:B P) D (:K 0))
             (&shade *S)
             (turn S D ^D2))
            ((dir_elem (:D D2)))))
    (source (P)
      (&mark (:P *M))
      (&stem.ray (:key *D) *P D (:Origin M))
      (margin (:B P) D (:K 0))
      (&shade *S)
      (turn S D D2))
    (node (P)
      (dir_elem (:D D2))
      (input *P))
    (dir ((:D D2))
      (dir_elem (:D D2)))))

(RULE &arm_cell
  (dir_elem (:D *Key))
  (input *P)
  (NOT (&mark P)))

(RULE &lit
  (OR ((&stem.ray (:key (:D *Ky)) *P)
       (&stem_cell (:Key Ky) P))
      ((&arm.ray (:key (:D2 Ky)) P)
       (&arm_cell (:Key Ky) P))))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&lit P))
      ((&line (:C *Col)))
      ((= Col Col_in))))
