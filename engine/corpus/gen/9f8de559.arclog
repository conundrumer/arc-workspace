;; 9f8de559

(INPUT field "a solid rectangle of &field_color sits inside the grid and does not touch the grid edge"

  (DET &body_color UnchangedColor)

  (DET_OR_RULE &head_color RarestColor)

  (RULE &pointer_of
    (&head_color (:C *Head))
    (&body_color (:C *Body)))

  (RULE &body3
    (&pointer_of *Head *Body)
    (input *P (:Col Body)))

  (RULE &head3
    (&pointer_of *Head *Body)
    (input *P (:Col Head)))

  (INIT &around_count Cardinality
    (key ((OR ((&head3 (:Head ^H) (:Body ^B) *P))
              ((&body3 (:Head H) (:Body B) P)))
          (neighbor P *Q)
          (input (:P Q) ^Col)
          (!= Col H)
          (!= Col B))
      (member ((:m Q))
        (OR ((&head3 (:Head H) (:Body B) *P))
            ((&body3 (:Head H) (:Body B) P)))
        (neighbor P *Q)
        (input (:P Q) Col)
        (!= Col H)
        (!= Col B))))

  (DET_OR_RULE &field_color DominantColor)

  ;; The commonest color among the cells next to the pointer, other than the
  ;; pointer colors.
  (INIT &around Order
    (key ((&around_count.size (:key (:H ^Head) (:B ^Body) *Col)))
      (member ((:t Col))
        (&around_count.size (:key (:H Head) (:B Body) *Col)))
      (score ((:t Col) (:S N))
        (&around_count.size (:key (:H Head) (:B Body) *Col) *N)))))

(INPUT pointer "inside the field, a straight line of &body_color cells runs along a row, a column, or a diagonal, and one &head_color cell continues that line at one end")

(OUTPUT ray "the ray starts at the head and steps away from the body, in the direction from the body cell next to the head to the head"

  (RULE &head
    (&head3 *Head *Body *P))

  (RULE &scan_cell
    (&head *Head *Body *P)
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  (INIT &scan Order
    (key ((&head (:Head ^Ky_head) (:Body ^Ky_body) *P)
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t P))
        (&head (:Head Ky_head) (:Body Ky_body) *P)
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a P) (:b P2))
        (&head (:Head Ky_head) (:Body Ky_body) *P)
        (diag_dir_elem (:D C))
        (axis_elem A)
        (&head (:Head Ky_head) (:Body Ky_body) (:P *P2))
        (&scan_cell (:Head Ky_head) (:Body Ky_body) (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (nearer D P (:Q P2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 P) P2)
             (nearer (:D D2) P (:Q P2)))))))

  (DET &head2
    (ex_input *E *P *Col)
    (&head_color (:C Col)))

  (DET &scan_cell2
    (&head2 (:E *Ky) *P)
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  (INIT &scan2 Order
    (key ((&head2 (:E ^Ky) *P)
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t P))
        (&head2 (:E Ky) *P)
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a P) (:b P2))
        (&head2 (:E Ky) *P)
        (diag_dir_elem (:D C))
        (axis_elem A)
        (&head2 (:E Ky) (:P *P2))
        (&scan_cell2 Ky (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (nearer D P (:Q P2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 P) P2)
             (nearer (:D D2) P (:Q P2)))))))

  ;; The axis on which body cells touch.
  (INIT &aligned Singleton
    (key ((&body3 ^Head ^Body *P)
          (&body3 Head Body (:P *Q))
          (neighbor P *D Q)
          (axis4_of D *A))
      (member ((:v A))
        (&body3 Head Body *P)
        (&body3 Head Body (:P *Q))
        (neighbor P *D Q)
        (axis4_of D *A))))

  ;; The step on that axis from each body cell toward the head cell.
  (INIT &away Singleton
    (key ((&head3 (:Head ^Ptr_head) (:Body ^Ptr_body) ^P))
      (member ((:v D))
        (&aligned.value (:key (:Head Ptr_head) (:Body Ptr_body)) (:v *A))
        (axis4_of *D A)
        (&body3 (:Head Ptr_head) (:Body Ptr_body) (:P *Q))
        (nearer D P Q)))))

(OUTPUT exit "the ray passes over field cells, and the first cell it reaches outside the field takes the field color; no other cell changes"

  (RULE &body
    (&body3 *Head *Body *P))

  ;; The body cells nearest each head cell, by taxicab distance.
  (INIT &near Order
    (key ((&head (:Head ^Ky_head) (:Body ^Ky_body) ^P))
      (member ((:t (:V Q) (:S N)))
        (&body (:Head Ky_head) (:Body Ky_body) (:P *Q))
        (relative (:Base P) (:X Q) (:X_rel *V))
        (diag_dist (:P V) *Diag *K1 *K2)
        (>= K1 0)
        (>= K2 0)
        (corner_dist (:P V) Diag (:K *N)))
      (score ((:t (:V Q) (:S N)) (:S N))
        (&body (:Head Ky_head) (:Body Ky_body) (:P *Q))
        (relative (:Base P) (:X Q) (:X_rel *V))
        (diag_dist (:P V) *Diag *K1 *K2)
        (>= K1 0)
        (>= K2 0)
        (corner_dist (:P V) Diag (:K *N)))))

  (DET &body2
    (ex_input *E *P *Col)
    (&body_color (:C Col)))

  ;; The body cells nearest each head cell, by taxicab distance.
  (INIT &near2 Order
    (key ((&head2 (:E ^Ky) ^P))
      (member ((:t (:V Q) (:S N)))
        (&body2 (:E Ky) (:P *Q))
        (relative (:Base P) (:X Q) (:X_rel *V))
        (diag_dist (:P V) *Diag *K1 *K2)
        (>= K1 0)
        (>= K2 0)
        (corner_dist (:P V) Diag (:K *N)))
      (score ((:t (:V Q) (:S N)) (:S N))
        (&body2 (:E Ky) (:P *Q))
        (relative (:Base P) (:X Q) (:X_rel *V))
        (diag_dist (:P V) *Diag *K1 *K2)
        (>= K1 0)
        (>= K2 0)
        (corner_dist (:P V) Diag (:K *N)))))

  (RULE &tie_cell
    (&near.minimal (:key (:Ky_head *Head) (:Ky_body *Body) (:P *Key_p)) (:t (:V *P)))
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  (INIT &tie Order
    (key ((&near.minimal (:key ^Ky_head ^Ky_body ^P) (:t (:V *Q)))
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t Q))
        (&near.minimal (:key Ky_head Ky_body P) (:t (:V *Q)))
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a Q) (:b Q2))
        (&near.minimal (:key Ky_head Ky_body P) (:t (:V *Q)))
        (diag_dir_elem (:D C))
        (axis_elem A)
        (&near.minimal (:key Ky_head Ky_body P) (:t (:V *Q2)))
        (&tie_cell (:Head Ky_head) (:Body Ky_body) (:Key_p P) (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (nearer D (:P Q) (:Q Q2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 Q) (:P2 Q2))
             (nearer (:D D2) (:P Q) (:Q Q2)))))))

  (DET &tie_cell2
    (&near2.minimal (:key *Ky (:P *Key_p)) (:t (:V *P)))
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  (INIT &tie2 Order
    (key ((&near2.minimal (:key ^Ky ^P) (:t (:V *Q)))
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t Q))
        (&near2.minimal (:key Ky P) (:t (:V *Q)))
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a Q) (:b Q2))
        (&near2.minimal (:key Ky P) (:t (:V *Q)))
        (diag_dir_elem (:D C))
        (axis_elem A)
        (&near2.minimal (:key Ky P) (:t (:V *Q2)))
        (&tie_cell2 Ky (:Key_p P) (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (nearer D (:P Q) (:Q Q2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 Q) (:P2 Q2))
             (nearer (:D D2) (:P Q) (:Q Q2)))))))

  (DET &tie_step2
    (&tie2.minimal (:key (:Ky *E) *P *C *A) (:t *Q))
    (OR ((perp_dir *D *D2)
         (nearer D P Q)
         (same_dist (:D D2) (:P1 P) (:P2 Q)))
        ((diag_dirs D *D1 D2)
         (nearer (:D D1) P Q)
         (nearer (:D D2) P Q))))

  (RULE &tie_step
    (&tie.minimal (:key (:Ky_head *Head) (:Ky_body *Body) *P *C *A) (:t *Q))
    (OR ((perp_dir *D *D2)
         (nearer D P Q)
         (same_dist (:D D2) (:P1 P) (:P2 Q)))
        ((diag_dirs D *D1 D2)
         (nearer (:D D1) P Q)
         (nearer (:D D2) P Q))))

  ;; The bounding box of each color's cells.
  (INIT &field BoundingBox
    (key ((input *P ^Col))
      (cell (P)
        (input *P Col))))

  ;; The step from each body cell next to a head cell.
  (INIT &touch Singleton
    (key ((&head3 (:Head ^Ptr_head) (:Body ^Ptr_body) ^P))
      (member ((:v D))
        (&body3 (:Head Ptr_head) (:Body Ptr_body) (:P *Q))
        (neighbor (:P Q) *D (:Q P)))))

  (RULE &heading
    (&touch.value (:key (:Ptr_head *Head) (:Ptr_body *Body) *P) (:v *D)))

  (RULE &field_of
    (&pointer_of *Head *Body)
    (&field_color (:C *F)))

  (RULE &palette
    (&pointer_of *Head *Body)
    (&field_of Head Body *F))

  (RULE &ray_blocked
    (&palette (:F *Field) *Head *Body)
    (&field.box (:key (:Col Field)) *B)
    (input *P)
    (NOT (inside (:A P) B)))

  (DET &changed
    (ex_input *E (:P *Q) (:Col *C_in))
    (ex_output E (:P Q) (:Col *C_out))
    (!= C_in C_out))

  (DET &cast
    (&head2 *E *P)
    (&changed E *Q)
    (same_line *A P Q)
    (axis4_of *D A)
    (nearer D (:P Q) (:Q P)))

  (DET &tie_cast
    (&cast *E *P *D)
    (&tie_step2 E P *C *A D))

  (DET &tie_missed
    (&tie_cast *C *A)
    (&tie_step2 *E *P C A)
    (ex_output E)
    (NOT (&tie_cast E P C A)))

  (DET &tie_order
    (&tie_cast *C *A)
    (NOT (&tie_missed C A))
    (ONE))

  (RULE &tie_heading
    (&tie_step *Head *Body *P *C *A *D)
    (&tie_order C A))

  ;; The cast from each head cell toward its step.
  (INIT &ray Ray
    (key ((&palette ^F (:Head ^Ptr_head) (:Body ^Ptr_body)))
      (source (P)
        (&head3 (:Head Ptr_head) (:Body Ptr_body) *P))
      (node (P)
        (OR ((&heading (:Head Ptr_head) (:Body Ptr_body) *D))
            ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) D)))
        (input *P)
        (NOT (&ray_blocked (:Field F) (:Head Ptr_head) (:Body Ptr_body) P)))
      (dir (D)
        (OR ((&heading (:Head Ptr_head) (:Body Ptr_body) *D))
            ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) D))))))

  (RULE &unaimed
    (&heading *Head *Body)
    (&head3 Head Body *P)
    (NOT (&heading Head Body P)))

  (RULE &exit
    (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
    (&heading (:Head Ptr_head) (:Body Ptr_body) (:P *Src) *D)
    (&head3 (:Head Ptr_head) (:Body Ptr_body) (:P Src))
    (&ray.end (:key F Ptr_head Ptr_body) (:P *E) D (:Origin Src))
    (neighbor (:P E) D (:Q *P))
    (input P))

  (RULE &framed
    (&field.box (:key (:Col *F))))

  ;; The exit cells take the field's color.
  (RULE &paint_of
    (&palette *F)))

(ALTS $direction "how the ray's direction is read" $Adjacent
  (ALT $NearestBody
    (OUTPUT ray "the ray steps from the head away from the body cell nearest the head (taxicab distance), along the sign of each axis; among nearest body cells, the first in the order &tie_order gives"
      ;; The cast from each head cell toward its step.
      (INIT &ray Ray
        (key ((&palette ^F (:Head ^Ptr_head) (:Body ^Ptr_body)))
          (source (P)
            (&head3 (:Head Ptr_head) (:Body Ptr_body) *P))
          (node (P)
            (&tie_heading (:Head Ptr_head) (:Body Ptr_body) *D)
            (input *P)
            (NOT (&ray_blocked (:Field F) (:Head Ptr_head) (:Body Ptr_body) P)))
          (dir (D)
            (&tie_heading (:Head Ptr_head) (:Body Ptr_body) *D))))

      (RULE &tie_exit
        (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
        (&tie_heading (:Head Ptr_head) (:Body Ptr_body) *C *A (:P *Src) *D)
        (&head3 (:Head Ptr_head) (:Body Ptr_body) (:P Src))
        (&ray.end (:key F Ptr_head Ptr_body) (:P *E) D (:Origin Src))
        (neighbor (:P E) D (:Q *P))
        (input P)))
    ;; One grid per tie order, read at every head order.
    (RULE &output
      (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
      (&head3 (:Head Ptr_head) (:Body Ptr_body))
      (&tie_order (:C *Tc) (:A *Ta))
      (ALL ((&head3 (:Head Ptr_head) (:Body Ptr_body) (:P *Pm)))
           ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) (:C Tc) (:A Ta) (:P Pm))))
      (&framed F)
      (&paint_of F)
      (OR ((input *P *Col)
           (NOT (&tie_exit (:C Tc) (:A Ta) P)))
          ((&tie_exit (:C Tc) (:A Ta) P)
           (= Col F))))
    (ALT $ScanHead
      (OUTPUT ray "only the head cell that comes first in the order &head_order gives casts"
        (RULE &tie_head_exit
          (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
          (&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C *Hc) (:A *Ha) (:P *Src))
          (&tie_heading (:Head Ptr_head) (:Body Ptr_body) (:C *Tc) (:A *Ta) (:P Src) *D)
          (&ray.end (:key F Ptr_head Ptr_body) (:P *E) D (:Origin Src))
          (neighbor (:P E) D (:Q *P))
          (input P)))
      ;; One grid per pair of orders.
      (RULE &output
        (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
        (&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C *Hc) (:A *Ha))
        (&tie_order (:C *Tc) (:A *Ta))
        (ALL ((&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C Hc) (:A Ha) (:P *Pm)))
             ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) (:C Tc) (:A Ta) (:P Pm))))
        (&framed F)
        (&paint_of F)
        (OR ((input *P *Col)
             (NOT (&tie_head_exit Tc Ta Hc Ha P)))
            ((&tie_head_exit Tc Ta Hc Ha P)
             (= Col F)))))
    (ALT $StoredPaint
      ;; One grid per tie order, read at every head order.
      (RULE &output
        (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
        (&head3 (:Head Ptr_head) (:Body Ptr_body))
        (&tie_order (:C *Tc) (:A *Ta))
        (ALL ((&head3 (:Head Ptr_head) (:Body Ptr_body) (:P *Pm)))
             ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) (:C Tc) (:A Ta) (:P Pm))))
        (&framed F)
        (&paint_of F (:Col *C))
        (OR ((input *P *Col)
             (NOT (&tie_exit (:C Tc) (:A Ta) P)))
            ((&tie_exit (:C Tc) (:A Ta) P)
             (= Col C)))))
    (ALT $ScanHead
      (ALT $StoredPaint
        ;; One grid per pair of orders.
        (RULE &output
          (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
          (&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C *Hc) (:A *Ha))
          (&tie_order (:C *Tc) (:A *Ta))
          (ALL ((&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C Hc) (:A Ha) (:P *Pm)))
               ((&tie_heading (:Head Ptr_head) (:Body Ptr_body) (:C Tc) (:A Ta) (:P Pm))))
          (&framed F)
          (&paint_of F (:Col *C))
          (OR ((input *P *Col)
               (NOT (&tie_head_exit Tc Ta Hc Ha P)))
              ((&tie_head_exit Tc Ta Hc Ha P)
               (= Col C)))))))
  (ALT $BodyAxis
    (OUTPUT ray "the ray steps from the head along the axis on which body cells touch, away from the body; undefined when body cells touch on two axes or lie on both sides of the head"
      (RULE &heading
        (&away.value (:key (:Ptr_head *Head) (:Ptr_body *Body) *P) (:v *D))))))

(ALTS $source "which head cells cast" $EveryHead
  (ALT $ScanHead
    (OUTPUT ray "only the head cell that comes first in the order &head_order gives casts"
      (DET &head_first
        (&cast *E *P)
        (&scan2.minimal (:key (:Ky E) *C *A) (:t P)))

      (DET &head_missed
        (&head_first *C *A)
        (ex_output *E)
        (NOT (&head_first E C A)))

      (DET &head_order
        (&head_first *C *A)
        (NOT (&head_missed C A))
        (ONE))

      (RULE &scan_source
        (&scan.minimal (:key (:Ky_head *Head) (:Ky_body *Body) *C *A) (:t *P))
        (&head_order C A))

      (RULE &head_unaimed
        (&heading *Head *Body)
        (&scan_source Head Body *C *A *P)
        (NOT (&heading Head Body P)))

      (RULE &head_exit
        (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
        (&scan_source (:Head Ptr_head) (:Body Ptr_body) *C *A (:P *Src))
        (&heading (:Head Ptr_head) (:Body Ptr_body) (:P Src) *D)
        (&ray.end (:key F Ptr_head Ptr_body) (:P *E) D (:Origin Src))
        (neighbor (:P E) D (:Q *P))
        (input P)))
    ;; One grid per head order, read at every tie order.
    (RULE &output
      (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
      (&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C *Hc) (:A *Ha))
      (&heading (:Head Ptr_head) (:Body Ptr_body))
      (NOT (&head_unaimed (:Head Ptr_head) (:Body Ptr_body) (:C Hc) (:A Ha)))
      (&framed F)
      (&paint_of F)
      (OR ((input *P *Col)
           (NOT (&head_exit (:C Hc) (:A Ha) P)))
          ((&head_exit (:C Hc) (:A Ha) P)
           (= Col F))))
    (ALT $StoredPaint
      ;; One grid per head order, read at every tie order.
      (RULE &output
        (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
        (&scan_source (:Head Ptr_head) (:Body Ptr_body) (:C *Hc) (:A *Ha))
        (&heading (:Head Ptr_head) (:Body Ptr_body))
        (NOT (&head_unaimed (:Head Ptr_head) (:Body Ptr_body) (:C Hc) (:A Ha)))
        (&framed F)
        (&paint_of F (:Col *C))
        (OR ((input *P *Col)
             (NOT (&head_exit (:C Hc) (:A Ha) P)))
            ((&head_exit (:C Hc) (:A Ha) P)
             (= Col C)))))))

(ALTS $stop "which cell the ray paints" $FieldExit
  (ALT $FirstNonfield
    (OUTPUT exit "the first cell on the ray that is not the field color takes the field color; no field cell needs to exist"
      (RULE &framed
        (&palette *F))

      (RULE &ray_blocked
        (&palette (:F *Field) *Head *Body)
        (input *P *Col)
        (!= Col Field)))))

(ALTS $paint "the color the painted cell takes" $FieldPaint
  (ALT $StoredPaint
    (OUTPUT exit "the first cell the ray reaches outside the field takes &paint_color"
      (DET_OR_RULE &paint_color DominantColor)

      ;; The exit cells take the stored paint color.
      (RULE &paint_of
        (&palette *F)
        (&paint_color (:C *Col))))
    (RULE &output
      ;; One grid, read at every order.
      (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
      (&heading (:Head Ptr_head) (:Body Ptr_body))
      (NOT (&unaimed (:Head Ptr_head) (:Body Ptr_body)))
      (&framed F)
      (&paint_of F (:Col *C))
      (OR ((input *P *Col)
           (NOT (&exit P)))
          ((&exit P)
           (= Col C))))))

(ALTS $field "how the field color is found" $StoredField
  (ALT $DerivedField
    (INPUT field "a solid rectangle of the color most common among the cells next to the pointer, other than the pointer colors; undefined at a tie"
      (RULE &field_of
        (&around.maximal (:key *Head *Body) (:t *F))))))

(ALTS $pointer "how the head and body colors are found" $StoredPointer
  (ALT $DerivedPointer
    (INPUT pointer "inside the field's bounding box, the cells not of the field color have two colors; the head color has one cell and the body color more; undefined otherwise"
      (RULE &inset
        (&field.box (:key (:Col *F)) *B)
        (input *P *Col)
        (inside (:A P) B)
        (!= Col F))

      (RULE &repeated
        (&inset *F *P *Col)
        (&inset F (:P *Q) Col)
        (!= P Q))

      (RULE &derived_pointer
        (&inset *F (:Col *Head))
        (NOT (&repeated F (:Col Head)))
        (&inset F (:Col *Body))
        (&repeated F (:Col Body))
        (ALL ((&inset F *Col)
              (!= Col Head))
             ((= Col Body))))

      (RULE &pointer_of
        (&derived_pointer *Head *Body))

      (RULE &palette
        (&derived_pointer *F *Head *Body)
        (&field_of Head Body F)))))

;; One grid, read at every order.
(RULE &output
  (&palette *F (:Head *Ptr_head) (:Body *Ptr_body))
  (&heading (:Head Ptr_head) (:Body Ptr_body))
  (NOT (&unaimed (:Head Ptr_head) (:Body Ptr_body)))
  (&framed F)
  (&paint_of F)
  (OR ((input *P *Col)
       (NOT (&exit P)))
      ((&exit P)
       (= Col F))))
