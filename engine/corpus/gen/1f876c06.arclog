;; 1f876c06

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &span_axis
  (&mark (:Col *Key))
  (diag_axis_elem (:Da *A)))

;; The domain is the whole grid, so a span covers its own marks.
(INIT &span Ray
  (key ((OR ((&mark ^Col *P))
            ((&span_axis (:Key Col) *A)
             (axis4_of *D A))
            ((&span_axis (:Key Col))
             (input P))))
    (source (P)
      (&mark Col *P))
    (node (P)
      (&span_axis (:Key Col))
      (input *P))
    (dir (D)
      (&span_axis (:Key Col) *A)
      (axis4_of *D A))))

(RULE &span_between
  (&mark (:Col *Key))
  (input *P)
  (&span_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&span.ray (:key (:Col Key)) P D)
  (&span.ray (:key (:Col Key)) P (:D O)))

(RULE &output
  (OR ((&span_between (:Key *Col) *P))
      ((input P Col)
       (NOT (&span_between P)))))
