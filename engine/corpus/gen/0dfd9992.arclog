;; 0dfd9992

(DET &hole ChangedColor)

(RULE &intact
  (input *P *Col)
  (NOT (&hole (:C Col))))

(INIT &si Periods
  (cell (P (:v Col))
    (&intact *P *Col)))

(INIT &wp Wallpaper
  (transform (D)
    (d4_elem *D))
  (cell (P (:v Col))
    (&intact *P *Col))
  (grid (P)
    (input *P))
  (period (A K)
    (&si.fundamental_period *A *K)))

;; The orbits of the frame positions under the symmetries.
(INIT &orbit Quotient
  (edge ((:a P) (:b Q))
    (&wp.action *P *Q)))

(RULE &output
  (&orbit.class (:a *P) *Id)
  (&orbit.class (:a *Q) Id)
  (&intact (:P Q) *Col))
