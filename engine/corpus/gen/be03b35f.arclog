;; be03b35f

(DET &frame Frame)

;; Each quadrant's anchored cells must map onto the whole output.
(INIT &d4m Agreement
  (key ((OR ((diag_dir_elem (:D ^Diag))
             (ex_input ^E (:P *P_in) *Col)
             (ex_output E)
             (&frame (:P *P_anchor))
             (same_corner (:D Diag) (:P1 P_anchor) (:P2 P_in)))
            ((diag_dir_elem (:D Diag))
             (ex_output E *P Col))))
    (source ((:i P_anchor) (:v Col))
      (diag_dir_elem (:D Diag))
      (ex_input E (:P *P_in) *Col)
      (ex_output E)
      (&frame (:P *P_anchor))
      (same_corner (:D Diag) (:P1 P_anchor) (:P2 P_in)))
    (target ((:i P) (:v Col))
      (diag_dir_elem (:D Diag))
      (ex_output E *P *Col))
    (correspondence ((:m D) (:i P_anchor) (:j Q))
      (diag_dir_elem (:D Diag))
      (ex_input E (:P *P_in) *Col)
      (ex_output E)
      (&frame (:P *P_anchor))
      (same_corner (:D Diag) (:P1 P_anchor) (:P2 P_in))
      (d4_elem *D)
      (apply D (:P P_anchor) (:P_out *Q)))))

(DET &broken
  (&d4m.mismatch (:key *E *Diag) (:m *D4))
  (ex_output E))

(DET &d4m_src
  (diag_dir_elem (:D *Diag))
  (ex_input *E (:P *P_in) (:Col *V))
  (ex_output E)
  (&frame *P)
  (same_corner (:D Diag) (:P1 P) (:P2 P_in)))

(DET &template
  (&d4m_src *E *Diag)
  (d4_elem (:D *D4))
  (NOT (&d4m.mismatch (:key E Diag) (:m D4)))
  (ex_output E)
  (NOT (&broken Diag D4)))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&template *Diag (:D4 *D))
  (&frame (:P *P_anchor))
  (same_corner (:D Diag) (:P1 P_anchor) (:P2 P_grid_in))
  (apply D (:P P_anchor) (:P_out *P)))
