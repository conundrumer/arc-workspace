;; c444b776

(INPUT divider-lines "full rows and full columns of divider (4) cut the grid into equal panels, with no divider on the grid edge"

  (DET &cell
    (ex_input *E *P *Col)
    (ex_output E))

  ;; The color of each line that holds one color alone.
  (INIT &line_color2 Singleton
    (key ((&cell (:E ^Ky) *P *Col)
          (axis_elem ^A)
          (split P A (:Along ^L)))
      (member ((:v Col))
        (&cell (:E Ky) *P *Col)
        (axis_elem A)
        (split P A (:Along L)))))

  (DET &filled
    (&line_color2.value (:key (:Ky *E)) (:v *Col)))

  (DET &unfilled
    (&filled *Col)
    (&cell *E)
    (NOT (&filled E Col)))

  (DET &divider
    (&filled (:Col *C))
    (NOT (&unfilled (:Col C))))

  (DET &cut2
    (&divider (:C *Col))
    (&cell *E))

  (DET &lattice_divider2
    (&cut2 *E *Col)
    (&line_color2.value (:key (:Ky E) *A *L) (:v Col)))

  ;; TODO no-det-plan: &panel_size: the plan gives no verdict
  (DET &panel_size)

  ;; The runs of adjacent divider lines.
  (INIT &divider_run Connectivity
    (key ((&lattice_divider2 ^E ^A *L))
      (node ((:P L))
        (&lattice_divider2 E A *L))))

  (INIT &band_width Cardinality
    (key ((&divider_run.component (:key ^E ^A) (:P *L) ^Id))
      (member ((:m L))
        (&divider_run.component (:key E A) (:P *L) Id))))

  (INIT &width Singleton
    (member ((:v N))
      (&band_width.size *N)))

  (DET_OR_RULE &gap "The width of the lines between the panels." SepThickness TileDim
    (&width.value (:v *G)))

  (INIT &stored Division
    (cell (P)
      (input *P))
    (side (A K)
      (&panel_size *A *K))
    (gap (A G)
      (&panel_size *A *K)
      (&gap *G))))

(INPUT one-drawn-panel "exactly one panel holds cells other than background (0), and every other panel is all background"

  (DET &lattice_cell2
    (&cut2 *E)
    (&cell E *P))

  (DET &lattice_on_divider2
    (&lattice_cell2 *E *P)
    (&lattice_divider2 E *A *L)
    (axis_of *D A)
    (same_dist D (:P1 P) (:P2 L)))

  (INIT &lattice_rank2 Order
    (key ((OR ((&lattice_divider2 (:E ^Ky) *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((&lattice_cell2 (:E Ky) *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&lattice_divider2 (:E Ky) *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&lattice_divider2 (:E Ky) *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((&lattice_cell2 (:E Ky) *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (&lattice_cell2 (:E Ky) *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (DET &lattice_part_idx2
    (&lattice_cell2 *E *P)
    (axis_of *D *A)
    (NOT (&lattice_on_divider2 E P A))
    (margin (:B P) D *K)
    (&lattice_rank2.rank (:key (:Ky E) D) (:t K) (:R *N)))

  (DET &lattice_part_of2
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&lattice_part_idx2 *E *P D (:N *N1))
    (&lattice_part_idx2 E P (:D D2) (:N *N2))
    (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

  (DET &lattice_tile_of2
    (&lattice_part_of2 *E *P *A (:P_part *P1))
    (perp A *A2)
    (&lattice_part_of2 E P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (RULE &cut
    (&divider (:C *Col)))

  (RULE &lattice_cell
    (&cut)
    (input *P))

  ;; The color of each line that holds one color alone.
  (INIT &line_color Singleton
    (key ((input *P *Col)
          (axis_elem ^A)
          (split P A (:Along ^L)))
      (member ((:v Col))
        (input *P *Col)
        (axis_elem A)
        (split P A (:Along L)))))

  (RULE &lattice_divider
    (&cut *Col)
    (&line_color.value (:key *A *L) (:v Col)))

  (RULE &lattice_on_divider
    (&lattice_cell *P)
    (&lattice_divider *A *L)
    (axis_of *D A)
    (same_dist D (:P1 P) (:P2 L)))

  (INIT &lattice_rank Order
    (key ((OR ((&lattice_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((&lattice_cell *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&lattice_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&lattice_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((&lattice_cell *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (&lattice_cell *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &lattice_part_idx
    (&lattice_cell *P)
    (axis_of *D *A)
    (NOT (&lattice_on_divider P A))
    (margin (:B P) D *K)
    (&lattice_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &lattice_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&lattice_part_idx *P D (:N *N1))
    (&lattice_part_idx P (:D D2) (:N *N2))
    (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

  (RULE &lattice_tile_of
    (&lattice_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&lattice_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (INIT &tile_box2 BoundingBox
    (key ((&lattice_tile_of2 (:E ^Ky) *P ^P_tile))
      (cell (P)
        (&lattice_tile_of2 (:E Ky) *P P_tile))))

  (DET &panel2
    (&lattice_tile_of2 *E *P *P_tile)
    (&tile_box2.box (:key (:Ky E) P_tile) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_intile)))

  (DET &stained
    (&panel2 *E *P *P_tile)
    (&cell E P (:Col *Col2))
    (&cell E *Col)
    (!= Col Col2))

  (DET &blank
    (&panel2 *E *P *P_tile)
    (&cell E P *Col)
    (NOT (&stained E P_tile Col)))

  (DET &unblank
    (&blank *Col)
    (&cell *E)
    (NOT (&blank E Col)))

  (DET_OR_RULE &background DominantColor
    (&blank (:Col *C))
    (NOT (&unblank (:Col C))))

  (INIT &tile_box BoundingBox
    (key ((&lattice_tile_of *P ^P_tile))
      (cell (P)
        (&lattice_tile_of *P P_tile))))

  (RULE &panel
    (&lattice_tile_of *P *P_tile)
    (&tile_box.box (:key P_tile) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_intile)))

  (RULE &panel3
    (&panel *P *P_tile *P_intile))

  (INIT &one_drawn Singleton
    (member ((:v P_tile))
      (&panel3 *P *P_tile)
      (input P *Col)
      (NOT (&background (:C Col))))))

(OUTPUT copy-to-every-panel "each panel of the output is the drawn panel of the input, and the divider lines stay as they are"

  ;; The colors other than background that the panels hold at each place.
  (INIT &overlay Singleton
    (key ((&panel3 *P ^P_intile)
          (input P *Col)
          (NOT (&background (:C Col))))
      (member ((:v Col))
        (&panel3 *P P_intile)
        (input P *Col)
        (NOT (&background (:C Col))))))

  ;; The cells other than background that each panel holds.
  (INIT &drawn_count Cardinality
    (key ((&panel3 ^P_tile))
      (member ((:m P))
        (&panel3 *P P_tile)
        (input P *Col)
        (NOT (&background (:C Col))))
      (domain ()
        (&panel3 P_tile))))

  (INIT &most Order
    (member ((:t (:V P_tile) (:S N)))
      (&drawn_count.size (:key *P_tile) *N))
    (score ((:t (:V P_tile) (:S N)) (:S N))
      (&drawn_count.size (:key *P_tile) *N)))

  (INIT &most_drawn Singleton
    (member ((:v P_tile))
      (&most.maximal (:t (:V *P_tile))))))

(ALTS $pn "how the panels are found" $DividerLines
  (ALT $DividerFromLines
    (INPUT divider-lines "the divider is the one color other than background that fills a whole row or column; undefined where no such color exists, or where several do"
      ;; The one color other than background that fills a whole line.
      (INIT &line_divider Singleton
        (member ((:v Col))
          (&line_color.value (:v *Col))
          (NOT (&background (:C Col)))))

      (RULE &cut
        (&line_divider.value (:v *Col)))))
  (ALT $StoredLattice
    (INPUT divider-lines "panels of panel_size (9 by 9), with lines gap (1) wide between them, cut the grid, whatever the lines' color; undefined where an extent of the grid is not a whole number of panels and gaps"
      (RULE &panel3
        (&stored.tile *P (:P_outer *P_tile) (:P_inner *P_intile))))))

(ALTS $s "what each panel of the output takes" $OneDrawn
  (ALT $Overlay
    (OUTPUT copy-to-every-panel "each panel of the output is the overlay of the input's panels, where a cell other than background in any panel shows; undefined where two panels hold different such colors at one place")
    (RULE &fill
      (&panel3 *P_intile)
      (OR ((&overlay.value (:key P_intile) (:v *Col)))
          ((NOT (&overlay.member (:key P_intile)))
           (&background (:C Col))))))
  (ALT $MostDrawn
    (OUTPUT copy-to-every-panel "each panel of the output is the input panel with the most cells other than background; undefined on a tie")
    (RULE &source
      (&most_drawn.value (:v *P_tile)))))

(RULE &source
  (&one_drawn.value (:v *P_tile)))

(RULE &fill
  (&source *P_tile)
  (&panel3 *P P_tile *P_intile)
  (input P *Col))

(RULE &in_panel
  (&panel3 *P))

(RULE &output
  (OR ((&panel3 *P *P_intile)
       (&fill P_intile *Col))
      ((&in_panel)
       (input P Col)
       (NOT (&in_panel P)))))
