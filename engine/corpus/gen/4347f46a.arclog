;; 4347f46a

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &comps Connectivity
  (node (P)
    (&ink *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(RULE &inner_cell
  (&bbox.box *B)
  (input *P)
  (interior (:A P) B))

(ALTS $choice "which cells are the interior" $Box
  (ALT $Erode
    (INIT &exposed Boundary
      (cell (P)
        (&ink *P)))

    (RULE &inner_cell
      (&ink *P)
      (NOT (&exposed.boundary P)))))

(RULE &output
  (OR ((&inner_cell *P)
       (&bg (:C *Col)))
      ((input P Col)
       (NOT (&inner_cell P)))))
