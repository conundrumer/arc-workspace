;; 239be575

(DET &mark VanishedColor)

(DET &link ColorDomain)

(DET &out_pos Frame)

(DET &bg DominantColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &node
  (input *P *Col)
  (OR ((&mark (:C Col)))
      ((&link (:C Col)))))

(INIT &orth Connectivity
  (node (P)
    (&node *P)))

(RULE &apart
  (&mark_cell *P)
  (&mark_cell (:P *Q))
  (NOT (&orth.connected P Q)))

(ALTS $a "what an edge is" $Orth
  (ALT $Diag
    (INIT &diag Connectivity
      (node (P)
        (&node *P))
      (step ((:Delta S))
        (diag_dir_elem *D)
        (step_offset D (:V *S))))

    (RULE &apart
      (&mark_cell *P)
      (&mark_cell (:P *Q))
      (NOT (&diag.connected P Q)))))

(ALTS $r "how the verdict renders" $Wire
  (ALT $Table
    (DET &join_paint ColorDomain)

    (DET &apart_paint DominantColor)

    (RULE &output
      (OR ((&joined)
           (&join_paint (:C *Col))
           (&out_pos *P))
          ((&apart)
           (&apart_paint (:C Col))
           (&out_pos P))))))

(RULE &joined
  (NOT (&apart)))

(RULE &output
  (OR ((&joined)
       (&link (:C *Col))
       (&out_pos *P))
      ((&apart)
       (&bg (:C Col))
       (&out_pos P))))
