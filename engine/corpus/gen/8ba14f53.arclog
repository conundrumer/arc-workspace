;; 8ba14f53

(DET &bg DominantColor)

(DET &out_pos Frame)

;; The reading order the filled cells follow: from corner, axis primary.
(DET &corner DiagDirDomain)

(DET &axis AxisDomain)

(RULE &stack_dir
  (&corner (:D *C))
  (&axis *A)
  (corner_dir C A (:D *D_corner))
  (opposite (:D D_corner) (:Opp *D)))

;; Shapes fill in order of their nearest cell to this edge.
(DET &order_dir DirDomain)

(INIT &shapes Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &obj
  (&shapes.component (:key *Col) *P *Id))

;; Reading order over the output frame.
(INIT &reading Order
  (member ((:t P))
    (&out_pos *P))
  (before ((:a P) (:b P2))
    (&out_pos *P)
    (&out_pos (:P *P2))
    (&corner (:D *C))
    (&axis *A)
    (OR ((corner_dir C A *D)
         (nearer D P (:Q P2)))
        ((diag_dirs (:D C) A (:D1 D) *D2)
         (same_dist D (:P1 P) P2)
         (nearer (:D D2) P (:Q P2))))))

(ALTS $choice "what a shape is" $Shape
  (ALT $Hue
    (INIT &hues Quotient
      (equivalent ((:a P) (:b Q))
        (input *P *Col)
        (input (:P *Q) Col)
        (NOT (&bg (:C Col)))))

    (RULE &obj
      (input *P *Col)
      (&hues.class (:a P) *Id)))
  (ALT $Region
    (INIT &regions Connectivity
      (node (P)
        (input *P *Col)
        (NOT (&bg (:C Col)))))

    (RULE &obj
      (&regions.component *P *Id)
      (input P *Col))))

;; The cells a shape closes off from the grid edge.
(INIT &closed Enclosure
  (key ((&obj ^Col ^Id))
    (cell (P)
      (input *P)
      (NOT (&obj Col Id P)))))

(INIT &enclosed Cardinality
  (key ((&closed.enclosed (:key ^Col ^Id) *P))
    (member ((:m P))
      (&closed.enclosed *P))))

(RULE &block
  (&enclosed.size (:key *Col *Id) *N)
  (&reading.rank (:t *P) *R)
  (< R N))

(RULE &block_line
  (&block *Col *Id *P)
  (&axis *A)
  (split P A (:Along *L)))

;; Shape order: by the nearest cell to order_dir.
(INIT &bbox BoundingBox
  (key ((&obj ^Col ^Id *P))
    (cell (P)
      (&obj Col Id *P))))

;; The lines the earlier shapes' blocks take: how far this block stacks.
(INIT &offset Cardinality
  (key ((OR ((&order_dir *D)
             (&bbox.box (:key (:Col *C2) (:Id *I2)) (:B *B2))
             (&bbox.box (:key (:Col ^C) (:Id ^I)) *B)
             (nearer D (:P B2) (:Q B))
             (&block_line (:Col C2) (:Id I2) *L))
            ((&obj (:Col C) (:Id I)))))
    (member ((:m (:Col C2) (:Id I2) L))
      (&order_dir *D)
      (&bbox.box (:key (:Col *C2) (:Id *I2)) (:B *B2))
      (&bbox.box (:key (:Col C) (:Id I)) *B)
      (nearer D (:P B2) (:Q B))
      (&block_line (:Col C2) (:Id I2) *L))
    (domain ()
      (&obj (:Col C) (:Id I)))))

(RULE &filled
  (&block *Col (:Id *K_id) (:P *P0))
  (&offset.size (:key (:C Col) (:I K_id)) (:N *S))
  (&stack_dir *D)
  (jump (:P P0) D (:K S) (:Q *P)))

(RULE &output
  (OR ((&filled *P *Col))
      ((&out_pos P)
       (NOT (&filled P))
       (&bg (:C Col)))))
