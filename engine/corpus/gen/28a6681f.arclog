;; 28a6681f

(INPUT vessel "Walls of every other color hold a body of water.")

(OUTPUT settle "The water settles under gravity as the first open cells of one fill order, as many as there are water cells. The water falls and slides to the cup it reaches, a cup fills by level from its bottom, and water that rises over a rim pours into the next cup, in the pour sense first."

  (DET &bg DominantColor)

  (DET &water SharedColor)

  (DET &gravity DirDomain)

  ;; The sense the water pours in. The pairs fix neither, so both stay open.
  ;; TODO no-det-plan: &pour_sense: the plan gives no verdict
  (DET &pour_sense (ONE))

  (RULE &lateral
    (&gravity (:D *D2))
    (perp_dir (:D D2) (:D2 *D)))

  (RULE &up
    (&gravity (:D *D2))
    (opposite (:D D2) (:Opp *D)))

  (RULE &pour
    (&pour_sense *S)
    (&gravity (:D *D2))
    (turn S (:D D2) (:D2 *D)))

  (RULE &wall
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&water (:C Col))))

  (RULE &open
    (input *P)
    (NOT (&wall P)))

  (RULE &parcel
    (input *P *Col)
    (&water (:C Col)))

  (RULE &row
    (input *P)
    (&gravity *D)
    (axis_of D *A)
    (split P A (:Along *Y)))

  (RULE &hangs
    (&open *P)
    (&gravity *D)
    (neighbor P D *Q)
    (&open (:P Q)))

  (INIT &run Ray
    (source (P)
      (&open *P))
    (node (P)
      (&open *P))
    (dir ((:D L))
      (&open)
      (&lateral (:D *L))))

  (RULE &drains
    (&lateral *D)
    (&run.ray (:P *Q) D (:K *N) (:Origin *P))
    (> N 0)
    (&hangs (:P Q)))

  (RULE &step
    (&pour_sense *S)
    (&open *P)
    (OR ((&hangs P)
         (&gravity *D)
         (neighbor P D *Q))
        ((NOT (&hangs P))
         (&pour S (:D *L))
         (&drains P (:D L))
         (neighbor P (:D L) Q))
        ((NOT (&hangs P))
         (&pour S (:D *L3))
         (NOT (&drains P (:D L3)))
         (opposite (:D L3) (:Opp *L2))
         (&drains P (:D L2))
         (neighbor P (:D L2) Q))))

  (RULE &rest
    (&open *P)
    (NOT (&hangs P))
    (NOT (&drains P)))

  ;; The cells whose water comes to rest at r, by the steps back from r.
  (INIT &sink Distance
    (key ((OR ((&pour_sense ^S)
               (&rest (:P ^R)))
              ((&rest (:P R))
               (&step S *P *Q))))
      (edge ((:a Q) (:b P))
        (&rest (:P R))
        (&step S *P *Q))
      (source ((:n R))
        (&pour_sense S)
        (&rest (:P R)))))

  (RULE &lands
    (&sink.distance (:key *S *R) (:n *P)))

  (RULE &lex_cell
    (&parcel (:P *P2))
    (&lands (:S *Key) (:P P2) (:R *P)))

  ;; The cell the water reaches first: the first place it rests, from
  ;; gravity's far edge, in the pour direction.
  (INIT &lex Order
    (key ((&lex_cell (:Key ^Ky) *P))
      (member ((:t P))
        (&lex_cell (:Key Ky) *P))
      (before ((:a Q) (:b P))
        (&lex_cell (:Key Ky) (:P *Q))
        (&lex_cell (:Key Ky) *P)
        (input)
        (&pour (:S Ky) (:D *L))
        (&gravity *D)
        (diag_dirs (:D *Diag) (:D1 D) (:D2 L))
        (&pour_sense (:S Ky))
        (&gravity (:D *D2))
        (axis_of (:D D2) *A)
        (OR ((corner_dir (:C Diag) A (:D *D3))
             (nearer (:D D3) (:P Q) (:Q P)))
            ((diag_dirs (:D Diag) A (:D1 D3) (:D2 *D22))
             (same_dist (:D D3) (:P1 Q) (:P2 P))
             (nearer (:D D22) (:P Q) (:Q P)))))))

  ;; The cups of each row: the components of the open cells at or below it.
  (INIT &cup Connectivity
    (key ((&row ^Y))
      (node (P)
        (&open *P)
        (&gravity *D)
        (NOT (nearer D (:P Y) (:Q P))))))

  (RULE &inner
    (&cup.component (:key (:Y *Yc)) *P (:Id *C))
    (&up (:D *U))
    (neighbor (:P Yc) (:D U) (:Q *Yp))
    (&cup.component (:key (:Y Yp)) P (:Id *Cp)))

  (RULE &mouth
    (&cup.component (:key *Y) (:P *M) (:Id *C))
    (&row (:P M) Y)
    (&up (:D *U))
    (neighbor (:P M) (:D U) (:Q *M2))
    (&open (:P M2)))

  (RULE &shadowed
    (&mouth *Y *C *M)
    (&mouth Y C (:M *M2))
    (&lateral *D)
    (nearer D (:P M2) (:Q M)))

  (RULE &away
    (&inner *Yc *C *Yp *Cp)
    (&rest (:P *R))
    (&cup.component (:key (:Y Yp)) (:P R) (:Id Cp))
    (NOT (&cup.component (:key (:Y Yc)) (:P R) (:Id C)))
    (&mouth (:Y Yc) C *M)
    (&lateral *D)
    (nearer D (:P M) (:Q R)))

  ;; Each cup the water fills, with the cell its water lands on: the inner
  ;; cup that holds the landing keeps it, and another inner cup takes the
  ;; water that pours in over its first mouth on the side of the landing.
  (INIT &descent Distance
    (key ((OR ((&lex.minimal (:key (:Ky ^S)) (:t *R))
               (&cup.component (:key *Y) (:P R) (:Id *C))
               (&up (:D *U))
               (margin (:B Y) (:D U) (:K 0)))
              ((&pour_sense S)
               (&rest (:P R))
               (&inner *Yc C *Yp *Cp)
               (&cup.component (:key (:Y Yc)) (:P R) (:Id C)))
              ((&away (:Yp *Yp3) (:Cp *Cp3) R (:Yc *Yc2) C (:D *L))
               (opposite (:D L) (:Opp *L2))
               (&mouth (:Y Yc2) C *M)
               (NOT (&shadowed (:Y Yc2) C (:D L2) M))
               (&lands S (:P M) (:R *R2)))))
      (edge ((:a (:Y Yp) (:C Cp) R) (:b (:Y Yc) C (:R R3)))
        (OR ((&away *Yp *Cp *R *Yc *C (:D *L))
             (opposite (:D L) (:Opp *L2))
             (&mouth (:Y Yc) C *M)
             (NOT (&shadowed (:Y Yc) C (:D L2) M))
             (&lands S (:P M) (:R *R3)))
            ((&pour_sense S)
             (&rest (:P R))
             (&inner Yc C Yp Cp)
             (&cup.component (:key (:Y Yc)) (:P R) (:Id C))
             (= R3 R))))
      (source ((:n Y C R))
        (&lex.minimal (:key (:Ky S)) (:t *R))
        (&cup.component (:key *Y) (:P R) (:Id *C))
        (&up (:D *U))
        (margin (:B Y) (:D U) (:K 0)))))

  (RULE &entry
    (&descent.distance (:key *S) (:n *Y *C *R)))

  (RULE &first_cup
    (OR ((&entry *S (:Y *Yp) (:C *Cp) *R)
         (&inner (:Yc *Y) (:C *C1) Yp Cp)
         (&cup.component (:key Y) (:P R) (:Id C1))
         (&inner (:Yc Y) (:C *C2) Yp Cp)
         (!= C1 C2))
        ((&entry S (:Y *Yp2) (:C *Cp2) (:R *R2))
         (&away (:Yp Yp2) (:Cp Cp2) (:R R2) (:Yc Y) (:C C1) (:D *L1))
         (&away (:Yp Yp2) (:Cp Cp2) (:R R2) (:Yc Y) (:C C2) (:D *L2))
         (OR ((&pour S (:D L1))
              (NOT (&pour S (:D L2))))
             ((= L1 L2)
              (!= C1 C2)
              (&mouth Y (:C C1) (:M *M1))
              (&mouth Y (:C C2) (:M *M2))
              (nearer (:D L1) (:P M2) (:Q M1)))))))

  (RULE &upto
    (OR ((&entry *S *Y *C)
         (&row *P Y)
         (&cup.component (:key Y) P (:Id C))
         (&cup.component (:key Y) (:P *Q) (:Id C)))
        ((&first_cup S (:Y *Y2) *C1 *C2)
         (&cup.component (:key (:Y Y2)) (:P Q) (:Id C1))
         (&cup.component (:key (:Y Y2)) P (:Id C2)))))

  (INIT &filled Cardinality
    (key ((&upto ^S ^P *Q))
      (member ((:m Q))
        (&upto S P *Q))))

  (INIT &amount Cardinality
    (member ((:m P))
      (&parcel *P))
    (domain ()
      (input))))

(RULE &settled
  (input *P (:Col *C))
  (&pour_sense *S)
  (OR ((&filled.size (:key S P) (:N *N1))
       (&amount.size *N)
       (<= N1 N)
       (&water (:C *Col)))
      ((&wall P)
       (= Col C))
      ((&upto S P *Q)
       (NOT (&upto S (:P Q) (:Q P)))
       (&filled.size (:key S (:P Q)) (:N N1))
       (&amount.size N)
       (>= N1 N)
       (&bg (:C Col)))
      ((&open P)
       (NOT (&upto S P (:Q P)))
       (&bg (:C Col)))))

(RULE &output
  (&settled *S *P *Col))
