;; 855e0971

(DET &marker RarestColor)

;; The one non-marker color of each line. A line is keyed by the axis it
;; lies across and its position along that axis.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (NOT (&marker (:C Col)))
        (axis_elem ^A)
        (split P A (:Along ^P_line)))
    (member ((:v Col))
      (input *P *Col)
      (NOT (&marker (:C Col)))
      (axis_elem A)
      (split P A (:Along P_line)))))

(RULE &mixed
  (&line_color.plural (:key *A)))

(RULE &stack_axis
  (axis_elem *A)
  (NOT (&mixed A)))

(RULE &band_of
  (input *P)
  (&stack_axis *A)
  (split P A (:Along *P_line))
  (&line_color.value (:key A P_line) (:v *Col)))

(RULE &cast_dir
  (&band_of (:Col *Key))
  (&stack_axis *A)
  (axis_of *D A))

;; Each marker casts along the stacking axis, keyed by its band's color;
;; cells outside that band block it.
(INIT &cast Ray
  (key ((OR ((&band_of *P ^Col)
             (input P (:Col *M))
             (&marker (:C M)))
            ((&cast_dir (:Key Col) *D))
            ((&cast_dir (:Key Col))
             (input P)
             (ALL ()
                  ((&band_of P Col))))))
    (source (P)
      (&band_of *P Col)
      (input P (:Col *M))
      (&marker (:C M)))
    (node (P)
      (&cast_dir (:Key Col))
      (input *P)
      (ALL ()
           ((&band_of P Col))))
    (dir (D)
      (&cast_dir (:Key Col) *D))))

(RULE &cast_cell
  (&band_of (:Col *Key))
  (input *P))

(RULE &cast_clear
  (&cast.ray (:key (:Col *Key)) *P *D *K (:Origin *Src))
  (&cast_cell Key P))

(RULE &output
  (input *P (:Col *C_in))
  (OR ((&cast.ray (:key (:Col *Ky)) P)
       (&cast_cell (:Key Ky) P)
       (&marker (:C *Col)))
      ((NOT (&cast_clear P))
       (= Col C_in))))
