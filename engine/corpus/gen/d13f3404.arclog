;; d13f3404

(DET &side ConstOutDim)

(INIT &frame Frame
  (extent (A N)
    (axis_elem *A)
    (&side *N)))

(DET &bg DominantColor)

(DET &sweep DiagDirDomain)

(RULE &seated
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (&frame.cell *P)
  (&sweep (:D *Diag))
  (diag_opposite (:D Diag) (:Opp *Anchor))
  (same_corner (:D Anchor) (:P1 P_in) (:P2 P)))

(INIT &rays Ray
  (source (P)
    (&seated *P))
  (node (P)
    (input *P))
  (dir (D)
    (&sweep *D)))

(RULE &rays_ray
  (&rays.ray *P *D *K (:Origin *Src))
  (&frame.cell P))

(RULE &output
  (OR ((&rays.ray *P (:Origin *Q))
       (&frame.cell P)
       (&seated (:P Q) *Col))
      ((&frame.cell P)
       (NOT (&rays_ray P))
       (&bg (:C Col)))))
