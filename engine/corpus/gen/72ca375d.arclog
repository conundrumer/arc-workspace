;; 72ca375d

(DET &bg DominantColor)

(DET &sym D4Domain)

(INIT &pieces Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(INIT &bbox BoundingBox
  (key ((&pieces.component *P ^Id))
    (cell (P)
      (&pieces.component *P Id))))

(RULE &cropped
  (&bbox.box (:key *Id) *B)
  (input (:P *P_grid) *Col)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

;; The crop's own symmetries.
(INIT &inv Agreement
  (key ((&cropped ^Id (:P_inner *P) *Col))
    (source ((:i P) (:v Col))
      (&cropped Id (:P_inner *P) *Col))
    (target ((:i P) (:v Col))
      (&cropped Id (:P_inner *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&cropped Id (:P_inner *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(RULE &chosen
  (&sym *D)
  (&cropped *Id)
  (d4_elem D)
  (NOT (&inv.mismatch (:key Id) (:m D))))

(ALTS $choice "where the symmetry test comes from — data-equivalent on this task, since the crop that &sym fixes is the one crop with a symmetry" $Stored
  (ALT $Any
    (RULE &chosen
      (&cropped *Id)
      (d4_elem *D)
      (NOT (d4_identity D))
      (NOT (&inv.mismatch (:key Id) (:m D))))))

(RULE &output
  (&chosen *Id)
  (&cropped Id (:P_inner *P) *Col))
