;; 221dfab4

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The segment's color.
(DET &marker_col RarestColor)

;; The beam's color.
(DET &beam_col AnyOutNewColor)

(RULE &marker
  (&marker_col (:C *Col))
  (input *P Col))

;; Each marker cell's distance from edge D.
(INIT &marker_dist Singleton
  (key ((dir_elem ^D))
    (member ((:v K))
      (&marker (:P *M))
      (margin (:B M) D *K))))

(RULE &step_dir
  (dir_elem *D)
  (&marker)
  (NOT (&marker_dist.plural (:key D))))

(RULE &corridor
  (input *P)
  (&step_dir *D)
  (axis_of D *A)
  (&marker (:P *M))
  (same_line A P (:Q M)))

(RULE &marker_line
  (input *P)
  (&step_dir *D)
  (&marker (:P *M))
  (same_dist D (:P1 P) (:P2 M)))

(INIT &ray Ray
  (source (P)
    (&marker_line *P))
  (node (P)
    (&step_dir *D)
    (input *P))
  (dir (D)
    (&step_dir *D)))

(RULE &ray_cell
  (input *P))

(RULE &offset
  (&ray.ray *P *K)
  (&ray_cell P))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(DET &role
  (&corridor *E *P)
  (&offset E P *K)
  (ex_output E P *Col))

(DET &cand
  (&role (:K *W))
  (!= W 0))

;; The colors carried at each phase of a candidate repeat. Keyed per
;; example: the cleared phases hold the example's own background.
(INIT &phase_color Singleton
  (key ((&cand ^W)
        (&role ^E (:K *T) *Col)
        (divide T (:Side W) (:Gap 0) (:Remainder ^K)))
    (member ((:v Col))
      (&cand W)
      (&role E (:K *T) *Col)
      (divide T (:Side W) (:Gap 0) (:Remainder K)))))

(DET &period_break
  (&phase_color.plural (:key *W)))

(INIT &least Order
  (member ((:t W))
    (&cand *W)
    (NOT (&period_break W)))
  (score ((:t W) (:S W))
    (&cand *W)
    (NOT (&period_break W))))

(DET &period
  (&least.minimal (:t *W)))

(RULE &phase
  (&offset *P (:K *T))
  (&period *W)
  (divide T (:Side W) (:Gap 0) (:Remainder *K)))

(DET &beam_phase
  (&period *W)
  (&phase_color.value (:key W *K) (:v *Col))
  (&beam_col (:C Col)))

(DET &copy_phase
  (&period *W)
  (&phase_color.value (:key W *K) (:v *Col))
  (&marker_col (:C Col)))

(RULE &paint
  (OR ((&corridor *P)
       (&phase P *K)
       (OR ((&copy_phase K)
            (&marker_col (:C *Col)))
           ((&beam_phase K)
            (&beam_col (:C Col)))
           ((NOT (&copy_phase K))
            (NOT (&beam_phase K))
            (&bg Col))))
      ((input P (:Col *C_in))
       (NOT (&bg (:Col C_in)))
       (&phase P (:K *K2))
       (&beam_phase (:K K2))
       (&beam_col (:C Col)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
