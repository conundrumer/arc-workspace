;; 045e512c

(DET &bg DominantColor)

(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &object
  (&objs.component (:key *Col) *P *Id))

(INIT &biggest_count Cardinality
  (key ((&object ^Id *P))
    (member ((:m P))
      (&object Id *P))))

;; The template is the largest object.
(INIT &biggest Order
  (member ((:t Id))
    (&biggest_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&biggest_count.size (:key *Id) *N)))

(RULE &shape
  (&biggest.maximal (:t *Id))
  (&object Id *P))

(RULE &span
  (input *P)
  (axis_elem *A)
  (sub_extent P A *K))

(RULE &toward
  (&span *K)
  (dir8_elem *D)
  (jump_offset D K (:V *Delta)))

;; Where each object seats on the template: the translations that carry
;; every cell of the object onto a template cell.
(INIT &seating Occurrences
  (key ((OR ((&object ^Id *P))
            ((&object Id)
             (&shape P))))
    (cell (P)
      (&object Id)
      (&shape *P))
    (shape (P)
      (&object Id *P))))

(RULE &fits
  (&seating.occurrence (:key *Id) (:P *M))
  (relative (:Base M) (:X 0) (:X_rel *Delta))
  (&toward *K Delta))

(INIT &reach Order
  (key ((&fits ^Id *Delta *K))
    (member ((:t (:V Delta) (:S K)))
      (&fits Id *Delta *K))
    (score ((:t (:V Delta) (:S K)) (:S K))
      (&fits Id *Delta *K))))

(RULE &step
  (&reach.maximal (:key *Id) (:t (:V *Delta))))

(RULE &march_cell
  (input *P))

(ALTS $choice "what fixes the step's length" $Reach
  (ALT $Stride
    (DET &stride TileCount)

    (RULE &step
      (&fits *Id *Delta *K)
      (&stride (:N K))))
  (ALT $Abut
    (DET &gap DivisorRatio)

    (INIT &sbox BoundingBox
      (cell (P)
        (&shape *P)))

    (RULE &step
      (&fits *Id *Delta)
      (&sbox.box *B)
      (&shape *P)
      (axis_elem *A)
      (perp A *A2)
      (box_extent B P A *N)
      (box_extent B P (:A A2) N)
      (&toward *D (:K N) (:Delta *S1))
      (&gap (:K *G))
      (&toward D (:K G) (:Delta *S2))
      (compose (:A S1) (:B S2) (:C Delta)))))

(RULE &march_dir
  (&step *Delta)
  (&toward *D Delta))

;; The template's cells, cast along each step's direction.
(INIT &march Ray
  (source (P)
    (&shape *P))
  (node (P)
    (&march_dir)
    (input *P))
  (dir (D)
    (&march_dir *D)))

(RULE &copy
  (&step *Id *Delta)
  (&toward *D *K Delta)
  (&march.ray *P D (:K *J))
  (&march_cell P)
  (> J 0)
  (divide (:T J) (:Side K) (:Gap 0) (:Remainder 0)))

(RULE &output
  (OR ((&copy *Id *P)
       (&object Id *Col))
      ((input P Col)
       (NOT (&copy P)))))
