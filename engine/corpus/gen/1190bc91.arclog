;; 1190bc91

(DET &bg DominantColor)

(INIT &obj Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &exposed Boundary
  (cell (P)
    (&obj.node *P)))

(RULE &seq
  (&obj.component *P *Id)
  (dir_elem *D)
  (neighbor P D (:Q *P2))
  (&obj.component (:P P2) Id)
  (&obj.component (:P *P_far) Id)
  (margin (:B P_far) D (:K 0))
  (&obj.component (:P *Anchor) Id)
  (opposite D (:Opp *D_back))
  (&exposed.exposed (:P Anchor) (:D D_back)))

;; Sequence cells indexed by their distance from the anchor.
(INIT &walk Ray
  (source (P)
    (&seq (:Anchor *P)))
  (node (P)
    (input *P))
  (dir (D)
    (&seq *D)))

(RULE &walk_cell
  (&obj.component *P *Id)
  (&seq Id))

(RULE &seq_idx
  (&walk.ray *P *K)
  (&walk_cell P))

(RULE &arm_dir
  (&seq_idx (:K *Key))
  (diag_dir_elem *D))

(INIT &arm_full Ray
  (key ((OR ((&seq_idx *P ^K))
            ((&arm_dir (:Key K) *D))
            ((&arm_dir (:Key K))
             (input P))))
    (source (P)
      (&seq_idx *P K))
    (node (P)
      (&arm_dir (:Key K))
      (input *P))
    (dir (D)
      (&arm_dir (:Key K) *D))))

(RULE &marker
  (input *P *Col)
  (&obj.component P *Id)
  (NOT (&seq Id)))

(RULE &arm_cell
  (&seq_idx (:K *Key))
  (input *P))

(INIT &arm Ray
  (key ((OR ((&seq_idx *P ^K))
            ((&arm_dir (:Key K) *D))
            ((&arm_dir (:Key K))
             (input P)
             (ALL ((&arm_full.ray (:key (:K *J)) P)
                   (&arm_cell (:Key J) P))
                  ((>= J K))))))
    (source (P)
      (&seq_idx *P K))
    (node (P)
      (&arm_dir (:Key K))
      (input *P)
      (ALL ((&arm_full.ray (:key (:K *J)) P)
            (&arm_cell (:Key J) P))
           ((>= J K))))
    (dir (D)
      (&arm_dir (:Key K) *D))))

;; Where the lit rays overlap, the nearest sequence cell wins. A ray reaches
;; its blocking cell and stops there.
(INIT &nearest Order
  (key ((OR ((&arm.ray (:key *K) ^P)
             (&arm_cell (:Key K) P))
            ((&arm.end (:key K) (:P *E) *D)
             (neighbor (:P E) D (:Q P))
             (input P))))
    (member ((:t K))
      (OR ((&arm.ray (:key *K) P)
           (&arm_cell (:Key K) P))
          ((&arm.end (:key K) (:P *E) *D)
           (neighbor (:P E) D (:Q P))
           (input P))))
    (score ((:t K) (:S K))
      (OR ((&arm.ray (:key *K) P)
           (&arm_cell (:Key K) P))
          ((&arm.end (:key K) (:P *E) *D)
           (neighbor (:P E) D (:Q P))
           (input P))))))

(RULE &paint
  (&nearest.minimal (:key *P) (:t *K)))

(RULE &cross
  (&seq (:Anchor *A))
  (&seq_idx (:P A) *K)
  (&arm_full.ray (:key K) *P)
  (&arm_cell (:Key K) P))

(INIT &area Connectivity
  (node (P)
    (input *P)
    (NOT (&cross P))))

(ALTS $choice "how the unlit cells take a marker color" $Sector
  (ALT $Flood
    (INIT &area Connectivity
      (node (P)
        (input *P)
        (NOT (&paint P))))))

(RULE &fill
  (&marker *P *Col)
  (&area.component P *Id))

(RULE &output
  (OR ((&paint *P *K)
       (&seq_idx (:P *P_seq) K)
       (input (:P P_seq) *Col))
      ((&area.component P *Id)
       (NOT (&paint P))
       (OR ((&fill Id Col))
           ((NOT (&fill Id))
            (&bg (:C Col)))))))
