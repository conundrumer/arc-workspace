;; 17b866bd

(DET &block TileCount)

(RULE &gap
  (&block (:N *K)))

(DET &line DivisorRatio)

(RULE &line2
  (&line *K))

(INIT &lattice_division Division
  (key ((axis_elem ^A))
    (side (A (:K W))
      (&line2 (:K *W)))
    (gap (A G)
      (&gap (:K *G))))
  (cell (P)
    (input *P)))

(DET &node SharedColor)

(DET &corner DiagDirDomain)

(DET &hole SharedColor)

(RULE &lattice
  (input *P)
  (&lattice_division.tile (:key *A) P))

(RULE &junction
  (&lattice *P *A)
  (perp A *A2)
  (&lattice P (:A A2)))

(RULE &node2
  (&node (:C *Col)))

(RULE &mark
  (&junction *P)
  (input P *Col)
  (NOT (&node2 Col)))

;; Blocks: connected components of off-lattice cells.
(INIT &blocks Connectivity
  (node (P)
    (input *P)
    (NOT (&lattice P))))

(RULE &label
  (&blocks.component *P *Id))

(RULE &mark_block
  (&mark *P)
  (diag_dir_elem (:D *Diag))
  (&line2 (:K *W))
  (jump P (:D Diag) (:K W) (:Q *P0))
  (&label (:P P0) *Id))

(RULE &painted
  (&mark *P *Col)
  (&corner (:D *Diag))
  (&mark_block P Diag *Id))

(RULE &fill
  (&painted *Id *Col)
  (&label *P Id)
  (input P (:Col *Hole))
  (&hole (:C Hole)))

(ALTS $choice "what the paint covers" $Holes
  (ALT $Stamp
    (INIT &bbox BoundingBox
      (key ((&label *P ^Id))
        (cell (P)
          (&label *P Id))))

    (RULE &box
      (&bbox.box (:key *Id) *B))

    (DET &repaint
      (ex_output *E *P *Col)
      (ex_input E P (:Col *Col2))
      (!= Col Col2)
      (&label E P *Id))

    (DET &stamp
      (&repaint *E (:P *P2) *Id)
      (&box E Id *B)
      (relative (:Base B) (:X P2) (:X_rel *P)))

    (RULE &fill
      (&painted *Id *Col)
      (&box Id *B)
      (&stamp (:P *P_inner))
      (compose (:A B) (:B P_inner) (:C *P)))))

(RULE &output
  (OR ((&fill *P *Col))
      ((&mark P)
       (&node (:C Col)))
      ((input P Col)
       (NOT (&mark P))
       (NOT (&fill P)))))
