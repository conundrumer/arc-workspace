;; 62ab2642

(DET &bg
  (ex_input *E *P *Col)
  (ex_output E P (:Col *Col2))
  (!= Col2 Col))

(RULE &blank
  (input *P *Col)
  (&bg Col))

(INIT &orth Connectivity
  (node (P)
    (&blank *P)))

(RULE &region
  (&orth.component *P *Id))

(INIT &region3 Connectivity
  (key ((ex_input ^E *P *Col)
        (&bg Col))
    (node (P)
      (ex_input E *P *Col)
      (&bg Col))))

(DET &region2
  (&region3.component (:key *E) *P *Id))

(INIT &size2 Cardinality
  (key ((&region2 (:E ^Ky) *P ^Id))
    (member ((:m P))
      (&region2 (:E Ky) *P Id))))

(INIT &extreme2 Order
  (key ((&size2.size (:key (:Ky ^E) *Id) *N))
    (member ((:t (:V Id) (:S N)))
      (&size2.size (:key (:Ky E) *Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&size2.size (:key (:Ky E) *Id) *N))))

(DET &biggest2
  (&extreme2.maximal (:key *E) (:t (:V *Id)))
  (&region2 E *P Id))

(DET &smallest2
  (&extreme2.minimal (:key *E) (:t (:V *Id)))
  (&region2 E *P Id))

(DET &big_paint
  (&biggest2 *E *P)
  (ex_output E P *Col))

(DET &small_paint
  (&smallest2 *E *P)
  (ex_output E P *Col))

(ALTS $choice "what joins two blank cells into one region" $Orth
  (ALT $Diag
    (INIT &diag Connectivity
      (node (P)
        (&blank *P))
      (step ((:Delta S))
        (diag_dir_elem *D)
        (step_offset D (:V *S))))

    (RULE &region
      (&diag.component *P *Id))))

(INIT &size Cardinality
  (key ((&region *P ^Id))
    (member ((:m P))
      (&region *P Id))))

(INIT &extreme Order
  (member ((:t (:V Id) (:S N)))
    (&size.size (:key *Id) *N))
  (score ((:t (:V Id) (:S N)) (:S N))
    (&size.size (:key *Id) *N)))

(RULE &biggest
  (&extreme.maximal (:t (:V *Id)))
  (&region *P Id))

(RULE &smallest
  (&extreme.minimal (:t (:V *Id)))
  (&region *P Id))

(RULE &paint
  (OR ((&biggest *P)
       (&big_paint *Col))
      ((&smallest P)
       (&small_paint Col))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
