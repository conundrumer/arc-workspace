;; a79310a0

(DET &ink ChangedColor)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(DET &shift_dir DirDomain)

(DET &shift_k DivisorRatio)

(RULE &shift_image
  (input (:P *P_in) *Col)
  (&ink (:C Col))
  (&shift_dir *D)
  (&shift_k *K)
  (jump (:P P_in) D K (:Q *P))
  (input P))

(RULE &output
  (OR ((&shift_image *P)
       (&mark (:C *Col)))
      ((input P)
       (NOT (&shift_image P))
       (&bg (:C Col)))))
