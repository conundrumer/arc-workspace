;; 2204b7a8

;; The scattered cells that take a line's color.
(DET &mark ChangedColor)

;; An edge of two colors is no line.
(INIT &line Singleton
  (key ((dir_elem ^D))
    (member ((:v Col))
      (input *P *Col)
      (margin (:B P) D (:K 0)))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&mark (:C Col_in))
       (&line.value (:key *D) (:v *Col))
       (dist_pair P D *K *K2)
       (< K K2))
      ((NOT (&mark (:C Col_in)))
       (= Col Col_in))))
