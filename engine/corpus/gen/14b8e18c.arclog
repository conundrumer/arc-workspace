;; 14b8e18c

(DET &bg DominantColor)

(DET &mark_color AnyOutNewColor)

(INIT &comps Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &cell_of
  (&comps.component *P *Id))

(INIT &bbox BoundingBox
  (key ((&cell_of ^Id *P))
    (cell (P)
      (&cell_of Id *P))))

(RULE &square
  (&bbox.box (:key *Id) *B)
  (&cell_of Id *P)
  (box_extent B P *A *N)
  (perp A *A2)
  (box_extent B P (:A A2) N))

(RULE &multi_cell
  (&cell_of *Id *P)
  (&cell_of Id (:P *Q))
  (!= P Q))

(RULE &qualify
  (&square *Id)
  (&multi_cell Id))

(RULE &corner_cell
  (&bbox.box (:key *Id) *B)
  (input *P)
  (inside (:A P) B)
  (same_corner (:D *Diag) (:P1 P) (:P2 B)))

(ALTS $choice "what makes an object square, and which corners get marks" $Square
  (ALT $Corners
    (RULE &anchor
      (&qualify *Id)
      (&corner_cell Id *Diag *P)
      (&cell_of Id P)))
  (ALT $Box
    (RULE &qualify
      (&square *Id)
      (&multi_cell Id)
      (ALL ((&bbox.box (:key Id) *B)
            (input *P)
            (inside (:A P) B)
            (same_dist (:P1 P) (:P2 B)))
           ((&cell_of Id P)))))
  (ALT $Ring
    (RULE &has_interior
      (&bbox.box (:key *Id) *B)
      (&cell_of Id *P)
      (interior (:A P) B))

    (RULE &qualify
      (&square *Id)
      (&multi_cell Id)
      (ALL ((&bbox.box (:key Id) *B)
            (input *P)
            (inside (:A P) B)
            (same_dist (:P1 P) (:P2 B)))
           ((&cell_of Id P)))
      (NOT (&has_interior Id)))))

(RULE &anchor
  (&qualify *Id)
  (&corner_cell Id *Diag *P))

(RULE &mark
  (&anchor (:Diag *Dg) (:P *P2))
  (corner_dir (:C Dg) *D)
  (neighbor (:P P2) D (:Q *P))
  (input P))

(RULE &output
  (OR ((&mark *P)
       (&mark_color (:C *Col)))
      ((input P Col)
       (NOT (&mark P)))))
