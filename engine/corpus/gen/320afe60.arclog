;; 320afe60

(DET &bg DominantColor)

;; Where the closed shapes go; the open ones go to the opposite edge.
(DET &closed_dir DirDomain)

(DET &closed_paint AnyOutNewColor)

(DET &open_paint AnyOutNewColor)

(INIT &shapes Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &shape
  (&shapes.component *P *Id))

(INIT &bbox BoundingBox
  (key ((&shape ^Id *P))
    (cell (P)
      (&shape Id *P))))

;; The grid with only this shape solid.
(INIT &off_shape Enclosure
  (key ((&shape ^Id))
    (cell (P)
      (input *P)
      (NOT (&shape Id P)))))

(RULE &gap
  (&bbox.box (:key *Id) *B)
  (input *P)
  (inside (:A P) B)
  (NOT (&shape Id P)))

(RULE &encloses
  (&off_shape.enclosed (:key *Id)))

(ALTS $choice "Two hypotheses on what stands solid while a shape is judged" $Own
  (ALT $Joint
    ;; The grid with all the ink solid.
    (INIT &off_ink Enclosure
      (cell (P)
        (input *P *Col)
        (&bg (:C Col))))

    (RULE &gap
      (&bbox.box (:key *Id) *B)
      (input *P *Col)
      (inside (:A P) B)
      (&bg (:C Col)))

    (RULE &encloses
      (&off_ink.enclosed *P)
      (dir_elem *D)
      (neighbor P D *Q)
      (&shape *Id (:P Q)))))

(RULE &open
  (&gap *Id)
  (NOT (&encloses Id)))

(RULE &dest
  (&shape *Id)
  (&closed_dir (:D *D_closed))
  (OR ((&open Id)
       (opposite (:D D_closed) (:Opp *D))
       (&open_paint (:C *Col)))
      ((NOT (&open Id))
       (= D D_closed)
       (&closed_paint (:C Col)))))

;; Each shape slides until it touches the destination edge.
(INIT &slide Distance
  (key ((&shape ^Id *P)
        (&dest Id *D)
        (margin (:B P) D *K))
    (source_distance (K)
      (&shape Id *P)
      (&dest Id *D)
      (margin (:B P) D *K))))

(RULE &slide_dir
  (&dest (:Id *Key) *D))

(RULE &paint
  (&shape *Id (:P *P2))
  (&dest Id *Col)
  (&slide.distance (:key Id) *K)
  (&slide_dir (:Key Id) *D)
  (jump_offset D K *V)
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&paint P)))))
