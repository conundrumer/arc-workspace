;; 13713586

(DET &bg DominantColor)

(DET &wall SharedColor)

(RULE &wall_dir
  (dir_elem *D)
  (ALL ((input *P *Col)
        (margin (:B P) D (:K 0)))
       ((&wall (:C Col)))))

(INIT &bars Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col)))
        (NOT (&wall (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))
      (NOT (&wall (:C Col))))))

(RULE &bar_cell
  (&bars.component (:key *Col) *P *Id))

(INIT &bar_box BoundingBox
  (key ((&bar_cell ^Col ^Id *P))
    (cell (P)
      (&bar_cell Col Id *P))))

(RULE &shadow_dir
  (&bar_cell *Col *Id)
  (&wall_dir *D))

(INIT &shadow Ray
  (key ((OR ((&bar_cell ^Col ^Id *P))
            ((&shadow_dir Col Id *D))
            ((&shadow_dir Col Id)
             (input P))))
    (source (P)
      (&bar_cell Col Id *P))
    (node (P)
      (&shadow_dir Col Id)
      (input *P))
    (dir (D)
      (&shadow_dir Col Id *D))))

(RULE &shadow_cell
  (&bar_cell *Col *Id)
  (input *P (:Col *Col2))
  (&bg (:C Col2)))

(INIT &paint Order
  (key ((&shadow.ray (:key *Col *Id) ^P)
        (&shadow_cell Col Id P)
        (&bar_box.box (:key Col Id) (:B *B_bar))
        (&wall_dir *D)
        (margin (:B B_bar) D *K))
    (member ((:t (:V Col) (:S K)))
      (&shadow.ray (:key *Col *Id) P)
      (&shadow_cell Col Id P)
      (&bar_box.box (:key Col Id) (:B *B_bar))
      (&wall_dir *D)
      (margin (:B B_bar) D *K))
    (score ((:t (:V Col) (:S K)) (:S K))
      (&shadow.ray (:key *Col *Id) P)
      (&shadow_cell Col Id P)
      (&bar_box.box (:key Col Id) (:B *B_bar))
      (&wall_dir *D)
      (margin (:B B_bar) D *K))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&paint.minimal (:key P))))
      ((&paint.minimal (:key P) (:t (:V Col))))))
