;; a59b95c0

(INIT &palette Cardinality
  (member ((:m Col))
    (input *Col)))

(INIT &arr Frame
  (extent (A N)
    (axis_elem *A)
    (&palette.size *N)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&arr.cell (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(RULE &output
  (input (:P *P_intile) *Col)
  (&output_tiling.cell (:P_inner P_intile) *P))
