;; 85fa5666

(DET &bg DominantColor)

(DET &square UnchangedColor)

(DET &turn D4Domain)

(INIT &sq Connectivity
  (node (P)
    (input *P *Col)
    (&square (:C Col))))

(INIT &bbox BoundingBox
  (key ((&sq.component *P ^Id))
    (cell (P)
      (&sq.component *P Id))))

(RULE &seat
  (&sq.component (:P *P2) *Id)
  (&bbox.box (:key Id) *B)
  (inside (:A P2) B)
  (same_corner *D (:P1 P2) (:P2 B))
  (neighbor (:P P2) D (:Q *P)))

(RULE &source
  (&turn (:D *R))
  (apply_diag_dir (:D R) (:Dir *D_from) (:Dir_out *D_to)))

;; Each seat casts outward along its own corner's diagonal: the key is the
;; cast direction.
(INIT &ray Ray
  (key ((OR ((&seat ^D (:P *Q)))
            ((diag_dir_elem D))))
    (source ((:P Q))
      (&seat D (:P *Q)))
    (node (P)
      (diag_dir_elem D)
      (input *P))
    (dir (D)
      (diag_dir_elem D))))

(RULE &ray_cell
  (input *P)
  (diag_dir_elem (:D *Key)))

(ALTS $choice "which corner a mark moves to" $Turn
  (ALT $Table
    (DET &corner_from
      (&seat *E *Id (:D *D_to) (:P *Q))
      (ex_output E (:P Q) *Col)
      (&seat E Id (:D *D_from) (:P *Q_from))
      (ex_input E (:P Q_from) Col))

    (RULE &source
      (&corner_from *D_to *D_from))))

(RULE &lit
  (&ray.ray (:key *D) *P D (:Origin *Q))
  (&ray_cell (:Key D) P)
  (&seat *Id D (:P Q))
  (&source (:D_to D) *D_from)
  (&seat Id (:D D_from) (:P *Q_from))
  (input (:P Q_from) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&lit P *Col))
      ((&square (:C Col_in))
       (= Col Col_in))
      ((NOT (&lit P))
       (NOT (&square (:C Col_in)))
       (&bg (:C Col)))))
