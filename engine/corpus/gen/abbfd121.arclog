;; abbfd121

(INPUT wallpaper "a pattern that repeats along both axes covers the whole grid; its period differs between inputs"

  (RULE &cell
    (input *P *Col))

  ;; Each color's bounding box.
  (INIT &color_box BoundingBox
    (key ((&cell *P ^Col))
      (cell (P)
        (&cell *P Col))))

  (RULE &color_fill
    (&color_box.box (:key *Col) *B)
    (ALL ((&color_box.box (:key Col) (:B *Bm))
          (&cell *P (:Col *C))
          (inside (:A P) (:B Bm)))
         ((= C Col))))

  (DET &occluder2
    (&color_fill *E *B))

  (DET &block_cell2
    (&occluder2 *E *B)
    (&cell E *P)
    (inside (:A P) B))

  (DET &hidden2
    (&block_cell2 *E *P))

  (DET &visible2
    (&cell *E *P *Col)
    (NOT (&hidden2 E P)))

  ;; The per-axis shortest periods of the visible cells.
  (INIT &period2 Periods
    (key ((&visible2 ^E *P *Col))
      (cell (P (:v Col))
        (&visible2 E *P *Col)))))

(INPUT occluders "two or more solid axis-aligned rectangles cover parts of the wallpaper, each in its own color that the wallpaper does not use; they do not touch or overlap; an occluder is a color whose cells fill their bounding box"

  (INIT &part Connectivity
    (key ((input *P ^Col))
      (node (P)
        (input *P Col))))

  (INIT &part_box BoundingBox
    (key ((&part.component *P ^Id))
      (cell (P)
        (&part.component *P Id)))))

(INPUT unique-largest "exactly one occluder has the largest area"

  (RULE &occluder
    (&color_fill *B))

  (RULE &block_cell
    (&occluder *B)
    (&cell *P)
    (inside (:A P) B))

  (INIT &area2 Cardinality
    (key ((&block_cell2 (:E ^Ky) ^B *P))
      (member ((:m P))
        (&block_cell2 (:E Ky) B *P))))

  (DET &above2
    (axis_elem (:A *X))
    (&area2.size (:key (:Ky *E) (:B *A)) (:N *N1))
    (&area2.size (:key (:Ky E) *B) (:N *N2))
    (< N1 N2))

  (DET &beaten2
    (&above2 (:E *Ky) (:X *Axis) *A *B))

  (INIT &area Cardinality
    (key ((&block_cell ^B *P))
      (member ((:m P))
        (&block_cell B *P))))

  (RULE &above
    (axis_elem (:A *X))
    (&area.size (:key (:B *A)) (:N *N1))
    (&area.size (:key *B) (:N *N2))
    (< N1 N2))

  (RULE &beaten
    (&above (:X *K) *A *B))

  (DET &top2
    (&occluder2 (:E *Ky) *B)
    (axis_elem (:A *Axis))
    (NOT (&beaten2 Ky Axis (:A B))))

  (RULE &top
    (&occluder *B)
    (axis_elem (:A *K))
    (NOT (&beaten K (:A B))))

  (INIT &sole Singleton
    (key ((&top (:K ^Axis) *B))
      (member ((:v B))
        (&top (:K Axis) *B))))

  (INIT &sole2 Singleton
    (key ((&top2 ^Ky ^Axis *B))
      (member ((:v B))
        (&top2 Ky Axis *B)))))

(OUTPUT select "the selected occluder is the one with the largest area"

  (DET &extent2
    (&block_cell2 *E *B *P)
    (box_extent B P *A *N))

  (RULE &extent
    (&block_cell *B *P)
    (box_extent B P *A *N))

  ;; The rows and columns a box spans.
  (INIT &span Cardinality
    (key ((&block_cell ^B *P)
          (axis_elem *A)
          (split P A (:Along *L)))
      (member ((:m A L))
        (&block_cell B *P)
        (axis_elem *A)
        (split P A (:Along *L)))))

  ;; The rows and columns a box spans.
  (INIT &span2 Cardinality
    (key ((&block_cell2 (:E ^Ky) ^B *P)
          (axis_elem *A)
          (split P A (:Along *L)))
      (member ((:m A L))
        (&block_cell2 (:E Ky) B *P)
        (axis_elem *A)
        (split P A (:Along *L)))))

  (INIT &sides Order
    (key ((&extent ^B *N))
      (member ((:t N))
        (&extent B *N))
      (score ((:t N) (:S N))
        (&extent B *N))))

  (INIT &sides2 Order
    (key ((&extent2 (:E ^Ky) ^B *N))
      (member ((:t N))
        (&extent2 (:E Ky) B *N))
      (score ((:t N) (:S N))
        (&extent2 (:E Ky) B *N)))))

(OUTPUT frame "the output has the height and width of the selected occluder")

(OUTPUT recover "each output cell is the wallpaper as drawn at the matching input cell under the selected occluder, before the occluders were placed"
  (APPROXIMATED "each output cell takes the color of the visible cells of its phase under the per-axis shortest periods that no two visible cells contradict; undefined where the phase has no visible cell")

  (RULE &hidden
    (&block_cell *P))

  (RULE &visible
    (&cell *P *Col)
    (NOT (&hidden P)))

  ;; The per-axis shortest periods of the visible cells.
  (INIT &period Periods
    (cell (P (:v Col))
      (&visible *P *Col)))

  (RULE &phase
    (&cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K *T))
    (axis_of D *A)
    (OR ((&period.fundamental_period A (:K *N))
         (divide T (:Side N) (:Gap 0) (:Remainder *K)))
        ((NOT (&period.fundamental_period A))
         (= K T))))

  (RULE &axis_color
    (OR ((&visible *P *Col))
        ((&hidden P)
         (diag_dirs *D1 *D2)
         (&phase P (:D D1) (:K *K1))
         (&phase P (:D D2) (:K *K2))
         (&phase (:P *P2) (:D D1) (:K K1))
         (&phase (:P P2) (:D D2) (:K K2))
         (&visible (:P P2) Col))))

  (RULE &color
    (&axis_color *P *Col))

  (RULE &scan_order_cell
    (&top (:K *Key_rank_axis) *B)
    (axis_elem (:A *Key_axis))
    (&block_cell B *P)
    (inside (:A P) B)
    (same_corner (:D *Corner) (:P1 P) (:P2 B)))

  ;; Each top occluder's first cell along a scan is its corner at the scan's
  ;; corner.
  (INIT &scan_order Order
    (key ((&top (:K ^X) *B)
          (axis_elem ^A)
          (&block_cell B *P)
          (inside (:A P) B)
          (same_corner (:D ^C) (:P1 P) (:P2 B)))
      (member ((:t P))
        (&top (:K X) *B)
        (axis_elem A)
        (&block_cell B *P)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B)))
      (before ((:a P) (:b P2))
        (&top (:K X) *B)
        (axis_elem A)
        (&block_cell B *P)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B))
        (&top (:K X) (:B *B2))
        (&block_cell (:B B2) (:P *P2))
        (inside (:A P2) (:B B2))
        (same_corner (:D C) (:P1 P2) (:P2 B2))
        (&scan_order_cell (:Key_rank_axis X) (:Corner C) (:Key_axis A))
        (OR ((corner_dir C A *D)
             (nearer D P (:Q P2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 P) P2)
             (nearer (:D D2) P (:Q P2)))))))

  (DET &scan_order_cell2
    (&top2 *Ky (:Axis *Key_rank_axis) *B)
    (axis_elem (:A *Key_axis))
    (&block_cell2 (:E Ky) B *P)
    (inside (:A P) B)
    (same_corner (:D *Corner) (:P1 P) (:P2 B)))

  ;; Each top occluder's first cell along a scan is its corner at the scan's
  ;; corner.
  (INIT &scan_order2 Order
    (key ((&top2 ^Ky (:Axis ^X) *B)
          (axis_elem ^A)
          (&block_cell2 (:E Ky) B *P)
          (inside (:A P) B)
          (same_corner (:D ^C) (:P1 P) (:P2 B)))
      (member ((:t P))
        (&top2 Ky (:Axis X) *B)
        (axis_elem A)
        (&block_cell2 (:E Ky) B *P)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B)))
      (before ((:a P) (:b P2))
        (&top2 Ky (:Axis X) *B)
        (axis_elem A)
        (&block_cell2 (:E Ky) B *P)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B))
        (&top2 Ky (:Axis X) (:B *B2))
        (&block_cell2 (:E Ky) (:B B2) (:P *P2))
        (inside (:A P2) (:B B2))
        (same_corner (:D C) (:P1 P2) (:P2 B2))
        (&scan_order_cell2 Ky (:Key_rank_axis X) (:Corner C) (:Key_axis A))
        (OR ((corner_dir C A *D)
             (nearer D P (:Q P2)))
            ((diag_dirs (:D C) A (:D1 D) *D2)
             (same_dist D (:P1 P) P2)
             (nearer (:D D2) P (:Q P2)))))))

  (RULE &reads_axis
    (axis_elem (:A *X)))

  ;; The isometries of the axis-period colors, over the whole frame.
  (INIT &wp Wallpaper
    (transform (D)
      (d4_elem *D))
    (cell (P (:v Col))
      (&axis_color *P *Col))
    (grid (P)
      (&cell *P))
    (period (A K)
      (&period.fundamental_period *A *K)))

  (DET &framed
    (&extent2 *E *B *A *N)
    (perp A *A2)
    (&extent2 E B (:A A2) (:N *N2))
    (ex_output E (:P *Q))
    (axis_extents (:P Q) A (:N1 N) N2)))

(ALTS $occluder "how the occluders are found" $ColorFill
  (ALT $MinTwoCells
    (INPUT occluders "an occluder is a color whose cells fill their bounding box and number at least two"
      (RULE &occluder
        (&color_fill *Col *B)
        (input *P Col)
        (input (:P *Q) Col)
        (!= P Q))))
  (ALT $ComponentRect
    (INPUT occluders "an occluder is a 4-connected one-color component that fills its bounding box, with both sides at least &min_side"
      ;; The least side of an occluder.
      (DET &min_side TileCount)

      (RULE &occluder
        (&part_box.box (:key *Id) *B)
        (ALL ((&part_box.box (:key Id) (:B *Bm))
              (input *P)
              (inside (:A P) (:B Bm)))
             ((&part.component P Id)))
        (&min_side (:N *K))
        (ALL ((&part_box.box (:key Id) (:B *Bmm))
              (&part.component (:P *Pm) Id)
              (box_extent (:B Bmm) (:P Pm) *A *N))
             ((>= N K)))))))

(ALTS $recovery "which maps carry colors to hidden cells beside the axis periods" $AxisPeriods
  (ALT $LatticePeriod
    (OUTPUT recover "a hidden cell also takes the colors that translations carry to it; a translation counts when it carries some visible cell onto a visible cell of its color, and no visible cell onto a visible cell of another color; undefined where a cell takes two colors"
      (RULE &carried
        (&visible *P *Col)
        (&visible (:P *Q) Col)
        (!= P Q)
        (relative (:Base P) (:X Q) (:X_rel *X)))

      (RULE &clash
        (&carried *X)
        (&visible *P (:Col *C1))
        (compose (:A P) (:B X) (:C *Q))
        (&visible (:P Q) (:Col *C2))
        (!= C1 C2))

      (RULE &map_link
        (&carried *X)
        (NOT (&clash X))
        (&cell *P)
        (compose (:A P) (:B X) (:C *Q))
        (&hidden (:P Q)))

      (RULE &color
        (OR ((&axis_color *P *Col))
            ((&map_link (:P *P2) (:Q P))
             (&axis_color (:P P2) Col))))))
  (ALT $IsometryOrbit
    (OUTPUT recover "where both axes have a period, a hidden cell also takes the colors that maps and axis periods carry to it, where a map applies a D4 isometry and then a translation; a map counts when it carries some cell's axis-period color onto another cell of that color and no cell's axis-period color onto a cell with another color; undefined where a cell takes two colors"
      (RULE &aperiodic
        (&visible)
        (axis_elem *A)
        (NOT (&period.fundamental_period A)))

      (RULE &map_link
        (&wp.action *P *Q)
        (&hidden (:P Q))
        (NOT (&aperiodic)))

      (RULE &color
        (OR ((&axis_color *P *Col))
            ((&map_link (:P *P2) (:Q P))
             (&axis_color (:P P2) Col)))))))

(ALTS $orbit "what a hidden cell gets when no visible cell reaches it" $NoSource
  (ALT $HiddenFill
    (OUTPUT fill "a hidden cell that no visible cell reaches takes &fill"
      (DET &phase2
        (&cell *E *P)
        (dir_elem *D)
        (margin (:B P) D (:K *T))
        (axis_of D *A)
        (OR ((&period2.fundamental_period (:key E) A (:K *N))
             (divide T (:Side N) (:Gap 0) (:Remainder *K)))
            ((NOT (&period2.fundamental_period (:key E) A))
             (= K T))))

      (DET &axis_color2
        (OR ((&visible2 *E *P *Col))
            ((&hidden2 E P)
             (diag_dirs *D1 *D2)
             (&phase2 E P (:D D1) (:K *K1))
             (&phase2 E P (:D D2) (:K *K2))
             (&phase2 E (:P *P2) (:D D1) (:K K1))
             (&phase2 E (:P P2) (:D D2) (:K K2))
             (&visible2 E (:P P2) Col))))

      (DET &color2
        (&axis_color2 *E *P *Col))

      (DET &palette
        (OR ((ex_input *Col))
            ((ex_output Col))))

      (DET &fill_contradicted
        (&sole2.value (:key (:Ky *E)) (:v *B))
        (&block_cell2 E B *P)
        (NOT (&color2 E P))
        (inside (:A P) B)
        (relative (:Base B) (:X P) (:X_rel *P_inner))
        (ex_output E (:P P_inner) (:Col *C))
        (&palette *Col)
        (!= Col C))

      (DET_OR_RULE &fill "The pairs hold no hidden cell without a source, so every color stays open." DominantColor RarestColor
        (&palette *Col)
        (NOT (&fill_contradicted Col))))
    (RULE &shade
      (OR ((&cell *P)
           (NOT (&color P))
           (&fill *Col))
          ((&color P Col))))))

(ALTS $selection "which occluder gives the output" $Area
  (ALT $Perimeter
    (OUTPUT select "the selected occluder has the largest height plus width"
      (DET &above2
        (axis_elem (:A *X))
        (&span2.size (:key (:Ky *E) (:B *A)) (:N *N1))
        (&span2.size (:key (:Ky E) *B) (:N *N2))
        (< N1 N2))

      (RULE &above
        (axis_elem (:A *X))
        (&span.size (:key (:B *A)) (:N *N1))
        (&span.size (:key *B) (:N *N2))
        (< N1 N2))))
  (ALT $AxisThenCross
    (OUTPUT select "the selected occluder has the greatest extent along &primary_axis, then the greatest extent across it"
      (DET &above2
        (perp (:A *X) (:A2 *Y))
        (&extent2 *E (:B *A) (:A X) (:N *N1))
        (&extent2 E *B (:A X) (:N *N2))
        (&extent2 E (:B A) (:A Y) (:N *M1))
        (&extent2 E B (:A Y) (:N *M2))
        (OR ((< N1 N2))
            ((= N1 N2)
             (< M1 M2))))

      (RULE &above
        (perp (:A *X) (:A2 *Y))
        (&extent (:B *A) (:A X) (:N *N1))
        (&extent *B (:A X) (:N *N2))
        (&extent (:B A) (:A Y) (:N *M1))
        (&extent B (:A Y) (:N *M2))
        (OR ((< N1 N2))
            ((= N1 N2)
             (< M1 M2))))

      (DET &axis_fits
        (&sole2.value (:key (:Ky *E) (:Axis *X)) (:v *B))
        (&framed E B))

      (DET &axis_missed
        (&axis_fits *X)
        (ex_output *E)
        (NOT (&axis_fits E X)))

      (DET &primary_axis
        (&axis_fits (:X *A))
        (NOT (&axis_missed (:X A)))
        (ONE))

      (RULE &reads_axis
        (&primary_axis (:A *X)))))
  (ALT $LongestThenShortest
    (OUTPUT select "the selected occluder has the longest side, then the longest short side"
      (DET &above2
        (axis_elem (:A *X))
        (&sides2.maximal (:key (:Ky *E) (:B *A)) (:t *N1))
        (&sides2.maximal (:key (:Ky E) *B) (:t *N2))
        (&sides2.minimal (:key (:Ky E) (:B A)) (:t *M1))
        (&sides2.minimal (:key (:Ky E) B) (:t *M2))
        (OR ((< N1 N2))
            ((= N1 N2)
             (< M1 M2))))

      (RULE &above
        (axis_elem (:A *X))
        (&sides.maximal (:key (:B *A)) (:t *N1))
        (&sides.maximal (:key *B) (:t *N2))
        (&sides.minimal (:key (:B A)) (:t *M1))
        (&sides.minimal (:key B) (:t *M2))
        (OR ((< N1 N2))
            ((= N1 N2)
             (< M1 M2)))))))

(ALTS $tie "what happens when occluders tie at the top of the selection's order" $UniqueTop
  (ALT $TieFirst
    (OUTPUT tie-first "among the tied occluders, the one whose corner at the corner of &scan comes first along that scan order wins"
      (DET &first_pick2
        (&scan_order2.minimal (:key *Ky (:X *Axis) *C *A) (:t *P))
        (&top2 Ky Axis *B)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B)))

      (RULE &first_pick
        (&scan_order.minimal (:key (:X *K) *C *A) (:t *P))
        (&top K *B)
        (inside (:A P) B)
        (same_corner (:D C) (:P1 P) (:P2 B)))

      (DET &scan_fits
        (&first_pick2 (:Ky *E) *C *A *B)
        (&framed E B))

      (DET &scan_missed
        (&scan_fits *C *A)
        (&first_pick2 (:Ky *E) C A)
        (ex_output E)
        (NOT (&scan_fits E C A)))

      (DET &scan
        (&scan_fits *C *A)
        (NOT (&scan_missed C A))
        (ONE)))
    (RULE &pick
      (&reads_axis *X)
      (&scan *C *A)
      (&first_pick (:K X) C A *B))))

(RULE &pick
  (&reads_axis *X)
  (&sole.value (:key (:Axis X)) (:v *B)))

(RULE &unpicked
  (&reads_axis *X)
  (NOT (&pick X)))

(RULE &shade
  (&color *P *Col))

(RULE &broken
  (OR ((&unpicked))
      ((&pick *B)
       (&block_cell B *P)
       (NOT (&shade P)))))

(RULE &output
  (&pick *B)
  (NOT (&broken))
  (&shade (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))
