;; 825aa9e9

(DET &bg SharedColor)

(DET &fall DirDomain)

;; The clearance a shape keeps beneath itself.
(DET &gap DivisorRatio)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &floor_color
  (&ink *P *Col)
  (&fall *D)
  (margin (:B P) D (:K 0)))

(INIT &body Connectivity
  (node (P)
    (&ink *P *Col)
    (NOT (&floor_color Col))))

(RULE &fall_dir
  (&fall *D))

(ALTS $choice "how the floor is told apart from the falling shapes" $FloorColor
  (ALT $Grounded
    (INIT &body Connectivity
      (node (P)
        (&ink *P)))

    (RULE &standing
      (&body.component *P *Id)
      (&fall *D)
      (margin (:B P) D (:K 0)))

    (RULE &mover
      (&body.component *Id)
      (NOT (&standing Id)))))

(RULE &mover
  (&body.component *Id))

(RULE &mover_cell
  (&mover *Id)
  (&body.component *P Id))

(RULE &foot
  (OR ((&mover_cell *Id *P))
      ((&mover_cell Id (:P *P2))
       (&fall *D)
       (&gap *K)
       (jump (:P P2) D K (:Q P)))))

;; Each body falls with its clearance until that clearance meets what lies
;; beneath.
(INIT &fall2 Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&foot *Id *P)
    (&fall_dir *D)
    (&foot (:Id *Id2) (:P *P2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&foot *Id *P)
         (&fall_dir *D)
         (margin (:B P) D *K))
        ((&foot Id (:P *P3))
         (&fall_dir (:D *D2))
         (&ink (:P *P2))
         (NOT (&mover_cell (:P P2)))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &landed
  (&fall2.distance (:n *Id) *K)
  (&fall_dir *D)
  (jump_offset D K (:V *Delta))
  (&mover_cell Id (:P *P3))
  (input (:P P3) *Col)
  (compose (:A P3) (:B Delta) (:C *P)))

(RULE &vacated
  (&fall2.distance (:n *Id) *K)
  (&fall_dir *D)
  (jump_offset D K)
  (&mover_cell Id *P))

(RULE &output
  (OR ((&landed *P *Col))
      ((input P (:Col *C_in))
       (NOT (&landed P))
       (IF ((&vacated P))
           ((&bg (:C Col)))
           ((= Col C_in))))))
