;; 6e02f1e3

(INIT &palette Cardinality
  (member ((:m Col))
    (input *Col)))

(RULE &ncolors
  (&palette.size *N))

(DET &lookup_grid
  (&ncolors *E *N)
  (ex_output E *P *Col))

(ALTS $choice "the render: table or rule" $Lookup
  (ALT $Figure
    (DET &fig_edge NumberDirDomain)

    (DET &mark AnyOutNewColor)

    (DET &bg AnyOutNewColor)

    (RULE &canvas
      (input *P))

    (DET &mark_cell
      (ex_output *E *P *Col)
      (&mark (:C Col)))

    (DET &mismatch
      (OR ((diag_dir_elem (:D *Dg))
           (&mark_cell *E *P)
           (diag_dist P (:Diag Dg) *K1 *K2)
           (!= K1 K2))
          ((diag_dir_elem (:D Dg))
           (ex_output E (:P *P2))
           (diag_dist (:P P2) (:Diag Dg) (:K1 *K) (:K2 K))
           (NOT (&mark_cell E (:P P2))))))

    (DET &fig_diag
      (&ncolors *E *N)
      (ex_output E)
      (diag_dir_elem (:D *Dg))
      (NOT (&mismatch E Dg))
      (diag_axis_of (:D Dg) *Da))

    (RULE &figure_cell
      (&canvas *P)
      (&ncolors *N)
      (OR ((&fig_edge N *D)
           (margin (:B P) D (:K 0)))
          ((&fig_diag N (:Da *DA))
           (diag_axis_of (:D *Dg) (:Da DA))
           (diag_dist P (:Diag Dg) (:K1 *K) (:K2 K)))))

    (RULE &output
      (OR ((&figure_cell *P)
           (&mark (:C *Col)))
          ((&canvas P)
           (NOT (&figure_cell P))
           (&bg (:C Col)))))
    (ALTS $canvas "the frame the figure is drawn in" $Input
      (ALT $Fixed
        (DET &out_pos Frame)
        (RULE &canvas
          (&out_pos *P))))))

(RULE &output
  (&ncolors *N)
  (&lookup_grid N *P *Col))
