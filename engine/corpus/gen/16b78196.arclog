;; 16b78196

(DET &bg DominantColor)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &obj_cell
  (&objs.component *P (:Id *O)))

(RULE &obj_color
  (&obj_cell *O *P)
  (input P *Col))

(INIT &bbox BoundingBox
  (key ((&obj_cell ^O *P))
    (cell (P)
      (&obj_cell O *P))))

(RULE &bar
  (&bbox.box (:key *O) (:B *B_obj))
  (dist_pair (:P B_obj) *D (:K 0) (:K2 0))
  (axis_of D *A))

(RULE &stack_dir
  (&bar *A)
  (perp A *A2)
  (axis_of *D (:A A2)))

(INIT &front Order
  (key ((&obj_cell ^O *P)
        (&stack_dir ^D)
        (axis_of D (:A *A_stack))
        (split P (:A A_stack) (:Across ^L))
        (margin (:B P) D *K))
    (member ((:t (:V P) (:S K)))
      (&obj_cell O *P)
      (&stack_dir D)
      (axis_of D (:A *A_stack))
      (split P (:A A_stack) (:Across L))
      (margin (:B P) D *K))
    (score ((:t (:V P) (:S K)) (:S K))
      (&obj_cell O *P)
      (&stack_dir D)
      (axis_of D (:A *A_stack))
      (split P (:A A_stack) (:Across L))
      (margin (:B P) D *K))))

(RULE &face
  (&front.minimal (:key *O *D) (:t (:V *P))))

(RULE &seat_offset
  (opposite *D (:Opp *Dn))
  (&face *O (:D Dn) (:P *N))
  (NOT (&bar O))
  (&face (:O *Host) D *P)
  (!= O Host)
  (neighbor P D *Q)
  (relative (:Base N) (:X Q) (:X_rel *R)))

(RULE &rest
  (OR ((&seat_offset *Host *O *D *R))
      ((&seat_offset Host O D (:R *R3))
       (perp_dir D (:D2 *D_slide))
       (neighbor (:P R3) (:D D_slide) (:Q R)))))

(RULE &gap
  (&rest *Host *O *D *R)
  (opposite D (:Opp *Dn))
  (&face O (:D Dn) (:P *N))
  (compose (:A N) (:B R) (:C *Q3))
  (neighbor (:P Q3) (:D Dn) *Q)
  (NOT (&obj_cell (:O Host) (:P Q))))

(RULE &catch
  (&gap *Host *O *D *R (:Q *Q2))
  (axis_of D (:A *A_stack))
  (&face (:O Host) D (:P *P_f))
  (same_line (:A A_stack) (:P P_f) (:Q Q2)))

(RULE &sunk
  (&rest *Host *O *D *R)
  (&obj_cell O *P)
  (compose (:A P) (:B R) (:C *Q))
  (&obj_cell (:O Host) (:P Q)))

(RULE &seat_flush
  (&seat_offset *Host *O *D *R)
  (NOT (&gap Host O D R))
  (NOT (&sunk Host O D R)))

(RULE &loose
  (&seat_flush *Host *O *D *R)
  (perp_dir D (:D2 *D_slide))
  (neighbor (:P R) (:D D_slide) (:Q *R2))
  (NOT (&catch Host O D (:R R2)))
  (NOT (&sunk Host O D (:R R2))))

(RULE &seat
  (&seat_flush *Host *O *D *R)
  (NOT (&loose Host O D R)))

(RULE &on_grid
  (&obj_cell *O *P)
  (input (:P *Q))
  (relative (:Base P) (:X Q) (:X_rel *Delta))
  (&bbox.box (:key O) (:B *B_obj))
  (compose (:A B_obj) (:B Delta) (:C *B_placed))
  (inside (:A B_placed) (:B 0)))

(RULE &seat_step
  (&on_grid (:O *H) (:Delta *D_host))
  (&seat (:Host H) *O *R)
  (compose (:A D_host) (:B R) (:C *Delta))
  (&on_grid O Delta))

;; The bar stays where it is; a piece reaches wherever it can seat on
;; something already placed, so long as it lands on the grid.
(INIT &reach Propagation
  (source ((:n (:O B) Delta))
    (&bar (:O *B))
    (= *Delta 0))
  (edge ((:a (:O H) (:Delta D_host)) (:b O Delta))
    (&seat_step *H *D_host *O *Delta)))

(RULE &placement
  (&reach.reached (:n *O *Delta)))

(RULE &place_cell
  (&placement *O *Delta)
  (&obj_cell O (:P *P2))
  (compose (:A P2) (:B Delta) (:C *P)))

;; The reach regrown with each placement held.
(INIT &beside Propagation
  (key ((&placement (:O ^O_h) (:Delta ^D_h)))
    (edge ((:a (:O H) (:Delta D_host)) (:b O Delta))
      (&seat_step *H *D_host *O *Delta)
      (&placement (:O H) (:Delta D_host))
      (&bar (:O *B))
      (ALL ((&place_cell O Delta (:P *Q))
            (&place_cell (:O B) (:Delta *D2) (:P Q)))
           ((= O B)))
      (ALL ((&place_cell O Delta (:P *Qm))
            (&place_cell (:O O_h) (:Delta D_h) (:P Qm)))
           ((= O O_h)))
      (OR ((!= O O_h))
          ((= Delta D_h)))))
  (source ((:n (:O B) Delta))
    (&bar (:O *B))
    (= *Delta 0)))

(RULE &kept
  (&beside.reached (:key *O_h *D_h) (:n *O)))

(RULE &filled
  (&place_cell *O *Delta *P)
  (ALL ((&obj_cell (:O *O2)))
       ((&kept (:O_h O) (:D_h Delta) (:O O2))))
  (&obj_color O *Col))

(RULE &output
  (OR ((&filled *P *Col))
      ((input P)
       (NOT (&filled P))
       (&bg (:C Col)))))
