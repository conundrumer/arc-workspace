;; 73ccf9c2

(DET &bg DominantColor)

(DET &sym D4Domain)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &object
  (&objs.component *P *Id))

(INIT &bbox BoundingBox
  (key ((&object ^Id *P))
    (cell (P)
      (&object Id *P))))

(RULE &figure
  (&object *Id *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (input P *Col))

(INIT &inv Agreement
  (key ((&figure ^Id (:P_inner *P) *Col))
    (source ((:i P) (:v Col))
      (&figure Id (:P_inner *P) *Col))
    (target ((:i P) (:v Col))
      (&figure Id (:P_inner *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&figure Id (:P_inner *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(RULE &output
  (&sym (:D *F))
  (&inv.mismatch (:key *Id) (:m F))
  (&bbox.box (:key Id) *B)
  (input (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))
