;; e3497940

(DET &frame Frame)

(DET &base DirDomain)

(DET &bg DominantColor)

(DET &tile_decompose Division)

(DET &divide_gap DivisorRatio)

(RULE &decompose
  (&tile_decompose *P *P_outer *P_inner))

(ALTS $choice "out's choice column (decompose)" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&base *D)
        (axis_of D *A)
        (&divisor *N))
      (gap (A G)
        (&base *D)
        (axis_of D *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (DET &frame_dim ConstOutDimAxis)

    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&base *D)
        (axis_of D *A)
        (&frame_dim A (:N *K)))
      (gap (A G)
        (&base *D)
        (axis_of D *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(RULE &ink
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&decompose (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile))
  (&base *D)
  (OR ((opposite D (:Opp *O))
       (margin (:B P_tile) (:D O) (:K 0))
       (axis_of D *A)
       (axis_inversion A (:T *F))
       (apply (:D F) (:P P_intile) (:P_out *P)))
      ((margin (:B P_tile) D (:K 0))
       (= P P_intile))))

(RULE &output
  (OR ((&ink *P *Col))
      ((&frame P)
       (&bg (:C Col))
       (NOT (&ink P)))))
