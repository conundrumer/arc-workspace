;; 32e9702f

(DET &dir DirDomain)

(DET &bg ChangedColor)

(DET &fill AnyOutNewColor)

(RULE &moved
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (&dir *D)
  (neighbor (:P P2) D (:Q *P))
  (input P))

(RULE &output
  (OR ((&moved *P *Col))
      ((input P)
       (NOT (&moved P))
       (&fill (:C Col)))))
