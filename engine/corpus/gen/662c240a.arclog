;; 662c240a

(DET &tile_axis AxisDomain)

(DET &tile_count ConstOutDim)

(INIT &tile_val_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (&tile_axis *A)
    (&tile_count *N)))

(DET &sym D4Domain)

(RULE &tile_val
  (input (:P *P_grid) *Col)
  (&tile_val_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $d "find the tiles" $Count
  (ALT $Size
    (DET &tile_size ConstOutDim)

    (INIT &tile_val_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&tile_axis *A)
        (&tile_size (:N *K))))

    (RULE &tile_val
      (input (:P *P_grid) *Col)
      (&tile_val_division2.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $s "which tile is the odd one" $Shared
  (ALT $Asym
    (RULE &inv_src
      (&tile_val (:P_tile *Key) (:P_intile *P) (:Col *V)))

    (RULE &inv_has_sym
      (&inv_src *Key)
      (d4_elem *D)
      (NOT (d4_identity D))
      (NOT (&inv.mismatch (:key (:T Key)) (:m D))))

    (RULE &output
      (&tile_val (:P_tile *T) (:P_intile *P) *Col)
      (NOT (&inv_has_sym (:Key T))))))

(INIT &inv Agreement
  (key ((&tile_val (:P_tile ^T) (:P_intile *P) *Col))
    (source ((:i P) (:v Col))
      (&tile_val (:P_tile T) (:P_intile *P) *Col))
    (target ((:i P) (:v Col))
      (&tile_val (:P_tile T) (:P_intile *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&tile_val (:P_tile T) (:P_intile *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(RULE &output
  (&tile_val (:P_tile *T) (:P_intile *P) *Col)
  (&sym (:D *F))
  (&inv.mismatch (:key T) (:m F)))
