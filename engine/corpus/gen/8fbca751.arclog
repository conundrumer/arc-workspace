;; 8fbca751

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A group is what line sharing connects.
(INIT &group Quotient
  (edge ((:a P) (:b Q))
    (&ink *P)
    (&ink (:P *Q))
    (axis_elem *A)
    (same_line A P Q)))

(INIT &group_box BoundingBox
  (key ((&group.class (:a *P) ^Id))
    (cell (P)
      (&group.class (:a *P) Id))))

(RULE &filled
  (input *P *Col)
  (&bg (:C Col))
  (&group_box.box *B)
  (inside (:A P) B))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&filled P))
      ((&fill (:C *Col)))
      ((= Col Col_in))))
