;; 6455b5f5

(DET &bg DominantColor)

(DET &most AnyOutNewColor)

(DET &fewest AnyOutNewColor)

(INIT &region Connectivity
  (node (P)
    (input *P *Col)
    (&bg (:C Col))))

(INIT &area Cardinality
  (key ((&region.component *P ^Id))
    (member ((:m P))
      (&region.component *P Id))))

(INIT &extreme Order
  (member ((:t (:V Id) (:S N)))
    (&area.size (:key *Id) *N))
  (score ((:t (:V Id) (:S N)) (:S N))
    (&area.size (:key *Id) *N)))

(RULE &paint
  (&region.component *P *Id)
  (OR ((&extreme.maximal (:t (:V Id)))
       (&most (:C *Col)))
      ((&extreme.minimal (:t (:V Id)))
       (&fewest (:C Col)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
