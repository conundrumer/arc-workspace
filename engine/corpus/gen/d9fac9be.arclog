;; d9fac9be

(DET &bg DominantColor)

(DET &out_pos Frame)

(DET &dim TileCount)

(RULE &ink
  (input (:Col *C))
  (NOT (&bg C)))

(INIT &box Frame
  (extent (A (:N K))
    (axis_elem *A)
    (&dim (:N *K))))

(INIT &outline Boundary
  (cell (P)
    (&box.cell *P)))

(INIT &occ Occurrences
  (key ((&ink (:C ^Col)))
    (cell (P)
      (input *P Col)))
  (shape ((:P S))
    (&outline.boundary (:P *S))))

(ALTS $choice "how the boxed cell is identified (data-equivalent on this task)" $Box
  (ALT $Ring
    (RULE &output
      (input (:P *P_grid_in) *Col)
      (&ink (:C *A))
      (!= A Col)
      (ALL ((dir8_elem *D)
            (neighbor (:P P_grid_in) D (:Q *P2)))
           ((input (:P P2) (:Col A))))
      (&out_pos *P)))
  (ALT $Full
    (RULE &inked
      (input *P *Col)
      (NOT (&bg (:C Col))))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (ALL ((dir8_elem *D)
            (neighbor (:P P_grid_in) D (:Q *P2)))
           ((&inked (:P P2))))
      (&out_pos *P))))

(RULE &output
  (&occ.occurrence (:key (:Col *Col2)) (:P *M))
  (&box.cell (:P *P_ctr))
  (centered (:P P_ctr))
  (compose (:A M) (:B P_ctr) (:C *P_grid_in))
  (input (:P P_grid_in) *Col)
  (!= Col Col2)
  (&out_pos *P))
