;; 16de56c4

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (axis_elem *A)
  (split P A *Across))

(RULE &seed
  (&mark *A *Across (:P *P1) *Col)
  (&mark A Across (:P *P2) Col)
  (!= P1 P2)
  (ALL ((&mark A Across (:P *P1m) Col)
        (&mark A Across (:P *P2m) Col)
        (&mark A Across (:P *P3) Col)
        (!= P1m P2m)
        (!= P1m P3))
       ((= P2m P3))))

(RULE &rhythm
  (&seed *A *Across *Col *P1 *P2)
  (ALL ((&seed A Across (:Col *Colm))
        (&mark A Across (:P *P1m) (:Col *Col1))
        (!= Col1 Colm)
        (&mark A Across (:P *P2m) (:Col *Col2))
        (!= Col2 Colm))
       ((= P1m P2m))))

(RULE &lattice
  (&rhythm *A *Across *P1 *P2)
  (relative (:Base P1) (:X P2) (:X_rel *V))
  (axis_of *D A)
  (margin (:B V) D *K)
  (> K 0)
  (input *P)
  (split P A Across)
  (margin (:B P1) D (:K *T1))
  (divide (:T T1) (:Side K) (:Gap 0) (:Remainder *Phase))
  (margin (:B P) D (:K *Tq))
  (divide (:T Tq) (:Side K) (:Gap 0) (:Remainder Phase)))

(RULE &intruder
  (&rhythm *A *Across (:Col *Col3))
  (&lattice A Across *P)
  (&mark A Across P *Col)
  (!= Col Col3))

(RULE &cast_blocked
  (&intruder *A *Across (:Col *Col2))
  (&mark A Across *P (:Col Col2))
  (&lattice A Across P))

;; The rhythm advancing from the seed both ways, through the intruder's cell
;; and no further.
(INIT &cast Ray
  (key ((OR ((&rhythm ^A ^Across (:P1 *P)))
            ((&rhythm A Across)
             (axis_of *D A))))
    (source (P)
      (&rhythm A Across (:P1 *P)))
    (node (P)
      (&rhythm A Across)
      (axis_of *D A)
      (input *P)
      (NOT (&cast_blocked A Across P)))
    (dir (D)
      (&rhythm A Across)
      (axis_of *D A))))

(RULE &fill
  (OR ((&cast.ray (:key *A *Across) *P)
       (&lattice A Across P))
      ((&cast.end (:key A Across) (:P *E) *D)
       (neighbor (:P E) D (:Q P))
       (input P))))

(ALTS $choice "how far the intruder's paint reaches" $Cast
  (ALT $Span
    (RULE &span_axis
      (&lattice *A *Across))

    (INIT &span Ray
      (key ((OR ((&mark ^A ^Across *P))
                ((&span_axis A Across)
                 (axis4_of *D A))
                ((&span_axis A Across)
                 (input P))))
        (source (P)
          (&mark A Across *P))
        (node (P)
          (&span_axis A Across)
          (input *P))
        (dir (D)
          (&span_axis A Across)
          (axis4_of *D A))))

    (RULE &span_between
      (&lattice *A *Across *P)
      (&span_axis A Across)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&span.ray (:key A Across) P D)
      (&span.ray (:key A Across) P (:D O)))

    (RULE &fill
      (&lattice *A *Across *P)
      (OR ((NOT (&intruder A Across)))
          ((&intruder A Across)
           (&span_between A Across P))))))

(RULE &paint
  (&fill (:A *Ln_a) (:Across *Ln_across) *P)
  (OR ((&intruder (:A Ln_a) (:Across Ln_across) *Col))
      ((&rhythm (:A Ln_a) (:Across Ln_across) Col)
       (NOT (&intruder (:A Ln_a) (:Across Ln_across)))
       (input P (:Col *Bg))
       (&bg (:C Bg)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
