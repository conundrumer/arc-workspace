;; d4b1c2b1

(INIT &palette Cardinality
  (member ((:m Col))
    (input *Col)))

(INIT &block Frame
  (extent (A N)
    (axis_elem *A)
    (&palette.size *N)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&block.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&output_tiling.cell (:P_outer P_tile) *P))
