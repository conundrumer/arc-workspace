;; bd283c4a

(INPUT distinct-counts "no two colors of an input have the same cell count")

(OUTPUT same-size "the output has the input's size")

(OUTPUT count-order "the colors are ranked by their cell count in the input, the highest first; colors of equal count take either order, each order one output")

(OUTPUT raster-fill "the output cells are taken in a raster order that starts at corner &start_corner, runs along axis &fill_axis within a line, and then steps to the next line away from that corner; each color, in rank order, takes as many cells of that order as its input count, after the cells the colors before it took"

  (DET &start_corner DiagDirDomain)

  (DET &fill_axis AxisDomain)

  (RULE &step_axis
    (&fill_axis (:A *A0))
    (perp (:A A0) (:A2 *A)))

  (RULE_OR_DET &out_dim
    (input *P)
    (axis_elem *A)
    (frame_extent P A *N))

  (INIT &frame Frame
    (extent (A N)
      (&out_dim *A *N)))

  (INIT &raster Order
    (member ((:t P))
      (&frame.cell *P))
    (before ((:a P) (:b P2))
      (&frame.cell *P)
      (&frame.cell (:P *P2))
      (&start_corner *D)
      (&step_axis *A)
      (OR ((corner_dir (:C D) A (:D *D2))
           (nearer (:D D2) P (:Q P2)))
          ((diag_dirs D A (:D1 D2) (:D2 *D22))
           (same_dist (:D D2) (:P1 P) P2)
           (nearer (:D D22) P (:Q P2))))))

  (INIT &size Cardinality
    (key ((input *P (:Col ^C)))
      (member ((:m P))
        (input *P (:Col C)))))

  ;; The input in the same raster order, for the first cell of each color.
  (INIT &scan Order
    (member ((:t P))
      (input *P))
    (before ((:a P) (:b P2))
      (input *P)
      (input (:P *P2))
      (&start_corner *D)
      (&step_axis *A)
      (OR ((corner_dir (:C D) A (:D *D2))
           (nearer (:D D2) P (:Q P2)))
          ((diag_dirs D A (:D1 D2) (:D2 *D22))
           (same_dist (:D D2) (:P1 P) P2)
           (nearer (:D D22) P (:Q P2))))))

  (INIT &first Order
    (key ((input *P (:Col ^C))
          (&scan.rank (:t P) *R))
      (member ((:t R))
        (input *P (:Col C))
        (&scan.rank (:t P) *R))
      (score ((:t R) (:S R))
        (input *P (:Col C))
        (&scan.rank (:t P) *R))))

  ;; Higher count first; of equal counts, the earlier first cell.
  (INIT &ranked Order
    (member ((:t C))
      (input (:Col *C)))
    (before ((:a C1) (:b C2))
      (OR ((&size.size (:key (:C *C1)) (:N *N1))
           (&size.size (:key (:C *C2)) (:N *N2))
           (> N1 N2))
          ((&size.size (:key (:C C1)) *N)
           (&size.size (:key (:C C2)) N)
           (&first.minimal (:key (:C C1)) (:t *R1))
           (&first.minimal (:key (:C C2)) (:t *R2))
           (< R1 R2)))))

  ;; A color takes the place in `ranked` of any color of equal count, so each
  ;; order of tied colors is one resolution.
  (RULE &ties
    (&size.size (:key (:C *C2)) *N)
    (&size.size (:key *C) N)
    (ONE C2)
    (ONE C))

  (RULE &place
    (&ties *C2 *C)
    (&ranked.rank (:t C2) *R))

  ;; The cells of the colors placed before this one: where its run starts.
  (INIT &preceding Cardinality
    (key ((&place ^C))
      (member ((:m Q))
        (&place C *R)
        (&place (:C *C2) (:R *R2))
        (< R2 R)
        (input (:P *Q) (:Col C2)))
      (domain ()
        (&place C))))

  ;; Those cells and the color's own: where its run ends.
  (INIT &through Cardinality
    (key ((OR ((&preceding.member (:key ^C) (:m *Q)))
              ((&place C)
               (input (:P Q) (:Col C)))))
      (member ((:m Q))
        (OR ((&preceding.member (:m *Q)))
            ((&place C)
             (input (:P Q) (:Col C))))))))

(ALTS $choice "How colors of equal count are ordered" $EitherOrder
  (ALT $TieFirstCell
    (OUTPUT count-order "colors of equal count stand in the order their first cells come in the input's raster order"
      (RULE &place
        (&ranked.rank (:t *C) *R)))))

(RULE &output
  (&raster.rank (:t *P) (:R *K))
  (&preceding.size (:key (:C *Col)) (:N *S))
  (<= S K)
  (&through.size (:key (:C Col)) (:N *E))
  (< K E))
