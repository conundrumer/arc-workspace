;; 3d6c6e23

(DET &bg DominantColor)

(DET &gravity DirDomain)

(RULE &line_of
  (input *P)
  (&gravity *D)
  (axis_of D *A)
  (split P A (:Across *L)))

(RULE &pixel
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&line_of P *L))

(RULE &above
  (&pixel (:P *P1) *L)
  (&pixel (:P *P2) L)
  (&gravity *D)
  (nearer D (:P P2) (:Q P1)))

(RULE &cand
  (&pixel *L)
  (&line_of (:P *A) L))

(RULE &cone
  (&cand *A)
  (input *P)
  (ALL ((&gravity *D)
        (opposite D (:Opp *D_up))
        (corner_dir (:C *Diag) (:D D_up))
        (corner_dist P Diag (:K *K_q))
        (corner_dist (:P A) Diag (:K *K_a)))
       ((>= K_q K_a))))

(INIT &cone_size Cardinality
  (key ((&cone ^A *P))
    (member ((:m P))
      (&cone A *P))))

(INIT &line_size Cardinality
  (key ((&pixel *P ^L))
    (member ((:m P))
      (&pixel *P L))))

(RULE &apex
  (&cand *L *A)
  (&cone_size.size (:key A) *N)
  (&line_size.size (:key L) N))

(RULE &pile
  (&apex *L *A)
  (&cone A *P))

(INIT &lex Order
  (key ((&pile ^L *P)
        (sense_elem ^S))
    (member ((:t P))
      (&pile L *P)
      (sense_elem S))
    (before ((:a P) (:b P2))
      (&pile L *P)
      (sense_elem S)
      (&pile L (:P *P2))
      (&pile L)
      (&gravity *D)
      (opposite D (:Opp *D_up))
      (turn S (:D D_up) (:D2 *Lat))
      (diag_dirs (:D *Diag) (:D1 D_up) (:D2 Lat))
      (&gravity (:D *D2))
      (axis_of (:D D2) (:A *Ax))
      (OR ((corner_dir (:C Diag) (:A Ax) (:D *D3))
           (nearer (:D D3) P (:Q P2)))
          ((diag_dirs (:D Diag) (:A Ax) (:D1 D3) (:D2 *D22))
           (same_dist (:D D3) (:P1 P) P2)
           (nearer (:D D22) P (:Q P2)))))))

(INIT &fill Order
  (key ((OR ((&pixel *P ^L))
            ((&above L *P1 *P2))))
    (member ((:t P))
      (&pixel *P L))
    (before ((:a P1) (:b P2))
      (&above L *P1 *P2))))

(ALTS $choice "the order the pixels fill in" $Fall
  (ALT $Sink
    (INIT &group Cardinality
      (key ((&pixel *P ^L ^Col))
        (member ((:m P))
          (&pixel *P L Col))))

    (INIT &fill Order
      (key ((OR ((&pixel *P ^L))
                ((&pixel (:P *P1) L (:Col *C1))
                 (&pixel (:P *P2) L (:Col *C2))
                 (OR ((&group.size (:key L (:Col C1)) (:N *N1))
                      (&group.size (:key L (:Col C2)) (:N *N2))
                      (< N1 N2))
                     ((= C1 C2)
                      (&above L P1 P2))))))
        (member ((:t P))
          (&pixel *P L))
        (before ((:a P1) (:b P2))
          (&pixel (:P *P1) L (:Col *C1))
          (&pixel (:P *P2) L (:Col *C2))
          (OR ((&group.size (:key L (:Col C1)) (:N *N1))
               (&group.size (:key L (:Col C2)) (:N *N2))
               (< N1 N2))
              ((= C1 C2)
               (&above L P1 P2))))))))

(RULE &output
  (OR ((&lex.rank (:key *L *S) (:t *P) *R)
       (&fill.rank (:key L) (:t *P_px) R)
       (&pixel (:P P_px) L *Col))
      ((input P)
       (NOT (&pile P))
       (&bg (:C Col)))))
