;; 50aad11f

(DET &shape VanishedColor)

(INIT &shapes Connectivity
  (node (P)
    (input *P *Col)
    (&shape (:C Col))))

(RULE &shape_cell
  (&shapes.component *P *Id))

(RULE &layout_axis
  (perp *A (:A2 *A_across))
  (ALL ((&shape_cell (:Id *Id1) (:P *P1))
        (&shape_cell (:Id *Id2) (:P *P2))
        (same_line (:A A_across) (:P P1) (:Q P2)))
       ((= Id1 Id2))))

(INIT &order Order
  (key ((&layout_axis (:A ^A2))
        (axis_of ^D (:A A2)))
    (before ((:a Id) (:b Id2))
      (&shape_cell *Id *P)
      (&layout_axis *A)
      (split P A (:Along *P_along))
      (&shape_cell (:Id *Id2) (:P *P2))
      (&layout_axis (:A *A22))
      (split (:P P2) (:A A22) (:Along *P_along2))
      (!= Id Id2)
      (margin (:B P_along) D (:K *K1))
      (margin (:B P_along2) D (:K *K2))
      (< K1 K2)))
  (member ((:t Id))
    (&shape_cell *Id *P)
    (&layout_axis *A)
    (split P A (:Along *P_along))))

(RULE &order_pos
  (&order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
  (&order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
  (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

(INIT &bbox BoundingBox
  (key ((&shape_cell ^Id *P))
    (cell (P)
      (&shape_cell Id *P))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&order_pos (:P_pos *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_grid_in))
    (&bbox.box *B)
    (inside (:A P_grid_in) B)
    (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))))

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&shape (:C Col))))

(RULE &shape_color
  (&mark (:P *P_mark) *Col)
  (&shape_cell *Id *P)
  (&layout_axis *A)
  (perp A (:A2 *A_across))
  (same_line (:A A_across) (:P P_mark) (:Q P)))

(ALTS $choice "how a shape gets its marker's color (each pair puts every marker on its own shape's band, which hides which reading it is)" $Aligned
  (ALT $Ranked
    (INIT &mark_order Order
      (key ((&layout_axis (:A ^A2))
            (axis_of ^D (:A A2)))
        (before ((:a P) (:b P2))
          (&mark *P)
          (&layout_axis *A)
          (split P A (:Along *P_along))
          (&mark (:P *P2))
          (&layout_axis (:A *A22))
          (split (:P P2) (:A A22) (:Along *P_along2))
          (!= P P2)
          (margin (:B P_along) D (:K *K1))
          (margin (:B P_along2) D (:K *K2))
          (< K1 K2)))
      (member ((:t P))
        (&mark *P)
        (&layout_axis *A)
        (split P A (:Along *P_along))))

    (RULE &mark_order_pos
      (&mark_order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
      (&mark_order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
      (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

    (RULE &shape_color
      (&order_pos (:M *Id) (:P_pos *P_place))
      (&mark_order_pos (:M *P_mark) (:P_pos P_place))
      (&mark (:P P_mark) *Col))))

(RULE &output
  (input (:P *P_grid_in))
  (&bbox.box (:key *Id) *B)
  (inside (:A P_grid_in) B)
  (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))
  (&order_pos (:M Id) (:P_pos *P_tile))
  (&layout_axis)
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P)
  (&shape_color Id (:Col *Col_shape))
  (OR ((NOT (&shape_cell Id (:P P_grid_in)))
       (&bg (:C *Col)))
      ((&shape_cell Id (:P P_grid_in))
       (= Col Col_shape))))
