;; 321b1fc6

(DET &bg DominantColor)

(DET &blank VanishedColor)

(RULE &template
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&blank (:C Col))))

(INIT &blocks Connectivity
  (node (P)
    (input *P *Col)
    (&blank (:C Col))))

(INIT &block_box BoundingBox
  (key ((&blocks.component *P ^Id))
    (cell (P)
      (&blocks.component *P Id))))

(INIT &tmpl_box BoundingBox
  (cell (P)
    (&template *P)))

(RULE &shift
  (&tmpl_box.box (:B *P_tmpl_box))
  (&block_box.box (:B *P_block_box))
  (relative (:Base P_tmpl_box) (:X P_block_box) (:X_rel *V)))

(RULE &image
  (&template (:P *P_tmpl) *Col)
  (&shift *V)
  (compose (:A P_tmpl) (:B V) (:C *P)))

(RULE &output
  (input *P)
  (OR ((&image P *Col))
      ((NOT (&image P))
       (&bg (:C Col)))))
