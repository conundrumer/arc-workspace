;; 7b0280bc

(INIT &ground_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(DET &wire_fill AnyOutNewColor)

(DET &square_fill AnyOutNewColor)

;; The background is the commonest color.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&ground_count.size (:key *Col) *N)))

;; Each color's pieces. A wire runs diagonally, so pieces are 8-connected.
(INIT &piece Connectivity
  (key ((input *P ^Col)
        (NOT (&ground.maximal (:t Col))))
    (node (P)
      (input *P Col)
      (NOT (&ground.maximal (:t Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &piece_cell
  (&piece.component *P *Id))

(RULE &piece_color
  (&piece.component (:key *Col) *Id))

(INIT &bbox BoundingBox
  (key ((&piece_cell ^Id *P))
    (cell (P)
      (&piece_cell Id *P))))

(RULE &square_box
  (&bbox.box (:key *Id) *B)
  (&piece_cell Id *P)
  (box_extent B P *A *N)
  (perp A *A2)
  (box_extent B P (:A A2) N))

(RULE &square
  (&square_box *Id)
  (ALL ((&bbox.box (:key Id) *B)
        (input *P)
        (inside (:A P) B))
       ((&piece_cell Id P))))

(RULE &touch
  (&piece_cell (:Id *A) *P)
  (dir8_elem *D)
  (neighbor P D *Q)
  (&piece_cell (:Id *B) (:P Q))
  (!= A B))

(ALTS $choice "what makes a piece a square" $Filled
  (ALT $Extents
    (RULE &square
      (&square_box *Id))))

(RULE &wire_color
  (&piece_color *Id *Col)
  (NOT (&square Id)))

(RULE &square_color
  (&piece_color *Col)
  (NOT (&wire_color Col)))

(INIT &squares Cardinality
  (key ((&square_color ^Col))
    (member ((:m Id))
      (&piece_color *Id Col))))

(INIT &fewest Order
  (member ((:t (:V Col) (:S N)))
    (&squares.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&squares.size (:key *Col) *N)))

(RULE &end_color
  (&fewest.minimal (:t (:V *Col))))

(RULE &end_piece
  (&piece_color *Id *Col)
  (&end_color Col))

;; Hops over the touch graph from each end.
(INIT &hops Distance
  (key ((&end_piece (:Id ^E))))
  (edge ((:a A) (:b B))
    (&touch *A *B)))

;; The route: traced from the other end back toward the seed along
;; fewest-hop predecessors. Each end seeds the same route.
(INIT &back Propagation
  (key ((OR ((&end_piece (:Id ^E))
             (&end_piece (:Id *E2))
             (!= E E2))
            ((&hops.predecessor (:key E) (:b *B) (:a *A)))))
    (source ((:n E2))
      (&end_piece (:Id E))
      (&end_piece (:Id *E2))
      (!= E E2))
    (edge ((:a B) (:b A))
      (&hops.predecessor (:b *B) (:a *A)))))

(RULE &route_cell
  (&back.reached (:n *Id))
  (&piece_cell Id *P)
  (&piece_color Id (:Col *C))
  (OR ((&wire_color (:Col C))
       (&wire_fill (:C *Col)))
      ((&square_color (:Col C))
       (NOT (&end_color (:Col C)))
       (&square_fill (:C Col)))))

(RULE &output
  (OR ((&route_cell *P *Col))
      ((input P Col)
       (NOT (&route_cell P)))))
