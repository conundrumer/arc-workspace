;; 3391f8c0

(DET &bg DominantColor)

(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &copy
  (&objs.component (:key *Col) *P *Id))

(INIT &bbox BoundingBox
  (key ((&copy ^Id *P))
    (cell (P)
      (&copy Id *P))))

(RULE &shape
  (&copy *Id *Col *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &swap
  (&copy *Col)
  (&copy (:Col *Col2))
  (!= Col Col2))

(RULE &paint
  (&copy *Id (:Col *Col3))
  (&swap (:Col Col3) (:Col2 *Col))
  (&shape Col *P_inner)
  (input *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel P_inner)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&bg (:C Col)))))
