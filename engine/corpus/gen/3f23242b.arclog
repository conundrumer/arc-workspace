;; 3f23242b

(DET &mark RarestColor)

;; The bracket edge the line runs along, and the line's color.
(DET &ground_dir DirDomain)

(DET &ground_paint AnyOutNewColor)

(DET &mark_at
  (ex_input *E *P *Col)
  (&mark (:C Col)))

(DET &painted
  (ex_output *E *P *Col)
  (OR ((&mark_at E P))
      ((ex_input E P (:Col *Col_in))
       (!= Col_in Col))))

(DET &ink
  (&painted *E *P *Col)
  (NOT (&ground_paint (:C Col))))

(DET &cand
  (&ink *E *P *Col)
  (&mark_at E (:P *M))
  (relative (:Base M) (:X P) (:X_rel *Off)))

(DET &missed
  (&cand *Off *Col)
  (ex_output *E)
  (&mark_at E (:P *M))
  (compose (:A M) (:B Off) (:C *P))
  (NOT (&ink E P Col)))

;; The bracket's frame is the ink's bounding box, and the mark sits at
;; the offsets' origin.
(INIT &frame BoundingBox
  (cell ((:P Off))
    (&cand *Off *Col)
    (NOT (&missed Off Col))))

(DET &seat
  (&frame.box *B)
  (inside (:A 0) B)
  (relative (:Base B) (:X 0) (:X_rel *P)))

;; The bracket's own frame, read off the seat.
(INIT &box Frame
  (extent (A N)
    (&seat *P)
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &placed
  (input (:P *Q) (:Col *Col_mark))
  (&mark (:C Col_mark))
  (&box.cell (:P *P_box))
  (&seat (:P *P_seat))
  (relative (:Base P_seat) (:X P_box) (:X_rel *Off))
  (compose (:A Q) (:B Off) (:C *P_grid))
  (input (:P P_grid)))

(RULE &line_cell
  (&placed *P_box (:P_grid *P_ground))
  (&ground_dir *D)
  (margin (:B P_box) D (:K 0))
  (input *P)
  (same_dist D (:P1 P_ground) (:P2 P))
  (NOT (&placed (:P_grid P))))

(DET &shape
  (&box.cell *P)
  (&seat (:P *P_seat))
  (relative (:Base P_seat) (:X P) (:X_rel *Off))
  (&mark_at *E (:P *M))
  (compose (:A M) (:B Off) (:C *P2))
  (&painted E (:P P2) *Col))

(RULE &paint
  (OR ((&line_cell *P)
       (&ground_paint (:C *Col)))
      ((&placed *P_box (:P_grid P))
       (&shape (:P P_box) Col))))

(ALTS $choice "how the bracket's ink is derived" $Lookup
  (ALT $Frame
    ;; The axis whose edges take the corners.
    (DET &face_axis AxisDomain)

    (DET &arm_paint AnyOutNewColor)

    (DET &arm_dir
      (&shape *P)
      (interior (:A P) (:B 0))
      (&seat (:P *P_seat))
      (dir_elem *D)
      (neighbor (:P P_seat) D (:Q P)))

    (RULE &on_edge
      (&box.cell (:P *P_box))
      (dir_elem *D)
      (margin (:B P_box) D (:K 0)))

    (RULE &stalk_blocked
      (&on_edge (:P_box *P)))

    ;; The stalk the mark casts, which the bracket's edges halt.
    (INIT &stalk Ray
      (source (P)
        (&seat *P))
      (node (P)
        (input *P)
        (NOT (&stalk_blocked P)))
      (dir (D)
        (&arm_dir *D)))

    (RULE &on_face
      (&on_edge *P_box *D)
      (&face_axis *A)
      (axis_of D A))

    (DET &corner
      (&box.cell (:P *P_box))
      (diag_dir_elem (:D *Diag))
      (same_corner (:D Diag) (:P1 P_box) (:P2 0)))

    (DET &edge_paint
      (&shape *P *Col)
      (&on_edge (:P_box P) *D)
      (NOT (&corner (:P_box P))))

    (RULE &frame_ink
      (OR ((&on_edge *P_box *D)
           (&edge_paint D *Col)
           (&face_axis *A)
           (OR ((axis_of D A))
               ((NOT (&on_face P_box)))))
          ((&stalk.ray (:P P_box) *K)
           (&box.cell (:P P_box))
           (!= K 0)
           (&arm_paint (:C Col)))))

    (RULE &paint
      (OR ((&placed *P_box (:P_grid *P))
           (&frame_ink P_box *Col))
          ((&line_cell P)
           (&ground_paint (:C Col)))))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
