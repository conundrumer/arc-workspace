;; 342dd610

(DET &bg DominantColor)

(DET &ink
  (ex_input *E *P (:Col *C))
  (NOT (&bg C)))

;; Seat each color's ink among its output's cells, color for color.
(INIT &occ Occurrences
  (key ((OR ((&ink ^E (:P *P_in) (:C ^Col)))
            ((&ink E (:C Col))
             (ex_output E (:P *P_out) (:Col *Col2)))))
    (cell ((:P P_out) (:v Col2))
      (&ink E (:C Col))
      (ex_output E (:P *P_out) (:Col *Col2)))
    (shape ((:P P_in) (:v Col))
      (&ink E (:P *P_in) (:C Col)))))

(DET &broken
  (&occ.occurrence (:key (:Col *C)) (:P *Delta))
  (&ink *E C)
  (ex_output E)
  (NOT (&occ.occurrence (:key E (:Col C)) (:P Delta))))

(DET &move
  (&occ.occurrence (:key (:Col *C)) (:P *Delta))
  (NOT (&broken C Delta))
  (dir_elem *D)
  (dist_pair (:P Delta) D (:K *K1) (:K2 *K))
  (< K1 K)
  (jump_offset D K (:V Delta)))

(RULE &moved
  (input (:P *P_in) *Col)
  (&move (:C Col) *D *K)
  (jump (:P P_in) D K (:Q *P)))

(RULE &output
  (OR ((&moved *P *Col))
      ((input P)
       (NOT (&moved P))
       (&bg (:C Col)))))
