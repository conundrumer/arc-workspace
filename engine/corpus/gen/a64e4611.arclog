;; a64e4611

(INPUT noise-field "the grid is &background with cells of one other color scattered over it"

  (DET_OR_RULE &background DominantColor))

(INPUT band "one empty rectangle, all &background, is larger in area than every other empty rectangle. It reaches at least one grid edge."

  (RULE &blank
    (input *P *Col)
    (&background (:C Col)))

  ;; The runs of blank cells.
  (INIT &open_run Ray
    (source (P)
      (&blank *P))
    (node (P)
      (&blank *P))
    (dir (D)
      (&blank)
      (dir_elem *D)))

  ;; The fewest lines that share a run width for that width to bound the band. The pairs leave it open.
  ;; TODO no-det-plan: &quorum: the plan gives no verdict
  (DET &quorum (ONE))

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (RULE &reach
    (&open_run.end (:P *E) *D (:Origin *P))
    (dir_elem D)
    (margin (:B E) D *K))

  ;; The empty rectangle on P's line across D that reaches as far toward D as
  ;; P's run: the cells of the line whose runs reach at least that far, joined
  ;; to P along the line.
  (INIT &base Flood
    (key ((&reach ^D ^P))
      (node ((:P Q))
        (&reach D P *K)
        (&reach D (:P *Q) (:K *K2))
        (same_dist D (:P1 P) (:P2 Q))
        (<= K2 K))
      (source (P)
        (&reach D P))))

  ;; The rectangle's box: its base run and the end of P's run.
  (INIT &hull BoundingBox
    (key ((OR ((&base.reached (:key ^D ^P) (:P *Q)))
              ((&open_run.end (:P *E) D (:Origin P))
               (dir_elem D))))
      (cell ((:P Q))
        (OR ((&base.reached (:P *Q)))
            ((&open_run.end (:P Q) D (:Origin P))
             (dir_elem D))))))

  (INIT &area Cardinality
    (key ((&hull.box ^B))
      (member ((:m P))
        (&blank *P)
        (inside (:A P) B))))

  (INIT &short_side Order
    (key ((&hull.box (:key *P) ^B)
          (box_extent B P *N))
      (member ((:t N))
        (&hull.box (:key *P) B)
        (box_extent B P *N))
      (score ((:t N) (:S N))
        (&hull.box (:key *P) B)
        (box_extent B P *N))))

  (INIT &by_side Order
    (member ((:t (:V B) (:S N)))
      (&short_side.minimal (:key *B) (:t *N)))
    (score ((:t (:V B) (:S N)) (:S N))
      (&short_side.minimal (:key *B) (:t *N))))

  (INIT &side_area Order
    (member ((:t (:V B) (:S N)))
      (&by_side.maximal (:t (:V *B)))
      (&area.size (:key B) *N))
    (score ((:t (:V B) (:S N)) (:S N))
      (&by_side.maximal (:t (:V *B)))
      (&area.size (:key B) *N)))

  (RULE &inked_line
    (&ink *P)
    (perp *A *A2)
    (split P (:A A2) (:Along *L)))

  (RULE &empty_line
    (input *P)
    (perp *A *A2)
    (split P (:A A2) (:Along *L))
    (NOT (&inked_line A L)))

  ;; The span across A from the first empty line to the last.
  (INIT &span BoundingBox
    (key ((&empty_line (:A ^L) *P))
      (cell (P)
        (&empty_line (:A L) *P))))

  (RULE &middle
    (&span.box (:key (:L *A)) (:B *S))
    (input *P)
    (inside (:A P) (:B S))
    (relative (:Base S) (:X P) (:X_rel *P_rel))
    (perp A *A2)
    (axis_of *D (:A A2))
    (opposite D (:Opp *O))
    (margin (:B P_rel) D (:K *N))
    (OR ((margin (:B P_rel) (:D O) (:K N)))
        ((neighbor P D *Q)
         (inside (:A Q) (:B S))
         (relative (:Base S) (:X Q) (:X_rel *Q_rel))
         (margin (:B Q_rel) (:D O) (:K N)))))

  (RULE &broken
    (&middle *A *P)
    (&ink P)
    (split P A (:Along *R)))

  (RULE &mid
    (&middle *A *P)
    (split P A (:Along *R))
    (NOT (&broken A R)))

  (RULE &mid_end
    (&mid *A *R *P)
    (perp A *A2)
    (axis_of *D (:A A2))
    (&open_run.end (:P *E1) D (:Origin P)))

  (INIT &run_width Cardinality
    (key ((&mid ^A ^R *P)
          (OR ((perp A *A2)
               (axis_of *D (:A A2))
               (&open_run.ray (:P *Q) D (:K *N) (:Origin P))
               (> N 0))
              ((= Q P))))
      (member ((:m Q))
        (&mid A R *P)
        (OR ((perp A *A2)
             (axis_of *D (:A A2))
             (&open_run.ray (:P *Q) D (:K *N) (:Origin P))
             (> N 0))
            ((= Q P))))))

  (INIT &width_count Cardinality
    (key ((&run_width.size (:key (:A ^L) *R) (:N ^W)))
      (member ((:m R))
        (&run_width.size (:key (:A L) *R) (:N W)))))

  ;; The narrowest width that the quorum of lines shares.
  (INIT &shared Order
    (key ((&width_count.size (:key (:L ^A) *W) *N)
          (&quorum (:N ^Q))
          (>= N Q))
      (member ((:t W))
        (&width_count.size (:key (:L A) *W) *N)
        (&quorum (:N Q))
        (>= N Q))
      (score ((:t W) (:S W))
        (&width_count.size (:key (:L A) *W) *N)
        (&quorum (:N Q))
        (>= N Q))))

  (RULE &wide_run
    (OR ((&run_width.size (:key *A *R) (:N *W))
         (&shared.minimal (:key A *Q) (:t *W0))
         (>= W W0))
        ((&run_width.size (:key A R))
         (&quorum (:N Q))
         (NOT (&shared.minimal (:key A Q))))))

  ;; The cross-section: the intersection of the wide runs.
  (INIT &cut Order
    (key ((&wide_run (:A ^L) ^Q *R)
          (&mid_end (:A L) R ^D (:E1 *E))
          (margin (:B E) D (:K *N)))
      (member ((:t N))
        (&wide_run (:A L) Q *R)
        (&mid_end (:A L) R D (:E1 *E))
        (margin (:B E) D (:K *N)))
      (score ((:t N) (:S N))
        (&wide_run (:A L) Q *R)
        (&mid_end (:A L) R D (:E1 *E))
        (margin (:B E) D (:K *N)))))

  (RULE &short_run
    (&mid_end *A *R *D (:E1 *E))
    (&cut.maximal (:key (:L A) *Q D) (:t *N))
    (margin (:B E) D (:K *N2))
    (> N2 N))

  (INIT &stretch Connectivity
    (key ((&mid ^A *R *P)
          (&quorum (:N ^Q))
          (NOT (&short_run A Q R)))
      (node (P)
        (&mid A *R *P)
        (&quorum (:N Q))
        (NOT (&short_run A Q R)))))

  (INIT &stretch_len Cardinality
    (key ((&stretch.component (:key ^A ^Q) *P ^Id)
          (split P A (:Along *R)))
      (member ((:m R))
        (&stretch.component (:key A Q) *P Id)
        (split P A (:Along *R)))))

  (INIT &longest Order
    (key ((&stretch_len.size (:key ^A ^Q *Id) *N))
      (member ((:t (:V Id) (:S N)))
        (&stretch_len.size (:key A Q *Id) *N))
      (score ((:t (:V Id) (:S N)) (:S N))
        (&stretch_len.size (:key A Q *Id) *N))))

  (INIT &stretch_box BoundingBox
    (key ((&stretch.component (:key (:A ^T_a) (:Q ^T_q)) *P ^Id))
      (cell (P)
        (&stretch.component (:key (:A T_a) (:Q T_q)) *P Id)))))

(INPUT channels "straight empty channels, each at least three cells wide, run from the band to a grid edge")

(OUTPUT band-fill "the band's cells become &fill, except a margin &margin cells wide along each side of the band that is not on the grid edge"

  (DET &margin DivisorRatio)

  (DET &fill AnyOutNewColor))

(OUTPUT channel-fill "a cell becomes &fill when no cell within &margin of it on either axis is off &background, and a straight line of such cells runs from it to a grid edge in one direction and to a &fill cell of the band in the other. The line stops at the band's &fill cells."

  (RULE &edge_cell
    (input (:P *E1))
    (dir_elem *D)
    (margin (:B E1) D (:K 0)))

  (RULE &open_line
    (&edge_cell *D *E1)
    (opposite D (:Opp *D2))
    (OR ((&open_run.ray *P (:D D2) (:K *N_2) (:Origin E1))
         (> N_2 0)
         (margin (:B P) D *K))
        ((&open_run.end (:P *F) (:D D2) (:Origin E1))
         (neighbor (:P F) (:D D2) (:Q *N))
         (input (:P N))
         (margin (:B N) D K))))

  (INIT &arm_group Connectivity
    (key ((&open_line ^D ^K (:E1 *E)))
      (node ((:P E))
        (&open_line D K (:E1 *E)))))

  (INIT &group_box BoundingBox
    (key ((&arm_group.component (:key ^D ^K) (:P *E) ^Id))
      (cell ((:P E))
        (&arm_group.component (:key D K) (:P *E) Id))))

  (RULE &group_end
    (&arm_group.component (:key *D *K) (:P *E1) *Id)
    (&group_box.box (:key D K Id) *B)
    (perp_dir D (:D2 *D_p))
    (inside (:A E1) B)
    (relative (:Base B) (:X E1) (:X_rel *E_rel))
    (margin (:B E_rel) (:D D_p) (:K *K_p))
    (&margin (:K *M))
    (< K_p M))

  (RULE &arm_line
    (&arm_group.component (:key *D *K) (:P *E_mid) *Id)
    (NOT (&group_end D K Id (:E1 E_mid)))
    (&arm_group.component (:key D K) (:P *E1) Id)
    (ALL ((&group_end (:D *G_d) (:K *G_k) (:Id *G_id) E1 *D_p)
          (&group_box.box (:key (:D G_d) (:K G_k) (:Id G_id)) *B))
         ((margin B (:D D_p) (:K 0)))))

  (INIT &arm_span BoundingBox
    (key ((&arm_line ^D ^K ^Id (:E1 *E)))
      (cell ((:P E))
        (&arm_line D K Id (:E1 *E)))))

  (RULE &line_end
    (&arm_group.component (:key *D *K) (:P *E) *Id)
    (opposite D (:Opp *D2))
    (&open_run.end (:P *F) (:D D2) (:Origin E))
    (margin (:B F) D (:K *N)))

  ;; How far from the edge every line of the group stays blank.
  (INIT &arm_depth Order
    (key ((&line_end ^D ^K ^Id *N))
      (member ((:t N))
        (&line_end D K Id *N))
      (score ((:t N) (:S N))
        (&line_end D K Id *N))))

  (RULE &rect_far
    (&arm_depth.minimal (:key *D (:K *G_k) *Id) (:t *N_d))
    (&line_end D (:K G_k) Id *F (:N N_d))
    (opposite D (:Opp *D2))
    (OR ((NOT (margin (:B F) (:D D2) (:K 0)))
         (&margin (:K *M))
         (jump (:P F) D (:K M) (:Q *F2)))
        ((margin (:B F) (:D D2) (:K 0))
         (= F2 F)))
    (margin (:B F2) (:D D2) *K))

  (RULE &arm_reach
    ;; The margin past any line across the group's side, as the far side of a
    ;; piece's green lies the margin past the piece's far line.
    (OR ((&arm_span.box (:key *D *K *Id))
         (opposite D (:Opp *D2))
         (perp_dir D (:D2 *D_p))
         (&edge_cell (:D D_p) (:E1 *E))
         (&margin (:K *M))
         (jump (:P E) D (:K M) (:Q *E2))
         (margin (:B E2) (:D D2) (:K *N)))
        ((&rect_far D (:G_k K) Id (:K N)))))

  (RULE &arm_edge
    (OR ((&arm_reach (:D *Key_d) (:K *Key_k) *Id *N)
         (&arm_span.box (:key (:D Key_d) (:K Key_k) Id) (:B *B_s))
         (OR ((perp_dir (:D Key_d) (:D2 *D)))
             ((= D Key_d)))
         (margin (:B B_s) D *K))
        ((&arm_reach (:D Key_d) (:K Key_k) Id N)
         (opposite (:D Key_d) (:Opp D))
         (= K N))))

  (RULE &arm_axis
    (axis_of (:D *D3) *A)
    (opposite (:D D3) (:Opp *D2))
    (&arm_edge (:Key_d *D) (:Key_k *K) *Id *N (:D D3) (:K *K1))
    (&arm_edge (:Key_d D) (:Key_k K) Id N (:D D2) (:K *K2))
    (axis_inset (:D D3) K1 K2 *B))

  (RULE &arm
    (&arm_axis *D *K *Id *N *A (:B *B1))
    (perp A *A2)
    (&arm_axis D K Id N (:A A2) (:B *B2))
    (compose (:A B1) (:B B2) (:C *B)))

  (RULE &crowded
    (input *P)
    (&ink (:P *Q))
    (&margin (:K *M))
    (uniform_outset (:K M) (:B *O))
    (compose (:A P) (:B O) (:C *B))
    (inside (:A Q) B))

  (INIT &by_area Order
    (member ((:t (:V B) (:S N)))
      (&area.size (:key *B) *N))
    (score ((:t (:V B) (:S N)) (:S N))
      (&area.size (:key *B) *N)))

  (RULE &band_box
    (&by_area.maximal (:t (:V *B)))
    (ALL ((&by_area.maximal (:t (:V *B1)))
          (&by_area.maximal (:t (:V *B2))))
         ((= B1 B2))))

  (RULE &shape
    (OR ((&band_box *B))
        ((&arm B))))

  (RULE &long_axis
    (&shape *B)
    (input *P)
    (corner_dist P (:K 0))
    (box_extent B P *A *N)
    (perp A *A2)
    (box_extent B P (:A A2) (:N *N2))
    (> N N2))

  (RULE &across
    (&shape *B)
    (dir_elem *D))

  (RULE &kept_side
    (&band_box *B)
    (dir_elem *D)
    (NOT (margin B D (:K 0))))

  (RULE &band_rim
    (&kept_side *B *D)
    (input *P)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (margin (:B P_rel) D *K)
    (&margin (:K *M))
    (< K M))

  (RULE &band_green
    (&band_box *B)
    (input *P)
    (inside (:A P) B)
    (NOT (&band_rim B P)))

  (RULE &lit
    (&band_green))

  (RULE &lane_run_node
    (&lit)
    (input *P)
    (NOT (&crowded P))
    (NOT (&band_green P)))

  ;; The runs of clear cells outside the band's green.
  (INIT &lane_run Ray
    (source (P)
      (&lane_run_node *P))
    (node (P)
      (&lane_run_node *P))
    (dir (D)
      (&lit)
      (dir_elem *D)))

  (RULE &lane
    (&lane_run.end (:P *E) *D (:Origin *P))
    (margin (:B E) D (:K 0))
    (opposite D (:Opp *D2))
    (&lane_run.end (:P *F) (:D D2) (:Origin P))
    (neighbor (:P F) (:D D2) (:Q *G))
    (&band_green *B (:P G))
    (&across B D))

  (RULE &channel_lane
    (&lane *D *P))

  (RULE &turns
    (dir_elem *D)
    (dir_elem (:D *D_q)))

  ;; The lanes that lanes leave from: a cell whose line runs to edge D lies on
  ;; a lane toward D when the cell behind it lies on a lane it may leave, or on
  ;; a lane toward D.
  (INIT &chain_lane Propagation
    (source ((:n D P))
      (&lane *D *P))
    (edge ((:a (:D D_q) (:P Q)) (:b D P))
      (&lane_run.end (:P *E) *D (:Origin *P))
      (margin (:B E) D (:K 0))
      (opposite D (:Opp *D2))
      (neighbor P (:D D2) *Q)
      (&lane_run_node (:P Q))
      (OR ((&turns D *D_q))
          ((= D_q D)))))

  ;; Lanes toward one edge whose edge cells touch form one channel.
  (INIT &channel Connectivity
    (key ((&channel_lane ^D (:P *E))
          (margin (:B E) D (:K 0)))
      (node ((:P E))
        (&channel_lane D (:P *E))
        (margin (:B E) D (:K 0)))))

  (RULE &cross
    (OR ((&channel.component (:key *D) *P *Id))
        ((&channel.component (:key D) (:P *E) Id)
         (perp_dir D (:D2 *D_p))
         (neighbor (:P E) (:D D_p) (:Q P))
         (input P))))

  (RULE &cross_end
    (&cross *D *Id (:P *Q))
    (opposite D (:Opp *D2))
    (&open_run.end (:P *F) (:D D2) (:Origin Q))
    (margin (:B F) D (:K *N)))

  ;; How far from the edge every line of the cross-section stays blank.
  (INIT &depth Order
    (key ((&cross_end ^D ^Id *N))
      (member ((:t N))
        (&cross_end D Id *N))
      (score ((:t N) (:S N))
        (&cross_end D Id *N))))

  (INIT &chan_box BoundingBox
    (key ((OR ((&cross ^D ^Id (:P *Q)))
              ((&depth.minimal (:key D Id) (:t *N))
               (&cross_end D Id *F N))))
      (cell ((:P Q))
        (OR ((&cross D Id (:P *Q)))
            ((&depth.minimal (:t *N))
             (&cross_end D Id (:F Q) N))))))

  (RULE &arm_off
    (&shape *B)
    (margin B *D *K)
    (NOT (margin B D (:K 0)))
    (&across B D)
    (&arm_span.box (:key D K *Id)))

  ;; Through the far side of the piece's green.
  (RULE &arm_far
    (&arm_off *B *D *K *Id)
    (opposite D (:Opp *D2))
    (&margin (:K *M))
    (jump (:P B) D (:K M) (:Q *B2))
    (margin (:B B2) (:D D2) (:K *N)))

  (RULE &track
    (&band_box *B))

  ;; The boxes reached from the band, each box sending off its arm.
  (INIT &chain Propagation
    (key ((&track (:B ^B0))))
    (edge ((:a B) (:b B_arm))
      (&arm_far *B (:D *G_d) (:K *G_k) (:Id *G_id) *N)
      (&arm (:D G_d) (:K G_k) (:Id G_id) N (:B *B_arm))))

  (RULE &needs_axis)

  (RULE &unaligned
    (&band_box *B)
    (NOT (&long_axis B))
    (&needs_axis)))

(OUTPUT green "every large empty region of the field becomes &fill, except a margin &margin cells wide next to a cell off &background. No margin is kept at the grid edge."
  (APPROXIMATED "the band and its channels become &fill, as band-fill and channel-fill state"))

(OUTPUT keep "every other cell keeps its input color")

(ALTS $bands "which empty rectangle is the band" $LargestArea
  (ALT $WidestBand
    (INPUT band "the band is the empty rectangle with the longest short side, and a tie goes to the larger area. Undefined on a remaining tie."
      (RULE &band_box
        (&side_area.maximal (:t (:V *B)))
        (ALL ((&side_area.maximal (:t (:V *B1)))
              (&side_area.maximal (:t (:V *B2))))
             ((= B1 B2))))))
  (ALT $TiedBands
    (INPUT band "every empty rectangle of the largest area is a band"
      (RULE &band_box
        (&by_area.maximal (:t (:V *B))))))
  (ALT $EmptyLineBands
    (INPUT band "each axis with a line of &background cells across the whole grid has a band. On each line across that axis, take the run of &background cells through the middle of the span of those empty lines. The band's cross-section is the intersection of the runs at least as wide as the narrowest width that &quorum lines share, and its extent is each longest stretch of lines whose run spans that cross-section. With no empty line there is no band, and the output is the input."
      (RULE &line_box_edge
        (OR ((&longest.maximal (:key *A *Q) (:t (:V *Id)))
             (&stretch_box.box (:key (:T_a A) (:T_q Q) Id) *B)
             (axis_of *D A)
             (margin B D *K))
            ((&longest.maximal (:key A Q) (:t (:V Id)))
             (perp A *A2)
             (axis_of D (:A A2))
             (&cut.maximal (:key (:L A) Q D) (:t K)))))

      (RULE &line_box_axis
        (axis_of *D *A)
        (opposite D (:Opp *D2))
        (&line_box_edge (:A *Key_a) *Q *Id D (:K *K1))
        (&line_box_edge (:A Key_a) Q Id (:D D2) (:K *K2))
        (axis_inset D K1 K2 *B))

      (RULE &line_box
        (&line_box_axis (:Key_a *A) *Q *Id (:A *A3) (:B *B1))
        (perp (:A A3) *A2)
        (&line_box_axis (:Key_a A) Q Id (:A A2) (:B *B2))
        (compose (:A B1) (:B B2) (:C *B)))

      (RULE &band_box
        (&line_box *Q *B)))
    (RULE &framed
      (OR ()
          ((&band_box))))))

(ALTS $anchor "what a channel runs to" $BandAnchor
  (ALT $ChannelChain
    (OUTPUT channel-fill "a channel may also run to a channel's &fill cell, and it continues past a channel it crosses"
      (RULE &channel_lane
        (&chain_lane.reached (:n *D *P)))

      (RULE &piece
        (&band_box (:B *B0))
        (&track (:B B0))
        (&chain.reached (:key B0) (:n *B))))
    (ALT $SideEmpty
      (OUTPUT channel-fill "on each side of the band off the grid edge, a line across that side is an arm line when every cell between the grid edge and the band's side is &background. A run of arm lines with a line past the margin at each end is an arm. The arm's lines, less the margin at each end off the grid edge, become &fill from the grid edge through the far side of the band's &fill cells, over cells of any color."
        (RULE &piece
          (OR ((&band_box (:B *B0))
               (&track (:B B0))
               (&chain.reached (:key B0) (:n *B)))
              ((&band_box B))))))))

(ALTS $extent "where a channel's green ends" $StopAtBand
  (ALT $ChannelRect
    (OUTPUT channel-fill "a channel is a run of touching lines toward one edge. It covers the rectangle of its lines and one line on each side, from the grid edge on while every cell is &background, less the margin at each side off the grid edge."
      (RULE &arm_far
        (&arm_off *B *D *K *Id)
        (&rect_far D (:G_k K) Id (:K *N))))
    (RULE &channel_green
      (&chan_box.box (:key *D *Id) *B)
      (input *P)
      (inside (:A P) B)
      (ALL ((&chan_box.box (:key (:D *C_d) (:Id *C_id)) (:B *Bm))
            (dir_elem (:D *Dm))
            (inside (:A P) (:B Bm))
            (relative (:Base Bm) (:X P) (:X_rel *P_rel))
            (margin (:B P_rel) (:D Dm) (:K *Km))
            (&margin (:K *M))
            (< Km M))
           ((margin (:B Bm) (:D Dm) (:K 0)))))))

(ALTS $heading "the directions a channel may leave its band in" $AnyHeading
  (ALT $PerpendicularChannels
    (OUTPUT channel-fill "a channel leaves only across the long axis of the piece it runs to. Undefined on a square band."
      (RULE &across
        (&long_axis *B *A)
        (perp A *A2)
        (axis_of *D (:A A2)))

      (RULE &turns
        (axis_of *D *A)
        (axis_of (:D *D_q) (:A *A2))
        (perp A A2)))
    (RULE &unready
      (OR ((NOT (&framed)))
          ((&unaligned))))))

(ALTS $line "what makes a channel" $ClearLine
  (ALT $SideEmpty
    (OUTPUT channel-fill "on each side of the band off the grid edge, a line across that side is an arm line when every cell between the grid edge and the band's side is &background. A run of arm lines with a line past the margin at each end is an arm. The arm's lines, less the margin at each end off the grid edge, become &fill from the grid edge through the far side of the band's &fill cells, over cells of any color."
      (RULE &piece
        (&band_box *B))

      (RULE &arm_cell
        (&piece *B)
        (&arm_far B (:D *G_d) (:K *G_k) (:Id *G_id) *N)
        (&arm (:D G_d) (:K G_k) (:Id G_id) N (:B *B_arm))
        (input *P)
        (inside (:A P) (:B B_arm))))
    (RULE &green
      (OR ((&arm_cell *P))
          ((&band_green P))))))

(ALTS $edge "the band's margin on the grid edge" $OpenEdge
  (ALT $BandEdgeMargin
    (OUTPUT band-fill "the margin is also kept along each long side of the band on the grid edge. Undefined on a square band."
      (RULE &kept_side
        (OR ((&band_box *B)
             (&long_axis B *A)
             (perp A *A2)
             (axis_of *D (:A A2)))
            ((&band_box B)
             (dir_elem D)
             (NOT (margin B D (:K 0)))))))
    (RULE &unready
      (OR ((NOT (&framed)))
          ((&unaligned))))))

(RULE &channel_green
  (&channel_lane *P))

(RULE &green
  (OR ((&band_green *P))
      ((&channel_green P))))

(RULE &framed
  (&band_box))

(RULE &unready
  (NOT (&framed)))

(RULE &output
  (NOT (&unready))
  (input *P (:Col *Col_in))
  (IF ((&green P))
      ((&fill (:C *Col)))
      ((= Col Col_in))))
