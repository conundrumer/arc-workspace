;; 5961cc34

(DET &bg DominantColor)

;; The color the current carries.
(DET &lit UnchangedColor)

;; The colors a port cell takes.
(DET &port ChangedColor)

(RULE &node
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &port_cell
  (input *P *Col)
  (&port (:C Col)))

(INIT &objects Connectivity
  (node (P)
    (&node *P)))

(RULE &obj
  (&objects.component *P *Id))

(RULE &port_dir
  (&node (:P *Q))
  (NOT (&port_cell (:P Q)))
  (dir_elem *D)
  (neighbor (:P Q) D (:Q *P))
  (&port_cell P))

(RULE &beam_blocked
  (dir_elem (:D *Key))
  (&node *P))

;; Each port's beam runs over the field until it meets ink.
(INIT &beam Ray
  (key ((OR ((&port_dir *P ^D))
            ((dir_elem D))))
    (source (P)
      (&port_dir *P D))
    (node (P)
      (dir_elem D)
      (input *P)
      (NOT (&beam_blocked (:Key D) P)))
    (dir (D)
      (dir_elem D))))

(RULE &beam_cell
  (dir_elem (:D *Key))
  (input *P))

(RULE &feeds
  (&beam.end (:P *E) *D (:Origin *P_port))
  (neighbor (:P E) D (:Q *P))
  (input P)
  (&obj (:P P_port) *Id)
  (&obj P (:Id *Id2)))

;; The live objects: the objects the current starts from, and those it
;; reaches from them, carrying on down the beams.
(INIT &live Propagation
  (source ((:n Id))
    (&obj *P *Id)
    (input P *Col)
    (&lit (:C Col)))
  (edge ((:a Id) (:b Id2))
    (&feeds *Id *Id2)))

(ALTS $choice "which property singles out the source object; the pairs never separate them" $Lit
  (ALT $Marked
    ;; The color that marks the source object.
    (DET &source RarestColor)

    ;; The live objects: the objects the current starts from, and those it
    ;; reaches from them, carrying on down the beams.
    (INIT &live Propagation
      (source ((:n Id))
        (&obj *P *Id)
        (input P *Col)
        (&source (:C Col)))
      (edge ((:a Id) (:b Id2))
        (&feeds *Id *Id2))))
  (ALT $Rim
    ;; The live objects: the objects the current starts from, and those it
    ;; reaches from them, carrying on down the beams.
    (INIT &live Propagation
      (source ((:n Id))
        (&obj *P *Id)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a Id) (:b Id2))
        (&feeds *Id *Id2)))))

(RULE &lit_cell
  (&live.reached (:n *Id))
  (&obj (:P *P_obj) Id)
  (OR ((&beam.ray (:key (:D *Ky)) *P (:Origin P_obj))
       (&beam_cell (:Key Ky) P))
      ((= P P_obj))))

(RULE &output
  (OR ((&lit_cell *P)
       (&lit (:C *Col)))
      ((input P)
       (NOT (&lit_cell P))
       (&bg (:C Col)))))
