;; e1baa8a4

(RULE &edge_dist
  (input *P)
  (dir_elem *D)
  (margin (:B P) D *K))

(RULE &bands_domain
  (&edge_dist *D *K))

(RULE &boundary
  (input *P (:Col *C1))
  (dir_elem *D)
  (margin (:B P) D *K)
  (neighbor P D (:Q *P2))
  (input (:P P2) (:Col *C2))
  (!= C1 C2))

(INIT &bands Cardinality
  (key ((&bands_domain ^D ^K))
    (member ((:m K2))
      (&boundary D (:K *K2))
      (<= K2 K))))

(RULE &place_edge
  (&edge_dist (:P *Key) *D (:K *K2))
  (&bands.size (:key D (:K K2)) (:N *K)))

(RULE &place_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&place_edge *Key D (:K *K1))
  (&place_edge Key (:D D2) (:K *K2))
  (axis_inset D K1 K2 *B))

(RULE &place
  (&place_axis *Key *A (:B *B1))
  (perp A *A2)
  (&place_axis Key (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(RULE &output
  (input (:P *P2) *Col)
  (&place (:Key P2) (:B *P)))
