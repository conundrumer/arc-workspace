;; 0ca9ddb6

(INIT &ground_count Cardinality
  (key ((ex_input *E *P ^Col))
    (member ((:m E P))
      (ex_input *E *P Col))))

(DET &radius DivisorRatio)

;; The grids' ground color; dots are the exception to it.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S Count))
    (&ground_count.size (:key *Col) (:N *Count))))

(DET &dot
  (ex_input *E *P (:Col *M))
  (NOT (&ground.maximal (:t M))))

(DET &star
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col2))
  (!= Col2 Col))

;; Each star with its dot, one 8-connected blob; inert dots blob alone.
(INIT &blob Connectivity
  (key ((OR ((&star ^E *P))
            ((&dot E P))))
    (node (P)
      (OR ((&star E *P))
          ((&dot E P)))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(DET &arms_mark
  (&dot *E *P)
  (&blob.component (:key E) P *Id))

(DET &arms_dir
  (&arms_mark *E *Id)
  (dir_elem *D))

;; Casts from each blob's dot, one instance per kind, classify the
;; blob's painted cells.
(INIT &arms Ray
  (key ((OR ((&dot ^E *P)
             (&blob.component (:key E) P ^Id))
            ((&arms_dir E Id *D))
            ((&arms_dir E Id)
             (ex_input E P))))
    (source (P)
      (&dot E *P)
      (&blob.component (:key E) P Id))
    (node (P)
      (&arms_dir E Id)
      (ex_input E *P))
    (dir (D)
      (&arms_dir E Id *D))))

(DET &arms_cell
  (&arms_mark *E *Id)
  (ex_input E *P))

(DET &star_cell
  (&dot *E (:P *Q) *M)
  (&blob.component (:key E) (:P Q) *Id)
  (&blob.component (:key E) *P Id)
  (&star E P *Col)
  (relative (:Base Q) (:X P) (:X_rel *Delta)))

(DET &arm_paint
  (&star_cell *E *Id (:M *Mark) *P *Col)
  (&arms.ray (:key E Id) P *K)
  (&arms_cell E Id P)
  (!= K 0))

(RULE &arm_dir
  (&arm_paint (:Mark *Key))
  (dir_elem *D))

;; One cast per kind: each roster's marks cast that kind's directions.
(INIT &arm Ray
  (key ((OR ((input *P (:Col ^M))
             (&arm_paint (:Mark M)))
            ((&arm_dir (:Key M) *D))
            ((&arm_dir (:Key M))
             (input P))))
    (source (P)
      (input *P (:Col M))
      (&arm_paint (:Mark M)))
    (node (P)
      (&arm_dir (:Key M))
      (input *P))
    (dir (D)
      (&arm_dir (:Key M) *D))))

(RULE &arm_cell
  (&arm_paint (:Mark *Key))
  (input *P))

(DET &diags_mark
  (&dot *E *P)
  (&blob.component (:key E) P *Id))

(DET &diags_dir
  (&diags_mark *E *Id)
  (diag_dir_elem *D))

(INIT &diags Ray
  (key ((OR ((&dot ^E *P)
             (&blob.component (:key E) P ^Id))
            ((&diags_dir E Id *D))
            ((&diags_dir E Id)
             (ex_input E P))))
    (source (P)
      (&dot E *P)
      (&blob.component (:key E) P Id))
    (node (P)
      (&diags_dir E Id)
      (ex_input E *P))
    (dir (D)
      (&diags_dir E Id *D))))

(DET &diags_cell
  (&diags_mark *E *Id)
  (ex_input E *P))

(DET &diag_paint
  (&star_cell *E *Id (:M *Mark) *P *Col)
  (&diags.ray (:key E Id) P *K)
  (&diags_cell E Id P)
  (!= K 0))

(RULE &diag_dir
  (&diag_paint (:Mark *Key))
  (diag_dir_elem *D))

(INIT &diag Ray
  (key ((OR ((input *P (:Col ^M))
             (&diag_paint (:Mark M)))
            ((&diag_dir (:Key M) *D))
            ((&diag_dir (:Key M))
             (input P))))
    (source (P)
      (input *P (:Col M))
      (&diag_paint (:Mark M)))
    (node (P)
      (&diag_dir (:Key M))
      (input *P))
    (dir (D)
      (&diag_dir (:Key M) *D))))

(RULE &diag_cell
  (&diag_paint (:Mark *Key))
  (input *P))

(RULE &painted
  (&radius (:K *R))
  (OR ((&arm.ray (:key *M) *P *K)
       (&arm_cell (:Key M) P)
       (&arm_paint (:Mark M) *Col))
      ((&diag.ray (:key M) P K)
       (&diag_cell (:Key M) P)
       (&diag_paint (:Mark M) Col)))
  (!= K 0)
  (<= K R))

(ALTS $choice "how a mark's star footprint is computed (data-equivalent on this task)" $Ray
  (ALT $Lookup
    (DET &paint
      (&star_cell (:M *Mark) *Col))

    (DET &template
      (&star_cell (:M *Mark) *Delta))

    (RULE &painted
      (input (:P *P2) (:Col *M))
      (&paint (:Mark M) *Col)
      (&template (:Mark M) (:Delta *V))
      (compose (:A P2) (:B V) (:C *P))
      (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
