;; 1a07d186

(DET &bg DominantColor)

(RULE &cell_line
  (input *P)
  (axis_elem *A)
  (split P A (:Along *L)))

(INIT &line_color Singleton
  (key ((&cell_line *P ^A ^L)
        (input P *Col))
    (member ((:v Col))
      (&cell_line *P A L)
      (input P *Col))))

(RULE &line
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &line_cell
  (&line *A *L *Col)
  (&cell_line *P A L))

(RULE &loose
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&line_cell P)))

(RULE &arrive
  (&loose (:P *P_grid_in) *Col)
  (&line *A *L Col)
  (split (:P P_grid_in) A (:Along *L_in) *Across)
  (axis_of *D A)
  (nearer D (:P L_in) (:Q L))
  (compose (:A L) (:B Across) (:C *P_foot))
  (neighbor (:P P_foot) D (:Q *P)))

(RULE &output
  (input *P)
  (OR ((&line_cell P *Col))
      ((&arrive P Col))
      ((NOT (&line_cell P))
       (NOT (&arrive P))
       (&bg (:C Col)))))
