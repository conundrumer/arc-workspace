;; c7f57c3e

(INPUT plain-background "one color fills every cell that no figure covers")

(INPUT figures "each figure is one 8-connected group of non-background cells")

(INPUT scaled-copies-of-one-body "the frame-color cells of every figure are one shape, at an integer scale per figure, with one orientation, and every figure's cells are blocks of that scale"

  (INIT &commonest_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N)))

  (RULE &bg
    (&commonest.maximal (:t *Col)))

  (INIT &figs Connectivity
    (node (P)
      (input *P *Col)
      (NOT (&bg Col)))
    (step ((:Delta S))
      (diag_dir_elem *D)
      (step_offset D (:V *S))))

  (INIT &fig_box BoundingBox
    (key ((&figs.component *P (:Id ^O)))
      (cell (P)
        (&figs.component *P (:Id O)))))

  (RULE &fig_frame
    (&fig_box.box (:key *O) *B)
    (input (:P *P_grid))
    (inside (:A P_grid) B)
    (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

  ;; A figure's box cut into blocks at each candidate size.
  (INIT &tiling Division
    (key ((&fig_frame ^O *P_inner)
          (axis_elem (:A *A2))
          (sub_extent (:P P_inner) (:A A2) ^K)
          (axis_elem *A))
      (cell ((:P P_inner2))
        (&fig_frame O *P_inner)
        (axis_elem (:A *A2))
        (sub_extent (:P P_inner) (:A A2) K)
        (axis_elem *A)
        (&fig_frame (:P_inner *P_inner2)))
      (side (A K)
        (&fig_frame O *P_inner)
        (axis_elem (:A *A2))
        (sub_extent (:P P_inner) (:A A2) K)
        (axis_elem *A))))

  (RULE &fig_tile
    (&fig_frame *O *P_grid *P_inner)
    (&tiling.tile (:key O *K) (:P P_inner) (:P_outer *P_tile) (:P_inner *P_intile)))

  ;; The figure's scale: the largest size at which its cells are blocks.
  (INIT &block Order
    (key ((&fig_tile ^O *K)
          (ALL ((&fig_tile O K (:P_grid *P) *P_tile)
                (&fig_tile O K (:P_grid *Q) P_tile)
                (input P *Col))
               ((input (:P Q) Col))))
      (member ((:t K))
        (&fig_tile O *K)
        (ALL ((&fig_tile O K (:P_grid *P) *P_tile)
              (&fig_tile O K (:P_grid *Q) P_tile)
              (input P *Col))
             ((input (:P Q) Col))))
      (score ((:t K) (:S K))
        (&fig_tile O *K)
        (ALL ((&fig_tile O K (:P_grid *P) *P_tile)
              (&fig_tile O K (:P_grid *Q) P_tile)
              (input P *Col))
             ((input (:P Q) Col))))))

  (RULE &block_color
    (&block.maximal (:key *O) (:t *K))
    (&fig_tile O K (:P_grid *P) *P_tile)
    (input P *Col))

  (INIT &col_box BoundingBox
    (key ((&block_color ^O *P_tile ^Col))
      (cell ((:P P_tile))
        (&block_color O *P_tile Col)))))

(INPUT two-decorations "a figure's cells of other colors than frame-color, put in the frame of its body and its scale, form one of exactly two patterns, and each pattern occurs on at least one figure")

(OUTPUT swap-decorations "each figure keeps its frame-color body, loses its own decoration, and takes the other decoration, scaled to its own scale and placed at the same position relative to its body"

  (DET &lost
    (ex_input *E *P *Col)
    (ex_output E)
    (NOT (ex_output E P Col)))

  (DET &frame_color
    (ex_input *E *Col)
    (ex_output E)
    (NOT (&lost Col)))

  (RULE &frame_col
    (&frame_color *Col))

  (INIT &body_box BoundingBox
    (key ((&block_color ^O *P_tile *Col)
          (&frame_col Col))
      (cell ((:P P_tile))
        (&block_color O *P_tile *Col)
        (&frame_col Col)))))

(OUTPUT rest-unchanged "every other cell keeps its input color")

(ALTS $choice "what gives the body's colors" $StoredFrame
  (ALT $FrameColorsByShape
    (INPUT scaled-copies-of-one-body "the body is every color that every figure carries in one shape up to the figure's scale; undefined where the bodies those colors give differ between figures"
      (RULE &col_shape
        (&block_color *O *P_tile *Col)
        (&col_box.box (:key O Col) *B)
        (inside (:A P_tile) B)
        (relative (:Base B) (:X P_tile) (:X_rel *P_rel)))

      (RULE &frame_col
        (&block_color *Col)
        (NOT (&bg Col))
        (ALL ((&block.maximal (:key *O)))
             ((&block_color O Col)))
        (ALL ((&col_shape (:O *Om) Col (:P_rel *P))
              (&col_box.box (:key (:O *O2) Col)))
             ((&col_shape (:O O2) Col (:P_rel P))))))))

(RULE &body_rel
  (&block_color *O *P_tile *Col)
  (&body_box.box (:key O) *B)
  (relative (:Base B) (:X P_tile) (:X_rel *P_rel)))

(RULE &decoration
  (&body_rel *O *P_rel *Col)
  (NOT (&bg Col))
  (NOT (&frame_col Col)))

(RULE &lacks
  (&decoration *O (:P_rel *P) *Col)
  (&body_box.box (:key (:O *O2)))
  (NOT (&decoration (:O O2) (:P_rel P) Col)))

(RULE &takes
  (OR ((&lacks *O *O2))
      ((&lacks (:O O2) (:O2 O))))
  (&decoration (:O O2) *P_rel *Col))

(INIT &paint_tiling Tiling
  (outer ((:P P_tile))
    (&takes *O *P_rel)
    (&body_box.box (:key O) *B)
    (compose (:A B) (:B P_rel) (:C *P_tile)))
  (inner ((:P P_intile))
    (&block.maximal (:key *O) (:t *K))
    (&fig_tile O K *P_intile)))

(RULE &body
  (&body_rel *O *P_rel *Col)
  (&frame_col Col))

(RULE &body_mismatch
  (&body *O (:P_rel *P))
  (&body_box.box (:key (:O *O2)))
  (NOT (&body (:O O2) (:P_rel P))))

(RULE &paint
  (&takes *O *P_rel *Col)
  (&body_box.box (:key O) *B)
  (compose (:A B) (:B P_rel) (:C *P_tile))
  (&block.maximal (:key O) (:t *K))
  (&fig_tile O K *P_intile)
  (&paint_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_fig))
  (&fig_box.box (:key O) (:B *B_fig))
  (compose (:A B_fig) (:B P_fig) (:C *P))
  (input P))

(RULE &output
  (OR ((&paint *P *Col))
      ;; A cell outside every figure, or a body cell, keeps its color while the
      ;; bodies agree.
      ((NOT (&body_mismatch))
       (input P Col)
       (NOT (&paint P))
       (OR ((NOT (&figs.component P)))
           ((&frame_col Col))))
      ;; A cell of the figure's own decoration clears, once the figure takes another.
      ((&figs.component P (:Id *O))
       (input P (:Col *C_in))
       (&takes O)
       (NOT (&frame_col (:Col C_in)))
       (NOT (&paint P))
       (&bg Col))))
