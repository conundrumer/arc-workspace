;; 2faf500b

(DET &bg DominantColor)

(DET &mark ChangedColor)

(INIT &shapes Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &shape
  (&shapes.component *P *Id))

(RULE &mark_cell
  (&shape *Id *P)
  (input P *Col)
  (&mark (:C Col)))

(RULE &cut_cell
  (&shape *Id *P)
  (&mark_cell Id (:P *M))
  (axis_elem *A)
  (same_line A P (:Q M)))

(RULE &cut_axis
  (&shape *Id)
  (axis_elem *A)
  (ALL ((&shape Id *P))
       ((&cut_cell Id A P))))

(RULE &moved
  (&cut_axis *Id *A)
  (&cut_cell Id A (:P *P2) *M)
  (input (:P P2) *Col)
  (NOT (&mark (:C Col)))
  (axis_of *D A)
  (nearer D (:P P2) (:Q M))
  (neighbor (:P P2) D (:Q *P)))

(ALTS $choice "where the cut runs" $Marks
  (ALT $Midline
    (INIT &bbox BoundingBox
      (key ((&shape ^Id *P))
        (cell (P)
          (&shape Id *P))))

    (RULE &moved
      (&shape *Id (:P *P2))
      (&bbox.box (:key Id) *B)
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P_inner))
      (input (:P P2) *Col)
      (NOT (&mark (:C Col)))
      (&cut_axis Id *A)
      (axis_of *D A)
      (dist_pair (:P P_inner) D *K (:K2 *K_far))
      (< K K_far)
      (neighbor (:P P2) D (:Q *P)))))

(RULE &output
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (&bg (:C Col)))))
