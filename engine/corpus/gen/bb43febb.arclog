;; bb43febb

(DET &ink SharedColor)

(DET &fill AnyOutNewColor)

(RULE &ink2
  (input *P *Col)
  (&ink (:C Col)))

(INIT &comps Connectivity
  (node (P)
    (&ink2 *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(RULE &inner_cell
  (&bbox.box *B)
  (input *P)
  (interior (:A P) B))

(ALTS $choice "Two models pick the interior" $Box
  (ALT $Erode
    (INIT &exposed Boundary
      (cell (P)
        (&ink2 *P)))

    (RULE &inner_cell
      (&ink2 *P)
      (NOT (&exposed.boundary P)))))

(RULE &output
  (OR ((&inner_cell *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&inner_cell P)))))
