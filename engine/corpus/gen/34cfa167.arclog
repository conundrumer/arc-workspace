;; 34cfa167

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The corner blocks' color.
(DET &block_color SharedColor)

;; The corner the arms run toward; the other block sits there.
(DET &arm_corner DiagDirDomain)

(DET &period TileCount)

;; The ground the figure sits on.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(INIT &blocks Connectivity
  (node (P)
    (input *P *Col)
    (&block_color (:C Col))))

(INIT &bbox BoundingBox
  (key ((&blocks.component *P ^Id))
    (cell (P)
      (&blocks.component *P Id))))

;; The block at the arms' corner stands alone; the other carries the arms.
(INIT &from_corner Order
  (member ((:t (:V Id) (:S K)))
    (&bbox.box (:key *Id) *B)
    (&arm_corner (:D *Diag))
    (corner_dist (:P B) Diag *K))
  (score ((:t (:V Id) (:S K)) (:S K))
    (&bbox.box (:key *Id) *B)
    (&arm_corner (:D *Diag))
    (corner_dist (:P B) Diag *K)))

(RULE &template
  (&from_corner.maximal (:t (:V *Id))))

(RULE &standalone
  (&from_corner.minimal (:t (:V *Id))))

(RULE &block_offset
  (&template (:Id *T))
  (&bbox.box (:key (:Id T)) *B)
  (&bbox.box (:key *Id) (:B *B2))
  (relative (:Base B) (:X B2) (:X_rel *V)))

(RULE &axis_offset
  (&block_offset (:V *V2))
  (axis_elem *A)
  (split (:P V2) A (:Along *V)))

(RULE &corner_delta
  (&axis_offset *A (:V *V1))
  (perp A *A2)
  (&axis_offset (:A A2) (:V *V2))
  (compose (:A V1) (:B V2) (:C *V)))

(RULE &arm_perp
  (&arm_corner (:D *Diag))
  (diag_dirs (:D Diag) (:D1 *D) *D2))

(RULE &arm_dir
  (&arm_perp *D))

;; Each arm casts from the template block's side, so a mark's distance is
;; read off the block's edge.
(INIT &cast Ray
  (key ((&arm_dir ^D))
    (source (P)
      (&template (:Id *T))
      (&bbox.cell (:key (:Id T)) *P)
      (&bbox.box (:key (:Id T)) *B)
      (inside (:A P) B)
      (same_dist D (:P1 P) (:P2 B))))
  (node (P)
    (input *P)))

(RULE &cast_cell
  (&arm_dir (:D *Key))
  (input *P))

(RULE &arm_mark
  (&cast.ray (:key *D) *P D *K)
  (&cast_cell (:Key D) P)
  (!= K 0)
  (input P *Col)
  (NOT (&bg Col)))

(RULE &arm
  (&arm_mark *D *K *Col))

(INIT &span Order
  (key ((&arm ^D *K))
    (member ((:t K))
      (&arm D *K))
    (score ((:t K) (:S K))
      (&arm D *K))))

(RULE &period2
  (&arm_dir *D)
  (&period (:N *K)))

(RULE &run
  (&cast.ray (:key *D) *P D *K (:Origin *Src))
  (&cast_cell (:Key D) P)
  (!= K 0)
  (opposite D (:Opp *D2))
  (&standalone (:Id *S))
  (&bbox.box (:key (:Id S)) *B)
  (nearer (:D D2) P (:Q B)))

(RULE &side
  (&arm_perp *D *D2)
  (axis_of (:D D2) (:A *A2))
  (&block_offset *Id (:V *V2))
  (split (:P V2) (:A A2) (:Along *V))
  (OR ((&template Id)
       (opposite (:D D2) (:Opp *D_out)))
      ((&standalone Id)
       (= D_out D2))))

(ALTS $choice "the distance at which the marks repeat, which the pairs do not separate" $Given
  (ALT $Extend
    (RULE &period2
      (&arm_mark *D *P (:K *K_last))
      (&span.maximal (:key D) (:t K_last))
      (neighbor P D *Q)
      (&cast.ray (:key D) (:P Q) D *K)
      (&cast_cell (:Key D) (:P Q)))))

(RULE &rail
  (&run *D *P *K)
  (&period2 D (:K *N))
  (divide (:T K) (:Side N) (:Gap 0) (:Remainder *R))
  (&arm D (:K R) *Col))

(RULE &paint
  ;; A corner block.
  (OR ((&blocks.component (:P *P2) *Id)
       (&template Id)
       (&block_color (:C *Col))
       (&corner_delta *V)
       (compose (:A P2) (:B V) (:C *P)))
      ;; A rail cell.
      ((&rail *D (:P *Q) Col)
       (&side D (:V *V2))
       (compose (:A Q) (:B V2) (:C P)))
      ;; The plain line one cell outside a rail.
      ((&span.minimal (:key (:D *D2)) (:t *K_near))
       (&arm (:D D2) (:K K_near) Col)
       (&template (:Id *T))
       (&bbox.box (:key (:Id T)) *B)
       (&run (:D D2) (:P *Q2) *Src)
       (&bbox.cell (:key (:Id T)) (:P Src))
       (inside (:A Src) B)
       (same_dist (:D *D_out) (:P1 Src) (:P2 B))
       (&side (:D D2) (:V *V3) D_out)
       (compose (:A Q2) (:B V3) (:C *P_rail))
       (neighbor (:P P_rail) (:D D_out) (:Q P)))))

(RULE &output
  (OR ((&paint *P *Col)
       (input P))
      ((input P)
       (&bg Col)
       (NOT (&paint P)))))
