;; 48f8583b

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg AnyOutNewColor)

(INIT &color_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &rarest Order
  (member ((:t (:V Col) (:S N)))
    (&color_count.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&color_count.size (:key *Col) *N)))

(RULE &active
  (input *P *Col)
  (&rarest.minimal (:t (:V Col))))

(RULE &output
  (&output_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) *P)
  (input (:P P_intile) (:Col *Col_intile))
  (OR ((NOT (&active (:P P_tile)))
       (&bg (:C *Col)))
      ((&active (:P P_tile))
       (= Col Col_intile))))
