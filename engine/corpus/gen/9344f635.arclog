;; 9344f635

(DET &bg DominantColor)

;; the axis whose filled lines cover the other axis's
(DET &over AxisDomain)

(RULE &segment
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (neighbor P *D *Q)
  (input (:P Q) Col)
  (axis_of D *A))

(RULE &line_col
  (input *P)
  (&segment (:P *Q) *A *Col)
  (same_line A P Q))

(RULE &shown
  (&over *A)
  (perp A *A2)
  (OR ((&line_col *P A *Col))
      ((&line_col P (:A A2) Col)
       (NOT (&line_col P A)))))

(RULE &output
  (input *P)
  (OR ((&shown P *Col))
      ((NOT (&shown P))
       (&bg (:C Col)))))
