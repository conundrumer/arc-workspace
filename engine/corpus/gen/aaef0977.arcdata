;; aaef0977

(param &bg Color (7))
(param &cycle_succ (Color Color)
  (3 4)
  (4 0)
  (0 5)
  (5 2)
  (2 8)
  (8 9)
  (9 6)
  (6 1)
  (1 3))
(param &scan_order (DiagDir Axis)
  (DIAG_TL AXIS_V)
  (DIAG_TL AXIS_H)
  (DIAG_TR AXIS_V)
  (DIAG_TR AXIS_H)
  (DIAG_BL AXIS_V)
  (DIAG_BL AXIS_H)
  (DIAG_BR AXIS_V)
  (DIAG_BR AXIS_H))

(alts $choice
  (alt $NearestSeed
    (witness two-seeds variant $NearestSeed
      (relaxed seed)
      (separates "$NearestSeed and $LastSeed from the concept: two seeds of different colors at an odd Manhattan distance, so no cell is equidistant from both. The concept needs exactly one seed and is undefined; $NearestSeed rings each cell from its nearer seed; $LastSeed gives a grid for each open scan order, and rings every cell from the last seed in that order: the 5 at some orders and the 3 at others.")
      (input (grid
        (7 7 7 7 7 7 7 7)
        (7 3 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 5 7 7)
        (7 7 7 7 7 7 7 7)))
      (output concept undefined)
      (output $NearestSeed (grid
        (0 4 0 5 2 8 9 6)
        (4 3 4 0 5 2 8 9)
        (0 4 0 5 2 6 1 3)
        (5 0 5 2 6 9 6 1)
        (2 5 2 6 9 8 9 6)
        (8 2 6 9 8 2 8 9)
        (1 6 9 8 2 5 2 8)
        (3 1 6 9 8 2 8 9)))
      (output $LastSeed
        (grid
          (8 2 5 0 4 3 4 0)
          (2 5 0 4 3 1 3 4)
          (5 0 4 3 1 6 1 3)
          (0 4 3 1 6 9 6 1)
          (4 3 1 6 9 8 9 6)
          (3 1 6 9 8 2 8 9)
          (1 6 9 8 2 5 2 8)
          (3 1 6 9 8 2 8 9))
        (grid
          (0 4 0 5 2 8 9 6)
          (4 3 4 0 5 2 8 9)
          (0 4 0 5 2 8 9 6)
          (5 0 5 2 8 9 6 1)
          (2 5 2 8 9 6 1 3)
          (8 2 8 9 6 1 3 4)
          (9 8 9 6 1 3 4 0)
          (6 9 6 1 3 4 0 5)))))
  (alt $LastSeed
    (witness two-seeds variant $NearestSeed)))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor borderline &bg=$Derived
      (relaxed field)
      (separates "`bg=DominantColor` from the stored value: the input of `other-field`")
      (input (grid
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 5 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)))
      (output ($OneSeed &bg=$Stored) undefined)
      (output $NearestSeed (grid
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 5 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)))
      (output $LastSeed
        (grid
          (8 2 5 0 4 3 1 6)
          (2 5 0 4 3 1 6 9)
          (5 0 4 3 1 6 9 8)
          (0 4 3 1 6 9 8 2)
          (4 3 1 6 9 8 2 5)
          (3 1 6 9 8 2 5 0)
          (1 6 9 8 2 5 0 4)
          (6 9 8 2 5 0 4 3))
        (grid
          (6 1 3 4 0 5 2 8)
          (9 6 1 3 4 0 5 2)
          (8 9 6 1 3 4 0 5)
          (2 8 9 6 1 3 4 0)
          (5 2 8 9 6 1 3 4)
          (0 5 2 8 9 6 1 3)
          (4 0 5 2 8 9 6 1)
          (3 4 0 5 2 8 9 6))
        (grid
          (6 9 8 2 5 0 4 3)
          (1 6 9 8 2 5 0 4)
          (3 1 6 9 8 2 5 0)
          (4 3 1 6 9 8 2 5)
          (0 4 3 1 6 9 8 2)
          (5 0 4 3 1 6 9 8)
          (2 5 0 4 3 1 6 9)
          (8 2 5 0 4 3 1 6))
        (grid
          (3 4 0 5 2 8 9 6)
          (4 0 5 2 8 9 6 1)
          (0 5 2 8 9 6 1 3)
          (5 2 8 9 6 1 3 4)
          (2 8 9 6 1 3 4 0)
          (8 9 6 1 3 4 0 5)
          (9 6 1 3 4 0 5 2)
          (6 1 3 4 0 5 2 8)))
      (output &bg=$Derived (grid
        (4 3 1 3 4 0 5 2)
        (3 1 6 1 3 4 0 5)
        (1 6 9 6 1 3 4 0)
        (6 9 8 9 6 1 3 4)
        (9 8 2 8 9 6 1 3)
        (8 2 5 2 8 9 6 1)
        (9 8 2 8 9 6 1 3)
        (6 9 8 9 6 1 3 4))))))
