;; 99fa7670

(DET &bg DominantColor)

(DET &dir DirDomain)

(DET &sense SenseDomain)

(RULE &legs_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Line fill: each dot casts its color toward &dir through bg; the next
;; dot occludes.
(INIT &legs Ray
  (source (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P)
    (NOT (&legs_blocked P)))
  (dir (D)
    (&dir *D)))

(RULE &leg
  (&legs.ray *P (:Origin *Src))
  (input (:P Src) *Col))

(RULE &bends_blocked
  (&leg *P))

;; At the &dir edge the fill bends and runs along the edge; legs occlude.
(INIT &bends Ray
  (source (P)
    (&leg *P)
    (&dir *D)
    (margin (:B P) D (:K 0)))
  (node (P)
    (input *P)
    (NOT (&bends_blocked P)))
  (dir ((:D D2))
    (&dir *D)
    (&sense *S)
    (turn S D *D2)))

(RULE &bend
  (&bends.ray *P (:Origin *Src))
  (&leg (:P Src) *Col))

(RULE &output
  (OR ((&leg *P *Col))
      ((&bend P Col))
      ((input P Col)
       (NOT (&leg P))
       (NOT (&bend P)))))
