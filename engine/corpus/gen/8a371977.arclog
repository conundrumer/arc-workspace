;; 8a371977

(DET &bg UnchangedColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &off_line
  (&ink *P)
  (axis_elem *A)
  (split P A (:Along *L)))

(RULE &cut_divider
  (input *P)
  (axis_elem *A)
  (split P A (:Along *L))
  (NOT (&off_line A L)))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D *K)
  (&cut_rank.rank (:key D) (:t K) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET &ring AnyOutNewColor)

(DET &within AnyOutNewColor)

;; The tile arrangement: the tile positions of the parts that hold ink.
(INIT &lattice BoundingBox
  (cell ((:P T))
    (&ink *P)
    (&cut_tile_of P (:P_tile *T))))

(RULE &ring_cell
  (&ink *P)
  (&cut_tile_of P (:P_tile *T))
  (&lattice.box *B)
  (inside (:A T) B)
  (same_dist (:P1 T) (:P2 B)))

(INIT &blob Connectivity
  (node (P)
    (&ink *P)))

(ALTS $choice "what a tile is, and how the ring tiles are found" $Lattice
  (ALT $Blobs
    (INIT &hull BoundingBox
      (cell (P)
        (&ink *P)))

    ;; P shares a tile with a cell on the hull's edge.
    (RULE &ring_cell
      (&blob.connected *P *Q)
      (&hull.box *B)
      (inside (:A Q) B)
      (same_dist (:P1 Q) (:P2 B))))
  (ALT $Sight
    (RULE &ring_cell
      (&blob.component *P *Id)
      (dir_elem *D)
      (ALL ((&blob.component (:P *Pm) Id)
            (&blob.component (:P *Q) (:Id *Id2))
            (axis_of D *A)
            (same_line A (:P Pm) Q)
            (nearer D (:P Q) (:Q Pm)))
           ((= Id Id2))))))

(RULE &output
  (OR ((input *P *Col)
       (&bg (:C Col)))
      ((&ring_cell P)
       (&ring (:C Col)))
      ((&ink P)
       (NOT (&ring_cell P))
       (&within (:C Col)))))
