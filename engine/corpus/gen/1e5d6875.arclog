;; 1e5d6875

(DET &bg DominantColor)

(INIT &parts2 Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &piece_cell2
  (&parts2.component (:key *Col) *P *Id))

(RULE &cell
  (&piece_cell2 *Col *Id *P))

(INIT &bbox BoundingBox
  (key ((&cell ^Col ^Id *P))
    (cell (P)
      (&cell Col Id *P))))

(RULE &corner_cell
  (&cell *Col *Id *P)
  (&bbox.box (:key Col Id) *B)
  (inside (:A P) B)
  (same_corner (:D *Diag) (:P1 P) (:P2 B)))

(RULE &open_diag
  (&cell *Col *Id)
  (diag_dir_elem (:D *Diag))
  (NOT (&corner_cell Col Id Diag)))

(DET &painted
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col2))
  (!= Col Col2))

(INIT &parts Connectivity
  (key ((ex_input ^E *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (ex_input E *P Col)
      (NOT (&bg (:C Col))))))

(DET &piece_cell
  (&parts.component (:key *E *Col) *P *Id))

;; The piece's shape among the repainted cells: its copy. A copy cell past
;; the frame drops, so each cell just past the frame counts as a copy cell.
(INIT &copy Occurrences
  (key ((&piece_cell ^E ^Col ^Id *P))
    (cell ((:P Q))
      (&piece_cell E Col Id *P)
      (OR ((&painted E (:P *Q)))
          ((diag_dir_elem *D)
           (neighbor P D Q)
           (NOT (ex_input E (:P Q))))))
    (shape (P)
      (&piece_cell E Col Id *P))))

(DET &piece_step
  (&open_diag *E (:Col *Src) *Id (:Diag *Open))
  (&copy.occurrence (:key E (:Col Src) Id) (:P *V))
  (diag_dir_elem (:D *Dir))
  (step_offset (:D Dir) V))

;; The rotation that turns a piece's open corner to its step, one per
;; step: the rotations act on the corners freely and transitively.
(INIT &turn Singleton
  (key ((&piece_step (:Src ^Col) (:Open *Diag) (:Dir *D))
        (c4_elem (:D *Rot))
        (apply_diag_dir (:D Rot) (:Dir Diag) (:Dir_out D)))
    (member ((:v Rot))
      (&piece_step (:Src Col) (:Open *Diag) (:Dir *D))
      (c4_elem (:D *Rot))
      (apply_diag_dir (:D Rot) (:Dir Diag) (:Dir_out D)))))

(DET &rot
  (&turn.value (:key (:Col *Src)) (:v *D)))

(RULE &step_dir
  (&open_diag *Col *Id *Diag)
  (&rot (:Src Col) (:D *Rot))
  (apply_diag_dir (:D Rot) (:Dir Diag) (:Dir_out *Dir)))

(DET &copy_land
  (&piece_cell *E *Col *Id (:P *P2))
  (diag_dir_elem (:D *Dir))
  (neighbor (:P P2) (:D Dir) (:Q *P))
  (ex_input E P))

(DET &copy_cell
  (&copy_land *E *Col *Id (:Dir *D) *P)
  (&open_diag E Col Id *Diag)
  (&piece_step (:Src Col) (:Open Diag) (:Dir D)))

(DET &copy_color
  (&copy_cell *E (:Col *O_col) *Id (:P *Q))
  (&painted E (:P Q) *Col))

(DET &mark_missing
  (&copy_color (:O_col *Src) *Col)
  (&copy_color (:E *E2) (:O_col Src) (:Id *Id2))
  (NOT (&copy_color (:E E2) (:O_col Src) (:Id Id2) Col)))

(DET &mark
  (&copy_color (:O_col *Src) *Col)
  (NOT (&mark_missing Src Col)))

(RULE &mark_cell
  (&piece_cell2 (:Col *Col2) *Id (:P *P2))
  (&step_dir (:Col Col2) Id (:Dir *D))
  (&mark (:Src Col2) *Col)
  (neighbor (:P P2) D (:Q *P))
  (input P))

(DET &copy_at
  (&copy_cell *E (:Col *Col2) *P)
  (&mark (:Src Col2) *Col))

(INIT &prec Order
  (member ((:t M))
    (&mark (:Col *M)))
  (before ((:a M) (:b M2))
    (&copy_at *E *P (:Col *M))
    (&copy_at E P (:Col *M2))
    (!= M M2)
    (ex_output E P (:Col M))))

(DET &mark_rank
  (&prec.rank (:t *Col) *R))

(INIT &win Order
  (key ((&mark_cell ^P (:Col *M))
        (&mark_rank (:Col M) *R))
    (member ((:t (:V M) (:S R)))
      (&mark_cell P (:Col *M))
      (&mark_rank (:Col M) *R))
    (score ((:t (:V M) (:S R)) (:S R))
      (&mark_cell P (:Col *M))
      (&mark_rank (:Col M) *R))))

(ALTS $choice "a copy landing on a piece cell" $Keep
  (ALT $Cover
    (RULE &output
      (input *P (:Col *Col_in))
      (OR ((&win.minimal (:key P) (:t (:V *Col))))
          ((NOT (&mark_cell P))
           (= Col Col_in))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&bg (:C Col))))
      ((input P (:Col *Bg))
       (&bg (:C Bg))
       (OR ((&win.minimal (:key P) (:t (:V Col))))
           ((NOT (&mark_cell P))
            (= Col Bg))))))
