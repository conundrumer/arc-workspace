;; 42918530

(DET &bg DominantColor)

(RULE &lattice_divider
  (input *P)
  (axis_elem *A)
  (split P A (:Along *L))
  (ALL ((input (:P *Pm) *Col)
        (split (:P Pm) A (:Along L)))
       ((&bg (:C Col)))))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &box_of
  (&lattice_tile_of *P (:P_tile *T)))

(INIT &bbox BoundingBox
  (key ((&box_of *P ^T))
    (cell (P)
      (&box_of *P T))))

(RULE &box_view
  (&box_of *P *T)
  (&bbox.box (:key T) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &box_color
  (&box_of *P *T)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &outline
  (&box_view *P_intile)
  (dir_elem *D)
  (margin (:B P_intile) D (:K 0)))

(RULE &ink
  (&box_view *T *P *P_intile)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &design
  (&ink *T *P_intile)
  (NOT (&outline P_intile)))

(RULE &group_design
  (&box_color *T *Col)
  (&design T *P_intile))

(RULE &show
  (OR ((&ink *T *P_intile))
      ((&box_color T *Col)
       (NOT (&design T))
       (&group_design Col P_intile))))

(ALTS $choice "which boxes of a group take the group's design" $Fill
  (ALT $Merge
    (RULE &show
      (OR ((&box_color *T *Col)
           (&group_design Col *P_intile))
          ((&ink T P_intile))))))

(RULE &output
  (OR ((&box_view *T *P *P_intile)
       (OR ((&show T P_intile)
            (&box_color T *Col))
           ((NOT (&show T P_intile))
            (&bg (:C Col)))))
      ((input P)
       (NOT (&box_of P))
       (&bg (:C Col)))))
