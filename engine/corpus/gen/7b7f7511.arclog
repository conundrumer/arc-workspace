;; 7b7f7511

(DET &copies TileCount)

(INIT &dup_cell_division Division
  (key ((axis_elem ^A))
    (parts (A N)
      (&copies *N)))
  (cell (P)
    (input *P)))

;; The grid as &copies slabs along A: what each within-slab cell holds.
(INIT &dup_cell Singleton
  (key ((input *P *Col)
        (&dup_cell_division.tile (:key ^A) P ^P_inner))
    (member ((:v Col))
      (input *P *Col)
      (&dup_cell_division.tile (:key A) P P_inner))))

(RULE &dup_mismatch
  (&dup_cell.plural (:key *A)))

(ALTS $choice "how the repeat count is fixed" $Dup
  (ALT $Tile
    (INIT &tile_cell_division Division
      (key ((input *P)
            (sub_extent P ^A ^K))
        (cell (P)
          (input *P)
          (sub_extent P A K))
        (side (A K)
          (input *P)
          (sub_extent P A K))))

    ;; The grid as K-sized slabs along A, for every proper K: what each
    ;; within-slab cell holds.
    (INIT &tile_cell Singleton
      (key ((input *P *Col)
            (&tile_cell_division.tile (:key ^A ^K) P ^P_inner))
        (member ((:v Col))
          (input *P *Col)
          (&tile_cell_division.tile (:key A K) P P_inner))))

    (RULE &tile_mismatch
      (&tile_cell.plural (:key *A *K)))

    (RULE &output
      (&tile_cell.value (:key *A *K (:P_inner *P)) (:v *Col))
      (NOT (&tile_mismatch A K)))))

(RULE &output
  (&dup_cell.value (:key *A (:P_inner *P)) (:v *Col))
  (NOT (&dup_mismatch A)))
