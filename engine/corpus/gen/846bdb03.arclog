;; 846bdb03

(DET &bg DominantColor)

(DET &corner RarestColor)

;; The orientations the shape may take: the reflection group that swaps the bars.
(DET &sym SymDomain)

(RULE &transform
  (&sym *S)
  (sym_member S (:D *T)))

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&corner (:C Col))))

(RULE &boxed
  (input *P)
  (&bbox.box *B)
  (inside (:A P) B))

(RULE &cropped
  (input (:P *P2) *Col)
  (&bbox.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(RULE &bar
  (&cropped *P *Col)
  (dir_elem *D)
  (margin (:B P) D (:K 0))
  (NOT (&bg (:C Col)))
  (NOT (&corner (:C Col))))

;; The box off its border, in its own frame.
(INIT &core BoundingBox
  (cell (P)
    (&cropped *P)
    (interior (:A P) (:B 0))))

(INIT &shape BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&boxed P))))

(RULE &placed
  (input *P *Col)
  (&shape.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner3))
  (&transform *T)
  (apply (:D T) (:P P_inner3) (:P_out *P_inner)))

(RULE &touches
  (&bar *D *Col)
  (&placed *T (:P_inner *P) Col)
  (margin (:B P) D (:K 0)))

(RULE &output
  (OR ((&cropped *P *Col)
       (NOT (&core.cell P)))
      ((&core.cell P)
       (&core.box *B)
       (inside (:A P) B)
       (relative (:Base B) (:X P) (:X_rel *P_inner))
       (&placed *T P_inner Col)
       (ALL ((&bar *D (:Col *Colm)))
            ((&touches T D (:Col Colm)))))))
