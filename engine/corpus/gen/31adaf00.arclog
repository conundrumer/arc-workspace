;; 31adaf00

(DET &bg DominantColor)

(DET &mark AnyOutNewColor)

;; The smallest square drawn.
(DET &min_side TileCount)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &span BoundingBox
  (key ((&bg_cell ^P)
        (&bg_cell (:P ^Q)))
    (cell ((:P R))
      (OR ((= *R P))
          ((= R Q))))))

(RULE &square
  (&span.cell (:key (:P *K_p) (:Q *K_q)) *P)
  (&span.box (:key (:P K_p) (:Q K_q)) *B)
  (perp *A *A2)
  (box_extent B P A *N)
  (box_extent B P (:A A2) N)
  (&min_side (:N *M))
  (>= N M))

(RULE &bg_square
  (&square *B *N)
  (ALL ((input *P *Col)
        (inside (:A P) B))
       ((&bg (:C Col)))))

(RULE &painted
  (&bg_square *B)
  (ALL ((&bg_square B *N)
        (&bg_square (:B *B2) (:N *N2))
        (input (:P *Pm))
        (inside (:A Pm) B)
        (inside (:A Pm) (:B B2)))
       ((<= N2 N)))
  (input *P)
  (inside (:A P) B))

(RULE &output
  (OR ((&painted *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
