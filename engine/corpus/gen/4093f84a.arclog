;; 4093f84a

(DET &bg DominantColor)

(DET &stripe UnchangedColor)

(RULE &stripe_cell
  (input *P *Col)
  (&stripe (:C Col)))

(RULE &dot
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stripe (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&stripe_cell *P)))

(RULE &side
  (&bbox.box *B)
  (axis_elem *A)
  (split (:P B) A (:Along 0))
  (perp A *A2)
  (axis_of *D (:A A2)))

;; The stripe's outermost cell on each side casts out along its line.
(INIT &spread Ray
  (key ((&side ^D))
    (source (P)
      (&stripe_cell *P)
      (&bbox.box *B)
      (inside (:A P) B)
      (same_dist D (:P1 P) (:P2 B))))
  (node (P)
    (input *P)))

(RULE &spread_cell
  (&side (:D *Key))
  (input *P))

(RULE &outward
  (&spread.ray (:key *D) *P D (:K *N) (:Origin *Src))
  (&spread_cell (:Key D) P))

(INIT &pile Cardinality
  (key ((&outward *P ^D ^Src)
        (&dot P))
    (member ((:m P))
      (&outward *P D Src)
      (&dot P))))

(RULE &dots
  (&pile.size (:key *D *Src) *N))

(RULE &growth
  (&dots *D *Src (:N *Len)))

(ALTS $choice "what the dots on one side of one line set" $Count
  (ALT $Table
    ;; The cells the output grew out of the stripe on that line.
    (INIT &grown Cardinality
      (key ((&outward ^E *P ^D (:N *K) ^Src)
            (!= K 0)
            (ex_output E P *Col)
            (&stripe (:C Col)))
        (member ((:m P))
          (&outward E *P D (:N *K) Src)
          (!= K 0)
          (ex_output E P *Col)
          (&stripe (:C Col)))))

    (DET &length
      (&dots *E *D *Src *N)
      (&grown.size (:key E D Src) (:N *Len)))

    (RULE &growth
      (&dots *D *Src *N)
      (&length N *Len))))

(RULE &painted
  (OR ((&stripe_cell *P))
      ((&outward P *D (:N *K) *Src)
       (!= K 0)
       (&growth D Src (:Len *N))
       (<= K N))))

(RULE &output
  (input *P)
  (IF ((&painted P))
      ((&stripe (:C *Col)))
      ((&bg (:C Col)))))
