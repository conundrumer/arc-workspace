;; 15663ba9

(DET &bg DominantColor)

(DET &open_paint AnyOutNewColor)

(DET &enclosed_paint AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &outside Flood
  (node (P)
    (&bg_cell *P))
  (source (P)
    (&bg_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))))

(INIT &rim Boundary
  (cell (P)
    (&ink *P)))

(RULE &arm
  (&ink *P)
  (dir_elem *D)
  (NOT (&rim.exposed P D)))

(RULE &bend
  (diag_dirs (:D *Arms) *D1 *D2)
  (&arm *P (:D D1))
  (&arm P (:D D2))
  (diag_opposite (:D *Open) (:Opp Arms)))

(RULE &faces_open
  (&bend *P *Open)
  (corner_dir (:C Open) *D)
  (neighbor P D *Q)
  (ALL ()
       ((&outside.reached (:P Q)))))

(RULE &output
  (OR ((&bend *P)
       (IF ((&faces_open P))
           ((&open_paint (:C *Col)))
           ((&enclosed_paint (:C Col)))))
      ((input P Col)
       (NOT (&bend P)))))
