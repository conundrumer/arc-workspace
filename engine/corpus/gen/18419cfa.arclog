;; 18419cfa

(DET &frame UnchangedColor)

(DET &ink RarestColor)

(INIT &closed Enclosure
  (cell (P)
    (input *P *Col)
    (NOT (&frame (:C Col)))))

(DET &cell
  (ex_output *E *P *Col))

(INIT &closed2 Enclosure
  (key ((&cell ^E *P *Col)
        (NOT (&frame (:C Col))))
    (cell (P)
      (&cell E *P *Col)
      (NOT (&frame (:C Col))))))

(INIT &bbox BoundingBox
  (key ((&closed.enclosed *P ^Id))
    (cell (P)
      (&closed.enclosed *P Id))))

(INIT &bbox2 BoundingBox
  (key ((&closed2.enclosed (:key (:E ^K)) *P ^Id))
    (cell (P)
      (&closed2.enclosed (:key (:E K)) *P Id))))

(DET &inner2
  (&closed2.enclosed (:key *E) *P *Id)
  (&bbox2.box (:key (:K E) Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &inner
  (&closed.enclosed *P *Id)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &ink_cell
  (input *P *Col)
  (&ink (:C Col))
  (&inner *Id P *P_inner))

(DET &ink_out
  (ex_output *E *P *Col)
  (&ink (:C Col))
  (&inner2 E *Id P *P_inner))

(INIT &inv Agreement
  (key ((&ink_out ^E ^Id *P_inner))
    (source ((:i P_inner))
      (&ink_out E Id *P_inner))
    (target ((:i P_inner))
      (&ink_out E Id *P_inner))
    (correspondence ((:m D) (:i P_inner) (:j Q))
      (&ink_out E Id *P_inner)
      (d4_elem *D)
      (apply D (:P P_inner) (:P_out *Q)))))

;; The group whose members are exactly the transforms every finished
;; pattern is invariant under.
(INIT &grp Inclusion
  (pattern ((:pattern S) (:m D))
    (sym_member *S *D))
  (observed ((:m D))
    (d4_elem *D)
    (NOT (&inv.mismatch (:m D)))))

(DET &sym
  (&grp.equal (:pattern *S)))

(RULE &flip
  (&ink_cell *Id)
  (&sym *S)
  (sym_member S *D))

(ALTS $choice "which mirrors apply" $Group
  (ALT $OneSided
    (RULE &one_sided
      (&ink_cell *Id)
      (dir_elem *D)
      (ALL ((&ink_cell Id *P_inner)
            (dist_pair (:P P_inner) D *K *K2))
           ((< K K2))))

    (RULE &flip
      (&one_sided *Id (:D *D2))
      (axis_of (:D D2) *A)
      (axis_inversion A (:T *D))))
  (ALT $Doorway
    (RULE &doorway
      (&closed.enclosed *P *Id)
      (&frame (:C *Wall))
      (opposite *D (:Opp *D2))
      (axis_of D (:A *A2))
      (perp (:A A2) (:A2 *A))
      (neighbor P D (:Q *Q1))
      (input (:P Q1) (:Col Wall))
      (neighbor P (:D D2) (:Q *Q2))
      (input (:P Q2) (:Col Wall)))

    (RULE &flip
      (&doorway *Id *A)
      (axis_inversion A (:T *D)))))

(RULE &paint
  (&ink_cell *Id *P_inner)
  (&flip Id *D)
  (apply D (:P P_inner) (:P_out *P_inner2))
  (&inner Id *P (:P_inner P_inner2)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&paint P)))
      ((&paint P)
       (&ink (:C Col)))))
