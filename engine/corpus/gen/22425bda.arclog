;; 22425bda

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &collinear
  (&ink *P)
  (&ink (:P *Q))
  (axis4_elem *A)
  (same_line A P Q))

(RULE &family
  (&ink *Col)
  (axis4_elem *A)
  (ALL ((&ink Col *P)
        (&ink Col (:P *Q)))
       ((&collinear A P Q))))

(RULE &line
  (&family *Col *A)
  (&ink Col (:P *Q))
  (input *P)
  (same_line A P Q))

(RULE &hides
  (&line (:Col *Hi) *P)
  (&line (:Col *Lo) P)
  (!= Hi Lo)
  (input P (:Col Hi)))

;; Above through any run of crossings, from each color.
(INIT &above Propagation
  (key ((&ink ^Col)))
  (edge ((:a Lo) (:b Hi))
    (&hides *Hi *Lo)))

;; Stack order: below through any run of crossings.
(INIT &stack Order
  (member ((:t Col))
    (&ink *Col))
  (before ((:a Lo) (:b Hi))
    (&above.reached (:key (:Col *Lo)) (:n *Hi))
    (!= Lo Hi)))

(INIT &row_size Cardinality
  (member ((:m R))
    (&stack.rank *R)))

;; The edge the bottom of the stack sits at.
(DET &stack_dir DirDomain)

(INIT &row_frame Frame
  (extent (A N)
    (&stack_dir *D)
    (axis_of D *A)
    (&row_size.size *N)))

(RULE &row_pos
  (&row_frame.cell *P)
  (&stack_dir *D)
  (margin (:B P) D *K)
  (&stack.rank (:R K)))

(RULE &output
  (&stack.rank (:t *Col) *R)
  (&row_pos (:K R) *P))
