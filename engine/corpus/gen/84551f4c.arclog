;; 84551f4c

(DET &bg DominantColor)

;; The edge the bars stand on.
(DET &ground DirDomain)

;; The color whose bars topple on their own.
(DET &pusher RarestColor)

;; The sense a bar turns in when it topples.
(DET &topple SenseDomain)

(RULE &up
  (&ground (:D *G))
  (opposite (:D G) (:Opp *D)))

(RULE &fall
  (&up (:D *U))
  (&topple *S)
  (turn S (:D U) (:D2 *D)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &base
  (&ink *P)
  (&ground (:D *G))
  (margin (:B P) (:D G) (:K 0)))

;; The run of ink rising from each base.
(INIT &rise Ray
  (source (P)
    (&ink *P))
  (node (P)
    (&ink *P))
  (dir (D)
    (&up *D)))

(RULE &bar_cell
  (&base (:P *P_base))
  (OR ((&rise.ray *P (:K *N) (:Origin P_base))
       (> N 0))
      ((= P P_base))))

(RULE &fallen
  (&bar_cell *P_base (:P *P2))
  (input (:P P2) *Col)
  (&topple *S)
  (c4_turn S (:T *R4))
  (relative (:Base P_base) (:X P2) (:X_rel *V))
  (apply (:D R4) (:P V) (:P_out *V2))
  (compose (:A P_base) (:B V2) (:C *P)))

;; The bars that topple: the pusher's bars, then each standing bar that a
;; toppled bar's landed cell touches in the fall direction.
(INIT &chain Propagation
  (source ((:n P_base))
    (&base (:P *P_base))
    (input (:P P_base) *Col)
    (&pusher (:C Col)))
  (edge ((:a P_base) (:b P_base2))
    (&fallen *P_base *P)
    (&fall *D)
    (neighbor P D *Q)
    (&bar_cell (:P_base *P_base2) (:P Q))))

(RULE &toppled
  (&chain.reached (:n *P_base)))

(RULE &landed
  (&toppled *P_base)
  (&fallen P_base *P *Col))

(RULE &cleared
  (&toppled *P_base)
  (&bar_cell P_base *P))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&landed P *Col))
      ((NOT (&landed P))
       (&cleared P)
       (&bg (:C Col)))
      ((NOT (&landed P))
       (NOT (&cleared P))
       (= Col Col_in))))
