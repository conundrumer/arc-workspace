;; 80af3007

(DET &ink RarestColor)

;; The picture: the box the ink occupies.
(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&ink (:C Col))))

;; A pixel's side, in cells.
(DET &scale TileCount)

(INIT &pixel_cell_division Division
  (cell ((:P P_inner))
    (input *P)
    (&bbox.box *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner)))
  (side (A K)
    (axis_elem *A)
    (&scale (:N *K))))

(RULE &pixel_cell
  (input *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&pixel_cell_division.tile (:P P_inner) (:P_outer *P_tile)))

(RULE &pixel
  (&pixel_cell *P_tile))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&pixel *P_tile))
  (inner ((:P P_intile))
    (&pixel (:P_tile *P_intile))))

(DET &bg DominantColor)

(RULE &inked
  (&pixel_cell *P *P_tile)
  (input P *Col)
  (&ink (:C Col)))

(RULE &cell
  (&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))

(RULE &stamp
  (&cell (:P_grid *P) *P_tile *P_intile)
  (&inked P_tile)
  (&inked (:P_tile P_intile)))

(RULE &output
  (&cell (:P_grid *P))
  (IF ((&stamp P))
      ((&ink (:C *Col)))
      ((&bg (:C Col)))))
