;; 20270e3b

(DET &bg ColorDomain)

(DET &socket_color VanishedColor)

(INIT &pieces Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (diag_dir_elem *D)
    (step_offset D (:V *S))))

(RULE &piece
  (&pieces.component *P *Id))

(RULE &wall
  (&piece *Id *P)
  (input P *Col)
  (NOT (&socket_color (:C Col))))

(RULE &socket
  (&piece *Id *P)
  (input P *Col)
  (&socket_color (:C Col)))

(INIT &socket_box BoundingBox
  (key ((&socket ^Id *P))
    (cell (P)
      (&socket Id *P))))

(RULE &seat
  (&piece (:Id *M) *P)
  (&socket_box.box (:key (:Id M)) (:B *B_m))
  (relative (:Base B_m) (:X P) (:X_rel *P_rel))
  (&socket_box.box (:key (:Id *H)) (:B *B_h))
  (!= H M)
  (compose (:A B_h) (:B P_rel) (:C *P_reg))
  (dir_elem *D)
  (neighbor (:P P_reg) D (:Q *P_seat)))

(RULE &laid_wall
  (OR ((&seat *H *M *D)
       (&wall (:Id H) *P *Col))
      ((&seat H M D (:P *P2) (:P_seat P))
       (&wall (:Id M) (:P P2) Col))))

(RULE &laid_socket
  (OR ((&seat *H *M *D)
       (&socket (:Id H) *P))
      ((&seat H M D (:P *P2) (:P_seat P))
       (&socket (:Id M) (:P P2)))))

(RULE &figure
  (&laid_wall *H *M *D *P *Col)
  (ALL ((&laid_socket H M D (:P *Pm)))
       ((&laid_wall H M D (:P Pm)))))

(INIT &figure_box BoundingBox
  (key ((&figure ^H ^M *P))
    (cell (P)
      (&figure H M *P))))

(RULE &painted
  (&figure *H *M (:P *P2) *Col)
  (&figure_box.box (:key H M) *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(INIT &sheet Frame
  (extent (A N)
    (&figure_box.box (:key (:H *J_h) (:M *J_m)) *B)
    (&figure_box.cell (:key (:H J_h) (:M J_m)) *P)
    (axis_elem *A)
    (box_extent B P A *N)))

(RULE &output
  (&sheet.cell *P)
  (OR ((&painted P *Col))
      ((NOT (&painted P))
       (&bg (:C Col)))))
