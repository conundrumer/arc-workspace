;; 91413438

(DET &bg SharedColor)

(INIT &side Cardinality
  (member ((:m P))
    (input *P *Col)
    (&bg (:C Col))))

(INIT &tiles Frame
  (extent (A (:N S))
    (axis_elem *A)
    (&side.size (:N *S))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tiles.cell (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &lex_corner DiagDirDomain)

(DET &lex_axis AxisDomain)

(INIT &copy_count Cardinality
  (member ((:m P))
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &lex Order
  (member ((:t P))
    (&tiles.cell *P))
  (before ((:a P) (:b P2))
    (&tiles.cell *P)
    (&tiles.cell (:P *P2))
    (&lex_corner *D)
    (&lex_axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (nearer (:D D2) P (:Q P2)))
        ((diag_dirs D A (:D1 D2) (:D2 *D22))
         (same_dist (:D D2) (:P1 P) P2)
         (nearer (:D D22) P (:Q P2))))))

(RULE &copy
  (&lex.rank (:t *P_tile) *R)
  (&copy_count.size *N)
  (< R N))

(RULE &output
  (&output_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) *P)
  (input (:P P_intile) (:Col *Col_in))
  (OR ((NOT (&copy P_tile))
       (&bg (:C *Col)))
      ((&copy P_tile)
       (= Col Col_in))))
