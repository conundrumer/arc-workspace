;; 252143c9

(RULE &dp_nearer
  (input *P)
  (dir_elem *D)
  (dist_pair P D *K *K2)
  (< K K2))

(RULE &dp_quadrant
  (diag_dirs (:D *Diag) *D1 *D2)
  (&dp_nearer *P (:D D1))
  (&dp_nearer P (:D D2)))

(DET &bg DominantColor)

(RULE &center
  (input *P)
  (centered P))

(RULE &quad_color
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&dp_quadrant P *Diag))

(RULE &target
  (&center *P)
  (input P *Col)
  (&quad_color *Diag Col))

(INIT &ray Ray
  (source (P)
    (&center *P))
  (node (P)
    (input *P))
  (dir (D)
    (&target (:Diag *D))))

(RULE &output
  (input *P)
  (IF ((&ray.ray P))
      ((&target *Col))
      ((&bg (:C Col)))))
