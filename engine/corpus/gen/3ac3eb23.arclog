;; 3ac3eb23

(DET &bg DominantColor)

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col))))

(DET &mark
  (ex_input *E *P *Col)
  (NOT (&bg (:C Col)))
  (ex_output E))

(DET &off_edge
  (&mark *P)
  (dir_elem *D)
  (NOT (margin (:B P) D (:K 0))))

(DET &dir
  (dir_elem *D)
  (NOT (&off_edge D)))

(RULE &seed
  (&marker *P *Col)
  (&dir (:D *E))
  (opposite (:D E) (:Opp *D)))

(RULE &trail_cell_ray
  (input *P))

(DET &offset
  (&mark *E *P *Col)
  (ex_output E (:P *Q) Col)
  (relative (:Base P) (:X Q) (:X_rel *Delta)))

(DET &radius
  (&offset *E *P *Delta)
  (&dir *D)
  (margin (:B Delta) D (:K *I))
  (perp_dir D (:D2 *Ds))
  (margin (:B Delta) (:D Ds) (:K *R))
  (>= R 0))

(DET &cand
  (&radius (:I *W))
  (!= W 0))

(DET &differ
  (&radius *E *P *I *R)
  (&radius E P (:I *I2))
  (NOT (&radius E P (:I I2) R)))

(DET &mismatch
  (&cand *W)
  (&differ *I *I2)
  (divide (:T I) (:Side W) (:Gap 0) (:Remainder *K))
  (divide (:T I2) (:Side W) (:Gap 0) (:Remainder K)))

;; The shortest period no trail breaks.
(INIT &unbroken Order
  (member ((:t W))
    (&cand *W)
    (NOT (&mismatch W)))
  (score ((:t W) (:S W))
    (&cand *W)
    (NOT (&mismatch W))))

(DET &period
  (&unbroken.minimal (:t *N)))

(DET &step_cells
  (&period (:N *K)))

(ALTS $choice "how each marker's trail is cast" $Parity
  (ALT $Parity
    (ALTS $s "marker edge — the trail extends away from it" $Dir
      (ALT $Edge
        (RULE &seed
          (&marker *P *Col)
          (dir_elem (:D *E))
          (margin (:B P) (:D E) (:K 0))
          (opposite (:D E) (:Opp *D))))))
  (ALT $Walk
    (RULE &lit
      ;; Two zigzag walks from the marker, one per side: each step goes one cell on
      ;; and one to the side, and the side flips each step, so a walk stands on the
      ;; trail at the end of each step and to its side between. A walk with no
      ;; room on its side stops at the marker.
      (OR ((&seed *Col *P))
          ((&trail_cell Col *D *Src (:P *P2) *K)
           (perp_dir D (:D2 *Ds))
           (neighbor (:P Src) (:D Ds) (:Q *Q0))
           (input (:P Q0))
           (&step_cells (:K *N))
           (divide (:T K) (:Side N) (:Gap 0) (:Remainder *J))
           (OR ((!= J 0)
                (neighbor (:P P2) (:D Ds) (:Q P))
                (input P))
               ((= J 0)
                (= P P2)))))))
  (ALT $Banner
    (DET &slot
      (&radius (:I *K))
      (&period *N)
      (< K N))

    (INIT &slots Order
      (member ((:t K))
        (&slot *K))
      (score ((:t K) (:S K))
        (&slot *K)))

    ;; The slot cycle, advanced once per step along the trail.
    (INIT &slot_walk Walk
      (successor ((:p K) (:p_next K2))
        (&slots.cyclic_successor (:a *K) (:b *K2)))
      (steps ((:N I))
        (&trail.ray *P (:K *I))
        (&trail_cell_ray P)))

    (DET &banner
      (&radius *I *R)
      (&period *N)
      (divide (:T I) (:Side N) (:Gap 0) (:Remainder *K)))

    ;; Light each slot's radius, both sides of the line: the trail cell K steps
    ;; out takes the slot K steps around the cycle.
    (RULE &lit
      (&trail_cell *Col *D (:P *P2) (:K *I))
      (&slot_walk.walk (:p0 0) (:N I) (:p *K))
      (&banner K *R)
      (perp_dir D (:D2 *Ds))
      (jump (:P P2) (:D Ds) (:K R) (:Q *P))
      (input P)))
  (ALT $Stamp
    (DET &template
      (&offset *Delta))

    (RULE &lit
      (&marker (:P *P2) *Col)
      (&template (:Delta *Off))
      (compose (:A P2) (:B Off) (:C *P))
      (input P))))

;; The trail: the cells from each marker away from its edge.
(INIT &trail Ray
  (source (P)
    (&seed *P))
  (node (P)
    (&seed *D)
    (input *P))
  (dir (D)
    (&seed *D)))

(RULE &trail_cell
  (&trail.ray *P *D *K (:Origin *Src))
  (&trail_cell_ray P)
  (&seed *Col D (:P Src)))

(RULE &center
  (&trail_cell *Col *D *P *K)
  (&step_cells (:K *N))
  (divide (:T K) (:Side N) (:Gap 0) (:Remainder 0)))

(RULE &lit
  (OR ((&center *Col *P))
      ;; Flanks: the diagonal neighbors of each center, ahead of it.
      ((&center Col *D (:P *P2))
       (corner_dir (:C *Diag) D)
       (neighbor (:P P2) (:D Diag) (:Q P))
       (input P))))

(RULE &output
  (OR ((&lit *P *Col))
      ((input P)
       (NOT (&lit P))
       (&bg (:C Col)))))
