;; ac0a08a4

(DET &bg DominantColor)

(RULE &on
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &cell_count Cardinality
  (member ((:m P))
    (&on *P)))

(INIT &block Frame
  (extent (A N)
    (axis_elem *A)
    (&cell_count.size *N)))

(ALTS $choice "how N is counted" $Cells
  (ALT $Colors
    (INIT &palette Cardinality
      (member ((:m Col))
        (&on *Col)))

    (INIT &block Frame
      (extent (A N)
        (axis_elem *A)
        (&palette.size *N)))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&block.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&block.cell (:P *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
