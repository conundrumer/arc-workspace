;; aa300dc3

(INPUT hole "a connected region of &hole_color cells sits inside a field of 5 that includes the whole border ring of the grid"

  (DET_OR_RULE &hole_color RarestColor)

  ;; The one color of the border ring.
  (INIT &ring Singleton
    (member ((:v Col))
      (input *P *Col)
      (dir_elem *D)
      (margin (:B P) D (:K 0))))

  (RULE_OR_DET &ring.value "The one color of the border ring.")

  ;; The one color off the ring's color.
  (INIT &other Singleton
    (member ((:v Col))
      (input *Col)
      (NOT (&ring.value (:v Col))))))

(INPUT diagonal-runs "the hole cells form maximal runs along each of the two diagonal axes; a run ends where the next cell along its diagonal is not a hole cell")

(OUTPUT longest-run "the longest diagonal run, over both diagonal axes, is painted &paint_color; every other cell keeps its color"

  (DET &paint_color AnyOutNewColor)

  ;; The edge whose two corners anchor the competing lines.
  (DET &anchor_edge DirDomain)

  (RULE &hole
    (&hole_color (:C *Col))
    (input *P Col))

  (INIT &arena Quotient
    (equivalent ((:a P) (:b Q))
      (&hole *P)
      (&hole (:P *Q))))

  (RULE &arena_cell
    (&arena.class (:a *P) (:Id *A)))

  (RULE &cell
    (&arena_cell (:A *K) *P))

  (RULE &diag_step
    (&cell *K *P)
    (diag_axis_of *D *Da)
    (neighbor P D *Q)
    (&cell K (:P Q)))

  (RULE &link
    (&diag_step *K *Da *P *Q))

  ;; A segment is what the links connect.
  (INIT &seg Quotient
    (edge ((:a K (:Da DA) P) (:b K (:Da DA) (:P P2)))
      (OR ((&link *K (:Da *DA) *P (:Q *P2)))
          ((&cell K P)
           (diag_axis_elem (:Da DA))
           (= P2 P)))))

  (RULE &segment
    (&seg.class (:a *K *Da *P) (:Id *Sg)))

  (INIT &seg_len Cardinality
    (key ((&segment ^Sg *P))
      (member ((:m P))
        (&segment Sg *P))))

  ;; Distance from a segment's line to the nearer of the two corners it
  ;; separates; the larger it is, the nearer the line passes to the center.
  (INIT &center Order
    (key ((&segment ^Sg (:Da *DA) *P)
          (diag_perp (:Da DA) (:Da2 *DA2))
          (diag_axis_of (:D *Dc) (:Da DA2))
          (corner_dist P (:Diag Dc) *K))
      (member ((:t K))
        (&segment Sg (:Da *DA) *P)
        (diag_perp (:Da DA) (:Da2 *DA2))
        (diag_axis_of (:D *Dc) (:Da DA2))
        (corner_dist P (:Diag Dc) *K))
      (score ((:t K) (:S K))
        (&segment Sg (:Da *DA) *P)
        (diag_perp (:Da DA) (:Da2 *DA2))
        (diag_axis_of (:D *Dc) (:Da DA2))
        (corner_dist P (:Diag Dc) *K))))

  (DET &cell2
    (ex_input *E *P *Col)
    (&hole_color (:C Col))
    (ex_output E))

  (DET &passed2
    (&cell2 *E *P)
    (&cell2 E (:P *Q))
    (diag_dir_elem (:D *Dc))
    (nearer (:D Dc) (:P Q) (:Q P)))

  (RULE &passed
    (&cell *K *P)
    (&cell K (:P *Q))
    (diag_dir_elem (:D *Dc))
    (nearer (:D Dc) (:P Q) (:Q P)))

  (DET &corner2
    (&cell2 *E *P)
    (diag_dir_elem (:D *Dc))
    (NOT (&passed2 E Dc P)))

  (RULE &corner
    (&cell *K *P)
    (diag_dir_elem (:D *Dc))
    (NOT (&passed K Dc P)))

  (RULE &arena_of
    (&arena_cell *A))

  (RULE &anchor
    (&anchor_edge *D)
    (corner_dir (:C *Dc) D))

  (DET &order2
    (ex_output *E)
    (dir_elem (:D *Dp)))

  ;; The first corner cell of corner Dc in the reading from edge Dp: the one
  ;; nearest that edge.
  (INIT &first_cell2 Order
    (key ((&order2 (:E ^K) ^Dp)
          (&corner2 (:E K) ^Dc *P))
      (member ((:t P))
        (&order2 (:E K) Dp)
        (&corner2 (:E K) Dc *P))
      (before ((:a P) (:b Q))
        (&order2 (:E K) Dp)
        (&corner2 (:E K) Dc *P)
        (&corner2 (:E K) Dc (:P *Q))
        (nearer (:D Dp) P Q))))

  (DET &anchored
    (ex_output *E *P *Col)
    (&paint_color (:C Col))
    (&anchor *Dc)
    (&first_cell2.minimal (:key (:K E) *Dp Dc) (:t P)))

  (DET &order_defect
    (&anchored *Dp)
    (ex_output *E)
    (NOT (&anchored E Dp)))

  (DET &pick_dir
    (&anchored (:Dp *D))
    (NOT (&order_defect (:Dp D)))
    (ONE))

  (RULE &order
    (&arena_of (:A *K))
    (&pick_dir (:D *Dp)))

  ;; The first corner cell of corner Dc in the reading from edge Dp: the one
  ;; nearest that edge.
  (INIT &first_cell Order
    (key ((&order ^K ^Dp)
          (&corner K ^Dc *P))
      (member ((:t P))
        (&order K Dp)
        (&corner K Dc *P))
      (before ((:a P) (:b Q))
        (&order K Dp)
        (&corner K Dc *P)
        (&corner K Dc (:P *Q))
        (nearer (:D Dp) P Q))))

  (INIT &region Connectivity
    (node (P)
      (&hole *P)))

  (RULE &cand
    (&segment (:K *Pool) *Sg))

  (INIT &longest Order
    (key ((&cand (:Pool ^A) *Sg)
          (&seg_len.size (:key Sg) *N))
      (member ((:t (:V Sg) (:S N)))
        (&cand (:Pool A) *Sg)
        (&seg_len.size (:key Sg) *N))
      (score ((:t (:V Sg) (:S N)) (:S N))
        (&cand (:Pool A) *Sg)
        (&seg_len.size (:key Sg) *N))))

  (RULE &tied
    (&longest.maximal (:key (:A *Pool)) (:t (:V *Sg))))

  (INIT &nearest Order
    (key ((&tied (:Pool ^A) *Sg)
          (&center.minimal (:key Sg) (:t *K)))
      (member ((:t (:V Sg) (:S K)))
        (&tied (:Pool A) *Sg)
        (&center.minimal (:key Sg) (:t *K)))
      (score ((:t (:V Sg) (:S K)) (:S K))
        (&tied (:Pool A) *Sg)
        (&center.minimal (:key Sg) (:t *K)))))

  (RULE &finalist
    (&nearest.maximal (:key (:A *Pool)) (:t (:V *Sg))))

  ;; The one segment the contest keeps.
  (INIT &pick Singleton
    (key ((&finalist ^Pool *Sg))
      (member ((:v Sg))
        (&finalist Pool *Sg)))))

(OUTPUT tie-center "when several runs tie for longest, the painted run is the one whose diagonal line passes nearest the grid's center"

  ;; The diagonal whose tied runs win a tie across the two diagonals.
  ;; TODO no-det-plan: &tie_dir: the plan gives no verdict
  (DET &tie_dir (ONE))

  (RULE &seg_axis
    (&segment *Sg *Da))

  (RULE &tied_along
    (&tied *Pool *Sg)
    (&seg_axis Sg *Da))

  (INIT &nearest_dir Order
    (key ((&tie_dir (:Da ^V))
          (&tied ^Pool *Sg)
          (&center.minimal (:key Sg) (:t *K))
          (OR ((&seg_axis Sg (:Da V)))
              ((NOT (&tied_along Pool (:Da V))))))
      (member ((:t (:V Sg) (:S K)))
        (&tie_dir (:Da V))
        (&tied Pool *Sg)
        (&center.minimal (:key Sg) (:t *K))
        (OR ((&seg_axis Sg (:Da V)))
            ((NOT (&tied_along Pool (:Da V))))))
      (score ((:t (:V Sg) (:S K)) (:S K))
        (&tie_dir (:Da V))
        (&tied Pool *Sg)
        (&center.minimal (:key Sg) (:t *K))
        (OR ((&seg_axis Sg (:Da V)))
            ((NOT (&tied_along Pool (:Da V))))))))

  (RULE &middle_elem
    (&tied (:Pool *A) *Sg)
    (&seg_axis Sg (:Da *DA))
    (diag_perp (:Da DA) (:Da2 *DA2))
    (diag_axis_of (:D *Dc) (:Da DA2)))

  ;; The tied segments ordered by their line's distance to corner Dc.
  (INIT &middle Order
    (key ((OR ((&middle_elem ^A ^Dc *Sg))
              ((&middle_elem A Dc (:Sg *Sg1))
               (&middle_elem A Dc (:Sg *Sg2))
               (&segment (:Sg Sg1) (:P *P1))
               (&segment (:Sg Sg2) (:P *P2))
               (nearer (:D Dc) (:P P1) (:Q P2)))))
      (member ((:t Sg))
        (&middle_elem A Dc *Sg))
      (before ((:a Sg1) (:b Sg2))
        (&middle_elem A Dc (:Sg *Sg1))
        (&middle_elem A Dc (:Sg *Sg2))
        (&segment (:Sg Sg1) (:P *P1))
        (&segment (:Sg Sg2) (:P *P2))
        (nearer (:D Dc) (:P P1) (:Q P2))))))

(ALTS $extent "what one competing line holds" $Run
  (ALT $LineCount
    (INPUT diagonal-runs "a whole diagonal line of the grid competes, and its hole cells, across any gap, are what it counts and what is painted"
      (RULE &link
        (&cell *K *P)
        (&cell K (:P *Q))
        (diag_axis_elem *Da)
        (same_line (:A Da) P Q))))
  (ALT $NoPinch
    (INPUT diagonal-runs "a run also ends at a diagonal step where both cells beside the step are not hole cells"
      (RULE &link
        (&diag_step *K *Da *P *Q)
        (neighbor P *D Q)
        (corner_dir (:C D) (:D *D_side))
        (neighbor P (:D D_side) (:Q *R))
        (&cell K (:P R))))))

(ALTS $cand "which runs compete" $EveryRun
  (ALT $CornerRun
    (OUTPUT longest-run "only a run that holds a corner cell of the hole competes; a corner cell is a hole cell nearest one grid corner"
      (RULE &cand
        (&segment (:K *Pool) *Sg *P)
        (&corner (:K Pool) P))))
  (ALT $AnchorCorner
    (OUTPUT longest-run "only a run through a corner cell of an anchor corner, along that corner's own diagonal, competes; the anchor corners are the two corners of &anchor_edge"
      (RULE &cand
        (&anchor *Dc)
        (diag_axis_of (:D Dc) (:Da *DA))
        (&corner (:K *Pool) Dc *P)
        (&segment (:K Pool) *Sg (:Da DA) P)))
    (ALTS $corners "which grid corners anchor a line" $EdgeCorners
      (ALT $EveryCorner
        (OUTPUT longest-run "every grid corner is an anchor corner"
          (RULE &anchor
            (diag_dir_elem (:D *Dc))))))
    (ALTS $pick "which of the tied corner cells anchors a line" $EveryCornerCell
      (ALT $AnchorFirst
        (OUTPUT longest-run "of the cells tied for an anchor corner, only the one nearest &pick_dir, the edge the reading starts from, anchors; that edge is open"
          (RULE &cand
            (&order (:K *Pool) *Dp)
            (&anchor *Dc)
            (diag_axis_of (:D Dc) (:Da *DA))
            (&first_cell.minimal (:key (:K Pool) Dp Dc) (:t *P))
            (&segment (:K Pool) *Sg (:Da DA) P)))))))

(ALTS $scope "where one run is painted" $WholeGrid
  (ALT $PerRegion
    (OUTPUT longest-run "each 4-connected region of hole cells has its own runs compete and its own longest run painted; undefined when some region leaves its tie unbroken"
      (INIT &arena Quotient
        (equivalent ((:a P) (:b Q))
          (OR ((&hole *P)
               (&hole (:P *Q)))
              ((&region.connected P Q))))))))

(ALTS $tie "which of the runs tied for longest is painted" $TieCenter
  (ALT $TieDirection
    (OUTPUT tie-center "the tied runs along &tie_dir win, and the concept's rule breaks the tie left among them; the output holds the grid of each open value"
      (RULE &finalist
        (&nearest_dir.maximal (:key *Pool *V) (:t (:V *Sg))))))
  (ALT $TieMiddle
    (OUTPUT tie-center "when the tied runs are parallel and odd in number, the middle one is painted; undefined otherwise"
      (RULE &mixed
        (&tied *Pool (:Sg *Sg1))
        (&tied Pool (:Sg *Sg2))
        (&seg_axis (:Sg Sg1) (:Da *DA1))
        (&seg_axis (:Sg Sg2) (:Da *DA2))
        (diag_perp (:Da DA1) (:Da2 DA2)))

      (RULE &finalist
        (&middle.rank (:key (:A *Pool) *Dc) (:t *Sg) *R)
        (&middle.dual_rank (:key (:A Pool) Dc) (:t Sg) R)
        (NOT (&mixed Pool)))))
  (ALT $TieCorner
    (OUTPUT tie-center "the painted run is the tied run that holds the one cell nearest some grid corner; undefined when no single tied run holds such a cell"
      (RULE &contested
        (&tied *Pool (:Sg *Sg1))
        (&tied Pool (:Sg *Sg2))
        (!= Sg1 Sg2))

      (RULE &finalist
        (&tied *Pool *Sg)
        (OR ((NOT (&contested Pool)))
            ((&contested Pool)
             (&segment (:K *A) Sg *P)
             (&corner (:K A) *Dc P)
             (ALL ((&corner (:K A) Dc (:P *Pmm))
                   (&corner (:K A) Dc (:P *Qm)))
                  ((= Pmm Qm)))))))))

(ALTS $hole "where the hole color comes from" $HoleStored
  (ALT $HoleDerived
    (INPUT hole "the hole color is the one color other than the color of the border ring; undefined when the ring has two colors or the rest of the grid has two other colors"
      (RULE &hole
        (&other.value (:v *Col))
        (input *P Col)))))

(RULE &case_value
  (&arena_of *A)
  (&pick.value (:key (:Pool A))))

(RULE &unsettled
  (&case_value)
  (&arena_of *A)
  (NOT (&pick.value (:key (:Pool A)))))

(RULE &painted
  (&case_value)
  (NOT (&unsettled))
  (&arena_of *A)
  (&pick.value (:key (:Pool A)) (:v *Sg))
  (&segment Sg *P))

(RULE &output
  (OR ((&painted *P)
       (&paint_color (:C *Col)))
      ((&case_value)
       (NOT (&unsettled))
       (input P Col)
       (NOT (&painted P)))))
