;; 696d4842

(DET &bg DominantColor)

(INIT &shapes Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(INIT &rim Boundary
  (key ((&shapes.node (:key ^Col) *P))
    (cell (P)
      (&shapes.node *P))))

(RULE &link
  (&shapes.node (:key *Col) *P)
  (dir_elem *D)
  (NOT (&rim.exposed (:key Col) P D)))

;; The one direction a shape cell's neighbors lie in.
(INIT &behind Singleton
  (key ((&link ^P *D))
    (member ((:v D))
      (&link P *D))))

(RULE &end
  (&behind.value (:key *P) (:v *D_in))
  (opposite (:D D_in) (:Opp *D)))

(RULE &dot
  (&shapes.node *P)
  (NOT (&link P)))

;; Ends look along their line, and any content stops the look.
(INIT &sight Ray
  (key ((OR ((&end *P ^D))
            ((dir_elem D))))
    (source (P)
      (&end *P D))
    (node (P)
      (dir_elem D)
      (input *P)
      (ALL ((input P *Col))
           ((&bg (:C Col)))))
    (dir (D)
      (dir_elem D))))

(RULE &sight_cell
  (dir_elem (:D *Key))
  (input *P *Col)
  (&bg (:C Col)))

(RULE &faces
  (&sight.end (:key *D) (:P *E) D (:Origin *P_end))
  (neighbor (:P E) D (:Q *P_dot))
  (input (:P P_dot))
  (&dot (:P P_dot)))

(RULE &growth
  (&faces *P_end)
  (&sight.ray (:key *D) *P D (:Origin P_end))
  (&sight_cell (:Key D) P))

(RULE &shape_cell
  (&faces *P_end)
  (&shapes.component (:key *Col) (:P P_end) *Id)
  (&shapes.component (:key Col) (:P *Q) Id))

;; The near end advances one growth cell per step, and at each step the far
;; end gives up the next cell of the shape.
(INIT &crawl Unfold
  (key ((OR ((&growth ^P_end *P)
             (&end (:P P_end) *D)
             (neighbor (:P P_end) D (:Q P)))
            ((&growth P_end P)
             (&end (:P P_end) D)
             (neighbor P D (:Q *P2))
             (&growth P_end (:P P2)))
            ((&shape_cell P_end *Q))))
    (start ((:t P))
      (&growth P_end *P)
      (&end (:P P_end) *D)
      (neighbor (:P P_end) D (:Q P)))
    (initial_untaken ((:item Q))
      (&shape_cell P_end *Q))
    (step ((:t P) (:t2 P2))
      (&growth P_end *P)
      (&end (:P P_end) *D)
      (neighbor P D (:Q *P2))
      (&growth P_end (:P P2)))
    (take ((:t P) (:item Q))
      (&growth P_end *P)
      (&shape_cell P_end *Q)
      (&crawl.untaken (:t P) (:item Q))
      (OR ((&end (:P Q))
           (!= Q P_end))
          ((&link (:P Q) *D)
           (neighbor (:P Q) D (:Q *Q2))
           (&crawl.taken (:t P) (:item Q2)))))))

(RULE &vacated
  (&crawl.take (:key *P_end) (:item *P))
  (&faces P_end *P_dot)
  (input (:P P_dot) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&growth *P_end P)
       (input (:P P_end) *Col))
      ((&vacated P Col))
      ((NOT (&growth P))
       (NOT (&vacated P))
       (= Col Col_in))))
