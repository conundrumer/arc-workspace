;; 77fdfe62

(RULE &cut_divider_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(DET &line VanishedColor)

(RULE &off_line_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &cut_divider
  (input *P)
  (axis_elem *A)
  (&cut_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (ALL ((input (:P *Pm) *Col)
        (&off_line_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
       ((&line (:C Col)))))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The parts the separator lines cut the grid into.
(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D (:K *K2)))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K2))
      (input *P)
      (dir_elem D)
      (margin (:B P) D (:K *K2)))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D (:K *K2))
  (&cut_rank.rank (:key D) (:t K2) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &screened
  (&cut_part_idx *P *D *N)
  (!= N 0))

(RULE &fenced
  (input *P)
  (ALL ((dir_elem *D))
       ((&screened P D))))

(INIT &fence_box BoundingBox
  (cell (P)
    (&fenced *P)))

(RULE &interior_cell
  (&fenced *P)
  (&fence_box.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(DET &ink VanishedColor)

(RULE &corner_color
  (input *P *Col)
  (corner_dist P *Diag (:K 0)))

(ALTS $interior "how the interior is found" $Lines
  (ALT $Margin
    (DET &margin
      (&fence_box.box *B)
      (dir_elem *D)
      (margin B D *K))

    (RULE &interior_cell_uniform_inset1
      (&margin (:K *K_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &interior_cell
      (input *P)
      (&margin *K)
      (&interior_cell_uniform_inset1 (:K_ K) (:B_ *B))
      (ALL ((&margin (:K *Km))
            (axis_of (:D *D1_m1) (:A *A1_m2))
            (perp (:A A1_m2) (:A2 *A2_m3))
            (axis_of (:D *D2_m4) (:A A2_m3))
            (opposite (:D D1_m1) (:Opp *O_m7))
            (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
            (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
            (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
            (opposite (:D D2_m4) (:Opp *O_m10))
            (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
            (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
            (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
            (compose (:A B1_m5) (:B B2_m6) (:C B))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))))

(ALTS $blank "how non-ink interior cells render" $Pass
  (ALT $Bg
    (DET &bg SharedColor)

    (RULE &output
      (OR ((input (:P *P2) (:Col *C0))
           (NOT (&ink (:C C0)))
           (&interior_cell (:P P2) (:P_inner *P))
           (&bg (:C *Col)))
          ;; Ink takes the corner color of its quadrant.
          ((input (:P *P22) (:Col *Ink))
           (&ink (:C Ink))
           (&interior_cell (:P P22) (:P_inner P))
           (&quad_quadrant P *Diag)
           (&corner_color Diag Col))))))

(RULE &quad_nearer
  (&interior_cell (:P_inner *P))
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &quad_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&quad_nearer *P (:D D1))
  (&quad_nearer P (:D D2)))

(RULE &output
  ;; Ink takes the corner color of its quadrant.
  (OR ((input (:P *P2) (:Col *Ink))
       (&ink (:C Ink))
       (&interior_cell (:P P2) (:P_inner *P))
       (&quad_quadrant P *Diag)
       (&corner_color Diag *Col))
      ((input (:P *P22) Col)
       (NOT (&ink (:C Col)))
       (&interior_cell (:P P22) (:P_inner P)))))
