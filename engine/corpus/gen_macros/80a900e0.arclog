;; 80a900e0

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg SharedColor)

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(RULE &object
  (&objs_component (:Key *Col) *P *Id))

(RULE &aligned
  (&object *Id *P)
  (&object Id (:P *Q))
  (diag_axis_elem *Da)
  (diag_perp Da (:Da2 *A2_m1))
  (diag_axis_of (:D *D_m2) (:Da A2_m1))
  (corner_dist P (:Diag D_m2) (:K *K_m3))
  (corner_dist (:P Q) (:Diag D_m2) (:K K_m3)))

(RULE &segment
  (&object *Id *P)
  (&object Id (:P *Q))
  (!= P Q)
  (diag_axis_elem *Da)
  (ALL ((&object Id (:P *Pm))
        (&object Id (:P *Qm)))
       ((&aligned Id Da (:P Pm) (:Q Qm)))))

(RULE &across
  (&segment *Id *Da)
  (diag_perp Da *Da2)
  (diag_axis_of *D (:Da Da2)))

(INIT &rim Boundary
  (key ((&object ^Id *P))
    (cell (P)
      (&object Id *P)))
  (dir (D)
    (dir8_elem *D)))

(RULE &end
  (&segment *Id *Da)
  (diag_axis_of *D Da)
  (&rim.exposed (:key Id) *P D))

(RULE &rays_dir
  (&end *Id (:P *Key))
  (&across Id *D))

(RULE &rays_blocked
  (&end (:P *Key))
  (&object *P))

(RULE &rays_source
  (&end (:P *Key)))

(RULE &rays_cell
  (&end (:P *Key))
  (input *P *Col)
  (&bg (:C Col)))

(ALTS $choice "which directions each end casts, and where a ray stops" $Halt
  (ALT $Away
    (RULE &rays_dir
      (&end *Id (:P *Key))
      (&across Id *D)
      (diag_opposite D (:Opp *D_in))
      (step_offset (:D D_in) (:V *V_m1))
      (compose (:A Key) (:B V_m1) (:C *Q))
      (&object (:P Q)))

    (RULE &rays_node
      (&rays_dir *Key)
      (input *P))))

(RULE &rays_dir_ray
  (&rays_dir *Key *D))

(RULE &rays_node
  (&rays_dir *Key)
  (input *P)
  (NOT (&rays_blocked Key P)))

(INIT &rays Distance
  (key ((&rays_source (:Key ^Ky))
        (&rays_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:Key Ky))
           (&rays_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P Ky) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A Ky) (:B V_m1) (:C *A2))
           (&rays_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:Key Ky) (:P Q)))
          ((&rays_source (:Key Ky))
           (&rays_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A Ky) (:B V_m12) (:C Q))
           (&rays_node (:Key Ky) (:P Q))
           (= A2 Ky))
          ((&rays_source (:Key Ky))
           (&rays_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P Ky) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A Ky) (:B V_m13) (:C A2))
           (&rays_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:Key Ky) (:P Q)))))
    (source ((:n Ky))
      (&rays_source (:Key Ky))
      (&rays_dir_ray (:Key Ky) D))))

(RULE &rays_ray
  (&rays.distance (:key (:Ky *Key) *D (:Ky *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray Key (:P Q) D Origin)))

(RULE &painted
  (&rays_ray (:Key *P_end) *P)
  (&rays_cell (:Key P_end) P)
  (&object (:P P_end) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
