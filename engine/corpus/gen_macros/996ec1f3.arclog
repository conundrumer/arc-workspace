;; 996ec1f3

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &panels_divider
  (&line_color.value (:key *A *L)))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A uniform line spans the grid, so it divides panels rather than sit in one.
(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET &gap TileDim)

(INIT &panel_pos_tiling Tiling
  (outer ((:P T))
    (&panels_tile_of (:P_tile *T)))
  (inner (P)
    (= *P 0))
  (gap (A G)
    (axis_elem *A)
    (&gap (:D *G))))

(INIT &cut Singleton
  (member ((:v Col))
    (&line_color.value (:v *Col))))

(INIT &border Boundary
  (key ((&panels_tile_of *P (:P_tile ^T)))
    (cell (P)
      (&panels_tile_of *P (:P_tile T)))))

(INIT &fill Singleton
  (key ((&panels_tile_of *P (:P_tile ^T))
        (NOT (&border.boundary (:key T) P))
        (input P *Col))
    (member ((:v Col))
      (&panels_tile_of *P (:P_tile T))
      (NOT (&border.boundary P))
      (input P *Col))))

(RULE &panel_pos
  (&panel_pos_tiling.cell (:P_outer *P_tile) (:P_inner 0) (:P *P_grid_out)))

(INIT &schematic Frame
  (extent (A N)
    (&panel_pos (:P_grid_out *P))
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &output
  (&schematic.cell *P)
  (OR ((&panel_pos (:P_tile *T) (:P_grid_out P))
       (&fill.value (:key T) (:v *Col)))
      ((NOT (&panel_pos (:P_grid_out P)))
       (&cut.value (:v Col)))))
