;; b6f77b65

(INPUT marker "the line on the edge opposite &fall_dir holds a run of marker cells from the DIAG_TL corner, and nothing else; the line next to it is empty"

  (DET &fall_dir DirDomain))

(INPUT arches "the rest of the grid is a stack of arches, each a bar across the tops of two legs that run along the axis of &fall_dir")

(INPUT sticks "each leg is one color for its whole length, its top corner cell included; each bar is one color over the cells strictly between its two legs")

(INPUT stacked "each leg stands on the edge toward &fall_dir or on a stick of a lower arch; the two legs of one arch may differ in length"

  (DET_OR_RULE &bg DominantColor)

  ;; The non-background cells on each frame edge.
  (INIT &edge_tally Cardinality
    (key ((dir_elem ^D))
      (member ((:m P))
        (input *P *Col)
        (NOT (&bg (:C Col)))
        (margin (:B P) D (:K 0)))))

  (INIT &floor_edge Order
    (member ((:t (:V D) (:S N)))
      (&edge_tally.size (:key *D) *N))
    (score ((:t (:V D) (:S N)) (:S N))
      (&edge_tally.size (:key *D) *N))))

(OUTPUT pull-marked "every stick whose color is a marker color becomes &bg")

(OUTPUT legs-fall "each leg left moves toward &fall_dir until the cell past its end is the frame edge or a stick")

(OUTPUT bar-hangs "a bar whose arch keeps both legs moves toward &fall_dir until it lies on the line of the lower of its legs' tops, or a cell past it is the frame edge or a stick")

(OUTPUT bar-drops "a bar whose arch lost a leg moves toward &fall_dir until a cell past it is the frame edge or a stick")

(OUTPUT marker-kept "the marker cells stay as they are"

  (RULE &stick_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &fall
    (&fall_dir *D))

  (RULE &marker_line
    (input *P)
    (&fall *D)
    (opposite D (:Opp *O))
    (margin (:B P) (:D O) (:K 0)))

  (RULE &stick_cell
    (&fall)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&marker_line P)))

  (RULE &bar_cell
    (&stick_cell *P *Col)
    (&fall *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (input (:P Q) (:Col *Bg))
    (&bg (:C Bg)))

  (RULE &leg_cell
    (&stick_cell *P *Col)
    (&fall *D)
    (OR ((margin (:B P) D (:K 0)))
        ((step_offset D (:V *V_m1))
         (compose (:A P) (:B V_m1) (:C *Q))
         (&stick_cell (:P Q)))))

  ;; Each stick: a leg runs along the fall's axis, a bar across it.
  (INIT &stick Quotient
    (edge ((:a A Col P) (:b A Col (:P P3)))
      (OR ((&fall *D)
           (axis_of D (:A *A_fall))
           (OR ((&bar_cell *P *Col)
                (perp (:A A_fall) (:A2 *A)))
               ((&leg_cell P Col)
                (= A A_fall)))
           (&stick_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&fall (:D *D2))
           (axis_of (:D D2) (:A *A_fall2))
           (OR ((&leg_cell (:P P3) Col)
                (= A A_fall2))
               ((&bar_cell (:P P3) Col)
                (perp (:A A_fall2) (:A2 A)))))
          ((&fall (:D *D3))
           (axis_of (:D D3) (:A *A_fall3))
           (OR ((&bar_cell P Col)
                (perp (:A A_fall3) (:A2 A)))
               ((&leg_cell P Col)
                (= A A_fall3)))
           (= P3 P)))))

  (RULE &stick_component
    (&stick.class (:a *A *Col *P) *Id))

  (RULE &marker
    (&marker_line *P)
    (input P *Col)
    (NOT (&bg (:C Col))))

  (RULE &stick_of
    (&stick_component *Col *P *Id))

  (RULE &bar
    (&bar_cell *P)
    (&stick_of P *Id))

  (RULE &arch_leg
    (&bar (:Id *B))
    (&stick_of *P (:Id B))
    (&fall *D)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *S) (:A A2_m2))
    (step_offset (:D S) (:V *V_m3))
    (compose (:A P) (:B V_m3) *C)
    (&stick_of (:P C) (:Id *L))
    (NOT (&bar (:Id L))))

  (RULE &pulled
    (&stick_of *Id *Col)
    (&marker Col))

  (RULE &broken
    (&arch_leg *B *L)
    (&pulled (:Id L)))

  (RULE &whole
    (&bar (:Id *B))
    (NOT (&pulled (:Id B)))
    (NOT (&broken B)))

  (RULE &body
    (&stick_of *P *Id)
    (NOT (&pulled Id)))

  (RULE &travel
    (&fall *D)
    (input *P)
    (margin (:B P) D *K)
    (dir8_opposite D (:D2 *O_m1))
    (edge_inset (:D O_m1) K (:B *B1_m2))
    (edge_inset D K (:B *I_m4))
    (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *V))))

(ALTS $b "where the bar of an arch that lost a leg comes to rest" $BarDrops
  (ALT $BarToFoot
    (OUTPUT bar-drops "the bar moves toward &fall_dir until it lies beside the end of the leg it keeps, or a cell past it is the frame edge or a stick"
      (RULE &leg_continues
        (&stick_of (:P *Q) (:Id *L))
        (&fall *D)
        (step_offset D (:V *V_m1))
        (compose (:A Q) (:B V_m1) (:C *Q2))
        (&stick_of (:P Q2) (:Id L))))
    ;; The sticks left settle toward the fall; each comes to rest at the least
    ;; travel that `settle` reaches for it.
    (INIT &settle Propagation
      (source ((:n Id V))
        (&body *Id *P)
        (&fall *D)
        (margin (:B P) D *K)
        (dir8_opposite D (:D2 *O_m1))
        (edge_inset (:D O_m1) K (:B *B1_m2))
        (edge_inset D K (:B *I_m4))
        (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *V)))
      (edge ((:a Id V) (:b (:Id Id3) (:V V2)))
        (OR ((&body (:Id *Id3) *P)
             (&body *Id (:P *Q))
             (!= Id3 Id)
             (&fall *D)
             (dir_elem D)
             (margin (:B Q) D (:K *K1_m1))
             (margin (:B P) D (:K *K2_m2))
             (< K1_m1 K2_m2)
             (&travel *V)
             (compose (:A Q) (:B V) (:C *Q2))
             (opposite D (:Opp *O))
             (step_offset (:D O) (:V *V_m3))
             (compose (:A Q2) (:B V_m3) (:C *P2))
             (relative (:Base P) (:X P2) (:X_rel *V2))
             (&travel (:V V2)))
            ((&body Id)
             (&travel V)
             (&fall (:D *D2))
             (step_offset (:D D2) (:V *V_m1))
             (compose (:A V) (:B V_m1) (:C V2))
             (&travel (:V V2))
             (= Id3 Id))
            ((&broken (:B Id3))
             (NOT (&pulled (:Id Id3)))
             (&arch_leg (:B Id3) (:L Id) *C)
             (NOT (&pulled Id))
             (&stick_of (:P *Q3) Id)
             (NOT (&leg_continues (:Q Q3)))
             (relative (:Base C) (:X Q3) (:X_rel *U))
             (&travel V)
             (compose (:A V) (:B U) (:C V2)))))
      (join ((:a (:Id L1) V) (:b (:Id L2) V) (:c (:Id Bar) V))
        (&whole (:B *Bar))
        (&arch_leg (:B Bar) (:L *L1))
        (&arch_leg (:B Bar) (:L *L2))
        (!= L1 L2)
        (&travel *V)))))

(ALTS $f "where the sticks fall" $StoredFall
  (ALT $FallToFloorEdge
    (INPUT stacked "each leg stands on the frame edge that the most non-background cells touch, or on a stick of a lower arch, and the sticks fall toward that edge; undefined where two edges tie for the most"
      (RULE &fall
        (&floor_edge.maximal (:t (:V *D)))))))

;; The sticks left settle toward the fall; each comes to rest at the least
;; travel that `settle` reaches for it.
(INIT &settle Propagation
  (source ((:n Id V))
    (&body *Id *P)
    (&fall *D)
    (margin (:B P) D *K)
    (dir8_opposite D (:D2 *O_m1))
    (edge_inset (:D O_m1) K (:B *B1_m2))
    (edge_inset D K (:B *I_m4))
    (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *V)))
  (edge ((:a Id V) (:b (:Id Id3) (:V V2)))
    (OR ((&body (:Id *Id3) *P)
         (&body *Id (:P *Q))
         (!= Id3 Id)
         (&fall *D)
         (dir_elem D)
         (margin (:B Q) D (:K *K1_m1))
         (margin (:B P) D (:K *K2_m2))
         (< K1_m1 K2_m2)
         (&travel *V)
         (compose (:A Q) (:B V) (:C *Q2))
         (opposite D (:Opp *O))
         (step_offset (:D O) (:V *V_m3))
         (compose (:A Q2) (:B V_m3) (:C *P2))
         (relative (:Base P) (:X P2) (:X_rel *V2))
         (&travel (:V V2)))
        ((&body Id)
         (&travel V)
         (&fall (:D *D2))
         (step_offset (:D D2) (:V *V_m1))
         (compose (:A V) (:B V_m1) (:C V2))
         (&travel (:V V2))
         (= Id3 Id))))
  (join ((:a (:Id L1) V) (:b (:Id L2) V) (:c (:Id Bar) V))
    (&whole (:B *Bar))
    (&arch_leg (:B Bar) (:L *L1))
    (&arch_leg (:B Bar) (:L *L2))
    (!= L1 L2)
    (&travel *V)))

(RULE &passed
  (&settle.reached (:n *Id *V))
  (&fall *D)
  (opposite D (:Opp *O))
  (step_offset (:D O) (:V *V_m1))
  (compose (:A V) (:B V_m1) (:C *V0))
  (&settle.reached (:n Id (:V V0))))

(RULE &landed
  (&settle.reached (:n *Id *V))
  (NOT (&passed Id V))
  (&stick_of (:P *P2) Id *Col)
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&marker_line *P)
       (input P *Col))
      ((&landed P Col))
      ((input P)
       (NOT (&marker_line P))
       (NOT (&landed P))
       (&bg (:C Col)))))
