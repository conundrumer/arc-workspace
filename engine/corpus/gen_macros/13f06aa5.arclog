;; 13f06aa5

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

(INIT &ink_mode_count Cardinality
  (key ((&ink *P ^Col))
    (member ((:m P))
      (&ink *P Col))))

;; The shapes' own color — the commonest ink.
(INIT &ink_mode Order
  (member ((:t Col))
    (&ink_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&ink_mode_count.size (:key *Col) *N)))

(RULE &mark
  (&ink *P *Col)
  (NOT (&ink_mode.maximal (:t Col))))

(RULE &mark_dir
  (&mark *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&bg_mode.maximal (:t Col)))

(RULE &ray_source
  (&mark (:P *Key)))

;; Distance between trail dots.
(DET &spacing TileCount)

;; Where two fired edges meet.
(DET &corner_color AnyOutNewColor)

(RULE &ray_cell
  (&mark (:P *Key))
  (input *P))

(ALTS $choice "how a marker's direction is read" $Open
  (ALT $Side
    (RULE &comps_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &comps Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&comps_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &comps_component
      (&comps.class (:a *P) *Id))

    (INIT &bbox BoundingBox
      (key ((&comps_component *P ^Id))
        (cell (P)
          (&comps_component *P Id))))

    (RULE &mark_dir
      (&mark *P)
      (&comps_component P *Id)
      (&bbox.box (:key Id) *B)
      (ALL ((&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) *D (:K *K_m1))
      (margin B D (:K K_m1)))))

(RULE &ray_dir
  (&mark_dir (:P *Key) *D))

(RULE &ray_node
  (&mark_dir (:P *Key) *D)
  (input *P))

(INIT &ray Distance
  (key ((&ray_source (:Key ^Ky))
        (&ray_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&ray_source (:Key Ky))
           (&ray_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P Ky) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A Ky) (:B V_m1) (:C *A2))
           (&ray_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ray_node (:Key Ky) (:P Q)))
          ((&ray_source (:Key Ky))
           (&ray_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A Ky) (:B V_m12) (:C Q))
           (&ray_node (:Key Ky) (:P Q))
           (= A2 Ky))
          ((&ray_source (:Key Ky))
           (&ray_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P Ky) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A Ky) (:B V_m13) (:C A2))
           (&ray_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ray_node (:Key Ky) (:P Q)))))
    (source ((:n Ky))
      (&ray_source (:Key Ky))
      (&ray_dir (:Key Ky) D))))

(RULE &ray_ray
  (&ray.distance (:key (:Ky *Key) *D (:Ky *Origin)) (:n *P) *K))

(RULE &ray_end
  (&ray_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ray_ray Key (:P Q) D Origin)))

(RULE &fired
  (&mark *P *Col)
  (&mark_dir P *D))

(RULE &paint
  (OR ((&fired *D *Col)
       (input *P)
       (margin (:B P) D (:K 0)))
      ((&mark (:P *M) Col)
       (&mark_dir (:P M) (:D *D2))
       (&ray_ray (:Key M) P (:D D2) *K)
       (&ray_cell (:Key M) P)
       (&spacing (:N *W))
       (divide (:T K) (:Side W) (:Gap 0) (:Remainder 0)))))

(RULE &corner
  (corner_dir (:C *Dg) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Dg) (:A A2_m2) (:D *D2))
  (&fired (:D D1))
  (&fired (:D D2))
  (input *P)
  (corner_dist P (:Diag Dg) (:K 0)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&corner P)
       (&corner_color (:C *Col)))
      ((&paint P Col)
       (NOT (&corner P)))
      ((NOT (&paint P))
       (= Col Col_in))))
