;; 5ffb2104

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &obj_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

(DET &grav DirDomain)

(INIT &settle Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj_component *P *Id)
    (&grav *D)
    (&obj_component (:P *P2) (:Id *Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (&obj_component *P *Id)
    (&grav *D)
    (margin (:B P) D *K)))

(RULE &fallen
  (&obj_component (:Key *Col) (:P *P2) *Id)
  (&settle.distance (:n Id) *K)
  (&grav *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta))
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (NOT (&fallen P))
       (&bg (:C Col)))))
