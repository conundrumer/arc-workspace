;; a3df8b1e

(DET &bg DominantColor)

(DET &dir DirDomain)

(RULE &seed
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The marker sits against both side walls, so a heading into a wall flips at
;; the first step and the two headings draw one trace. The heading is not
;; observable, and the program takes both.
(RULE &launch
  (&dir (:D *U))
  (axis_of (:D U) (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *H) (:A A2_m2)))

(ALTS $dir "how the ray's advance direction and heading are set" $Stored
  (ALT $Seat
    (DET &axis AxisDomain)

    (RULE &launch
      (&seed *P)
      (corner_dist P *Diag (:K 0))
      (diag_opposite (:D Diag) *Opp)
      (&axis *A)
      (corner_dir (:C Opp) A (:D *U))
      (perp A (:A2 *A2_m1))
      (corner_dir (:C Opp) (:A A2_m1) (:D *H)))))

(ALTS $ink "what color the ray draws" $Prop
  (ALT $Fixed
    (DET &ink RarestColor)

    (RULE &output
      (OR ((&traced *P)
           (&ink (:C *Col)))
          ((input P)
           (NOT (&traced P))
           (&bg (:C Col)))))))

(INIT &trace Propagation
  (source ((:n P H))
    (&launch *H)
    (&seed *P))
  (edge ((:a P H) (:b (:P P2) (:H H2)))
    (&launch *U)
    (axis_of (:D U) (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *H) (:A A2_m2))
    (input *P)
    (OR ((margin (:B P) (:D H) (:K 0))
         (opposite (:D H) (:Opp *H2))
         (= *P2 P))
        ((NOT (margin (:B P) (:D H) (:K 0)))
         (NOT (margin (:B P) (:D U) (:K 0)))
         (corner_dir (:C *Diag) (:A *A_m3) (:D U))
         (perp (:A A_m3) (:A2 *A2_m4))
         (corner_dir (:C Diag) (:A A2_m4) (:D H))
         (step_offset (:D Diag) (:V *V_m5))
         (compose (:A P) (:B V_m5) (:C P2))
         (= H2 H)))))

(RULE &traced
  (&trace.reached (:n *P)))

(RULE &output
  (OR ((&traced *P)
       (&seed *Col))
      ((input P)
       (NOT (&traced P))
       (&bg (:C Col)))))
