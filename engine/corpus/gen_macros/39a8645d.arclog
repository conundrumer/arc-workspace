;; 39a8645d

(RULE &pieces_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &pieces_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &pieces Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&pieces_node (:Key *Ky) *P)
         (&pieces_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&pieces_node (:Key Ky) (:P P2)))
        ((&pieces_node (:Key Ky) P)
         (= P2 P)))))

(RULE &pieces_component
  (&pieces.class (:a *Key *P) *Id))

(INIT &bbox BoundingBox
  (key ((&pieces_component *P ^Id))
    (cell (P)
      (&pieces_component *P Id))))

(RULE &shape_cell
  (&bbox.box (:key *Id) *B)
  (&pieces_component *P Id)
  (ALL ((&pieces_component P (:Id *Idm))
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &same_shape Inclusion
  (pattern ((:pattern Id) (:m P_inner))
    (&shape_cell *Id *P_inner))
  (observed ((:observed Id) (:m P_inner))
    (&shape_cell *Id *P_inner)))

(RULE &copy
  (&same_shape.equal (:observed *Id) (:pattern *Id2))
  (&pieces_component (:Key *Col) Id)
  (&pieces_component (:Key Col) (:Id Id2)))

(INIT &commonest_count Cardinality
  (key ((&copy ^Id *Id2))
    (member ((:m Id2))
      (&copy Id *Id2))))

;; The pieces with the most copies.
(INIT &commonest Order
  (member ((:t Id))
    (&commonest_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&commonest_count.size (:key *Id) *N)))

(RULE &output
  (&commonest.maximal (:t *Id))
  (&bbox.box (:key Id) *B)
  (input (:P *P2))
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&pieces_component (:Key *Col) (:P P2) Id))
      ((NOT (&pieces_component (:P P2) Id))
       (&bg (:C Col)))))
