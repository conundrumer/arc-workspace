;; 456873bc

(RULE &side_division_cell
  (input *P)
  (sub_extent P (:K *Key)))

(DET &gap DivisorRatio)

(RULE &side_division_gap
  (axis_elem *A)
  (input *P)
  (sub_extent P (:K *Key))
  (&gap (:K *G)))

(RULE &side_division_axis_split1
  (&side_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &side_division_side_held
  (axis_elem (:A *A2))
  (input *P)
  (sub_extent P *K))

(RULE &side_division_axis
  (OR ((&side_division_cell *Key *P)
       (axis_elem *A)
       (input (:P *P3))
       (sub_extent (:P P3) (:K Key))
       (&side_division_gap Key A *G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side Key) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side Key) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N Key)))
      ((&side_division_cell Key P)
       (axis_elem A)
       (input (:P *P32))
       (sub_extent (:P P32) (:K Key))
       (NOT (&side_division_gap Key A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side Key) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side Key) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N Key)))
      ((&side_division_cell Key P)
       (axis_elem A)
       (NOT (&side_division_side_held (:K Key) (:A2 A)))
       (&side_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &side_division_tile
  (&side_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&side_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &side
  (&side_division_tile (:Key *K) *P (:P_outer *P_tile))
  (sub_extent P *A K)
  (perp A (:A2 *A2_m1))
  (frame_extent (:P P_tile) A (:N K))
  (frame_extent (:P P_tile) (:A A2_m1) (:N K)))

(RULE &cell_division_cell
  (input *P)
  (&side (:K *Key)))

(RULE &cell_division_gap
  (axis_elem *A)
  (&side (:K *Key))
  (&gap (:K *G)))

(RULE &cell_division_axis_split1
  (&cell_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &cell_division_side_held
  (axis_elem *A)
  (&side *K))

(RULE &cell_division_axis
  (OR ((&cell_division_cell *Key *P)
       (axis_elem *A)
       (&side (:K Key))
       (&cell_division_gap Key A *G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side Key) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side Key) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N Key)))
      ((&cell_division_cell Key P)
       (axis_elem A)
       (&side (:K Key))
       (NOT (&cell_division_gap Key A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side Key) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side Key) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N Key)))
      ((&cell_division_cell Key P)
       (axis_elem A)
       (NOT (&cell_division_side_held (:K Key) A))
       (&cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &cell_division_tile
  (&cell_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&cell_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(DET &ink SharedColor)

(DET &mark AnyOutNewColor)

(RULE &cell
  (&cell_division_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &shape
  (&cell *P_grid *P_intile)
  (input (:P P_grid) *Col)
  (&ink (:C Col)))

(RULE &inked
  (&cell *P_grid *P_tile *P_intile)
  (&shape (:P_intile P_tile))
  (&shape P_intile))

(RULE &marked
  (&cell *P_grid *P_tile (:P_intile P_tile))
  (&shape (:P_intile P_tile)))

(ALTS $choice "what the fractal's ink comes from" $Draw
  (ALT $Restore
    (DET &cover ChangedColor)

    (RULE &output
      (OR ((input *P *Col)
           (NOT (&marked (:P_grid P)))
           (NOT (&cover (:C Col))))
          ((&marked (:P_grid P))
           (&mark (:C Col)))
          ((input P (:Col *Cover))
           (&cover (:C Cover))
           (NOT (&marked (:P_grid P)))
           (IF ((&inked (:P_grid P)))
               ((&ink (:C Col)))
               ((&bg (:C Col)))))))))

(RULE &output
  (OR ((&inked (:P_grid *P))
       (NOT (&marked (:P_grid P)))
       (&ink (:C *Col)))
      ((&marked (:P_grid P))
       (&mark (:C Col)))
      ((input P)
       (NOT (&inked (:P_grid P)))
       (&bg (:C Col)))))
