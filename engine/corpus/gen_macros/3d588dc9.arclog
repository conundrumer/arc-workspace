;; 3d588dc9

(DET &flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &shed
  (ex_input *E *P *Col)
  (NOT (&bg (:C Col)))
  (ex_output E P (:Col *Bg))
  (&bg (:C Bg)))

(INIT &flood Propagation
  (key ((&shed ^E (:P ^P0)))
    (source ((:n P0))
      (ex_input E (:P P0) *Col))
    (edge ((:a P) (:b P2))
      (ex_input E (:P P0) *Col)
      (ex_input E *P Col)
      (&flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (ex_input E (:P P0) (:Col *Col2))
      (ex_input E (:P P2) (:Col Col2)))))

;; Each shed key is one copy of the chart, in its own pose.
(INIT &bbox BoundingBox
  (key ((&flood.reached (:key ^E (:P0 ^P)) (:n *P2)))
    (cell ((:P P2))
      (&flood.reached (:key E (:P0 P)) (:n *P2)))))

(DET &chart_view_inside1
  (&bbox.cell (:key (:E *K_e) (:P *K_p)) (:P *P_))
  (&bbox.box (:key (:E K_e) (:P K_p)) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &objects_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &objects_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &objects Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objects_node (:Key *Ky) *P)
         (&objects_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objects_node (:Key Ky) (:P P2)))
        ((&objects_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objects_component
  (&objects.class (:a *Key *P) *Id))

(DET &face AnyOutNewColor)

;; The axis a wedge's corner is read on.
(DET &face_axis AxisDomain)

(DET &chart_view
  (&bbox.cell (:key *E (:P *K_p)) *P)
  (&bbox.box (:key E (:P K_p)) *B)
  (NOT (&chart_view_inside1 (:P_ P) (:B_ B)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(DET &key_shed
  (&flood.reached (:key *E (:P0 *K_p)) (:n *P))
  (&shed E P))

(DET &block
  (&chart_view *E (:K_p *P0) (:P *P2) (:P_inner *P))
  (NOT (&key_shed E (:K_p P0) (:P P2))))

(DET &stem
  (&key_shed *E (:K_p *P0) (:P *P2))
  (&chart_view E (:K_p P0) (:P P2) (:P_inner *P)))

(RIGID_DET &key
  (&block *E *P0 *P)
  (&stem *E *P0 *P))

(RULE &obj
  (&objects_component *P *Id))

(INIT &obj_box BoundingBox
  (key ((&obj ^Id *P))
    (cell (P)
      (&obj Id *P))))

(INIT &foot_box BoundingBox
  (key ((OR ((&key.block (:Pose ^D) (:P *P_shape)))
            ((&key.stem (:Pose D) (:P P_shape)))))
    (cell ((:P P_shape))
      (OR ((&key.block (:Pose D) (:P *P_shape)))
          ((&key.stem (:Pose D) (:P P_shape)))))))

(RULE &foot_view
  (&foot_box.cell (:key *D) (:P *P_shape))
  (&foot_box.box (:key D) *B)
  (ALL ((&foot_box.cell (:key (:D *Dm)) (:P P_shape))
        (&foot_box.box (:key (:D Dm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_shape) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_shape) (:X_rel *P_inner)))

(INIT &key_match Inclusion
  (pattern ((:pattern D) (:m P_inner))
    (&foot_view *D *P_inner))
  (observed ((:observed Id) (:m P_inner))
    (&obj *Id *P)
    (&obj_box.box (:key Id) *B)
    (ALL ((&obj (:Id *Idm) P)
          (&obj_box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &key_at
  (&key_match.equal (:observed *Id) (:pattern *D)))

(RULE &key_cell
  (&key_at *Id *D)
  (input *P)
  (&obj_box.box (:key Id) *B)
  (ALL ((&obj_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&foot_view D *P_shape P_inner))

(RULE &stem_cell
  (&key_cell *Id *D *P *P_shape)
  (&key.stem (:Pose D) (:P P_shape)))

(RULE &notch
  (diag_dir_elem (:D *Dg))
  (&obj *Id *P)
  (&obj_box.box (:key Id) *B)
  (ALL ((&obj (:Id *Idm) P)
        (&obj_box.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (input (:P *Q))
  (ALL ((&obj_box.box (:key (:Id *Idmm)) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X Q) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (relative (:Base B) (:X Q) (:X_rel *Q_inner))
  (diag_dir_elem (:D Dg))
  (corner_dist (:P Q_inner) (:Diag Dg) (:K *K1_m1))
  (corner_dist (:P P_inner) (:Diag Dg) (:K *K2_m2))
  (< K1_m1 K2_m2)
  (NOT (&obj Id (:P Q))))

;; A wedge is packed into exactly one corner, so the far diagonal is its slant.
(INIT &wedge Singleton
  (key ((&obj ^Id))
    (member ((:v Dg))
      (diag_dir_elem (:D *Dg))
      (NOT (&notch Id Dg)))))

(INIT &side Singleton
  (key ((&key_at (:Id ^K)))
    (member ((:v D))
      (&wedge.value (:key (:Id *T)) (:v *Dg))
      (ALL ((&wedge.value (:key (:Id T)) (:v *Dgm))
            (corner_dir (:C Dgm) (:D *Dm))
            (&obj_box.box (:key (:Id T)) (:B *B_t))
            (margin (:B B_t) (:D Dm) (:K *N_t))
            (&obj_box.box (:key (:Id K)) (:B *B_k))
            (margin (:B B_k) (:D Dm) (:K *N_k)))
           ((> N_k N_t)))
      (&face_axis *A)
      (corner_dir (:C Dg) A *D))))

(INIT &block_box BoundingBox
  (key ((&key_cell ^Id *D *P *P_shape)
        (&key.block (:Pose D) (:P P_shape)))
    (cell (P)
      (&key_cell Id *D *P *P_shape)
      (&key.block (:Pose D) (:P P_shape)))))

(RULE &block_edge
  (&block_box.cell (:key *Id) *P)
  (&block_box.box (:key Id) *B)
  (ALL ((&block_box.cell (:key (:Id *Idm)) P)
        (&block_box.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) *D (:K *K_m1))
  (margin B D (:K K_m1)))

(RULE &stem_blocks
  (&block_edge *Id *D *P)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&stem_cell Id (:P Q)))

(RULE &open
  (&side.value (:key (:K *Id)) (:v *D))
  (NOT (&stem_blocks Id D)))

(RULE &cleared
  (&open *Id)
  (&stem_cell Id *P))

(RULE &faced
  (&open *Id *D)
  (&block_edge Id D *P))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&faced P)
       (&face (:C *Col)))
      ((&cleared P)
       (&bg (:C Col)))
      ((NOT (&faced P))
       (NOT (&cleared P))
       (= Col Col_in))))
