;; 7df24a62

(DET &box UnchangedColor)

(DET &mark UnchangedColor)

;; The drawn box, bounding the motif it holds.
(INIT &tpl BoundingBox
  (cell (P)
    (input *P *Col)
    (&box (:C Col))))

(RULE &pose
  (&tpl.box *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner2))
  (d4_elem *D)
  (apply D (:P P_inner2) (:P_out *P_inner)))

;; The posed motif seated on the grid's marks.
(INIT &occ Occurrences
  (key ((OR ((&pose ^D *P_inner *Col)
             (&mark (:C Col)))
            ((d4_elem D)
             (input *P Col)
             (&mark (:C Col)))))
    (cell (P)
      (d4_elem D)
      (input *P *Col)
      (&mark (:C Col)))
    (shape ((:P P_inner))
      (&pose D *P_inner *Col)
      (&mark (:C Col)))))

(RULE &filled
  (&occ.occurrence (:key *D) (:P *M))
  (&pose D *P_inner)
  (compose (:A M) (:B P_inner) (:C *P))
  (input P *Col)
  (NOT (&mark (:C Col))))

(RULE &output
  (OR ((&filled *P)
       (&box (:C *Col)))
      ((input P Col)
       (NOT (&filled P)))))
