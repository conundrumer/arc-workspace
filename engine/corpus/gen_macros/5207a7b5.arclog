;; 5207a7b5

(DET &bg DominantColor)

(DET &bar RarestColor)

;; The corner the slant runs toward, and how far it goes along the bar per cell across it.
(DET &slant_dir DiagDirDomain)

(DET &rise_axis AxisDomain)

(DET &rise TileCount)

(RULE &base
  (&slant_dir (:D *Dg))
  (&rise_axis *A)
  (corner_dir (:C Dg) A (:D *D2))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Dg) (:A A2_m2) (:D *D2_m1))
  (opposite (:D D2) (:Opp *D)))

(RULE &bar_cell
  (input *P *Col)
  (&bar (:C Col)))

(RULE &on_slant
  (&bar_cell (:P *Q))
  (input *P)
  (relative (:Base Q) (:X P) (:X_rel *R))
  (&slant_dir (:D *Dg))
  (&rise_axis *A)
  (corner_dir (:C Dg) A *D)
  (perp A (:A2 *A2_m1))
  (corner_dir (:C Dg) (:A A2_m1) (:D *D_side))
  (OR ((opposite D (:Opp *D1))
       (opposite (:D D_side) (:Opp *D2)))
      ((= D1 D)
       (= D2 D_side)))
  (opposite (:D D1) (:Opp *O1))
  (margin (:B R) (:D O1) (:K *T))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B R) (:D O2) (:K *J))
  (&rise (:N *K))
  (divide T (:Side K) (:Gap 0) (:Part J) (:Remainder 0)))

(RULE &region
  (&on_slant (:P *Q))
  (input *P)
  (OR ((= P Q))
      ((&rise_axis *A)
       (perp A (:A2 *A2_m1))
       (axis_of (:D *D_m2) (:A A2_m1))
       (margin (:B P) (:D D_m2) (:K *K_m3))
       (margin (:B Q) (:D D_m2) (:K K_m3))
       (&base (:D *B))
       (dir_elem (:D B))
       (margin (:B P) (:D B) (:K *K1_m4))
       (margin (:B Q) (:D B) (:K *K2_m5))
       (< K1_m4 K2_m5))))

(DET &paint
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col)))
  (&rise_axis *A)
  (perp A *A2)
  (axis_of *D (:A A2))
  (ex_input E (:P *Q) (:Col *Col_bar))
  (&bar (:C Col_bar))
  (dir_elem D)
  (margin (:B P) D (:K *K1_m1))
  (margin (:B Q) D (:K *K2_m2))
  (< K1_m1 K2_m2))

(RULE &output
  (OR ((&region *P)
       (&bar_cell (:P *Q))
       (OR ((&rise_axis *A)
            (perp A (:A2 *A2_m1))
            (axis_of (:D *D_m2) (:A A2_m1))
            (margin (:B P) (:D D_m2) (:K *K_m3))
            (margin (:B Q) (:D D_m2) (:K K_m3))
            (&bar (:C *Col)))
           ((dir_elem *D)
            (margin (:B P) D (:K *K1_m4))
            (margin (:B Q) D (:K *K2_m5))
            (< K1_m4 K2_m5)
            (&paint D Col))))
      ((input P)
       (NOT (&region P))
       (&bg (:C Col)))))
