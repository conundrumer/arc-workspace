;; 470c91de

(DET &bg DominantColor)

(DET &marker ChangedColor)

(INIT &bx BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &corner_cell
  (&bx.box (:key *Col) *B)
  (input *P)
  (ALL ((&bx.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &slide
  (&corner_cell *Col *D *P)
  (input P (:Col *M))
  (&marker (:C M))
  (NOT (&marker (:C Col))))

(ALTS $choice "what names the corner" $Mark
  (ALT $Gap
    ;; The bitten corner. Two bites name no single direction, so `value` drops them.
    (INIT &gap Singleton
      (key ((&corner_cell ^Col *D *P)
            (NOT (&bx.cell (:key Col) P)))
        (member ((:v D))
          (&corner_cell Col *D *P)
          (NOT (&bx.cell P)))))

    (RULE &ragged
      (&bx.box (:key *Col) *B)
      (input *P)
      (ALL ((&bx.box (:key (:Col *Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (NOT (&bx.cell (:key Col) P))
      (NOT (&corner_cell Col P)))

    (RULE &slide
      (&gap.value (:key *Col) (:v *D))
      (NOT (&ragged Col)))))

(RULE &painted
  (&slide *Col *D)
  (&bx.box (:key Col) *B)
  (input (:P *P2))
  (ALL ((&bx.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P)
       (NOT (&painted P))
       (&bg (:C Col)))))
