;; 00dbd492

(DET &regions_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &changed
  (ex_input *E *P (:Col *C_in))
  (ex_output E P *Col)
  (!= Col C_in))

(INIT &regions Quotient
  (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
    (OR ((&changed *E *P)
         (&regions_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&changed E (:P P3)))
        ((&changed E P)
         (= P3 P)))))

(DET &regions_component
  (&regions.class (:a *Key *P) *Id))

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The square's wall is one ink component, so its box is the square.
(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(INIT &bbox BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(RULE &viewed
  (input *P)
  (&bbox.box (:key *Id) *B)
  (ALL ((input P)
        (&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(RULE &region2
  (&viewed *Id *P)
  (&bg_cell P))

(DET &region
  (&regions_component (:Key *E) *P *Id)
  (&changed E P *Col))

(INIT &rbox BoundingBox
  (key ((&region ^E ^Id *P))
    (cell (P)
      (&region E Id *P))))

(DET &size_fill
  (&region (:E *H_e) (:Id *H_id) *P *Col)
  (&rbox.box (:key (:E H_e) (:Id H_id)) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N))

(ALTS $choice "how the fill is found" $Recolor
  (ALT $Recolor
    (ALTS $r "how the empty region is delimited" $Box
      (ALT $Enclose
        (RULE &closed_flood_steps
          (dir_elem *D)
          (step_offset D (:V *Delta)))
        (RULE &closed_steps
          (dir_elem *D)
          (step_offset D (:V *Delta)))
        (RULE &closed_cell
          (&bg_cell *P))
        (INIT &closed_flood Propagation
          (source ((:n P))
            (&closed_cell *P)
            (dir_elem *D)
            (margin (:B P) D (:K 0))
            (&bg_cell P))
          (edge ((:a P) (:b P2))
            (&bg_cell *P)
            (&closed_flood_steps (:Delta *S))
            (compose (:A P) (:B S) (:C *P2))
            (&bg_cell (:P P2))))
        (RULE &closed_node
          (&closed_cell *P)
          (NOT (&closed_flood.reached (:n P))))
        ;; $Enclose: the bg regions closed off from the grid edge.
        (INIT &closed Quotient
          (edge ((:a P) (:b P2))
            (OR ((&closed_node *P)
                 (&closed_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *P2))
                 (&closed_node (:P P2)))
                ((&closed_node P)
                 (= P2 P)))))
        (RULE &closed_component
          (&closed.class (:a *P) *Id))
        (RULE &region2
          (&closed_component *P *Id))))
    (ALTS $k "how the region's size is measured" $Size
      (ALT $Count
        (INIT &region_size2 Cardinality
          (key ((&region2 ^Id *P))
            (member ((:m P))
              (&region2 Id *P))))
        (INIT &region_size Cardinality
          (key ((&region ^E ^Id *P))
            (member ((:m P))
              (&region E Id *P))))
        (DET &count_fill
          (&region_size.size (:key (:E *H_e) (:Id *H_id)) *N)
          (&region (:E H_e) (:Id H_id) *Col))
        (RULE &fill
          (&region_size2.size (:key *Id) *N)
          (&count_fill N *Col)))))
  (ALT $Replace
    (RULE &inner
      (input *P)
      (&bbox.box (:key *Id) *B)
      (ALL ((input P)
            (&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    (DET &obj_member
      (&inner *E *Id *P *P_inner)
      (&ink E P))

    (DET &rewritten
      (&inner *E *Id *P)
      (&changed E P))

    ;; One id per distinct object.
    (INIT &same2 Inclusion
      (pattern ((:pattern (:E O_e) (:Id O_id)) (:m P_inner))
        (&rewritten (:E *O_e) (:Id *O_id))
        (&obj_member (:E O_e) (:Id O_id) *P_inner))
      (observed ((:observed (:E O_e) (:Id O_id)) (:m P_inner))
        (&rewritten (:E *O_e) (:Id *O_id))
        (&obj_member (:E O_e) (:Id O_id) *P_inner)))

    (INIT &entry Quotient
      (equivalent ((:a (:E O_e) (:Id O_id)) (:b (:E O2_e) (:Id O2_id)))
        (&same2.equal (:observed (:E *O_e) (:Id *O_id)) (:pattern (:E *O2_e) (:Id *O2_id)))))

    (DET &patch_member
      (&entry.class (:a (:E *O_e) (:Id *O_id)) *Id)
      (&obj_member (:E O_e) (:Id O_id) (:P_inner *P)))

    (INIT &same Inclusion
      (pattern ((:pattern Pat) (:m P))
        (&patch_member (:Id *Pat) *P))
      (observed ((:observed Id) (:m P_inner))
        (&inner *Id *P *P_inner)
        (&ink P)))

    (DET &obj_out
      (&inner *E *Id *P *P_inner)
      (ex_output E P *Col))

    (DET &patch_out
      (&entry.class (:a (:E *O_e) (:Id *O_id)) *Id)
      (&obj_out (:E O_e) (:Id O_id) (:P_inner *P) *Col))

    (RULE &painted
      (&same.equal (:observed *Id) (:pattern *Pat))
      (&patch_out (:Id Pat) (:P *P_inner) *Col)
      (&inner Id *P P_inner))))

(INIT &rbox2 BoundingBox
  (key ((&region2 ^Id *P))
    (cell (P)
      (&region2 Id *P))))

(RULE &fill
  (&rbox2.cell (:key *Id) *P)
  (&rbox2.box (:key Id) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N)
  (&size_fill N *Col))

(RULE &painted
  (&region2 *Id *P)
  (&fill Id *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
