;; 57aa92db

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(RULE &obj_cell
  (&objs_component *P *Id)
  (input P *Col))

(RULE &mark_col
  (&obj_cell *Col)
  (ALL ((&obj_cell (:Id *O)))
       ((&obj_cell (:Id O) Col))))

;; The mark's block: one tile of the object's copy, and so its size.
(INIT &block BoundingBox
  (key ((&obj_cell (:Id ^O) *P *Col)
        (&mark_col Col))
    (cell (P)
      (&obj_cell (:Id O) *P *Col)
      (&mark_col Col))))

(RULE &obj_grid_dim
  (&block.cell (:key (:O *Key)) *P)
  (&block.box (:key (:O Key)) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K)))

(INIT &obj_box BoundingBox
  (key ((&obj_cell (:Id ^O) *P))
    (cell (P)
      (&obj_cell (:Id O) *P))))

(RULE &obj_inner
  (&obj_box.cell (:key (:O *Id)) (:P *P_grid))
  (&obj_box.box (:key (:O Id)) *B)
  (ALL ((&obj_box.cell (:key (:O *Om)) (:P P_grid))
        (&obj_box.box (:key (:O Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

(RULE &obj_grid_cell
  (&obj_grid_dim *Key)
  (&obj_inner (:P_inner *P)))

(RULE &obj_grid_axis_split1
  (&obj_grid_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &obj_grid_axis
  (OR ((&obj_grid_cell *Key *P)
       (&obj_grid_dim Key *A (:K *N))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side N) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side N) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A N))
      ((&obj_grid_cell Key P)
       (axis_elem A)
       (NOT (&obj_grid_dim Key A))
       (&obj_grid_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &obj_grid_tile
  (&obj_grid_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&obj_grid_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &fullest_count Cardinality
  (key ((&obj_inner (:Id ^O) *P_inner)
        (&obj_grid_tile (:Key O) (:P P_inner) (:P_outer *P_tile)))
    (member ((:m P_tile))
      (&obj_inner (:Id O) *P_inner)
      (&obj_grid_tile (:Key O) (:P P_inner) (:P_outer *P_tile)))))

(RULE &block_inner
  (&block.box (:key (:O *Id)) *B)
  (input (:P *P_grid))
  (ALL ((&block.box (:key (:O *Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_intile)))

;; The template: the object showing the most tiles of the shape.
(INIT &fullest Order
  (member ((:t O))
    (&fullest_count.size (:key *O)))
  (score ((:t O) (:S N))
    (&fullest_count.size (:key *O) *N)))

(RULE &shape_cell
  (&fullest.maximal (:t *O))
  (&obj_inner (:Id O) *P_grid *P_inner)
  (input (:P P_grid) *Col)
  (&obj_grid_tile (:Key O) (:P P_inner) (:P_outer *P_tile)))

(INIT &seat_tiling Tiling
  (outer ((:P P_tile))
    (&shape_cell *P_tile *Col)
    (&mark_col Col))
  (inner ((:P P_intile))
    (&block_inner *P_intile)))

(INIT &stamp_tiling Tiling
  (outer ((:P P_tile))
    (&shape_cell *P_tile))
  (inner ((:P P_intile))
    (&block_inner *P_intile)))

(RULE &body_col
  (&obj_cell *Id *Col)
  (NOT (&mark_col Col)))

(RULE &seat
  (&seat_tiling.cell (:P_inner *P_intile) (:P *P_stamp))
  (&block_inner *Id *P_grid P_intile)
  (relative (:Base P_stamp) (:X P_grid) (:X_rel *V)))

(RULE &stamp
  (&seat *Id *V)
  (&shape_cell *P_tile *Col)
  (&block_inner Id *P_intile)
  (&stamp_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_stamp))
  (compose (:A P_stamp) (:B V) (:C *P_grid))
  (input (:P P_grid)))

(RULE &output
  (OR ((&stamp (:Id *O) (:P_grid *P) (:Col *C_shape))
       (OR ((NOT (&mark_col (:Col C_shape)))
            (&body_col (:Id O) *Col))
           ((&mark_col (:Col C_shape))
            (= Col C_shape))))
      ((input P)
       (NOT (&stamp (:P_grid P)))
       (&bg (:C Col)))))
