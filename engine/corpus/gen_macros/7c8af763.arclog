;; 7c8af763

(RULE &regions_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg ChangedColor)

(INIT &regions Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&bg (:C Col))
         (&regions_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&bg (:C Col2)))
        ((input P (:Col *Col3))
         (&bg (:C Col3))
         (= P3 P)))))

(RULE &regions_component
  (&regions.class (:a *P) *Id))

(DET &line UnchangedColor)

(RULE &touch
  (input *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (NOT (&bg (:C Col)))
  (NOT (&line (:C Col))))

(INIT &region_vote_count Cardinality
  (key ((&regions_component *P ^Id)
        (&touch P *Q ^Col))
    (member ((:m Q))
      (&regions_component *P Id)
      (&touch P *Q Col))))

(INIT &region_vote Order
  (key ((&region_vote_count.size (:key ^Id *Col)))
    (member ((:t Col))
      (&region_vote_count.size (:key Id *Col)))
    (score ((:t Col) (:S N))
      (&region_vote_count.size (:key Id *Col) *N))))

(ALTS $choice "how a region is parsed" $Region
  (ALT $Tile
    (RULE &bg_line_split1
      (input (:P *P_) *Col)
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &bg_line
      (input *P *Col)
      (&bg (:C Col))
      (axis_elem *A)
      (&bg_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

    (RULE &tiles_divider_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &tiles_divider
      (input *P)
      (axis_elem *A)
      (&tiles_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
      (NOT (&bg_line L)))

    (RULE &tiles_on_divider
      (input *P *Col)
      (&bg (:C Col))
      (&tiles_divider *A *L)
      (axis_of *D A)
      (margin (:B P) D (:K *K_m1))
      (margin (:B L) D (:K K_m1)))

    (INIT &tiles_rank Order
      (key ((OR ((&tiles_divider *A *L)
                 (axis_of ^D A)
                 (margin (:B L) D *K))
                ((input *P *Col)
                 (&bg (:C Col))
                 (dir_elem D)
                 (margin (:B P) D K))))
        (member ((:t K))
          (&tiles_divider *A *L)
          (axis_of D A)
          (margin (:B L) D *K))
        (score ((:t K) (:S K))
          (OR ((&tiles_divider *A *L)
               (axis_of D A)
               (margin (:B L) D *K))
              ((input *P *Col)
               (&bg (:C Col))
               (dir_elem D)
               (margin (:B P) D K))))
        (probe ((:t K))
          (input *P *Col)
          (&bg (:C Col))
          (dir_elem D)
          (margin (:B P) D *K))))

    (RULE &tiles_part_idx
      (input *P *Col)
      (&bg (:C Col))
      (axis_of *D *A)
      (NOT (&tiles_on_divider P A))
      (margin (:B P) D *K)
      (&tiles_rank.rank (:key D) (:t K) (:R *N)))

    (RULE &tiles_part_of
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&tiles_part_idx *P D (:N *N1))
      (&tiles_part_idx P (:D D2) (:N *N2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K N1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

    (RULE &tiles_tile_of
      (&tiles_part_of *P *A (:P_part *P1))
      (perp A *A2)
      (&tiles_part_of P (:A A2) (:P_part *P2))
      (compose (:A P1) (:B P2) (:C *P_tile)))

    (INIT &tile_vote_count Cardinality
      (key ((&tiles_tile_of *P ^P_tile)
            (&touch P *Q ^Col))
        (member ((:m Q))
          (&tiles_tile_of *P P_tile)
          (&touch P *Q Col))))

    (INIT &tile_vote Order
      (key ((&tile_vote_count.size (:key ^P_tile *Col)))
        (member ((:t Col))
          (&tile_vote_count.size (:key P_tile *Col)))
        (score ((:t Col) (:S N))
          (&tile_vote_count.size (:key P_tile *Col) *N))))

    (RULE &output
      (OR ((&tiles_tile_of *P *P_tile)
           (&tile_vote.maximal (:key P_tile) (:t *Col)))
          ((input P Col)
           (NOT (&bg (:C Col))))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&bg (:C Col))))
      ((&regions_component P *Id)
       (&region_vote.maximal (:key Id) (:t Col)))))
