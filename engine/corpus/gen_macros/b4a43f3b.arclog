;; b4a43f3b

(INPUT two-halves "the input is two equal halves on one axis, on each side of its middle line, and that line is a full line of 5")

(INPUT scaled-picture "the half on &pattern_side is a picture scaled up by &pattern_scale, so each picture cell is a block of one color, &background included, &pattern_scale cells on a side"

  (DET_OR_RULE &pattern_scale "A block's side." SepTileCount)

  (DET_OR_RULE &background DominantColor)

  ;; The side of the dividing line that holds the picture; the mask is on the opposite side.
  (DET &pattern_side DirDomain))

(INPUT mask "the other half is a mask: cells of 2 on &background, one input cell per mask cell")

(INPUT half-extent "each half is 6×6, so the picture is 6 / &pattern_scale on a side")

(OUTPUT picture-down "the picture is the half on &pattern_side, read at one cell per block of &pattern_scale cells on a side"

  (RULE &divider_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &divider
    (input *P)
    (axis_elem *A)
    (&divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (axis_of *D A)
    (opposite D (:Opp *O_m2))
    (margin (:B L) D *K)
    (margin (:B L) (:D O_m2) K))

  (RULE &half_cell
    (&divider *A *L)
    (axis_of (:D *H) A)
    (input *P)
    (dir_elem (:D H))
    (margin (:B P) (:D H) (:K *K1_m1))
    (margin (:B L) (:D H) (:K *K2_m2))
    (< K1_m1 K2_m2))

  (INIT &half_box BoundingBox
    (key ((&half_cell (:H ^D) *P))
      (cell (P)
        (&half_cell (:H D) *P))))

  (RULE &half_px
    (&half_box.box (:key (:D *H)) *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (&half_box.box (:key (:D *Hm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner)))

  (RULE &block_division_cell
    (&half_px (:P_inner *P))
    (&pattern_scale (:K *Key)))

  (RULE &block_division_axis_split1
    (&block_division_cell (:Key *Ky) (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
    (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

  (RULE &block_division_side_held
    (axis_elem *A)
    (&pattern_scale *K))

  (RULE &block_division_axis
    (OR ((&block_division_cell *Key *P)
         (axis_elem *A)
         (&pattern_scale (:K Key))
         (axis_of *D A)
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T))
         (margin (:B P) (:D O) (:K *T2))
         (divide T (:Side Key) (:Gap 0) (:Part *I) (:Remainder *R))
         (divide (:T T2) (:Side Key) (:Gap 0) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
         (frame_extent (:P P_inner) A (:N Key)))
        ((&block_division_cell Key P)
         (axis_elem A)
         (NOT (&block_division_side_held (:K Key) A))
         (&block_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

  (RULE &block_division_tile
    (&block_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&block_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (RULE &block
    (&half_px *H *P_inner)
    (&block_division_tile (:Key *K) (:P P_inner) (:P_outer *Q)))

  (RULE &broken
    (&block *K *H (:P_inner *P1) *Q)
    (&half_px H (:P_inner P1) (:Col *C1))
    (&block K H (:P_inner *P2) Q)
    (&half_px H (:P_inner P2) (:Col *C2))
    (!= C1 C2))

  ;; The colors of each half's non-background cells.
  (INIT &half_ink Singleton
    (key ((&half_px (:H ^D) *Col)
          (NOT (&background Col)))
      (member ((:v Col))
        (&half_px (:H D) *Col)
        (NOT (&background Col))))))

(OUTPUT output-size "the output is the mask's extent times the picture's extent on each axis")

(OUTPUT stamp-at-marks "the output is cut into a tile per mask cell, each the size of the picture; the tile of a marked mask cell holds the picture, and the tile of an unmarked mask cell is &background"

  ;; The axis the two halves lie along.
  (DET &halves_axis AxisDomain))

(ALTS $side "which half holds the picture" $StoredSide
  (ALT $PictureByBlocks
    (OUTPUT picture-down "of the two halves along &halves_axis, the picture is the one in blocks of one color, more than one cell each, and the mask is the other; undefined where both halves or neither half is in blocks"
      (RULE &blocky
        (&block *K *H (:P_inner *P1) *Q)
        (&block K H (:P_inner *P2) Q)
        (!= P1 P2)
        (NOT (&broken K H))))
    (RULE &picture_side
      (&halves_axis *A)
      (axis_of *D A)
      (opposite D (:Opp *D2))
      (&blocky (:H D))
      (NOT (&blocky (:H D2)))))
  (ALT $PictureByColors
    (OUTPUT picture-down "of the two halves along &halves_axis, the mask is the one whose non-background cells have one color, and the picture is the other; undefined where both halves or neither half has one color")
    (RULE &picture_side
      (&halves_axis *A)
      (axis_of *D A)
      (opposite D (:Opp *D2))
      (&half_ink.value (:key (:D D2)))
      (NOT (&half_ink.value (:key D))))))

(ALTS $scale "what fixes the block side the picture is read at" $StoredScale
  (ALT $ScaleFromBlocks
    (OUTPUT picture-down "the block side is the largest side such that the picture's half is in aligned square blocks of one color with that side"
      (RULE &side_cand
        (&half_px *H (:P_inner *P))
        (axis_elem *A)
        (OR ((sub_extent P A *K))
            ((frame_extent P A (:N K)))))

      (RULE &block_division2_axis_split1
        (&half_px *H (:P_inner *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      (RULE &block_division2_side_held
        (axis_elem *A)
        (&side_cand *H *K))

      (RULE &block_division2_axis
        (OR ((&side_cand (:H *D) *K)
             (&half_px (:H D) (:P_inner *P))
             (axis_elem *A)
             (axis_of (:D *D2) A)
             (opposite (:D D2) (:Opp *O))
             (margin (:B P) (:D D2) (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
             (opposite (:D D2) (:Opp *O_m1))
             (edge_inset (:D D2) (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
             (opposite (:D D2) (:Opp *O_m4))
             (edge_inset (:D D2) (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
             (frame_extent (:P P_inner) A (:N K)))
            ((&side_cand (:H D) K)
             (&half_px (:H D) (:P_inner P))
             (axis_elem A)
             (NOT (&block_division2_side_held K (:H D) A))
             (&block_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

      (RULE &block_division2_tile
        (&block_division2_axis *K *D *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&block_division2_axis K D P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

      (RULE &block
        (&block_division2_tile *K (:D *H) (:P *P_inner) (:P_outer *Q)))

      ;; The largest block side whose cut is whole and puts one color in each block.
      (INIT &sides Order
        (key ((&block *K (:H ^D))
              (NOT (&broken K (:H D))))
          (member ((:t K))
            (&block *K (:H D))
            (NOT (&broken K (:H D))))
          (score ((:t K) (:S K))
            (&block *K (:H D))
            (NOT (&broken K (:H D)))))))
    (RULE &cut
      (&sides.maximal (:key (:D *H)) (:t *K))))
  (ALT $StoredPictureExtent
    (OUTPUT picture-down "the picture is &picture_extent on a side, so a block's side is the half's extent over it; undefined where the half's extent is not a multiple of it"
      ;; The picture's side.
      (DET &picture_extent ScaleRatio)

      (RULE &block_division3_cell
        (&half_px (:P_inner *P))
        (&picture_extent (:K *Key)))

      (INIT &block_division3_sides ExtentDivisions
        (key ((&block_division3_cell (:Key ^Ky) *P))
          (frame (P)
            (&block_division3_cell (:Key Ky) *P))))

      (RULE &block_division3_axis_split1
        (&block_division3_cell (:Key *Ky) (:P *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      (RULE &block_division3_parts_held
        (axis_elem *A)
        (&picture_extent (:K *N)))

      (RULE &block_division3_axis
        (OR ((&block_division3_cell *Key *P)
             (axis_elem *A)
             (&picture_extent (:K Key))
             (&block_division3_sides.division (:key (:Ky Key)) A (:N Key) *K (:G 0))
             (axis_of *D A)
             (opposite D (:Opp *O))
             (margin (:B P) D (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
             (opposite D (:Opp *O_m1))
             (edge_inset D (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
             (opposite D (:Opp *O_m4))
             (edge_inset D (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
             (frame_extent (:P P_inner) A (:N K)))
            ((&block_division3_cell Key P)
             (axis_elem A)
             (&picture_extent (:K Key))
             (frame_extent P A (:N *K2))
             (axis_of (:D *D2) A)
             (opposite (:D D2) (:Opp *O2))
             (margin (:B P) (:D D2) (:K *T3))
             (margin (:B P) (:D O2) (:K *T22))
             (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
             (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
             (opposite (:D D2) (:Opp *O_m12))
             (edge_inset (:D D2) (:K I3) (:B *B1_m22))
             (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
             (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
             (opposite (:D D2) (:Opp *O_m42))
             (edge_inset (:D D2) (:K R3) (:B *B1_m52))
             (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
             (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
             (frame_extent (:P P_inner) A (:N K2))
             (frame_extent (:P P_outer) A (:N Key)))
            ((&block_division3_cell Key P)
             (axis_elem A)
             (NOT (&block_division3_parts_held (:N Key) A))
             (&block_division3_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

      (RULE &block_division3_tile
        (&block_division3_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&block_division3_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

      (RULE &block
        (&half_px *H *P_inner)
        (&block_division3_tile (:Key *K) (:P P_inner) (:P_outer *Q))))))

(ALTS $mark "which mask cells take a copy of the picture" $NotBackground
  (ALT $MarkByColor
    (OUTPUT stamp-at-marks "a mask cell is marked when it is &mask_color"
      (DET &mask_color SharedColor))
    (RULE &marked
      (&half_px *H *P_inner *Col)
      (&mask_color (:C Col)))))

(ALTS $split "where the input splits into its halves" $MiddleLine
  (ALT $SplitAtSeparator
    (INPUT two-halves "the input is two halves on one axis, on each side of the one full line of &separator_color; undefined where no such line or several exist"
      (RULE &sep_gap_split1
        (input (:P *P_) *Col)
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *L_))
        (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

      (RULE &sep_line_split1
        (input (:P *P_) *Col)
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *L_))
        (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

      (DET &separator_color VanishedColor)

      (RULE &sep_line
        (input *P *Col)
        (&separator_color (:C Col))
        (axis_elem *A)
        (&sep_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
        (ALL ((input (:P *Pm) (:Col *Colm))
              (&sep_gap_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
             ((&separator_color (:C Colm)))))

      (RULE &divider
        (&sep_line *A *L)
        (ALL ((&sep_line A (:L *L1))
              (&sep_line A (:L *L2)))
             ((= L1 L2)))))))

(RULE &cut
  (&block *K *H))

(RULE &picture
  (&cut *K *H)
  (&block K H (:P_inner *P) *Q)
  (&half_px H (:P_inner P) *Col))

(INIT &output_tiling Tiling
  (outer ((:P M))
    (&half_px (:P_inner *M)))
  (inner ((:P Q))
    (&picture *Q)))

(RULE &marked
  (&half_px *H *P_inner *Col)
  (NOT (&background Col)))

(RULE &picture_side
  (&pattern_side *D))

;; Each mask cell's tile: the picture where the cell is marked, and
;; &background where it is not.
(RULE &output
  (&picture_side *D)
  (opposite D (:Opp *D2))
  (&half_px (:H D2) (:P_inner *M))
  (&picture (:H D) *Q (:Col *Col_pic))
  (&output_tiling.cell (:P_outer M) (:P_inner Q) *P)
  (OR ((NOT (&marked (:H D2) (:P_inner M)))
       (&background *Col))
      ((&marked (:H D2) (:P_inner M))
       (= Col Col_pic))))
