;; 4c416de3

(RULE &frames_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The color the outlines are drawn in.
(DET &frame SharedColor)

(RULE &drawn
  (input *P *Col)
  (&frame (:C Col)))

(RULE &outline
  (OR ((&drawn *P))
      ((input P)
       (opposite *D (:Opp *D2))
       (step_offset D (:V *V_m1))
       (compose (:A P) (:B V_m1) (:C *Q))
       (&drawn (:P Q))
       (step_offset (:D D2) (:V *V_m2))
       (compose (:A P) (:B V_m2) (:C *Q2))
       (&drawn (:P Q2)))))

(INIT &frames Quotient
  (edge ((:a P) (:b P3))
    (OR ((&outline *P)
         (&frames_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&outline (:P P3)))
        ((&outline P)
         (= P3 P)))))

(RULE &frames_component
  (&frames.class (:a *P) *Id))

(RULE &marks_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &bg_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg Order
  (member ((:t Col))
    (&bg_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&frame (:C Col)))
  (NOT (&bg.maximal (:t Col))))

(INIT &marks Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&ink *P *Col)
         (&marks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3) Col))
        ((&ink P Col)
         (= P3 P)))))

(RULE &marks_component
  (&marks.class (:a *Key *P) *Id))

(INIT &boxes BoundingBox
  (key ((&frames_component *P ^Id))
    (cell (P)
      (&frames_component *P Id))))

(RULE &site
  (input *P)
  (&boxes.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(INIT &mark_boxes BoundingBox
  (key ((&marks_component *P ^Id))
    (cell (P)
      (&marks_component *P Id))))

(RULE &shape
  (&site (:P *P_site) *D)
  (&mark_boxes.box (:key *Id) *B)
  (ALL ((&site (:P P_site) (:D *Dm))
        (&mark_boxes.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_site) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (&marks_component *P Id)
  (relative (:Base P_site) (:X P) (:X_rel *V)))

(RULE &stamp
  (&site (:P *P_site) *D)
  (&shape (:D *D_whole) *V)
  (d4_elem (:D *G))
  (diag_dir_elem (:D D_whole))
  (diag_dir_elem D)
  (step_offset (:D D_whole) (:V *S_m1))
  (apply (:D G) (:P S_m1) (:P_out *S2_m2))
  (step_offset D (:V S2_m2))
  (apply (:D G) (:P V) (:P_out *V_here))
  (compose (:A P_site) (:B V_here) (:C *P)))

(RULE &painted
  (&stamp *P_site *P)
  (&stamp P_site (:P *Q))
  (&ink (:P Q) *Col))

(ALTS $choice "which cells of a completed stamp get painted" $Cover
  (ALT $Fill
    (RULE &open
      (OR ((input *P *Col)
           (&bg.maximal (:t Col)))
          ((&drawn P))))

    (RULE &filled
      (&painted *P *Col)
      (&open P))

    (RULE &output
      (OR ((input *P)
           (&filled P *Col))
          ((input P Col)
           (NOT (&filled P)))))))

(RULE &output
  (OR ((input *P)
       (&painted P *Col))
      ((input P Col)
       (NOT (&painted P)))))
