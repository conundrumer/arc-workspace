;; c61be7dc

(INPUT field "every cell that is not a line or the shape has color background")

(INPUT walls "two full lines of color line_color, parallel to each other, bound a corridor whose width is odd and at least 3")

(INPUT cross-line "one line of color line_color, perpendicular to the walls, runs from edge to edge outside the corridor, and inside the corridor the input shows only shape or background on it"

  (RULE &item_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

  ;; The one color of each line that holds one color alone.
  (INIT &full_line Singleton
    (key ((input *P *Col)
          (axis_elem ^A)
          (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ ^L)))
      (member ((:v Col))
        (input *P *Col)
        (axis_elem A)
        (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ L)))))

  (DET &filled
    (&full_line.value *E (:v *Col)))

  (DET &unfilled
    (&filled *Col)
    (ex_input *E)
    (NOT (&filled E Col)))

  (DET &line_color3
    (&filled (:Col *C))
    (NOT (&unfilled (:Col C))))

  (DET &line_color2
    (&line_color3 (:C *Col))
    (ex_input *E))

  (DET &full2
    (&full_line.value *E (:key *A *L) (:v *Col))
    (&line_color2 E Col))

  ;; The walls' axis: the one axis with full lines of line_color.
  (INIT &walls2 Singleton
    (key ((&full2 ^E *A))
      (member ((:v A))
        (&full2 E *A))))

  (DET &wall_axis2
    (&walls2.value (:key *E) (:v *A)))

  (DET &gap_axis2
    (&wall_axis2 *E (:A *A3))
    (perp (:A A3) (:A2 *A)))

  (DET &gap_dir2
    (&gap_axis2 *E *A)
    (axis4_of *D A))

  (DET &gap_node2
    (&gap_axis2 *E)
    (ex_input E *P))

  (DET &place_split12
    (ex_input (:E *Ky) (:P *P_))
    (&wall_axis2 (:E Ky) (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L1_))
    (relative (:Base L1_) (:X P_) (:X_rel *L2_)))

  (DET &place2
    (ex_input *E *P)
    (&wall_axis2 E *A)
    (&place_split12 (:P_ P) (:A_ A) (:L1_ *Along) (:L2_ *Across)))

  (DET &wall2
    (&place2 *E *P (:Across *L))
    (&full2 E L))

  (DET &gap_source2
    (&wall2 *E *P))

  (INIT &gap2 Distance
    (key ((&gap_source2 (:E ^Ky) (:P ^O))
          (&gap_dir2 (:E Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&gap_source2 (:E Ky) (:P O))
             (&gap_dir2 (:E Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&gap_node2 (:E Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&gap_node2 (:E Ky) (:P Q)))
            ((&gap_source2 (:E Ky) (:P O))
             (&gap_dir2 (:E Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&gap_node2 (:E Ky) (:P Q))
             (= A2 O))
            ((&gap_source2 (:E Ky) (:P O))
             (&gap_dir2 (:E Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&gap_node2 (:E Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&gap_node2 (:E Ky) (:P Q)))))
      (source ((:n O))
        (&gap_source2 (:E Ky) (:P O))
        (&gap_dir2 (:E Ky) D))))

  (DET &gap_ray2
    (&gap2.distance (:key (:Ky *E) *D (:O *Origin)) (:n *P) *K))

  (DET &gap_between2
    (ex_input *E *P)
    (&gap_axis2 E *A)
    (axis4_of *D A)
    (dir8_opposite D (:D2 *O))
    (&gap_ray2 E P D)
    (&gap_ray2 E P (:D O)))

  (DET &corridor2
    (&gap_between2 *E *P)
    (NOT (&wall2 E P)))

  ;; The one color each line across the walls shows outside the corridor.
  (INIT &outside2 Singleton
    (key ((ex_input (:E ^Ky) *P *Col)
          (NOT (&corridor2 (:E Ky) P))
          (&place2 (:E Ky) P (:Along ^L)))
      (member ((:v Col))
        (ex_input (:E Ky) *P *Col)
        (NOT (&corridor2 (:E Ky) P))
        (&place2 (:E Ky) P (:Along L))))))

(INPUT shape "the cells of color shape_color all lie in the corridor, are symmetric about the cross line, and are odd in number")

(OUTPUT close-walls "each wall moves to the line next to the corridor's center line, and the cells of the old walls take background, except where the cross line passes")

(OUTPUT press-shape "the shape becomes a line of shape_color on the corridor's center line, with as many cells as the shape has, centered on the cross line; every other cell of the old corridor that no wall or cross line takes is background"

  (DET &held
    (&corridor2 *E *P)
    (ex_input E P *Col))

  (DET &stray
    (OR ((&held *Col)
         (ex_input *E *P Col)
         (NOT (&corridor2 E P)))
        ((&held Col)
         (ex_input (:E *E2))
         (NOT (&held (:E E2) Col)))))

  (DET_OR_RULE &shape_color RarestColor
    (&held (:Col *C))
    (NOT (&stray (:Col C))))

  (RULE &shape
    (input *P *Col)
    (&shape_color (:C Col)))

  (INIT &shape_box BoundingBox
    (cell (P)
      (&shape *P))))

(OUTPUT restore-cross-line "the cross line runs from edge to edge in the output, across the old corridor too, and the shape's line covers it at the one cell where they meet"

  (RULE &line_color
    (&line_color3 (:C *Col)))

  (RULE &full
    (&full_line.value (:key *A *L) (:v *Col))
    (&line_color Col))

  ;; The walls' axis: the one axis with full lines of line_color.
  (INIT &walls Singleton
    (member ((:v A))
      (&full *A)))

  (RULE &wall_axis
    (&walls.value (:v *A)))

  (RULE &gap_axis
    (&wall_axis (:A *A3))
    (perp (:A A3) (:A2 *A)))

  (RULE &gap_dir
    (&gap_axis *A)
    (axis4_of *D A))

  (RULE &gap_node
    (&gap_axis)
    (input *P))

  (RULE &place_split1
    (input (:P *P_))
    (&wall_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L1_))
    (relative (:Base L1_) (:X P_) (:X_rel *L2_)))

  (RULE &place
    (input *P)
    (&wall_axis *A)
    (&place_split1 (:P_ P) (:A_ A) (:L1_ *Along) (:L2_ *Across)))

  (RULE &wall
    (&place *P (:Across *L))
    (&full L))

  (RULE &gap_source
    (&wall *P))

  (INIT &gap Distance
    (key ((&gap_source (:P ^O))
          (&gap_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&gap_source (:P O))
             (&gap_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&gap_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&gap_node (:P Q)))
            ((&gap_source (:P O))
             (&gap_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&gap_node (:P Q))
             (= A2 O))
            ((&gap_source (:P O))
             (&gap_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&gap_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&gap_node (:P Q)))))
      (source ((:n O))
        (&gap_source (:P O))
        (&gap_dir D))))

  (RULE &gap_ray
    (&gap.distance (:key *D (:O *Origin)) (:n *P) *K))

  (RULE &gap_between
    (input *P)
    (&gap_axis *A)
    (axis4_of *D A)
    (dir8_opposite D (:D2 *O))
    (&gap_ray P D)
    (&gap_ray P (:D O)))

  (RULE &corridor
    (&gap_between *P)
    (NOT (&wall P)))

  (INIT &corridor_box BoundingBox
    (cell (P)
      (&corridor *P)))

  (RULE &across_host
    (&corridor_box.box *B))

  (RULE &center_line_split1
    (&across_host *B)
    (&place *P (:Across *L))
    (relative (:Base B) (:X P) (:X_rel *P_rel_))
    (&wall_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_rel_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_rel_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X P_rel_) (:X_rel *L_rel_)))

  ;; The one color each line across the walls shows outside the corridor.
  (INIT &outside Singleton
    (key ((input *P *Col)
          (NOT (&corridor P))
          (&place P (:Along ^L)))
      (member ((:v Col))
        (input *P *Col)
        (NOT (&corridor P))
        (&place P (:Along L)))))

  (RULE &cross
    (&place *P (:Along *L))
    (&outside.value (:key L) (:v *Col))
    (&line_color Col))

  (INIT &cross_box BoundingBox
    (cell (P)
      (&cross *P)))

  (RULE &along_host
    (&cross_box.box *B))

  (RULE &along_place_split1
    (&along_host *B)
    (&place *P (:Along *L))
    (relative (:Base B) (:X P) (:X_rel *P_rel_))
    (&wall_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_rel_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_rel_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_rel_))
    (relative (:Base L_rel_) (:X P_rel_) (:X_rel *X_m1_)))

  (INIT &size Cardinality
    (member ((:m P))
      (&shape *P))
    (domain ()))

  ;; The pressed line in a frame of its own, one cell per shape cell.
  (INIT &line Frame
    (key ((&wall_axis ^A))
      (extent (A N)
        (&size.size *N))))

  (RULE &center_line
    (&across_host *B)
    (&place *P (:Across *L))
    (ALL ((&place P (:Across *Lm))
          (&across_host B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (&wall_axis *A)
    (&center_line_split1 (:P_rel_ P_rel) (:A_ A) (:X_m1_ *X_m1) (:L_rel_ *L_rel))
    (ALL ((&across_host (:B *Bm))
          (&place (:P *Pm) (:Across *Lmm))
          (relative (:Base Bm) (:X Pm) (:X_rel *P_relm))
          (&wall_axis (:A *Am))
          (axis_of (:D *D_m2) (:A Am))
          (opposite (:D D_m2) (:Opp *O_m3))
          (margin (:B P_relm) (:D D_m2) (:K *K1_m4))
          (margin (:B P_relm) (:D O_m3) (:K *K2_m5))
          (opposite (:D D_m2) (:Opp *O_m6))
          (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
          (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
          (compose (:A B1_m7) (:B B2_m8) (:C *Along_m1))
          (relative (:Base Along_m1) (:X P_relm) (:X_rel L_rel))
          (opposite (:D *D_m1m) (:Opp *O_m2))
          (margin (:B L_rel) (:D D_m1m) (:K *K1_m3))
          (margin (:B L_rel) (:D O_m2) (:K *K2_m4)))
         ((= K1_m3 K2_m4))))

  (RULE &along_place
    (&along_host *B)
    (&place *P (:Along *L))
    (ALL ((&place P (:Along *Lm))
          (&along_host B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (&wall_axis *A)
    (&along_place_split1 (:P_rel_ P_rel) (:A_ A) (:L_rel_ *L_rel) (:X_m1_ *X_m1)))

  (RULE &span_place
    (OR ((&line.cell *P))
        ((&along_place (:L_rel P)))))

  (RULE &middle
    (&span_place *P)
    (&wall_axis *A)
    (axis_of *D A)
    (opposite D (:Opp *O))
    (margin (:B P) (:D O) *K)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (margin (:B Q) D K))

  (RULE &placement
    (&wall_axis *A)
    (axis_of *D A)
    (&line.cell (:P *P_line))
    (&along_place *L_rel *L)
    (OR ((axis_of (:D *D1_m1) (:A *A1_m2))
         (opposite (:D D1_m1) (:Opp *O1_m3))
         (perp (:A A1_m2) (:A2 *A2_m4))
         (axis_of (:D *D2_m5) (:A A2_m4))
         (opposite (:D D2_m5) (:Opp *O2_m6))
         (margin (:B P_line) (:D D1_m1) (:K *K1_m7))
         (margin (:B P_line) (:D O1_m3) (:K K1_m7))
         (margin (:B P_line) (:D D2_m5) (:K *K2_m8))
         (margin (:B P_line) (:D O2_m6) (:K K2_m8))
         (axis_of (:D *D1_m9) (:A *A1_m10))
         (opposite (:D D1_m9) (:Opp *O1_m11))
         (perp (:A A1_m10) (:A2 *A2_m12))
         (axis_of (:D *D2_m13) (:A A2_m12))
         (opposite (:D D2_m13) (:Opp *O2_m14))
         (margin (:B L_rel) (:D D1_m9) (:K *K1_m15))
         (margin (:B L_rel) (:D O1_m11) (:K K1_m15))
         (margin (:B L_rel) (:D D2_m13) (:K *K2_m16))
         (margin (:B L_rel) (:D O2_m14) (:K K2_m16)))
        ((&middle D (:P P_line))
         (&middle D (:P L_rel))))
    (relative (:Base P_line) (:X L) (:X_rel *V)))

  (RULE &placed
    (&placement *D)))

(ALTS $al "the point along the corridor that the pressed line centers on" $CrossLine
  (ALT $AlongShapeCenter
    (OUTPUT press-shape "the line centers on the middle of the shape's extent along the corridor; undefined where that extent and the count do not let the line center on that middle"
      (RULE &along_host
        (&shape_box.box *B))))
  (ALT $AlongGridMiddle
    (OUTPUT press-shape "the line centers on the grid's middle line across the corridor; undefined where the grid's extent along the corridor and the count do not let the line center there"
      (RULE &along_host
        (= *B 0)))))

(ALTS $ac "the line that the closed corridor centers on" $Corridor
  (ALT $AcrossShapeCenter
    (OUTPUT close-walls "the new walls flank the center line of the shape's extent across the corridor; undefined where that extent is even"
      (RULE &across_host
        (&shape_box.box *B)))
    (OUTPUT press-shape "the line sits on the center line of the shape's extent across the corridor"))
  (ALT $AcrossGridMiddle
    (OUTPUT close-walls "the new walls flank the grid's middle line parallel to the walls; undefined where the grid's extent across the walls is even"
      (RULE &across_host
        (= *B 0)))
    (OUTPUT press-shape "the line sits on the grid's middle line parallel to the walls")))

(ALTS $uc "a count that cannot center on the center point" $ExactCenter
  (ALT $EvenCountBothSides
    (INPUT shape "the cells of color shape_color all lie in the corridor and are symmetric about the cross line, in any number")
    (OUTPUT press-shape "where the line cannot center exactly, the output holds two grids, the placements half a cell off the center, one on each side"
      (RULE &placement
        ;; A line half a cell off the center.
        (OR ((&wall_axis *A)
             (axis_of *D A)
             (&line.cell (:P *P_line))
             (&along_place *L_rel *L)
             (OR ((axis_of (:D *D1_m1) (:A *A1_m2))
                  (opposite (:D D1_m1) (:Opp *O1_m3))
                  (perp (:A A1_m2) (:A2 *A2_m4))
                  (axis_of (:D *D2_m5) (:A A2_m4))
                  (opposite (:D D2_m5) (:Opp *O2_m6))
                  (margin (:B P_line) (:D D1_m1) (:K *K1_m7))
                  (margin (:B P_line) (:D O1_m3) (:K K1_m7))
                  (margin (:B P_line) (:D D2_m5) (:K *K2_m8))
                  (margin (:B P_line) (:D O2_m6) (:K K2_m8))
                  (&middle D (:P L_rel)))
                 ((&middle D (:P P_line))
                  (axis_of (:D *D1_m9) (:A *A1_m10))
                  (opposite (:D D1_m9) (:Opp *O1_m11))
                  (perp (:A A1_m10) (:A2 *A2_m12))
                  (axis_of (:D *D2_m13) (:A A2_m12))
                  (opposite (:D D2_m13) (:Opp *O2_m14))
                  (margin (:B L_rel) (:D D1_m9) (:K *K1_m15))
                  (margin (:B L_rel) (:D O1_m11) (:K K1_m15))
                  (margin (:B L_rel) (:D D2_m13) (:K *K2_m16))
                  (margin (:B L_rel) (:D O2_m14) (:K K2_m16))))
             (relative (:Base P_line) (:X L) (:X_rel *V)))
            ((&wall_axis (:A *A2))
             (axis_of D (:A A2))
             (&line.cell (:P *P_line2))
             (&along_place (:L_rel *L_rel2) (:L *L2))
             (OR ((axis_of (:D *D1_m12) (:A *A1_m22))
                  (opposite (:D D1_m12) (:Opp *O1_m32))
                  (perp (:A A1_m22) (:A2 *A2_m42))
                  (axis_of (:D *D2_m52) (:A A2_m42))
                  (opposite (:D D2_m52) (:Opp *O2_m62))
                  (margin (:B P_line2) (:D D1_m12) (:K *K1_m72))
                  (margin (:B P_line2) (:D O1_m32) (:K K1_m72))
                  (margin (:B P_line2) (:D D2_m52) (:K *K2_m82))
                  (margin (:B P_line2) (:D O2_m62) (:K K2_m82))
                  (axis_of (:D *D1_m92) (:A *A1_m102))
                  (opposite (:D D1_m92) (:Opp *O1_m112))
                  (perp (:A A1_m102) (:A2 *A2_m122))
                  (axis_of (:D *D2_m132) (:A A2_m122))
                  (opposite (:D D2_m132) (:Opp *O2_m142))
                  (margin (:B L_rel2) (:D D1_m92) (:K *K1_m152))
                  (margin (:B L_rel2) (:D O1_m112) (:K K1_m152))
                  (margin (:B L_rel2) (:D D2_m132) (:K *K2_m162))
                  (margin (:B L_rel2) (:D O2_m142) (:K K2_m162)))
                 ((&middle D (:P P_line2))
                  (&middle D (:P L_rel2))))
             (relative (:Base P_line2) (:X L2) (:X_rel V)))))

      (RULE &placed
        ;; A line of no cells has no middle, and no cell to place.
        (OR ((&size.size (:N 0))
             (&along_host)
             (&wall_axis *A)
             (axis_of *D A))
            ((&placement D)))))))

(ALTS $ov "a line longer than the corridor" $WithinGrid
  (ALT $ClipAtEdge
    (OUTPUT press-shape "the part of the line past a grid edge is dropped")
    (RULE &shown
      (&placed *D)
      (&center_line))))

(RULE &gap_end
  (&gap_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&gap_ray (:P Q) D Origin)))

(DET &cross2
  (&place2 *E *P (:Along *L))
  (&outside2.value (:key (:Ky E) L) (:v *Col))
  (&line_color2 E Col))

;; The one color of the cells outside the corridor that no line takes.
(INIT &field Singleton
  (member ((:v Col))
    (ex_input *E *P *Col)
    (NOT (&corridor2 E P))
    (NOT (&wall2 E P))
    (NOT (&cross2 E P))))

(DET_OR_RULE &background DominantColor
  (&field.value (:v *C)))

(RULE &line_along
  (&placement *D *V)
  (&line.cell (:P *P_line))
  (compose (:A P_line) (:B V) (:C *L)))

(RULE &overflow
  (&line_along *L)
  (dir_elem (:D *D_m1))
  (relative (:Base 0) (:X L) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &press
  (&line_along *D (:L *L1))
  (&center_line (:L *L2))
  (&place *P (:Along L1) (:Across L2)))

(RULE &new_wall
  (&center_line *L)
  (&place *P (:Across *L2))
  (step_offset (:D *D_m1) (:V *V_m2))
  (compose (:A L) (:B V_m2) (:C L2)))

(RULE &shown
  (&placed *D)
  (&center_line)
  (NOT (&overflow)))

(RULE &output
  (&shown *D)
  (input *P)
  (OR ((&press D P)
       (&shape_color (:C *Col)))
      ((&new_wall P)
       (NOT (&press D P))
       (&line_color3 (:C Col)))
      ((NOT (&press D P))
       (NOT (&new_wall P))
       (&cross P)
       (&line_color3 (:C Col)))
      ((NOT (&press D P))
       (NOT (&new_wall P))
       (NOT (&cross P))
       (&background (:C Col)))))
