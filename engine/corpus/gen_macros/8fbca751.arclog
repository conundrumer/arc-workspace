;; 8fbca751

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A group is what line sharing connects.
(INIT &group Quotient
  (edge ((:a P) (:b Q))
    (&ink *P)
    (&ink (:P *Q))
    (axis_elem *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P) (:D D_m2) (:K *K_m3))
    (margin (:B Q) (:D D_m2) (:K K_m3))))

(INIT &group_box BoundingBox
  (key ((&group.class (:a *P) ^Id))
    (cell (P)
      (&group.class (:a *P) Id))))

(RULE &filled
  (input *P *Col)
  (&bg (:C Col))
  (&group_box.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&filled P))
      ((&fill (:C *Col)))
      ((= Col Col_in))))
