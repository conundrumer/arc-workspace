;; f25ffba3

(DET &bg DominantColor)

(DET &pair_cell
  (ex_input *E *P *Col)
  (ex_output E))

(INIT &slab BoundingBox
  (key ((&pair_cell ^E *P *Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (&pair_cell E *P *Col)
      (NOT (&bg (:C Col))))))

(DET &data_dir
  (&slab.box *B)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin B D *K)
  (margin B (:D O_m1) (:K *K2))
  (< K K2))

(DET &slab_depth
  (&data_dir *D)
  (axis_of D *A)
  (&slab.cell (:key *E) *P)
  (&slab.box (:key E) *B)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(RULE &tile_axis
  (&data_dir *D)
  (axis_of D *A))

(DET &out_cell_division_axis_split1
  (ex_output (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &out_cell_division_side
  (&tile_axis *A)
  (&slab_depth (:N *K)))

(DET &out_cell_division_axis
  (OR ((ex_output *P)
       (&tile_axis *A)
       (&slab_depth (:N *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_output P)
       (axis_elem A)
       (NOT (&out_cell_division_side A))
       (&out_cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &out_cell_division_tile
  (&out_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&out_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &out_cell
  (ex_output *E (:P *P_grid) *Col)
  (&out_cell_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

;; The output keeps the data tile at the data edge, and each output
;; tile is an image of it.
(INIT &tile Agreement
  (key ((OR ((&out_cell ^E (:P_tile *P_data) *P_intile *Col)
             (&data_dir *D)
             (margin (:B P_data) D (:K 0))
             (&out_cell E ^P_tile))
            ((&out_cell E P_tile P_intile Col))))
    (source ((:i P_intile) (:v Col))
      (&out_cell E (:P_tile *P_data) *P_intile *Col)
      (&data_dir *D)
      (margin (:B P_data) D (:K 0))
      (&out_cell E P_tile))
    (target ((:i P_intile) (:v Col))
      (&out_cell E P_tile *P_intile *Col))
    (correspondence ((:m D2) (:i P_intile) (:j Q))
      (&out_cell E (:P_tile *P_data) *P_intile *Col)
      (&data_dir *D)
      (margin (:B P_data) D (:K 0))
      (&out_cell E P_tile)
      (d4_elem (:D *D2))
      (apply (:D D2) (:P P_intile) (:P_out *Q)))))

(DET &tile_mismatch
  (&tile.mismatch (:key *P_tile) (:m *D)))

(DET &tile_d4
  (&out_cell *P_tile)
  (d4_elem *D)
  (NOT (&tile_mismatch P_tile D)))

(INIT &output_tiling Tiling
  (outer ((:P P_out_outer))
    (&tile_d4 (:P_tile *P_out_outer))))

;; The stamps: the transforms each output is invariant under.
(INIT &stamp Agreement
  (key ((ex_output ^E *P *Col))
    (source ((:i P) (:v Col))
      (ex_output E *P *Col))
    (target ((:i P) (:v Col))
      (ex_output E *P *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (ex_output E *P *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(DET &stamps
  (d4_elem *D)
  (NOT (&stamp.mismatch (:m D))))

(ALTS $choice "how the slab's images are placed" $Stamp
  (ALT $Augment
    (RULE &augment_ink
      (input (:P *P_in) *Col)
      (NOT (&bg (:C Col)))
      (&stamps *D)
      (apply D (:P P_in) (:P_out *P)))

    (RULE &output
      (OR ((&augment_ink *P *Col))
          ((input P)
           (&bg (:C Col))
           (NOT (&augment_ink P))))))
  (ALT $TileCount
    (DET &slab_cut
      (&data_dir *D)
      (axis_of D *A)
      (&slab_depth (:N *K)))

    (DET &n_tiles_division_cell
      (&pair_cell *P)
      (&slab_cut (:A *Key)))

    (DET &n_tiles_division_axis_split1
      (&n_tiles_division_cell (:Key *Ky) (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (DET &n_tiles_division_side_held
      (&slab_cut *A *K))

    (DET &n_tiles_division_axis
      (OR ((&n_tiles_division_cell *Key *P)
           (axis_elem *A)
           (OR ((!= A Key))
               ((NOT (&n_tiles_division_side_held (:A Key)))))
           (&n_tiles_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&n_tiles_division_cell Key P)
           (&slab_cut (:A Key) *K)
           (axis_of *D (:A Key))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K))
           (= A Key))))

    (DET &n_tiles_division_tile
      (&n_tiles_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&n_tiles_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (INIT &data_cell_division_sides ExtentDivisions
      (frame ((:P P_grid_in))
        (input (:P *P_grid_in))))

    (DET &n_tiles
      (&n_tiles_division_tile (:Key *A) *P_outer)
      (frame_extent (:P P_outer) A *N))

    (RULE &data_cell_division_axis_split1
      (input (:P *P_grid_in_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_in_) (:X_rel *X_m1_)))

    (RULE &data_cell_division_parts
      (&tile_axis *A)
      (&n_tiles *N))

    (RULE &data_cell_division_axis
      (OR ((input *P)
           (&tile_axis *A)
           (&n_tiles *N)
           (&data_cell_division_sides.division A N *K (:G 0))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&tile_axis A)
           (&n_tiles (:N *N2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N2)))
          ((input P)
           (axis_elem A)
           (NOT (&data_cell_division_parts A))
           (&data_cell_division_axis_split1 (:P_grid_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &data_cell_division_tile
      (&data_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&data_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &data_cell
      (input (:P *P_grid_in) *Col)
      (&data_cell_division_tile (:P P_grid_in) (:P_outer *P_in_outer) (:P_inner *P_intile))
      (&data_dir (:D *D_data))
      (margin (:B P_in_outer) (:D D_data) (:K 0)))

    (RULE &output
      (&data_cell *P_intile *Col)
      (&tile_d4 (:P_tile *P_out_outer) *D)
      (apply D (:P P_intile) (:P_out *P_out_intile))
      (&tile_axis)
      (&output_tiling.cell (:P_outer P_out_outer) (:P_inner P_out_intile) *P))

    (INIT &output_tiling Tiling
      (outer ((:P P_out_outer))
        (&tile_d4 (:P_tile *P_out_outer)))
      (inner ((:P P_out_intile))
        (&data_cell *P_intile)
        (&tile_d4 *D)
        (apply D (:P P_intile) (:P_out *P_out_intile)))))
  (ALT $TileSize
    (RULE &data_cell_division2_axis_split1
      (input (:P *P_grid_in_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_in_) (:X_rel *X_m1_)))

    (RULE &data_cell_division2_side
      (&tile_axis *A)
      (&slab_depth (:N *K)))

    (RULE &data_cell_division2_axis
      (OR ((input *P)
           (&tile_axis *A)
           (&slab_depth (:N *K))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (NOT (&data_cell_division2_side A))
           (&data_cell_division2_axis_split1 (:P_grid_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &data_cell_division2_tile
      (&data_cell_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&data_cell_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &data_cell
      (input (:P *P_grid_in) *Col)
      (&data_cell_division2_tile (:P P_grid_in) (:P_outer *P_in_outer) (:P_inner *P_intile))
      (&data_dir (:D *D_data))
      (margin (:B P_in_outer) (:D D_data) (:K 0)))

    (RULE &output
      (&data_cell *P_intile *Col)
      (&tile_d4 (:P_tile *P_out_outer) *D)
      (apply D (:P P_intile) (:P_out *P_out_intile))
      (&tile_axis)
      (&output_tiling.cell (:P_outer P_out_outer) (:P_inner P_out_intile) *P))

    (INIT &output_tiling Tiling
      (outer ((:P P_out_outer))
        (&tile_d4 (:P_tile *P_out_outer)))
      (inner ((:P P_out_intile))
        (&data_cell *P_intile)
        (&tile_d4 *D)
        (apply D (:P P_intile) (:P_out *P_out_intile))))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&data_dir (:D *D_data))
  (margin (:B P_grid_in) (:D D_data) *K)
  (&slab_depth (:N *Depth))
  (< K Depth)
  (&stamps *D)
  (apply D (:P P_grid_in) (:P_out *P)))
