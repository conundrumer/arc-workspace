;; 4c7dc4dd

;; The color of a panel's unfilled cells.
(DET &hole SharedColor)

;; The rectangles each drawn color draws.
(INIT &drect Outlines
  (key ((input *P ^Col)
        (NOT (&hole (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&hole (:C Col))))))

;; What a rectangle encloses.
(INIT &bbox BoundingBox
  (key ((&drect.box (:B ^Pan)))
    (cell (P)
      (input *P)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base Pan) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((> K_m3 0))))))

(RULE &cand
  (&bbox.cell (:key *Pan) (:P *P_grid))
  (input (:P P_grid) *Col)
  (&bbox.box (:key Pan) *B)
  (ALL ((&bbox.cell (:key (:Pan *Panm)) (:P P_grid))
        (&bbox.box (:key (:Pan Panm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner))
  (axis_elem *A)
  (relative (:Base B) (:X P_grid) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N))

(RULE &cand_side
  (&cand *Pan *Col)
  (&hole (:C Col))
  (&bbox.box (:key Pan) *B)
  (&bbox.cell (:key Pan) *P)
  (axis_elem (:A *A_m1))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A_m1) *N))

;; The panels are the largest of them; smaller frames sit inside their marks.
(INIT &widest Order
  (member ((:t (:V Pan) (:S N)))
    (&cand_side *Pan *N))
  (score ((:t (:V Pan) (:S N)) (:S N))
    (&cand_side *Pan *N)))

(RULE &panel
  (&widest.maximal (:t (:V *Pan))))

(RULE &flank_axis
  (&panel (:Pan *Key))
  (axis_elem *A))

(RULE &flank_dir
  (&flank_axis *Key *A)
  (axis4_of *D A))

(RULE &flank_node
  (&flank_axis *Key)
  (input *P))

(RULE &pval
  (&panel *Pan)
  (&cand Pan *P_inner *Col))

(RULE &mark
  (&pval *Pan *P_inner *Col)
  (NOT (&hole (:C Col))))

(RULE &flank_source
  (&mark (:Pan *Key) (:P_inner *P)))

(INIT &flank Distance
  (key ((&flank_source (:Key ^Ky) (:P ^O))
        (&flank_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&flank_source (:Key Ky) (:P O))
           (&flank_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&flank_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&flank_node (:Key Ky) (:P Q)))
          ((&flank_source (:Key Ky) (:P O))
           (&flank_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&flank_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&flank_source (:Key Ky) (:P O))
           (&flank_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&flank_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&flank_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&flank_source (:Key Ky) (:P O))
      (&flank_dir (:Key Ky) D))))

(RULE &flank_ray
  (&flank.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &flank_end
  (&flank_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&flank_ray Key (:P Q) D Origin)))

(RULE &content
  (&mark *Pan))

(RULE &own
  (&mark *Pan *Col)
  (&content (:Pan *Pan2))
  (!= Pan Pan2)
  (NOT (&mark (:Pan Pan2) Col)))

(RULE &slot
  (&content (:Pan *Answer))
  (&content (:Pan *Shown))
  (&content (:Pan *Done))
  (!= Answer Shown)
  (!= Answer Done)
  (!= Shown Done))

(DEMONSTRATED &catalog
  (key ((OR ((&slot (:Answer ^Pan) (:Shown ^Pan1))
             (&content (:Pan *Pan3))
             (&pval (:Pan Pan3) *P_inner *Col))
            ((&slot (:Answer Pan) (:Shown Pan1) (:Done *Pan2)))))
    (value ((:o Pan3) (:i P_inner) (:v Col))
      (&slot (:Answer Pan) (:Shown Pan1))
      (&content (:Pan *Pan3))
      (&pval (:Pan Pan3) *P_inner *Col))
    (demonstration ((:o Pan1) (:o2 Pan2))
      (&slot (:Answer Pan) (:Shown Pan1) (:Done *Pan2))))
  (DEMO_RULE $Extend
    ;; The canvas the marks lie on: one color along a diagonal, chained across
    ;; the two diagonal families.
    (INIT &spread Quotient
      (edge ((:a Pan P) (:b Pan (:P Q)))
        (&content *Pan)
        (&pval Pan (:P_inner *P))
        (&pval Pan (:P_inner *Q))
        (diag_axis_elem *Da)
        (diag_perp Da (:Da2 *A2_m1))
        (diag_axis_of (:D *D_m2) (:Da A2_m1))
        (corner_dist P (:Diag D_m2) (:K *K_m3))
        (corner_dist (:P Q) (:Diag D_m2) (:K K_m3))))

    (INIT &canvas Singleton
      (key ((&mark ^Pan (:P_inner *P_mark) *Col)
            (&spread.class (:a Pan (:P P_mark)) *Id)
            (&spread.class (:a Pan (:P ^P_inner)) Id))
        (member ((:v Col))
          (&mark Pan (:P_inner *P_mark) *Col)
          (&spread.class (:a Pan (:P P_mark)) *Id)
          (&spread.class (:a Pan (:P P_inner)) Id))))

    (RULE &predict
      (&pval *Pan *P_inner (:Col *V))
      (&hole (:C *H))
      (OR ((= V H)
           (&canvas.value (:key Pan P_inner) (:v *Col)))
          ((!= V H)
           (= Col H))))

    (RULE &prediction
      (&slot (:Answer *Pan) (:Shown *Pan1))
      (&predict (:Pan *Pan3) *P_inner *Col)))
  (DEMO_RULE $Span
    (RULE &flank_between
      (&pval (:Pan *Key) (:P_inner *P))
      (&flank_axis Key *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&flank_ray Key P D)
      (&flank_ray Key P (:D O)))

    (RULE &predict
      (OR ((&mark *Pan *P_inner *Col))
          ((&pval Pan P_inner (:Col *H))
           (&hole (:C H))
           (IF ((&flank_between (:Key Pan) (:P P_inner)))
               ((&own Pan Col))
               ((= Col H))))))

    (RULE &prediction
      (&slot (:Answer *Pan) (:Shown *Pan1))
      (&predict (:Pan *Pan3) *P_inner *Col)))
  (DEMO_RULE $Reflect
    ;; The window a panel shows: the box its marks span.
    (INIT &window BoundingBox
      (key ((&mark ^Pan *P_inner))
        (cell ((:P P_inner))
          (&mark Pan *P_inner))))

    (RULE &repeat
      (&pval *Pan (:P_inner *P_inner2) *Col)
      (&window.box (:key Pan) *B)
      (ALL ((&pval (:Pan *Panm) (:P_inner P_inner2) (:Col *Colm))
            (&window.box (:key (:Pan Panm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_inner2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (d4_elem *D)
      (apply D (:P P_inner2) (:P_out *P_inner)))

    (INIT &image Singleton
      (key ((&repeat ^Pan ^P_inner *Col))
        (member ((:v Col))
          (&repeat Pan P_inner *Col))))

    (RULE &predict
      (&pval *Pan *P_inner)
      (OR ((&image.value (:key Pan P_inner) (:v *Col)))
          ((NOT (&repeat Pan P_inner))
           (&own Pan Col))))

    (RULE &prediction
      (&slot (:Answer *Pan) (:Shown *Pan1))
      (&predict (:Pan *Pan3) *P_inner *Col))))

(RULE &output
  (&slot (:Answer *Pan) (:Shown *Pan1))
  (&catalog (:key Pan Pan1) (:o Pan) (:i *P) (:v *Col)))
