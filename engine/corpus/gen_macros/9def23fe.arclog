;; 9def23fe

(INPUT rect "the ink holds one solid rectangle of one color")

(INPUT dots "every other ink cell is a lone cell of one other color")

(OUTPUT beam "on each side of the rectangle, every line the rectangle spans takes the rectangle's color out to the grid edge, unless a dot lies on that line between the rectangle and that edge"

  (RULE &cast_dir
    (dir_elem *D))

  (RULE &cast_dir_ray
    (&cast_dir *D))

  (DET_OR_RULE &bg DominantColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&bg Col)))

  ;; the rectangle's color, which its beams also take
  (DET &beam SharedColor)

  (RULE &rect
    (input *P *Col)
    (&beam (:C Col)))

  (RULE &dot
    (&ink *P)
    (NOT (&rect P)))

  (RULE &cast_blocked
    (&dot *P))

  (RULE &cast_node
    (&cast_dir)
    (input *P)
    (NOT (&cast_blocked P)))

  (INIT &bx BoundingBox
    (cell (P)
      (&rect *P)))

  (RULE &body
    (input *P)
    (&bx.box *B)
    (ALL ((&bx.box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &cast_source
    (&body *P))

  ;; The body casts toward each edge, over the cells outside it.
  (INIT &cast Distance
    (key ((&cast_source (:P ^O))
          (&cast_dir_ray ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&cast_source (:P O))
             (&cast_dir_ray D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&cast_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&cast_node (:P Q)))
            ((&cast_source (:P O))
             (&cast_dir_ray D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&cast_node (:P Q))
             (= A2 O))
            ((&cast_source (:P O))
             (&cast_dir_ray D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&cast_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&cast_node (:P Q)))))
      (source ((:n O))
        (&cast_source (:P O))
        (&cast_dir_ray D)))))

(OUTPUT keep "every other cell keeps its input color")

(ALTS $f "what tells the rectangle from the dots" $Hue
  (ALT $Touch
    (INPUT dots "every other ink cell is a lone cell")
    (OUTPUT beam "on each side of the ink that touches other ink, every line that ink spans takes its own color out to the grid edge, unless a lone ink cell lies on that line between it and that edge"
      ;; A rectangle cell: ink that touches other ink.
      (RULE &rect
        (&ink *P)
        (dir_elem *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (&ink (:P Q))))
    (RULE &paint
      (&rect *P)
      (input P *Col))))

(ALTS $e "where the beams start" $Box
  (ALT $Cells
    (OUTPUT beam "from each cell of the rectangle, every line through it takes the rectangle's color out to the grid edge, unless a dot lies on that line between the cell and that edge"
      (RULE &body
        (&rect *P)))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &cast_full_dir
  (&cast_dir *D))

(RULE &cast_full_node
  (&cast_dir)
  (input *P))

(RULE &cast_full_source
  (&body *P))

(INIT &cast_full Distance
  (key ((&cast_full_source (:P ^O))
        (&cast_full_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_full_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_full_node (:P Q)))
          ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_full_node (:P Q))
           (= A2 O))
          ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_full_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_full_node (:P Q)))))
    (source ((:n O))
      (&cast_full_source (:P O))
      (&cast_full_dir D))))

(RULE &cast_full_ray
  (&cast_full.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_stop
  (&cast_end (:P *E) *D (:Origin *Src))
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P))
  (&cast_full_ray P D *K (:Origin Src)))

(RULE &cast_full_end
  (&cast_full_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_full_ray (:P Q) D Origin)))

(RULE &paint
  (&beam (:C *Col)))

(RULE &cast_cell
  (input *P)
  (NOT (&body P)))

(RULE &fill
  (&cast_full_ray *P *D (:Origin *Src))
  (&cast_cell P)
  (NOT (&cast_stop D Src)))

(RULE &output
  (input *P (:Col *C0))
  (IF ((&fill P))
      ((&paint *Col))
      ((= Col C0))))
