;; af24b4cc

(INPUT block-grid "the input is a grid of equal blocks laid out in rows and columns, with a 1-wide line of bg (0) along every edge of the input and between each two adjacent blocks"

  (DET_OR_RULE &bg DominantColor)

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &piece8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET_OR_RULE &tile_edge "The width of the lines along the edges." SepThickness TileDim)

  (RULE &inset_cell_uniform_inset1
    (&tile_edge (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &inset_cell
    (input (:P *P_grid))
    (&tile_edge *K)
    (&inset_cell_uniform_inset1 (:K_ K) (:B_ *B))
    (ALL ((&tile_edge (:K *Km))
          (axis_of (:D *D1_m1) (:A *A1_m2))
          (perp (:A A1_m2) (:A2 *A2_m3))
          (axis_of (:D *D2_m4) (:A A2_m3))
          (opposite (:D D1_m1) (:Opp *O_m7))
          (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
          (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
          (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
          (opposite (:D D2_m4) (:Opp *O_m10))
          (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
          (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
          (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
          (compose (:A B1_m5) (:B B2_m6) (:C B))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

  (INIT &counted_sides ExtentDivisions
    (frame (P)
      (&inset_cell (:P_inner *P))))

  (INIT &piece Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&bg (:C Col)))
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&bg (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&bg (:C Col3)))
           (= P3 P)))))

  (INIT &piece8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&bg (:C Col)))
           (&piece8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&bg (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&bg (:C Col3)))
           (= P3 P))))))

(INPUT block-size "each block is block_h (3) rows by block_w (2) columns")

(INPUT block-layout "the blocks stand in block_rows (2) rows and block_cols (3) columns")

(INPUT no-bg-in-block "no cell of a block is bg (0)")

(INPUT unique-mode "in each block, one color occurs more often than every other color")

(OUTPUT output-frame "the output has one row per block row and one column per block column, inside a border of bg that is margin (1) cells wide"

  ;; The bounding box of the cells other than bg.
  (INIT &region BoundingBox
    (cell (P)
      (input *P *Col)
      (NOT (&bg (:C Col)))))

  (RULE_OR_DET &region.box "The bounding box of the cells other than bg."))

(OUTPUT block-mode "the output cell of a block takes that block's commonest color"

  (RULE &inked_line_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &lattice_divider_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE_OR_DET &lattice_divider
    (input *P)
    (axis_elem *A)
    (&lattice_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (ALL ((input (:P *Pm) *Col)
          (axis_elem (:A *Am))
          (&inked_line_split1 (:P_ Pm) (:A_ Am) (:L_ L) (:X_m1_ *X_m1m)))
         ((&bg (:C Col)))))

  (RULE &lattice_on_divider
    (input *P)
    (&lattice_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  (INIT &lattice_rank Order
    (key ((OR ((&lattice_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&lattice_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&lattice_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &lattice_part_idx
    (input *P)
    (axis_of *D *A)
    (NOT (&lattice_on_divider P A))
    (margin (:B P) D *K)
    (&lattice_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &lattice_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&lattice_part_idx *P D (:N *N1))
    (&lattice_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE &stripe_member_split1
    (&lattice_part_of (:P *P_) (:A *A_) *P_part)
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &stripe_member
    (&lattice_part_of (:P *P2) (:A *Key) (:P_part *M))
    (&stripe_member_split1 (:P_ P2) (:A_ Key) (:L_ *P) (:X_m1_ *X_m1)))

  ;; One picture line per run of lines between dividers.
  (INIT &stripe Order
    (key ((axis_elem ^A)
          (axis_of ^D A))
      (member ((:t P_part))
        (&stripe_member (:Key A) (:M *P_part)))
      (before ((:a P_part) (:b M_b))
        (&stripe_member (:Key A) (:M *P_part) (:P *L))
        (&stripe_member (:Key A) (:M *M_b) (:P *Q))
        (!= P_part M_b)
        (margin (:B L) D (:K *K1))
        (margin (:B Q) D (:K *K2))
        (< K1 K2))))

  (RULE &stripe_pos
    (&stripe.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
    (&stripe.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K R1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

  (RULE &tile
    (&lattice_part_of *P *A (:P_part *P_part1))
    (&stripe_pos (:Key A) (:M P_part1) (:P_pos *P1))
    (perp A *A2)
    (&lattice_part_of P (:A A2) (:P_part *P_part2))
    (&stripe_pos (:Key A2) (:M P_part2) (:P_pos *P2))
    (compose (:A P1) (:B P2) (:C *P_pic)))

  (INIT &tile_id Quotient
    (equivalent ((:a P_pic) (:b P_pic))
      (&tile *P_pic)))

  (RULE &tile_cell
    (&tile *P *P_pic)
    (&tile_id.class (:a P_pic) (:Id *B)))

  (RULE &member
    (&tile_cell *B *P)
    (input P *Col))

  (INIT &commonest_count Cardinality
    (key ((&member (:B ^Bl) *P ^Col))
      (member ((:m P))
        (&member (:B Bl) *P Col))))

  (DET_OR_RULE &tile_gap "The width of the lines between the tiles." SepThickness TileDim)

  ;; The color each block's output cell takes.
  (INIT &commonest Order
    (key ((&commonest_count.size (:key (:Bl ^Id) *Col)))
      (member ((:t Col))
        (&commonest_count.size (:key (:Bl Id) *Col)))
      (score ((:t Col) (:S N))
        (&commonest_count.size (:key (:Bl Id) *Col) *N))))

  (DET &train
    (ex_output *E)))

(ALTS $parse "how the blocks are found" $Lattice
  (ALT $Lattice
    (ALTS $source "what cuts the lattice" $Dividers
      (ALT $StoredTileSize
        (INPUT block-grid "the blocks are tiles of tile_size (3 by 2), with lines tile_edge (1) wide along each edge and tile_gap (1) wide between them; undefined where an input extent does not fit whole tiles"
          (DET &item_split1
            (&lattice_part_of *E (:P *P_) (:A *A_) *P_part)
            (axis_of (:D *D_m1) (:A A_))
            (opposite (:D D_m1) (:Opp *O_m2))
            (margin (:B P_) (:D D_m1) (:K *K1_m3))
            (margin (:B P_) (:D O_m2) (:K *K2_m4))
            (opposite (:D D_m1) (:Opp *O_m1))
            (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
            (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C *L_))
            (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))
          ;; The lines each band holds.
          (INIT &band_lines Cardinality
            (key ((&lattice_part_of ^E *P ^A ^P_part)
                  (&item_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))
              (member ((:m L))
                (&lattice_part_of E *P A P_part)
                (&item_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))))
          (INIT &band_size Singleton
            (key ((&band_lines.size (:key *E ^A) (:N *K))
                  (&train E))
              (member ((:v K))
                (&band_lines.size (:key *E A) (:N *K))
                (&train E))))
          (DET &tile_size
            (&band_size.value (:key *A) (:v *K)))
          (RULE &sized_gap
            (&tile_size *A *K)
            (&tile_gap *G))
          (RULE &sized_axis_split1
            (&inset_cell (:P_inner *P_))
            (axis_elem (:A *A_))
            (axis_of (:D *D_m1) (:A A_))
            (opposite (:D D_m1) (:Opp *O_m2))
            (margin (:B P_) (:D D_m1) (:K *K1_m3))
            (margin (:B P_) (:D O_m2) (:K *K2_m4))
            (opposite (:D D_m1) (:Opp *O_m1))
            (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
            (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
            (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))
          (RULE &sized_axis
            (OR ((&inset_cell (:P_inner *P))
                 (&tile_size *A *K)
                 (&tile_size A (:K *K2))
                 (&tile_gap *G)
                 (axis_of *D A)
                 (opposite D (:Opp *O))
                 (margin (:B P) D (:K *T))
                 (margin (:B P) (:D O) (:K *T2))
                 (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
                 (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
                 (opposite D (:Opp *O_m1))
                 (edge_inset D (:K I) (:B *B1_m2))
                 (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
                 (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
                 (opposite D (:Opp *O_m4))
                 (edge_inset D (:K R) (:B *B1_m5))
                 (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
                 (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
                 (frame_extent (:P P_inner) A (:N K)))
                ((&inset_cell (:P_inner P))
                 (&tile_size A (:K *K3))
                 (NOT (&sized_gap A))
                 (axis_of (:D *D2) A)
                 (opposite (:D D2) (:Opp *O2))
                 (margin (:B P) (:D D2) (:K *T3))
                 (margin (:B P) (:D O2) (:K *T22))
                 (divide (:T T3) (:Side K3) (:Gap 0) (:Part *I3) (:Remainder *R3))
                 (divide (:T T22) (:Side K3) (:Gap 0) (:Part *I22) (:Remainder *R22))
                 (opposite (:D D2) (:Opp *O_m12))
                 (edge_inset (:D D2) (:K I3) (:B *B1_m22))
                 (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
                 (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
                 (opposite (:D D2) (:Opp *O_m42))
                 (edge_inset (:D D2) (:K R3) (:B *B1_m52))
                 (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
                 (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
                 (frame_extent (:P P_inner) A (:N K3)))
                ((&inset_cell (:P_inner P))
                 (axis_elem A)
                 (NOT (&tile_size A))
                 (&sized_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
                 (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
          (RULE &sized_tile
            (&sized_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
            (perp (:A A1) *A2)
            (&sized_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
            (compose (:A Po1) (:B Po2) (:C *P_outer))
            (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
          (RULE &tile
            (&sized_tile (:P *P_inner) (:P_outer *P_pic))
            (&inset_cell P_inner (:P_grid *P)))))
      (ALT $StoredTileCount
        (INPUT block-grid "the blocks are tile_count (2 by 3) equal tiles, with lines tile_edge (1) wide along each edge and tile_gap (1) wide between them; undefined where an input extent does not fit them"
          ;; The bands along each axis.
          (INIT &bands Cardinality
            (key ((&lattice_part_of ^E ^A *P_part))
              (member ((:m P_part))
                (&lattice_part_of E A *P_part))))
          (INIT &band_count Singleton
            (key ((&bands.size (:key *E ^A) *N)
                  (&train E))
              (member ((:v N))
                (&bands.size (:key *E A) *N)
                (&train E))))
          (DET &tile_count
            (&band_count.value (:key *A) (:v *N)))
          (RULE &counted_gap
            (&tile_count *A *N)
            (&tile_gap *G))
          (RULE &counted_axis_split1
            (&inset_cell (:P_inner *P_))
            (axis_elem (:A *A_))
            (axis_of (:D *D_m1) (:A A_))
            (opposite (:D D_m1) (:Opp *O_m2))
            (margin (:B P_) (:D D_m1) (:K *K1_m3))
            (margin (:B P_) (:D O_m2) (:K *K2_m4))
            (opposite (:D D_m1) (:Opp *O_m1))
            (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
            (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
            (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))
          (RULE &counted_axis
            (OR ((&inset_cell (:P_inner *P))
                 (&tile_count *A *N)
                 (&tile_count A (:N *N2))
                 (&tile_gap *G)
                 (&counted_sides.division A N *K G)
                 (axis_of *D A)
                 (opposite D (:Opp *O))
                 (margin (:B P) D (:K *T))
                 (margin (:B P) (:D O) (:K *T2))
                 (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
                 (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
                 (opposite D (:Opp *O_m1))
                 (edge_inset D (:K I) (:B *B1_m2))
                 (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
                 (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
                 (opposite D (:Opp *O_m4))
                 (edge_inset D (:K R) (:B *B1_m5))
                 (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
                 (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
                 (frame_extent (:P P_inner) A (:N K)))
                ((&inset_cell (:P_inner P))
                 (&tile_count A (:N *N3))
                 (&tile_count A (:N *N22))
                 (&tile_gap (:G *G2))
                 (frame_extent P A (:N *K2))
                 (axis_of (:D *D2) A)
                 (opposite (:D D2) (:Opp *O2))
                 (margin (:B P) (:D D2) (:K *T3))
                 (margin (:B P) (:D O2) (:K *T22))
                 (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
                 (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
                 (opposite (:D D2) (:Opp *O_m12))
                 (edge_inset (:D D2) (:K I3) (:B *B1_m22))
                 (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
                 (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
                 (opposite (:D D2) (:Opp *O_m42))
                 (edge_inset (:D D2) (:K R3) (:B *B1_m52))
                 (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
                 (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
                 (frame_extent (:P P_inner) A (:N K2))
                 (frame_extent (:P P_outer) A (:N N3)))
                ((&inset_cell (:P_inner P))
                 (&tile_count A (:N *N4))
                 (NOT (&counted_gap A))
                 (&counted_sides.division A (:N N4) (:K *K3) (:G 0))
                 (axis_of (:D *D3) A)
                 (opposite (:D D3) (:Opp *O3))
                 (margin (:B P) (:D D3) (:K *T4))
                 (margin (:B P) (:D O3) (:K *T23))
                 (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
                 (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
                 (opposite (:D D3) (:Opp *O_m13))
                 (edge_inset (:D D3) (:K I4) (:B *B1_m23))
                 (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
                 (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
                 (opposite (:D D3) (:Opp *O_m43))
                 (edge_inset (:D D3) (:K R4) (:B *B1_m53))
                 (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
                 (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
                 (frame_extent (:P P_inner) A (:N K3)))
                ((&inset_cell (:P_inner P))
                 (&tile_count A (:N *N5))
                 (NOT (&counted_gap A))
                 (frame_extent P A (:N *K4))
                 (axis_of (:D *D4) A)
                 (opposite (:D D4) (:Opp *O4))
                 (margin (:B P) (:D D4) (:K *T5))
                 (margin (:B P) (:D O4) (:K *T24))
                 (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
                 (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
                 (opposite (:D D4) (:Opp *O_m14))
                 (edge_inset (:D D4) (:K I5) (:B *B1_m24))
                 (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
                 (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
                 (opposite (:D D4) (:Opp *O_m44))
                 (edge_inset (:D D4) (:K R5) (:B *B1_m54))
                 (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
                 (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
                 (frame_extent (:P P_inner) A (:N K4))
                 (frame_extent (:P P_outer) A (:N N5)))
                ((&inset_cell (:P_inner P))
                 (axis_elem A)
                 (NOT (&tile_count A))
                 (&counted_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
                 (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
          (RULE &counted_tile
            (&counted_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
            (perp (:A A1) *A2)
            (&counted_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
            (compose (:A Po1) (:B Po2) (:C *P_outer))
            (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
          (RULE &tile
            (&counted_tile (:P *P_inner) (:P_outer *P_pic))
            (&inset_cell P_inner (:P_grid *P))))))
    (ALTS $domain "which cells of a block count toward its color" $AllCells
      (ALT $NonBgMode
        (OUTPUT block-mode "the output cell of a block takes the commonest color among its cells other than bg; undefined on a block with no such cell"
          (RULE &member
            (&tile_cell *B *P)
            (input P *Col)
            (NOT (&bg (:C Col))))))))
  (ALT $Components
    (INPUT block-grid "the blocks are the 4-adjacent pieces of cells other than bg")
    (OUTPUT output-frame "a piece's output cell stands, toward each edge, at the rank of its distance to that edge among the pieces' distances to it, and a cell with no piece takes bg; undefined where the ranks toward two opposite edges disagree, or two pieces of different colors share a cell"
      (RULE &piece_component
        (&piece.class (:a *P) *Id))

      (RULE &member
        (&piece_component *P (:Id *B))
        (input P *Col))

      (INIT &piece_box BoundingBox
        (key ((&member (:B ^Id) *P))
          (cell (P)
            (&member (:B Id) *P))))

      (RULE &piece_dist
        (&piece_box.box (:key (:Id *B)) (:B *B2))
        (dir_elem *D)
        (margin (:B B2) D *K))

      (INIT &rank Order
        (key ((&piece_dist ^D *K))
          (member ((:t K))
            (&piece_dist D *K))
          (score ((:t K) (:S K))
            (&piece_dist D *K))))

      (RULE &piece_slot_axis
        (axis_of *D *A)
        (opposite D (:Opp *D2))
        (&piece_dist (:B *Key) D *K)
        (&rank.rank (:key D) (:t K) *R)
        (&piece_dist (:B Key) (:D D2) (:K *K2))
        (&rank.rank (:key (:D D2)) (:t K2) (:R *R2))
        (opposite D (:Opp *O_m1))
        (edge_inset D (:K R) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B)))

      (RULE &piece_slot
        (&piece_slot_axis *Key *A (:B *B1))
        (perp A *A2)
        (&piece_slot_axis Key (:A A2) (:B *B2))
        (compose (:A B1) (:B B2) (:C *B))))
    (RULE &slot
      (&piece_slot (:Key *B) (:B *P_pic)))
    (ALTS $adjacency "which cells join one piece" $Cardinal
      (ALT $DiagonalJoin
        (INPUT block-grid "the blocks are the 8-adjacent pieces of cells other than bg"
          (RULE &piece8_component
            (&piece8.class (:a *P) *Id))
          (RULE &member
            (&piece8_component *P (:Id *B))
            (input P *Col)))
        (RULE &slot
          (OR ((&tile_id.class (:a *P_pic) (:Id *B)))
              ((&piece_slot (:Key B) (:B P_pic)))))))))

(ALTS $margin "how wide the output border is" $StoredMargin
  (ALT $InputMargin
    (OUTPUT output-frame "each side of the output border is as wide as the input's run of full bg lines on that side")
    (RULE &border
      (&region.box (:B *R))
      (relative (:Base R) (:X 0) (:X_rel *B)))))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET_OR_RULE &margin SepThickness)

(RULE &border_uniform_outset1
  (&margin (:K *M_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m7))
  (edge_inset (:D D1_m1) (:K M_) (:B *B1_m8))
  (edge_inset (:D O_m7) (:K M_) (:B *B2_m9))
  (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m10))
  (edge_inset (:D D2_m4) (:K M_) (:B *B1_m11))
  (edge_inset (:D O_m10) (:K M_) (:B *B2_m12))
  (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
  (relative (:Base I_m1) (:X 0) (:X_rel *B_)))

(RULE_OR_DET &inked_line "A line that holds a cell other than bg.")

(RULE &border
  (&margin (:K *M))
  (&border_uniform_outset1 (:M_ M) (:B_ *B)))

(RULE &slot
  (&tile_id.class (:a *P_pic) (:Id *B)))

(INIT &canvas Frame
  (extent (A N)
    (&slot (:P_pic *P))
    (&border *B)
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)))

(RULE_OR_DET &canvas.extent)

(RULE &placed
  (&slot *B (:P_pic *P))
  (&border (:B *B2))
  (ALL ((&slot (:B *Idm) (:P_pic P))
        (&border (:B B2))
        (dir_elem (:D *D_m1))
        (relative (:Base B2) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B2) (:X P) (:X_rel *Q)))

(RULE &occupied
  (&placed *Q))

(RULE &output
  (&canvas.cell *P)
  (OR ((&placed (:B *Bl_id) (:Q P))
       (&commonest.maximal (:key (:Id Bl_id)) (:t *Col)))
      ((NOT (&occupied (:Q P)))
       (&bg (:C Col)))))
