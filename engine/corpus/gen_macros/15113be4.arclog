;; 15113be4

(DET &cand
  (ex_input *P)
  (axis_elem *A)
  (sub_extent P A (:K *N)))

(DET &cut_division_cell
  (ex_input *P)
  (&cand (:N *Key)))

;; Separator thickness.
(DET &gap DivisorRatio)

(DET &cut_division_gap
  (axis_elem *A)
  (&cand (:N *Key))
  (&gap (:K *G)))

(INIT &cut_division_sides ExtentDivisions
  (key ((&cut_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&cut_division_cell (:Key Ky) *P))))

(DET &cut_division_axis_split1
  (&cut_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &cut_division_parts_held
  (axis_elem *A)
  (&cand *N))

(DET &cut_division_axis
  (OR ((&cut_division_cell *Key *P)
       (axis_elem *A)
       (&cand (:N Key))
       (&cut_division_gap Key A *G)
       (&cut_division_sides.division (:key (:Ky Key)) A (:N Key) *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&cut_division_cell Key P)
       (axis_elem A)
       (&cand (:N Key))
       (&cut_division_gap Key A (:G *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N Key)))
      ((&cut_division_cell Key P)
       (axis_elem A)
       (&cand (:N Key))
       (NOT (&cut_division_gap Key A))
       (&cut_division_sides.division (:key (:Ky Key)) A (:N Key) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&cut_division_cell Key P)
       (axis_elem A)
       (&cand (:N Key))
       (NOT (&cut_division_gap Key A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N Key)))
      ((&cut_division_cell Key P)
       (axis_elem A)
       (NOT (&cut_division_parts_held (:N Key) A))
       (&cut_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &cut_division_tile
  (&cut_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&cut_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &key_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &cell_at_division_sides ExtentDivisions
  (frame (P)
    (input *P)))

(DET &cut
  (ex_input *E *P)
  (&cut_division_tile (:Key *N) P))

(DET &bg SharedColor)

(DET &ink SharedColor)

(DET &sep SharedColor)

(RULE &key_color
  (input *Col)
  (NOT (&bg (:C Col)))
  (NOT (&ink (:C Col)))
  (NOT (&sep (:C Col))))

(RULE &key_node
  (input *P *Col)
  (NOT (&sep (:C Col))))

;; The key's interior — what its separator border encloses.
(INIT &key Propagation
  (source ((:n P))
    (input *P *Col)
    (&key_color Col)
    (&key_node P))
  (edge ((:a P) (:b Q))
    (&key_node *P)
    (&key_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *Q))
    (&key_node (:P Q))))

(DET &key_block
  (OR ((&key.reached *E (:n *P)))
      ((&key.reached E (:n *P2))
       (dir8_elem *D)
       (step_offset D (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C P))
       (ex_input E P))))

(DET &defect
  (&cand *N)
  (ex_input *E *P *Col)
  (NOT (&key_block E P))
  (OR ((NOT (&cut E N P))
       (NOT (&sep (:C Col))))
      ((&cut E N P)
       (&sep (:C Col)))))

(DET &cell_count
  (&cand *N)
  (NOT (&defect N)))

(RULE &cell_at_division_gap
  (axis_elem *A)
  (&gap (:K *G)))

(RULE &cell_at_division_axis_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &cell_at_division_parts
  (axis_elem *A)
  (&cell_count *N))

(RULE &cell_at_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&cell_count *N)
       (&gap (:K *G))
       (&cell_at_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&cell_count (:N *N2))
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (&cell_count (:N *N3))
       (NOT (&cell_at_division_gap A))
       (&cell_at_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (axis_elem A)
       (&cell_count (:N *N4))
       (NOT (&cell_at_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&cell_at_division_parts A))
       (&cell_at_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &cell_at_division_tile
  (&cell_at_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&cell_at_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &cell_at
  (&cell_at_division_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

(INIT &key_box BoundingBox
  (cell (P)
    (&key.reached (:n *P))))

(RULE &footprint_division_axis_split1
  (&key_box.box *B)
  (input *P *Col)
  (relative (:Base B) (:X P) (:X_rel *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(ALTS $choice "what the cut reads" $Count
  (ALT $Size
    ;; A cell's extent.
    (DET &dim SepTileCount)

    (RULE &cell_at_division2_gap
      (axis_elem *A)
      (&gap (:K *G)))

    (RULE &cell_at_division2_axis_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &cell_at_division2_side
      (axis_elem *A)
      (&dim (:N *K)))

    (RULE &cell_at_division2_axis
      (OR ((input *P)
           (axis_elem *A)
           (&dim (:N *K))
           (&gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (&dim (:N *K2))
           (NOT (&cell_at_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&cell_at_division2_side A))
           (&cell_at_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &cell_at_division2_tile
      (&cell_at_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&cell_at_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &cell_at
      (&cell_at_division2_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))))

(RULE &cell_dim
  (&cell_at *P_intile)
  (axis_elem *A)
  (frame_extent (:P P_intile) A *N))

(INIT &footprint_division_sides ExtentDivisions
  (key ((&cell_dim ^N)))
  (frame ((:P P_inner))
    (input *P *Col)
    (&key_color Col)
    (&key_box.cell P)
    (&key_box.box *B)
    (ALL ((input P (:Col *Colm))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &footprint_division_parts_held
  (axis_elem *A)
  (&cell_dim *N))

(RULE &footprint_division_axis
  (OR ((input (:P *P2) *Col)
       (&key_color Col)
       (&key_box.cell (:P P2))
       (&key_box.box *B)
       (ALL ((input (:P P2) (:Col *Colm))
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X P2) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P2) (:X_rel *P))
       (&cell_dim (:N *Key))
       (axis_elem *A)
       (&footprint_division_sides.division (:key (:N Key)) A (:N Key) *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input (:P *P22) (:Col *Col2))
       (&key_color (:Col Col2))
       (&key_box.cell (:P P22))
       (&key_box.box (:B *B2))
       (ALL ((input (:P P22) (:Col *Colm2))
             (dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P22) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B2) (:X P22) (:X_rel P))
       (&cell_dim (:N Key))
       (axis_elem A)
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N Key)))
      ((input (:P *P23) (:Col *Col3))
       (&key_color (:Col Col3))
       (&key_box.cell (:P P23))
       (&key_box.box (:B *B3))
       (ALL ((input (:P P23) (:Col *Colm3))
             (dir_elem (:D *D_m13))
             (relative (:Base B3) (:X P23) (:X_rel *R_m23))
             (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
            ((>= K_m33 0)))
       (relative (:Base B3) (:X P23) (:X_rel P))
       (&cell_dim (:N Key))
       (axis_elem A)
       (NOT (&footprint_division_parts_held (:N Key) A))
       (&footprint_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &footprint_division_tile
  (&footprint_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&footprint_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &footprint
  (&footprint_division_tile (:P_outer *P_intile)))

;; The footprint against each cell's ink, both in cell frame.
(INIT &cover Inclusion
  (pattern ((:m P_intile))
    (&footprint *P_intile))
  (observed ((:observed P_tile) (:m P_intile))
    (&cell_at *P *P_tile *P_intile)
    (input P *Col)
    (&ink (:C Col))))

(RULE &stamp
  (&cell_at *P *P_tile *P_intile)
  (&cover.superset (:observed P_tile))
  (&footprint P_intile))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&stamp P)))
      ((&stamp P)
       (&key_color Col))))
