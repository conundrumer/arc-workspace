;; 52364a65

(DET &bg DominantColor)

(DET &peel_dir DirDomain)

(DET &depth TileCount)

(RULE &obj_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Each object's bounding box.
(INIT &bbox BoundingBox
  (key ((&obj_cell ^Col *P))
    (cell (P)
      (&obj_cell Col *P))))

(RULE &layer
  (&bbox.cell (:key *Col) *P)
  (&bbox.box (:key Col) *B)
  (ALL ((&bbox.cell (:key (:Col *Colm)) P)
        (&bbox.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&peel_dir *D)
  (margin (:B P_inner) D *K))

(ALTS $choice "The cases differ in what a layer is" $Strip
  (ALT $Occupied
    (RULE &obj_line_split1
      (&obj_cell *Col (:P *P_))
      (axis_of *D (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &obj_line
      (&obj_cell *Col *P)
      (&peel_dir *D)
      (axis_of D *A)
      (&obj_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

    (RULE &order_axis
      (&obj_cell (:Col *Key))
      (&peel_dir *D)
      (axis_of D *A))

    ;; The lines the object occupies, ordered along that axis.
    (INIT &order Order
      (key ((&order_axis (:Key ^Col) ^A)
            (axis_of ^D A))
        (member ((:t L))
          (&obj_line Col *L))
        (before ((:a L) (:b L2))
          (&obj_line Col *L)
          (&obj_line Col (:L *L2))
          (!= L L2)
          (margin (:B L) D (:K *K1))
          (margin (:B L2) D (:K *K2))
          (< K1 K2))))

    (RULE &order_pos
      (&order.rank (:key (:Col *Key) *A *D) (:t *M) (:R *R1))
      (&order.dual_rank (:key (:Col Key) A D) (:t M) (:R *R2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K R1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

    (RULE &layer
      (&obj_line *Col *P *L)
      (&order_pos (:Key Col) (:M L) (:P_pos *P_order))
      (&peel_dir *D)
      (margin (:B P_order) D *K))))

(RULE &peeled
  (&layer *P *K)
  (&depth *N)
  (< K N))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&peeled P)))
      ((&peeled P)
       (&bg (:C Col)))))
