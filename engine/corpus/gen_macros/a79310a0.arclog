;; a79310a0

(DET &ink ChangedColor)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(DET &shift_dir DirDomain)

(DET &shift_k DivisorRatio)

(RULE &shift_image
  (input (:P *P_in) *Col)
  (&ink (:C Col))
  (&shift_dir *D)
  (&shift_k *K)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset D K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P_in) (:B V_m1) (:C *P))
  (input P))

(RULE &output
  (OR ((&shift_image *P)
       (&mark (:C *Col)))
      ((input P)
       (NOT (&shift_image P))
       (&bg (:C Col)))))
