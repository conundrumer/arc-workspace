;; a1570a43

(INPUT markers "four single cells of &marker_color sit at the corners of an axis-aligned rectangle"

  (DET_OR_RULE &background DominantColor)

  ;; The bounding box of each non-background color; the marker rectangle is the
  ;; box of the marker color.
  (INIT &color_box BoundingBox
    (key ((input *P ^Col)
          (NOT (&background (:C Col))))
      (cell (P)
        (input *P Col)
        (NOT (&background (:C Col))))))

  (RULE &at_corner_inside1
    (input (:P *P_) *Col)
    (&color_box.box (:key Col) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET_OR_RULE &marker_color RarestColor)

  (RULE &off_corner
    (OR ((input *P *Col)
         (ALL ((&color_box.box (:key Col) *B)
               (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1_m3))
               (perp (:A A_m2) (:A2 *A2_m4))
               (corner_dir (:C Diag_m1) (:A A2_m4) (:D *D2_m5))
               (margin (:B P) (:D D1_m3) (:K *K1_m6))
               (margin B (:D D1_m3) (:K K1_m6))
               (margin (:B P) (:D D2_m5) (:K *K2_m7))
               (margin B (:D D2_m5) (:K K2_m7)))
              ((&at_corner_inside1 (:P_ P) (:B_ B)))))
        ((&color_box.box (:key Col) (:B *B2))
         (input (:P *P2))
         (ALL ((&color_box.box (:key (:Col *Colm)) (:B B2))
               (dir_elem (:D *D_m1))
               (relative (:Base B2) (:X P2) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
         (perp (:A A_m1) (:A2 *A2_m3))
         (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
         (margin (:B P2) (:D D1_m2) (:K *K1_m5))
         (margin (:B B2) (:D D1_m2) (:K K1_m5))
         (margin (:B P2) (:D D2_m4) (:K *K2_m6))
         (margin (:B B2) (:D D2_m4) (:K K2_m6))
         (OR ((NOT (input (:P P2) Col)))
             ((relative (:Base B2) (:X P2) (:X_rel *R_m7))
              (axis_of (:D *D1_m8) (:A *A1_m9))
              (opposite (:D D1_m8) (:Opp *O1_m10))
              (perp (:A A1_m9) (:A2 *A2_m11))
              (axis_of (:D *D2_m12) (:A A2_m11))
              (opposite (:D D2_m12) (:Opp *O2_m13))
              (margin (:B R_m7) (:D D1_m8) (:K *K1_m14))
              (>= K1_m14 0)
              (margin (:B R_m7) (:D O1_m10) (:K *K2_m15))
              (>= K2_m15 0)
              (margin (:B R_m7) (:D D2_m12) (:K *K3_m16))
              (>= K3_m16 0)
              (margin (:B R_m7) (:D O2_m13) (:K *K4_m17))
              (>= K4_m17 0)
              (corner_dir (:C *D2) (:A *A_m18) (:D *D1_m19))
              (perp (:A A_m18) (:A2 *A2_m20))
              (corner_dir (:C D2) (:A A2_m20) (:D *D2_m21))
              (margin (:B P2) (:D D1_m19) (:K *K1_m22))
              (margin (:B B2) (:D D1_m19) (:K K1_m22))
              (margin (:B P2) (:D D2_m21) (:K *K2_m23))
              (margin (:B B2) (:D D2_m21) (:K K2_m23))
              (!= D2 D))))))

  (INIT &corner_color Singleton
    (member ((:v Col))
      (&color_box.box (:key *Col))
      (NOT (&off_corner Col)))))

(INPUT shape "one connected object of &shape_color lies on the &background field, off the marker cells"

  (DET &shape_color ColorDomain))

(INPUT fits "the shape's bounding box has the height and width of the rectangle's interior, the cells strictly between the marker rows and strictly between the marker columns")

(OUTPUT keep-markers "the markers stay where they are")

(OUTPUT place "the shape translates as one piece so that its bounding box is the interior of the marker rectangle; the cells it left take &background"

  (RULE &piece4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &piece8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &marker_color2
    (&marker_color (:C *K)))

  (RULE &shape_cell
    (input *P *Col)
    (&shape_color (:C Col)))

  (RULE &cargo
    (&marker_color2)
    (&shape_cell *P *Col))

  (INIT &joint BoundingBox
    (cell (P)
      (&cargo *P)))

  (RULE &unit
    (&cargo *P *Col)
    (&joint.box *B))

  (RULE &mover
    (&unit *B))

  (RULE &shift
    (input *P)
    (input (:P *Q))
    (relative (:Base P) (:X Q) (:X_rel *V)))

  ;; The interior of each marker rectangle.
  (INIT &inner BoundingBox
    (key ((&marker_color2 ^K))
      (cell (P)
        (&color_box.box (:key (:Col K)) (:B *R))
        (input *P)
        (ALL ((&color_box.box (:key (:Col *Km)) (:B R))
              (dir_elem (:D *D_m1))
              (relative (:Base R) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((> K_m3 0))))))

  ;; The unit's box is a translate of the interior.
  (RULE &place
    (&mover *B)
    (&marker_color2 *K)
    (&inner.box (:key K) (:B *I))
    (relative (:Base B) (:X I) (:X_rel *V))
    (&shift V))

  (RULE &landed
    (&place *B *V)
    (&unit B *P *Col)
    (compose (:A P) (:B V) (:C *Q)))

  ;; The color each landed cell shows; two pieces that give one cell different
  ;; colors leave it none.
  (INIT &shows Singleton
    (key ((&landed ^Q *Col)
          (&marker_color2 *K)
          (input (:P Q) (:Col *C))
          (!= C K))
      (member ((:v Col))
        (&landed Q *Col)
        (&marker_color2 *K)
        (input (:P Q) (:Col *C))
        (!= C K))))

  (INIT &piece4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&cargo *P)
           (&piece4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&cargo (:P P3)))
          ((&cargo P)
           (= P3 P)))))

  (INIT &piece8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&cargo *P)
           (&piece8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&cargo (:P P3)))
          ((&cargo P)
           (= P3 P))))))

(ALTS $anchor "how the shape's destination is fixed" $Fill
  (ALT $Center
    (OUTPUT place "the shape translates so that its bounding box sits at equal margins from the marker rectangle on each axis; undefined where the two extents differ in parity on an axis, or a moved cell falls off the grid"
      ;; The color each landed cell shows; two pieces that give one cell different
      ;; colors leave it none.
      (INIT &shows Singleton
        (key ((OR ((&landed ^Q *Col)
                   (&marker_color2 *K)
                   (input (:P Q) (:Col *C))
                   (!= C K))
                  ((&landed Q)
                   (&marker_color2 K)
                   (input (:P Q) (:Col K)))))
          (member ((:v Col))
            (OR ((&landed Q *Col)
                 (&marker_color2 *K)
                 (input (:P Q) (:Col *C))
                 (!= C K))
                ((&landed Q)
                 (&marker_color2 (:K Col))
                 (input (:P Q) Col))))))

      (RULE &lands
        (&mover *B)
        (&marker_color2 *K)
        (&color_box.box (:key (:Col K)) (:B *R))
        (&shift *V)
        (compose (:A B) (:B V) (:C *T_grid))
        (relative (:Base R) (:X T_grid) (:X_rel *T)))

      ;; The box sits at equal margins from the rectangle on each axis.
      (RULE &place
        (&lands *B *V *T)
        (ALL ((&lands (:B *Bm) (:V *Vm) T)
              (opposite (:D *D_m1) (:Opp *O_m2))
              (margin (:B T) (:D D_m1) (:K *K1_m3))
              (margin (:B T) (:D O_m2) (:K *K2_m4)))
             ((= K1_m3 K2_m4)))))
    (ALTS $top "what shows where a moved cell lands on a marker, under Center" $MarkerTop
      (ALT $ShapeTop
        (OUTPUT keep-markers "a moved cell that lands on a marker covers it"
          ;; The color each landed cell shows; two pieces that give one cell different
          ;; colors leave it none.
          (INIT &shows Singleton
            (key ((&landed ^Q *Col))
              (member ((:v Col))
                (&landed Q *Col)))))))))

(ALTS $others "what happens to the cells that are neither markers nor the shape color" $KeepRest
  (ALT $EraseRest
    (OUTPUT place "the output starts blank, and only the markers and the moved shape are drawn on it")
    (RULE &stays
      (&marker_color2 (:K *Col))
      (input *P Col)))
  (ALT $Carry
    (OUTPUT place "the unit that moves is every cell that is neither &background nor the marker color, and its cells keep their colors"
      (RULE &cargo
        (&marker_color2 *K)
        (input *P *Col)
        (NOT (&background (:C Col)))
        (!= Col K)))
    (RULE &stays
      (&marker_color2)
      (input *P *Col)
      (NOT (&cargo P)))))

(ALTS $grouping "what moves as one piece" $ColorClass
  (ALT $PerObject
    (OUTPUT place "each piece of edge-adjacent moving cells is placed alone by its own bounding box, and all of them are drawn; undefined where two placed pieces give one cell different colors"
      (RULE &piece4_component
        (&piece4.class (:a *P) *Id))

      (INIT &piece_box BoundingBox
        (key ((&piece4_component *P ^Id))
          (cell (P)
            (&piece4_component *P Id))))

      (RULE &unit
        (&piece_box.cell (:key *Id) *P)
        (&piece_box.box (:key Id) *B)
        (&cargo P *Col)))
    (ALTS $conn "which cells join into one piece under PerObject" $Conn4
      (ALT $Conn8
        (OUTPUT place "diagonal neighbors also join into one piece"
          (RULE &piece8_component
            (&piece8.class (:a *P) *Id))
          (INIT &piece_box BoundingBox
            (key ((&piece8_component *P ^Id))
              (cell (P)
                (&piece8_component *P Id)))))))))

(ALTS $marker "where the marker color comes from" $StoredMarker
  (ALT $DeriveMarker
    (INPUT markers "the marker color is the one non-background color whose cells are exactly the four corners of a rectangle; undefined when no color or more than one color is"
      (RULE &marker_color2
        (&corner_color.value (:v *K))))))

(RULE &plan
  (&mover))

(RULE &stranded
  (&plan)
  (&mover *B)
  (NOT (&place B)))

(RULE &strays
  (&landed *Q)
  (NOT (input (:P Q))))

(RULE &stays
  (&marker_color2)
  (input *P *Col)
  (NOT (&shape_cell P)))

(RULE &painted
  (OR ((&shows.value (:key *Q) (:v *Col)))
      ((&plan)
       (input (:P Q))
       (NOT (&landed Q))
       (OR ((&stays (:P Q) Col))
           ((NOT (&stays (:P Q)))
            (&background (:C Col)))))))

(RULE &output
  (&painted (:Q *P) *Col)
  (NOT (&stranded))
  (NOT (&strays)))
