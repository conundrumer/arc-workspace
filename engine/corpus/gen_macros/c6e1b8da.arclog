;; c6e1b8da

(INPUT solid-rectangles "every input holds solid rectangles on a field of &background, each rectangle in its own color."

  (DET &edge_color
    (ex_input *E *P *Col)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))

  (DET &off_edge
    (ex_input *Col)
    (ex_output *E)
    (dir_elem *D)
    (NOT (&edge_color E Col D)))

  (DET_OR_RULE &background DominantColor
    (ex_input (:Col *C))
    (NOT (&off_edge (:Col C)))))

(INPUT tails "at least one rectangle has a tail: a straight line one cell wide, of the rectangle's color, that goes out from the middle part of one side, perpendicular to that side. The other rectangles have no tail.")

(INPUT tailed-on-top "a tailed rectangle and its tail lie on top of any rectangle they overlap. Only a tailed rectangle or a tail hides part of a rectangle.")

(OUTPUT slide-by-tail "each tailed rectangle moves in the direction its tail points, by as many cells as the tail has, so its leading side ends on the tail's tip. The tail is not drawn.")

(OUTPUT slid-on-top "a moved rectangle covers any other rectangle where they overlap.")

(OUTPUT restore-whole "each rectangle with no tail is drawn whole at its place, the cells a tailed rectangle or a tail hid in the input included.")

(OUTPUT vacated-background "a cell that no rectangle covers in the output is &background."

  (RULE &mate
    (input *P *Col)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (input (:P Q) Col))

  (RULE &flanked
    (&mate *P *D)
    (axis_of D (:A *A2))
    (perp (:A A2) (:A2 *A)))

  (RULE &tail_cand
    (input *P *Col)
    (NOT (&background (:C Col)))
    (axis_elem *A)
    (NOT (&flanked P A)))

  (RULE &foot
    (&mate (:P *Q) *D (:Q *T))
    (axis_of D *A)
    (&tail_cand (:P T) A)
    (ALL ((axis_of D (:A *A_m1))
          (perp (:A A_m1) (:A2 *A2_m2))
          (axis_of (:D *D2) (:A A2_m2)))
         ((&mate (:P Q) (:D D2)))))

  (RULE &tail_dir
    (&foot (:Q *Key) *D))

  (RULE &tail_node
    (&foot (:Q *Key))
    (input (:P Key) *Col)
    (input *P Col))

  (RULE &tail_node_ray
    (&tail_node *Key *P))

  (RULE &tail_source
    (&tail_node *Key *P))

  ;; The tail of each foot: the run of its color's cells that leaves it.
  (INIT &tail Distance
    (key ((&tail_source (:Key ^Ky) (:P ^O))
          (&tail_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&tail_source (:Key Ky) (:P O))
             (&tail_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&tail_node_ray (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&tail_node_ray (:Key Ky) (:P Q)))
            ((&tail_source (:Key Ky) (:P O))
             (&tail_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&tail_node_ray (:Key Ky) (:P Q))
             (= A2 O))
            ((&tail_source (:Key Ky) (:P O))
             (&tail_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&tail_node_ray (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&tail_node_ray (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&tail_source (:Key Ky) (:P O))
        (&tail_dir (:Key Ky) D))))

  (RULE &tail_ray
    (&tail.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (RULE &tail_cell
    (&tail_ray (:Key *Q) (:P *T) (:K *N) (:Origin Q))
    (> N 0))

  (INIT &tail_size Cardinality
    (key ((&tail_cell ^Q *T))
      (member ((:m T))
        (&tail_cell Q *T))))

  (RULE &slide
    (&foot *Q *D)
    (input (:P Q) *Col)
    (&tail_size.size (:key Q) *N))

  ;; Each rectangle's extent: the box of its color's cells, the tail left out.
  (INIT &rect BoundingBox
    (key ((input *P ^Col)
          (NOT (&background (:C Col)))
          (NOT (&tail_cell (:T P))))
      (cell (P)
        (input *P Col)
        (NOT (&background (:C Col)))
        (NOT (&tail_cell (:T P))))))

  (RULE &still
    (&rect.box (:key *Col) *B)
    (NOT (&slide Col))
    (input *P)
    (ALL ((&rect.box (:key (:Col *Colm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))))

(ALTS $choice "how a rectangle with no tail shows where a tailed one hid it" $RestoreWhole
  (ALT $RestoreVacatedOnly
    (OUTPUT restore-whole "each rectangle with no tail keeps its input cells, and a cell that a moved rectangle or its tail leaves takes the color of the rectangle with no tail whose bounding box holds it; undefined where two such boxes hold one left cell.")
    (RULE &ground
      (input *P (:Col *Col_in))
      (OR ((&slide (:Col Col_in))
           (&still P *Col))
          ((NOT (&slide (:Col Col_in)))
           (= Col Col_in))
          ((&slide (:Col Col_in))
           (NOT (&still P))
           (&background (:C Col)))))))

(RULE &tail_end
  (&tail_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&tail_ray Key (:P Q) D Origin)))

(RULE &slid
  (&slide *Col *D *N)
  (&rect.box (:key Col) *B)
  (input (:P *P2))
  (ALL ((&rect.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
  (edge_inset D (:K N) (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

(RULE &ground
  (input *P)
  (OR ((&still P *Col))
      ((NOT (&still P))
       (&background (:C Col)))))

(RULE &output
  (input *P)
  (OR ((&slid P *Col))
      ((NOT (&slid P))
       (&ground P Col))))
