;; 1bfc4729

(DET &bg DominantColor)

;; The axis the two halves stack along.
(DET &axis AxisDomain)

;; The line's distance from the half's outer edge.
(DET &line_dist SepThickness)

(RULE &half
  (input *P)
  (&axis *A)
  (axis_of *D A)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&half P *D))

(RULE &ink
  ;; The grid's border, in the color of the half it runs through.
  (OR ((&half *P *D)
       (&mark D *Col)
       (dir_elem (:D *D2))
       (margin (:B P) (:D D2) (:K 0)))
      ((&half P (:D *D3))
       (&mark (:D D3) Col)
       (&line_dist (:G *K))
       (margin (:B P) (:D D3) K))))

(ALTS $choice "where each half's line sits; data-equivalent on this task, since every mark sits two cells in from its half's outer edge" $StoredLine
  (ALT $MarkLine
    (RULE &ink
      (OR ((&half *P *D)
           (&mark D *Col (:P *P_mark))
           (margin (:B P) D (:K *K_m1))
           (margin (:B P_mark) D (:K K_m1)))
          ;; The grid's border, in the color of the half it runs through.
          ((&half P (:D *D3))
           (&mark (:D D3) Col)
           (dir_elem (:D *D2))
           (margin (:B P) (:D D2) (:K 0)))))))

(RULE &output
  (OR ((&ink *P *Col))
      ((input P)
       (NOT (&ink P))
       (&bg (:C Col)))))
