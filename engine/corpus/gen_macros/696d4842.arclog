;; 696d4842

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &shapes_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(RULE &sight_dir
  (dir_elem (:D *Key)))

(RULE &sight_node
  (dir_elem (:D *Key))
  (input *P)
  (ALL ((input P *Col))
       ((&bg (:C Col)))))

(INIT &rim Boundary
  (key ((&shapes_node (:Key ^Col) *P))
    (cell (P)
      (&shapes_node (:Key Col) *P))))

(RULE &link
  (&shapes_node (:Key *Col) *P)
  (dir_elem *D)
  (NOT (&rim.exposed (:key Col) P D)))

;; The one direction a shape cell's neighbors lie in.
(INIT &behind Singleton
  (key ((&link ^P *D))
    (member ((:v D))
      (&link P *D))))

(RULE &end
  (&behind.value (:key *P) (:v *D_in))
  (opposite (:D D_in) (:Opp *D)))

(RULE &sight_source
  (&end *P (:D *Key)))

;; Ends look along their line, and any content stops the look.
(INIT &sight Distance
  (key ((&sight_source (:Key ^Ky) (:P ^O))
        (&sight_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:Key Ky) (:P O))
           (&sight_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:Key Ky) (:P Q)))
          ((&sight_source (:Key Ky) (:P O))
           (&sight_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&sight_source (:Key Ky) (:P O))
           (&sight_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&sight_source (:Key Ky) (:P O))
      (&sight_dir (:Key Ky)))))

(RULE &sight_ray
  (&sight.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray Key (:P Q) D Origin)))

(RULE &dot
  (&shapes_node *P)
  (NOT (&link P)))

(RULE &sight_cell
  (dir_elem (:D *Key))
  (input *P *Col)
  (&bg (:C Col)))

(RULE &faces
  (&sight_end (:Key *D) (:P *E) D (:Origin *P_end))
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P_dot))
  (input (:P P_dot))
  (&dot (:P P_dot)))

(RULE &growth
  (&faces *P_end)
  (&sight_ray (:Key *D) *P D (:Origin P_end))
  (&sight_cell (:Key D) P))

(RULE &shape_cell
  (&faces *P_end)
  (&shapes_component (:Key *Col) (:P P_end) *Id)
  (&shapes_component (:Key Col) (:P *Q) Id))

;; The near end advances one growth cell per step, and at each step the far
;; end gives up the next cell of the shape.
(INIT &crawl Unfold
  (key ((OR ((&growth ^P_end *P)
             (&end (:P P_end) *D)
             (step_offset D (:V *V_m1))
             (compose (:A P_end) (:B V_m1) (:C P)))
            ((&growth P_end P)
             (&end (:P P_end) D)
             (step_offset D (:V V_m1))
             (compose (:A P) (:B V_m1) (:C *P2))
             (&growth P_end (:P P2)))
            ((&shape_cell P_end *Q))))
    (start ((:t P))
      (&growth P_end *P)
      (&end (:P P_end) *D)
      (step_offset D (:V *V_m1))
      (compose (:A P_end) (:B V_m1) (:C P)))
    (initial_untaken ((:item Q))
      (&shape_cell P_end *Q))
    (step ((:t P) (:t2 P2))
      (&growth P_end *P)
      (&end (:P P_end) *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *P2))
      (&growth P_end (:P P2)))
    (take ((:t P) (:item Q))
      (&growth P_end *P)
      (&shape_cell P_end *Q)
      (&crawl.untaken (:t P) (:item Q))
      (OR ((&end (:P Q))
           (!= Q P_end))
          ((&link (:P Q) *D)
           (step_offset D (:V *V_m1))
           (compose (:A Q) (:B V_m1) (:C *Q2))
           (&crawl.taken (:t P) (:item Q2)))))))

(RULE &vacated
  (&crawl.take (:key *P_end) (:item *P))
  (&faces P_end *P_dot)
  (input (:P P_dot) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&growth *P_end P)
       (input (:P P_end) *Col))
      ((&vacated P Col))
      ((NOT (&growth P))
       (NOT (&vacated P))
       (= Col Col_in))))
