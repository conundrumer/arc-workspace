;; 40f6cd08

(RULE &rects_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &rects Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&rects_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &rects_component
  (&rects.class (:a *P) *Id))

(INIT &bbox BoundingBox
  (key ((&rects_component *P ^Id))
    (cell (P)
      (&rects_component *P Id))))

(RULE &rect_view
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &rect_color Singleton
  (key ((&bbox.cell (:key ^Id) *P)
        (input P *Col))
    (member ((:v Col))
      (&bbox.cell *P)
      (input P *Col))))

(INIT &layer BoundingBox
  (key ((&rect_color.plural (:key *Id))
        (&rect_view Id *P *P_inner)
        (input P ^Col))
    (cell ((:P P_inner))
      (&rect_color.plural (:key *Id))
      (&rect_view Id *P *P_inner)
      (input P Col))))

(RULE &nested
  (&layer.box (:key (:Col *Col_in)) (:B *B_in))
  (&layer.box (:key (:Col *Col_out)) (:B *B_out))
  (ALL ((&layer.box (:key (:Col *Col_inm)) (:B B_in))
        (&layer.box (:key (:Col *Col_outm)) (:B B_out))
        (dir_elem (:D *D_m1))
        (relative (:Base B_out) (:X B_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (!= B_in B_out))

(RULE &covers
  (&rect_view *P *P_inner)
  (&layer.box (:key *Col) *B)
  (ALL ((&rect_view (:P *Pm) P_inner)
        (&layer.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_inner) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &shadowed
  (&covers *P (:Col *Col_in))
  (&nested Col_in (:Col_out *Col)))

(RULE &paint
  (&covers *P *Col)
  (NOT (&shadowed P Col)))

(RULE &stamp
  (&paint *P *Col))

(ALTS $choice "the outermost layer's margins are all zero, and every plain rectangle already carries its color, so no pair separates these two cases" $Repaint
  (ALT $Overlay
    (RULE &stamp
      (&paint *P *Col)
      (&nested (:Col_in Col)))))

(RULE &output
  (OR ((&stamp *P *Col))
      ((input P Col)
       (NOT (&stamp P)))))
