;; 496994bd

(DET &bg DominantColor)

(DET &axis AxisDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &img
  (&ink (:P *P3) *Col)
  (&axis *A)
  (axis_inversion A (:T *F))
  (apply (:D F) (:P P3) (:P_out *P)))

(ALTS $choice "where the reflected copy comes from; the block is flush at its edge in every pair, so the pairs cannot separate the cases" $Mirror
  (ALT $Seat
    (DET &dir DirDomain)

    (INIT &block BoundingBox
      (cell (P)
        (&ink *P)))

    (RULE &img
      (&ink (:P *P3) *Col)
      (&dir *D)
      (axis_of D *A)
      (axis_inversion A (:T *F))
      (apply (:D F) (:P P3) (:P_out *P_img))
      (opposite D (:Opp *O))
      (&block.box *B)
      (margin B D (:K *M))
      (dir8_opposite (:D O) (:D2 *O_m2))
      (edge_inset (:D O_m2) (:K M) (:B *B1_m3))
      (edge_inset (:D O) (:K M) (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A P_img) (:B V_m1) (:C *P)))))

(RULE &output
  (OR ((&ink *P *Col))
      ((&img P Col))
      ((input P)
       (NOT (&ink P))
       (NOT (&img P))
       (&bg (:C Col)))))
