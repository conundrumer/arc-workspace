;; 05f2a901

(RULE &cast_dir
  (dir_elem *D))

(RULE &cast_node
  (input *P))

(DET &mover ChangedColor)

(RULE &mover_cell
  (input *P *Col)
  (&mover (:C Col)))

(RULE &cast_source
  (&mover_cell *P))

;; The anchor lies toward one edge from the mover, on a shared line.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &anchor RarestColor)

(RULE &anchor_cell
  (input *P *Col)
  (&anchor (:C Col)))

(RULE &move_dir
  (dir_elem *D)
  (&cast_ray *P D)
  (&anchor_cell P))

(RULE &shape
  (&mover_cell *P))

(RULE &blocked
  (&anchor_cell *P))

(RULE &gravity_dir
  (&move_dir *D))

(RULE &cleared
  (OR ((input *P *Col)
       (NOT (&mover_cell P)))
      ((&mover_cell P)
       (&bg (:C Col)))))

(ALTS $choice "The cases differ in what counts as contact" $Block
  (ALT $Touch
    ;; One step along the travel past a cell beside the anchor.
    (RULE &blocked
      (&anchor_cell (:P *P3))
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P3) (:B V_m1) (:C *P1))
      (&move_dir (:D *D_move))
      (step_offset (:D D_move) (:V *V_m2))
      (compose (:A P1) (:B V_m2) (:C *P))))
  (ALT $Extent
    (INIT &bbox BoundingBox
      (key ((OR ((&mover_cell *P)
                 (&mover (:C ^Col)))
                ((&anchor_cell P)
                 (&anchor (:C Col)))))
        (cell (P)
          (OR ((&mover_cell *P)
               (&mover (:C Col)))
              ((&anchor_cell P)
               (&anchor (:C Col)))))))

    (RULE &box_cell
      (&bbox.box (:key *Col) *B)
      (input *P)
      (ALL ((&bbox.box (:key (:Col *Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))

    (RULE &shape
      (&mover (:C *Col))
      (&box_cell Col *P))

    (RULE &blocked
      (&anchor (:C *Col))
      (&box_cell Col *P))))

;; The footprint travels toward the anchor until it would cover a blocked cell.
(INIT &gravity Distance
  (source_distance (K)
    (OR ((&shape *P)
         (&gravity_dir *D)
         (margin (:B P) D *K))
        ((&shape (:P *P3))
         (&gravity_dir (:D *D2))
         (&blocked (:P *P2))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &landed
  (&gravity.distance *K)
  (&gravity_dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (&mover_cell (:P *P3))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &output
  (OR ((&landed *P)
       (&mover (:C *Col)))
      ((&gravity.distance *K)
       (&gravity_dir *D)
       (dir8_opposite D (:D2 *O_m2))
       (edge_inset (:D O_m2) K (:B *B1_m3))
       (edge_inset D K (:B *I_m5))
       (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
       (&cleared P Col)
       (NOT (&landed P)))))
