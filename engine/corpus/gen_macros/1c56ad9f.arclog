;; 1c56ad9f

(DET &bg DominantColor)

(DET &anchor DirDomain)

(DET &period TileCount)

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&figure *P)))

(RULE &phase
  (&bbox.cell *P)
  (&bbox.box *B)
  (ALL ((&bbox.cell P)
        (&bbox.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&anchor *D)
  (margin (:B P_inner) D (:K *T))
  (&period *N)
  (divide T (:Side N) (:Gap 0) (:Remainder *K)))

;; Where each phase's lines seat on their example's output: the
;; translations that carry every cell of the phase onto an output cell
;; of its color.
(INIT &seating Occurrences
  (key ((OR ((&figure ^E *P *Col)
             (&phase E P ^K))
            ((&phase E K)
             (ex_output E P Col))))
    (cell (P (:v Col))
      (&phase E K)
      (ex_output E *P *Col))
    (shape (P (:v Col))
      (&figure E *P *Col)
      (&phase E P K))))

(DET &wave
  (&seating.occurrence (:key *K) (:P *V))
  (&anchor *D)
  (sense_elem *S)
  (turn S D (:D2 *D_step))
  (step_offset (:D D_step) V))

(RULE &step_dir
  (&wave *K *S)
  (&anchor (:D *D2))
  (turn S (:D D2) (:D2 *D)))

(RULE &moved
  (&figure (:P *P2) *Col)
  (&phase (:P P2) *K)
  (OR ((&step_dir K *D)
       (step_offset D (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C *P)))
      ((NOT (&step_dir K))
       (= P P2))))

(RULE &output
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (&bg (:C Col)))))
