;; 3a301edc

(DET &bg DominantColor)

(RULE &fig
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &fig_box BoundingBox
  (cell (P)
    (&fig *P)))

(RULE &rect_color
  (&fig *P)
  (&fig_box.box *B)
  (ALL ((dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (input P *Col))

(RULE &blk_color
  (&fig *P)
  (input P *Col)
  (NOT (&rect_color Col)))

(INIT &blk_box BoundingBox
  (cell (P)
    (input *P *Col)
    (&blk_color Col)))

(RULE &thick_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&blk_box.box (:B *B4))
  (&blk_box.cell *P)
  (axis_elem (:A *A4))
  (relative (:Base B4) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) (:A A4) *N)
  (axis_of D (:A A4))
  (&blk_box.box (:B *B2))
  (&blk_box.cell (:P *P2))
  (axis_elem (:A *A2))
  (relative (:Base B2) (:X P2) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N *N2))
  (axis_of (:D D2) (:A A2))
  (opposite D (:Opp *O_m3))
  (edge_inset D (:K N) (:B *B1_m4))
  (edge_inset (:D O_m3) (:K N2) (:B *B2_m5))
  (compose (:A B1_m4) (:B B2_m5) (:C *B)))

(RULE &thick
  (&thick_axis *A (:B *B1))
  (perp A *A2)
  (&thick_axis (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(RULE &fig_cover
  (&fig_box.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &ring_box
  (&fig_box.box (:B *B_fig))
  (&thick (:B *B_thick))
  (relative (:Base B_thick) (:X B_fig) (:X_rel *B)))

(RULE &ring_cover
  (input *P)
  (&ring_box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &ring
  (&ring_cover *P)
  (NOT (&fig_cover P)))

(ALTS $wrap "What the ring goes around." $Box
  (ALT $Cells
    (RULE &ring
      (&ring_cover *P)
      (NOT (&fig P)))))

(ALTS $render "What the output shows." $Outset
  (ALT $Nest
    (RULE &blk_cover
      (&blk_box.box *B)
      (input *P)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))

    (RULE &output
      (OR ((&fig_cover *P)
           (IF ((&blk_cover P))
               ((&blk_color *Col))
               ((&rect_color Col))))
          ((input P)
           (NOT (&fig_cover P))
           (IF ((&ring P))
               ((&blk_color Col))
               ((&bg (:C Col)))))))))

(RULE &output
  (OR ((&ring *P)
       (&blk_color *Col))
      ((input P Col)
       (NOT (&ring P)))))
