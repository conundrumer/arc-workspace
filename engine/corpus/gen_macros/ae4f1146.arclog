;; ae4f1146

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(DET &mark RarestColor)

(INIT &comp_winner_count Cardinality
  (key ((&comps_component *P ^Id)
        (input P *Col)
        (&mark (:C Col)))
    (member ((:m P))
      (&comps_component *P Id)
      (input P *Col)
      (&mark (:C Col)))))

(INIT &comp_winner Order
  (member ((:t Id))
    (&comp_winner_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&comp_winner_count.size (:key *Id) *N)))

;; Crop to the winner's bounding box.
(INIT &view BoundingBox
  (cell (P)
    (&comp_winner.maximal (:t *Id))
    (&comps_component *P Id)))

(ALTS $choice "what structure counts as a block" $Object
  (ALT $Window
    (DET &shape Frame)

    ;; Placements where the square lands all-ink.
    (INIT &occ Occurrences
      (cell (P)
        (input *P *Col)
        (NOT (&bg (:C Col))))
      (shape (P)
        (&shape *P)))

    (RULE &window_cell
      (&occ.occurrence (:P *Anchor))
      (&shape (:P *P_inner))
      (compose (:A Anchor) (:B P_inner) (:C *P_grid)))

    (INIT &window_winner_count Cardinality
      (key ((&window_cell (:Anchor ^A) (:P_grid *P))
            (input P *Col)
            (&mark (:C Col)))
        (member ((:m P))
          (&window_cell (:Anchor A) (:P_grid *P))
          (input P *Col)
          (&mark (:C Col)))))

    (INIT &window_winner Order
      (member ((:t A))
        (&window_winner_count.size (:key *A)))
      (score ((:t A) (:S N))
        (&window_winner_count.size (:key *A) *N)))

    (RULE &output
      (&window_winner.maximal (:t *A))
      (&window_cell (:Anchor A) (:P_inner *P) (:P_grid *P2))
      (input (:P P2) *Col))))

(RULE &output
  (input (:P *P2) *Col)
  (&view.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
