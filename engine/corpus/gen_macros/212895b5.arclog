;; 212895b5

(RULE &cast_dir
  (diag_dir_elem *D))

;; Cells no arm can enter.
(DET &stop UnchangedColor)

(RULE &cast_blocked
  (input *P *Col)
  (&stop (:C Col)))

(RULE &cast_node
  (input *P)
  (NOT (&cast_blocked P)))

(DET &block RarestColor)

(RULE &block_cell
  (input *P *Col)
  (&block (:C Col)))

;; The block's box, so its sides, middles, and corners can be named.
(INIT &bbox BoundingBox
  (cell (P)
    (&block_cell *P)))

(RULE &corner
  (&block_cell *P)
  (&bbox.box *B)
  (ALL ((&block_cell P)
        (&bbox.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &cast_source
  (&corner *P))

(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(DET &diag_paint AnyOutNewColor)

(DET &arm_paint AnyOutNewColor)

(RULE &seed
  (&block_cell *P)
  (&bbox.box *B)
  (ALL ((&block_cell P)
        (&bbox.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) *D (:K *K_m1))
  (margin B D (:K K_m1))
  (relative (:Base B) (:X P) (:X_rel *P_rel))
  (axis_of D (:A *A_m2))
  (perp (:A A_m2) (:A2 *A2_m3))
  (axis_of (:D *D2) (:A A2_m3))
  (opposite (:D D2) (:Opp *O_m4))
  (margin (:B P_rel) (:D D2) *K)
  (margin (:B P_rel) (:D O_m4) K))

(RULE &diag_arm
  (&cast_ray *P *D *K (:Origin *Src))
  (&corner (:P Src) (:Diag D))
  (!= K 0))

(DET &place
  (ex_output *E *P *Col)
  (&arm_paint (:C Col))
  (&seed E (:P *P0) *D)
  (relative (:Base P0) (:X P) (:X_rel *P_rel))
  (opposite D (:Opp *D_back))
  (corner_dir (:C *Diag) *A (:D D_back))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2_m1))
  (corner_dir (:C Diag) A (:D *D1_m3))
  (perp A (:A2 *A2_m5))
  (corner_dir (:C Diag) (:A A2_m5) (:D *D2_m4))
  (margin (:B P_rel) (:D D1_m3) (:K *O))
  (margin (:B P_rel) (:D D2_m4) (:K *S))
  (> O 0)
  (>= S 0)
  (<= S O))

;; The arm's path order: every step goes out or across, never back.
(INIT &step_order Order
  (key ((&place ^E ^D *P))
    (member ((:t P))
      (&place E D *P))
    (before ((:a Q) (:b P))
      (&place E D (:P *Q) (:O *O1) (:S *S1))
      (&place E D *P (:O *O2) (:S *S2))
      (<= O1 O2)
      (<= S1 S2)
      (!= Q P))))

(DET &entered
  (&step_order.rank (:key *E *D) (:t *P) *R)
  (opposite (:D *H) (:Opp *H_back))
  (step_offset (:D H_back) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (OR ((&step_order.rank (:key E D) (:t Q) (:R *R2))
       (< R2 R))
      ((&seed E (:P Q) D))))

(DET &bend
  (&entered *E *D *P *R *H)
  (&entered E D (:P *Q) (:H *H2))
  (step_offset (:D H2) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C Q))
  (c4_elem (:D *T))
  (d4_elem (:D T))
  (dir_elem (:D H))
  (dir_elem (:D H2))
  (step_offset (:D H) (:V *S_m2))
  (apply (:D T) (:P S_m2) (:P_out *S2_m3))
  (step_offset (:D H2) (:V S2_m3)))

(DET &cand
  (&bend (:R *N))
  (!= N 0))

;; The rotation an arm's bends show at one phase of a candidate cycle.
(INIT &phase_turn Singleton
  (key ((&cand ^N)
        (&bend ^E ^D *R *T)
        (divide (:T R) (:Side N) (:Gap 0) (:Remainder ^K)))
    (member ((:v T))
      (&cand N)
      (&bend E D *R *T)
      (divide (:T R) (:Side N) (:Gap 0) (:Remainder K)))))

(DET &broken_cycle
  (&phase_turn.plural (:key *N)))

;; The gait is the shortest cycle the arms bear out.
(INIT &cycle Order
  (member ((:t N))
    (&cand *N)
    (NOT (&broken_cycle N)))
  (score ((:t N) (:S N))
    (&cand *N)
    (NOT (&broken_cycle N))))

(DET &gait
  (&cycle.minimal (:t *N))
  (&phase_turn.value (:key N (:K *Phase)) (:v *T)))

(INIT &cycle2 Order
  (member ((:t K))
    (&gait (:Phase *K)))
  (score ((:t K) (:S K))
    (&gait (:Phase *K))))

;; The turtle: its cell, heading, and phase, from where it starts. Each step
;; moves along the heading onto a cell it may enter, then turns by the phase's
;; rotation.
(INIT &turtle Propagation
  (source ((:n P (:H D) Phase))
    (&seed *P *D)
    (= *Phase 0))
  (edge ((:a P H (:Phase K)) (:b (:P Q) (:H H2) (:Phase K2)))
    (input *P)
    (dir_elem (:D *H))
    (step_offset (:D H) (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (input (:P Q) *Col)
    (NOT (&stop (:C Col)))
    (&gait (:Phase *K) *T)
    (d4_elem (:D T))
    (dir_elem (:D H))
    (dir_elem (:D *H2))
    (step_offset (:D H) (:V *S_m2))
    (apply (:D T) (:P S_m2) (:P_out *S2_m3))
    (step_offset (:D H2) (:V S2_m3))
    (&cycle2.cyclic_successor (:a K) (:b *K2))))

(RULE &paint
  (OR ((&diag_arm *P)
       (&diag_paint (:C *Col)))
      ((&turtle.reached (:n P))
       (NOT (&block_cell P))
       (&arm_paint (:C Col)))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (= Col Col_in))))
