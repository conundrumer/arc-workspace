;; 6e4f6532

(INIT &fill_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; bg is the commonest color.
(INIT &fill Order
  (member ((:t Col))
    (&fill_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&fill_count.size (:key *Col) *N)))

(RULE &bg
  (&fill.maximal (:t *Col)))

(RULE &line_bg_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *X_m1_)))

(RULE &line_bg
  (input *P *Col)
  (&bg Col)
  (axis_elem *A)
  (&line_bg_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1)))

(RULE &wall_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *X_m1_)))

(RULE &wall
  (input *P *Col)
  (axis_elem *A)
  (&wall_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1))
  (NOT (&line_bg A Along)))

(RULE &wall_cast_dir
  (&wall (:Col *Key))
  (dir_elem *D))

(RULE &wall_cast_dir_ray
  (&wall_cast_dir *Key *D))

(RULE &wall_cast_node
  (&wall_cast_dir *Key)
  (input *P))

(RULE &wall_cast_source
  (&wall *P (:Col *Key)))

;; Each wall's cells cast across the cells off that wall, keyed by the wall's
;; color.
(INIT &wall_cast Distance
  (key ((&wall_cast_source (:Key ^Ky) (:P ^O))
        (&wall_cast_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&wall_cast_source (:Key Ky) (:P O))
           (&wall_cast_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&wall_cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&wall_cast_node (:Key Ky) (:P Q)))
          ((&wall_cast_source (:Key Ky) (:P O))
           (&wall_cast_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&wall_cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&wall_cast_source (:Key Ky) (:P O))
           (&wall_cast_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&wall_cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&wall_cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&wall_cast_source (:Key Ky) (:P O))
      (&wall_cast_dir_ray (:Key Ky) D))))

(RULE &wall_cast_ray
  (&wall_cast.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &wall_cast_end
  (&wall_cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&wall_cast_ray Key (:P Q) D Origin)))

(RULE &parts_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(RULE &ink
  (input *P *Col)
  (NOT (&bg Col))
  (NOT (&wall P)))

(INIT &parts Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&parts_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &parts_component
  (&parts.class (:a *P) *Id))

(DET &core RarestColor)

(RULE &wall_cast_cell
  (&wall (:Col *Key))
  (input *P)
  (NOT (&wall P (:Col Key))))

(RULE &wall_toward
  (&wall_cast_ray (:Key *Col) *P (:D *Opp))
  (&wall_cast_cell (:Key Col) P)
  (opposite *D Opp))

(RULE &has_body
  (&parts_component *P *Id)
  (&ink P *Col)
  (NOT (&core (:C Col))))

(RULE &object_cell
  (&parts_component *P *Id)
  (&has_body Id)
  (&ink P *Col))

(RULE &target_cell
  (&parts_component *P *Id)
  (NOT (&has_body Id)))

;; Seek each pose among the target cells; an occurrence lands every core cell
;; on a target cell.
(INIT &seat Occurrences
  (key ((OR ((&object_cell ^Id *P *Col)
             (&core (:C Col))
             (d4_elem ^D)
             (apply D P (:P_out *P_img)))
            ((&object_cell Id)
             (d4_elem D)
             (&target_cell P))))
    (cell (P)
      (&object_cell Id)
      (d4_elem D)
      (&target_cell *P))
    (shape ((:P P_img))
      (&object_cell Id *P *Col)
      (&core (:C Col))
      (d4_elem D)
      (apply D P (:P_out *P_img)))))

(RULE &seated
  (&seat.occurrence (:key *Id *D) (:P *Sh))
  (&object_cell Id *P *Col)
  (apply D P (:P_out *P_img))
  (compose (:A Sh) (:B P_img) (:C *P_out)))

(RULE &faces
  (&seated *Id *D *Sh (:P_out *P) *Col)
  (&wall_toward P Col (:D *Dir))
  (opposite (:D Dir) *Opp)
  (step_offset (:D Opp) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&seated Id D Sh (:P_out Q)))

(ALTS $choice "how a wall-colored cell faces its wall" $Backed
  (ALT $Edge
    (INIT &obj_box BoundingBox
      (key ((&object_cell ^Id *P))
        (cell (P)
          (&object_cell Id *P))))

    ;; A wall-colored cell of a seating faces its wall when it lies on the edge of
    ;; the object's box that the transform turns toward the wall.
    (RULE &faces
      (&seated *Id *D *Sh (:P *P2) (:P_out *P) *Col)
      (&wall_toward P Col (:D *Dir))
      (&obj_box.box (:key Id) *B)
      (ALL ((&seated (:Id *Idm) (:D *Dm) (:Sh *Shm) (:P P2) (:P_out *P_outm) (:Col *Colm))
            (&obj_box.box (:key (:Id Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P2) (:D *Dir_in) (:K *K_m1))
      (margin B (:D Dir_in) (:K K_m1))
      (d4_elem D)
      (dir_elem (:D Dir_in))
      (dir_elem (:D Dir))
      (step_offset (:D Dir_in) (:V *S_m2))
      (apply D (:P S_m2) (:P_out *S2_m3))
      (step_offset (:D Dir) (:V S2_m3)))))

(RULE &misfaced
  (&seated *Id *D *Sh (:P_out *P) *Col)
  (&wall Col)
  (NOT (&faces Id D Sh P)))

(RULE &fit
  (&seat.occurrence (:key *Id *D) (:P *Sh))
  (ALL ((&seated Id D Sh (:P_out *P) *Col)
        (&core (:C Col))
        (&target_cell (:Id *T) P)
        (&target_cell (:Id T) (:P *Q)))
       ((&seated Id D Sh (:P_out Q) Col)))
  (NOT (&misfaced Id D Sh)))

(RULE &rotation_fits
  (&fit *Id *D)
  (c4_elem D))

(RULE &placed
  (&fit *Id *D *Sh)
  (OR ((c4_elem D))
      ((NOT (&rotation_fits Id))))
  (&seated Id D Sh (:P_out *P) *Col))

(RULE &output
  (OR ((&placed *P *Col))
      ((input P (:Col *C_in))
       (NOT (&placed P))
       (OR ((&object_cell P)
            (&bg Col))
           ((NOT (&object_cell P))
            (= Col C_in))))))
