;; c663677b

(INPUT periodic-pattern "apart from the blanked cells, the grid is periodic on each axis: each cell has the color of every cell that lies a whole number of periods away from it on the row axis and on the column axis. The period on an axis is the shortest shift under which the unblanked cells agree, and it is shorter than the grid on that axis."

  (DET &hole_color
    (ex_input *E *P (:Col *C))
    (ex_output E P (:Col *C2))
    (!= C C2))

  (RULE &hole
    (&hole_color *C))

  (RULE &blank_cand
    (&hole_color *C))

  ;; The shifts under which the cells left unblanked agree, with each color
  ;; read as blank.
  (INIT &shifts Periods
    (key ((&blank_cand ^C))
      (cell (P (:v Col))
        (input *P *Col)
        (!= Col C))))

  (RULE_OR_DET &period "The lattice's period on each axis."
    (&hole *C)
    (&shifts.fundamental_period (:key C) *A *K))

  ;; The classes of the lattice.
  (INIT &lattice Wallpaper
    (grid (P)
      (input *P))
    (period (A K)
      (&period *A *K))))

(INPUT blanked-patches "some cells are blanked, each with &hole_color. The blanked cells form one or more patches. &hole_color occurs nowhere in the pattern.")

(INPUT each-class-seen "for each blanked cell, some cell a whole number of periods away from it on each axis is not blanked.")

(OUTPUT restore-pattern "the output is the input with each blanked cell given the color that the unblanked cells of its class under the periods hold."

  (RULE &corner_cell
    (input (:P *Q))
    (diag_dir_elem (:D *Dg))
    (axis_elem *A)
    (corner_dir (:C Dg) A (:D *D1_m1))
    (perp A (:A2 *A2_m3))
    (corner_dir (:C Dg) (:A A2_m3) (:D *D2_m2))
    (margin (:B Q) (:D D1_m1) (:K *K1))
    (margin (:B Q) (:D D2_m2) (:K *K2)))

  (RULE &tile_cand
    (&corner_cell *Dg *A *K1 *K2 (:Q *T))
    (> K1 0)
    (> K2 0))

  (RULE &tile_place
    (&tile_cand *Dg *A *T *K1 *K2)
    (&corner_cell Dg A (:K1 *T1) (:K2 *T2) (:Q *P))
    (divide (:T T1) (:Side K1) (:Gap 0) (:Remainder *R1))
    (divide (:T T2) (:Side K2) (:Gap 0) (:Remainder *R2))
    (&corner_cell Dg A (:K1 R1) (:K2 R2) *Q))

  (INIT &tile_mode_count Cardinality
    (key ((&tile_place ^Dg ^T *P ^Q)
          (input P ^Col))
      (member ((:m P))
        (&tile_place Dg T *P Q)
        (input P Col))))

  (RULE &aperiodic
    (axis_elem *A)
    (NOT (&period A)))

  (RULE &broken
    (&aperiodic))

  (RULE &intact
    (&hole *C)
    (input *P *Col)
    (!= Col C))

  (INIT &tile_mode Order
    (key ((&tile_mode_count.size (:key ^Dg ^T ^Q *Col)))
      (member ((:t Col))
        (&tile_mode_count.size (:key Dg T Q *Col)))
      (score ((:t Col) (:S N))
        (&tile_mode_count.size (:key Dg T Q *Col) *N))))

  (RULE &tile_vote
    (&tile_mode.maximal (:key *Dg *T *Q) (:t *Col))
    (&tile_place Dg T *P Q)
    (input P (:Col *Col2)))

  ;; The commonest color of a class against the class's other cells.
  (INIT &tile_major Excess
    (key ((OR ((&tile_vote (:Dg ^K_dg) (:T ^K_t) (:Q ^K_q) ^Col *P (:Col2 Col)))
              ((&tile_vote (:Dg K_dg) (:T K_t) (:Q K_q) Col P *Col2)
               (!= Col2 Col))))
      (plus ((:m P))
        (&tile_vote (:Dg K_dg) (:T K_t) (:Q K_q) Col *P (:Col2 Col)))
      (minus ((:m P))
        (&tile_vote (:Dg K_dg) (:T K_t) (:Q K_q) Col *P *Col2)
        (!= Col2 Col))))

  (RULE &major_class
    (&tile_major.excess (:key (:K_dg *Dg) (:K_t *T) (:K_q *Q))))

  (INIT &tile_area Cardinality
    (key ((&tile_place ^Dg ^T *Q))
      (member ((:m Q))
        (&tile_place Dg T *Q))))

  (INIT &least_tile Order
    (key ((&tile_area.size (:key ^Dg *T) *N)
          (ALL ((&tile_place Dg T *Q))
               ((&major_class Dg T Q))))
      (member ((:t (:V T) (:S N)))
        (&tile_area.size (:key Dg *T) *N)
        (ALL ((&tile_place Dg T *Q))
             ((&major_class Dg T Q))))
      (score ((:t (:V T) (:S N)) (:S N))
        (&tile_area.size (:key Dg *T) *N)
        (ALL ((&tile_place Dg T *Q))
             ((&major_class Dg T Q))))))

  (INIT &one_tile Singleton
    (key ((&least_tile.minimal (:key ^Dg) (:t (:V *T))))
      (member ((:v T))
        (&least_tile.minimal (:t (:V *T))))))

  ;; The classes of the lattice joined under the tile's witnessed isometries.
  (INIT &mirror2 Wallpaper
    (transform ((:D T))
      (d4_compose (:A *T) (:B *U) (:C *V))
      (!= U V))
    (cell (P (:v Col))
      (&intact *P *Col))
    (grid (P)
      (input *P))
    (period (A K)
      (&period *A *K))))

(ALTS $d "how a blanked cell is known" $StoredHole
  (ALT $HoleFromPeriod
    (INPUT blanked-patches "the blanked cells have the one color whose cells, read as blank, leave the tile of least area under the period derivation of periodic-pattern; undefined where two colors tie, or where no color leaves a period on both axes"
      (RULE &blank_cand
        (input (:Col *C)))

      ;; The tile each color leaves when its cells are read as blank.
      (INIT &hole_tile Frame
        (key ((&shifts.fundamental_period (:key ^C) *A *K))
          (extent (A (:N K))
            (&shifts.fundamental_period *A *K))))

      (INIT &hole_area Cardinality
        (key ((&hole_tile.cell (:key ^C) *P))
          (member ((:m P))
            (&hole_tile.cell *P))))

      (INIT &least_hole Order
        (member ((:t (:V C) (:S N)))
          (&hole_area.size (:key *C) *N))
        (score ((:t (:V C) (:S N)) (:S N))
          (&hole_area.size (:key *C) *N)))

      (INIT &one_hole Singleton
        (member ((:v C))
          (&least_hole.minimal (:t (:V *C)))))

      (RULE &hole
        (&one_hole.value (:v *C)))))
  (ALT $ClassMode
    (INPUT blanked-patches "no cell is known to be blank")
    (OUTPUT restore-pattern "each cell takes the color that holds more than half the cells of its class, under the tile of least area at which every class has such a color; undefined where two tiles tie, or where no tile shorter than the grid gives every class such a color"
      (RULE &intact
        (input *P *Col))

      (RULE &period
        (&one_tile.value (:key *Dg) (:v *T))
        (corner_dir (:C Dg) *A (:D *D1_m2))
        (perp A (:A2 *A2_m4))
        (corner_dir (:C Dg) (:A A2_m4) (:D *D2_m3))
        (margin (:B T) (:D D1_m2) *K)
        (margin (:B T) (:D D2_m3) (:K *K2_m1))))))

(ALTS $l "which shifts relate cells" $AxisShifts
  (ALT $ObliqueLattice
    (INPUT periodic-pattern "the lattice also takes each shift shorter than the axis periods, in any direction, under which the unblanked cells agree and at least one pair of unblanked cells meets")
    (ALT $WitnessedMirror
      (ALT $StoredMirror
        (OUTPUT restore-pattern "classes also merge under &mirror; undefined where a merged class holds two colors, where &mirror does not take the grid onto itself, or where the periods differ between the axes"
          (RULE &short_step
            (&period *A *K)
            (input *P)
            (axis_of (:D *Dr) A)
            (margin (:B P) (:D Dr) (:K *K2))
            (< K2 K)
            (dir8_opposite (:D Dr) (:D2 *O_m1))
            (edge_inset (:D O_m1) (:K K2) (:B *B1_m2))
            (edge_inset (:D Dr) (:K K2) (:B *I_m4))
            (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C *V)))

          (RULE &oblique_cand
            (&short_step *A (:V *V1))
            (perp A *A2)
            (&short_step (:A A2) (:V *V2))
            (compose (:A V1) (:B V2) (:C *V))
            (!= V 0))

          (RULE &oblique_pair
            (&oblique_cand *V)
            (&intact *P *Col)
            (compose (:A P) (:B V) (:C *Q))
            (&intact (:P Q) (:Col *Col2)))

          (RULE &oblique_clash
            (&oblique_pair *V *Col *Col2)
            (!= Col Col2))

          ;; The classes of each case: the lattice's, joined by the case's further
          ;; shifts and isometries.
          (INIT &orbit Quotient
            (edge ((:a P) (:b P2))
              (OR ((&lattice.action *P (:Q *P2)))
                  ((input P)
                   (= P2 P))
                  ((&oblique_pair *V)
                   (NOT (&oblique_clash V))
                   (input P)
                   (compose (:A P) (:B V) (:C P2))
                   (input (:P P2)))
                  ((&mirror2.action P (:Q P2)))
                  ((&mirror (:D *T))
                   (input P)
                   (apply (:D T) P (:P_out P2))
                   (input (:P P2)))))))))))

(ALTS $i "which further cells join a class" $Translations
  (ALT $WitnessedMirror
    (OUTPUT restore-pattern "classes also merge under each reflection or rotation of the tile, with a shift, that some two unblanked cells it pairs witness and no two contradict"))
  (ALT $StoredMirror
    (INPUT tile-mirror "the grid is symmetric under &mirror, the reflection across its main diagonal")
    (OUTPUT restore-pattern "classes also merge under &mirror; undefined where a merged class holds two colors, where &mirror does not take the grid onto itself, or where the periods differ between the axes"
      (DET &asymmetric
        (reflection (:T *D))
        (ex_output *E *P (:Col *C))
        (apply D P (:P_out *Q))
        (NOT (ex_output E (:P Q) (:Col C))))

      (INIT &symmetric_count Cardinality
        (key ((reflection ^T))
          (member ((:m E))
            (ex_output *E)
            (NOT (&asymmetric E (:D T))))))

      ;; The reflection across a diagonal under which the most train outputs
      ;; are symmetric.
      (INIT &symmetric Order
        (member ((:t T))
          (&symmetric_count.size (:key *T)))
        (score ((:t T) (:S N))
          (&symmetric_count.size (:key *T) *N)))

      (DET &mirror
        (&symmetric.maximal (:t *D)))

      (RULE &broken
        ;; The mirror takes a cell off the grid, or the periods differ between the
        ;; axes.
        (OR ((OR ((&mirror (:D *T))
                  (input *P)
                  (apply (:D T) P (:P_out *Q))
                  (NOT (input (:P Q))))
                 ((&period *A *K)
                  (perp A *A2)
                  (&period (:A A2) (:K *K2))
                  (!= K K2))))
            ((&aperiodic)))))))

;; An unblanked cell keeps its color, and a blanked cell takes the colors the
;; unblanked cells of its class hold.
(RULE &output
  (&hole *C)
  (NOT (&broken))
  (&intact *P *Col))
