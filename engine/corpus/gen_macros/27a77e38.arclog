;; 27a77e38

(DET &stamp
  (ex_input *E *P *Col)
  (ex_output E P (:Col *Col2))
  (!= Col Col2))

(DET &field_dir
  (&stamp *P)
  (opposite *D (:Opp *D_far))
  (margin (:B P) (:D D_far) (:K 0)))

(INIT &tally_count Cardinality
  (key ((input *P ^Col)
        (&field_dir *D)
        (opposite D (:Opp *O_m1))
        (margin (:B P) D *K)
        (margin (:B P) (:D O_m1) (:K *K2))
        (< K K2))
    (member ((:m P))
      (input *P Col)
      (&field_dir *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))))

(RULE &target
  (input *P)
  (&field_dir *D)
  (opposite D (:Opp *D_far))
  (margin (:B P) (:D D_far) (:K 0))
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *D2) (:A A2_m2))
  (opposite (:D D2) (:Opp *O_m3))
  (margin (:B P) (:D D2) *K)
  (margin (:B P) (:D O_m3) K))

(ALTS $choice "the domain the count runs over; no field cell carries a ground color, so the pairs do not separate the two" $Half
  (ALT $Ink
    (DET &field_cell
      (ex_input *E *P)
      (&field_dir *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (DET &ground
      (ex_input *E *P *Col)
      (NOT (&field_cell E P)))

    (INIT &tally_count Cardinality
      (key ((input *P ^Col)
            (NOT (&ground Col)))
        (member ((:m P))
          (input *P Col)
          (NOT (&ground Col)))))))

(INIT &tally Order
  (member ((:t Col))
    (&tally_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&tally_count.size (:key *Col) *N)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&target P)))
      ((&target P)
       (&tally.maximal (:t Col)))))
