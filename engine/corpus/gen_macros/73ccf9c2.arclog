;; 73ccf9c2

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(DET &sym D4Domain)

(RULE &object
  (&objs_component *P *Id))

(INIT &bbox BoundingBox
  (key ((&object ^Id *P))
    (cell (P)
      (&object Id *P))))

(RULE &figure
  (&object *Id *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&object (:Id *Idm) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (input P *Col))

(INIT &inv Agreement
  (key ((&figure ^Id (:P_inner *P) *Col))
    (source ((:i P) (:v Col))
      (&figure Id (:P_inner *P) *Col))
    (target ((:i P) (:v Col))
      (&figure Id (:P_inner *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&figure Id (:P_inner *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(RULE &output
  (&sym (:D *F))
  (&inv.mismatch (:key *Id) (:m F))
  (&bbox.box (:key Id) *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
