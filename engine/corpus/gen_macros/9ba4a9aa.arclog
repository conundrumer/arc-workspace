;; 9ba4a9aa

(INPUT ground "the commonest color is the background")

(INPUT squares "the ink holds 3×3 squares; a square is framed when a uniform border surrounds a center of another color, and one square, the source, is not framed"

  (INIT &ground_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &ground Order
    (member ((:t Col))
      (&ground_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&ground_count.size (:key *Col) *N)))

  (RULE &ink
    (input *P *Col)
    (NOT (&ground.maximal (:t Col))))

  (INIT &rim Boundary
    (cell (P)
      (&ink *P))
    (dir (D)
      (dir8_elem *D)))

  (RULE &center
    (&ink (:P *C))
    (NOT (&rim.boundary (:P C))))

  (RULE &border
    (&center *C)
    (dir8_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A C) (:B V_m1) (:C *P)))

  (RULE &square_cell
    (&center *C)
    (OR ((&border C *P))
        ((= P C))))

  (INIT &square BoundingBox
    (key ((&square_cell ^C *P))
      (cell (P)
        (&square_cell C *P)))))

(INPUT trails "the ink outside the squares is dots; dots of one color, one spacing apart along a row or column, chain into a trail, and a trail ends beside a square"

  ;; Distance from a trail dot to the next.
  (DET &spacing TileCount)

  (RULE &trail_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((&spacing (:N *K))
         (dir_elem (:D *D2))
         (dir8_opposite (:D D2) (:D2 *O_m1))
         (edge_inset (:D O_m1) K (:B *B1_m2))
         (edge_inset (:D D2) K (:B *I_m4))
         (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C Delta)))))

  (INIT &frame Singleton
    (key ((&border ^C *P)
          (input P *Col))
      (member ((:v Col))
        (&border C *P)
        (input P *Col))))

  (RULE &framed
    (&frame.value (:key *C) (:v *Col))
    (input (:P C) (:Col *Col2))
    (!= Col Col2))

  (RULE &source
    (&center *C)
    (NOT (&framed C)))

  (RULE &dot
    (&ink *P *Col)
    (NOT (&square_cell P)))

  (RULE &beside
    (&dot *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&square_cell *C (:P Q)))

  ;; The trail leaving the source: dots of one color, one spacing apart, reached
  ;; from the dot beside the source. The lib's unit steps stay in the set; dots
  ;; are never adjacent, so they never fire.
  (INIT &trail Propagation
    (key ((OR ((&source *C)
               (&beside *P C)
               (&dot P ^Col))
              ((&dot P Col)
               (&trail_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&dot (:P P2) Col))))
      (source ((:n P))
        (&source *C)
        (&beside *P C)
        (&dot P Col))
      (edge ((:a P) (:b P2))
        (&dot *P Col)
        (&trail_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&dot (:P P2) Col)))))

(OUTPUT pick "the output is the framed square that the trail leaving the source reaches")

(ALTS $choice "what makes a dot part of the source's trail" $Chain
  (ALT $Hue
    (INPUT trails "the ink outside the squares is dots, and the dots of one color form a trail"
      (RULE &lead_color
        (&source *C)
        (&beside *P C)
        (&dot P *Col)))
    (RULE &target
      (&framed *C)
      (&beside *P C)
      (&dot P *Col)
      (&lead_color Col))))

(RULE &target
  (&framed *C)
  (&beside *P C)
  (&trail.reached (:n P)))

(RULE &output
  (&target *C)
  (&square.box (:key C) *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (&square.box (:key (:C *Cm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
