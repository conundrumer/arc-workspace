;; 33067df9

(DET &bg DominantColor)

;; Lattice widths.
(DET &in_line TileDim)

(RULE &tile_col_division_cell_uniform_inset1
  (&in_line (:D *G_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K G_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K G_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K G_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K G_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(RULE &tile_col_division_cell
  (input (:P *P_grid_in))
  (&in_line (:D *Key))
  (&tile_col_division_cell_uniform_inset1 (:G_ Key) (:B_ *B))
  (ALL ((&in_line (:D *Gm))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K Gm) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K Gm) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K Gm) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K Gm) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C B))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid_in) (:X_rel *P)))

(DET &in_tile TileDim)

(RULE &tile_col_division_side
  (axis_elem *A)
  (&in_line (:D *Key))
  (&in_tile (:D *K)))

(RULE &tile_col_division_gap_held
  (axis_elem *A)
  (&in_line (:D *G)))

(RULE &tile_col_division_axis_split1
  (&tile_col_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &tile_col_division_axis
  (OR ((&tile_col_division_cell *Key *P)
       (&tile_col_division_side Key *A *K)
       (axis_elem A)
       (&in_line (:D Key))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap Key) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap Key) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&tile_col_division_cell Key P)
       (&tile_col_division_side Key A (:K *K2))
       (NOT (&tile_col_division_gap_held (:G Key) A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((&tile_col_division_cell Key P)
       (axis_elem A)
       (NOT (&tile_col_division_side Key A))
       (&tile_col_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_col_division_tile
  (&tile_col_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_col_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile_col_uniform_inset1
  (&tile_col_division_tile (:Key *G_) (:P *P_field) (:P_outer *P_tile))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K G_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K G_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K G_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K G_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(RULE &tile_col
  (input (:P *P_grid_in) *Col)
  (&tile_col_division_tile (:Key *G) (:P *P_field) (:P_outer *P_tile))
  (&tile_col_uniform_inset1 (:G_ G) (:B_ *B))
  (ALL ((input (:P P_grid_in) (:Col *Colm))
        (&tile_col_division_tile (:Key *Gm) (:P *P_fieldm) (:P_outer *P_tilem))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K Gm) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K Gm) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K Gm) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K Gm) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C B))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid_in) (:X_rel P_field)))

(RULE &ink
  (&tile_col *P_tile *Col)
  (NOT (&bg (:C Col))))

(DET &run_axis AxisDomain)

(RULE &run_dir
  (&ink (:Col *Key))
  (&run_axis *A)
  (axis_of *D A))

(RULE &run_node
  (&ink (:P_tile *P) (:Col *Key)))

(RULE &run_source
  (&ink (:P_tile *P) (:Col *Key)))

;; Like tiles neighboring along the run axis make a run.
(INIT &run Distance
  (key ((&run_source (:Key ^Ky) (:P ^O))
        (&run_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_node (:Key Ky) (:P Q)))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&run_source (:Key Ky) (:P O))
      (&run_dir (:Key Ky) D))))

(RULE &run_ray
  (&run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &run_end
  (&run_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray Key (:P Q) D Origin)))

(RULE &run_reach
  (&ink *P_tile *Col)
  (&run_end (:Key Col) (:P *E_tile) *D (:Origin P_tile))
  (margin (:B E_tile) D *K))

(RULE &span_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&run_reach (:P_tile *Key) D *K)
  (&run_reach (:P_tile Key) (:D D2) (:K *K2))
  (opposite D (:Opp *O_m1))
  (edge_inset D K (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B)))

(RULE &span
  (&span_axis *Key *A (:B *B1))
  (perp A *A2)
  (&span_axis Key (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(DET &canvas_side ConstOutDim)

(INIT &canvas Frame
  (extent (A N)
    (axis_elem *A)
    (&canvas_side *N)))

(DET &out_line TileCount)

(RULE &out_field_uniform_inset1
  (&out_line (:N *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(RULE &out_field
  (&canvas.cell (:P *P_grid_out))
  (&out_line (:N *K))
  (&out_field_uniform_inset1 (:K_ K) (:B_ *B))
  (ALL ((&out_line (:N *Km))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C B))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_out) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid_out) (:X_rel *P_field)))

;; The canvas holds as many tiles as the input does, so its field fixes how
;; large they come out.
(INIT &out_cells_sides ExtentDivisions
  (frame ((:P P_field))
    (&out_field *P_field)))

(RULE &out_cells_gap
  (&tile_col *P_tile)
  (axis_elem *A)
  (frame_extent (:P P_tile) A *N)
  (&out_line (:N *G)))

(RULE &out_cells_axis_split1
  (&out_field (:P_field *P_field_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_field_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_field_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_field_) (:X_rel *X_m1_)))

(RULE &out_cells_parts
  (&tile_col *P_tile)
  (axis_elem *A)
  (frame_extent (:P P_tile) A *N))

(RULE &out_cells_axis
  (OR ((&out_field (:P_field *P))
       (&tile_col *P_tile)
       (axis_elem *A)
       (frame_extent (:P P_tile) A *N)
       (&tile_col (:P_tile *P_tile2))
       (frame_extent (:P P_tile2) A (:N *N2))
       (&out_line (:N *G))
       (&out_cells_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&out_field (:P_field P))
       (&tile_col (:P_tile *P_tile3))
       (axis_elem A)
       (frame_extent (:P P_tile3) A (:N *N3))
       (&tile_col (:P_tile *P_tile22))
       (frame_extent (:P P_tile22) A (:N *N22))
       (&out_line (:N *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N3)))
      ((&out_field (:P_field P))
       (&tile_col (:P_tile *P_tile4))
       (axis_elem A)
       (frame_extent (:P P_tile4) A (:N *N4))
       (NOT (&out_cells_gap A))
       (&out_cells_sides.division A (:N N4) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&out_field (:P_field P))
       (&tile_col (:P_tile *P_tile5))
       (axis_elem A)
       (frame_extent (:P P_tile5) A (:N *N5))
       (NOT (&out_cells_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N5)))
      ((&out_field (:P_field P))
       (axis_elem A)
       (NOT (&out_cells_parts A))
       (&out_cells_axis_split1 (:P_field_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &out_cells_tile
  (&out_cells_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&out_cells_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &join
  (&ink *P_tile *Col)
  (&ink (:P_tile *Q_tile) Col)
  (&run_axis *A)
  (OR ((axis_of *D A)
       (step_offset D (:V *V_m1))
       (compose (:A P_tile) (:B V_m1) (:C Q_tile)))
      ((perp A *A2)
       (axis_of (:D *D_across) (:A A2))
       (step_offset (:D D_across) (:V *V_m2))
       (compose (:A P_tile) (:B V_m2) (:C Q_tile))
       (&span_axis (:Key P_tile) A (:B *P_span))
       (&span_axis (:Key Q_tile) A (:B P_span)))))

;; A group is what the joins connect.
(INIT &group Quotient
  (edge ((:a P_tile) (:b B))
    (OR ((&join *P_tile (:Q_tile *B)))
        ((&ink P_tile)
         (= B P_tile)))))

(INIT &group_box BoundingBox
  (key ((&group.class (:a *P_tile) ^Id)
        (&out_field *P_grid_out *P_field)
        (&out_cells_tile (:P P_field) (:P_outer P_tile)))
    (cell ((:P P_grid_out))
      (&group.class (:a *P_tile) Id)
      (&out_field *P_grid_out *P_field)
      (&out_cells_tile (:P P_field) (:P_outer P_tile)))))

(RULE &paint
  (&group_box.box (:key *Id) *B)
  (&canvas.cell (:P *P_grid_out))
  (ALL ((&group_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_out) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (&group.class (:a *P_tile) Id)
  (&ink P_tile *Col))

(RULE &output
  (&canvas.cell *P)
  (OR ((&paint (:P_grid_out P) *Col))
      ((NOT (&paint (:P_grid_out P)))
       (&bg (:C Col)))))
