;; 8731374e

(INIT &drect Outlines
  (key ((input *P ^Col))
    (node (P)
      (input *P Col))))

(RULE &covered
  (&drect.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(INIT &biggest_count Cardinality
  (key ((&covered ^B *P))
    (member ((:m P))
      (&covered B *P))))

;; The block: the rectangle covering the most cells.
(INIT &biggest Order
  (member ((:t B))
    (&biggest_count.size (:key *B)))
  (score ((:t B) (:S N))
    (&biggest_count.size (:key *B) *N)))

(RULE &block
  (&biggest.maximal (:t *B))
  (&drect.box (:key *Col) B))

(RULE &view
  (&block *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &flaw
  (&view (:P *P2) (:P_inner *P))
  (input (:P P2) *Col)
  (NOT (&block Col)))

(RULE &flaw_line
  (&view (:P_inner *P))
  (&flaw (:P *Q) *Col)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &output
  (&view (:P_inner *P))
  (OR ((&flaw_line P *Col))
      ((NOT (&flaw_line P))
       (&block Col))))
