;; 4e7e0eb9

(DET &bg DominantColor)

(DET &item_split1
  (ex_input *E (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

;; The color a grid line holds, when it holds just one.
(INIT &line_col Singleton
  (key ((ex_input ^E *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (ex_input E *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(DET &parts_divider
  (&line_col.value (:key (:E *Key) *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(DET &parts_on_divider
  (ex_input (:E *Key) *P)
  (&parts_divider Key *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The separator lines cut the grid into parts.
(INIT &parts_rank Order
  (key ((OR ((&parts_divider (:Key ^Ky) *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((ex_input (:E Ky) *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&parts_divider (:Key Ky) *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&parts_divider (:Key Ky) *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((ex_input (:E Ky) *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (ex_input (:E Ky) *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(DET &parts_part_idx
  (ex_input (:E *Key) *P)
  (axis_of *D *A)
  (NOT (&parts_on_divider Key P A))
  (margin (:B P) D *K)
  (&parts_rank.rank (:key (:Ky Key) D) (:t K) (:R *N)))

(DET &parts_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&parts_part_idx *Key *P D (:N *N1))
  (&parts_part_idx Key P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(DET &parts_tile_of
  (&parts_part_of *Key *P *A (:P_part *P1))
  (perp A *A2)
  (&parts_part_of Key P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; The border between a section's edge and its field.
(DET &margin DivisorRatio)

(RULE &field_cell_uniform_inset1
  (&margin (:K *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(INIT &part_box BoundingBox
  (key ((&parts_tile_of (:Key ^E) *P (:P_tile ^P_part)))
    (cell (P)
      (&parts_tile_of (:Key E) *P (:P_tile P_part)))))

(DET &section
  (&part_box.cell (:key (:E *Ky_e) (:P_part *Ky_p_part)) *P)
  (&part_box.box (:key (:E Ky_e) (:P_part Ky_p_part)) *B)
  (perp *A *A2)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K))
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N K)))

(DET &sep DivisorRatio)

(RULE &section_cell_division_gap
  (axis_elem *A)
  (&sep (:K *G)))

(RULE &section_cell_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &section_cell_division_side
  (axis_elem *A)
  (&section *K))

(RULE &section_cell_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&section (:K *N))
       (&sep (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side N) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side N) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A N))
      ((input P)
       (axis_elem A)
       (&section (:K *N2))
       (NOT (&section_cell_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side N2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side N2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N N2)))
      ((input P)
       (axis_elem A)
       (NOT (&section_cell_division_side A))
       (&section_cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &section_cell_division_tile
  (&section_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&section_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &section_cell
  (&section_cell_division_tile (:P *P_grid) (:P_outer *P_sec) (:P_inner *P_insec)))

(RULE &field_cell
  (&section_cell *P_grid *P_sec *P_insec)
  (&margin *K)
  (&field_cell_uniform_inset1 (:K_ K) (:B_ *B))
  (ALL ((&section_cell (:P_grid *P_gridm) (:P_sec *P_secm) P_insec)
        (&margin (:K *Km))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C B))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_insec) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_insec) (:X_rel *P_field)))

(RULE &quad_nearer
  (&field_cell (:P_field *P))
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &quad_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&quad_nearer *P (:D D1))
  (&quad_nearer P (:D D2)))

(DET &blank ChangedColor)

(RULE &block_cell
  (&field_cell *P_grid *P_sec *P_field)
  (&quad_quadrant (:P P_field) (:Diag *Blk)))

(RULE &block_col
  (&block_cell *P_grid *P_sec *Blk)
  (input (:P P_grid) *Col))

(RULE &mid_cell
  (&field_cell *P_grid *P_sec *P_field)
  (opposite *D (:Opp *O_m1))
  (margin (:B P_field) D *K)
  (margin (:B P_field) (:D O_m1) K)
  (axis_of D *A))

(RULE &mid_bg
  (&mid_cell *P_grid *P_sec *A)
  (input (:P P_grid) *Col)
  (&bg (:C Col)))

;; No bg cell on the line.
(RULE &divider
  (&section_cell *P_sec)
  (axis_elem *A)
  (NOT (&mid_bg P_sec A)))

;; The one color the blocks other than &blank carry.
(INIT &unblank Singleton
  (key ((&block_col ^P_sec *Col)
        (NOT (&blank (:C Col))))
    (member ((:v Col))
      (&block_col P_sec *Col)
      (NOT (&blank (:C Col))))))

(RULE &fill
  (&unblank.value (:key *P_sec) (:v *Col)))

(ALTS $i "which halving lines are dividers" $Whole
  (ALT $Any
    ;; An inked cell on the line, away from where the two lines cross. The
    ;; crossing cell lies on both lines, so it tells neither of them apart.
    (RULE &divider
      (&mid_cell *P_grid *P_sec *P_field *A)
      (opposite (:D *D_m1) (:Opp *O_m2))
      (margin (:B P_field) (:D D_m1) (:K *K1_m3))
      (margin (:B P_field) (:D O_m2) (:K *K2_m4))
      (!= K1_m3 K2_m4)
      (input (:P P_grid) *Col)
      (NOT (&bg (:C Col))))))

(ALTS $f "the color an undivided section takes" $Blank
  (ALT $Rarest
    (INIT &block_tally Cardinality
      (key ((&block_col ^P_sec *Blk ^Col))
        (member ((:m Blk))
          (&block_col P_sec *Blk Col))))

    (INIT &rarest Order
      (key ((&block_tally.size (:key ^P_sec *Col) *N))
        (member ((:t (:V Col) (:S N)))
          (&block_tally.size (:key P_sec *Col) *N))
        (score ((:t (:V Col) (:S N)) (:S N))
          (&block_tally.size (:key P_sec *Col) *N))))

    (RULE &fill
      (&rarest.minimal (:key *P_sec) (:t (:V *Col))))))

(RULE &divided
  (&divider *P_sec))

(RULE &side_img
  (&section_cell *P_sec)
  (axis_of *D *A)
  (IF ((&divider P_sec A))
      ((opposite D (:Opp *D_img)))
      ((= D_img D))))

(RULE &block_img
  (corner_dir (:C *Blk) *A (:D *D1))
  (perp A (:A2 *A2_m1))
  (corner_dir (:C Blk) (:A A2_m1) (:D *D2))
  (&side_img *P_sec (:D D1) (:D_img *E1))
  (&side_img P_sec (:D D2) (:D_img *E2))
  (corner_dir (:C *Img) A (:D E1))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Img) (:A A2_m2) (:D E2)))

(RULE &output
  (OR ((&block_cell (:P_grid *P) *P_sec *Blk)
       (&divided P_sec)
       (&block_img P_sec Blk *Img)
       (&block_col P_sec (:Blk Img) *Col))
      ((&block_cell (:P_grid P) (:P_sec *P_sec2))
       (NOT (&divided (:P_sec P_sec2)))
       (&fill (:P_sec P_sec2) Col))
      ((input P Col)
       (NOT (&block_cell (:P_grid P))))))
