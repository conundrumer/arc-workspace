;; f0df5ff0

(DET &bg DominantColor)

(DET &ink RarestColor)

(RULE &painted
  (input *P *Col)
  (&bg (:C Col))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *P2))
  (input (:P P2) (:Col *Ink))
  (&ink (:C Ink)))

(RULE &output
  (OR ((&painted *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
