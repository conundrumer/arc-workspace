;; 1e81d6f9

(DET &target_corner DiagDirDomain)

(DET &target_offset DivisorRatio)

(DET &bg DominantColor)

(RULE &target_pos
  (input *P)
  (&target_corner (:D *Diag))
  (&target_offset *K)
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) K)
  (margin (:B P) (:D D2_m3) K))

(RULE &target_color
  (input *P (:Col *C))
  (&target_pos P))

(RULE &kept
  (&target_pos *P))

(ALTS $choice "what is kept" $Marker
  (ALT $Bbox
    (RULE &region_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (DET &mask_color UnchangedColor)

    (RULE &mask
      (input *P (:Col *MaskCol))
      (&mask_color (:C MaskCol)))

    ;; The mask region at the corner: the component touching the corner's two edges,
    ;; so a stray mask cell elsewhere stays out.
    (INIT &region Propagation
      (source ((:n P))
        (&mask *P)
        (&target_corner (:D *Diag))
        (corner_dir (:C Diag) *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a P) (:b P2))
        (&mask *P)
        (&region_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&mask (:P P2))))

    (INIT &bbox BoundingBox
      (cell (P)
        (&region.reached (:n *P))))

    (RULE &kept
      (input *P)
      (&bbox.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &output
  (input *P (:Col *Col2))
  (OR ((&target_color (:C Col2))
       (NOT (&kept P))
       (&bg (:C *Col)))
      ((NOT (&target_color (:C Col2)))
       (= Col Col2))
      ((&kept P)
       (= Col Col2))))
