;; 3bdb4ada

(RULE &rect_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &rect Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&rect_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &rect_component
  (&rect.class (:a *P) *Id))

;; The dash's period: the ink run, then the gap run.
(DET &dash DivisorRatio)

;; The axis the dash runs along.
(DET &dash_axis AxisDomain)

(DET &gap DivisorRatio)

(INIT &bbox BoundingBox
  (key ((&rect_component *P ^Id))
    (cell (P)
      (&rect_component *P Id))))

(RULE &rect_cell
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &ink_run_division_gap
  (&dash_axis *A)
  (&gap (:K *G)))

(RULE &ink_run_division_axis_split1
  (&rect_cell (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &ink_run_division_side
  (&dash_axis *A)
  (&dash *K))

(RULE &ink_run_division_axis
  (OR ((&rect_cell (:P_inner *P))
       (&dash_axis *A)
       (&dash *K)
       (&gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&rect_cell (:P_inner P))
       (&dash_axis A)
       (&dash (:K *K2))
       (NOT (&ink_run_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((&rect_cell (:P_inner P))
       (axis_elem A)
       (NOT (&ink_run_division_side A))
       (&ink_run_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &ink_run_division_tile
  (&ink_run_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&ink_run_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &ink_run
  (&rect_cell *P *P_inner)
  (&ink_run_division_tile (:P P_inner)))

(RULE &dash_cover
  (&rect_cell *P *P_inner)
  (&dash_axis *A)
  (perp A *A2)
  (axis_of *D (:A A2))
  (opposite D (:Opp *O_m1))
  (margin (:B P_inner) D *K)
  (margin (:B P_inner) (:D O_m1) K))

(ALTS $choice "which cells the dash covers" $Midline
  (ALT $Interior
    (INIT &rim Boundary
      (key ((&rect_component *P ^Id))
        (cell (P)
          (&rect_component *P Id))))

    (RULE &dash_cover
      (&rect_component *P *Id)
      (NOT (&rim.boundary (:key Id) P)))))

(RULE &erased
  (&dash_cover *P)
  (NOT (&ink_run P)))

(RULE &output
  (OR ((&erased *P)
       (&bg (:C *Col)))
      ((input P Col)
       (NOT (&erased P)))))
