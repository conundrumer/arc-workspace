;; 2753e76c

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &blocks_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &blocks Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&blocks_node (:Key *Ky) *P)
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&blocks_node (:Key Ky) (:P P2)))
        ((&blocks_node (:Key Ky) P)
         (= P2 P)))))

(RULE &blocks_component
  (&blocks.class (:a *Key *P) *Id))

;; The chart corner: the top-ranked row lies against it, and every bar grows from it.
(DET &corner DiagDirDomain)

;; The axis the rows stack along; the bars run across it.
(DET &rank_axis AxisDomain)

(INIT &rects Cardinality
  (key ((&blocks_component (:Key ^Col) *Id))
    (member ((:m Id))
      (&blocks_component (:Key Col) *Id))))

;; Rows descend by count: the color with the most rectangles ranks 0.
(INIT &order Order
  (member ((:t N))
    (&rects.size *N))
  (score ((:t N) (:S N))
    (&rects.size *N)))

;; The chart: one row per color, as wide as the longest bar.
(INIT &colors Cardinality
  (member ((:m Col))
    (&rects.size (:key *Col))))

(INIT &chart Frame
  (extent (A N)
    (OR ((&rank_axis *A)
         (&colors.size *N))
        ((&rank_axis (:A *A3))
         (perp (:A A3) (:A2 A))
         (&order.dual_rank (:t N) (:R 0))))))

(RULE &bar
  (&chart.cell *P)
  (&corner (:D *Diag))
  (&rank_axis *A)
  (corner_dir (:C Diag) A (:D *D_rank))
  (perp A (:A2 *A2_m1))
  (corner_dir (:C Diag) (:A A2_m1) (:D *D_bar))
  (&rects.size (:key *Col) *N)
  (&order.dual_rank (:t N) *R)
  (margin (:B P) (:D D_rank) (:K R))
  (margin (:B P) (:D D_bar) *K)
  (< K N))

(RULE &output
  (&chart.cell *P)
  (OR ((&bar P *Col))
      ((NOT (&bar P))
       (&bg (:C Col)))))
