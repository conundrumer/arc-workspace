;; 37d3e8b2

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &objs_node
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &objs Quotient
  (edge ((:a P) (:b P2))
    (OR ((&objs_node *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:P P2)))
        ((&objs_node P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(RULE &off_ink_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &off_ink_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(RULE &off_ink_cell
  (&bg_cell *P))

(INIT &off_ink_flood Propagation
  (source ((:n P))
    (&off_ink_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (&bg_cell P))
  (edge ((:a P) (:b P2))
    (&bg_cell *P)
    (&off_ink_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&bg_cell (:P P2))))

(RULE &off_ink_node
  (&off_ink_cell *P)
  (NOT (&off_ink_flood.reached (:n P))))

;; The background, with all ink solid.
(INIT &off_ink Quotient
  (edge ((:a P) (:b P2))
    (OR ((&off_ink_node *P)
         (&off_ink_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&off_ink_node (:P P2)))
        ((&off_ink_node P)
         (= P2 P)))))

(RULE &off_ink_component
  (&off_ink.class (:a *P) *Id))

;; A closed region counts for every object it touches.
(INIT &joint_holes Cardinality
  (key ((&off_ink_component *P *Id)
        (dir_elem *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (&objs_component (:P Q) (:Id ^O)))
    (member ((:m Id))
      (&off_ink_component *P *Id)
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&objs_component (:P Q) (:Id O)))))

(DET &joint_count_color
  (&objs_component *E *P (:Id *O))
  (&joint_holes.size E (:key O) *N)
  (ex_output E P *Col))

(ALTS $choice "what a hole is" $Joint
  (ALT $Own
    (RULE &off_obj_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &off_obj_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &off_obj_cell
      (input *P)
      (&objs_component (:Id *Key))
      (NOT (&objs_component P (:Id Key))))

    (INIT &off_obj_flood Propagation
      (key ((&objs_component (:Id ^O)))
        (source ((:n P))
          (&off_obj_cell (:Key O) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (input P)
          (NOT (&objs_component P (:Id O))))
        (edge ((:a P) (:b P2))
          (input *P)
          (NOT (&objs_component P (:Id O)))
          (&off_obj_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *P2))
          (input (:P P2))
          (NOT (&objs_component (:P P2) (:Id O))))))

    (RULE &off_obj_node
      (&off_obj_cell *Key *P)
      (NOT (&off_obj_flood.reached (:key (:O Key)) (:n P))))

    ;; The cells left when only O is solid — other objects among them.
    (INIT &off_obj Quotient
      (edge ((:a (:O Ky) P) (:b (:O Ky) (:P P2)))
        (OR ((&off_obj_node (:Key *Ky) *P)
             (&off_obj_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&off_obj_node (:Key Ky) (:P P2)))
            ((&off_obj_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &off_obj_component
      (&off_obj.class (:a (:O *Key) *P) *Id))

    (INIT &own_holes Cardinality
      (key ((&off_obj_component (:Key ^O) *Id))
        (member ((:m Id))
          (&off_obj_component (:Key O) *Id))))

    (DET &own_count_color
      (&objs_component *E *P (:Id *O))
      (&own_holes.size E (:key O) *N)
      (ex_output E P *Col))

    (RULE &output
      (OR ((&objs_component *P (:Id *O))
           (&own_holes.size (:key O) *N)
           (&own_count_color N *Col))
          ((input P Col)
           (&bg (:C Col))))))
  (ALT $Box
    (RULE &box_regions_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    ;; Each object's own extent.
    (INIT &bbox BoundingBox
      (key ((&objs_component *P (:Id ^O)))
        (cell (P)
          (&objs_component *P (:Id O)))))

    ;; The background inside that extent.
    (INIT &box_regions Quotient
      (edge ((:a O P) (:b O (:P P3)))
        (OR ((&bbox.box (:key *O) *B)
             (&bg_cell *P)
             (ALL ((&bg_cell P)
                   (&bbox.box (:key (:O *Om)) B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X P) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (&box_regions_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&bbox.box (:key O) (:B *B2))
             (&bg_cell (:P P3))
             (ALL ((&bg_cell (:P P3))
                   (&bbox.box (:key (:O *Omm)) (:B B2))
                   (dir_elem (:D *D_m1m))
                   (relative (:Base B2) (:X P3) (:X_rel *R_m2m))
                   (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                  ((>= K_m3m 0))))
            ((&bbox.box (:key O) (:B *B3))
             (&bg_cell P)
             (ALL ((&bg_cell P)
                   (&bbox.box (:key (:O *Om2)) (:B B3))
                   (dir_elem (:D *D_m12))
                   (relative (:Base B3) (:X P) (:X_rel *R_m22))
                   (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                  ((>= K_m32 0)))
             (= P3 P)))))

    (RULE &box_regions_component
      (&box_regions.class (:a (:O *Key) *P) *Id))

    (INIT &box_holes Cardinality
      (key ((&box_regions_component (:Key ^O) *Id))
        (member ((:m Id))
          (&box_regions_component (:Key O) *Id))))

    (DET &box_count_color
      (&objs_component *E *P (:Id *O))
      (&box_holes.size E (:key O) *N)
      (ex_output E P *Col))

    (RULE &output
      (OR ((&objs_component *P (:Id *O))
           (&box_holes.size (:key O) *N)
           (&box_count_color N *Col))
          ((input P Col)
           (&bg (:C Col)))))))

(RULE &output
  (OR ((input *P *Col)
       (&bg (:C Col)))
      ((&objs_component P (:Id *O))
       (&joint_holes.size (:key O) *N)
       (&joint_count_color N Col))))
