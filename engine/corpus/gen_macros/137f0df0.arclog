;; 137f0df0

(DET &bg DominantColor)

;; A block-free line where it crosses the field's box...
(DET &inside_paint AnyOutNewColor)

;; ...and where it runs beyond.
(DET &outside_paint AnyOutNewColor)

(RULE &block
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bx BoundingBox
  (cell (P)
    (&block *P)))

(RULE &covered
  (&bx.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &block_line
  (input *P)
  (axis_elem *A)
  (&block (:P *Q))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &gap_cell
  (input *P)
  (axis_elem *A)
  (NOT (&block_line A P))
  (&covered (:P *Q))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &output
  (OR ((&gap_cell *P)
       (IF ((&covered P))
           ((&inside_paint (:C *Col)))
           ((&outside_paint (:C Col)))))
      ((input P Col)
       (NOT (&gap_cell P)))))
