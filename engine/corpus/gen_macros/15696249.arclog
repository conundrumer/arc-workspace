;; 15696249

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(RULE &gate_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg AnyOutNewColor)

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ ^P_across)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))))

(RULE &gate
  (input *P)
  (axis_elem *A)
  (&gate_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across))
  (NOT (&line_color.plural (:key A P_across))))

(ALTS $choice "two models of the gate; they coincide while that color stays on its line, and diverge on a stray cell of it" $Line
  (ALT $Color
    (RULE &gate
      (input *P *Col)
      (&line_color.value (:v Col)))))

(RULE &output
  (&output_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) *P)
  (input (:P P_intile) (:Col *Col_in))
  (OR ((NOT (&gate (:P P_tile)))
       (&bg (:C *Col)))
      ((&gate (:P P_tile))
       (= Col Col_in))))
