;; 4cd1b7b2

(DET &bg ChangedColor)

;; The colors a line holds, one each.
(DET &palette UnchangedColor)

(RULE &cell_cand
  (input *P (:Col *C_in))
  (OR ((&bg (:C C_in))
       (&palette (:C *Col)))
      ((NOT (&bg (:C C_in)))
       (= Col C_in))))

;; Each cell takes one candidate; elimination settles which.
(CHOOSE &fill
  (for ((&cell_cand ^P))
    (from (&cell_cand P *Col)))
  (never
    (&cell_cand *P *Col)
    (&cell_cand (:P *P2) Col)
    (!= P P2)
    (axis_elem *A)
    (same_line A P (:Q P2))))

(RULE &output
  (&fill *P *Col))
