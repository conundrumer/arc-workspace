;; b7f8a4d8

(INPUT tile-lattice "on a field of &bg, a lattice of equal square tiles at one period on both axes, each a frame 1 cell thick of one frame color around a solid interior of one color; the tiles at the right and bottom edges may be cut off"

  (DET &bg SharedColor))

(INPUT common-interior "one interior color, the commonest, fills most tiles")

(INPUT odd-rectangle "the tiles of each other interior color sit at the four corners of a rectangle of tiles: two tile rows by two tile columns")

(OUTPUT bridge-odd-tiles "for each interior color other than the common one, between two tiles of that color in one tile row or one tile column, each &bg cell in line with their interiors becomes that color; the tiles between them stay as they are"

  (RULE &core_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &ground
    (input *P *Col)
    (&bg (:C Col)))

  (RULE &core_node
    (input *P (:Col *Key))
    (NOT (&bg (:C Key)))
    (ALL ((input (:P *Pm) (:Col Key))
          (step_offset (:D *D_m1) (:V *V_m2))
          (compose (:A Pm) (:B V_m2) (:C *Q))
          (&ground (:P Q)))
         ((&bg (:C Key)))))

  ;; Each tile's interior, under its own id.
  (INIT &core Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&core_node (:Key *Ky) *P)
           (&core_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&core_node (:Key Ky) (:P P2)))
          ((&core_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &core_component
    (&core.class (:a *Key *P) *Id))

  (INIT &tile_count_count Cardinality
    (key ((&core_component (:Key ^Col) (:Id *I)))
      (member ((:m I))
        (&core_component (:Key Col) (:Id *I)))))

  ;; The common interior color fills the most tiles; every other one is odd.
  (INIT &tile_count Order
    (member ((:t Col))
      (&tile_count_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&tile_count_count.size (:key *Col) *N)))

  (RULE &odd
    (&core_component (:Key *Col))
    (NOT (&tile_count.maximal (:t Col))))

  (INIT &color_box BoundingBox
    (key ((&odd ^Col))
      (cell (P)
        (input *P Col)))))

(OUTPUT keep-rest "every other cell keeps its input color"

  (RULE &bridge_dir
    (dir_elem *D))

  (RULE &cell_key
    (&odd (:Col *K)))

  (RULE &cell_ray_dir
    (&cell_key (:K *Key))
    (&bridge_dir *D))

  (RULE &cell_ray_node
    (&cell_key (:K *Key))
    (&bridge_dir *D)
    (input *P))

  (RULE &cell_ray_source
    (&cell_key (:K *Key))
    (input *P (:Col Key)))

  (INIT &cell_ray Distance
    (key ((&cell_ray_source (:Key ^Ky) (:P ^O))
          (&cell_ray_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&cell_ray_source (:Key Ky) (:P O))
             (&cell_ray_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&cell_ray_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&cell_ray_node (:Key Ky) (:P Q)))
            ((&cell_ray_source (:Key Ky) (:P O))
             (&cell_ray_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&cell_ray_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&cell_ray_source (:Key Ky) (:P O))
             (&cell_ray_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&cell_ray_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&cell_ray_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&cell_ray_source (:Key Ky) (:P O))
        (&cell_ray_dir (:Key Ky) D))))

  (RULE &cell_ray_ray
    (&cell_ray.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (RULE &odd_tile
    (&core_component (:Key *Col) (:Id *I))
    (&odd Col))

  (INIT &tile_box BoundingBox
    (key ((&core_component (:Key *Col) *P (:Id ^I))
          (&odd Col))
      (cell (P)
        (&core_component (:Key *Col) *P (:Id I))
        (&odd Col))))

  (RULE &line_pair
    (&bridge_dir *D)
    (dir_elem D)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *X) (:A A2_m2))
    (&odd_tile *I *Col)
    (&odd_tile (:I *I2) Col)
    (!= I I2)
    (&tile_box.box (:key I) (:B *B1))
    (&tile_box.box (:key (:I I2)) (:B *B2))
    (opposite (:D X) (:Opp *O_m3))
    (margin (:B B1) (:D X) (:K *K1))
    (margin (:B B1) (:D O_m3) (:K *K2))
    (opposite (:D X) (:Opp *O_m4))
    (margin (:B B2) (:D X) (:K K1))
    (margin (:B B2) (:D O_m4) (:K K2)))

  (RULE &span_tile
    ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
    (OR ((&line_pair *I *I2 *D)
         (axis4_of D *A)
         (&core_component (:Key *Col) (:P *Q1) (:Id I))
         (input *P)
         (perp A (:A2 *A2_m1))
         (axis_of (:D *D_m2) (:A A2_m1))
         (margin (:B P) (:D D_m2) (:K *K_m3))
         (margin (:B Q1) (:D D_m2) (:K K_m3))
         (dir_elem D)
         (margin (:B P) D (:K *K1_m4))
         (margin (:B Q1) D (:K *K2_m5))
         (< K1_m4 K2_m5)
         (&core_component (:Key Col) (:P *Q2) (:Id I2))
         (perp A (:A2 *A2_m6))
         (axis_of (:D *D_m7) (:A A2_m6))
         (margin (:B P) (:D D_m7) (:K *K_m8))
         (margin (:B Q2) (:D D_m7) (:K K_m8))
         (nearer D (:P Q2) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D2))
         (axis4_of (:D D2) (:A *A2))
         (&core_component (:Key Col) (:P *Q12) (:Id I))
         (input P)
         (perp (:A A2) (:A2 *A2_m12))
         (axis_of (:D *D_m22) (:A A2_m12))
         (margin (:B P) (:D D_m22) (:K *K_m32))
         (margin (:B Q12) (:D D_m22) (:K K_m32))
         (dir_elem (:D D2))
         (margin (:B P) (:D D2) (:K *K1_m42))
         (margin (:B Q12) (:D D2) (:K *K2_m52))
         (< K1_m42 K2_m52)
         (&core_component (:Key Col) (:P *Q22) (:Id I2))
         (diag_perp (:Da A2) (:Da2 *A2_m62))
         (diag_axis_of (:D *D_m72) (:Da A2_m62))
         (corner_dist P (:Diag D_m72) (:K *K_m82))
         (corner_dist (:P Q22) (:Diag D_m72) (:K K_m82))
         (nearer (:D D2) (:P Q22) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D3))
         (axis4_of (:D D3) (:A *A3))
         (&core_component (:Key Col) (:P *Q13) (:Id I))
         (input P)
         (perp (:A A3) (:A2 *A2_m13))
         (axis_of (:D *D_m23) (:A A2_m13))
         (margin (:B P) (:D D_m23) (:K *K_m33))
         (margin (:B Q13) (:D D_m23) (:K K_m33))
         (diag_dir_elem (:D D3))
         (corner_dist P (:Diag D3) (:K *K1_m43))
         (corner_dist (:P Q13) (:Diag D3) (:K *K2_m53))
         (< K1_m43 K2_m53)
         (&core_component (:Key Col) (:P *Q23) (:Id I2))
         (perp (:A A3) (:A2 *A2_m63))
         (axis_of (:D *D_m73) (:A A2_m63))
         (margin (:B P) (:D D_m73) (:K *K_m83))
         (margin (:B Q23) (:D D_m73) (:K K_m83))
         (nearer (:D D3) (:P Q23) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D4))
         (axis4_of (:D D4) (:A *A4))
         (&core_component (:Key Col) (:P *Q14) (:Id I))
         (input P)
         (perp (:A A4) (:A2 *A2_m14))
         (axis_of (:D *D_m24) (:A A2_m14))
         (margin (:B P) (:D D_m24) (:K *K_m34))
         (margin (:B Q14) (:D D_m24) (:K K_m34))
         (diag_dir_elem (:D D4))
         (corner_dist P (:Diag D4) (:K *K1_m44))
         (corner_dist (:P Q14) (:Diag D4) (:K *K2_m54))
         (< K1_m44 K2_m54)
         (&core_component (:Key Col) (:P *Q24) (:Id I2))
         (diag_perp (:Da A4) (:Da2 *A2_m64))
         (diag_axis_of (:D *D_m74) (:Da A2_m64))
         (corner_dist P (:Diag D_m74) (:K *K_m84))
         (corner_dist (:P Q24) (:Diag D_m74) (:K K_m84))
         (nearer (:D D4) (:P Q24) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D5))
         (axis4_of (:D D5) (:A *A5))
         (&core_component (:Key Col) (:P *Q15) (:Id I))
         (input P)
         (diag_perp (:Da A5) (:Da2 *A2_m15))
         (diag_axis_of (:D *D_m25) (:Da A2_m15))
         (corner_dist P (:Diag D_m25) (:K *K_m35))
         (corner_dist (:P Q15) (:Diag D_m25) (:K K_m35))
         (dir_elem (:D D5))
         (margin (:B P) (:D D5) (:K *K1_m45))
         (margin (:B Q15) (:D D5) (:K *K2_m55))
         (< K1_m45 K2_m55)
         (&core_component (:Key Col) (:P *Q25) (:Id I2))
         (perp (:A A5) (:A2 *A2_m65))
         (axis_of (:D *D_m75) (:A A2_m65))
         (margin (:B P) (:D D_m75) (:K *K_m85))
         (margin (:B Q25) (:D D_m75) (:K K_m85))
         (nearer (:D D5) (:P Q25) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D6))
         (axis4_of (:D D6) (:A *A6))
         (&core_component (:Key Col) (:P *Q16) (:Id I))
         (input P)
         (diag_perp (:Da A6) (:Da2 *A2_m16))
         (diag_axis_of (:D *D_m26) (:Da A2_m16))
         (corner_dist P (:Diag D_m26) (:K *K_m36))
         (corner_dist (:P Q16) (:Diag D_m26) (:K K_m36))
         (dir_elem (:D D6))
         (margin (:B P) (:D D6) (:K *K1_m46))
         (margin (:B Q16) (:D D6) (:K *K2_m56))
         (< K1_m46 K2_m56)
         (&core_component (:Key Col) (:P *Q26) (:Id I2))
         (diag_perp (:Da A6) (:Da2 *A2_m66))
         (diag_axis_of (:D *D_m76) (:Da A2_m66))
         (corner_dist P (:Diag D_m76) (:K *K_m86))
         (corner_dist (:P Q26) (:Diag D_m76) (:K K_m86))
         (nearer (:D D6) (:P Q26) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D7))
         (axis4_of (:D D7) (:A *A7))
         (&core_component (:Key Col) (:P *Q17) (:Id I))
         (input P)
         (diag_perp (:Da A7) (:Da2 *A2_m17))
         (diag_axis_of (:D *D_m27) (:Da A2_m17))
         (corner_dist P (:Diag D_m27) (:K *K_m37))
         (corner_dist (:P Q17) (:Diag D_m27) (:K K_m37))
         (diag_dir_elem (:D D7))
         (corner_dist P (:Diag D7) (:K *K1_m47))
         (corner_dist (:P Q17) (:Diag D7) (:K *K2_m57))
         (< K1_m47 K2_m57)
         (&core_component (:Key Col) (:P *Q27) (:Id I2))
         (perp (:A A7) (:A2 *A2_m67))
         (axis_of (:D *D_m77) (:A A2_m67))
         (margin (:B P) (:D D_m77) (:K *K_m87))
         (margin (:B Q27) (:D D_m77) (:K K_m87))
         (nearer (:D D7) (:P Q27) (:Q P)))
        ;; TODO lib-judgment: nearer: the first column's type at the site is no one member type
        ((&line_pair I I2 (:D *D8))
         (axis4_of (:D D8) (:A *A8))
         (&core_component (:Key Col) (:P *Q18) (:Id I))
         (input P)
         (diag_perp (:Da A8) (:Da2 *A2_m18))
         (diag_axis_of (:D *D_m28) (:Da A2_m18))
         (corner_dist P (:Diag D_m28) (:K *K_m38))
         (corner_dist (:P Q18) (:Diag D_m28) (:K K_m38))
         (diag_dir_elem (:D D8))
         (corner_dist P (:Diag D8) (:K *K1_m48))
         (corner_dist (:P Q18) (:Diag D8) (:K *K2_m58))
         (< K1_m48 K2_m58)
         (&core_component (:Key Col) (:P *Q28) (:Id I2))
         (diag_perp (:Da A8) (:Da2 *A2_m68))
         (diag_axis_of (:D *D_m78) (:Da A2_m68))
         (corner_dist P (:Diag D_m78) (:K *K_m88))
         (corner_dist (:P Q28) (:Diag D_m78) (:K K_m88))
         (nearer (:D D8) (:P Q28) (:Q P)))))

  (RULE &paint
    (&span_tile *Col (:I *I1) *I2 *P)
    (&ground P)))

(ALTS $join "which tiles of one odd color its bridges join" $Bridges
  (ALT $Bridges
    (ALTS $pairs "which two tiles in one tile line a bridge joins" $AnyPair
      (ALT $BlockedByOdd
        (OUTPUT bridge-odd-tiles "a bridge is drawn only where no tile of another odd color lies between its two tiles; defined also where that leaves no cell to two colors"
          (RULE &cell_ray_blocked
            (&cell_key (:K *Key))
            (input *P (:Col *Col2))
            (&odd (:Col Col2))
            (!= Col2 Key))
          (RULE &cell_ray_node
            (&cell_key (:K *Key))
            (&bridge_dir *D)
            (input *P)
            (NOT (&cell_ray_blocked Key P)))
          ;; A tile of another odd color lies between the two.
          (RULE &blocked_tile
            (&span_tile *Col *I *I2 *P)
            (input P (:Col *Col2))
            (&odd (:Col Col2))
            (!= Col2 Col))
          (RULE &paint
            (&span_tile *Col (:I *I1) *I2 *P)
            (&ground P)
            (NOT (&blocked_tile (:I I1) I2))))
        (ALT $CellBetween
          (OUTPUT bridge-odd-tiles "a &bg cell with a cell of one odd color on each side along its row or column becomes that color"
            ;; A background cell with a cell of the color on each side along one line.
            (RULE &paint
              (&cell_ray_ray (:Key *Col) *P *D)
              (&cell_ray_cell (:Key Col) P)
              (dir8_opposite D *D2)
              (&cell_ray_ray (:Key Col) P (:D D2))
              (&cell_ray_cell (:Key Col) P))))))
    (ALTS $dirs "the lines along which tiles join" $Cardinal
      (ALT $Dir8Bridges
        (OUTPUT bridge-odd-tiles "two tiles of the color on one tile diagonal are joined too, on the &bg cells of the diagonals through their interiors"
          (RULE &bridge_dir
            (OR ((diag_dir_elem *D))
                ((dir_elem D))))
          (RULE &line_pair
            (OR ((diag_dir_elem *D)
                 (diag_axis_of D (:Da *DA))
                 (diag_perp (:Da DA) (:Da2 *DA2))
                 (diag_axis_of (:D *X) (:Da DA2))
                 (diag_opposite (:D X) (:Opp *X2))
                 (&odd_tile *I *Col)
                 (&odd_tile (:I *I2) Col)
                 (!= I I2)
                 (&tile_box.box (:key I) (:B *B1))
                 (&tile_box.box (:key (:I I2)) (:B *B2))
                 (corner_dist (:P B1) (:Diag X) (:K *K1))
                 (corner_dist (:P B2) (:Diag X) (:K K1))
                 (corner_dist (:P B1) (:Diag X2) (:K *K2))
                 (corner_dist (:P B2) (:Diag X2) (:K K2)))
                ((&bridge_dir D)
                 (dir_elem D)
                 (axis_of D (:A *A_m1))
                 (perp (:A A_m1) (:A2 *A2_m2))
                 (axis_of (:D *X3) (:A A2_m2))
                 (&odd_tile I (:Col *Col2))
                 (&odd_tile (:I I2) (:Col Col2))
                 (!= I I2)
                 (&tile_box.box (:key I) (:B *B12))
                 (&tile_box.box (:key (:I I2)) (:B *B22))
                 (opposite (:D X3) (:Opp *O_m3))
                 (margin (:B B12) (:D X3) (:K *K12))
                 (margin (:B B12) (:D O_m3) (:K *K22))
                 (opposite (:D X3) (:Opp *O_m4))
                 (margin (:B B22) (:D X3) (:K K12))
                 (margin (:B B22) (:D O_m4) (:K K22)))))))))
  (ALT $BboxOutline
    (OUTPUT bridge-odd-tiles "for each interior color other than the common one, each &bg cell on the outline of the rectangle that the color's outermost tile rows and tile columns bound, in line with the interiors of the tiles on its side, becomes that color"
      ;; A background cell in the rectangle, in line with a tile on its d side.
      (RULE &paint
        (&color_box.box (:key *Col) (:B *B_all))
        (&tile_box.box (:key *I) *B)
        (dir_elem *D)
        (margin B D (:K *K_m1))
        (margin (:B B_all) D (:K K_m1))
        (axis_of D (:A *A_d))
        (perp (:A A_d) (:A2 *A))
        (&core_component (:Key Col) (:P *Q) (:Id I))
        (&ground *P)
        (perp A (:A2 *A2_m2))
        (axis_of (:D *D_m3) (:A A2_m2))
        (margin (:B P) (:D D_m3) (:K *K_m4))
        (margin (:B Q) (:D D_m3) (:K K_m4))
        (ALL ((&color_box.box (:key (:Col *Colm)) (:B B_all))
              (dir_elem (:D *D_m1))
              (relative (:Base B_all) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))))))

(ALTS $test "when two tiles of one odd color are in line" $TileLevel
  (ALT $CellBetween
    (OUTPUT bridge-odd-tiles "a &bg cell with a cell of one odd color on each side along its row or column becomes that color"
      (RULE &cell_ray_cell
        (&cell_key (:K *Key))
        (&ground *P))

      ;; A background cell with a cell of the color on each side along one line.
      (RULE &paint
        (&cell_ray_ray (:Key *Col) *P *D)
        (&cell_ray_cell (:Key Col) P)
        (dir8_opposite D *D2)
        (&cell_ray_ray (:Key Col) P (:D D2))
        (&cell_ray_cell (:Key Col) P)))))

(ALTS $order "what a &bg cell that bridges of two colors claim becomes" $Unordered
  (ALT $DrawnOver
    (OUTPUT bridge-odd-tiles "where bridges of two colors claim one &bg cell, the color drawn later in a stored order of colors takes it; undefined where the order ranks no claimant above the others"
      ;; Each color's rank in the order the colors are drawn, under each open value: every order of the odd colors the inputs hold.
      ;; TODO no-det-plan: &draw_rank: the plan gives no verdict
      (DET &draw_rank (ONE))

      (RULE &covered
        (&paint *P *Col)
        (&draw_rank *V Col *R)
        (&paint P (:Col *Col2))
        (&draw_rank V (:Col Col2) (:R *R2))
        (< R R2)))
    (RULE &output
      (OR ((&paint *P *Col)
           (&draw_rank *V)
           (NOT (&covered V P Col)))
          ((input P Col)
           (NOT (&paint P)))))))

(RULE &cell_ray_end
  (&cell_ray_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cell_ray_ray Key (:P Q) D Origin)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&paint P)))
      ((&paint P Col))))
