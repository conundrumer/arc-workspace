;; bd4472b8

(DET &body_start SepThickness)

(DET &copies SepThickness)

(DET &header_dir DirDomain)

(INIT &fill_division_sides ExtentDivisions
  (key ((&header_dir ^D)
        (axis_of D ^A))
    (frame ((:P P_body))
      (input (:P *P_b))
      (&body_start (:G *K))
      (edge_inset D K *B)
      (ALL ((&header_dir (:D *Dm))
            (&body_start (:G *Km))
            (edge_inset (:D Dm) (:K Km) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_b) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_b) (:X_rel *P_body)))))

(RULE &fill_division_axis_split1
  (&header_dir *D)
  (&body_start (:G *K))
  (edge_inset D K *B)
  (input (:P *P_b))
  (relative (:Base B) (:X P_b) (:X_rel *P_body_))
  (axis_elem (:A *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_body_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_body_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_body_) (:X_rel *X_m1_)))

(RULE &fill_division_parts_held
  (&header_dir *D)
  (axis_of D *A)
  (&copies (:G *N)))

(RULE &fill_division_axis
  (OR ((input (:P *P_b))
       (&header_dir *D)
       (&body_start (:G *K))
       (edge_inset D K *B)
       (ALL ((&header_dir (:D *Dm))
             (&body_start (:G *Km))
             (edge_inset (:D Dm) (:K Km) B)
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X P_b) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P_b) (:X_rel *P))
       (axis_of D (:A *Key_a))
       (axis_elem *A)
       (OR ((!= A Key_a))
           ((NOT (&fill_division_parts_held D (:A Key_a)))))
       (&fill_division_axis_split1 (:P_body_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((input (:P *P_b2))
       (&header_dir D)
       (&body_start (:G *K3))
       (edge_inset D (:K K3) (:B *B2))
       (ALL ((&header_dir (:D *Dm2))
             (&body_start (:G *Km2))
             (edge_inset (:D Dm2) (:K Km2) (:B B2))
             (dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P_b2) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B2) (:X P_b2) (:X_rel P))
       (axis_of D (:A Key_a))
       (&copies (:G *N))
       (&fill_division_sides.division (:key D (:A Key_a)) (:A Key_a) N (:K *K2) (:G 0))
       (axis_of (:D *D2) (:A Key_a))
       (opposite (:D D2) (:Opp *O))
       (margin (:B P) (:D D2) (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K2) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K2) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite (:D D2) (:Opp *O_m1))
       (edge_inset (:D D2) (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m4))
       (edge_inset (:D D2) (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key_a) (:N K2))
       (= A Key_a))
      ((input (:P *P_b3))
       (&header_dir D)
       (&body_start (:G *K4))
       (edge_inset D (:K K4) (:B *B3))
       (ALL ((&header_dir (:D *Dm3))
             (&body_start (:G *Km3))
             (edge_inset (:D Dm3) (:K Km3) (:B B3))
             (dir_elem (:D *D_m13))
             (relative (:Base B3) (:X P_b3) (:X_rel *R_m23))
             (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
            ((>= K_m33 0)))
       (relative (:Base B3) (:X P_b3) (:X_rel P))
       (axis_of D (:A Key_a))
       (&copies (:G *N2))
       (frame_extent P (:A Key_a) (:N *K22))
       (axis_of (:D *D22) (:A Key_a))
       (opposite (:D D22) (:Opp *O2))
       (margin (:B P) (:D D22) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K22) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K22) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D22) (:Opp *O_m12))
       (edge_inset (:D D22) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D22) (:Opp *O_m42))
       (edge_inset (:D D22) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key_a) (:N K22))
       (frame_extent (:P P_outer) (:A Key_a) (:N N2))
       (= A Key_a))))

(RULE &fill_division_tile
  (&fill_division_axis *D (:Key_a *A) *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&fill_division_axis D (:Key_a A) P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &stripe_split1
  (reflection (:A *Da) *T)
  (input (:P *P_h) *Col)
  (apply (:D T) (:P P_h) (:P_out *P_ht_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_ht_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_ht_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_stack_))
  (relative (:Base P_stack_) (:X P_ht_) (:X_rel *X_m1_)))

(RULE &fill_split1
  (&fill_division_tile *D (:A *A_) (:P *P_body) (:P_inner *P_slab_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
  (relative (:Base P_inner_) (:X P_slab_) (:X_rel *X_m1_)))

(DET &diag DiagAxisDomain)

(RULE &stripe
  (input (:P *P_h) *Col)
  (&header_dir *D)
  (margin (:B P_h) D (:K 0))
  (&diag *Da)
  (reflection (:A Da) *T)
  (apply (:D T) (:P P_h) (:P_out *P_ht))
  (axis_of D *A)
  (&stripe_split1 (:P_ht_ P_ht) (:A_ A) (:P_stack_ *P_stack) (:X_m1_ *X_m1)))

(RULE &fill
  (input *P)
  (&fill_division_tile *D *A (:P *P_body) (:P_inner *P_slab))
  (&fill_split1 (:P_slab_ P_slab) (:A_ A) (:P_inner_ *P_inner) (:X_m1_ *X_m1))
  (&body_start (:G *K))
  (edge_inset D K *B)
  (ALL ((&fill_division_tile (:D *Dm) (:A *Am) (:P *P_bodym) (:P_inner *P_slabm))
        (&body_start (:G *Km))
        (edge_inset (:D Dm) (:K Km) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel P_body))
  (&stripe (:P_stack P_inner) *Col))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&fill P)))
      ((&fill P Col))))
