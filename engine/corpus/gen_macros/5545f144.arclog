;; 5545f144

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background: the color that covers the grid.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &panels_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&field.maximal (:t Col))))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A drawn line running the whole way across separates snapshots.
(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &figure_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(RULE &panel_cell
  (&panels_tile_of *P (:P_tile *Pan)))

(RULE &ink
  (&panel_cell *Pan *P)
  (input P *Col)
  (NOT (&field.maximal (:t Col))))

(INIT &figure Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&figure_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &figure_component
  (&figure.class (:a *P) *Id))

(RULE &sight_dir
  (&panel_cell (:Pan *Key))
  (dir_elem *D))

(RULE &sight_dir_ray
  (&sight_dir *Key *D))

(RULE &sym_cell
  (&figure_component (:P *T) (:Id *I))
  (&figure_component *P (:Id I))
  (dir_elem *D)
  (axis_of D *A)
  (perp A *A2)
  (axis_inversion (:A A2) (:T *G))
  (relative (:Base T) (:X P) (:X_rel *V))
  (apply (:D G) (:P V) (:P_out *V2))
  (compose (:A T) (:B V2) (:C *Q))
  (&figure_component (:P T) (:Id I))
  (&figure_component (:P Q) (:Id I)))

(INIT &size Cardinality
  (key ((&sym_cell ^T ^D *P))
    (member ((:m P))
      (&sym_cell T D *P))))

;; The arrow is the widest mirror-symmetric set the panel holds.
(INIT &widest Order
  (key ((&size.size (:key *T *D) *N)
        (ALL ((&sym_cell T D *P)
              (!= P T)
              (margin (:B P) D *K)
              (margin (:B T) D (:K *K2)))
             ((> K K2)))
        (&panel_cell ^Pan (:P T)))
    (member ((:t T D (:S N)))
      (&size.size (:key *T *D) *N)
      (ALL ((&sym_cell T D *P)
            (!= P T)
            (margin (:B P) D *K)
            (margin (:B T) D (:K *K2)))
           ((> K K2)))
      (&panel_cell Pan (:P T)))
    (score ((:t T D (:S N)) (:S N))
      (&size.size (:key *T *D) *N)
      (ALL ((&sym_cell T D *P)
            (!= P T)
            (margin (:B P) D *K)
            (margin (:B T) D (:K *K2)))
           ((> K K2)))
      (&panel_cell Pan (:P T)))))

(RULE &arrow
  (&widest.maximal (:key *Pan) (:t *T *D))
  (&sym_cell T D *P))

(RULE &dot
  (&ink *Pan *P)
  (NOT (&arrow Pan P)))

(RULE &sight_node
  (&sight_dir *Key)
  (input *P)
  (NOT (&dot (:Pan Key) P)))

(RULE &tip
  (&widest.maximal (:key *Pan) (:t (:T *P) *D)))

(RULE &sight_mark
  (OR ((&dot (:Pan *Key) *P))
      ((&tip (:Pan Key) P))))

(RULE &sight_source
  (&sight_mark *Key *P))

(INIT &sight Distance
  (key ((&sight_source (:Key ^Ky) (:P ^O))
        (&sight_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:Key Ky) (:P O))
           (&sight_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:Key Ky) (:P Q)))
          ((&sight_source (:Key Ky) (:P O))
           (&sight_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&sight_source (:Key Ky) (:P O))
           (&sight_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&sight_source (:Key Ky) (:P O))
      (&sight_dir_ray (:Key Ky) D))))

(RULE &sight_ray
  (&sight.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray Key (:P Q) D Origin)))

(RULE &sight_full_dir
  (&sight_dir *Key *D))

(RULE &sight_full_node
  (&sight_dir *Key)
  (input *P))

(RULE &sight_full_source
  (&sight_mark *Key *P))

(INIT &sight_full Distance
  (key ((&sight_full_source (:Key ^Ky) (:P ^O))
        (&sight_full_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_full_source (:Key Ky) (:P O))
           (&sight_full_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_full_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_full_node (:Key Ky) (:P Q)))
          ((&sight_full_source (:Key Ky) (:P O))
           (&sight_full_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_full_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&sight_full_source (:Key Ky) (:P O))
           (&sight_full_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_full_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_full_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&sight_full_source (:Key Ky) (:P O))
      (&sight_full_dir (:Key Ky) D))))

(RULE &sight_full_ray
  (&sight_full.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &sight_full_end
  (&sight_full_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_full_ray Key (:P Q) D Origin)))

(RULE &reach
  (&sight_end (:Key *Pan) (:P *E) *D (:Origin *P))
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *Q))
  (&sight_full_ray (:Key Pan) (:P Q) D *K (:Origin P))
  (dir_elem D))

(RULE &way
  (OR ((axis_of *D (:A *A_m1))
       (perp (:A A_m1) (:A2 *A2_m2))
       (axis_of (:D *D2) (:A A2_m2)))
      ((dir_elem D)
       (= D2 D))))

;; The steps to the first dot on each way.
(INIT &steps Order
  (key ((&way ^D *D2)
        (&reach ^Pan ^P (:D D2) *K))
    (member ((:t K))
      (&way D *D2)
      (&reach Pan P (:D D2) *K))
    (score ((:t K) (:S K))
      (&way D *D2)
      (&reach Pan P (:D D2) *K))))

(RULE &hop
  (OR ((axis_of *D (:A *A_m1))
       (perp (:A A_m1) (:A2 *A2_m2))
       (axis_of (:D *D2) (:A A2_m2))
       (&reach *Pan *P (:D D2) *Q *K)
       (NOT (&reach Pan P D))
       (&steps.minimal (:key Pan P D) (:t K)))
      ((&reach Pan P D Q)
       (= D2 D))))

(INIT &frame BoundingBox
  (key ((&panel_cell ^Pan *P))
    (cell (P)
      (&panel_cell Pan *P))))

(ALTS $choice "which dot the arrow takes next" $Momentum
  (ALT $Nearest
    (RULE &hop
      (&way *D *D2)
      (&reach *Pan *P (:D D2) *Q *K)
      (&steps.minimal (:key Pan P D) (:t K)))))

;; The journey: from the tip, one hop after another.
(INIT &journey Propagation
  (source ((:n Pan (:P P0) (:D D0)))
    (&tip *Pan (:P *P0) (:D *D0)))
  (edge ((:a Pan P D) (:b Pan (:P Q) (:D D2)))
    (&hop *Pan *P *D *Q *D2)))

(RULE &placed
  (&tip *Pan (:P *T) (:D *D0))
  (&arrow Pan (:P *P3))
  (&journey.reached (:n Pan (:P *R) *D))
  (NOT (&hop Pan (:P R) D))
  (c4_elem (:D *G))
  (d4_elem (:D G))
  (dir_elem (:D D0))
  (dir_elem D)
  (step_offset (:D D0) (:V *S_m1))
  (apply (:D G) (:P S_m1) (:P_out *S2_m2))
  (step_offset D (:V S2_m2))
  (relative (:Base T) (:X P3) (:X_rel *V))
  (apply (:D G) (:P V) (:P_out *V2))
  (compose (:A R) (:B V2) (:C *P)))

(RULE &output
  (&panel_cell *Pan (:P *P2))
  (&frame.box (:key Pan) *B)
  (ALL ((&panel_cell (:Pan *Panm) (:P P2))
        (&frame.box (:key (:Pan Panm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (IF ((&placed Pan (:P P2)))
      ((&ink Pan *Col))
      ((&field.maximal (:t Col)))))
