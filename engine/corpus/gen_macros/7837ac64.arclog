;; 7837ac64

(RULE &tiles_cell
  (input *P))

(DET &bg SharedColor)

(RULE &gapped_line_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &gapped_line
  (input *P *Col)
  (&bg (:C Col))
  (axis_elem *A)
  (&gapped_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &on_line_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &on_line
  (input *P)
  (axis_elem *A)
  (&on_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (NOT (&gapped_line L)))

(RULE &tiles_divider_split1
  (&on_line (:P *P_) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Ln_))
  (relative (:Base Ln_) (:X P_) (:X_rel *X_m1_)))

;; $Lattice — every cutting line.
(RULE &tiles_divider
  (&on_line *P *A)
  (&tiles_divider_split1 (:P_ P) (:A_ A) (:Ln_ *L) (:X_m1_ *X_m1)))

(RULE &node
  (&on_line *P *A)
  (perp A *A2)
  (&on_line P (:A A2)))

(RULE &mark
  (&node *P)
  (input P *Col)
  (ALL ((input (:P *Pm) Col)
        (&on_line (:P Pm)))
       ((&node (:P Pm)))))

;; $Marks — the tiles the marks' bounding box reaches.
(INIT &marks_box BoundingBox
  (cell (P)
    (&mark *P)))

(ALTS $l "which lines frame the tiles" $Lattice
  (ALT $Marked
    (RULE &tiles_divider_split2
      (&mark (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Ln_))
      (relative (:Base Ln_) (:X P_) (:X_rel *X_m1_)))

    ;; $Marked — the cutting lines a mark sits on.
    (RULE &tiles_divider
      (&mark *P)
      (axis_elem *A)
      (&tiles_divider_split2 (:P_ P) (:A_ A) (:Ln_ *L) (:X_m1_ *X_m1)))))

(ALTS $s "what the miniature is cropped to" $Marks
  (ALT $Blocks
    ;; The box the miniature is cropped to.
    (INIT &span_box BoundingBox
      (cell ((:P P_tile))
        (&block *P_tile)))))

(RULE &tiles_on_divider
  (&tiles_cell *P)
  (&tiles_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &tiles_rank Order
  (key ((OR ((&tiles_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((&tiles_cell *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&tiles_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&tiles_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((&tiles_cell *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (&tiles_cell *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &tiles_part_idx
  (&tiles_cell *P)
  (axis_of *D *A)
  (NOT (&tiles_on_divider P A))
  (margin (:B P) D *K)
  (&tiles_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiles_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiles_part_idx *P D (:N *N1))
  (&tiles_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &tiles_tile_of
  (&tiles_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiles_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &corner_mark
  (&mark *P *Col)
  (diag_opposite *D (:Opp *D2))
  (step_offset (:D D2) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&tiles_tile_of (:P Q) *P_tile))

;; The one color of a tile's corner marks.
(INIT &corner_color Singleton
  (key ((&corner_mark ^P_tile *Col))
    (member ((:v Col))
      (&corner_mark P_tile *Col))))

(RULE &bare_corner
  (&corner_mark *P_tile)
  (diag_dir_elem *D)
  (NOT (&corner_mark P_tile D)))

(RULE &block
  (&corner_color.value (:key *P_tile) (:v *Col))
  (NOT (&bare_corner P_tile)))

;; The box the miniature is cropped to.
(INIT &span_box BoundingBox
  (cell ((:P P_tile))
    (&marks_box.box *B)
    (&tiles_tile_of *P *P_tile)
    (ALL ((&tiles_tile_of P (:P_tile *P_tilem))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))))

(RULE &output
  (&span_box.box *B)
  (&tiles_tile_of *P_tile)
  (ALL ((&tiles_tile_of P_tile)
        (&span_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_tile) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_tile) (:X_rel *P))
  (OR ((&block P_tile *Col))
      ((NOT (&block P_tile))
       (&bg (:C Col)))))
