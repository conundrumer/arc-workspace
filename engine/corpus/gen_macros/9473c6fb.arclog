;; 9473c6fb

(DET &bg DominantColor)

(DET &order_corner DiagDirDomain)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &corner
  (&order_corner *D))

(RULE &cand
  (&corner (:D *Diag))
  (corner_dir (:C Diag) *D))

(RULE &pair
  (&cand *D)
  (&mark *P)
  (&mark (:P *Q)))

;; The marks by distance from edge d, nearest first.
(INIT &order Order
  (key ((OR ((&cand ^D)
             (&mark *P))
            ((&pair D P *Q)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B Q) D (:K *K2_m2))
             (< K1_m1 K2_m2))))
    (member ((:t P))
      (&cand D)
      (&mark *P))
    (before ((:a P) (:b Q))
      (&pair D *P *Q)
      (dir_elem D)
      (margin (:B P) D (:K *K1_m1))
      (margin (:B Q) D (:K *K2_m2))
      (< K1_m1 K2_m2))))

(RULE &tie
  (&pair *D *P *Q)
  (!= P Q)
  (margin (:B P) D (:K *K_m1))
  (margin (:B Q) D (:K K_m1)))

(DET &rank_dir
  (&cand *E *D)
  (NOT (&tie E D))
  (&order_corner (:D *Diag)))

(DET &cycle_succ
  (&order_corner (:D *Diag))
  (&rank_dir *E Diag *D)
  (&order.successor E (:key D) (:a *P) (:b *P2))
  (ex_output E P (:Col *C))
  (ex_output E (:P P2) (:Col *C_next)))

(INIT &cycle Walk
  (successor ((:p C) (:p_next C2))
    (&cycle_succ *C (:C_next *C2)))
  (steps ((:N R))
    (&order.rank *R)))

(RULE &order_dir
  (&cand *D)
  (NOT (&tie D)))

(DET &cycle_start
  (&order_corner (:D *Diag))
  (&rank_dir *E Diag *D)
  (&order.minimal E (:key D) (:t *P))
  (ex_output E P (:Col *C)))

(ALTS $choice "which of the corner's two directions ranks the marks" $Separate
  (ALT $Span
    (RULE &spans
      (&cand *D)
      (&mark *P)
      (margin (:B P) D (:K 0))
      (opposite D (:Opp *D_far))
      (&mark (:P *Q))
      (margin (:B Q) (:D D_far) (:K 0)))

    (RULE &order_dir
      (&spans *D))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&order_dir *D)
       (&order.rank (:key D) (:t P) *R)
       (&cycle_start (:C *C0))
       (&cycle.walk (:p0 C0) (:N R) (:p *Col)))
      ((&bg (:C Col_in))
       (= Col Col_in))))
