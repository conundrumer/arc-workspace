;; 551d5bf1

(RULE &rects_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &outline RarestColor)

(INIT &rects Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&outline (:C Col))
         (&rects_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&outline (:C Col2)))
        ((input P (:Col *Col3))
         (&outline (:C Col3))
         (= P3 P)))))

(RULE &rects_component
  (&rects.class (:a *P) *Id))

(RULE &leak_dir
  (dir_elem (:D *Key)))

(RULE &leak_node
  (dir_elem (:D *Key))
  (input *P))

(INIT &bbox BoundingBox
  (key ((&rects_component *P ^Id))
    (cell (P)
      (&rects_component *P Id))))

(RULE &leak_source
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *Key) (:K *K_m1))
  (margin B (:D Key) (:K K_m1))
  (NOT (&bbox.cell (:key Id) P)))

;; A gap — a border cell the rectangle does not draw — casts away from the
;; rectangle. The key is the side the gap breaks.
(INIT &leak Distance
  (key ((&leak_source (:Key ^Ky) (:P ^O))
        (&leak_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&leak_source (:Key Ky) (:P O))
           (&leak_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&leak_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&leak_node (:Key Ky) (:P Q)))
          ((&leak_source (:Key Ky) (:P O))
           (&leak_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&leak_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&leak_source (:Key Ky) (:P O))
           (&leak_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&leak_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&leak_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&leak_source (:Key Ky) (:P O))
      (&leak_dir (:Key Ky)))))

(RULE &leak_ray
  (&leak.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &leak_end
  (&leak_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&leak_ray Key (:P Q) D Origin)))

(DET &ink AnyOutNewColor)

(RULE &leak_cell
  (dir_elem (:D *Key))
  (input *P))

(RULE &paint
  (OR ((&bbox.box *B)
       (input *P)
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((> K_m3 0))))
      ((&leak_ray (:Key *D) P D)
       (&leak_cell (:Key D) P))))

(RULE &output
  (input *P (:Col *Col0))
  (IF ((&paint P))
      ((&ink (:C *Col)))
      ((= Col Col0))))
