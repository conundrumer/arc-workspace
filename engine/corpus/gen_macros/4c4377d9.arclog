;; 4c4377d9

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tile_d4 (:Pt *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_in))
    (&tile_d4 (:T *D))
    (apply D (:P P_in) (:P_out *P_intile))))

(ALTS $choice "data-equivalent on this task" $Lookup
  (ALT $Unfold
    (DET &arr_pos Frame)

    (DET &anchor DirDomain)

    ;; The input reflected across the shared boundary, once per tile step away
    ;; from the anchor-end tile.
    (INIT &reflect Walk
      (successor ((:p P) (:p_next P_img))
        (input *P)
        (&anchor *D)
        (axis_of D *A)
        (axis_inversion A (:T *F))
        (apply (:D F) P (:P_out *P_img)))
      (steps ((:N K))
        (&arr_pos (:P *T))
        (&anchor *D)
        (margin (:B T) D *K)))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (&arr_pos (:P *T)))
      (inner ((:P P_intile))
        (&reflect.walk (:p *P_intile))))

    (RULE &output
      (&output_tiling2.cell (:P_outer *T) (:P_inner *P_intile) *P)
      (&anchor *D)
      (margin (:B T) D *K)
      (&reflect.walk (:p0 *P2) (:N K) (:p P_intile))
      (input (:P P2) *Col))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
