;; 2a5f8217

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &shapes_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(DET &blank ChangedColor)

(RULE &shape
  (&shapes_component (:Key *Col) *P *Id))

(INIT &bbox BoundingBox
  (key ((&shape ^Col ^Id *P))
    (cell (P)
      (&shape Col Id *P))))

(RULE &footprint
  (&shape *Col *Id *P)
  (&bbox.box (:key Col Id) *B)
  (ALL ((&shape (:Col *Sm_col) (:Id *Sm_id) P)
        (&bbox.box (:key (:Col Sm_col) (:Id Sm_id)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; The blank shapes against a catalog of the other shapes' footprints.
(INIT &same Inclusion
  (pattern ((:pattern Col Id) (:m P_inner))
    (&footprint *Col *Id *P_inner)
    (NOT (&blank (:C Col))))
  (observed ((:observed Col Id) (:m P_inner))
    (&footprint *Col *Id *P_inner)
    (&blank (:C Col))))

(RULE &paint
  (&shape (:Col *S_col) (:Id *S_id) *P)
  (&same.equal (:observed (:Col S_col) (:Id S_id)) (:pattern *Col)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
