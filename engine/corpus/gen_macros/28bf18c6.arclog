;; 28bf18c6

(DET &bg DominantColor)

(INIT &shape_box BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(DET &axis AxisDomain)

(DET &copies DimDiff)

(INIT &strip Frame
  (key ((&axis ^A))
    (extent (A N)
      (&copies (:D *N)))))

(INIT &output_tiling Tiling
  (outer ((:P P_copy))
    (&strip.cell (:P *P_copy)))
  (inner ((:P P_intile))
    (input *P)
    (&shape_box.box *B)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_intile))))

(RULE &output
  (input (:P *P2) *Col)
  (&shape_box.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_intile))
  (&strip.cell (:P *P_copy))
  (&output_tiling.cell (:P_outer P_copy) (:P_inner P_intile) *P))
