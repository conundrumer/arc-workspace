;; 3979b1a8

(DET &anchored_corner_anchor1
  (diag_dir_elem (:D *Diag_))
  (ex_input *E (:P *P_in_))
  (ex_output E (:P *P_grid_))
  (corner_dir (:C Diag_) (:D *D_m1))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K2_m3))
  (!= K1_m2 K2_m3))

(DET &scale ScaleRatio)

;; The frame is a scale x scale arrangement of input-sized tiles; the
;; input occupies its tile.
(INIT &tiles Frame
  (extent (A (:N S))
    (&scale (:K *S))
    (axis_elem *A)))

(INIT &tile_cell_tiling Tiling
  (outer ((:P P_tile))
    (&tiles.cell (:P *P_tile)))
  (inner ((:P P_in))
    (input (:P *P_in))))

;; Tiles of the scale arrangement.
(INIT &tiles2 Frame
  (extent (A (:N S))
    (&scale (:K *S))
    (axis_elem *A)))

(INIT &tile_seated_tiling Tiling
  (outer ((:P P_tile))
    (&tiles2.cell (:P *P_tile)))
  (inner ((:P P_in))
    (ex_input (:P *P_in))))

(RULE &tile_cell
  (&tile_cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_in) (:P *P_grid)))

(RULE &frame_cell
  (&tile_cell *P_grid))

;; Where each train input occurs in its output, as the box of the input's
;; frame in the output's.
(INIT &occ Occurrences
  (key ((OR ((ex_output ^E *P *Col))
            ((ex_input E P Col)
             (ex_output E))))
    (cell (P (:v Col))
      (ex_output E *P *Col))
    (shape (P (:v Col))
      (ex_input E *P *Col)
      (ex_output E))))

(DET &tile_seated
  (&occ.occurrence (:key *E) (:P *B))
  (ex_input E (:P *P_in))
  (compose (:A B) (:B P_in) (:C *P_grid))
  (&tile_seated_tiling.cell (:P_outer *P_tile) (:P_inner P_in) (:P P_grid)))

(DET &tile_defect
  (&tile_seated *P_tile)
  (ex_output *E)
  (NOT (&tile_seated E P_tile)))

(DET &in_tile
  (&tile_seated *P_tile)
  (NOT (&tile_defect P_tile)))

(RULE &placed
  (&in_tile *P_tile)
  (&tile_cell *P_grid P_tile *P_in))

(DET &seated
  (&occ.occurrence (:key *E) (:P *B))
  (diag_dir_elem (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin B (:D D1_m2) (:K 0))
  (margin B (:D D2_m3) (:K 0)))

(DET &anchor_defect
  (&seated *Diag)
  (ex_output *E)
  (NOT (&seated E Diag)))

(DET &anchor
  (&seated (:Diag *D))
  (NOT (&anchor_defect (:Diag D))))

(DET &growth
  (&anchor (:D *A))
  (diag_opposite (:D A) (:Opp *D)))

(DET &cand
  (ex_output *P)
  (axis_elem *A)
  (sub_extent P A (:K *N))
  (&growth (:D *Diag))
  (diag_opposite (:D Diag) (:Opp *Back))
  (dir8_opposite (:D Back) (:D2 *O_m1))
  (edge_inset (:D O_m1) (:K N) (:B *B1_m2))
  (edge_inset (:D Back) (:K N) (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta)))

(DET &diag_cell
  (ex_output *E *P)
  (&growth (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) *K)
  (margin (:B P) (:D D2_m3) K))

(DET &anchored
  (ex_input *E (:P *P_in))
  (ex_output E (:P *P_grid))
  (diag_dir_elem (:D *Diag))
  (NOT (&anchored_corner_anchor1 (:Diag_ Diag) (:P_in_ P_in) (:P_grid_ P_grid))))

(DET &in_region
  (&anchor (:D *Diag))
  (&anchored *E Diag *P_grid))

(DET &mismatch
  (&cand *N *Delta)
  (&diag_cell *E *P)
  (NOT (&in_region E (:P_grid P)))
  (compose (:A P) (:B Delta) (:C *P2))
  (ex_output E P *Col)
  (ex_output E (:P P2) (:Col *C2))
  (!= C2 Col))

(DET &period
  (&cand *N)
  (NOT (&mismatch N)))

(ALTS $choice "what the output frame is" $Scale
  (ALT $Canvas
    (DET &out_dim ConstOutDim)

    ;; The frame is a stored canvas; the input sits at the anchor corner.
    (INIT &canvas Frame
      (extent (A (:N K))
        (&out_dim (:N *K))
        (axis_elem *A)))

    (RULE &frame_cell
      (&canvas.cell (:P *P_grid)))

    (RULE &placed
      (&canvas.cell (:P *P_grid))
      (input (:P *P_in))
      (&anchor (:D *Diag))
      (ALL ((corner_dir (:C Diag) (:D *D_m1))
            (margin (:B P_in) (:D D_m1) (:K *K1_m2))
            (margin (:B P_grid) (:D D_m1) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))))

(RULE &on_diag
  (&frame_cell *P_grid)
  (&growth (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P_grid) (:D D1_m2) *K)
  (margin (:B P_grid) (:D D2_m3) K))

(RULE &diag_color
  (&on_diag *P_grid)
  (OR ((&placed P_grid *P_in)
       (input (:P P_in) *Col))
      ((&growth (:D *Diag))
       (&period *N)
       (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
       (perp (:A A_m1) (:A2 *A2_m4))
       (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
       (margin (:B P_grid) (:D D1_m2) *K)
       (margin (:B P_grid) (:D D2_m3) K)
       (divide (:T K) (:Side N) (:Gap 0) (:Remainder *R))
       (&on_diag (:P_grid *Q))
       (NOT (&placed P_grid))
       (&placed (:P_grid Q) (:P_in *Q_in))
       (input (:P Q_in) Col)
       (corner_dir (:C Diag) (:A *A_m5) (:D *D1_m6))
       (perp (:A A_m5) (:A2 *A2_m8))
       (corner_dir (:C Diag) (:A A2_m8) (:D *D2_m7))
       (margin (:B Q) (:D D1_m6) (:K *Kq))
       (margin (:B Q) (:D D2_m7) (:K Kq))
       (divide (:T Kq) (:Side N) (:Gap 0) (:Remainder R))
       (dir8_opposite (:D Diag) (:D2 *O_m10))
       (edge_inset (:D O_m10) (:K N) (:B *B1_m11))
       (edge_inset (:D Diag) (:K N) (:B *I_m13))
       (relative (:Base I_m13) (:X 0) (:X_rel *B2_m12))
       (compose (:A B1_m11) (:B B2_m12) (:C *V_m9))
       (compose (:A Q) (:B V_m9) (:C *Q2))
       (NOT (&placed (:P_grid Q2))))))

(RULE &output
  ;; The input in place.
  (OR ((&placed (:P_grid *P) *P_in)
       (input (:P P_in) *Col))
      ;; Outside the input, the diagonal continues, and each diagonal cell paints
      ;; two arms one shell out: a step toward the corner, then a ray back across.
      ((&diag_color (:P_grid *Q) Col)
       (OR ((&growth (:D *Diag))
            (corner_dir (:C Diag) (:A *A_m1) (:D *D1))
            (perp (:A A_m1) (:A2 *A2_m2))
            (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
            (step_offset (:D D1) (:V *V_m3))
            (compose (:A Q) (:B V_m3) (:C *M))
            (&frame_cell (:P_grid P))
            (axis_of (:D D2) *A)
            (perp A (:A2 *A2_m4))
            (axis_of (:D *D_m5) (:A A2_m4))
            (margin (:B P) (:D D_m5) (:K *K_m6))
            (margin (:B M) (:D D_m5) (:K K_m6))
            (opposite (:D D2) (:Opp *O))
            (margin (:B P) (:D O) (:K *Kp))
            (margin (:B M) (:D O) (:K *Km))
            (<= Kp Km))
           ((= P Q)))
       (NOT (&placed (:P_grid P))))))
