;; 00d62c1b

(RULE &outside_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &outside Propagation
  (source ((:n P))
    (&bg_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))
  (edge ((:a P) (:b P2))
    (&bg_cell *P)
    (&outside_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&bg_cell (:P P2))))

(RULE &enclosed
  (&bg_cell *P)
  (NOT (&outside.reached (:n P))))

(RULE &output
  (OR ((&enclosed *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&enclosed P)))))
