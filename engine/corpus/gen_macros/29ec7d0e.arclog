;; 29ec7d0e

(DET &noise ChangedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&noise (:C Col))))

(INIT &si Periods
  (cell (P (:v Col))
    (&clean *P *Col)))

(RULE &period
  (&si.fundamental_period *A *K))

(ALTS $choice "how the repair finds the period-preserving shift" $Shift
  (ALT $Count
    (INIT &palette Cardinality
      (member ((:m Col))
        (&clean *Col)))

    (RULE &period
      (&palette.size (:N *K))
      (axis_elem *A))))

(RULE &phase
  (input *P)
  (corner_dir (:C *Dg) *A (:D *D1_m1))
  (perp A (:A2 *A2_m3))
  (corner_dir (:C Dg) (:A A2_m3) (:D *D2_m2))
  (margin (:B P) (:D D1_m1) (:K *T))
  (margin (:B P) (:D D2_m2) (:K *T2))
  (perp A *A2)
  (&period A *K)
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (&period (:A A2) (:K *K2))
  (divide (:T T2) (:Side K2) (:Gap 0) (:Remainder *R2)))

;; A cell takes the value of the clean cells at its place in the tile.
(RULE &output
  (&phase *Dg *A (:P *Q) *R *R2)
  (&clean (:P Q) *Col)
  (&phase Dg A *P R R2))
