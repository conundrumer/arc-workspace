;; b8825c91

(DET &noise ChangedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&noise (:C Col))))

(ALTS $choice "which D4 elements the repair draws on" $Full
  (ALT $Detect
    ;; Self-symmetry of the clean cells.
    (INIT &sym Agreement
      (source ((:i P) (:v Col))
        (&clean *P *Col))
      (target ((:i P) (:v Col))
        (&clean *P *Col))
      (correspondence ((:m D) (:i P) (:j Q))
        (&clean *P *Col)
        (d4_elem *D)
        (apply D P (:P_out *Q))))

    (RULE &output
      (OR ((&clean *P *Col))
          ((input P (:Col *N))
           (&noise (:C N))
           (&clean)
           (d4_elem *D)
           (NOT (&sym.conflict (:m D)))
           (apply D P (:P_out *P2))
           (&clean (:P P2) Col))))))

(RULE &output
  (OR ((&clean *P *Col))
      ((input P (:Col *N))
       (&noise (:C N))
       (d4_elem *D)
       (apply D P (:P_out *P2))
       (&clean (:P P2) Col))))
