;; c658a4bd

(INPUT square-per-color "each non-&bg color draws one square: the outline of a square, or a solid square when its side is 1 or 2"

  (DET_OR_RULE &bg DominantColor
    (ex_input *E (:Col *C))
    (ex_output E)
    (NOT (ex_output E (:Col C)))))

(INPUT distinct-sizes "the squares have distinct side lengths")

(INPUT sizes-step "sorted by side, the sides fall by 2 from the largest to the smallest, and the smallest side is 1 or 2")

(INPUT partly-hidden "a square may cross another square, which then covers some of its cells, and a square may run past the grid edge; each square keeps enough cells to show its side")

(OUTPUT output-size "the output is a square whose side is the largest square's side"

  ;; The bounding box of each square.
  (INIT &square BoundingBox
    (key ((input *P ^Col)
          (NOT (&bg (:C Col))))
      (cell (P)
        (input *P Col)
        (NOT (&bg (:C Col))))))

  (INIT &area Cardinality
    (key ((&square.box (:key ^Col) *B)
          (input *P)
          (ALL ((&square.box (:key (:Col *Colm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0))))
      (member ((:m P))
        (&square.box *B)
        (input *P)
        (ALL ((&square.box (:key (:Col *Colm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))))))

(OUTPUT concentric-rings "the output's ring at depth k from its edge takes the color of the square of the k-th largest side, the largest at depth 0"

  (RULE &ring_depth_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &extent
    (&square.box (:key *Col) *B)
    (&square.cell (:key Col) *P)
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N))

  (INIT &larger Order
    (key ((&extent ^Col *N))
      (member ((:t N))
        (&extent Col *N))
      (score ((:t N) (:S N))
        (&extent Col *N))))

  (RULE &side
    (&larger.maximal (:key *Col) (:t *N)))

  (RULE &score
    (&side *Col (:N *S)))

  ;; The squares from the highest score down: a square's rank is its depth.
  (INIT &order Order
    (member ((:t Col))
      (&score *Col)
      (ALL ((&score (:Col *Col1) (:S *N))
            (&score (:Col *Col2) (:S N)))
           ((= Col1 Col2))))
    (before ((:a Col1) (:b Col2))
      (&score (:Col *Col1) (:S *N1))
      (&score (:Col *Col2) (:S *N2))
      (> N1 N2)))

  (RULE &top_side
    (&order.minimal (:t *Col))
    (&side Col *N))

  (INIT &frame Frame
    (extent (A N)
      (&top_side *N)
      (axis_elem *A)))

  (INIT &ring Boundary
    (cell (P)
      (&frame.cell *P)))

  (INIT &ring_depth Distance
    (edge ((:a P) (:b P2))
      (&frame.cell *P)
      (&ring_depth_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (&frame.cell (:P P2)))
    (source ((:n P))
      (&ring.boundary *P)))

  (RULE &ring_side_uniform_inset1
    (&ring_depth.distance (:n *P) (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &ranked_ring
    (&ring_depth.distance (:n *P) *K)
    (&order.rank (:t *Col) (:R K)))

  (RULE &ring_side
    (&ring_depth.distance (:n *P) *K)
    (&ring_side_uniform_inset1 (:K_ K) (:B_ *B))
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A (:N *S)))

  (RULE &ring_of_side
    (&ring_side *S))

  (RULE &unplaced
    (&ring_of_side)
    (&side (:N *S))
    (NOT (&ring_of_side S))))

(ALTS $nesting "how the ordered squares make the output" $RankRings
  (ALT $OutlineAtSide
    (OUTPUT concentric-rings "each square is drawn as a 1-wide outline at its own side, centered in the frame, and &bg fills the rest; undefined where a square's side is the side of no ring of the frame")
    (RULE &output
      (&ring_side *P *S)
      (NOT (&unplaced))
      (OR ((&side *Col (:N S)))
          ((NOT (&side (:N S)))
           (&bg (:C Col))))))
  (ALT $SolidAtSide
    (OUTPUT concentric-rings "each square is drawn solid at its own side, centered, the larger ones first; undefined where a square's side is the side of no ring of the frame"
      ;; The squares that cover each cell, and the smallest of them, which lies on
      ;; top.
      (INIT &cover Order
        (key ((&ring_side ^P (:S *T))
              (&side *Col (:N *S))
              (>= S T))
          (member ((:t (:V Col) S))
            (&ring_side P (:S *T))
            (&side *Col (:N *S))
            (>= S T))
          (score ((:t (:V Col) S) S)
            (&ring_side P (:S *T))
            (&side *Col (:N *S))
            (>= S T)))))
    (RULE &output
      (&cover.minimal (:key *P) (:t (:V *Col)))
      (NOT (&unplaced))))
  (ALT $SideFromCount
    (OUTPUT output-size "the output's side is the smallest square's side with one ring added around it for each other square"
      (RULE &extent_uniform_outset1
        (&order.rank (:t *Col) (:R *K_))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
        (relative (:Base I_m1) (:X 0) (:X_rel *B_)))

      ;; The smallest square's side as a frame.
      (INIT &core Frame
        (extent (A (:N S))
          (&order.maximal (:t *Col))
          (&side Col (:N *S))
          (axis_elem *A)))

      (INIT &frame Frame
        (extent (A N)
          (&order.maximal (:t *Col))
          (&order.rank (:t Col) (:R *K))
          (&extent_uniform_outset1 (:K_ K) (:B_ *B))
          (&core.cell *P)
          (axis_elem *A)
          (relative (:Base B) (:X P) (:X_rel *R_m1))
          (frame_extent (:P R_m1) A *N)))))
  (ALT $InnermostFills
    (OUTPUT concentric-rings "the smallest square's color fills each ring deeper than the squares reach")
    (RULE &output
      (&ring_depth.distance (:n *P) *K)
      (OR ((&order.rank (:t *Col) (:R K)))
          ((&order.maximal (:t Col))
           (NOT (&order.rank (:R K))))))))

(ALTS $rank "what orders the squares and picks the largest" $BySide
  (ALT $RankByBboxArea
    (OUTPUT concentric-rings "the squares are ordered by the cell count of their visible bounding box, and the output's side is the side of the first; undefined where two counts tie"
      (RULE &score
        (&area.size (:key *Col) (:N *S))))))

(ALTS $side "how a square's side is read from its visible cells" $LargerExtent
  (ALT $SideOnAxis
    (OUTPUT concentric-rings "a square's side is its bounding box's extent along &side_axis"
      (DET &side_axis AxisDomain)

      (RULE &side
        (&extent *Col *A *N)
        (&side_axis A)))))

(RULE &output
  (&ranked_ring *P *Col))
