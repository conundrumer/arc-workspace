;; a2d730bd

(param &draw.aim Dir (DIR_B))
(param &draw.foot_offsets Offset
  (grid
    (1 @1 1)))
(param &draw.head_offsets Offset
  (grid
    (1 @_ 1)
    (_ 1 _)))
(param &block_order (DiagDir Axis)
  (DIAG_TL AXIS_V)
  (DIAG_TL AXIS_H)
  (DIAG_TR AXIS_V)
  (DIAG_TR AXIS_H)
  (DIAG_BL AXIS_V)
  (DIAG_BL AXIS_H)
  (DIAG_BR AXIS_V)
  (DIAG_BR AXIS_H))
(param &scan_order (DiagDir Axis)
  (DIAG_TL AXIS_V)
  (DIAG_TL AXIS_H)
  (DIAG_TR AXIS_V)
  (DIAG_TR AXIS_H)
  (DIAG_BL AXIS_V)
  (DIAG_BL AXIS_H)
  (DIAG_BR AXIS_V)
  (DIAG_BR AXIS_H))

(exclude ($NeedRect) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $PaintBgOnly) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $ScanOrder) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $ThinBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $FirstBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $AlignedBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedAligned $SkipOrphan) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $PaintBgOnly) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $ScanOrder) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $ThinBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $FirstBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $AlignedBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $NearestFace) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($NeedBlock $SkipUnaligned) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $PaintBgOnly) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $ScanOrder) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $ThinBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $SkipOrphan) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $NearestFace) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($SoleBlock $SkipUnaligned) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $PaintBgOnly) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $ScanOrder) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $FirstBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $AlignedBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $SkipOrphan) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $NearestFace) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($ThickBlock $SkipUnaligned) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $PaintBgOnly) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $ThinBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $FirstBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $AlignedBlock) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $SkipOrphan) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $NearestFace) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")
(exclude ($Clash $SkipUnaligned) "The concept case, and the cases that take SkipOrphan, ThinBlock, CellDots and ScanOrder with a non-concept branch at Unaligned and at Several. Every other case is subsumed: wherever it is defined, the case with those branches in place of its concept branches gives the same grid.")

(alts $unaligned
  (alt $NearestFace
    (witness unaligned-dot borderline $SkipUnaligned
      (relaxed aligned)
      (separates "the $NearestFace and $SkipUnaligned cases from the concept: the dot is outside both spans of its block. The $NearestFace cases draw toward the side with the smaller gap, with the foot off the block; the $SkipUnaligned cases keep the dot; the concept is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $NearestFace (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 2 8 2 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $SkipUnaligned (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))))
  (alt $SkipUnaligned
    (witness unaligned-dot borderline $SkipUnaligned)))

(alts $orphan
  (alt $SkipOrphan
    (witness orphan-dot borderline $SkipOrphan
      (relaxed dots)
      (separates "the $SkipOrphan cases from the concept: a dot of color 3 has no block of color 3. The $SkipOrphan cases keep it; the concept is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 2 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 3 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $CellDots (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 2 8 8 8 2 8 8)
        (8 8 2 2 2 2 2 2 2 8 2 8)
        (8 8 2 2 2 2 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 3 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $several
  (alt $FirstBlock
    (witness two-blocks borderline $AlignedBlock
      (relaxed blocks)
      (separates "the $FirstBlock and $AlignedBlock cases from the concept: color 2 has two blocks, and the dot is aligned with both. The $FirstBlock cases give a grid for each open block order, connecting to the first block in that order: the upper block at some orders and the lower block at others; the $AlignedBlock cases connect to the nearer; the concept is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 2 2 8 8 8 8 8 8 8 8)
        (8 2 2 2 8 8 8 8 8 2 8 8)
        (8 2 2 2 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $AlignedBlock (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 2 2 8 8 8 8 8 2 8 8)
        (8 2 2 2 8 8 8 8 2 8 2 8)
        (8 2 2 2 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $FirstBlock
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 2 2 2 2 8 8 8 8 2 8 8)
          (8 2 2 2 2 2 2 2 2 8 2 8)
          (8 2 2 2 2 8 8 8 8 2 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 2 2 2 8 8 8 8 8 2 8 8)
          (8 2 2 2 8 8 8 8 2 8 2 8)
          (8 2 2 2 8 8 8 8 8 2 8 8)
          (8 8 8 8 8 8 8 8 8 2 8 8)
          (8 8 8 8 8 8 8 8 8 2 8 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 2 2 2 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)))))
  (alt $AlignedBlock
    (witness two-blocks borderline $AlignedBlock)))

(alts $thin
  (alt $ThinBlock
    (witness thin-block variant $ThinBlock
      (relaxed blocks)
      (separates "the $ThinBlock cases from the concept: the block is one cell wide. The $ThinBlock cases connect the dot to it; the concept is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 2 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $CellDots (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 2 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 2 8 2 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $ragged
  (alt $CellDots
    (witness ragged-piece foreign any
      (relaxed dots)
      (separates "the $CellDots cases from $NeedRect under $ScanOrder: a piece of color 2 is an L of three cells, below the block of color 2 and in its column span. The $CellDots cases read each cell of the L as a dot that draws from the block, with a grid for each open scan order; under $NeedRect the L is neither a block nor dots, and the model is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $PaintBgOnly (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8 8 8)
        (8 8 2 2 2 2 8 8 8 8 8 8)
        (8 8 8 2 2 8 8 8 8 8 8 8)
        (8 8 8 2 2 8 8 8 8 8 8 8)
        (8 8 2 8 2 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 8 8 8 8)
        (8 8 8 2 2 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output ($CellDots $PaintOver)
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 8 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 8 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 2 8 2 8 8 8 8 8 8 8)
          (8 8 2 2 8 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))
        (grid
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 2 8 2 8 8 8 8 8 8 8)
          (8 8 2 2 2 2 8 8 8 8 8 8)
          (8 8 8 2 2 8 8 8 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $overlap
  (alt $ScanOrder
    (witness crossing-lines variant any
      (separates "the $ScanOrder cases from the concept: the lines of two dots of different colors cross. The $ScanOrder cases give a grid for each open scan order, with the later dot in that order painted on top: color 2 at some orders and color 3 at others; the concept is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 3 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 2 8 8 8 8 8 8 8 2 8)
        (8 2 2 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 3 3 3 8 8 8 8)
        (8 8 8 8 8 3 3 3 8 8 8 8)
        (8 8 8 8 8 3 3 3 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output concept undefined)
      (output $CellDots
        (grid
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 3 8 3 8 8 8 8)
          (8 8 8 2 8 8 3 8 8 8 2 8)
          (8 2 2 2 2 2 2 2 2 2 8 2)
          (8 2 2 2 8 8 3 8 8 8 2 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))
        (grid
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 3 8 3 8 8 8 8)
          (8 8 8 2 8 8 3 8 8 8 2 8)
          (8 2 2 2 2 2 3 2 2 2 8 2)
          (8 2 2 2 8 8 3 8 8 8 2 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 8 3 8 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 3 3 3 8 8 8 8)
          (8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $content
  (alt $PaintBgOnly
    (witness line-over-block variant concept
      (separates "the $PaintBgOnly cases from the concept: a block of color 3 stands on the line from block 2 to its dot. The concept paints the line over it; the $PaintBgOnly cases paint background cells only and leave block 3 whole.")
