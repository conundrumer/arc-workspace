;; 20a9e565

(INPUT growing-sequence "on a field of &background, figures stand one after another along one direction, each separated from the next by &background; each term grows from the one before it by the same step, and the term colors repeat a cycle."

  (DET_OR_RULE &background DominantColor))

(INPUT corner-marks "two 3-cell L marks of &marker_color, one at each of the top-left and bottom-right corners of a rectangle, the window; each mark's corner cell is the window's corner cell, and the marks touch no figure."

  (DET_OR_RULE &marker_color "The color of the corner marks that frame the window." RarestColor)

  (RULE &mark
    (input *P *Col)
    (&marker_color (:C Col)))

  (INIT &mark_box BoundingBox
    (cell (P)
      (&mark *P)))

  (RULE &elbow
    (&mark *P)
    (step_offset *D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&mark (:P Q))
    (axis_of D (:A *A_m2))
    (perp (:A A_m2) (:A2 *A2_m3))
    (axis_of (:D *D2) (:A A2_m3))
    (step_offset (:D D2) (:V *V_m4))
    (compose (:A P) (:B V_m4) (:C *Q2))
    (&mark (:P Q2)))

  (INIT &elbow_box BoundingBox
    (cell (P)
      (&elbow *P))))

(INPUT window-ahead "the window lies past the last shown term, across the place where a later term of the continued sequence stands.")

(OUTPUT continue-sequence "the sequence goes on by whatever progression its maker drew, as a person reads it from the shown terms."
  (APPROXIMATED "the sequence goes on past its last shown term; each new term takes the growth, the spacing and the alignment that the shown terms follow from one term to the next, and the next color of the cycle. The growth is one of a catalog of five, the one every pair of consecutive shown terms confirms.")

  (RULE &figure
    (input *P *Col)
    (NOT (&background (:C Col)))
    (NOT (&marker_color (:C Col))))

  (RULE &term_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  ;; The terms: the figures, each a connected group of figure cells.
  (INIT &term Quotient
    (edge ((:a P) (:b P3))
      (OR ((&figure *P)
           (&term_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&figure (:P P3)))
          ((&figure P)
           (= P3 P)))))

  (RULE &term_component
    (&term.class (:a *P) *Id))

  (RULE &term_cell
    (&term_component *P (:Id *T))
    (&figure P *Col))

  (RULE &term_line_split1
    (&term_cell *T (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &term_line
    (&term_cell *T *P)
    (axis_elem *A)
    (&term_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (RULE &order_member
    (&term_line (:A *Key) (:T *M) (:L *P))
    (ALL ((&term_line (:A Key) (:T *Tm) (:L *Lm))
          (&term_line (:A Key) (:T *T2) (:L Lm)))
         ((= Tm T2))))

  ;; The terms in order along an axis on which no two of them share a line.
  (INIT &order Order
    (key ((axis_elem ^A)
          (axis_of ^D A))
      (member ((:t T))
        (&order_member (:Key A) (:M *T))
        (ALL ((&term_line A (:T *Tm) *L)
              (&term_line A (:T *T2) L))
             ((= Tm T2))))
      (before ((:a T) (:b M_b))
        (&order_member (:Key A) (:M *T) (:P *L))
        (&order_member (:Key A) (:M *M_b) (:P *Q))
        (!= T M_b)
        (ALL ((&term_line A (:T *Tm) (:L *Lm))
              (&term_line A (:T *T2) (:L Lm)))
             ((= Tm T2)))
        (margin (:B L) D (:K *K1))
        (margin (:B Q) D (:K *K2))
        (< K1 K2))))

  (RULE &order_pos
    (&order.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
    (&order.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K R1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

  (RULE &edge_part_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &term_box BoundingBox
    (key ((&term_cell ^T *P))
      (cell (P)
        (&term_cell T *P))))

  (RULE &edge_cell
    (&term_box.box (:key *T) *B)
    (&term_cell T *P)
    (dir_elem (:D *E1))
    (ALL ((&term_cell (:T *Tm) P)
          (&term_box.box (:key (:T Tm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D E1) (:K *K_m1))
    (margin B (:D E1) (:K K_m1)))

  (RULE &term_edge_split1
    (&edge_cell *T (:E1 *E) (:P *P_))
    (axis_of (:D E) (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &grid_line_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &term_band_split1
    (&term_box.box (:key *T) (:B *B_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B_a_))
    (relative (:Base B_a_) (:X B_) (:X_rel *X_m1_)))

  (RULE &term_at
    (&order_pos (:Key *A) (:M *T) (:P_pos *I))
    (axis_of *D A))

  (INIT &term_period Periods
    (key ((&term_box.box (:key ^T) *B)
          (input *P)
          (ALL ((&term_box.box (:key (:T *Tm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (OR ((&term_cell T P *Col))
              ((NOT (&term_cell T P))
               (&background (:C Col)))))
      (cell (P (:v Col))
        (&term_box.box *B)
        (input *P)
        (ALL ((&term_box.box (:key (:T *Tm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (OR ((&term_cell T P *Col))
            ((NOT (&term_cell T P))
             (&background (:C Col)))))))

  (RULE &cross_period
    (&term_at *D (:I *I0) *T)
    (axis_of D *A)
    (perp A (:A2 *C))
    (&term_period.fundamental_period (:key T) (:A C) *K))

  (RULE &repeat_uniform_outset1
    (&cross_period *D *I0 (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m7))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
    (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m10))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
    (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
    (relative (:Base I_m1) (:X 0) (:X_rel *B_)))

  (RULE &cell_at
    (&term_at *D *I *T)
    (&term_cell T *P *Col))

  (RULE &span
    (input *P)
    (dir_elem *D)
    (margin (:B P) D *K)
    (> K 0))

  (RULE &repeat
    (OR ((&cross_period *D *I0)
         (&cell_at D (:I I0) *P))
        ((&cross_period D I0 *K)
         (&cell_at D (:I I0) (:P *P2))
         (axis_of D (:A *A_m1))
         (perp (:A A_m1) (:A2 *A2_m2))
         (axis_of (:D *E) (:A A2_m2))
         (&span (:K *S))
         (divide (:T S) (:Side K) (:Gap 0) (:Remainder 0))
         (dir8_opposite (:D E) (:D2 *O_m4))
         (edge_inset (:D O_m4) (:K S) (:B *B1_m5))
         (edge_inset (:D E) (:K S) (:B *I_m7))
         (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
         (compose (:A P2) (:B V_m3) (:C P))
         (&repeat_uniform_outset1 (:K_ K) (:B_ *B))
         (ALL ((&cell_at (:D *Dm) (:I *I0m) (:P *Pm))
               (axis_of (:D Dm) (:A *A_m1m))
               (perp (:A A_m1m) (:A2 *A2_m2m))
               (axis_of (:D *Em) (:A A2_m2m))
               (&span (:K *Sm))
               (dir8_opposite (:D Em) (:D2 *O_m4m))
               (edge_inset (:D O_m4m) (:K Sm) (:B *B1_m5m))
               (edge_inset (:D Em) (:K Sm) (:B *I_m7m))
               (relative (:Base I_m7m) (:X 0) (:X_rel *B2_m6m))
               (compose (:A B1_m5m) (:B B2_m6m) (:C *V_m3m))
               (compose (:A Pm) (:B V_m3m) (:C P))
               (&cross_period (:D Dm) (:I0 I0m) (:K *Km))
               (axis_of (:D *D1_m9) (:A *A1_m10))
               (perp (:A A1_m10) (:A2 *A2_m11))
               (axis_of (:D *D2_m12) (:A A2_m11))
               (opposite (:D D1_m9) (:Opp *O_m15))
               (edge_inset (:D D1_m9) (:K Km) (:B *B1_m16))
               (edge_inset (:D O_m15) (:K Km) (:B *B2_m17))
               (compose (:A B1_m16) (:B B2_m17) (:C *B1_m13))
               (opposite (:D D2_m12) (:Opp *O_m18))
               (edge_inset (:D D2_m12) (:K Km) (:B *B1_m19))
               (edge_inset (:D O_m18) (:K Km) (:B *B2_m20))
               (compose (:A B1_m19) (:B B2_m20) (:C *B2_m14))
               (compose (:A B1_m13) (:B B2_m14) (:C *I_m8))
               (relative (:Base I_m8) (:X 0) (:X_rel B))
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0))))))

  (RULE &axis_cand_split1
    (&repeat *D *I0 (:P *P_))
    (axis_of (:D *E) (:A *C_))
    (axis_of (:D *D_m1) (:A C_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m3_)))

  (RULE &mirror_defect_split1
    (&repeat *D *I0 (:P *P_))
    (axis_of (:D *E) (:A *C_))
    (axis_of (:D *D_m1) (:A C_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L3_))
    (relative (:Base L3_) (:X P_) (:X_rel *P_across_)))

  (RULE &mirror_defect_uniform_outset1
    (&cross_period *D *I0 (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m7))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
    (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m10))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
    (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
    (relative (:Base I_m1) (:X 0) (:X_rel *B_)))

  (RULE &edge_part_seed
    (&edge_cell *T *E1 *P))

  ;; The part of term t in one color that holds its e edge.
  (INIT &edge_part Propagation
    (key ((OR ((&edge_cell ^T (:E1 ^E) *P)
               (&edge_part_seed T (:E1 E) (:P *Q))
               (&term_cell T (:P Q) *Col)
               (&term_cell T P Col))
              ((&edge_part_seed T (:E1 E) (:P Q))
               (&term_cell T (:P Q) Col)
               (&term_cell T P Col)
               (&edge_part_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&edge_part_seed T (:E1 E) (:P *Q2))
               (&term_cell T (:P Q2) (:Col *Col2))
               (&term_cell T (:P P2) (:Col Col2)))))
      (source ((:n P))
        (&edge_cell T (:E1 E) *P)
        (&edge_part_seed T (:E1 E) (:P *Q))
        (&term_cell T (:P Q) *Col)
        (&term_cell T P Col))
      (edge ((:a P) (:b P2))
        (&edge_part_seed T (:E1 E) (:P *Q))
        (&term_cell T (:P Q) *Col)
        (&term_cell T *P Col)
        (&edge_part_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&edge_part_seed T (:E1 E) (:P *Q2))
        (&term_cell T (:P Q2) (:Col *Col2))
        (&term_cell T (:P P2) (:Col Col2)))))

  (RULE &piece_shift_split1
    (&edge_part.reached (:key *T *E) (:n *P_))
    (axis_of (:D E) (:A *C_))
    (axis_of (:D *D_m1) (:A C_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m4_)))

  (RULE &piece_shift_split2
    (&edge_part.reached (:key *T *E) (:n *Q_))
    (axis_of (:D E) (:A *C_))
    (axis_of (:D *D_m1) (:A C_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
    (relative (:Base L2_) (:X Q_) (:X_rel *X_m6_)))

  (RULE &term_edge
    (&edge_cell *T *E1 *P)
    (axis_of (:D E1) *A)
    (&term_edge_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (RULE &back_line
    (&term_at *D (:I *I0) *T)
    (opposite D (:Opp *Db))
    (&term_edge T (:E1 Db) *L))

  (RULE &consecutive
    (&term_at *D *I)
    (step_offset D (:V *V_m1))
    (compose (:A I) (:B V_m1) (:C *I2))
    (&term_at D (:I I2)))

  (INIT &part_box BoundingBox
    (key ((&edge_part.reached (:key ^T ^E) (:n *P)))
      (cell (P)
        (&edge_part.reached (:n *P)))))

  (RULE &piece_shift
    (&term_at *D (:I *I0) *T)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2))
    (opposite (:D E1) (:Opp *E2))
    (axis_of (:D E1) (:A *C))
    (&part_box.box (:key T (:E E1)) *B)
    (&edge_part.reached (:key T (:E E1)) (:n *P))
    (ALL ((&edge_part.reached (:key (:T *Tm) (:E *Em)) (:n P))
          (&part_box.box (:key (:T Tm) (:E Em)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3m)))
         ((>= K_m3m 0)))
    (margin (:B P) (:D E2) (:K *K_m3))
    (margin B (:D E2) (:K K_m3))
    (&piece_shift_split1 (:P_ P) (:C_ C) (:L_ *L) (:X_m4_ *X_m4))
    (&edge_part.reached (:key T (:E E1)) (:n *Q))
    (ALL ((&edge_part.reached (:key (:T *Tmm) (:E *Emm)) (:n Q))
          (&part_box.box (:key (:T Tmm) (:E Emm)) B)
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X Q) (:X_rel *R_m2m))
          (margin (:B R_m2m) (:D D_m1m) (:K *K_m3mm)))
         ((>= K_m3mm 0)))
    (margin (:B Q) (:D E1) (:K *K_m5))
    (margin B (:D E1) (:K K_m5))
    (&piece_shift_split2 (:Q_ Q) (:C_ C) (:L2_ *L2) (:X_m6_ *X_m6))
    (relative (:Base L) (:X L2) (:X_rel *V)))

  (RULE &last
    (&term_at *D *I)
    (margin (:B I) D (:K 0)))

  (RULE &new_index
    (&last *D (:I *I0))
    (input *P)
    (margin (:B P) D (:K *M))
    (> M 0)
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K M) (:B *B1_m3))
    (edge_inset D (:K M) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A I0) (:B V_m1) (:C *I)))

  (RULE &target
    (OR ((&consecutive *D (:I *I0) (:I2 *I)))
        ((&consecutive D (:I2 I0))
         (&last D (:I I0))
         (&new_index D I))))

  (RULE &step
    (step_offset *D (:V *V_m1))
    (&target D *I0 (:I *I2))
    (OR ((&target D I0 (:I *I1)))
        ((= I1 I0)))
    (compose (:A I1) (:B V_m1) (:C I2)))

  (RULE &term_band
    (&term_at *D (:I *I0) *T)
    (&term_box.box (:key T) (:B *B2))
    (axis_elem *A)
    (&term_band_split1 (:B_ B2) (:A_ A) (:B_a_ *B) (:X_m1_ *X_m1)))

  ;; The piece the term at i0 gains on side e at each index: its end piece
  ;; there, flipped along the sequence within the term's band and moved out
  ;; past itself, once per step.
  (INIT &end_piece Propagation
    (key ((OR ((&term_at ^D (:I ^I0) *T)
               (axis_of D (:A *A_m1))
               (perp (:A A_m1) (:A2 *A2_m2))
               (axis_of (:D ^E) (:A A2_m2))
               (&edge_part.reached (:key T E) (:n *P)))
              ((&step D I0 *I1 *I2)
               (&piece_shift D I0 (:E1 E) *V)
               (axis_of D *A)
               (&term_band D I0 A (:B *B_al))
               (input P)
               (ALL ((&term_band (:D *Dm) (:I0 *I0m) (:A *Am) (:B B_al))
                     (dir_elem (:D *D_m1))
                     (relative (:Base B_al) (:X P) (:X_rel *R_m2))
                     (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                    ((>= K_m3 0)))
               (axis_inversion A (:T *F))
               (relative (:Base B_al) (:X P) (:X_rel *P_rel))
               (apply (:D F) (:P P_rel) (:P_out *P_rel2))
               (compose (:A B_al) (:B P_rel2) (:C *P2))
               (compose (:A P2) (:B V) (:C *Q)))))
      (source ((:n (:I I0) P))
        (&term_at D (:I I0) *T)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D E) (:A A2_m2))
        (&edge_part.reached (:key T E) (:n *P)))
      (edge ((:a (:I I1) P) (:b (:I I2) (:P Q)))
        (&step D I0 *I1 *I2)
        (&piece_shift D I0 (:E1 E) *V)
        (axis_of D *A)
        (&term_band D I0 A (:B *B_al))
        (input *P)
        (ALL ((&term_band (:D *Dm) (:I0 *I0m) (:A *Am) (:B B_al))
              (dir_elem (:D *D_m1))
              (relative (:Base B_al) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (axis_inversion A (:T *F))
        (relative (:Base B_al) (:X P) (:X_rel *P_rel))
        (apply (:D F) (:P P_rel) (:P_out *P_rel2))
        (compose (:A B_al) (:B P_rel2) (:C *P2))
        (compose (:A P2) (:B V) (:C *Q)))))

  (RULE &first_end
    (&repeat *D *I0)
    (&term_at D (:I I0) *T)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2))
    (&term_edge T E1 *L))

  (RULE &axis_cand
    (&repeat *D *I0 *P)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2))
    (axis_of (:D E1) (:A *C))
    (&axis_cand_split1 (:P_ P) (:C_ C) (:L_ *L) (:X_m3_ *X_m3))
    (OR ((step_offset (:D E1) (:V *V_m4))
         (compose (:A L) (:B V_m4) (:C *L2)))
        ((= L2 L))))

  (RULE &ends_elem
    (OR ((&first_end *D *I0 *E1 *L))
        ((&axis_cand D I0 E1 L *L2)
         (ALL ((axis_of (:D E1) (:A *C))
               (&repeat D I0 *P)
               (&mirror_defect_split1 (:P_ P) (:C_ C) (:L3_ *L3) (:P_across_ *P_across))
               (relative (:Base L3) (:X L) (:X_rel *V))
               (compose (:A L2) (:B V) (:C *L4))
               (compose (:A L4) (:B P_across) (:C *Q))
               (&cross_period D I0 *K)
               (&mirror_defect_uniform_outset1 (:K_ K) (:B_ *B))
               (relative (:Base B) (:X Q) (:X_rel *R_m1))
               (axis_of (:D *D1_m2) (:A *A1_m3))
               (opposite (:D D1_m2) (:Opp *O1_m4))
               (perp (:A A1_m3) (:A2 *A2_m5))
               (axis_of (:D *D2_m6) (:A A2_m5))
               (opposite (:D D2_m6) (:Opp *O2_m7))
               (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
               (>= K1_m8 0)
               (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
               (>= K2_m9 0)
               (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
               (>= K3_m10 0)
               (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
               (>= K4_m11 0))
              ((&repeat D I0 (:P Q))))
         (&first_end D I0 E1 (:L *L0))
         (dir_elem (:D E1))
         (margin (:B L) (:D E1) (:K *K1_m1))
         (margin (:B L0) (:D E1) (:K *K2_m2))
         (< K1_m1 K2_m2))))

  ;; The lines on side e from which the repeat reaches out, in order from the
  ;; term's own edge: that edge, and each line past it at which a mirror axis
  ;; of the repeat ends it.
  (INIT &ends Order
    (key ((&ends_elem ^D ^I0 (:E1 ^E) *L))
      (member ((:t L))
        (&ends_elem D I0 (:E1 E) *L))
      (before ((:a L) (:b L2))
        (&ends_elem D I0 (:E1 E) *L)
        (&ends_elem D I0 (:E1 E) (:L *L2))
        (dir_elem (:D E))
        (margin (:B L2) (:D E) (:K *K1_m1))
        (margin (:B L) (:D E) (:K *K2_m2))
        (< K1_m1 K2_m2))))

  ;; The one color of the cells on a term's back edge.
  (INIT &back_color Singleton
    (key ((opposite ^D (:Opp *Db))
          (&edge_cell ^T (:E1 Db) *P)
          (&term_cell T P *Col))
      (member ((:v Col))
        (opposite D (:Opp *Db))
        (&edge_cell T (:E1 Db) *P)
        (&term_cell T P *Col))))

  ;; The color of a term: the one color of its back edge, and where that edge
  ;; holds several, the one color of its two edges across the sequence.
  (INIT &term_color Singleton
    (key ((OR ((&back_color.value (:key ^D ^T) (:v *Col)))
              ((&back_color.plural (:key D T))
               (axis_of D (:A *A_m1))
               (perp (:A A_m1) (:A2 *A2_m2))
               (axis_of (:D *E) (:A A2_m2))
               (&edge_cell T (:E1 E) *P)
               (&term_cell T P Col))))
      (member ((:v Col))
        (OR ((&back_color.value (:v *Col)))
            ((&back_color.plural)
             (axis_of D (:A *A_m1))
             (perp (:A A_m1) (:A2 *A2_m2))
             (axis_of (:D *E) (:A A2_m2))
             (&edge_cell T (:E1 E) *P)
             (&term_cell T P Col))))))

  (RULE &shown_color
    (&term_at *D *I *T)
    (&term_color.value (:key D T) (:v *Col)))

  (RULE &period_cand
    (&term_at *D (:I *I0))
    (opposite D (:Opp *Db))
    (margin (:B I0) (:D Db) (:K 0))
    (OR ((&term_at D *I))
        ((&last D (:I *I1))
         (step_offset D (:V *V_m1))
         (compose (:A I1) (:B V_m1) (:C I))))
    (relative (:Base I0) (:X I) (:X_rel *V))
    (margin (:B V) (:D Db) *K)
    (> K 0))

  (INIT &least_period Order
    (key ((&shown_color ^D))
      (member ((:t K))
        (&period_cand D *K)
        (ALL ((&term_color.member (:key D *T)))
             ((&term_color.value (:key D T))))
        (ALL ((&shown_color D *I *Col)
              (dir8_opposite D (:D2 *O_m2))
              (edge_inset (:D O_m2) K (:B *B1_m3))
              (edge_inset D K (:B *I_m5))
              (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
              (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
              (compose (:A I) (:B V_m1) (:C *I2))
              (&shown_color D (:I I2) (:Col *Col2)))
             ((= Col Col2))))
      (score ((:t K) (:S K))
        (&period_cand D *K)
        (ALL ((&term_color.member (:key D *T)))
             ((&term_color.value (:key D T))))
        (ALL ((&shown_color D *I *Col)
              (dir8_opposite D (:D2 *O_m2))
              (edge_inset (:D O_m2) K (:B *B1_m3))
              (edge_inset D K (:B *I_m5))
              (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
              (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
              (compose (:A I) (:B V_m1) (:C *I2))
              (&shown_color D (:I I2) (:Col *Col2)))
             ((= Col Col2))))))

  (RULE &index_color
    (OR ((&shown_color *D *I *Col))
        ((&new_index D I)
         (&least_period.minimal (:key D) (:t *K))
         (&shown_color D (:I *I3) Col)
         (opposite D (:Opp *Db))
         (margin (:B I3) (:D Db) (:K *X))
         (divide (:T X) (:Side K) (:Gap 0) (:Remainder *R))
         (margin (:B I) (:D Db) (:K *X2))
         (divide (:T X2) (:Side K) (:Gap 0) (:Remainder R)))))

  (RULE &grown_frame
    (&target *D *I0 *I)
    (&back_line D I0 *L)
    (&index_color D I *Col))

  (RULE &hook
    (&term_at *D (:I *I0) *T)
    (opposite D (:Opp *Db))
    (&edge_part.reached (:key T (:E Db)) (:n *P)))

  (RULE &on_half
    (&term_at *D (:I *I0))
    (axis_of D *A)
    (perp A (:A2 *C))
    (&term_band D I0 (:A C) (:B *Bc))
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2))
    (opposite (:D E1) (:Opp *E2))
    (input *P)
    (relative (:Base Bc) (:X P) (:X_rel *X))
    (margin (:B X) (:D E1) (:K *K1))
    (margin (:B X) (:D E2) (:K *K2))
    (<= K1 K2))

  (INIT &half_box BoundingBox
    (key ((&hook ^D *I0 ^T *P)
          (&on_half D I0 (:E1 ^E) P))
      (cell (P)
        (&hook D *I0 T *P)
        (&on_half D I0 (:E1 E) P))))

  (RULE &hook_depth
    (&term_at *D (:I *I0) *T)
    (opposite D (:Opp *Db))
    (&part_box.box (:key T (:E Db)) *B)
    (axis_of D *A)
    (input *P)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A (:N *K)))

  (RULE &moves
    (&target *D *I0 *I)
    (OR ((&target D I0 (:I *I1)))
        ((= I1 I0)))
    (relative (:Base I1) (:X I) (:X_rel *V))
    (opposite D (:Opp *Db))
    (margin (:B V) (:D Db) (:K *N))
    (>= N 0))

  (RULE &steps
    (&target *D *I0 *I)
    (&moves D (:I1 I0) I (:N *M)))

  (RULE &stretch
    (OR ((&steps *D *I0 *I *M)
         (&term_at D (:I I0) *T)
         (OR ((axis_of D (:A *A_m1))
              (perp (:A A_m1) (:A2 *A2_m2))
              (axis_of (:D *E1) (:A A2_m2)))
             ((= E1 D)))
         (&edge_cell T E1 *P)
         (&span *K)
         (<= K M))
        ((&target D I0 I)
         (&cell_at D (:I I0) P)
         (OR ((axis_of D (:A *A_m12))
              (perp (:A A_m12) (:A2 *A2_m22))
              (axis_of (:D E1) (:A A2_m22)))
             ((= E1 D)))
         (= K 0))))

  (RULE &tent_seed
    (OR ((&target *D *I0 (:I *I_o))
         (&hook D I0 *T (:P *P_o))
         (OR ((opposite D (:Opp *Db))
              (&part_box.box (:key T (:E Db)) *B)
              (relative (:Base B) (:X P_o) (:X_rel *R_m1))
              (axis_of (:D *D1_m2) (:A *A1_m3))
              (opposite (:D D1_m2) (:Opp *O1_m4))
              (perp (:A A1_m3) (:A2 *A2_m5))
              (axis_of (:D *D2_m6) (:A A2_m5))
              (opposite (:D D2_m6) (:Opp *O2_m7))
              (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
              (>= K1_m8 0)
              (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
              (>= K2_m9 0)
              (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
              (>= K3_m10 0)
              (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
              (>= K4_m11 0)
              (margin (:B P_o) D (:K *K_m12))
              (margin B D (:K K_m12))
              (&hook_depth D I0 *K)
              (dir8_opposite D (:D2 *O_m14))
              (edge_inset (:D O_m14) K (:B *B1_m15))
              (edge_inset D K (:B *I_m17))
              (relative (:Base I_m17) (:X 0) (:X_rel *B2_m16))
              (compose (:A B1_m15) (:B B2_m16) (:C *V_m13))
              (compose (:A P_o) (:B V_m13) (:C *P)))
             ((= P P_o))))
        ((&cell_at D (:I I0) P)
         (&hook D I0)
         (= I_o I0)
         (= P_o P))))

  ;; Each term is read with its lines along the sequence measured from its own
  ;; back edge line and its lines across the sequence from the grid, so that a
  ;; growth carries the alignment across the sequence and the gap does not
  ;; enter. A shown term is the term at its own index grown to that index, and
  ;; each rule predicts the term at i0 grown to each index it grows to, from the
  ;; back edge line of the term at i0.
  (DEMONSTRATED &catalog
    (key ((OR ((&cell_at ^D *I *P *Col)
               (&back_line D (:I0 I) *L)
               (relative (:Base L) (:X P) (:X_rel *P_h)))
              ((&consecutive D I *I2))))
      (value ((:o (:I0 I) I) (:i P_h) (:v Col))
        (&cell_at D *I *P *Col)
        (&back_line D (:I0 I) *L)
        (relative (:Base L) (:X P) (:X_rel *P_h)))
      (demonstration ((:o (:I0 I) (:I I2)) (:o2 (:I0 I2) (:I I2)))
        (&consecutive D *I *I2)))
    (DEMO_RULE ($Stretch *E) "Each cell of the stretched term takes the color of the term at index i."
      (RULE &prediction
        ;; TODO head-term: Stretch: a prediction head site that is no label
        (&stretch *D (:E1 D) *I0 *I *P *K)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D E) (:A A2_m2))
        (&stretch D (:E1 E) I0 I P (:K *K2))
        (dir8_opposite D (:D2 *O_m4))
        (edge_inset (:D O_m4) K (:B *B1_m5))
        (edge_inset D K (:B *I_m7))
        (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
        (compose (:A P) (:B V_m3) (:C *Q1))
        (dir8_opposite (:D E) (:D2 *O_m9))
        (edge_inset (:D O_m9) (:K K2) (:B *B1_m10))
        (edge_inset (:D E) (:K K2) (:B *I_m12))
        (relative (:Base I_m12) (:X 0) (:X_rel *B2_m11))
        (compose (:A B1_m10) (:B B2_m11) (:C *V_m8))
        (compose (:A Q1) (:B V_m8) (:C *Q))
        (&grown_frame D I0 I *L *Col)
        (relative (:Base L) (:X Q) (:X_rel *P_h))))
    (DEMO_RULE ($PeriodEnd *E) "The term's own cells and its period blocks take the color of the term at index i."
      (RULE &period_block
        (&steps *D *I0 *I *M)
        (&cross_period D I0 *K)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E1) (:A A2_m2))
        (&term_at D (:I I0) *T)
        (&term_box.box (:key T) *B)
        (&term_cell T (:P *P2))
        (relative (:Base B) (:X P2) (:X_rel *X))
        (margin (:B X) (:D E1) (:K *J))
        (< J K)
        (&span (:K *S))
        (divide (:T S) (:Side K) (:Gap 0) (:Part *N) (:Remainder 0))
        (<= N M)
        (dir8_opposite (:D E1) (:D2 *O_m4))
        (edge_inset (:D O_m4) (:K S) (:B *B1_m5))
        (edge_inset (:D E1) (:K S) (:B *I_m7))
        (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
        (compose (:A P2) (:B V_m3) (:C *P)))

      (RULE &prediction
        ;; TODO head-term: PeriodEnd: a prediction head site that is no label
        (OR ((&target *D *I0 *I)
             (&cross_period D I0)
             (axis_of D (:A *A_m1))
             (perp (:A A_m1) (:A2 *A2_m2))
             (axis_of (:D E) (:A A2_m2))
             (&cell_at D (:I I0) *P))
            ((&period_block D (:E1 E) I0 I P)))
        (&grown_frame D I0 I *L *Col)
        (relative (:Base L) (:X P) (:X_rel *P_h))))
    (DEMO_RULE $MirrorEnds "The repeat between the two ends takes the color of the term at index i."
      (RULE &prediction_split1
        (&repeat *D *I0 (:P *P_))
        (axis_of (:D *E) (:A *C_))
        (axis_of (:D *D_m1) (:A C_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *L3_))
        (relative (:Base L3_) (:X P_) (:X_rel *X_m1_)))

      (RULE &mirror_reach
        (&steps *D *I0 *I *M)
        (&ends.rank (:key D I0 (:E *E1)) (:t *L) (:R M)))

      (RULE &prediction
        ;; TODO head-term: MirrorEnds: a prediction head site that is no label
        (&mirror_reach *D *I0 (:E1 *E) *I *L)
        (opposite (:D E) (:Opp *E2))
        (&mirror_reach D I0 (:E1 E2) I (:L *L2))
        (&repeat D I0 *P)
        (axis_of (:D E) (:A *C))
        (&prediction_split1 (:P_ P) (:C_ C) (:L3_ *L3) (:X_m1_ *X_m1))
        (dir_elem (:D E))
        (margin (:B L3) (:D E) (:K *K1_m2))
        (margin (:B L) (:D E) (:K *K2_m3))
        (>= K1_m2 K2_m3)
        (dir_elem (:D E2))
        (margin (:B L3) (:D E2) (:K *K1_m4))
        (margin (:B L2) (:D E2) (:K *K2_m5))
        (>= K1_m4 K2_m5)
        (&grown_frame D I0 I (:L *L_b) *Col)
        (relative (:Base L_b) (:X P) (:X_rel *P_h))))
    (DEMO_RULE $FlippedEnds "The term's own cells keep their colors, and each piece gained at index i_c takes the color of the term there."
      (RULE &prediction
        ;; TODO head-term: FlippedEnds: a prediction head site that is no label
        (&target *D *I0 *I)
        (OR ((&cell_at D (:I I0) *P *Col))
            ((&end_piece.reached (:key D I0) (:n (:I *I_c) P))
             (&target D I0 (:I I_c))
             (&moves D (:I1 I_c) I)
             (&index_color D (:I I_c) Col)))
        (&back_line D I0 *L)
        (relative (:Base L) (:X P) (:X_rel *P_h))))
    (DEMO_RULE $SplitStep "A cell from the term's own cells keeps its color, and a cell from a hook added at index i_c takes the color of the term there."
      (RULE &half_out
        (&term_at *D (:I *I0) *T)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E1) (:A A2_m2))
        (opposite (:D E1) (:Opp *E2))
        (&half_box.box (:key D T (:E E1)) *B)
        (&half_box.cell (:key D T (:E E1)) *P)
        (ALL ((&half_box.cell (:key (:D *Dm) (:T *Tm) (:E *Em)) P)
              (&half_box.box (:key (:D Dm) (:T Tm) (:E Em)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3m)))
             ((>= K_m3m 0)))
        (margin (:B P) (:D E2) (:K *K_m3))
        (margin B (:D E2) (:K K_m3))
        (&half_box.cell (:key D T (:E E1)) (:P *Q))
        (ALL ((&half_box.cell (:key (:D *Dmm) (:T *Tmm) (:E *Emm)) (:P Q))
              (&half_box.box (:key (:D Dmm) (:T Tmm) (:E Emm)) B)
              (dir_elem (:D *D_m1m))
              (relative (:Base B) (:X Q) (:X_rel *R_m2m))
              (margin (:B R_m2m) (:D D_m1m) (:K *K_m3mm)))
             ((>= K_m3mm 0)))
        (margin (:B Q) (:D E1) (:K *K_m4))
        (margin B (:D E1) (:K K_m4))
        (relative (:Base P) (:X Q) (:X_rel *V))
        (margin (:B V) (:D E2) (:K *W)))

      (RULE &tent
        (&tent_seed *D *I0 *I_o (:P *P2) *P_o)
        (&moves D (:I1 I_o) *I *N)
        (&target D I0 I)
        (OR ((> N 0)
             (&on_half D I0 (:E1 *E) (:P P2))
             (&half_out D I0 (:E1 E) *W)
             (&hook_depth D I0 *K)
             (&span (:K *S2))
             (divide (:T S2) (:Side K) (:Gap 0) (:Part N) (:Remainder 0))
             (OR ((= W 0)
                  (dir8_opposite D (:D2 *O_m2))
                  (edge_inset (:D O_m2) (:K S2) (:B *B1_m3))
                  (edge_inset D (:K S2) (:B *I_m5))
                  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
                  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
                  (compose (:A P2) (:B V_m1) (:C *P)))
                 ((&span (:K *S1))
                  (divide (:T S1) (:Side W) (:Gap 0) (:Part N) (:Remainder 0))
                  (dir8_opposite (:D E) (:D2 *O_m7))
                  (edge_inset (:D O_m7) (:K S1) (:B *B1_m8))
                  (edge_inset (:D E) (:K S1) (:B *I_m10))
                  (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
                  (compose (:A B1_m8) (:B B2_m9) (:C *V_m6))
                  (compose (:A P2) (:B V_m6) (:C *Q1))
                  (dir8_opposite D (:D2 *O_m12))
                  (edge_inset (:D O_m12) (:K S2) (:B *B1_m13))
                  (edge_inset D (:K S2) (:B *I_m15))
                  (relative (:Base I_m15) (:X 0) (:X_rel *B2_m14))
                  (compose (:A B1_m13) (:B B2_m14) (:C *V_m11))
                  (compose (:A Q1) (:B V_m11) (:C P)))))
            ((= N 0)
             (= P P2))))

      (RULE &prediction
        ;; TODO head-term: SplitStep: a prediction head site that is no label
        (&tent *D *I0 *I *P (:I_o *I_c) *P_o)
        (OR ((= I_c I0)
             (&cell_at D (:I I0) (:P P_o) *Col))
            ((!= I_c I0)
             (&index_color D (:I I_c) Col)))
        (&back_line D I0 *L)
        (relative (:Base L) (:X P) (:X_rel *P_h)))))

  (RULE &grown
    (&catalog (:key *D) (:o *I0 *I) (:i *P_h) (:v *Col))
    (&last D (:I I0))
    (&new_index D I)
    (&least_period.minimal (:key D)))

  (RULE &grid_line
    (input *P)
    (axis_elem *A)
    (&grid_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (RULE &gap_domain
    (&consecutive *D *I *I2)
    (&term_at D I *T)
    (&term_at D (:I I2) (:T *T2)))

  ;; The lines between two consecutive terms.
  (INIT &gap Cardinality
    (key ((&gap_domain ^T ^T2))
      (member ((:m L))
        (&term_box.box (:key T) *B)
        (&term_box.box (:key (:T T2)) (:B *B2))
        (dir_elem *D)
        (opposite D (:Opp *Db))
        (axis_of D *A)
        (&grid_line A *L)
        (dir_elem D)
        (margin (:B L) D (:K *K1_m1))
        (margin B D (:K *K2_m2))
        (< K1_m1 K2_m2)
        (dir_elem (:D Db))
        (margin (:B L) (:D Db) (:K *K1_m3))
        (margin (:B B2) (:D Db) (:K *K2_m4))
        (< K1_m3 K2_m4))))

  (INIT &gap_size Singleton
    (member ((:v N))
      (&gap.size *N)))

  (RULE_OR_DET &term_gap "The count of lines between consecutive terms."
    (&gap_size.value (:v *G)))

  (RULE &grown_front
    (&grown *D *I *P_h)
    (ALL ((&grown (:D *Dm) I P_h)
          (&grown (:D Dm) I (:P_h *Q_h))
          (dir_elem (:D Dm))
          (margin (:B Q_h) (:D Dm) (:K *K1_m1))
          (margin (:B P_h) (:D Dm) (:K *K2_m2)))
         ((>= K1_m1 K2_m2)))
    (opposite D (:Opp *Db))
    (margin (:B P_h) (:D Db) *K))

  (RULE &advance
    (OR ((&last *D (:I *I1)))
        ((&new_index D (:I I1))))
    (step_offset D (:V *V_m1))
    (compose (:A I1) (:B V_m1) (:C *I2))
    (&new_index D (:I I2))
    (axis_of D *A)
    (&grid_line A (:L *L1))
    (&term_gap *G)
    (dir8_opposite D (:D2 *O_m3))
    (edge_inset (:D O_m3) (:K G) (:B *B1_m4))
    (edge_inset D (:K G) (:B *I_m6))
    (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
    (compose (:A B1_m4) (:B B2_m5) (:C *V_m2))
    (compose (:A L1) (:B V_m2) (:C *L22))
    (step_offset D (:V *V_m7))
    (compose (:A L22) (:B V_m7) (:C *L2)))

  ;; The line of each term's front edge where it stands, from the last shown
  ;; term on.
  (INIT &front Propagation
    (source ((:n I (:P L)))
      (&grown *D)
      (&last D *I)
      (&term_at D I *T)
      (&term_edge T (:E1 D) *L))
    (edge ((:a (:I I1) (:P L1)) (:b (:I I2) (:P L)))
      (&grown *D (:I *I2))
      (&advance D *I1 *L1 I2 (:L2 *L3))
      (&grown_front (:I I2) *K)
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) K (:B *B1_m3))
      (edge_inset D K (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A L3) (:B V_m1) (:C *L)))))

(OUTPUT crop-window "the output is the window, marks included in its extent; each cell takes the color the continued sequence draws there, and &background where it draws nothing.")

(ALTS $drawn "which terms the output draws" $EveryTerm
  (ALT $NewTermsOnly
    (OUTPUT crop-window "only the terms past the last shown one are drawn")
    (RULE &drawn
      (&grown *D *I *P_h *Col)
      (&front.reached (:n (:I *I1) (:P *L1)))
      (&advance D I1 L1 (:I2 I) (:L2 *L_b))
      (opposite D (:Opp *Db))
      (margin (:B P_h) (:D Db) *K)
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) K (:B *B1_m3))
      (edge_inset D K (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A L_b) (:B V_m1) (:C *L))
      (axis_of D *A)
      (&drawn_split1 (:P_h_ P_h) (:A_ A) (:X_m6_ *X_m6) (:P_across_ *P_across))
      (compose (:A L) (:B P_across) (:C *P)))))

(ALTS $extent "how far the window reaches" $MarkBox
  (ALT $ElbowBox
    (OUTPUT crop-window "the window is the box of the marks' corner cells, the cells with a mark neighbor on both axes")
    (RULE &window
      (&elbow_box.box *B))))

(RULE &drawn_split1
  (&grown *D *I (:P_h *P_h_) *Col)
  (axis_of D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_h_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_h_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m6_))
  (relative (:Base X_m6_) (:X P_h_) (:X_rel *P_across_)))

(RULE &drawn
  (OR ((&grown *D *I *P_h *Col)
       (&front.reached (:n (:I *I1) (:P *L1)))
       (&advance D I1 L1 (:I2 I) (:L2 *L_b))
       (opposite D (:Opp *Db))
       (margin (:B P_h) (:D Db) *K)
       (dir8_opposite D (:D2 *O_m2))
       (edge_inset (:D O_m2) K (:B *B1_m3))
       (edge_inset D K (:B *I_m5))
       (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
       (compose (:A L_b) (:B V_m1) (:C *L))
       (axis_of D *A)
       (&drawn_split1 (:P_h_ P_h) (:A_ A) (:X_m6_ *X_m6) (:P_across_ *P_across))
       (compose (:A L) (:B P_across) (:C *P)))
      ((&term_cell P Col))))

(RULE &window
  (&mark_box.box *B))

(RULE &output
  (&window *B)
  (input (:P *P2))
  (ALL ((&window B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&drawn (:P P2) *Col)
       (&grown))
      ((&grown)
       (NOT (&drawn (:P P2)))
       (NOT (&drawn (:P P2)))
       (&background (:C Col)))))
