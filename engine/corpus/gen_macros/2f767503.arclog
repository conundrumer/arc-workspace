;; 2f767503

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &eye RarestColor)

(RULE &eye2
  (input *P *Col)
  (&eye (:C Col)))

(DET &lens UnchangedColor)

(RULE &aim
  (&eye2 *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&lens (:C Col)))

(RULE &sight_dir
  (&aim *D))

(RULE &sight_node
  (input *P))

(RULE &sight_source
  (&eye2 *P))

(INIT &sight Distance
  (key ((&sight_source (:P ^O))
        (&sight_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:P O))
           (&sight_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:P Q)))
          ((&sight_source (:P O))
           (&sight_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:P Q))
           (= A2 O))
          ((&sight_source (:P O))
           (&sight_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:P Q)))))
    (source ((:n O))
      (&sight_source (:P O))
      (&sight_dir D))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &speck ColorDomain)

(RULE &speck2
  (input *P *Col)
  (&speck (:C Col)))

(INIT &objs Propagation
  (source ((:n P))
    (&sight_ray *P)
    (&speck2 P))
  (edge ((:a P) (:b P2))
    (&speck2 *P)
    (&objs_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&speck2 (:P P2))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&objs.reached (:n P))
       (&bg (:C *Col)))
      ((NOT (&objs.reached (:n P)))
       (= Col Col_in))))
