;; 7b5033c1

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(DET &line_axis AxisDomain)

;; Bg is the commonest color.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

(RULE &link
  (&ink *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&ink (:P Q)))

(RULE &end
  (&link *P)
  (ALL ((&link P *Q)
        (&link P (:Q *Q2)))
       ((= Q Q2))))

(RULE &head
  (&line_axis *A)
  (axis_of *D A)
  (&end *P)
  (&end (:P *Q))
  (dir_elem D)
  (margin (:B P) D (:K *K1_m1))
  (margin (:B Q) D (:K *K2_m2))
  (< K1_m1 K2_m2))

;; Each path cell's place along the walk from the head: its hop count.
(INIT &path Distance
  (key ((OR ((&head ^D)
             (&link *P *Q))
            ((&head D P))))
    (edge ((:a P) (:b Q))
      (&head D)
      (&link *P *Q))
    (source ((:n P))
      (&head D *P))))

;; The output line: one cell per path cell.
(INIT &total Cardinality
  (member ((:m P))
    (&ink *P)))

(INIT &line Frame
  (key ((&line_axis ^A))
    (extent (A N)
      (&total.size *N))))

(RULE &output
  (&path.distance (:key *D) (:n *P2) *K)
  (input (:P P2) *Col)
  (&line.cell *P)
  (margin (:B P) D K))
