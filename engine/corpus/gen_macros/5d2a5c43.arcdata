(param &frame_dim (Axis number) (AXIS_V 6) (AXIS_H 4))
(param &gap number (1))
(param &tile_decompose (Position Position Position) (Division
  ((:A AXIS_V) (:Count 1) (:Size 6) (:Gap 0))
  ((:A AXIS_H) (:Count 2) (:Size 4) (:Gap 1))))
(param &divide_axis Axis (AXIS_H))
(param &divisor number (2))
(param &combine (Ident Color Position Color)
  (0 0 (grid
    (0 0)))
  (1 8 (grid
    (0 4)))
  (2 8 (grid
    (4 0)))
  (3 8 (grid
    (4 4))))
(param &frame Position (Frame
  ((:A AXIS_V) (:N 6))
  ((:A AXIS_H) (:N 4))))
(param &bg Color (0))
(param &out_fill Color (8))
