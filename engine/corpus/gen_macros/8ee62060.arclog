;; 8ee62060

(DET &block_size TileDim)

(DET &block_division_axis_split1
  (ex_input *E (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &block_division_side
  (axis_elem *A)
  (&block_size (:D *K)))

(DET &block_division_axis
  (OR ((ex_input *E *P)
       (ex_output E)
       (axis_elem *A)
       (&block_size (:D *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input (:E *E2) P)
       (ex_output (:E E2))
       (axis_elem A)
       (NOT (&block_division_side A))
       (&block_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &block_division_tile
  (&block_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&block_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &block_division2_axis_split1
  (ex_input *E (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &block_division2_side
  (axis_elem *A)
  (&block_size (:D *K)))

(DET &block_division2_axis
  (OR ((ex_input *E *P)
       (ex_output E)
       (axis_elem *A)
       (&block_size (:D *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input (:E *E2) P)
       (ex_output (:E E2))
       (axis_elem A)
       (NOT (&block_division2_side A))
       (&block_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &block_division2_tile
  (&block_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&block_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &block_src_division_axis_split1
  (ex_input *E (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &block_src_division_side
  (axis_elem *A)
  (&block_size (:D *K)))

(DET &block_src_division_axis
  (OR ((ex_input *E *P)
       (ex_output E)
       (axis_elem *A)
       (&block_size (:D *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input (:E *E2) P)
       (ex_output (:E E2))
       (axis_elem A)
       (NOT (&block_src_division_side A))
       (&block_src_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &block_src_division_tile
  (&block_src_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&block_src_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &output_division_axis_split1
  (input (:P *P_in_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_in_) (:X_rel *X_m1_)))

(RULE &output_division_side
  (axis_elem *A)
  (&block_size (:D *K)))

(RULE &output_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&block_size (:D *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (NOT (&output_division_side A))
       (&output_division_axis_split1 (:P_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &output_division_tile
  (&output_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&output_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &block_src
  (ex_input *E (:P *P_grid) (:Col *V))
  (ex_output E)
  (&block_src_division_tile (:P P_grid) (:P_outer *P) (:P_inner *P_local)))

;; At each within-block offset, each train input's block-grid, matched
;; against itself.
(INIT &block Agreement
  (key ((OR ((ex_input ^E (:P *P_grid) *Col)
             (ex_output E)
             (&block_division_tile (:P P_grid) (:P_outer *P_block) (:P_inner ^P_local))
             (d4_elem *D)
             (apply D (:P P_block) (:P_out *Q)))
            ((ex_input E (:P P_grid) Col)
             (ex_output E)
             (&block_division2_tile (:P P_grid) (:P_outer P_block) (:P_inner P_local)))
            ((&block_src E P_local (:P P_block) (:V Col)))))
    (source ((:i P_block) (:v Col))
      (ex_input E (:P *P_grid) *Col)
      (ex_output E)
      (&block_division2_tile (:P P_grid) (:P_outer *P_block) (:P_inner P_local)))
    (target ((:i P_block) (:v Col))
      (&block_src E P_local (:P *P_block) (:V *Col)))
    (correspondence ((:m D) (:i P_block) (:j Q))
      (ex_input E (:P *P_grid) *Col)
      (ex_output E)
      (&block_division_tile (:P P_grid) (:P_outer *P_block) (:P_inner P_local))
      (d4_elem *D)
      (apply D (:P P_block) (:P_out *Q)))))

(DET &moved
  (&block.mismatch (:key *E) (:m *D)))

(DET &kept
  (ex_input *E)
  (ex_output E)
  (d4_elem *D)
  (NOT (&moved E D)))

(DET &block_d4
  (d4_elem *D)
  (NOT (&kept D))
  (ONE))

(INIT &output_tiling Tiling
  (outer ((:P P_block_out))
    (&output_division_tile (:P_outer *P_block_in))
    (&block_d4 *D)
    (apply D (:P P_block_in) (:P_out *P_block_out)))
  (inner ((:P P_local))
    (&output_division_tile (:P_inner *P_local))))

(RULE &output
  (input (:P *P_in) *Col)
  (&output_division_tile (:P P_in) (:P_outer *P_block_in) (:P_inner *P_local))
  (&block_d4 *D)
  (apply D (:P P_block_in) (:P_out *P_block_out))
  (&output_tiling.cell (:P_outer P_block_out) (:P_inner P_local) *P))
