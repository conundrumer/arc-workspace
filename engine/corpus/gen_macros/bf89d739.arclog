;; bf89d739

(INPUT scattered-dots "single cells of color 2 lie apart on a field of &background, no two touching."

  (INIT &field_count Cardinality
    (key ((ex_input *E *P (:Col ^C)))
      (member ((:m E P))
        (ex_input *E *P (:Col C)))))

  ;; The field: the commonest color of the inputs.
  (INIT &field Order
    (member ((:t C))
      (&field_count.size (:key *C)))
    (score ((:t C) (:S Count))
      (&field_count.size (:key *C) (:N *Count))))

  (DET_OR_RULE &background DominantColor
    (&field.maximal (:t *C))))

(INPUT one-aligned-pair "exactly two dots share a row or a column, and no other two dots share a row or a column.")

(INPUT within-span "every other dot lies off the pair's line, level with a cell strictly between the pair's two dots.")

(OUTPUT trunk "each two dots that share a row or a column with no dot between them form a trunk: each background cell strictly between them takes &line_color."

  (RULE &dot
    (input *P (:Col *C))
    (NOT (&background C)))

  (DET &line_color
    (ex_output *E *P (:Col *C))
    (ex_input E P (:Col *C0))
    (!= C0 C))

  (INIT &dots_box BoundingBox
    (cell (P)
      (&dot *P))))

(OUTPUT branch "a dot off a trunk's line, level with a cell strictly between the trunk's two dots, branches onto that cell: each background cell strictly between the dot and that cell takes &line_color.")

(OUTPUT keep "every other cell keeps its input color."

  (RULE &span_dir
    (axis_elem (:A *Key))
    (axis4_of *D (:A Key)))

  (RULE &span_node
    (axis_elem (:A *Key))
    (input *P))

  (RULE &span_source
    (&dot *P)
    (axis_elem (:A *Key)))

  ;; The cells with a dot on each side along axis a.
  (INIT &span Distance
    (key ((&span_source (:Key ^Ky) (:P ^O))
          (&span_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&span_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&span_node (:Key Ky) (:P Q)))
            ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&span_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&span_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&span_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&span_source (:Key Ky) (:P O))
        (&span_dir (:Key Ky) D))))

  (RULE &span_ray
    (&span.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (RULE &span_between
    (axis_elem (:A *Key))
    (input *P)
    (axis4_of *D (:A Key))
    (dir8_opposite D (:D2 *O))
    (&span_ray Key P D)
    (&span_ray Key P (:D O)))

  (RULE &between_pair
    (&span_between (:Key *A) *P)
    (NOT (&dot P)))

  (RULE &landing
    (&between_pair *A *P))

  (RULE &line_cell
    (&dot (:P *Q))
    (&dot (:P *Q2))
    (!= Q Q2)
    (axis_elem *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B Q) (:D D_m2) (:K *K_m3))
    (margin (:B Q2) (:D D_m2) (:K K_m3))
    (input *P)
    (perp A (:A2 *A2_m4))
    (axis_of (:D *D_m5) (:A A2_m4))
    (margin (:B P) (:D D_m5) (:K *K_m6))
    (margin (:B Q) (:D D_m5) (:K K_m6))))

(ALTS $beyond "what a dot gets when its level is not strictly between the pair's two dots" $WithinSpan
  (ALT $TrunkSpansAll
    (INPUT within-span "a dot off the pair's line may lie at any level")
    (OUTPUT trunk "each line that holds two dots carries a trunk across the bounding box of all the dots: each background cell of the line inside that box takes &line_color"
      (RULE &landing
        (&line_cell *A *P)
        (&dots_box.box *B)
        (ALL ((&line_cell (:A *Am) P)
              (&dots_box.box B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))))
    (OUTPUT branch "every dot off a trunk's line branches onto it")
    (RULE &paint
      (OR ((&landing *P))
          ((&landing *A (:P *T))
           (perp A *A2)
           (&dot_line (:A A2) *X (:P T))
           (&dot_line (:A A2) X P)
           (axis_of *D (:A A2))
           (dir_elem D)
           (margin (:B X) D (:K *K1_m1))
           (margin (:B P) D (:K *K2_m2))
           (< K1_m1 K2_m2)
           (dir_elem D)
           (margin (:B P) D (:K *K1_m3))
           (margin (:B T) D (:K *K2_m4))
           (< K1_m3 K2_m4)))))
  (ALT $BranchToLine
    (INPUT within-span "a dot off the pair's line may lie at any level")
    (OUTPUT branch "every dot off a trunk's line branches onto that line, past the trunk's end where its level is beyond the pair"
      (RULE &landing
        (&line_cell *A *P)))
    (RULE &paint
      (OR ((&between_pair *P))
          ((&landing *A (:P *T))
           (perp A *A2)
           (&dot_line (:A A2) *X (:P T))
           (&dot_line (:A A2) X P)
           (axis_of *D (:A A2))
           (dir_elem D)
           (margin (:B X) D (:K *K1_m1))
           (margin (:B P) D (:K *K2_m2))
           (< K1_m1 K2_m2)
           (dir_elem D)
           (margin (:B P) D (:K *K1_m3))
           (margin (:B T) D (:K *K2_m4))
           (< K1_m3 K2_m4))))))

(ALTS $dots "which cells are dots" $NonBackground
  (ALT $DotsOfOneColor
    (INPUT scattered-dots "only cells of &dot_color are dots; a cell of another color that is not the background is kept and joins nothing"
      (DET_OR_RULE &dot_color RarestColor
        (ex_input (:Col *C))
        (NOT (&background C)))

      (RULE &dot
        (input *P (:Col *C))
        (&dot_color C)))))

(RULE &span_end
  (&span_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray Key (:P Q) D Origin)))

(RULE &dot_line
  (&dot (:P *X))
  (axis_elem *A)
  (input *P)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B X) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3)))

(RULE &paint
  (OR ((&landing *A (:P *T))
       (perp A *A2)
       (&dot_line (:A A2) *X (:P T))
       (&dot_line (:A A2) X *P)
       (axis_of *D (:A A2))
       (dir_elem D)
       (margin (:B X) D (:K *K1_m1))
       (margin (:B P) D (:K *K2_m2))
       (< K1_m1 K2_m2)
       (dir_elem D)
       (margin (:B P) D (:K *K1_m3))
       (margin (:B T) D (:K *K2_m4))
       (< K1_m3 K2_m4))
      ((&between_pair P))))

(RULE &drawn
  (&paint *P)
  (input P (:Col *C))
  (&background C))

(RULE &output
  (input *P (:Col *C))
  (IF ((&drawn P))
      ((&line_color (:C *Col)))
      ((= Col C))))
