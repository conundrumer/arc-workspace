;; 73182012

(DET &bg DominantColor)

(INIT &ex_box BoundingBox
  (key ((ex_output ^E))
    (cell (P)
      (ex_input E *P *Col)
      (NOT (&bg (:C Col))))))

(DET &ex_box_cell_inside1
  (ex_input *E (:P *P_) *Col)
  (&ex_box.box (:key E) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &ex_box_cell
  (ex_input *E *P *Col)
  (&ex_box.box (:key E) *B)
  (NOT (&ex_box_cell_inside1 (:P_ P) (:B_ B)))
  (relative (:Base B) (:X P) (:X_rel *P_box)))

(DET &divisor_division_cell
  (&ex_box_cell (:P_box *P))
  (sub_extent P (:K *Key)))

(INIT &divisor_division_sides ExtentDivisions
  (key ((&divisor_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&divisor_division_cell (:Key Ky) *P))))

(DET &divisor_division_axis_split1
  (&divisor_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &divisor_division_parts_held
  (axis_elem (:A *A2))
  (&ex_box_cell *P_box)
  (sub_extent (:P P_box) (:K *N)))

(DET &divisor_division_axis
  (OR ((&divisor_division_cell *Key *P)
       (axis_elem *A)
       (&ex_box_cell *P_box)
       (sub_extent (:P P_box) (:K Key))
       (&divisor_division_sides.division (:key (:Ky Key)) A (:N Key) *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&divisor_division_cell Key P)
       (axis_elem A)
       (&ex_box_cell (:P_box *P_box2))
       (sub_extent (:P P_box2) (:K Key))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N Key)))
      ((&divisor_division_cell Key P)
       (axis_elem A)
       (NOT (&divisor_division_parts_held (:N Key) (:A2 A)))
       (&divisor_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &divisor_division_tile
  (&divisor_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&divisor_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &divisor
  (&ex_box_cell *E *P_box)
  (axis_elem *A)
  (sub_extent (:P P_box) A (:K *N))
  (&divisor_division_tile (:Key N) (:P P_box) *P_inner)
  (ex_output E (:P *Q))
  (perp A (:A2 *A2_m1))
  (frame_extent (:P P_inner) A (:N *K1))
  (frame_extent (:P P_inner) (:A A2_m1) (:N *K2))
  (perp A (:A2 *A2_m2))
  (frame_extent (:P Q) A (:N K1))
  (frame_extent (:P Q) (:A A2_m2) (:N K2)))

(DET &out_tile_division_cell
  (&ex_box_cell (:P_box *P))
  (&divisor (:N *Key)))

(INIT &out_tile_division_sides ExtentDivisions
  (key ((&out_tile_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&out_tile_division_cell (:Key Ky) *P))))

(DET &out_tile_division_axis_split1
  (&out_tile_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &out_tile_division_parts_held
  (axis_elem *A)
  (&divisor *N))

(DET &out_tile_division_axis
  (OR ((&out_tile_division_cell *Key *P)
       (axis_elem *A)
       (&divisor (:N Key))
       (&out_tile_division_sides.division (:key (:Ky Key)) A (:N Key) *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&out_tile_division_cell Key P)
       (axis_elem A)
       (&divisor (:N Key))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N Key)))
      ((&out_tile_division_cell Key P)
       (axis_elem A)
       (NOT (&out_tile_division_parts_held (:N Key) A))
       (&out_tile_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &out_tile_division_tile
  (&out_tile_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&out_tile_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; Where each output occurs in its box, as a window of the box's frame.
(INIT &seat Occurrences
  (key ((OR ((&ex_box_cell ^E *P_box *Col))
            ((ex_output E (:P *Q) Col)
             (&ex_box.box (:key E)))))
    (cell ((:P P_box) (:v Col))
      (&ex_box_cell E *P_box *Col))
    (shape ((:P Q) (:v Col))
      (ex_output E (:P *Q) *Col)
      (&ex_box.box))))

(DET &out_tile_inside1
  (&ex_box_cell *E (:P_box *P_box_))
  (&seat.occurrence (:key E) (:P *M_))
  (dir_elem (:D *D_m1))
  (relative (:Base M_) (:X P_box_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &box_cell
  (&bbox.box *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_box)))

(INIT &output_division_sides ExtentDivisions
  (frame ((:P P_box))
    (&box_cell *P_box)))

(RULE &output_division_axis_split1
  (&box_cell (:P_box *P_box_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_box_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_box_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_box_) (:X_rel *X_m1_)))

(RULE &output_division_parts
  (axis_elem *A)
  (&divisor *N))

(RULE &output_division_axis
  (OR ((&box_cell (:P_box *P))
       (axis_elem *A)
       (&divisor *N)
       (&output_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&box_cell (:P_box P))
       (axis_elem A)
       (&divisor (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&box_cell (:P_box P))
       (axis_elem A)
       (NOT (&output_division_parts A))
       (&output_division_axis_split1 (:P_box_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &output_division_tile
  (&output_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&output_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &out_tile
  (&seat.occurrence (:key *E) (:P *M))
  (&ex_box_cell E *P_box)
  (NOT (&out_tile_inside1 (:P_box_ P_box) (:M_ M)))
  (relative (:Base M) (:X P_box) (:X_rel *P_rel))
  (&out_tile_division_tile (:P P_box) (:P_outer *P_tile) (:P_inner P_rel)))

(ALTS $choice "how the corner region is bounded" $Half
  (ALT $Window
    (DET &win_dim ConstOutDim)

    (INIT &win Frame
      (extent (A (:N K))
        (&win_dim (:N *K))
        (axis_elem *A)))

    (DET &corner
      (&seat.occurrence (:P *M))
      (corner_dist (:P M) (:Diag *D) (:K 0)))

    (RULE &output
      (&box_cell *P_box *Col)
      (&win.cell *P)
      (&corner (:D *Diag))
      (ALL ((&box_cell P_box (:Col *Colm))
            (corner_dir (:C Diag) (:D *D_m1))
            (margin (:B P_box) (:D D_m1) (:K *K1_m2))
            (margin (:B P) (:D D_m1) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))))

(RULE &output
  (&box_cell *P_box *Col)
  (&output_division_tile (:P P_box) (:P_outer *P_tile) (:P_inner *P))
  (&out_tile P_tile))
