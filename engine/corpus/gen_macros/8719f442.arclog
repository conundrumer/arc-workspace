;; 8719f442

(DET &ring_width TileDim)

(RULE &seat_delta_uniform_inset1
  (&ring_width (:D *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *P_)))

(RULE &seat_delta
  (&ring_width (:D *K))
  (&seat_delta_uniform_inset1 (:K_ K) (:P_ *P)))

(RULE &seated
  (input (:P *P_in))
  (&seat_delta (:P *Delta))
  (compose (:A P_in) (:B Delta) (:C *P_tile)))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&seated *P_tile))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(INIT &cell_tiling2 Tiling
  (outer ((:P P_tile))
    (&seated (:P_tile *P_seat))
    (step_offset (:D *D_m1) (:V *V_m2))
    (compose (:A P_seat) (:B V_m2) (:C *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg ColorDomain)

(DET &fill ColorDomain)

(RULE &active
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &cell
  (OR ((&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))
      ((&cell_tiling2.cell (:P_outer P_tile) (:P_inner P_intile) (:P P_grid)))))

(RULE &copy
  (&active (:P *P_in))
  (&seated P_in (:P_tile *P_seat))
  (dir_elem *D)
  (margin (:B P_in) D (:K 0))
  (step_offset D (:V *V_m1))
  (compose (:A P_seat) (:B V_m1) (:C *P_tile)))

(RULE &block
  (input (:P *P_in) *Col)
  (&seated P_in *P_tile))

(ALTS $choice "which color the block's cells take — data-equivalent on this task, whose inputs are one fg color with a fg center" $Scaled
  (ALT $Stored
    (RULE &block
      (&active (:P *P_in))
      (&seated P_in *P_tile)
      (&fill (:C *Col))))
  (ALT $Hub
    (RULE &block
      (&seated *P_in *P_tile)
      (OR ((&active (:P P_in)))
          ((axis_of (:D *D1_m1) (:A *A1_m2))
           (opposite (:D D1_m1) (:Opp *O1_m3))
           (perp (:A A1_m2) (:A2 *A2_m4))
           (axis_of (:D *D2_m5) (:A A2_m4))
           (opposite (:D D2_m5) (:Opp *O2_m6))
           (margin (:B P_in) (:D D1_m1) (:K *K1_m7))
           (margin (:B P_in) (:D O1_m3) (:K K1_m7))
           (margin (:B P_in) (:D D2_m5) (:K *K2_m8))
           (margin (:B P_in) (:D O2_m6) (:K K2_m8))))
      (&fill (:C *Col)))))

(RULE &output
  (&cell (:P_grid *P) *P_tile *P_intile)
  (OR ((&block P_tile *Col))
      ((&copy P_tile)
       (input (:P P_intile) Col))
      ((NOT (&block P_tile))
       (NOT (&copy P_tile))
       (&bg (:C Col)))))
