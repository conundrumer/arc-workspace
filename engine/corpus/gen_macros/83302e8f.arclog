;; 83302e8f

(DET &bg ChangedColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color_count Cardinality
  (key ((input *P ^Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:m P))
      (input *P Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

;; A wall line is mostly one non-bg color.
(INIT &line_color Order
  (key ((&line_color_count.size (:key ^A ^L *Col)))
    (member ((:t Col))
      (&line_color_count.size (:key A L *Col)))
    (score ((:t Col) (:S N))
      (&line_color_count.size (:key A L *Col) *N))))

(RULE &lattice_divider
  (&line_color.maximal (:key *A *L) (:t *Col))
  (NOT (&bg (:C Col))))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(RULE &region_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &sealed AnyOutNewColor)

(DET &leaky AnyOutNewColor)

(RULE &gap
  (&lattice_on_divider *P)
  (input P *Col)
  (&bg (:C Col)))

(INIT &region Propagation
  (source ((:n P))
    (&gap *P)
    (input P *Col)
    (&bg (:C Col)))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (&bg (:C Col))
    (&region_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (&bg (:C Col2))))

(ALTS $choice "which bg cells are leaky" $Flood
  (ALT $Tile
    (INIT &lattice_rank Order
      (key ((OR ((&lattice_divider *A *L)
                 (axis_of ^D A)
                 (margin (:B L) D *K))
                ((input *P)
                 (dir_elem D)
                 (margin (:B P) D K))))
        (member ((:t K))
          (&lattice_divider *A *L)
          (axis_of D A)
          (margin (:B L) D *K))
        (score ((:t K) (:S K))
          (OR ((&lattice_divider *A *L)
               (axis_of D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
        (probe ((:t K))
          (input *P)
          (dir_elem D)
          (margin (:B P) D *K))))

    (RULE &lattice_part_idx
      (input *P)
      (axis_of *D *A)
      (NOT (&lattice_on_divider P A))
      (margin (:B P) D *K)
      (&lattice_rank.rank (:key D) (:t K) (:R *N)))

    (RULE &lattice_part_of
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&lattice_part_idx *P D (:N *N1))
      (&lattice_part_idx P (:D D2) (:N *N2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K N1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

    (RULE &lattice_tile_of
      (&lattice_part_of *P *A (:P_part *P1))
      (perp A *A2)
      (&lattice_part_of P (:A A2) (:P_part *P2))
      (compose (:A P1) (:B P2) (:C *P_tile)))

    (RULE &leaky_tile
      (&lattice_tile_of *P *P_tile)
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&gap (:P Q)))

    (RULE &output
      (OR ((input *P (:Col *C0))
           (&bg (:C C0))
           (OR ((&gap P)
                (&leaky (:C *Col)))
               ((&lattice_tile_of P *P_tile)
                (IF ((&leaky_tile P_tile))
                    ((&leaky (:C Col)))
                    ((&sealed (:C Col)))))))
          ;; Walls stay.
          ((input P Col)
           (NOT (&bg (:C Col)))))))
  (ALT $Solid
    (RULE &region_label_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &region_label Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (&bg (:C Col))
             (&region_label_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (&bg (:C Col2)))
            ((input P (:Col *Col3))
             (&bg (:C Col3))
             (= P3 P)))))

    (RULE &region_label_component
      (&region_label.class (:a *P) *Id))

    (INIT &bbox BoundingBox
      (key ((&region_label_component *P ^Id))
        (cell (P)
          (&region_label_component *P Id))))

    (RULE &irregular
      (&bbox.box (:key *Id) *B)
      (input *P)
      (ALL ((&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (NOT (&region_label_component P Id)))

    (RULE &output
      (OR ((&region_label_component *P *Id)
           (IF ((&irregular Id))
               ((&leaky (:C *Col)))
               ((&sealed (:C Col)))))
          ;; Walls stay.
          ((input P Col)
           (NOT (&bg (:C Col))))))))

(RULE &output
  ;; Walls stay.
  (OR ((input *P *Col)
       (NOT (&bg (:C Col))))
      ((input P (:Col *C0))
       (&bg (:C C0))
       (IF ((&region.reached (:n P)))
           ((&leaky (:C Col)))
           ((&sealed (:C Col)))))))
