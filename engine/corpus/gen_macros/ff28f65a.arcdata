(param &block_color Color (2))
(param &block_shape Position (Frame
  ((:A AXIS_V) (:N 2))
  ((:A AXIS_H) (:N 2))))
(param &mark Color (1))
(param &bg Color (0))
(param &lex_corner DiagDir (DIAG_TL))
(param &lex_axis Axis (AXIS_V))
(param &out_pos Position (Frame
  ((:A AXIS_V) (:N 3))
  ((:A AXIS_H) (:N 3))))
(param &lookup_grid (number Position Color)
  (1 (grid
    (1 0 0)
    (0 0 0)
    (0 0 0)))
  (2 (grid
    (1 0 1)
    (0 0 0)
    (0 0 0)))
  (3 (grid
    (1 0 1)
    (0 1 0)
    (0 0 0)))
  (4 (grid
    (1 0 1)
    (0 1 0)
    (1 0 0)))
  (5 (grid
    (1 0 1)
    (0 1 0)
    (1 0 1))))
