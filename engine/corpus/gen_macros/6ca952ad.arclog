;; 6ca952ad

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(DET &grav DirDomain)

;; Least cell count of an object that falls.
(DET &heavy TileCount)

(INIT &size Cardinality
  (key ((&obj_component *P ^Id))
    (member ((:m P))
      (&obj_component *P Id))))

(RULE &falls
  (&size.size (:key *Id) *N)
  (&heavy (:N *K))
  (>= N K))

(INIT &fall Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj_component *P *Id)
    (&falls Id)
    (&grav *D)
    (&obj_component (:P *P2) (:Id *Id2))
    (&falls (:Id Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&obj_component *P *Id)
         (&falls Id)
         (&grav *D)
         (margin (:B P) D *K))
        ((&obj_component (:P *P3) Id)
         (&falls Id)
         (&grav (:D *D2))
         (&obj_component (:P *P2) (:Id *Id2))
         (NOT (&falls (:Id Id2)))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &fallen
  (input (:P *P2) *Col)
  (&obj_component (:P P2) *Id)
  (OR ((&fall.distance (:n Id) *K)
       (&grav *D)
       (dir8_opposite D (:D2 *O_m1))
       (edge_inset (:D O_m1) K (:B *B1_m2))
       (edge_inset D K (:B *I_m4))
       (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *Delta))
       (compose (:A P2) (:B Delta) (:C *P)))
      ((NOT (&falls Id))
       (= P P2))))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (NOT (&fallen P))
       (&bg (:C Col)))))
