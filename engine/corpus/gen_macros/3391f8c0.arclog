;; 3391f8c0

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(RULE &copy
  (&objs_component (:Key *Col) *P *Id))

(INIT &bbox BoundingBox
  (key ((&copy ^Id *P))
    (cell (P)
      (&copy Id *P))))

(RULE &shape
  (&copy *Id *Col *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&copy (:Id *Idm) (:Col *Colm) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &swap
  (&copy *Col)
  (&copy (:Col *Col2))
  (!= Col Col2))

(RULE &paint
  (&copy *Id (:Col *Col3))
  (&swap (:Col Col3) (:Col2 *Col))
  (&shape Col *P_inner)
  (input *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel P_inner)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&bg (:C Col)))))
