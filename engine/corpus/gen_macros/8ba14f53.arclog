;; 8ba14f53

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &shapes_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &obj
  (&shapes_component (:Key *Col) *P *Id))

(DET &axis AxisDomain)

;; The reading order the filled cells follow: from corner, axis primary.
(DET &corner DiagDirDomain)

(DET &out_pos Frame)

;; Reading order over the output frame.
(INIT &reading Order
  (member ((:t P))
    (&out_pos *P))
  (before ((:a P) (:b P2))
    (&out_pos *P)
    (&out_pos (:P *P2))
    (&corner (:D *C))
    (&axis *A)
    (OR ((corner_dir C A *D)
         (dir_elem D)
         (margin (:B P) D (:K *K1_m1))
         (margin (:B P2) D (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir C A D)
         (perp A (:A2 *A2_m3))
         (corner_dir C (:A A2_m3) (:D *D2))
         (margin (:B P) D (:K *K_m4))
         (margin (:B P2) D (:K K_m4))
         (dir_elem (:D D2))
         (margin (:B P) (:D D2) (:K *K1_m5))
         (margin (:B P2) (:D D2) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

(RULE &stack_dir
  (&corner (:D *C))
  (&axis *A)
  (corner_dir C A (:D *D_corner))
  (opposite (:D D_corner) (:Opp *D)))

;; Shapes fill in order of their nearest cell to this edge.
(DET &order_dir DirDomain)

(ALTS $choice "what a shape is" $Shape
  (ALT $Hue
    (INIT &hues Quotient
      (equivalent ((:a P) (:b Q))
        (input *P *Col)
        (input (:P *Q) Col)
        (NOT (&bg (:C Col)))))

    (RULE &obj
      (input *P *Col)
      (&hues.class (:a P) *Id)))
  (ALT $Region
    (RULE &regions_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &regions Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (NOT (&bg (:C Col)))
             (&regions_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (NOT (&bg (:C Col2))))
            ((input P (:Col *Col3))
             (NOT (&bg (:C Col3)))
             (= P3 P)))))

    (RULE &regions_component
      (&regions.class (:a *P) *Id))

    (RULE &obj
      (&regions_component *P *Id)
      (input P *Col))))

(RULE &closed_cell
  (input *P)
  (&obj *Col *Id)
  (NOT (&obj Col Id P)))

(RULE &closed_flood_node
  (input *P)
  (&obj *Col *Id)
  (NOT (&obj Col Id P)))

(INIT &closed_flood Propagation
  (key ((OR ((&closed_cell ^Col ^Id *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&closed_flood_node Col Id P))
            ((&closed_flood_node Col Id P)
             (&closed_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&closed_flood_node Col Id (:P Q)))))
    (source ((:n P))
      (&closed_cell Col Id *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&closed_flood_node Col Id P))
    (edge ((:a P) (:b Q))
      (&closed_flood_node Col Id *P)
      (&closed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&closed_flood_node Col Id (:P Q)))))

(RULE &closed_node
  (&closed_cell *Col *Id *P)
  (NOT (&closed_flood.reached (:key Col Id) (:n P))))

;; The cells a shape closes off from the grid edge.
(INIT &closed Quotient
  (edge ((:a (:Col Ky_col) (:Id Ky_id) P) (:b (:Col Ky_col) (:Id Ky_id) (:P P2)))
    (OR ((&closed_node (:Col *Ky_col) (:Id *Ky_id) *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:Col Ky_col) (:Id Ky_id) (:P P2)))
        ((&closed_node (:Col Ky_col) (:Id Ky_id) P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *Col (:Id *Key_id) *P) *Id))

(INIT &enclosed Cardinality
  (key ((&closed_component ^Col (:Key_id ^Id) *P))
    (member ((:m P))
      (&closed_component Col (:Key_id Id) *P))))

(RULE &block
  (&enclosed.size (:key *Col *Id) *N)
  (&reading.rank (:t *P) *R)
  (< R N))

(RULE &block_line_split1
  (&block (:Col *K_col) (:Id *K_id) (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &block_line
  (&block *Col *Id *P)
  (&axis *A)
  (&block_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

;; Shape order: by the nearest cell to order_dir.
(INIT &bbox BoundingBox
  (key ((&obj ^Col ^Id *P))
    (cell (P)
      (&obj Col Id *P))))

;; The lines the earlier shapes' blocks take: how far this block stacks.
(INIT &offset Cardinality
  (key ((OR ((&order_dir *D)
             (&bbox.box (:key (:Col *C2) (:Id *I2)) (:B *B2))
             (&bbox.box (:key (:Col ^C) (:Id ^I)) *B)
             (dir_elem D)
             (margin (:B B2) D (:K *K1_m1))
             (margin B D (:K *K2_m2))
             (< K1_m1 K2_m2)
             (&block_line (:Col C2) (:Id I2) *L))
            ((&obj (:Col C) (:Id I)))))
    (member ((:m (:Col C2) (:Id I2) L))
      (&order_dir *D)
      (&bbox.box (:key (:Col *C2) (:Id *I2)) (:B *B2))
      (&bbox.box (:key (:Col C) (:Id I)) *B)
      (dir_elem D)
      (margin (:B B2) D (:K *K1_m1))
      (margin B D (:K *K2_m2))
      (< K1_m1 K2_m2)
      (&block_line (:Col C2) (:Id I2) *L))
    (domain ()
      (&obj (:Col C) (:Id I)))))

(RULE &filled
  (&block *Col (:Id *K_id) (:P *P0))
  (&offset.size (:key (:C Col) (:I K_id)) (:N *S))
  (&stack_dir *D)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) (:K S) (:B *B1_m3))
  (edge_inset D (:K S) (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P0) (:B V_m1) (:C *P)))

(RULE &output
  (OR ((&filled *P *Col))
      ((&out_pos P)
       (NOT (&filled P))
       (&bg (:C Col)))))
