;; aa62e3f4

(INPUT one-object "one 4-connected object of non-background cells sits on a field of &background"

  (RULE &piece4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &piece8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET_OR_RULE &background DominantColor)

  (RULE &object
    (input *P *Col)
    (NOT (&background (:C Col))))

  (INIT &piece4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&object *P)
           (&piece4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&object (:P P3)))
          ((&object P)
           (= P3 P)))))

  (INIT &piece8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&object *P)
           (&piece8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&object (:P P3)))
          ((&object P)
           (= P3 P))))))

(INPUT rare-color "one color of the object has fewer cells than every other color of the object"

  ;; The scan order that breaks a tie for the fewest cells: the corner it starts from, and the axis it reads first. No pair holds a tie, so every order stays open.
  ;; TODO no-det-plan: &scan_order: the plan gives no verdict
  (DET &scan_order (ONE))

  (RULE &field
    (input *P *Col)
    (&background (:C Col)))

  ;; Every object cell in one class.
  (INIT &whole Quotient
    (equivalent ((:a P) (:b Q))
      (&object *P)
      (&object (:P *Q))))

  (RULE &member
    (&whole.class (:a *P) (:Id *G)))

  ;; The cells each pool counts.
  (RULE &cell
    (&member (:G *Key) *P)
    (input P *Col))

  (INIT &hue_count Cardinality
    (key ((&cell (:Key ^K) *P ^Col))
      (member ((:m P))
        (&cell (:Key K) *P Col))))

  (INIT &fewest Order
    (key ((&hue_count.size (:key (:K ^Id) *Col) *N))
      (member ((:t (:V Col) (:S N)))
        (&hue_count.size (:key (:K Id) *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&hue_count.size (:key (:K Id) *Col) *N))))

  (RULE &scan_cell
    (&fewest.minimal (:key *Id) (:t (:V *Col)))
    (&cell (:Key Id) *P Col)
    (&scan_order (:D *Corner) *A))

  ;; The cells of the colors tied for the fewest, under each scan order.
  (INIT &scan Order
    (key ((&fewest.minimal (:key (:Id ^K)) (:t (:V *Col)))
          (&cell (:Key K) *P Col)
          (&scan_order (:D ^Dg) ^A))
      (member ((:t P))
        (&fewest.minimal (:key (:Id K)) (:t (:V *Col)))
        (&cell (:Key K) *P Col)
        (&scan_order (:D Dg) A))
      (before ((:a P) (:b P2))
        (&fewest.minimal (:key (:Id K)) (:t (:V *Col)))
        (&cell (:Key K) *P Col)
        (&scan_order (:D Dg) A)
        (&fewest.minimal (:key (:Id K)) (:t (:V *Col2)))
        (&cell (:Key K) (:P *P2) (:Col Col2))
        (&scan_cell (:Id K) (:Corner Dg) A)
        (OR ((corner_dir (:C Dg) A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir (:C Dg) A D)
             (perp A (:A2 *A2_m3))
             (corner_dir (:C Dg) (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  ;; A color's level less one: its hops from the colors beside the background
  ;; or the off-grid border.
  (INIT &hops Distance
    (key ((OR ((&member (:G ^Id) *P)
               (input P *Col)
               (dir_elem *D)
               (OR ((margin (:B P) D (:K 0)))
                   ((step_offset D (:V *V_m1))
                    (compose (:A P) (:B V_m1) (:C *Q))
                    (&field (:P Q)))))
              ((&member (:G Id) P)
               (input P (:Col *A))
               (dir_elem D)
               (step_offset D (:V *V_m12))
               (compose (:A P) (:B V_m12) (:C *Q2))
               (&member (:G Id) (:P Q2))
               (input (:P Q2) (:Col *B)))))
      (edge ((:a A) (:b B))
        (&member (:G Id) *P)
        (input P (:Col *A))
        (dir_elem *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (&member (:G Id) (:P Q))
        (input (:P Q) (:Col *B)))
      (source ((:n Col))
        (&member (:G Id) *P)
        (input P *Col)
        (dir_elem *D)
        (OR ((margin (:B P) D (:K 0)))
            ((step_offset D (:V *V_m1))
             (compose (:A P) (:B V_m1) (:C *Q))
             (&field (:P Q)))))))

  (INIT &deepest Order
    (key ((&hops.distance (:key ^Id) (:n *Col) *K))
      (member ((:t (:V Col) (:S K)))
        (&hops.distance (:n *Col) *K))
      (score ((:t (:V Col) (:S K)) (:S K))
        (&hops.distance (:n *Col) *K))))

  (INIT &innermost Singleton
    (key ((&deepest.maximal (:key ^Id) (:t (:V *Col))))
      (member ((:v Col))
        (&deepest.maximal (:t (:V *Col)))))))

(OUTPUT erase "every cell of the object takes &background")

(OUTPUT halo "every background cell 4-adjacent to a cell of the object takes the object's rare color"

  (RULE &outside_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &beside
    (&field *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&object (:P Q)))

  (INIT &rare Singleton
    (key ((&fewest.minimal (:key ^Id) (:t (:V *Col))))
      (member ((:v Col))
        (&fewest.minimal (:t (:V *Col))))))

  (RULE &group_color
    (&rare.value (:key (:Id *G)) (:v *Col)))

  ;; The color of each halo cell; two groups that give one cell different
  ;; colors leave it none.
  (INIT &paint Singleton
    (key ((&beside ^P *Q)
          (&member (:G *Id) (:P Q))
          (&group_color (:G Id) *Col))
      (member ((:v Col))
        (&beside P *Q)
        (&member (:G *Id) (:P Q))
        (&group_color (:G Id) *Col))))

  ;; The background cells that reach the grid edge through background.
  (INIT &outside Propagation
    (source ((:n P))
      (&field *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0)))
    (edge ((:a P) (:b P2))
      (&field *P)
      (&outside_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (&field (:P P2)))))

(OUTPUT rest "every other cell keeps its input color")

(ALTS $color "which color the halo takes" $RareColor
  (ALT $RareColor
    (ALTS $bg "whether the background's cells take part in the count under RareColor" $ObjectCount
      (ALT $RarestWithBackground
        (OUTPUT halo "the count also takes in the background's cells over the whole grid, so when the background is the rarest color the halo takes the background color; undefined when two colors tie for the fewest cells"
          (RULE &cell
            (OR ((&member (:G *Key))
                 (&field *P *Col))
                ;; The cells each pool counts.
                ((&member (:G Key) P)
                 (input P Col)))))))
    (ALTS $tie "the halo color when colors tie for the fewest cells under RareColor" $TieUndefined
      (ALT $ScanOrder
        (INPUT rare-color "several colors of the object may tie for the fewest cells")
        (OUTPUT halo "every background cell 4-adjacent to a cell of the object takes, of the colors tied for the fewest cells, the color of the cell that comes first in the scan order &scan_order; the output holds the grid of each open order"
          ;; The color of each halo cell at each open value; two groups that give one
          ;; cell different colors leave it none.
          (INIT &order_paint Singleton
            (key ((&beside ^P *Q)
                  (&member (:G *Id) (:P Q))
                  (&scan.minimal (:key (:K Id) *Dg *A) (:t *P_first))
                  (&cell (:Key Id) (:P P_first) *Col))
              (member ((:v Col))
                (&beside P *Q)
                (&member (:G *Id) (:P Q))
                (&scan.minimal (:key (:K Id) *Dg *A) (:t *P_first))
                (&cell (:Key Id) (:P P_first) *Col)))))
        (RULE &output
          (input *P (:Col *Col0))
          (OR ((&object P)
               (&background (:C *Col)))
              ((&halo P)
               (&order_paint.value (:key P) (:v Col)))
              ((NOT (&object P))
               (NOT (&halo P))
               (= Col Col0)))))))
  (ALT $InnermostColor
    (INPUT rare-color "one color of the object is innermost. A color's level is 1 more than the lowest level of a color its cells touch, the background and the off-grid border are level 0, and the innermost color is the one at the highest level")
    (OUTPUT halo "every background cell 4-adjacent to a cell of the object takes the object's innermost color; undefined when two colors share the highest level"
      (RULE &group_color
        (&innermost.value (:key (:Id *G)) (:v *Col))))))

(ALTS $region "which background cells join the halo" $Touching
  (ALT $ExteriorHalo
    (OUTPUT halo "a background cell 4-adjacent to a cell of the object joins the halo only when it is 4-connected through background cells to the grid edge")
    (RULE &halo
      (&beside *P)
      (&outside.reached (:n P)))))

(ALTS $scope "over which cells the halo color is chosen" $AllCells
  (ALT $PerObject
    (INPUT one-object "4-connected objects of non-background cells sit on a field of &background")
    (OUTPUT halo "every background cell 4-adjacent to a cell of an object takes that object's rare color; undefined where a cell touches two objects that give different colors"
      (RULE &piece4_component
        (&piece4.class (:a *P) *Id))

      (RULE &member
        (&piece4_component *P (:Id *G))))
    (ALTS $conn "how the cells of one object connect under PerObject" $Conn4
      (ALT $PerObject8
        (INPUT one-object "the objects are 8-connected"
          (RULE &piece8_component
            (&piece8.class (:a *P) *Id))
          (RULE &member
            (&piece8_component *P (:Id *G))))))))

(RULE &halo
  (&beside *P))

(RULE &output
  (input *P (:Col *Col0))
  (OR ((&object P)
       (&background (:C *Col)))
      ((&halo P)
       (&paint.value (:key P) (:v Col)))
      ((NOT (&object P))
       (NOT (&halo P))
       (= Col Col0))))
