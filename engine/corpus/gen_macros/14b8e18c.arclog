;; 14b8e18c

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(DET &mark_color AnyOutNewColor)

(RULE &cell_of
  (&comps_component *P *Id))

(INIT &bbox BoundingBox
  (key ((&cell_of ^Id *P))
    (cell (P)
      (&cell_of Id *P))))

(RULE &square
  (&bbox.box (:key *Id) *B)
  (&cell_of Id *P)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N))

(RULE &multi_cell
  (&cell_of *Id *P)
  (&cell_of Id (:P *Q))
  (!= P Q))

(RULE &border_gap
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (NOT (&cell_of Id P)))

(RULE &qualify
  (&square *Id)
  (&multi_cell Id))

(RULE &corner_cell
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(ALTS $choice "what makes an object square, and which corners get marks" $Square
  (ALT $Corners
    (RULE &anchor
      (&qualify *Id)
      (&corner_cell Id *Diag *P)
      (&cell_of Id P)))
  (ALT $Box
    (RULE &qualify
      (&square *Id)
      (&multi_cell Id)
      (NOT (&border_gap Id))))
  (ALT $Ring
    (RULE &has_interior_interior1
      (&cell_of *Id (:P *P_))
      (&bbox.box (:key Id) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (<= K_m3 0))

    (RULE &qualify
      (&square *Id)
      (&multi_cell Id)
      (NOT (&border_gap Id))
      (ALL ((&bbox.box (:key Id) *B)
            (&cell_of Id *P))
           ((&has_interior_interior1 (:P_ P) (:B_ B)))))))

(RULE &anchor
  (&qualify *Id)
  (&corner_cell Id *Diag *P))

(RULE &mark
  (&anchor (:Diag *Dg) (:P *P2))
  (corner_dir (:C Dg) *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(RULE &output
  (OR ((&mark *P)
       (&mark_color (:C *Col)))
      ((input P Col)
       (NOT (&mark P)))))
