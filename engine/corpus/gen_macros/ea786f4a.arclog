;; ea786f4a

(RULE &xrays_dir
  (diag_dir_elem *D))

(RULE &xrays_node
  (input *P))

(DET &ink RarestColor)

(RULE &dot
  (input *P (:Col *Ink))
  (&ink (:C Ink)))

(RULE &xrays_source
  (&dot *P))

;; Diagonal rays from the dot toward every corner.
(INIT &xrays Distance
  (key ((&xrays_source (:P ^O))
        (&xrays_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&xrays_source (:P O))
           (&xrays_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&xrays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&xrays_node (:P Q)))
          ((&xrays_source (:P O))
           (&xrays_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&xrays_node (:P Q))
           (= A2 O))
          ((&xrays_source (:P O))
           (&xrays_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&xrays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&xrays_node (:P Q)))))
    (source ((:n O))
      (&xrays_source (:P O))
      (&xrays_dir D))))

(RULE &xrays_ray
  (&xrays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &xrays_end
  (&xrays_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&xrays_ray (:P Q) D Origin)))

(RULE &x_cell
  (&xrays_ray *P))

(ALTS $choice "where the X comes from" $Dot
  (ALT $Grid
    (RULE &dg_diagonal
      (input *P)
      (diag_dir_elem *D)
      (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m4))
      (corner_dir (:C D) (:A A2_m4) (:D *D2_m3))
      (margin (:B P) (:D D1_m2) (:K *Ring))
      (margin (:B P) (:D D2_m3) (:K Ring)))

    (RULE &x_cell
      (&dg_diagonal *P))))

(RULE &output
  (OR ((&x_cell *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&x_cell P)))))
