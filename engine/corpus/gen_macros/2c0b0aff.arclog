;; 2c0b0aff

(RULE &panels_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg VanishedColor)

(INIT &panels Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&panels_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &panels_component
  (&panels.class (:a *P) *Id))

(DET &mark RarestColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &panel
  (&panels_component *P *Id))

(INIT &mark_rim Boundary
  (cell (P)
    (&mark_cell *P)))

(RULE &cross
  (&mark_cell (:P *Inst))
  (NOT (&mark_rim.boundary (:P Inst)))
  (&panel *Id (:P Inst)))

(ALTS $choice "what identifies a cross" $Plus
  (ALT $Shape
    (DET &objs_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (DET &objs_node
      (ex_input (:E *Key) *P *Col)
      (&mark (:C Col)))

    (INIT &objs Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&objs_node (:Key *Ky) *P)
             (&objs_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&objs_node (:Key Ky) (:P P2)))
            ((&objs_node (:Key Ky) P)
             (= P2 P)))))

    (DET &objs_component
      (&objs.class (:a *Key *P) *Id))

    (INIT &biggest_count Cardinality
      (key ((&objs_component (:Key ^E) *P ^Id))
        (member ((:m P))
          (&objs_component (:Key E) *P Id))))

    ;; A cross is the biggest thing the marks make.
    (INIT &biggest Order
      (member ((:t (:E M_e) (:Id M_id)))
        (&biggest_count.size (:key (:E *M_e) (:Id *M_id))))
      (score ((:t (:E M_e) (:Id M_id)) (:S N))
        (&biggest_count.size (:key (:E *M_e) (:Id *M_id)) *N)))

    (INIT &bbox BoundingBox
      (key ((&biggest.maximal (:t ^E ^Id)))
        (cell (P)
          (&objs_component (:Key E) *P Id))))

    (DET &shape_inside1
      (&bbox.cell (:key (:E *K_e) (:Id *K_id)) (:P *P_))
      (&bbox.box (:key (:E K_e) (:Id K_id)) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &shape
      (&bbox.cell (:key (:E *K_e) (:Id *K_id)) (:P *P2))
      (&bbox.box (:key (:E K_e) (:Id K_id)) *B)
      (NOT (&shape_inside1 (:P_ P2) (:B_ B)))
      (relative (:Base B) (:X P2) (:X_rel *P)))

    (INIT &occ Occurrences
      (cell (P)
        (&mark_cell *P))
      (shape ((:P S))
        (&shape (:P *S))))

    (RULE &cross
      (&occ.occurrence (:P *Inst))
      (&shape (:P *S))
      (compose (:A Inst) (:B S) (:C *P))
      (&panel *Id P)))
  (ALT $Size
    (RULE &marks_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &marks Quotient
      (edge ((:a P) (:b P3))
        (OR ((&mark_cell *P)
             (&marks_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&mark_cell (:P P3)))
            ((&mark_cell P)
             (= P3 P)))))

    (RULE &marks_component
      (&marks.class (:a *P) *Id))

    (DET &piece_size TileCount)

    (INIT &mark_size Cardinality
      (key ((&marks_component *P (:Id ^Obj)))
        (member ((:m P))
          (&marks_component *P (:Id Obj)))))

    ;; An instance here is a mark object, not a position, so the count runs over
    ;; objects and joins the shared pipeline at the score.
    (INIT &piece_count Cardinality
      (key ((&mark_size.size (:key *Obj) *N)
            (&piece_size N)
            (&marks_component *P (:Id Obj))
            (&panel ^Id P))
        (member ((:m Obj))
          (&mark_size.size (:key *Obj) *N)
          (&piece_size N)
          (&marks_component *P (:Id Obj))
          (&panel Id P))))

    ;; The panel holding the most crosses, scored per case.
    (INIT &most Order
      (member ((:t (:V Id) (:S N)))
        (OR ((&cross_count.size (:key *Id) *N))
            ((&piece_count.size (:key Id) N))))
      (score ((:t (:V Id) (:S N)) (:S N))
        (OR ((&cross_count.size (:key *Id) *N))
            ((&piece_count.size (:key Id) N)))))))

(INIT &cross_count Cardinality
  (key ((&cross ^Id *Inst))
    (member ((:m Inst))
      (&cross Id *Inst))))

;; The panel holding the most crosses, scored per case.
(INIT &most Order
  (member ((:t (:V Id) (:S N)))
    (&cross_count.size (:key *Id) *N))
  (score ((:t (:V Id) (:S N)) (:S N))
    (&cross_count.size (:key *Id) *N)))

(INIT &view BoundingBox
  (cell (P)
    (&most.maximal (:t (:V *Id)))
    (&panel Id *P)))

(RULE &output
  (&view.cell (:P *P2))
  (&view.box *B)
  (ALL ((&view.cell (:P P2))
        (&view.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (input (:P P2) *Col))
