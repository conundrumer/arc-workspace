;; c4d067a0

(INPUT background "one color fills most of the grid; it is the commonest color of the input"

  (INIT &corner_color Singleton
    (member ((:v Col))
      (input *P *Col)
      (diag_dir_elem *D)
      (relative (:Base 0) (:X P) (:X_rel *R_m1))
      (axis_of (:D *D1_m2) (:A *A1_m3))
      (opposite (:D D1_m2) (:Opp *O1_m4))
      (perp (:A A1_m3) (:A2 *A2_m5))
      (axis_of (:D *D2_m6) (:A A2_m5))
      (opposite (:D D2_m6) (:Opp *O2_m7))
      (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
      (>= K1_m8 0)
      (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
      (>= K2_m9 0)
      (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
      (>= K3_m10 0)
      (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
      (>= K4_m11 0)
      (corner_dir (:C D) (:A *A_m12) (:D *D1_m13))
      (perp (:A A_m12) (:A2 *A2_m14))
      (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
      (margin (:B P) (:D D1_m13) (:K *K1_m16))
      (margin (:B 0) (:D D1_m13) (:K K1_m16))
      (margin (:B P) (:D D2_m15) (:K *K2_m17))
      (margin (:B 0) (:D D2_m15) (:K K2_m17)))))

(INPUT key-lattice "the key is a set of single cells of non-background colors, on a lattice of pitch &key_pitch along each axis, with a background cell between neighboring dots; a lattice point inside the key's bounding box can hold the background color"

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &cell
    (input *P *Col))

  ;; The one-color pieces of the grid.
  (INIT &piece Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((&cell *P *Col)
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&cell (:P P3) Col))
          ((&cell P Col)
           (= P3 P)))))

  (RULE &piece_component
    (&piece.class (:a (:Col *Key) *P) *Id))

  (INIT &color_count_count Cardinality
    (key ((&cell *P ^Col))
      (member ((:m P))
        (&cell *P Col))))

  (INIT &color_count Order
    (member ((:t Col))
      (&color_count_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&color_count_count.size (:key *Col) *N)))

  (DET &bg2
    (&color_count.maximal *E (:t *Col)))

  (INIT &piece_box BoundingBox
    (key ((&piece_component *P ^Id))
      (cell (P)
        (&piece_component *P Id))))

  (DET &key_dot2
    (&piece_component *E (:Key *Col) (:P *Q) *Id)
    (&piece_box.box E (:key Id) (:B Q))
    (&bg2 E (:Col *C_bg))
    (!= Col C_bg))

  (DET &key_offset2
    (&key_dot2 *E (:Q *Q1))
    (&key_dot2 E (:Q *Q2))
    (relative (:Base Q1) (:X Q2) (:X_rel *R))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B R) (:D O) (:K *T))
    (> T 0))

  (DET &pitch_cand2
    (&key_offset2 *E)
    (&key_dot2 E *Q)
    (axis_elem *A)
    (sub_extent (:P Q) A (:K *N)))

  (DET &off_pitch2
    (&pitch_cand2 *E *N)
    (&key_offset2 E *T)
    (divide T (:Side N) (:Gap 0) (:Remainder *R))
    (> R 0))

  ;; The greatest pitch that divides every key offset.
  (INIT &key_lattice2 Order
    (key ((&pitch_cand2 ^E *N)
          (NOT (&off_pitch2 E N)))
      (member ((:t N))
        (&pitch_cand2 E *N)
        (NOT (&off_pitch2 E N)))
      (score ((:t N) (:S N))
        (&pitch_cand2 E *N)
        (NOT (&off_pitch2 E N)))))

  (DET &split_pitch
    (&key_lattice2.maximal (:t *N))
    (ex_input *E)
    (NOT (&key_lattice2.maximal (:key E) (:t N))))

  (DET_OR_RULE &key_pitch "The distance between neighboring lattice points of the key." TileDim
    (&key_lattice2.maximal (:t *N))
    (NOT (&split_pitch N)))

  (RULE &bg3
    (&color_count.maximal (:t *Col)))

  (RULE &bg
    (&bg3 *Col))

  (RULE &key_dot
    (&piece_component (:Key *Col) (:P *Q) *Id)
    (&piece_box.box (:key Id) (:B Q))
    (&bg (:Col *C_bg))
    (!= Col C_bg))

  (RULE &key_offset
    (&key_dot (:Q *Q1))
    (&key_dot (:Q *Q2))
    (relative (:Base Q1) (:X Q2) (:X_rel *R))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B R) (:D O) (:K *T))
    (> T 0))

  (RULE &pitch_cand
    (&key_offset)
    (&key_dot *Q)
    (axis_elem *A)
    (sub_extent (:P Q) A (:K *N)))

  ;; The greatest pitch that divides every key offset.
  (INIT &key_lattice Order
    (member ((:t N))
      (&pitch_cand *N)
      (ALL ((&key_offset *T)
            (divide T (:Side N) (:Gap 0) (:Remainder *R)))
           ((<= R 0))))
    (score ((:t N) (:S N))
      (&pitch_cand *N)
      (ALL ((&key_offset *T)
            (divide T (:Side N) (:Gap 0) (:Remainder *R)))
           ((<= R 0))))))

(INPUT given-blocks "two solid squares of one size k (k at least 2), each of a non-background color, lie on one line along the horizontal axis, with the same gap g between neighbors")

(INPUT blocks-match-key "the given blocks are the large drawing of a run of neighboring key dots, block for dot and color for color, and exactly one such run of the key matches them")

(INPUT fits-grid "the large drawing of the whole key, placed by that match, lies inside the grid")

(OUTPUT enlarge-key "each key dot of a non-background color becomes a k×k block of that color, and key dots one lattice step apart become blocks at a pitch of k+g along either axis, with the gap g read from the given blocks used on both axes")

(OUTPUT anchor-by-match "the large drawing is placed so that the blocks of the matched run land on the given blocks")

(OUTPUT background-dot-empty "a key point of the background color gives no block"

  (INIT &key_box BoundingBox
    (cell ((:P Q))
      (&key_dot *Q))))

(OUTPUT keep-input "every other cell keeps its input color, the key and the given blocks included"

  (RULE &block
    (&piece_component (:Key *Col) *P *Id)
    (&piece_box.box (:key Id) (:B *Box))
    (!= Box P)
    (&bg (:Col *C_bg))
    (!= Col C_bg)
    (axis_elem *A)
    (perp A *A2)
    (axis_elem A)
    (relative (:Base Box) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (axis_elem (:A A2))
    (relative (:Base Box) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) N))

  (RULE &block_pair
    (&block (:Id *Id1) (:Box *B1) (:N *K))
    (&block (:Id *Id2) (:Box *B2) (:N K))
    (!= Id1 Id2)
    (relative (:Base B1) (:X B2) (:X_rel *V))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B V) (:D O) (:K *S))
    (> S 0)
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K S) (:B *B1_m3))
    (edge_inset D (:K S) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A B1) (:B V_m1) (:C B2)))

  (RULE &pitch
    (&key_pitch *N))

  (RULE &run_match
    (&block_pair *Id1 *Id2 *D *S)
    (&block (:Id Id1) (:Col *C1))
    (&block (:Id Id2) (:Col *C2))
    (&pitch *N)
    (&key_dot (:Q *Q1) (:Col C1))
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
    (edge_inset D (:K N) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A Q1) (:B V_m1) (:C *Q2))
    (&key_dot (:Q Q2) (:Col C2)))

  (RULE &placement
    (&run_match (:Id1 *Id) (:Q1 *Q) *S *N)
    (&block Id (:Box *A) (:N *K)))

  (RULE &ambiguous
    (&run_match (:Id1 *Id) *Q1)
    (&run_match (:Id1 Id) (:Q1 *Q2))
    (!= Q1 Q2))

  (RULE &frame_cell
    (OR ((input (:P *X)))
        ((input *P)
         (dir_elem *D)
         (margin (:B P) D (:K 0))
         (step_offset D (:V *V_m1))
         (compose (:A P) (:B V_m1) (:C X)))))

  (RULE &block_slot
    (&placement *A (:Q *Q0) *S (:N *Pitch) *K)
    (&frame_cell *X)
    (relative (:Base A) X (:X_rel *R))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B R) (:D O) (:K *T))
    (divide T (:Side S) (:Gap 0) (:Part *N) (:Remainder *I))
    (< I K))

  (RULE &key_point
    (&key_dot *Q *Col))

  (RULE &key_slot
    (&placement *A (:Q *Q0) *S (:N *Pitch))
    (&key_point *Q)
    (relative (:Base Q0) (:X Q) (:X_rel *R))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B R) (:D O) (:K *T))
    (divide T (:Side Pitch) (:Gap 0) (:Part *N) (:Remainder 0)))

  (RULE &drawn
    (&block_slot *A *Q0 *S *Pitch *X (:D *D1) (:N *N1))
    (&key_slot A Q0 S Pitch *Q (:D D1) (:N N1))
    (&block_slot A Q0 S Pitch X (:D *D2) (:N *N2))
    (&key_slot A Q0 S Pitch Q (:D D2) (:N N2))
    (axis_of (:D D1) (:A *A1))
    (axis_of (:D D2) (:A *A2))
    (perp (:A A1) A2))

  (RULE &admitted
    (&placement *A (:Q *Q0) *S (:N *Pitch))
    (NOT (&ambiguous))))

(ALTS $pitch "where the key's lattice pitch comes from" $StoredPitch
  (ALT $KeyPitchFromKey
    (INPUT key-lattice "the key is a set of single cells of non-background colors on a lattice whose pitch is the greatest common divisor of the dots' row and column offsets; undefined where the key has one dot"
      (RULE &pitch
        (&key_lattice.maximal (:t *N))))))

(ALTS $background "which color is the background" $Commonest
  (ALT $BackgroundAtCorners
    (INPUT background "one color fills most of the grid; it is the color the four grid corners share; undefined where the corners differ"
      (RULE &bg3
        (&corner_color.value (:v *Col))))))

(ALTS $spacing "how far apart in the key the dots of the given blocks stand" $NeighborRun
  (ALT $JointPitchMatch
    (INPUT blocks-match-key "the given blocks are the large drawing of two key dots m lattice steps apart along the blocks' line, block for dot and color for color, with the drawing's pitch the distance between the blocks over m and a gap of at least one cell"
      (RULE &run_match
        (&block_pair *Id1 *Id2 *D (:S *S3))
        (&block (:Id Id1) (:Col *C1) (:N *K))
        (&block (:Id Id2) (:Col *C2))
        (&pitch *N)
        (&key_dot (:Q *Q1) (:Col C1))
        (&key_dot (:Q *Q2) (:Col C2))
        (relative (:Base Q1) (:X Q2) (:X_rel *R))
        (opposite D (:Opp *O))
        (margin (:B R) (:D O) (:K *T))
        (dir8_opposite D (:D2 *O_m2))
        (edge_inset (:D O_m2) (:K T) (:B *B1_m3))
        (edge_inset D (:K T) (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
        (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
        (compose (:A Q1) (:B V_m1) (:C Q2))
        (divide T (:Side N) (:Gap 0) (:Part *M) (:Remainder 0))
        (> M 0)
        (axis_of D *A)
        (sub_extent (:P Q1) A (:K *S))
        (divide (:T S3) (:Side S) (:Gap 0) (:Part M) (:Remainder 0))
        (> S K)))))

(ALTS $matching "what the output is where more than one run matches" $UniqueMatch
  (ALT $EveryMatch
    (OUTPUT anchor-by-match "each run that matches the given blocks places one drawing, and the output holds a grid for each"
      (RULE &admitted
        (&placement *A (:Q *Q0) *S (:N *Pitch))))))

(ALTS $overlap "what the drawing writes over" $PaintOver
  (ALT $BackgroundBlocks
    (OUTPUT background-dot-empty "a key point of the background color gives a block of the background color"
      (RULE &key_point
        (&key_box.box (:B *Box))
        (input (:P *Q) *Col)
        (ALL ((input (:P Q) (:Col *Colm))
              (&key_box.box (:B Box))
              (dir_elem (:D *D_m1))
              (relative (:Base Box) (:X Q) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0))))))
  (ALT $UnderlayDrawing
    (OUTPUT enlarge-key "the drawing writes only on cells of the background color")
    (RULE &writable
      (input (:P *X) (:Col *C_bg))
      (&bg3 (:Col C_bg)))))

(ALTS $edge "what happens where the drawing runs past the grid" $Clip
  (ALT $NoClip
    (OUTPUT enlarge-key "a drawing that runs past the grid gives no grid"
      (RULE &on_lattice
        (&key_slot *A *Q0 *S *Pitch *Q (:D *D1))
        (&key_slot A Q0 S Pitch Q (:D *D2))
        (axis_of (:D D1) (:A *A1))
        (axis_of (:D D2) (:A *A2))
        (perp (:A A1) A2))

      (RULE &on_grid
        (&drawn *A *Q0 *S *Pitch *X *Q)
        (input (:P X)))

      (RULE &runs_off
        (OR ((&drawn *A *Q0 *S *Pitch *X)
             (NOT (input (:P X))))
            ((&on_lattice A Q0 S Pitch *Q)
             (NOT (&on_grid A Q0 S Pitch Q))))))
    (RULE &kept
      (&admitted *A *Q0 *S *Pitch)
      (NOT (&runs_off A Q0 S Pitch)))))

(RULE &writable
  (input (:P *X)))

(RULE &paint
  (&drawn *A *Q0 *S *Pitch *X *Q)
  (&key_point Q *Col)
  (&writable X))

(RULE &kept
  (&admitted *A *Q0 *S *Pitch))

(RULE &output
  (OR ((&kept *A *Q0 *S (:Pitch *L))
       (&paint A Q0 S (:Pitch L) (:X *P) *Col))
      ((&kept (:A *A2) (:Q0 *Q02) (:S *S2) (:Pitch *L2))
       (input P Col)
       (NOT (&paint (:A A2) (:Q0 Q02) (:S S2) (:Pitch L2) (:X P))))))
