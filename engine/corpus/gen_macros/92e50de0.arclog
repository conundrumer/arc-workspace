;; 92e50de0

(DET &bg DominantColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

;; A line of one non-bg color cuts the grid.
(RULE &lattice_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Tiles from one copy to the next.
(DET &tile_period TileCount)

(RULE &tile_phase_edge
  (&lattice_tile_of (:P_tile *Key))
  (&tile_period (:N *K2))
  (dir_elem *D)
  (margin (:B Key) D (:K *T))
  (divide T (:Side K2) (:Gap 0) (:Remainder *K)))

(RULE &tile_phase_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tile_phase_edge *Key D (:K *K1))
  (&tile_phase_edge Key (:D D2) (:K *K2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K K1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B)))

(RULE &tile_phase
  (&tile_phase_axis *Key *A (:B *B1))
  (perp A *A2)
  (&tile_phase_axis Key (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

;; The corner of its tile a copy aligns to.
(DET &anchor DiagDirDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &tile_box BoundingBox
  (key ((&lattice_tile_of *P ^P_tile))
    (cell (P)
      (&lattice_tile_of *P P_tile))))

(RULE &tile_cell
  (&lattice_tile_of *P *P_tile)
  (&tile_box.box (:key P_tile) *B)
  (ALL ((&lattice_tile_of P (:P_tile *P_tilem))
        (&tile_box.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &copy_tile
  (&lattice_tile_of *P (:P_tile *P_tile3))
  (&ink P)
  (&tile_phase (:Key P_tile3) *B)
  (&tile_phase (:Key *P_tile) B))

(RULE &paint
  (&tile_cell (:P *P2) *P_intile)
  (&ink (:P P2) *Col)
  (&copy_tile *P_tile)
  (&tile_cell P_tile *P (:P_intile *Q_intile))
  (&anchor (:D *Dg))
  (ALL ((&tile_cell (:P *Pm) P_intile)
        (&tile_cell (:P_tile *P_tilem) (:P *Qm) (:P_intile Q_intile))
        (corner_dir (:C Dg) (:D *D_m1))
        (margin (:B P_intile) (:D D_m1) (:K *K1_m2))
        (margin (:B Q_intile) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

(ALTS $choice "where the copies stand" $Alternate
  (ALT $Wallpaper
    ;; The output stands still under a shift of one period, and under no
    ;; shorter one.
    (INIT &repeat Periods
      (key ((ex_output ^E *P *Col))
        (cell (P (:v Col))
          (ex_output E *P *Col))))

    (DET &period
      (&repeat.fundamental_period *A *K))

    (RULE &phase_edge
      (input (:P *Key))
      (dir_elem *D)
      (axis_of D *A)
      (&period A (:K *K2))
      (margin (:B Key) D (:K *T))
      (divide T (:Side K2) (:Gap 0) (:Remainder *K)))

    (RULE &phase_axis
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&phase_edge *Key D (:K *K1))
      (&phase_edge Key (:D D2) (:K *K2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K K1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B)))

    (RULE &phase
      (&phase_axis *Key *A (:B *B1))
      (perp A *A2)
      (&phase_axis Key (:A A2) (:B *B2))
      (compose (:A B1) (:B B2) (:C *B)))

    ;; A cell at the place in the period of an ink cell.
    (RULE &paint
      (&ink (:P *P2) *Col)
      (&phase (:Key P2) *B)
      (&phase (:Key *P) B))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (= Col Col_in))))
