;; 963e52fc

(RULE &cell_line_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Line_)))

(DET &dir DirDomain)

(DET &scale ScaleRatio)

;; Output frame: &scale copies of the input frame along &dir.
(INIT &copies Frame
  (key ((&dir *D)
        (axis_of D ^A)
        (&scale (:K *N)))
    (extent (A N)
      (&dir *D)
      (axis_of D A)
      (&scale (:K *N)))))

(INIT &out_cell_tiling Tiling
  (outer ((:P P_outer))
    (&copies.cell (:P *P_outer)))
  (inner ((:P P_grid_in))
    (input (:P *P_grid_in))))

(RULE &out_cell
  (&copies.cell (:P *P_outer))
  (&out_cell_tiling.cell P_outer *P))

(RULE &out_split1
  (&out_cell (:P *P_grid_out_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_out_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_out_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_grid_out_) (:X_rel *Line_)))

(RULE &base
  (&out_cell *P)
  (input (:P *P_grid_in) *Col)
  (&dir *D)
  (opposite D (:Opp *O))
  (margin (:B P_grid_in) (:D O) (:K *K_m1))
  (margin (:B P) (:D O) (:K K_m1))
  (ALL ((opposite (:D *Dm) (:Opp O))
        (input (:P P_grid_in) (:Col *Colm))
        (axis_of (:D O) (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E_m3) (:A A2_m2))
        (margin (:B P_grid_in) (:D E_m3) (:K *K1_m4))
        (margin (:B P) (:D E_m3) (:K *K2_m5)))
       ((= K1_m4 K2_m5))))

(RULE &out_split2
  (&base (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X P_) (:X_rel *Line_)))

(RULE &cell_line
  (input *P *Col)
  (&dir *D)
  (axis_of D *A)
  (&cell_line_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Line_ *Line)))

(INIT &si_line Periods
  (key ((&cell_line *P ^Line *Col))
    (cell (P (:v Col))
      (&cell_line *P Line *Col))))

(RULE &period_at
  (&dir *D)
  (axis_of D *A)
  (&si_line.fundamental_period (:key *Line) A *K))

(ALTS $choice "the period's scope" $Line
  (ALT $Grid
    (INIT &si_grid Periods
      (cell (P (:v Col))
        (input *P *Col)))

    ;; The grid's period, so every line takes it.
    (RULE &period_at
      (&cell_line *Line)
      (&dir *D)
      (axis_of D *A)
      (&si_grid.fundamental_period A *K))))

;; Each output cell repeats the base cell of its line that stands at its
;; place within the period, counted from the edge the growth moves away from.
(RULE &output
  (&out_cell *P)
  (&dir *D)
  (axis_of D *A)
  (opposite D (:Opp *O))
  (&out_split1 (:P_grid_out_ P) (:A_ A) (:X_m1_ *X_m1) (:Line_ *Line))
  (&period_at Line *K)
  (margin (:B P) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (&base (:P *P2) *Col)
  (&out_split2 (:P_ P2) (:A_ A) (:X_m2_ *X_m2) (:Line_ Line))
  (margin (:B P2) (:D O) (:K R)))
