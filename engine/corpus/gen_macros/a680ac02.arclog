;; a680ac02

(INPUT squares "the input holds 4×4 squares on a field of &bg, each of one color, with no two squares of the same color and no two squares touching"

  (DET_OR_RULE &bg DominantColor))

(INPUT two-kinds "each square is either hollow (a one-cell wall around a 2×2 hole of &bg) or solid; every input holds two or more hollow squares and one or more solid squares")

(INPUT one-separating-axis "on exactly one axis, the extents of the hollow squares are pairwise disjoint; on the other axis, the extents of at least one pair of hollow squares overlap")

(OUTPUT select-hollow "the output keeps the hollow squares and drops the solid squares"

  (RULE &comp4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &ink
    (input *P *Col)
    (NOT (&bg (:C Col))))

  (INIT &comp4 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((&ink *P *Col)
           (&comp4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (RULE &comp4_component
    (&comp4.class (:a (:Col *Key) *P) *Id))

  (RULE &obj_cell
    (&comp4_component *P (:Id *O)))

  (RULE &comp8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET &square_side
    (ex_output *P)
    (perp *A (:A2 *A2_m1))
    (frame_extent P A *N)
    (frame_extent P (:A A2_m1) (:N *K))
    (< K N))

  (INIT &template_wall_frame Frame
    (key ((&square_side ^K))
      (extent (A K)
        (axis_elem *A))))

  ;; The rim of the window, and the rest of it.
  (DET &template_wall
    (&template_wall_frame.cell (:key *K) *P)
    (dir_elem (:D *D_m1))
    (relative (:Base 0) (:X P) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (<= K_m3 0))

  (INIT &template_hole_frame Frame
    (key ((&square_side ^K))
      (extent (A K)
        (axis_elem *A))))

  (DET &template_hole
    (&template_hole_frame.cell (:key *K) *P)
    (relative (:Base 0) (:X P) (:X_rel *R_m1))
    (axis_of (:D *D1_m2) (:A *A1_m3))
    (opposite (:D D1_m2) (:Opp *O1_m4))
    (perp (:A A1_m3) (:A2 *A2_m5))
    (axis_of (:D *D2_m6) (:A A2_m5))
    (opposite (:D D2_m6) (:Opp *O2_m7))
    (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
    (> K1_m8 0)
    (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
    (> K2_m9 0)
    (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
    (> K3_m10 0)
    (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
    (> K4_m11 0))

  (INIT &comp8 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((&ink *P *Col)
           (&comp8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (INIT &obj_size Cardinality
    (key ((&obj_cell (:O ^Id)))
      (member ((:m P))
        (&obj_cell (:O Id) *P))
      (domain ()
        (&obj_cell (:O Id)))))

  (INIT &fewest Order
    (member ((:t (:V Id) (:S N)))
      (&obj_size.size (:key *Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&obj_size.size (:key *Id) *N)))

  ;; The windows that match the template, one key per wall color.
  (INIT &window Occurrences
    (key ((&ink ^Col))
      (shape ((:P S) (:v V))
        (OR ((&template_hole (:P *S))
             (&bg (:C *V)))
            ((&template_wall (:P S))
             (= V Col)))))
    (cell (P (:v V))
      (input *P (:Col *V)))))

(OUTPUT axis "the output lines the kept squares up in the direction along which they lie in the input"
  (APPROXIMATED "the output lines the kept squares up along the axis on which their extents are pairwise disjoint")

  (INIT &obj_box BoundingBox
    (key ((&obj_cell (:O ^Id) *P))
      (cell (P)
        (&obj_cell (:O Id) *P))))

  (RULE &hole_cell
    (&obj_box.box (:key (:Id *Key)))
    (input *P)
    (NOT (&obj_cell (:O Key) P)))

  (RULE &hole_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &hole_flood Propagation
    (key ((&obj_box.box (:key ^Id)))
      (source ((:n P))
        (&hole_cell (:Key Id) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P)
        (NOT (&obj_cell (:O Id) P)))
      (edge ((:a P) (:b P2))
        (input *P)
        (NOT (&obj_cell (:O Id) P))
        (&hole_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2))
        (NOT (&obj_cell (:O Id) (:P P2))))))

  (RULE &hole_node
    (&hole_cell *Key *P)
    (NOT (&hole_flood.reached (:key (:Id Key)) (:n P))))

  (RULE &hole_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The cells each object closes off from the grid edge.
  (INIT &hole Quotient
    (edge ((:a (:Id Ky) P) (:b (:Id Ky) (:P P2)))
      (OR ((&hole_node (:Key *Ky) *P)
           (&hole_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&hole_node (:Key Ky) (:P P2)))
          ((&hole_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &hole_component
    (&hole.class (:a (:Id *Key) *P) *Id))

  (RULE &encloses
    (&obj_box.box (:key *Id) *B)
    (&hole_component (:Key Id) *P)
    (input P *Col)
    (&bg (:C Col)))

  (DET &cell_inside1
    (ex_input *E (:P *P_))
    (&encloses E (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &kept
    (&encloses *B))

  (RULE &sq_cell
    (&kept *B)
    (input *P)
    (ALL ((&kept B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner)))

  ;; The box of the kept squares' corners, once per corner.
  (INIT &spread2 BoundingBox
    (key ((&sq_cell *B *P)
          (ALL ((&sq_cell B P)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (corner_dir (:C ^D) (:A *A_m1) (:D *D1_m2))
          (perp (:A A_m1) (:A2 *A2_m3))
          (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
          (margin (:B P) (:D D1_m2) (:K *K1_m5))
          (margin B (:D D1_m2) (:K K1_m5))
          (margin (:B P) (:D D2_m4) (:K *K2_m6))
          (margin B (:D D2_m4) (:K K2_m6)))
      (cell (P)
        (&sq_cell *B *P)
        (ALL ((&sq_cell B P)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
        (margin (:B P) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B P) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6)))))

  (DET &out_axis
    (ex_output *E *P)
    (perp *A (:A2 *A2_m1))
    (frame_extent P A *N)
    (frame_extent P (:A A2_m1) (:N *N2))
    (> N N2))

  ;; The box of the concept's kept squares' corners, once per corner.
  (INIT &spread BoundingBox
    (key ((&encloses ^E *B)
          (ex_input E *P)
          (NOT (&cell_inside1 (:P_ P) (:B_ B)))
          (corner_dir (:C ^D) (:A *A_m1) (:D *D1_m2))
          (perp (:A A_m1) (:A2 *A2_m3))
          (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
          (margin (:B P) (:D D1_m2) (:K *K1_m5))
          (margin B (:D D1_m2) (:K K1_m5))
          (margin (:B P) (:D D2_m4) (:K *K2_m6))
          (margin B (:D D2_m4) (:K K2_m6)))
      (cell (P)
        (&encloses E *B)
        (ex_input E *P)
        (NOT (&cell_inside1 (:P_ P) (:B_ B)))
        (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
        (margin (:B P) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B P) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6)))))

  (DET &tie
    (&spread.box (:key *E) *B)
    (ex_input E *P)
    (perp *A *A2)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (axis_elem (:A A2))
    (relative (:Base B) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) N))

  (DET &tied_pair
    (&tie *E)
    (ex_output E))

  (DET &tie_axis
    (OR ((&tied_pair *E)
         (&out_axis E *A))
        ((axis_elem A)
         (NOT (&tied_pair))))
    (ONE))

  (INIT &spread_axis Singleton
    (member ((:v A))
      (&spread2.box *B)
      (input *P)
      (&tie_axis (:A *T))
      (perp *A *A2)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N)
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) (:N *N2))
      (OR ((> N N2))
          ((= N N2)
           (= A T)))))

  ;; The joint box of the kept squares.
  (INIT &joint BoundingBox
    (cell ((:P B))
      (&kept *B))))

(OUTPUT order "along that axis, the kept squares keep the order they have in the input"

  (DET &lex_diagonal DiagAxisDomain)

  (DET &lex_axis AxisDomain)

  (RULE &lex_cell
    (&sq_cell *B *P)
    (&lex_diagonal *Da)
    (diag_axis_of (:D *Corner) Da)
    (ALL ((&sq_cell B P)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (ALL ((diag_axis_of (:D Corner) (:Da *Dam))
          (&sq_cell B P)
          (corner_dir (:C Corner) (:D *D_m1m))
          (margin (:B P) (:D D_m1m) (:K *K1_m2))
          (margin B (:D D_m1m) (:K *K2_m3)))
         ((= K1_m2 K2_m3))))

  (INIT &lex Order
    (key ((&lex_cell (:Corner ^Dg) *P))
      (member ((:t P))
        (&lex_cell (:Corner Dg) *P))
      (before ((:a P) (:b P2))
        (&lex_cell (:Corner Dg) *P)
        (&lex_cell (:Corner Dg) (:P *P2))
        (&lex_cell (:Corner Dg))
        (&lex_axis *A)
        (OR ((corner_dir (:C Dg) A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir (:C Dg) A D)
             (perp A (:A2 *A2_m3))
             (corner_dir (:C Dg) (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6)))))))

(OUTPUT concatenate "the output is the kept squares, each copied unchanged, placed end to end along that axis with no gap; its size across that axis is one square"

  (RULE &sq_line_split1
    (&sq_cell *B (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &sq_line
    (&sq_cell *B *P)
    (axis_elem *A)
    (&sq_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (RULE &overlap
    (&sq_line (:B *B1) *A *L)
    (&sq_line (:B *B2) A L)
    (!= B1 B2))

  (RULE &layout_axis
    (&overlap (:A *A2))
    (perp *A A2)
    (NOT (&overlap A)))

  (RULE &run
    (&layout_axis *A)
    (axis_of *D A))

  (RULE &laid_split1
    (&sq_cell *B (:P *P_) *P_inner)
    (&run *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m4_)))

  (RULE &laid_split2
    (&sq_cell *B *P (:P_inner *P_inner_))
    (&run *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m5_))
    (relative (:Base X_m5_) (:X P_inner_) (:X_rel *P_across_)))

  (RULE &sequence_elem
    (&run *D *A)
    (&sq_line *B A *L))

  ;; The squares go by their distance to edge d.
  (RULE &sq_before
    (&run (:D *Rn))
    (&kept (:B *B1))
    (&kept (:B *B2))
    (dir_elem (:D Rn))
    (margin (:B B1) (:D Rn) (:K *K1_m1))
    (margin (:B B2) (:D Rn) (:K *K2_m2))
    (< K1_m1 K2_m2))

  (INIT &sequence Order
    (key ((OR ((&sequence_elem ^D (:B *T_b) (:L *T_l)))
              ((&sq_before (:Rn D) *B1 *B2)
               (&sequence_elem D (:B B1) (:L *L1))
               (&sequence_elem D (:B B2) (:L *L2)))
              ((&sequence_elem D *B (:L *L12))
               (&sequence_elem D B (:L *L22))
               (dir_elem D)
               (margin (:B L12) D (:K *K1_m1))
               (margin (:B L22) D (:K *K2_m2))
               (< K1_m1 K2_m2))))
      (member ((:t (:B T_b) (:L T_l)))
        (&sequence_elem D (:B *T_b) (:L *T_l)))
      (before ((:a (:B B1) (:L L1)) (:b (:B B2) (:L L2)))
        (OR ((&sq_before (:Rn D) *B1 *B2)
             (&sequence_elem D (:B B1) (:L *L1))
             (&sequence_elem D (:B B2) (:L *L2)))
            ((&sequence_elem D (:B B1) (:L L1))
             (&sequence_elem D (:B B1) (:L L2))
             (dir_elem D)
             (margin (:B L1) D (:K *K1_m1))
             (margin (:B L2) D (:K *K2_m2))
             (< K1_m1 K2_m2)
             (= B2 B1))))))

  (RULE &laid
    (&run *D *A)
    (&sequence.rank (:key D) (:t *B *L) *R)
    (&sequence.dual_rank (:key D) (:t B L) (:R *R2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K R) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_along))
    (&sq_cell B (:P *P2) *P_inner)
    (&laid_split1 (:P_ P2) (:A_ A) (:L_ L) (:X_m4_ *X_m4))
    (input (:P P2) *Col)
    (&laid_split2 (:P_inner_ P_inner) (:A_ A) (:X_m5_ *X_m5) (:P_across_ *P_across))
    (compose (:A P_along) (:B P_across) (:C *P))))

(ALTS $squares "how the kept squares are found" $ColorObjects
  (ALT $ColorObjects
    (ALTS $conn "which cells join one object" $FourConnected
      (ALT $EightConnected
        (OUTPUT select-hollow "the objects are the 8-connected single-color components"
          (RULE &comp8_component
            (&comp8.class (:a (:Col *Key) *P) *Id))
          (RULE &obj_cell
            (&comp8_component *P (:Id *O)))
          (DET &tie_axis
            (axis_elem *A)
            (ONE)))))
    (ALTS $keep "which objects are kept" $EnclosesHole
      (ALT $SelectNotFull
        (OUTPUT select-hollow "an object is kept when it does not fill its bounding box"
          (RULE &kept
            (&obj_box.box (:key *Id) *B)
            (input *P)
            (ALL ((&obj_box.box (:key (:Id *Idm)) B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0)))
            (NOT (&obj_cell (:O Id) P)))))
      (ALT $SelectFewestCells
        (OUTPUT select-hollow "the objects with the fewest cells are kept"
          (RULE &kept
            (&fewest.minimal (:t (:V *Id)))
            (&obj_box.box (:key Id) *B))))))
  (ALT $StoredTemplate
    (OUTPUT select-hollow "a window of &square_side is a kept square when its rim is one color other than &bg and the rest of it is &bg; undefined when no window matches"
      (RULE &kept
        (&window.occurrence (:P *B))))))

(ALTS $axis "the axis the output lines the squares along" $SeparatingAxis
  (ALT $AxisSpread
    (OUTPUT axis "the axis along which the kept squares' corners spread further, the same at every corner, and &tie_axis on a tie"
      (RULE &layout_axis
        (&spread_axis.value (:v *A))))
    (RULE &output
      (&laid *A *P *Col)
      (&spread_axis.value (:v A))))
  (ALT $AxisBbox
    (OUTPUT axis "the longer axis of the kept squares' joint bounding box; undefined when the box is square"
      (RULE &layout_axis
        (&joint.box *B)
        (input *P)
        (perp *A *A2)
        (axis_elem A)
        (relative (:Base B) (:X P) (:X_rel *R_m1))
        (frame_extent (:P R_m1) A *N)
        (axis_elem (:A A2))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (frame_extent (:P R_m2) (:A A2) (:N *N2))
        (> N N2)))))

(ALTS $order "the order of the squares along the axis" $AlongAxis
  (ALT $OrderColumnMajor
    (OUTPUT order "the squares go in the lexicographic order of their corners at an end of &lex_diagonal, &lex_axis first, from that corner's edge of the layout axis; both ends give one order"
      (RULE &sq_before
        (&run (:D *Rn) *A)
        (&lex.before (:key *Dg) (:a *P1) (:b *P2))
        (corner_dir (:C Dg) A (:D Rn))
        (&lex_cell (:Corner Dg) (:B *B1) (:P P1))
        (&lex_cell (:Corner Dg) (:B *B2) (:P P2))))))

(RULE &output
  (&laid *P *Col))
