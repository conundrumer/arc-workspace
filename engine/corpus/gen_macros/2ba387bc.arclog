;; 2ba387bc

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

;; The side of one square, and so of one output tile.
(DET &tile_dim TileCount)

(INIT &cells Frame
  (extent (A N)
    (axis_elem *A)
    (&tile_dim *N)))

;; The column hollow squares stack in; solid squares take the other one.
(DET &hole_side DirDomain)

(RULE &class_axis
  (&hole_side *D)
  (axis_of D *A))

;; One column per class, the classes being the two edges of the class axis.
(INIT &class_count Cardinality
  (key ((axis_of *D ^A))
    (member ((:m D))
      (axis_of *D A))))

(RULE &order_axis
  (&class_axis (:A *A3))
  (perp (:A A3) (:A2 *A)))

(RULE &square
  (&comps_component (:Key *Col) *P *Id))

(INIT &bbox BoundingBox
  (key ((&square ^Id *P))
    (cell (P)
      (&square Id *P))))

(RULE &hollow
  (input *P)
  (&bbox.box (:key *Id) *B)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&square Id P)))

(RULE &stack
  (&square *Id)
  (&hole_side (:D *D0))
  (OR ((NOT (&hollow Id))
       (opposite (:D D0) (:Opp *D)))
      ((&hollow Id)
       (= D D0))))

(INIT &height Cardinality
  (key ((&stack *Id ^D))
    (member ((:m Id))
      (&stack *Id D))))

(INIT &tallest Order
  (member ((:t N))
    (&height.size *N))
  (score ((:t N) (:S N))
    (&height.size *N)))

(INIT &tiles Frame
  (extent (A N)
    (OR ((&order_axis *A)
         (&tallest.maximal (:t *N)))
        ((&class_axis A)
         (&class_count.size (:key A) N)))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tiles.cell (:P *P_tile)))
  (inner ((:P P_intile))
    (&cells.cell (:P *P_intile))))

;; The corner reading order runs from.
(DET &corner DiagDirDomain)

(RULE &order_cell
  (&stack *Id (:D *Key))
  (&bbox.box (:key Id) (:B *P)))

;; Each square compares as its box.
(INIT &order Order
  (key ((&order_cell (:Key ^Ky) *P))
    (member ((:t P))
      (&order_cell (:Key Ky) *P))
    (before ((:a Q) (:b P))
      (&order_cell (:Key Ky) (:P *Q))
      (&order_cell (:Key Ky) *P)
      (&order_cell (:Key Ky))
      (&corner (:D *Diag))
      (&order_axis *A)
      (OR ((corner_dir (:C Diag) A *D)
           (dir_elem D)
           (margin (:B Q) D (:K *K1_m1))
           (margin (:B P) D (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C Diag) A D)
           (perp A (:A2 *A2_m3))
           (corner_dir (:C Diag) (:A A2_m3) (:D *D2))
           (margin (:B Q) D (:K *K_m4))
           (margin (:B P) D (:K K_m4))
           (dir_elem (:D D2))
           (margin (:B Q) (:D D2) (:K *K1_m5))
           (margin (:B P) (:D D2) (:K *K2_m6))
           (< K1_m5 K2_m6))))))

(RULE &square_tile
  (&stack *Id *D)
  (&bbox.box (:key Id) *B)
  (&order.rank (:key (:Ky D)) (:t B) *R)
  (&tiles.cell (:P *P_tile))
  (margin (:B P_tile) D (:K 0))
  (&corner (:D *Cn))
  (&order_axis *A)
  (corner_dir (:C Cn) A (:D *D_ord))
  (margin (:B P_tile) (:D D_ord) (:K R)))

(RULE &tile_cell
  (&square_tile *Id *P_tile)
  (&square Id *P *Col)
  (&bbox.box (:key Id) *B)
  (ALL ((&square (:Id *Idm) P (:Col *Colm))
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &output
  (&output_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) *P)
  (OR ((&tile_cell P_tile P_intile *Col))
      ((NOT (&tile_cell P_tile P_intile))
       (&bg (:C Col)))))
