;; 8886d717

(DET &mark ColorDomain)

;; Marks in this region take its color.
(DET &absorb UnchangedColor)

;; Marks in this region copy themselves toward the edge line.
(DET &extend DominantColor)

(DET &border UnchangedColor)

(RULE &mark2
  (input *P *Col)
  (&mark (:C Col)))

(RULE &around
  (&mark2 *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (NOT (&mark (:C Col))))

(INIT &cell_region Singleton
  (key ((&around ^P *Col))
    (member ((:v Col))
      (&around P *Col))))

(RULE &region
  (&cell_region.value (:key *P) (:v *Col)))

;; The one color of each edge line, where it has one.
(INIT &edge_color Singleton
  (key ((dir_elem ^D))
    (member ((:v Col))
      (input *P *Col)
      (margin (:B P) D (:K 0)))))

(RULE &border_dir
  (&edge_color.value (:key *D) (:v *Col))
  (&border (:C Col)))

(ALTS $region "how a mark reads the region it sits in" $Cell
  (ALT $Cluster
    (RULE &clusters_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &clusters Quotient
      (edge ((:a P) (:b P3))
        (OR ((&mark2 *P)
             (&clusters_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&mark2 (:P P3)))
            ((&mark2 P)
             (= P3 P)))))

    (RULE &clusters_component
      (&clusters.class (:a *P) *Id))

    (INIT &cluster_region Singleton
      (key ((&clusters_component *P ^Id)
            (&around P *Col))
        (member ((:v Col))
          (&clusters_component *P Id)
          (&around P *Col))))

    (RULE &region
      (&clusters_component *P *Id)
      (&cluster_region.value (:key Id) (:v *Col)))))

(ALTS $border "which edge the line runs along" $Stored
  (ALT $Uniform
    (RULE &border_dir
      (&edge_color.value (:key *D)))))

(RULE &copy
  (&region (:P *P2) *Col)
  (&extend (:C Col))
  (&border_dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

(RULE &output
  (OR ((&copy *P)
       (&mark (:C *Col)))
      ((&region P (:Col *Col2))
       (OR ((&extend (:C Col2))
            (&mark (:C Col)))
           ((&absorb (:C Col2))
            (= Col Col2))))
      ((input P Col)
       (NOT (&mark2 P))
       (NOT (&copy P)))))
