;; 03560426

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &blocks Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *P) *Id))

(DET &order DirDomain)

(DET &corner DiagDirDomain)

(INIT &bb BoundingBox
  (key ((&blocks_component *P ^Id))
    (cell (P)
      (&blocks_component *P Id))))

(RULE &block_corner
  (&blocks_component *P *Id)
  (&bb.box (:key Id) *B)
  (ALL ((&blocks_component P (:Id *Idm))
        (&bb.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &near
  (&corner (:D *Diag))
  (diag_opposite (:D Diag) (:Opp *Start))
  (&block_corner *Id *P (:D Start)))

(RULE &beyond
  (&order *D)
  (&bb.box (:key (:Id *Id1)) (:B *B1))
  (&bb.box (:key (:Id *Id2)) (:B *B2))
  (dir_elem D)
  (margin (:B B1) D (:K *K1_m1))
  (margin (:B B2) D (:K *K2_m2))
  (< K1_m1 K2_m2))

(INIT &chain Order
  (member ((:t Id))
    (&blocks_component *Id))
  (before ((:a Id1) (:b Id2))
    (&beyond *Id1 *Id2)))

;; The chain's walk: the first block's near corner lands on the start corner,
;; and each next block's near corner lands where the previous block's far
;; corner lands.
(INIT &walk Propagation
  (source ((:n Id P))
    (&chain.minimal (:t *Id))
    (&corner (:D *Diag))
    (diag_opposite (:D Diag) (:Opp *Start))
    (input *P)
    (corner_dist P (:Diag Start) (:K 0)))
  (edge ((:a (:Id Id1) (:P A)) (:b (:Id Id2) (:P A2)))
    (&chain.successor (:a *Id1) (:b *Id2))
    (input (:P *A))
    (&near (:Id Id1) (:P *N))
    (&corner (:D *Diag))
    (&block_corner (:Id Id1) (:P *F) (:D Diag))
    (relative (:Base N) (:X F) (:X_rel *V))
    (compose A (:B V) (:C *A2))))

(RULE &place
  (&walk.reached (:n *Id (:P *A)))
  (&blocks_component (:P *P_in) Id)
  (&near Id (:P *N))
  (relative (:Base N) (:X P_in) (:X_rel *V))
  (compose A (:B V) (:C *P_out)))

(RULE &taken
  (&place *Id (:P_out *P))
  (&beyond (:Id1 Id) *Id2)
  (&place (:Id Id2) (:P_out P)))

(RULE &output
  (OR ((&place *Id *P_in (:P_out *P))
       (NOT (&taken Id P))
       (input (:P P_in) *Col))
      ((input P)
       (NOT (&place (:P_out P)))
       (&bg (:C Col)))))
