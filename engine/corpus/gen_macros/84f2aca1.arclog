;; 84f2aca1

(DET &holes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &changed
  (ex_input *E *P (:Col *C_in))
  (ex_output E P *Col)
  (!= Col C_in))

(INIT &holes Quotient
  (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
    (OR ((&changed *E *P)
         (&holes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&changed E (:P P3)))
        ((&changed E P)
         (= P3 P)))))

(DET &holes_component
  (&holes.class (:a *Key *P) *Id))

(DET &bg DominantColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; $Rect: the inside of each rectangle outline drawn in ink.
(INIT &drect Outlines
  (node (P)
    (&ink *P)))

(INIT &rect_id Quotient
  (equivalent ((:a B) (:b B))
    (&drect.box *B)))

(RULE &region
  (&rect_id.class (:a *B) *Id)
  (&bg_cell *P)
  (ALL ((&rect_id.class (:a B) (:Id *Idm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(DET &hole
  (&holes_component (:Key *E) *P *Id)
  (&changed E P *Col))

(INIT &hole_size Cardinality
  (key ((&hole ^E ^Id *P))
    (member ((:m P))
      (&hole E Id *P))))

(DET &count_fill
  (&hole_size.size (:key (:E *H_e) (:Id *H_id)) *N)
  (&hole (:E H_e) (:Id H_id) *Col))

(ALTS $r "which cells count as the hole" $Rect
  (ALT $Box
    (RULE &objs_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    ;; $Box: the bg cells each ink object's box holds.
    (INIT &objs Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&objs_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &objs_component
      (&objs.class (:a *P) *Id))

    (INIT &obox BoundingBox
      (key ((&objs_component *P ^Id))
        (cell (P)
          (&objs_component *P Id))))

    (RULE &region
      (&obox.box (:key *Id) *B)
      (&bg_cell *P)
      (ALL ((&obox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))))
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&bg_cell *P))

    (INIT &closed_flood Propagation
      (source ((:n P))
        (&closed_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&bg_cell P))
      (edge ((:a P) (:b P2))
        (&bg_cell *P)
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&bg_cell (:P P2))))

    (RULE &closed_node
      (&closed_cell *P)
      (NOT (&closed_flood.reached (:n P))))

    ;; $Enclose: the bg regions closed off from the grid edge.
    (INIT &closed Quotient
      (edge ((:a P) (:b P2))
        (OR ((&closed_node *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:P P2)))
            ((&closed_node P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *P) *Id))

    (RULE &region
      (&closed_component *P *Id))))

(ALTS $k "what selects the fill color" $Count
  (ALT $Extent
    (INIT &rbox BoundingBox
      (key ((&region ^Id *P))
        (cell (P)
          (&region Id *P))))

    (INIT &hbox BoundingBox
      (key ((&hole ^E ^Id *P))
        (cell (P)
          (&hole E Id *P))))

    (DET &extent_fill
      (&hbox.box (:key (:E *H_e) (:Id *H_id)) *B)
      (&hole (:E H_e) (:Id H_id) *P *Col)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *N_short))
      (perp A *A2)
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) (:N *N_long))
      (<= N_short N_long))

    (RULE &fill
      (&rbox.box (:key *Id) *B)
      (&region Id *P)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *N1))
      (perp A *A2)
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) (:N *N2))
      (&extent_fill (:N_short N1) (:N_long N2) *Col))))

(INIT &region_size Cardinality
  (key ((&region ^Id *P))
    (member ((:m P))
      (&region Id *P))))

(RULE &fill
  (&region_size.size (:key *Id) *N)
  (&count_fill N *Col))

(RULE &painted
  (&region *Id *P)
  (&fill Id *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
