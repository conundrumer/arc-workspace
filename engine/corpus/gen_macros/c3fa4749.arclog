;; c3fa4749

(INPUT blocks "several solid one-color blocks lie against the grid border in a field of random colors; a block is made of one-color 4-connected regions of at least &min_block_cells cells each, and a channel that crosses a block cuts it into more than one such region"

  (DET_OR_RULE &min_block_cells "The fewest cells a one-color region has to be a block region." ConstInDim)

  (RULE &regions8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &regions8 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((input *P *Col)
           (&regions8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (= P3 P))))))

(INPUT channels "each block holds one or more pockets, each a 4-connected set of cells that lie in no block region")

(OUTPUT dead-end-fills "a channel drawn 4-connected from one grid-border cell into a block takes that border cell's color in every cell when it ends inside the block, and keeps its colors when it runs out through the block's side"
  (APPROXIMATED "a pocket whose every neighbor lies in one block region, and that meets the grid border at exactly one cell, takes that cell's color in every cell, the block-colored cells it walls in included")

  (RULE &regions_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &regions Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((input *P *Col)
           (&regions_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (= P3 P)))))

  (RULE &regions_component
    (&regions.class (:a *Key *P) *Id))

  (RULE &pockets_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &region
    (&regions_component *P (:Id *X)))

  (INIT &region_size Cardinality
    (key ((&region (:X ^Id) *P))
      (member ((:m P))
        (&region (:X Id) *P))))

  (RULE &block
    (&region (:X *R) *P)
    (&region_size.size (:key (:Id R)) *N)
    (&min_block_cells (:N *K))
    (>= N K))

  (INIT &pockets Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P)
           (NOT (&block P))
           (&pockets_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3))
           (NOT (&block (:P P3))))
          ((input P)
           (NOT (&block P))
           (= P3 P)))))

  (RULE &pockets_component
    (&pockets.class (:a *P) *Id))

  (RULE &box_pockets_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &grid_pocket
    (&pockets_component *P (:Id *X)))

  (RULE &step_dir
    (dir_elem *D))

  ;; The block regions that each pocket's neighbors lie in.
  (INIT &wall Singleton
    (key ((&grid_pocket (:X ^Id) *P)
          (&step_dir *D)
          (step_offset D (:V *V_m1))
          (compose (:A P) (:B V_m1) (:C *Q))
          (&block *R (:P Q)))
      (member ((:v R))
        (&grid_pocket (:X Id) *P)
        (&step_dir *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (&block *R (:P Q)))))

  (RULE &pocket
    (&wall.value (:key *Id) (:v *Region))
    (&grid_pocket (:X Id) *P))

  (RULE &mouth
    (&pocket *Region *Id *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))

  ;; The cells where each pocket opens, as one cell.
  (INIT &one_mouth Singleton
    (key ((&mouth ^Region ^Id *P))
      (member ((:v P))
        (&mouth Region Id *P))))

  (INIT &block_box BoundingBox
    (key ((&block ^R *P))
      (cell (P)
        (&block R *P))))

  (RULE &box_pockets_node
    (&block_box.box (:key (:R *Key)) *B)
    (input *P)
    (ALL ((&block_box.box (:key (:R *Rm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&region (:X Key) P)))

  (INIT &box_pockets Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&box_pockets_node (:Key *Ky) *P)
           (&box_pockets_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&box_pockets_node (:Key Ky) (:P P2)))
          ((&box_pockets_node (:Key Ky) P)
           (= P2 P)))))

  ;; The colors of the cells where each pocket opens, as one color.
  (INIT &mouth_color Singleton
    (key ((&mouth ^Region ^Id *P)
          (input P *Col))
      (member ((:v Col))
        (&mouth Region Id *P)
        (input P *Col)))))

(OUTPUT rest-kept "every other cell keeps its input color")

(ALTS $place "where a dead end's mouth lies" $GridBorder
  (ALT $MouthOnBlockSide
    (OUTPUT dead-end-fills "the pockets of a block region are the 4-connected sets of cells inside the region's bounding box that lie outside the region, and a pocket with exactly one cell on that box's edge takes that cell's color in every cell; undefined where two such pockets share a cell and give it different colors"
      (RULE &box_pockets_component
        (&box_pockets.class (:a *Key *P) *Id))

      (RULE &pocket
        (&box_pockets_component (:Key *Region) *P *Id))

      (RULE &mouth
        (&pocket *Region *Id *P)
        (&block_box.box (:key (:R Region)) *B)
        (ALL ((&pocket (:Region *Rm) (:Id *Idm) P)
              (&block_box.box (:key (:R Rm)) B)
              (dir_elem (:D *D_m1m))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) (:D *D_m1) (:K *K_m2))
        (margin B (:D D_m1) (:K K_m2))))
    (ALT $Adjacency8
      (OUTPUT dead-end-fills "a pocket's diagonal neighbors are neighbors too"
        (RULE &box_pockets8_component
          (&box_pockets8.class (:a *Key *P) *Id))

        (RULE &pocket
          (&box_pockets8_component (:Key *Region) *P *Id))))))

(ALTS $adj "the adjacency of block regions, pockets and their walls" $Orthogonal
  (ALT $Adjacency8
    (INPUT blocks "block regions are 8-connected")
    (INPUT channels "pockets are 8-connected"
      (RULE &pockets8_steps
        (OR ((dir_elem *D)
             (step_offset D (:V *Delta)))
            ((diag_dir_elem (:D *D2))
             (step_offset (:D D2) (:V Delta)))))

      (INIT &pockets8 Quotient
        (edge ((:a P) (:b P3))
          (OR ((input *P)
               (NOT (&block P))
               (&pockets8_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P3))
               (input (:P P3))
               (NOT (&block (:P P3))))
              ((input P)
               (NOT (&block P))
               (= P3 P))))))
    (OUTPUT dead-end-fills "a pocket's diagonal neighbors are neighbors too"
      (RULE &regions8_component
        (&regions8.class (:a *Key *P) *Id))

      (RULE &pockets8_component
        (&pockets8.class (:a *P) *Id))

      (RULE &region
        (&regions8_component *P (:Id *X)))

      (RULE &step_dir
        (dir8_elem *D))

      (RULE &grid_pocket
        (&pockets8_component *P (:Id *X)))

      (RULE &box_pockets8_node
        (&block_box.box (:key (:R *Key)) *B)
        (input *P)
        (ALL ((&block_box.box (:key (:R *Rm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (NOT (&region (:X Key) P)))

      (INIT &box_pockets8 Quotient
        (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
          (OR ((&box_pockets8_node (:Key *Ky) *P)
               (&box_pockets8_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&box_pockets8_node (:Key Ky) (:P P2)))
              ((&box_pockets8_node (:Key Ky) P)
               (= P2 P))))))))

(ALTS $mouths "how many border cells a dead end meets" $OneMouth
  (ALT $WalledAnyMouth
    (OUTPUT dead-end-fills "a walled pocket that meets the grid border at one or more cells, all of one color, takes that color, and a pocket whose border cells differ keeps its colors")
    (RULE &fill
      (&mouth_color.value (:key (:Region *R) *Id) (:v *Col))
      (&pocket (:Region R) Id *P))))

(RULE &box_pockets8_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(RULE &fill
  (&one_mouth.value (:key (:Region *R) *Id) (:v *Q))
  (input (:P Q) *Col)
  (&pocket (:Region R) Id *P))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))
