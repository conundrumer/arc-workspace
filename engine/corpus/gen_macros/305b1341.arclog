;; 305b1341

(DET &bg DominantColor)

;; The edge the legend's dot colors sit on.
(DET &legend_side DirDomain)

(RULE &legend
  (&legend_side (:D *D_side))
  (input (:P *P_dot) (:Col *Dot))
  (margin (:B P_dot) (:D D_side) (:K 0))
  (NOT (&bg (:C Dot)))
  (step_offset (:D D_side) (:V *V_m1))
  (input (:P *P_fill) (:Col *Fill))
  (compose (:A P_fill) (:B V_m1) (:C P_dot))
  (NOT (&bg (:C Fill))))

(RULE &panel_cell
  (&legend *Dot)
  (input *P (:Col Dot))
  (NOT (&legend (:P_dot P)))
  (NOT (&legend (:P_fill P))))

(INIT &bbox BoundingBox
  (key ((&panel_cell ^Dot *P))
    (cell (P)
      (&panel_cell Dot *P))))

(DET &dot_gap DivisorRatio)

(DET &dot_size DivisorRatio)

(RULE &lattice_division_gap
  (axis_elem *A)
  (&dot_gap (:K *G)))

(RULE &lattice_division_axis_split1
  (&bbox.box *B)
  (input *P)
  (relative (:Base B) (:X P) (:X_rel *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &lattice_division_side
  (axis_elem *A)
  (&dot_size *K))

(RULE &lattice_division_axis
  (OR ((input (:P *P2))
       (&bbox.box *B)
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P2) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P2) (:X_rel *P))
       (axis_elem *A)
       (&dot_size *K)
       (&dot_gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input (:P *P22))
       (&bbox.box (:B *B2))
       (ALL ((dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P22) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B2) (:X P22) (:X_rel P))
       (axis_elem A)
       (&dot_size (:K *K2))
       (NOT (&lattice_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((input (:P *P23))
       (&bbox.box (:B *B3))
       (ALL ((dir_elem (:D *D_m13))
             (relative (:Base B3) (:X P23) (:X_rel *R_m23))
             (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
            ((>= K_m33 0)))
       (relative (:Base B3) (:X P23) (:X_rel P))
       (axis_elem A)
       (NOT (&lattice_division_side A))
       (&lattice_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &lattice_division_tile
  (&lattice_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&lattice_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; The quarter turn from legend_side to the edge the first entry lies on.
(DET &legend_sense SenseDomain)

(RULE &dots_choice)

(RULE &lattice
  (input *P)
  (&bbox.box (:key *Dot) *B)
  (ALL ((&bbox.box (:key (:Dot *Dotm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&lattice_division_tile (:P P_inner)))

(RULE &dotted
  (&panel_cell *Dot *P))

(RULE &core
  (&dots_choice)
  (input *P)
  (&bbox.box (:key *Dot) *B)
  (ALL ((&bbox.box (:key (:Dot *Dotm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &above
  (&legend_side *D)
  (&legend_sense *S)
  (turn S D (:D2 *D_run))
  (&legend *Dot (:P_dot *P))
  (&legend (:Dot *Dot2) (:P_dot *P2))
  (dir_elem (:D D_run))
  (margin (:B P) (:D D_run) (:K *K1_m1))
  (margin (:B P2) (:D D_run) (:K *K2_m2))
  (< K1_m1 K2_m2))

(ALTS $dots "what a panel holds" $Shown
  (ALT $Lattice
    (RULE &dotted
      (&lattice *Dot *P))))

(ALTS $panel "what the panel's ring grows around" $Box
  (ALT $Cells
    (RULE &core
      (&dotted *Dot *P))))

(ALTS $stack "which of two overlapping panels wins" $Legend
  (ALT $Occlusion
    (RULE &above
      (&lattice (:Dot *Dot2) *P)
      (NOT (&panel_cell (:Dot Dot2) P))
      (&panel *Dot P)
      (!= Dot Dot2))))

(RULE &panel
  (&core *Dot (:P *P2))
  (OR ((dir8_elem *D)
       (step_offset D (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C *P))
       (input P))
      ((= P P2))))

(RULE &paint
  (&panel *Dot *P)
  (&legend Dot *Fill)
  (IF ((&dotted Dot P))
      ((= *Ink Dot))
      ((= Ink Fill))))

(RULE &covered
  (&paint *Dot *P)
  (&paint (:Dot *Dot2) P)
  (&above (:Dot Dot2) (:Dot2 Dot)))

(RULE &output
  (input *P)
  (OR ((&paint *Dot P (:Ink *Col))
       (NOT (&covered P Dot)))
      ((NOT (&paint P))
       (&bg (:C Col)))))
