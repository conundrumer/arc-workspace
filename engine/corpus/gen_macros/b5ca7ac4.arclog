;; b5ca7ac4

(INPUT background "one background color fills every cell outside the squares"

  (DET &at_edge
    (ex_output *E *P *Col)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))

  (DET &missing
    (ex_output *E)
    (&at_edge *Col *D)
    (NOT (&at_edge E Col D)))

  (DET &heading
    (&at_edge *Col *D)
    (NOT (&missing Col D)))

  (RULE &slide
    (&heading *Col *D))

  ;; The rectangle outlines of each frame color.
  (INIT &outline Outlines
    (key ((&slide ^Col))
      (node (P)
        (input *P Col))))

  (RULE &square_box
    (&outline.box (:key *Col) *B)
    (input *P Col)
    (axis_elem *A)
    (perp A *A2)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (axis_elem (:A A2))
    (relative (:Base B) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) N))

  ;; The interior color of each square outline.
  (INIT &fill Singleton
    (key ((&square_box ^B))
      (member ((:v Col))
        (input *P *Col)
        (ALL ((input P (:Col *Colm))
              (&square_box B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((> K_m3 0))))))

  (RULE &framed
    (&square_box *Col *B)
    (&fill.value (:key B)))

  (RULE &inner_square
    (&framed *B)
    (&framed (:B *B2))
    (!= B B2)
    (ALL ((&framed B)
          (&framed (:B B2))
          (dir_elem (:D *D_m1))
          (relative (:Base B2) (:X B) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &square
    (&framed *Col *B)
    (NOT (&inner_square B)))

  (RULE &body_cell
    (&square *B)
    (input *P)
    (ALL ((&square B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (INIT &outside Singleton
    (member ((:v Col))
      (input *P *Col)
      (NOT (&body_cell P)))))

(INPUT framed-squares "the other cells form squares of side 5, each a one-cell outline in one of the colors of &heading around a solid interior of one color, and the interior color may equal a frame color"

  (RULE &component8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &component8 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (&slide Col)
           (&component8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (&slide Col)
           (= P3 P))))))

(INPUT disjoint-squares "no two squares share a cell, and two squares may touch along an edge or at a corner")

(OUTPUT slide-by-frame "each square keeps its rows and moves along the row axis toward the direction &heading gives its frame color")

(OUTPUT stack-per-color "the squares of one frame color fall together as rigid bodies: each square stops at the first place where it meets the grid edge or a stopped square of the same frame color, and squares of the other frame color do not block it"

  (RULE &component4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &component4 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (&slide Col)
           (&component4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (&slide Col)
           (= P3 P)))))

  (RULE &component4_component
    (&component4.class (:a (:Col *Key) *P) *Id))

  (RULE &enclosed_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &enclosed_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &component
    (&component4_component (:Key *Col) *P *Id))

  (RULE &enclosed_cell
    (&component (:Id *Key))
    (input *P)
    (NOT (&component (:Id Key) P)))

  (INIT &enclosed_flood Propagation
    (key ((&component ^Id))
      (source ((:n P))
        (&enclosed_cell (:Key Id) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P)
        (NOT (&component Id P)))
      (edge ((:a P) (:b P2))
        (input *P)
        (NOT (&component Id P))
        (&enclosed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2))
        (NOT (&component Id (:P P2))))))

  (RULE &enclosed_node
    (&enclosed_cell *Key *P)
    (NOT (&enclosed_flood.reached (:key (:Id Key)) (:n P))))

  ;; The cells each component closes off from the grid edge.
  (INIT &enclosed Quotient
    (edge ((:a (:Id Ky) P) (:b (:Id Ky) (:P P2)))
      (OR ((&enclosed_node (:Key *Ky) *P)
           (&enclosed_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&enclosed_node (:Key Ky) (:P P2)))
          ((&enclosed_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &enclosed_component
    (&enclosed.class (:a (:Id *Key) *P) *Id))

  ;; The squares of each frame color fall together toward its heading.
  (INIT &square_fall Distance
    (key ((OR ((&square ^Col *B)
               (input *P)
               (ALL ((&square (:Col *Colm) B)
                     (dir_elem (:D *D_m1))
                     (relative (:Base B) (:X P) (:X_rel *R_m2))
                     (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                    ((>= K_m3 0)))
               (&slide Col *D)
               (margin (:B P) D *K))
              ((&square Col B)
               (input P)
               (ALL ((&square (:Col *Colm2) B)
                     (dir_elem (:D *D_m12))
                     (relative (:Base B) (:X P) (:X_rel *R_m22))
                     (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                    ((>= K_m32 0)))
               (&slide Col D)
               (&square Col (:B *B2))
               (input (:P *P2))
               (ALL ((&square (:Col *Colmm) (:B B2))
                     (dir_elem (:D *D_m1m))
                     (relative (:Base B2) (:X P2) (:X_rel *R_m2m))
                     (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                    ((>= K_m3m 0)))
               (!= B B2)
               (gap D P (:Q P2) K))))
      (weight ((:a B2) (:b B) (:W K))
        (&square Col *B)
        (input *P)
        (ALL ((&square (:Col *Colm) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (&slide Col *D)
        (&square Col (:B *B2))
        (input (:P *P2))
        (ALL ((&square (:Col *Colmm) (:B B2))
              (dir_elem (:D *D_m1m))
              (relative (:Base B2) (:X P2) (:X_rel *R_m2m))
              (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
             ((>= K_m3m 0)))
        (!= B B2)
        (gap D P (:Q P2) *K))
      (source_distance ((:n B) K)
        (&square Col *B)
        (input *P)
        (ALL ((&square (:Col *Colm) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (&slide Col *D)
        (margin (:B P) D *K))))

  (RULE &nested
    (&component *Id *P)
    (&enclosed_component (:Key *Id2) P)
    (!= Id Id2))

  (RULE &frame_body
    (&component *Col *Id)
    (NOT (&nested Id))
    (OR ((&component Col Id *P))
        ((&enclosed_component (:Key Id) P))))

  ;; The bodies of each frame color fall together toward its heading.
  (INIT &frame_fall Distance
    (key ((&frame_body ^Col))
      (weight ((:a Id2) (:b Id) (:W K))
        (&frame_body Col *Id *P)
        (&slide Col *D)
        (&frame_body Col (:Id *Id2) (:P *P2))
        (!= Id Id2)
        (gap D P (:Q P2) *K))
      (source_distance ((:n Id) K)
        (&frame_body Col *Id *P)
        (&slide Col *D)
        (margin (:B P) D *K)))))

(OUTPUT background-rest "every cell that no moved square covers takes the background color"

  (INIT &commonest_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N)))

  (INIT &dominant Singleton
    (member ((:v Col))
      (&commonest.maximal (:t *Col)))))

(ALTS $bodies "what moves as one body" $Squares
  (ALT $FrameComponents
    (INPUT framed-squares "a body is a 4-connected component of one frame color's cells together with the cells it closes off from the grid edge, and a component inside another body's closed-off cells belongs to that body"
      (RULE &body_cell
        (&frame_body *P))

      (RULE &frame_fall_dir
        (&frame_body (:Col *Key))
        (&slide (:Col Key) *D)))
    (RULE &moved
      (&frame_fall.distance (:key (:Col *Col2)) (:n *Id) *K)
      (&frame_fall_dir (:Key Col2) *D)
      (dir8_opposite D (:D2 *O_m1))
      (edge_inset (:D O_m1) K (:B *B1_m2))
      (edge_inset D K (:B *I_m4))
      (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *V))
      (&frame_body (:Col Col2) Id (:P *P3))
      (input (:P P3) *Col)
      (compose (:A P3) (:B V) (:C *P)))
    (ALTS $adj "which cells join one component" $Adjacent4
      (ALT $Adjacent8
        (INPUT framed-squares "components join by 8-adjacency, so squares that touch at a corner only join one body"
          (RULE &component8_component
            (&component8.class (:a (:Col *Key) *P) *Id))
          (RULE &component
            (&component8_component (:Key *Col) *P *Id)))))))

(ALTS $heading "where a square's heading comes from" $StoredHeading
  (ALT $HeadingOpposite
    (OUTPUT slide-by-frame "&lead_heading gives the lead frame color's direction, and the squares of &trail_color slide the opposite way"
      ;; The cells of each color across the train outputs.
      (INIT &color_cells Cardinality
        (key ((ex_output *E *P ^Col))
          (member ((:m E P))
            (ex_output *E *P Col))))

      (DET &lead_trail
        (&heading *Col *D)
        (&heading (:Col *Col2) (:D *D2))
        (opposite D (:Opp D2))
        (&color_cells.size (:key Col) *N)
        (&color_cells.size (:key (:Col Col2)) (:N *N2))
        (< N2 N))

      (DET &lead_heading
        (&lead_trail *Col *D))

      (DET &trail_color
        (&lead_trail (:Col2 *Col)))

      (RULE &slide
        (OR ((&lead_heading *Col *D))
            ((&trail_color Col)
             (&lead_heading (:D *D_lead))
             (opposite (:D D_lead) (:Opp D))))))))

(ALTS $background "the color of the cells no moved square covers" $OutsideBodies
  (ALT $BackgroundDominant
    (OUTPUT background-rest "every cell that no moved square covers takes the commonest color of the input; undefined where two colors tie")
    (RULE &background
      (&dominant.value (:v *Col)))))

(RULE &background
  (&outside.value (:v *Col)))

(RULE &square_fall_dir
  (&slide (:Col *Key) *D))

(RULE &moved
  (&square_fall.distance (:key (:Col *Col2)) (:n *B) *K)
  (&square_fall_dir (:Key Col2) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (input (:P *P3) *Col)
  (ALL ((input (:P P3) (:Col *Col_inm))
        (&square_fall.distance (:key (:Col *Colm)) (:n B) (:K *Km))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P3) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &output
  (&background (:Col *Col_bg))
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (= Col Col_bg))))
