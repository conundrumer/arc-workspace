;; 62b74c02

(DET &bg ChangedColor)

(DET &dir DirDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &empty_dir
  (&dir *D))

(ALTS $dir "the empty edge" $Dir
  (ALT $Edge
    (RULE &empty_dir
      (&bbox.box *B)
      (dir_elem *D)
      (NOT (margin B D (:K 0))))))

(ALTS $fill "which boundary of the block is copied" $Outer
  (ALT $Inner
    (RULE &fill_edge
      (&empty_dir (:D *E1)))))

;; The block slides to the empty edge; the copy lands where it comes to rest.
(INIT &slide Distance
  (source_distance (K)
    (&ink *P)
    (&empty_dir)
    (&empty_dir *D)
    (margin (:B P) D *K)))

(RULE &copy
  (&ink (:P *P3) *Col)
  (&slide.distance *K)
  (&empty_dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &fill_edge
  (&empty_dir *D)
  (opposite D (:Opp *E1)))

(RULE &fill
  (input *P (:Col *Bg))
  (&bg (:C Bg))
  (&fill_edge (:E1 *E))
  (NOT (&copy P))
  (&ink (:P *Q) *Col)
  (&bbox.box *B)
  (ALL ((&ink (:P Q) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X Q) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B Q) (:D E) (:K *K_m1))
  (margin B (:D E) (:K K_m1))
  (axis_of (:D E) *A)
  (perp A (:A2 *A2_m2))
  (axis_of (:D *D_m3) (:A A2_m2))
  (margin (:B P) (:D D_m3) (:K *K_m4))
  (margin (:B Q) (:D D_m3) (:K K_m4)))

(RULE &output
  (OR ((&ink *P *Col)
       (&empty_dir))
      ((&copy P Col))
      ((&fill P Col))))
