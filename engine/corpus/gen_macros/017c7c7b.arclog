;; 017c7c7b

(DET &dir DirDomain)

(RULE &axis
  (&dir *D)
  (axis_of D *A))

(RULE &cell_line_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Line_)))

(DET &extent ConstOutDim)

;; Output frame: the input grown along &dir to &extent.
(INIT &frame Frame
  (extent (A N)
    (OR ((&axis *A)
         (&extent *N))
        ((input *P)
         (&axis (:A *A3))
         (perp (:A A3) (:A2 A))
         (frame_extent P A N)))))

(RULE &fill_split1
  (&frame.cell (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Line_)))

(DET &bg ChangedColor)

(DET &ink AnyOutNewColor)

(RULE &cell_line
  (input *P *Col)
  (&axis *A)
  (&cell_line_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Line_ *Line)))

(RULE &base
  (&frame.cell *P)
  (&cell_line (:P *P_grid_in) *Line *Col)
  (&dir *D)
  (opposite D (:Opp *O))
  (margin (:B P_grid_in) (:D O) (:K *K_m1))
  (margin (:B P) (:D O) (:K K_m1))
  (ALL ((opposite (:D *Dm) (:Opp O))
        (&cell_line (:P P_grid_in) (:Line *Linem) (:Col *Colm))
        (axis_of (:D O) (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E_m3) (:A A2_m2))
        (margin (:B P_grid_in) (:D E_m3) (:K *K1_m4))
        (margin (:B P) (:D E_m3) (:K *K2_m5)))
       ((= K1_m4 K2_m5))))

(INIT &si_line Periods
  (key ((&cell_line *P ^Line *Col))
    (cell (P (:v Col))
      (&cell_line *P Line *Col))))

(RULE &period_at
  (&axis *A)
  (&si_line.fundamental_period (:key *Line) A *K))

(ALTS $choice "the period's scope" $Line
  (ALT $Grid
    (INIT &si_grid Periods
      (cell (P (:v Col))
        (input *P *Col)))

    ;; The grid's period, so every line takes it.
    (RULE &period_at
      (&cell_line *Line)
      (&axis *A)
      (&si_grid.fundamental_period A *K))))

(RULE &fill
  (&frame.cell *P)
  (&axis *A)
  (&fill_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Line_ *Line))
  (&period_at Line *K)
  (&dir *D)
  (opposite D (:Opp *O))
  (margin (:B P) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (&base Line (:P *Q) *Col)
  (margin (:B Q) (:D O) (:K R)))

(RULE &output
  (&fill *P (:Col *C))
  (OR ((NOT (&bg C))
       (&ink (:C *Col)))
      ((&bg C)
       (= Col C))))
