;; bc1d5164

(DET &bg DominantColor)

(DET &frame Frame)

(RULE &contribution
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (diag_dir_elem (:D *Diag))
  (&frame (:P *P_out))
  (ALL ((input (:P P_in) (:Col *Colm))
        (corner_dir (:C Diag) (:D *D_m1))
        (margin (:B P_in) (:D D_m1) (:K *K1_m2))
        (margin (:B P_out) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

(RULE &output
  (OR ((&contribution (:P_out *P) *Col))
      ((&frame P)
       (NOT (&contribution (:P_out P)))
       (&bg (:C Col)))))
