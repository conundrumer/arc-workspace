;; 6aa20dc0

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &ground_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The ground: the commonest color.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&ground_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&ground.maximal (:t Col))))

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

;; Each object's one color; the object of several colors is the template,
;; and every other object is a square.
(INIT &hue Singleton
  (key ((&obj_component *P ^Id)
        (&ink P *Col))
    (member ((:v Col))
      (&obj_component *P Id)
      (&ink P *Col))))

(RULE &square
  (&obj_component *P *Id)
  (&hue.value (:key Id)))

(INIT &pair_box BoundingBox
  (key ((&square (:Id ^A))
        (&square (:Id ^B)))
    (cell (P)
      (!= A B)
      (OR ((&square *P (:Id A)))
          ((&square P (:Id B)))))))

(RULE &pair_cell
  (&pair_box.box (:key *A *B) (:B *B2))
  (input *P)
  (ALL ((&pair_box.box (:key (:A *Pairm_a) (:B *Pairm_b)) (:B B2))
        (dir_elem (:D *D_m1))
        (relative (:Base B2) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B2) (:X P) (:X_rel *P_inner)))

;; The box divided as the template is: one tile per template cell.
(INIT &tiles_sides ExtentDivisions
  (frame ((:P P_inner))
    (&pair_cell *P_inner)))

;; The template as a picture: its box, ground cells included.
(INIT &tmpl_box BoundingBox
  (cell (P)
    (&obj_component *P *Id)
    (&hue.plural (:key Id))))

(RULE &tiles_axis_split1
  (&pair_cell (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &tiles_parts
  (&tmpl_box.cell *P)
  (&tmpl_box.box *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(RULE &tiles_axis
  (OR ((&pair_cell (:P_inner *P))
       (&tmpl_box.cell (:P *P2))
       (&tmpl_box.box *B)
       (axis_elem *A)
       (relative (:Base B) (:X P2) (:X_rel *R_m1))
       (frame_extent (:P R_m1) A *N)
       (&tiles_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m2))
       (edge_inset D (:K I) (:B *B1_m3))
       (edge_inset (:D O_m2) (:K I2) (:B *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *P_outer))
       (opposite D (:Opp *O_m5))
       (edge_inset D (:K R) (:B *B1_m6))
       (edge_inset (:D O_m5) (:K R2) (:B *B2_m7))
       (compose (:A B1_m6) (:B B2_m7) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&pair_cell (:P_inner P))
       (&tmpl_box.cell (:P *P22))
       (&tmpl_box.box (:B *B2))
       (axis_elem A)
       (relative (:Base B2) (:X P22) (:X_rel *R_m12))
       (frame_extent (:P R_m12) A (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m22))
       (edge_inset (:D D2) (:K I3) (:B *B1_m32))
       (edge_inset (:D O_m22) (:K I22) (:B *B2_m42))
       (compose (:A B1_m32) (:B B2_m42) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m52))
       (edge_inset (:D D2) (:K R3) (:B *B1_m62))
       (edge_inset (:D O_m52) (:K R22) (:B *B2_m72))
       (compose (:A B1_m62) (:B B2_m72) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&pair_cell (:P_inner P))
       (axis_elem A)
       (NOT (&tiles_parts A))
       (&tiles_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tiles_tile
  (&tiles_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tiles_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tmpl
  (&tmpl_box.box *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &sq_box BoundingBox
  (key ((&square *P ^Id))
    (cell (P)
      (&square *P Id))))

(RULE &square_tile
  (&pair_box.cell (:key *A *B) *P)
  (&square P *Id)
  (&pair_cell A B P *P_inner)
  (&tiles_tile (:P P_inner) (:P_outer *P_tile) (:P_inner *P_intile))
  (&sq_box.box (:key Id) (:B *B_sq))
  (axis_elem (:A *A3))
  (relative (:Base B_sq) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) (:A A3) (:N *N1))
  (perp (:A A3) *A2)
  (axis_elem (:A A2))
  (relative (:Base B_sq) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N *N2))
  (perp (:A A3) (:A2 *A2_m3))
  (frame_extent (:P P_intile) (:A A3) (:N N1))
  (frame_extent (:P P_intile) (:A A2_m3) (:N N2)))

(RULE &pair
  (&square_tile *A *B (:Id A))
  (&square_tile A B (:Id B)))

;; The turns that carry the template's marks onto the pair's squares.
(INIT &fit Agreement
  (key ((OR ((&pair ^A ^B)
             (&tmpl *P_inner *Col))
            ((&square_tile A B *Id *P_tile)
             (&hue.value (:key Id) (:v Col)))))
    (source ((:i P_inner) (:v Col))
      (&pair A B)
      (&tmpl *P_inner *Col))
    (target ((:i P_tile) (:v Col))
      (&square_tile A B *Id *P_tile)
      (&hue.value (:key Id) (:v *Col)))
    (correspondence ((:m D) (:i P_inner) (:j Q))
      (&pair A B)
      (&tmpl *P_inner *Col)
      (d4_elem *D)
      (apply D (:P P_inner) (:P_out *Q)))))

(RULE &fit_src
  (&pair *A *B)
  (&tmpl (:P_inner *P) (:Col *V)))

(RULE &stamp
  (&pair_cell (:A *Pair_a) (:B *Pair_b) *P *P_inner)
  (&tiles_tile (:P P_inner) (:P_outer *P_tile))
  (&fit_src (:A Pair_a) (:B Pair_b))
  (d4_elem *D)
  (NOT (&fit.conflict (:key (:A Pair_a) (:B Pair_b)) (:m D)))
  (&tmpl (:P_inner *Q) *Col)
  (apply D (:P Q) (:P_out P_tile)))

(RULE &output
  (OR ((&stamp *P *Col))
      ((input P Col)
       (NOT (&stamp P)))))
