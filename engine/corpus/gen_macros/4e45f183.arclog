;; 4e45f183

(DET &line_width DivisorRatio)

(RULE &field_cell_uniform_inset1
  (&line_width (:K *G_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K G_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K G_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K G_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K G_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(RULE &field_cell
  (input (:P *P_grid))
  (&line_width (:K *G))
  (&field_cell_uniform_inset1 (:G_ G) (:B_ *B))
  (ALL ((&line_width (:K *Gm))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m7))
        (edge_inset (:D D1_m1) (:K Gm) (:B *B1_m8))
        (edge_inset (:D O_m7) (:K Gm) (:B *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m10))
        (edge_inset (:D D2_m4) (:K Gm) (:B *B1_m11))
        (edge_inset (:D O_m10) (:K Gm) (:B *B2_m12))
        (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C B))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_field)))

(DET &tile_count TileCount)

(INIT &tile_division_sides ExtentDivisions
  (frame ((:P P_field))
    (&field_cell *P_field)))

(RULE &tile_division_gap
  (axis_elem *A)
  (&line_width (:K *G)))

(RULE &tile_division_axis_split1
  (&field_cell (:P_field *P_field_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_field_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_field_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_field_) (:X_rel *X_m1_)))

(RULE &tile_division_parts
  (axis_elem *A)
  (&tile_count *N))

(RULE &tile_division_axis
  (OR ((&field_cell (:P_field *P))
       (axis_elem *A)
       (&tile_count *N)
       (&line_width (:K *G))
       (&tile_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&field_cell (:P_field P))
       (axis_elem A)
       (&tile_count (:N *N2))
       (&line_width (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&field_cell (:P_field P))
       (axis_elem A)
       (&tile_count (:N *N3))
       (NOT (&tile_division_gap A))
       (&tile_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&field_cell (:P_field P))
       (axis_elem A)
       (&tile_count (:N *N4))
       (NOT (&tile_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((&field_cell (:P_field P))
       (axis_elem A)
       (NOT (&tile_division_parts A))
       (&tile_division_axis_split1 (:P_field_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile
  (&field_cell *P_grid *P_field)
  (&tile_division_tile (:P P_field) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $d "what the ruling is read by" $Count
  (ALT $Size
    (DET &tile_side TileCount)

    (RULE &tile_division2_gap
      (axis_elem *A)
      (&line_width (:K *G)))

    (RULE &tile_division2_axis_split1
      (&field_cell (:P_field *P_field_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_field_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_field_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_field_) (:X_rel *X_m1_)))

    (RULE &tile_division2_side
      (axis_elem *A)
      (&tile_side (:N *K)))

    (RULE &tile_division2_axis
      (OR ((&field_cell (:P_field *P))
           (axis_elem *A)
           (&tile_side (:N *K))
           (&line_width (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((&field_cell (:P_field P))
           (axis_elem A)
           (&tile_side (:N *K2))
           (NOT (&tile_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((&field_cell (:P_field P))
           (axis_elem A)
           (NOT (&tile_division2_side A))
           (&tile_division2_axis_split1 (:P_field_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &tile_division2_tile
      (&tile_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile
      (&field_cell *P_grid *P_field)
      (&tile_division2_tile (:P P_field) (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $l "where the marks sit" $Reach
  (ALT $Bulk
    (RULE &mark_side
      (&mark *P_tile *P_intile)
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P_intile) D *K)
      (margin (:B P_intile) (:D O_m1) (:K *K2))
      (< K K2))

    (INIT &bulk Excess
      (key ((OR ((&mark_side ^P_tile *P_intile ^D))
                ((&mark_side P_tile P_intile (:D *D2))
                 (opposite D (:Opp D2)))))
        (plus ((:m P_intile))
          (&mark_side P_tile *P_intile D))
        (minus ((:m P_intile))
          (&mark_side P_tile *P_intile (:D *D2))
          (opposite D (:Opp D2)))))

    (RULE &lean
      (&bulk.excess (:key *P_tile *D)))))

(RULE &tile_line_split1
  (&tile (:P_tile *P_tile_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_axis_))
  (relative (:Base P_axis_) (:X P_tile_) (:X_rel *X_m1_)))

(INIT &field_count Cardinality
  (key ((&tile *P_grid)
        (input (:P P_grid) ^Col))
    (member ((:m P_grid))
      (&tile *P_grid)
      (input (:P P_grid) Col))))

;; The field is one color everywhere but the marks.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &mark
  (&tile *P_grid *P_tile *P_intile)
  (input (:P P_grid) *Col)
  (NOT (&field.maximal (:t Col))))

(INIT &mark_box BoundingBox
  (key ((&mark ^P_tile *P_intile))
    (cell ((:P P_intile))
      (&mark P_tile *P_intile))))

(RULE &lean
  (&mark_box.box (:key *P_tile) *B)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin B D *K)
  (margin B (:D O_m1) (:K *K2))
  (< K K2))

(RULE &balanced
  (&mark *P_tile)
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (NOT (&lean P_tile D))
  (NOT (&lean P_tile (:D D2))))

(RULE &tile_line
  (&tile *P_tile)
  (axis_elem *A)
  (&tile_line_split1 (:P_tile_ P_tile) (:A_ A) (:P_axis_ *P_axis) (:X_m1_ *X_m1)))

(RULE &seat_line
  (&tile_line *A *P_axis)
  (OR ((&lean *P_tile *D)
       (axis_of D A)
       (margin (:B P_axis) D (:K 0)))
      ((&balanced P_tile A)
       (axis_of (:D *D1_m1) (:A *A1_m2))
       (opposite (:D D1_m1) (:Opp *O1_m3))
       (perp (:A A1_m2) (:A2 *A2_m4))
       (axis_of (:D *D2_m5) (:A A2_m4))
       (opposite (:D D2_m5) (:Opp *O2_m6))
       (margin (:B P_axis) (:D D1_m1) (:K *K1_m7))
       (margin (:B P_axis) (:D O1_m3) (:K K1_m7))
       (margin (:B P_axis) (:D D2_m5) (:K *K2_m8))
       (margin (:B P_axis) (:D O2_m6) (:K K2_m8)))))

(RULE &seat
  (&seat_line *P_tile *A (:P_axis *P1))
  (perp A *A2)
  (&seat_line P_tile (:A A2) (:P_axis *P2))
  (compose (:A P1) (:B P2) (:C *P_seat)))

(RULE &output
  (OR ((&tile (:P_grid *P_grid_in) *P_tile *P_intile)
       (input (:P P_grid_in) *Col)
       (&seat P_tile *P_seat)
       (&tile (:P_grid *P) (:P_tile P_seat) P_intile))
      ((input P Col)
       (NOT (&tile (:P_grid P))))))
