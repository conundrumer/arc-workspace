;; bbb1b8b6

(DET &base_dir DirDomain)

(DET &gap DivisorRatio)

(DET &tile_count SepTileCount)

(INIT &tile_val_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_val_division_gap
  (&base_dir *D)
  (axis_of D *A)
  (&gap (:K *G)))

(RULE &tile_val_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_val_division_parts
  (&base_dir *D)
  (axis_of D *A)
  (&tile_count *N))

(RULE &tile_val_division_axis
  (OR ((input *P)
       (&base_dir *D)
       (axis_of D *A)
       (&tile_count *N)
       (&base_dir (:D *D2))
       (axis_of (:D D2) A)
       (&gap (:K *G))
       (&tile_val_division_sides.division A N *K G)
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O))
       (margin (:B P) (:D D3) (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite (:D D3) (:Opp *O_m1))
       (edge_inset (:D D3) (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite (:D D3) (:Opp *O_m4))
       (edge_inset (:D D3) (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&base_dir (:D *D4))
       (axis_of (:D D4) A)
       (&tile_count (:N *N2))
       (&base_dir (:D *D22))
       (axis_of (:D D22) A)
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D32) A)
       (opposite (:D D32) (:Opp *O2))
       (margin (:B P) (:D D32) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D32) (:Opp *O_m12))
       (edge_inset (:D D32) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D32) (:Opp *O_m42))
       (edge_inset (:D D32) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&base_dir (:D *D5))
       (axis_of (:D D5) A)
       (&tile_count (:N *N3))
       (NOT (&tile_val_division_gap A))
       (&tile_val_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D23) A)
       (opposite (:D D23) (:Opp *O3))
       (margin (:B P) (:D D23) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D23) (:Opp *O_m13))
       (edge_inset (:D D23) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D23) (:Opp *O_m43))
       (edge_inset (:D D23) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&base_dir (:D *D6))
       (axis_of (:D D6) A)
       (&tile_count (:N *N4))
       (NOT (&tile_val_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D24) A)
       (opposite (:D D24) (:Opp *O4))
       (margin (:B P) (:D D24) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D24) (:Opp *O_m14))
       (edge_inset (:D D24) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D24) (:Opp *O_m44))
       (edge_inset (:D D24) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_val_division_parts A))
       (&tile_val_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_val_division_tile
  (&tile_val_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_val_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(RULE &tile_val
  (input (:P *P_grid) *Col)
  (&tile_val_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $cr "the fit criterion; data-equivalent here — every train piece is an exact complement or collides" $Exact
  (ALT $Fit
    (RULE &unfit
      (&piece *P)
      (NOT (&hole P)))))

(ALTS $d "how the separator cuts the grid into the base and piece tiles" $Count
  (ALT $Size
    (DET &tile_size ConstOutDim)

    (RULE &tile_val_division2_gap
      (&base_dir *D)
      (axis_of D *A)
      (&gap (:K *G)))

    (RULE &tile_val_division2_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &tile_val_division2_side
      (&base_dir *D)
      (axis_of D *A)
      (&tile_size (:N *K)))

    (RULE &tile_val_division2_axis
      (OR ((input *P)
           (&base_dir *D)
           (axis_of D *A)
           (&tile_size (:N *K))
           (&base_dir (:D *D2))
           (axis_of (:D D2) A)
           (&gap (:K *G))
           (axis_of (:D *D3) A)
           (opposite (:D D3) (:Opp *O))
           (margin (:B P) (:D D3) (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite (:D D3) (:Opp *O_m1))
           (edge_inset (:D D3) (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite (:D D3) (:Opp *O_m4))
           (edge_inset (:D D3) (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&base_dir (:D *D4))
           (axis_of (:D D4) A)
           (&tile_size (:N *K2))
           (NOT (&tile_val_division2_gap A))
           (axis_of (:D *D22) A)
           (opposite (:D D22) (:Opp *O2))
           (margin (:B P) (:D D22) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D22) (:Opp *O_m12))
           (edge_inset (:D D22) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D22) (:Opp *O_m42))
           (edge_inset (:D D22) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&tile_val_division2_side A))
           (&tile_val_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &tile_val_division2_tile
      (&tile_val_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_val_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile_val
      (input (:P *P_grid) *Col)
      (&tile_val_division2_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))

(RULE &base
  (&tile_val (:P_tile *T) (:P_intile *P) *Col)
  (&base_dir *D)
  (margin (:B T) D (:K 0)))

(RULE &piece
  (&tile_val (:P_tile *T) (:P_intile *P) *Col)
  (NOT (&bg (:C Col)))
  (&base_dir *D)
  (opposite D (:Opp *O))
  (margin (:B T) (:D O) (:K 0)))

(RULE &hole
  (&base *P *Col)
  (&bg (:C Col)))

(RULE &unfit
  (OR ((&piece *P)
       (NOT (&hole P)))
      ((&hole (:P *P2))
       (NOT (&piece (:P P2))))))

(RULE &output
  (OR ((NOT (&unfit))
       (OR ((&piece *P *Col))
           ((&base P Col)
            (NOT (&piece P)))))
      ((&unfit)
       (&base P Col))))
