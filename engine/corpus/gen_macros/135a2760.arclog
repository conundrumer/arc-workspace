;; 135a2760

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &panels_divider
  (&line_color.value (:key *A *L)))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A uniform line spans the grid, so it divides panels rather than sit in one.
(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &frame Boundary
  (key ((&panels_tile_of *P (:P_tile ^T)))
    (cell (P)
      (&panels_tile_of *P (:P_tile T)))))

(RULE &inner_cell
  (&panels_tile_of *P (:P_tile *T))
  (NOT (&frame.boundary (:key T) P)))

(INIT &si Periods
  (key ((&inner_cell ^T *P)
        (input P *Col))
    (cell (P (:v Col))
      (&inner_cell T *P)
      (input P *Col))))

;; The interior's period per axis: the shortest. On an axis with no true
;; period the shortest is pair-less, so it generates nothing.
(INIT &period Order
  (key ((&si.approximate_period (:key ^T) ^A *K))
    (member ((:t K))
      (&si.approximate_period (:key T) A *K))
    (score ((:t K) (:S K))
      (&si.approximate_period (:key T) A *K))))

;; Orbits of the lattice: the cells of one interior whose distance on each
;; axis is a whole number of periods.
(INIT &orbit Quotient
  (equivalent ((:a P) (:b Q))
    (&inner_cell *T *P)
    (&inner_cell T (:P *Q))
    (relative (:Base P) (:X Q) (:X_rel *V))
    (corner_dir (:C *Diag_m1) *A (:D *D1))
    (perp A (:A2 *A2_m2))
    (corner_dir (:C Diag_m1) (:A A2_m2) (:D *D2))
    (perp A *A2)
    (margin (:B V) (:D D1) (:K *K1))
    (margin (:B V) (:D D2) (:K *K2))
    (&period.minimal (:key T A) (:t *N1))
    (&period.minimal (:key T (:A A2)) (:t *N2))
    (divide (:T K1) (:Side N1) (:Gap 0) (:Remainder 0))
    (divide (:T K2) (:Side N2) (:Gap 0) (:Remainder 0))))

(INIT &pattern_count Cardinality
  (key ((&orbit.class (:a *P) (:Id ^Cls))
        (input P ^Col))
    (member ((:m P))
      (&orbit.class (:a *P) (:Id Cls))
      (input P Col))))

(INIT &pattern Order
  (key ((&pattern_count.size (:key ^Cls *Col)))
    (member ((:t Col))
      (&pattern_count.size (:key Cls *Col)))
    (score ((:t Col) (:S N))
      (&pattern_count.size (:key Cls *Col) *N))))

(RULE &output
  (OR ((&orbit.class (:a *P) (:Id *Cls))
       (&pattern.maximal (:key Cls) (:t *Col)))
      ((input P Col)
       (NOT (&inner_cell P)))))
