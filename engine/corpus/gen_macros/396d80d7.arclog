;; 396d80d7

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &beside
  (input *P (:Col *C_bg))
  (&bg (:C C_bg))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&ink (:P Q) *Col))

(RULE &side
  (dir_elem *D)
  (&beside *P D))

(RULE &corner_only
  (&beside *P)
  (NOT (&side P)))

(RULE &shell
  (&corner_only *P)
  (&beside P *Col))

(RULE &core
  (&ink *Col)
  (NOT (&shell Col)))

(RULE &output
  (input *P (:Col *C_in))
  (IF ((&corner_only P))
      ((&core *Col))
      ((= Col C_in))))
