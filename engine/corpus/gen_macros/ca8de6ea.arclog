;; ca8de6ea

(DET &dp_cell
  (OR ((ex_input *P))
      ((ex_output P))))

(DET &dp_nearer
  (&dp_cell *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(DET &cand
  (ex_input *E (:P *P_in) *Col)
  (ex_output E (:P *P_out) Col))

(DET &crossing
  (&cand *P_in *P_out)
  (&dp_nearer (:P P_in) *D)
  (opposite D (:Opp *O))
  (&dp_nearer (:P P_out) (:D O)))

(DET &pair
  (&cand *P_in *P_out)
  (NOT (&crossing P_in P_out)))

(INIT &ident Quotient
  (equivalent ((:a P_in) (:b P_in))
    (&pair *P_in)))

(DET &in_label
  (&pair (:P_in *P))
  (&ident.class (:a P) *Id))

(DET &out_label
  (&pair *P_in (:P_out *P))
  (&ident.class (:a P_in) *Id))

(RULE &map
  (&in_label (:P *P_in) *Id)
  (&out_label (:P *P_out) Id))

(RULE &perm
  (&map *P_in *P_out))

(ALTS $choice "how the collapse is derived" $LabeledGrids
  (ALT $Cycle
    (DET &dp_quadrant
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&dp_nearer *P (:D D1))
      (&dp_nearer P (:D D2)))

    (DET &dp_diag_cell
      (&dp_quadrant *P *Diag)
      (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m4))
      (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
      (margin (:B P) (:D D1_m2) (:K *Ring))
      (margin (:B P) (:D D2_m3) (:K Ring)))

    (DET &out_center_centered1
      (&pair (:P_in *P_in_) *P_out)
      (opposite (:D *D_m1) (:Opp *O_m2))
      (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
      (!= K1_m3 K2_m4))

    (DET &ring_cell
      (ex_output *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0)))

    (DET &border_step
      (&ring_cell *P)
      (turn *S *D (:D2 *D_step))
      (margin (:B P) D (:K 0))
      (step_offset (:D D_step) (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *P_next)))

    (DET &ring_corner
      (&ring_cell *P)
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
      (margin (:B P) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (DET &sense
      (&pair *P_in *P_out)
      (&dp_diag_cell (:P P_in) *Diag)
      (&ring_corner Diag (:P *P_corner))
      (&border_step (:P P_corner) *S (:P_next P_out)))

    (DET &ring_succ
      (&sense *S)
      (&border_step *P S *P_next)
      (&ring_cell (:P P_next)))

    (RULE &cell
      (OR ((input *P))
          ((&ring_succ P))))

    (RULE &dp_nearer2
      (&cell *P)
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (RULE &dp_quadrant2
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&dp_nearer2 *P (:D D1))
      (&dp_nearer2 P (:D D2)))

    (RULE &dp_diag_cell2
      (&dp_quadrant2 *P *Diag)
      (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m4))
      (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
      (margin (:B P) (:D D1_m2) (:K *Ring))
      (margin (:B P) (:D D2_m3) (:K Ring)))

    (INIT &ring_size Cardinality
      (member ((:m P))
        (&ring_cell *P)))

    (INIT &ring2 Walk
      (successor ((:p P) (:p_next P_next))
        (&ring_succ *P *P_next))
      (steps (N)
        (&ring_size.size *N)))

    ;; Steps around the ring from the arm's own corner to the arm's paired cell.
    (INIT &advance Order
      (key ((&pair *P_in *P_out)
            (&dp_diag_cell (:P P_in) *Diag ^Ring)
            (&ring_corner Diag (:P *P_corner))
            (&ring2.walk (:p0 P_corner) *N (:p P_out)))
        (member ((:t N))
          (&pair *P_in *P_out)
          (&dp_diag_cell (:P P_in) *Diag Ring)
          (&ring_corner Diag (:P *P_corner))
          (&ring2.walk (:p0 P_corner) *N (:p P_out)))
        (score ((:t N) (:S N))
          (&pair *P_in *P_out)
          (&dp_diag_cell (:P P_in) *Diag Ring)
          (&ring_corner Diag (:P *P_corner))
          (&ring2.walk (:p0 P_corner) *N (:p P_out)))))

    (DET &ring_shift
      (&advance.minimal (:key *Ring) (:t *Shift)))

    (INIT &ring Walk
      (successor ((:p P) (:p_next P_next))
        (&ring_succ *P *P_next))
      (steps (N)
        (&ring_shift (:Shift *N))))

    (DET &out_center
      (&pair *P_in (:P_out *P))
      (NOT (&out_center_centered1 (:P_in_ P_in))))

    (RULE &perm
      (OR ((input (:P *P_in))
           (&dp_diag_cell2 (:P P_in) *Diag *Ring)
           (&ring_shift Ring *Shift)
           (&ring_succ (:P *P_corner))
           (&dp_diag_cell2 (:P P_corner) Diag (:Ring 0))
           (&ring.walk (:p0 P_corner) (:N Shift) (:p *P_out)))
          ((input (:P P_in))
           (ALL ((opposite (:D *D_m1) (:Opp *O_m2))
                 (margin (:B P_in) (:D D_m1) (:K *K1_m3))
                 (margin (:B P_in) (:D O_m2) (:K *K2_m4)))
                ((= K1_m3 K2_m4)))
           (&out_center (:P P_out)))))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&perm (:P_in P_grid_in) (:P_out *P)))
