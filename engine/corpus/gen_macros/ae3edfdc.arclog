;; ae3edfdc

(INPUT single-cells "on a &background field, every non-background cell stands alone, with no other non-background cell next to it"

  (DET_OR_RULE &background DominantColor))

(INPUT one-center-per-color "each center color of &pair has exactly one cell"

  (DET &pair
    (ex_input *E *P (:Col *C_center))
    (NOT (&background (:C C_center)))
    (ex_output E P (:Col C_center))
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (ex_output E (:P Q) (:Col *C_satellite))
    (NOT (&background (:C C_satellite)))))

(INPUT satellites-in-line "each cell of a satellite color of &pair lies in the row or the column of the center its color is paired with")

(INPUT one-per-side "each center has at most one satellite on each of its four sides")

(OUTPUT pull-in "each satellite moves along its line to the cell next to its center on the satellite's side. Undefined where two cells of different colors land on one cell."

  (RULE &line_dir
    (dir_elem *D))

  (RULE &line_dir_ray
    (&line_dir *D))

  (RULE &line_node
    (&line_dir)
    (input *P))

  (RULE &line_source
    (input *P *Col)
    (NOT (&background (:C Col))))

  ;; The lines through each non-background cell, in the case's directions.
  (INIT &line Distance
    (key ((&line_source (:P ^O))
          (&line_dir_ray ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&line_source (:P O))
             (&line_dir_ray D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&line_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&line_node (:P Q)))
            ((&line_source (:P O))
             (&line_dir_ray D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&line_node (:P Q))
             (= A2 O))
            ((&line_source (:P O))
             (&line_dir_ray D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&line_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&line_node (:P Q)))))
      (source ((:n O))
        (&line_source (:P O))
        (&line_dir_ray D))))

  (RULE &line_ray2
    (&line.distance (:key *D (:O *Origin)) (:n *P) *K))

  (RULE &line_cell
    (input *P))

  (RULE_OR_DET &partner "Col2 is a satellite color of center color Col."
    (&pair (:C_center *Col) (:C_satellite *Col2)))

  (RULE &center_color
    (&partner *Col))

  (RULE &center
    (&center_color *Col)
    (input *P Col))

  (RULE &in_line
    (&center *P *Col)
    (&partner Col *Col2)
    (input (:P *Q) (:Col Col2))
    (&line_ray2 (:P Q) *D *K (:Origin P))
    (&line_cell (:P Q)))

  (RULE &pull
    (&in_line *P *Q *D *K))

  ;; The obstacle nearest Q, which Q comes to rest against.
  (INIT &stop Order
    (key ((&pull ^P ^Q *D)
          (&line_ray2 P D *K (:Origin P))
          (&line_cell P))
      (member ((:t (:V P) (:S K)))
        (&pull P Q *D)
        (&line_ray2 P D *K (:Origin P))
        (&line_cell P))
      (score ((:t (:V P) (:S K)) (:S K))
        (&pull P Q *D)
        (&line_ray2 P D *K (:Origin P))
        (&line_cell P))))

  (RULE &rest_on
    (&stop.maximal (:key *P *Q) (:t (:V *F)))
    (&pull P Q *D))

  ;; The satellites that rest against F, in order from F: F ranks 0, and the
  ;; satellite of rank N lands N cells beyond the pile's base.
  (INIT &pile Order
    (key ((&rest_on ^P ^D ^F))
      (member ((:t T))
        (OR ((&rest_on P D F (:Q *T)))
            ((&rest_on P D F)
             (= T F))))
      (before ((:a A) (:b Q))
        (OR ((&rest_on P D F (:Q *A))
             (&pull P (:Q A) D (:K *K1))
             (&rest_on P D F *Q)
             (&pull P Q D (:K *K2))
             (< K1 K2))
            ((&rest_on P D F Q)
             (= A F)))))))

(OUTPUT centers-stay "each center stays where it is")

(OUTPUT rest-background "every other cell of the output is &background")

(ALTS $s "which non-center cells a center pulls" $PartnerColor
  (ALT $PartnerColor
    (ALTS $source "where the pairing of center colors with satellite colors comes from" $StoredPair
      (ALT $PairFromAlignment
        (INPUT one-center-per-color "a center color is a color with exactly one cell that some other color is paired with"
          (RULE &line_ray
            (&line_ray2 *P *D *K (:Origin *Src))
            (&line_cell P))
          (RULE &lone
            (input *P *Col)
            (NOT (&background (:C Col)))
            (ALL ((input (:P *Pm) Col)
                  (input (:P *Q) Col))
                 ((= Pm Q)))
            (input (:Col *Col2))
            (NOT (&background (:C Col2)))
            (!= Col Col2))
          (RULE_OR_DET &off_line "A cell of Col2 lies on no line through the one cell of Col."
            (&lone *P *Col *Col2)
            (input (:P *Q) (:Col Col2))
            (NOT (&line_ray (:P Q) (:Src P))))
          (RULE &partner
            (&lone *Col *Col2)
            (NOT (&off_line Col Col2))))
        (INPUT satellites-in-line "a color is paired with that center color when it is not &background and each of its cells lies in a line through the center, in the directions the case reads"))))
  (ALT $AnyColorSatellite
    (INPUT satellites-in-line "a center is a cell of a color in &centers. Each cell that is not &background, whose color is not in &centers, and that lies in a line with a center is its satellite.")
    (OUTPUT pull-in "each satellite moves to the cell next to each center it lies in line with, on its side"
      (DET_OR_RULE &centers RarestColor)

      (RULE &center_color
        (&centers (:C *Col)))

      (RULE &partner
        (&centers (:C *Col))
        (input (:Col *Col2))
        (NOT (&background (:C Col2)))
        (NOT (&centers (:C Col2)))))))

(ALTS $l "the directions in which a satellite lies in line with its center" $FourDirections
  (ALT $EightDirections
    (INPUT satellites-in-line "each satellite lies in the row, the column or a diagonal of its center")
    (OUTPUT pull-in "a satellite on a diagonal of its center moves to the diagonal neighbor of the center on its side"
      (RULE &line_dir
        (dir8_elem *D)))))

(ALTS $c "which centers pull a satellite that lies in line with several centers it is paired with" $EveryCenter
  (ALT $NearestCenter
    (OUTPUT pull-in "only the nearest of those centers pulls it, ties keeping all"
      ;; The centers nearest each satellite.
      (INIT &nearest Order
        (key ((&in_line *P ^Q *K))
          (member ((:t (:V P) (:S K)))
            (&in_line *P Q *K))
          (score ((:t (:V P) (:S K)) (:S K))
            (&in_line *P Q *K))))

      (RULE &pull
        (&nearest.minimal (:key *Q) (:t (:V *P) (:S *K)))
        (&in_line P Q *D K)))))

(ALTS $ld "where several satellites on one side of a center land" $SameCell
  (ALT $Stack
    (OUTPUT pull-in "the k-th nearest satellite on a side of a center lands k cells from the center")
    (RULE &lands_at
      (&rest_on *P *D *F *Q)
      (&pile.rank (:key P D F) (:t Q) (:R *N))
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
      (edge_inset D (:K N) (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A F) (:B V_m1) (:C *X)))
    (ALT $StoredGap
      (RULE &lands_at
        (&rest_on *P *D *F *Q)
        (&pile.rank (:key P D F) (:t Q) (:R *N))
        (&gap (:N *K))
        (dir8_opposite D (:D2 *O_m2))
        (edge_inset (:D O_m2) K (:B *B1_m3))
        (edge_inset D K (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
        (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
        (compose (:A F) (:B V_m1) (:C *F_base))
        (dir8_opposite D (:D2 *O_m7))
        (edge_inset (:D O_m7) (:K N) (:B *B1_m8))
        (edge_inset D (:K N) (:B *I_m10))
        (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *V_m6))
        (compose (:A F_base) (:B V_m6) (:C *X))))))

(ALTS $g "how far from the cell it rests against a satellite stops" $NoGap
  (ALT $StoredGap
    (OUTPUT pull-in "each satellite stops with &gap empty cells between it and the cell it rests against"
      (DET &gap NumberDomain))
    ;; The satellites that rest against F from side D land beyond F_base,
    ;; &gap cells past F.
    (RULE &lands_at
      (&rest_on *D *F *Q)
      (&gap (:N *K))
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) K (:B *B1_m3))
      (edge_inset D K (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A F) (:B V_m1) (:C *F_base))
      (step_offset D (:V *V_m6))
      (compose (:A F_base) (:B V_m6) (:C *X)))))

(ALTS $b "whether cells between a satellite and its center stop it" $PassOver
  (ALT $SlideBlocked
    (OUTPUT pull-in "each satellite slides toward its center and stops next to the first non-background input cell in its path. With $Stack, a satellite of the same center and side stops it at its resting place."
      (RULE &in_path
        (&pull *P *Q *D (:K *K_q))
        (&line_ray2 (:P *R) D *K (:Origin P))
        (&line_cell (:P R))
        (< K K_q)
        (input (:P R) *Col)
        (NOT (&background (:C Col))))

      (RULE &obstacle
        (&in_path *P *Q *R *K))

      ;; The obstacle nearest Q, which Q comes to rest against.
      (INIT &stop Order
        (key ((&obstacle ^P ^Q *R *K))
          (member ((:t (:V R) (:S K)))
            (&obstacle P Q *R *K))
          (score ((:t (:V R) (:S K)) (:S K))
            (&obstacle P Q *R *K)))))))

(ALTS $u "what becomes of a non-center cell that no center pulls" $ClearUnmatched
  (ALT $KeepUnmatched
    (OUTPUT rest-background "a non-center cell that no center pulls stays in place. Undefined where a pulled cell lands on a kept cell of another color.")
    (RULE &paint
      (OR ((input *P *Col)
           (NOT (&background (:C Col)))
           (NOT (&pull (:Q P))))
          ((&center P Col))
          ((&lands_at *Q (:X P))
           (input (:P Q) Col))))))

(RULE &line_end
  (&line_ray2 *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&line_ray2 (:P Q) D Origin)))

(RULE &satellite_color_choice)

(RULE &lands_at
  (&rest_on *D *F *Q)
  (step_offset D (:V *V_m1))
  (compose (:A F) (:B V_m1) (:C *X)))

(RULE &paint
  (OR ((&center *P *Col))
      ((&lands_at *Q (:X P))
       (input (:P Q) Col))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&background (:C Col)))))

(RULE_OR_DET &repeated "A color with more than one cell.")
