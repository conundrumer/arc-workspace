;; aa4ec2a5

(INPUT field "the background is &bg, and it covers the grid border"

  (DET_OR_RULE &bg DominantColor))

(INPUT shapes "several shapes of &shape_color sit on the field; each shape is a 4-connected component of &shape_color, and no two shapes touch, not even at a corner"

  (DET_OR_RULE &shape_color RarestColor)

  (RULE &shape_cell
    (input *P *Col)
    (&shape_color (:C Col)))

  (RULE &shapes8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &shapes8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&shape_cell *P)
           (&shapes8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&shape_cell (:P P3)))
          ((&shape_cell P)
           (= P3 P))))))

(INPUT holes "some shapes each enclose one region of &bg cells that is cut off from the grid border")

(OUTPUT hole-fill "a &bg cell with no 4-connected path of &bg cells to the grid border is a hole cell, and becomes &hole_color"

  (RULE &shapes4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &shapes4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&shape_cell *P)
           (&shapes4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&shape_cell (:P P3)))
          ((&shape_cell P)
           (= P3 P)))))

  (RULE &shapes4_component
    (&shapes4.class (:a *P) *Id))

  (RULE &open8_steps
    (step_offset (:V *Delta)))

  (RULE &own_holes4_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &own_holes4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &shape
    (&shapes4_component *P (:Id *O)))

  (RULE &wall
    (&shape (:O *W)))

  (RULE &off_wall
    (&wall *W)
    (input *P)
    (NOT (&shape P (:O W))))

  (RULE &own_holes4_cell
    (&off_wall (:W *Key) *P))

  (INIT &own_holes4_flood Propagation
    (key ((OR ((&own_holes4_cell (:Key ^O) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0))
               (&off_wall (:W O) P))
              ((&off_wall (:W O) P)
               (&own_holes4_flood_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&off_wall (:W O) (:P P2)))))
      (source ((:n P))
        (&own_holes4_cell (:Key O) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&off_wall (:W O) P))
      (edge ((:a P) (:b P2))
        (&off_wall (:W O) *P)
        (&own_holes4_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&off_wall (:W O) (:P P2)))))

  (RULE &own_holes4_node
    (&own_holes4_cell *Key *P)
    (NOT (&own_holes4_flood.reached (:key (:O Key)) (:n P))))

  (INIT &own_holes4 Quotient
    (edge ((:a (:O Ky) P) (:b (:O Ky) (:P P2)))
      (OR ((&own_holes4_node (:Key *Ky) *P)
           (&own_holes4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&own_holes4_node (:Key Ky) (:P P2)))
          ((&own_holes4_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &own_holes4_component
    (&own_holes4.class (:a (:O *Key) *P) *Id))

  (DET &hole_color AnyOutNewColor)

  (RULE &bg_cell
    (input *P *Col)
    (&bg (:C Col)))

  (RULE &own_hole
    (&own_holes4_component (:Key *W) *P))

  (INIT &open8 Propagation
    (source ((:n P))
      (&bg_cell *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0)))
    (edge ((:a P) (:b P2))
      (&bg_cell *P)
      (&open8_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (&bg_cell (:P P2))))

  (INIT &own_hole_cells Cardinality
    (key ((&own_hole ^W *P))
      (member ((:m P))
        (&own_hole W *P)))))

(OUTPUT holed-shape "every cell of a shape that alone encloses a hole cell becomes &holed_color; a shape alone encloses a cell when the cell has no 4-connected path to the grid border that avoids that shape's cells"

  (RULE &own_open8_steps
    (step_offset (:V *Delta)))

  (DET &holed_color AnyOutNewColor)

  (INIT &own_open8 Propagation
    (key ((OR ((&off_wall (:W ^O) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0)))
              ((&off_wall (:W O) P)
               (&own_open8_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&off_wall (:W O) (:P P2)))))
      (source ((:n P))
        (&off_wall (:W O) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a P) (:b P2))
        (&off_wall (:W O) *P)
        (&own_open8_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&off_wall (:W O) (:P P2))))))

(OUTPUT plain-shape "a shape that alone encloses no hole cell keeps &shape_color")

(OUTPUT outline "a &bg cell that is not a hole cell and has a shape cell among its 8 neighbors becomes &outline_color"

  (DET &outline_color AnyOutNewColor))

(OUTPUT rest "every other cell keeps its input color"

  (RULE &holes4_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &holes4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &holes4_cell
    (input *P *Col)
    (&bg (:C Col)))

  (RULE &holes4_flood_node
    (input *P *Col)
    (&bg (:C Col)))

  (INIT &holes4_flood Propagation
    (source ((:n P))
      (&holes4_cell *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&holes4_flood_node P))
    (edge ((:a P) (:b Q))
      (&holes4_flood_node *P)
      (&holes4_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&holes4_flood_node (:P Q))))

  (RULE &holes4_node
    (&holes4_cell *P)
    (NOT (&holes4_flood.reached (:n P))))

  (INIT &holes4 Quotient
    (edge ((:a P) (:b P2))
      (OR ((&holes4_node *P)
           (&holes4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&holes4_node (:P P2)))
          ((&holes4_node P)
           (= P2 P)))))

  (RULE &holes4_component
    (&holes4.class (:a *P) *Id))

  (INIT &hole_cells Cardinality
    (key ((&holes4_component *P ^Id))
      (member ((:m P))
        (&holes4_component *P Id))))

  (RULE &hole_size
    (&holes4_component *P *Id)
    (&hole_cells.size (:key Id) *N))

  (RULE &shape_near
    (&bg_cell *P)
    (step_offset (:D *D_m1) (:V *V_m2))
    (compose (:A P) (:B V_m2) (:C *Q))
    (&shape_cell (:P Q)))

  (RULE &enclosed
    (&holes4_component *P))

  (RULE &sole_holed
    (&own_hole *W *P)
    (&enclosed P))

  (RULE &holed
    (&sole_holed (:W *O)))

  (RULE &holed_cell
    (&holed *O)
    (&shape *P O))

  (RULE &rim
    (&shape_near *P)
    (NOT (&enclosed P))))

(ALTS $owner "which cells are hole cells, which shapes turn &holed_color, and which cells take the outline" $SoleEncloser
  (ALT $BboxHole
    (OUTPUT hole-fill "a cell that a shape alone encloses is a hole cell, whatever its color, and becomes &hole_color unless it is a cell of a holed shape"
      (RULE &in_own_hole
        (&own_hole *P))

      (RULE &holed
        (&own_hole (:W *O))))
    (OUTPUT holed-shape "every cell of a shape that alone encloses some cell becomes &holed_color")
    (RULE &hole_cell
      (&own_hole *P)
      (NOT (&holed_cell P)))

    (RULE &outline_cell
      (&shape_near *P)
      (NOT (&in_own_hole P)))
    (ALT $SizeLookup
      (OUTPUT hole-fill "a hole cell becomes the color &hole_size_color gives the cell count of its hole, and is undefined when no color is stored for that count; a hole is a region of hole cells, connected as the path to the grid border is, and under BboxHole it is every cell that one shape alone encloses"
        (RULE &hole_count
          (&own_hole (:W *O) *P)
          (&own_hole_cells.size (:key (:W O)) *N)))))
  (ALT $AdjacentHoled
    (OUTPUT holed-shape "every cell of a shape with a hole cell among the 8 neighbors of one of its cells becomes &holed_color"
      (RULE &holed
        (&enclosed *P)
        (step_offset (:D *D_m1) (:V *V_m2))
        (compose (:A P) (:B V_m2) (:C *Q))
        (&shape (:P Q) *O))))
  (ALT $PerShapeOutline
    (OUTPUT outline "a &bg cell becomes &outline_color when it has a cell of some shape among its 8 neighbors and that shape does not alone enclose it; the outline takes priority over &hole_color"
      (RULE &own_rim
        (&bg_cell *P)
        (step_offset (:D *D_m1) (:V *V_m2))
        (compose (:A P) (:B V_m2) (:C *Q))
        (&shape (:P Q) *O)
        (NOT (&own_hole (:W O) P))))
    (RULE &outline_cell
      (&own_rim *P))

    (RULE &hole_cell
      (&enclosed *P)
      (NOT (&own_rim P)))))

(ALTS $leak "the path that keeps a cell from being enclosed" $Hole4conn
  (ALT $Hole8conn
    (OUTPUT hole-fill "a &bg cell with no 8-connected path of &bg cells to the grid border is a hole cell, and becomes &hole_color"
      (RULE &holes8_steps
        (OR ((dir_elem *D)
             (step_offset D (:V *Delta)))
            ((diag_dir_elem (:D *D2))
             (step_offset (:D D2) (:V Delta)))))

      (RULE &enclosed
        (&bg_cell *P)
        (NOT (&open8.reached (:n P))))

      (INIT &holes8 Quotient
        (edge ((:a P) (:b P3))
          (OR ((&enclosed *P)
               (&holes8_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P3))
               (&enclosed (:P P3)))
              ((&enclosed P)
               (= P3 P)))))

      (RULE &holes8_component
        (&holes8.class (:a *P) *Id))

      (RULE &own_hole
        (&off_wall *W *P)
        (NOT (&own_open8.reached (:key (:O W)) (:n P))))

      (INIT &hole8_cells Cardinality
        (key ((&holes8_component *P ^Id))
          (member ((:m P))
            (&holes8_component *P Id))))

      (RULE &hole_size2
        (&holes8_component *P *Id)
        (&hole8_cells.size (:key Id) *N)))
    (OUTPUT holed-shape "every cell of a shape that alone encloses a hole cell becomes &holed_color; a shape alone encloses a cell when the cell has no 8-connected path to the grid border that avoids that shape's cells")
    (ALT $SizeLookup
      (OUTPUT hole-fill "a hole cell becomes the color &hole_size_color gives the cell count of its hole, and is undefined when no color is stored for that count; a hole is a region of hole cells, connected as the path to the grid border is, and under BboxHole it is every cell that one shape alone encloses"
        (RULE &hole_size2
          (&holes8_component *P *Id)
          (&hole8_cells.size (:key Id) *N))))))

(ALTS $shape "how shape cells join into one shape" $Shape4conn
  (ALT $Shape8conn
    (INPUT shapes "several shapes of &shape_color sit on the field; each shape is an 8-connected component of &shape_color"
      (RULE &shapes8_component
        (&shapes8.class (:a *P) *Id))

      (RULE &shape
        (&shapes8_component *P (:Id *O))))))

(ALTS $fill "where a hole cell's color comes from" $OneHoleColor
  (ALT $SizeLookup
    (OUTPUT hole-fill "a hole cell becomes the color &hole_size_color gives the cell count of its hole, and is undefined when no color is stored for that count; a hole is a region of hole cells, connected as the path to the grid border is, and under BboxHole it is every cell that one shape alone encloses"
      (RULE &hole_size2
        (&hole_size *P *N))

      (RULE &hole_count
        (&hole_size2 *P *N)))
    (RULE &output
      (OR ((&holed_cell *P)
           (&holed_color (:C *Col)))
          ((&outline_cell P)
           (&outline_color (:C Col)))
          ((input P Col)
           (NOT (&holed_cell P))
           (NOT (&hole_cell P))
           (NOT (&outline_cell P)))
          ((&hole_cell P)
           (&hole_count P *N)
           (&hole_size_color N (:C Col)))))))

(RULE &outline_cell
  (&rim *P))

(RULE &hole_cell
  (&enclosed *P))

(RULE &output
  (OR ((&holed_cell *P)
       (&holed_color (:C *Col)))
      ((&outline_cell P)
       (&outline_color (:C Col)))
      ((input P Col)
       (NOT (&holed_cell P))
       (NOT (&hole_cell P))
       (NOT (&outline_cell P)))
      ((&hole_cell P)
       (&hole_color (:C Col)))))

(DET &hole_size_color
  (&hole_size *E *P *N)
  (ex_output E P (:Col *C)))
