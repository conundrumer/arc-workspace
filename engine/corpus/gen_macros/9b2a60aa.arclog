;; 9b2a60aa

(INPUT shape "the ink holds one shape of one color, connected with its diagonals, and every other ink cell is a marker: a cell no ink touches")

(INPUT line "the markers lie on one row or one column")

(INPUT own "exactly one marker has the shape's color")

(OUTPUT slots "walked from the shape's marker, the marker line unrolls into a line of slots: a marker takes the shape's extent along the line, a gap cell takes one cell, and the shape's marker's slot is the shape's own box")

(OUTPUT copies "each marker's slot holds a copy of the shape in the marker's color, at the shape's place across the line")

(OUTPUT keep "every other cell keeps its input color"

  (DET &bg DominantColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&bg (:C Col))))

  (RULE &shape
    (&ink *P)
    (dir8_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&ink (:P Q)))

  (RULE &marker
    (&ink *P)
    (NOT (&shape P)))

  (INIT &shape_box BoundingBox
    (cell (P)
      (&shape *P)))

  (RULE &own_marker
    (&marker *P)
    (input P *Col)
    (&shape (:P *Q))
    (input (:P Q) Col))

  (RULE &inner_step
    (&shape_box.box *B)
    (input (:P *C))
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X C) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X C) (:X_rel *C_rel))
    (step_offset *D (:V *V_m1))
    (compose (:A C) (:B V_m1) (:C *C2))
    (ALL ((input (:P *Cm))
          (opposite (:D *Dm) (:Opp *Om))
          (step_offset (:D Dm) (:V *V_m1m))
          (compose (:A Cm) (:B V_m1m) (:C C2))
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X C2) (:X_rel *R_m2m))
          (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
         ((>= K_m3m 0)))
    (relative (:Base B) (:X C2) (:X_rel *C2_rel))
    (opposite D (:Opp *O))
    (margin (:B C_rel) (:D O) (:K *I))
    (margin (:B C2_rel) (:D O) (:K *I2)))

  (RULE &inner_end
    (&shape_box.box *B)
    (input (:P *C))
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X C) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X C) (:X_rel *C_rel))
    (dir_elem *D)
    (opposite D (:Opp *O))
    (margin (:B C_rel) (:D O) (:K *I))
    (NOT (&inner_step D I)))

  (RULE &aligned
    (&marker *P)
    (&marker (:P *Q))
    (axis_elem *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P) (:D D_m2) (:K *K_m3))
    (margin (:B Q) (:D D_m2) (:K K_m3)))

  (RULE &line_axis
    (axis_elem *A)
    (ALL ((&marker *P)
          (&marker (:P *Q)))
         ((&aligned A P Q))))

  (RULE &walk_start
    (&own_marker *P)
    (&line_axis *A)
    (axis_of *D A))

  ;; The walk unrolls the marker line: a marker spans the shape's extent along
  ;; the line, and a gap cell spans one cell.
  (INIT &unroll Distance
    (key ((OR ((&walk_start ^D *P))
              ((&walk_start D)
               (&marker P)
               (&inner_step D *I *I2))
              ((&walk_start D)
               (step_offset D (:V *V_m1))
               (input (:P *Q))
               (OR ((&marker P)
                    (&inner_end D (:I *I3)))
                   ((input P)
                    (NOT (&marker P))
                    (= I3 0)))
               (compose (:A P) (:B V_m1) (:C Q)))))
      (edge ((:a P I) (:b (:P P2) (:I I2)))
        (OR ((&walk_start D)
             (step_offset D (:V *V_m1))
             (input (:P *P2))
             (OR ((&marker *P)
                  (&inner_end D *I))
                 ((input P)
                  (NOT (&marker P))
                  (= I 0)))
             (compose (:A P) (:B V_m1) (:C P2))
             (= *I2 0))
            ((&walk_start D)
             (&marker P)
             (&inner_step D I I2)
             (= P2 P))))
      (source ((:n P I))
        (&walk_start D *P)
        (= *I 0))))

  (RULE &slot
    (&unroll.distance (:key *D) (:n *P (:I 0)) (:K *N))
    (&shape_box.box (:B *B3))
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
    (edge_inset D (:K N) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A B3) (:B V_m1) (:C *B)))

  (RULE &copy
    (&marker (:P *Q))
    (input (:P Q) *Col)
    (&slot (:P Q) *B)
    (&shape (:P *P_in))
    (&shape_box.box (:B *B_s))
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B_s) (:X P_in) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B_s) (:X P_in) (:X_rel *P_rel))
    (input *P)
    (ALL ((&slot (:P *Qm) B)
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X P) (:X_rel *R_m2m))
          (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
         ((>= K_m3m 0)))
    (relative (:Base B) (:X P) (:X_rel P_rel))))

(ALTS $w "the walk's reach from the shape's marker: the marker line, or all four directions" $Line
  (ALT $FourDir
    (OUTPUT slots "walked from the shape's marker toward each of the four edges, the markers along each walk unroll into slots the same way"
      (RULE &walk_start
        (&own_marker *P)
        (dir_elem *D)))))

(ALTS $o "which color a cell takes where a copy lands on input ink" $Stamp
  (ALT $Fill
    (OUTPUT keep "input ink keeps its color, and a copy paints only background cells")
    (RULE &output
      ;; Input ink keeps its color; a copy paints only background.
      (OR ((&copy *P *Col)
           (input P (:Col *C0))
           (&bg (:C C0)))
          ((input P Col)
           (OR ((NOT (&bg (:C Col))))
               ((NOT (&copy P)))))))))

(RULE &output
  ;; A copy paints over the input.
  (OR ((&copy *P *Col))
      ((input P Col)
       (NOT (&copy P)))))
