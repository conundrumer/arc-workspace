;; 56ff96f3

(DET &bg DominantColor)

(INIT &bbox BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &spanned
  (&bbox.box (:key *Col) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &output
  (OR ((&spanned *P *Col))
      ((input P Col)
       (NOT (&spanned P)))))
