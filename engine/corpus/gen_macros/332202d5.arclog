;; 332202d5

;; The axis the marked lines stack along; the divider runs along it.
(DET &axis AxisDomain)

(RULE &casts_dir
  (&axis *A)
  (axis_of *D A))

(RULE &casts_node
  (input *P))

;; The field the marked lines sit in.
(DET &bg DominantColor)

(RULE &cell_split_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *P_across_)))

(RULE &cell_split
  (input *P *Col)
  (&axis *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:P_across_ *P_across)))

;; The divider's color in the input; the crossings take it in the output.
(DET &divider_color SharedColor)

(RULE &divider
  (&cell_split *Col *P_across)
  (&divider_color (:C Col)))

(RULE &mark
  (&cell_split *Col *P_along *P_across)
  (NOT (&bg (:C Col)))
  (NOT (&divider P_across)))

(RULE &casts_source
  (&mark (:P_along *P)))

;; Each marked line casts its color both ways along the stacking axis.
(INIT &casts Distance
  (key ((&casts_source (:P ^O))
        (&casts_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&casts_source (:P O))
           (&casts_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&casts_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&casts_node (:P Q)))
          ((&casts_source (:P O))
           (&casts_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&casts_node (:P Q))
           (= A2 O))
          ((&casts_source (:P O))
           (&casts_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&casts_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&casts_node (:P Q)))))
    (source ((:n O))
      (&casts_source (:P O))
      (&casts_dir D))))

(RULE &casts_ray
  (&casts.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &casts_end
  (&casts_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&casts_ray (:P Q) D Origin)))

;; The crossings' color in the input; every line takes it in the output.
(DET &cross_color RarestColor)

(RULE &casts_cell
  (&cell_split (:P_along *P)))

;; The colors carried by the nearest marked lines.
(INIT &nearest Order
  (key ((&casts_cell (:P ^P_along)))
    (member ((:t (:V Col) (:S K)))
      (&casts_ray (:P P_along) *K (:Origin *Src))
      (&mark (:P_along Src) *Col))
    (score ((:t (:V Col) (:S K)) (:S K))
      (&casts_ray (:P P_along) *K (:Origin *Src))
      (&mark (:P_along Src) *Col))))

(INIT &agree Singleton
  (key ((&nearest.minimal (:key ^P_along) (:t (:V *Col))))
    (member ((:v Col))
      (&nearest.minimal (:t (:V *Col))))))

(RULE &field
  (OR ((&agree.value (:key *P_along) (:v *Col)))
      ((&agree.plural (:key P_along))
       (&cross_color (:C Col)))))

(RULE &output
  (&cell_split *P *P_along *P_across)
  (OR ((&mark P_along)
       (&divider P_across)
       (&divider_color (:C *Col)))
      ((&mark P_along)
       (NOT (&divider P_across))
       (&cross_color (:C Col)))
      ((NOT (&mark P_along))
       (&divider P_across)
       (&cross_color (:C Col)))
      ((NOT (&mark P_along))
       (NOT (&divider P_across))
       (&field P_along Col))))
