;; ed74f2f2

(DET &border SepThickness)

(RULE &decompose_uniform_inset1
  (&border (:G *K2_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K2_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K2_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K2_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(DET &bg DominantColor)

(DET &target_tile PositionDomain)

(DET &decompose_tiles Division)

(RULE &decompose
  (&decompose_tiles (:P *P_frame) (:P_outer *P_tile) (:P_inner *P_intile))
  (&border (:G *K2))
  (&decompose_uniform_inset1 (:K2_ K2) (:B_ *B))
  (compose (:A P_frame) B (:C *P_grid)))

(DET &key_tile
  (&decompose (:P_tile *P))
  (NOT (&target_tile P)))

(RULE &key_cell
  (&decompose *P_grid *P_tile *P_intile)
  (&key_tile (:P P_tile)))

(RULE &decompose2
  (&decompose *P_grid *P_tile *P_intile))

(DET &key_content
  (ex_input *E (:P *P_grid) *Col)
  (&key_cell P_grid *P_intile))

;; Examples whose key tiles agree share an entry.
(INIT &same Inclusion
  (pattern ((:pattern E) (:m (:P P_intile) Col))
    (&key_content *E *P_intile *Col))
  (observed ((:observed E) (:m (:P P_intile) Col))
    (&key_content *E *P_intile *Col)))

(INIT &entry Quotient
  (equivalent ((:a E) (:b E2))
    (&same.equal (:observed *E) (:pattern *E2))))

(DET &key_member
  (&entry.class (:a *E) *Id)
  (&key_content E *P_intile *Col))

(DET &key_color
  (&entry.class (:a *E) *Id)
  (ex_output E *Col)
  (NOT (&bg (:C Col))))

(ALTS $choice "how the arrangement is decomposed; every grid of the task is 5×9, so the decomposition reads two ways. The division by tile size gets no case: &key_tile is a position of the tile arrangement, so a grid the two divisions read differently leaves the arrangement without that tile, and the size reading emits nothing" $Table
  (ALT $Count
    (DET &arr_dim SepTileCountAxis)

    (RULE &inner_cell_uniform_inset1
      (&border (:G *K_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &inner_cell
      (input (:P *P_grid))
      (&border (:G *K))
      (&inner_cell_uniform_inset1 (:K_ K) (:B_ *B))
      (ALL ((&border (:G *Km))
            (axis_of (:D *D1_m1) (:A *A1_m2))
            (perp (:A A1_m2) (:A2 *A2_m3))
            (axis_of (:D *D2_m4) (:A A2_m3))
            (opposite (:D D1_m1) (:Opp *O_m7))
            (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
            (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
            (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
            (opposite (:D D2_m4) (:Opp *O_m10))
            (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
            (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
            (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
            (compose (:A B1_m5) (:B B2_m6) (:C B))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

    (INIT &div_sides ExtentDivisions
      (frame ((:P P_inner))
        (&inner_cell *P_inner)))

    (DET &gap SepThickness)

    (RULE &div_gap
      (&arr_dim *A *N)
      (&gap *G))

    (RULE &div_axis_split1
      (&inner_cell (:P_inner *P_inner_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &div_axis
      (OR ((&inner_cell (:P_inner *P))
           (&arr_dim *A *N)
           (&arr_dim A (:N *N2))
           (&gap *G)
           (&div_sides.division A N *K G)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((&inner_cell (:P_inner P))
           (&arr_dim A (:N *N3))
           (&arr_dim A (:N *N22))
           (&gap (:G *G2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N3)))
          ((&inner_cell (:P_inner P))
           (&arr_dim A (:N *N4))
           (NOT (&div_gap A))
           (&div_sides.division A (:N N4) (:K *K3) (:G 0))
           (axis_of (:D *D3) A)
           (opposite (:D D3) (:Opp *O3))
           (margin (:B P) (:D D3) (:K *T4))
           (margin (:B P) (:D O3) (:K *T23))
           (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
           (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
           (opposite (:D D3) (:Opp *O_m13))
           (edge_inset (:D D3) (:K I4) (:B *B1_m23))
           (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
           (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
           (opposite (:D D3) (:Opp *O_m43))
           (edge_inset (:D D3) (:K R4) (:B *B1_m53))
           (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
           (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K3)))
          ((&inner_cell (:P_inner P))
           (&arr_dim A (:N *N5))
           (NOT (&div_gap A))
           (frame_extent P A (:N *K4))
           (axis_of (:D *D4) A)
           (opposite (:D D4) (:Opp *O4))
           (margin (:B P) (:D D4) (:K *T5))
           (margin (:B P) (:D O4) (:K *T24))
           (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
           (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
           (opposite (:D D4) (:Opp *O_m14))
           (edge_inset (:D D4) (:K I5) (:B *B1_m24))
           (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
           (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
           (opposite (:D D4) (:Opp *O_m44))
           (edge_inset (:D D4) (:K R5) (:B *B1_m54))
           (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
           (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K4))
           (frame_extent (:P P_outer) A (:N N5)))
          ((&inner_cell (:P_inner P))
           (axis_elem A)
           (NOT (&arr_dim A))
           (&div_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &div_tile
      (&div_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&div_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &decompose2
      (&inner_cell *P_grid *P_inner)
      (&div_tile (:P P_inner) (:P_outer *P_tile) (:P_inner *P_intile)))))

;; Key tile content → color.
(INIT &key_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_intile) Col))
    (&key_member *Id *P_intile *Col))
  (observed ((:m (:P P_intile) Col))
    (input (:P *P_grid) *Col)
    (&decompose2 P_grid *P_tile *P_intile)
    (&key_tile (:P P_tile))))

(RULE &target
  (input (:P *P_grid) *Col)
  (&decompose2 P_grid *P_tile *P_intile)
  (&target_tile (:P P_tile)))

(RULE &output
  (OR ((&target (:P_intile *P) (:Col *C))
       (NOT (&bg C))
       (&key_match.equal (:pattern *Id))
       (&key_color Id *Col))
      ((&target (:P_intile P) Col)
       (&bg (:C Col)))))
