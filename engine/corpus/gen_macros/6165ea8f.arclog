;; 6165ea8f

(DET &ink_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &ink_node
  (ex_output (:E *Key) *P *Col)
  (NOT (&bg (:C Col))))

;; Gap cells stand between the blocks, so each block is one component.
(INIT &ink Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&ink_node (:Key *Ky) *P)
         (&ink_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&ink_node (:Key Ky) (:P P2)))
        ((&ink_node (:Key Ky) P)
         (= P2 P)))))

(DET &ink_component
  (&ink.class (:a *Key *P) *Id))

(INIT &blk BoundingBox
  (key ((&ink_component (:Key ^E) *P ^Id))
    (cell (P)
      (&ink_component (:Key E) *P Id))))

(DET &block
  (&blk.cell (:key *E *Id) *P)
  (&blk.box (:key E Id) *B)
  (axis_elem (:A *A_m1))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A_m1) *N))

(DET &cand_gap
  (ex_output *P)
  (axis_elem *A)
  (sub_extent P A (:K *G)))

(DET &tiled_division_gap_held
  (axis_elem *A)
  (&cand_gap *G)
  (&block (:N *K)))

(DET &tiled_division_axis_split1
  (ex_output (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &tiled_division_side_held
  (axis_elem *A)
  (&cand_gap *G)
  (&block (:N *K)))

(DET &tiled_division_axis
  (OR ((ex_output *P)
       (&cand_gap *G)
       (&block (:N *K))
       (axis_elem *A)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_output P)
       (&cand_gap G)
       (&block (:N K))
       (axis_elem A)
       (NOT (&tiled_division_gap_held G K A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_output P)
       (&cand_gap G)
       (&block (:N K))
       (axis_elem A)
       (NOT (&tiled_division_side_held G K A))
       (&tiled_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &tiled_division_tile
  (&tiled_division_axis *G *K *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tiled_division_axis G K P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; The edge the color list runs along.
(DET &legend_dir DirDomain)

(RULE &legend
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&legend_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &legend_axis
  (&legend_dir *D)
  (axis_of D (:A *A2))
  (perp (:A A2) (:A2 *A)))

(RULE &before_split1
  (&legend *Col (:P *P_))
  (&legend_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &before_split2
  (&legend (:Col *Col2) (:P *P2_))
  (&legend_axis (:A *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
  (relative (:Base L2_) (:X P2_) (:X_rel *X_m2_)))

(RULE &elem_split1
  (&legend *Col (:P *P_))
  (&legend_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &order Order
  (key ((&legend_axis (:A ^A2))
        (axis_of ^D (:A A2)))
    (before ((:a Col) (:b Col2))
      (&legend *Col *P)
      (&legend_axis *A)
      (&before_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
      (&legend (:Col *Col2) (:P *P2))
      (&legend_axis (:A *A22))
      (&before_split2 (:P2_ P2) (:A2_ A22) (:L2_ *L2) (:X_m2_ *X_m2))
      (!= Col Col2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2)))
  (member ((:t Col))
    (&legend *Col *P)
    (&legend_axis *A)
    (&elem_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))))

(RULE &order_pos
  (&order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
  (&order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(INIT &entry Frame
  (extent (A N)
    (axis_elem *A)
    (&block *N)))

(DET &tiled
  (ex_output *E *P)
  (&tiled_division_tile *G P (:P_outer *P_tile)))

(DET &loose
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col)))
  (&cand_gap *G)
  (NOT (&tiled E G P)))

(DET &gap
  (&cand_gap *G)
  (NOT (&loose G)))

;; What a block says about the two shapes it stands for.
(DET &alike AnyOutNewColor)

(RULE &shape_cell
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&legend_dir *D)
  (NOT (margin (:B P) D (:K 0))))

(INIT &bbox BoundingBox
  (key ((&shape_cell ^Col *P))
    (cell (P)
      (&shape_cell Col *P))))

(RULE &shape_inner
  (&shape_cell *Col *P)
  (&bbox.box (:key Col) *B)
  (ALL ((&shape_cell (:Col *Colm) P)
        (&bbox.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &cong Agreement
  (key ((OR ((&shape_inner (:Col ^A) *P_inner)
             (&shape_inner (:Col ^B)))
            ((&shape_inner (:Col A))
             (&shape_inner (:Col B) P_inner))))
    (source ((:i P_inner))
      (&shape_inner (:Col A) *P_inner)
      (&shape_inner (:Col B)))
    (target ((:i P_inner))
      (&shape_inner (:Col A))
      (&shape_inner (:Col B) *P_inner))
    (correspondence ((:m D) (:i P_inner) (:j Q))
      (&shape_inner (:Col A) *P_inner)
      (&shape_inner (:Col B))
      (d4_elem *D)
      (apply D (:P P_inner) (:P_out *Q)))))

(RULE &cong_src
  (&shape_inner (:Col *A) (:P_inner *P))
  (&shape_inner (:Col *B)))

(RULE &same_shape
  (&cong_src *A *B)
  (d4_elem *D)
  (NOT (&cong.mismatch (:key A B) (:m D)))
  (d4_inverse D (:D_inv *D_back))
  (&cong_src (:A B) (:B A))
  (d4_elem (:D D_back))
  (NOT (&cong.mismatch (:key (:A B) (:B A)) (:m D_back))))

;; The output corner the two header lines meet at. Its diagonal carries the blocks where a color meets itself.
(DET &header_corner DiagDirDomain)

(DET &ring
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col)))
  (&gap *G)
  (&tiled E G P *P_tile)
  (&header_corner (:D *Cn))
  (corner_dist (:P P_tile) (:Diag Cn) *K))

(INIT &near Order
  (member ((:t K))
    (&ring *K))
  (score ((:t K) (:S K))
    (&ring *K)))

(DET &header
  (&near.minimal (:t *N)))

(RULE &list_slot
  (&order_pos (:M *Col) (:P_pos *P_order))
  (&legend_axis *A)
  (&header_corner (:D *Cn))
  (corner_dir (:C Cn) A *D)
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Cn) (:A A2_m2) (:D *D2_m1))
  (&header (:N *K))
  (edge_inset D K (:B *Delta))
  (compose (:A P_order) (:B Delta) (:C *P)))

(RULE &slot
  (&list_slot *Col (:A *A0) (:P *P0))
  (OR ((perp (:A A0) (:A2 *A))
       (&header_corner (:D *Cn))
       (diag_axis_of (:D Cn) (:Da *DA))
       (reflection (:A DA) *T)
       (apply (:D T) (:P P0) (:P_out *P)))
      ((= A A0)
       (= P P0))))

(INIT &tile_line Frame
  (key ((&slot ^A *P)
        (frame_extent P A *N))
    (extent (A N)
      (&slot A *P)
      (frame_extent P A *N))))

(DET &unlike AnyOutNewColor)

(RULE &tile_color
  (&slot (:Col *C2) (:A *A2) (:P *P2))
  (perp *A A2)
  (OR ((&slot (:Col *C1) A (:P *P1))
       (!= C1 C2)
       (IF ((&same_shape (:A C1) (:B C2)))
           ((&alike (:C *Col)))
           ((&unlike (:C Col)))))
      ((&tile_line.cell (:key A) (:P P1))
       (NOT (&slot A (:P P1)))
       (= Col C2)))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &painted_tiling Tiling
  (outer ((:P P_tile))
    (&tile_color *P_tile))
  (inner ((:P P_intile))
    (&entry.cell (:P *P_intile)))
  (gap (A G)
    (axis_elem *A)
    (&gap *G)))

(RULE &painted
  (&tile_color *P_tile *Col)
  (&painted_tiling.cell (:P_outer P_tile) *P))

(INIT &sheet Frame
  (extent (A N)
    (&painted *P)
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &output
  (&sheet.cell *P)
  (OR ((&painted P *Col))
      ((NOT (&painted P))
       (&bg (:C Col)))))
