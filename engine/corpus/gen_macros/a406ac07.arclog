;; a406ac07

(DET &header DiagDirDomain)

(DET &bg DominantColor)

(RULE &line_color
  (input *P)
  (&header (:D *Diag))
  (corner_dir (:C Diag) *A *D)
  (input (:P *Q) *Col)
  (margin (:B Q) D (:K 0))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &agree
  (&header (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&line_color *P (:D D1) *Col)
  (&line_color P (:D D2) Col))

(ALTS $choice "how the line colors are read, and what an unmatched cell becomes" $Passthrough
  (ALT $Repaint
    (RULE &on_header
      (input *P)
      (&header (:D *Diag))
      (corner_dir (:C Diag) *D)
      (margin (:B P) D (:K 0)))

    (RULE &output
      (OR ((input *P *Col)
           (&on_header P))
          ((&agree P Col)
           (NOT (&on_header P)))
          ((input P)
           (NOT (&on_header P))
           (NOT (&agree P))
           (&bg (:C Col))))))
  (ALT $Coincide
    (RULE &line_ink
      (input *P)
      (input (:P *Q) *Col)
      (NOT (&bg (:C Col)))
      (axis_elem *A)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P) (:D D_m2) (:K *K_m3))
      (margin (:B Q) (:D D_m2) (:K K_m3)))

    (RULE &coincide
      (input *P (:Col *C0))
      (&bg (:C C0))
      (perp (:A *A1) *A2)
      (&line_ink P (:A A1) *Col)
      (&line_ink P (:A A2) Col))

    (RULE &output
      (OR ((&coincide *P *Col))
          ((input P Col)
           (NOT (&coincide P)))))))

(RULE &output
  (OR ((&agree *P *Col))
      ((input P Col)
       (NOT (&agree P)))))
