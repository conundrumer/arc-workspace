;; 80214e03

(DET &bg DominantColor)

(RULE &line_color_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &line_color
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (axis_elem *A)
  (&line_color_split1 (:P_ P2) (:A_ A) (:L_ *P) (:X_m1_ *X_m1)))

(RULE &adjacent
  (&line_color *A (:P *L))
  (&line_color A (:P *L2))
  (axis_of *D A)
  (step_offset D (:V *V_m1))
  (compose (:A L) (:B V_m1) (:C L2)))

(INIT &content Inclusion
  (pattern ((:pattern (:A L_a) (:P L_p)) (:m Col))
    (&line_color (:A *L_a) (:P *L_p) *Col))
  (observed ((:observed (:A L_a) (:P L_p)) (:m Col))
    (&line_color (:A *L_a) (:P *L_p) *Col)))

(RULE &separated
  (&adjacent *A *L *L2)
  (NOT (&content.equal (:observed A (:P L)) (:pattern A (:P L2)))))

(RULE &tile_of_split1
  (input (:P *P_))
  (perp (:A *A_) *A2)
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &tile_of_split2
  (input (:P *P_))
  (perp *A (:A2 *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
  (relative (:Base L2_) (:X P_) (:X_rel *X_m2_)))

(DET &transform D4Domain)

(ALTS $choice "what separates two adjacent lines" $Content
  (ALT $Contrast
    (RULE &separated_split1
      (input (:P *P_) *Col)
      (axis_of *D (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m2_)))

    (RULE &separated_split2
      (input (:P *Q_) (:Col *Col2))
      (axis_of *D (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B Q_) (:D D_m1) (:K *K1_m3))
      (margin (:B Q_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
      (relative (:Base L2_) (:X Q_) (:X_rel *X_m3_)))

    (RULE &separated
      (input *P *Col)
      (input (:P *Q) (:Col *Col2))
      (NOT (&bg (:C Col)))
      (NOT (&bg (:C Col2)))
      (!= Col Col2)
      (axis_of *D *A)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C Q))
      (&separated_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m2_ *X_m2))
      (&separated_split2 (:Q_ Q) (:A_ A) (:L2_ *L2) (:X_m3_ *X_m3)))))

;; A block-line is a run of adjacent lines that no boundary separates.
(INIT &block_line Quotient
  (edge ((:a (:A L_a) (:P L_p)) (:b (:A L_a) P))
    (OR ((&adjacent (:A *L_a) (:L *L_p) (:L2 *P))
         (NOT (&separated (:A L_a) (:L L_p) (:L2 P))))
        ((&line_color (:A L_a) (:P L_p))
         (= P L_p)))))

;; The frame the block-lines induce on each axis.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t B))
      (&block_line.class (:a A (:P *L)) (:Id *B)))
    (before ((:a B) (:b B2))
      (&block_line.class (:a A (:P *L)) (:Id *B))
      (&block_line.class (:a A (:P *L2)) (:Id *B2))
      (!= B B2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) *A *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) A D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &tile_of
  (input *P)
  (perp *A *A2)
  (&tile_of_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (&tile_of_split2 (:P_ P) (:A2_ A2) (:L2_ *L2) (:X_m2_ *X_m2))
  (&block_line.class (:a A (:P L)) (:Id *B))
  (&block_line.class (:a (:A A2) (:P L2)) (:Id *B2))
  (&layout_pos (:Key A) (:M B) (:P_pos *P_line))
  (&layout_pos (:Key A2) (:M B2) (:P_pos *P_line2))
  (compose (:A P_line) (:B P_line2) (:C *P_tile)))

(RULE &output
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (&tile_of (:P P2) *P_tile)
  (&transform (:D *T))
  (apply (:D T) (:P P_tile) (:P_out *P)))
