;; ac0c2ac3

(INPUT square-odd "the input is a square grid with an odd side, so it has one center cell, and its rings are the cells at each Chebyshev distance from that center")

(INPUT one-mark-per-ring "on a field of &bg, each ring holds exactly one mark, a cell of another color, and no two marks share a color"

  (DET_OR_RULE &bg DominantColor))

(OUTPUT fill-ring "the output has the input's frame, and every cell of a ring takes the color of the mark that lies on that ring"

  (RULE &ring_uniform_outset1
    (input (:P *O))
    (input *P)
    (relative (:Base O) (:X P) (:X_rel *P_rel))
    (dir_elem *D)
    (margin (:B P_rel) D (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m7))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
    (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m10))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
    (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
    (relative (:Base I_m1) (:X 0) (:X_rel *B_out_)))

  ;; the scan starts at this corner and runs along this axis first
  ;; TODO no-det-plan: &scan_order: the plan gives no verdict
  (DET &scan_order)

  (RULE &mark
    (input *P *Col)
    (NOT (&bg (:C Col))))

  ;; P lies on ring K about center O: on the outline of the square that reaches
  ;; K cells past O on every side.
  (RULE &ring
    (input (:P *O))
    (ALL ((opposite (:D *D_m1m) (:Opp *O_m2))
          (margin (:B O) (:D D_m1m) (:K *K1_m3))
          (margin (:B O) (:D O_m2) (:K *K2_m4)))
         ((= K1_m3 K2_m4)))
    (input *P)
    (relative (:Base O) (:X P) (:X_rel *P_rel))
    (dir_elem *D)
    (margin (:B P_rel) D *K)
    (&ring_uniform_outset1 (:K_ K) (:B_out_ *B_out))
    (compose (:A O) (:B B_out) (:C *B))
    (ALL ((input (:P *Om))
          (relative (:Base Om) (:X P) (:X_rel *P_relm))
          (dir_elem (:D *Dm))
          (margin (:B P_relm) (:D Dm) (:K *Km))
          (axis_of (:D *D1_m2) (:A *A1_m3))
          (perp (:A A1_m3) (:A2 *A2_m4))
          (axis_of (:D *D2_m5) (:A A2_m4))
          (opposite (:D D1_m2) (:Opp *O_m8))
          (edge_inset (:D D1_m2) (:K Km) (:B *B1_m9))
          (edge_inset (:D O_m8) (:K Km) (:B *B2_m10))
          (compose (:A B1_m9) (:B B2_m10) (:C *B1_m6))
          (opposite (:D D2_m5) (:Opp *O_m11))
          (edge_inset (:D D2_m5) (:K Km) (:B *B1_m12))
          (edge_inset (:D O_m11) (:K Km) (:B *B2_m13))
          (compose (:A B1_m12) (:B B2_m13) (:C *B2_m7))
          (compose (:A B1_m6) (:B B2_m7) (:C *I_m1))
          (relative (:Base I_m1) (:X 0) (:X_rel *B_outm))
          (compose (:A Om) (:B B_outm) (:C B))
          (dir_elem (:D *D_m1mm))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1mm) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D *D_m1) (:K *K_m2))
    (margin B (:D D_m1) (:K K_m2)))

  (RULE &mark_ring
    (&mark *P *Col)
    (&ring P *K))

  (RULE &marked
    (&mark_ring *K))

  (RULE &crowded
    (&mark_ring *K *P)
    (&mark_ring K (:P *Q))
    (!= P Q))

  (RULE &ring_color
    (&mark_ring *K *Col)
    (NOT (&crowded K)))

  (RULE &scan_cell
    (&mark_ring *K *P)
    (&scan_order (:D *C) *A))

  (INIT &scan Order
    (key ((&mark_ring ^K *P)
          (&scan_order (:D ^C) ^A))
      (member ((:t P))
        (&mark_ring K *P)
        (&scan_order (:D C) A))
      (before ((:a P) (:b P2))
        (&mark_ring K *P)
        (&scan_order (:D C) A)
        (&mark_ring K (:P *P2))
        (&scan_cell K C A)
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  ;; The last mark's color, kept where every open scan order agrees.
  (INIT &last Singleton
    (key ((&scan.maximal (:key ^K) (:t *P))
          (&mark P *Col))
      (member ((:v Col))
        (&scan.maximal (:key K) (:t *P))
        (&mark P *Col))))

  ;; The marked rings, outermost first.
  (INIT &nest Order
    (member ((:t K))
      (&marked *K))
    (before ((:a K) (:b K2))
      (&marked *K)
      (&marked (:K *K2))
      (> K K2))))

(ALTS $rings "what a ring is" $CenterRings
  (ALT $DepthRings
    (INPUT square-odd "the grid may have any shape, and its rings are the cells at each distance from the nearest grid edge"
      (RULE &ring_uniform_inset1
        (input *P)
        (dir_elem *D)
        (margin (:B P) D (:K *K_))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m1))
        (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m4))
        (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
        (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
        (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

      ;; P lies on ring K: on the outline of the frame inset by K on every side.
      (RULE &ring
        (input *P)
        (dir_elem *D)
        (margin (:B P) D *K)
        (&ring_uniform_inset1 (:K_ K) (:B_ *B))
        (ALL ((dir_elem (:D *Dm))
              (margin (:B P) (:D Dm) (:K *Km))
              (axis_of (:D *D1_m1) (:A *A1_m2))
              (perp (:A A1_m2) (:A2 *A2_m3))
              (axis_of (:D *D2_m4) (:A A2_m3))
              (opposite (:D D1_m1) (:Opp *O_m7))
              (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
              (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
              (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
              (opposite (:D D2_m4) (:Opp *O_m10))
              (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
              (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
              (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
              (compose (:A B1_m5) (:B B2_m6) (:C B))
              (dir_elem (:D *D_m1m))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) (:D *D_m1) (:K *K_m2))
        (margin B (:D D_m1) (:K K_m2)))

      ;; The marked rings, outermost first.
      (INIT &nest Order
        (member ((:t K))
          (&marked *K))
        (before ((:a K) (:b K2))
          (&marked *K)
          (&marked (:K *K2))
          (< K K2))))))

(ALTS $unmarked "what a ring with no mark gets" $NeedsMark
  (ALT $EmptyBg
    (OUTPUT empty-bg "a ring with no mark keeps &bg")
    (RULE &draw
      (&ring *P *K)
      (OR ((&ring_color K *Col))
          ((NOT (&marked K))
           (&bg (:C Col))))))
  (ALT $RankRings
    (OUTPUT fill-ring "the output is a square with one ring per marked ring, and its rings, outermost first, take the colors of the marked rings, outermost first"
      (RULE &canvas_uniform_inset1
        (&nest.rank (:t *K) (:R *N_))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m1))
        (edge_inset (:D D1_m1) (:K N_) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K N_) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m4))
        (edge_inset (:D D2_m4) (:K N_) (:B *B1_m6))
        (edge_inset (:D O_m4) (:K N_) (:B *B2_m7))
        (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *C_)))

      (RULE &draw_uniform_inset1
        (&nest.rank (:t *K) (:R *J_))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m1))
        (edge_inset (:D D1_m1) (:K J_) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K J_) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m4))
        (edge_inset (:D D2_m4) (:K J_) (:B *B1_m6))
        (edge_inset (:D O_m4) (:K J_) (:B *B2_m7))
        (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

      (RULE &canvas
        (&nest.maximal (:t *K))
        (&nest.rank (:t K) (:R *N))
        (&canvas_uniform_inset1 (:N_ N) (:C_ *C))
        (&nest.rank (:R *K1))
        (&nest.rank (:R *K2))
        (axis_of (:D *D1) *A)
        (perp A *A2)
        (axis_of (:D *D2) (:A A2))
        (dir8_opposite (:D D1) (:D2 *O_m2))
        (edge_inset (:D O_m2) (:K K1) (:B *B1_m3))
        (edge_inset (:D D1) (:K K1) (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
        (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
        (compose (:A C) (:B V_m1) (:C *Q))
        (dir8_opposite (:D D2) (:D2 *O_m7))
        (edge_inset (:D O_m7) (:K K2) (:B *B1_m8))
        (edge_inset (:D D2) (:K K2) (:B *I_m10))
        (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *V_m6))
        (compose (:A Q) (:B V_m6) (:C *P))))
    (RULE &draw
      (&canvas *P)
      (&nest.rank (:t *K) (:R *J))
      (&draw_uniform_inset1 (:J_ J) (:B_ *B))
      (ALL ((&canvas P)
            (&nest.rank (:t *Km) (:R *Jm))
            (axis_of (:D *D1_m1) (:A *A1_m2))
            (perp (:A A1_m2) (:A2 *A2_m3))
            (axis_of (:D *D2_m4) (:A A2_m3))
            (opposite (:D D1_m1) (:Opp *O_m7))
            (edge_inset (:D D1_m1) (:K Jm) (:B *B1_m8))
            (edge_inset (:D O_m7) (:K Jm) (:B *B2_m9))
            (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
            (opposite (:D D2_m4) (:Opp *O_m10))
            (edge_inset (:D D2_m4) (:K Jm) (:B *B1_m11))
            (edge_inset (:D O_m10) (:K Jm) (:B *B2_m12))
            (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
            (compose (:A B1_m5) (:B B2_m6) (:C B))
            (dir_elem (:D *D_m1m))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) (:D *D_m1) (:K *K_m2))
      (margin B (:D D_m1) (:K K_m2))
      (&ring_color K *Col))

    (RULE &frame
      (&canvas *P))))

(ALTS $shared "what a ring with two marks gets" $OneMark
  (ALT $ScanLast
    (OUTPUT fill-ring "a ring takes the color of its mark that comes last in the scan from the corner of a &scan_order along its axis first. Undefined where the open scan orders pick marks of different colors."
      (RULE &ring_color
        (&last.value (:key *K) (:v *Col))))))

(RULE &draw
  (&ring *P *K)
  (&ring_color K *Col))

(RULE &frame
  (&ring *P))

(RULE &blank
  (&frame *P)
  (NOT (&draw P)))

(RULE &output
  (&draw *P *Col)
  (NOT (&blank)))
