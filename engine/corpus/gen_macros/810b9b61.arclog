;; 810b9b61

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &recolor ChangedPairs)

(RULE &ink
  (input *P *Col)
  (&recolor (:C_from Col)))

(INIT &objs Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&ink *Col *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink Col (:P P3)))
        ((&ink Col P)
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(INIT &drect Outlines
  (key ((&ink ^Col *P))
    (node (P)
      (&ink Col *P))))

(RULE &painted
  (&drect.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2)))

(RULE &obj
  (&objs_component (:Key *Col) *P *Id))

(ALTS $choice "how a closed rectangle is recognized" $Rect
  (ALT $Object
    (INIT &bbox BoundingBox
      (key ((&obj ^Col ^Id *P))
        (cell (P)
          (&obj Col Id *P))))

    (RULE &edge_gap
      (&bbox.box (:key *Col *Id) *B)
      (input *P)
      (ALL ((&bbox.box (:key (:Col *Km_col) (:Id *Km_id)) B)
            (dir_elem (:D *D_m1m))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) (:D *D_m1) (:K *K_m2))
      (margin B (:D D_m1) (:K K_m2))
      (NOT (&obj Col Id P)))

    (RULE &painted
      (&obj (:Col *K_col) (:Id *K_id) *P)
      (&bbox.box (:key (:Col K_col) (:Id K_id)) *B)
      (NOT (&edge_gap (:Col K_col) (:Id K_id)))
      (input (:P *Q))
      (ALL ((&bbox.box (:key (:Col *Km_col) (:Id *Km_id)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X Q) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((> K_m3 0)))))
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&recolor (:C_from *Key))
      (input *P)
      (NOT (&ink (:Col Key) P)))

    (RULE &closed_flood_node
      (&recolor (:C_from *Key))
      (input *P)
      (NOT (&ink (:Col Key) P)))

    (INIT &closed_flood Propagation
      (key ((OR ((&closed_cell (:Key ^Ky) *P)
                 (dir_elem *D)
                 (margin (:B P) D (:K 0))
                 (&closed_flood_node (:Key Ky) P))
                ((&closed_flood_node (:Key Ky) P)
                 (&closed_flood_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *Q))
                 (&closed_flood_node (:Key Ky) (:P Q)))))
        (source ((:n P))
          (&closed_cell (:Key Ky) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (&closed_flood_node (:Key Ky) P))
        (edge ((:a P) (:b Q))
          (&closed_flood_node (:Key Ky) *P)
          (&closed_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *Q))
          (&closed_flood_node (:Key Ky) (:P Q)))))

    (RULE &closed_node
      (&closed_cell *Key *P)
      (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

    ;; Each ink color walls the rest of the grid off.
    (INIT &closed Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&closed_node (:Key *Ky) *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:Key Ky) (:P P2)))
            ((&closed_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *Key *P) *Id))

    (RULE &wall
      (&closed_component (:Key *Col) (:P *Q))
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A Q) (:B V_m1) (:C *P))
      (&obj Col *Id P))

    (RULE &painted
      (&wall (:Col *K_col) (:Id *K_id))
      (&obj (:Col K_col) (:Id K_id) *P))))

(RULE &output
  (OR ((&painted *P)
       (input P (:Col *Col2))
       (&recolor (:C_from Col2) (:C_to *Col)))
      ((input P Col)
       (NOT (&painted P)))))
