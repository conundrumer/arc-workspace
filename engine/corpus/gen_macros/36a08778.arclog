;; 36a08778

(RULE &stream_dir
  (dir_elem (:D *Key)))

(DET &block UnchangedColor)

(RULE &block2
  (input *P *Col)
  (&block (:C Col)))

(RULE &stream_blocked
  (dir_elem (:D *Key))
  (&block2 *P))

(RULE &stream_node
  (dir_elem (:D *Key))
  (input *P)
  (NOT (&stream_blocked Key P)))

(RULE &stream_source
  (dir_elem (:D *Key))
  (input *P)
  (NOT (&block2 P)))

;; The course water poured at a cell toward a direction takes: a cast toward
;; that direction, halted by a block. Keyed by direction.
(INIT &stream Distance
  (key ((&stream_source (:Key ^Ky) (:P ^O))
        (&stream_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&stream_source (:Key Ky) (:P O))
           (&stream_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&stream_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&stream_node (:Key Ky) (:P Q)))
          ((&stream_source (:Key Ky) (:P O))
           (&stream_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&stream_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&stream_source (:Key Ky) (:P O))
           (&stream_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&stream_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&stream_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&stream_source (:Key Ky) (:P O))
      (&stream_dir (:Key Ky)))))

(RULE &stream_ray
  (&stream.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &stream_end
  (&stream_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&stream_ray Key (:P Q) D Origin)))

(DET &water RarestColor)

(DET &fall DirDomain)

(RULE &source
  (input *P *Col)
  (&water (:C Col)))

(RULE &pour
  (&source *P)
  (&fall *D))

(RULE &stream_cell
  (dir_elem (:D *Key))
  (input *P))

(RULE &barred
  (&stream_ray (:Key *D) *P D (:Origin *M))
  (&stream_cell (:Key D) P)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *B))
  (&stream_end (:Key D) (:P *E) D (:Origin M))
  (step_offset D (:V *V_m2))
  (compose (:A E) (:B V_m2) (:C B))
  (input (:P B)))

;; A cell to each side, across the flow, pours on.
(RULE &pour_on
  (&barred *M *D *P)
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *D2) (:A A2_m2))
  (step_offset (:D D2) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q))
  (input (:P Q))
  (NOT (&block2 (:P Q))))

(ALTS $flow "how the water passes a barring block" $Step
  (ALT $Shell
    (RULE &run_dir
      (axis_of *D (:A *Key)))

    (RULE &run_node
      (axis_of *D (:A *Key))
      (input *P)
      (ALL ()
           ((&block2 P))))

    (RULE &run_source
      (axis_elem (:A *Key))
      (&block2 *P))

    ;; A block's maximal run along an axis: a cast over block cells that any
    ;; other cell halts.
    (INIT &run Distance
      (key ((&run_source (:Key ^Ky) (:P ^O))
            (&run_dir (:Key Ky) ^D))
        (edge ((:a A2) (:b Q))
          (OR ((&run_source (:Key Ky) (:P O))
               (&run_dir (:Key Ky) D)
               (axis_of D *A)
               (sub_extent (:P O) A *K)
               (dir8_opposite D (:D2 *O_m2))
               (edge_inset (:D O_m2) K (:B *B1_m3))
               (edge_inset D K (:B *I_m5))
               (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
               (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
               (compose (:A O) (:B V_m1) (:C *A2))
               (&run_node (:Key Ky) (:P A2))
               (step_offset D (:V *V_m6))
               (compose (:A A2) (:B V_m6) (:C *Q))
               (&run_node (:Key Ky) (:P Q)))
              ((&run_source (:Key Ky) (:P O))
               (&run_dir (:Key Ky) D)
               (step_offset D (:V *V_m12))
               (compose (:A O) (:B V_m12) (:C Q))
               (&run_node (:Key Ky) (:P Q))
               (= A2 O))
              ((&run_source (:Key Ky) (:P O))
               (&run_dir (:Key Ky) D)
               (diag_dir_elem D)
               (axis_elem (:A *A3))
               (sub_extent (:P O) (:A A3) (:K *K2))
               (dir8_opposite D (:D2 *O_m22))
               (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
               (edge_inset D (:K K2) (:B *I_m52))
               (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
               (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
               (compose (:A O) (:B V_m13) (:C A2))
               (&run_node (:Key Ky) (:P A2))
               (step_offset D (:V *V_m62))
               (compose (:A A2) (:B V_m62) (:C Q))
               (&run_node (:Key Ky) (:P Q)))))
        (source ((:n O))
          (&run_source (:Key Ky) (:P O))
          (&run_dir (:Key Ky) D))))

    (RULE &run_ray
      (&run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

    (RULE &run_end
      (&run_ray *Key *P *D *K *Origin)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (NOT (&run_ray Key (:P Q) D Origin)))

    (RULE &run_cell
      (axis_elem (:A *Key))
      (&block2 *P))

    (RULE &span
      (OR ((&run_ray (:Key *A) *P (:Origin *B))
           (&run_cell (:Key A) P))
          ((&run_end (:Key A) (:P *E) *D (:Origin B))
           (step_offset D (:V *V_m1))
           (compose (:A E) (:B V_m1) (:C P))
           (input P))))

    (RULE &shell
      (axis_of *D (:A *A0))
      (perp (:A A0) (:A2 *A))
      (&span A *B (:P *Q))
      (opposite D (:Opp *D_back))
      (step_offset (:D D_back) (:V *V_m1))
      (compose (:A Q) (:B V_m1) (:C *P))
      (input P)
      (NOT (&block2 P)))

    ;; Where a block stands on another's shell row (test 1), the water past it
    ;; arrives by another pour, so $Step and $Shell agree there too.
    (RULE &pour_on
      (&barred *M *D *B)
      (&shell D B (:P *Q)))))

(ALTS $seat "where the pour direction comes from" $Dir
  (ALT $Stub
    (RULE &stub_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &stub Quotient
      (edge ((:a P) (:b P3))
        (OR ((&source *P)
             (&stub_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&source (:P P3)))
            ((&source P)
             (= P3 P)))))

    (RULE &stub_component
      (&stub.class (:a *P) *Id))

    (RULE &stub_flow
      (&stub_component *P *Id)
      (opposite *D (:Opp *E))
      (margin (:B P) (:D E) (:K 0))
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&source (:P Q)))

    (RULE &pour
      (&stub_component *P *Id)
      (&stub_flow Id *D))))

;; The pours the water makes: the stub's pours, and each pour on from a
;; barred one.
(INIT &flow Propagation
  (source ((:n P D))
    (&pour *P *D))
  (edge ((:a (:P M) D) (:b (:P Q) D))
    (&pour_on *M *D *Q)))

(RULE &wet
  (&flow.reached (:n (:P *M) *D))
  (&stream_ray (:Key D) *P D (:Origin M))
  (&stream_cell (:Key D) P))

(RULE &output
  (OR ((&wet *P)
       (&water (:C *Col)))
      ((input P Col)
       (NOT (&wet P)))))
