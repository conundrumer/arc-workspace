;; a57f2f04

(INPUT panels "several solid rectangles of &blank stand apart on a field of &field"

  (DET_OR_RULE &field DominantColor)

  (RULE &field2
    (&field (:C *Col)))

  (RULE &panel_cell
    (&field2)
    (input *P *Col)
    (NOT (&field2 Col)))

  (RULE &diag_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET &blank SharedColor)

  (INIT &border Singleton
    (member ((:v Col))
      (input *P *Col)
      (dir_elem *D)
      (margin (:B P) D (:K 0))))

  (INIT &diag Quotient
    (edge ((:a P) (:b P3))
      (OR ((&panel_cell *P)
           (&diag_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&panel_cell (:P P3)))
          ((&panel_cell P)
           (= P3 P))))))

(INPUT motif "each panel holds cells of one mark color, in one corner of that panel; panels may differ in mark color")

(INPUT tile "the bounding box of a panel's mark cells is the motif tile; the tile's height divides the panel's height, and its width divides the panel's width")

(OUTPUT tile-panel "each panel is filled with copies of its motif tile, repeated along both axes on the grid of the tile's own position, so the copies cover the panel exactly; blank cells in the tile stay blank")

(OUTPUT field-kept "every field cell keeps its color"

  (RULE &orth_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &orth Quotient
    (edge ((:a P) (:b P3))
      (OR ((&panel_cell *P)
           (&orth_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&panel_cell (:P P3)))
          ((&panel_cell P)
           (= P3 P)))))

  (RULE &orth_component
    (&orth.class (:a *P) *Id))

  (RULE &panel2
    (&orth_component *P (:Id *Pn)))

  (RULE &panel
    (&panel2 (:Pn *K) *P))

  (INIT &box BoundingBox
    (key ((&panel (:K ^X) *P))
      (cell (P)
        (&panel (:K X) *P))))

  (RULE &blank2
    (&box.box (:key (:X *K)))
    (&blank (:C *Col)))

  (RULE &color
    (&box.box (:key (:X *K)) *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (&box.box (:key (:X *Pnm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &mark
    (&panel *K *P)
    (&color K P *Col)
    (NOT (&blank2 K Col)))

  (INIT &marks_box2 BoundingBox
    (key ((&mark (:K ^X) *P))
      (cell (P)
        (&mark (:K X) *P))))

  (RULE &marks_box
    (&marks_box2.box (:key (:X *Pn)) *B))

  (RULE &tile
    (&marks_box (:Pn *K) *B)))

(ALTS $field "where the field color comes from" $StoredField
  (ALT $DeriveField
    (INPUT panels "several solid rectangles of &blank stand apart on a field whose color is the one color of the grid's border ring"
      (RULE &field2
        (&border.value (:v *Col))))))

(ALTS $conn "which non-field cells join into one panel" $Orthogonal
  (ALT $DiagPanel
    (INPUT panels "several solid rectangles of &blank stand apart on a field of &field; cells that touch at a corner join one panel"
      (RULE &diag_component
        (&diag.class (:a *P) *Id))

      (RULE &panel2
        (&diag_component *P (:Id *Pn))))))

(ALTS $blank "where a panel's blank color comes from" $StoredBlank
  (ALT $DeriveBlank
    (INPUT panels "several solid rectangles stand apart on a field of &field; each panel's blank is its one most frequent color"
      (INIT &commonest_count Cardinality
        (key ((&panel2 (:Pn ^Pn_x) *P)
              (input P ^Col))
          (member ((:m P))
            (&panel2 (:Pn Pn_x) *P)
            (input P Col))))

      (INIT &commonest Order
        (key ((&commonest_count.size (:key (:Pn_x ^X) *Col)))
          (member ((:t Col))
            (&commonest_count.size (:key (:Pn_x X) *Col)))
          (score ((:t Col) (:S N))
            (&commonest_count.size (:key (:Pn_x X) *Col) *N))))

      (INIT &top Singleton
        (key ((&commonest.maximal (:key ^X) (:t *Col)))
          (member ((:v Col))
            (&commonest.maximal (:t *Col)))))

      (RULE &blank2
        (&top.value (:key (:X *K)) (:v *Col)))

      (RULE &broken
        (&top.plural)))
    (RULE &live
      (&field2)
      (NOT (&broken))
      (NOT (&broken_at)))
    (ALT $ColorBox
      (INPUT tile "the motif tile is the bounding box of a panel's cells of one mark color, the color of the first mark met in each scan order of &scan; scan orders that give different boxes give no tile; the tile's height divides the panel's height, and its width divides the panel's width"
        (RULE &broken
          (OR ((&top.plural))
              ((&color_box.plural)))))
      (ALT $CornerBox
        (INPUT tile "the motif tile runs from the panel corner nearest the marks' bounding box to that box's far edges; a marks' box equally far from two opposite sides of the panel gives no tile; the tile's height divides the panel's height, and its width divides the panel's width"
          (RULE &broken
            (OR ((&top.plural))
                ((&color_box.plural))
                ((&gap *K (:K2 K))))))))
    (ALT $CornerBox
      (INPUT tile "the motif tile runs from the panel corner nearest the marks' bounding box to that box's far edges; a marks' box equally far from two opposite sides of the panel gives no tile; the tile's height divides the panel's height, and its width divides the panel's width"
        (RULE &broken
          (OR ((&top.plural))
              ((&gap *K (:K2 K)))))))))

(ALTS $marks "which marks the tile bounds" $AllMarks
  (ALT $ColorBox
    (INPUT tile "the motif tile is the bounding box of a panel's cells of one mark color, the color of the first mark met in each scan order of &scan; scan orders that give different boxes give no tile; the tile's height divides the panel's height, and its width divides the panel's width"
      ;; The scan orders that find a panel's first mark: from corner d, along axis a first. The pairs leave all eight open.
      (DET &scan DiagDirAxisDomain)

      (RULE &scan2
        (&box.box (:key (:X *K)))
        (&scan *D *A))

      (INIT &scan_order Order
        (key ((&scan2 ^K ^D ^A))
          (member ((:t P))
            (&mark K *P))
          (before ((:a P) (:b P2))
            (&mark K *P)
            (&mark K (:P *P2))
            (OR ((corner_dir (:C D) A (:D *D2))
                 (dir_elem (:D D2))
                 (margin (:B P) (:D D2) (:K *K1_m1))
                 (margin (:B P2) (:D D2) (:K *K2_m2))
                 (< K1_m1 K2_m2))
                ((corner_dir (:C D) A (:D D2))
                 (perp A (:A2 *A2_m3))
                 (corner_dir (:C D) (:A A2_m3) (:D *D22))
                 (margin (:B P) (:D D2) (:K *K_m4))
                 (margin (:B P2) (:D D2) (:K K_m4))
                 (dir_elem (:D D22))
                 (margin (:B P) (:D D22) (:K *K1_m5))
                 (margin (:B P2) (:D D22) (:K *K2_m6))
                 (< K1_m5 K2_m6))))))

      ;; The box of the cells of the first mark's color, in each scan order.
      (INIT &first_color BoundingBox
        (key ((&scan_order.minimal (:key ^K ^D ^A) (:t *P))
              (&color K P *Col)
              (&mark K (:P *Q))
              (&color K (:P Q) Col))
          (cell ((:P Q))
            (&scan_order.minimal (:t *P))
            (&color K P *Col)
            (&mark K (:P *Q))
            (&color K (:P Q) Col))))

      (INIT &color_box Singleton
        (key ((&first_color.box (:key (:K ^X)) *B))
          (member ((:v B))
            (&first_color.box (:key (:K X)) *B))))

      (RULE &marks_box
        (&color_box.value (:key (:X *Pn)) (:v *B)))

      (RULE &broken
        (&color_box.plural)))
    (RULE &live
      (&field2)
      (NOT (&broken))
      (NOT (&broken_at)))
    (ALT $CornerBox
      (INPUT tile "the motif tile runs from the panel corner nearest the marks' bounding box to that box's far edges; a marks' box equally far from two opposite sides of the panel gives no tile; the tile's height divides the panel's height, and its width divides the panel's width"
        (RULE &broken
          (OR ((&color_box.plural))
              ((&gap *K (:K2 K)))))))))

(ALTS $tile "how far the tile reaches" $MarkBox
  (ALT $CornerBox
    (INPUT tile "the motif tile runs from the panel corner nearest the marks' bounding box to that box's far edges; a marks' box equally far from two opposite sides of the panel gives no tile; the tile's height divides the panel's height, and its width divides the panel's width"
      (RULE &gap
        (&marks_box *Pn *B)
        (&box.box (:key (:X Pn)) (:B *B_p))
        (relative (:Base B_p) (:X B) (:X_rel *B_rel))
        (opposite *D (:Opp *O_m1))
        (margin (:B B_rel) D *K)
        (margin (:B B_rel) (:D O_m1) (:K *K2)))

      (RULE &near
        (&gap *Pn *D *K *K2)
        (< K K2))

      (RULE &tile
        (&marks_box (:Pn *K) (:B *B_m))
        (&near (:Pn K) (:D *D1) (:K *K1))
        (&near (:Pn K) (:D *D2) (:K *K2))
        (corner_dir (:C *Diag_m1) (:A *A_m2) (:D D1))
        (perp (:A A_m2) (:A2 *A2_m3))
        (corner_dir (:C Diag_m1) (:A A2_m3) (:D D2))
        (edge_inset (:D D1) (:K K1) (:B *I_m4))
        (relative (:Base I_m4) (:X 0) (:X_rel *O1))
        (compose (:A B_m) (:B O1) (:C *B1))
        (edge_inset (:D D2) (:K K2) (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *O2))
        (compose (:A B1) (:B O2) (:C *B)))

      (RULE &broken
        (&gap *K (:K2 K))))
    (RULE &live
      (&field2)
      (NOT (&broken))
      (NOT (&broken_at)))))

(ALTS $anchor "where the lattice of copies is laid from" $TileLattice
  (ALT $CornerAnchor
    (OUTPUT tile-panel "each panel is filled with copies of its motif tile, laid from the corner of the panel's bounding box at &anchor and repeated along both axes; blank cells in the tile stay blank; the output holds each anchor's grid"
      (DET &corner_cell_inside1
        (&panel (:E *Pn_e) (:K *Pn_x) (:P *P_))
        (&box.box (:E Pn_e) (:key (:X Pn_x)) (:B *B_p_))
        (dir_elem (:D *D_m1))
        (relative (:Base B_p_) (:X P_) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (DET &corner_cell_corner_anchor1
        (diag_dir_elem (:D *D_))
        (&panel (:E *Pn_e) (:K *Pn_x) (:P *P_))
        (&box.box (:E Pn_e) (:key (:X Pn_x)) (:B *B_p_))
        (corner_dir (:C D_) (:D *D_m1))
        (margin (:B P_) (:D D_m1) (:K *K1_m2))
        (margin (:B B_p_) (:D D_m1) (:K *K2_m3))
        (!= K1_m2 K2_m3))

      (DET &corner_shown_inside1
        (&color *E (:K *X) (:P *Q_) *Col)
        (&tile E (:K X) (:B *B_))
        (dir_elem (:D *D_m1))
        (relative (:Base B_) (:X Q_) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (DET &corner_cell
        (&tile *E (:K *X))
        (&box.box E (:key X) (:B *B_p))
        (diag_dir_elem *D)
        (&panel E (:K X) *P)
        (NOT (&corner_cell_inside1 (:P_ P) (:B_p_ B_p)))
        (NOT (&corner_cell_corner_anchor1 (:D_ D) (:P_ P) (:B_p_ B_p))))

      (DET &corner_shown_corner_anchor1
        (&corner_cell *E *X (:D *D_) *P)
        (&color E (:K X) (:P *Q_) *Col)
        (&tile E (:K X) (:B *B_))
        (corner_dir (:C D_) (:D *D_m1))
        (margin (:B Q_) (:D D_m1) (:K *K1_m2))
        (margin (:B B_) (:D D_m1) (:K *K2_m3))
        (!= K1_m2 K2_m3))

      (RULE &corner_lay
        (&tile *K *B)
        (&box.box (:key (:X K)) (:B *B_p))
        (relative (:Base B_p) (:X B) (:X_rel *B_rel))
        (corner_dir (:C *D) (:A *A_m1) (:D *D1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (corner_dir (:C D) (:A A2_m2) (:D *D2))
        (margin (:B B_rel) (:D D1) (:K *K1))
        (dir8_opposite (:D D1) (:D2 *O_m3))
        (edge_inset (:D O_m3) (:K K1) (:B *B1_m4))
        (edge_inset (:D D1) (:K K1) (:B *I_m6))
        (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
        (compose (:A B1_m4) (:B B2_m5) (:C *V1))
        (margin (:B B_rel) (:D D2) (:K *K2))
        (dir8_opposite (:D D2) (:D2 *O_m7))
        (edge_inset (:D O_m7) (:K K2) (:B *B1_m8))
        (edge_inset (:D D2) (:K K2) (:B *I_m10))
        (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
        (compose (:A B1_m8) (:B B2_m9) (:C *V2))
        (compose (:A V1) (:B V2) (:C *V))
        (compose (:A B) (:B V) (:C *B_laid)))

      (DET &corner_shown
        (&corner_cell *E *X *D *P)
        (&tile E (:K X) *B)
        (&color E (:K X) (:P *Q) *Col)
        (NOT (&corner_shown_inside1 (:Q_ Q) (:B_ B)))
        (NOT (&corner_shown_corner_anchor1 (:D_ D) (:Q_ Q) (:B_ B)))
        (ex_output E P Col))

      (DET &anchor_missed
        (&corner_shown *D)
        (&corner_cell *E *X D)
        (ex_output E)
        (NOT (&corner_shown E X D)))

      (DET &anchor
        (&corner_shown *D)
        (NOT (&anchor_missed D))
        (ONE))

      (RULE &moved
        (&corner_lay *K *B *D *B_laid)
        (&anchor D)))
    (RULE &laid
      (&corner_lay (:K *Pn) *D *B_laid)
      (&anchor D))

    (RULE &copy
      (&moved *K *B *B_laid)
      (relative (:Base B) (:X B_laid) (:X_rel *V))
      (&color K *P)
      (relative (:Base V) (:X P) (:X_rel *Q_v))
      (corner_dir (:C *Diag_m1) *A (:D *D1))
      (perp A (:A2 *A2_m2))
      (corner_dir (:C Diag_m1) (:A A2_m2) (:D *D2))
      (perp A *A2)
      (opposite (:D D1) (:Opp *O1))
      (opposite (:D D2) (:Opp *O2))
      (relative (:Base B) (:X Q_v) (:X_rel *Q_rel))
      (margin (:B Q_rel) (:D O1) (:K *T1))
      (margin (:B Q_rel) (:D O2) (:K *T2))
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m3))
      (frame_extent (:P R_m3) A (:N *N1))
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m4))
      (frame_extent (:P R_m4) (:A A2) (:N *N2))
      (divide (:T T1) (:Side N1) (:Gap 0) (:Remainder *K1))
      (divide (:T T2) (:Side N2) (:Gap 0) (:Remainder *K2))
      (dir8_opposite (:D O1) (:D2 *O_m6))
      (edge_inset (:D O_m6) (:K T1) (:B *B1_m7))
      (edge_inset (:D O1) (:K T1) (:B *I_m9))
      (relative (:Base I_m9) (:X 0) (:X_rel *B2_m8))
      (compose (:A B1_m7) (:B B2_m8) (:C *V_m5))
      (compose (:A Q_v) (:B V_m5) (:C *P1))
      (dir8_opposite (:D D1) (:D2 *O_m11))
      (edge_inset (:D O_m11) (:K K1) (:B *B1_m12))
      (edge_inset (:D D1) (:K K1) (:B *I_m14))
      (relative (:Base I_m14) (:X 0) (:X_rel *B2_m13))
      (compose (:A B1_m12) (:B B2_m13) (:C *V_m10))
      (compose (:A P1) (:B V_m10) (:C *P2))
      (dir8_opposite (:D O2) (:D2 *O_m16))
      (edge_inset (:D O_m16) (:K T2) (:B *B1_m17))
      (edge_inset (:D O2) (:K T2) (:B *I_m19))
      (relative (:Base I_m19) (:X 0) (:X_rel *B2_m18))
      (compose (:A B1_m17) (:B B2_m18) (:C *V_m15))
      (compose (:A P2) (:B V_m15) (:C *P3))
      (dir8_opposite (:D D2) (:D2 *O_m21))
      (edge_inset (:D O_m21) (:K K2) (:B *B1_m22))
      (edge_inset (:D D2) (:K K2) (:B *I_m24))
      (relative (:Base I_m24) (:X 0) (:X_rel *B2_m23))
      (compose (:A B1_m22) (:B B2_m23) (:C *V_m20))
      (compose (:A P3) (:B V_m20) (:C *P4))
      (&color K (:P P4) *Col)
      (relative (:Base B) (:X P4) (:X_rel *R_m25))
      (axis_of (:D *D1_m26) (:A *A1_m27))
      (opposite (:D D1_m26) (:Opp *O1_m28))
      (perp (:A A1_m27) (:A2 *A2_m29))
      (axis_of (:D *D2_m30) (:A A2_m29))
      (opposite (:D D2_m30) (:Opp *O2_m31))
      (margin (:B R_m25) (:D D1_m26) (:K *K1_m32))
      (>= K1_m32 0)
      (margin (:B R_m25) (:D O1_m28) (:K *K2_m33))
      (>= K2_m33 0)
      (margin (:B R_m25) (:D D2_m30) (:K *K3_m34))
      (>= K3_m34 0)
      (margin (:B R_m25) (:D O2_m31) (:K *K4_m35))
      (>= K4_m35 0))

    (RULE &paint
      (&laid (:Pn *X) *B_laid)
      (&copy (:K X) B_laid *P *Col)
      (&fill (:Pn X) P))))

(ALTS $extent "which cells the copies fill" $PanelCells
  (ALT $ComponentBbox
    (OUTPUT tile-panel "the whole bounding box of each panel is filled with copies of its motif tile, field cells included, repeated along both axes on the grid of the tile's own position")
    (RULE &fill
      (&box.box (:key (:X *Pn)) *B)
      (input *P)
      (ALL ((&box.box (:key (:X *Pnm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(DET &pieces_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &pieces_node
  (ex_input (:E *Key) *P *Col)
  (NOT (&field (:C Col))))

;; The concept's panels in each example.
(INIT &pieces Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&pieces_node (:Key *Ky) *P)
         (&pieces_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&pieces_node (:Key Ky) (:P P2)))
        ((&pieces_node (:Key Ky) P)
         (= P2 P)))))

(DET &pieces_component
  (&pieces.class (:a *Key *P) *Id))

(DET &color_inside1
  (ex_input *E (:P *P_) *Col)
  (&box.box E (:key *X) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &lay
  (&tile *K *B))

(RULE &copy
  (&lay *K *B)
  (relative (:Base B) (:X B) (:X_rel *V))
  (&color K *P)
  (relative (:Base V) (:X P) (:X_rel *Q_v))
  (corner_dir (:C *Diag_m1) *A (:D *D1))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Diag_m1) (:A A2_m2) (:D *D2))
  (perp A *A2)
  (opposite (:D D1) (:Opp *O1))
  (opposite (:D D2) (:Opp *O2))
  (relative (:Base B) (:X Q_v) (:X_rel *Q_rel))
  (margin (:B Q_rel) (:D O1) (:K *T1))
  (margin (:B Q_rel) (:D O2) (:K *T2))
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m3))
  (frame_extent (:P R_m3) A (:N *N1))
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m4))
  (frame_extent (:P R_m4) (:A A2) (:N *N2))
  (divide (:T T1) (:Side N1) (:Gap 0) (:Remainder *K1))
  (divide (:T T2) (:Side N2) (:Gap 0) (:Remainder *K2))
  (dir8_opposite (:D O1) (:D2 *O_m6))
  (edge_inset (:D O_m6) (:K T1) (:B *B1_m7))
  (edge_inset (:D O1) (:K T1) (:B *I_m9))
  (relative (:Base I_m9) (:X 0) (:X_rel *B2_m8))
  (compose (:A B1_m7) (:B B2_m8) (:C *V_m5))
  (compose (:A Q_v) (:B V_m5) (:C *P1))
  (dir8_opposite (:D D1) (:D2 *O_m11))
  (edge_inset (:D O_m11) (:K K1) (:B *B1_m12))
  (edge_inset (:D D1) (:K K1) (:B *I_m14))
  (relative (:Base I_m14) (:X 0) (:X_rel *B2_m13))
  (compose (:A B1_m12) (:B B2_m13) (:C *V_m10))
  (compose (:A P1) (:B V_m10) (:C *P2))
  (dir8_opposite (:D O2) (:D2 *O_m16))
  (edge_inset (:D O_m16) (:K T2) (:B *B1_m17))
  (edge_inset (:D O2) (:K T2) (:B *I_m19))
  (relative (:Base I_m19) (:X 0) (:X_rel *B2_m18))
  (compose (:A B1_m17) (:B B2_m18) (:C *V_m15))
  (compose (:A P2) (:B V_m15) (:C *P3))
  (dir8_opposite (:D D2) (:D2 *O_m21))
  (edge_inset (:D O_m21) (:K K2) (:B *B1_m22))
  (edge_inset (:D D2) (:K K2) (:B *I_m24))
  (relative (:Base I_m24) (:X 0) (:X_rel *B2_m23))
  (compose (:A B1_m22) (:B B2_m23) (:C *V_m20))
  (compose (:A P3) (:B V_m20) (:C *P4))
  (&color K (:P P4) *Col)
  (relative (:Base B) (:X P4) (:X_rel *R_m25))
  (axis_of (:D *D1_m26) (:A *A1_m27))
  (opposite (:D D1_m26) (:Opp *O1_m28))
  (perp (:A A1_m27) (:A2 *A2_m29))
  (axis_of (:D *D2_m30) (:A A2_m29))
  (opposite (:D D2_m30) (:Opp *O2_m31))
  (margin (:B R_m25) (:D D1_m26) (:K *K1_m32))
  (>= K1_m32 0)
  (margin (:B R_m25) (:D O1_m28) (:K *K2_m33))
  (>= K2_m33 0)
  (margin (:B R_m25) (:D D2_m30) (:K *K3_m34))
  (>= K3_m34 0)
  (margin (:B R_m25) (:D O2_m31) (:K *K4_m35))
  (>= K4_m35 0))

(RULE &fill
  (&panel2 *Pn *P))

(RULE &laid
  (&tile (:K *Pn) (:B *B_laid)))

(RULE &paint
  (&laid (:Pn *X) *B_laid)
  (&copy (:K X) (:B B_laid) *P *Col)
  (&fill (:Pn X) P))

(RULE &broken_at
  (&paint *P *Col)
  (&paint P (:Col *Col2))
  (!= Col Col2))

(RULE &live
  (&field2)
  (NOT (&broken_at)))

(RULE &output
  (OR ((&live)
       (&paint *P *Col))
      ((&live)
       (input P Col)
       (NOT (&paint P)))))
