;; 1990f7a8

(DET &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(DET &obj_node
  (ex_input (:E *Key) *P *Col)
  (NOT (&bg (:C Col))))

(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(DET &obj_component
  (&obj.class (:a *Key *P) *Id))

(RULE &obj_steps2
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

;; The shapes, each with its own bounding box.
(INIT &obj2 Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&obj_steps2 (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &obj_component2
  (&obj2.class (:a *P) *Id))

(INIT &bbox2 BoundingBox
  (key ((&obj_component2 *P ^Id))
    (cell (P)
      (&obj_component2 *P Id))))

(RULE &quad_cell
  (&bbox2.box (:key (:Id *Key)) (:B *P)))

(INIT &bbox BoundingBox
  (key ((&obj_component (:Key ^E) *P ^Id))
    (cell (P)
      (&obj_component (:Key E) *P Id))))

(DET &block_dim
  (&bbox.box (:key (:E *Ky_e) (:Id *Ky_id)) *B)
  (&bbox.cell (:key (:E Ky_e) (:Id Ky_id)) *P)
  (axis_elem *A)
  (perp A *A2)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K))
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N K)))

(DET &frame Frame)

(DET &gap NumberDomain)

(RULE &block_division_gap
  (axis_elem *A)
  (&gap (:N *G)))

(RULE &block_division_axis_split1
  (&frame (:P *P_grid_out_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_out_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_out_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_out_) (:X_rel *X_m1_)))

(RULE &block_division_side
  (axis_elem *A)
  (&block_dim *K))

(RULE &block_division_axis
  (OR ((&frame *P)
       (axis_elem *A)
       (&block_dim *K)
       (&gap (:N *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&frame P)
       (axis_elem A)
       (&block_dim (:K *K2))
       (NOT (&block_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((&frame P)
       (axis_elem A)
       (NOT (&block_division_side A))
       (&block_division_axis_split1 (:P_grid_out_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &block_division_tile
  (&block_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&block_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &block
  (&block_division_tile (:P *P_grid_out) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $choice "which corner a shape claims" $Grid
  (ALT $Span
    (RULE &obj_node2
      (input *P *Col)
      (NOT (&bg (:C Col))))

    ;; The four boxes' joint span, and each box's margins inside it.
    (INIT &span BoundingBox
      (cell (P)
        (&obj_node2 *P)))

    (RULE &quad_cell
      (&bbox2.box (:key (:Id *Key)) *B)
      (&span.box (:B *B_span))
      (relative (:Base B_span) (:X B) (:X_rel *P)))))

(RULE &quad_nearer
  (&quad_cell *Key *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &quad_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&quad_nearer *Key *P (:D D1))
  (&quad_nearer Key P (:D D2)))

(RULE &paint
  (&obj_component2 (:P *P_grid_in) *Id)
  (input (:P P_grid_in) *Col)
  (&bbox2.box (:key Id) *B)
  (ALL ((&obj_component2 (:P P_grid_in) (:Id *Idm))
        (&bbox2.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))
  (&quad_quadrant (:Key Id) *Diag)
  (&block (:P_grid_out *P) *P_tile P_intile)
  (corner_dist (:P P_tile) Diag (:K 0)))

(RULE &output
  (OR ((&paint *P *Col))
      ((&frame P)
       (NOT (&paint P))
       (&bg (:C Col)))))
