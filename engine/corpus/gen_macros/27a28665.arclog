;; 27a28665

(DET &bg RarestColor)

(DET &out_pos Frame)

(RULE &silhouette
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Examples with the same silhouette share an entry.
(INIT &same Inclusion
  (pattern ((:pattern E) (:m P))
    (&silhouette *E *P))
  (observed ((:observed E) (:m P))
    (&silhouette *E *P)))

(INIT &entry Quotient
  (equivalent ((:a E) (:b E2))
    (&same.equal (:observed *E) (:pattern *E2))))

(DET &pattern_member
  (&entry.class (:a *E) *Id)
  (&silhouette E *P))

(INIT &lookup_match Inclusion
  (pattern ((:pattern Id) (:m P))
    (&pattern_member *Id *P))
  (observed ((:m P))
    (&silhouette *P)))

(DET &pattern_out
  (&entry.class (:a *E) *Id)
  (ex_output E (:Col *C)))

(ALTS $choice "what of the silhouette gives the color" $Lookup
  (ALT $Classify
    (DET &center_pos_centered1
      (ex_input (:P *P_))
      (opposite (:D *D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (!= K1_m3 K2_m4))

    (DET &in_dim ConstInDim)

    (INIT &corner_pos_frame Frame
      (key ((&in_dim ^N))
        (extent (A N)
          (axis_elem *A))))

    (DET &corner_pos
      (&corner_pos_frame.cell (:key *N) *P)
      (diag_dir_elem *D)
      (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin (:B P) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (DET &center_pos
      (ex_input *P)
      (NOT (&center_pos_centered1 (:P_ P))))

    (RULE &center_on
      (&center_pos *P)
      (&silhouette P))

    (INIT &corners Cardinality
      (member ((:m P))
        (&corner_pos *P)
        (&silhouette P))
      (domain ()
        (input)))

    (DET &center_off_out
      (ex_output *E (:Col *C))
      (NOT (&center_on E)))

    (DET &center_on_out
      (ex_output *E (:Col *C))
      (&center_on E)
      (&corners.size E *N))

    (RULE &output
      (OR ((NOT (&center_on))
           (&center_off_out (:C *Col))
           (&out_pos *P))
          ((&center_on)
           (&corners.size *N)
           (&center_on_out N (:C Col))
           (&out_pos P))))))

(RULE &output
  (&pattern_out *Id (:C *Col))
  (&lookup_match.equal (:pattern Id))
  (&out_pos *P))
