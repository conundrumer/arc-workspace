;; 1fad071e

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &block_color ColorDomain)

(RULE &on
  (input *P *Col)
  (&block_color (:C Col)))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((&on *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&on (:P P3)))
        ((&on P)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(DET &block_shape Frame)

(DET &bg DominantColor)

(DET &out_pos Frame)

(INIT &bbox BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

;; Each component's cells in its bbox frame, against the block shape.
(INIT &same Inclusion
  (pattern ((:m P))
    (&block_shape *P))
  (observed ((:observed O) (:m P_inner))
    (&bbox.cell (:key (:Id *O)) *P)
    (&bbox.box (:key (:Id O)) *B)
    (ALL ((&bbox.cell (:key (:Id *Om)) P)
          (&bbox.box (:key (:Id Om)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(INIT &blocks Cardinality
  (member ((:m Id))
    (&same.equal (:observed *Id)))
  (domain ()
    (input)))

(RULE &total
  (&blocks.size *N))

(DET &bar
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col))))

(DET &mark
  (&bar (:Col *C)))

(RULE &bar_mark
  (&mark (:C *Col)))

(INIT &bar_len Cardinality
  (key ((&bar ^E *P))
    (member ((:m P))
      (&bar E *P))))

(DET &mismatch_edge
  (dir_elem *D)
  (&bar_len.size (:key *E) *N)
  (ex_output E *P)
  (margin (:B P) D *K)
  (< K N)
  (NOT (&bar E P)))

(DET &bar_edge
  (dir_elem *D)
  (NOT (&mismatch_edge D)))

(ALTS $detect "how the block shape's occurrences are found" $Object
  (ALT $Placement
    (INIT &occ Occurrences
      (cell (P)
        (&on *P))
      (shape (P)
        (&block_shape *P)))

    (INIT &placements Cardinality
      (member ((:m P))
        (&occ.occurrence *P)))

    (RULE &total
      (&placements.size *N))))

(ALTS $mark "the bar's color" $Fixed
  (ALT $Counted
    (RULE &bar_mark
      (&block_color (:C *Col)))))

(RULE &marked
  (&out_pos *P)
  (&bar_edge *D)
  (margin (:B P) D *K)
  (&total *N)
  (< K N))

(RULE &output
  (OR ((&marked *P)
       (&bar_mark *Col))
      ((&out_pos P)
       (&total)
       (NOT (&marked P))
       (&bar_mark)
       (&bg (:C Col)))))
