;; ba26e723

(DET &anchor DirDomain)

(DET &period ConstInDim)

(DET &phase NumberDomain)

(DET &mapping ChangedPairs)

(RULE &on_stride
  (input *P)
  (&anchor *D)
  (&period (:N *W))
  (&phase (:N *K))
  (margin (:B P) D (:K *T))
  (divide T (:Side W) (:Gap 0) (:Remainder K)))

(RULE &recolored
  (input *P *Col)
  (&mapping (:C_from Col))
  (&on_stride P))

(RULE &output
  (OR ((input *P (:Col *Col_in))
       (&mapping (:C_from Col_in) (:C_to *Col))
       (&on_stride P))
      ((input P Col)
       (NOT (&recolored P)))))
