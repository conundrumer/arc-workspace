;; 6d1d5c90

(DET &shift_dir DirDomain)

(RULE &row_origin
  (&shift_dir (:D *SD))
  (opposite (:D SD) (:Opp *D)))

(RULE &row_idx
  (input *P)
  (&row_origin (:D *FE))
  (margin (:B P) (:D FE) *K))

;; Rows placed back on the shift axis by index.
(INIT &rows_size Cardinality
  (member ((:m K))
    (&row_idx *K)))

(INIT &rows_frame Frame
  (extent (A N)
    (&row_origin (:D *FE))
    (axis_of (:D FE) *A)
    (&rows_size.size *N)))

(RULE &rows_pos
  (&rows_frame.cell *P)
  (&row_origin (:D *FE))
  (margin (:B P) (:D FE) *K)
  (&row_idx K))

(DET &band_width DimDiff)

(DET &marker_edge DirDomain)

(RULE &out_split1
  (&marker_edge (:D *ME))
  (&band_width (:D *K))
  (edge_inset (:D ME) K *B)
  (input (:P *P_in) *Col)
  (relative (:Base B) (:X P_in) (:X_rel *P_kept_))
  (axis_of (:D ME) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_kept_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_kept_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_col_))
  (relative (:Base P_col_) (:X P_kept_) (:X_rel *X_m1_)))

(DET &marker_color RarestColor)

(RULE &marker
  (input *P *Col)
  (&marker_edge *D)
  (margin (:B P) D (:K 0))
  (&marker_color (:C Col)))

(INIT &row_cycle Order
  (member ((:t K))
    (&row_idx *K))
  (score ((:t K) (:S K))
    (&row_idx *K)))

(ALTS $choice "Two models for which cell is the marker, tagged on out's Choice" $Marked
  (ALT $Singleton
    (DET &marker_count DimDiff)

    (RULE &band_cell
      (input *P *Col)
      (&marker_edge *D)
      (margin (:B P) D (:K 0)))

    (INIT &band_count Cardinality
      (key ((&band_cell *P ^Col))
        (member ((:m P))
          (&band_cell *P Col))))

    (RULE &marker
      (&band_cell *P *Col)
      (&marker_count (:D *N))
      (&band_count.size (:key Col) N))))

(RULE &shift_amt
  (&marker *P)
  (&row_origin (:D *FE))
  (margin (:B P) (:D FE) (:K *M)))

(INIT &rot Walk
  (successor ((:p K) (:p_next K2))
    (&row_cycle.cyclic_successor (:a *K) (:b *K2)))
  (steps ((:N M))
    (&shift_amt *M)))

(RULE &output
  (input (:P *P_in) *Col)
  (&marker_edge (:D *ME))
  (&band_width (:D *K))
  (edge_inset (:D ME) K *B)
  (ALL ((input (:P P_in) (:Col *Colm))
        (&marker_edge (:D *MEm))
        (&band_width (:D *Km))
        (edge_inset (:D MEm) (:K Km) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_in) (:X_rel *P_kept))
  (&row_origin (:D *FE))
  (margin (:B P_in) (:D FE) (:K *K_in))
  (&shift_amt *M)
  (&rot.walk (:p0 K_in) (:N M) (:p *K_out))
  (&rows_pos (:K K_out) (:P *P_v_out))
  (axis_of (:D ME) *A)
  (&out_split1 (:P_kept_ P_kept) (:A_ A) (:P_col_ *P_col) (:X_m1_ *X_m1))
  (compose (:A P_v_out) (:B P_col) (:C *P)))
