;; b71a7747

(INPUT lattice "a background crossed by evenly spaced full rows and full columns of a line color")

(INPUT tiles "equal solid squares of a tile color, one centered on each line crossing where the whole square fits in the frame, so they form a full rectangular array with a gap of at least one cell between neighbors on each axis")

(INPUT path "a path of a path color is drawn inside the tiles, and only there; it runs across tile edges, so it is one 4-connected line once the gaps are closed")

(INPUT noise "some inputs also hold scattered cells of a noise color, only outside the tiles")

(OUTPUT pack-tiles "the output is the tiles laid edge to edge, in their row and column order, with everything outside the tiles dropped: the input with each row and each column that holds no tile cell removed"

  (RULE &color
    (input *Col))

  (RULE &pair_parts_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The parts of each pair of colors: the components of the cells of either.
  (INIT &pair_parts Quotient
    (edge ((:a C1 C2 P) (:b C1 C2 (:P P3)))
      (OR ((&color (:Col *C1))
           (&color (:Col *C2))
           (!= C1 C2)
           (OR ((input *P (:Col C1)))
               ((input P (:Col C2))))
           (&pair_parts_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (OR ((input (:P P3) (:Col C1)))
               ((input (:P P3) (:Col C2)))))
          ((&color (:Col C1))
           (&color (:Col C2))
           (!= C1 C2)
           (OR ((input P (:Col C1)))
               ((input P (:Col C2))))
           (= P3 P)))))

  (RULE &pair_parts_component
    (&pair_parts.class (:a *C1 *C2 *P) *Id))

  (INIT &part_box BoundingBox
    (key ((&pair_parts_component (:C1 ^K_c1) (:C2 ^K_c2) *P ^Id))
      (cell (P)
        (&pair_parts_component (:C1 K_c1) (:C2 K_c2) *P Id))))

  (RULE &part_extent
    (&part_box.box (:key (:K_c1 *C1) (:K_c2 *C2) *Id) *B)
    (&pair_parts_component C1 C2 *P Id)
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N))

  (RULE &unsquare
    (OR ((&part_box.box (:key (:K_c1 *C1) (:K_c2 *C2) *Id) *B)
         (input *P)
         (ALL ((&part_box.box (:key (:K_c1 *Km_c1) (:K_c2 *Km_c2) (:Id *Idm)) B)
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (NOT (&pair_parts_component C1 C2 P Id)))
        ((&part_extent C1 C2 (:N *N1))
         (&part_extent C1 C2 (:N *N2))
         (!= N1 N2))))

  (RULE &tile_pair
    (&pair_parts_component *C1 *C2)
    (NOT (&unsquare C1 C2)))

  (RULE &tile_color
    (&tile_pair (:C1 *Col)))

  (RULE &tile_cell
    (input *P *Col)
    (&tile_color Col))

  (RULE &kept_split1
    (&tile_cell (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &kept
    (&tile_cell *P)
    (axis_elem *A)
    (&kept_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  ;; The kept lines of each axis, closed up in order.
  (INIT &layout Order
    (key ((&kept ^A)
          (axis_of ^D A))
      (member ((:t L))
        (&kept A *L))
      (before ((:a L) (:b L2))
        (&kept A *L)
        (&kept A (:L *L2))
        (!= L L2)
        (margin (:B L) D (:K *K1))
        (margin (:B L2) D (:K *K2))
        (< K1 K2))))

  (RULE &holds_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &tile_box
    (&tile_pair (:C1 *K_c1) (:C2 *K_c2))
    (&part_box.box (:key K_c1 K_c2) *B))

  (RULE &tile_center
    (&tile_box *B)
    (input *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (ALL ((&tile_box (:B *Bm))
          (input (:P *Pm))
          (relative (:Base Bm) (:X Pm) (:X_rel P_rel))
          (opposite (:D *D_m1m) (:Opp *O_m2))
          (margin (:B P_rel) (:D D_m1m) (:K *K1_m3))
          (margin (:B P_rel) (:D O_m2) (:K *K2_m4)))
         ((= K1_m3 K2_m4))))

  (RULE &crossed_split1
    (&tile_center (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (INIT &tile_fill_count Cardinality
    (key ((&tile_color ^Col))
      (member ((:m P))
        (input *P Col))))

  ;; The tile color is the commoner of the pair.
  (INIT &tile_fill Order
    (member ((:t Col))
      (&tile_fill_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&tile_fill_count.size (:key *Col) *N)))

  (RULE &holds
    (input *P *Col)
    (axis_elem *A)
    (&holds_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (RULE &crossed
    (&tile_center *P)
    (axis_elem *A)
    (&crossed_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (&holds A L *Col))

  (RULE &field
    (&color *Col)
    (NOT (&tile_color Col))
    (NOT (&crossed Col)))

  (RULE &fielded
    (&holds *A *L *Col)
    (&field Col))

  (RULE &line
    (&holds *A *L)
    (NOT (&fielded A L))))

(ALTS $choice "where the kept rows and columns are read from" $FromTiles
  (ALT $FromTiles
    (ALTS $k "how the tiles give the output" $TileRows
      (ALT $TileRows
        (ALTS $c "which colors make tile cells" $BothColors
          (ALT $TileColorOnly
            (OUTPUT pack-tiles "only the tile color makes tile cells, and path cells do not"
              (RULE &tile_cell
                (input *P *Col)
                (&tile_fill.maximal (:t Col)))))))
      (ALT $LatticeBands
        (OUTPUT pack-tiles "keep each row and column within the tiles' half-side of a line crossing where the whole square fits in the frame, whatever those cells hold; undefined where the tiles are not equal squares"
          (RULE &kept_split2
            (input (:P *P_))
            (axis_elem (:A *A_))
            (axis_of (:D *D_m1) (:A A_))
            (opposite (:D D_m1) (:Opp *O_m2))
            (margin (:B P_) (:D D_m1) (:K *K1_m3))
            (margin (:B P_) (:D O_m2) (:K *K2_m4))
            (opposite (:D D_m1) (:Opp *O_m1))
            (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
            (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C *L_))
            (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))
          (RULE &band_square_split1
            (input (:P *P_))
            (&line (:A *A_) (:L *L_))
            (axis_of (:D *D_m1) (:A A_))
            (opposite (:D D_m1) (:Opp *O_m2))
            (margin (:B P_) (:D D_m1) (:K *K1_m3))
            (margin (:B P_) (:D O_m2) (:K *K2_m4))
            (opposite (:D D_m1) (:Opp *O_m1))
            (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
            (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
            (compose (:A B1_m2) (:B B2_m3) (:C L_))
            (relative (:Base L_) (:X P_) (:X_rel *L2_)))
          (RULE &band_square
            (&line *A *L)
            (perp A *A2)
            (&line (:A A2) (:L *L2))
            (input *P)
            (&band_square_split1 (:P_ P) (:A_ A) (:L_ L) (:L2_ L2))
            (&tile_box (:B *B3))
            (&tile_center (:P *C))
            (ALL ((dir_elem (:D *D_m1))
                  (relative (:Base B3) (:X C) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0)))
            (relative (:Base C) (:X P) (:X_rel *V))
            (compose (:A B3) (:B V) (:C *B))
            (relative (:Base 0) (:X B) (:X_rel *R_m1))
            (axis_of (:D *D1_m2) (:A *A1_m3))
            (opposite (:D D1_m2) (:Opp *O1_m4))
            (perp (:A A1_m3) (:A2 *A2_m5))
            (axis_of (:D *D2_m6) (:A A2_m5))
            (opposite (:D D2_m6) (:Opp *O2_m7))
            (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
            (>= K1_m8 0)
            (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
            (>= K2_m9 0)
            (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
            (>= K3_m10 0)
            (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
            (>= K4_m11 0))
          (RULE &kept
            (&band_square *B)
            (input *P)
            (ALL ((dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0)))
            (axis_elem *A)
            (&kept_split2 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))))))
  (ALT $LineBreaks
    (OUTPUT pack-tiles "a kept column is a column where a line row holds a cell that is not the line color, and a kept row is the same on the line columns; undefined where no line is interrupted"
      (RULE &kept_split3
        (input (:P *P_) *Col)
        (&line (:A *A_) (:L *L_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C L_))
        (relative (:Base L_) (:X P_) (:X_rel *L2_)))

      (RULE &line_color
        (&color *Col)
        (NOT (&tile_color Col))
        (ALL ((&line *A *L))
             ((&holds A L Col))))

      ;; A line's cell of another color keeps its place across the line.
      (RULE &kept
        (&line (:A *A3) (:L *L3))
        (input *P *Col)
        (&kept_split3 (:P_ P) (:A_ A3) (:L_ L3) (:L2_ *L))
        (NOT (&line_color Col))
        (perp (:A A3) (:A2 *A))))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) *A *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) A D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &out_split1
  (input (:P *P_in_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_in_) (:X_rel *L2_)))

(RULE &output
  (input (:P *P_in) *Col)
  (axis_elem *A)
  (perp A *A2)
  (&out_split1 (:P_in_ P_in) (:A_ A) (:L_ *L) (:L2_ *L2))
  (&layout_pos (:Key A) (:M L) *P_pos)
  (&layout_pos (:Key A2) (:M L2) (:P_pos *P_pos2))
  (compose (:A P_pos) (:B P_pos2) (:C *P)))
