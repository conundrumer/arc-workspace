;; 995c5fa3

(INPUT tiles "the input is &tile_count equal tiles side by side along &tile_axis, separated by lines &tile_gap wide"

  (DET &tile_axis AxisDomain)

  ;; The output square's side, and the divisor of the Count split.
  (DET &tile_count ConstOutDim)

  (DET_OR_RULE &tile_gap SepThickness))

(INPUT catalog "each tile is one of the catalog's patterns"

  (INIT &tile_cell_division_sides ExtentDivisions
    (frame (P)
      (input *P)))

  (RULE &tile_cell_division_gap
    (&tile_axis *A)
    (&tile_gap *G))

  (RULE &tile_cell_division_axis_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
    (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

  (RULE &tile_cell_division_parts
    (&tile_axis *A)
    (&tile_count *N))

  (RULE &tile_cell_division_axis
    (OR ((input *P)
         (&tile_axis *A)
         (&tile_count *N)
         (&tile_gap *G)
         (&tile_cell_division_sides.division A N *K G)
         (axis_of *D A)
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T))
         (margin (:B P) (:D O) (:K *T2))
         (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
         (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
         (frame_extent (:P P_inner) A (:N K)))
        ((input P)
         (&tile_axis A)
         (&tile_count (:N *N2))
         (&tile_gap (:G *G2))
         (frame_extent P A (:N *K2))
         (axis_of (:D *D2) A)
         (opposite (:D D2) (:Opp *O2))
         (margin (:B P) (:D D2) (:K *T3))
         (margin (:B P) (:D O2) (:K *T22))
         (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
         (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
         (opposite (:D D2) (:Opp *O_m12))
         (edge_inset (:D D2) (:K I3) (:B *B1_m22))
         (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
         (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
         (opposite (:D D2) (:Opp *O_m42))
         (edge_inset (:D D2) (:K R3) (:B *B1_m52))
         (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
         (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
         (frame_extent (:P P_inner) A (:N K2))
         (frame_extent (:P P_outer) A (:N N2)))
        ((input P)
         (&tile_axis A)
         (&tile_count (:N *N3))
         (NOT (&tile_cell_division_gap A))
         (&tile_cell_division_sides.division A (:N N3) (:K *K3) (:G 0))
         (axis_of (:D *D3) A)
         (opposite (:D D3) (:Opp *O3))
         (margin (:B P) (:D D3) (:K *T4))
         (margin (:B P) (:D O3) (:K *T23))
         (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
         (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
         (opposite (:D D3) (:Opp *O_m13))
         (edge_inset (:D D3) (:K I4) (:B *B1_m23))
         (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
         (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
         (opposite (:D D3) (:Opp *O_m43))
         (edge_inset (:D D3) (:K R4) (:B *B1_m53))
         (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
         (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
         (frame_extent (:P P_inner) A (:N K3)))
        ((input P)
         (&tile_axis A)
         (&tile_count (:N *N4))
         (NOT (&tile_cell_division_gap A))
         (frame_extent P A (:N *K4))
         (axis_of (:D *D4) A)
         (opposite (:D D4) (:Opp *O4))
         (margin (:B P) (:D D4) (:K *T5))
         (margin (:B P) (:D O4) (:K *T24))
         (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
         (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
         (opposite (:D D4) (:Opp *O_m14))
         (edge_inset (:D D4) (:K I5) (:B *B1_m24))
         (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
         (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
         (opposite (:D D4) (:Opp *O_m44))
         (edge_inset (:D D4) (:K R5) (:B *B1_m54))
         (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
         (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
         (frame_extent (:P P_inner) A (:N K4))
         (frame_extent (:P P_outer) A (:N N4)))
        ((input P)
         (axis_elem A)
         (NOT (&tile_cell_division_parts A))
         (&tile_cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

  (RULE &tile_cell_division_tile
    (&tile_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&tile_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (DET_OR_RULE &bg RarestColor)

  (RULE &tile_cell
    (input *P *Col)
    (&tile_cell_division_tile P (:P_outer *P_tile) (:P_inner *P_intile)))

  (DET &ftile
    (&tile_cell *E *P_tile *P_intile *Col))

  ;; Tiles with equal content share an entry.
  (INIT &same Inclusion
    (pattern ((:pattern (:E T_e) (:P_tile T_p_tile)) (:m (:P P_intile) (:Col C)))
      (&ftile (:E *T_e) (:P_tile *T_p_tile) *P_intile (:Col *C)))
    (observed ((:observed (:E T_e) (:P_tile T_p_tile)) (:m (:P P_intile) (:Col C)))
      (&ftile (:E *T_e) (:P_tile *T_p_tile) *P_intile (:Col *C))))

  (INIT &entry Quotient
    (equivalent ((:a (:E T_e) (:P_tile T_p_tile)) (:b (:E T2_e) (:P_tile T2_p_tile)))
      (&same.equal (:observed (:E *T_e) (:P_tile *T_p_tile)) (:pattern (:E *T2_e) (:P_tile *T2_p_tile)))))

  (DET &mapping_member
    (&entry.class (:a (:E *T_e) (:P_tile *T_p_tile)) *Id)
    (&ftile (:E T_e) (:P_tile T_p_tile) *P_intile (:Col *C)))

  (INIT &tile_match Inclusion
    (pattern ((:pattern Id) (:m (:P P_intile) (:Col C)))
      (&mapping_member *Id *P_intile *C))
    (observed ((:observed P_tile) (:m (:P P_intile) (:Col C)))
      (&tile_cell *P_tile *P_intile (:Col *C))))

  (INIT &hole_box BoundingBox
    (key ((&tile_cell ^P_tile *P_intile (:Col *C))
          (&bg C))
      (cell ((:P P_intile))
        (&tile_cell P_tile *P_intile (:Col *C))
        (&bg C)))))

(OUTPUT class-color "a tile's class color is the color its catalog pattern maps to")

(OUTPUT rows "the output is a &tile_count-sided square; the row at a tile's index fills with that tile's class color, the tile counted from &tile_dir and the row from &row_dir"

  ;; Tile index (from tile_dir) maps to output row index (from row_dir).
  (DET &tile_dir DirDomain)

  (DET &row_dir DirDomain)

  ;; Output frame: tile_count-sided square.
  (INIT &frame Frame
    (extent (A N)
      (axis_elem *A)
      (&tile_count *N)))

  (RULE_OR_DET &row_tile "Output cell ↔ the tile whose index matches its row index."
    (&frame.cell (:P *P_out))
    (&row_dir (:D *D_row))
    (margin (:B P_out) (:D D_row) *K)
    (&tile_cell *P_tile)
    (&tile_dir (:D *D_tile))
    (margin (:B P_tile) (:D D_tile) K))

  (DET &tile_color
    (&ftile *E *P_tile)
    (&tile_dir (:D *D_tile))
    (margin (:B P_tile) (:D D_tile) *K)
    (ex_output E (:P *P_out) *Col)
    (&row_dir (:D *D_row))
    (margin (:B P_out) (:D D_row) K)))

(ALTS $cl "how a tile's class color is read" $Lookup
  (ALT $HoleBox
    (INPUT catalog "each tile's &bg cells have a box that &box_color keys, or the tile has no &bg cell")
    (OUTPUT class-color "a tile's class color is &box_color at the box of its &bg cells, and &full_color where it has none; undefined where that box has no entry"
      (DET &full_color OutNewColor)

      ;; The box of a tile's bg cells keys its class color.
      (INIT &fhole BoundingBox
        (key ((&ftile ^E ^P_tile *P_intile (:Col *C))
              (&bg C))
          (cell ((:P P_intile))
            (&ftile E P_tile *P_intile (:Col *C))
            (&bg C))))

      (DET &box_color
        (&fhole.box (:key (:E *T_e) (:P_tile *T_p_tile)) *B)
        (&tile_color (:E T_e) (:P_tile T_p_tile) *Col)))
    (RULE &output
      (&row_tile (:P_out *P) *P_tile)
      (OR ((&hole_box.box (:key P_tile) *B)
           (&box_color B *Col))
          ((NOT (&hole_box.box (:key P_tile)))
           (&full_color (:C Col)))))))

(ALTS $d "how the input splits into tiles" $Count
  (ALT $Size
    (INPUT tiles "the input is equal tiles &tile_size wide side by side along &tile_axis, separated by lines &tile_gap wide; the tiles past the first &tile_count are not read"
      (DET &tile_size_division_cell
        (ex_input *P)
        (&tile_axis (:A *Key)))

      (INIT &tile_size_division_sides ExtentDivisions
        (key ((&tile_size_division_cell (:Key ^Ky) *P))
          (frame (P)
            (&tile_size_division_cell (:Key Ky) *P))))

      (DET &tile_size_division_gap_held
        (&tile_axis *A)
        (&tile_gap *G))

      (DET &tile_size_division_axis_split1
        (&tile_size_division_cell (:Key *Ky) (:P *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      (DET &tile_size_division_parts_held
        (&tile_axis *A)
        (&tile_count *N))

      (DET &tile_size_division_axis
        (OR ((&tile_size_division_cell *Key *P)
             (axis_elem *A)
             (OR ((!= A Key))
                 ((NOT (&tile_size_division_parts_held (:A Key)))))
             (&tile_size_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
            ((&tile_size_division_cell Key P)
             (&tile_axis (:A Key))
             (&tile_count *N)
             (&tile_gap *G)
             (&tile_size_division_sides.division (:key (:Ky Key)) (:A Key) N *K G)
             (axis_of *D (:A Key))
             (opposite D (:Opp *O))
             (margin (:B P) D (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
             (opposite D (:Opp *O_m1))
             (edge_inset D (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
             (opposite D (:Opp *O_m4))
             (edge_inset D (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
             (frame_extent (:P P_inner) (:A Key) (:N K))
             (= A Key))
            ((&tile_size_division_cell Key P)
             (&tile_axis (:A Key))
             (&tile_count (:N *N2))
             (&tile_gap (:G *G2))
             (frame_extent P (:A Key) (:N *K2))
             (axis_of (:D *D2) (:A Key))
             (opposite (:D D2) (:Opp *O2))
             (margin (:B P) (:D D2) (:K *T3))
             (margin (:B P) (:D O2) (:K *T22))
             (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
             (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
             (opposite (:D D2) (:Opp *O_m12))
             (edge_inset (:D D2) (:K I3) (:B *B1_m22))
             (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
             (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
             (opposite (:D D2) (:Opp *O_m42))
             (edge_inset (:D D2) (:K R3) (:B *B1_m52))
             (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
             (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
             (frame_extent (:P P_inner) (:A Key) (:N K2))
             (frame_extent (:P P_outer) (:A Key) (:N N2))
             (= A Key))
            ((&tile_size_division_cell Key P)
             (&tile_axis (:A Key))
             (&tile_count (:N *N3))
             (OR ((!= Key Key))
                 ((NOT (&tile_size_division_gap_held (:A Key)))))
             (&tile_size_division_sides.division (:key (:Ky Key)) (:A Key) (:N N3) (:K *K3) (:G 0))
             (axis_of (:D *D3) (:A Key))
             (opposite (:D D3) (:Opp *O3))
             (margin (:B P) (:D D3) (:K *T4))
             (margin (:B P) (:D O3) (:K *T23))
             (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
             (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
             (opposite (:D D3) (:Opp *O_m13))
             (edge_inset (:D D3) (:K I4) (:B *B1_m23))
             (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
             (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
             (opposite (:D D3) (:Opp *O_m43))
             (edge_inset (:D D3) (:K R4) (:B *B1_m53))
             (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
             (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
             (frame_extent (:P P_inner) (:A Key) (:N K3))
             (= A Key))
            ((&tile_size_division_cell Key P)
             (&tile_axis (:A Key))
             (&tile_count (:N *N4))
             (OR ((!= Key Key))
                 ((NOT (&tile_size_division_gap_held (:A Key)))))
             (frame_extent P (:A Key) (:N *K4))
             (axis_of (:D *D4) (:A Key))
             (opposite (:D D4) (:Opp *O4))
             (margin (:B P) (:D D4) (:K *T5))
             (margin (:B P) (:D O4) (:K *T24))
             (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
             (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
             (opposite (:D D4) (:Opp *O_m14))
             (edge_inset (:D D4) (:K I5) (:B *B1_m24))
             (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
             (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
             (opposite (:D D4) (:Opp *O_m44))
             (edge_inset (:D D4) (:K R5) (:B *B1_m54))
             (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
             (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
             (frame_extent (:P P_inner) (:A Key) (:N K4))
             (frame_extent (:P P_outer) (:A Key) (:N N4))
             (= A Key))))

      (DET &tile_size_division_tile
        (&tile_size_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&tile_size_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

      (RULE &tile_cell_division2_gap
        (&tile_axis *A)
        (&tile_gap *G))

      (RULE &tile_cell_division2_axis_split1
        (input (:P *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      (DET_OR_RULE &tile_size ConstInDim SepTileDim TileCount TileDim
        (&tile_size_division_tile (:Key *A) (:P_inner *P_intile))
        (frame_extent (:P P_intile) A (:N *K)))

      (RULE &tile_cell_division2_side
        (&tile_axis *A)
        (&tile_size *K))

      (RULE &tile_cell_division2_axis
        (OR ((input *P)
             (&tile_axis *A)
             (&tile_size (:K *S))
             (&tile_gap *G)
             (axis_of *D A)
             (opposite D (:Opp *O))
             (margin (:B P) D (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side S) (:Gap G) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side S) (:Gap G) (:Part *I2) (:Remainder *R2))
             (opposite D (:Opp *O_m1))
             (edge_inset D (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
             (opposite D (:Opp *O_m4))
             (edge_inset D (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
             (frame_extent (:P P_inner) A (:N S)))
            ((input P)
             (&tile_axis A)
             (&tile_size (:K *S2))
             (NOT (&tile_cell_division2_gap A))
             (axis_of (:D *D2) A)
             (opposite (:D D2) (:Opp *O2))
             (margin (:B P) (:D D2) (:K *T3))
             (margin (:B P) (:D O2) (:K *T22))
             (divide (:T T3) (:Side S2) (:Gap 0) (:Part *I3) (:Remainder *R3))
             (divide (:T T22) (:Side S2) (:Gap 0) (:Part *I22) (:Remainder *R22))
             (opposite (:D D2) (:Opp *O_m12))
             (edge_inset (:D D2) (:K I3) (:B *B1_m22))
             (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
             (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
             (opposite (:D D2) (:Opp *O_m42))
             (edge_inset (:D D2) (:K R3) (:B *B1_m52))
             (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
             (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
             (frame_extent (:P P_inner) A (:N S2)))
            ((input P)
             (axis_elem A)
             (NOT (&tile_cell_division2_side A))
             (&tile_cell_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

      (RULE &tile_cell_division2_tile
        (&tile_cell_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&tile_cell_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

      (RULE &tile_cell
        (input *P *Col)
        (&tile_cell_division2_tile P (:P_outer *P_tile) (:P_inner *P_intile))))))

(DET &mapping_out
  (&entry.class (:a (:E *T_e) (:P_tile *T_p_tile)) *Id)
  (&tile_color (:E T_e) (:P_tile T_p_tile) (:Col *C_out)))

(RULE &output
  (&row_tile (:P_out *P) *P_tile)
  (&mapping_out *Id (:C_out *Col))
  (&tile_match.equal (:observed P_tile) (:pattern Id)))
