;; cbded52d

(DET &base DominantColor)

(DET &arr SepTileCount)

(DET &gap DivisorRatio)

(INIT &tile_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_division_gap
  (axis_elem *A)
  (&gap (:K *G)))

(RULE &tile_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_parts
  (axis_elem *A)
  (&arr *N))

(RULE &tile_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&arr *N)
       (&gap (:K *G))
       (&tile_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&arr (:N *N2))
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (&arr (:N *N3))
       (NOT (&tile_division_gap A))
       (&tile_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (axis_elem A)
       (&arr (:N *N4))
       (NOT (&tile_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_division_parts A))
       (&tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile
  (&tile_division_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $d "the grid is 8×8, so its tile arrangement reads two ways" $Count
  (ALT $Size
    (DET &tile_dim SepTileDim)

    (RULE &tile_division2_gap
      (axis_elem *A)
      (&gap (:K *G)))

    (RULE &tile_division2_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &tile_division2_side
      (axis_elem *A)
      (&tile_dim (:D *K)))

    (RULE &tile_division2_axis
      (OR ((input *P)
           (axis_elem *A)
           (&tile_dim (:D *K))
           (&gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (&tile_dim (:D *K2))
           (NOT (&tile_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&tile_division2_side A))
           (&tile_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &tile_division2_tile
      (&tile_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile
      (&tile_division2_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $f "how a marked line fills" $Span
  (ALT $Line
    (RULE &fill
      (&tile *P_tile)
      (&mark *Col *P_intile (:P_tile *Q1))
      (&mark Col P_intile (:P_tile *Q2))
      (!= Q1 Q2)
      (axis_elem *A)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B Q1) (:D D_m2) (:K *K_m3))
      (margin (:B Q2) (:D D_m2) (:K K_m3))
      (perp A (:A2 *A2_m4))
      (axis_of (:D *D_m5) (:A A2_m4))
      (margin (:B Q1) (:D D_m5) (:K *K_m6))
      (margin (:B P_tile) (:D D_m5) (:K K_m6)))))

(RULE &mark
  (input (:P *P_grid) *Col)
  (NOT (&base (:C Col)))
  (&tile P_grid *P_tile *P_intile))

(RULE &btw_axis
  (&mark *Col *P_intile)
  (axis_elem *A))

(RULE &btw_dir
  (&btw_axis *Col *P_intile *A)
  (axis4_of *D A))

(RULE &btw_node
  (&btw_axis *Col *P_intile)
  (input *P))

(RULE &btw_source
  (&mark *Col *P_intile (:P_tile *P)))

(INIT &btw Distance
  (key ((&btw_source (:Col ^Ky_col) (:P_intile ^Ky_p_intile) (:P ^O))
        (&btw_dir (:Col Ky_col) (:P_intile Ky_p_intile) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&btw_source (:Col Ky_col) (:P_intile Ky_p_intile) (:P O))
           (&btw_dir (:Col Ky_col) (:P_intile Ky_p_intile) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&btw_node (:Col Ky_col) (:P_intile Ky_p_intile) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&btw_node (:Col Ky_col) (:P_intile Ky_p_intile) (:P Q)))
          ((&btw_source (:Col Ky_col) (:P_intile Ky_p_intile) (:P O))
           (&btw_dir (:Col Ky_col) (:P_intile Ky_p_intile) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&btw_node (:Col Ky_col) (:P_intile Ky_p_intile) (:P Q))
           (= A2 O))
          ((&btw_source (:Col Ky_col) (:P_intile Ky_p_intile) (:P O))
           (&btw_dir (:Col Ky_col) (:P_intile Ky_p_intile) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&btw_node (:Col Ky_col) (:P_intile Ky_p_intile) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&btw_node (:Col Ky_col) (:P_intile Ky_p_intile) (:P Q)))))
    (source ((:n O))
      (&btw_source (:Col Ky_col) (:P_intile Ky_p_intile) (:P O))
      (&btw_dir (:Col Ky_col) (:P_intile Ky_p_intile) D))))

(RULE &btw_ray
  (&btw.distance (:key (:Ky_col *Col) (:Ky_p_intile *P_intile) *D (:O *Origin)) (:n *P) *K))

(RULE &btw_between
  (&mark *Col *P_intile)
  (&tile (:P_tile *P))
  (&btw_axis Col P_intile *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&btw_ray Col P_intile P D)
  (&btw_ray Col P_intile P (:D O)))

(RULE &btw_end
  (&btw_ray *Col *P_intile *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&btw_ray Col P_intile (:P Q) D Origin)))

(RULE &fill
  (&btw_between *Col *P_intile (:P *P_tile)))

(RULE &filled
  (&fill *P_tile *Col *P_intile)
  (&tile *P_grid P_tile P_intile))

(RULE &output
  (OR ((&filled (:P_grid *P) *Col))
      ((input P Col)
       (NOT (&filled (:P_grid P))))))
