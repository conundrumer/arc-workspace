;; 1f0c79e5

(RULE &ray_cell
  (input *P))

(DET &bg DominantColor)

(RULE &block
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&block *P)))

;; The color that names a heading.
(DET &mark ChangedColor)

(RULE &marker
  (input *P *Col)
  (&mark (:C Col)))

(RULE &heading
  (&marker *P)
  (&block P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &ray_source
  (&block *P))

(RULE &trail
  (&block *P)
  (input P *Col)
  (NOT (&mark (:C Col))))

(ALTS $choice "where a mark sits in the block, named two ways; the block is 2x2 in every pair, so the two ways agree here and part only on a larger block" $Corner
  (ALT $Quadrant
    (RULE &block_inner
      (&block *P)
      (&bbox.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    (RULE &place_nearer
      (&block_inner (:P_inner *P))
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (RULE &place_quadrant
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&place_nearer *P (:D D1))
      (&place_nearer P (:D D2)))

    (RULE &heading
      (&marker *P)
      (&block_inner P *P_inner)
      (&place_quadrant (:P P_inner) (:Diag *D)))))

(RULE &ray_dir
  (&heading *D))

(RULE &ray_node
  (&heading *D)
  (input *P))

;; Every block cell casts toward the headings the case claims.
(INIT &ray Distance
  (key ((&ray_source (:P ^O))
        (&ray_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&ray_source (:P O))
           (&ray_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ray_node (:P Q)))
          ((&ray_source (:P O))
           (&ray_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&ray_node (:P Q))
           (= A2 O))
          ((&ray_source (:P O))
           (&ray_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ray_node (:P Q)))))
    (source ((:n O))
      (&ray_source (:P O))
      (&ray_dir D))))

(RULE &ray_ray2
  (&ray.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &ray_ray
  (&ray_ray2 *P *D *K (:Origin *Src))
  (&ray_cell P))

(RULE &ray_end
  (&ray_ray2 *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ray_ray2 (:P Q) D Origin)))

(RULE &output
  (input *P)
  (OR ((&ray_ray2 P)
       (&ray_cell P)
       (&trail *Col))
      ((NOT (&ray_ray P))
       (&bg (:C Col)))))
