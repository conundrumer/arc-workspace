;; 19bb5feb

(DET &bg SharedColor)

;; The color the panel is filled with.
(DET &panel VanishedColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&panel (:C Col))))

(RULE &marks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &marks Quotient
  (edge ((:a P) (:b P3))
    (OR ((&mark *P)
         (&marks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&mark (:P P3)))
        ((&mark P)
         (= P3 P)))))

(RULE &marks_component
  (&marks.class (:a *P) *Id))

(INIT &mark_box BoundingBox
  (key ((&marks_component *P ^Id))
    (cell (P)
      (&marks_component *P Id))))

;; The markers' distances to each edge, ranked densely — markers level with
;; each other share a rank.
(INIT &rank Order
  (key ((dir_elem ^D))
    (member ((:t K))
      (&mark_box.box *B)
      (margin B D *K))
    (score ((:t K) (:S K))
      (&mark_box.box *B)
      (margin B D *K))))

(RULE &place_edge
  (&mark_box.box (:key (:Id *Key)) *B)
  (dir_elem *D)
  (margin B D (:K *K2))
  (&rank.rank (:key D) (:t K2) (:R *K)))

(RULE &place_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&place_edge *Key D (:K *K1))
  (&place_edge Key (:D D2) (:K *K2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K K1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B)))

(RULE &place
  (&place_axis *Key *A (:B *B1))
  (perp A *A2)
  (&place_axis Key (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(RULE &rank_mark
  (&marks_component (:P *P_grid) *Id)
  (&mark (:P P_grid) *Col)
  (&place (:Key Id) (:B *P)))

;; The frame the ranks span.
(INIT &rank_frame Frame
  (extent (A N)
    (&place (:B *P))
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &output
  (&rank_frame.cell *P)
  (OR ((&rank_mark P *Col))
      ((NOT (&rank_mark P))
       (&bg (:C Col)))))
