;; 846bdb03

(DET &corner RarestColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&corner (:C Col))))

(RULE &boxed_inside1
  (input (:P *P_))
  (&bbox.box (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &bg DominantColor)

;; The orientations the shape may take: the reflection group that swaps the bars.
(DET &sym SymDomain)

(RULE &transform
  (&sym *S)
  (sym_member S (:D *T)))

(RULE &cropped
  (input (:P *P2) *Col)
  (&bbox.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

(RULE &bar
  (&cropped *P *Col)
  (dir_elem *D)
  (margin (:B P) D (:K 0))
  (NOT (&bg (:C Col)))
  (NOT (&corner (:C Col))))

;; The box off its border, in its own frame.
(INIT &core BoundingBox
  (cell (P)
    (&cropped *P)
    (relative (:Base 0) (:X P) (:X_rel *R_m1))
    (axis_of (:D *D1_m2) (:A *A1_m3))
    (opposite (:D D1_m2) (:Opp *O1_m4))
    (perp (:A A1_m3) (:A2 *A2_m5))
    (axis_of (:D *D2_m6) (:A A2_m5))
    (opposite (:D D2_m6) (:Opp *O2_m7))
    (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
    (> K1_m8 0)
    (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
    (> K2_m9 0)
    (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
    (> K3_m10 0)
    (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
    (> K4_m11 0)))

(INIT &shape BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (ALL ((&bbox.box *B))
         ((&boxed_inside1 (:P_ P) (:B_ B))))))

(RULE &placed
  (input *P *Col)
  (&shape.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner3))
  (&transform *T)
  (apply (:D T) (:P P_inner3) (:P_out *P_inner)))

(RULE &touches
  (&bar *D *Col)
  (&placed *T (:P_inner *P) Col)
  (margin (:B P) D (:K 0)))

(RULE &output
  (OR ((&cropped *P *Col)
       (NOT (&core.cell P)))
      ((&core.cell P)
       (&core.box *B)
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P) (:X_rel *P_inner))
       (&placed *T P_inner Col)
       (ALL ((&bar *D (:Col *Colm)))
            ((&touches T D (:Col Colm)))))))
