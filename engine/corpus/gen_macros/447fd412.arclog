;; 447fd412

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The drawing's color.
(DET &ink RarestColor)

(RULE &ink_cell
  (input *P *Col)
  (&ink (:C Col)))

;; The color of the marks and of the blocks.
(DET &mark UnchangedColor)

(RULE &obj_node
  (OR ((&ink_cell *P))
      ((input P *Col)
       (&mark (:C Col)))))

(INIT &obj Quotient
  (edge ((:a P) (:b P2))
    (OR ((&obj_node *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:P P2)))
        ((&obj_node P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(RULE &object
  (&obj_component *P *Id))

(RULE &template
  (&object *Id *P)
  (&ink_cell P))

(INIT &block BoundingBox
  (key ((&object ^Id *P)
        (NOT (&template Id)))
    (cell (P)
      (&object Id *P)
      (NOT (&template Id)))))

(RULE &template_cell
  (&template *Id)
  (&object Id *P)
  (input P *Col))

(RULE &template_mark
  (&template_cell *P *Col)
  (&mark (:C Col)))

(RULE &side
  (&block.box (:key *Id) *B)
  (&block.cell (:key Id) *P)
  (axis_elem *A)
  (perp A *A2)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K))
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N K)))

(RULE &strip
  (&side *Id *K)
  (&block.box (:key Id) *B)
  (input (:P *Q))
  (relative (:Base B) (:X Q) (:X_rel *Q_rel))
  (dir_elem *D)
  (opposite D (:Opp *O))
  (margin (:B Q_rel) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Part *N) (:Remainder *K_in)))

(RULE &strips
  (&strip *Id *Q (:D *D1) (:N *N1) (:K_in *K1))
  (&strip Id Q (:D *D2) (:N *N2) (:K_in *K2))
  (axis_of (:D D1) (:A *A1))
  (axis_of (:D D2) (:A *A2))
  (perp (:A A1) A2))

(RULE &scaled
  (&template_mark (:P *T0))
  (&strips *Id *Q *D1 *N1 *D2 *N2)
  (dir8_opposite (:D D1) (:D2 *O_m2))
  (edge_inset (:D O_m2) (:K N1) (:B *B1_m3))
  (edge_inset (:D D1) (:K N1) (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A T0) (:B V_m1) (:C *P1))
  (dir8_opposite (:D D2) (:D2 *O_m7))
  (edge_inset (:D O_m7) (:K N2) (:B *B1_m8))
  (edge_inset (:D D2) (:K N2) (:B *I_m10))
  (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
  (compose (:A B1_m8) (:B B2_m9) (:C *V_m6))
  (compose (:A P1) (:B V_m6) (:C *P))
  (&template_cell P))

(RULE &twin
  (&strips *Id *Q *D1 *K1 *D2 *K2)
  (&strip Id (:Q *C) (:D D1) (:N 0) (:K_in K1))
  (&strip Id (:Q C) (:D D2) (:N 0) (:K_in K2)))

(RULE &seated
  (&scaled *T0 *Id *P (:Q *C))
  (&template_mark P)
  (&block.cell (:key (:Id *Id2)) (:P C))
  (&side Id *K)
  (&side (:Id Id2) K)
  (&block.box (:key (:Id Id2)) (:B *B2))
  (ALL ((&scaled (:T0 *T0m) (:Id *Idm) (:P *Pm) (:Q C))
        (&block.box (:key (:Id *Id2m)) (:B B2))
        (dir_elem (:D *D_m1))
        (relative (:Base B2) (:X C) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B2) (:X C) (:X_rel *R))
  (&twin Id (:Q C) (:C *C2))
  (&block.box (:key Id) *B)
  (ALL ((&twin (:Id *Idmm) (:Q *Cm) (:C C2))
        (&block.box (:key (:Id Idmm)) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X C2) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (relative (:Base B) (:X C2) (:X_rel R)))

(RULE &covers
  (&scaled *T0 *Id *P *Q)
  (ALL ((&template_mark (:P *Pm)))
       ((&seated T0 Id (:P Pm)))))

(RULE &carried
  (&template_cell *P *Col)
  (&ink (:C Col)))

(RULE &covered_cell
  (&covers *P *Q))

(ALTS $carry "What a template cell carries into its box." $Ink
  (ALT $Whole
    (RULE &carried
      (&template_cell *P *Col))))

(ALTS $cover "Which cells of a covered box the stamp reaches." $Box
  (ALT $Cells
    (RULE &covered_cell
      (&covers *Id *P *Q)
      (&twin Id Q *C)
      (&block.cell (:key Id) (:P C)))))

(RULE &stamped
  (&covered_cell (:P *P2) (:Q *P))
  (&carried (:P P2) *Col))

(RULE &output
  (OR ((&stamped *P *Col))
      ((input P Col)
       (NOT (&stamped P)))))
