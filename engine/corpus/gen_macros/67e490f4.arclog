;; 67e490f4

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The field is the commonest color; everything else is ink.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &obj_node
  (input *P (:Col *Key))
  (NOT (&field.maximal (:t Key))))

;; Same-colored ink objects.
(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

(RULE &boxed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &field_cell
  (input *P *Col)
  (&field.maximal (:t Col)))

(RULE &closed_cell
  (&field_cell *P))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &closed_flood Propagation
  (source ((:n P))
    (&closed_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (&field_cell P))
  (edge ((:a P) (:b P2))
    (&field_cell *P)
    (&closed_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&field_cell (:P P2))))

(RULE &closed_node
  (&closed_cell *P)
  (NOT (&closed_flood.reached (:n P))))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The field regions closed off from the grid edge.
(INIT &closed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&closed_node *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:P P2)))
        ((&closed_node P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *P) *Id))

(RULE &stencil
  (&closed_component *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&obj_component (:P Q) *Id))

(INIT &obj_shape BoundingBox
  (key ((&obj_component *P ^Id))
    (cell (P)
      (&obj_component *P Id))))

;; The group under which a piece and a cutout are the same shape.
(DET &shape_sym SymDomain)

(ALTS $s "what marks the stencil out among the objects" $Bordering
  (ALT $Largest
    (INIT &biggest_count Cardinality
      (key ((&obj_component *P ^Id))
        (member ((:m P))
          (&obj_component *P Id))))

    (INIT &biggest Order
      (member ((:t Id))
        (&biggest_count.size (:key *Id)))
      (score ((:t Id) (:S N))
        (&biggest_count.size (:key *Id) *N)))

    (RULE &stencil
      (&biggest.maximal (:t *Id)))))

(ALTS $r "what a cutout is" $Box
  (ALT $Closed
    (RULE &cutout
      (&closed_component *P *Id))))

(INIT &stencil_box BoundingBox
  (cell (P)
    (&stencil *Id)
    (&obj_component *P Id)))

(RULE &boxed_node
  (&stencil_box.box *B)
  (&field_cell *P)
  (ALL ((&stencil_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(INIT &boxed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&boxed_node *P)
         (&boxed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&boxed_node (:P P2)))
        ((&boxed_node P)
         (= P2 P)))))

(RULE &boxed_component
  (&boxed.class (:a *P) *Id))

(RULE &cutout
  (&boxed_component *P *Id))

(INIT &cut_shape BoundingBox
  (key ((&cutout *P ^Id))
    (cell (P)
      (&cutout *P Id))))

(INIT &cong Agreement
  (key ((OR ((&cut_shape.cell (:key (:Id ^C)) *P)
             (&cut_shape.box (:key (:Id C)) *B)
             (ALL ((&cut_shape.cell (:key (:Id *Cm)) P)
                   (&cut_shape.box (:key (:Id Cm)) B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X P) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (relative (:Base B) (:X P) (:X_rel *P_inner))
             (&obj_shape.box (:key (:Id ^O))))
            ((&obj_shape.cell (:key (:Id O)) P)
             (&obj_shape.box (:key (:Id O)) B)
             (ALL ((&obj_shape.cell (:key (:Id *Om)) P)
                   (&obj_shape.box (:key (:Id Om)) B)
                   (dir_elem (:D *D_m12))
                   (relative (:Base B) (:X P) (:X_rel *R_m22))
                   (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                  ((>= K_m32 0)))
             (relative (:Base B) (:X P) (:X_rel P_inner))
             (&cut_shape.box (:key (:Id C))))))
    (source ((:i P_inner))
      (&cut_shape.cell (:key (:Id C)) *P)
      (&cut_shape.box (:key (:Id C)) *B)
      (ALL ((&cut_shape.cell (:key (:Id *Cm)) P)
            (&cut_shape.box (:key (:Id Cm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&obj_shape.box (:key (:Id O))))
    (target ((:i P_inner))
      (&obj_shape.cell (:key (:Id O)) *P)
      (&obj_shape.box (:key (:Id O)) *B)
      (ALL ((&obj_shape.cell (:key (:Id *Om)) P)
            (&obj_shape.box (:key (:Id Om)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&cut_shape.box (:key (:Id C))))
    (correspondence ((:m D) (:i P_inner) (:j Q))
      (&cut_shape.cell (:key (:Id C)) *P)
      (&cut_shape.box (:key (:Id C)) *B)
      (ALL ((&cut_shape.cell (:key (:Id *Cm)) P)
            (&cut_shape.box (:key (:Id Cm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&obj_shape.box (:key (:Id O)))
      (d4_elem *D)
      (apply D (:P P_inner) (:P_out *Q)))))

(RULE &cong_dst
  (&obj_shape.cell (:key (:Id *Obj)) (:P *P2))
  (&obj_shape.box (:key (:Id Obj)) *B)
  (ALL ((&obj_shape.cell (:key (:Id *Om)) (:P P2))
        (&obj_shape.box (:key (:Id Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (&cut_shape.box (:key *Id)))

(RULE &cong_src
  (&cut_shape.cell (:key *Id) (:P *P2))
  (&cut_shape.box (:key Id) *B)
  (ALL ((&cut_shape.cell (:key (:Id *Cm)) (:P P2))
        (&cut_shape.box (:key (:Id Cm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (&obj_shape.box (:key (:Id *Obj))))

(RULE &onto
  (&cong_src *Id *Obj)
  (d4_elem *D)
  (NOT (&cong.mismatch (:key (:C Id) (:O Obj)) (:m D)))
  (ALL ((&cong_dst Id Obj (:P *Q))
        (d4_inverse D (:D_inv *D_back))
        (apply (:D D_back) (:P Q) (:P_out *P)))
       ((&cong_src Id Obj P))))

(INIT &fill_count Cardinality
  (key ((&onto (:Id ^C) (:Obj *O) *D)
        (&shape_sym *S)
        (sym_member S D)
        (&obj_component (:Key ^Col) (:Id O)))
    (member ((:m O))
      (&onto (:Id C) (:Obj *O) *D)
      (&shape_sym *S)
      (sym_member S D)
      (&obj_component (:Key Col) (:Id O)))))

;; The commonest color among the objects of the cutout's shape. The stencil
;; surrounds its cutouts, so it never has a cutout's shape.
(INIT &fill Order
  (key ((&fill_count.size (:key (:C ^Id) *Col)))
    (member ((:t Col))
      (&fill_count.size (:key (:C Id) *Col)))
    (score ((:t Col) (:S N))
      (&fill_count.size (:key (:C Id) *Col) *N))))

(RULE &output
  (&stencil_box.box *B)
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (OR ((&obj_component (:Key *Col) (:P *P2) *Id)
       (&stencil Id))
      ((&cutout (:P P2) Id)
       (&fill.maximal (:key Id) (:t Col))))
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (relative (:Base B) (:X P2) (:X_rel *P)))
