;; b942fd60

(INPUT background "every cell that is not a mark has the color `background`")

(INPUT one-seed "exactly one cell has the color `line-color`, the seed, and it lies on the grid edge opposite `start-dir`")

(INPUT scattered-marks "single cells of other colors, the obstacles, lie scattered over the grid; none has the color `line-color`")

(OUTPUT first-ray "a ray leaves the seed toward `start-dir`")

(OUTPUT ray-stops "a ray runs over the cells in its direction, and stops at the last cell before an obstacle or before the grid edge"

  (DET &line RarestColor)

  (RULE &seed
    (input *P *Col)
    (&line (:C Col))))

(OUTPUT branch "where a ray stops before an obstacle, two new rays leave the stop cell, one in each direction perpendicular to that ray")

(OUTPUT edge-ends "a ray that stops at the grid edge has no branches")

(OUTPUT paint "every cell a ray runs over takes the color `line-color`; every other cell keeps its input color"

  (RULE &cast_dir
    (dir_elem *D))

  (DET_OR_RULE &bg DominantColor)

  (RULE &obstacle2
    (input *P *Col)
    (NOT (&bg Col))
    (NOT (&line (:C Col))))

  (RULE &cast_blocked
    (&obstacle2 *P))

  (RULE &cast_node
    (dir_elem *D)
    (input *P)
    (NOT (&cast_blocked P)))

  (RULE &cast_cell
    (input *P))

  (RULE &cast_source
    (&cast_cell *P))

  ;; Rays cross the grid from every cell, and stop before a blocked cell.
  (INIT &cast Distance
    (key ((&cast_source (:P ^O))
          (&cast_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&cast_source (:P O))
             (&cast_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&cast_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&cast_node (:P Q)))
            ((&cast_source (:P O))
             (&cast_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&cast_node (:P Q))
             (= A2 O))
            ((&cast_source (:P O))
             (&cast_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&cast_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&cast_node (:P Q)))))
      (source ((:n O))
        (&cast_source (:P O))
        (&cast_dir D))))

  (RULE &cast_ray
    (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

  (RULE &cast_end
    (&cast_ray *P *D *K *Origin)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (NOT (&cast_ray (:P Q) D Origin)))

  (RULE &branch_leg
    (&cast_end (:P *E_2) *D (:Origin *A))
    (step_offset D (:V *V_m1))
    (compose (:A E_2) (:B V_m1) (:C *Q))
    (input (:P Q))
    (dir_elem D)
    (opposite D (:Opp *D_back))
    (step_offset (:D D_back) (:V *V_m2))
    (compose (:A Q) (:B V_m2) (:C *E1))
    (axis_of D (:A *A_m3))
    (perp (:A A_m3) (:A2 *A2_m4))
    (axis_of (:D *D2) (:A A2_m4)))

  (DET &painted_next
    (&line (:C *Col))
    (ex_input *E *P Col)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (ex_output E (:P Q) Col))

  (DET &unpainted
    (ex_output *E)
    (dir_elem *D)
    (NOT (&painted_next E D)))

  (DET &start
    (dir_elem *D)
    (NOT (&unpainted D)))

  (RULE &start2
    (&start *D)))

(ALTS $s "whether the seed blocks a ray" $SeedPasses
  (ALT $SeedBlocks
    (OUTPUT ray-stops "a ray stops at the last cell before an obstacle, before the seed, or before the grid edge"
      (RULE &cast_blocked
        (OR ((&seed *P))
            ((&obstacle2 P)))))))

(ALTS $b "whether a ray whose first cell is an obstacle branches" $BlockedRayBranches
  (ALT $BlockedRayEnds
    (OUTPUT branch "where a ray runs over at least one cell and stops before an obstacle, two new rays leave the stop cell, one in each direction perpendicular to that ray")
    ;; The rays the seed sets off.
    (INIT &reach Propagation
      (source ((:n P D))
        (&seed *P)
        (&start2 *D))
      (edge ((:a (:P A) D) (:b (:P E) (:D D2)))
        (&branch_leg *A *D (:E1 *E) *D2)
        (!= E A)))))

(ALTS $st "where the first ray's direction comes from" $StoredStart
  (ALT $StartFromSeedEdge
    (OUTPUT first-ray "a ray leaves the seed away from the grid edge it lies on; undefined where the seed lies on no edge or on two edges"
      (RULE &seed_edge
        (&seed *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))

      (RULE &start2
        (&seed_edge (:D *D_edge))
        (ALL ((&seed_edge (:D *D1))
              (&seed_edge (:D *D2)))
             ((= D1 D2)))
        (opposite (:D D_edge) (:Opp *D))))))

(ALTS $o "which cells block a ray" $NonBackground
  (ALT $StoredObstacleColors
    (INPUT scattered-marks "single cells of the colors in `obstacle-colors`, the obstacles, lie scattered over the grid; a ray paints over a cell of any other color"
      (DET &repainted
        (ex_input *E *P *Col)
        (ex_output E P (:Col *Col2))
        (!= Col Col2))

      (DET &obstacle
        (ex_input *E *Col)
        (ex_output E)
        (NOT (&repainted Col))
        (NOT (&line (:C Col))))

      (RULE &obstacle2
        (input *P *Col)
        (&obstacle Col)))))

;; The rays the seed sets off.
(INIT &reach Propagation
  (source ((:n P D))
    (&seed *P)
    (&start2 *D))
  (edge ((:a (:P A) D) (:b (:P E) (:D D2)))
    (&branch_leg *A *D (:E1 *E) *D2)))

(RULE &painted
  (&reach.reached (:n (:P *A) *D))
  (&cast_ray *P D (:Origin A))
  (&cast_cell P))

(RULE &output
  ;; A case draws where the seed sets off a first ray.
  (OR ((&painted *P)
       (&line (:C *Col)))
      ((input P Col)
       (&reach.source)
       (NOT (&painted P)))))
