;; aee291af

(INPUT field "a field of background (1), with stray cells of frame_color (8) scattered over it, some of them touching a box")

(INPUT boxes "several disjoint square boxes of one size, each with a 1-wide border of frame_color and an interior of frame_color and mark_color cells, where the marks span the whole interior"

  (RULE &blobs_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &marks_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET_OR_RULE &mark_color RarestColor SharedColor)

  (DET_OR_RULE &background DominantColor)

  (INIT &blobs Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&background Col))
           (&blobs_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&background (:Col Col2))))
          ((input P (:Col *Col3))
           (NOT (&background (:Col Col3)))
           (= P3 P)))))

  (INIT &marks Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (&mark_color Col)
           (&marks_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (&mark_color (:Col Col2)))
          ((input P (:Col *Col3))
           (&mark_color (:Col Col3))
           (= P3 P))))))

(INPUT one-odd "every box but one has the same interior pattern, and the one left has another pattern")

(OUTPUT odd-box "the output is the box whose pattern no other box shares, border included"

  (DET &frame_color ColorDomain)

  (INIT &outline Outlines
    (node (P)
      (input *P *Col)
      (&frame_color (:C Col))))

  (RULE &foreign_cell
    (&outline.box *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0)))
    (NOT (&frame_color (:C Col)))
    (NOT (&mark_color Col)))

  (RULE &candidate
    (&outline.box *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0)))
    (&mark_color Col)
    (ALL ((input P (:Col *Colmm))
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X P) (:X_rel *R_m2m))
          (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
         ((>= K_m3m 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (axis_elem *A)
    (perp A (:A2 *A2_m1))
    (frame_extent (:P P_rel) A *N)
    (frame_extent (:P P_rel) (:A A2_m1) N)
    (NOT (&foreign_cell B)))

  (RULE &nested_inside1
    (&candidate (:B *B_))
    (&candidate (:B *B2_))
    (dir_elem (:D *D_m1))
    (relative (:Base B2_) (:X B_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &box
    (&candidate *B)
    (ALL ((&candidate (:B *B2))
          (!= B B2))
         ((&nested_inside1 (:B_ B) (:B2_ B2)))))

  (RULE &box_cell
    (&box *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (&box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel)))

  ;; Two boxes show the same pattern when their cells match, each read in its
  ;; box's own frame.
  (INIT &pattern Inclusion
    (pattern ((:pattern B) (:m P Col))
      (&box_cell *B (:P_rel *P) *Col))
    (observed ((:observed B) (:m P Col))
      (&box_cell *B (:P_rel *P) *Col)))

  ;; How many boxes show each box's pattern.
  (INIT &copies Cardinality
    (key ((&pattern.equal (:observed ^B) (:pattern *B2)))
      (member ((:m B2))
        (&pattern.equal (:observed B) (:pattern *B2)))))

  (INIT &extremes Order
    (member ((:t (:V B) (:S N)))
      (&copies.size (:key *B) *N))
    (score ((:t (:V B) (:S N)) (:S N))
      (&copies.size (:key *B) *N))))

(ALTS $f "how a box is found" $FramedSquare
  (ALT $MarkBbox
    (INPUT boxes "a box is the bounding box of the marks of one 8-connected group of non-background cells, grown by one cell on each side; undefined where a grown box reaches past the grid edge"
      (RULE &blobs_component
        (&blobs.class (:a *P) *Id))

      (RULE &mark_group
        (&blobs_component *P *Id)
        (input P *Col)
        (&mark_color Col))

      ;; The bounding box of each group's marks together with the cells around them.
      (INIT &grown BoundingBox
        (key ((&mark_group *P ^Id)
              (dir8_elem *D)
              (step_offset D (:V *V_m1))
              (compose (:A P) (:B V_m1) (:C *Q)))
          (cell ((:P Q))
            (&mark_group *P Id)
            (dir8_elem *D)
            (step_offset D (:V *V_m1))
            (compose (:A P) (:B V_m1) (:C *Q)))))

      (RULE &spill
        (&grown.box *B)
        (dir_elem (:D *D_m1))
        (relative (:Base 0) (:X B) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (RULE &box
        (&grown.box *B)
        (NOT (&spill)))))
  (ALT $MarkGroupBbox
    (INPUT boxes "a box is the bounding box of one 8-connected group of marks, grown by one cell on each side; undefined where a grown box reaches past the grid edge"
      (RULE &marks_component
        (&marks.class (:a *P) *Id))

      (RULE &mark_group
        (&marks_component *P *Id))

      ;; The bounding box of each group's marks together with the cells around them.
      (INIT &grown BoundingBox
        (key ((&mark_group *P ^Id)
              (dir8_elem *D)
              (step_offset D (:V *V_m1))
              (compose (:A P) (:B V_m1) (:C *Q)))
          (cell ((:P Q))
            (&mark_group *P Id)
            (dir8_elem *D)
            (step_offset D (:V *V_m1))
            (compose (:A P) (:B V_m1) (:C *Q)))))

      (RULE &spill
        (&grown.box *B)
        (dir_elem (:D *D_m1))
        (relative (:Base 0) (:X B) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (RULE &box
        (&grown.box *B)
        (NOT (&spill))))))

(ALTS $s "which box is the odd one" $UniquePattern
  (ALT $RarestPattern
    (INPUT one-odd "the boxes show several patterns")
    (OUTPUT odd-box "the output is the pattern the fewest boxes show; undefined where that fewest count is tied"
      (RULE &rare_tie
        (&extremes.minimal (:t (:V *B)))
        (&extremes.minimal (:t (:V *B2)))
        (NOT (&pattern.equal (:observed B) (:pattern B2)))))
    (RULE &picked
      (&extremes.minimal (:t (:V *B)))
      (NOT (&rare_tie)))))

(RULE &shared
  (&pattern.equal (:observed *B) (:pattern *B2))
  (!= B B2))

(RULE &unique
  (&box *B)
  (NOT (&shared B)))

(RULE &many_unique
  (&unique *B)
  (&unique (:B *B2))
  (!= B B2))

(RULE &picked
  (&unique *B)
  (NOT (&many_unique)))

(RULE &output
  (&picked *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (&picked B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
