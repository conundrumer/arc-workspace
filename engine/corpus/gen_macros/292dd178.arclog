;; 292dd178

(RULE &comp_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &wall RarestColor)

(RULE &wall_cell
  (input *P *Col)
  (&wall (:C Col)))

(INIT &comp Quotient
  (edge ((:a P) (:b P3))
    (OR ((&wall_cell *P)
         (&comp_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&wall_cell (:P P3)))
        ((&wall_cell P)
         (= P3 P)))))

(RULE &comp_component
  (&comp.class (:a *P) *Id))

(RULE &flow_dir
  (dir_elem *D))

(RULE &flow_node
  (input *P)
  (NOT (&wall_cell P)))

(INIT &bbox BoundingBox
  (key ((&comp_component *P ^Id))
    (cell (P)
      (&comp_component *P Id))))

(RULE &hole
  (&bbox.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(RULE &flow_source
  (&hole *P))

(INIT &flow Distance
  (key ((&flow_source (:P ^O))
        (&flow_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&flow_source (:P O))
           (&flow_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&flow_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&flow_node (:P Q)))
          ((&flow_source (:P O))
           (&flow_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&flow_node (:P Q))
           (= A2 O))
          ((&flow_source (:P O))
           (&flow_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&flow_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&flow_node (:P Q)))))
    (source ((:n O))
      (&flow_source (:P O))
      (&flow_dir D))))

(RULE &flow_ray
  (&flow.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &flow_end
  (&flow_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&flow_ray (:P Q) D Origin)))

(RULE &cast_dir
  (dir_elem (:D *Key)))

(RULE &cast_node
  (dir_elem (:D *Key))
  (input *P))

(RULE &cast_source
  (&bbox.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *Key) (:K *K_m1))
  (margin B (:D Key) (:K K_m1))
  (NOT (&wall_cell P)))

(INIT &cast Distance
  (key ((&cast_source (:Key ^Ky) (:P ^O))
        (&cast_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:Key Ky) (:P Q)))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&cast_source (:Key Ky) (:P O))
      (&cast_dir (:Key Ky)))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray Key (:P Q) D Origin)))

(DET &fill AnyOutNewColor)

(RULE &painted
  (&flow_ray *P))

(ALTS $choice "how the fill reaches outside the box through the break" $Flow
  (ALT $Cast
    (RULE &cast_cell
      (dir_elem (:D *Key))
      (input *P))

    (RULE &painted
      (OR ((&hole *P))
          ((&cast_ray (:Key *Ky) P)
           (&cast_cell (:Key Ky) P))))))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
