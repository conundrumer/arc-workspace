;; 928ad970

(DET &drawn
  (ex_input *E *P (:Col *C_in))
  (ex_output E P *Col)
  (!= Col C_in))

(INIT &rect_box BoundingBox
  (key ((&drawn ^E *P))
    (cell (P)
      (&drawn E *P))))

(DET &bg
  (ex_input *E *P (:Col *C))
  (&drawn E P))

(DET &mark_col
  (ex_output *E)
  (ex_input E (:Col *C))
  (NOT (&bg C))
  (NOT (&drawn E (:Col C))))

(DET &spanned
  (ex_input *E *P *Col)
  (&mark_col (:C Col)))

(RULE &fg
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &mark
  (&fg *P *Col)
  (&mark_col (:C Col)))

(RULE &ink
  (&fg *Col)
  (NOT (&mark_col (:C Col))))

(ALTS $m "What tells the markers from the shape." $Named
  (ALT $Lone
    (RULE &touching
      (&fg *P)
      (dir8_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&fg (:P Q)))

    (RULE &mark
      (&fg *P)
      (NOT (&touching P)))

    (RULE &ink
      (&fg *P *Col)
      (&touching P))))

(ALTS $s "The cells the box spans." $Markers
  (ALT $Content
    (RULE &spanned2
      (&fg *P))

    (DET &content_inset
      (&inset *K))

    (RULE &inset2
      (&content_inset *K))

    (DET &spanned
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col))))))

(INIT &span_box BoundingBox
  (key ((&spanned ^E *P))
    (cell (P)
      (&spanned E *P))))

(DET &inset
  (&span_box.box (:key *E) *B)
  (&rect_box.box (:key E) (:B *B_rect))
  (relative (:Base B) (:X B_rect) (:X_rel *V))
  (dir_elem *D)
  (margin (:B V) D *K))

(DET &mark_inset
  (&inset *K))

(RULE &inset2
  (&mark_inset *K))

(RULE &rect_uniform_inset1
  (&inset2 (:K *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *V_)))

(RULE &spanned2
  (&mark *P))

(INIT &span_box2 BoundingBox
  (cell (P)
    (&spanned2 *P)))

(RULE &rect
  (&span_box2.box (:B *B2))
  (&inset2 *K)
  (&rect_uniform_inset1 (:K_ K) (:V_ *V))
  (compose (:A B2) (:B V) (:C *B)))

(RULE &drawn2
  (input *P)
  (&rect *B)
  (ALL ((&rect B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2)))

(RULE &output
  (OR ((&drawn2 *P)
       (&ink *Col))
      ((input P Col)
       (NOT (&drawn2 P)))))
