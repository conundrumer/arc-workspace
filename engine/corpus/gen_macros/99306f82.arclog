;; 99306f82

(RULE &rings_depth_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; the color the outline is drawn in
(DET &frame SharedColor)

(RULE &frame_cell
  (input *P *Col)
  (&frame (:C Col)))

(INIT &outline Outlines
  (node (P)
    (&frame_cell *P)))

(RULE &held
  (&outline.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(DET &bg DominantColor)

;; the corner the markers are ordered from
(DET &corner DiagDirDomain)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&frame (:C Col))))

;; The run, ordered from the marker nearest the corner.
(INIT &marks Order
  (member ((:t P))
    (&mark *P))
  (before ((:a P) (:b Q))
    (&mark *P)
    (&mark (:P *Q))
    (&corner *D)
    (diag_dir_elem D)
    (corner_dist P (:Diag D) (:K *K1_m1))
    (corner_dist (:P Q) (:Diag D) (:K *K2_m2))
    (< K1_m1 K2_m2)))

(ALTS $choice "what the outline is, and what counts as its inside" $Rect
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (input *P)
      (NOT (&frame_cell P)))

    (INIT &closed_flood Propagation
      (source ((:n P))
        (&closed_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P)
        (NOT (&frame_cell P)))
      (edge ((:a P) (:b P2))
        (input *P)
        (NOT (&frame_cell P))
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2))
        (NOT (&frame_cell (:P P2)))))

    (RULE &closed_node
      (&closed_cell *P)
      (NOT (&closed_flood.reached (:n P))))

    (INIT &closed Quotient
      (edge ((:a P) (:b P2))
        (OR ((&closed_node *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:P P2)))
            ((&closed_node P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *P) *Id))

    (RULE &held
      (&closed_component *P))))

;; The rings: depth runs inward from the held cells' own boundary.
(INIT &rings Boundary
  (cell (P)
    (&held *P)))

(INIT &rings_depth Distance
  (edge ((:a P) (:b P2))
    (&held *P)
    (&rings_depth_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&held (:P P2)))
  (source ((:n P))
    (&rings.boundary *P)))

(RULE &output
  (OR ((&rings_depth.distance (:n *P) *K)
       (&mark (:P *M) *Col)
       (&marks.rank (:t M) *R)
       (OR ((= K R))
           ((> K R)
            (&marks.maximal (:t M)))))
      ((input P Col)
       (NOT (&held P)))))
