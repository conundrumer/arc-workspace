;; 825aa9e9

(RULE &body_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &fall DirDomain)

(DET &bg SharedColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &floor_color
  (&ink *P *Col)
  (&fall *D)
  (margin (:B P) D (:K 0)))

(RULE &body_node
  (&ink *P *Col)
  (NOT (&floor_color Col)))

;; The clearance a shape keeps beneath itself.
(DET &gap DivisorRatio)

(RULE &fall_dir
  (&fall *D))

(ALTS $choice "how the floor is told apart from the falling shapes" $FloorColor
  (ALT $Grounded
    (RULE &body_node
      (&ink *P))

    (RULE &standing
      (&body_component *P *Id)
      (&fall *D)
      (margin (:B P) D (:K 0)))

    (RULE &mover
      (&body_component *Id)
      (NOT (&standing Id)))))

(INIT &body Quotient
  (edge ((:a P) (:b P2))
    (OR ((&body_node *P)
         (&body_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&body_node (:P P2)))
        ((&body_node P)
         (= P2 P)))))

(RULE &body_component
  (&body.class (:a *P) *Id))

(RULE &mover
  (&body_component *Id))

(RULE &mover_cell
  (&mover *Id)
  (&body_component *P Id))

(RULE &foot
  (OR ((&mover_cell *Id *P))
      ((&mover_cell Id (:P *P2))
       (&fall *D)
       (&gap *K)
       (dir8_opposite D (:D2 *O_m2))
       (edge_inset (:D O_m2) K (:B *B1_m3))
       (edge_inset D K (:B *I_m5))
       (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
       (compose (:A P2) (:B V_m1) (:C P)))))

;; Each body falls with its clearance until that clearance meets what lies
;; beneath.
(INIT &fall2 Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&foot *Id *P)
    (&fall_dir *D)
    (&foot (:Id *Id2) (:P *P2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&foot *Id *P)
         (&fall_dir *D)
         (margin (:B P) D *K))
        ((&foot Id (:P *P3))
         (&fall_dir (:D *D2))
         (&ink (:P *P2))
         (NOT (&mover_cell (:P P2)))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &landed
  (&fall2.distance (:n *Id) *K)
  (&fall_dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta))
  (&mover_cell Id (:P *P3))
  (input (:P P3) *Col)
  (compose (:A P3) (:B Delta) (:C *P)))

(RULE &vacated
  (&fall2.distance (:n *Id) *K)
  (&fall_dir *D)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset D K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (&mover_cell Id *P))

(RULE &output
  (OR ((&landed *P *Col))
      ((input P (:Col *C_in))
       (NOT (&landed P))
       (IF ((&vacated P))
           ((&bg (:C Col)))
           ((= Col C_in))))))
