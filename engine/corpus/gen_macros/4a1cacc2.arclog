;; 4a1cacc2

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &place_nearer
  (&mark *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &place_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&place_nearer *P (:D D1))
  (&place_nearer P (:D D2)))

(INIT &bbox BoundingBox
  (cell (P)
    (OR ((&mark *P))
        ((input P)
         (&place_quadrant *Diag)
         (corner_dist P Diag (:K 0))))))

(RULE &covered
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &output
  (input *P (:Col *C0))
  (IF ((&covered P))
      ((&mark *Col))
      ((= Col C0))))
