;; 746b3537

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ ^P_across)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))))

(RULE &mismatch
  (&line_color.plural (:key *A)))

(RULE &seq_axis
  (perp (:A *A2) (:A2 *A))
  (NOT (&mismatch (:A A2))))

(RULE &runs_node_split1
  (input (:P *P_) *Col)
  (&seq_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

(RULE &runs_node
  (&seq_axis *A)
  (input (:P *P2) (:Col *Key))
  (&runs_node_split1 (:P_ P2) (:A_ A) (:P_line_ *P) (:X_m1_ *X_m1)))

(RULE &runs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; A run: adjacent sequence lines of one color.
(INIT &runs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&runs_node (:Key *Ky) *P)
         (&runs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&runs_node (:Key Ky) (:P P2)))
        ((&runs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &runs_component
  (&runs.class (:a *Key *P) *Id))

;; One output cell per run — the frame the runs induce.
(INIT &seq Order
  (key ((&seq_axis ^A)
        (axis_of ^D A))
    (before ((:a Id) (:b Id2))
      (&runs_component (:P *P_line) *Id)
      (&runs_component (:P *P_line2) (:Id *Id2))
      (!= Id Id2)
      (margin (:B P_line) D (:K *K1))
      (margin (:B P_line2) D (:K *K2))
      (< K1 K2)))
  (member ((:t Id))
    (&runs_component (:P *P_line) *Id)))

(RULE &seq_pos
  (&seq.rank (:key *A *D) (:t *M) (:R *R1))
  (&seq.dual_rank (:key A D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &output
  (&runs_component (:Key *Col) *Id)
  (&seq_pos (:M Id) (:P_pos *P)))
