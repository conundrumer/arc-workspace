;; a934301b

(INPUT rectangles "the input is a &background field holding solid rectangles, each made of cells of 1 and &mark cells, and no two rectangles touch, so each rectangle is one connected component of non-&background cells"

  (DET_OR_RULE &background DominantColor)

  (DET_OR_RULE &mark RarestColor))

(OUTPUT count-marks "an object is one rectangle, and its mark count is the number of its &mark cells"
  (APPROXIMATED "an object is a 4-connected component of non-&background cells, and its mark count is the number of its &mark cells")

  (RULE &objects4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (INIT &objects4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&objects4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (RULE &objects4_component
    (&objects4.class (:a *P) *Id))

  (RULE &groups_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &mark2
    (input *P *Col)
    (&mark (:C Col)))

  (INIT &groups Quotient
    (edge ((:a P) (:b P3))
      (OR ((&mark2 *P)
           (&groups_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&mark2 (:P P3)))
          ((&mark2 P)
           (= P3 P)))))

  (RULE &groups_component
    (&groups.class (:a *P) *Id))

  (RULE &objects8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &object
    (&objects4_component *P *Id))

  (INIT &objects8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&objects8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (INIT &group_count Cardinality
    (key ((&object ^Id))
      (member ((:m G))
        (&object Id *P)
        (&groups_component P (:Id *G)))
      (domain ()
        (&object Id)))))

(OUTPUT erase-crowded "an object whose mark count exceeds &max_marks becomes &background"

  ;; the largest mark count an object keeps
  (DET &max_marks DivisorRatio))

(OUTPUT keep-rest "every other cell of the output is the input cell"

  (INIT &mark_cells Cardinality
    (key ((&object ^Id))
      (member ((:m P))
        (&object Id *P)
        (&mark2 P))
      (domain ()
        (&object Id))))

  (RULE &mark_count
    (&mark_cells.size (:key (:Id *M)) *N)))

(ALTS $a "which cells join one object" $FourAdjacent
  (ALT $EightAdjacent
    (OUTPUT count-marks "an object is an 8-connected component of non-&background cells"
      (RULE &objects8_component
        (&objects8.class (:a *P) *Id))

      (RULE &object
        (&objects8_component *P *Id)))))

(ALTS $k "which cells of an object count as marks" $MarkColor
  (ALT $NonBody
    (OUTPUT count-marks "a mark is any object cell not of &body"
      (DET &body ColorDomain)

      (RULE &mark2
        (&ink *P *Col)
        (NOT (&body (:C Col)))))))

(ALTS $u "what the mark count counts" $MarkCells
  (ALT $MarkGroups
    (OUTPUT count-marks "the mark count is the number of 4-connected groups of mark cells in the object"
      (RULE &mark_count
        (&group_count.size (:key (:Id *M)) *N)))))

(ALTS $s "which mark counts erase an object" $Threshold
  (ALT $CountTable
    (OUTPUT erase-crowded "an object whose mark count is in &drop_count becomes &background, one whose count is in &keep_count stays, and an object whose count is in neither leaves the output undefined"
      (DET_OR_RULE &drop_count TileCount)

      (DET &changed
        (&object *E *Id *P)
        (ex_input E P *Col)
        (ex_output E P (:Col *Col2))
        (!= Col Col2))

      (DET &keep_count
        (&mark_count *E (:M *Id) *N)
        (ex_output E)
        (NOT (&changed E Id))))
    (RULE &crowded
      (&mark_count (:M *Id) *N)
      (&drop_count N))

    (RULE &spared
      (&mark_count (:M *Id) *N)
      (&keep_count N))))

(RULE &crowded
  (&mark_count (:M *Id) *N)
  (&max_marks (:K *Max))
  (> N Max))

(RULE &spared
  (&mark_count (:M *Id) *N)
  (&max_marks (:K *Max))
  (<= N Max))

(RULE &output
  (OR ((input *P *Col)
       (&background (:C Col)))
      ((&object *Id P)
       (&crowded Id)
       (&background (:C Col)))
      ((&object (:Id *Id2) P)
       (&spared (:Id Id2))
       (input P Col))))
