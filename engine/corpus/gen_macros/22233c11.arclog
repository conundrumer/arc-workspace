;; 22233c11

(DET &block RarestColor)

(RULE &block_cell
  (input *P *Col)
  (&block (:C Col)))

;; The box the two squares share.
(INIT &bbox BoundingBox
  (cell (P)
    (&block_cell *P)))

(RULE &box_cell
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &place_nearer
  (&box_cell (:P_inner *P))
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &place_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&place_nearer *P (:D D1))
  (&place_nearer P (:D D2)))

(DET &echo AnyOutNewColor)

(RULE &quad_cell
  (&box_cell *P *P_inner)
  (&place_quadrant (:P P_inner) *Diag))

(INIT &quad BoundingBox
  (key ((&quad_cell ^Diag *P))
    (cell (P)
      (&quad_cell Diag *P))))

(RULE &filled
  (&quad_cell *Diag *P)
  (&block_cell P))

(RULE &echo_cell
  (&quad_cell *Diag (:P *P2))
  (NOT (&filled Diag))
  (&quad.box (:key Diag) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P2) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N)
  (dir8_opposite (:D Diag) (:D2 *O_m4))
  (edge_inset (:D O_m4) (:K N) (:B *B1_m5))
  (edge_inset (:D Diag) (:K N) (:B *I_m7))
  (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
  (compose (:A P2) (:B V_m3) (:C *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&echo_cell P))
      ((&echo (:C *Col)))
      ((= Col Col_in))))
