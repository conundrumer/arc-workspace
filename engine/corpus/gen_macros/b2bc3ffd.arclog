;; b2bc3ffd

(INPUT floor "a full line of floor_color lies along the floor_side edge of the grid")

(INPUT background "every cell that is neither floor nor object is background")

(INPUT objects "the objects are 4-connected single-color components of the cells that are neither background nor floor_color, and each object has a different color"

  (DET_OR_RULE &background DominantColor)

  (DET &floor_color UnchangedColor)

  (RULE &floor_color2
    (&floor_color *C))

  (RULE_OR_DET &floor_cell "The cells that stay as floor."
    (&floor_color2 (:C *Col))
    (input *P Col))

  (DET &floor_side DirDomain)

  (RULE &floor_side2
    (&floor_side *D))

  (RULE &ink
    (&floor_side2)
    (input *P *Col)
    (NOT (&background (:C Col)))
    (NOT (&floor_cell P)))

  (RULE &any4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &one8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &any8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &one8 Quotient
    (edge ((:a (:C Col) P) (:b (:C Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&one8_steps (:Delta *S2))
           (compose (:A P) (:B S2) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (INIT &any4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&any4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (INIT &any8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&any8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (INIT &color_id Quotient
    (equivalent ((:a Col) (:b Col))
      (&ink *Col))))

(INPUT grounded "each object touches the line next to the floor")

(INPUT fits "each object, moved away from the floor by its cell count, stays inside the grid")

(OUTPUT jump "each object moves away from the floor by a distance equal to its cell count, and keeps its shape and color; the cells moved past the far edge are lost; undefined where two moved objects of different colors land on one cell, or a moved object lands on a floor cell"

  (RULE &one4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &one4 Quotient
    (edge ((:a (:C Col) P) (:b (:C Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&one4_steps (:Delta *S2))
           (compose (:A P) (:B S2) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (RULE &one4_component
    (&one4.class (:a (:C *Key) *P) *Id))

  (RULE &heading
    (&floor_side2 (:D *D2))
    (opposite (:D D2) (:Opp *D)))

  (RULE &obj_cell
    (&one4_component (:Key *Col) *P (:Id *O)))

  (INIT &size Cardinality
    (key ((&obj_cell (:O ^Id) *P))
      (member ((:m P))
        (&obj_cell (:O Id) *P))))

  ;; Each line along the heading as a cycle that runs from the floor edge to
  ;; the far edge and back in at the floor edge.
  (INIT &cycle Walk
    (successor ((:p P) (:p_next Q))
      (&heading (:D *H))
      (input *P)
      (OR ((step_offset (:D H) (:V *V_m1))
           (compose (:A P) (:B V_m1) (:C *Q))
           (input (:P Q)))
          ((margin (:B P) (:D H) (:K 0))
           (&floor_side2 *D)
           (input (:P Q))
           (margin (:B Q) D (:K 0))
           (axis_of D *A)
           (perp A (:A2 *A2_m2))
           (axis_of (:D *D_m3) (:A A2_m2))
           (margin (:B P) (:D D_m3) (:K *K_m4))
           (margin (:B Q) (:D D_m3) (:K K_m4)))))
    (steps (N)
      (&size.size *N))))

(OUTPUT clear "the cells an object left, and that no moved object covers, become background")

(OUTPUT keep-floor "the floor stays as it is"

  (RULE &grounded
    (&obj_cell *O *P)
    (&floor_side2 *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (margin (:B Q) D (:K 0)))

  (INIT &box BoundingBox
    (key ((&obj_cell (:O ^Id) *P))
      (cell (P)
        (&obj_cell (:O Id) *P))))

  (RULE &lift
    (OR ((&grounded *O)
         (&size.size (:key (:Id O)) *N)
         (&box.box (:key (:Id O)) *B))
        ((&size.size (:key (:Id O)) N)
         (NOT (&grounded O))
         (&box.box (:key (:Id O)) B))))

  (RULE &shift
    (&lift *O (:B *B0) *N)
    (&heading (:D *H))
    (dir8_opposite (:D H) (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
    (edge_inset (:D H) (:K N) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A B0) (:B V_m1) (:C *B1))
    (&box.box (:key (:Id O)) *B)
    (relative (:Base B) (:X B1) (:X_rel *V)))

  (RULE &drift
    (&shift *O *V))

  (RULE &landing
    (&drift (:O *Id) *V)
    (&obj_cell (:O Id) *P *Col)
    (compose (:A P) (:B V) (:C *K))
    (input (:P K)))

  (INIT &top Order
    (key ((&landing (:K ^P) *Id *Col)
          (&size.size (:key Id) *N))
      (member ((:t (:V Col) (:S N)))
        (&landing (:K P) *Id *Col)
        (&size.size (:key Id) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&landing (:K P) *Id *Col)
        (&size.size (:key Id) *N)))))

(ALTS $s "where floor_side and floor_color come from" $FloorStored
  (ALT $FloorDerived
    (INPUT floor "the floor is the one edge line that is all one color other than background; floor_side and floor_color are read from it; undefined where no edge line, or more than one, is like that"
      (RULE &uniform_edge
        (dir_elem *D)
        (input *P *Col)
        (margin (:B P) D (:K 0))
        (ALL ((input (:P *Pm) (:Col *Colm))
              (margin (:B Pm) D (:K 0))
              (input (:P *Q) (:Col *Col2))
              (margin (:B Q) D (:K 0)))
             ((= Colm Col2)))
        (NOT (&background (:C Col))))

      (RULE &floor_side2
        (&uniform_edge *D)
        (ALL ((&uniform_edge (:D *D2)))
             ((= D D2))))

      (RULE &floor_color2
        (&floor_side2 *D)
        (&uniform_edge D (:Col *C))))))

(ALTS $e "which cells are floor, which stay and are not ink" $FloorColor
  (ALT $FloorLineOnly
    (INPUT objects "the objects are 4-connected single-color components of the cells that are neither background nor on the floor line; the floor is the floor line alone"
      (RULE &floor_cell
        (&floor_side2 *D)
        (input *P)
        (margin (:B P) D (:K 0)))))
  (ALT $FloorMoves
    (INPUT objects "the objects are 4-connected single-color components of the cells that are not background, the floor line included")
    (OUTPUT keep-floor "no cell is floor")))

(ALTS $o "what an object is" $Component
  (ALT $Component
    (ALTS $color "which ink cells join one component" $OneColor
      (ALT $MultiColor
        (INPUT objects "the objects are 4-connected components of the ink cells, of any colors, and an object jumps by its whole cell count"
          (RULE &any4_component
            (&any4.class (:a *P) *Id))
          (RULE &obj_cell
            (&any4_component *P (:Id *O))
            (&ink P *Col)))
        (ALT $Adj8
          (INPUT objects "the components are 8-connected"
            (RULE &any8_component
              (&any8.class (:a *P) *Id))
            (RULE &obj_cell
              (&any8_component *P (:Id *O))
              (&ink P *Col))))))
    (ALTS $adj "which cells count as touching" $Adj4
      (ALT $Adj8
        (INPUT objects "the components are 8-connected"
          (RULE &one8_component
            (&one8.class (:a (:C *Key) *P) *Id))
          (RULE &obj_cell
            (&one8_component (:Key *Col) *P (:Id *O)))))))
  (ALT $ColorClass
    (INPUT objects "all ink cells of one color form one object, wherever they lie"
      (RULE &obj_cell
        (&ink *P *Col)
        (&color_id.class (:a Col) (:Id *O))))))

(ALTS $f "how an object that does not touch the line next to the floor moves" $FromPlace
  (ALT $FromFloor
    (OUTPUT jump "an object that does not touch the line next to the floor lands with its cell nearest the floor its cell count past that line"
      (RULE &lift
        (OR ((&size.size (:key (:Id *O)) *N)
             (NOT (&grounded O))
             (&box.box (:key (:Id O)) (:B *B2))
             (&floor_side2 *D)
             (margin (:B B2) D (:K *M))
             (&obj_cell O *P)
             (margin (:B P) D (:K M))
             (input (:P *Q0))
             (margin (:B Q0) D (:K 0))
             (axis_of D *A)
             (perp A (:A2 *A2_m1))
             (axis_of (:D *D_m2) (:A A2_m1))
             (margin (:B P) (:D D_m2) (:K *K_m3))
             (margin (:B Q0) (:D D_m2) (:K K_m3))
             (&heading (:D *H))
             (step_offset (:D H) (:V *V_m4))
             (compose (:A Q0) (:B V_m4) (:C *Q))
             (relative (:Base P) (:X Q) (:X_rel *V))
             (compose (:A B2) (:B V) (:C *B)))
            ((&grounded O)
             (&size.size (:key (:Id O)) N)
             (&box.box (:key (:Id O)) B))))))
  (ALT $GroundedOnly
    (OUTPUT jump "an object that does not touch the line next to the floor stays"
      (RULE &lift
        (OR ((&grounded *O)
             (&size.size (:key (:Id O)) *N)
             (&box.box (:key (:Id O)) *B))
            ((&size.size (:key (:Id O)))
             (NOT (&grounded O))
             (&box.box (:key (:Id O)) B)
             (= N 0)))))))

(ALTS $ov "what happens to cells that a jump takes past the far edge" $Lost
  (ALT $Clamp
    (OUTPUT jump "an object that would leave the grid moves only until it reaches the far edge"
      (RULE &escapes
        (&shift *O *V)
        (&box.box (:key (:Id O)) *B)
        (compose (:A B) (:B V) (:C *B2))
        (&heading (:D *H))
        (margin (:B B2) (:D H) *K)
        (< K 0))

      (RULE &drift
        (OR ((&shift *O *V)
             (NOT (&escapes O)))
            ((&escapes O)
             (&box.box (:key (:Id O)) *B)
             (&heading (:D *H))
             (margin B (:D H) *K)
             (dir8_opposite (:D H) (:D2 *O_m1))
             (edge_inset (:D O_m1) K (:B *B1_m2))
             (edge_inset (:D H) K (:B *I_m4))
             (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C V)))))))
  (ALT $Wrap
    (OUTPUT jump "a cell moved past the far edge comes back in at the floor edge of its line and goes on from there"
      (RULE &landing
        (&lift (:O *Id) (:B *B0) *N)
        (&obj_cell (:O Id) *P *Col)
        (&box.box (:key Id) *B)
        (ALL ((&obj_cell (:O *Idm) P (:Col *Colm))
              (&box.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base B) (:X P) (:X_rel *P_rel))
        (compose (:A B0) (:B P_rel) (:C *P2))
        (&cycle.walk (:p0 P2) N (:p *K))))))

(ALTS $co "which color a cell takes when two moved objects land on it" $Clash
  (ALT $LargerOnTop
    (OUTPUT larger-on-top "where two moved objects land on one cell, the object with more cells paints over the other")
    (RULE &output
      (OR ((&top.maximal (:key *P) (:t (:V *Col))))
          ((&floor_side2)
           (input P (:Col *Col0))
           (OR ((NOT (&floor_cell P))
                (NOT (&landing (:K P)))
                (&background (:C Col)))
               ((&floor_cell P)
                (= Col Col0)))))))
  (ALT $SmallerOnTop
    (OUTPUT smaller-on-top "where two moved objects land on one cell, the object with fewer cells paints over the other")
    (RULE &output
      (OR ((&top.minimal (:key *P) (:t (:V *Col))))
          ((&floor_side2)
           (input P (:Col *Col0))
           (OR ((NOT (&floor_cell P))
                (NOT (&landing (:K P)))
                (&background (:C Col)))
               ((&floor_cell P)
                (= Col Col0))))))))

(RULE &output
  (OR ((&floor_side2)
       (input *P (:Col *Col0))
       (OR ((NOT (&floor_cell P))
            (NOT (&landing (:K P)))
            (&background (:C *Col)))
           ((&floor_cell P)
            (= Col Col0))))
      ((&landing (:K P) Col))))
