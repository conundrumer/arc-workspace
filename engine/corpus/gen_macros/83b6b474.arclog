;; 83b6b474

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background is the commonest color.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &bg
  (&field.maximal (:t *Col)))

;; The box each color's shape occupies.
(INIT &bbox BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg Col)))
    (cell (P)
      (input *P Col)
      (NOT (&bg Col)))))

(RULE &cand_side
  (input *P)
  (axis_elem *A)
  (OR ((frame_extent P A (:N *K)))
      ((sub_extent P A K))))

(INIT &square Frame
  (key ((&cand_side ^K))
    (extent (A (:N K))
      (axis_elem *A))))

(RULE &border
  (&square.cell (:key *K) *P)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(INIT &border_size Cardinality
  (key ((&border ^K *P))
    (member ((:m P))
      (&border K *P))))

(INIT &shape_size Cardinality
  (member ((:m P))
    (&bbox.cell *P)))

(RULE &side
  (&shape_size.size *N)
  (&border_size.size (:key *K) N))

(RULE &ring
  (&side *K)
  (&border K *P))

;; Where a shape lands with each of its cells on the ring.
(INIT &occ Occurrences
  (key ((OR ((&bbox.cell (:key ^Col) *P)
             (&bbox.box (:key Col) *B)
             (ALL ((&bbox.cell (:key (:Col *Colm)) P)
                   (&bbox.box (:key (:Col Colm)) B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X P) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (relative (:Base B) (:X P) (:X_rel *P_inner)))
            ((&bbox.cell (:key Col))
             (&ring P))))
    (cell (P)
      (&bbox.cell)
      (&ring *P))
    (shape ((:P P_inner))
      (&bbox.cell *P)
      (&bbox.box *B)
      (ALL ((&bbox.cell (:key (:Col *Colm)) P)
            (&bbox.box (:key (:Col Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))))

(RULE &covers
  (&occ.occurrence (:key *Col) (:P *B))
  (&occ.shape (:key Col) (:P *P_inner))
  (compose (:A B) (:B P_inner) (:C *P)))

(CHOOSE &pruning
  (for ((&occ.occurrence (:key ^Col)))
    (from (&occ.occurrence (:key Col) (:P *B))))
  (never
    (&occ.occurrence (:key *Col) (:P *B))
    (&occ.occurrence (:key (:Col *Col2)) (:P *B2))
    (&covers Col B *P)
    (&covers (:Col Col2) (:B B2) P)))

(RULE &output
  (&side *K)
  (&square.cell (:key K) *P)
  (OR ((&pruning *Col (:B *Cd_b))
       (&covers (:Col *Cd_col) (:B Cd_b) P))
      ((NOT (&ring P))
       (&bg Col))))
