;; 89565ca0

(RULE &piece_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &piece Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&ink *P *Col)
         (&piece_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3) Col))
        ((&ink P Col)
         (= P3 P)))))

(RULE &piece_component
  (&piece.class (:a *Key *P) *Id))

(INIT &scattered_count Cardinality
  (key ((&piece_component (:Key ^Col) *Id))
    (member ((:m Id))
      (&piece_component (:Key Col) *Id))))

;; The specks are the color that lies in the most pieces.
(INIT &scattered Order
  (member ((:t Col))
    (&scattered_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&scattered_count.size (:key *Col) *N)))

(RULE &speck
  (&scattered.maximal (:t *Col)))

(RULE &frame
  (&ink *Col)
  (NOT (&speck Col)))

(RULE &run_on_dir
  (&frame (:Col *F))
  (dir_elem *D))

(RULE &run_on_blocked
  (&frame (:Col *F))
  (dir_elem *D)
  (input *P *Col)
  (&bg (:C Col)))

(RULE &run_on_node
  (&frame (:Col *F))
  (dir_elem *D)
  (input *P)
  (NOT (&run_on_blocked F D P)))

(RULE &run_on_source
  (&ink *P (:Col *F))
  (&frame (:Col F))
  (dir_elem *D)
  (opposite D (:Opp *O))
  (step_offset (:D O) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&ink (:P Q) (:Col F)))

;; A line of frame f runs on toward d from a cell of f with another cell of f
;; behind it, over hidden cells, until background stops it.
(INIT &run_on Distance
  (key ((&run_on_source (:F ^Ky_f) (:D ^Ky_d) (:P ^O))
        (&run_on_dir (:F Ky_f) (:D Ky_d)))
    (edge ((:a A2) (:b Q))
      (OR ((&run_on_source (:F Ky_f) (:D Ky_d) (:P O))
           (&run_on_dir (:F Ky_f) (:D Ky_d))
           (axis_of (:D Ky_d) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky_d) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky_d) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_on_node (:F Ky_f) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_on_node (:F Ky_f) (:D Ky_d) (:P Q)))
          ((&run_on_source (:F Ky_f) (:D Ky_d) (:P O))
           (&run_on_dir (:F Ky_f) (:D Ky_d))
           (step_offset (:D Ky_d) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_on_node (:F Ky_f) (:D Ky_d) (:P Q))
           (= A2 O))
          ((&run_on_source (:F Ky_f) (:D Ky_d) (:P O))
           (&run_on_dir (:F Ky_f) (:D Ky_d))
           (diag_dir_elem (:D Ky_d))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky_d) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky_d) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_on_node (:F Ky_f) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_on_node (:F Ky_f) (:D Ky_d) (:P Q)))))
    (source ((:n O))
      (&run_on_source (:F Ky_f) (:D Ky_d) (:P O))
      (&run_on_dir (:F Ky_f) (:D Ky_d)))))

(RULE &run_on_ray
  (&run_on.distance (:key (:Ky_f *F) (:Ky_d *Key_d) (:Ky_d *D) (:O *Origin)) (:n *P) *K))

(RULE &run_on_end
  (&run_on_ray *F *Key_d *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_on_ray F Key_d (:P Q) D Origin)))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &run_on_cell
  (&frame (:Col *F))
  (dir_elem *D)
  (input *P))

(RULE &line
  (OR ((&frame (:Col *F))
       (&ink *P (:Col F)))
      ((&run_on_ray F P)
       (&run_on_cell F P))))

(RULE &closed_cell
  (&frame (:Col *Key))
  (input *P)
  (NOT (&line (:F Key) P)))

(RULE &closed_flood_node
  (&frame (:Col *Key))
  (input *P)
  (NOT (&line (:F Key) P)))

(INIT &closed_flood Propagation
  (key ((OR ((&closed_cell (:Key ^Ky) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&closed_flood_node (:Key Ky) P))
            ((&closed_flood_node (:Key Ky) P)
             (&closed_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&closed_flood_node (:Key Ky) (:P Q)))))
    (source ((:n P))
      (&closed_cell (:Key Ky) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&closed_flood_node (:Key Ky) P))
    (edge ((:a P) (:b Q))
      (&closed_flood_node (:Key Ky) *P)
      (&closed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&closed_flood_node (:Key Ky) (:P Q)))))

(RULE &closed_node
  (&closed_cell *Key *P)
  (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

;; The space a frame's lines leave.
(INIT &closed Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&closed_node (:Key *Ky) *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:Key Ky) (:P P2)))
        ((&closed_node (:Key Ky) P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *Key *P) *Id))

;; The chart's layout: rows counted from rank_dir, bars growing from the edge a quarter turn away.
(DET &rank_dir DirDomain)

(DET &bar_sense SenseDomain)

(INIT &size Cardinality
  (key ((OR ((&closed_component (:Key ^F) *Id))
            ((&frame (:Col F)))))
    (member ((:m Id))
      (&closed_component (:Key F) *Id))
    (domain ()
      (&frame (:Col F)))))

(RULE &bar_dir
  (&rank_dir (:D *D3))
  (&bar_sense *S)
  (turn S (:D D3) (:D2 *D)))

(INIT &frames Cardinality
  (member ((:m F))
    (&frame (:Col *F))))

(INIT &widest Order
  (member ((:t N))
    (&size.size *N))
  (score ((:t N) (:S N))
    (&size.size *N)))

(INIT &chart Frame
  (extent (A N)
    (OR ((&rank_dir *D)
         (axis_of D *A)
         (&frames.size *N))
        ((&bar_dir (:D *D2))
         (axis_of (:D D2) A)
         (&widest.maximal (:t N))))))

(RULE &row
  (&chart.cell *P)
  (&rank_dir *D)
  (margin (:B P) D *K))

(INIT &fewer Order
  (member ((:t F))
    (&frame (:Col *F)))
  (before ((:a F1) (:b F2))
    (&size.size (:key (:F *F1)) (:N *N1))
    (&size.size (:key (:F *F2)) (:N *N2))
    (< N1 N2)))

(RULE &ties
  (&row *K)
  (&fewer.rank (:t *F) *R)
  (<= R K)
  (ONE K)
  (ONE F))

(RULE &output
  (&chart.cell *P)
  (&rank_dir *D)
  (margin (:B P) D *K)
  (&ties *F K)
  (&size.size (:key F) *N)
  (&bar_dir (:D *Db))
  (margin (:B P) (:D Db) (:K *K2))
  (OR ((>= K2 N)
       (&speck *Col))
      ((< K2 N)
       (= Col F))))
