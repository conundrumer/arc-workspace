;; c64f1187

(INPUT legend "a row of entries, each a marker cell of its own color with a shape of &shape_color drawn in the tile-sized box whose &marker_corner corner the marker touches diagonally from outside"

  (DET &drawn
    (ex_output *E))

  (INIT &color_mode_count Cardinality
    (key ((ex_input ^E *P ^Col))
      (member ((:m P))
        (ex_input E *P Col))))

  (INIT &color_mode Order
    (key ((&color_mode_count.size (:key ^E *Col)))
      (member ((:t Col))
        (&color_mode_count.size (:key E *Col)))
      (score ((:t Col) (:S N))
        (&color_mode_count.size (:key E *Col) *N))))

  (DET &background_defect
    (&color_mode.maximal (:t *C))
    (&drawn *E)
    (NOT (&color_mode.maximal (:key E) (:t C))))

  (DET_OR_RULE &background DominantColor
    (&color_mode.maximal (:t *C))
    (NOT (&background_defect C)))

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &cell
    (input *P *Col))

  (RULE &piece_node
    (&cell *P *Col)
    (NOT (&background (:C Col))))

  ;; The 4-connected pieces of ink.
  (INIT &piece Quotient
    (edge ((:a P) (:b P2))
      (OR ((&piece_node *P)
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&piece_node (:P P2)))
          ((&piece_node P)
           (= P2 P)))))

  (RULE &piece_component
    (&piece.class (:a *P) *Id))

  (INIT &piece_box BoundingBox
    (key ((&piece_component *P ^Id))
      (cell (P)
        (&piece_component *P Id))))

  (DET &piece_color
    (&piece_component *E *P *Id)
    (ex_input E P *Col))

  (DET &mixed
    (&piece_color *E *Id (:Col *C1))
    (&piece_color E Id (:Col *C2))
    (!= C1 C2))

  (DET &tile_color_defect
    (&piece_color (:Col *C))
    (&drawn *E)
    (&mixed E *Id)
    (NOT (&piece_color E Id (:Col C))))

  (DET &tile_color3
    (&piece_color (:Col *C))
    (NOT (&tile_color_defect C)))

  (DET &tile_color2
    (ex_input *E *Col)
    (&tile_color3 (:C Col)))

  (DET &tile_piece2
    (&piece_component *E *P *Id)
    (&cell E P *Col)
    (&tile_color2 E Col))

  (DET &code_at
    (&tile_piece2 *E *Id)
    (&piece_component E *P Id)
    (ex_input E P *Col)
    (NOT (&tile_color3 (:C Col)))
    (&piece_box.box E (:key Id) *B))

  (DET &marker
    (&code_at *E *P)
    (ex_input E P *Col)
    (ex_input E (:P *M) Col)
    (&piece_component E (:P M) *Id)
    (NOT (&tile_piece2 E Id)))

  (DET &free_ink
    (&drawn *E)
    (&piece_component E *P *Id)
    (NOT (&tile_piece2 E Id))
    (ex_input E P *Col)
    (NOT (&marker E (:M P)))
    (NOT (ex_output E Col)))

  (DET &shape_color_defect
    (&free_ink (:Col *C))
    (&drawn *E)
    (NOT (&free_ink E (:Col C))))

  (DET &shape_color
    (&free_ink (:Col *C))
    (NOT (&shape_color_defect C)))

  (DET &shape_past
    (&marker *E *M)
    (diag_dir_elem *D)
    (corner_dir (:C D) (:A *A_m1) (:D *D1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (corner_dir (:C D) (:A A2_m2) (:D *D2))
    (opposite (:D D1) (:Opp *D1_far))
    (opposite (:D D2) (:Opp *D2_far))
    (ex_input E (:P *Q) *Col)
    (&shape_color (:C Col))
    (dir_elem (:D D1_far))
    (margin (:B Q) (:D D1_far) (:K *K1_m3))
    (margin (:B M) (:D D1_far) (:K *K2_m4))
    (< K1_m3 K2_m4)
    (dir_elem (:D D2_far))
    (margin (:B Q) (:D D2_far) (:K *K1_m5))
    (margin (:B M) (:D D2_far) (:K *K2_m6))
    (< K1_m5 K2_m6))

  (DET &marker_corner_defect
    (&drawn *E)
    (&marker E *M)
    (diag_dir_elem *D)
    (NOT (&shape_past E D M)))

  (DET &marker_corner
    (diag_dir_elem *D)
    (NOT (&marker_corner_defect D))))

(INPUT tile-grid "a rectangular grid of 2 by 2 tiles of &tile_color, apart from the legend, with a 1-wide line of background between neighboring tiles"

  (INIT &ink_mode_count Cardinality
    (key ((&cell *P ^Col)
          (NOT (&background (:C Col))))
      (member ((:m P))
        (&cell *P Col)
        (NOT (&background (:C Col))))))

  ;; The commonest colors of the ink.
  (INIT &ink_mode Order
    (member ((:t Col))
      (&ink_mode_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&ink_mode_count.size (:key *Col) *N)))

  (RULE &tile_color_of
    (&tile_color3 (:C *Col)))

  (RULE &tile_color
    (&tile_color_of *Col)))

(INPUT code "a tile holds at most one cell of another color, at its bottom-right cell, and that color is the color of a legend marker")

(INPUT background "every other cell is &background")

(OUTPUT crop-to-tiles "the output is the bounding box of the tile grid, and the gaps stay background"

  (DET &bg_run_dir
    (&drawn (:E *Key))
    (dir_elem *D))

  (DET &bg_run_node
    (ex_input (:E *Key) *P *Col)
    (&background (:C Col)))

  (DET &bg_run_node_ray
    (&bg_run_node *Key *P))

  (DET &bg_run_source
    (&bg_run_node *Key *P))

  (INIT &bg_run Distance
    (key ((&bg_run_source (:Key ^Ky) (:P ^O))
          (&bg_run_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&bg_run_source (:Key Ky) (:P O))
             (&bg_run_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&bg_run_node_ray (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&bg_run_node_ray (:Key Ky) (:P Q)))
            ((&bg_run_source (:Key Ky) (:P O))
             (&bg_run_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&bg_run_node_ray (:Key Ky) (:P Q))
             (= A2 O))
            ((&bg_run_source (:Key Ky) (:P O))
             (&bg_run_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&bg_run_node_ray (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&bg_run_node_ray (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&bg_run_source (:Key Ky) (:P O))
        (&bg_run_dir (:Key Ky) D))))

  (DET &bg_run_ray
    (&bg_run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (DET &bg_run_end
    (&bg_run_ray *Key *P *D *K *Origin)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (NOT (&bg_run_ray Key (:P Q) D Origin)))

  ;; The corner of the tile region the lattice runs from.
  (DET &lattice_corner DiagDirDomain)

  (RULE &tile_piece
    (&piece_component *P *Id)
    (&cell P *Col)
    (&tile_color Col))

  ;; The tile region.
  (INIT &region BoundingBox
    (cell ((:P B))
      (&tile_piece *Id)
      (&piece_box.box (:key Id) *B)))

  (INIT &tile_extent Singleton
    (key ((axis_elem ^A)
          (axis_elem A))
      (member ((:v N))
        (&tile_piece *Id)
        (&piece_box.box (:key Id) *B)
        (&piece_component *P Id)
        (relative (:Base B) (:X P) (:X_rel *R_m1))
        (frame_extent (:P R_m1) A *N))))

  (RULE_OR_DET &tile_size "The extent of a tile, and of a legend box, on each axis."
    (&tile_extent.value (:key *A) (:v *N)))

  (INIT &box_frame Frame
    (extent (A N)
      (&tile_size *A *N)))

  (RULE &box_corner_cell
    (&box_frame.cell (:P *K))
    (diag_dir_elem *D)
    (relative (:Base 0) (:X K) (:X_rel *R_m1))
    (axis_of (:D *D1_m2) (:A *A1_m3))
    (opposite (:D D1_m2) (:Opp *O1_m4))
    (perp (:A A1_m3) (:A2 *A2_m5))
    (axis_of (:D *D2_m6) (:A A2_m5))
    (opposite (:D D2_m6) (:Opp *O2_m7))
    (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
    (>= K1_m8 0)
    (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
    (>= K2_m9 0)
    (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
    (>= K3_m10 0)
    (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
    (>= K4_m11 0)
    (corner_dir (:C D) (:A *A_m12) (:D *D1_m13))
    (perp (:A A_m12) (:A2 *A2_m14))
    (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
    (margin (:B K) (:D D1_m13) (:K *K1_m16))
    (margin (:B 0) (:D D1_m13) (:K K1_m16))
    (margin (:B K) (:D D2_m15) (:K *K2_m17))
    (margin (:B 0) (:D D2_m15) (:K K2_m17)))

  (INIT &gap_run Order
    (member ((:t G))
      (&drawn *E)
      (ex_input E *P (:Col *C1))
      (&tile_color3 (:C C1))
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&bg_run_end (:Key E) (:P *R) D (:Origin Q))
      (step_offset D (:V *V_m2))
      (compose (:A R) (:B V_m2) (:C *S))
      (ex_input E (:P S) (:Col *C2))
      (&tile_color3 (:C C2))
      (axis_of D *A)
      (sub_extent P A (:K *G))
      (dir8_opposite D (:D2 *O_m4))
      (edge_inset (:D O_m4) (:K G) (:B *B1_m5))
      (edge_inset D (:K G) (:B *I_m7))
      (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
      (compose (:A P) (:B V_m3) (:C R)))
    (score ((:t G) (:S G))
      (&drawn *E)
      (ex_input E *P (:Col *C1))
      (&tile_color3 (:C C1))
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&bg_run_end (:Key E) (:P *R) D (:Origin Q))
      (step_offset D (:V *V_m2))
      (compose (:A R) (:B V_m2) (:C *S))
      (ex_input E (:P S) (:Col *C2))
      (&tile_color3 (:C C2))
      (axis_of D *A)
      (sub_extent P A (:K *G))
      (dir8_opposite D (:D2 *O_m4))
      (edge_inset (:D O_m4) (:K G) (:B *B1_m5))
      (edge_inset D (:K G) (:B *I_m7))
      (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
      (compose (:A P) (:B V_m3) (:C R))))

  (DET &gap
    (&gap_run.minimal (:t *K)))

  (RULE &lattice_origin
    (&region.box (:B *R))
    (input (:P *C))
    (ALL ((&region.box (:B R))
          (dir_elem (:D *D_m1))
          (relative (:Base R) (:X C) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base R) (:X C) (:X_rel *C_rel))
    (&lattice_corner *D)
    (corner_dir (:C D) (:A *A1) (:D *D1))
    (perp (:A A1) (:A2 *A2_m1))
    (corner_dir (:C D) (:A A2_m1) (:D *D2))
    (perp (:A A1) *A2)
    (margin (:B C_rel) (:D D1) (:K *T1))
    (margin (:B C_rel) (:D D2) (:K *T2))
    (&tile_size (:A A1) (:N *W1))
    (&tile_size (:A A2) (:N *W2))
    (&gap (:K *G))
    (divide (:T T1) (:Side W1) (:Gap G) (:Remainder 0))
    (divide (:T T2) (:Side W2) (:Gap G) (:Remainder 0)))

  (RULE &lattice_tile
    (&lattice_origin *C)
    (&lattice_corner *D)
    (&box_corner_cell D *K)
    (relative (:Base K) (:X C) (:X_rel *B))
    (&region.box (:B *R))
    (ALL ((&box_corner_cell (:D *Dm) (:K *Km))
          (&lattice_origin (:C *Cm))
          (relative (:Base Km) (:X Cm) (:X_rel B))
          (&region.box (:B R))
          (dir_elem (:D *D_m1))
          (relative (:Base R) (:X B) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (INIT &lattice_frame BoundingBox
    (cell ((:P B))
      (&lattice_tile *B))))

(OUTPUT stamp-shape "a tile with a code takes the legend shape of the code's color, each shape cell at the same place in the tile as in its legend box, in the code's color, and the tile's other cells become background"

  (RULE &box_offset
    (&box_corner_cell *D *K)
    (&box_frame.cell *P)
    (relative (:Base K) (:X P) (:X_rel *W)))

  (RULE &tile_cell
    (&tile_piece *Id)
    (&piece_box.box (:key Id) *B)
    (&piece_component *P Id))

  (RULE &code_cell
    (&tile_cell *B *P)
    (input P *Col)
    (NOT (&tile_color_of Col))
    (NOT (&background (:C Col))))

  (RULE &tile_code
    (&code_cell *B *P)
    (input P *Col))

  (RULE &marker2
    (&tile_code *Col)
    (input (:P *M) Col)
    (NOT (&tile_cell (:P M))))

  (RULE &legend_box
    (&marker2 *M)
    (diag_dir_elem *D)
    (diag_opposite D (:Opp *D_in))
    (step_offset (:D D_in) (:V *V_m1))
    (compose (:A M) (:B V_m1) (:C *K)))

  (RULE &legend_cell
    (&legend_box *D *M *K)
    (&box_offset D *W)
    (compose (:A K) (:B W) (:C *Q)))

  (RULE &corner_of
    (&marker_corner *D))

  (RULE &shape_ink
    (&shape_color (:C *Col))
    (input (:P *Q) Col))

  (RULE &shape_cell
    (&corner_of *D)
    (&marker2 *M *Col)
    (&legend_cell D M *Q)
    (&shape_ink Q))

  (INIT &shape_box BoundingBox
    (key ((&shape_cell ^Col *Q))
      (cell ((:P Q))
        (&shape_cell Col *Q)))))

(OUTPUT blank-tile "a tile with no code becomes background")

(ALTS $legend "which shape a marker names" $InBox
  (ALT $InBox
    (ALTS $place "where a shape cell lands in its tile" $BoxPlace
      (ALT $BboxAnchor
        (OUTPUT stamp-shape "a shape's bounding box sits at the tile's &marker_corner corner")
        (RULE &shape_anchor
          (&shape_box.box (:key *Col) *B)
          (&corner_of *D)
          (input (:P *A))
          (ALL ((&shape_box.box (:key (:Col *Colm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X A) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (ALL ((&corner_of D)
                (&shape_box.box (:key (:Col *Colmm)) B)
                (corner_dir (:C D) (:D *D_m1m))
                (margin (:B A) (:D D_m1m) (:K *K1_m2))
                (margin B (:D D_m1m) (:K *K2_m3)))
               ((= K1_m2 K2_m3)))))))
  (ALT $ByOrder
    (INPUT legend "the markers and the pieces of shape ink outside the tiles are each ranked along &order_axis from &marker_corner, and a marker names the piece of its rank"
      (RULE &order_piece_steps
        (dir_elem *D)
        (step_offset D (:V *Delta)))

      ;; The pieces of shape ink outside the tiles.
      (INIT &order_piece Quotient
        (edge ((:a Q) (:b P))
          (OR ((&shape_ink *Q)
               (NOT (&tile_cell (:P Q)))
               (&order_piece_steps (:Delta *S))
               (compose (:A Q) (:B S) (:C *P))
               (&shape_ink (:Q P))
               (NOT (&tile_cell P)))
              ((&shape_ink Q)
               (NOT (&tile_cell (:P Q)))
               (= P Q)))))

      (RULE &order_piece_component
        (&order_piece.class (:a *P) *Id))

      (INIT &order_piece_box BoundingBox
        (key ((&order_piece_component (:P *Q) ^Id))
          (cell ((:P Q))
            (&order_piece_component (:P *Q) Id))))

      (RULE &piece_corner
        (&order_piece_box.box (:key *Id) *B)
        (&corner_of *D)
        (input (:P *A))
        (ALL ((&order_piece_box.box (:key (:Id *Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X A) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (ALL ((&corner_of D)
              (&order_piece_box.box (:key (:Id *Idmm)) B)
              (corner_dir (:C D) (:D *D_m1m))
              (margin (:B A) (:D D_m1m) (:K *K1_m2))
              (margin B (:D D_m1m) (:K *K2_m3)))
             ((= K1_m2 K2_m3))))

      (DET &marker_line
        (&marker *E (:M *M1))
        (&marker E (:M *M2))
        (axis_elem *A)
        (perp A (:A2 *A2_m1))
        (axis_of (:D *D_m2) (:A A2_m1))
        (margin (:B M1) (:D D_m2) (:K *K_m3))
        (margin (:B M2) (:D D_m2) (:K K_m3)))

      (DET &order_axis_defect
        (&drawn *E)
        (&marker E (:M *M1))
        (&marker E (:M *M2))
        (axis_elem *A)
        (NOT (&marker_line E M1 M2 A)))

      (DET &order_axis
        (axis_elem *A)
        (NOT (&order_axis_defect A)))

      (RULE &rank_axis
        (&order_axis *A))

      (INIT &marker_order Order
        (member ((:t M))
          (&marker2 *M))
        (before ((:a M) (:b M2))
          (&marker2 *M)
          (&marker2 (:M *M2))
          (&corner_of *D)
          (&rank_axis *A)
          (OR ((corner_dir (:C D) A (:D *D2))
               (dir_elem (:D D2))
               (margin (:B M) (:D D2) (:K *K1_m1))
               (margin (:B M2) (:D D2) (:K *K2_m2))
               (< K1_m1 K2_m2))
              ((corner_dir (:C D) A (:D D2))
               (perp A (:A2 *A2_m3))
               (corner_dir (:C D) (:A A2_m3) (:D *D22))
               (margin (:B M) (:D D2) (:K *K_m4))
               (margin (:B M2) (:D D2) (:K K_m4))
               (dir_elem (:D D22))
               (margin (:B M) (:D D22) (:K *K1_m5))
               (margin (:B M2) (:D D22) (:K *K2_m6))
               (< K1_m5 K2_m6)))))

      (INIT &piece_order Order
        (member ((:t A))
          (&piece_corner *A))
        (before ((:a A) (:b A2))
          (&piece_corner *A)
          (&piece_corner (:A *A2))
          (&corner_of *D)
          (&rank_axis (:A *A3))
          (OR ((corner_dir (:C D) (:A A3) (:D *D2))
               (dir_elem (:D D2))
               (margin (:B A) (:D D2) (:K *K1_m1))
               (margin (:B A2) (:D D2) (:K *K2_m2))
               (< K1_m1 K2_m2))
              ((corner_dir (:C D) (:A A3) (:D D2))
               (perp (:A A3) (:A2 *A2_m3))
               (corner_dir (:C D) (:A A2_m3) (:D *D22))
               (margin (:B A) (:D D2) (:K *K_m4))
               (margin (:B A2) (:D D2) (:K K_m4))
               (dir_elem (:D D22))
               (margin (:B A) (:D D22) (:K *K1_m5))
               (margin (:B A2) (:D D22) (:K *K2_m6))
               (< K1_m5 K2_m6))))))
    (OUTPUT stamp-shape "a shape's bounding box sits at the tile's &marker_corner corner"
      (RULE &shape_cell
        (&marker2 *M *Col)
        (&marker_order.rank (:t M) *R)
        (&piece_order.rank (:t *A) R)
        (&piece_corner *Id A)
        (&order_piece_component (:P *Q) Id)))
    (RULE &shape_anchor
      (&shape_box.box (:key *Col) *B)
      (&corner_of *D)
      (input (:P *A))
      (ALL ((&shape_box.box (:key (:Col *Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X A) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((&corner_of D)
            (&shape_box.box (:key (:Col *Colmm)) B)
            (corner_dir (:C D) (:D *D_m1m))
            (margin (:B A) (:D D_m1m) (:K *K1_m2))
            (margin B (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))))

(ALTS $corner "the corner of a legend box that its marker touches" $StoredCorner
  (ALT $DerivedCorner
    (INPUT legend "the corner is the one at which every marker's box holds a shape cell; undefined where no corner or more than one does"
      (RULE &box_inked
        (&legend_cell *D *M *Q)
        (&shape_ink Q))

      (RULE &corner_defect
        (&marker2 *M)
        (diag_dir_elem *D)
        (NOT (&box_inked D M)))

      (RULE &corner_fit
        (diag_dir_elem *D)
        (NOT (&corner_defect D)))

      (RULE &corner_tie
        (&corner_fit (:D *D1))
        (&corner_fit (:D *D2))
        (!= D1 D2))

      (RULE &corner_of
        (&corner_fit *D)
        (NOT (&corner_tie))))))

(ALTS $ink "which cells of a legend box are the shape" $ShapeColor
  (ALT $AnyInk
    (INPUT legend "a shape is every cell of its box that is not &background, in no tile and no marker"
      (RULE &shape_ink
        (input (:P *Q) *Col)
        (NOT (&background (:C Col)))
        (NOT (&tile_cell (:P Q)))
        (NOT (&marker2 (:M Q)))))))

(ALTS $code "which cell of a tile is its code" $OddCell
  (ALT $CodeAtCorner
    (INPUT code "a tile's code is its cell at &code_corner, where that cell is neither the tile color nor background; defined on a tile with two such cells"
      (DET &code_at_corner_inside1
        (&code_at *E (:P *P_) (:B *B_))
        (dir_elem (:D *D_m1))
        (relative (:Base B_) (:X P_) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (DET &code_at_corner_corner_anchor1
        (diag_dir_elem (:D *D_))
        (&code_at *E (:P *P_) (:B *B_))
        (corner_dir (:C D_) (:D *D_m1))
        (margin (:B P_) (:D D_m1) (:K *K1_m2))
        (margin (:B B_) (:D D_m1) (:K *K2_m3))
        (!= K1_m2 K2_m3))

      (DET &code_at_corner
        (&code_at *E *P *B)
        (diag_dir_elem *D)
        (NOT (&code_at_corner_inside1 (:P_ P) (:B_ B)))
        (NOT (&code_at_corner_corner_anchor1 (:D_ D) (:P_ P) (:B_ B))))

      (DET &code_corner_defect
        (&drawn *E)
        (diag_dir_elem *D)
        (NOT (&code_at_corner E D)))

      (DET &code_corner
        (diag_dir_elem *D)
        (NOT (&code_corner_defect D)))

      (RULE &code_cell
        (&tile_cell *B *P)
        (&code_corner *D)
        (ALL ((&tile_cell B P)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (ALL ((&tile_cell B P)
              (corner_dir (:C D) (:D *D_m1m))
              (margin (:B P) (:D D_m1m) (:K *K1_m2))
              (margin B (:D D_m1m) (:K *K2_m3)))
             ((= K1_m2 K2_m3)))
        (input P *Col)
        (NOT (&tile_color_of Col))
        (NOT (&background (:C Col)))))))

(ALTS $tcol "the color of the tiles" $StoredTileColor
  (ALT $TileColorByCount
    (INPUT tile-grid "the tile color is the commonest color other than &background; undefined on a tie"
      (RULE &tile_color_of
        (&ink_mode.maximal (:t *Col))
        (ALL ((&ink_mode.maximal (:t *C1))
              (&ink_mode.maximal (:t *C2)))
             ((= C1 C2)))))))

(ALTS $parse "how the tiles are found" $Pieces
  (ALT $Lattice
    (INPUT tile-grid "the tiles lie on a lattice that runs from the &lattice_corner corner of the tile region, each of the tile extent, at a stride of that extent plus &gap; the tiles are the lattice boxes that lie wholly in the region"
      (RULE &tile_cell
        (&lattice_tile *B)
        (input *P)
        (ALL ((&lattice_tile B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))))
    (RULE &frame
      (&lattice_frame.box *B))))

(RULE &code_clash
  (&code_cell *B (:P *P1))
  (&code_cell B (:P *P2))
  (!= P1 P2))

(RULE &shape_anchor
  (&corner_of *D)
  (&marker2 *M *Col)
  (&legend_box D M (:K *A)))

(RULE &shape
  (&shape_cell *Col *Q)
  (&shape_anchor Col *A)
  (relative (:Base A) (:X Q) (:X_rel *W)))

(RULE &stamp
  (&shape *Col *W)
  (&tile_code *B Col)
  (&corner_of *D)
  (&tile_cell B (:P *C))
  (ALL ((&tile_cell B (:P C))
        (&tile_code B (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X C) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((&corner_of D)
        (&tile_cell B (:P C))
        (&tile_code B (:Col *Colmm))
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B C) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (compose (:A C) (:B W) (:C *P)))

(RULE &frame
  (&region.box *B))

(RULE &output
  (&corner_of)
  (&frame *B)
  (NOT (&code_clash))
  (input (:P *P2))
  (ALL ((&frame B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&stamp (:P P2) *Col))
      ((NOT (&stamp (:P P2)))
       (&background (:C Col)))))
