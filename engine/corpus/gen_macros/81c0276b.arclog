;; 81c0276b

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &lattice_divider
  (&line_color.value (:key *A *L)))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET &bg DominantColor)

;; The chart's layout: rows counted from rank_dir, bars growing from the edge a quarter turn away.
(DET &rank_dir DirDomain)

(DET &bar_sense SenseDomain)

(RULE &bar_dir
  (&rank_dir (:D *D3))
  (&bar_sense *S)
  (turn S (:D D3) (:D2 *D)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&line_color.value (:v Col))))

(INIT &slots Cardinality
  (key ((&lattice_tile_of *P (:P_tile *T))
        (&ink P ^Col))
    (member ((:m T))
      (&lattice_tile_of *P (:P_tile *T))
      (&ink P Col))))

(RULE &bar
  (&slots.size (:key *Col) *N))

(ALTS $choice "what is counted for each color's bar, diverging when a slot holds several pieces of one color" $Tiles
  (ALT $Objects
    (RULE &blob_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &blob Quotient
      (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
        (OR ((&ink *P *Col)
             (&blob_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3) Col))
            ((&ink P Col)
             (= P3 P)))))

    (RULE &blob_component
      (&blob.class (:a *Key *P) *Id))

    (INIT &blobs Cardinality
      (key ((&blob_component (:Key ^Col) *Id))
        (member ((:m Id))
          (&blob_component (:Key Col) *Id))))

    (RULE &bar
      (&blobs.size (:key *Col) *N))))

;; Rows ascend by count: the shortest bar lies against the rank edge.
(INIT &order Order
  (member ((:t Col))
    (&bar *Col))
  (before ((:a Col) (:b Col2))
    (&bar *Col *N)
    (&bar (:Col *Col2) (:N *N2))
    (< N N2)))

(INIT &colors Cardinality
  (member ((:m Col))
    (&bar *Col)))

(INIT &widest Order
  (member ((:t N))
    (&bar *N))
  (score ((:t N) (:S N))
    (&bar *N)))

(INIT &chart Frame
  (extent (A N)
    (OR ((&rank_dir *D)
         (axis_of D *A)
         (&colors.size *N))
        ((&bar_dir (:D *D2))
         (axis_of (:D D2) A)
         (&widest.maximal (:t N))))))

(RULE &output
  (&chart.cell *P)
  (&rank_dir *D)
  (margin (:B P) D (:K *R))
  (&order.rank (:t *Col0) R)
  (&bar (:Col Col0) *N)
  (&bar_dir (:D *Db))
  (margin (:B P) (:D Db) *K)
  (OR ((>= K N)
       (&bg (:C *Col)))
      ((< K N)
       (= Col Col0))))
