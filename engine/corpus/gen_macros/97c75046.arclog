;; 97c75046

(RULE &travel_dir
  (dir_elem *D))

(DET &shape UnchangedColor)

(RULE &shape_cell
  (input *P *Col)
  (&shape (:C Col)))

(RULE &travel_node
  (input *P)
  (NOT (&shape_cell P)))

(DET &marker ChangedColor)

(RULE &marker_cell
  (input *P *Col)
  (&marker (:C Col)))

(RULE &travel_source
  (&marker_cell *P))

(INIT &travel Distance
  (key ((&travel_source (:P ^O))
        (&travel_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&travel_source (:P O))
           (&travel_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&travel_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&travel_node (:P Q)))
          ((&travel_source (:P O))
           (&travel_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&travel_node (:P Q))
           (= A2 O))
          ((&travel_source (:P O))
           (&travel_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&travel_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&travel_node (:P Q)))))
    (source ((:n O))
      (&travel_source (:P O))
      (&travel_dir D))))

(RULE &travel_ray
  (&travel.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &travel_end
  (&travel_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&travel_ray (:P Q) D Origin)))

(RULE &landing
  (&travel_end (:P *E) *D)
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *Q))
  (input (:P Q))
  (dir_elem D)
  (opposite D (:Opp *O))
  (step_offset (:D O) (:V *V_m2))
  (compose (:A Q) (:B V_m2) (:C *P)))

(RULE &slide_dir
  (&landing (:D *D2))
  (corner_dir (:C *D) (:D D2)))

(DET &bg DominantColor)

(RULE &contact
  (input *P *Col)
  (&bg (:C Col))
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&shape_cell (:P Q)))

(RULE &slide_node
  (&contact *P))

(RULE &slide_source
  (&contact *P))

(INIT &slide Distance
  (key ((&slide_source (:P ^O))
        (&slide_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&slide_source (:P O))
           (&slide_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&slide_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&slide_node (:P Q)))
          ((&slide_source (:P O))
           (&slide_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&slide_node (:P Q))
           (= A2 O))
          ((&slide_source (:P O))
           (&slide_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&slide_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&slide_node (:P Q)))))
    (source ((:n O))
      (&slide_source (:P O))
      (&slide_dir D))))

(RULE &slide_ray
  (&slide.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &slide_end
  (&slide_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&slide_ray (:P Q) D Origin)))

(RULE &dest
  (&landing (:P *P2))
  (OR ((&slide_end *P (:K *N) (:Origin P2))
       (> N 0))
      ((ALL ((&slide_end (:P *V3m) (:D *V2m) (:K *Nmm) (:Origin P2)))
            ((<= Nmm 0)))
       (= P P2))))

(RULE &cleared
  (OR ((input *P *Col)
       (NOT (&marker_cell P)))
      ((&marker_cell P)
       (&bg (:C Col)))))

(RULE &output
  (OR ((&dest *P)
       (&marker (:C *Col)))
      ((&cleared P Col)
       (NOT (&dest P)))))
