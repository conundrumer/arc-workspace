;; 08ed6ac7

(DET &axis AxisDomain)

(DET &line_cell_split1
  (ex_input *E (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *B_)))

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &ink ChangedColor)

(RULE &ink2
  (input *P *Col)
  (&ink (:C Col)))

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink2 *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink2 (:P P3)))
        ((&ink2 P)
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(INIT &obj_size Cardinality
  (key ((&objs_component *P ^Id))
    (member ((:m P))
      (&objs_component *P Id))))

(RULE &bar_size
  (&obj_size.size *N))

(DET &line_cell
  (ex_input *E *P *Col)
  (&ink (:C Col))
  (&axis *A)
  (&line_cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:B_ *B)))

(INIT &line_size Cardinality
  (key ((&line_cell ^E ^B *P))
    (member ((:m P))
      (&line_cell E B *P))))

(DET &bar_color
  (&line_size.size (:key *E *B) *N)
  (&line_cell E B *P)
  (ex_output E P *Col))

(INIT &seq Order
  (key ((&line_size.size (:key ^E) *N))
    (member ((:t N))
      (&line_size.size (:key E) *N))
    (score ((:t N) (:S N))
      (&line_size.size (:key E) *N))))

(DET &tall_color
  (&seq.dual_rank (:key *E) (:t *N) *R)
  (&bar_color E N *Col))

(ALTS $s "what a bar is" $Object
  (ALT $Line
    (RULE &line_cell_split12
      (&ink2 (:P *P_))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *B_)))

    (RULE &line_cell2
      (&ink2 *P)
      (&axis *A)
      (&line_cell_split12 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:B_ *B)))

    (INIT &line_size2 Cardinality
      (key ((&line_cell2 ^B *P))
        (member ((:m P))
          (&line_cell2 B *P))))

    (RULE &bar_size
      (&line_size2.size *N))

    (RULE &output
      (OR ((&line_cell2 *B *P)
           (&line_size2.size (:key B) *N)
           (&size_color N *Col))
          ((input P Col)
           (NOT (&ink (:C Col))))))))

(ALTS $a "which end of the size order is rank 0" $Tall
  (ALT $Short
    (DET &short_color
      (&seq.rank (:key *E) (:t *N) *R)
      (&bar_color E N *Col))

    (RULE &size_color
      (&seq2.rank (:t *N) *R)
      (&short_color R *Col))))

(INIT &seq2 Order
  (member ((:t N))
    (&bar_size *N))
  (score ((:t N) (:S N))
    (&bar_size *N)))

(RULE &size_color
  (&seq2.dual_rank (:t *N) *R)
  (&tall_color R *Col))

(RULE &output
  (OR ((&objs_component *P *Id)
       (&obj_size.size (:key Id) *N)
       (&size_color N *Col))
      ((input P Col)
       (NOT (&ink (:C Col))))))
