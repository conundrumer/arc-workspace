;; 6ecd11f4

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

;; Every object's box.
(INIT &boxes BoundingBox
  (key ((&objs_component *P ^Id))
    (cell (P)
      (&objs_component *P Id))))

(RULE &box_size
  (&boxes.cell (:key *Id) *P)
  (&boxes.box (:key Id) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(INIT &obj_col Singleton
  (key ((&objs_component *P ^Id)
        (input P *Col))
    (member ((:v Col))
      (&objs_component *P Id)
      (input P *Col))))

(RULE &square_id
  (&obj_col.plural (:key *Id)))

(ALTS $choice "which object is the square" $Multicolor
  (ALT $Smallest
    (INIT &by_extent Order
      (member ((:t (:V Id) (:S N)))
        (&box_size *Id *N))
      (score ((:t (:V Id) (:S N)) (:S N))
        (&box_size *Id *N)))

    (RULE &square_id
      (&by_extent.minimal (:t (:V *Id))))))

(RULE &blocks_dim
  (&square_id *Id)
  (&box_size Id *A *N))

(RULE &shape_id
  (&objs_component *Id)
  (NOT (&square_id Id)))

(RULE &shape_cell
  (&shape_id (:Id *Sh))
  (&boxes.box (:key (:Id Sh)) *B)
  (input *P)
  (ALL ((&boxes.box (:key (:Id *Shm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &blocks_cell
  (&blocks_dim)
  (&shape_cell (:P_inner *P)))

;; The shape's box divided into the square's cell arrangement.
(INIT &blocks_sides ExtentDivisions
  (frame (P)
    (&blocks_cell *P)))

(RULE &blocks_axis_split1
  (&blocks_cell (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &blocks_axis
  (OR ((&blocks_cell *P)
       (&blocks_dim *A *N)
       (&blocks_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&blocks_cell P)
       (&blocks_dim A (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&blocks_cell P)
       (axis_elem A)
       (NOT (&blocks_dim A))
       (&blocks_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &blocks_tile
  (&blocks_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&blocks_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &output
  (&square_id (:Id *Sq))
  (input (:P *P_grid) (:Col *Col_sq))
  (&boxes.box (:key (:Id Sq)) (:B *B_sq))
  (ALL ((input (:P P_grid) (:Col *Col_sqm))
        (&boxes.box (:key (:Id *Sqm)) (:B B_sq))
        (dir_elem (:D *D_m1))
        (relative (:Base B_sq) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B_sq) (:X P_grid) (:X_rel *P))
  (&blocks_tile (:P *P_inner) (:P_outer P))
  (&shape_id (:Id *Sh))
  (&shape_cell (:P *P_shape) P_inner)
  (OR ((NOT (&objs_component (:P P_shape) (:Id Sh)))
       (&bg (:C *Col)))
      ((&objs_component (:P P_shape) (:Id Sh))
       (= Col Col_sq))))
