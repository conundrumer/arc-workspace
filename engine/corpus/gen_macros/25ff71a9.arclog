;; 25ff71a9

(DET &shift_dir DirDomain)

(DET &shift_k DivisorRatio)

(DET &bg DominantColor)

(RULE &shift_image
  (input (:P *P_in) *Col)
  (&shift_dir *D)
  (&shift_k *K)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset D K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P_in) (:B V_m1) (:C *P_out))
  (input (:P P_out)))

(ALTS $choice "the edge behavior" $Shift
  (ALT $Cycle
    (RULE &row_idx
      (input *P)
      (&shift_dir (:D *SD))
      (opposite (:D SD) (:Opp *FE))
      (margin (:B P) (:D FE) *K))

    (RULE &rows_dir
      (&shift_dir (:D *SD))
      (opposite (:D SD) (:Opp *D)))

    ;; Rows seated back on the shift axis by index.
    (INIT &rows_size Cardinality
      (member ((:m K))
        (&row_idx *K)))

    (INIT &rows_frame Frame
      (extent (A N)
        (&rows_dir *D)
        (axis_of D *A)
        (&rows_size.size *N)))

    (RULE &rows_pos
      (&rows_frame.cell *P)
      (&rows_dir *D)
      (margin (:B P) D *K)
      (&row_idx K))

    (RULE &out_split1
      (input (:P *P_in_) *Col)
      (axis_of (:D *SD) (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_in_) (:X_rel *P_across_)))

    (INIT &row_cycle Order
      (member ((:t K))
        (&row_idx *K))
      (score ((:t K) (:S K))
        (&row_idx *K)))

    (INIT &rot Walk
      (successor ((:p K) (:p_next K2))
        (&row_cycle.cyclic_successor (:a *K) (:b *K2)))
      (steps ((:N M))
        (&shift_k (:K *M))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&shift_dir (:D *SD))
      (opposite (:D SD) (:Opp *FE))
      (margin (:B P_in) (:D FE) (:K *K_in))
      (&shift_k (:K *M))
      (&rot.walk (:p0 K_in) (:N M) (:p *K_out))
      (&rows_pos (:K K_out) (:P *P_row))
      (axis_of (:D SD) *A)
      (&out_split1 (:P_in_ P_in) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across))
      (compose (:A P_row) (:B P_across) (:C *P)))))

(RULE &output
  (OR ((&shift_image (:P_out *P) *Col))
      ((input P)
       (NOT (&shift_image (:P_out P)))
       (&bg (:C Col)))))
