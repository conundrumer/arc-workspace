;; c62e2108

(INPUT background "the field is color `background` (0).")

(INPUT squares "one or more copies of one shape, a square outline of side 4 with a hollow middle, all in one color other than `background` and `marker`. A square is a 4-connected object."

  (DET &train
    (ex_output *E))

  (INIT &commonest_count Cardinality
    (key ((ex_input ^E *P ^Col)
          (&train E))
      (member ((:m P))
        (ex_input E *P Col)
        (&train E))))

  (INIT &commonest Order
    (key ((&commonest_count.size (:key ^E *Col)))
      (member ((:t Col))
        (&commonest_count.size (:key E *Col)))
      (score ((:t Col) (:S N))
        (&commonest_count.size (:key E *Col) *N))))

  (DET &not_field
    (ex_input (:Col *C))
    (&train *E)
    (NOT (&commonest.maximal (:key E) (:t C))))

  (DET_OR_RULE &background DominantColor
    (ex_input (:Col *C))
    (NOT (&not_field C)))

  (RULE &piece8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &piece8_node
    (input *P (:Col *Key))
    (NOT (&background (:C Key))))

  (INIT &piece8 Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&piece8_node (:Key *Ky) *P)
           (&piece8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&piece8_node (:Key Ky) (:P P2)))
          ((&piece8_node (:Key Ky) P)
           (= P2 P))))))

(INPUT edge-markers "one or more straight segments of color `marker` (1), each lying along a grid edge, as long as a square's side, and covering the same rows (on a left or right edge) or the same columns (on a top or bottom edge) as exactly one square.")

(INPUT clear-strip "the strip between a square and each marker lined up with it holds only `background` and that marker.")

(OUTPUT repeat-toward-marker "each square repeats toward each marker lined up with it, each copy placed `gap` cells past the one before, so the copies tile the strip from the square to the grid edge, and the last copy is cut off at the grid edge."

  (RULE &piece4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &piece4_node
    (input *P (:Col *Key))
    (NOT (&background (:C Key))))

  (INIT &piece4 Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&piece4_node (:Key *Ky) *P)
           (&piece4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&piece4_node (:Key Ky) (:P P2)))
          ((&piece4_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &piece4_component
    (&piece4.class (:a *Key *P) *Id))

  (DET_OR_RULE &marker RarestColor
    (ex_input *E (:Col *C))
    (&train E)
    (NOT (ex_output (:Col C))))

  (RULE &piece
    (&piece4_component (:Key *Col) *P *Id))

  (RULE &mark_cell
    (&piece *Col (:Id *M) *P)
    (&marker (:C Col)))

  (INIT &pbox BoundingBox
    (key ((&piece ^Id *P))
      (cell (P)
        (&piece Id *P))))

  (RULE &square
    (&piece *Col (:Id *S))
    (NOT (&marker (:C Col)))
    (&pbox.box (:key (:Id S)) *B))

  (RULE &lined
    (&mark_cell *M (:P *Q))
    (&pbox.box (:key (:Id M)) (:B *B_m))
    (ALL ((&mark_cell (:M *Mm) (:P Q))
          (&pbox.box (:key (:Id Mm)) (:B B_m))
          (dir_elem (:D *D_m1))
          (relative (:Base B_m) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B Q) *D (:K *K_m1))
    (margin (:B B_m) D (:K K_m1))
    (opposite D (:Opp *D_opp))
    (margin (:B Q) (:D D_opp) (:K *K_m2))
    (margin (:B B_m) (:D D_opp) (:K K_m2))
    (&square *S (:B *B_s))
    (axis_of D (:A *A_m3))
    (perp (:A A_m3) (:A2 *A2_m4))
    (axis_of (:D *D_p) (:A A2_m4))
    (opposite (:D D_p) (:Opp *O_m5))
    (margin (:B B_m) (:D D_p) (:K *K1))
    (margin (:B B_m) (:D O_m5) (:K *K2))
    (opposite (:D D_p) (:Opp *O_m6))
    (margin (:B B_s) (:D D_p) (:K K1))
    (margin (:B B_s) (:D O_m6) (:K K2))
    (relative (:Base Q) (:X B_s) (:X_rel *V))
    (margin (:B V) D *K)
    (> K 0))

  (RULE &origin
    (&lined *S *D)
    (&square S *B)
    (input (:P *Q))
    (ALL ((&square (:S *Sm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X Q) (:X_rel *P_t))
    (opposite D (:Opp *D_opp))
    (margin (:B P_t) (:D D_opp) (:K 0)))

  (RULE &march_dir
    (&origin (:D *Key)))

  (RULE &march_node
    (&origin (:D *Key))
    (input *P))

  (RULE &march_source
    (&origin (:D *Key) (:Q *P)))

  (INIT &march Distance
    (key ((&march_source (:Key ^Ky) (:P ^O))
          (&march_dir (:Key Ky)))
      (edge ((:a A2) (:b Q))
        (OR ((&march_source (:Key Ky) (:P O))
             (&march_dir (:Key Ky))
             (axis_of (:D Ky) *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite (:D Ky) (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset (:D Ky) K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&march_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&march_node (:Key Ky) (:P Q)))
            ((&march_source (:Key Ky) (:P O))
             (&march_dir (:Key Ky))
             (step_offset (:D Ky) (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&march_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&march_source (:Key Ky) (:P O))
             (&march_dir (:Key Ky))
             (diag_dir_elem (:D Ky))
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite (:D Ky) (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset (:D Ky) (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&march_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&march_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&march_source (:Key Ky) (:P O))
        (&march_dir (:Key Ky)))))

  (RULE &march_ray
    (&march.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

  ;; the cells between one copy and the next
  (DET &gap NumberDomain)

  (INIT &nearest Order
    (key ((&lined *S ^M *K))
      (member ((:t (:V S) (:S K)))
        (&lined *S M *K))
      (score ((:t (:V S) (:S K)) (:S K))
        (&lined *S M *K))))

  (RULE &march_cell
    (&origin (:D *Key))
    (input *P))

  (RULE &placed
    (&origin *S *D *Q (:P_t *P_t0))
    (&march_ray (:Key D) *P D *K (:Origin Q))
    (&march_cell (:Key D) P)
    (axis_of D *A)
    (frame_extent (:P P_t0) A (:N *W))
    (&gap (:N *G))
    (divide (:T K) (:Side W) (:Gap G) (:Part *N) (:Remainder *I))
    (> N 0))

  ;; Each copy counts from the edge opposite the one the copy before it counts from.
  (INIT &flips Walk
    (key ((OR ((&placed ^D)
               (opposite D (:Opp *D_opp)))
              ((&placed D *N))))
      (successor ((:p P) (:p_next D_opp))
        (OR ((&placed D)
             (opposite D (:Opp *D_opp))
             (= *P D))
            ((&placed D)
             (opposite D (:Opp P))
             (= D_opp D))))
      (steps (N)
        (&placed D *N)))))

(OUTPUT copies-overwrite "a copy writes every cell of its box, its hollow cells as `background`, so the marker cells take the copy's cells. Undefined where two copies write different colors to one cell."

  (RULE &hit
    (&lined *S *M *D))

  (RULE &tile_val
    (&square *S *B)
    (input (:P *Q) *Col)
    (ALL ((input (:P Q) (:Col *Colm))
          (&square (:S *Sm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X Q) (:X_rel *P_t)))

  (RULE &start_side
    (&placed *D *N)
    (opposite D (:Opp *Side)))

  (RULE &copy_cell
    (&placed *S *D *P *N *I *P_t0)
    (&start_side D N *Side)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *D_p) (:A A2_m2))
    (&tile_val S *P_t *Col)
    (margin (:B P_t) (:D D_p) (:K *K_m3))
    (margin (:B P_t0) (:D D_p) (:K K_m3))
    (margin (:B P_t) (:D Side) (:K I)))

  (RULE &painted
    (&hit *S *M *D)
    (&copy_cell S D *P *Col))

  (INIT &shown Singleton
    (key ((&painted ^P *Col))
      (member ((:v Col))
        (&painted P *Col)))))

(OUTPUT keep-rest "every other cell keeps its input color.")

(ALTS $layer "what a copy writes over" $Overwrite
  (ALT $Overlay
    (OUTPUT copies-overwrite "a copy writes only its shape's cells, and the cells of a marker that a square repeats toward turn `background`. Undefined where two copies write different shape colors to one cell."
      (RULE &unwritten
        (&background (:C *Col)))

      (RULE &painted
        (&hit *S *M *D)
        (&copy_cell S D *P *Col)
        (NOT (&unwritten Col)))

      (RULE &cleared
        (&hit *M)
        (&mark_cell M *P)))
    (RULE &output
      (input *P (:Col *Col_in))
      (NOT (&clash))
      (OR ((&written P *Col))
          ((&cleared P)
           (NOT (&written P))
           (&background (:C Col)))
          ((NOT (&written P))
           (NOT (&cleared P))
           (= Col Col_in))))
    (ALT $ToMarker
      (OUTPUT repeat-toward-marker "the copies run to the marker's line, that line included, and are cut off there."
        (RULE &painted
          (&hit *S *M *D)
          (&copy_cell S D *P *Col)
          (NOT (&past M D P))
          (NOT (&unwritten Col)))))
    (ALT $EraseMarkers
      (OUTPUT erase-markers "every marker cell that no copy covers turns `background`."
        (RULE &cleared
          (OR ((&hit *M)
               (&mark_cell M *P))
              ((input P *Col)
               (&marker (:C Col)))))))))

(ALTS $reach "where the copies stop" $ToEdge
  (ALT $ToMarker
    (OUTPUT repeat-toward-marker "the copies run to the marker's line, that line included, and are cut off there."
      (RULE &past
        (&lined *S *M *D)
        (&copy_cell S D *P)
        (&mark_cell M (:P *Q))
        (dir_elem D)
        (margin (:B P) D (:K *K1_m1))
        (margin (:B Q) D (:K *K2_m2))
        (< K1_m1 K2_m2))

      (RULE &painted
        (&hit *S *M *D)
        (&copy_cell S D *P *Col)
        (NOT (&past M D P))))))

(ALTS $tile "what each copy draws" $OwnBox
  (ALT $StoredTile
    (OUTPUT repeat-toward-marker "each copy is `tile` drawn in the square's color, its `tile_corner` corner on that corner of the square's box, and the stride is the tile's extent plus `gap`."
      ;; the cells of each copy: 1 for the square's color, 0 for `background`
      ;; TODO no-det-plan: &tile: the plan gives no verdict
      (DET &tile)

      ;; the corner of the tile laid on the same corner of the square's box
      ;; TODO no-det-plan: &tile_corner: the plan gives no verdict
      (DET &tile_corner (ONE))

      (RULE &tile_val
        (&square *S (:Col *Col_s))
        (&tile (:P *P_t) *Ink)
        (OR ((= Ink 0)
             (&background (:C *Col)))
            ((!= Ink 0)
             (= Col Col_s))))

      (RULE &origin
        (&lined *S *D)
        (&square S *B)
        (&tile (:P *P_t))
        (opposite D (:Opp *D_opp))
        (margin (:B P_t) (:D D_opp) (:K 0))
        (&tile_corner *C)
        (input (:P *Q))
        (relative (:Base B) (:X Q) (:X_rel *Q_rel))
        (ALL ((&square (:S *Sm) (:B *Bm))
              (input (:P *Qm))
              (relative (:Base Bm) (:X Qm) (:X_rel Q_rel))
              (corner_dir C (:D *D_m1))
              (margin (:B P_t) (:D D_m1) (:K *K1_m2))
              (margin (:B Q_rel) (:D D_m1) (:K *K2_m3)))
             ((= K1_m2 K2_m3)))))))

(ALTS $form "how each copy relates to the one before" $Translate
  (ALT $Mirror
    (OUTPUT repeat-toward-marker "every other copy is reflected across the edge it shares with the copy before it."
      (RULE &start_side
        (&flips.walk (:key *D) (:p0 *D_opp) *N (:p *Side))
        (opposite D (:Opp D_opp))))))

(ALTS $adj "how the cells of a square or a marker join" $Adj4
  (ALT $Adj8
    (INPUT squares "a square or a marker segment is an 8-connected object."
      (RULE &piece8_component
        (&piece8.class (:a *Key *P) *Id))

      (RULE &piece
        (&piece8_component (:Key *Col) *P *Id)))))

(ALTS $owner "which of the squares lined up with a marker repeat toward it" $EveryLined
  (ALT $NearestOnly
    (OUTPUT repeat-toward-marker "of the squares lined up with a marker, only the one nearest to it repeats toward it."
      (RULE &hit
        (&nearest.minimal (:key *M) (:t (:V *S)))
        (&lined S M *D)))))

(ALTS $unmatched "what a marker cell that no copy covers takes" $KeepMarkers
  (ALT $EraseMarkers
    (OUTPUT erase-markers "every marker cell that no copy covers turns `background`."
      (RULE &cleared
        (input *P *Col)
        (&marker (:C Col))))
    (RULE &output
      (input *P (:Col *Col_in))
      (NOT (&clash))
      (OR ((&written P *Col))
          ((&cleared P)
           (NOT (&written P))
           (&background (:C Col)))
          ((NOT (&written P))
           (NOT (&cleared P))
           (= Col Col_in))))))

(RULE &march_end
  (&march_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&march_ray Key (:P Q) D Origin)))

(RULE &clash
  (&shown.plural))

(RULE &written
  (&shown.value (:key *P) (:v *Col)))

(RULE &output
  (input *P (:Col *Col_in))
  (NOT (&clash))
  (OR ((&written P *Col))
      ((NOT (&written P))
       (= Col Col_in))))
