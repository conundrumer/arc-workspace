;; 1e97544e

;; The cycle advances along this diagonal.
(DET &diag_axis DiagAxisDomain)

(RULE &line_dir
  (&diag_axis (:Da *DA))
  (diag_axis_of *D (:Da DA)))

(RULE &line_node
  (input *P))

(DET &hole ChangedColor)

(RULE &intact
  (input *P *Col)
  (NOT (&hole (:C Col))))

(RULE &line_source
  (&intact *P))

;; The diagonal lines through the intact cells, each cell with its step count
;; from the intact cell.
(INIT &line Distance
  (key ((&line_source (:P ^O))
        (&line_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&line_source (:P O))
           (&line_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&line_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&line_node (:P Q)))
          ((&line_source (:P O))
           (&line_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&line_node (:P Q))
           (= A2 O))
          ((&line_source (:P O))
           (&line_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&line_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&line_node (:P Q)))))
    (source ((:n O))
      (&line_source (:P O))
      (&line_dir D))))

(RULE &line_ray
  (&line.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &line_end
  (&line_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&line_ray (:P Q) D Origin)))

;; Stripes run along this axis.
(DET &axis AxisDomain)

(RULE &stripe_split1
  (input (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

;; The fault diagonal runs from this corner.
(DET &corner DiagDirDomain)

(RULE &damaged
  (input *P *Col)
  (&hole (:C Col)))

(RULE &stripe
  (input *P)
  (&corner (:D *C))
  (&axis *A)
  (&stripe_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across))
  (corner_dir C A (:D *D1_m2))
  (perp A (:A2 *A2_m3))
  (corner_dir C (:A A2_m3) (:D *D_jog))
  (corner_dir C A (:D *D1_m4))
  (perp A (:A2 *A2_m6))
  (corner_dir C (:A A2_m6) (:D *D2_m5))
  (margin (:B P) (:D D1_m4) (:K *K_start))
  (margin (:B P) (:D D2_m5) (:K *K_jog))
  (OR ((> K_start K_jog)
       (opposite (:D D_jog) (:Opp *D_back))
       (step_offset (:D D_back) (:V *V_m7))
       (compose (:A Across) (:B V_m7) (:C *S)))
      ((<= K_start K_jog)
       (= S Across))))

(RULE &stripe_color
  (&stripe *P *S)
  (&stripe (:P *Q) S)
  (&intact (:P Q) *Col))

(ALTS $choice "how the pattern's law is read" $Stripe
  (ALT $Cycle
    (RULE &cycle_succ
      (&diag_axis (:Da *DA))
      (diag_axis_of *D (:Da DA))
      (&intact *P *Col)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&intact (:P Q) (:Col *Col2)))

    ;; The color a count of steps along the cycle reaches.
    (INIT &advance Walk
      (key ((OR ((&cycle_succ ^D *Col *Col2))
                ((&line_ray D *K)
                 (diag_dir_elem D))))
        (successor ((:p Col) (:p_next Col2))
          (&cycle_succ D *Col *Col2))
        (steps ((:N K))
          (&line_ray D *K)
          (diag_dir_elem D))))

    (RULE &flow
      (&intact (:P *P2) (:Col *Col3))
      (&line_ray *P *D *K (:Origin P2))
      (diag_dir_elem D)
      (&advance.walk (:key D) (:p0 Col3) (:N K) (:p *Col)))

    (RULE &output
      (OR ((&damaged *P)
           (&flow P *Col))
          ((&intact P Col))))))

(RULE &output
  (OR ((&intact *P *Col))
      ((&damaged P)
       (&stripe_color P Col))))
