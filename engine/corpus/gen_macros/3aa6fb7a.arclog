;; 3aa6fb7a

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &empty
  (input *P *Col)
  (&bg (:C Col)))

(RULE &mark
  (&empty *P)
  (corner_dir (:C *G) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C G) (:A A2_m2) (:D *D2))
  (step_offset (:D D1) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q1))
  (&ink (:P Q1))
  (step_offset (:D D2) (:V *V_m4))
  (compose (:A P) (:B V_m4) (:C *Q2))
  (&ink (:P Q2))
  (step_offset (:D G) (:V *V_m5))
  (compose (:A P) (:B V_m5) (:C *Q3))
  (&ink (:P Q3)))

(ALTS $choice "what marks a cell" $Corner
  (ALT $Box
    (RULE &parts_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &parts Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&parts_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &parts_component
      (&parts.class (:a *P) *Id))

    (INIT &part_box BoundingBox
      (key ((&parts_component *P ^Id))
        (cell (P)
          (&parts_component *P Id))))

    (RULE &mark
      (&empty *P)
      (&part_box.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &output
  (OR ((&mark *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&mark P)))))
