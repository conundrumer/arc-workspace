;; 1be83260

(DET &bg VanishedColor)

(INIT &region BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &cell
  (input (:P *P_grid) *Col)
  (&region.box *B)
  (ALL ((input (:P P_grid) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P)))

(RULE &df_divider_split1
  (&cell (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &inked_line_split1
  (&cell (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &df_divider
  (&cell *P)
  (axis_elem *A)
  (&df_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (ALL ((&cell (:P *Pm) *Col)
        (axis_elem (:A *Am))
        (&inked_line_split1 (:P_ Pm) (:A_ Am) (:L_ L) (:X_m1_ *X_m1m)))
       ((&bg (:C Col)))))

(RULE &df_on_divider
  (&cell *P)
  (&df_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &df_rank Order
  (key ((OR ((&df_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((&cell *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&df_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&df_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((&cell *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (&cell *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &df_part_idx
  (&cell *P)
  (axis_of *D *A)
  (NOT (&df_on_divider P A))
  (margin (:B P) D *K)
  (&df_rank.rank (:key D) (:t K) (:R *N)))

(RULE &df_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&df_part_idx *P D (:N *N1))
  (&df_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &df_tile_of
  (&df_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&df_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &block BoundingBox
  (key ((&df_tile_of *P ^P_tile))
    (cell (P)
      (&df_tile_of *P P_tile))))

(RULE &block_cell
  (&block.cell (:key *P_tile) (:P *P_region))
  (&block.box (:key P_tile) *B)
  (ALL ((&block.cell (:key (:P_tile *P_tilem)) (:P P_region))
        (&block.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_region) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_region) (:X_rel *P_intile)))

(RULE &hole
  (&block_cell *P_region *P_intile)
  (&cell (:P P_region) *Col)
  (&bg (:C Col)))

(RULE &before_split1
  (&hole (:P_intile *P_intile_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_intile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_intile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_intile_) (:X_rel *X_m1_)))

(RULE &before_split2
  (&hole (:P_intile *P_intile2_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_intile2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_intile2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
  (relative (:Base L2_) (:X P_intile2_) (:X_rel *X_m2_)))

(RULE &elem_split1
  (&hole (:P_intile *P_intile_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_intile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_intile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_intile_) (:X_rel *X_m1_)))

(INIT &hole_frame Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t L))
      (&hole *P_intile)
      (&elem_split1 (:P_intile_ P_intile) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))
    (before ((:a L) (:b L2))
      (&hole *P_intile)
      (&before_split1 (:P_intile_ P_intile) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
      (&hole (:P_intile *P_intile2))
      (&before_split2 (:P_intile2_ P_intile2) (:A_ A) (:L2_ *L2) (:X_m2_ *X_m2))
      (!= L L2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &hole_frame_pos
  (&hole_frame.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
  (&hole_frame.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &body
  (&block_cell *P_intile)
  (NOT (&hole P_intile)))

(RULE &block_color
  (&df_tile_of *P *P_tile)
  (&cell P *Col)
  (NOT (&bg (:C Col))))

(RULE &border
  (&block_color *Col)
  (ALL ((&block_color *P_tile))
       ((&block_color P_tile Col))))

(RULE &key_cell
  (&block_color *P_tile (:Col *K))
  (NOT (&border (:Col K)))
  (&block_cell P_tile *P_region *P_intile)
  (&cell (:P P_region) *Col))

(RULE &palette
  (perp *A *A2)
  (&hole_frame_pos (:Key A) (:M *L1) (:P_pos *P1))
  (&hole_frame_pos (:Key A2) (:M *L2) (:P_pos *P2))
  (compose (:A P1) (:B P2) (:C *P_tile))
  (compose (:A L1) (:B L2) (:C *P_intile))
  (&key_cell P_intile *Col))

(RULE &painted
  (&block_cell *P_tile (:P_region *P) *P_intile)
  (&body P_intile)
  (&palette P_tile *Col))

(ALTS $choice "how the output frame is built" $Repaint
  (ALT $Assemble
    (DET &gap NumberDomain)

    (INIT &assembled_tiling Tiling
      (outer ((:P P_tile))
        (&palette *P_tile))
      (inner ((:P P_intile))
        (&body *P_intile))
      (gap (A G)
        (axis_elem *A)
        (&gap (:N *G))))

    (RULE &assembled
      (&palette *P_tile *Col)
      (&assembled_tiling.cell (:P_outer P_tile) *P))

    (INIT &sheet Frame
      (extent (A N)
        (&assembled *P)
        (axis_elem *A)
        (frame_extent P A *N)))

    (RULE &output
      (&sheet.cell *P)
      (OR ((&assembled P *Col))
          ((NOT (&assembled P))
           (&border Col))))))

(RULE &output
  (&cell *P)
  (OR ((&painted P *Col))
      ((NOT (&painted P))
       (&border Col))))
