;; 7468f01a

(DET &bg DominantColor)

(DET &transform D4Domain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &output
  (&ink (:P *P2) *Col)
  (&bbox.box *B)
  (ALL ((&ink (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_inner))
  (&transform *D)
  (apply D (:P P_inner) (:P_out *P)))
