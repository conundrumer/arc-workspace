;; 94133066

;; the panel's color
(DET &field SharedColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&field (:C Col))))

(RULE &panel
  (input *P *Col)
  (&bbox.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &outside
  (input *P *Col)
  (&bbox.box *B)
  (dir_elem (:D *D_m1))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &placed
  (d4_elem *D)
  (&panel *P_inner *Col)
  (&outside (:P *P_grid_in) Col)
  (apply D (:P P_inner) (:P_out *P_grid_out)))

(RULE &broken
  (&placed *D (:P_grid_out *P1) (:P_grid_in *Q1))
  (&placed D (:P_grid_out *P2) (:P_grid_in *Q2))
  (relative (:Base P1) (:X P2) (:X_rel *V))
  (relative (:Base Q1) (:X Q2) (:X_rel *V2))
  (!= V V2))

(ALTS $choice "how much of the turned marks' arrangement the outside cells keep" $Congruent
  (ALT $Ordered
    (RULE &broken
      (&placed *D (:P_grid_out *P1) (:P_grid_in *Q1))
      (&placed D (:P_grid_out *P2) (:P_grid_in *Q2))
      (dir_elem (:D *Dir))
      (OR ((dir_elem (:D Dir))
           (margin (:B P1) (:D Dir) (:K *K1_m1))
           (margin (:B P2) (:D Dir) (:K *K2_m2))
           (< K1_m1 K2_m2)
           (dir_elem (:D Dir))
           (margin (:B Q1) (:D Dir) (:K *K1_m3))
           (margin (:B Q2) (:D Dir) (:K *K2_m4))
           (>= K1_m3 K2_m4))
          ((dir_elem (:D Dir))
           (margin (:B Q1) (:D Dir) (:K *K1_m5))
           (margin (:B Q2) (:D Dir) (:K *K2_m6))
           (< K1_m5 K2_m6)
           (dir_elem (:D Dir))
           (margin (:B P1) (:D Dir) (:K *K1_m7))
           (margin (:B P2) (:D Dir) (:K *K2_m8))
           (>= K1_m7 K2_m8))))))

(RULE &pose
  (d4_elem *D)
  (NOT (&broken D)))

(RULE &output
  (&panel *P_inner *Col)
  (&pose *D)
  (apply D (:P P_inner) (:P_out *P)))
