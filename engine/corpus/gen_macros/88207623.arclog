;; 88207623

(RULE &lines_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &line SharedColor)

(INIT &lines Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&line (:C Col))
         (&lines_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&line (:C Col2)))
        ((input P (:Col *Col3))
         (&line (:C Col3))
         (= P3 P)))))

(RULE &lines_component
  (&lines.class (:a *P) *Id))

(RULE &blob_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((dir8_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(DET &shape SharedColor)

;; The axis across the line, which the reflection inverts.
(DET &across_axis AxisDomain)

(RULE &in_band
  (&lines_component (:P *L) *Id)
  (input *P)
  (&across_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B L) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3)))

(RULE &dot
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&line (:C Col)))
  (NOT (&shape (:C Col))))

(RULE &blob_node
  (&lines_component (:Id *Key))
  (OR ((input *P *Col)
       (&shape (:C Col)))
      ((&lines_component P (:Id Key)))))

;; $Attached — the shape cells reached from the line over 8-adjacency.
(INIT &blob Propagation
  (key ((OR ((&lines_component *P ^Id)
             (&blob_node (:Key Id) P))
            ((&blob_node (:Key Id) P)
             (&blob_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&blob_node (:Key Id) (:P Q)))))
    (source ((:n P))
      (&lines_component *P Id)
      (&blob_node (:Key Id) P))
    (edge ((:a P) (:b Q))
      (&blob_node (:Key Id) *P)
      (&blob_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&blob_node (:Key Id) (:P Q)))))

(RULE &source
  (&blob.reached (:key *Id) (:n *P))
  (input P *Col)
  (&shape (:C Col)))

(ALTS $s "which shape cells a line reflects" $Attached
  (ALT $Spanned
    ;; $Spanned — the shape cells in the line's band.
    (RULE &source
      (&in_band *Id *P)
      (input P *Col)
      (&shape (:C Col)))))

(ALTS $m "which dot colors a line's reflection" $Beside
  (ALT $Sample
    ;; $Sample — the dot on the line's reflection.
    (RULE &paint
      (&image *Id (:Q *P))
      (&dot (:P *P2) *Col)
      (&image Id (:Q P2)))))

(RULE &image
  (&source *Id *P)
  (&lines_component (:P *L) Id)
  (&across_axis *A)
  (axis_inversion A (:T *F))
  (relative (:Base L) (:X P) (:X_rel *V))
  (apply (:D F) (:P V) (:P_out *V2))
  (compose (:A L) (:B V2) (:C *Q))
  (input (:P Q)))

;; $Beside — the dot in the line's band.
(RULE &paint
  (&image *Id (:Q *P))
  (&dot (:P *P2) *Col)
  (&in_band Id (:P P2)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
