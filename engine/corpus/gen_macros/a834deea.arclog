;; a834deea

(INPUT boxes "one or more 5×5 boxes stand apart from each other. Each box has a solid outline of &frame_color, and no side neighbor of the outline outside the box has that color."

  (DET_OR_RULE &frame_color RarestColor)

  (RULE &frame_cell
    (input *P *Col)
    (&frame_color (:C Col)))

  (RULE &comps4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &comps4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&frame_cell *P)
           (&comps4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&frame_cell (:P P3)))
          ((&frame_cell P)
           (= P3 P)))))

  (RULE &comps4_component
    (&comps4.class (:a *P) *Id))

  (RULE &comps8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &comp_box BoundingBox
    (key ((&comps4_component *P ^Id))
      (cell (P)
        (&comps4_component *P Id))))

  (INIT &comps8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&frame_cell *P)
           (&comps8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&frame_cell (:P P3)))
          ((&frame_cell P)
           (= P3 P))))))

(OUTPUT keyed-fill "in each box, an interior cell of &frame_color takes the color &position_color gives for its place in the 3×3 interior."

  (RULE &iso_dir
    (dir_elem *D))

  (INIT &outline Outlines
    (node (P)
      (&frame_cell *P)))

  (RULE &attached
    (&outline.box *B)
    (&frame_cell *P)
    (ALL ((&frame_cell P)
          (&outline.box B)
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D *D_m1) (:K *K_m2))
    (margin B (:D D_m1) (:K K_m2))
    (&iso_dir *D)
    (step_offset D (:V *V_m3))
    (compose (:A P) (:B V_m3) (:C *Q))
    (&frame_cell (:P Q))
    (dir_elem (:D *D_m4))
    (relative (:Base B) (:X Q) (:X_rel *R_m5))
    (margin (:B R_m5) (:D D_m4) (:K *K_m6))
    (< K_m6 0))

  (RULE &box
    (&outline.box *B)
    (&iso_dir)
    (NOT (&attached B)))

  ;; The interior of each box.
  (INIT &inner BoundingBox
    (key ((&box ^B))
      (cell (P)
        (input *P)
        (ALL ((input P)
              (&box B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((> K_m3 0))))))

  (RULE &inner_cell
    (&box *B)
    (&inner.box (:key B) (:B *I))
    (&frame_cell *P)
    (ALL ((&frame_cell P)
          (&inner.box (:key (:B *Bm)) (:B I))
          (dir_elem (:D *D_m1))
          (relative (:Base I) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (DET &filled
    (&inner_cell *E *P *I)
    (ex_input E P (:Col *C_in))
    (ex_output E P *Col)
    (!= Col C_in))

  (DET &position_color_inside1
    (&filled (:P *P_grid_) (:I *I_) *Col)
    (dir_elem (:D *D_m1))
    (relative (:Base I_) (:X P_grid_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET &position_color
    (&filled (:P *P_grid) *I *Col)
    (NOT (&position_color_inside1 (:P_grid_ P_grid) (:I_ I)))
    (relative (:Base I) (:X P_grid) (:X_rel *P)))

  (INIT &touch Inclusion
    (pattern ((:pattern D) (:m M))
      (OR ((corner_dir (:C *D) (:D *M)))
          ((dir_elem D)
           (= M D))))
    (observed ((:observed P I) (:m D))
      (&inner_cell *P *I)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base I) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) *D (:K *K_m1))
      (margin (:B I) D (:K K_m1)))))

(OUTPUT center-kept "the center of the interior has no entry in &position_color and keeps its color.")

(OUTPUT rest-kept "every other cell keeps its input color."

  (DET &side_color_inside1
    (ex_input *E (:P *Q_grid_))
    (&filled E (:P *P_grid) (:I *I_) *Col)
    (dir_elem (:D *D_m1))
    (relative (:Base I_) (:X Q_grid_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET &side_color_centered1
    (&filled *E (:P *P_grid) *I *Col)
    (ex_input E (:P *Q_grid))
    (relative (:Base I) (:X Q_grid) (:X_rel *Q_inner_))
    (opposite (:D *D_m1) (:Opp *O_m2))
    (margin (:B Q_inner_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_inner_) (:D O_m2) (:K *K2_m4))
    (!= K1_m3 K2_m4))

  (DET &side_color
    (&filled *E (:P *P_grid) *I *Col)
    (ex_input E (:P *Q_grid))
    (NOT (&side_color_inside1 (:Q_grid_ Q_grid) (:I_ I)))
    (relative (:Base I) (:X Q_grid) (:X_rel *Q_inner))
    (NOT (&side_color_centered1 (:Q_inner_ Q_inner)))
    (step_offset *D (:V *V_m1))
    (compose (:A Q_grid) (:B V_m1) (:C P_grid))))

(ALTS $find "which cells form a box" $Outline
  (ALT $Outline
    (ALTS $iso "which neighbors of the outline outside the box must not be frame-colored" $SideIsolation
      (ALT $DiagonalIsolation
        (INPUT boxes "no diagonal neighbor of the outline outside the box has &frame_color either."
          (RULE &iso_dir
            (dir8_elem *D))))))
  (ALT $ComponentBbox
    (INPUT boxes "a box is the bounding box of a connected component of &frame_color. Its outline need not be solid."
      (RULE &box
        (&comp_box.box *B)))
    (ALTS $conn "which neighbors join a component" $FourConn
      (ALT $EightConn
        (INPUT boxes "diagonal neighbors join a component too."
          (RULE &comps8_component
            (&comps8.class (:a *P) *Id))
          (INIT &comp_box BoundingBox
            (key ((&comps8_component *P ^Id))
              (cell (P)
                (&comps8_component *P Id)))))))))

(ALTS $key "which key a recolored cell reads" $Place
  (ALT $RingBySide
    (OUTPUT keyed-fill "a box is any size. A cell of the interior takes &side_color at the corner or side whose outline sides it touches. A cell that touches no side, or two opposite sides, keeps its color.")
    (RULE &keyed
      (&inner_cell *P *I)
      (&touch.equal (:observed P I) (:pattern *D))
      (&side_color D *Col)))
  (ALT $SignOfOffset
    (OUTPUT keyed-fill "a box is any size. A cell of the interior takes &side_color at the direction of its row and column offsets from the interior's center. The center keeps its color."
      (RULE &place_nearer
        (&inner_cell (:P *P_grid) *I)
        (ALL ((dir_elem (:D *D_m1))
              (relative (:Base I) (:X P_grid) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base I) (:X P_grid) (:X_rel *P))
        (dir_elem *D)
        (opposite D (:Opp *O_m1))
        (margin (:B P) D *K)
        (margin (:B P) (:D O_m1) (:K *K2))
        (< K K2))

      (RULE &place_quadrant
        (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
        (&place_nearer *P (:D D1))
        (&place_nearer P (:D D2)))

      (RULE &off_mid
        (&place_nearer (:P *P_inner) *D)
        (axis_of D *A))

      (RULE &sign_key
        (OR ((&place_quadrant (:P *P_inner) (:Diag *D)))
            ((&place_nearer (:P P_inner) D)
             (axis_of D *A)
             (perp A *A2)
             (NOT (&off_mid P_inner (:A A2)))))))
    (RULE &keyed
      (&inner_cell *P *I)
      (ALL ((&inner_cell P I)
            (dir_elem (:D *D_m1))
            (relative (:Base I) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base I) (:X P) (:X_rel *P_inner))
      (&sign_key P_inner *D)
      (&side_color D *Col))))

(RULE &keyed
  (&inner_cell *P *I)
  (ALL ((&inner_cell P I)
        (dir_elem (:D *D_m1))
        (relative (:Base I) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base I) (:X P) (:X_rel *P_inner))
  (&position_color (:P P_inner) *Col))

(RULE &output
  (OR ((&keyed *P *Col))
      ((input P Col)
       (NOT (&keyed P)))))
