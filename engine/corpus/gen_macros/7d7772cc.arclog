;; 7d7772cc

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

;; A line of one color, keyed by its normal axis.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:P_line_ ^P_line) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:P_line_ P_line) (:X_m1_ *X_m1)))))

;; A color is thin when every cell of it borders another color or the edge.
(INIT &thin Boundary
  (key ((input *P ^Col))
    (cell (P)
      (input *P Col))))

(RULE &fence
  (input *P *Col)
  (&line_color.value (:v Col))
  (ALL ((input (:P *Pm) Col))
       ((&thin.boundary (:key Col) (:P Pm)))))

(INIT &pen BoundingBox
  (cell (P)
    (&fence *P)))

(RULE &penned_inside1
  (input (:P *P_))
  (&pen.box (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &free_cell
  (input *P)
  (ALL ((&pen.box *B))
       ((&penned_inside1 (:P_ P) (:B_ B)))))

(INIT &free_bg_count Cardinality
  (key ((&free_cell *P)
        (input P ^Col))
    (member ((:m P))
      (&free_cell *P)
      (input P Col))))

(RULE &open_dir
  (&pen.box *B)
  (dir_elem *D)
  (NOT (margin B D (:K 0))))

(INIT &free_bg Order
  (member ((:t Col))
    (&free_bg_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&free_bg_count.size (:key *Col) *N)))

(RULE &mark
  (&free_cell *P)
  (input P *Col)
  (NOT (&free_bg.maximal (:t Col))))

(RULE &heading
  (&mark *P *Col)
  (&open_dir (:D *D2))
  (axis_of (:D D2) *A)
  (&fence (:P *S))
  (&pen.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X S) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B S) (:D D2) (:K *K_m1))
  (margin B (:D D2) (:K K_m1))
  (perp A (:A2 *A2_m2))
  (axis_of (:D *D_m3) (:A A2_m2))
  (margin (:B P) (:D D_m3) (:K *K_m4))
  (margin (:B S) (:D D_m3) (:K K_m4))
  (opposite (:D D2) (:Opp *D_in))
  (step_offset (:D D_in) (:V *V_m5))
  (compose (:A S) (:B V_m5) (:C *G))
  (IF ((input (:P G) Col))
      ((= *D D_in))
      ((= D D2))))

;; Each mark slides along its heading until the fence or the grid edge.
(INIT &slide Distance
  (key ((&heading ^D))
    (weight ((:a P2) (:b P) (:W K))
      (&heading *P D)
      (&heading (:P *P2) D)
      (!= P P2)
      (gap D P (:Q P2) *K))
    (source_distance ((:n P) K)
      (OR ((&heading *P D)
           (margin (:B P) D *K))
          ((&heading P D)
           (&fence (:P *S))
           (gap D P (:Q S) K))))))

(RULE &slide_dir
  (&heading (:D *Key)))

(RULE &rest
  (&mark (:P *P2) *Col)
  (&heading (:P P2) *D)
  (&slide.distance (:key D) (:n P2) *K)
  (&slide_dir (:Key D))
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&rest P *Col))
      ((NOT (&rest P))
       (&mark P)
       (&free_bg.maximal (:t Col)))
      ((NOT (&rest P))
       (NOT (&mark P))
       (= Col Col_in))))
