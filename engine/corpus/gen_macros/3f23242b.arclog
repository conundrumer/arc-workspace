;; 3f23242b

(DET &ground_paint AnyOutNewColor)

(DET &mark RarestColor)

(DET &mark_at
  (ex_input *E *P *Col)
  (&mark (:C Col)))

(DET &painted
  (ex_output *E *P *Col)
  (OR ((&mark_at E P))
      ((ex_input E P (:Col *Col_in))
       (!= Col_in Col))))

(DET &ink
  (&painted *E *P *Col)
  (NOT (&ground_paint (:C Col))))

(DET &cand
  (&ink *E *P *Col)
  (&mark_at E (:P *M))
  (relative (:Base M) (:X P) (:X_rel *Off)))

(DET &missed
  (&cand *Off *Col)
  (ex_output *E)
  (&mark_at E (:P *M))
  (compose (:A M) (:B Off) (:C *P))
  (NOT (&ink E P Col)))

;; The bracket's frame is the ink's bounding box, and the mark sits at
;; the offsets' origin.
(INIT &frame BoundingBox
  (cell ((:P Off))
    (&cand *Off *Col)
    (NOT (&missed Off Col))))

(DET &seat
  (&frame.box *B)
  (relative (:Base B) (:X 0) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (relative (:Base B) (:X 0) (:X_rel *P)))

;; The bracket's own frame, read off the seat.
(INIT &box Frame
  (extent (A N)
    (&seat *P)
    (axis_elem *A)
    (frame_extent P A *N)))

(DET &shape
  (&box.cell *P)
  (&seat (:P *P_seat))
  (relative (:Base P_seat) (:X P) (:X_rel *Off))
  (&mark_at *E (:P *M))
  (compose (:A M) (:B Off) (:C *P2))
  (&painted E (:P P2) *Col))

(DET &arm_dir
  (&shape *P)
  (relative (:Base 0) (:X P) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (> K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (> K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (> K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (> K4_m11 0)
  (&seat (:P *P_seat))
  (dir_elem *D)
  (step_offset D (:V *V_m12))
  (compose (:A P_seat) (:B V_m12) (:C P)))

(RULE &stalk_dir
  (&arm_dir *D))

(RULE &on_edge
  (&box.cell (:P *P_box))
  (dir_elem *D)
  (margin (:B P_box) D (:K 0)))

(RULE &stalk_blocked
  (&on_edge (:P_box *P)))

(RULE &stalk_node
  (input *P)
  (NOT (&stalk_blocked P)))

(RULE &stalk_source
  (&seat *P))

;; The stalk the mark casts, which the bracket's edges halt.
(INIT &stalk Distance
  (key ((&stalk_source (:P ^O))
        (&stalk_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&stalk_source (:P O))
           (&stalk_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&stalk_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&stalk_node (:P Q)))
          ((&stalk_source (:P O))
           (&stalk_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&stalk_node (:P Q))
           (= A2 O))
          ((&stalk_source (:P O))
           (&stalk_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&stalk_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&stalk_node (:P Q)))))
    (source ((:n O))
      (&stalk_source (:P O))
      (&stalk_dir D))))

(RULE &stalk_ray
  (&stalk.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &stalk_end
  (&stalk_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&stalk_ray (:P Q) D Origin)))

;; The bracket edge the line runs along, and the line's color.
(DET &ground_dir DirDomain)

(RULE &placed
  (input (:P *Q) (:Col *Col_mark))
  (&mark (:C Col_mark))
  (&box.cell (:P *P_box))
  (&seat (:P *P_seat))
  (relative (:Base P_seat) (:X P_box) (:X_rel *Off))
  (compose (:A Q) (:B Off) (:C *P_grid))
  (input (:P P_grid)))

(RULE &line_cell
  (&placed *P_box (:P_grid *P_ground))
  (&ground_dir *D)
  (margin (:B P_box) D (:K 0))
  (margin (:B P_ground) D (:K *K_m1))
  (input *P)
  (margin (:B P) D (:K K_m1))
  (NOT (&placed (:P_grid P))))

(RULE &paint
  (OR ((&line_cell *P)
       (&ground_paint (:C *Col)))
      ((&placed *P_box (:P_grid P))
       (&shape (:P P_box) Col))))

(ALTS $choice "how the bracket's ink is derived" $Lookup
  (ALT $Frame
    ;; The axis whose edges take the corners.
    (DET &face_axis AxisDomain)

    (DET &arm_paint AnyOutNewColor)

    (RULE &on_face
      (&on_edge *P_box *D)
      (&face_axis *A)
      (axis_of D A))

    (DET &corner
      (&box.cell (:P *P_box))
      (diag_dir_elem (:D *Diag))
      (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
      (margin (:B P_box) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P_box) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (DET &edge_paint
      (&shape *P *Col)
      (&on_edge (:P_box P) *D)
      (NOT (&corner (:P_box P))))

    (RULE &frame_ink
      (OR ((&on_edge *P_box *D)
           (&edge_paint D *Col)
           (&face_axis *A)
           (OR ((axis_of D A))
               ((NOT (&on_face P_box)))))
          ((&stalk_ray (:P P_box) *K)
           (&box.cell (:P P_box))
           (!= K 0)
           (&arm_paint (:C Col)))))

    (RULE &paint
      (OR ((&placed *P_box (:P_grid *P))
           (&frame_ink P_box *Col))
          ((&line_cell P)
           (&ground_paint (:C Col)))))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
