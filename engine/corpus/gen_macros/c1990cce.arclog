;; c1990cce

(DET &grow DirDomain)

(RULE &corner
  (&grow *D)
  (corner_dir (:C *Diag) D))

(DET &echo_axis DiagAxisDomain)

(RULE &cast_corner
  (&corner *Diag)
  (diag_axis_of (:D Diag) (:Da *DA))
  (&echo_axis (:Da DA)))

(RULE &rays_dir
  (&cast_corner (:Diag *D)))

(RULE &rays_node
  (input *P))

(RULE &side
  (input *P)
  (perp (:A *A_m1) (:A2 *A2_m2))
  (frame_extent P (:A A_m1) *N)
  (frame_extent P (:A A2_m2) (:N *K))
  (> N K))

(INIT &frame Frame
  (extent (A N)
    (axis_elem *A)
    (&side *N)))

(RULE &mirror_corner
  (&corner *Diag)
  (NOT (&cast_corner Diag)))

(DET &bg DominantColor)

(RULE &seed2
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (&frame.cell *P)
  (&grow *D)
  (opposite D (:Opp *D0))
  (margin (:B P_in) (:D D0) (:K *K_m1))
  (margin (:B P) (:D D0) (:K K_m1))
  (ALL ((opposite (:D *Dm) (:Opp D0))
        (input (:P P_in) (:Col *Colm))
        (axis_of (:D D0) (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E_m3) (:A A2_m2))
        (margin (:B P_in) (:D E_m3) (:K *K1_m4))
        (margin (:B P) (:D E_m3) (:K *K2_m5)))
       ((= K1_m4 K2_m5))))

(DET &spacing SepTileCount)

(RULE &emitter
  (&seed2 (:P *S))
  (&grow *D)
  (axis_of D *A)
  (opposite D (:Opp *O))
  (&frame.cell (:P *Q))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B S) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3))
  (relative (:Base S) (:X Q) (:X_rel *V))
  (margin (:B V) (:D O) *K)
  (&spacing (:N *Sp))
  (divide (:T K) (:Side Sp) (:Gap 0) (:Remainder 0))
  (&mirror_corner (:Diag *MD))
  (dir8_opposite (:D MD) (:D2 *O_m5))
  (edge_inset (:D O_m5) K (:B *B1_m6))
  (edge_inset (:D MD) K (:B *I_m8))
  (relative (:Base I_m8) (:X 0) (:X_rel *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *V_m4))
  (compose (:A S) (:B V_m4) (:C *P)))

(RULE &rays_source
  (&emitter *P))

(INIT &rays Distance
  (key ((&rays_source (:P ^O))
        (&rays_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:P O))
           (&rays_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:P Q)))
          ((&rays_source (:P O))
           (&rays_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:P Q))
           (= A2 O))
          ((&rays_source (:P O))
           (&rays_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:P Q)))))
    (source ((:n O))
      (&rays_source (:P O))
      (&rays_dir D))))

(RULE &rays_ray
  (&rays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray (:P Q) D Origin)))

(DET &echo AnyOutNewColor)

(RULE &arm
  (&frame.cell *P)
  (&seed2 (:P *S))
  (&corner *Diag)
  (diag_axis_of (:D Diag) (:Da *DA))
  (diag_perp (:Da DA) (:Da2 *A2_m1))
  (diag_axis_of (:D *D_m2) (:Da A2_m1))
  (corner_dist P (:Diag D_m2) (:K *K_m3))
  (corner_dist (:P S) (:Diag D_m2) (:K K_m3)))

(RULE &echo2
  (&rays_ray *P)
  (&frame.cell P)
  (NOT (&arm P)))

(RULE &v_color2
  (&seed2 *Col))

(ALTS $v "V color" $VSeed
  (ALT $VFixed
    (DET &v_color RarestColor)

    (RULE &v_color2
      (&v_color (:C *Col)))))

(ALTS $e "echo placement" $Emit
  (ALT $Stripe
    (DET &seed_slab_anchor1
      (opposite *D (:Opp *D0_))
      (ex_input *E (:P *P_in_) *Col)
      (ex_output E (:P *P_out_))
      (axis_of (:D D0_) (:A *A_m1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (axis_of (:D *E_m3) (:A A2_m2))
      (margin (:B P_in_) (:D E_m3) (:K *K1_m4))
      (margin (:B P_out_) (:D E_m3) (:K *K2_m5))
      (!= K1_m4 K2_m5))

    (RULE &within2
      (&frame.cell *P)
      (&seed2 (:P *S))
      (&cast_corner (:Diag *CD))
      (diag_dir_elem (:D CD))
      (corner_dist P (:Diag CD) (:K *K1_m1))
      (corner_dist (:P S) (:Diag CD) (:K *K2_m2))
      (< K1_m1 K2_m2)
      (&mirror_corner (:Diag *MD))
      (diag_dir_elem (:D MD))
      (corner_dist P (:Diag MD) (:K *K1_m3))
      (corner_dist (:P S) (:Diag MD) (:K *K2_m4))
      (< K1_m3 K2_m4))

    (DET &seed
      (ex_input *E (:P *P_in) *Col)
      (NOT (&bg (:C Col)))
      (ex_output E *P)
      (&grow *D)
      (opposite D (:Opp *D0))
      (margin (:B P_in) (:D D0) (:K *K_m1))
      (margin (:B P) (:D D0) (:K K_m1))
      (NOT (&seed_slab_anchor1 (:D0_ D0) (:P_in_ P_in) (:P_out_ P))))

    (DET &within
      (ex_output *E *P)
      (&seed E (:P *S))
      (&cast_corner (:Diag *CD))
      (diag_dir_elem (:D CD))
      (corner_dist P (:Diag CD) (:K *K1_m1))
      (corner_dist (:P S) (:Diag CD) (:K *K2_m2))
      (< K1_m1 K2_m2)
      (&mirror_corner (:Diag *MD))
      (diag_dir_elem (:D MD))
      (corner_dist P (:Diag MD) (:K *K1_m3))
      (corner_dist (:P S) (:Diag MD) (:K *K2_m4))
      (< K1_m3 K2_m4))

    ;; The steps from each echoed cell inside the cone to the seed, counted
    ;; as the seed's distance to the mirror corner less the cell's.
    (INIT &near Order
      (key ((ex_output ^E *P *Col)
            (&echo (:C Col))
            (&within E P)
            (&seed E (:P *S))
            (relative (:Base P) (:X S) (:X_rel *V))
            (&mirror_corner (:Diag *MD))
            (corner_dist (:P V) (:Diag MD) *K))
        (member ((:t K))
          (ex_output E *P *Col)
          (&echo (:C Col))
          (&within E P)
          (&seed E (:P *S))
          (relative (:Base P) (:X S) (:X_rel *V))
          (&mirror_corner (:Diag *MD))
          (corner_dist (:P V) (:Diag MD) *K))
        (score ((:t K) (:S K))
          (ex_output E *P *Col)
          (&echo (:C Col))
          (&within E P)
          (&seed E (:P *S))
          (relative (:Base P) (:X S) (:X_rel *V))
          (&mirror_corner (:Diag *MD))
          (corner_dist (:P V) (:Diag MD) *K))))

    (DET &period
      (&near.minimal (:t *K)))

    ;; $Stripe — diagonal offset from the echo-axis arm is a multiple of
    ;; &period: the same corner_dist class from the mirror corner as the seed.
    (RULE &echo2
      (&within2 *P)
      (&seed2 (:P *S))
      (&mirror_corner (:Diag *MD))
      (corner_dist P (:Diag MD) (:K *Kp))
      (corner_dist (:P S) (:Diag MD) (:K *Ks))
      (&period (:K *Per))
      (divide (:T Kp) (:Side Per) (:Gap 0) (:Remainder *R))
      (divide (:T Ks) (:Side Per) (:Gap 0) (:Remainder R)))))

(RULE &output
  (OR ((&arm *P)
       (&v_color2 *Col))
      ((&echo2 P)
       (&echo (:C Col)))
      ((&frame.cell P)
       (NOT (&arm P))
       (NOT (&echo2 P))
       (&bg (:C Col)))))
