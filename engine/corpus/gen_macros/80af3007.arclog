;; 80af3007

(DET &ink RarestColor)

;; The picture: the box the ink occupies.
(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&ink (:C Col))))

;; A pixel's side, in cells.
(DET &scale TileCount)

(RULE &pixel_cell_division_axis_split1
  (&bbox.box *B)
  (input *P)
  (relative (:Base B) (:X P) (:X_rel *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &pixel_cell_division_side
  (axis_elem *A)
  (&scale (:N *K)))

(RULE &pixel_cell_division_axis
  (OR ((input (:P *P2))
       (&bbox.box *B)
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P2) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P2) (:X_rel *P))
       (axis_elem *A)
       (&scale (:N *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input (:P *P22))
       (&bbox.box (:B *B2))
       (ALL ((dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P22) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B2) (:X P22) (:X_rel P))
       (axis_elem A)
       (NOT (&pixel_cell_division_side A))
       (&pixel_cell_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &pixel_cell_division_tile
  (&pixel_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&pixel_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &pixel_cell
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&pixel_cell_division_tile (:P P_inner) (:P_outer *P_tile)))

(RULE &pixel
  (&pixel_cell *P_tile))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&pixel *P_tile))
  (inner ((:P P_intile))
    (&pixel (:P_tile *P_intile))))

(DET &bg DominantColor)

(RULE &inked
  (&pixel_cell *P *P_tile)
  (input P *Col)
  (&ink (:C Col)))

(RULE &cell
  (&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))

(RULE &stamp
  (&cell (:P_grid *P) *P_tile *P_intile)
  (&inked P_tile)
  (&inked (:P_tile P_intile)))

(RULE &output
  (&cell (:P_grid *P))
  (IF ((&stamp P))
      ((&ink (:C *Col)))
      ((&bg (:C Col)))))
