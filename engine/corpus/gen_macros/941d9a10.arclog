;; 941d9a10

(RULE &cut_divider_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &off_line_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(DET &sep UnchangedColor)

(RULE &cut_divider
  (input *P)
  (axis_elem *A)
  (&cut_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (ALL ((input (:P *Pm) *Col)
        (&off_line_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
       ((&sep (:C Col)))))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D (:K *K2)))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K2))
      (input *P)
      (dir_elem D)
      (margin (:B P) D (:K *K2)))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D (:K *K2))
  (&cut_rank.rank (:key D) (:t K2) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; the color of the block at the center of the arrangement
(DET &center_color AnyOutNewColor)

(DET &corner_color
  (&cut_tile_of *E *P *P_tile)
  (relative (:Base 0) (:X P_tile) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (corner_dir (:C *D) (:A *A_m12) (:D *D1_m13))
  (perp (:A A_m12) (:A2 *A2_m14))
  (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
  (margin (:B P_tile) (:D D1_m13) (:K *K1_m16))
  (margin (:B 0) (:D D1_m13) (:K K1_m16))
  (margin (:B P_tile) (:D D2_m15) (:K *K2_m17))
  (margin (:B 0) (:D D2_m15) (:K K2_m17))
  (ex_output E P (:Col *C))
  (ex_input E P (:Col *Col_in))
  (!= C Col_in))

(RULE &painted
  (&cut_tile_of *P *P_tile)
  (OR ((&corner_color *D (:C *Col))
       (relative (:Base 0) (:X P_tile) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (>= K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (>= K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (>= K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (>= K4_m11 0)
       (corner_dir (:C D) (:A *A_m12) (:D *D1_m13))
       (perp (:A A_m12) (:A2 *A2_m14))
       (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
       (margin (:B P_tile) (:D D1_m13) (:K *K1_m16))
       (margin (:B 0) (:D D1_m13) (:K K1_m16))
       (margin (:B P_tile) (:D D2_m15) (:K *K2_m17))
       (margin (:B 0) (:D D2_m15) (:K K2_m17)))
      ((&center_color (:C Col))
       (axis_of (:D *D1_m18) (:A *A1_m19))
       (opposite (:D D1_m18) (:Opp *O1_m20))
       (perp (:A A1_m19) (:A2 *A2_m21))
       (axis_of (:D *D2_m22) (:A A2_m21))
       (opposite (:D D2_m22) (:Opp *O2_m23))
       (margin (:B P_tile) (:D D1_m18) (:K *K1_m24))
       (margin (:B P_tile) (:D O1_m20) (:K K1_m24))
       (margin (:B P_tile) (:D D2_m22) (:K *K2_m25))
       (margin (:B P_tile) (:D O2_m23) (:K K2_m25)))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
