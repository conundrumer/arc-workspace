;; 337b420f

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &panel_axis AxisDomain)

(INIT &panel_cell_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(DET &panel_count SepTileCount)

(DET &sep_width DivisorRatio)

(RULE &panel_cell_division_gap
  (&panel_axis *A)
  (&sep_width (:K *G)))

(RULE &panel_cell_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &panel_cell_division_parts
  (&panel_axis *A)
  (&panel_count *N))

(RULE &panel_cell_division_axis
  (OR ((input *P)
       (&panel_axis *A)
       (&panel_count *N)
       (&sep_width (:K *G))
       (&panel_cell_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&panel_axis A)
       (&panel_count (:N *N2))
       (&sep_width (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&panel_axis A)
       (&panel_count (:N *N3))
       (NOT (&panel_cell_division_gap A))
       (&panel_cell_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&panel_axis A)
       (&panel_count (:N *N4))
       (NOT (&panel_cell_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&panel_cell_division_parts A))
       (&panel_cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &panel_cell_division_tile
  (&panel_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&panel_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &panel_cell
  (&panel_cell_division_tile (:P *P_grid) (:P_outer *P_panel) (:P_inner *P_frame)))

(ALTS $d "what the panel cut reads" $Count
  (ALT $Size
    (DET &panel_size ConstOutDim)

    (RULE &panel_cell_division2_gap
      (&panel_axis *A)
      (&sep_width (:K *G)))

    (RULE &panel_cell_division2_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &panel_cell_division2_side
      (&panel_axis *A)
      (&panel_size (:N *K)))

    (RULE &panel_cell_division2_axis
      (OR ((input *P)
           (&panel_axis *A)
           (&panel_size (:N *K))
           (&sep_width (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&panel_axis A)
           (&panel_size (:N *K2))
           (NOT (&panel_cell_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&panel_cell_division2_side A))
           (&panel_cell_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &panel_cell_division2_tile
      (&panel_cell_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&panel_cell_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &panel_cell
      (&panel_cell_division2_tile (:P *P_grid) (:P_outer *P_panel) (:P_inner *P_frame)))))

(ALTS $move "which shape slides" $Least
  (ALT $Yield
    (INIT &smallest Order
      (member ((:t (:V M) (:S N)))
        (&least_slide.minimal (:key *M))
        (&size.size (:key (:Id M)) *N))
      (score ((:t (:V M) (:S N)) (:S N))
        (&least_slide.minimal (:key *M))
        (&size.size (:key (:Id M)) *N)))

    (RULE &mover
      (&smallest.minimal (:t (:V *M))))))

(RULE &obj_node
  (&panel_cell (:P_grid *P))
  (input P *Col)
  (NOT (&bg (:C Col))))

(INIT &obj Quotient
  (edge ((:a P) (:b P2))
    (OR ((&obj_node *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:P P2)))
        ((&obj_node P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(RULE &frame
  (&panel_cell *P_frame))

(INIT &size Cardinality
  (key ((&obj_component (:P *P_grid) ^Id))
    (member ((:m P_grid))
      (&obj_component (:P *P_grid) Id))))

;; A panel's piece is the larger of the shapes it holds.
(INIT &largest Order
  (key ((&obj_component (:P *P_grid) *Id)
        (&panel_cell P_grid ^P_panel)
        (&size.size (:key Id) *N))
    (member ((:t (:V Id) (:S N)))
      (&obj_component (:P *P_grid) *Id)
      (&panel_cell P_grid P_panel)
      (&size.size (:key Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&obj_component (:P *P_grid) *Id)
      (&panel_cell P_grid P_panel)
      (&size.size (:key Id) *N))))

(RULE &piece
  (&largest.maximal (:t (:V *Id)))
  (&obj_component (:P *P_grid) Id)
  (input (:P P_grid) *Col))

(RULE &piece_cell
  (&piece *Id)
  (&obj_component (:P *P_grid) Id)
  (&panel_cell P_grid *P_frame))

(RULE &slide
  (&frame (:P_frame *P))
  (dir_elem *D)
  (margin (:B P) D *K))

(RULE &covered
  (&piece (:Id *M))
  (&slide *D *K)
  (&piece_cell *Id (:P_frame *P))
  (OR ((= Id M)
       (dir8_opposite D (:D2 *O_m2))
       (edge_inset (:D O_m2) K (:B *B1_m3))
       (edge_inset D K (:B *I_m5))
       (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
       (compose (:A P) (:B V_m1) (:C *P_frame)))
      ((!= Id M)
       (= P_frame P))))

;; The piece holding a frame cell, absent where two pieces meet.
(INIT &holder Singleton
  (key ((&covered ^M ^D ^K *Id (:P_frame ^P)))
    (member ((:v Id))
      (&covered M D K *Id (:P_frame P)))))

(RULE &clash
  (OR ((&holder.plural (:key *M *D *K)))
      ((&covered M D K (:P_frame *P))
       (NOT (&frame (:P_frame P))))))

(RULE &fits
  (&piece (:Id *M))
  (&slide *D *K)
  (NOT (&clash M D K)))

;; The shortest slide each piece can clear the meeting with.
(INIT &least_slide Order
  (key ((&fits ^M *K))
    (member ((:t K))
      (&fits M *K))
    (score ((:t K) (:S K))
      (&fits M *K))))

(INIT &shortest Order
  (member ((:t (:V M) (:S K)))
    (&least_slide.minimal (:key *M) (:t *K)))
  (score ((:t (:V M) (:S K)) (:S K))
    (&least_slide.minimal (:key *M) (:t *K))))

(RULE &mover
  (&shortest.minimal (:t (:V *M))))

(RULE &chosen
  (&mover *M)
  (&least_slide.minimal (:key M) (:t *K))
  (&fits M *D K))

(RULE &paint
  (&chosen *M *D *K)
  (&holder.value (:key M D K (:P *P_frame)) (:v *Id))
  (&piece Id *Col))

(RULE &output
  (OR ((&paint (:P_frame *P) *Col))
      ((&frame (:P_frame P))
       (&bg (:C Col))
       (NOT (&paint (:P_frame P))))))
