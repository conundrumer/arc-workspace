;; 7d18a6fb

(DET &gap TileDim)

;; The legend's color.
(DET &frame VanishedColor)

(INIT &legend BoundingBox
  (cell (P)
    (input *P *Col)
    (&frame (:C Col))))

(RULE &legend_cell
  (&legend.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &marker
  (&legend_cell *P *P_inner)
  (input P *Col)
  (NOT (&frame (:C Col))))

(INIT &quadrant_color_division_sides ExtentDivisions
  (frame ((:P P_inner))
    (&marker *P_inner)))

;; Quadrants per axis, and the gap between them.
(DET &tiles TileDim)

(RULE &quadrant_color_division_gap
  (axis_elem *A)
  (&gap (:D *G)))

(RULE &quadrant_color_division_axis_split1
  (&marker (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &quadrant_color_division_parts
  (axis_elem *A)
  (&tiles (:D *N)))

(RULE &quadrant_color_division_axis
  (OR ((&marker (:P_inner *P))
       (axis_elem *A)
       (&tiles (:D *N))
       (&gap (:D *G))
       (&quadrant_color_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&marker (:P_inner P))
       (axis_elem A)
       (&tiles (:D *N2))
       (&gap (:D *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&marker (:P_inner P))
       (axis_elem A)
       (&tiles (:D *N3))
       (NOT (&quadrant_color_division_gap A))
       (&quadrant_color_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&marker (:P_inner P))
       (axis_elem A)
       (&tiles (:D *N4))
       (NOT (&quadrant_color_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((&marker (:P_inner P))
       (axis_elem A)
       (NOT (&quadrant_color_division_parts A))
       (&quadrant_color_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &quadrant_color_division_tile
  (&quadrant_color_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&quadrant_color_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &canvas
  (&legend_cell (:P_inner *P)))

(RULE &ink_division_gap
  (axis_elem *A)
  (&gap (:D *G)))

(RULE &ink_division_parts
  (axis_elem *A)
  (&tiles (:D *N)))

(DET &bg DominantColor)

;; Each color's shape outside the legend, with its bounding box.
(INIT &shape BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col)))
        (NOT (&legend_cell P)))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col)))
      (NOT (&legend_cell P)))))

(RULE &quadrant_color
  (&marker *P_inner *Col)
  (&quadrant_color_division_tile (:P P_inner) (:P_outer *P_tile)))

(RULE &quadrant_ink
  (&quadrant_color *P_tile *Col)
  (&shape.cell (:key Col) *P)
  (&shape.box (:key Col) *B)
  (ALL ((&shape.cell (:key (:Col *Colm)) P)
        (&shape.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(ALTS $choice "where the extracted shapes go in the output" $Legend
  (ALT $Concat
    (INIT &abutted_tiling Tiling
      (outer ((:P P_tile))
        (&quadrant_ink *P_tile))
      (inner ((:P P_intile))
        (&quadrant_ink *P_intile))
      (gap (A G)
        (axis_elem *A)
        (&gap (:D *G))))

    (RULE &abutted
      (&quadrant_ink *P_tile *P_intile *Col)
      (&abutted_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_grid_out)))

    (RULE &ink
      (&abutted (:P_grid_out *P) *Col))

    ;; The assembled frame, gap cells included.
    (INIT &assembled Frame
      (extent (A N)
        (&abutted (:P_grid_out *P))
        (axis_elem *A)
        (frame_extent P A *N)))

    (RULE &canvas
      (&assembled.cell *P)))
  (ALT $Stamp
    (RULE &ink
      (&canvas *P)
      (&marker (:P_inner *M) *Col)
      (&shape.cell (:key Col) (:P *P2))
      (&shape.box (:key Col) *B)
      (ALL ((&shape.cell (:key (:Col *Colm)) (:P P2))
            (&shape.box (:key (:Col Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P2) (:X_rel *P_intile))
      (relative (:Base P_intile) (:X P) (:X_rel *B_stamp))
      (relative (:Base B_stamp) (:X M) (:X_rel *P_rel))
      (ALL ((&shape.box (:key (:Col *Colmm)) (:B *Bm))
            (&shape.cell (:key (:Col Colmm)) (:P *Pm))
            (relative (:Base Bm) (:X Pm) (:X_rel *P_intilem))
            (&canvas (:P *P_grid_outm))
            (relative (:Base P_intilem) (:X P_grid_outm) (:X_rel *B_stampm))
            (&marker (:P_inner *Mm) (:Col Colmm))
            (relative (:Base B_stampm) (:X Mm) (:X_rel P_rel))
            (opposite (:D *D_m1m) (:Opp *O_m2))
            (margin (:B P_rel) (:D D_m1m) (:K *K1_m3))
            (margin (:B P_rel) (:D O_m2) (:K *K2_m4)))
           ((= K1_m3 K2_m4))))))

(INIT &ink_division_sides ExtentDivisions
  (frame ((:P P_grid_out))
    (&canvas (:P *P_grid_out))))

(RULE &ink_division_axis_split1
  (&canvas (:P *P_grid_out_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_out_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_out_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_out_) (:X_rel *X_m1_)))

(RULE &ink_division_axis
  (OR ((&canvas *P)
       (axis_elem *A)
       (&tiles (:D *N))
       (&gap (:D *G))
       (&ink_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&canvas P)
       (axis_elem A)
       (&tiles (:D *N2))
       (&gap (:D *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&canvas P)
       (axis_elem A)
       (&tiles (:D *N3))
       (NOT (&ink_division_gap A))
       (&ink_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&canvas P)
       (axis_elem A)
       (&tiles (:D *N4))
       (NOT (&ink_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((&canvas P)
       (axis_elem A)
       (NOT (&ink_division_parts A))
       (&ink_division_axis_split1 (:P_grid_out_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &ink_division_tile
  (&ink_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&ink_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &ink
  (&ink_division_tile *P (:P_outer *P_tile) (:P_inner *P_intile))
  (&quadrant_ink P_tile P_intile *Col))

(RULE &output
  (&canvas *P)
  (OR ((&ink P *Col))
      ((NOT (&ink P))
       (&bg (:C Col)))))
