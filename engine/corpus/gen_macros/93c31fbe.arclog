;; 93c31fbe

(DET &bg DominantColor)

;; the color of the content the boxes hold
(DET &content RarestColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&content (:C Col))))

(RULE &corner
  (&mark *P)
  (diag_opposite *D (:Opp *G))
  (corner_dir (:C G) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C G) (:A A2_m2) (:D *D2))
  (step_offset (:D D1) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q1))
  (&mark (:P Q1))
  (step_offset (:D D2) (:V *V_m4))
  (compose (:A P) (:B V_m4) (:C *Q2))
  (&mark (:P Q2)))

(INIT &span BoundingBox
  (key ((&corner ^P *D)
        (&corner (:P ^Q) (:D *G))
        (diag_opposite D (:Opp G))
        (OR ((= *R P))
            ((= R Q))))
    (cell ((:P R))
      (&corner P *D)
      (&corner (:P Q) (:D *G))
      (diag_opposite D (:Opp G))
      (OR ((= *R P))
          ((= R Q))))))

(RULE &corner_at
  (&span.box *B)
  (&corner *P *D)
  (ALL ((corner_dir (:C D) (:D *D_m1))
        (margin (:B P) (:D D_m1) (:K *K1_m2))
        (margin B (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

(RULE &box
  (&span.box *B)
  (ALL ((diag_dir_elem *D))
       ((&corner_at B D))))

(RULE &content_in
  (input *P *Col)
  (&content (:C Col))
  (&box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; The box is longer on axis a, so the content mirrors along the box's length.
(RULE &mirror_axis
  (&box *B)
  (&corner_at B *P)
  (perp *A *A2)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *N1))
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) (:N *N2))
  (> N1 N2))

(ALTS $choice "Which way the content mirrors inside its box." $Long
  (ALT $Clear
    ;; The content lies wholly on the d side of the midline across axis a, so the
    ;; flip on a carries it onto the side it keeps clear.
    (RULE &mirror_axis
      (&content_in *B)
      (dir_elem *D)
      (ALL ((&content_in B *P_inner)
            (opposite D (:Opp *O_m1))
            (margin (:B P_inner) D *K)
            (margin (:B P_inner) (:D O_m1) (:K *K2)))
           ((< K K2)))
      (axis_of D *A))))

(RULE &ink
  (&content_in *B *P_inner)
  (OR ((&mirror_axis B *A)
       (axis_inversion A (:T *F))
       (apply (:D F) (:P P_inner) (:P_out *P_img)))
      ((= P_img P_inner)))
  (compose (:A B) (:B P_img) (:C *P)))

(RULE &output
  (input *P (:Col *Col2))
  (OR ((NOT (&mark P))
       (&ink P)
       (&content (:C *Col)))
      ((&mark P)
       (= Col Col2))
      ((NOT (&mark P))
       (NOT (&ink P))
       (&bg (:C Col)))))
