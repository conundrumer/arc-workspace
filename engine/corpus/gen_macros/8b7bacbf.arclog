;; 8b7bacbf

(RULE &region_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background is the commonest color; the rest is ink.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

;; Background regions, and the ink beside each.
(INIT &region Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&bg Col)
         (&region_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&bg (:Col Col2)))
        ((input P (:Col *Col3))
         (&bg (:Col Col3))
         (= P3 P)))))

(RULE &region_component
  (&region.class (:a *P) *Id))

(RULE &box_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &object_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(RULE &ink
  (input *P *Col)
  (NOT (&bg Col)))

;; Objects: same-colored ink, 8-connected.
(INIT &object Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&ink *P *Col)
         (&object_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3) Col))
        ((&ink P Col)
         (= P3 P)))))

(RULE &object_component
  (&object.class (:a *Key *P) *Id))

(RULE &beside
  (input *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&ink (:P Q) *Col))

(RULE &contact
  (&object_component *P (:Id *A))
  (&beside P *Q)
  (&object_component (:P Q) (:Id *B)))

;; The circuits: the classes of objects joined by touching. The marker's
;; circuit stands in for a wire's continuation under a wire that crosses it:
;; the crossing wire touches both parts. It also reaches a wire that another
;; wire of the circuit merely touches.
(INIT &circuit Quotient
  (edge ((:a W) (:b W2))
    (&contact (:A *W) (:B *W2))))

(RULE &live
  (&ink *P (:Col *M))
  (ALL ((&ink (:P *Pm) (:Col M))
        (&ink (:P *Q) (:Col M)))
       ((= Pm Q)))
  (&object_component (:Key M) P (:Id *W0))
  (&circuit.class (:a W0) (:Id *C))
  (&beside P (:Col *G))
  (&object_component (:Key G) (:Id *W))
  (&circuit.class (:a W) (:Id C)))

(RULE &wall
  (&region_component (:P *Q) (:Id *H))
  (&beside (:P Q) (:Q *P) *Col))

;; A hole is a region walled in one color.
(INIT &wall_color Singleton
  (key ((&wall ^H *Col))
    (member ((:v Col))
      (&wall H *Col))))

(RULE &box_node
  (&wall_color.value (:key (:H *Key)) (:v *Col))
  (&ink *P Col))

;; A hole's box: its wall, and the same-colored ink 4-connected to the wall,
;; so two boxes of one color that meet at a corner stay apart.
(INIT &box Propagation
  (key ((OR ((&wall ^H *P)
             (&box_node (:Key H) P))
            ((&box_node (:Key H) P)
             (&box_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&box_node (:Key H) (:P Q)))))
    (source ((:n P))
      (&wall H *P)
      (&box_node (:Key H) P))
    (edge ((:a P) (:b Q))
      (&box_node (:Key H) *P)
      (&box_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&box_node (:Key H) (:P Q)))))

(RULE &touch
  (&box.reached (:key *H) (:n *P))
  (&beside P *Q)
  (NOT (&box.reached (:key H) (:n Q)))
  (&object_component (:P Q) (:Id *W)))

(RULE &fill
  (&region_component *P (:Id *H))
  (&touch H *W)
  (&live W (:M *Col)))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))
