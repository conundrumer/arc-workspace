;; 981add89

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The edge the marks sit on.
(DET &mark_dir DirDomain)

;; The field is the commonest color, and the ink is what it does not fill.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&field.maximal (:t Col))))

(RULE &mark
  (&ink *P *Col)
  (&mark_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &line_axis
  (&mark_dir *D)
  (axis_of D *A))

(ALTS $choice "which ink cells are marks, and which way their lines run" $Header
  (ALT $Isolated
    ;; The axis the marks' lines run along.
    (DET &axis AxisDomain)

    (RULE &block_cell
      (&ink *P *Col)
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&ink (:P Q) Col))

    (RULE &mark
      (&ink *P *Col)
      (NOT (&block_cell P)))

    (RULE &line_axis
      (&axis *A))))

(RULE &painted
  (&mark (:P *Q) (:Col *Col_mark))
  (&line_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B Q) (:D D_m2) (:K *K_m3))
  (input *P)
  (margin (:B P) (:D D_m2) (:K K_m3))
  (NOT (&mark P)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&painted P)))
      ((&painted P *Col_mark)
       (IF ((input P (:Col Col_mark)))
           ((&field.maximal (:t Col)))
           ((= Col Col_mark))))))
