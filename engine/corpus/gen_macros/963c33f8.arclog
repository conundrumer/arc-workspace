;; 963c33f8

(DET &fall DirDomain)

(DET &bg DominantColor)

(RULE &piece_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

;; the debris the piece travels through
(DET &solid ColorDomain)

(RULE &piece
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&solid (:C Col)))
  (&fall *D)
  (axis_of D *A)
  (&piece_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across)))

(RULE &slide_dir
  (&piece (:P_across *Key))
  (&fall *D))

(RULE &shift
  (input *P)
  (&fall *D)
  (axis_of D *A)
  (sub_extent P A *K)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V)))

;; the piece color that debris stops; the piece's other cells pass through
(DET &stop RarestColor)

(RULE &blocked
  (&piece *P_across *P *Col)
  (&shift *V)
  (compose (:A P) (:B V) (:C *P2))
  (OR ((NOT (input (:P P2))))
      ((&stop (:C Col))
       (input (:P P2) (:Col *Col2))
       (&solid (:C Col2)))))

(RULE &slide_node
  (&piece (:P_across *Key))
  (OR ((&shift (:V *P))
       (NOT (&blocked (:P_across Key) (:V P))))
      ((= P 0))))

(RULE &slide_node_ray
  (&slide_node *Key *P))

(RULE &slide_source
  (&slide_node *Key *P))

;; Each line stands where it is, and travels through the displacements that
;; nothing blocks.
(INIT &slide Distance
  (key ((&slide_source (:Key ^Ky) (:P ^O))
        (&slide_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&slide_source (:Key Ky) (:P O))
           (&slide_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&slide_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&slide_node_ray (:Key Ky) (:P Q)))
          ((&slide_source (:Key Ky) (:P O))
           (&slide_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&slide_node_ray (:Key Ky) (:P Q))
           (= A2 O))
          ((&slide_source (:Key Ky) (:P O))
           (&slide_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&slide_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&slide_node_ray (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&slide_source (:Key Ky) (:P O))
      (&slide_dir (:Key Ky) D))))

(RULE &slide_ray
  (&slide.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &slide_end
  (&slide_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&slide_ray Key (:P Q) D Origin)))

(RULE &landed
  (&piece *P_across (:P *P3) *Col)
  (&slide_end (:Key P_across) (:P *V) (:Origin 0))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &output
  (OR ((&landed *P *Col))
      ((input P (:Col *Col_in))
       (NOT (&landed P))
       (IF ((&piece P))
           ((&bg (:C Col)))
           ((= Col Col_in))))))
