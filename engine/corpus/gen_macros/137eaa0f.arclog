;; 137eaa0f

(DET &bg DominantColor)

(DET &frame Frame)

;; An ink color the overlay draws fewer times than the input holds it:
;; the key cells of every fragment land on one output cell.
(INIT &surplus Excess
  (key ((OR ((ex_output ^E)
             (ex_input E *P ^Col)
             (NOT (&bg (:C Col))))
            ((ex_output E P Col))))
    (plus ((:m P))
      (ex_output E)
      (ex_input E *P Col)
      (NOT (&bg (:C Col))))
    (minus ((:m P))
      (ex_output E *P Col))))

(DET &key
  (&surplus.excess (:key (:Col *C))))

(RULE &mark
  (input *P *Col)
  (&key (:C Col)))

(DET &anchor
  (ex_output *P *Col)
  (&key (:C Col)))

(RULE &paint
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (&mark (:P *A))
  (relative (:Base A) (:X P2) (:X_rel *P_rel))
  (&anchor (:P *Anc))
  (compose (:A Anc) (:B P_rel) (:C *P))
  (&frame P))

(ALTS $choice "what collects into a fragment, and the output frame" $Frame
  (ALT $Object
    (RULE &comp8_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (INIT &comp8 Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (NOT (&bg (:C Col)))
             (&comp8_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (NOT (&bg (:C Col2))))
            ((input P (:Col *Col3))
             (NOT (&bg (:C Col3)))
             (= P3 P)))))

    (RULE &comp8_component
      (&comp8.class (:a *P) *Id))

    (RULE &obj_off
      (&mark (:P *A))
      (&comp8_component (:P A) *Id)
      (input *P *Col)
      (&comp8_component P Id)
      (relative (:Base A) (:X P) (:X_rel *P_rel)))

    (INIT &obox BoundingBox
      (cell ((:P P_rel))
        (&obj_off *P_rel)))

    (RULE &view
      (&mark (:P *A))
      (input *P)
      (relative (:Base A) (:X P) (:X_rel *P_rel))
      (&obox.box *B)
      (ALL ((&mark (:P *Am))
            (input (:P *Pm))
            (relative (:Base Am) (:X Pm) (:X_rel P_rel))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_rel) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_rel) (:X_rel *P_inner)))

    (RULE &output
      (OR ((&obj_off *P_rel *Col)
           (&view P_rel (:P_inner *P)))
          ((&view (:P_rel *P_rel2) (:P_inner P))
           (NOT (&obj_off (:P_rel P_rel2)))
           (&bg (:C Col)))))))

(RULE &output
  (OR ((&paint *P *Col))
      ((&frame P)
       (NOT (&paint P))
       (&bg (:C Col)))))
