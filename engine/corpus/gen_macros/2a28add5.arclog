;; 2a28add5

(DET &axis AxisDomain)

(RULE &marker_at_split1
  (input (:P *M_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B M_) (:D D_m1) (:K *K1_m3))
  (margin (:B M_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X M_) (:X_rel *Across_)))

(RULE &ink_at_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

(DET &bg DominantColor)

(DET &marker VanishedColor)

(DET &fill ColorDomain)

(RULE &marker_at
  (input (:P *M) *Col)
  (&marker (:C Col))
  (&axis *A)
  (&marker_at_split1 (:M_ M) (:A_ A) (:X_m1_ *X_m1) (:Across_ *P_across)))

(RULE &ink_at
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&axis *A)
  (&ink_at_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ *P_across)))

;; Each ink cell travels toward its line's marker and stops against the marker
;; or against the ink already packed ahead of it.
(INIT &pack Distance
  (key ((OR ((&ink_at (:P_across ^Across) *P)
             (&marker_at (:P_across Across) *M)
             (dir_elem ^D)
             (margin (:B M) D (:K *K1_m1))
             (margin (:B P) D (:K *K2_m2))
             (< K1_m1 K2_m2)
             (&marker_at (:P_across Across))
             (&axis *A)
             (axis_of D A)
             (margin (:B P) D *K))
            ((&ink_at (:P_across Across) P)
             (&marker_at (:P_across Across) M)
             (dir_elem D)
             (margin (:B M) D (:K K1_m1))
             (margin (:B P) D (:K K2_m2))
             (< K1_m1 K2_m2)
             (&marker_at (:P_across Across))
             (&axis A)
             (axis_of D A)
             (&marker_at (:P_across Across) (:M *M2))
             (&axis (:A *A2))
             (axis_of D (:A A2))
             (gap D P (:Q M2) K))
            ((&ink_at (:P_across Across) P)
             (&marker_at (:P_across Across) M)
             (dir_elem D)
             (margin (:B M) D (:K K1_m1))
             (margin (:B P) D (:K K2_m2))
             (< K1_m1 K2_m2)
             (&marker_at (:P_across Across))
             (&axis A)
             (axis_of D A)
             (&ink_at (:P_across Across) (:P *P2))
             (&marker_at (:P_across Across) (:M *M22))
             (dir_elem D)
             (margin (:B M22) D (:K *K1_m3))
             (margin (:B P2) D (:K *K2_m4))
             (< K1_m3 K2_m4)
             (!= P P2)
             (gap D P (:Q P2) K))))
    (weight ((:a P2) (:b P) (:W K))
      (&ink_at (:P_across Across) *P)
      (&marker_at (:P_across Across) *M)
      (dir_elem D)
      (margin (:B M) D (:K *K1_m1))
      (margin (:B P) D (:K *K2_m2))
      (< K1_m1 K2_m2)
      (&marker_at (:P_across Across))
      (&axis *A)
      (axis_of D A)
      (&ink_at (:P_across Across) (:P *P2))
      (&marker_at (:P_across Across) (:M *M2))
      (dir_elem D)
      (margin (:B M2) D (:K *K1_m3))
      (margin (:B P2) D (:K *K2_m4))
      (< K1_m3 K2_m4)
      (!= P P2)
      (gap D P (:Q P2) *K))
    (source_distance ((:n P) K)
      (OR ((&ink_at (:P_across Across) *P)
           (&marker_at (:P_across Across) *M)
           (dir_elem D)
           (margin (:B M) D (:K *K1_m1))
           (margin (:B P) D (:K *K2_m2))
           (< K1_m1 K2_m2)
           (&marker_at (:P_across Across))
           (&axis *A)
           (axis_of D A)
           (margin (:B P) D *K))
          ((&ink_at (:P_across Across) P)
           (&marker_at (:P_across Across) (:M *M3))
           (dir_elem D)
           (margin (:B M3) D (:K *K1_m12))
           (margin (:B P) D (:K *K2_m22))
           (< K1_m12 K2_m22)
           (&marker_at (:P_across Across))
           (&axis (:A *A3))
           (axis_of D (:A A3))
           (&marker_at (:P_across Across) (:M *M2))
           (&axis (:A *A2))
           (axis_of D (:A A2))
           (gap D P (:Q M2) K))))))

(RULE &pack_dir
  (&marker_at *P_across)
  (&axis *A)
  (axis_of *D A))

(RULE &packed
  (OR ((&marker_at (:M *P)))
      ((&pack.distance (:key (:Across *Ky_p_across) (:D *Ky_d)) (:n *P2) *K)
       (&pack_dir (:P_across Ky_p_across) (:D Ky_d))
       (dir8_opposite (:D Ky_d) (:D2 *O_m1))
       (edge_inset (:D O_m1) K (:B *B1_m2))
       (edge_inset (:D Ky_d) K (:B *I_m4))
       (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *V))
       (compose (:A P2) (:B V) (:C P)))))

(RULE &output
  (OR ((&packed *P)
       (&fill (:C *Col)))
      ((input P)
       (NOT (&packed P))
       (&bg (:C Col)))))
