;; 4e469f39

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; Ink objects, each with its own bounding box.
(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(INIT &bbox BoundingBox
  (key ((&objs_component *P (:Id ^O)))
    (cell (P)
      (&objs_component *P (:Id O)))))

(DET &open_dir DirDomain)

(RULE &gap
  (input *P *Col)
  (&bg (:C Col))
  (&bbox.box (:key *O) *B)
  (&open_dir *D)
  (ALL ((input P (:Col *Colm))
        (&bbox.box (:key (:O *Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) D (:K *K_m1))
  (margin B D (:K K_m1)))

(DET &fill AnyOutNewColor)

(ALTS $choice "two models of the gapped wall, which the pairs do not separate: every gap sits on a top wall" $Dir
  (ALT $Hole
    (RULE &gap
      (input *P *Col)
      (&bg (:C Col))
      (&bbox.box (:key *O) *B)
      (ALL ((input P (:Col *Colm))
            (&bbox.box (:key (:O *Om)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) *D (:K *K_m1))
      (margin B D (:K K_m1)))))

(RULE &arm_dir
  (&gap *O (:D *D2) *P)
  (&bbox.box (:key O) *B)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (axis_of (:D D2) (:A *A_m12))
  (perp (:A A_m12) (:A2 *A2_m13))
  (axis_of *D (:A A2_m13))
  (opposite D (:Opp *O_m14))
  (margin (:B P_inner) D *K)
  (margin (:B P_inner) (:D O_m14) (:K *K2))
  (> K K2))

(RULE &spill_dir
  (&arm_dir (:O *Key) *D))

(RULE &spill_node
  (&arm_dir (:O *Key) *D)
  (input *P))

(RULE &spill_source
  (&gap (:O *Key) *D (:P *P2))
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

;; The fill leaves through the gap and runs along the outside of the wall.
(INIT &spill Distance
  (key ((&spill_source (:Key ^Ky) (:P ^O))
        (&spill_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&spill_source (:Key Ky) (:P O))
           (&spill_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&spill_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&spill_node (:Key Ky) (:P Q)))
          ((&spill_source (:Key Ky) (:P O))
           (&spill_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&spill_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&spill_source (:Key Ky) (:P O))
           (&spill_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&spill_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&spill_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&spill_source (:Key Ky) (:P O))
      (&spill_dir (:Key Ky) D))))

(RULE &spill_ray
  (&spill.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &spill_end
  (&spill_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&spill_ray Key (:P Q) D Origin)))

(RULE &spill_cell
  (&arm_dir (:O *Key))
  (input *P))

(RULE &paint
  (OR ((input *P *Col)
       (&bg (:C Col))
       (&bbox.box *B)
       (ALL ((input P (:Col *Colm))
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0))))
      ((&spill_ray P)
       (&spill_cell P))))

(RULE &output
  (OR ((&paint *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&paint P)))))
