;; 845d6e51

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &frame SharedColor)

(RULE &obj_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key)))
  (NOT (&frame (:C Key))))

;; Same-colored ink objects.
(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

;; The group under which a shape and a legend shape are the same shape.
(DET &shape_sym SymDomain)

(INIT &border BoundingBox
  (cell (P)
    (input *P *Col)
    (&frame (:C Col))))

(RULE &boxed
  (input *P)
  (&border.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &legend
  (&obj_component *P *Id)
  (&boxed P))

(RULE &query2
  (&obj_component *P *Id)
  (NOT (&boxed P)))

;; Each object's shape: its cells read in its own box.
(INIT &obj_box BoundingBox
  (key ((&obj_component *P ^Id))
    (cell (P)
      (&obj_component *P Id))))

(RULE &shape
  (&obj_box.cell (:key *Id) *P)
  (&obj_box.box (:key Id) *B)
  (ALL ((&obj_box.cell (:key (:Id *Idm)) P)
        (&obj_box.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(ALTS $choice "what separates the legend shapes from the shapes to recolor" $Boxed
  (ALT $Marked
    (DET &query ChangedColor)

    (RULE &legend
      (&obj_component (:Key *Col) *Id)
      (NOT (&query (:C Col))))

    (RULE &query2
      (&obj_component (:Key *Col) *Id)
      (&query (:C Col)))))

(INIT &cong Agreement
  (key ((&query2 (:Id ^Q))
        (&legend (:Id ^L)))
    (source ((:i P_inner))
      (&shape (:Id Q) *P_inner))
    (target ((:i P_inner))
      (&shape (:Id L) *P_inner))
    (correspondence ((:m D) (:i P_inner) (:j Q2))
      (&shape (:Id Q) *P_inner)
      (d4_elem *D)
      (apply D (:P P_inner) (:P_out *Q2)))))

(RULE &cong_src
  (&query2 (:Id *Q))
  (&legend (:Id *L))
  (&shape (:Id Q) (:P_inner *P)))

(RULE &cong_dst
  (&query2 (:Id *Q))
  (&legend (:Id *L))
  (&shape (:Id L) (:P_inner *P)))

(RULE &onto
  (&cong_src *Q *L)
  (d4_elem *D)
  (NOT (&cong.mismatch (:key Q L) (:m D)))
  (ALL ((&cong_dst Q L (:P *P_legend))
        (d4_inverse D (:D_inv *D_back))
        (apply (:D D_back) (:P P_legend) (:P_out *P)))
       ((&cong_src Q L P))))

(RULE &recolor
  (&onto *Q *L *D)
  (&shape_sym *S)
  (sym_member S D)
  (&obj_component *P (:Id Q))
  (&obj_component (:Key *Col) (:Id L)))

(RULE &output
  (input *P (:Col *C_in))
  (OR ((&recolor P *Col))
      ((NOT (&recolor P))
       (= Col C_in))))
