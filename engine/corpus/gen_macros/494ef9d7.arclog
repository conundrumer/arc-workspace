;; 494ef9d7

(RULE &line_of_split1
  (input (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(DET &bg DominantColor)

;; The direction the far cell moves; the near cell holds.
(DET &pull_dir DirDomain)

(RULE &line_of
  (input *P)
  (&pull_dir *D)
  (axis_of D *A)
  (&line_of_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L)))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&line_of P *L))

(RULE &rest
  (&mark *L (:P *P_near) (:Col *Col_near))
  (&mark L (:P *P_far) (:Col *Col_far))
  (&pull_dir *D)
  (dir_elem D)
  (margin (:B P_near) D (:K *K1_m1))
  (margin (:B P_far) D (:K *K2_m2))
  (< K1_m1 K2_m2)
  (OR ((= *Col Col_far)
       (opposite D (:Opp *D_back))
       (step_offset (:D D_back) (:V *V_m3))
       (compose (:A P_near) (:B V_m3) (:C *P)))
      ((= P P_near)
       (= Col Col_near))))

;; Lines holding the same colors share an entry.
(INIT &same Inclusion
  (pattern ((:pattern E L) (:m Col))
    (&mark *E *L *Col))
  (observed ((:observed E L) (:m Col))
    (&mark *E *L *Col)))

(INIT &entry Quotient
  (equivalent ((:a (:E Ln_e) (:L Ln_l)) (:b (:E Ln2_e) (:L Ln2_l)))
    (&same.equal (:observed (:E *Ln_e) (:L *Ln_l)) (:pattern (:E *Ln2_e) (:L *Ln2_l)))))

(DET &moved
  (&line_of *E *P *L)
  (ex_input E P *Col)
  (ex_output E P (:Col *Col2))
  (!= Col Col2))

(DET &attract
  (&entry.class (:a *E *L) (:Id *Pair))
  (&moved E L)
  (&mark E L *Col))

(INIT &pairs Inclusion
  (pattern ((:pattern Pair) (:m Col))
    (&attract *Pair *Col))
  (observed ((:observed L) (:m Col))
    (&mark *L *Col)))

(RULE &pair_line
  (&pairs.equal (:observed *L)))

(RULE &output
  (input *P (:Col *C_in))
  (&line_of P *L)
  (OR ((&pair_line L)
       (&rest L P *Col))
      ((NOT (&pair_line L))
       (= Col C_in))
      ((&pair_line L)
       (NOT (&rest L P))
       (&bg (:C Col)))))
