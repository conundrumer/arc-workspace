;; 1e5d6875

(DET &parts_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &parts Quotient
  (edge ((:a E Col P) (:b E Col (:P P3)))
    (OR ((ex_input *E *P *Col)
         (NOT (&bg (:C Col)))
         (&parts_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (ex_input E (:P P3) Col))
        ((ex_input E P Col)
         (NOT (&bg (:C Col)))
         (= P3 P)))))

(DET &parts_component
  (&parts.class (:a *E *Col *P) *Id))

(RULE &parts_steps2
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &parts_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &parts2 Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&parts_node (:Key *Ky) *P)
         (&parts_steps2 (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&parts_node (:Key Ky) (:P P2)))
        ((&parts_node (:Key Ky) P)
         (= P2 P)))))

(RULE &parts_component2
  (&parts2.class (:a *Key *P) *Id))

(RULE &piece_cell2
  (&parts_component2 (:Key *Col) *P *Id))

(RULE &cell
  (&piece_cell2 *Col *Id *P))

(INIT &bbox BoundingBox
  (key ((&cell ^Col ^Id *P))
    (cell (P)
      (&cell Col Id *P))))

(RULE &corner_cell_inside1
  (&cell (:Col *K_col) (:Id *K_id) (:P *P_))
  (&bbox.box (:key (:Col K_col) (:Id K_id)) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &open_diag
  (&cell *Col *Id)
  (diag_dir_elem (:D *Diag))
  (ALL ((&cell Col Id *P)
        (&bbox.box (:key Col Id) *B)
        (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
        (margin (:B P) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B P) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6)))
       ((&corner_cell_inside1 (:P_ P) (:B_ B)))))

(DET &painted
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col2))
  (!= Col Col2))

(DET &piece_cell
  (&parts_component *E *Col *P *Id))

;; The piece's shape among the repainted cells: its copy. A copy cell past
;; the frame drops, so each cell just past the frame counts as a copy cell.
(INIT &copy Occurrences
  (key ((&piece_cell ^E ^Col ^Id *P))
    (cell ((:P Q))
      (&piece_cell E Col Id *P)
      (OR ((&painted E (:P *Q)))
          ((diag_dir_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A P) (:B V_m1) (:C Q))
           (NOT (ex_input E (:P Q))))))
    (shape (P)
      (&piece_cell E Col Id *P))))

(DET &piece_step
  (&open_diag *E (:Col *Src) *Id (:Diag *Open))
  (&copy.occurrence (:key E (:Col Src) Id) (:P *V))
  (diag_dir_elem (:D *Dir))
  (step_offset (:D Dir) V))

;; The rotation that turns a piece's open corner to its step, one per
;; step: the rotations act on the corners freely and transitively.
(INIT &turn Singleton
  (key ((&piece_step (:Src ^Col) (:Open *Diag) (:Dir *D))
        (c4_elem (:D *Rot))
        (d4_elem (:D Rot))
        (diag_dir_elem (:D Diag))
        (diag_dir_elem D)
        (step_offset (:D Diag) (:V *S_m1))
        (apply (:D Rot) (:P S_m1) (:P_out *S2_m2))
        (step_offset D (:V S2_m2)))
    (member ((:v Rot))
      (&piece_step (:Src Col) (:Open *Diag) (:Dir *D))
      (c4_elem (:D *Rot))
      (d4_elem (:D Rot))
      (diag_dir_elem (:D Diag))
      (diag_dir_elem D)
      (step_offset (:D Diag) (:V *S_m1))
      (apply (:D Rot) (:P S_m1) (:P_out *S2_m2))
      (step_offset D (:V S2_m2)))))

(DET &rot
  (&turn.value (:key (:Col *Src)) (:v *D)))

(RULE &step_dir
  (&open_diag *Col *Id *Diag)
  (&rot (:Src Col) (:D *Rot))
  (d4_elem (:D Rot))
  (diag_dir_elem (:D Diag))
  (diag_dir_elem (:D *Dir))
  (step_offset (:D Diag) (:V *S_m1))
  (apply (:D Rot) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D Dir) (:V S2_m2)))

(DET &copy_land
  (&piece_cell *E *Col *Id (:P *P2))
  (diag_dir_elem (:D *Dir))
  (step_offset (:D Dir) (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (ex_input E P))

(DET &copy_cell
  (&copy_land *E *Col *Id (:Dir *D) *P)
  (&open_diag E Col Id *Diag)
  (&piece_step (:Src Col) (:Open Diag) (:Dir D)))

(DET &copy_color
  (&copy_cell *E (:Col *O_col) *Id (:P *Q))
  (&painted E (:P Q) *Col))

(DET &mark_missing
  (&copy_color (:O_col *Src) *Col)
  (&copy_color (:E *E2) (:O_col Src) (:Id *Id2))
  (NOT (&copy_color (:E E2) (:O_col Src) (:Id Id2) Col)))

(DET &mark
  (&copy_color (:O_col *Src) *Col)
  (NOT (&mark_missing Src Col)))

(RULE &mark_cell
  (&piece_cell2 (:Col *Col2) *Id (:P *P2))
  (&step_dir (:Col Col2) Id (:Dir *D))
  (&mark (:Src Col2) *Col)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(DET &copy_at
  (&copy_cell *E (:Col *Col2) *P)
  (&mark (:Src Col2) *Col))

(INIT &prec Order
  (member ((:t M))
    (&mark (:Col *M)))
  (before ((:a M) (:b M2))
    (&copy_at *E *P (:Col *M))
    (&copy_at E P (:Col *M2))
    (!= M M2)
    (ex_output E P (:Col M))))

(DET &mark_rank
  (&prec.rank (:t *Col) *R))

(INIT &win Order
  (key ((&mark_cell ^P (:Col *M))
        (&mark_rank (:Col M) *R))
    (member ((:t (:V M) (:S R)))
      (&mark_cell P (:Col *M))
      (&mark_rank (:Col M) *R))
    (score ((:t (:V M) (:S R)) (:S R))
      (&mark_cell P (:Col *M))
      (&mark_rank (:Col M) *R))))

(ALTS $choice "a copy landing on a piece cell" $Keep
  (ALT $Cover
    (RULE &output
      (input *P (:Col *Col_in))
      (OR ((&win.minimal (:key P) (:t (:V *Col))))
          ((NOT (&mark_cell P))
           (= Col Col_in))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&bg (:C Col))))
      ((input P (:Col *Bg))
       (&bg (:C Bg))
       (OR ((&win.minimal (:key P) (:t (:V Col))))
           ((NOT (&mark_cell P))
            (= Col Bg))))))
