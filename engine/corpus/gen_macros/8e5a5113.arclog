;; 8e5a5113

(DET &axis AxisDomain)

(DET &cell
  (ex_output *E *P))

(DET &gap DivisorRatio)

(INIT &tile_division_sides2 ExtentDivisions
  (frame ((:P P_grid))
    (&cell (:P *P_grid))))

(DET &tile_n ConstInDim)

(RULE &tile_division_gap
  (&axis *A)
  (&gap (:K *G)))

(DET &tile_division_axis_split12
  (&cell (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_parts
  (&axis *A)
  (&tile_n *N))

(DET &tile_division_axis2
  (OR ((&cell *P)
       (&axis *A)
       (&tile_n *N)
       (&gap (:K *G))
       (&tile_division_sides2.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&cell P)
       (&axis A)
       (&tile_n (:N *N2))
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&cell P)
       (&axis A)
       (&tile_n (:N *N3))
       (NOT (&tile_division_gap A))
       (&tile_division_sides2.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&cell P)
       (&axis A)
       (&tile_n (:N *N4))
       (NOT (&tile_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((&cell P)
       (axis_elem A)
       (NOT (&tile_division_parts A))
       (&tile_division_axis_split12 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &tile_division_tile2
  (&tile_division_axis2 *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis2 P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &flow_dir DirDomain)

(RULE &flow_dir2
  (&flow_dir *D))

(RULE &flow_dir_ray
  (&flow_dir2 *D))

(RULE &flow_node
  (&flow_dir2)
  (input *P))

(DET &bg ChangedColor)

(INIT &tile_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_axis
  (OR ((input *P)
       (&axis *A)
       (&tile_n *N)
       (&gap (:K *G))
       (&tile_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&axis A)
       (&tile_n (:N *N2))
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&axis A)
       (&tile_n (:N *N3))
       (NOT (&tile_division_gap A))
       (&tile_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&axis A)
       (&tile_n (:N *N4))
       (NOT (&tile_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_division_parts A))
       (&tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile
  (input (:P *P_grid))
  (&tile_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &tile_cell
  (&tile *P_grid *P_tile *P_intile))

(DET &tile2
  (&cell *E (:P *P_grid))
  (&tile_division_tile2 (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &out_cell
  (ex_output *E (:P *P_grid) *Col)
  (&tile2 E P_grid *P_tile *P_intile))

(DET &flow_pair
  (&out_cell *E (:P_tile *T1))
  (&flow_dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A T1) (:B V_m1) (:C *T2))
  (&out_cell E (:P_tile T2)))

;; Each tile's content must map onto its flow-neighbor's.
(INIT &step Agreement
  (key ((OR ((&flow_pair ^E ^T1)
             (&out_cell E (:P_tile T1) (:P_intile *P) *Col))
            ((&flow_pair E T1 *T2)
             (&out_cell E (:P_tile T2) (:P_intile P) Col))))
    (source ((:i P) (:v Col))
      (&flow_pair E T1)
      (&out_cell E (:P_tile T1) (:P_intile *P) *Col))
    (target ((:i P) (:v Col))
      (&flow_pair E T1 *T2)
      (&out_cell E (:P_tile T2) (:P_intile *P) *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&flow_pair E T1)
      (&out_cell E (:P_tile T1) (:P_intile *P) *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(DET &step_broken
  (&step.mismatch (:key *E (:T1 *T)) (:m *D))
  (&out_cell E (:P_tile T)))

(DET &rot
  (&out_cell)
  (d4_elem *D)
  (NOT (&step_broken D)))

(ALTS $choice "data-equivalent on this task" $StepCount
  (ALT $StepSize
    (DET &tile_size
      (&tile *P_intile)
      (&axis *A)
      (frame_extent (:P P_intile) A (:N *K)))

    (RULE &size_tile_division_gap
      (&axis *A)
      (&gap (:K *G)))

    (RULE &size_tile_division_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &size_tile_division_side
      (&axis *A)
      (&tile_size *K))

    (RULE &size_tile_division_axis
      (OR ((input *P)
           (&axis *A)
           (&tile_size (:K *Sz))
           (&gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side Sz) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side Sz) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N Sz)))
          ((input P)
           (&axis A)
           (&tile_size (:K *Sz2))
           (NOT (&size_tile_division_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side Sz2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side Sz2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N Sz2)))
          ((input P)
           (axis_elem A)
           (NOT (&size_tile_division_side A))
           (&size_tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &size_tile_division_tile
      (&size_tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&size_tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &size_tile
      (input (:P *P_grid))
      (&size_tile_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

    (RULE &tile_cell
      (&size_tile *P_grid *P_tile *P_intile)))
  (ALT $Lookup
    ;; TODO no-det-plan: &tile_d4: the plan gives no verdict
    (DET &tile_d4)

    (RULE &output
      (OR ((&src (:P_intile *P_src) *Col)
           (&tile_d4 (:P *P_tile) *D)
           (apply D (:P P_src) (:P_out *P_intile))
           (&tile_cell (:P_grid *P) P_tile P_intile))
          ;; Separator passthrough — cells the divide leaves undecomposed.
          ((input P Col)
           (NOT (&tile_cell (:P_grid P))))))))

(RULE &src
  (&tile_cell *P_grid *P_tile *P_intile)
  (input (:P P_grid) *Col)
  (NOT (&bg (:C Col))))

(RULE &flow_source
  (&src (:P_tile *P)))

;; The tiles counted off from the pattern's toward flow_dir.
(INIT &flow Distance
  (key ((&flow_source (:P ^O))
        (&flow_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&flow_source (:P O))
           (&flow_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&flow_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&flow_node (:P Q)))
          ((&flow_source (:P O))
           (&flow_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&flow_node (:P Q))
           (= A2 O))
          ((&flow_source (:P O))
           (&flow_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&flow_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&flow_node (:P Q)))))
    (source ((:n O))
      (&flow_source (:P O))
      (&flow_dir_ray D))))

(RULE &flow_ray
  (&flow.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &flow_end
  (&flow_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&flow_ray (:P Q) D Origin)))

(RULE &flow_cell
  (&tile_cell (:P_tile *P)))

;; A cell of the pattern under k turns by &rot.
(INIT &turns Walk
  (successor ((:p P1) (:p_next P2))
    (&tile_cell (:P_intile *P1))
    (&rot (:D *R))
    (apply (:D R) (:P P1) (:P_out *P2)))
  (steps ((:N K))
    (&flow_ray *P *K)
    (&flow_cell P)))

(RULE &output
  ;; Separator passthrough — cells the divide leaves undecomposed.
  (OR ((input *P *Col)
       (NOT (&tile_cell (:P_grid P))))
      ;; The k-th tile on carries the pattern turned k times.
      ((&src (:P_tile *T0) (:P_intile *P0) Col)
       (&flow_ray (:P *T) *K (:Origin T0))
       (&flow_cell (:P T))
       (&turns.walk (:p0 P0) (:N K) (:p *P_intile))
       (&tile_cell (:P_grid P) (:P_tile T) P_intile))))
