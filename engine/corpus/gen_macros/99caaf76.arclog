;; 99caaf76

(RULE &comps_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(RULE &arrow
  (&comps_component *P *Id))

(INIT &edge Boundary
  (key ((&arrow ^Id *P))
    (cell (P)
      (&arrow Id *P))))

(RULE &center
  (&arrow *Id *P)
  (NOT (&edge.boundary (:key Id) P)))

(RULE &arm
  (&center *Id (:P *C))
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A C) (:B V_m1) (:C *P)))

(RULE &fletching
  (&arrow *Id *P)
  (NOT (&center Id P))
  (NOT (&arm Id P)))

;; the flight: the arrow travels away from its fletching until its leading arm
;; comes to rest on the grid edge
(INIT &flight Distance
  (key ((&fletching ^Id))
    (source_distance (K)
      (&arrow Id *P)
      (dir_elem *D)
      (ALL ((&fletching Id (:P *Pm))
            (&center Id (:P *C))
            (margin (:B C) D (:K *K1_m1))
            (margin (:B Pm) D (:K *K2_m2)))
           ((< K1_m1 K2_m2)))
      (margin (:B P) D *K))))

(RULE &flight_dir
  (&fletching (:Id *Key))
  (dir_elem *D)
  (ALL ((&fletching (:Id Key) *P)
        (&center (:Id Key) (:P *C))
        (margin (:B C) D (:K *K1_m1))
        (margin (:B P) D (:K *K2_m2)))
       ((< K1_m1 K2_m2))))

(RULE &turned
  (OR ((&arm *Id *D *P)
       (opposite D (:Opp *D2))
       (&arm Id (:D D2) (:P *P_src))
       (input (:P P_src) *Col))
      ((&arrow Id P)
       (NOT (&arm Id P))
       (input P Col))))

(RULE &landing
  (&turned *Id (:P *P2) *Col)
  (&flight.distance (:key Id) *K)
  (&flight_dir (:Key Id) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&landing *P *Col))
      ((input P)
       (NOT (&landing P))
       (&bg (:C Col)))))
