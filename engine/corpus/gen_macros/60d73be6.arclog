;; 60d73be6

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &bg_mode_count Cardinality
  (key ((ex_input ^E *P ^Col))
    (member ((:m P))
      (ex_input E *P Col))))

;; A line of one color is a line of the cross: a full line meets the cross's
;; other line, so it carries that line's color.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &flip
  (input *P)
  (&line_color.value (:key *A *L))
  (axis_inversion A (:T *F))
  (relative (:Base L) (:X P) (:X_rel *V))
  (apply (:D F) (:P V) (:P_out *V2))
  (compose (:A L) (:B V2) (:C *Q))
  (input (:P Q)))

(INIT &bg_mode Order
  (key ((&bg_mode_count.size (:key ^E *Col)))
    (member ((:t Col))
      (&bg_mode_count.size (:key E *Col)))
    (score ((:t Col) (:S N))
      (&bg_mode_count.size (:key E *Col) *N))))

(DET &bg
  (&bg_mode.maximal (:t *C)))

(RULE &image
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (OR ((&flip (:P P2) (:Q *P)))
      ((= P P2))
      ((&flip *A (:P P2) (:Q *Q1))
       (perp A *A2)
       (&flip (:A A2) (:P Q1) (:Q P)))))

(RULE &output
  (OR ((&image *P *Col))
      ((input P Col)
       (NOT (&image P)))))
