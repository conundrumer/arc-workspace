;; 762cd429

(DET &bg DominantColor)

(DET &factor SepThickness)

;; Coincides with $Away on this task: the seed touches the left edge and grows right.
(DET &grow DirDomain)

;; The seed: the non-bg cells, as a box.
(INIT &seed BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &grow2
  (&grow *D))

(RULE &seed_corner
  (&seed.cell *P)
  (&seed.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Dg) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Dg) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(ALTS $choice "how the growth direction is read" $Stored
  (ALT $Away
    (RULE &grow2
      (&seed.box *B)
      (margin B (:D *D2) (:K 0))
      (opposite (:D D2) (:Opp *D)))))

(RULE &anchor
  (&grow2 (:D *G))
  (opposite (:D G) (:Opp *G_back))
  (&seed_corner (:P *P_front) *Dg)
  (corner_dir (:C Dg) (:A *A_m1) *D)
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Dg) (:A A2_m2) (:D G))
  (&seed_corner (:P *P_back) (:Dg *Dg_back))
  (corner_dir (:C Dg_back) (:A *A_m3) D)
  (perp (:A A_m3) (:A2 *A2_m4))
  (corner_dir (:C Dg_back) (:A A2_m4) (:D G_back))
  (step_offset (:D G) (:V *V_m5))
  (compose (:A P_front) (:B V_m5) (:C *P_next)))

(RULE &source
  (input (:P *Q))
  (&anchor *Dg *P_back *P_next)
  (relative (:Base P_next) (:X Q) (:X_rel *V))
  (&factor (:G *F))
  (corner_dir (:C Dg) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Dg) (:A A2_m2) (:D *D2))
  (opposite (:D D1) (:Opp *O1))
  (margin (:B V) (:D O1) (:K *K1))
  (divide (:T K1) (:Side F) (:Gap 0) (:Part *N1))
  (opposite (:D D2) (:Opp *O2))
  (margin (:B V) (:D O2) (:K *K2))
  (divide (:T K2) (:Side F) (:Gap 0) (:Part *N2))
  (dir8_opposite (:D D1) (:D2 *O_m4))
  (edge_inset (:D O_m4) (:K N1) (:B *B1_m5))
  (edge_inset (:D D1) (:K N1) (:B *I_m7))
  (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
  (compose (:A P_back) (:B V_m3) (:C *P1))
  (dir8_opposite (:D D2) (:D2 *O_m9))
  (edge_inset (:D O_m9) (:K N2) (:B *B1_m10))
  (edge_inset (:D D2) (:K N2) (:B *I_m12))
  (relative (:Base I_m12) (:X 0) (:X_rel *B2_m11))
  (compose (:A B1_m10) (:B B2_m11) (:C *V_m8))
  (compose (:A P1) (:B V_m8) (:C *P)))

(INIT &chain Propagation
  (key ((&seed.cell (:P ^S)))
    (source ((:n S))))
  (edge ((:a P) (:b Q))
    (&source *Q *P)))

(RULE &copy
  (&chain.reached (:key *S) (:n *P))
  (input (:P S) *Col))

(RULE &output
  (input *P)
  (OR ((&copy P *Col))
      ((NOT (&copy P))
       (&bg (:C Col)))))
