;; 2c737e39

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(DET &mark SharedColor)

(RULE &drawing
  (&obj_component *P *Id)
  (&obj_component (:P *Q) Id)
  (!= P Q))

(RULE &drawn
  (&obj_component *P *Id)
  (&drawing Id)
  (input P *Col))

(RULE &shift
  (&drawn *P *Col)
  (&mark (:C Col))
  (input (:P *Q) Col)
  (NOT (&drawn (:P Q)))
  (relative (:Base P) (:X Q) (:X_rel *V)))

(RULE &footprint
  (&drawn *P))

(ALTS $choice "what the copy carries" $Transparent
  (ALT $Opaque
    (INIT &bbox BoundingBox
      (cell (P)
        (&drawn *P)))

    (RULE &footprint
      (&bbox.box *B)
      (input *P)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &stamp
  (&footprint (:P *P2))
  (input (:P P2) (:Col *C))
  (&shift *V)
  (compose (:A P2) (:B V) (:C *P))
  (input P)
  (OR ((&mark C)
       (&bg (:C *Col)))
      ((NOT (&mark C))
       (= Col C))))

(RULE &output
  (OR ((&stamp *P *Col))
      ((input P Col)
       (NOT (&stamp P)))))
