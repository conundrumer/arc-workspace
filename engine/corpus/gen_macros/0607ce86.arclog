;; 0607ce86

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &block_shape Frame)

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A copy is what a solid &block_dim block covers; noise sits too thin to
;; carry one.
(INIT &occ Occurrences
  (cell (P)
    (&ink *P))
  (shape (P)
    (&block_shape *P)))

(RULE &solid
  (&occ.occurrence (:P *M))
  (&block_shape (:P *S))
  (compose (:A M) (:B S) (:C *P)))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((&solid *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&solid (:P P3)))
        ((&solid P)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(INIT &bbox BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(RULE &copy_view
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &copy_color
  (&copy_view *Id *P *P_intile)
  (input P *Col))

(INIT &template_count Cardinality
  (key ((&copy_color *Id ^P_intile ^Col))
    (member ((:m Id))
      (&copy_color *Id P_intile Col))))

(INIT &template Order
  (key ((&template_count.size (:key ^P_intile *Col)))
    (member ((:t Col))
      (&template_count.size (:key P_intile *Col)))
    (score ((:t Col) (:S N))
      (&template_count.size (:key P_intile *Col) *N))))

(ALTS $choice "The cases differ in how the undamaged copy is recovered" $Vote
  (ALT $Copy
    (INIT &intact_count Cardinality
      (key ((&copy_color ^Id *P_intile *Col)
            (&copy_color (:Id *Id2) P_intile Col)
            (!= Id Id2))
        (member ((:m Id2 P_intile))
          (&copy_color Id *P_intile *Col)
          (&copy_color (:Id *Id2) P_intile Col)
          (!= Id Id2))))

    (INIT &intact Order
      (member ((:t Id))
        (&intact_count.size (:key *Id)))
      (score ((:t Id) (:S Count))
        (&intact_count.size (:key *Id) (:N *Count))))

    (RULE &output
      (OR ((&copy_view *P *P_intile)
           (&intact.maximal (:t *Id))
           (&copy_color Id P_intile *Col))
          ((input P)
           (NOT (&solid P))
           (&bg (:C Col)))))))

(RULE &output
  (OR ((input *P)
       (NOT (&solid P))
       (&bg (:C *Col)))
      ((&copy_view P *P_intile)
       (&template.maximal (:key P_intile) (:t Col)))))
