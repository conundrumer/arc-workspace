;; 6ad5bdfd

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &wall UnchangedColor)

(RULE &obj_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key)))
  (NOT (&wall (:C Key))))

(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

(RULE &wall2
  (input *P (:Col *W))
  (&wall (:C W)))

(INIT &settle Distance
  (weight ((:a Id2) (:b Id) (:W K))
    (&obj_component *P *Id)
    (dir_elem *D)
    (ALL ((&wall2 (:P *Pm)))
         ((margin (:B Pm) D (:K 0))))
    (&obj_component (:P *P2) (:Id *Id2))
    (!= Id Id2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n Id) K)
    (OR ((&obj_component *P *Id)
         (dir_elem *D)
         (ALL ((&wall2 (:P *Pm)))
              ((margin (:B Pm) D (:K 0))))
         (margin (:B P) D *K))
        ((&obj_component (:P *P3) Id)
         (dir_elem (:D *D2))
         (ALL ((&wall2 (:P *Pm2)))
              ((margin (:B Pm2) (:D D2) (:K 0))))
         (&wall2 (:P *P2))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &settle_dir
  (dir_elem *D)
  (ALL ((&wall2 *P))
       ((margin (:B P) D (:K 0)))))

(RULE &fallen
  (&obj_component (:Key *Col) (:P *P2) *Id)
  (&settle.distance (:n Id) *K)
  (&settle_dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta))
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((&wall2 P)
       (input P Col))
      ((input P)
       (NOT (&fallen P))
       (NOT (&wall2 P))
       (&bg (:C Col)))))
