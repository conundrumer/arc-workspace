;; 9b4c17c4

(INPUT field "the grid is two rectangular fields, each one connected region of one background color")

(INPUT shape "the ink shapes are rectangles, each surrounded by one field")

(INPUT lane "no two shapes on one field share a line along that field's slide direction")

(OUTPUT direction "each field color picks the direction its shapes slide")

(OUTPUT flush "each shape slides in its field's direction until it touches the field's edge"

  (RULE &field_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The shapes' color.
  (DET &ink RarestColor)

  (RULE &field_node
    (input *P (:Col *Key))
    (NOT (&ink (:C Key))))

  (INIT &field Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&field_node (:Key *Ky) *P)
           (&field_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&field_node (:Key Ky) (:P P2)))
          ((&field_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &field_component
    (&field.class (:a *Key *P) *Id))

  (RULE &shape_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &shape Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (&ink (:C Col))
           (&shape_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (&ink (:C Col2)))
          ((input P (:Col *Col3))
           (&ink (:C Col3))
           (= P3 P)))))

  (RULE &shape_component
    (&shape.class (:a *P) *Id))

  (RULE &field_color
    (&field_component (:Key *Col) (:Id *F)))

  (DET &inked
    (ex_input *E *P *Col)
    (NOT (&ink (:C Col)))
    (ex_output E P (:Col *Col_ink))
    (&ink (:C Col_ink)))

  (DET &vacated
    (ex_input *E *P (:Col *Col_ink))
    (&ink (:C Col_ink))
    (ex_output E P *Col)
    (NOT (&ink (:C Col))))

  (DET &led
    (&vacated *E *P *Col)
    (&inked E (:P *Q) Col)
    (axis_of *D *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P) (:D D_m2) (:K *K_m3))
    (margin (:B Q) (:D D_m2) (:K K_m3))
    (dir_elem D)
    (margin (:B Q) D (:K *K1_m4))
    (margin (:B P) D (:K *K2_m5))
    (< K1_m4 K2_m5))

  (DET &cand
    (&vacated *E *P (:Col *C))
    (&led E P *D))

  (DET &stranded
    (&cand *C *D)
    (&vacated *E *P (:Col C))
    (NOT (&led E P D)))

  (DET &slide
    (&cand *C *D)
    (NOT (&stranded C D)))

  (RULE &field_dir
    (&field_color *F *Col)
    (&slide (:C Col) *D))

  (RULE &on_field
    (&shape_component *P (:Id *X))
    (step_offset (:D *D_m1) (:V *V_m2))
    (compose (:A P) (:B V_m2) (:C *Q))
    (&field_component (:P Q) (:Id *F)))

  (RULE &region
    (OR ((&field_component *P (:Id *F)))
        ((&shape_component P (:Id *X))
         (&on_field X F))))

  (RULE &outside
    (&field_color *F)
    (input *P)
    (NOT (&region F P)))

  (RULE &slide_dir
    (&on_field (:X *Key) *F)
    (&field_dir F *D))

  ;; Each shape slides as one body toward its field's slide edge.
  (INIT &slide2 Distance
    (key ((OR ((&shape_component *P (:Id ^X))
               (&slide_dir (:Key X) *D)
               (margin (:B P) D *K))
              ((&shape_component P (:Id X))
               (&slide_dir (:Key X) D)
               (&on_field X *F)
               (&outside F (:P *P2))
               (gap D P (:Q P2) K))))
      (source_distance (K)
        (OR ((&shape_component *P (:Id X))
             (&slide_dir (:Key X) *D)
             (margin (:B P) D *K))
            ((&shape_component (:P *P3) (:Id X))
             (&slide_dir (:Key X) (:D *D2))
             (&on_field X *F)
             (&outside F (:P *P2))
             (gap (:D D2) (:P P3) (:Q P2) K))))))

  ;; Each ink cell falls toward its field's slide edge and stacks on the ink
  ;; ahead of it.
  (INIT &pack Distance
    (key ((OR ((&shape_component *P (:Id *X))
               (&on_field X ^F)
               (&field_dir F *D)
               (margin (:B P) D *K))
              ((&shape_component P (:Id X))
               (&on_field X F)
               (&field_dir F D)
               (&outside F (:P *P2))
               (gap D P (:Q P2) K))
              ((&shape_component P (:Id X))
               (&on_field X F)
               (&field_dir F D)
               (&shape_component (:P *P22) (:Id *X2))
               (&on_field (:X X2) F)
               (!= P P22)
               (gap D P (:Q P22) K))))
      (weight ((:a P2) (:b P) (:W K))
        (&shape_component *P (:Id *X))
        (&on_field X F)
        (&field_dir F *D)
        (&shape_component (:P *P2) (:Id *X2))
        (&on_field (:X X2) F)
        (!= P P2)
        (gap D P (:Q P2) *K))
      (source_distance ((:n P) K)
        (OR ((&shape_component *P (:Id *X))
             (&on_field X F)
             (&field_dir F *D)
             (margin (:B P) D *K))
            ((&shape_component P (:Id *X2))
             (&on_field (:X X2) F)
             (&field_dir F (:D *D2))
             (&outside F (:P *P2))
             (gap (:D D2) P (:Q P2) K)))))))

(OUTPUT ground "every other cell takes its field's color")

(ALTS $choice "what slides: the shape as one body, or each line's ink on its own" $Flush
  (ALT $Pack
    (OUTPUT flush "in each line along a field's slide direction, the ink packs against the field's edge")
    (RULE &moved
      (&pack.distance (:key (:F *Ky)) (:n *P2) *K)
      (&field_dir (:F Ky) *D)
      (dir8_opposite D (:D2 *O_m1))
      (edge_inset (:D O_m1) K (:B *B1_m2))
      (edge_inset D K (:B *I_m4))
      (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *V))
      (compose (:A P2) (:B V) (:C *P)))))

(RULE &moved
  (&shape_component (:P *P2) (:Id *X))
  (&slide2.distance (:key X) *K)
  (&slide_dir (:Key X) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&moved *P)
       (&ink (:C *Col)))
      ((&region *F P)
       (NOT (&moved P))
       (&field_color F Col))))
