;; 8f215267

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

;; The objects, one color each.
(INIT &comps Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&ink *P *Col)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3) Col))
        ((&ink P Col)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(INIT &drect Outlines
  (key ((&ink *P ^Col))
    (node (P)
      (&ink *P Col))))

(RULE &in_hole_interior1
  (&comps_component (:P *P_) *Id)
  (&drect.box (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (<= K_m3 0))

;; The frame edge the dots count in from.
(DET &dot_dir DirDomain)

;; Distance between dots.
(DET &spacing TileCount)

(RULE &frame
  (&drect.box (:key *Col) *B)
  (input (:P *Q))
  (ALL ((&drect.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X Q) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((> K_m3 0)))
  (&comps_component (:Key Col) *P *Id)
  (ALL ((&comps_component (:Key *Colmm) P (:Id *Idm))
        (&drect.box (:key (:Col Colmm)) B)
        (dir_elem (:D *D_m1mm))
        (relative (:Base B) (:X P) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1mm) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (ALL ((&comps_component (:P *Pm) Id))
       ((&in_hole_interior1 (:P_ Pm) (:B_ B)))))

(ALTS $choice "what makes an object a frame" $Rect
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&comps_component (:Id *Key))
      (input *P)
      (NOT (&comps_component P (:Id Key))))

    (RULE &closed_flood_node
      (&comps_component (:Id *Key))
      (input *P)
      (NOT (&comps_component P (:Id Key))))

    (INIT &closed_flood Propagation
      (key ((OR ((&closed_cell (:Key ^Ky) *P)
                 (dir_elem *D)
                 (margin (:B P) D (:K 0))
                 (&closed_flood_node (:Key Ky) P))
                ((&closed_flood_node (:Key Ky) P)
                 (&closed_flood_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *Q))
                 (&closed_flood_node (:Key Ky) (:P Q)))))
        (source ((:n P))
          (&closed_cell (:Key Ky) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (&closed_flood_node (:Key Ky) P))
        (edge ((:a P) (:b Q))
          (&closed_flood_node (:Key Ky) *P)
          (&closed_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *Q))
          (&closed_flood_node (:Key Ky) (:P Q)))))

    (RULE &closed_node
      (&closed_cell *Key *P)
      (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

    ;; What each object closes off, over the cells that are not its own.
    (INIT &closed Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&closed_node (:Key *Ky) *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:Key Ky) (:P P2)))
            ((&closed_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *Key *P) *Id))

    (INIT &obox BoundingBox
      (key ((&comps_component *P ^Id))
        (cell (P)
          (&comps_component *P Id))))

    (RULE &frame
      (&closed_component (:Key *Id))
      (&comps_component (:Key *Col) Id)
      (&obox.box (:key Id) *B))))

;; The blobs of each color: its objects that are not frames.
(INIT &blobs Cardinality
  (key ((&comps_component (:Key ^Col) *Id)
        (NOT (&frame Col Id)))
    (member ((:m Id))
      (&comps_component (:Key Col) *Id)
      (NOT (&frame Col Id)))))

(RULE &kept
  (OR ((&frame *Col *Id)
       (&comps_component (:Key Col) *P Id))
      ((&frame Col *B)
       (input P)
       (ALL ((&frame (:Col *Colm) B)
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((> K_m3 0)))
       (relative (:Base B) (:X P) (:X_rel *P_inner))
       (&dot_dir *D)
       (axis_of D (:A *A_m1))
       (perp (:A A_m1) (:A2 *A2_m2))
       (axis_of (:D *D2) (:A A2_m2))
       (opposite (:D D2) (:Opp *O_m3))
       (margin (:B P_inner) (:D D2) (:K *K2))
       (margin (:B P_inner) (:D O_m3) (:K K2))
       (margin (:B P_inner) D *K)
       (&spacing (:N *W))
       (divide (:T K) (:Side W) (:Gap 0) (:Part *I) (:Remainder 0))
       (&blobs.size (:key Col) *N)
       (<= I N))))

(RULE &output
  (input *P)
  (OR ((&kept P *Col))
      ((NOT (&kept P))
       (&bg_mode.maximal (:t Col)))))
