;; 42a15761

(DET &gap DivisorRatio)

(DET &order_dir DirDomain)

(DET &panel_size SepTileDim)

(RULE &panel_division_gap
  (&order_dir *D)
  (axis_of D *A)
  (&gap (:K *G)))

(RULE &panel_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &panel_division_side
  (&order_dir *D)
  (axis_of D *A)
  (&panel_size (:D *K)))

(RULE &panel_division_axis
  (OR ((input *P)
       (&order_dir *D)
       (axis_of D *A)
       (&panel_size (:D *K))
       (&order_dir (:D *D2))
       (axis_of (:D D2) A)
       (&gap (:K *G))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O))
       (margin (:B P) (:D D3) (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite (:D D3) (:Opp *O_m1))
       (edge_inset (:D D3) (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite (:D D3) (:Opp *O_m4))
       (edge_inset (:D D3) (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&order_dir (:D *D4))
       (axis_of (:D D4) A)
       (&panel_size (:D *K2))
       (NOT (&panel_division_gap A))
       (axis_of (:D *D22) A)
       (opposite (:D D22) (:Opp *O2))
       (margin (:B P) (:D D22) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D22) (:Opp *O_m12))
       (edge_inset (:D D22) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D22) (:Opp *O_m42))
       (edge_inset (:D D22) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((input P)
       (axis_elem A)
       (NOT (&panel_division_side A))
       (&panel_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &panel_division_tile
  (&panel_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&panel_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &mark RarestColor)

(RULE &panel
  (&panel_division_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &tile
  (&panel *P_tile))

;; Marks per panel; a panel carrying none counts 0.
(INIT &marks Cardinality
  (key ((OR ((&tile ^P_tile))
            ((&panel *P_grid P_tile)
             (input (:P P_grid) *Col)
             (&mark (:C Col)))))
    (member ((:m P_grid))
      (&panel *P_grid P_tile)
      (input (:P P_grid) *Col)
      (&mark (:C Col)))
    (domain ()
      (&tile P_tile))))

;; Dense rank over the distinct mark counts, fewest first.
(INIT &count_order Order
  (member ((:t N))
    (&marks.size *N))
  (score ((:t N) (:S N))
    (&marks.size *N)))

(RULE &place
  (&marks.size (:key (:P_tile *P_src_tile)) *N)
  (&count_order.rank (:t N) *R)
  (&tile (:P_tile *P_dst_tile))
  (&order_dir *D)
  (margin (:B P_dst_tile) D (:K R)))

(RULE &output
  (OR ((&panel (:P_grid *P) (:P_tile *P_dst_tile) *P_intile)
       (&place *P_src_tile P_dst_tile)
       (&panel (:P_grid *P_grid_in) (:P_tile P_src_tile) P_intile)
       (input (:P P_grid_in) *Col))
      ((input P Col)
       (NOT (&panel (:P_grid P))))))
