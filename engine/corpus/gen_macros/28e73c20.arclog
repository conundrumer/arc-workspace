;; 28e73c20

;; Spacing between successive arms.
(DET &pitch SepTileCount)

(RULE &inset_uniform_inset1
  (&pitch (:N *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(RULE &turn_box_uniform_inset1
  (input *P)
  (dir_elem *D)
  (margin (:B P) D (:K *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

(DET &ink AnyOutNewColor)

;; The corner the spiral starts from.
(DET &corner DiagDirDomain)

;; The sense the spiral winds in.
(DET &sense SenseDomain)

(RULE &inset
  (&pitch (:N *K))
  (&inset_uniform_inset1 (:K_ K) (:B_ *B)))

(RULE &cycle_end
  (&corner (:D *C))
  (corner_dir C (:A *A_m1) *D)
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir C (:A A2_m2) (:D *D2))
  (&sense *S)
  (turn S D D2))

(RULE &turn_box
  (input *P)
  (dir_elem *D)
  (margin (:B P) D *K)
  (&turn_box_uniform_inset1 (:K_ K) (:B_ *B)))

;; The walk starts at the corner cell, on the frame.
(INIT &spiral Propagation
  (source ((:n P D B))
    (input *P)
    (&corner (:D *C))
    (corner_dist P (:Diag C) (:K 0))
    (&cycle_end (:D *D_end))
    (opposite (:D D_end) (:Opp *D))
    (= *B 0))
  (edge ((:a P D B) (:b (:P P2) (:D D2) (:B B2)))
    (input *P)
    (dir_elem *D)
    (&turn_box *B)
    (OR ((margin B D (:K *K_m4))
         (margin (:B P) D (:K K_m4))
         (= *P2 P)
         (&sense *S)
         (turn S D *D2)
         (IF ((&cycle_end D))
             ((&inset (:B *B_inset))
              (compose (:A B) (:B B_inset) (:C *B2)))
             ((= B2 B))))
        ((dir_elem D)
         (margin B D (:K *K1_m1))
         (margin (:B P) D (:K *K2_m2))
         (< K1_m1 K2_m2)
         (= D2 D)
         (= B2 B)
         (step_offset D (:V *V_m3))
         (compose (:A P) (:B V_m3) (:C P2))))))

(RULE &walk
  (&spiral.reached (:n *P)))

(ALTS $choice "how an off-spiral cell is filled — every input is blank, so this is underdetermined" $Passthrough
  (ALT $Repaint
    (DET &bg DominantColor)

    (RULE &output
      (OR ((input *P)
           (NOT (&walk P))
           (&bg (:C *Col)))
          ((&walk P)
           (&ink (:C Col)))))))

(RULE &output
  (OR ((&walk *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&walk P)))))
