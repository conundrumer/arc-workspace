;; 25d8a9c8

(DET &axis AxisDomain)

(RULE &cell_split_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
  (relative (:Base P_inner_) (:X P_) (:X_rel *P_across_)))

(DET &uniform_color AnyOutNewColor)

(DET &non_uniform_color AnyOutNewColor)

(RULE &cell_split
  (input *P *Col)
  (&axis *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_inner_ *P_inner) (:P_across_ *P_across)))

;; $PairExist: the color a slice holds.
(INIT &slice_color Singleton
  (key ((&cell_split *Col ^P_across))
    (member ((:v Col))
      (&cell_split *Col P_across))))

(DET &slice_out
  (&cell_split *E *P *P_inner *P_across)
  (ex_output E P *Col))

(ALTS $detect "detect" $PairExist
  (ALT $Count
    ;; $Count: distinct-color count per slice.
    (INIT &slice_palette Cardinality
      (key ((&cell_split *Col ^P_across))
        (member ((:m Col))
          (&cell_split *Col P_across))))

    (RULE &ncolors
      (&slice_palette.size (:key *P_across) *N))

    (DET &count_color
      (&ncolors *E *P_across *N)
      (&slice_out E P_across *Col))

    (RULE &output
      (&cell_split *P *P_across)
      (&ncolors P_across *N)
      (&count_color N *Col))
    (ALT $SliceMap
      (DET &count_template
        (&ncolors *E *P_across *N)
        (&slice_out E P_across *P_inner *Col))

      (RULE &output
        (&cell_split *P *P_inner *P_across)
        (&ncolors P_across *N)
        (&count_template N P_inner *Col)))))

(ALTS $stage "stage" $PerCell
  (ALT $SliceMap
    (DET &non_uniform_template
      (&slice_out *E *P_across (:P_inner *P) *Col)
      (&slice_color.plural E (:key P_across)))

    (DET &uniform_template
      (&slice_out *E *P_across (:P_inner *P) *Col)
      (NOT (&slice_color.plural E (:key P_across))))

    (RULE &output
      (&cell_split *P *P_inner *P_across)
      (OR ((NOT (&slice_color.plural (:key P_across)))
           (&uniform_template (:P P_inner) *Col))
          ((&slice_color.plural (:key P_across))
           (&non_uniform_template (:P P_inner) Col))))))

(RULE &output
  (&cell_split *P *P_across)
  (OR ((NOT (&slice_color.plural (:key P_across)))
       (&uniform_color (:C *Col)))
      ((&slice_color.plural (:key P_across))
       (&non_uniform_color (:C Col)))))
