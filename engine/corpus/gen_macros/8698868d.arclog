;; 8698868d

(RULE &squares_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(RULE &squares_node
  (input *P (:Col *Key))
  (NOT (&bg (:Col Key))))

;; Touching cells of one non-bg color.
(INIT &squares Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&squares_node (:Key *Ky) *P)
         (&squares_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&squares_node (:Key Ky) (:P P2)))
        ((&squares_node (:Key Ky) P)
         (= P2 P)))))

(RULE &squares_component
  (&squares.class (:a *Key *P) *Id))

(RULE &enclosed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bbox BoundingBox
  (key ((&squares_component *P ^Id))
    (cell (P)
      (&squares_component *P Id))))

(RULE &covered
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &enclosed_node
  (&covered (:Id *Key) *P)
  (input P *Col)
  (&bg Col))

;; The background regions a square encloses: a block's dots, a piece's holes.
(INIT &enclosed Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&enclosed_node (:Key *Ky) *P)
         (&enclosed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&enclosed_node (:Key Ky) (:P P2)))
        ((&enclosed_node (:Key Ky) P)
         (= P2 P)))))

(RULE &enclosed_component
  (&enclosed.class (:a *Key *P) *Id))

(RULE &square
  (&squares_component (:Key *Col) *Id))

(RULE &side
  (&bbox.box (:key *Id) *B)
  (input *P)
  (axis_elem (:A *A_m1))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A_m1) *N))

;; The largest squares are the blocks; the rest are the pieces.
(INIT &size Order
  (member ((:t N))
    (&side *N))
  (score ((:t N) (:S N))
    (&side *N)))

(RULE &block
  (&side *Id *N)
  (&size.maximal (:t N)))

(RULE &piece
  (&square *Id)
  (NOT (&block Id)))

(INIT &region_count Cardinality
  (key ((OR ((&enclosed_component (:Key ^Id) (:Id *R)))
            ((&square Id))))
    (member ((:m R))
      (&enclosed_component (:Key Id) (:Id *R)))
    (domain ()
      (&square Id))))

(RULE &pair
  (&block (:Id *Id_block))
  (&piece (:Id *Id_piece))
  (&region_count.size (:key (:Id Id_block)) *N)
  (&region_count.size (:key (:Id Id_piece)) N))

;; A block's interior, in its own frame: the piece's frame.
(INIT &core BoundingBox
  (key ((&block ^Id))
    (cell (P)
      (&bbox.box *B)
      (input *P)
      (ALL ((&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((> K_m3 0))))))

;; The output frame is the region the blocks tile.
(INIT &layout BoundingBox
  (cell (P)
    (&block *Id)
    (&covered Id *P)))

(ALTS $choice "which piece fills each block — data-equivalent on this task, since the blocks' and pieces' region counts are the same set" $Count
  (ALT $Rank
    (RULE &fewer
      (&region_count.size (:key *Id) *N)
      (&region_count.size (:key (:Id *Id2)) (:N *N2))
      (< N N2))

    (INIT &block_rank Order
      (member ((:t Id))
        (&block *Id))
      (before ((:a Id) (:b Id2))
        (&fewer *Id *Id2)))

    (INIT &piece_rank Order
      (member ((:t Id))
        (&piece *Id))
      (before ((:a Id) (:b Id2))
        (&fewer *Id *Id2)))

    (RULE &pair
      (OR ((&block_rank.rank (:t *Id_block) *R)
           (&piece_rank.rank (:t *Id_piece) R))
          ((&block_rank.dual_rank (:t Id_block) R)
           (&piece_rank.dual_rank (:t Id_piece) R))))))

(RULE &output
  (&layout.cell (:P *P_grid_in))
  (&layout.box (:B *B_l))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B_l) (:X P_grid_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B_l) (:X P_grid_in) (:X_rel *P))
  (&block (:Id *Id_b))
  (&covered (:Id Id_b) (:P P_grid_in))
  (OR ((NOT (&core.cell (:key (:Id Id_b)) (:P P_grid_in)))
       (&square (:Id Id_b) *Col))
      ((&core.cell (:key (:Id Id_b)) (:P P_grid_in))
       (&core.box (:key (:Id Id_b)) (:B *B_c))
       (relative (:Base B_c) (:X P_grid_in) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (>= K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (>= K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (>= K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (>= K4_m11 0)
       (relative (:Base B_c) (:X P_grid_in) (:X_rel *P_inner))
       (&pair (:Id_block Id_b) (:Id_piece *Id_p))
       (input (:P *Q) (:Col *C_q))
       (&bbox.box (:key (:Id Id_p)) (:B *B_p))
       (relative (:Base B_p) (:X Q) (:X_rel *R_m12))
       (axis_of (:D *D1_m13) (:A *A1_m14))
       (opposite (:D D1_m13) (:Opp *O1_m15))
       (perp (:A A1_m14) (:A2 *A2_m16))
       (axis_of (:D *D2_m17) (:A A2_m16))
       (opposite (:D D2_m17) (:Opp *O2_m18))
       (margin (:B R_m12) (:D D1_m13) (:K *K1_m19))
       (>= K1_m19 0)
       (margin (:B R_m12) (:D O1_m15) (:K *K2_m20))
       (>= K2_m20 0)
       (margin (:B R_m12) (:D D2_m17) (:K *K3_m21))
       (>= K3_m21 0)
       (margin (:B R_m12) (:D O2_m18) (:K *K4_m22))
       (>= K4_m22 0)
       (relative (:Base B_p) (:X Q) (:X_rel P_inner))
       (OR ((NOT (&bg (:Col C_q)))
            (= Col C_q))
           ((&bg (:Col C_q))
            (&square (:Id Id_b) Col))))))
