;; 97a05b5b

(RULE &flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(DET &board_color SharedColor)

(RULE &flood_node
  (input *P *Col)
  (&bg (:C Col)))

(INIT &flood Propagation
  (source ((:n P))
    (&flood_node *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P *Col)
    (&bg (:C Col)))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (&bg (:C Col))
    (&flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (&bg (:C Col2))))

(RULE &hole
  (&flood_node *P)
  (NOT (&flood.reached (:n P))))

(RULE &obj_cell
  (&obj_component *P (:Id *O))
  (input P *Col))

(RULE &board
  (&obj_cell *O *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&hole (:P Q)))

(RULE &piece
  (&obj_cell *O)
  (NOT (&board O)))

(INIT &patch_box BoundingBox
  (key ((&piece ^O))
    (cell (P)
      (&obj_cell O *P *Col)
      (&board_color (:C Col)))))

(RULE &piece_cell
  (&obj_cell *O *P *Col)
  (&patch_box.box (:key O) *B)
  (relative (:Base B) (:X P) (:X_rel *P_rel))
  (c4_elem *D)
  (apply D (:P P_rel) (:P_out *P_turn)))

(RULE &patch_cell
  (&piece_cell *O *D *P_turn *Col)
  (&board_color (:C Col)))

;; Every spot at which a turned patch falls on holes alone.
(INIT &occ Occurrences
  (key ((OR ((&patch_cell ^O ^D *P_turn))
            ((&piece O)
             (c4_elem D)
             (&hole *P))))
    (cell (P)
      (&piece O)
      (c4_elem D)
      (&hole *P))
    (shape ((:P P_turn))
      (&patch_cell O D *P_turn))))

(RULE &fills
  (&occ.occurrence (:key *O *D) (:P *B))
  (&patch_cell O D *P_turn)
  (compose (:A B) (:B P_turn) (:C *P)))

(RULE &pruning_item
  (&occ.occurrence (:key *O *D) (:P *B)))

;; One spot per piece, and no two pieces over one hole.
(CHOOSE &pruning
  (for ((&pruning_item ^O))
    (from (&pruning_item O *D *B)))
  (never
    (&pruning_item *O *D *B)
    (&pruning_item (:O *O2) (:D *D2) (:B *B2))
    (&fills O D B *P)
    (&fills (:O O2) (:D D2) (:B B2) P)))

(RULE &place
  (&pruning *O *D *B))

(INIT &board_box BoundingBox
  (cell (P)
    (&board *O)
    (&obj_cell O *P)))

(ALTS $choice "what settles where a piece lands" $Pack
  (ALT $Match
    (RULE &hole_region_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    ;; The holes grouped into regions. A hole joins its neighbors at a corner as
    ;; well as at a side, as the cells of a patch do.
    (INIT &hole_region Quotient
      (edge ((:a P) (:b P3))
        (OR ((&hole *P)
             (&hole_region_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&hole (:P P3)))
            ((&hole P)
             (= P3 P)))))

    (RULE &hole_region_component
      (&hole_region.class (:a *P) *Id))

    (INIT &region_box BoundingBox
      (key ((&hole_region_component *P (:Id ^R)))
        (cell (P)
          (&hole_region_component *P (:Id R)))))

    ;; A turned patch against a region, each read in its own box.
    (INIT &congruent Inclusion
      (pattern ((:pattern R) (:m P_rel))
        (&hole_region_component *P (:Id *R))
        (&region_box.box (:key R) *B)
        (ALL ((&hole_region_component P (:Id *Rm))
              (&region_box.box (:key (:R Rm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base B) (:X P) (:X_rel *P_rel)))
      (observed ((:observed O D) (:m P_turn))
        (&patch_cell *O *D *P_turn)))

    (RULE &place
      (&congruent.equal (:observed *O *D) (:pattern *R))
      (&region_box.box (:key R) *B))))

(RULE &paints
  (&place *O *D *B)
  (&piece_cell O D *P_turn *Col)
  (compose (:A B) (:B P_turn) (:C *P)))

(RULE &output
  (&board_box.box *B)
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (OR ((&paints (:P *P2) *Col))
      ((input (:P P2) Col)
       (NOT (&paints (:P P2)))))
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (relative (:Base B) (:X P2) (:X_rel *P)))
