;; 9720b24f

(INPUT container "a container is every cell of one color"

  (RULE &shapes_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET &bg SharedColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&bg (:C Col))))

  (INIT &shapes Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&shapes_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P))))))

(INPUT outline-shape "each container is drawn as one 8-connected shape.")

(OUTPUT inside "a non-bg cell is erased to bg when it lies inside a container it does not belong to"
  (APPROXIMATED "a cell lies inside a container when the container's cells are on both sides of it along one axis, and one is to a side of the other axis"))

(OUTPUT pass "every other cell passes through unchanged")

(ALTS $choice "what a container is" $ColorClass
  (ALT $Shape
    (INPUT container "a container is one 8-connected shape of non-bg cells"
      (RULE &shapes_component
        (&shapes.class (:a *Key *P) *Id)))
    (RULE &together
      (&shapes_component (:Key *Ky) *P (:Id *I))
      (&shapes_component (:Key Ky) (:P *Q) (:Id I)))))

(RULE &together
  (&ink *P *Col)
  (&ink (:P *Q) Col))

(RULE &sees
  (&ink *P)
  (&together (:P *Q) (:Q *Q2))
  (axis_of *D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q2) (:D D_m2) (:K K_m3))
  (dir_elem D)
  (margin (:B Q2) D (:K *K1_m4))
  (margin (:B P) D (:K *K2_m5))
  (< K1_m4 K2_m5))

(RULE &between
  (&sees *P *Q *D)
  (&sees P Q (:D *D2))
  (opposite D (:Opp D2))
  (axis_of D *A))

(RULE &surrounded
  (&between *P *Q *A)
  (perp A *A2)
  (axis_of *D (:A A2))
  (&sees P Q D))

(RULE &erased
  (&surrounded *P *Q)
  (NOT (&together P Q)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&erased P)))
      ((&erased P)
       (&bg (:C Col)))))
