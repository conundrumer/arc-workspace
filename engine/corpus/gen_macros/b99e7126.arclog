;; b99e7126

(INPUT tile-lattice "divider lines of one color, one cell wide, cut the grid into a 7 by 7 lattice of 3 by 3 tiles, with a divider line along each edge of the grid")

(INPUT base-tile "most tiles hold one same two-color pattern, the base tile"

  (RULE &item_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (INIT &line_color Singleton
    (key ((input *P *Col)
          (axis_elem ^A)
          (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
      (member ((:v Col))
        (input *P *Col)
        (axis_elem A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

  (RULE &lattice_divider
    (&line_color.value (:key *A *L)))

  (RULE &lattice_on_divider
    (input *P)
    (&lattice_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  (INIT &lattice_rank Order
    (key ((OR ((&lattice_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&lattice_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&lattice_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &lattice_part_idx
    (input *P)
    (axis_of *D *A)
    (NOT (&lattice_on_divider P A))
    (margin (:B P) D *K)
    (&lattice_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &lattice_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&lattice_part_idx *P D (:N *N1))
    (&lattice_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE_OR_DET &lattice_tile_of
    (&lattice_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&lattice_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (INIT &block BoundingBox
    (key ((&lattice_tile_of *P (:P_tile ^T)))
      (cell (P)
        (&lattice_tile_of *P (:P_tile T)))))

  (RULE &tile_at
    (&block.cell (:key *T) *P)
    (&block.box (:key T) *B)
    (ALL ((&block.cell (:key (:T *Tm)) P)
          (&block.box (:key (:T Tm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_intile)))

  (RULE &tile_cell
    (&tile_at *P *T *P_intile)
    (input P *Col))

  (INIT &pattern Quotient
    (equivalent ((:a T) (:b T2))
      (&block.box (:key *T))
      (&block.box (:key (:T *T2)))
      (ALL ((&tile_cell T (:P_intile *P) *Col)
            (&tile_cell (:T T2) (:P_intile P) (:Col *Col2)))
           ((= Col Col2)))))

  (RULE &tile_toward
    (&pattern.class (:a *T))
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A T) (:B V_m1) (:C *T2))
    (&pattern.class (:a T2)))

  (INIT &corner Singleton
    (member ((:v Id))
      (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1))
      (perp (:A A_m2) (:A2 *A2_m3))
      (corner_dir (:C Diag_m1) (:A A2_m3) (:D *D2))
      (&pattern.class (:a *T) *Id)
      (NOT (&tile_toward T (:D D1)))
      (NOT (&tile_toward T (:D D2))))))

(INPUT marked-tile "every other tile holds one same pattern, the marked tile, made of one color of the base tile and one color that the base tile does not have, the new color")

(INPUT partial-shape "the marked tiles sit, at the tile scale, on cells of exactly one placement of the new color's shape in the lattice, and do not fill it"

  (INIT &commoner_count Cardinality
    (key ((&pattern.class (:a *T) ^Id))
      (member ((:m T))
        (&pattern.class (:a *T) Id))))

  (INIT &commoner Order
    (member ((:t Id))
      (&commoner_count.size (:key *Id)))
    (score ((:t Id) (:S N))
      (&commoner_count.size (:key *Id) *N)))

  (RULE &base_pattern
    (&commoner.maximal (:t *Id)))

  (RULE &marked
    (&base_pattern)
    (&pattern.class (:a *T) *Id)
    (NOT (&base_pattern Id)))

  (RULE &mark_cell
    (&marked *T)
    (&tile_cell T *P_intile *Col))

  (RULE &base_color
    (&base_pattern *Id)
    (&pattern.class (:a *T) Id)
    (&tile_cell T *Col))

  (RULE &shape
    (&mark_cell *P_intile *Col)
    (NOT (&base_color Col)))

  ;; The shape laid on the lattice at the tile scale.
  (INIT &fit Occurrences
    (cell ((:P T))
      (&shape)
      (&pattern.class (:a *T)))
    (shape (P)
      (&shape (:P_intile *P))))

  (RULE &placement
    (&fit.occurrence (:P *B)))

  (RULE &covers
    (&placement *B)
    (&shape (:P_intile *P))
    (compose (:A B) (:B P) (:C *T))
    (&pattern.class (:a T)))

  (INIT &most_count Cardinality
    (key ((&covers ^B *T)
          (&marked T))
      (member ((:m T))
        (&covers B *T)
        (&marked T))))

  (INIT &most Order
    (member ((:t B))
      (&most_count.size (:key *B)))
    (score ((:t B) (:S N))
      (&most_count.size (:key *B) *N))))

(OUTPUT shape-of-new-color "the shape is the set of cells of the marked tile whose color the base tile does not have, read as a mask of the tile's size"

  (INIT &majority_count Cardinality
    (key ((&mark_cell (:P_intile *P) ^Col))
      (member ((:m P))
        (&mark_cell (:P_intile *P) Col))))

  (INIT &majority Order
    (member ((:t Col))
      (&majority_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&majority_count.size (:key *Col) *N))))

(OUTPUT complete-shape "the output keeps the input, and each tile at a cell of the one placement of the shape that holds the marked tiles becomes a marked tile"

  (RULE &misses
    (&placement *B)
    (&marked *T)
    (NOT (&covers B T)))

  (RULE &qualifies
    (&placement *B)
    (NOT (&misses B))))

(ALTS $base "which tile pattern is the base tile" $Commoner
  (ALT $CornerBase
    (INPUT base-tile "the base tile is the pattern of the lattice's four corner tiles; undefined where they hold different patterns"
      (RULE &base_pattern
        (&corner.value (:v *Id))))))

(ALTS $src "which cells of the marked tile make the shape" $NewColor
  (ALT $MajorityColor
    (OUTPUT shape-of-new-color "the shape is the cells of the marked tile's commoner color; undefined where two colors tie for commonest"
      (RULE &majority_tie
        (&majority.maximal (:t *Col))
        (&majority.maximal (:t *Col2))
        (!= Col Col2))

      (RULE &shape
        (&mark_cell *P_intile *Col)
        (&majority.maximal (:t Col))
        (NOT (&majority_tie))))))

(ALTS $bound "whether a placement of the shape lies wholly inside the lattice" $InLattice
  (ALT $ClippedPlacement
    (INPUT partial-shape "a placement may run past the lattice edge, and only its part inside the lattice is drawn"
      (RULE &placement
        (&fit.candidate (:P *B))))))

(ALTS $many "what the output is where more than one placement qualifies" $OnePlacement
  (ALT $UnionOfPlacements
    (OUTPUT complete-shape "where several placements qualify, one grid completes every one of them")
    (RULE &drawn
      (&qualifies *B)))
  (ALT $EachPlacement
    (OUTPUT complete-shape "where several placements qualify, each gives a grid of its own")
    (RULE &drawn
      (&qualifies *B))))

(ALTS $cover "which placements of the shape qualify" $AllMarked
  (ALT $MostMarked
    (INPUT partial-shape "marked tiles may lie outside every placement of the shape")
    (OUTPUT complete-shape "the placements that hold the most marked tiles qualify, and marked tiles outside them stay"
      (RULE &qualifies
        (&most.maximal (:t *B))))))

(RULE &rival
  (&qualifies *B)
  (&qualifies (:B *B2))
  (!= B B2))

(RULE &drawn
  (&qualifies *B)
  (NOT (&rival B)))

(RULE &filled
  (&drawn *B)
  (&covers B *T)
  (&tile_at *P T *P_intile)
  (&mark_cell P_intile *Col))

(RULE &output
  (&drawn)
  (input *P (:Col *Col_in))
  (OR ((&filled P *Col))
      ((NOT (&filled P))
       (= Col Col_in))))
