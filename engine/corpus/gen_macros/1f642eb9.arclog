;; 1f642eb9

(RULE &rays_dir
  (dir_elem *D))

(RULE &rays_dir_ray
  (&rays_dir *D))

(DET &block SharedColor)

(RULE &block_cell
  (input *P *Col)
  (&block (:C Col)))

(RULE &rays_blocked
  (&block_cell *P))

(DET &bg DominantColor)

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&block (:C Col))))

(RULE &rays_source
  (&marker *P))

(ALTS $choice "what stops a traveling color; the block is a solid rectangle in every pair, so the data does not say which" $Block
  (ALT $Box
    (INIT &bbox BoundingBox
      (cell (P)
        (&block_cell *P)))

    (RULE &rays_blocked
      (input *P)
      (&bbox.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &rays_node
  (&rays_dir)
  (input *P)
  (NOT (&rays_blocked P)))

;; Each marker casts every way; the color halts on the first cell the case
;; blocks.
(INIT &rays Distance
  (key ((&rays_source (:P ^O))
        (&rays_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:P O))
           (&rays_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:P Q)))
          ((&rays_source (:P O))
           (&rays_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:P Q))
           (= A2 O))
          ((&rays_source (:P O))
           (&rays_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:P Q)))))
    (source ((:n O))
      (&rays_source (:P O))
      (&rays_dir_ray D))))

(RULE &rays_ray
  (&rays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray (:P Q) D Origin)))

(RULE &paint
  (&rays_end (:P *E) *D (:Origin *P2))
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P))
  (input P)
  (&marker (:P P2) *Col))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
