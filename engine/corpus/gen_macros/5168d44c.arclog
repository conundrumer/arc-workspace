;; 5168d44c

(DET &ring ColorDomain)

(RULE &ring_cell
  (input *P *Col)
  (&ring (:C Col)))

(RULE &closed_cell
  (input *P)
  (NOT (&ring_cell P)))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &closed_flood Propagation
  (source ((:n P))
    (&closed_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P)
    (NOT (&ring_cell P)))
  (edge ((:a P) (:b P2))
    (input *P)
    (NOT (&ring_cell P))
    (&closed_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2))
    (NOT (&ring_cell (:P P2)))))

(RULE &closed_node
  (&closed_cell *P)
  (NOT (&closed_flood.reached (:n P))))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &closed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&closed_node *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:P P2)))
        ((&closed_node P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *P) *Id))

(RULE &center
  (&closed_component *P))

(DET &corner DiagDirDomain)

(DET &dot UnchangedColor)

(RULE &dot_cell
  (input *P *Col)
  (&dot (:C Col)))

(RULE &move_dir
  (&center (:P *C))
  (&dot_cell *P)
  (!= P C)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B C) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3))
  (&corner (:D *Diag))
  (corner_dir (:C Diag) A *D))

(RULE &cast_dir
  (&move_dir *D))

(RULE &cast_dir_ray
  (&cast_dir *D))

(RULE &cast_blocked
  (&dot_cell *P))

(RULE &cast_source
  (&center *P))

(DET &bg DominantColor)

(RULE &shape
  (&ring_cell *P)
  (&center (:P *C))
  (relative (:Base C) (:X P) (:X_rel *V)))

(ALTS $choice "what fixes where the ring lands (coincide when the dots are two apart)" $Next
  (ALT $Jump
    (DET &step TileCount)

    (RULE &target
      (OR ((&center (:P *C))
           (&move_dir *D)
           (&step (:N *K))
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A C) (:B V_m1) (:C *P)))
          ((&cast_end (:P *E) (:D *D2))
           (step_offset (:D D2) (:V *V_m12))
           (compose (:A E) (:B V_m12) (:C P))
           (input P))))

    (RULE &cast_node
      (&cast_dir)
      (input *P)))
  (ALT $Fit
    (RULE &obstructed
      (input *P)
      (&shape *V)
      (compose (:A P) (:B V) (:C *Q))
      (&dot_cell (:P Q)))

    ;; The travel halts where the ring covers no dot.
    (RULE &cast_blocked
      (input *P)
      (NOT (&obstructed P)))))

(RULE &cast_node
  (&cast_dir)
  (input *P)
  (NOT (&cast_blocked P)))

;; $Next and $Fit both take the first cell ahead that halts the ring.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir_ray D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &target
  (&cast_end (:P *E) *D)
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P))
  (input P))

(RULE &new_ring
  (&target (:P *Q))
  (&shape *V)
  (compose (:A Q) (:B V) (:C *P)))

(RULE &output
  (OR ((&dot_cell *P)
       (&dot (:C *Col)))
      ((&new_ring P)
       (&ring (:C Col)))
      ((input P)
       (NOT (&dot_cell P))
       (NOT (&new_ring P))
       (&bg (:C Col)))))
