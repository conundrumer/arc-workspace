;; b7955b3c

(INPUT layered-rectangles "a background fills the frame, and solid axis-aligned rectangles, each of its own color, lie stacked over it; each rectangle hides the part of every lower rectangle that it covers")

(INPUT visible-extent "each rectangle shows cells on each of its four sides, so the bounding box of its visible cells, with the mark cells it lies under, is the rectangle")

(INPUT marks "marks of color mark_color, each a plus — a center cell and its four cardinal neighbors — lie over the scene and hide the cells under them; no other cell has color mark_color")

(OUTPUT erase-marks "each cell of color mark_color takes the color the stack of rectangles shows there: the color of the rectangle drawn last of those that cover it, and the background color where no rectangle covers it; every other cell keeps its color"
  (APPROXIMATED "each rectangle is the bounding box of its visible cells, and a rectangle is over another when one of its visible cells lies in the other's box, closed transitively; each cell of color mark_color takes the color of the topmost rectangle that covers it")

  (DET &marks_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &mark_color ChangedColor)

  (DET &erased
    (ex_input *E *P *Col)
    (&mark_color (:C Col))
    (ex_output E P (:Col *Col2))
    (NOT (&mark_color (:C Col2))))

  (INIT &marks Quotient
    (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
      (OR ((&erased *E *P)
           (&marks_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&erased E (:P P3)))
          ((&erased E P)
           (= P3 P)))))

  (DET &marks_component
    (&marks.class (:a *Key *P) *Id))

  (DET &mark_cell
    (&marks_component (:Key *E) *P *Id))

  (INIT &mark_size Cardinality
    (key ((&mark_cell ^E ^Id *P))
      (member ((:m P))
        (&mark_cell E Id *P))))

  ;; The smallest erased component is a single mark.
  (INIT &smallest Order
    (member ((:t (:E K_e) (:Id K_id) (:S N)))
      (&mark_size.size (:key (:E *K_e) (:Id *K_id)) *N))
    (score ((:t (:E K_e) (:Id K_id) (:S N)) (:S N))
      (&mark_size.size (:key (:E *K_e) (:Id *K_id)) *N)))

  (INIT &frame BoundingBox
    (key ((&smallest.minimal (:t ^E ^Id)))
      (cell (P)
        (&mark_cell E Id *P))))

  (DET &mark_shape_inside1
    (&frame.cell (:key (:E *K_e) (:Id *K_id)) (:P *P_))
    (&frame.box (:key (:E K_e) (:Id K_id)) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &mark_colored
    (input *P *Col)
    (&mark_color (:C Col)))

  (RULE &mark_at
    (&mark_colored *P))

  (RULE &shown
    (input *P *Col)
    (NOT (&mark_at P)))

  (INIT &common_count Cardinality
    (key ((&shown *P ^Col))
      (member ((:m P))
        (&shown *P Col))))

  (INIT &box BoundingBox
    (key ((&shown *P ^Col))
      (cell (P)
        (&shown *P Col))))

  (RULE &unit
    (&shown *Col))

  (RULE &over
    (&unit (:Col *Hi))
    (&unit (:Col *Lo))
    (!= Hi Lo)
    (&shown *P (:Col Hi))
    (&box.box (:key (:Col Lo)) *B)
    (ALL ((&shown P (:Col *Him))
          (&box.box (:key (:Col *Lom)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &covers
    (&unit *Col)
    (&mark_at *P)
    (&box.box (:key Col) *B)
    (ALL ((&mark_at P)
          (&box.box (:key (:Col *Colm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (DET &mark_shape
    (&frame.cell (:key (:E *K_e) (:Id *K_id)) (:P *P2))
    (&frame.box (:key (:E K_e) (:Id K_id)) *B)
    (NOT (&mark_shape_inside1 (:P_ P2) (:B_ B)))
    (relative (:Base B) (:X P2) (:X_rel *P)))

  (INIT &plus Occurrences
    (cell (P)
      (&mark_colored *P))
    (shape (P)
      (&mark_shape *P)))

  (INIT &common Order
    (member ((:t Col))
      (&common_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&common_count.size (:key *Col) *N))))

(ALTS $m "which cells are mark cells" $EveryMarkCell
  (ALT $PlusOccurrences
    (OUTPUT erase-marks "the mark cells are only the cells of whole placements of the plus in mark_color; a mark-colored cell outside every placement is a rectangle cell"
      (RULE &mark_at
        (&plus.occurrence (:P *Q))
        (&mark_shape (:P *S))
        (compose (:A Q) (:B S) (:C *P))))))

(ALTS $o "how the visible cells order the rectangles" $Transitive
  (ALT $DirectOrder
    (OUTPUT erase-marks "a rectangle is over another only when one of its visible cells lies in the other's box, with no transitive closure; undefined where two rectangles that cover a mark cell are ordered only through a third")
    (RULE &above
      (&over *Hi *Lo))))

(ALTS $b "what lies under the rectangles" $BottomLayer
  (ALT $DominantBackground
    (OUTPUT dominant-background "the commonest non-mark color is the background, lies under every rectangle and is not one of them, and fills a mark cell that no rectangle covers; undefined where two colors tie for commonest"
      (RULE &unit
        (&shown *Col)
        (NOT (&common.maximal (:t Col)))))
    (RULE &output
      (OR ((&mark_at *P)
           (NOT (&covers P))
           (&common.maximal (:t *Col)))
          ((&covers P Col)
           (NOT (&buried P Col)))
          ((input P Col)
           (NOT (&mark_at P)))))))

(INIT &stack Propagation
  (key ((&unit ^Col)))
  (edge ((:a Hi) (:b Lo))
    (&over *Hi *Lo)))

(RULE &above
  (&stack.reached (:key (:Col *Hi)) (:n *Lo))
  (!= Hi Lo))

(RULE &buried
  (&above (:Hi *Col2) (:Lo *Col))
  (&covers *P (:Col Col2)))

(RULE &output
  (OR ((&covers *P *Col)
       (NOT (&buried P Col)))
      ((input P Col)
       (NOT (&mark_at P)))))
