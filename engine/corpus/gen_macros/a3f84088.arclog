;; a3f84088

(INPUT square-frame "each input holds one square, one-cell-thick outline of &frame_color on a field of &background"

  (DET &frame_color UnchangedColor)

  (DET &background SharedColor))

(INPUT empty-inside "every cell inside that outline is &background")

(OUTPUT ring-depth "the cells that an outline of &frame_color closes off from the grid edge, where a cell escapes by side-by-side steps through cells of other colors, form a region, one per closed-off component; a region cell's depth is the count of the region's rings outside it: its Chebyshev distance to the nearest cell outside the region, less one"

  (RULE &closed_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &closed_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &leak_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &leak_regions_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &wall
    (&frame_color *C))

  (RULE &open
    (&wall (:C *Ky))
    (input *P *Col)
    (!= Col Ky))

  ;; The open cells the grid edge reaches by side or diagonal steps.
  (INIT &leak Propagation
    (key ((OR ((&open (:Ky ^C) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0)))
              ((&open (:Ky C) P)
               (&leak_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&open (:Ky C) (:P P2)))))
      (source ((:n P))
        (&open (:Ky C) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a P) (:b P2))
        (&open (:Ky C) *P)
        (&leak_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&open (:Ky C) (:P P2)))))

  (RULE &leak_regions_node
    (&open (:Ky *Key) *P)
    (NOT (&leak.reached (:key (:C Key)) (:n P))))

  (INIT &leak_regions Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&leak_regions_node (:Key *Ky) *P)
           (&leak_regions_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&leak_regions_node (:Key Ky) (:P P2)))
          ((&leak_regions_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &leak_regions_component
    (&leak_regions.class (:a *Key *P) *Id))

  (RULE &closed_cell
    (&open (:Ky *Key) *P))

  (INIT &closed_flood Propagation
    (key ((OR ((&closed_cell (:Key ^Ky) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0))
               (&open Ky P))
              ((&open Ky P)
               (&closed_flood_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&open Ky (:P P2)))))
      (source ((:n P))
        (&closed_cell (:Key Ky) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&open Ky P))
      (edge ((:a P) (:b P2))
        (&open Ky *P)
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&open Ky (:P P2)))))

  (RULE &closed_node
    (&closed_cell *Key *P)
    (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

  (INIT &closed Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&closed_node (:Key *Ky) *P)
           (&closed_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&closed_node (:Key Ky) (:P P2)))
          ((&closed_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &closed_component
    (&closed.class (:a *Key *P) *Id))

  (RULE &bg_color
    (&background *C))

  (RULE &ink_color
    (&bg_color (:C *Bg))
    (input (:Col *C))
    (!= C Bg))

  ;; The one color of the cells other than the background.
  (INIT &ink Singleton
    (member ((:v C))
      (&ink_color *C)))

  (RULE &area
    (&closed_component (:Key *C) *P *Id))

  (INIT &leak_cheb Boundary
    (key ((&leak_regions_component (:Key ^C) *P))
      (cell (P)
        (&leak_regions_component (:Key C) *P)))
    (dir (D)
      (dir8_elem *D)))

  (INIT &manh Boundary
    (key ((&area ^C *P))
      (cell (P)
        (&area C *P))))

  (INIT &frame_box BoundingBox
    (key ((&wall ^C))
      (cell (P)
        (input *P (:Col C)))))

  ;; The inside of the box.
  (INIT &box_depth Boundary
    (key ((&frame_box.box (:key ^C) *B)
          (input *P)
          (ALL ((&frame_box.box (:key (:C *Cm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((> K_m3 0))))
      (cell (P)
        (&frame_box.box *B)
        (input *P)
        (ALL ((&frame_box.box (:key (:C *Cm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((> K_m3 0)))))
    (dir (D)
      (dir8_elem *D))))

(OUTPUT cycle-color "a region cell takes the &cycle entry at its depth modulo the number of entries"

  (DET &open2
    (ex_input *E *P *Col)
    (NOT (&frame_color (:C Col))))

  (DET &closed_cell2
    (&open2 *E *P))

  (INIT &closed_flood2 Propagation
    (key ((OR ((&closed_cell2 ^E *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0))
               (&open2 E P))
              ((&open2 E P)
               (&closed_flood_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&open2 E (:P P2)))))
      (source ((:n P))
        (&closed_cell2 E *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&open2 E P))
      (edge ((:a P) (:b P2))
        (&open2 E *P)
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&open2 E (:P P2)))))

  (DET &closed_node2
    (&closed_cell2 *E *P)
    (NOT (&closed_flood2.reached (:key E) (:n P))))

  (INIT &closed2 Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&closed_node2 (:E *Ky) *P)
           (&closed_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&closed_node2 (:E Ky) (:P P2)))
          ((&closed_node2 (:E Ky) P)
           (= P2 P)))))

  (DET &closed_component2
    (&closed2.class (:a (:Key *E) *P) *Id))

  (RULE &cheb_depth_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((dir8_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &commonest_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  ;; One instance serves every component of a key: two components meet at
  ;; most at a corner, where both cells lie on the rim.
  (INIT &cheb2 Boundary
    (key ((&closed_component2 ^E *P))
      (cell (P)
        (&closed_component2 E *P)))
    (dir ((:D E))
      (dir8_elem (:D *E))))

  (INIT &cheb_depth2 Distance
    (key ((OR ((&closed_component2 ^E *P)
               (&cheb_depth_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&closed_component2 E (:P P2)))
              ((&cheb2.boundary (:key E) P))))
      (edge ((:a P) (:b P2))
        (&closed_component2 E *P)
        (&cheb_depth_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&closed_component2 E (:P P2)))
      (source ((:n P))
        (&cheb2.boundary *P))))

  (DET &seen
    (&cheb_depth2.distance (:key *E) (:n *P) *K)
    (ex_output E P *Col))

  (DET &clash
    (&seen (:K *W))
    (> W 0)
    (&seen (:K *K1) (:Col *C1))
    (divide (:T K1) (:Side W) (:Gap 0) (:Remainder *Idx))
    (&seen (:K *K2) (:Col *C2))
    (divide (:T K2) (:Side W) (:Gap 0) (:Remainder Idx))
    (!= C1 C2))

  ;; The shortest period no pair contradicts.
  (INIT &shortest Order
    (member ((:t W))
      (&seen (:K *W))
      (> W 0)
      (NOT (&clash W)))
    (score ((:t W) (:S W))
      (&seen (:K *W))
      (> W 0)
      (NOT (&clash W))))

  (DET &cycle
    (&shortest.minimal (:t *W))
    (&seen (:K *K2) (:Col *C))
    (divide (:T K2) (:Side W) (:Gap 0) (:Remainder *K)))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N)))

  ;; The last entry, which the outline itself would take.
  (INIT &entries Order
    (member ((:t K))
      (&cycle *K))
    (score ((:t K) (:S K))
      (&cycle *K)))

  (INIT &area_box BoundingBox
    (key ((&area ^C ^Id *P))
      (cell (P)
        (&area C Id *P)))))

(OUTPUT outside-kept "every cell outside the regions keeps its input color"

  ;; One instance serves every component of a key: two components meet at
  ;; most at a corner, where both cells lie on the rim.
  (INIT &cheb Boundary
    (key ((&closed_component (:Key ^Ky) *P))
      (cell (P)
        (&closed_component (:Key Ky) *P)))
    (dir (D)
      (dir8_elem *D)))

  (INIT &cheb_depth Distance
    (key ((OR ((&closed_component (:Key ^Ky) *P)
               (&cheb_depth_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&closed_component (:Key Ky) (:P P2)))
              ((&cheb.boundary (:key Ky) P))))
      (edge ((:a P) (:b P2))
        (&closed_component (:Key Ky) *P)
        (&cheb_depth_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&closed_component (:Key Ky) (:P P2)))
      (source ((:n P))
        (&cheb.boundary *P))))

  (INIT &period Cardinality
    (member ((:m K))
      (&cycle *K))
    (domain ()))

  (RULE &ring
    (&cheb_depth.distance (:key (:Ky *C)) (:n *P) *K))

  (RULE &phase
    (&ring *K)
    (&period.size (:N *W))
    (divide (:T K) (:Side W) (:Gap 0) (:Remainder *Idx)))

  (RULE &bg_phase
    (&cycle (:K *Idx) (:C *Col))
    (&background (:C Col)))

  (RULE &hue
    (&wall *C)
    (&cycle (:K *Idx) (:C *Col)))

  (RULE &tint
    (&wall *C)
    (&ring C *P *K)
    (&phase K *Idx)
    (&hue C Idx *Col)))

(ALTS $region "which cells take the cycle" $Enclosed
  (ALT $Enclosed
    (ALTS $step "how a cell escapes to the grid edge" $SideStep
      (ALT $DiagonalLeak
        (OUTPUT ring-depth "a cell also escapes by diagonal steps, so an outline that closes only at a corner closes nothing off"
          (RULE &leak_cheb_depth_steps
            (OR ((dir_elem *D)
                 (step_offset D (:V *Delta)))
                ((dir8_elem (:D *D2))
                 (step_offset (:D D2) (:V Delta)))))
          (INIT &leak_cheb_depth Distance
            (key ((OR ((&leak_regions_component (:Key ^C) *P)
                       (&leak_cheb_depth_steps (:Delta *S))
                       (compose (:A P) (:B S) (:C *P2))
                       (&leak_regions_component (:Key C) (:P P2)))
                      ((&leak_cheb.boundary (:key C) P))))
              (edge ((:a P) (:b P2))
                (&leak_regions_component (:Key C) *P)
                (&leak_cheb_depth_steps (:Delta *S))
                (compose (:A P) (:B S) (:C *P2))
                (&leak_regions_component (:Key C) (:P P2)))
              (source ((:n P))
                (&leak_cheb.boundary *P))))
          (RULE &area
            (&leak_regions_component (:Key *C) *P *Id))
          (RULE &ring
            (&leak_cheb_depth.distance (:key *C) (:n *P) *K)))
        (ALT $ManhattanDepth
          (OUTPUT ring-depth "depth is the city-block distance to the nearest cell outside the region, less one"
            (RULE &ring
              (&manh_depth.distance (:key *C) (:n *P) *K))))))
    (ALTS $metric "the distance that sets depth" $Chebyshev
      (ALT $ManhattanDepth
        (OUTPUT ring-depth "depth is the city-block distance to the nearest cell outside the region, less one"
          (RULE &manh_depth_steps
            (dir_elem *D)
            (step_offset D (:V *Delta)))
          (INIT &manh_depth Distance
            (key ((OR ((&area ^C *P)
                       (&manh_depth_steps (:Delta *S2))
                       (compose (:A P) (:B S2) (:C *P2))
                       (&area C (:P P2)))
                      ((&manh.boundary (:key C) P))))
              (edge ((:a P) (:b P2))
                (&area C *P)
                (&manh_depth_steps (:Delta *S2))
                (compose (:A P) (:B S2) (:C *P2))
                (&area C (:P P2)))
              (source ((:n P))
                (&manh.boundary *P))))
          (RULE &ring
            (&manh_depth.distance (:key *C) (:n *P) *K))))))
  (ALT $BboxRegion
    (OUTPUT ring-depth "the region is the inside of the bounding box of all &frame_color cells, and depth is a cell's distance to the nearest side of that inside")
    (OUTPUT outside-kept "the box's own border takes &frame_color"
      (RULE &box_depth_depth_node
        (&frame_box.box (:key (:C *Key)) *B)
        (input *P)
        (ALL ((&frame_box.box (:key (:C *Cm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((> K_m3 0))))

      (RULE &box_depth_depth_steps
        (OR ((dir_elem *D)
             (step_offset D (:V *Delta)))
            ((dir8_elem (:D *D2))
             (step_offset (:D D2) (:V Delta)))))

      (INIT &box_depth_depth Distance
        (key ((OR ((&box_depth_depth_node (:Key ^Ky) *P)
                   (&box_depth_depth_steps (:Delta *S))
                   (compose (:A P) (:B S) (:C *Q))
                   (&box_depth_depth_node (:Key Ky) (:P Q)))
                  ((&box_depth.boundary (:key (:C Ky)) P))))
          (edge ((:a P) (:b Q))
            (&box_depth_depth_node (:Key Ky) *P)
            (&box_depth_depth_steps (:Delta *S))
            (compose (:A P) (:B S) (:C *Q))
            (&box_depth_depth_node (:Key Ky) (:P Q)))
          (source ((:n P))
            (&box_depth.boundary (:key (:C Ky)) *P))))

      (RULE &ring
        (&box_depth_depth.distance (:key (:Ky *C)) (:n *P) *K)))
    (RULE &paint
      (OR ((&wall (:C *Col))
           (&frame_box.box (:key (:C Col)) (:B *B_box))
           (input *P)
           (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                 (dir_elem (:D *D_m1m))
                 (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                 (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                ((>= K_m3m 0)))
           (dir_elem (:D *D_m1))
           (relative (:Base B_box) (:X P) (:X_rel *R_m2))
           (margin (:B R_m2) (:D D_m1) (:K *K_m3))
           (<= K_m3 0))
          ((&tint *C P Col))))
    (ALT $FrameAnyColor
      (OUTPUT ring-depth "every color other than the background is tried as an outline; under BboxRegion the box bounds all cells of other colors than the background, and is undefined when they hold two colors"
        (RULE &wall
          (&ink.value (:v *C)))

        (RULE &void
          (&ink.plural))))
    (ALT $CenterDot
      (OUTPUT cycle-color "the center cell of a region whose bounding box has an odd number of rows and of columns takes the outline's color, whatever its depth"
        (RULE &dot
          (&frame_box.box (:key *C) *B)
          (input *P)
          (ALL ((&frame_box.box (:key (:C *Cm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (relative (:Base B) (:X P) (:X_rel *P_rel))
          (ALL ((&frame_box.box (:key (:C *Cmm)) (:B *Bm))
                (input (:P *Pm))
                (relative (:Base Bm) (:X Pm) (:X_rel P_rel))
                (opposite (:D *D_m1m) (:Opp *O_m2))
                (margin (:B P_rel) (:D D_m1m) (:K *K1_m3))
                (margin (:B P_rel) (:D O_m2) (:K *K2_m4)))
               ((= K1_m3 K2_m4)))))
      (RULE &paint
        (OR ((&wall (:C *Col))
             (&frame_box.box (:key (:C Col)) (:B *B_box))
             (input *P)
             (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                   (dir_elem (:D *D_m1m))
                   (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                   (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                  ((>= K_m3m 0)))
             (dir_elem (:D *D_m1))
             (relative (:Base B_box) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3))
             (<= K_m3 0))
            ((&wall (:C Col))
             (&dot (:C Col) P))
            ((&tint *C P Col)
             (NOT (&dot C P))))))
    (ALT $GapKept
      (RULE &paint
        (OR ((&wall (:C *Col))
             (&frame_box.box (:key (:C Col)) (:B *B_box))
             (input *P)
             (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                   (dir_elem (:D *D_m1m))
                   (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                   (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                  ((>= K_m3m 0)))
             (dir_elem (:D *D_m1))
             (relative (:Base B_box) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3))
             (<= K_m3 0))
            ((&tint *C P *Idx Col)
             (NOT (&bg_phase Idx)))))
      (ALT $CenterDot
        (RULE &paint
          (OR ((&wall (:C *Col))
               (&frame_box.box (:key (:C Col)) (:B *B_box))
               (input *P)
               (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                     (dir_elem (:D *D_m1m))
                     (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                     (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                    ((>= K_m3m 0)))
               (dir_elem (:D *D_m1))
               (relative (:Base B_box) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3))
               (<= K_m3 0))
              ((&tint *C P *Idx Col)
               (NOT (&bg_phase Idx))
               (NOT (&dot C P)))
              ((&wall (:C Col))
               (&dot (:C Col) P))))))
    (ALT $InteriorKept
      (RULE &paint
        (OR ((&wall (:C *Col))
             (&frame_box.box (:key (:C Col)) (:B *B_box))
             (input *P)
             (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                   (dir_elem (:D *D_m1m))
                   (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                   (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                  ((>= K_m3m 0)))
             (dir_elem (:D *D_m1))
             (relative (:Base B_box) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3))
             (<= K_m3 0))
            ((&tint *C P Col)
             (input P (:Col *Col_in))
             (&bg_color (:C Col_in)))))
      (ALT $CenterDot
        (RULE &paint
          (OR ((&wall (:C *Col))
               (&frame_box.box (:key (:C Col)) (:B *B_box))
               (input *P)
               (ALL ((&frame_box.box (:key (:C *Cm)) (:B B_box))
                     (dir_elem (:D *D_m1m))
                     (relative (:Base B_box) (:X P) (:X_rel *R_m2m))
                     (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                    ((>= K_m3m 0)))
               (dir_elem (:D *D_m1))
               (relative (:Base B_box) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3))
               (<= K_m3 0))
              ((&tint *C P Col)
               (input P (:Col *Col_in))
               (&bg_color (:C Col_in))
               (NOT (&dot C P)))
              ((&wall (:C Col))
               (&dot (:C Col) P))))))))

(ALTS $frame "which color draws the outline" $StoredFrame
  (ALT $FrameAnyColor
    (OUTPUT ring-depth "every color other than the background is tried as an outline; under BboxRegion the box bounds all cells of other colors than the background, and is undefined when they hold two colors"
      (RULE &outline_phase
        (&cycle (:K *Idx) (:C *Col))
        (&frame_color (:C Col)))

      (RULE &wall
        (&ink_color *C))

      (RULE &hue
        (&wall *C)
        (&cycle (:K *Idx) (:C *Col0))
        (OR ((&outline_phase Idx)
             (= *Col C))
            ((NOT (&outline_phase Idx))
             (= Col Col0)))))
    (OUTPUT cycle-color "the cycle entries of &frame_color take the color of the region's outline")
    (ALTS $ring2 "the color at the cycle entries that repeat the outline, under FrameAnyColor" $OutlineRing2
      (ALT $InnerFrameStored
        (OUTPUT cycle-color "only the last cycle entry takes the outline's color, and every other entry keeps its stored color"
          (RULE &outline_phase
            (&entries.dual_rank (:t *Idx) (:R 0))))))))

(ALTS $write "which region cells the cycle writes" $WriteAll
  (ALT $GapKept
    (OUTPUT cycle-color "a cell at the entry of &background keeps its input color")
    (RULE &paint
      (&tint *C *P *Idx *Col)
      (NOT (&bg_phase Idx)))
    (ALT $CenterDot
      (RULE &paint
        (OR ((&tint *C *P *Idx *Col)
             (NOT (&bg_phase Idx))
             (NOT (&dot C P)))
            ((&wall (:C Col))
             (&dot (:C Col) P))))))
  (ALT $InteriorKept
    (OUTPUT cycle-color "only cells of the background color are written, and every other cell keeps its input color")
    (RULE &paint
      (&tint *C *P *Col)
      (input P (:Col *Col_in))
      (&bg_color (:C Col_in)))
    (ALT $CenterDot
      (RULE &paint
        (OR ((&tint *C *P *Col)
             (input P (:Col *Col_in))
             (&bg_color (:C Col_in))
             (NOT (&dot C P)))
            ((&wall (:C Col))
             (&dot (:C Col) P)))))))

(ALTS $bg "the background color" $StoredBackground
  (ALT $DerivedBackground
    (OUTPUT cycle-color "the background is the input's commonest color, and it replaces &background at that color's cycle entry"
      (RULE &bg_color
        (&commonest.maximal (:t *C)))

      (RULE &swap
        (&bg_phase *Idx)
        (&bg_color (:C *Col)))

      (RULE &hue
        (&wall *C)
        (&cycle (:K *Idx) (:C *Col0))
        (OR ((&swap Idx *Col))
            ((NOT (&swap Idx))
             (= Col Col0)))))))

(ALTS $center "the color of a region's center cell" $RingCenter
  (ALT $CenterDot
    (OUTPUT cycle-color "the center cell of a region whose bounding box has an odd number of rows and of columns takes the outline's color, whatever its depth"
      (RULE &dot
        (&area_box.box (:key *C *Id) *B)
        (&area C Id *P)
        (ALL ((&area (:C *Cm) (:Id *Idm) P)
              (&area_box.box (:key (:C Cm) (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base B) (:X P) (:X_rel *P_rel))
        (ALL ((&area_box.box (:key (:C *Cmm) (:Id *Idmm)) (:B *Bm))
              (&area (:C Cmm) (:Id Idmm) (:P *Pm))
              (relative (:Base Bm) (:X Pm) (:X_rel P_rel))
              (opposite (:D *D_m1m) (:Opp *O_m2))
              (margin (:B P_rel) (:D D_m1m) (:K *K1_m3))
              (margin (:B P_rel) (:D O_m2) (:K *K2_m4)))
             ((= K1_m3 K2_m4)))))
    (RULE &paint
      (OR ((&wall (:C *Col))
           (&dot (:C Col) *P))
          ((&tint *C P Col)
           (NOT (&dot C P)))))))

(RULE &paint
  (&tint *C *P *Col))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
