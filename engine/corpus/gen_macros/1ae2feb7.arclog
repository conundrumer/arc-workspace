;; 1ae2feb7

;; Runs and the pattern they claim extend along this axis; the separator is one line across it.
(DET &axis AxisDomain)

(RULE &cell_split_split1
  (input (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *P_line_)))

(RULE &cell_split
  (input *P)
  (&axis *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:P_line_ *P_line)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &sep_count Cardinality
  (key ((&ink *P)
        (&cell_split P ^P_along))
    (member ((:m P))
      (&ink *P)
      (&cell_split P P_along))))

;; The separator is the fullest line across the run axis.
(INIT &sep Order
  (member ((:t P_along))
    (&sep_count.size (:key *P_along)))
  (score ((:t P_along) (:S N))
    (&sep_count.size (:key *P_along) *N)))

(RULE &cut_divider
  (&sep.maximal (:t *L))
  (&axis *A))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The two sides the separator cuts.
(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D *K)
  (&cut_rank.rank (:key D) (:t K) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &runs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &side
  (&axis *A)
  (axis_of *D A)
  (&cut_part_idx *P D (:N 0)))

(RULE &ink_dir
  (&side *P *D)
  (&ink P))

(INIT &runs Quotient
  (edge ((:a P_line Col P) (:b P_line Col (:P P3)))
    (OR ((&ink *P *Col)
         (&cell_split P *P_line)
         (&ink_dir *D)
         (&side P D)
         (&runs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3) Col)
         (&cell_split (:P P3) P_line)
         (&ink_dir (:D *D2))
         (&side (:P P3) (:D D2)))
        ((&ink P Col)
         (&cell_split P P_line)
         (&ink_dir (:D *D3))
         (&side P (:D D3))
         (= P3 P)))))

(RULE &runs_component
  (&runs.class (:a *P_line *Col *P) *Id))

(RULE &canvas_dir
  (&ink_dir (:D *D_ink))
  (opposite (:D D_ink) (:Opp *D)))

(RULE &canvas
  (&canvas_dir *D)
  (&side *P D))

(RULE &run
  (&runs_component *P_line *Col *Id))

;; A run's box: its margin toward the canvas measures how far it sits from
;; the separator.
(INIT &run_box BoundingBox
  (key ((&runs_component *P ^Id))
    (cell (P)
      (&runs_component *P Id))))

;; The canvas's box, so offset 0 in its frame sits against the separator.
(INIT &canvas_box BoundingBox
  (cell (P)
    (&canvas *P)))

(RULE &canvas_off
  (&canvas *P)
  (&canvas_box.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&cell_split P *P_line)
  (&ink_dir *D)
  (margin (:B P_inner) D (:K *Off)))

(RULE &claim
  (&canvas_off *P *P_line *Off)
  (&run *Id P_line)
  (&axis *A)
  (&run_box.box (:key Id) *B)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *W))
  (divide (:T Off) (:Side W) (:Gap 0) (:Remainder 0)))

;; Where several runs claim one cell, the one nearest the separator wins.
(INIT &won Order
  (key ((&claim ^P *Id)
        (&canvas_dir *D)
        (&run_box.box (:key Id) *B)
        (margin B D *K))
    (member ((:t (:V Id) (:S K)))
      (&claim P *Id)
      (&canvas_dir *D)
      (&run_box.box (:key Id) *B)
      (margin B D *K))
    (score ((:t (:V Id) (:S K)) (:S K))
      (&claim P *Id)
      (&canvas_dir *D)
      (&run_box.box (:key Id) *B)
      (margin B D *K))))

(RULE &painted
  (&won.minimal (:key *P) (:t (:V *Id)))
  (&run Id *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&painted P *Col))
      ((NOT (&canvas P))
       (= Col Col_in))
      ((&canvas P)
       (NOT (&painted P))
       (&bg (:C Col)))))
