;; 1caeab9d

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &hue Quotient
  (equivalent ((:a P) (:b Q))
    (&ink *P *Col)
    (&ink (:P *Q) Col)))

(RULE &group
  (&hue.class (:a *P) *Id))

;; The color of the block the others come to.
(DET &anchor UnchangedColor)

;; The edge whose line the blocks share once moved. Every block in this task is the same shape, so the opposite edge fits the pairs as well.
(DET &align_dir DirDomain)

(ALTS $choice "what a block is" $ByColor
  (ALT $ByObject
    (RULE &piece_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (INIT &piece Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&piece_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &piece_component
      (&piece.class (:a *P) *Id))

    (RULE &group
      (&piece_component *P *Id))))

(INIT &bbox BoundingBox
  (key ((&group *P ^Id))
    (cell (P)
      (&group *P Id))))

(RULE &front_split1
  (&bbox.cell (:key (:Id *Ky)) (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m2_)))

(RULE &front
  (&align_dir *D)
  (&bbox.cell (:key (:Id *Ky)) *P)
  (&bbox.box (:key (:Id Ky)) *B)
  (ALL ((&bbox.cell (:key (:Id *Kym)) P)
        (&bbox.box (:key (:Id Kym)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) D (:K *K_m1))
  (margin B D (:K K_m1))
  (axis_of D *A)
  (&front_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m2_ *X_m2)))

(RULE &slide
  (&front *Ky *L)
  (&group *P (:Id *Id_a))
  (input P *Col)
  (&anchor (:C Col))
  (&front (:Ky Id_a) (:L *L_a))
  (relative (:Base L) (:X L_a) (:X_rel *Delta)))

(RULE &moved
  (&group (:P *P2) *Id)
  (input (:P P2) *Col)
  (&slide (:Ky Id) *Delta)
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &output
  (OR ((&moved *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&moved P)))))
