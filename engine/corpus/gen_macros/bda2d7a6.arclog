;; bda2d7a6

(INPUT nested-rings "the grid is square, and every cell's color depends only on its ring, the cells at one distance from the nearest frame edge; each ring is 1 cell wide")

(INPUT color-cycle "read from the outermost ring inward, the first 3 rings show 3 distinct colors, one new color each, and every ring after them repeats a color already seen")

(OUTPUT cycle-colors "list the distinct colors in the order they first appear from the outermost ring inward; every cell of a color takes the color just before it in that list, and the first color takes the last"

  (RULE &peel_depth_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The grid peels into rings, one per depth.
  (INIT &peel Boundary
    (cell (P)
      (input *P)))

  (INIT &peel_depth Distance
    (edge ((:a P) (:b P2))
      (input *P)
      (&peel_depth_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (input (:P P2)))
    (source ((:n P))
      (&peel.boundary *P)))

  ;; The corner a scan starts from, and the axis it runs along first.
  ;; TODO no-det-plan: &scan: the plan gives no verdict
  (DET &scan (ONE))

  (RULE &ring_color
    (&peel_depth.distance (:n *P) (:K *I))
    (input P *Col))

  ;; The depth of each color's outermost ring: where it first appears.
  (INIT &appear Order
    (key ((&ring_color *I ^Col))
      (member ((:t I))
        (&ring_color *I Col))
      (score ((:t I) (:S I))
        (&ring_color *I Col))))

  (INIT &order Order
    (member ((:t Col))
      (input *Col))
    (before ((:a A) (:b B))
      (&appear.minimal (:key (:Col *A)) (:t *I))
      (&appear.minimal (:key (:Col *B)) (:t *I2))
      (< I I2)))

  (INIT &size Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &scan2 Order
    (member ((:t P))
      (&scan *D *A)
      (input *P))
    (before ((:a P) (:b P2))
      (&scan *D *A)
      (input *P)
      (input (:P *P2))
      (OR ((corner_dir (:C D) A (:D *D2))
           (dir_elem (:D D2))
           (margin (:B P) (:D D2) (:K *K1_m1))
           (margin (:B P2) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C D) A (:D D2))
           (perp A (:A2 *A2_m3))
           (corner_dir (:C D) (:A A2_m3) (:D *D22))
           (margin (:B P) (:D D2) (:K *K_m4))
           (margin (:B P2) (:D D2) (:K K_m4))
           (dir_elem (:D D22))
           (margin (:B P) (:D D22) (:K *K1_m5))
           (margin (:B P2) (:D D22) (:K *K2_m6))
           (< K1_m5 K2_m6)))))

  ;; The place in each scan of each color's first cell.
  (INIT &scan_first Order
    (key ((input *P ^Col)
          (&scan2.rank (:t P) *R))
      (member ((:t R))
        (input *P Col)
        (&scan2.rank (:t P) *R))
      (score ((:t R) (:S R))
        (input *P Col)
        (&scan2.rank (:t P) *R))))

  (RULE &outer_ring
    (&peel_depth.distance (:n *P) (:K *I))
    (step_offset (:D *D_m1) (:V *V_m2))
    (compose (:A P) (:B V_m2) (:C *Q))
    (&peel_depth.distance (:n Q) (:K *I2))
    (< I2 I))

  ;; The depth at which the last color first appears.
  (INIT &newest Order
    (member ((:t I))
      (&appear.minimal (:t *I)))
    (score ((:t I) (:S I))
      (&appear.minimal (:t *I))))

  ;; The colors other than the outermost ring's.
  (INIT &others Cardinality
    (member ((:m Col))
      (input *Col)
      (NOT (&ring_color (:I 0) Col)))
    (domain ()))

  (RULE_OR_DET &others.size "The colors other than the outermost ring's."))

(ALTS $choice "what the output takes from the input" $Recolor
  (ALT $Recolor
    (ALTS $pred "which color each color takes" $ListCycle
      (ALT $ListCycle
        (ALTS $order "the order that lists the colors" $FirstSeen
          (ALT $CountOrder
            (OUTPUT cycle-colors "the colors are listed by their cell count, the highest first; undefined where two colors have the same count"
              (INIT &order Order
                (member ((:t Col))
                  (input *Col))
                (before ((:a A) (:b B))
                  (&size.size (:key (:Col *A)) *N)
                  (&size.size (:key (:Col *B)) (:N *N2))
                  (> N N2)))))
          (ALT $ScanOrder
            (OUTPUT cycle-colors "the colors are listed in the order their first cells come in a scan from the corner and along the axis first that &scan gives"
              (INIT &order Order
                (member ((:t Col))
                  (&scan_first.minimal (:key *Col)))
                (before ((:a A) (:b B))
                  (&scan_first.minimal (:key (:Col *A)) (:t *R))
                  (&scan_first.minimal (:key (:Col *B)) (:t *R2))
                  (< R R2)))))))
      (ALT $EnclosingColor
        (OUTPUT cycle-colors "each color takes the color of the ring just outside its outermost ring, and the outermost ring's color takes the last color to appear; undefined where that ring holds two colors")
        (RULE &output
          (input *P (:Col *C))
          (&appear.minimal (:key (:Col C)) (:t *I))
          (OR ((&outer_ring I *I2)
               (&ring_color (:I I2) *Col))
              ((= I 0)
               (&newest.maximal (:t I2))
               (&appear.minimal (:key Col) (:t I2))))))))
  (ALT $RingShift
    (OUTPUT cycle-colors "each ring takes the color of the ring just outside it, and the outermost ring takes the color of the ring with as many rings outside it as the input has colors other than the outermost ring's")
    (RULE &output
      (&peel_depth.distance (:n *P) (:K *I))
      (OR ((&outer_ring I *I2)
           (&ring_color (:I I2) *Col))
          ((= I 0)
           (&others.size (:N I2))
           (&ring_color (:I I2) Col))))))

;; A color takes the color just before it, and the first color the last.
(RULE &output
  (input *P (:Col *C))
  (OR ((&order.successor (:a *Col) (:b C)))
      ((&order.minimal (:t C))
       (&order.maximal (:t Col)))))
