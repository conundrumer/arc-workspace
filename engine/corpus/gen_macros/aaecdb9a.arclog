;; aaecdb9a

(INPUT pieces "on a field of &background lie pieces of the colors of &column_order. A piece is a set of same-colored cells joined by 8-adjacency."

  (DET &column_order_split1
    (ex_output (:P *P_) *Col)
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X P_) (:X_rel *Q_)))

  (DET_OR_RULE &background DominantColor)

  (RULE &objects_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  ;; the edge the bars rise from
  (DET &base DirDomain)

  (DET &column_order
    (ex_output (:P *P2) *Col)
    (NOT (&background (:C Col)))
    (&base *D)
    (axis_of D *A)
    (&column_order_split1 (:P_ P2) (:A_ A) (:X_m1_ *X_m1) (:Q_ *P)))

  (INIT &objects Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&background (:C Col)))
           (&objects_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&background (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&background (:C Col3)))
           (= P3 P))))))

(OUTPUT count "each color of &column_order counts its pieces")

(OUTPUT frame "the output has one column per cell of &column_order. Its extent away from &base is the largest count."

  (RULE &same_color_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &same_color_node
    (input *P (:Col *Key))
    (NOT (&background (:C Key))))

  (INIT &same_color Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&same_color_node (:Key *Ky) *P)
           (&same_color_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&same_color_node (:Key Ky) (:P P2)))
          ((&same_color_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &same_color_component
    (&same_color.class (:a *Key *P) *Id))

  ;; The color counts, under each reading of a piece.
  (INIT &pieces Cardinality
    (key ((&same_color_component (:Key ^Col) *Id))
      (member ((:m Id))
        (&same_color_component (:Key Col) *Id))))

  ;; The counts whose largest is the frame's height.
  (INIT &height Order
    (member ((:t N))
      (&pieces.size (:key *Col) *N)
      (&column_order Col))
    (score ((:t N) (:S N))
      (&pieces.size (:key *Col) *N)
      (&column_order Col))))

(OUTPUT bars "each color's column holds a bar of that color. The bar rises from &base, and its length is that color's count. A color with no piece gives an empty column.")

(OUTPUT fill "every cell that no bar covers is &background")

(ALTS $height "which counts set the frame's height" $OrderedHeight
  (ALT $HeightAllColors
    (OUTPUT frame "the output has one column per cell of &column_order. Its extent away from &base is the largest count over every color other than &background, a color with no column included. Undefined on an input with no piece."
      ;; The counts whose largest is the frame's height.
      (INIT &height Order
        (member ((:t N))
          (&pieces.size *N))
        (score ((:t N) (:S N))
          (&pieces.size *N))))))

(ALTS $piece "what joins cells into one counted piece" $ColorPieces
  (ALT $ObjectPieces
    (INPUT pieces "on a field of &background lie pieces. A piece is a set of cells of any other color, joined by 8-adjacency.")
    (OUTPUT count "each color of &column_order counts the pieces that hold it. Undefined on an input with no piece."
      (RULE &objects_component
        (&objects.class (:a *P) *Id))

      ;; The color counts, under each reading of a piece.
      (INIT &pieces Cardinality
        (key ((&objects_component *P *Id)
              (input P ^Col))
          (member ((:m Id))
            (&objects_component *P *Id)
            (input P Col)))))))

(INIT &frame Frame
  (extent ((:A A_frame) N)
    (&height.maximal (:t *H))
    (&base *D)
    (axis_of D *A)
    (OR ((perp A (:A2 *A_frame))
         (&column_order (:P *Q))
         (frame_extent (:P Q) (:A A_frame) *N))
        ((= A_frame A)
         (= N H)))))

(RULE &bar_split1
  (&frame.cell (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Q_)))

(RULE &bar
  (&frame.cell *P)
  (&base *D)
  (axis_of D *A)
  (&bar_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Q_ *Q))
  (&column_order (:P Q) *Col)
  (margin (:B P) D (:K *J))
  (&pieces.size (:key Col) *N)
  (< J N))

(RULE &output
  (&frame.cell *P)
  (OR ((&bar P *Col))
      ((NOT (&bar P))
       (&background (:C Col)))))
