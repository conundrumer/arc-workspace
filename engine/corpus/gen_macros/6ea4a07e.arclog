;; 6ea4a07e

(DET &bg SharedColor)

(DET &recolor VanishedNewPairs)

(RULE &fill
  (input *Col)
  (&recolor (:C_from Col) (:C_to *C)))

(RULE &output
  (OR ((input *P (:Col *Col2))
       (&bg (:C Col2))
       (&fill (:C *Col)))
      ((input P (:Col *Col22))
       (NOT (&bg (:C Col22)))
       (&bg (:C Col)))))
