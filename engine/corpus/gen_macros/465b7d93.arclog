;; 465b7d93

(DET &bg DominantColor)

(DET &frame UnchangedColor)

(RULE &frame_cell
  (input *P *Col)
  (&frame (:C Col)))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&frame (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&frame_cell *P)))

;; The field the frame encloses. The frame's ring is closed, so the field's rim
;; toward d is the interior line against the frame's d side.
(INIT &field Boundary
  (cell (P)
    (&bbox.box *B)
    (input *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&frame_cell P))))

(RULE &corner
  (&mark *P)
  (diag_opposite *D *Opp)
  (corner_dir (:C Opp) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Opp) (:A A2_m2) (:D *D2))
  (step_offset (:D D1) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q1))
  (&mark (:P Q1))
  (step_offset (:D D2) (:V *V_m4))
  (compose (:A P) (:B V_m4) (:C *Q2))
  (&mark (:P Q2)))

(RULE &paint
  (&corner (:D *Diag))
  (corner_dir (:C Diag) *D)
  (&field.exposed *P D))

(ALTS $choice "which sides get the rim" $Corner
  (ALT $Stretch
    (INIT &shape_box BoundingBox
      (cell (P)
        (&mark *P)))

    (RULE &edge_hole
      (&shape_box.box *B)
      (input *P)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) *D (:K *K_m1))
      (margin B D (:K K_m1))
      (NOT (&mark P)))

    (RULE &paint
      (&field.exposed *P *D)
      (NOT (&edge_hole D)))))

(RULE &output
  (OR ((&paint *P)
       (&mark *Col))
      ((input P (:Col *Col_in))
       (NOT (&paint P))
       (OR ((&mark P)
            (&bg (:C Col)))
           ((NOT (&mark P))
            (= Col Col_in))))))
