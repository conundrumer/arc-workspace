;; 99fa7670

(DET &dir DirDomain)

(RULE &legs_dir
  (&dir *D))

(DET &bg DominantColor)

(RULE &legs_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &legs_node
  (input *P)
  (NOT (&legs_blocked P)))

(RULE &legs_source
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Line fill: each dot casts its color toward &dir through bg; the next
;; dot occludes.
(INIT &legs Distance
  (key ((&legs_source (:P ^O))
        (&legs_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&legs_source (:P O))
           (&legs_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&legs_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&legs_node (:P Q)))
          ((&legs_source (:P O))
           (&legs_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&legs_node (:P Q))
           (= A2 O))
          ((&legs_source (:P O))
           (&legs_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&legs_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&legs_node (:P Q)))))
    (source ((:n O))
      (&legs_source (:P O))
      (&legs_dir D))))

(RULE &legs_ray
  (&legs.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &legs_end
  (&legs_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&legs_ray (:P Q) D Origin)))

(DET &sense SenseDomain)

(RULE &bends_dir
  (&dir (:D *D3))
  (&sense *S)
  (turn S (:D D3) (:D2 *D)))

(RULE &leg
  (&legs_ray *P (:Origin *Src))
  (input (:P Src) *Col))

(RULE &bends_blocked
  (&leg *P))

(RULE &bends_node
  (input *P)
  (NOT (&bends_blocked P)))

(RULE &bends_source
  (&leg *P)
  (&dir *D)
  (margin (:B P) D (:K 0)))

;; At the &dir edge the fill bends and runs along the edge; legs occlude.
(INIT &bends Distance
  (key ((&bends_source (:P ^O))
        (&bends_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&bends_source (:P O))
           (&bends_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&bends_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&bends_node (:P Q)))
          ((&bends_source (:P O))
           (&bends_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&bends_node (:P Q))
           (= A2 O))
          ((&bends_source (:P O))
           (&bends_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&bends_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&bends_node (:P Q)))))
    (source ((:n O))
      (&bends_source (:P O))
      (&bends_dir D))))

(RULE &bends_ray
  (&bends.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &bends_end
  (&bends_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&bends_ray (:P Q) D Origin)))

(RULE &bend
  (&bends_ray *P (:Origin *Src))
  (&leg (:P Src) *Col))

(RULE &output
  (OR ((&leg *P *Col))
      ((&bend P Col))
      ((input P Col)
       (NOT (&leg P))
       (NOT (&bend P)))))
