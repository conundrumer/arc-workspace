;; 817e6c09

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &ink RarestColor)

(INIT &blocks Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&ink (:C Col))
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&ink (:C Col2)))
        ((input P (:Col *Col3))
         (&ink (:C Col3))
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *P) *Id))

(DET &anchor DirDomain)

(DET &mark AnyOutNewColor)

;; alternation rhythm: run of marked, run of kept
(DET &mark_run DivisorRatio)

(DET &keep_run DivisorRatio)

(INIT &bbox BoundingBox
  (key ((&blocks_component *P ^Id))
    (cell (P)
      (&blocks_component *P Id))))

(RULE &block_dist
  (&anchor *D)
  (&bbox.box (:key *Id) *B)
  (margin B D *K))

(INIT &seq Order
  (member ((:t K))
    (&block_dist *K))
  (score ((:t K) (:S K))
    (&block_dist *K)))

(RULE &marked
  (&blocks_component *P *Id)
  (&block_dist Id *K)
  (&seq.rank (:t K) *R)
  (&mark_run (:K *Kr))
  (&keep_run (:K *G))
  (divide (:T R) (:Side Kr) (:Gap G)))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&marked P)))))
