;; 4612dd53

(RULE &line_cell_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(DET &min_marks TileCount)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&mark *P)))

(RULE &line_cell
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (axis_elem *A)
  (&line_cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L)))

(RULE &line_mark
  (&line_cell *A *L *P)
  (&mark P))

(RULE &line_gap
  (&line_cell *A *L *P)
  (NOT (&mark P)))

(INIT &marks Cardinality
  (key ((&line_mark ^A ^L *P))
    (member ((:m P))
      (&line_mark A L *P))))

(RULE &line
  (&marks.size (:key *A *L) *N)
  (&min_marks (:N *K))
  (>= N K))

(ALTS $choice "what makes a row or column a line" $Threshold
  (ALT $Majority
    (INIT &lead Excess
      (key ((OR ((&line_mark ^A ^L *P))
                ((&line_gap A L P))))
        (plus ((:m P))
          (&line_mark A L *P))
        (minus ((:m P))
          (&line_gap A L *P))))

    (RULE &line
      (&lead.excess (:key *A *L))))
  (ALT $Segment
    (RULE &line
      (&line_mark *A *L *P)
      (&line_mark A L (:P *Q))
      (axis_of *D A)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C Q)))))

(RULE &repaired
  (&line *A *L)
  (&line_gap A L *P))

(RULE &output
  (OR ((&repaired *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&repaired P)))))
