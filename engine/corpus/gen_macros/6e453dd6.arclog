;; 6e453dd6

(DET &sep RarestColor)

(RULE &sep_cell
  (input *P *Col)
  (&sep (:C Col)))

(DET &slide_dir DirDomain)

(RULE &slide_axis
  (&slide_dir *D)
  (axis_of D *A))

(RULE &cut_divider_split1
  (&sep_cell (:P *P_))
  (&slide_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &cut_divider
  (&sep_cell *P)
  (&slide_axis *A)
  (&cut_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The two sides the separator cuts.
(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D *K)
  (&cut_rank.rank (:key D) (:t K) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET &bg DominantColor)

(DET &shape SharedColor)

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&shape (:C Col))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&shape (:C Col2)))
        ((input P (:Col *Col3))
         (&shape (:C Col3))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(RULE &slide_dir2
  (&comps_component (:Id *Key))
  (&slide_dir *D))

;; Each shape slides on its own until it touches the separator.
(INIT &slide Distance
  (key ((OR ((&comps_component *P ^Id)
             (&slide_dir2 (:Key Id) *D)
             (margin (:B P) D *K))
            ((&comps_component P Id)
             (&slide_dir2 (:Key Id) D)
             (&comps_component Id)
             (&sep_cell (:P *P2))
             (gap D P (:Q P2) K))))
    (source_distance (K)
      (OR ((&comps_component *P Id)
           (&slide_dir2 (:Key Id) *D)
           (margin (:B P) D *K))
          ((&comps_component (:P *P3) Id)
           (&slide_dir2 (:Key Id) (:D *D2))
           (&comps_component Id)
           (&sep_cell (:P *P2))
           (gap (:D D2) (:P P3) (:Q P2) K))))))

(RULE &slid
  (&comps_component (:P *P3) *Id)
  (&slide.distance (:key Id) *K)
  (&slide_dir2 (:Key Id) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &canvas
  (input *P)
  (OR ((&sep_cell P)
       (&sep (:C *Col)))
      ((&slid P)
       (&shape (:C Col)))
      ((NOT (&sep_cell P))
       (NOT (&slid P))
       (&bg (:C Col)))))

(RULE &canvas_bg
  (&canvas *P *Col)
  (&bg (:C Col)))

(RULE &flank_dir
  (&slide_axis *A)
  (axis4_of *D A))

(RULE &flank_node
  (input *P))

(RULE &flank_source
  (&slid *P))

(INIT &flank Distance
  (key ((&flank_source (:P ^O))
        (&flank_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&flank_source (:P O))
           (&flank_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&flank_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&flank_node (:P Q)))
          ((&flank_source (:P O))
           (&flank_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&flank_node (:P Q))
           (= A2 O))
          ((&flank_source (:P O))
           (&flank_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&flank_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&flank_node (:P Q)))))
    (source ((:n O))
      (&flank_source (:P O))
      (&flank_dir D))))

(RULE &flank_ray
  (&flank.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &flank_between
  (&canvas_bg *P)
  (&slide_axis *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&flank_ray P D)
  (&flank_ray P (:D O)))

(RULE &flank_end
  (&flank_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&flank_ray (:P Q) D Origin)))

(RULE &cast_dir
  (&slide_dir *D))

(RULE &cast_dir_ray
  (&cast_dir *D))

(RULE &cast_blocked
  (input *P)
  (NOT (&slid P)))

(RULE &cast_node
  (&cast_dir)
  (input *P)
  (NOT (&cast_blocked P)))

(RULE &gap
  (&flank_between *P))

(DET &mark AnyOutNewColor)

(ALTS $choice "what a gap is" $Between
  (ALT $Enclosed
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (input *P)
      (NOT (&slid P)))

    (INIT &closed_flood Propagation
      (source ((:n P))
        (&closed_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P)
        (NOT (&slid P)))
      (edge ((:a P) (:b P2))
        (input *P)
        (NOT (&slid P))
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2))
        (NOT (&slid (:P P2)))))

    (RULE &closed_node
      (&closed_cell *P)
      (NOT (&closed_flood.reached (:n P))))

    ;; The regions the shapes close off from the grid edge.
    (INIT &closed Quotient
      (edge ((:a P) (:b P2))
        (OR ((&closed_node *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:P P2)))
            ((&closed_node P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *P) *Id))

    (RULE &gap
      (&closed_component *P)
      (&canvas_bg P))))

(RULE &cast_source
  (&gap *P))

;; A gap casts toward the separator; the cast stops at the first cell that is
;; not shape.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir_ray D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &fill
  (&cast_end (:P *E) (:D *D_2))
  (step_offset (:D D_2) (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *S))
  (input (:P S))
  (&sep_cell (:P S))
  (&slide_axis *A)
  (perp A (:A2 *A2_m2))
  (axis_of (:D *D_m3) (:A A2_m2))
  (margin (:B S) (:D D_m3) (:K *K_m4))
  (&slide_dir *D)
  (&cut_part_idx *P D (:N 0))
  (margin (:B P) (:D D_m3) (:K K_m4)))

(RULE &output
  (OR ((&fill *P)
       (&mark (:C *Col)))
      ((&canvas P Col)
       (NOT (&fill P)))))
