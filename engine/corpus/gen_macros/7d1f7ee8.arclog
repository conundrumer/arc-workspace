;; 7d1f7ee8

(DET &bg DominantColor)

(RULE &ink
  (input *Col)
  (NOT (&bg (:C Col))))

(INIT &drect Outlines
  (key ((&ink ^Col))
    (node (P)
      (input *P Col))))

(RULE &nested_rect_inside1
  (&drect.box (:B *B_))
  (&drect.box (:B *B_outer_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_outer_) (:X B_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &enclosed
  (&ink (:Col *C))
  (input *P (:Col C))
  (&drect.box (:key *Col) *B)
  (ALL ((&drect.box (:B *B_outer))
        (!= B B_outer))
       ((&nested_rect_inside1 (:B_ B) (:B_outer_ B_outer))))
  (ALL ((input P (:Col *Cm))
        (&drect.box (:key (:Col *Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(ALTS $choice "what counts as an outline, and which outlines are outermost" $Rect
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&ink (:Col *Key))
      (input *P (:Col *C))
      (!= C Key))

    (RULE &closed_flood_node
      (&ink (:Col *Key))
      (input *P (:Col *C))
      (!= C Key))

    (INIT &closed_flood Propagation
      (key ((OR ((&closed_cell (:Key ^Ky) *P)
                 (dir_elem *D)
                 (margin (:B P) D (:K 0))
                 (&closed_flood_node (:Key Ky) P))
                ((&closed_flood_node (:Key Ky) P)
                 (&closed_flood_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *Q))
                 (&closed_flood_node (:Key Ky) (:P Q)))))
        (source ((:n P))
          (&closed_cell (:Key Ky) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (&closed_flood_node (:Key Ky) P))
        (edge ((:a P) (:b Q))
          (&closed_flood_node (:Key Ky) *P)
          (&closed_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *Q))
          (&closed_flood_node (:Key Ky) (:P Q)))))

    (RULE &closed_node
      (&closed_cell *Key *P)
      (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

    ;; Each ink color walls the rest of the grid off; a cell some color cuts off
    ;; is nested.
    (INIT &closed Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&closed_node (:Key *Ky) *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:Key Ky) (:P P2)))
            ((&closed_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *Key *P) *Id))

    (RULE &outer_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &outer_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &outer_cell
      (&ink (:Col *Key))
      (input *P (:Col *C))
      (OR ((!= C Key))
          ((&closed_component P))))

    (RULE &outer_flood_node
      (&ink (:Col *Key))
      (input *P (:Col *C))
      (OR ((!= C Key))
          ((&closed_component P))))

    (INIT &outer_flood Propagation
      (key ((OR ((&outer_cell (:Key ^Ky) *P)
                 (dir_elem *D)
                 (margin (:B P) D (:K 0))
                 (&outer_flood_node (:Key Ky) P))
                ((&outer_flood_node (:Key Ky) P)
                 (&outer_flood_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *Q))
                 (&outer_flood_node (:Key Ky) (:P Q)))))
        (source ((:n P))
          (&outer_cell (:Key Ky) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (&outer_flood_node (:Key Ky) P))
        (edge ((:a P) (:b Q))
          (&outer_flood_node (:Key Ky) *P)
          (&outer_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *Q))
          (&outer_flood_node (:Key Ky) (:P Q)))))

    (RULE &outer_node
      (&outer_cell *Key *P)
      (NOT (&outer_flood.reached (:key (:Ky Key)) (:n P))))

    ;; Each color's outermost walls cut the grid off: a cell of another color
    ;; passes, and so does a cell some color already cuts off.
    (INIT &outer Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&outer_node (:Key *Ky) *P)
             (&outer_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&outer_node (:Key Ky) (:P P2)))
            ((&outer_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &outer_component
      (&outer.class (:a *Key *P) *Id))

    (RULE &enclosed
      (&ink (:Col *C))
      (input *P (:Col C))
      (&outer_component (:Key *Col) P))))

(RULE &output
  (OR ((&enclosed *P *Col))
      ((input P Col)
       (NOT (&enclosed P)))))
