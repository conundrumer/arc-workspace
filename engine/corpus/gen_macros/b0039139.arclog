;; b0039139

(INPUT panels "full lines of &divider_color, one cell wide, cut the input into four panels in a row along one axis, and each panel spans the whole input across that axis"

  (DET &line_cell_split1
    (ex_input *E (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &line_cell
    (ex_input *E *P *Col)
    (axis_elem *A)
    (&line_cell_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  ;; The color of each one-colored line of an input.
  (INIT &line Singleton
    (key ((&line_cell ^E ^A ^L *Col))
      (member ((:v Col))
        (&line_cell E A L *Col))))

  (DET &line_color
    (&line.value (:key *E) (:v *Col)))

  (DET &on_line
    (&line_cell *E *A *L *P *Col)
    (&line.value (:key E A L) (:v Col)))

  (DET &lacks
    (OR ((ex_output *E)
         (&line_color *Col)
         (NOT (&line_color E Col)))
        ((ex_output E)
         (ex_input E *P Col)
         (NOT (&on_line E P)))))

  (DET &divider_color
    (&line_color (:Col *C))
    (NOT (&lacks (:Col C)))))

(INPUT shape-panel "one end panel holds one connected shape of &shape_color on background 0, with background between the shape and the panel's sides"

  (DET &shape_color SharedColor))

(INPUT count-panel "the panel next to the shape panel holds marks of &mark_color on background 0, each mark a domino of two cells, with background between any two marks"

  (DET &mark_color SharedColor))

(INPUT solid-panels "each of the other two panels is solid in one color, and the two colors differ from each other, from &divider_color and from background 0")

(OUTPUT count "N is the number of marks in the count panel"

  (RULE &broken_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &divider_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &divider
    (input *P)
    (axis_elem *A)
    (&divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (ALL ((input (:P *Pm) *Col)
          (&broken_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
         ((&divider_color (:C Col)))))

  (RULE &panel_axis
    (&divider *A))

  (RULE &panels_divider
    (&divider *A *L))

  (RULE &panels_on_divider
    (input *P)
    (&panels_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  ;; The panels the divider lines cut, each named by its tile position.
  (INIT &panels_rank Order
    (key ((OR ((&panels_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&panels_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&panels_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &panels_part_idx
    (input *P)
    (axis_of *D *A)
    (NOT (&panels_on_divider P A))
    (margin (:B P) D *K)
    (&panels_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &panels_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&panels_part_idx *P D (:N *N1))
    (&panels_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE &panels_tile_of
    (&panels_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&panels_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (RULE &row_elem
    (&panels_tile_of (:P_tile *T))
    (&panel_axis *A)
    (axis_of (:D *Key) A))

  ;; The panels in order toward each end of the row, nearest that end first.
  (INIT &row Order
    (key ((OR ((&row_elem (:Key ^D) *T))
              ((&row_elem (:Key D) (:T *T1))
               (&row_elem (:Key D) (:T *T2))
               (dir_elem D)
               (margin (:B T1) D (:K *K1_m1))
               (margin (:B T2) D (:K *K2_m2))
               (< K1_m1 K2_m2))))
      (member ((:t T))
        (&row_elem (:Key D) *T))
      (before ((:a T1) (:b T2))
        (&row_elem (:Key D) (:T *T1))
        (&row_elem (:Key D) (:T *T2))
        (dir_elem D)
        (margin (:B T1) D (:K *K1_m1))
        (margin (:B T2) D (:K *K2_m2))
        (< K1_m1 K2_m2))))

  ;; A solid panel's color; a panel of two colors clashes.
  (INIT &solid Singleton
    (key ((&panels_tile_of *P (:P_tile ^T))
          (input P *Col))
      (member ((:v Col))
        (&panels_tile_of *P (:P_tile T))
        (input P *Col))))

  (RULE &shape_end
    (&row.minimal (:key *D) (:t *T))
    (&solid.plural (:key T)))

  (RULE &marks4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &mark_cell
    (&shape_end *D *T)
    (&row.successor (:key D) (:a T) (:b *T2))
    (&panels_tile_of *P (:P_tile T2))
    (input P *Col)
    (&mark_color (:C Col)))

  ;; The marks, 4-connected.
  (INIT &marks4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&mark_cell *P)
           (&marks4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&mark_cell (:P P3)))
          ((&mark_cell P)
           (= P3 P)))))

  (RULE &marks4_component
    (&marks4.class (:a *P) *Id))

  (RULE &marks8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &marks Cardinality
    (member ((:m Id))
      (&marks4_component *Id)))

  ;; The marks, 8-connected.
  (INIT &marks8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&mark_cell *P)
           (&marks8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&mark_cell (:P P3)))
          ((&mark_cell P)
           (= P3 P)))))

  (INIT &cells Cardinality
    (member ((:m P))
      (&mark_cell *P))))

(OUTPUT tile-shape "the output is the shape's bounding box, copied N times in a line along the panel axis, with &gap_width lines between neighbor copies"

  (DET &gap_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &gap_node_split1
    (ex_output *E (:P *P_))
    (&panel_axis E (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &field_color
    (&shape_end *D)
    (&row.maximal (:key D) (:t *T))
    (&solid.value (:key T) (:v *Col)))

  (DET &off_field_split1
    (ex_output *E (:P *P_) *Col)
    (&panel_axis E (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &off_field
    (ex_output *E *P *Col)
    (&panel_axis E *A)
    (&off_field_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (NOT (&field_color E Col)))

  (DET &gap_node
    (ex_output (:E *Key) *P)
    (&panel_axis (:E Key) *A)
    (&gap_node_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (NOT (&off_field (:E Key) L)))

  ;; The gaps between copies: runs of output lines all in the field color.
  (INIT &gap Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&gap_node (:Key *Ky) *P)
           (&gap_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&gap_node (:Key Ky) (:P P2)))
          ((&gap_node (:Key Ky) P)
           (= P2 P)))))

  (DET &gap_component
    (&gap.class (:a *Key *P) *Id))

  (DET &item_split1
    (&gap_component (:Key *E) (:P *P_) *Id)
    (&panel_axis E (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &divider_band_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &edge_split1
    (input (:P *P_))
    (&divider (:A *A_) (:L *L_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &edge_split2
    (input (:P *P_))
    (&divider (:A *A_) (:L *L_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &edge_split3
    (input (:P *P2_))
    (&divider (:A *A2_) (:L *L2_))
    (axis_of (:D *D_m1) (:A A2_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P2_) (:D D_m1) (:K *K1_m3))
    (margin (:B P2_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C L2_))
    (relative (:Base L2_) (:X P2_) (:X_rel *X_m2_)))

  ;; The divider bands, each one or more adjacent divider lines.
  (INIT &divider_band Quotient
    (edge ((:a P) (:b P3))
      (OR ((&divider *A *L)
           (input *P)
           (&edge_split2 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1))
           (&divider_band_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&divider (:A *A2) (:L *L2))
           (input (:P P3))
           (&edge_split3 (:P2_ P3) (:A2_ A2) (:L2_ L2) (:X_m2_ *X_m2)))
          ((&divider (:A *A3) (:L *L3))
           (input P)
           (&edge_split1 (:P_ P) (:A_ A3) (:L_ L3) (:X_m1_ *X_m12))
           (= P3 P)))))

  (RULE &divider_band_component
    (&divider_band.class (:a *P) *Id))

  (RULE &facing_dir
    (dir_elem *D))

  (DET_OR_RULE &background DominantColor)

  (RULE &facing_blocked
    (input *P *Col)
    (NOT (&background (:C Col))))

  (RULE &facing_node
    (dir_elem *D)
    (input *P)
    (NOT (&facing_blocked P)))

  (RULE &mark
    (&marks4_component *P *Id))

  (RULE &facing_source
    (&mark *P))

  ;; Casts from each mark cell along rows and columns, stopped by any cell off
  ;; the background.
  (INIT &facing Distance
    (key ((&facing_source (:P ^O))
          (&facing_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&facing_source (:P O))
             (&facing_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&facing_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&facing_node (:P Q)))
            ((&facing_source (:P O))
             (&facing_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&facing_node (:P Q))
             (= A2 O))
            ((&facing_source (:P O))
             (&facing_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&facing_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&facing_node (:P Q)))))
      (source ((:n O))
        (&facing_source (:P O))
        (&facing_dir D))))

  (RULE &facing_ray
    (&facing.distance (:key *D (:O *Origin)) (:n *P) *K))

  (RULE &facing_end
    (&facing_ray *P *D *K *Origin)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (NOT (&facing_ray (:P Q) D Origin)))

  (RULE &item_split12
    (&divider_band_component (:P *P_) *Id)
    (&divider (:A *A_) (:L *L_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (INIT &shape BoundingBox
    (cell (P)
      (&shape_end *T)
      (&panels_tile_of *P (:P_tile T))
      (input P *Col)
      (&shape_color (:C Col))))

  (INIT &gap_lines Cardinality
    (key ((&gap_component (:Key ^E) *P ^Id)
          (&panel_axis E *A)
          (&item_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))
      (member ((:m L))
        (&gap_component (:Key E) *P Id)
        (&panel_axis E *A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))))

  (DET &gap_width
    (&gap_lines.size (:N *K)))

  (INIT &shape_panel BoundingBox
    (cell (P)
      (&shape_end *T)
      (&panels_tile_of *P (:P_tile T))))

  ;; The shape's distance from each side of its panel.
  (INIT &shape_margin Singleton
    (member ((:v N))
      (&shape_panel.box (:B *B0))
      (&shape.box *B)
      (relative (:Base B0) (:X B) (:X_rel *B_rel))
      (dir_elem *D)
      (margin (:B B_rel) D (:K *N))))

  ;; The background run of a cast that ends on another mark.
  (INIT &run Cardinality
    (key ((&facing_end (:P *E) ^D (:Origin ^Src))
          (step_offset D (:V *V_m1))
          (compose (:A E) (:B V_m1) (:C *Q))
          (input (:P Q))
          (&mark (:P Q) (:Id *Id2))
          (&mark (:P Src) (:Id *Id1))
          (!= Id1 Id2)
          (&facing_ray *P D (:Origin Src))
          (input P *Col)
          (&background (:C Col)))
      (member ((:m P))
        (&facing_end (:P *E) D (:Origin Src))
        (step_offset D (:V *V_m1))
        (compose (:A E) (:B V_m1) (:C *Q))
        (input (:P Q))
        (&mark (:P Q) (:Id *Id2))
        (&mark (:P Src) (:Id *Id1))
        (!= Id1 Id2)
        (&facing_ray *P D (:Origin Src))
        (input P *Col)
        (&background (:C Col)))))

  (INIT &shortest Order
    (member ((:t N))
      (&run.size *N))
    (score ((:t N) (:S N))
      (&run.size *N)))

  (INIT &thickness Cardinality
    (key ((&divider_band_component *P ^Id)
          (&divider *A *L)
          (&item_split12 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))
      (member ((:m L))
        (&divider_band_component *P Id)
        (&divider *A *L)
        (&item_split12 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

  (INIT &same_thickness Singleton
    (member ((:v N))
      (&thickness.size *N))))

(OUTPUT recolor "a shape cell takes the color of the solid panel next to the count panel, and every other cell of the output, in a box or in a gap, takes the color of the solid panel at the far end")

(ALTS $m "how the marks give the number of copies" $Marks4
  (ALT $MarkCells
    (OUTPUT count "N is the number of &mark_color cells in the count panel divided by &mark_size; undefined where that number is not a multiple of &mark_size"
      ;; One place per mark cell.
      (INIT &cell_row Frame
        (key ((&panel_axis ^A))
          (extent (A N)
            (&cells.size *N))))

      (RULE &copies_extent_division_axis_split1
        (&cell_row.cell (:key *A) (:P *P_))
        (axis_elem (:A *A2_))
        (axis_of (:D *D_m1) (:A A2_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      ;; The cells of one mark.
      (DET &mark_size TileDim)

      (RULE &copies_extent_division_side_held
        (&cell_row.cell (:key *A))
        (&mark_size (:D *K)))

      (RULE &copies_extent_division_axis
        (OR ((&cell_row.cell (:key (:A *Key)) *P)
             (axis_elem *A)
             (OR ((!= A Key))
                 ((NOT (&copies_extent_division_side_held (:A Key)))))
             (&copies_extent_division_axis_split1 (:P_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
            ((&cell_row.cell (:key (:A Key)) P)
             (&cell_row.cell (:key (:A Key)))
             (&mark_size (:D *K))
             (axis_of *D (:A Key))
             (opposite D (:Opp *O))
             (margin (:B P) D (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
             (opposite D (:Opp *O_m1))
             (edge_inset D (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
             (opposite D (:Opp *O_m4))
             (edge_inset D (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
             (frame_extent (:P P_inner) (:A Key) (:N K))
             (= A Key))))

      (RULE &copies_extent_division_tile
        (&copies_extent_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&copies_extent_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner))))
    ;; One copy per mark_size mark cells.
    (RULE &copies_extent
      (&cell_row.cell (:key *A) *P)
      (&copies_extent_division_tile (:Key A) P *P_outer)
      (frame_extent (:P P_outer) A *N)))
  (ALT $Marks8
    (OUTPUT count "the marks are the 8-connected components of &mark_color in the count panel"
      (RULE &marks8_component
        (&marks8.class (:a *P) *Id))

      (INIT &marks Cardinality
        (member ((:m Id))
          (&marks8_component *Id)))

      (RULE &mark
        (&marks8_component *P *Id)))))

(ALTS $s "the box each copy takes" $ShapeBox
  (ALT $PanelInset
    (OUTPUT tile-shape "the box is the shape panel inset by &margin on every side; undefined where the panel is no wider than twice the margin on an axis"
      (DET &margin
        (ex_output *E)
        (&shape_margin.value E (:v *K)))

      (RULE &shape_box_uniform_inset1
        (&margin (:K *K_))
        (axis_of (:D *D1_m1) (:A *A1_m2))
        (perp (:A A1_m2) (:A2 *A2_m3))
        (axis_of (:D *D2_m4) (:A A2_m3))
        (opposite (:D D1_m1) (:Opp *O_m1))
        (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
        (opposite (:D D2_m4) (:Opp *O_m4))
        (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
        (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
        (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *I_))))
    (RULE &shape_box
      (&shape_panel.box (:B *B0))
      (&margin *K)
      (&shape_box_uniform_inset1 (:K_ K) (:I_ *I))
      (compose (:A B0) (:B I) (:C *B)))))

(ALTS $r "how the panels take their roles" $RolesByContent
  (ALT $PanelOrder
    (INPUT shape-panel "the shape panel is the first panel from corner &start_corner along the panel axis, whatever it holds")
    (INPUT count-panel "the count panel is the second panel from that corner")
    (OUTPUT recolor "the fill panel is the third panel from that corner and the field panel the last; undefined where either is not solid"
      ;; The corner whose end of the panel row holds the shape panel.
      (DET &start_corner DiagDirDomain)

      (RULE &shape_end
        (&row.minimal (:key *D) (:t *T))
        (&start_corner (:D *C))
        (corner_dir C D)))))

(ALTS $g "the lines between neighbor copies" $StoredGap
  (ALT $GapFromMarkSpacing
    (OUTPUT tile-shape "the gap is the shortest run of background between two different marks along a row or column of the count panel; undefined where no two marks face each other along a row or column")
    (RULE &spacing
      (&shortest.minimal (:t *K))))
  (ALT $GapFromDivider
    (OUTPUT tile-shape "the gap is the thickness of the divider lines; undefined where the dividers differ in thickness")
    (RULE &spacing
      (&same_thickness.value (:v *K))))
  (ALT $GapFromShapeMargin
    (OUTPUT tile-shape "the gap is the shape's distance from the sides of its panel; undefined where its distances from the four sides differ")
    (RULE &spacing
      (&shape_margin.value (:v *K)))))

(RULE &copies_extent
  (&marks.size *N)
  (&panel_axis *A))

;; The index of each copy, axis-only on the panel axis.
(INIT &copies Frame
  (key ((&copies_extent ^A *N))
    (extent (A N)
      (&copies_extent A *N))))

(RULE &shape_box
  (&shape.box *B))

(RULE &spacing
  (&gap_width *K))

(INIT &copy_tiling Tiling
  (key ((OR ((&copies.cell (:key ^A) (:P *P_idx))
             (&spacing))
            ((&copies.cell (:key A))
             (&shape_box *B)
             (&spacing)
             (input (:P *Q))
             (ALL ((&shape_box B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X Q) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (relative (:Base B) (:X Q) (:X_rel *Q_rel)))
            ((&copies.cell (:key A))
             (&spacing *K))))
    (outer ((:P P_idx))
      (&copies.cell (:P *P_idx))
      (&spacing))
    (inner ((:P Q_rel))
      (&copies.cell)
      (&shape_box *B)
      (&spacing)
      (input (:P *Q))
      (ALL ((&shape_box B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X Q) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X Q) (:X_rel *Q_rel)))
    (gap (A (:G K))
      (&copies.cell)
      (&spacing *K))))

(RULE &fill_color
  (&shape_end *D *T)
  (&row.successor (:key D) (:a T) (:b *T2))
  (&row.successor (:key D) (:a T2) (:b *T3))
  (&solid.value (:key (:T T3)) (:v *Col)))

(RULE &copy
  (&copies.cell (:key *A) (:P *P_idx))
  (&shape_box *B)
  (&copy_tiling.cell (:key A) (:P_outer P_idx) (:P_inner *Q_rel) *P)
  (input (:P *Q))
  (ALL ((&shape_box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X Q) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X Q) (:X_rel Q_rel)))

;; The output frame.
(INIT &frame Frame
  (extent (A N)
    (&copy *P)
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &shape_copy
  (&copy *P *Q)
  (input (:P Q) *Col)
  (&shape_color (:C Col)))

(RULE &output
  (OR ((&shape_copy *P)
       (&fill_color *Col))
      ((&frame.cell P)
       (NOT (&shape_copy P))
       (&field_color Col))))
