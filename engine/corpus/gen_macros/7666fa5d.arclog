;; 7666fa5d

(DET &bg DominantColor)

;; The axis the fill runs along; the mark lines run across it.
(DET &fill_axis DiagAxisDomain)

(RULE &wall_dir
  (&fill_axis *Da)
  (axis4_of *D (:A Da)))

(RULE &wall_node
  (input *P))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &step
  (input *P)
  (corner_dir (:C *G) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C G) (:A A2_m2) (:D *D2))
  (step_offset (:D D1) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q1))
  (&mark (:P Q1))
  (step_offset (:D D2) (:V *V_m4))
  (compose (:A P) (:B V_m4) (:C *Q2))
  (&mark (:P Q2)))

(RULE &wall_mark
  (OR ((&mark *P))
      ((&step P))))

(RULE &wall_source
  (&wall_mark *P))

;; The lines as walls: marks and the cells they step past, over the bg cells.
(INIT &wall Distance
  (key ((&wall_source (:P ^O))
        (&wall_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&wall_source (:P O))
           (&wall_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&wall_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&wall_node (:P Q)))
          ((&wall_source (:P O))
           (&wall_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&wall_node (:P Q))
           (= A2 O))
          ((&wall_source (:P O))
           (&wall_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&wall_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&wall_node (:P Q)))))
    (source ((:n O))
      (&wall_source (:P O))
      (&wall_dir D))))

(RULE &wall_ray
  (&wall.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &wall_between
  (input *P *Col)
  (&bg (:C Col))
  (&fill_axis *Da)
  (axis4_of *D (:A Da))
  (dir8_opposite D (:D2 *O))
  (&wall_ray P D)
  (&wall_ray P (:D O)))

(RULE &wall_end
  (&wall_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&wall_ray (:P Q) D Origin)))

(DET &fill AnyOutNewColor)

(RULE &wall_cell
  (input *P *Col)
  (&bg (:C Col)))

(RULE &strict
  (dir8_opposite *D (:D2 *O))
  (&wall_ray *P D *K)
  (&wall_cell P)
  (!= K 0)
  (&wall_ray P (:D O) (:K *K2))
  (&wall_cell P)
  (!= K2 0))

(RULE &output
  (OR ((&strict *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&strict P)))))
