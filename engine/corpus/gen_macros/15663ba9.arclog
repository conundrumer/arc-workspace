;; 15663ba9

(RULE &outside_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &open_paint AnyOutNewColor)

(DET &enclosed_paint AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &outside Propagation
  (source ((:n P))
    (&bg_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))
  (edge ((:a P) (:b P2))
    (&bg_cell *P)
    (&outside_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&bg_cell (:P P2))))

(INIT &rim Boundary
  (cell (P)
    (&ink *P)))

(RULE &arm
  (&ink *P)
  (dir_elem *D)
  (NOT (&rim.exposed P D)))

(RULE &bend
  (corner_dir (:C *Arms) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Arms) (:A A2_m2) (:D *D2))
  (&arm *P (:D D1))
  (&arm P (:D D2))
  (diag_opposite (:D *Open) (:Opp Arms)))

(RULE &faces_open
  (&bend *P *Open)
  (corner_dir (:C Open) *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (ALL ()
       ((&outside.reached (:n Q)))))

(RULE &output
  (OR ((&bend *P)
       (IF ((&faces_open P))
           ((&open_paint (:C *Col)))
           ((&enclosed_paint (:C Col)))))
      ((input P Col)
       (NOT (&bend P)))))
