;; 8618d23e

(DET &arr TileCount)

(DET &slab_cell_division_cell
  (ex_input *E *P)
  (ex_output E)
  (axis_elem (:A *Key)))

(INIT &slab_cell_division_sides ExtentDivisions
  (key ((&slab_cell_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&slab_cell_division_cell (:Key Ky) *P))))

(DET &slab_cell_division_axis_split1
  (&slab_cell_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &slab_cell_division_parts_held
  (axis_elem *A)
  (&arr *N))

(DET &slab_cell_division_axis
  (OR ((&slab_cell_division_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&slab_cell_division_parts_held (:A Key)))))
       (&slab_cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&slab_cell_division_cell Key P)
       (axis_elem (:A Key))
       (&arr *N)
       (&slab_cell_division_sides.division (:key (:Ky Key)) (:A Key) N *K (:G 0))
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K))
       (= A Key))
      ((&slab_cell_division_cell Key P)
       (axis_elem (:A Key))
       (&arr (:N *N2))
       (frame_extent P (:A Key) (:N *K2))
       (axis_of (:D *D2) (:A Key))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K2))
       (frame_extent (:P P_outer) (:A Key) (:N N2))
       (= A Key))))

(DET &slab_cell_division_tile
  (&slab_cell_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&slab_cell_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &dp_nearer
  (input *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(DET &sep DimDiff)

(RULE &grow_delta_corner_inset1
  (diag_dir_elem (:D *Diag_))
  (&sep (:D *G_))
  (corner_dir (:C Diag_) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Diag_) (:A A2_m3) (:D *D2_m4))
  (edge_inset (:D D1_m2) (:K G_) (:B *B1_m5))
  (edge_inset (:D D2_m4) (:K G_) (:B *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *E_)))

(DET &filler AnyOutNewColor)

(DET &slab_cell
  (ex_input *E *P *Col)
  (ex_output E)
  (&slab_cell_division_tile (:Key *A) P (:P_outer *P_tile)))

;; Seat each slab among its output's cells, color for color.
(INIT &occ Occurrences
  (key ((OR ((&slab_cell ^E ^A ^P_tile *P *Col))
            ((&slab_cell E A P_tile)
             (ex_output E (:P *P_out) Col))))
    (cell ((:P P_out) (:v Col))
      (&slab_cell E A P_tile)
      (ex_output E (:P *P_out) *Col))
    (shape (P (:v Col))
      (&slab_cell E A P_tile *P *Col))))

(DET &broken
  (&occ.occurrence (:key *A *P_tile) (:P *Delta))
  (&slab_cell *E A P_tile)
  (NOT (&occ.occurrence (:key E A P_tile) (:P Delta))))

(DET &slab_disp
  (&occ.occurrence (:key *A *P_tile) (:P *Delta))
  (NOT (&broken A P_tile Delta)))

(DET &axis_broken
  (&slab_disp *A)
  (&slab_cell A *P_tile)
  (NOT (&slab_disp A P_tile)))

(DET &axis
  (&slab_disp *A)
  (NOT (&axis_broken A)))

(RULE &side
  (&axis *A)
  (axis_of *D A)
  (&dp_nearer *P D))

(DET &disp
  (&axis *A)
  (&slab_disp A *P_tile *Delta))

(DET &seat
  (&disp *P_tile *Delta)
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B Delta) (:D D1_m2) (:K 0))
  (margin (:B Delta) (:D D2_m3) (:K 0)))

(DET &diag
  (&seat *Diag)
  (diag_axis_of (:D Diag) *Da))

(RULE &seat2
  (&side *P *D)
  (&diag (:Da *DA))
  (diag_axis_of (:D *Diag) (:Da DA))
  (corner_dir (:C Diag) D))

(RULE &grow_delta
  (diag_dir_elem (:D *Diag))
  (&sep (:D *G))
  (&grow_delta_corner_inset1 (:Diag_ Diag) (:G_ G) (:E_ *E1)))

(ALTS $choice "how the reseat offset is computed — data-equivalent on this task" $Derive
  (ALT $Derive
    (ALTS $g "how wide the growth is" $Iso
      (ALT $Aniso
        (DET &sep_dim
          (&disp *Delta)
          (axis_of *D *A)
          (margin (:B Delta) D (:K *N))
          (!= N 0))
        (RULE &grow_delta
          (corner_dir (:C *Diag) *A (:D *D1))
          (perp A (:A2 *A2_m1))
          (corner_dir (:C Diag) (:A A2_m1) (:D *D2))
          (&sep_dim A (:N *K1))
          (perp A *A2)
          (&sep_dim (:A A2) (:N *K2))
          (edge_inset (:D D1) (:K K1) (:B *E12))
          (edge_inset (:D D2) (:K K2) (:B *E2))
          (compose (:A E12) (:B E2) (:C *E1)))))
    (ALTS $s "which corner each half seats at" $Derived
      (ALT $Table
        (DET &seat_of
          (&seat *P_tile *Diag)
          (&axis *A)
          (axis_of *D A)
          (margin (:B P_tile) D (:K 0)))
        (RULE &seat2
          (&side *P *D)
          (&seat_of D *Diag)))))
  (ALT $Disp
    (INIT &seated_division_sides ExtentDivisions
      (frame (P)
        (input *P)))

    (RULE &seated_division_axis_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &seated_division_parts
      (&axis *A)
      (&arr *N))

    (RULE &seated_division_axis
      (OR ((input *P)
           (&axis *A)
           (&arr *N)
           (&seated_division_sides.division A N *K (:G 0))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&axis A)
           (&arr (:N *N2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N2)))
          ((input P)
           (axis_elem A)
           (NOT (&seated_division_parts A))
           (&seated_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &seated_division_tile
      (&seated_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&seated_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &seated
      (input *P *Col)
      (&seated_division_tile P (:P_outer *P_tile))
      (&disp P_tile *Delta)
      (compose (:A P) (:B Delta) (:C *P_out)))))

;; Displaced by the growth extents at both edges of the opposite corner —
;; the frame grows away from the seat.
(RULE &seated
  (input *P *Col)
  (&seat2 P *Diag)
  (diag_opposite (:D Diag) (:Opp *Diag2))
  (&grow_delta (:Diag Diag2) (:E1 *E))
  (compose (:A P) (:B E) (:C *P_out)))

;; Output frame extents, read off the seated images.
(INIT &frame Frame
  (extent (A N)
    (&seated (:P_out *P))
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &output
  (OR ((&seated (:P_out *P) *Col))
      ((&frame.cell P)
       (NOT (&seated (:P_out P)))
       (&filler (:C Col)))))
