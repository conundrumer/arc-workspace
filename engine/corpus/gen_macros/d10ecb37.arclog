;; d10ecb37

(DET &diag DiagDirDomain)

(DET &window Frame)

(ALTS $choice "how the corner block is located" $Corner
  (ALT $Block
    (DET &tile_dim ConstOutDim)

    (RULE &output_division_axis_split1
      (input (:P *P_in_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_in_) (:X_rel *X_m1_)))

    (RULE &output_division_side
      (axis_elem *A)
      (&tile_dim (:N *K)))

    (RULE &output_division_axis
      (OR ((input *P)
           (axis_elem *A)
           (&tile_dim (:N *K))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (NOT (&output_division_side A))
           (&output_division_axis_split1 (:P_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &output_division_tile
      (&output_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&output_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &output
      (input (:P *P_in) *Col)
      (&output_division_tile (:P P_in) (:P_outer *P_tile) (:P_inner *P))
      (&diag *D)
      (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin (:B P_tile) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P_tile) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))))

(RULE &output
  (input (:P *P_in) *Col)
  (&window *P)
  (&diag *D)
  (ALL ((input (:P P_in) (:Col *Colm))
        (corner_dir (:C D) (:D *D_m1))
        (margin (:B P) (:D D_m1) (:K *K1_m2))
        (margin (:B P_in) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))
