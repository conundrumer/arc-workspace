;; 673ef223

(DET &bg DominantColor)

(RULE &cast_cell
  (input *P *Col)
  (&bg (:C Col)))

(DET &axis AxisDomain)

(RULE &cast_dir
  (&axis *A)
  (perp A *A2)
  (axis_of *D (:A A2)))

(RULE &cast_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &cast_node
  (input *P)
  (NOT (&cast_blocked P)))

(DET &bar UnchangedColor)

(RULE &bars_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bars Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&bar (:C Col))
         (&bars_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&bar (:C Col2)))
        ((input P (:Col *Col3))
         (&bar (:C Col3))
         (= P3 P)))))

(RULE &bars_component
  (&bars.class (:a *P) *Id))

(RULE &line_split1
  (input (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

(RULE &line
  (input *P)
  (&axis *A)
  (&line_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1)))

(RULE &bar_cell
  (&bars_component *P *Id)
  (&line P *P_along))

;; Each bar's box over its lines, the frame a place in the bar is read in.
(INIT &bar_box BoundingBox
  (key ((&bar_cell ^Id *P_along))
    (cell ((:P P_along))
      (&bar_cell Id *P_along))))

(RULE &bar_place
  (&bar_box.cell (:key *Id) (:P *P_along))
  (&bar_box.box (:key Id) *B)
  (ALL ((&bar_box.cell (:key (:Id *Idm)) (:P P_along))
        (&bar_box.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_along) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_along) (:X_rel *P_inner)))

(DET &mark ChangedColor)

(RULE &flagged
  (input *P *Col)
  (&mark (:C Col))
  (&line P *P_along)
  (&bar_place P_along *P_inner))

(RULE &cast_source
  (&bar_cell *Id *P *P_along)
  (&bar_place Id P_along *P_inner)
  (&flagged P_inner))

;; Flagged bar cells cast across &axis through bg; ink stops the cast.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_clear
  (&cast_ray *P *D *K (:Origin *Src))
  (&cast_cell P))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(DET &cap AnyOutNewColor)

(RULE &output
  (OR ((&cast_ray *P)
       (&cast_cell P)
       (&mark (:C *Col)))
      ((input P (:Col *C_in))
       (NOT (&cast_clear P))
       (IF ((&mark (:C C_in)))
           ((&cap (:C Col)))
           ((= Col C_in))))))
