;; 57edb29d

(RULE &panel_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg VanishedColor)

(INIT &panel Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&panel_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &panel_component
  (&panel.class (:a *P) *Id))

;; Each panel's bounding box.
(INIT &bbox BoundingBox
  (key ((&panel_component *P ^Id))
    (cell (P)
      (&panel_component *P Id))))

(RULE &field
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (input P *Col))

(RULE &panel_inner
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &mark
  (&panel_inner *Id *P *P_inner)
  (input P *Col)
  (NOT (&field Id Col)))

(RULE &target_cell
  (&panel_inner *Id *P_inner)
  (NOT (&mark Id)))

(RULE &anchor
  (&mark *P_inner)
  (opposite *D (:Opp *O_m1))
  (margin (:B P_inner) D *K)
  (margin (:B P_inner) (:D O_m1) (:K *K2))
  (<= K K2))

(RULE &anchored
  (&target_cell *P_inner)
  (&anchor (:P_inner *M_inner) *D *K)
  (axis_of D *A)
  (margin (:B P_inner) D K))

(RULE &design
  (&mark (:P_inner *M_inner) *Col)
  (perp *A *A2)
  (&anchored *P_inner M_inner A)
  (&anchored P_inner M_inner (:A A2)))

(RULE &output
  (&target_cell *Id (:P_inner *P))
  (OR ((&design (:P_inner P) *Col))
      ((NOT (&design (:P_inner P)))
       (&field Id Col))))
