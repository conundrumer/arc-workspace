;; 898e7135

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &object
  (&objs_component (:Key *Col) *P *Id))

(RULE &closed_cell
  (&object (:Id *Key))
  (input *P)
  (NOT (&object (:Id Key) P)))

(RULE &closed_flood_node
  (&object (:Id *Key))
  (input *P)
  (NOT (&object (:Id Key) P)))

(INIT &closed_flood Propagation
  (key ((OR ((&closed_cell (:Key ^Ky) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&closed_flood_node (:Key Ky) P))
            ((&closed_flood_node (:Key Ky) P)
             (&closed_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&closed_flood_node (:Key Ky) (:P Q)))))
    (source ((:n P))
      (&closed_cell (:Key Ky) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&closed_flood_node (:Key Ky) P))
    (edge ((:a P) (:b Q))
      (&closed_flood_node (:Key Ky) *P)
      (&closed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&closed_flood_node (:Key Ky) (:P Q)))))

(RULE &closed_node
  (&closed_cell *Key *P)
  (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

;; What each object closes off: the cells outside it that cannot reach the
;; grid edge.
(INIT &closed Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&closed_node (:Key *Ky) *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:Key Ky) (:P P2)))
        ((&closed_node (:Key Ky) P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *Key *P) *Id))

(RULE &board
  (&closed_component (:Key *Id)))

(INIT &piece_box BoundingBox
  (key ((&object (:Id ^O) *P)
        (NOT (&board (:Id O))))
    (cell (P)
      (&object (:Id O) *P)
      (NOT (&board (:Id O))))))

(RULE &piece_cell
  (&piece_box.cell (:key *O) *P)
  (&piece_box.box (:key O) *B)
  (ALL ((&piece_box.cell (:key (:O *Om)) P)
        (&piece_box.box (:key (:O Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &scale_cand
  (&piece_cell *P_inner)
  (axis_elem *A)
  (OR ((frame_extent (:P P_inner) A (:N *K)))
      ((sub_extent (:P P_inner) A K))))

;; The block a cell becomes at each scale.
(INIT &block Frame
  (key ((&scale_cand ^K))
    (extent (A (:N K))
      (axis_elem *A))))

(RULE &hole
  (&closed_component *P (:Id *H)))

;; Each hole's own box.
(INIT &hole_box BoundingBox
  (key ((&hole ^H *P))
    (cell (P)
      (&hole H *P))))

(RULE &hole_cell
  (&hole *H *P)
  (&hole_box.box (:key H) *B)
  (ALL ((&hole (:H *Hm) P)
        (&hole_box.box (:key (:H Hm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &hole_scaled_tiling Tiling
  (outer ((:P P_hole))
    (&hole_cell (:P_inner *P_hole)))
  (inner ((:P P_blk))
    (&block.cell (:P *P_blk))))

;; The box the board spans, holes included.
(INIT &board_box BoundingBox
  (key ((&board ^Id))
    (cell (P)
      (&object Id *P))))

(RULE &hole_scaled
  (&hole_cell *H (:P_inner *P_hole))
  (&block.cell (:key *K) (:P *P_blk))
  (&hole_scaled_tiling.cell (:P_outer P_hole) (:P_inner P_blk) *P))

(INIT &congruent Inclusion
  (pattern ((:pattern O) (:m P_piece))
    (&piece_cell *O (:P_inner *P_piece)))
  (observed ((:observed H K D) (:m P_turned))
    (&hole_scaled *H *K (:P *P_scaled))
    (d4_elem *D)
    (apply D (:P P_scaled) (:P_out *P_turned))))

(RULE &fit
  (&congruent.equal (:observed *H *K) (:pattern *O)))

(RULE &scale
  (&scale_cand *K)
  (ALL ((&hole *H))
       ((&fit H K))))

(INIT &output_tiling Tiling
  (outer ((:P P_board))
    (&board_box.box (:key *Id) *B)
    (&object Id *P)
    (ALL ((&object (:Id *Idm) P)
          (&board_box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_board)))
  (inner ((:P P_blk))
    (&scale *K)
    (&block.cell (:key K) (:P *P_blk))))

(INIT &output_tiling2 Tiling
  (outer ((:P P_board))
    (&board_box.box *B)
    (&hole *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_board)))
  (inner ((:P P_blk))
    (&scale *K)
    (&block.cell (:key K) (:P *P_blk))))

(RULE &output
  (OR ((&output_tiling.cell (:P_outer *P_board) *P)
       (&board_box.box (:key *Id) *B)
       (&object Id *Col (:P *P2))
       (ALL ((&object (:Id *Idm) (:Col *Colm) (:P P2))
             (&board_box.box (:key (:Id Idm)) B)
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X P2) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P2) (:X_rel P_board)))
      ((&scale *K)
       (&block.cell (:key K) (:P *P_blk))
       (&board_box.box (:key (:Id *Id2)) (:B *B2))
       (&output_tiling2.cell (:P_outer *P_board2) (:P_inner P_blk) P)
       (&hole *H (:P *P22))
       (ALL ((&hole (:H *Hm) (:P P22))
             (&board_box.box (:key (:Id *Idm2)) (:B B2))
             (dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P22) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B2) (:X P22) (:X_rel P_board2))
       (&fit H K *O)
       (&object (:Id O) Col))))
