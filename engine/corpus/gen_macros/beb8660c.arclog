;; beb8660c

(INPUT bars "every non-bg cell belongs to a horizontal bar, a run of one color on one row, and each row holds at most one bar"

  ;; The edge the units stack against.
  (DET &fall_dir DirDomain)

  (RULE &row_of_split1
    (input (:P *P_))
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Row_))
    (relative (:Base Row_) (:X P_) (:X_rel *X_m1_)))

  (RULE &row_of
    (input *P)
    (&fall_dir *D)
    (axis_of D *A)
    (&row_of_split1 (:P_ P) (:A_ A) (:Row_ *Row) (:X_m1_ *X_m1)))

  (INIT &rows Quotient
    (equivalent ((:a Row) (:b Row))
      (&row_of *Row))))

(INPUT lengths-one-to-width "the bar lengths are exactly 1 to the grid width, one bar of each length")

(INPUT base-bar "the bottom row is a full-width bar of color 8")

(OUTPUT sort-by-length "the output places the bars on consecutive rows, ordered by length, the longest on the row nearest the &fall_dir edge"

  (RULE &runs_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &bg DominantColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&bg (:C Col))))

  (INIT &runs Quotient
    (edge ((:a Row Col P) (:b Row Col (:P P3)))
      (OR ((&ink *P *Col)
           (&row_of P *Row)
           (&runs_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col)
           (&row_of (:P P3) Row))
          ((&ink P Col)
           (&row_of P Row)
           (= P3 P)))))

  (RULE &runs_component
    (&runs.class (:a *Row *Col *P) *Id))

  (RULE &unit_cell
    (&runs_component *P (:Id *U))
    (input P *Col))

  (RULE &unit
    (&unit_cell *U))

  (INIT &length Cardinality
    (key ((&unit_cell ^U *P))
      (member ((:m P))
        (&unit_cell U *P))))

  (RULE &longer
    (&length.size (:key (:U *U1)) (:N *N1))
    (&length.size (:key (:U *U2)) (:N *N2))
    (> N1 N2))

  ;; The units in stacking order, from the &fall_dir edge.
  (INIT &stack Order
    (member ((:t U))
      (&unit *U))
    (before ((:a U1) (:b U2))
      (&longer *U1 *U2))))

(OUTPUT stack-at-edge "the stack of bars touches the &fall_dir edge, with one bar per row and no gap rows"

  ;; The cells of each unit's row that lie outside the unit.
  (INIT &outside Cardinality
    (key ((OR ((&unit_cell ^U (:P *Q))
               (&row_of (:P Q) *Row)
               (&row_of *P Row)
               (NOT (&unit_cell U P)))
              ((&unit U))))
      (member ((:m P))
        (&unit_cell U (:P *Q))
        (&row_of (:P Q) *Row)
        (&row_of *P Row)
        (NOT (&unit_cell U P)))
      (domain ()
        (&unit U)))))

(OUTPUT align-to-side "each bar touches the &align_side edge"

  ;; The edge each unit touches in the output.
  (DET &align_side DirDomain)

  ;; Each unit's cells, ranked from the &align_side edge: a cell's rank
  ;; is its distance from that edge in the output.
  (INIT &pack Order
    (key ((&unit_cell ^U *P))
      (member ((:t P))
        (&unit_cell U *P))
      (before ((:a P) (:b Q))
        (&unit_cell U *P)
        (&unit_cell U (:P *Q))
        (&align_side *D)
        (dir_elem D)
        (margin (:B P) D (:K *K1_m1))
        (margin (:B Q) D (:K *K2_m2))
        (< K1_m1 K2_m2)))))

(OUTPUT keep-bar "each bar keeps its color and length")

(OUTPUT clear-rest "every other cell is bg")

(ALTS $item "what one moving unit is" $Bar
  (ALT $RowUnit
    (INPUT bars "each row that holds a non-bg cell is one unit, whose length is its count of non-bg cells and whose cells keep their order along the row; undefined where two units of different content have one length"
      (RULE &unit_cell
        (&ink *P *Col)
        (&row_of P *Row)
        (&rows.class (:a Row) (:Id *U))))))

(ALTS $place "the row each unit lands on" $Stack
  (ALT $RowByLength
    (OUTPUT stack-at-edge "a unit lands as many rows from the &fall_dir edge as its row has cells outside it, in place of the stack by length; undefined where two units land on one row or a unit lands outside the frame")
    (RULE &placed
      (&outside.size (:key *U) (:N *R)))
    (ALT $BaseStays
      (RULE &placed
        (OR ((&outside.size (:key *U) (:N *R))
             (NOT (&base_unit U)))
            ((&base_unit U)
             (= R 0)))))))

(ALTS $base "what happens to the base bar" $Ranked
  (ALT $BaseStays
    (INPUT base-bar "the one unit that holds &base_color takes the row on the &fall_dir edge, and the other units stack on it by length; undefined where the count of such units is not one"
      (DET &base_color
        (ex_input *P (:Col *C))
        (&fall_dir *D)
        (margin (:B P) D (:K 0)))

      (RULE &base_unit
        (&unit_cell *U *Col)
        (&base_color (:C Col)))

      ;; The units in stacking order, from the &fall_dir edge.
      (INIT &stack Order
        (member ((:t U))
          (&unit *U))
        (before ((:a U1) (:b U2))
          (OR ((&base_unit (:U *U1))
               (&unit (:U *U2))
               (NOT (&base_unit (:U U2))))
              ((&longer U1 U2)
               (NOT (&base_unit (:U U1)))
               (NOT (&base_unit (:U U2))))))))
    (RULE &undefined
      (OR ((NOT (&base_unit)))
          ((&placed *R)
           (NOT (&fall_dist R)))))))

(RULE &fall_dist
  (input *P)
  (&fall_dir *D)
  (margin (:B P) D (:K *R)))

(RULE &placed
  (&stack.rank (:t *U) *R))

(RULE &undefined
  (&placed *R)
  (NOT (&fall_dist R)))

(RULE &landed
  (&placed *U *R)
  (&unit_cell U (:P *Q) *Col)
  (&pack.rank (:key U) (:t Q) (:R *K))
  (&fall_dist *P R)
  (&align_side *D)
  (margin (:B P) D K))

(RULE &output
  (OR ((&landed *P *Col)
       (NOT (&undefined)))
      ((input P)
       (NOT (&landed P))
       (NOT (&undefined))
       (&bg (:C Col)))))
