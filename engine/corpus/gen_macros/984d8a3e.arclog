;; 984d8a3e

(RULE &run_dir
  (input (:Col *Key))
  (dir_elem *D))

(RULE &run_node
  (input *P (:Col *Key)))

(RULE &run_source
  (input *P (:Col *Key)))

;; Each color's cells as runs toward the four edges.
(INIT &run Distance
  (key ((&run_source (:Key ^Ky) (:P ^O))
        (&run_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_node (:Key Ky) (:P Q)))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&run_source (:Key Ky) (:P O))
      (&run_dir (:Key Ky) D))))

(RULE &run_ray
  (&run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &run_end
  (&run_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray Key (:P Q) D Origin)))

(RULE &cell_split_split1
  (input (:P *P_) (:Col *C))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

;; The edge the movers run against; the zone lies toward the opposite edge.
(DET &from_dir DirDomain)

(RULE &flush
  (input *Col)
  (dir_elem *D)
  (ALL ((&run_end (:Key Col) *P D))
       ((margin (:B P) D (:K 0)))))

(RULE &far_dir
  (&from_dir (:D *D0))
  (opposite (:D D0) (:Opp *D)))

(RULE &mover
  (&from_dir *D)
  (&flush (:Col *C) D))

(RULE &far
  (&far_dir *D)
  (&flush (:Col *C) D))

(RULE &bg
  (input (:Col *C))
  (NOT (&mover C))
  (NOT (&far C)))

(RULE &cell_split
  (input *P *Col)
  (&far_dir *D)
  (axis_of D *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
  (margin (:B P) D *K))

(RULE &zone
  (&cell_split (:Col *C) *K)
  (&far C))

(RULE &slot
  (&cell_split *P (:Col *C) *L *K)
  (&bg C)
  (&zone K))

(RULE &mover_cell
  (&cell_split *P (:Col *C) *L *K)
  (&mover C))

;; Both runs counted off from the far edge inward.
(INIT &slot_rank Order
  (key ((&slot ^L *K))
    (member ((:t K))
      (&slot L *K))
    (score ((:t K) (:S K))
      (&slot L *K))))

(INIT &mover_rank Order
  (key ((&mover_cell ^L *K))
    (member ((:t K))
      (&mover_cell L *K))
    (score ((:t K) (:S K))
      (&mover_cell L *K))))

(RULE &move
  (&mover_cell *L (:P *P_from) *K)
  (&mover_rank.rank (:key L) (:t K) *R)
  (&slot L (:P *P_to) (:K *K2))
  (&slot_rank.rank (:key L) (:t K2) R))

(RULE &output
  (input *P (:Col *C))
  (OR ((&move (:P_to P))
       (&mover (:C *Col)))
      ((&move (:P_from P))
       (&bg (:C Col)))
      ((NOT (&move (:P_from P)))
       (NOT (&move (:P_to P)))
       (= Col C))))
