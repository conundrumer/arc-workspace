;; 22806e14

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(RULE &cell
  (&comps_component *P *Id))

(INIT &bbox BoundingBox
  (key ((&cell ^Id *P))
    (cell (P)
      (&cell Id *P))))

(RULE &marker
  (input *P)
  (&bbox.box (:key *Id) *B)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&cell Id P)))

(RULE &marker_cell
  (&marker *Id)
  (&cell Id *P))

(RULE &rect
  (&cell *Id)
  (NOT (&marker Id)))

(RULE &center
  (&rect *Id)
  (input *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (ALL ((&bbox.box (:key (:Id *Idmm)) (:B *Bm))
        (input (:P *Pm))
        (relative (:Base Bm) (:X Pm) (:X_rel P_inner))
        (opposite (:D *D_m1m) (:Opp *O_m2))
        (margin (:B P_inner) (:D D_m1m) (:K *K1_m3))
        (margin (:B P_inner) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4))))

(RULE &mark
  (&center *P))

(INIT &size_cmp Excess
  (plus ((:m P))
    (&marker_cell *P))
  (minus ((:m P))
    (&mark *P)))

(RULE &erase
  (&size_cmp.excess))

(ALTS $choice "what counts as enough marks" $MarkerSize
  (ALT $Majority
    (INIT &rect_cmp Excess
      (plus ((:m Id))
        (&center *Id))
      (minus ((:m Id))
        (&rect *Id)
        (NOT (&center Id))))

    (RULE &erase
      (NOT (&rect_cmp.excess)))))

(RULE &gone
  (&erase)
  (&marker_cell *P))

(RULE &output
  (OR ((&mark *P)
       (&marker_cell (:P *Q))
       (input (:P Q) *Col))
      ((&gone P)
       (&bg (:C Col)))
      ((input P Col)
       (NOT (&mark P))
       (NOT (&gone P)))))
