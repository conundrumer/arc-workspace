;; 256b0a75

(RULE &sweep_dir
  (dir_elem *D))

(RULE &sweep_node
  (input *P))

(DET &frame UnchangedColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&frame (:C Col))))

(RULE &sweep_source
  (&bbox.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2)))

(INIT &sweep Distance
  (key ((&sweep_source (:P ^O))
        (&sweep_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sweep_source (:P O))
           (&sweep_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sweep_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sweep_node (:P Q)))
          ((&sweep_source (:P O))
           (&sweep_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sweep_node (:P Q))
           (= A2 O))
          ((&sweep_source (:P O))
           (&sweep_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sweep_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sweep_node (:P Q)))))
    (source ((:n O))
      (&sweep_source (:P O))
      (&sweep_dir D))))

(RULE &sweep_ray
  (&sweep.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sweep_end
  (&sweep_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sweep_ray (:P Q) D Origin)))

(RULE &cast_dir
  (dir_elem (:D *Key)))

(RULE &arm
  (&bbox.box *B)
  (input (:P *Src))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X Src) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B Src) *D (:K *K_m1))
  (margin B D (:K K_m1))
  (&sweep_ray *P D *K (:Origin Src))
  (!= K 0))

(DET &bg DominantColor)

(RULE &mark
  (&arm *P *D)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &cast_blocked
  (&mark *P (:D *Key)))

(RULE &cast_node
  (dir_elem (:D *Key))
  (input *P)
  (NOT (&cast_blocked Key P)))

(RULE &cast_source
  (&mark *P (:D *Key)))

;; Each mark colors its arm outward from itself, as far as the next mark.
(INIT &cast Distance
  (key ((&cast_source (:Key ^Ky) (:P ^O))
        (&cast_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:Key Ky) (:P Q)))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&cast_source (:Key Ky) (:P O))
      (&cast_dir (:Key Ky)))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray Key (:P Q) D Origin)))

(RULE &box_cell_inside1
  (input (:P *P_))
  (&bbox.box (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &fill
  (&bbox.box *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (NOT (&bg (:C Col)))
  (NOT (&frame (:C Col))))

(RULE &painted
  (&cast_ray (:Key *D) *P (:Origin *Src))
  (&arm P D)
  (&mark (:P Src) *Col D))

(RULE &output
  (OR ((&bbox.box *B)
       (input *P)
       (OR ((relative (:Base B) (:X P) (:X_rel *R_m1))
            (axis_of (:D *D1_m2) (:A *A1_m3))
            (opposite (:D D1_m2) (:Opp *O1_m4))
            (perp (:A A1_m3) (:A2 *A2_m5))
            (axis_of (:D *D2_m6) (:A A2_m5))
            (opposite (:D D2_m6) (:Opp *O2_m7))
            (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
            (>= K1_m8 0)
            (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
            (>= K2_m9 0)
            (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
            (>= K3_m10 0)
            (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
            (>= K4_m11 0)
            (margin (:B P) (:D *D_m12) (:K *K_m13))
            (margin B (:D D_m12) (:K K_m13))
            (&frame (:C *Col)))
           ((relative (:Base B) (:X P) (:X_rel *R_m14))
            (axis_of (:D *D1_m15) (:A *A1_m16))
            (opposite (:D D1_m15) (:Opp *O1_m17))
            (perp (:A A1_m16) (:A2 *A2_m18))
            (axis_of (:D *D2_m19) (:A A2_m18))
            (opposite (:D D2_m19) (:Opp *O2_m20))
            (margin (:B R_m14) (:D D1_m15) (:K *K1_m21))
            (> K1_m21 0)
            (margin (:B R_m14) (:D O1_m17) (:K *K2_m22))
            (> K2_m22 0)
            (margin (:B R_m14) (:D D2_m19) (:K *K3_m23))
            (> K3_m23 0)
            (margin (:B R_m14) (:D O2_m20) (:K *K4_m24))
            (> K4_m24 0)
            (&fill Col))))
      ((&arm P)
       (OR ((&painted P Col))
           ((NOT (&painted P))
            (&fill Col))))
      ((input P Col)
       (ALL ((&bbox.box (:B *B2)))
            ((&box_cell_inside1 (:P_ P) (:B_ B2))))
       (NOT (&arm P)))))
