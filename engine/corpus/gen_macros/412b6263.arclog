;; 412b6263

(DET &line_width TileDim)

(RULE &ring_uniform_inset1
  (&line_width (:D *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *P_)))

(DET &xform D4Domain)

;; Where the copies seat on the output. A copy is the input under
;; &xform.
(INIT &seat Occurrences
  (key ((OR ((ex_input ^E (:P *P_grid_in) *Col)
             (&xform *D)
             (apply D (:P P_grid_in) (:P_out *P_intile)))
            ((ex_output E (:P *P_grid) Col))))
    (cell ((:P P_grid) (:v Col))
      (ex_output E (:P *P_grid) *Col))
    (shape ((:P P_intile) (:v Col))
      (ex_input E (:P *P_grid_in) *Col)
      (&xform *D)
      (apply D (:P P_grid_in) (:P_out *P_intile)))))

(DET &item_split1
  (&seat.occurrence (:key *E) (:P *V_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B V_) (:D D_m1) (:K *K1_m3))
  (margin (:B V_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X V_) (:X_rel *X_m1_)))

(RULE &content
  (input (:P *P_grid_in) *Col)
  (&xform *D)
  (apply D (:P P_grid_in) (:P_out *P_intile)))

;; The tile count on each axis: how many distinct offsets the seats take
;; along it.
(INIT &tile_n Cardinality
  (key ((&seat.occurrence (:key ^E) (:P *V))
        (axis_elem ^A)
        (&item_split1 (:V_ V) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1)))
    (member ((:m P_along))
      (&seat.occurrence (:key E) (:P *V))
      (axis_elem A)
      (&item_split1 (:V_ V) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1)))))

(INIT &tile_dim Singleton
  (key ((&tile_n.size (:key ^A) *N))
    (member ((:v N))
      (&tile_n.size (:key A) *N))))

(DET &tiles
  (&tile_dim.value (:key *A) (:v *N)))

(INIT &layout Frame
  (extent (A N)
    (&tiles *A *N)))

(INIT &placed_tiling Tiling
  (outer ((:P P_tile))
    (&layout.cell (:P *P_tile)))
  (inner ((:P P_intile))
    (&content *P_intile))
  (gap (A (:G W))
    (axis_elem *A)
    (&line_width (:D *W))))

(DET &bg ChangedColor)

(DET &line_col AnyOutNewColor)

(RULE &ring
  (&line_width (:D *K))
  (&ring_uniform_inset1 (:K_ K) (:P_ *P)))

(RULE &placed
  (&placed_tiling.cell (:P_inner *P_intile) (:P *P_inner)))

(ALTS $choice "Two hypotheses about the copy count" $Layout
  (ALT $Count
    (RULE &blocks_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &blocks Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (NOT (&bg (:C Col)))
             (&blocks_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (NOT (&bg (:C Col2))))
            ((input P (:Col *Col3))
             (NOT (&bg (:C Col3)))
             (= P3 P)))))

    (RULE &blocks_component
      (&blocks.class (:a *P) *Id))

    (INIT &block_n Cardinality
      (member ((:m Id))
        (&blocks_component *Id)))

    (DET &stack_axis AxisDomain)

    (INIT &stack Frame
      (key ((&stack_axis ^A))
        (extent (A N)
          (&block_n.size *N))))

    (INIT &placed_tiling2 Tiling
      (key ((OR ((&stack.cell (:key ^A) (:P *P_tile)))
                ((&stack.cell (:key A))
                 (&content *P_intile))
                ((&stack.cell (:key A))
                 (&line_width (:D *W)))))
        (outer ((:P P_tile))
          (&stack.cell (:P *P_tile)))
        (inner ((:P P_intile))
          (&stack.cell)
          (&content *P_intile))
        (gap (A (:G W))
          (&stack.cell)
          (&line_width (:D *W)))))

    (RULE &placed
      (&stack.cell (:key *A) (:P *P_tile))
      (&placed_tiling2.cell (:key A) (:P_outer P_tile) (:P_inner *P_intile) (:P *P_inner)))))

(RULE &copy_cell
  (&placed *P_inner *P_intile)
  (&ring (:P *R))
  (compose (:A P_inner) (:B R) (:C *P_grid)))

;; The output frame — the copies' frame, which the ring has grown.
(INIT &frame Frame
  (extent (A N)
    (&copy_cell *P_grid)
    (axis_elem *A)
    (frame_extent (:P P_grid) A *N)))

(RULE &copy_line
  (&frame.cell (:P *P_grid))
  (axis_elem *A)
  (&copy_cell (:P_grid *Q))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P_grid) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &output
  (OR ((&copy_cell (:P_grid *P) *P_intile)
       (&content P_intile *Col))
      ((&frame.cell P)
       (NOT (&copy_cell (:P_grid P)))
       (IF ((&copy_line (:P_grid P)))
           ((&line_col (:C Col)))
           ((&bg (:C Col)))))))
