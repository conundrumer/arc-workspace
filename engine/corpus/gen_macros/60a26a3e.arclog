;; 60a26a3e

(DET &bg DominantColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(DET &ring RarestColor)

(RULE &ring_cell
  (input *P *Col)
  (&ring (:C Col)))

(RULE &center
  (&bg_cell *P)
  (ALL ((dir_elem *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q)))
       ((&ring_cell (:P Q)))))

(RULE &link_axis
  (axis_elem *A))

(RULE &link_dir
  (&link_axis *A)
  (axis4_of *D A))

(RULE &link_node
  (&link_axis)
  (input *P))

(DET &line AnyOutNewColor)

(ALTS $choice "what makes a bg cell a center" $Ringed
  (ALT $Enclosed
    (RULE &outside_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &outside Propagation
      (source ((:n P))
        (&bg_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a P) (:b P2))
        (&bg_cell *P)
        (&outside_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&bg_cell (:P P2))))

    (RULE &center
      (&bg_cell *P)
      (NOT (&outside.reached (:n P))))))

(RULE &link_source
  (&center *P))

(INIT &link Distance
  (key ((&link_source (:P ^O))
        (&link_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&link_source (:P O))
           (&link_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&link_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&link_node (:P Q)))
          ((&link_source (:P O))
           (&link_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&link_node (:P Q))
           (= A2 O))
          ((&link_source (:P O))
           (&link_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&link_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&link_node (:P Q)))))
    (source ((:n O))
      (&link_source (:P O))
      (&link_dir D))))

(RULE &link_ray
  (&link.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &link_between
  (&bg_cell *P)
  (NOT (&center P))
  (&link_axis *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&link_ray P D)
  (&link_ray P (:D O)))

(RULE &link_end
  (&link_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&link_ray (:P Q) D Origin)))

(RULE &output
  (OR ((&link_between *P)
       (&line (:C *Col)))
      ((input P Col)
       (NOT (&link_between P)))))
