;; 4f537728

(DET &bg DominantColor)

(DET &base SharedColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&base (:C Col))))

(RULE &painted
  (input *P *Col)
  (&base (:C Col))
  (&mark (:P *P_mark))
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P_mark) (:D D_m2) (:K K_m3)))

(ALTS $choice "how far the mark color spreads" $Cell
  (ALT $Block
    (RULE &blocks_divider_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &inked_line_split1
      (input (:P *P_) *Col)
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &blocks_divider
      (input *P)
      (axis_elem *A)
      (&blocks_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
      (ALL ((input (:P *Pm) *Col)
            (axis_elem (:A *Am))
            (&inked_line_split1 (:P_ Pm) (:A_ Am) (:L_ L) (:X_m1_ *X_m1m)))
           ((&bg (:C Col)))))

    (RULE &blocks_on_divider
      (input *P)
      (&blocks_divider *A *L)
      (axis_of *D A)
      (margin (:B P) D (:K *K_m1))
      (margin (:B L) D (:K K_m1)))

    (INIT &blocks_rank Order
      (key ((OR ((&blocks_divider *A *L)
                 (axis_of ^D A)
                 (margin (:B L) D *K))
                ((input *P)
                 (dir_elem D)
                 (margin (:B P) D K))))
        (member ((:t K))
          (&blocks_divider *A *L)
          (axis_of D A)
          (margin (:B L) D *K))
        (score ((:t K) (:S K))
          (OR ((&blocks_divider *A *L)
               (axis_of D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
        (probe ((:t K))
          (input *P)
          (dir_elem D)
          (margin (:B P) D *K))))

    (RULE &blocks_part_idx
      (input *P)
      (axis_of *D *A)
      (NOT (&blocks_on_divider P A))
      (margin (:B P) D *K)
      (&blocks_rank.rank (:key D) (:t K) (:R *N)))

    (RULE &blocks_part_of
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&blocks_part_idx *P D (:N *N1))
      (&blocks_part_idx P (:D D2) (:N *N2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K N1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

    (RULE &blocks_tile_of
      (&blocks_part_of *P *A (:P_part *P1))
      (perp A *A2)
      (&blocks_part_of P (:A A2) (:P_part *P2))
      (compose (:A P1) (:B P2) (:C *P_tile)))

    (RULE &painted
      (&blocks_tile_of *P *P_tile)
      (&mark (:P *P_mark))
      (&blocks_tile_of (:P P_mark) (:P_tile *P_tile_mark))
      (axis_elem *A)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P_tile) (:D D_m2) (:K *K_m3))
      (margin (:B P_tile_mark) (:D D_m2) (:K K_m3)))))

(RULE &output
  (OR ((&painted *P)
       (&mark *Col))
      ((input P Col)
       (NOT (&painted P)))))
