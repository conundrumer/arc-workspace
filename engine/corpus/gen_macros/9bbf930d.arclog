;; 9bbf930d

(INPUT wall "the edge on &wall_dir is a solid line of one ink, and the line inside it is blank"

  ;; The edge the wall lies on.
  (DET &wall_dir DirDomain)

  ;; The one color of each edge's cells.
  (INIT &edge_color Singleton
    (key ((dir_elem ^D))
      (member ((:v Col))
        (input *P *Col)
        (margin (:B P) D (:K 0))))))

(INPUT pipes "a pipe is two parallel bars of one ink with a one-cell blank channel between them; a pipe may bend, and a pipe's mouth faces the wall")

(OUTPUT inlet "a wall cell opens — takes the blank color — when the blank run inward from it reaches a pipe's channel")

(OUTPUT roll "the ink of an opened wall cell rolls inward: it runs straight through blank cells until blocked, follows a bend at a corner where a pipe of one ink turns, and lands where it is blocked outside a bend or meets the grid edge"

  (RULE &run_dir
    (dir_elem *D))

  (DET &bg DominantColor)

  (RULE &blank
    (input *P *Col)
    (&bg (:C Col)))

  (RULE &run_node
    (&blank *P))

  (RULE &run_source
    (&blank *P))

  (INIT &run Distance
    (key ((&run_source (:P ^O))
          (&run_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&run_source (:P O))
             (&run_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&run_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&run_node (:P Q)))
            ((&run_source (:P O))
             (&run_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&run_node (:P Q))
             (= A2 O))
            ((&run_source (:P O))
             (&run_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&run_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&run_node (:P Q)))))
      (source ((:n O))
        (&run_source (:P O))
        (&run_dir D))))

  (RULE &run_ray
    (&run.distance (:key *D (:O *Origin)) (:n *P) *K))

  (RULE &run_end
    (&run_ray *P *D *K *Origin)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (NOT (&run_ray (:P Q) D Origin)))

  (RULE &wall_side
    (&wall_dir *D))

  (RULE &wall
    (&wall_side *D)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (margin (:B P) D (:K 0)))

  (RULE &walled
    (&blank *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (input (:P Q) *Col)
    (NOT (&bg (:C Col))))

  (RULE &channel
    (perp *A (:A2 *A_across))
    (axis_of (:D *D1) (:A A_across))
    (opposite (:D D1) (:Opp *D2))
    (&walled *P (:D D1) *Col)
    (&walled P (:D D2) Col))

  (RULE &channel_turn
    (&blank (:P *Q))
    (axis_of *D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *D2) (:A A2_m2))
    (opposite D (:Opp *D_back))
    (step_offset (:D D_back) (:V *V_m3))
    (compose (:A Q) (:B V_m3) (:C *B))
    (axis_of D *A)
    (&channel (:P B) A *Col)
    (step_offset (:D D2) (:V *V_m4))
    (compose (:A Q) (:B V_m4) (:C *N))
    (axis_of (:D D2) (:A *A2))
    (&channel (:P N) (:A A2) Col))

  (RULE &bend
    (&channel_turn *Q *D *D2 *Col)
    (&walled (:P Q) D Col)
    (opposite (:D D2) (:Opp *D_side))
    (&walled (:P Q) (:D D_side) Col))

  (RULE &mouth
    (&wall (:P *P_wall))
    (&wall_side (:D *D_wall))
    (opposite (:D D_wall) (:Opp *D))
    (step_offset D (:V *V_m1))
    (compose (:A P_wall) (:B V_m1) (:C *Q))
    (&blank (:P Q)))

  (RULE &inlet
    (&mouth (:P_wall *P) *Q *D)
    (axis_of D *A)
    (OR ((&channel (:P Q) A))
        ((&run_ray (:P *R) D (:K *N) (:Origin Q))
         (> N 0)
         (&channel (:P R) A))))

  (RULE &roller
    (&inlet (:P *P_wall)))

  ;; The roll: from the end of the run inward from the mouth, each bend turns
  ;; the ink into a new run.
  (INIT &roll Propagation
    (key ((&roller (:P_wall ^P0)))
      (source ((:n (:P R) D))
        (&mouth (:P_wall P0) *Q *D)
        (&run_end (:P *R) D (:Origin Q))))
    (edge ((:a (:P Q) D) (:b (:P R) (:D D2)))
      (&bend *Q *D *D2)
      (&run_end (:P *R) (:D D2) (:Origin Q)))))

(OUTPUT keep "every other cell keeps its color")

(ALTS $follow "what the rolling ink follows around a corner" $Pipe
  (ALT $Channel
    (OUTPUT roll "the ink follows the blank channel of a pipe around its bend, whether or not the outer bar closes the far side"
      (RULE &bend
        (&channel_turn *Q *D *D2 *Col)
        (&walled (:P Q) D Col))))
  (ALT $Exit
    (OUTPUT roll "the ink, stopped in a channel, turns to the side the channel opens"
      (RULE &bend
        (&walled (:P *Q) *D)
        (opposite D (:Opp *D_back))
        (step_offset (:D D_back) (:V *V_m1))
        (compose (:A Q) (:B V_m1) (:C *B))
        (axis_of D *A)
        (&channel (:P B) A)
        (axis_of D (:A *A_m2))
        (perp (:A A_m2) (:A2 *A2_m3))
        (axis_of (:D *D2) (:A A2_m3))
        (step_offset (:D D2) (:V *V_m4))
        (compose (:A Q) (:B V_m4) (:C *N))
        (&blank (:P N))
        (opposite (:D D2) (:Opp *D_side))
        (&walled (:P Q) (:D D_side))))))

(ALTS $open "what opens the wall" $Reach
  (ALT $Mouth
    (OUTPUT inlet "a wall cell opens where a pipe's mouth faces it across a clear lane, with no ink beside the lane before the channel"
      (RULE &lane_blocked
        (&mouth *P_wall *Q *D)
        (&run_ray (:P *S) D (:K *N) (:Origin Q))
        (> N 0)
        (&run_ray (:P *R) D (:K N) (:Origin S))
        (> N 0)
        (!= S R)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *D_perp) (:A A2_m2))
        (&walled (:P S) (:D D_perp)))

      ;; Mouth adds to Reach that no ink lies beside the lane before the channel.
      (RULE &inlet
        (&mouth (:P_wall *P) *Q *D)
        (axis_of D *A)
        (OR ((&channel (:P Q) A))
            ((&run_ray (:P *R) D (:K *N) (:Origin Q))
             (> N 0)
             (&channel (:P R) A)
             (NOT (&lane_blocked (:P_wall P) R))))))))

(ALTS $locate "how the wall is located" $Stored
  (ALT $Derived
    (INPUT wall "the wall is the edge that is a solid line of one ink, and the line inside it is blank"
      (RULE &wall_side
        (&edge_color.value (:key *D) (:v *Col))
        (NOT (&bg (:C Col)))))))

(RULE &landing
  (&roll.reached (:key (:P0 *P_wall)) (:n *P *D))
  (NOT (&bend (:Q P) D)))

(RULE &output
  (OR ((&inlet *P)
       (&bg (:C *Col)))
      ((&landing (:P_wall *P0) P)
       (&wall (:P P0) Col))
      ((input P Col)
       (NOT (&inlet P))
       (NOT (&landing P)))))
