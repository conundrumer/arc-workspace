;; 50f325b5

(DET &field ColorDomain)

(DET &mark RarestColor)

(RULE &mark2
  (&mark (:C *Col)))

(ALTS $choice "which color draws the shape" $Stored
  (ALT $Minority
    (INIT &size Cardinality
      (key ((input *P ^Col))
        (member ((:m P))
          (input *P Col))))

    (INIT &rare Order
      (member ((:t (:V Col) (:S N)))
        (&size.size (:key *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&size.size (:key *Col) *N)))

    (RULE &mark2
      (&rare.minimal (:t (:V *Col))))))

;; Every D4 image of the drawn shape, sought among the field cells.
(INIT &seek Occurrences
  (key ((d4_elem ^D))
    (shape ((:P P_img))
      (input *P *Col)
      (&mark2 Col)
      (apply D P (:P_out *P_img))))
  (cell (P)
    (input *P *Col)
    (&field (:C Col))))

(RULE &stamped
  (&seek.occurrence (:key *D) (:P *Sh))
  (&seek.shape (:key D) (:P *P_img))
  (compose (:A Sh) (:B P_img) (:C *P)))

(RULE &output
  (OR ((&stamped *P)
       (&mark2 *Col))
      ((input P Col)
       (NOT (&stamped P)))))
