;; 7e4d4f7c

(RULE &out_cell_split1
  (input (:P *P_in_))
  (axis_of (:D *H_dir) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_in_) (:X_rel *P_across_)))

(INIT &bg_count Cardinality
  (key ((input *P (:Col ^C)))
    (member ((:m P))
      (input *P (:Col C)))))

(DET &header_dir DirDomain)

(DET &out_h ConstOutDim)

(DET &marker ChangedColor)

;; Along-axis frame for the output: out_h cells on header_dir's axis.
(INIT &out_along Frame
  (key ((&header_dir *D)
        (axis_of D ^A)
        (&out_h *N))
    (extent (A N)
      (&header_dir *D)
      (axis_of D A)
      (&out_h *N))))

(INIT &bg Order
  (member ((:t C))
    (&bg_count.size (:key *C)))
  (score ((:t C) (:S N))
    (&bg_count.size (:key *C) *N)))

(RULE &out_cell
  (&header_dir (:D *H_dir))
  (axis_of (:D H_dir) *A)
  (&out_along.cell (:key A) (:P *P_along))
  (input (:P *P_in))
  (&out_cell_split1 (:P_in_ P_in) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across))
  (compose (:A P_along) (:B P_across) (:C *P)))

;; The tail row matches its input cells on the across line alone: it does
;; not share depth-from-header with input row 0.
(RULE &output
  (&out_cell *P)
  (&header_dir (:D *H_dir))
  (opposite (:D H_dir) (:Opp *H_opp))
  (OR ((NOT (margin (:B P) (:D H_opp) (:K 0)))
       (input (:P *P_in) *Col)
       (margin (:B P_in) (:D H_dir) (:K *K_m1))
       (margin (:B P) (:D H_dir) (:K K_m1))
       (axis_of (:D H_dir) (:A *A_m2))
       (perp (:A A_m2) (:A2 *A2_m3))
       (axis_of (:D *E_m4) (:A A2_m3))
       (opposite (:D E_m4) (:Opp *E2_m5))
       (margin (:B P_in) (:D E_m4) (:K *K1_m6))
       (margin (:B P) (:D E_m4) (:K K1_m6))
       (margin (:B P_in) (:D E2_m5) (:K *K2_m7))
       (margin (:B P) (:D E2_m5) (:K K2_m7)))
      ((margin (:B P) (:D H_opp) (:K 0))
       (axis_of (:D H_dir) *A)
       (input (:P P_in) (:Col *Col_in))
       (margin (:B P_in) (:D H_dir) (:K 0))
       (perp A (:A2 *A2_m8))
       (axis_of (:D *D_m9) (:A A2_m8))
       (margin (:B P_in) (:D D_m9) (:K *K_m10))
       (margin (:B P) (:D D_m9) (:K K_m10))
       (IF ((&bg.maximal (:t Col_in)))
           ((= Col Col_in))
           ((&marker (:C Col)))))))
