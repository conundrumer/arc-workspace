;; 070dd51e

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &bet_axis
  (&mark (:Col *Key))
  (axis_elem *A))

(RULE &bet_dir
  (&bet_axis *Key *A)
  (axis4_of *D A))

(RULE &bet_node
  (&bet_axis *Key)
  (input *P))

(RULE &bet_source
  (&mark (:Col *Key) *P))

(INIT &bet Distance
  (key ((&bet_source (:Key ^Ky) (:P ^O))
        (&bet_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&bet_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&bet_node (:Key Ky) (:P Q)))
          ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&bet_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&bet_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&bet_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&bet_source (:Key Ky) (:P O))
      (&bet_dir (:Key Ky) D))))

(RULE &bet_ray
  (&bet.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &bet_between
  (&mark (:Col *Key))
  (input *P)
  (&bet_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&bet_ray Key P D)
  (&bet_ray Key P (:D O)))

(RULE &bet_end
  (&bet_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&bet_ray Key (:P Q) D Origin)))

(DET &over_axis AxisDomain)

(RULE &line_axis
  (&mark *Col *P)
  (&mark Col (:P *Q))
  (!= P Q)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &span
  (&bet_between (:Key *Col) *P)
  (&line_axis Col *A))

(RULE &over_span
  (&span *P *A)
  (&over_axis A))

(RULE &top_span
  (OR ((&span *P *Col *A)
       (&over_axis A))
      ((&span P Col)
       (NOT (&over_span P)))))

(ALTS $choice "Cases split what a span may paint" $PaintAll
  (ALT $PaintBg
    (RULE &output
      (OR ((input *P (:Col *Bg))
           (&bg (:C Bg))
           (OR ((&top_span P *Col))
               ((NOT (&top_span P))
                (= Col Bg))))
          ((input P Col)
           (NOT (&bg (:C Col))))))))

(RULE &output
  (OR ((&top_span *P *Col))
      ((input P Col)
       (NOT (&top_span P)))))
