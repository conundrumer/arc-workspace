;; 3cd86f4f

(DET &sense SenseDomain)

(DET &slide AxisDomain)

(RULE &shear
  (input (:P *P_in))
  (&slide *A)
  (perp A *A2)
  (axis_of (:D *D_m) (:A A2))
  (&sense *S)
  (turn S (:D D_m) (:D2 *D_push))
  (opposite (:D D_m) (:Opp *O_m1))
  (margin (:B P_in) (:D D_m) (:K *K_m))
  (margin (:B P_in) (:D O_m1) (:K *K_o))
  (opposite (:D D_push) (:Opp *O_m2))
  (edge_inset (:D D_push) (:K K_m) (:B *B1_m3))
  (edge_inset (:D O_m2) (:K K_o) (:B *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *Delta))
  (compose (:A P_in) (:B Delta) (:C *P_out)))

(RULE &image
  (&shear (:P_out *P)))

(RULE &frame_split1
  (&image (:P *P1_))
  (&slide (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P1_) (:D D_m1) (:K *K1_m3))
  (margin (:B P1_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P1_) (:X_rel *X_m1_)))

(RULE &frame_split2
  (&image (:P *P2_))
  (&slide (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X P2_) (:X_rel *Across_)))

(DET &bg AnyOutNewColor)

(RULE &frame
  (&image (:P *P1))
  (&image (:P *P2))
  (&slide *A)
  (&frame_split1 (:P1_ P1) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1))
  (&frame_split2 (:P2_ P2) (:A_ A) (:X_m2_ *X_m2) (:Across_ *Across))
  (compose (:A Along) (:B Across) (:C *P)))

(RULE &output
  (OR ((input (:P *P_in) *Col)
       (&shear P_in (:P_out *P)))
      ((&frame P)
       (NOT (&image P))
       (&bg (:C Col)))))
