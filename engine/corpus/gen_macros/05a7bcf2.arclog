;; 05a7bcf2

(RULE &wall_cast_dir
  (dir_elem *D))

(RULE &wall_cast_node
  (input *P))

(DET &wall UnchangedColor)

(RULE &wall_cell
  (input *P *Col)
  (&wall (:C Col)))

(RULE &wall_cast_source
  (&wall_cell *P))

;; From the wall toward the push structure, and on to the far edge.
(INIT &wall_cast Distance
  (key ((&wall_cast_source (:P ^O))
        (&wall_cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&wall_cast_source (:P O))
           (&wall_cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&wall_cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&wall_cast_node (:P Q)))
          ((&wall_cast_source (:P O))
           (&wall_cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&wall_cast_node (:P Q))
           (= A2 O))
          ((&wall_cast_source (:P O))
           (&wall_cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&wall_cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&wall_cast_node (:P Q)))))
    (source ((:n O))
      (&wall_cast_source (:P O))
      (&wall_cast_dir D))))

(RULE &wall_cast_ray
  (&wall_cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &wall_cast_end
  (&wall_cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&wall_cast_ray (:P Q) D Origin)))

(DET &push SharedColor)

(RULE &push_cell
  (input *P *Col)
  (&push (:C Col)))

(RULE &dir
  (dir_elem *D)
  (&wall_cast_ray *P D)
  (&push_cell P))

(RULE &cast_dir
  (&dir *D))

(RULE &cast_node
  (input *P))

(DET &shape ChangedColor)

(RULE &shape_cell
  (input *P *Col)
  (&shape (:C Col)))

(RULE &cast_source
  (&shape_cell *P))

;; The shape casts toward the wall; the wall's fill reaches on past it.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &reach_dir
  (&dir *D))

(RULE &reach_node
  (input *P))

(RULE &reach_source
  (&wall_cell *P))

(INIT &reach Distance
  (key ((&reach_source (:P ^O))
        (&reach_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&reach_source (:P O))
           (&reach_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&reach_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&reach_node (:P Q)))
          ((&reach_source (:P O))
           (&reach_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&reach_node (:P Q))
           (= A2 O))
          ((&reach_source (:P O))
           (&reach_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&reach_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&reach_node (:P Q)))))
    (source ((:n O))
      (&reach_source (:P O))
      (&reach_dir D))))

(RULE &reach_ray
  (&reach.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &reach_end
  (&reach_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&reach_ray (:P Q) D Origin)))

(DET &mark AnyOutNewColor)

(RULE &short
  (input *P)
  (&dir *D)
  (NOT (&cast_ray P D)))

(RULE &gap
  (&cast_ray *P *D)
  (NOT (&reach_ray P D))
  (NOT (&shape_cell P)))

(RULE &through
  (&reach_ray *P *D)
  (&cast_ray P D))

;; It travels until it rests against the far edge.
(INIT &slide Distance
  (source_distance (K)
    (&push_cell *P)
    (&dir *D)
    (margin (:B P) D *K)))

(RULE &placed
  (&slide.distance *K)
  (&dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (&push_cell (:P *P3))
  (compose (:A P3) (:B V) (:C *P)))

(ALTS $choice "Two models of how it gets there" $Slide
  (ALT $Pack
    ;; Each push cell falls toward the far edge and stacks on those ahead of it.
    (INIT &fall Distance
      (weight ((:a P2) (:b P) (:W K))
        (&push_cell *P)
        (&dir *D)
        (&push_cell (:P *P2))
        (!= P P2)
        (gap D P (:Q P2) *K))
      (source_distance ((:n P) K)
        (&push_cell *P)
        (&dir *D)
        (margin (:B P) D *K)))

    (RULE &placed
      (&fall.distance (:n *P3) *K)
      (&dir *D)
      (dir8_opposite D (:D2 *O_m1))
      (edge_inset (:D O_m1) K (:B *B1_m2))
      (edge_inset D K (:B *I_m4))
      (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *V))
      (compose (:A P3) (:B V) (:C *P)))))

(RULE &output
  (OR ((input *P *Col)
       (&short P))
      ((&shape_cell P)
       (&mark (:C Col)))
      ((&gap P)
       (&shape (:C Col)))
      ((&through P)
       (IF ((&placed P))
           ((&push (:C Col)))
           ((&wall (:C Col)))))))
