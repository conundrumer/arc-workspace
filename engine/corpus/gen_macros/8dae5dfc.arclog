;; 8dae5dfc

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; An object is a component of the non-background cells.
(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(RULE &fused_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &object
  (&objs_component *P *Id))

(RULE &fused_node
  (&object *P)
  (input P (:Col *Key)))

;; A layer is a same-color component of an object: adjacent rings of one
;; color fuse.
(INIT &fused Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&fused_node (:Key *Ky) *P)
         (&fused_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&fused_node (:Key Ky) (:P P2)))
        ((&fused_node (:Key Ky) P)
         (= P2 P)))))

(RULE &fused_component
  (&fused.class (:a *Key *P) *Id))

(RULE &peel_depth_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The objects peel into rings; depth counts the rings outside a cell.
(INIT &peel Boundary
  (cell (P)
    (&object *P)))

(INIT &peel_depth Distance
  (edge ((:a P) (:b P2))
    (&object *P)
    (&peel_depth_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&object (:P P2)))
  (source ((:n P))
    (&peel.boundary *P)))

(RULE &layer
  (&fused_component *P *Id))

;; A layer's depth is the depth of its outermost ring.
(INIT &layer_depth Order
  (key ((&layer *P ^Id)
        (&peel_depth.distance (:n P) *K))
    (member ((:t K))
      (&layer *P Id)
      (&peel_depth.distance (:n P) *K))
    (score ((:t K) (:S K))
      (&layer *P Id)
      (&peel_depth.distance (:n P) *K))))

(RULE &nest_elem
  (&object *P (:Id *Obj))
  (&layer P *Id))

;; The layers of an object, ordered from the outside in.
(INIT &nest Order
  (key ((&nest_elem ^Obj *Id))
    (member ((:t Id))
      (&nest_elem Obj *Id))
    (before ((:a Id) (:b Id2))
      (&nest_elem Obj *Id)
      (&nest_elem Obj (:Id *Id2))
      (&layer_depth.minimal (:key Id) (:t *K))
      (&layer_depth.minimal (:key (:Id Id2)) (:t *K2))
      (< K K2))))

(RULE &output
  ;; The background stays.
  (OR ((input *P *Col)
       (&bg (:C Col)))
      ;; A layer takes the color of the layer as deep from the inside as it is from
      ;; the outside.
      ((&layer P *Id)
       (&nest.rank (:key *Obj) (:t Id) *R)
       (&nest.dual_rank (:key Obj) (:t *Id2) R)
       (&layer (:P *P2) (:Id Id2))
       (input (:P P2) Col))))
