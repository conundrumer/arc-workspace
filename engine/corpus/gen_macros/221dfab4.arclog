;; 221dfab4

;; The segment's color.
(DET &marker_col RarestColor)

(RULE &marker
  (&marker_col (:C *Col))
  (input *P Col))

;; Each marker cell's distance from edge D.
(INIT &marker_dist Singleton
  (key ((dir_elem ^D))
    (member ((:v K))
      (&marker (:P *M))
      (margin (:B M) D *K))))

(RULE &step_dir
  (dir_elem *D)
  (&marker)
  (NOT (&marker_dist.plural (:key D))))

(RULE &ray_dir
  (&step_dir *D))

(RULE &ray_node
  (&step_dir *D)
  (input *P))

(RULE &marker_line
  (input *P)
  (&step_dir *D)
  (&marker (:P *M))
  (margin (:B P) D (:K *K_m1))
  (margin (:B M) D (:K K_m1)))

(RULE &ray_source
  (&marker_line *P))

(INIT &ray Distance
  (key ((&ray_source (:P ^O))
        (&ray_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&ray_source (:P O))
           (&ray_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ray_node (:P Q)))
          ((&ray_source (:P O))
           (&ray_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&ray_node (:P Q))
           (= A2 O))
          ((&ray_source (:P O))
           (&ray_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ray_node (:P Q)))))
    (source ((:n O))
      (&ray_source (:P O))
      (&ray_dir D))))

(RULE &ray_ray
  (&ray.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &ray_end
  (&ray_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ray_ray (:P Q) D Origin)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The beam's color.
(DET &beam_col AnyOutNewColor)

(RULE &corridor
  (input *P)
  (&step_dir *D)
  (axis_of D *A)
  (&marker (:P *M))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B M) (:D D_m2) (:K K_m3)))

(RULE &ray_cell
  (input *P))

(RULE &offset
  (&ray_ray *P *K)
  (&ray_cell P))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(DET &role
  (&corridor *E *P)
  (&offset E P *K)
  (ex_output E P *Col))

(DET &cand
  (&role (:K *W))
  (!= W 0))

;; The colors carried at each phase of a candidate repeat. Keyed per
;; example: the cleared phases hold the example's own background.
(INIT &phase_color Singleton
  (key ((&cand ^W)
        (&role ^E (:K *T) *Col)
        (divide T (:Side W) (:Gap 0) (:Remainder ^K)))
    (member ((:v Col))
      (&cand W)
      (&role E (:K *T) *Col)
      (divide T (:Side W) (:Gap 0) (:Remainder K)))))

(DET &period_break
  (&phase_color.plural (:key *W)))

(INIT &least Order
  (member ((:t W))
    (&cand *W)
    (NOT (&period_break W)))
  (score ((:t W) (:S W))
    (&cand *W)
    (NOT (&period_break W))))

(DET &period
  (&least.minimal (:t *W)))

(RULE &phase
  (&offset *P (:K *T))
  (&period *W)
  (divide T (:Side W) (:Gap 0) (:Remainder *K)))

(DET &beam_phase
  (&period *W)
  (&phase_color.value (:key W *K) (:v *Col))
  (&beam_col (:C Col)))

(DET &copy_phase
  (&period *W)
  (&phase_color.value (:key W *K) (:v *Col))
  (&marker_col (:C Col)))

(RULE &paint
  (OR ((&corridor *P)
       (&phase P *K)
       (OR ((&copy_phase K)
            (&marker_col (:C *Col)))
           ((&beam_phase K)
            (&beam_col (:C Col)))
           ((NOT (&copy_phase K))
            (NOT (&beam_phase K))
            (&bg Col))))
      ((input P (:Col *C_in))
       (NOT (&bg (:Col C_in)))
       (&phase P (:K *K2))
       (&beam_phase (:K K2))
       (&beam_col (:C Col)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
