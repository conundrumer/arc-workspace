;; 890034e9

;; The rectangle outlines each color draws.
(INIT &drect Outlines
  (key ((input *P ^Col))
    (node (P)
      (input *P Col))))

(RULE &on_edge_inside1
  (input (:P *P_))
  (&drect.box (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &on_edge
  (&drect.box *B)
  (input *P)
  (NOT (&on_edge_inside1 (:P_ P) (:B_ B)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2)))

(RULE &frame
  (&drect.box (:key *Col) *B)
  (ALL ((&drect.box (:key (:Col *Colm)) B)
        (input *P (:Col Colm)))
       ((&on_edge B P))))

(RULE &hole
  (&frame *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

;; The hole's twins, the hole itself among them: the cases value the hole's
;; cells differently.
(INIT &occ Occurrences
  (key ((OR ((&frame ^B)
             (input *P *Col))
            ((&hole B (:P *S))
             (input (:P S) Col))))
    (cell (P (:v Col))
      (&frame B)
      (input *P *Col))
    (shape ((:P S) (:v Col))
      (&hole B (:P *S))
      (input (:P S) *Col))))

(ALTS $choice "what the hole's twin is" $Content
  (ALT $Empty
    (DET &bg SharedColor)

    ;; The hole's twins, the hole itself among them: the cases value the hole's
    ;; cells differently.
    (INIT &occ Occurrences
      (key ((OR ((&frame ^B)
                 (input *P *Col))
                ((&hole B (:P *S))
                 (&bg (:C Col)))))
        (cell (P (:v Col))
          (&frame B)
          (input *P *Col))
        (shape ((:P S) (:v Col))
          (&hole B (:P *S))
          (&bg (:C *Col)))))))

(RULE &twin
  (&occ.occurrence (:key *B) (:P *M))
  (&hole B (:P *S))
  (compose (:A M) (:B S) (:C *P)))

(RULE &outline
  (&twin *B (:P *P2))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P)
  (NOT (&twin B P)))

(RULE &output
  (OR ((&outline *B *P)
       (&frame *Col B))
      ((input P Col)
       (NOT (&outline P)))))
