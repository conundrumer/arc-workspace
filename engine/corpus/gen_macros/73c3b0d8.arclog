;; 73c3b0d8

(DET &move_dir DirDomain)

(RULE &splash_dir
  (&move_dir (:D *D2))
  (opposite (:D D2) (:Opp *Back))
  (corner_dir (:C *D) (:A *A_m1) (:D Back))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m2)))

(RULE &splash_dir2
  (&splash_dir *D))

(RULE &splash_node
  (input *P))

(DET &mark ChangedColor)

(RULE &landed
  (input (:P *P2) *Col)
  (&mark (:C Col))
  (&move_dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

(DET &wall UnchangedColor)

(RULE &hit
  (&landed *P)
  (&move_dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&wall (:C Col)))

(RULE &splash_source
  (&hit *P))

(INIT &splash Distance
  (key ((&splash_source (:P ^O))
        (&splash_dir2 ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&splash_source (:P O))
           (&splash_dir2 D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&splash_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&splash_node (:P Q)))
          ((&splash_source (:P O))
           (&splash_dir2 D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&splash_node (:P Q))
           (= A2 O))
          ((&splash_source (:P O))
           (&splash_dir2 D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&splash_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&splash_node (:P Q)))))
    (source ((:n O))
      (&splash_source (:P O))
      (&splash_dir2 D))))

(RULE &splash_ray
  (&splash.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &splash_end
  (&splash_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&splash_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(RULE &painted
  (OR ((&landed *P))
      ((&splash_ray P))))

(RULE &output
  (input *P (:Col *C_in))
  (OR ((&painted P)
       (&mark (:C *Col)))
      ((NOT (&painted P))
       (&mark (:C C_in))
       (&bg (:C Col)))
      ((NOT (&painted P))
       (NOT (&mark (:C C_in)))
       (= Col C_in))))
