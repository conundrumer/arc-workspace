;; a2fd1cf0

(INPUT two-markers "a background of 0 holds exactly one &start_color cell and one &end_color cell, in different rows and different columns"

  (DET &end_color RarestColor)

  (DET &start_color RarestColor))

(OUTPUT corner "the corner cell lies on the &start_axis line of the &start_color cell and on the other axis's line of the &end_color cell"

  ;; The axis of the leg through the start_color cell; the leg through the end_color cell runs on the other axis.
  (DET &start_axis AxisDomain))

(OUTPUT l-path "the output paints &path_color on every cell strictly between the &start_color cell and the corner, on the corner, and on every cell strictly between the corner and the &end_color cell"

  (INIT &field_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (DET &path_color AnyOutNewColor)

  (INIT &field Order
    (member ((:t Col))
      (&field_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&field_count.size (:key *Col) *N))))

(OUTPUT keep "every other cell keeps its input color"

  ;; The one cell of each color.
  (INIT &mark Singleton
    (key ((input *P ^Col))
      (member ((:v P))
        (input *P Col))))

  (RULE &leg
    (&mark.value (:key *Col) (:v *P))
    (&start_axis (:A *A2))
    (OR ((&end_color (:C Col))
         (perp (:A A2) (:A2 *A)))
        ((&start_color (:C Col))
         (= A A2))))

  (RULE &span_dir
    (&leg (:Col *Key) *A)
    (axis4_of *D A))

  (RULE &span_node
    (&leg (:Col *Key) *A)
    (input *P))

  (RULE &corner
    (input *P)
    (&leg (:P *P1) (:A *A1))
    (perp (:A A1) (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P) (:D D_m2) (:K *K_m3))
    (margin (:B P1) (:D D_m2) (:K K_m3))
    (&leg (:P *P2) (:A *A2))
    (perp (:A A1) A2)
    (perp (:A A2) (:A2 *A2_m4))
    (axis_of (:D *D_m5) (:A A2_m4))
    (margin (:B P) (:D D_m5) (:K *K_m6))
    (margin (:B P2) (:D D_m5) (:K K_m6)))

  (RULE &span_mark
    (OR ((&leg (:Col *Key) *P))
        ((&leg (:Col Key))
         (&corner P))))

  (RULE &span_source
    (&span_mark *Key *P))

  ;; Each leg runs from its marker to the corner.
  (INIT &span Distance
    (key ((&span_source (:Key ^Ky) (:P ^O))
          (&span_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&span_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&span_node (:Key Ky) (:P Q)))
            ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&span_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&span_source (:Key Ky) (:P O))
             (&span_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&span_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&span_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&span_source (:Key Ky) (:P O))
        (&span_dir (:Key Ky) D))))

  (RULE &span_ray
    (&span.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (RULE &span_between
    (&leg (:Col *Key))
    (input *P)
    (&leg (:Col Key) *A)
    (axis4_of *D A)
    (dir8_opposite D (:D2 *O))
    (&span_ray Key P D)
    (&span_ray Key P (:D O)))

  (RULE &path
    (&span_between (:Key *Col) *P)
    (&leg Col (:P *M))
    (!= P M)))

(ALTS $choice "what the path does to a path cell that is not background" $PaintAll
  (ALT $KeepMarkers
    (OUTPUT l-path "the path paints the same cells, except that the &start_color and &end_color cells keep their color")
    (RULE &painted
      (&path *P)
      (NOT (&leg P))))
  (ALT $BackgroundOnly
    (OUTPUT l-path "the path paints &path_color only on its cells that hold &bg"
      (DET &bg DominantColor)

      (RULE &background
        (&bg *C)))
    (RULE &painted
      (&path *P)
      (input P (:Col *Bg))
      (&background (:C Bg)))
    (ALTS $bg "where the background color comes from" $StoredBg
      (ALT $DominantBg
        (OUTPUT l-path "the background the path paints over is the input's most frequent color"
          (RULE &background
            (&field.maximal (:t *C))))))))

(RULE &span_end
  (&span_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray Key (:P Q) D Origin)))

(RULE &painted
  (&path *P))

(RULE &output
  (&corner)
  (input *P (:Col *C_in))
  (IF ((&painted P))
      ((&path_color (:C *Col)))
      ((= Col C_in))))
