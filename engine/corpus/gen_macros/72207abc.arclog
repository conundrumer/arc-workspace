;; 72207abc

(DET &grow DirDomain)

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The seeds run in order of nearness to the grow edge.
(INIT &order Order
  (member ((:t P))
    (&ink *P))
  (before ((:a P1) (:b P2))
    (&ink (:P *P1))
    (&ink (:P *P2))
    (&grow *D)
    (dir_elem D)
    (margin (:B P2) D (:K *K1_m1))
    (margin (:B P1) D (:K *K2_m2))
    (< K1_m1 K2_m2)))

(RULE &seed_next
  (OR ((&order.successor (:a *P1) (:b *P2)))
      ((&order.maximal (:t P1))
       (&order.minimal (:t P2)))))

(RULE &jump_size
  (input *P)
  (&grow *D)
  (margin (:B P) D *K)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta)))

;; The first seed arrives with no jump; each step lengthens the jump by one
;; cell, and the walk stops where it leaves the grid.
(INIT &grown Distance
  (edge ((:a (:P P1) (:Delta V1)) (:b (:P P2) (:Delta V2)))
    (input (:P *P1))
    (&jump_size (:Delta *V1))
    (&grow *D)
    (step_offset D (:V *V_m1))
    (compose (:A V1) (:B V_m1) (:C *V2))
    (compose (:A P1) (:B V2) (:C *P2))
    (input (:P P2)))
  (source ((:n P Delta))
    (&order.minimal (:t *P))
    (= *Delta 0)))

;; Each step advances the color cursor one seed.
(INIT &cursor Walk
  (successor ((:p P1) (:p_next P2))
    (&seed_next *P1 *P2))
  (steps (N)
    (&grown.distance (:K *N))))

(RULE &marked
  (OR ((&ink *P *Col))
      ((&grown.distance (:n P) (:K *N))
       (&order.minimal (:t *P0))
       (&cursor.walk (:p0 P0) N (:p *Q))
       (&ink (:P Q) Col))))

(RULE &output
  (OR ((&marked *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&marked P)))))
