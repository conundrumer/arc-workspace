;; 82819916

;; Lines run along this axis.
(DET &axis AxisDomain)

(RULE &cell_split_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *P_line_)))

(DET &bg DominantColor)

(RULE &cell_split
  (input *P *Col)
  (&axis *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:P_line_ *P_line)))

(RULE &blank
  (&cell_split *Col *P_line)
  (&bg (:C Col)))

(RULE &template_color
  (&cell_split (:Col *C) *P_along (:P_line *P_tpl))
  (NOT (&blank (:P_line P_tpl))))

(RULE &recolor
  (&cell_split (:Col *C) *P_along *P_line)
  (NOT (&bg C))
  (&template_color P_along (:C *C_tpl)))

(RULE &output
  (&cell_split *P (:Col *C_in) *P_along *P_line)
  (OR ((&template_color P_along (:C *C_tpl))
       (&recolor P_line C_tpl (:C *Col)))
      ((ALL ((&cell_split (:Col *Colmm) P_line))
            ((&bg (:C Colmm))))
       (= Col C_in))))
