;; a61f2674

(INPUT bar-color "the bars are drawn in &bar_color on a &background field"

  (DET_OR_RULE &bar_color RarestColor)

  (DET_OR_RULE &background DominantColor)

  (INIT &sole Singleton
    (member ((:v Col))
      (input *Col)
      (NOT (&background Col)))))

(INPUT bars "vertical bars stand on the &gravity_side edge, each one column wide, with an empty column between neighbors; a bar is a 4-connected component of the bar-color cells"

  (RULE &bar_color2
    (&bar_color *Col))

  (RULE &ink
    (input *P *Col)
    (&bar_color2 Col))

  (RULE &bars8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  ;; The edge the bars stand on.
  (DET &gravity_side DirDomain)

  (INIT &bars8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&bars8_steps (:Delta *S2))
           (compose (:A P) (:B S2) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P))))))

(INPUT distinct-heights "the bars have pairwise different heights")

(OUTPUT height "a bar's height is the number of lines it spans along the axis of &gravity_side"

  ;; The lines along the gravity axis, each as one unit.
  (INIT &lines Quotient
    (equivalent ((:a P) (:b Q))
      (input *P)
      (input (:P *Q))
      (&gravity_side *D)
      (axis_of D *A)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P) (:D D_m2) (:K *K_m3))
      (margin (:B Q) (:D D_m2) (:K K_m3)))))

(OUTPUT tallest-recolor "the tallest bar keeps its cells and takes &tallest_color; undefined where two bars tie for the tallest"

  (RULE &bars_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &bars Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&bars_steps (:Delta *S2))
           (compose (:A P) (:B S2) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (RULE &bars_component
    (&bars.class (:a *P) *Id))

  (DET &tallest_color AnyOutNewColor)

  (RULE &member
    (&bars_component *P (:Id *B)))

  (INIT &span BoundingBox
    (key ((&member (:B ^Id) *P))
      (cell (P)
        (&member (:B Id) *P))))

  (RULE &height
    (&span.box (:key (:Id *B)) (:B *B2))
    (&member B *P)
    (&gravity_side *D)
    (axis_of D *A)
    (axis_elem A)
    (relative (:Base B2) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N))

  (INIT &rank Order
    (member ((:t (:V Id) (:S N)))
      (&height (:B *Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&height (:B *Id) *N)))

  (INIT &top Singleton
    (member ((:v Id))
      (&rank.maximal (:t (:V *Id))))))

(OUTPUT shortest-recolor "the shortest bar keeps its cells and takes &shortest_color; undefined where two bars tie for the shortest; a bar that is both the tallest and the shortest takes a color of &role_priority, and the output holds a grid for each such color"

  (DET &shortest_color AnyOutNewColor)

  ;; The role color a bar at both extremes takes. The pairs leave the tallest role and the shortest role open.
  (DET &role_priority AnyOutNewColor (ONE))

  (INIT &bottom Singleton
    (member ((:v Id))
      (&rank.minimal (:t (:V *Id))))))

(OUTPUT erase-rest "every other bar takes &background")

(ALTS $reading "the unit that is ranked, and how its height is measured" $ComponentSpan
  (ALT $ColumnCount
    (INPUT bars "vertical bars stand on the &gravity_side edge; a bar is the set of bar-color cells on one line along the axis of &gravity_side, whether or not they touch")
    (OUTPUT height "a bar's height is its number of cells"
      (RULE &member
        (&ink *P)
        (&lines.class (:a P) (:Id *B)))

      (INIT &size Cardinality
        (key ((&member (:B ^Id) *P))
          (member ((:m P))
            (&member (:B Id) *P))))

      (RULE &height
        (&size.size (:key (:Id *B)) *N))))
  (ALT $TopExtent
    (INPUT bars "vertical bars stand on the &gravity_side edge; a bar is the set of bar-color cells on one line along the axis of &gravity_side, whether or not they touch")
    (OUTPUT height "a bar's height is the distance of its farthest cell from the &gravity_side edge"
      (RULE &member
        (&ink *P)
        (&lines.class (:a P) (:Id *B)))

      ;; The distance of each line's farthest cell from the &gravity_side edge.
      (INIT &reach Order
        (key ((&member (:B ^Id) *P)
              (&gravity_side *D)
              (margin (:B P) D *K))
          (member ((:t K))
            (&member (:B Id) *P)
            (&gravity_side *D)
            (margin (:B P) D *K))
          (score ((:t K) (:S K))
            (&member (:B Id) *P)
            (&gravity_side *D)
            (margin (:B P) D *K))))

      (RULE &height
        (&reach.maximal (:key (:Id *B)) (:t *N)))))
  (ALT $Area
    (OUTPUT height "a bar's height is its number of cells"
      (INIT &size Cardinality
        (key ((&member (:B ^Id) *P))
          (member ((:m P))
            (&member (:B Id) *P))))

      (RULE &height
        (&size.size (:key (:Id *B)) *N))))
  (ALT $EightConnected
    (INPUT bars "vertical bars stand on the &gravity_side edge, each one column wide, with an empty column between neighbors; a bar is an 8-connected component of the bar-color cells"
      (RULE &bars8_component
        (&bars8.class (:a *P) *Id))

      (RULE &member
        (&bars8_component *P (:Id *B))))
    (RULE &output
      (OR ((&member (:B *Id) *P)
           (&background *Col))
          ((&bar_color2)
           (input P Col)
           (NOT (&ink P)))))))

(ALTS $tie "what happens when several bars share an extreme height" $Unique
  (ALT $TieAll
    (OUTPUT tallest-recolor "every bar at the greatest height keeps its cells and takes &tallest_color")
    (OUTPUT shortest-recolor "every bar at the least height keeps its cells and takes &shortest_color; a bar at both extremes, as when all bars have one height, takes a color of &role_priority, and the output holds a grid for each such color")
    (RULE &tallest
      (&rank.maximal (:t (:V *B))))

    (RULE &shortest
      (&rank.minimal (:t (:V *B))))))

(ALTS $source "where the bar color comes from" $StoredBarColor
  (ALT $DeriveBarColor
    (INPUT bar-color "the bars are drawn in the one color other than &background that the input holds; undefined where the input holds no such color or more than one"
      (RULE &bar_color2
        (&sole.value (:v *Col))))))

(RULE &shortest
  (&bottom.value (:v *B)))

(RULE &tallest
  (&top.value (:v *B)))

(RULE &paint
  (OR ((&tallest *B)
       (NOT (&shortest B))
       (&tallest_color (:C *Col)))
      ((&shortest B)
       (NOT (&tallest B))
       (&shortest_color (:C Col)))))

(RULE &output
  (OR ((&member (:B *Id) *P)
       (OR ((&paint (:B Id) *Col))
           ((&tallest (:B Id))
            (&shortest (:B Id))
            (&role_priority (:C Col)))
           ((NOT (&rank.maximal (:t (:V Id))))
            (NOT (&rank.minimal (:t (:V Id))))
            (&background Col))))
      ((&bar_color2)
       (input P Col)
       (NOT (&ink P)))))
