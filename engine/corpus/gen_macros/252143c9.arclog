;; 252143c9

(RULE &dp_nearer
  (input *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &dp_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&dp_nearer *P (:D D1))
  (&dp_nearer P (:D D2)))

(RULE &center
  (input *P)
  (ALL ((opposite (:D *D_m1) (:Opp *O_m2))
        (margin (:B P) (:D D_m1) (:K *K1_m3))
        (margin (:B P) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4))))

(DET &bg DominantColor)

(RULE &quad_color
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&dp_quadrant P *Diag))

(RULE &target
  (&center *P)
  (input P *Col)
  (&quad_color *Diag Col))

(RULE &ray_dir
  (&target (:Diag *D)))

(RULE &ray_node
  (input *P))

(RULE &ray_source
  (&center *P))

(INIT &ray Distance
  (key ((&ray_source (:P ^O))
        (&ray_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&ray_source (:P O))
           (&ray_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ray_node (:P Q)))
          ((&ray_source (:P O))
           (&ray_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&ray_node (:P Q))
           (= A2 O))
          ((&ray_source (:P O))
           (&ray_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&ray_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ray_node (:P Q)))))
    (source ((:n O))
      (&ray_source (:P O))
      (&ray_dir D))))

(RULE &ray_ray
  (&ray.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &ray_end
  (&ray_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ray_ray (:P Q) D Origin)))

(RULE &output
  (input *P)
  (IF ((&ray_ray P))
      ((&target *Col))
      ((&bg (:C Col)))))
