;; 5ad8a7c0

;; The axis a pair spans.
(DET &axis AxisDomain)

(RULE &cast_dir
  (&axis *A)
  (axis_of *D A))

(DET &mark RarestColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &cast_node
  (input *P)
  (NOT (&mark_cell P)))

(RULE &cast_source
  (&mark_cell *P))

;; Each mark casts along the task's axis and halts at the next mark.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &cast_full_dir
  (&axis *A)
  (axis_of *D A))

(RULE &cast_full_node
  (input *P))

(RULE &cast_full_source
  (&mark_cell *P))

(INIT &cast_full Distance
  (key ((&cast_full_source (:P ^O))
        (&cast_full_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_full_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_full_node (:P Q)))
          ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_full_node (:P Q))
           (= A2 O))
          ((&cast_full_source (:P O))
           (&cast_full_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_full_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_full_node (:P Q)))))
    (source ((:n O))
      (&cast_full_source (:P O))
      (&cast_full_dir D))))

(RULE &cast_full_ray
  (&cast_full.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_full_end
  (&cast_full_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_full_ray (:P Q) D Origin)))

(RULE &span
  (&cast_end (:P *E) *D (:Origin *Src))
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P))
  (&cast_full_ray P D *K (:Origin Src)))

(RULE &span_cell
  (&span *Src *D)
  (&cast_ray *P D *K (:Origin Src))
  (!= K 0))

(INIT &closest Order
  (member ((:t K))
    (&span *K))
  (score ((:t K) (:S K))
    (&span *K)))

(RULE &fill
  (&span *Src *D *K)
  (&closest.minimal (:t K))
  (&span_cell Src D *P))

(ALTS $choice "which spans fill" $Shortest
  (ALT $Clear
    (RULE &crossed
      (&span_cell *Src *D *P)
      (&mark_cell (:P *Q))
      (&axis *A)
      (perp A *A2)
      (perp (:A A2) (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P) (:D D_m2) (:K *K_m3))
      (margin (:B Q) (:D D_m2) (:K K_m3)))

    (RULE &fill
      (&span_cell *Src *D *P)
      (NOT (&crossed Src D)))))

(RULE &output
  (OR ((&fill *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&fill P)))))
