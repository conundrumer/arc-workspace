;; 97d7923e

;; The edge the headers lie on. The runs go inward from it, and the bars lie along its axis.
(DET &head_dir DirDomain)

(RULE &inward
  (&head_dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

;; The train pairs admit a second color; the DominantColor proposer, exact here, fixes this value.
(DET &bg DominantColor)

(RULE &run_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(RULE &run_dir
  (&run_node *Key)
  (&inward *D))

(RULE &run_node_ray
  (&run_node *Key *P))

(RULE &run_source
  (&run_node *Key *P))

;; Every run of one color, inward.
(INIT &run Distance
  (key ((&run_source (:Key ^Ky) (:P ^O))
        (&run_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_node_ray (:Key Ky) (:P Q)))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_node_ray (:Key Ky) (:P Q))
           (= A2 O))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_node_ray (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&run_source (:Key Ky) (:P O))
      (&run_dir (:Key Ky) D))))

(RULE &run_ray
  (&run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &run_end
  (&run_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray Key (:P Q) D Origin)))

(RULE &header
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&head_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &reach
  (&header *Col *P)
  (&inward (:D *D_in))
  (&run_end (:Key Col) (:P *P_end) (:D D_in) (:Origin P))
  (&head_dir *D)
  (margin (:B P_end) D *K))

(RULE &bar
  (input (:P *P_cap) *Col)
  (NOT (&bg (:C Col)))
  (&inward (:D *D_in))
  (step_offset (:D D_in) (:V *V_m1))
  (compose (:A P_cap) (:B V_m1) (:C *P_first))
  (input (:P P_first) (:Col *Body))
  (NOT (&bg (:C Body)))
  (!= Body Col)
  (&run_end (:Key Body) (:P *P_last) (:D D_in) (:Origin P_first))
  (step_offset (:D D_in) (:V *V_m2))
  (compose (:A P_last) (:B V_m2) (:C *P_tail))
  (input (:P P_tail) Col))

(RULE &bar_cell
  (&bar *Col *P_cap *Body *P_first)
  (&inward (:D *D_in))
  (OR ((&run_ray (:Key Body) *P (:D D_in) (:K *N) (:Origin P_first))
       (> N 0))
      ((= P P_first))))

(INIT &bar_size Cardinality
  (key ((&bar_cell ^Col ^P_cap *P))
    (member ((:m P))
      (&bar_cell Col P_cap *P))))

(INIT &bar_ord Order
  (key ((OR ((&bar ^Col *P_cap))
            ((&bar_size.size (:key Col P_cap) *N)
             (&bar_size.size (:key Col (:P_cap *P_cap2)) (:N *N2))
             (> N N2))))
    (member ((:t P_cap))
      (&bar Col *P_cap))
    (before ((:a P_cap) (:b P_cap2))
      (&bar_size.size (:key Col *P_cap) *N)
      (&bar_size.size (:key Col (:P_cap *P_cap2)) (:N *N2))
      (> N N2))))

(ALTS $choice "how the bars of one cap color rank" $Size
  (ALT $Head
    (INIT &bar_ord Order
      (key ((&bar ^Col *P_cap))
        (member ((:t P_cap))
          (&bar Col *P_cap))
        (before ((:a P_cap) (:b P_cap2))
          (&bar Col *P_cap)
          (&bar Col (:P_cap *P_cap2))
          (&head_dir *D)
          (dir_elem D)
          (margin (:B P_cap) D (:K *K1_m1))
          (margin (:B P_cap2) D (:K *K2_m2))
          (< K1_m1 K2_m2))))))

(RULE &fill
  (&reach *Col *K)
  (&bar_ord.rank (:key Col) (:t *P_cap) (:R K))
  (&bar_cell Col P_cap *P))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))
