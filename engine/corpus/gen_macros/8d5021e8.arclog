;; 8d5021e8

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tile_d4 (:Pt *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_in))
    (&tile_d4 (:T *D))
    (apply D (:P P_in) (:P_out *P_intile))))

(DET &arr_pos Frame)

(DET &anchor DirDomain)

(RULE &anchor_tile
  (&arr_pos *P)
  (&anchor *D)
  (margin (:B P) D (:K 0))
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *D2) (:A A2_m2))
  (opposite (:D D2) (:Opp *O_m3))
  (margin (:B P) (:D D2) *K)
  (margin (:B P) (:D O_m3) K))

(ALTS $choice "data-equivalent on this task" $Lookup
  (ALT $Mirror
    (RULE &mirror
      (input *P)
      (&arr_pos (:P *P_tile))
      (&anchor_tile (:P *Anc))
      (axis_of *D *A)
      (OR ((margin (:B P_tile) D *K)
           (margin (:B Anc) D (:K *K2))
           (!= K K2)
           (axis_inversion A (:T *F))
           (apply (:D F) P (:P_out *P_img)))
          ((margin (:B P_tile) D (:K *K_m1))
           (margin (:B Anc) D (:K K_m1))
           (= P_img P))))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (&mirror (:P_tile *T)))
      (inner ((:P P_intile))
        (&mirror (:P_img *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (perp (:A *A1) *A2)
      (&mirror (:A A1) (:P_tile *T) (:P P_in) (:P_img *P1))
      (&mirror (:A A2) (:P_tile T) (:P P1) (:P_img *P_intile))
      (&output_tiling2.cell (:P_outer T) (:P_inner P_intile) *P)))
  (ALT $Unfold
    (RULE &tile_off
      (&arr_pos (:P *P_tile))
      (&anchor_tile (:P *Anc))
      (relative (:Base Anc) (:X P_tile) (:X_rel *V))
      (axis_of *D *A)
      (margin (:B V) D *K)
      (>= K 0))

    ;; The input reflected across a shared boundary on each axis, once per tile
    ;; step away from the anchor tile along that axis.
    (INIT &reflect Walk
      (key ((OR ((input *P)
                 (axis_elem ^A)
                 (axis_inversion A (:T *F))
                 (apply (:D F) P (:P_out *P_img)))
                ((&tile_off A *K))))
        (successor ((:p P) (:p_next P_img))
          (input *P)
          (axis_elem A)
          (axis_inversion A (:T *F))
          (apply (:D F) P (:P_out *P_img)))
        (steps ((:N K))
          (&tile_off A *K))))

    (INIT &output_tiling3 Tiling
      (outer ((:P T))
        (&tile_off (:P_tile *T)))
      (inner ((:P P_intile))
        (&reflect.walk (:p *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (perp (:A *A1) *A2)
      (&tile_off (:P_tile *T) (:A A1) (:K *K1))
      (&tile_off (:P_tile T) (:A A2) (:K *K2))
      (&reflect.walk (:key (:A A1)) (:p0 P_in) (:N K1) (:p *P1))
      (&reflect.walk (:key (:A A2)) (:p0 P1) (:N K2) (:p *P_intile))
      (&output_tiling3.cell (:P_outer T) (:P_inner P_intile) *P))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
