;; f8b3ba0a

(DET &rank_dir DirDomain)

(RULE &col_dir
  (&rank_dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(DET &bg DominantColor)

(INIT &cell_count Cardinality
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &count_of
  (&cell_count.size (:key *Col) *N))

(ALTS $choice "what is counted for each color" $Cells
  (ALT $Blocks
    (RULE &comps_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &comps Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (NOT (&bg (:C Col)))
             (&comps_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (NOT (&bg (:C Col2))))
            ((input P (:Col *Col3))
             (NOT (&bg (:C Col3)))
             (= P3 P)))))

    (RULE &comps_component
      (&comps.class (:a *P) *Id))

    (INIT &block_count Cardinality
      (key ((&comps_component *P *Id)
            (input P ^Col))
        (member ((:m Id))
          (&comps_component *P *Id)
          (input P Col))))

    (RULE &count_of
      (&block_count.size (:key *Col) *N)))
  (ALT $Lattice
    (DET &blocks_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (DET &ink
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col)))
      (ex_output E))

    (INIT &blocks Quotient
      (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
        (OR ((&ink *E *P)
             (&blocks_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink E (:P P3)))
            ((&ink E P)
             (= P3 P)))))

    (DET &blocks_component
      (&blocks.class (:a *Key *P) *Id))

    ;; The frame the non-bg cells span: the grid inside the separator border,
    ;; with each ink cell's place in it.
    (INIT &span BoundingBox
      (key ((&ink ^E *P))
        (cell (P)
          (&ink E *P))))

    (DET &frame_inside1
      (&span.cell (:key *E) (:P *P_))
      (&span.box (:key E) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &border_width
      (&span.box *B)
      (dir_elem *D)
      (margin B D *K))

    (RULE &core_cell_uniform_inset1
      (&border_width (:K *K_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &core_cell
      (input *P)
      (&border_width *K)
      (&core_cell_uniform_inset1 (:K_ K) (:B_ *B))
      (ALL ((&border_width (:K *Km))
            (axis_of (:D *D1_m1) (:A *A1_m2))
            (perp (:A A1_m2) (:A2 *A2_m3))
            (axis_of (:D *D2_m4) (:A A2_m3))
            (opposite (:D D1_m1) (:Opp *O_m7))
            (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
            (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
            (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
            (opposite (:D D2_m4) (:Opp *O_m10))
            (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
            (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
            (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
            (compose (:A B1_m5) (:B B2_m6) (:C B))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    (INIT &bbox BoundingBox
      (key ((&blocks_component (:Key ^E) *P ^Id))
        (cell (P)
          (&blocks_component (:Key E) *P Id))))

    (DET &tile_dim
      (&bbox.cell (:key (:E *Blk_e) (:Id *Blk_id)) *P)
      (&bbox.box (:key (:E Blk_e) (:Id Blk_id)) *B)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *K)))

    ;; Blocks along an axis: the distinct offsets their boxes sit at.
    (INIT &tile_count Cardinality
      (key ((&bbox.box (:key ^E *Id) *B)
            (dir_elem ^D)
            (margin B D *K))
        (member ((:m K))
          (&bbox.box (:key E *Id) *B)
          (dir_elem D)
          (margin B D *K))))

    (INIT &tile_gap_divisions ExtentDivisions
      (key ((&span.cell (:key ^E) *P)
            (&span.box (:key E) *B)
            (NOT (&frame_inside1 (:P_ P) (:B_ B)))
            (relative (:Base B) (:X P) (:X_rel *P_inner)))
        (frame ((:P P_inner))
          (&span.cell *P)
          (&span.box *B)
          (NOT (&frame_inside1 (:P_ P) (:B_ B)))
          (relative (:Base B) (:X P) (:X_rel *P_inner)))))

    (DET &tile_gap
      (&tile_gap_divisions.division (:key *E) *A *N *K *G)
      (&tile_count.size (:key E *D) N)
      (axis_of D A)
      (&tile_dim A K))

    (RULE &lattice_gap
      (&tile_dim *A *K)
      (&tile_gap *G))

    (RULE &lattice_axis_split1
      (&core_cell *P (:P_inner *P_inner_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &lattice_axis
      (OR ((input (:P *P2) *Col)
           (NOT (&bg (:C Col)))
           (&core_cell (:P P2) (:P_inner *P))
           (&tile_dim *A *K)
           (&tile_dim A (:K *K2))
           (&tile_gap *G)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input (:P *P22) (:Col *Col2))
           (NOT (&bg (:C Col2)))
           (&core_cell (:P P22) (:P_inner P))
           (&tile_dim A (:K *K3))
           (NOT (&lattice_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K3) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K3) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K3)))
          ((input (:P *P23) (:Col *Col3))
           (NOT (&bg (:C Col3)))
           (&core_cell (:P P23) (:P_inner P))
           (axis_elem A)
           (NOT (&tile_dim A))
           (&lattice_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &lattice_tile
      (&lattice_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&lattice_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile_color
      (input *P *Col)
      (&core_cell P *P_inner)
      (&lattice_tile (:P P_inner) (:P_outer *P_tile)))

    (INIT &tile_count2 Cardinality
      (key ((&tile_color *P_tile ^Col))
        (member ((:m P_tile))
          (&tile_color *P_tile Col))))

    (RULE &count_of
      (&tile_count2.size (:key *Col) *N))))

;; Ranked colors: the max-count color is dominant and drops out; the rest
;; take dense ranks over their counts, fewest first.
(INIT &dominant Order
  (member ((:t (:V Col) (:S N)))
    (&count_of *Col *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&count_of *Col *N)))

(RULE &minority_count
  (&count_of *Col *N)
  (NOT (&dominant.maximal (:t (:V Col)))))

(INIT &o Order
  (member ((:t N))
    (&minority_count *N))
  (score ((:t N) (:S N))
    (&minority_count *N)))

(RULE &minority_rank
  (&minority_count *Col *N)
  (&o.rank (:t N) *R))

;; Output frame: 1D axis anchored at &rank_dir, per choice. Placing ascending
;; rank from the opposite edge puts the largest count at the rank_dir edge.
(INIT &col_size Cardinality
  (member ((:m R))
    (&minority_rank *R)))

(INIT &col_frame Frame
  (extent (A N)
    (&col_dir *D)
    (axis_of D *A)
    (&col_size.size *N)))

(RULE &col_pos
  (&col_frame.cell *P)
  (&col_dir *D)
  (margin (:B P) D *K)
  (&minority_rank (:R K)))

(RULE &output
  (&minority_rank *Col (:R *Rk))
  (&col_pos (:K Rk) *P))
