;; 08573cc6

(DET &len0 TileCount)

(DET &dot RarestColor)

(RULE &seed
  (input *P *Col)
  (&dot (:C Col)))

(DET &sense SenseDomain)

(DET &start_dir DirDomain)

;; The arms the walk reaches: from an arm that ends on the grid, the next arm
;; turns and is one cell longer.
;; The first arm leaves the dot.
(INIT &spiral Propagation
  (source ((:n P_end D Delta))
    (&seed *P)
    (&start_dir *D)
    (&len0 *N)
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
    (edge_inset D (:K N) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A P) (:B V_m1) (:C *P_end))
    (dir8_opposite D (:D2 *O_m6))
    (edge_inset (:D O_m6) (:K N) (:B *B1_m7))
    (edge_inset D (:K N) (:B *I_m9))
    (relative (:Base I_m9) (:X 0) (:X_rel *B2_m8))
    (compose (:A B1_m7) (:B B2_m8) (:C *Delta)))
  (edge ((:a (:P_end P) D Delta) (:b (:P_end P_end2) (:D D2) (:Delta Delta2)))
    (input *P)
    (dir_elem *D)
    (axis_of D *A)
    (sub_extent P A (:K *N))
    (dir8_opposite D (:D2 *O_m1))
    (edge_inset (:D O_m1) (:K N) (:B *B1_m2))
    (edge_inset D (:K N) (:B *I_m4))
    (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Delta))
    (&sense *S)
    (turn S D *D2)
    (c4_turn S (:T *M))
    (apply (:D M) (:P Delta) (:P_out *DeltaR))
    (step_offset (:D D2) (:V *V_m5))
    (compose (:A DeltaR) (:B V_m5) (:C *Delta2))
    (compose (:A P) (:B Delta2) (:C *P_end2))))

(RULE &arm
  (&spiral.reached (:n *P_end *D *Delta))
  (relative (:Base Delta) (:X P_end) (:X_rel *P_start)))

(RULE &run_dir
  (&arm (:P_start *Key) (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(RULE &run_dir_ray
  (&run_dir *Key *D))

(RULE &run_node
  (&run_dir *Key)
  (input *P))

(RULE &run_source
  (&arm (:P_start *Key) (:P_end *P)))

;; An arm read back from its end, keyed by where it starts. An arm the grid
;; edge cuts short ends off the grid, so a forward cast from the start has no
;; end to stop at. A cast from off the frame still walks in, so the backward
;; run reaches that arm's on-grid cells.
(INIT &run Distance
  (key ((&run_source (:Key ^Ky) (:P ^O))
        (&run_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_source (:Key Ky) (:P O))
           (&run_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_node (:Key Ky) (:P Q)))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&run_source (:Key Ky) (:P O))
           (&run_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&run_source (:Key Ky) (:P O))
      (&run_dir_ray (:Key Ky) D))))

(RULE &run_ray
  (&run.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &run_end
  (&run_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray Key (:P Q) D Origin)))

(DET &bg DominantColor)

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&dot (:C Col))))

(DET &marker_corner
  (ex_input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&dot (:C Col)))
  (corner_dist P (:Diag *D) (:K 0)))

(RULE &corner_color
  (&marker *P *Col)
  (&marker_corner (:D *Diag))
  (corner_dist P Diag (:K 0)))

(RULE &other_color
  (&marker *P *Col)
  (&marker_corner (:D *Diag))
  (corner_dir (:C Diag) *D)
  (NOT (margin (:B P) D (:K 0))))

(RULE &run_cell
  (&arm (:P_start *Key))
  (input *P))

(RULE &arm_cell
  (&arm (:P_start *P2) *D *P_end)
  (opposite D (:Opp *O))
  (&run_ray (:Key P2) *P (:D O) *K (:Origin P_end))
  (&run_cell (:Key P2) P)
  (&run_ray (:Key P2) (:P P2) (:D O) (:K *N) (:Origin P_end))
  (&run_cell (:Key P2) (:P P2))
  (< K N))

(RULE &corner_axis
  (&start_dir *D)
  (axis_of D *A))

(ALTS $choice "The cases differ on how the corner marker's axis is picked" $Start
  (ALT $Stored
    (DET &color_axis AxisDomain)

    (RULE &corner_axis
      (&color_axis *A))))

(RULE &output
  (OR ((&arm_cell *P *D)
       (axis_of D *A)
       (OR ((&corner_axis A)
            (&corner_color *Col))
           ((&corner_axis (:A *A2))
            (perp A A2)
            (&other_color Col))))
      ((input P (:Col *Col2))
       (OR ((NOT (&arm_cell P))
            (NOT (&seed P))
            (&bg (:C Col)))
           ((&seed P)
            (= Col Col2))))))
