;; ce039d91

(DET &mark RarestColor)

(DET &fill AnyOutNewColor)

(DET &sym D4Domain)

(RULE &symmetric
  (input *P (:Col *M))
  (&mark (:C M))
  (&sym *D)
  (apply D P (:P_out *Q))
  (input (:P Q) (:Col M)))

(RULE &output
  (OR ((&symmetric *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&symmetric P)))))
