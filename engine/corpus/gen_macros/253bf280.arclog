;; 253bf280

(RULE &rays_dir
  (dir_elem *D))

(RULE &rays_dir_ray
  (&rays_dir *D))

(RULE &rays_node
  (&rays_dir)
  (input *P))

(DET &bg DominantColor)

(RULE &rays_source
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &rays Distance
  (key ((&rays_source (:P ^O))
        (&rays_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:P O))
           (&rays_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:P Q)))
          ((&rays_source (:P O))
           (&rays_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:P Q))
           (= A2 O))
          ((&rays_source (:P O))
           (&rays_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:P Q)))))
    (source ((:n O))
      (&rays_source (:P O))
      (&rays_dir_ray D))))

(RULE &rays_ray
  (&rays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray (:P Q) D Origin)))

(DET &fill AnyOutNewColor)

(RULE &rays_cell
  (input *P (:Col *Bg))
  (&bg (:C Bg)))

(ALTS $choice "what a stroke does to a mark it crosses" $Spare
  (ALT $Paint
    (RULE &rays_cell
      (input *P))))

(RULE &between
  (opposite *D (:Opp *O))
  (&rays_ray *P D *K)
  (&rays_cell P)
  (!= K 0)
  (&rays_ray P (:D O) (:K *K2))
  (&rays_cell P)
  (!= K2 0))

(RULE &output
  (OR ((&between *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&between P)))))
