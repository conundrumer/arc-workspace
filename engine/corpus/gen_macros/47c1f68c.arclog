;; 47c1f68c

;; The outputs' own symmetries, per example.
(INIT &grid_map Agreement
  (key ((ex_output ^E (:P *P_grid_out) *Col))
    (source ((:i P_grid_out) (:v Col))
      (ex_output E (:P *P_grid_out) *Col))
    (target ((:i P_grid_out) (:v Col))
      (ex_output E (:P *P_grid_out) *Col))
    (correspondence ((:m D) (:i P_grid_out) (:j Q))
      (ex_output E (:P *P_grid_out) *Col)
      (d4_elem *D)
      (apply D (:P P_grid_out) (:P_out *Q)))))

(DET &grid_map_map
  (ex_output (:E *Key))
  (d4_elem *D)
  (NOT (&grid_map.mismatch (:key (:E Key)) (:m D))))

(INIT &cell_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(DET &divisor SepTileCount)

(DET &gap DimDiff)

(RULE &cell_division_gap
  (axis_elem *A)
  (&gap (:D *G)))

(RULE &cell_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &cell_division_parts
  (axis_elem *A)
  (&divisor *N))

(RULE &cell_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&divisor *N)
       (&gap (:D *G))
       (&cell_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&divisor (:N *N2))
       (&gap (:D *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (&divisor (:N *N3))
       (NOT (&cell_division_gap A))
       (&cell_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (axis_elem A)
       (&divisor (:N *N4))
       (NOT (&cell_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&cell_division_parts A))
       (&cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &cell_division_tile
  (&cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&cell_division_tile (:P_outer *P_tile)))
  (inner ((:P P_intile))
    (&cell_division_tile (:P_inner *P_intile))))

(DET &bg DominantColor)

(DET &anchor DiagDirDomain)

(RULE &cell
  (&cell_division_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile))
  (&cell_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_grid_out)))

(RULE &line_color
  (input (:P *P_grid) *Col)
  (NOT (&cell P_grid)))

(RULE &ink
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col))))

(DET &broken
  (ex_output *E)
  (d4_elem *D)
  (NOT (&grid_map_map (:Key E) D)))

;; The named subgroup matching the transforms every output holds.
(INIT &sym_id Inclusion
  (pattern ((:pattern S) (:m D))
    (sym_member *S *D))
  (observed ((:m D))
    (d4_elem *D)
    (NOT (&broken D))))

(DET &sym
  (&sym_id.equal (:pattern *S)))

(RULE &paint
  (&ink *P_grid)
  (&cell P_grid (:P_grid_out *P_grid_out2))
  (&sym *S)
  (sym_member S *D)
  (apply D (:P P_grid_out2) (:P_out *P_grid_out)))

(RULE &anchor_tile2
  (&cell *P_tile)
  (&anchor (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
  (margin (:B P_tile) (:D D1_m2) (:K *K1_m5))
  (margin (:B 0) (:D D1_m2) (:K K1_m5))
  (margin (:B P_tile) (:D D2_m4) (:K *K2_m6))
  (margin (:B 0) (:D D2_m4) (:K K2_m6)))

(RULE &pattern
  (&ink *P_grid)
  (&cell P_grid *P_tile *P_intile)
  (&anchor_tile2 P_tile))

(ALTS $choice "how the pattern in the anchor quadrant is carried into the other quadrants — data-equivalent on this task" $Complete
  (ALT $Lookup
    (INIT &tile_cell_division_sides ExtentDivisions
      (frame ((:P P_grid_out))
        (ex_output (:P *P_grid_out))))

    (DET &tile_cell_division_axis_split1
      (ex_output (:P *P_grid_out_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_out_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_out_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_out_) (:X_rel *X_m1_)))

    (DET &tile_cell_division_parts
      (axis_elem *A)
      (&divisor *N))

    (DET &tile_cell_division_axis
      (OR ((ex_output *P)
           (axis_elem *A)
           (&divisor *N)
           (&tile_cell_division_sides.division A N *K (:G 0))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((ex_output P)
           (axis_elem A)
           (&divisor (:N *N2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N2)))
          ((ex_output P)
           (axis_elem A)
           (NOT (&tile_cell_division_parts A))
           (&tile_cell_division_axis_split1 (:P_grid_out_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (DET &tile_cell_division_tile
      (&tile_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (DET &tile_cell
      (ex_output *E (:P *P_grid_out) *Col)
      (&tile_cell_division_tile (:P P_grid_out) (:P_outer *P_tile) (:P_inner *P_intile)))

    (DET &tile
      (&tile_cell *E *P_tile))

    (DET &anchor_tile
      (&tile *P_tile)
      (&anchor (:D *Diag))
      (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
      (margin (:B P_tile) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P_tile) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (INIT &tile_map Agreement
      (key ((OR ((&tile ^E ^P_tile)
                 (&anchor_tile (:P_tile *T_anc))
                 (&tile_cell E (:P_tile T_anc) *P_intile *Col))
                ((&tile_cell E P_tile P_intile Col))))
        (source ((:i P_intile) (:v Col))
          (&tile E P_tile)
          (&anchor_tile (:P_tile *T_anc))
          (&tile_cell E (:P_tile T_anc) *P_intile *Col))
        (target ((:i P_intile) (:v Col))
          (&tile_cell E P_tile *P_intile *Col))
        (correspondence ((:m D) (:i P_intile) (:j Q))
          (&tile E P_tile)
          (&anchor_tile (:P_tile *T_anc))
          (&tile_cell E (:P_tile T_anc) *P_intile *Col)
          (d4_elem *D)
          (apply D (:P P_intile) (:P_out *Q)))))

    (DET &tile_map_src
      (&tile *E *P_tile)
      (&anchor_tile (:P_tile *T_anc))
      (&tile_cell E (:P_tile T_anc) (:P_intile *P) (:Col *V)))

    (DET &tile_map_map
      (&tile_map_src *E *P_tile)
      (d4_elem *D)
      (NOT (&tile_map.mismatch (:key E P_tile) (:m D))))

    (DET &tile_broken
      (&tile *E *P_tile)
      (d4_elem *D)
      (NOT (&tile_map_map E P_tile D)))

    (DET &tile_d4
      (&tile *P_tile)
      (d4_elem *D)
      (NOT (&tile_broken P_tile D)))

    (INIT &paint_tiling Tiling
      (outer ((:P P_tile))
        (&tile_d4 *P_tile))
      (inner ((:P P_intile2))
        (&pattern *P_intile)
        (&tile_d4 *D)
        (apply D (:P P_intile) (:P_out *P_intile2))))

    (RULE &paint
      (&pattern *P_intile)
      (&tile_d4 *P_tile *D)
      (apply D (:P P_intile) (:P_out *P_intile2))
      (&paint_tiling.cell (:P_outer P_tile) (:P_inner P_intile2) (:P *P_grid_out))))
  (ALT $Mirror
    (RULE &mirror
      (&cell *P_tile *P_intile)
      (&anchor (:D *Diag))
      (corner_dir (:C Diag) *A *D)
      (OR ((NOT (margin (:B P_tile) D (:K 0)))
           (axis_inversion A (:T *F))
           (apply (:D F) (:P P_intile) (:P_out *P_img)))
          ((margin (:B P_tile) D (:K 0))
           (= P_img P_intile))))

    (INIT &paint_tiling2 Tiling
      (outer ((:P P_tile))
        (&pattern *P_intile)
        (&mirror *P_tile P_intile))
      (inner ((:P P_intile2))
        (&mirror (:P_img *P_intile2))))

    (RULE &paint
      (&pattern *P_intile)
      (perp (:A *A1) *A2)
      (&mirror (:A A1) *P_tile P_intile (:P_img *P1))
      (&mirror (:A A2) P_tile (:P_intile P1) (:P_img *P_intile2))
      (&paint_tiling2.cell (:P_outer P_tile) (:P_inner P_intile2) (:P *P_grid_out))))
  (ALT $Unfold
    ;; The pattern reflected across a shared boundary on each axis, once per
    ;; tile step away from the anchor tile along that axis.
    (INIT &reflect Walk
      (key ((OR ((&cell *P_intile)
                 (axis_inversion ^A (:T *F))
                 (apply (:D F) (:P P_intile) (:P_out *P_img)))
                ((&cell *P_tile)
                 (&anchor (:D *Diag))
                 (corner_dir (:C Diag) A *D)
                 (margin (:B P_tile) D *K))))
        (successor ((:p P_intile) (:p_next P_img))
          (&cell *P_intile)
          (axis_inversion A (:T *F))
          (apply (:D F) (:P P_intile) (:P_out *P_img)))
        (steps ((:N K))
          (&cell *P_tile)
          (&anchor (:D *Diag))
          (corner_dir (:C Diag) A *D)
          (margin (:B P_tile) D *K))))

    (INIT &paint_tiling3 Tiling
      (outer ((:P P_tile))
        (&cell *P_tile))
      (inner ((:P P_intile2))
        (&reflect.walk (:p *P_intile2))))

    (RULE &paint
      (&pattern *P_intile)
      (&paint_tiling3.cell (:P_outer *P_tile) (:P_inner *P_intile2) (:P *P_grid_out))
      (&anchor (:D *Diag))
      (perp (:A *A1) *A2)
      (corner_dir (:C Diag) (:A A1) (:D *D1))
      (margin (:B P_tile) (:D D1) (:K *K1))
      (corner_dir (:C Diag) (:A A2) (:D *D2))
      (margin (:B P_tile) (:D D2) (:K *K2))
      (&reflect.walk (:key (:A A1)) (:p0 P_intile) (:N K1) (:p *P1))
      (&reflect.walk (:key (:A A2)) (:p0 P1) (:N K2) (:p P_intile2)))))

(RULE &output
  (OR ((&paint (:P_grid_out *P))
       (&line_color *Col))
      ((&cell (:P_grid_out P))
       (NOT (&paint (:P_grid_out P)))
       (&bg (:C Col)))))
