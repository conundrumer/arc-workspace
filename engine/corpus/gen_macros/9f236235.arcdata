;; 9f236235

(param &pose D4 (D4_LR))
(param &gap number (1))

(alts $choice
  (alt $Lattice
    (witness unequal borderline concept
      (relaxed even)
      (separates "panels cut by the lines that draw them, against panels read off an even lattice")
      (input (grid
        (3 3 5 0 0 0 0)
        (5 5 5 5 5 5 5)
        (0 0 5 4 4 4 4)
        (0 0 5 4 4 4 4)
        (0 0 5 4 4 4 4)))
      (output concept (grid
        (0 3)
        (4 0)))
      (output $Lattice (grid
        (0 0 5 3)
        (4 4 5 0)
        (4 4 5 0))))))
