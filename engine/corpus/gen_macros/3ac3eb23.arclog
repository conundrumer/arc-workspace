;; 3ac3eb23

(DET &bg DominantColor)

(DET &mark
  (ex_input *E *P *Col)
  (NOT (&bg (:C Col)))
  (ex_output E))

(DET &off_edge
  (&mark *P)
  (dir_elem *D)
  (NOT (margin (:B P) D (:K 0))))

(DET &dir
  (dir_elem *D)
  (NOT (&off_edge D)))

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &seed
  (&marker *P *Col)
  (&dir (:D *E))
  (opposite (:D E) (:Opp *D)))

(RULE &trail_cell_ray
  (input *P))

(DET &offset
  (&mark *E *P *Col)
  (ex_output E (:P *Q) Col)
  (relative (:Base P) (:X Q) (:X_rel *Delta)))

(DET &radius
  (&offset *E *P *Delta)
  (&dir *D)
  (margin (:B Delta) D (:K *I))
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *Ds) (:A A2_m2))
  (margin (:B Delta) (:D Ds) (:K *R))
  (>= R 0))

(DET &cand
  (&radius (:I *W))
  (!= W 0))

(DET &differ
  (&radius *E *P *I *R)
  (&radius E P (:I *I2))
  (NOT (&radius E P (:I I2) R)))

(DET &mismatch
  (&cand *W)
  (&differ *I *I2)
  (divide (:T I) (:Side W) (:Gap 0) (:Remainder *K))
  (divide (:T I2) (:Side W) (:Gap 0) (:Remainder K)))

;; The shortest period no trail breaks.
(INIT &unbroken Order
  (member ((:t W))
    (&cand *W)
    (NOT (&mismatch W)))
  (score ((:t W) (:S W))
    (&cand *W)
    (NOT (&mismatch W))))

(DET &period
  (&unbroken.minimal (:t *N)))

(DET &step_cells
  (&period (:N *K)))

(ALTS $choice "how each marker's trail is cast" $Parity
  (ALT $Parity
    (ALTS $s "marker edge — the trail extends away from it" $Dir
      (ALT $Edge
        (RULE &seed
          (&marker *P *Col)
          (dir_elem (:D *E))
          (margin (:B P) (:D E) (:K 0))
          (opposite (:D E) (:Opp *D))))))
  (ALT $Walk
    (RULE &lit
      ;; Two zigzag walks from the marker, one per side: each step goes one cell on
      ;; and one to the side, and the side flips each step, so a walk stands on the
      ;; trail at the end of each step and to its side between. A walk with no
      ;; room on its side stops at the marker.
      (OR ((&seed *Col *P))
          ((&trail_cell Col *D *Src (:P *P2) *K)
           (axis_of D (:A *A_m1))
           (perp (:A A_m1) (:A2 *A2_m2))
           (axis_of (:D *Ds) (:A A2_m2))
           (step_offset (:D Ds) (:V *V_m3))
           (compose (:A Src) (:B V_m3) (:C *Q0))
           (input (:P Q0))
           (&step_cells (:K *N))
           (divide (:T K) (:Side N) (:Gap 0) (:Remainder *J))
           (OR ((!= J 0)
                (step_offset (:D Ds) (:V *V_m4))
                (compose (:A P2) (:B V_m4) (:C P))
                (input P))
               ((= J 0)
                (= P P2)))))))
  (ALT $Banner
    (DET &slot
      (&radius (:I *K))
      (&period *N)
      (< K N))

    (INIT &slots Order
      (member ((:t K))
        (&slot *K))
      (score ((:t K) (:S K))
        (&slot *K)))

    ;; The slot cycle, advanced once per step along the trail.
    (INIT &slot_walk Walk
      (successor ((:p K) (:p_next K2))
        (&slots.cyclic_successor (:a *K) (:b *K2)))
      (steps ((:N I))
        (&trail_ray *P (:K *I))
        (&trail_cell_ray P)))

    (DET &banner
      (&radius *I *R)
      (&period *N)
      (divide (:T I) (:Side N) (:Gap 0) (:Remainder *K)))

    ;; Light each slot's radius, both sides of the line: the trail cell K steps
    ;; out takes the slot K steps around the cycle.
    (RULE &lit
      (&trail_cell *Col *D (:P *P2) (:K *I))
      (&slot_walk.walk (:p0 0) (:N I) (:p *K))
      (&banner K *R)
      (axis_of D (:A *A_m1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (axis_of (:D *Ds) (:A A2_m2))
      (dir8_opposite (:D Ds) (:D2 *O_m4))
      (edge_inset (:D O_m4) (:K R) (:B *B1_m5))
      (edge_inset (:D Ds) (:K R) (:B *I_m7))
      (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
      (compose (:A P2) (:B V_m3) (:C *P))
      (input P)))
  (ALT $Stamp
    (DET &template
      (&offset *Delta))

    (RULE &lit
      (&marker (:P *P2) *Col)
      (&template (:Delta *Off))
      (compose (:A P2) (:B Off) (:C *P))
      (input P))))

(RULE &trail_dir
  (&seed *D))

(RULE &trail_node
  (&seed *D)
  (input *P))

(RULE &trail_source
  (&seed *P))

;; The trail: the cells from each marker away from its edge.
(INIT &trail Distance
  (key ((&trail_source (:P ^O))
        (&trail_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&trail_source (:P O))
           (&trail_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&trail_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&trail_node (:P Q)))
          ((&trail_source (:P O))
           (&trail_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&trail_node (:P Q))
           (= A2 O))
          ((&trail_source (:P O))
           (&trail_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&trail_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&trail_node (:P Q)))))
    (source ((:n O))
      (&trail_source (:P O))
      (&trail_dir D))))

(RULE &trail_ray
  (&trail.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &trail_end
  (&trail_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&trail_ray (:P Q) D Origin)))

(RULE &trail_cell
  (&trail_ray *P *D *K (:Origin *Src))
  (&trail_cell_ray P)
  (&seed *Col D (:P Src)))

(RULE &center
  (&trail_cell *Col *D *P *K)
  (&step_cells (:K *N))
  (divide (:T K) (:Side N) (:Gap 0) (:Remainder 0)))

(RULE &lit
  (OR ((&center *Col *P))
      ;; Flanks: the diagonal neighbors of each center, ahead of it.
      ((&center Col *D (:P *P2))
       (corner_dir (:C *Diag) D)
       (step_offset (:D Diag) (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C P))
       (input P))))

(RULE &output
  (OR ((&lit *P *Col))
      ((input P)
       (NOT (&lit P))
       (&bg (:C Col)))))
