;; 25c199f5

(DET &order_axis AxisDomain)

(RULE &stack_axis
  (&order_axis (:A *A2))
  (perp (:A A2) (:A2 *A)))

(RULE &span_axis
  (&stack_axis *A))

(RULE &span_dir
  (&span_axis *A)
  (axis4_of *D A))

(RULE &span_node
  (&span_axis)
  (input *P))

(DET &bg DominantColor)

;; The panels lie along order_axis, one divider between them.
(DET &divide_gap DivisorRatio)

(DET &divisor SepTileCount)

(INIT &panel_division_sides ExtentDivisions
  (frame (P)
    (input *P)))

(RULE &panel_division_gap
  (&order_axis *A)
  (&divide_gap (:K *G)))

(RULE &panel_division_axis_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &panel_division_parts
  (&order_axis *A)
  (&divisor *N))

(RULE &panel_division_axis
  (OR ((input *P)
       (&order_axis *A)
       (&divisor *N)
       (&divide_gap (:K *G))
       (&panel_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&order_axis A)
       (&divisor (:N *N2))
       (&divide_gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&order_axis A)
       (&divisor (:N *N3))
       (NOT (&panel_division_gap A))
       (&panel_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&order_axis A)
       (&divisor (:N *N4))
       (NOT (&panel_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&panel_division_parts A))
       (&panel_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &panel_division_tile
  (&panel_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&panel_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &panel
  (&panel_division_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

;; order_corner sets where the stack builds from: panels in order from its edge along order_axis, lines settling against its edge across.
(DET &order_corner DiagDirDomain)

(RULE &stack_dir
  (&order_corner (:D *Diag))
  (&stack_axis (:A *A_st))
  (corner_dir (:C Diag) (:A A_st) *D))

(ALTS $d "how the panels are found" $Count
  (ALT $Size
    (DET &panel_size ConstOutDim)

    (RULE &panel_division2_gap
      (&order_axis *A)
      (&divide_gap (:K *G)))

    (RULE &panel_division2_axis_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &panel_division2_side
      (&order_axis *A)
      (&panel_size (:N *K)))

    (RULE &panel_division2_axis
      (OR ((input *P)
           (&order_axis *A)
           (&panel_size (:N *K))
           (&divide_gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&order_axis A)
           (&panel_size (:N *K2))
           (NOT (&panel_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&panel_division2_side A))
           (&panel_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &panel_division2_tile
      (&panel_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&panel_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &panel
      (&panel_division2_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $l "which lines a panel contributes" $Rows
  (ALT $Bands
    (RULE &span_between
      (&cell_slab (:P_slab *P))
      (&span_axis *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&span_ray P D)
      (&span_ray P (:D O)))

    (RULE &stacked
      (&span_between (:P *P_slab)))))

(RULE &cell_slab_split1
  (&panel *P *P_tile (:P_intile *P_intile_))
  (&stack_axis (:A *A_st_))
  (axis_of (:D *D_m1) (:A A_st_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_intile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_intile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_intile_) (:X_rel *X_m1_)))

(RULE &cell_slab
  (input *P *Col)
  (&panel P *P_tile *P_intile)
  (&stack_axis (:A *A_st))
  (&cell_slab_split1 (:P_intile_ P_intile) (:A_st_ A_st) (:Along_ *Along) (:X_m1_ *X_m1))
  (compose (:A P_tile) (:B Along) (:C *P_slab)))

(RULE &ink_slab
  (&cell_slab *P_slab *Col)
  (NOT (&bg (:C Col))))

(RULE &span_source
  (&ink_slab (:P_slab *P)))

(INIT &span Distance
  (key ((&span_source (:P ^O))
        (&span_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&span_source (:P O))
           (&span_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&span_node (:P Q)))
          ((&span_source (:P O))
           (&span_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&span_node (:P Q))
           (= A2 O))
          ((&span_source (:P O))
           (&span_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&span_node (:P Q)))))
    (source ((:n O))
      (&span_source (:P O))
      (&span_dir D))))

(RULE &span_ray
  (&span.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &span_end
  (&span_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray (:P Q) D Origin)))

(RULE &out_cell
  (&cell_slab (:P_intile *P_grid_out)))

(RULE &stacked
  (&ink_slab *P_slab))

;; Slabs stack in order, so a slab's rank is its distance from the stacking
;; edge: panel first, then line, both counted from &order_corner.
(INIT &order Order
  (member ((:t P_slab))
    (&stacked *P_slab))
  (before ((:a P_slab) (:b P_slab2))
    (&stacked *P_slab)
    (&stacked (:P_slab *P_slab2))
    (&stacked)
    (&order_corner (:D *Diag))
    (&order_axis *A)
    (OR ((corner_dir (:C Diag) A *D)
         (dir_elem D)
         (margin (:B P_slab) D (:K *K1_m1))
         (margin (:B P_slab2) D (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir (:C Diag) A D)
         (perp A (:A2 *A2_m3))
         (corner_dir (:C Diag) (:A A2_m3) (:D *D2))
         (margin (:B P_slab) D (:K *K_m4))
         (margin (:B P_slab2) D (:K K_m4))
         (dir_elem (:D D2))
         (margin (:B P_slab) (:D D2) (:K *K1_m5))
         (margin (:B P_slab2) (:D D2) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

(RULE &moved
  (&cell_slab *P_slab *P_intile *Col)
  (&order.rank (:t P_slab) *R)
  (&out_cell *P_grid_out)
  (&stack_dir *D)
  (margin (:B P_grid_out) D (:K R))
  (&stack_axis (:A *A_st))
  (perp (:A A_st) (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P_intile) (:D D_m2) (:K *K_m3))
  (margin (:B P_grid_out) (:D D_m2) (:K K_m3)))

(RULE &output
  (&out_cell (:P_grid_out *P))
  (OR ((&moved (:P_grid_out P) *Col))
      ((NOT (&moved (:P_grid_out P)))
       (&bg (:C Col)))))
