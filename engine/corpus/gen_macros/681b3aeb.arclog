;; 681b3aeb

(DET &bg DominantColor)

;; The square the shapes fill.
(DET &side ConstOutDim)

;; Each color's cells and the box they bound.
(INIT &bbox BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(INIT &frame Frame
  (extent (A N)
    (axis_elem *A)
    (&side *N)))

;; A placement lands every cell of the shape in the square.
(INIT &occ Occurrences
  (key ((OR ((&bbox.cell (:key ^Col) *P)
             (&bbox.box (:key Col) *B)
             (ALL ((&bbox.cell (:key (:Col *Colm)) P)
                   (&bbox.box (:key (:Col Colm)) B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X P) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (relative (:Base B) (:X P) (:X_rel *P_inner)))
            ((&bbox.cell (:key Col))
             (&frame.cell P))))
    (cell (P)
      (&bbox.cell)
      (&frame.cell *P))
    (shape ((:P P_inner))
      (&bbox.cell *P)
      (&bbox.box *B)
      (ALL ((&bbox.cell (:key (:Col *Colm)) P)
            (&bbox.box (:key (:Col Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))))

(RULE &covers
  (&occ.occurrence (:key *Col) (:P *B))
  (&occ.shape (:key Col) (:P *P_inner))
  (compose (:A B) (:B P_inner) (:C *P)))

(CHOOSE &forcing
  (for ((&covers ^P))
    (from (&covers *Col *B P)))
  (never
    (&covers *Col *B *P)
    (&covers (:Col *Col2) (:B *B2) (:P *P2))
    (&covers Col B (:P P2))
    (OR ((!= Col Col2))
        ((!= B B2)))))

(RULE &output
  (&forcing *Col *B)
  (&covers Col B *P))
