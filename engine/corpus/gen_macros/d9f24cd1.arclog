;; d9f24cd1

(DET &mark UnchangedColor)

(DET &block RarestColor)

;; Dodge side, as a turn from the walk direction.
(DET &dodge SenseDomain)

(DET &dir DirDomain)

;; The walk: starts at each mark, headed away from the mark edge; steps
;; ahead while clear; deflects one cell to the dodge side when blocked.
(INIT &walk Propagation
  (source ((:n P W))
    (input *P *Col)
    (&mark (:C Col))
    (&dir *D)
    (opposite D (:Opp *W)))
  (edge ((:a P W) (:b (:P P2) W))
    (input *P)
    (dir_elem (:D *W))
    (step_offset (:D W) (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (OR ((input (:P Q) *Col)
         (&block (:C Col))
         (&dodge (:S *Sn))
         (turn (:S Sn) (:D W) (:D2 *Dd))
         (step_offset (:D Dd) (:V *V_m2))
         (compose (:A P) (:B V_m2) (:C *P2))
         (input (:P P2)))
        ((input (:P Q) Col)
         (NOT (&block (:C Col)))
         (= P2 Q)))))

(ALTS $choice "which edge is the mark edge" $Dir
  (ALT $Edge
    ;; The walk: starts at each mark, headed away from the mark edge; steps
    ;; ahead while clear; deflects one cell to the dodge side when blocked.
    (INIT &walk Propagation
      (source ((:n P W))
        (input *P *Col)
        (&mark (:C Col))
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (opposite D (:Opp *W)))
      (edge ((:a P W) (:b (:P P2) W))
        (input *P)
        (dir_elem (:D *W))
        (step_offset (:D W) (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (OR ((input (:P Q) *Col)
             (&block (:C Col))
             (&dodge (:S *Sn))
             (turn (:S Sn) (:D W) (:D2 *Dd))
             (step_offset (:D Dd) (:V *V_m2))
             (compose (:A P) (:B V_m2) (:C *P2))
             (input (:P P2)))
            ((input (:P Q) Col)
             (NOT (&block (:C Col)))
             (= P2 Q)))))))

(RULE &walked
  (&walk.reached (:n *P)))

(RULE &output
  (OR ((&walked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&walked P)))))
