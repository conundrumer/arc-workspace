;; 5b37cb25

(RULE &canvas
  (input *P)
  (relative (:Base 0) (:X P) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (> K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (> K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (> K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (> K4_m11 0))

(INIT &bg_mode_count Cardinality
  (key ((&canvas *P)
        (input P ^Col))
    (member ((:m P))
      (&canvas *P)
      (input P Col))))

(RULE &edge_color
  (input *P *Col)
  (margin (:B P) *D (:K 0))
  (opposite D (:Opp *D_in))
  (step_offset (:D D_in) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&canvas (:P Q)))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ground
  (&canvas *P)
  (input P *Col)
  (&bg_mode.maximal (:t Col)))

(RULE &blob
  (&canvas *P)
  (NOT (&ground P)))

(INIT &ground_rim Boundary
  (cell (P)
    (&ground *P)))

(RULE &diamond
  (&ground *P)
  (NOT (&ground_rim.boundary P)))

(RULE &closed
  (&diamond *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (step_offset D (:V *V_m2))
  (compose (:A Q) (:B V_m2) (:C *R))
  (&blob (:P R)))

;; A diamond open on two sides is no bite, and `bite.value` drops it.
(INIT &bite Singleton
  (key ((&diamond ^P))
    (member ((:v D))
      (dir_elem *D)
      (NOT (&closed P D)))))

(RULE &paint
  (&bite.value (:key (:P *P2)) (:v *D))
  (&edge_color D *Col)
  (OR ((dir_elem (:D *D2))
       (step_offset (:D D2) (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C *P)))
      ((= P P2))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
