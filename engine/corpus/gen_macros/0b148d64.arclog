;; 0b148d64

(RULE &sep_dir
  (dir_elem *D))

(RULE &sep_node
  (input *P))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &ink_slice_split1
  (&ink (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *X_m1_)))

(RULE &ink_slice
  (&ink *P)
  (axis_elem *A)
  (&ink_slice_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1)))

(RULE &sep_cell_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *X_m1_)))

(RULE &sep_cell
  (input *P)
  (axis_elem *A)
  (&sep_cell_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1))
  (NOT (&ink_slice Along)))

(RULE &sep_source
  (&sep_cell *P))

(INIT &sep Distance
  (key ((&sep_source (:P ^O))
        (&sep_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sep_source (:P O))
           (&sep_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sep_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sep_node (:P Q)))
          ((&sep_source (:P O))
           (&sep_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sep_node (:P Q))
           (= A2 O))
          ((&sep_source (:P O))
           (&sep_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sep_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sep_node (:P Q)))))
    (source ((:n O))
      (&sep_source (:P O))
      (&sep_dir D))))

(RULE &sep_ray
  (&sep.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sep_end
  (&sep_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sep_ray (:P Q) D Origin)))

(RULE &side
  (input *P)
  (opposite *D *Opp)
  (NOT (&sep_ray P (:D Opp))))

(RULE &panel
  (corner_dir (:C *Q) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Q) (:A A2_m2) (:D *D2))
  (&side *P (:D D1))
  (&side P (:D D2)))

;; The panel a color belongs to; a color two panels share belongs to neither.
(INIT &color_panel Singleton
  (key ((&panel *P *Q)
        (&ink P ^Col))
    (member ((:v Q))
      (&panel *P *Q)
      (&ink P Col))))

(RULE &odd_panel
  (&color_panel.value (:v *Q)))

(INIT &view BoundingBox
  (cell (P)
    (&odd_panel *Q)
    (&panel *P Q)))

(ALTS $choice "what the crop's box is" $Panel
  (ALT $Ink
    (INIT &view BoundingBox
      (cell (P)
        (&odd_panel *Q)
        (&panel *P Q)
        (&ink P)))

    (RULE &viewed
      (input *P))))

(RULE &viewed
  (&view.cell *P))

(RULE &output
  (&viewed (:P *P2))
  (&view.box *B)
  (ALL ((&viewed (:P P2))
        (&view.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (input (:P P2) *Col))
