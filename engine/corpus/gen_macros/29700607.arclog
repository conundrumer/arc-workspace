;; 29700607

;; The edge the headers sit on.
(DET &head_dir DirDomain)

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &header
  (&ink *P *Col)
  (&head_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &path_axis
  (&header (:Col *Key))
  (axis_elem *A))

(RULE &path_dir
  (&path_axis *Key *A)
  (axis4_of *D A))

(RULE &path_node
  (&path_axis *Key)
  (input *P))

(RULE &marker
  (&ink *P *Col)
  (NOT (&header P)))

(RULE &elbow_split1
  (&marker (:P *M_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B M_) (:D D_m1) (:K *K1_m3))
  (margin (:B M_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X M_) (:X_rel *X_m1_)))

(RULE &elbow_split2
  (&header (:P *H_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B H_) (:D D_m1) (:K *K1_m3))
  (margin (:B H_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X H_) (:X_rel *Across_)))

(RULE &elbow
  (&header (:P *H) *Col)
  (&marker (:P *M) Col)
  (&head_dir *D)
  (axis_of D *A)
  (&elbow_split1 (:M_ M) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1))
  (&elbow_split2 (:H_ H) (:A_ A) (:X_m2_ *X_m2) (:Across_ *Across))
  (compose (:A Along) (:B Across) (:C *P)))

(RULE &path_mark
  (OR ((&header *P (:Col *Key)))
      ((&elbow P (:Col Key)))
      ((&marker P (:Col Key)))))

(RULE &path_source
  (&path_mark *Key *P))

;; Each leg spans two of the wire's three points: header to elbow along the
;; head axis, elbow to marker across it.
(INIT &path Distance
  (key ((&path_source (:Key ^Ky) (:P ^O))
        (&path_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&path_source (:Key Ky) (:P O))
           (&path_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&path_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&path_node (:Key Ky) (:P Q)))
          ((&path_source (:Key Ky) (:P O))
           (&path_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&path_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&path_source (:Key Ky) (:P O))
           (&path_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&path_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&path_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&path_source (:Key Ky) (:P O))
      (&path_dir (:Key Ky) D))))

(RULE &path_ray
  (&path.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &path_between
  (&header (:Col *Key))
  (input *P)
  (&path_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&path_ray Key P D)
  (&path_ray Key P (:D O)))

(RULE &path_end
  (&path_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&path_ray Key (:P Q) D Origin)))

(RULE &path_cell
  (&header (:Col *Key))
  (input *P))

(RULE &wire
  (OR ((&path_between (:Key *Col) *P))
      ((&header (:P *H) Col)
       (NOT (&elbow Col))
       (&head_dir (:D *D_head))
       (opposite (:D D_head) (:Opp *D))
       (&path_ray (:Key Col) P D (:Origin H))
       (&path_cell (:Key Col) P))))

(ALTS $choice "where the turned leg ends" $AtMarker
  (ALT $ToEdge
    (RULE &side
      (&elbow (:P *E) *Col)
      (&marker (:P *M) Col)
      (&head_dir (:D *D_head))
      (axis_of (:D D_head) (:A *A_m1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (axis_of *D (:A A2_m2))
      (&path_ray (:Key Col) (:P M) D (:Origin E))
      (&path_cell (:Key Col) (:P M)))

    (RULE &wire
      ;; every marker sits on a frame edge, so this rule agrees with $AtMarker on every pair
      (OR ((&elbow (:P *E) *Col)
           (&side Col *D)
           (&path_ray (:Key Col) *P D (:Origin E))
           (&path_cell (:Key Col) P))
          ((&path_between (:Key Col) P))
          ((&header (:P *H) Col)
           (NOT (&elbow Col))
           (&head_dir (:D *D_head))
           (opposite (:D D_head) (:Opp *D2))
           (&path_ray (:Key Col) P (:D D2) (:Origin H))
           (&path_cell (:Key Col) P))))))

(RULE &output
  (OR ((&wire *Col *P))
      ((input P)
       (NOT (&wire P))
       (&bg (:C Col)))))
