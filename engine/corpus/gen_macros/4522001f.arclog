;; 4522001f

(DET &bg DominantColor)

(DET &canvas Frame)

(DET &input
  (ex_output *E)
  (ex_input E *P *Col))

(DET &output2
  (ex_output *E *P *Col))

(DET &pose4
  (ex_output *E)
  (c4_elem *D))

;; The exemplar pair, with the poses of the rotations of the training
;; instance it is.
(RIGID_DET &pair
  (&input *E *P *Col)
  (&output2 *E *P *Col)
  (&pose4 *E *D))

;; The placements of the stored input that equal the observed input.
(INIT &pair_match Inclusion
  (pattern ((:pattern P) (:m (:P Q) Col))
    (&pair.input (:Pose *P) (:P *Q) *Col))
  (observed ((:m (:P Q) Col))
    (input (:P *Q) *Col)))

(ALTS $choice "how the rotation is found and what it carries" $Pair
  (ALT $Loc
    (DET &sq_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (DET &cell
      (ex_output *E *P *Col)
      (NOT (&bg (:C Col))))

    ;; The boxes as separate objects; the stored one seats at the corner.
    (INIT &sq Quotient
      (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
        (OR ((&cell *E *P)
             (&sq_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&cell E (:P P3)))
            ((&cell E P)
             (= P3 P)))))

    (DET &sq_component
      (&sq.class (:a *Key *P) *Id))

    ;; The corner the picture seats against.
    (INIT &pbox BoundingBox
      (key ((&cell ^E *P))
        (cell (P)
          (&cell E *P))))

    (DET &corner2
      (&pbox.box (:key *E) *B)
      (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin B (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin B (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (DET &anchor
      (&corner2 *E *D))

    (INIT &sqbox BoundingBox
      (key ((&sq_component (:Key ^E) *P ^Id))
        (cell (P)
          (&sq_component (:Key E) *P Id))))

    (DET &margin
      (&sqbox.box (:key *E) *B)
      (&corner2 E (:D *Diag))
      (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
      (margin B (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin B (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6))
      (dir_elem *D)
      (margin B D *K))

    (DET &pose2
      (ex_output *E)
      (c4_elem *D))

    ;; The first box, as its margin at each edge, with the corner it seats at
    ;; and the poses of the rotations of the training instance it is drawn
    ;; from.
    (RIGID_DET &box
      (&anchor *E *D)
      (&margin *E *D *K)
      (&pose2 *E *D))

    (RULE &box_seated
      (&box.anchor (:Pose *P) (:D *C))
      (&box.pose2 (:Pose P) (:D *R))
      (c4_elem (:D R))
      (&box.margin (:Pose P) *D *K))

    (RULE &block
      (input *P *Col)
      (NOT (&bg (:C Col))))

    (INIT &bb BoundingBox
      (cell (P)
        (&block *P)))

    ;; The grid corner the block touches.
    (RULE &diag
      (&bb.box *B)
      (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin B (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin B (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))

    (RULE &sq_edge
      (&diag (:D *Diag))
      (&box_seated (:C Diag) *D *K))

    (RULE &sq_axis
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&sq_edge D (:K *K1))
      (&sq_edge (:D D2) (:K *K2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K K1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B)))

    (RULE &sq2
      (&sq_axis *A (:B *B1))
      (perp A *A2)
      (&sq_axis (:A A2) (:B *B2))
      (compose (:A B1) (:B B2) (:C *B)))

    (DET &mark RarestColor)

    (RULE &sq_jump
      (&diag (:D *Diag))
      (diag_opposite (:D Diag) (:Opp *Od))
      (corner_dir (:C Od) *A (:D *O1))
      (perp A (:A2 *A2_m1))
      (corner_dir (:C Od) (:A A2_m1) (:D *O2))
      (&sq2 *B)
      (&canvas *P)
      (perp A *A2)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) A (:N *K1))
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m3))
      (frame_extent (:P R_m3) (:A A2) (:N *K2))
      (dir8_opposite (:D O1) (:D2 *O_m4))
      (edge_inset (:D O_m4) (:K K1) (:B *B1_m5))
      (edge_inset (:D O1) (:K K1) (:B *I_m7))
      (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *V1))
      (dir8_opposite (:D O2) (:D2 *O_m8))
      (edge_inset (:D O_m8) (:K K2) (:B *B1_m9))
      (edge_inset (:D O2) (:K K2) (:B *I_m11))
      (relative (:Base I_m11) (:X 0) (:X_rel *B2_m10))
      (compose (:A B1_m9) (:B B2_m10) (:C *V2))
      (compose (:A V1) (:B V2) (:C *V)))

    (RULE &grow_box
      (OR ((&sq2 *B))
          ((&sq2 (:B *B3))
           (&sq_jump *V)
           (compose (:A B3) (:B V) (:C B))
           (relative (:Base 0) (:X B) (:X_rel *R_m1))
           (axis_of (:D *D1_m2) (:A *A1_m3))
           (opposite (:D D1_m2) (:Opp *O1_m4))
           (perp (:A A1_m3) (:A2 *A2_m5))
           (axis_of (:D *D2_m6) (:A A2_m5))
           (opposite (:D D2_m6) (:Opp *O2_m7))
           (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
           (>= K1_m8 0)
           (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
           (>= K2_m9 0)
           (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
           (>= K3_m10 0)
           (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
           (>= K4_m11 0))))

    (RULE &paint
      (input *Col)
      (NOT (&bg (:C Col)))
      (NOT (&mark (:C Col))))

    (RULE &lit
      (&grow_box *B)
      (&canvas *P)
      (ALL ((&grow_box B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (&paint *Col))

    (RULE &output
      (OR ((&lit *P *Col))
          ((&canvas P)
           (NOT (&lit P))
           (&bg (:C Col)))))
    (ALTS $l "the boxes' corner" $Corner
      (ALT $Mark
        ;; The block corner opposite the mark cell.
        (RULE &diag
          (input *P *Col)
          (&mark (:C Col))
          (&block P)
          (&bb.box *B)
          (ALL ((input P (:Col *Colm))
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (diag_opposite (:D *D2) (:Opp *D))
          (ALL ((diag_opposite (:D D2) (:Opp *Diagm))
                (input P (:Col *Colmm))
                (corner_dir (:C D2) (:D *D_m1m))
                (margin (:B P) (:D D_m1m) (:K *K1_m2))
                (margin B (:D D_m1m) (:K *K2_m3)))
               ((= K1_m2 K2_m3))))))
    (ALTS $r "the boxes" $Grow
      (ALT $Fit
        (RULE &fit_cell
          (&diag (:D *Diag))
          (diag_opposite (:D Diag) (:Opp *Od))
          (corner_dir (:C Od) *A (:D *O1))
          (perp A (:A2 *A2_m1))
          (corner_dir (:C Od) (:A A2_m1) (:D *O2))
          (&sq2 *B)
          (&canvas *P)
          (perp A *A2)
          (axis_elem A)
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (frame_extent (:P R_m2) A (:N *K1))
          (axis_elem (:A A2))
          (relative (:Base B) (:X P) (:X_rel *R_m3))
          (frame_extent (:P R_m3) (:A A2) (:N *K2))
          (relative (:Base B) (:X P) (:X_rel *R))
          (opposite (:D O1) (:Opp *C1))
          (opposite (:D O2) (:Opp *C2))
          (margin (:B R) (:D C1) (:K *T1))
          (divide (:T T1) (:Side K1) (:Gap 0) (:Part *N) (:Remainder *R1))
          (margin (:B R) (:D C2) (:K *T2))
          (divide (:T T2) (:Side K2) (:Gap 0) (:Part N) (:Remainder *R2))
          (dir8_opposite (:D C1) (:D2 *O_m5))
          (edge_inset (:D O_m5) (:K R1) (:B *B1_m6))
          (edge_inset (:D C1) (:K R1) (:B *I_m8))
          (relative (:Base I_m8) (:X 0) (:X_rel *B2_m7))
          (compose (:A B1_m6) (:B B2_m7) (:C *V_m4))
          (compose (:A P) (:B V_m4) (:C *P1))
          (dir8_opposite (:D C2) (:D2 *O_m10))
          (edge_inset (:D O_m10) (:K R2) (:B *B1_m11))
          (edge_inset (:D C2) (:K R2) (:B *I_m13))
          (relative (:Base I_m13) (:X 0) (:X_rel *B2_m12))
          (compose (:A B1_m11) (:B B2_m12) (:C *V_m9))
          (compose (:A P1) (:B V_m9) (:C *P_corner))
          (&canvas (:P *P0))
          (ALL ((&sq2 B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P0) (:X_rel *R_m2m))
                (margin (:B R_m2m) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (ALL ((&diag (:D Diag))
                (&sq2 B)
                (corner_dir (:C Diag) (:D *D_m1m))
                (margin (:B P0) (:D D_m1m) (:K *K1_m2))
                (margin B (:D D_m1m) (:K *K2_m3)))
               ((= K1_m2 K2_m3)))
          (relative (:Base P0) (:X P_corner) (:X_rel *V))
          (compose (:A B) (:B V) (:C *B_n))
          (relative (:Base 0) (:X B_n) (:X_rel *R_m14))
          (axis_of (:D *D1_m15) (:A *A1_m16))
          (opposite (:D D1_m15) (:Opp *O1_m17))
          (perp (:A A1_m16) (:A2 *A2_m18))
          (axis_of (:D *D2_m19) (:A A2_m18))
          (opposite (:D D2_m19) (:Opp *O2_m20))
          (margin (:B R_m14) (:D D1_m15) (:K *K1_m21))
          (>= K1_m21 0)
          (margin (:B R_m14) (:D O1_m17) (:K *K2_m22))
          (>= K2_m22 0)
          (margin (:B R_m14) (:D D2_m19) (:K *K3_m23))
          (>= K3_m23 0)
          (margin (:B R_m14) (:D O2_m20) (:K *K4_m24))
          (>= K4_m24 0))
        (RULE &lit
          (&fit_cell *P)
          (&paint *Col)))
      (ALT $Stamp
        (DET &corner
          (&corner2 *E *D))
        (DET &pose3
          (ex_output *E)
          (c4_elem *D))
        ;; The output picture, whose member cells take the paint, with the corner
        ;; it seats at and the poses of the rotations of the training instance it
        ;; is drawn from.
        (RIGID_DET &mask
          (&corner *E *D)
          (&cell *E *P)
          (&pose3 *E *D))
        (RULE &mask_seated
          (&mask.corner (:Pose *P2) (:D *C))
          (&mask.pose3 (:Pose P2) (:D *R))
          (c4_elem (:D R))
          (&mask.cell (:Pose P2) *P))
        (RULE &lit
          (&diag (:D *Diag))
          (&mask_seated (:C Diag) *P)
          (&paint *Col))))
    (ALTS $f "box color" $Block
      (ALT $Ink
        (DET &ink
          (ex_output (:Col *C))
          (NOT (&bg C)))
        (RULE &paint
          (&ink (:C *Col)))))))

(RULE &output
  (OR ((&canvas *P)
       (&bg (:C *Col)))
      ;; Canvas and colors both come from the stored output.
      ((&pair_match.equal (:pattern *P2))
       (&pair.pose4 (:Pose P2) (:D *R))
       (c4_elem (:D R))
       (&pair.output2 (:Pose P2) P Col))))
