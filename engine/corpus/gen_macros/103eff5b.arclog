;; 103eff5b

(DET &shape_col ChangedColor)

(RULE &shape_cell
  (input *P *Col)
  (&shape_col (:C Col)))

(INIT &shape_box BoundingBox
  (cell (P)
    (&shape_cell *P)))

(RULE &box_view
  (input (:P *P_grid))
  (&shape_box.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

;; The shape's box divided into the key's block arrangement.
(INIT &blocks_sides ExtentDivisions
  (frame ((:P P_inner))
    (&box_view *P_inner)))

(DET &bg DominantColor)

(RULE &key_cell
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&shape_col (:C Col))))

(INIT &key_box BoundingBox
  (cell (P)
    (&key_cell *P)))

;; The turn taking the key onto the shape.
(DET &turn_to_shape D4Domain)

(RULE &tile_col
  (&key_cell *P *Col)
  (&key_box.box *B)
  (ALL ((&key_cell P (:Col *Colm))
        (&key_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_tile_key))
  (&turn_to_shape *D)
  (apply D (:P P_tile_key) (:P_out *P_tile)))

(RULE &blocks_axis_split1
  (&box_view (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &blocks_parts
  (&tile_col *P_tile)
  (axis_elem *A)
  (frame_extent (:P P_tile) A *N))

(RULE &blocks_axis
  (OR ((&box_view (:P_inner *P))
       (&tile_col *P_tile)
       (axis_elem *A)
       (frame_extent (:P P_tile) A *N)
       (&blocks_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&box_view (:P_inner P))
       (&tile_col (:P_tile *P_tile2))
       (axis_elem A)
       (frame_extent (:P P_tile2) A (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&box_view (:P_inner P))
       (axis_elem A)
       (NOT (&blocks_parts A))
       (&blocks_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &blocks_tile
  (&blocks_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&blocks_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(ALTS $choice "whether the shape's own ink or the blown-up key supplies each block's mask" $Recolor
  (ALT $Stamp
    (RULE &output
      (OR ((&box_view (:P_grid *P) *P_inner)
           (&blocks_tile (:P P_inner) (:P_outer *P_tile))
           (OR ((&tile_col P_tile *Col))
               ((NOT (&tile_col P_tile))
                (&bg (:C Col)))))
          ((input P Col)
           (NOT (&box_view (:P_grid P))))))))

(RULE &output
  (OR ((&shape_cell *P)
       (&box_view (:P_grid P) *P_inner)
       (&blocks_tile (:P P_inner) (:P_outer *P_tile))
       (&tile_col P_tile *Col))
      ((input P Col)
       (NOT (&shape_col (:C Col))))))
