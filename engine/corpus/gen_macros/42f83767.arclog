;; 42f83767

;; Blank line between a strip's blocks.
(DET &gap TileDim)

;; The strips run along this axis.
(DET &strip_axis AxisDomain)

;; The stencils' color.
(DET &stencil VanishedColor)

(INIT &stencils BoundingBox
  (cell (P)
    (input *P *Col)
    (&stencil (:C Col))))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stencil (:C Col))))

(RULE &legend_cell_split1
  (&stencils.box (:B *B_))
  (&strip_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B B_) (:D D_m1) (:K *K1_m3))
  (margin (:B B_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X B_) (:X_rel *B_slab_)))

(RULE &legend_cell
  (&ink *P)
  (&stencils.box *B)
  (&strip_axis *A)
  (&legend_cell_split1 (:B_ B) (:A_ A) (:X_m1_ *X_m1) (:B_slab_ *B_slab))
  (ALL ((&stencils.box (:B *Bm))
        (&strip_axis (:A *Am))
        (axis_of (:D *D_m2) (:A Am))
        (opposite (:D D_m2) (:Opp *O_m3))
        (margin (:B Bm) (:D D_m2) (:K *K1_m4))
        (margin (:B Bm) (:D O_m3) (:K *K2_m5))
        (opposite (:D D_m2) (:Opp *O_m6))
        (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
        (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
        (compose (:A B1_m7) (:B B2_m8) (:C *Along_m1))
        (relative (:Base Along_m1) (:X Bm) (:X_rel B_slab))
        (dir_elem (:D *D_m1))
        (relative (:Base B_slab) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(INIT &legend BoundingBox
  (cell (P)
    (&legend_cell *P)))

(RULE &strip_box
  (OR ((&stencils.box *B))
      ((&legend.box B))))

(RULE &block_cell_division_gap
  (&strip_box *B)
  (input *P)
  (&strip_axis *A)
  (&gap (:D *G)))

(RULE &block_cell_division_axis_split1
  (&strip_box *B)
  (input *P)
  (relative (:Base B) (:X P) (:X_rel *P_strip_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_strip_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_strip_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_strip_) (:X_rel *X_m1_)))

(RULE &block_cell_division_side
  (&strip_box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (&strip_axis *A)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) (:A A2) (:N *K)))

(RULE &block_cell_division_axis
  (OR ((&strip_box *B)
       (input (:P *Key_p))
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X Key_p) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X Key_p) (:X_rel *P))
       (&strip_axis *A)
       (perp A *A2)
       (axis_elem (:A A2))
       (relative (:Base B) (:X Key_p) (:X_rel *R_m1))
       (frame_extent (:P R_m1) (:A A2) (:N *K))
       (&gap (:D *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m2))
       (edge_inset D (:K I) (:B *B1_m3))
       (edge_inset (:D O_m2) (:K I2) (:B *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *P_outer))
       (opposite D (:Opp *O_m5))
       (edge_inset D (:K R) (:B *B1_m6))
       (edge_inset (:D O_m5) (:K R2) (:B *B2_m7))
       (compose (:A B1_m6) (:B B2_m7) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&strip_box B)
       (input (:P Key_p))
       (ALL ((dir_elem (:D *D_m12))
             (relative (:Base B) (:X Key_p) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B) (:X Key_p) (:X_rel P))
       (&strip_axis A)
       (perp A (:A2 *A22))
       (axis_elem (:A A22))
       (relative (:Base B) (:X Key_p) (:X_rel *R_m12))
       (frame_extent (:P R_m12) (:A A22) (:N *K2))
       (NOT (&block_cell_division_gap B (:P Key_p) A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m22))
       (edge_inset (:D D2) (:K I3) (:B *B1_m32))
       (edge_inset (:D O_m22) (:K I22) (:B *B2_m42))
       (compose (:A B1_m32) (:B B2_m42) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m52))
       (edge_inset (:D D2) (:K R3) (:B *B1_m62))
       (edge_inset (:D O_m52) (:K R22) (:B *B2_m72))
       (compose (:A B1_m62) (:B B2_m72) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((&strip_box B)
       (input (:P Key_p))
       (ALL ((dir_elem (:D *D_m13))
             (relative (:Base B) (:X Key_p) (:X_rel *R_m23))
             (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
            ((>= K_m33 0)))
       (relative (:Base B) (:X Key_p) (:X_rel P))
       (axis_elem A)
       (NOT (&block_cell_division_side B (:P Key_p) A))
       (&block_cell_division_axis_split1 (:P_strip_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &block_cell_division_tile
  (&block_cell_division_axis *B *Key_p *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&block_cell_division_axis B Key_p P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &composition BoundingBox
  (cell (P)
    (&ink *P)
    (NOT (&legend_cell P))))

(RULE &block_cell
  (&block_cell_division_tile *B (:Key_p *P) (:P_outer *P_block) (:P_inner *P_intile)))

(RULE &stencil_cell
  (&stencils.box *B)
  (&block_cell B *P *P_block *P_intile)
  (input P *Col))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&composition.box *B)
    (&composition.cell *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_tile)))
  (inner ((:P P_intile))
    (&stencil_cell *P_intile)))

(RULE &legend_color
  (&legend.box *B)
  (&block_cell B *P *P_block)
  (&legend_cell P)
  (input P *Col))

(RULE &output
  (&composition.box *B)
  (&composition.cell (:P *P2))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_tile))
  (input (:P P2) (:Col *Col_tile))
  (&legend_color *P_block (:Col Col_tile))
  (&stencil_cell P_block *P_intile (:Col *T))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P)
  (OR ((NOT (&stencil (:C T)))
       (&bg (:C *Col)))
      ((&stencil (:C T))
       (= Col Col_tile))))
