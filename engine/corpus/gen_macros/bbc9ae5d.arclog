;; bbc9ae5d

(DET &diag DiagDirDomain)

(RULE &rays_dir
  (&diag *D))

(RULE &rays_node
  (input *P))

(DET &divisor SepThickness)

(RULE &long_axis
  (input *P)
  (perp *A (:A2 *A2_m1))
  (frame_extent P A (:N *N1))
  (frame_extent P (:A A2_m1) (:N *N2))
  (> N1 N2))

(RULE &frame_division_cell
  (&long_axis (:A *Key))
  (input *P))

(INIT &frame_division_sides ExtentDivisions
  (key ((&frame_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&frame_division_cell (:Key Ky) *P))))

(RULE &frame_division_axis_split1
  (&frame_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &frame_division_parts_held
  (&long_axis *A)
  (&divisor (:G *K)))

(RULE &frame_division_axis
  (OR ((&frame_division_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&frame_division_parts_held (:A Key)))))
       (&frame_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&frame_division_cell Key P)
       (&long_axis (:A Key))
       (&divisor (:G *K))
       (&frame_division_sides.division (:key (:Ky Key)) (:A Key) (:N K) (:K *K2) (:G 0))
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K2) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K2) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K2))
       (= A Key))
      ((&frame_division_cell Key P)
       (&long_axis (:A Key))
       (&divisor (:G *K3))
       (frame_extent P (:A Key) (:N *K22))
       (axis_of (:D *D2) (:A Key))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K22) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K22) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K22))
       (frame_extent (:P P_outer) (:A Key) (:N K3))
       (= A Key))))

(RULE &frame_division_tile
  (&frame_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&frame_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &extent_split1
  (&frame_division_tile (:Key *A_) (:P_inner *P_slab_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part_))
  (relative (:Base P_part_) (:X P_slab_) (:X_rel *X_m1_)))

;; Output frame: the line's extent along, line length / &divisor across.
(INIT &frame Frame
  (extent (A N)
    (OR ((&long_axis *A)
         (input *P)
         (frame_extent P A *N))
        ((&frame_division_tile (:Key *A3) (:P_inner *P_slab))
         (&extent_split1 (:P_slab_ P_slab) (:A_ A3) (:P_part_ *P_part) (:X_m1_ *X_m1))
         (perp (:A A3) (:A2 A))
         (frame_extent (:P P_part) (:A A3) N)))))

(RULE &seated
  (input (:P *P_in) *Col)
  (&frame.cell *P)
  (&diag (:D *Diag))
  (&long_axis *A)
  (corner_dir (:C Diag) A (:D *D_adv))
  (perp A (:A2 *A2_m1))
  (corner_dir (:C Diag) (:A A2_m1) (:D *D_stack))
  (margin (:B P_in) (:D D_adv) (:K *K_m2))
  (margin (:B P) (:D D_adv) (:K K_m2))
  (opposite (:D D_stack) (:Opp *D_seed))
  (margin (:B P) (:D D_seed) (:K 0)))

(RULE &rays_source
  (&seated *P))

;; Each seated cell casts toward &diag.
(INIT &rays Distance
  (key ((&rays_source (:P ^O))
        (&rays_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:P O))
           (&rays_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:P Q)))
          ((&rays_source (:P O))
           (&rays_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:P Q))
           (= A2 O))
          ((&rays_source (:P O))
           (&rays_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:P Q)))))
    (source ((:n O))
      (&rays_source (:P O))
      (&rays_dir D))))

(RULE &rays_ray2
  (&rays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray2 *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray2 (:P Q) D Origin)))

(RULE &fall_dir
  (&diag (:D *Diag))
  (&long_axis *A)
  (corner_dir (:C Diag) A (:D *D1_m1))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) *D))

(RULE &fall_node
  (input *P))

(DET &bg SharedColor)

(RULE &ink_cast
  (&rays_ray2 *P (:Origin *Q))
  (&frame.cell P)
  (&seated (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &fall_source
  (&ink_cast *P))

(INIT &fall Distance
  (key ((&fall_source (:P ^O))
        (&fall_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&fall_source (:P O))
           (&fall_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&fall_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&fall_node (:P Q)))
          ((&fall_source (:P O))
           (&fall_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&fall_node (:P Q))
           (= A2 O))
          ((&fall_source (:P O))
           (&fall_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&fall_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&fall_node (:P Q)))))
    (source ((:n O))
      (&fall_source (:P O))
      (&fall_dir D))))

(RULE &fall_ray
  (&fall.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &fall_end
  (&fall_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&fall_ray (:P Q) D Origin)))

(RULE &grown
  (&fall_ray *P (:Origin *Q))
  (&frame.cell P)
  (&ink_cast (:P Q) *Col))

(ALTS $choice "how each row continues from the one before it" $Grow
  (ALT $Slide
    (RULE &rays_ray
      (&rays_ray2 *P *D *K (:Origin *Src))
      (&frame.cell P))

    (RULE &anchor_color
      (&seated *P *Col)
      (&diag (:D *Diag))
      (diag_opposite (:D Diag) (:Opp *Anchor))
      (corner_dist P (:Diag Anchor) (:K 0)))

    (RULE &output
      (OR ((&rays_ray2 *P (:Origin *Q))
           (&frame.cell P)
           (&seated (:P Q) *Col))
          ((&frame.cell P)
           (NOT (&rays_ray P))
           (&anchor_color Col))))))

(RULE &output
  (OR ((&grown *P *Col))
      ((&frame.cell P)
       (NOT (&grown P))
       (&bg (:C Col)))))
