;; 444801d8

(RULE &walls_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &wall SharedColor)

;; A box is a connected run of wall cells.
(INIT &walls Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&wall (:C Col))
         (&walls_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&wall (:C Col2)))
        ((input P (:Col *Col3))
         (&wall (:C Col3))
         (= P3 P)))))

(RULE &walls_component
  (&walls.class (:a *P) *Id))

(DET &bg DominantColor)

(DET &open_dir DirDomain)

(INIT &bbox BoundingBox
  (key ((&walls_component *P ^Id))
    (cell (P)
      (&walls_component *P Id))))

(RULE &seed
  (&bbox.box (:key *Id) *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&wall (:C Col)))
  (NOT (&bg (:C Col))))

(RULE &open_side
  (&bbox.box (:key *Id))
  (&open_dir *D))

(ALTS $choice "which side is open; every box here breaks on the top, so the two models agree" $Dir
  (ALT $Gap
    (RULE &open_side
      (&bbox.box (:key *Id) *B)
      (input *P *Col)
      (ALL ((input P (:Col *Colm))
            (&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) *D (:K *K_m1))
      (margin B D (:K K_m1))
      (NOT (&wall (:C Col))))))

(RULE &paint
  (&open_side *Id *D)
  (&seed Id *Col)
  (&bbox.box (:key Id) *B)
  (OR ((input *P)
       (relative (:Base B) (:X P) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (>= K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (>= K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (>= K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (>= K4_m11 0))
      ((input (:P *Q))
       (relative (:Base B) (:X Q) (:X_rel *R_m12))
       (axis_of (:D *D1_m13) (:A *A1_m14))
       (opposite (:D D1_m13) (:Opp *O1_m15))
       (perp (:A A1_m14) (:A2 *A2_m16))
       (axis_of (:D *D2_m17) (:A A2_m16))
       (opposite (:D D2_m17) (:Opp *O2_m18))
       (margin (:B R_m12) (:D D1_m13) (:K *K1_m19))
       (>= K1_m19 0)
       (margin (:B R_m12) (:D O1_m15) (:K *K2_m20))
       (>= K2_m20 0)
       (margin (:B R_m12) (:D D2_m17) (:K *K3_m21))
       (>= K3_m21 0)
       (margin (:B R_m12) (:D O2_m18) (:K *K4_m22))
       (>= K4_m22 0)
       (margin (:B Q) D (:K *K_m23))
       (margin B D (:K K_m23))
       (step_offset D (:V *V_m24))
       (compose (:A Q) (:B V_m24) (:C P))))
  (input P (:Col *C))
  (NOT (&wall C)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
