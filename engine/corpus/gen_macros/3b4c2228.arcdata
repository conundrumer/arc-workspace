(param &block_color Color (3))
(param &block_shape Position (Frame
  ((:A AXIS_V) (:N 2))
  ((:A AXIS_H) (:N 2))))
(param &mark Color (1))
(param &bg Color (0))
(param &out_diag DiagDir (DIAG_TL))
(param &out_pos Position (Frame
  ((:A AXIS_V) (:N 3))
  ((:A AXIS_H) (:N 3))))
(param &lookup_grid (number Position Color)
  (1 (grid
    (1 0 0)
    (0 0 0)
    (0 0 0)))
  (2 (grid
    (1 0 0)
    (0 1 0)
    (0 0 0)))
  (3 (grid
    (1 0 0)
    (0 1 0)
    (0 0 1))))
