;; 5ad4f10b

;; The picture's extent, in pixels.
(DET &dim ConstOutDim)

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &figure
  (&ink *Col *P)
  (corner_dir (:C *G) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C G) (:A A2_m2) (:D *D2))
  (step_offset (:D D1) (:V *V_m3))
  (compose (:A P) (:B V_m3) (:C *Q1))
  (&ink Col (:P Q1))
  (step_offset (:D D2) (:V *V_m4))
  (compose (:A P) (:B V_m4) (:C *Q2))
  (&ink Col (:P Q2))
  (step_offset (:D G) (:V *V_m5))
  (compose (:A P) (:B V_m5) (:C *Q3))
  (&ink Col (:P Q3)))

;; The drawing: the box the figure occupies, its cells read as figure or blank.
(INIT &bbox BoundingBox
  (cell (P)
    (&figure *Col)
    (&ink Col *P)))

(RULE &drawing
  (input *P (:Col *C))
  (&bbox.box *B)
  (ALL ((input P (:Col *Cm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (OR ((NOT (&figure (:Col C)))
       (&bg (:C *Col)))
      ((&figure (:Col C))
       (= Col C))))

(INIT &pixel_division_sides ExtentDivisions
  (frame ((:P P_inner))
    (&drawing *P_inner)))

(RULE &pixel_division_axis_split1
  (&drawing (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &pixel_division_parts
  (axis_elem *A)
  (&dim *N))

(RULE &pixel_division_axis
  (OR ((&drawing (:P_inner *P))
       (axis_elem *A)
       (&dim *N)
       (&pixel_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&drawing (:P_inner P))
       (axis_elem A)
       (&dim (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&drawing (:P_inner P))
       (axis_elem A)
       (NOT (&pixel_division_parts A))
       (&pixel_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &pixel_division_tile
  (&pixel_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&pixel_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &speck
  (&ink *Col)
  (NOT (&figure Col)))

(RULE &pixel
  (&pixel_division_tile (:P *P_inner) (:P_outer *P_tile)))

(ALTS $choice "how wide the picture is" $Extent
  (ALT $Pixels
    (RULE &pixel_cand_division_axis_split1
      (&drawing (:P_inner *P_inner_))
      (axis_elem (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &pixel_cand_division_side_held
      (&drawing *P_inner)
      (sub_extent (:P P_inner) *A (:K *S)))

    (RULE &pixel_cand_division_axis
      (OR ((&drawing (:P_inner *P))
           (sub_extent P (:A *Key_a) (:K *S))
           (axis_elem *A)
           (OR ((!= A Key_a))
               ((NOT (&pixel_cand_division_side_held (:A Key_a) S))))
           (&pixel_cand_division_axis_split1 (:P_inner_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&drawing (:P_inner P))
           (sub_extent P (:A Key_a) (:K S))
           (&drawing (:P_inner *P_inner2))
           (sub_extent (:P P_inner2) (:A Key_a) (:K S))
           (axis_of *D (:A Key_a))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side S) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side S) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key_a) (:N S))
           (= A Key_a))))

    (RULE &pixel_cand_division_tile
      (&pixel_cand_division_axis (:Key_a *A) *S *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&pixel_cand_division_axis (:Key_a A) S P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &pixel_cand_division2_axis_split1
      (&drawing (:P_inner *P_inner_))
      (axis_elem (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &pixel_cand_division2_side_held
      (&drawing *P_inner)
      (frame_extent (:P P_inner) *A (:N *S)))

    (RULE &pixel_cand_division2_axis
      (OR ((&drawing (:P_inner *P))
           (frame_extent P (:A *Key_a) (:N *S))
           (axis_elem *A)
           (OR ((!= A Key_a))
               ((NOT (&pixel_cand_division2_side_held (:A Key_a) S))))
           (&pixel_cand_division2_axis_split1 (:P_inner_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&drawing (:P_inner P))
           (frame_extent P (:A Key_a) (:N S))
           (&drawing (:P_inner *P_inner2))
           (frame_extent (:P P_inner2) (:A Key_a) (:N S))
           (axis_of *D (:A Key_a))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side S) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side S) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key_a) (:N S))
           (= A Key_a))))

    (RULE &pixel_cand_division2_tile
      (&pixel_cand_division2_axis (:Key_a *A) *S *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&pixel_cand_division2_axis (:Key_a A) S P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &pixel_cand
      (OR ((&pixel_cand_division_tile *A *S))
          ((&pixel_cand_division2_tile A S))))

    (RULE &run_color_division_axis_split1
      (&drawing (:P_inner *P_inner_))
      (axis_elem (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &run_color_division_side_held
      (&pixel_cand *A *S))

    (RULE &run_color_division_axis
      (OR ((&pixel_cand (:A *Key_a) *S)
           (&drawing (:P_inner *P))
           (axis_elem *A)
           (OR ((!= A Key_a))
               ((NOT (&run_color_division_side_held (:A Key_a) S))))
           (&run_color_division_axis_split1 (:P_inner_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&pixel_cand (:A Key_a) S)
           (&drawing (:P_inner P))
           (axis_of *D (:A Key_a))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side S) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side S) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key_a) (:N S))
           (= A Key_a))))

    (RULE &run_color_division_tile
      (&run_color_division_axis (:Key_a *A) *S *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&run_color_division_axis (:Key_a A) S P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &item_split1
      (&run_color_division_tile (:A *A_) *S (:P *P_inner_) *P_outer)
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_inner_) (:X_rel *P_across_)))

    (INIT &run_color Singleton
      (key ((&run_color_division_tile ^A ^S (:P *P_inner) ^P_outer)
            (&drawing P_inner *Col)
            (&item_split1 (:P_inner_ P_inner) (:A_ A) (:X_m1_ *X_m1) (:P_across_ ^P_across)))
        (member ((:v Col))
          (&run_color_division_tile A S (:P *P_inner) P_outer)
          (&drawing P_inner *Col)
          (&item_split1 (:P_inner_ P_inner) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))))

    (RULE &pixel_broken
      (&run_color.plural (:key *A *S)))

    ;; The pixels are as large as the drawing allows.
    (INIT &pixel_size Order
      (key ((&pixel_cand ^A *S)
            (NOT (&pixel_broken A S)))
        (member ((:t S))
          (&pixel_cand A *S)
          (NOT (&pixel_broken A S)))
        (score ((:t S) S)
          (&pixel_cand A *S)
          (NOT (&pixel_broken A S)))))

    (RULE &pixels_axis_split1
      (&drawing (:P_inner *P_inner_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &pixels_axis
      (OR ((&drawing (:P_inner *P))
           (&pixel_size.maximal (:key *A) (:t *S))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side S) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side S) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N S)))
          ((&drawing (:P_inner P))
           (axis_elem A)
           (NOT (&pixel_size.maximal (:key A)))
           (&pixels_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &pixels_tile
      (&pixels_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&pixels_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &pixel
      (&pixels_tile (:P *P_inner) (:P_outer *P_tile)))))

(RULE &filled
  (&pixel *P_inner *P_tile)
  (&drawing P_inner *Col)
  (&figure Col))

(RULE &output
  (&pixel (:P_tile *P))
  (IF ((&filled (:P_tile P)))
      ((&speck *Col))
      ((&bg (:C Col)))))
