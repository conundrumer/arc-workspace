;; 78332cb0

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(DET &sep SharedColor)

(RULE &lattice_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (&sep (:C Col)))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The lattice the separator lines cut.
(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each tile's own box.
(INIT &tile BoundingBox
  (key ((&lattice_tile_of *P ^P_tile))
    (cell (P)
      (&lattice_tile_of *P P_tile))))

(RULE &port_split1
  (&tile.box (:key *P_tile) *B)
  (&tile.cell (:key P_tile) *P)
  (relative (:Base B) (:X P) (:X_rel *P_intile_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_intile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_intile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_intile_) (:X_rel *Across_)))

(DET &gap TileDim)

(DET &bg DominantColor)

(RULE &port
  (&tile.cell (:key *P_tile) *P)
  (input P *Col)
  (NOT (&bg (:C Col)))
  (&tile.box (:key P_tile) *B)
  (ALL ((&tile.cell (:key (:P_tile *P_tilem)) P)
        (&tile.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile))
  (margin (:B P_intile) *D (:K 0))
  (axis_of D *A)
  (&port_split1 (:P_intile_ P_intile) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across)))

(RULE &link
  (&port (:P_tile *X) *D *Across)
  (opposite D (:Opp *D2))
  (&port (:P_tile *Y) (:D D2) Across)
  (!= X Y))

(INIT &onward Propagation
  (key ((&link ^D)
        (&tile.box (:key (:P_tile ^X))))
    (source ((:n X))
      (&link D)
      (&tile.box (:key (:P_tile X))))
    (edge ((:a X2) (:b Y))
      (&link (:X *X2) D *Y)
      (&tile.box (:key (:P_tile X))))))

;; The tiles ordered along the chain, read toward d.
(INIT &chain Order
  (key ((OR ((&link ^D)
             (&tile.cell (:key (:P_tile *X))))
            ((&onward.reached (:key D X) (:n *Y))
             (!= X Y))))
    (member ((:t X))
      (&link D)
      (&tile.cell (:key (:P_tile *X))))
    (before ((:a X) (:b Y))
      (&onward.reached (:key D *X) (:n *Y))
      (!= X Y))))

(RULE &seat
  (&chain.dual_rank (:key *D) (:t *X) (:R *K1))
  (&chain.rank (:key D) (:t X) (:R *K2))
  (axis_of D *A)
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K K1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_tile)))

(INIT &placed_tiling Tiling
  (key ((OR ((&seat ^A *P_tile))
            ((&seat *X A)
             (&tile.cell (:key (:P_tile X)) *P)
             (&tile.box (:key (:P_tile X)) *B)
             (ALL ((&tile.cell (:key (:P_tile *Xm)) P)
                   (&tile.box (:key (:P_tile Xm)) B)
                   (dir_elem (:D *D_m1))
                   (relative (:Base B) (:X P) (:X_rel *R_m2))
                   (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                  ((>= K_m3 0)))
             (relative (:Base B) (:X P) (:X_rel *P_intile)))
            ((&seat A)
             (&gap (:D *G)))))
    (outer ((:P P_tile))
      (&seat A *P_tile))
    (inner ((:P P_intile))
      (&seat *X A)
      (&tile.cell (:key (:P_tile X)) *P)
      (&tile.box (:key (:P_tile X)) *B)
      (ALL ((&tile.cell (:key (:P_tile *Xm)) P)
            (&tile.box (:key (:P_tile Xm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_intile)))
    (gap (A G)
      (&seat A)
      (&gap (:D *G)))))

(RULE &placed
  (&seat *X *A *P_tile)
  (&tile.cell (:key (:P_tile X)) (:P *P2))
  (input (:P P2) *Col)
  (&tile.box (:key (:P_tile X)) *B)
  (ALL ((&tile.cell (:key (:P_tile *Xm)) (:P P2))
        (&tile.box (:key (:P_tile Xm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_intile))
  (&placed_tiling.cell (:key A) (:P_outer P_tile) (:P_inner P_intile) *P))

(INIT &sheet Frame
  (extent (A N)
    (&placed *P)
    (axis_elem *A)
    (frame_extent P A *N)))

(RULE &output
  (&sheet.cell *P)
  (OR ((&placed P *Col))
      ((NOT (&placed P))
       (&sep (:C Col)))))
