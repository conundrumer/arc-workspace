;; 4093f84a

(DET &stripe UnchangedColor)

(RULE &stripe_cell
  (input *P *Col)
  (&stripe (:C Col)))

(INIT &bbox BoundingBox
  (cell (P)
    (&stripe_cell *P)))

(RULE &side
  (&bbox.box *B)
  (axis_elem *A)
  (axis_of (:D *D_m2) A)
  (opposite (:D D_m2) (:Opp *O_m3))
  (margin B (:D D_m2) (:K *K1_m4))
  (margin B (:D O_m3) (:K *K2_m5))
  (opposite (:D D_m2) (:Opp *O_m6))
  (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
  (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
  (compose (:A B1_m7) (:B B2_m8) (:C 0))
  (relative (:Base 0) (:X B) (:X_rel *Across_m1))
  (perp A *A2)
  (axis_of *D (:A A2)))

(RULE &spread_dir
  (&side (:D *Key)))

(RULE &spread_node
  (&side (:D *Key))
  (input *P))

(RULE &spread_source
  (&side (:D *Key))
  (&stripe_cell *P)
  (&bbox.box *B)
  (ALL ((&stripe_cell P)
        (&bbox.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D Key) (:K *K_m1))
  (margin B (:D Key) (:K K_m1)))

;; The stripe's outermost cell on each side casts out along its line.
(INIT &spread Distance
  (key ((&spread_source (:Key ^Ky) (:P ^O))
        (&spread_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&spread_source (:Key Ky) (:P O))
           (&spread_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&spread_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&spread_node (:Key Ky) (:P Q)))
          ((&spread_source (:Key Ky) (:P O))
           (&spread_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&spread_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&spread_source (:Key Ky) (:P O))
           (&spread_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&spread_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&spread_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&spread_source (:Key Ky) (:P O))
      (&spread_dir (:Key Ky)))))

(RULE &spread_ray
  (&spread.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &spread_end
  (&spread_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&spread_ray Key (:P Q) D Origin)))

(DET &bg DominantColor)

(RULE &dot
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stripe (:C Col))))

(RULE &spread_cell
  (&side (:D *Key))
  (input *P))

(RULE &outward
  (&spread_ray (:Key *D) *P D (:K *N) (:Origin *Src))
  (&spread_cell (:Key D) P))

(INIT &pile Cardinality
  (key ((&outward *P ^D ^Src)
        (&dot P))
    (member ((:m P))
      (&outward *P D Src)
      (&dot P))))

(RULE &dots
  (&pile.size (:key *D *Src) *N))

(RULE &growth
  (&dots *D *Src (:N *Len)))

(ALTS $choice "what the dots on one side of one line set" $Count
  (ALT $Table
    ;; The cells the output grew out of the stripe on that line.
    (INIT &grown Cardinality
      (key ((&outward ^E *P ^D (:N *K) ^Src)
            (!= K 0)
            (ex_output E P *Col)
            (&stripe (:C Col)))
        (member ((:m P))
          (&outward E *P D (:N *K) Src)
          (!= K 0)
          (ex_output E P *Col)
          (&stripe (:C Col)))))

    (DET &length
      (&dots *E *D *Src *N)
      (&grown.size (:key E D Src) (:N *Len)))

    (RULE &growth
      (&dots *D *Src *N)
      (&length N *Len))))

(RULE &painted
  (OR ((&stripe_cell *P))
      ((&outward P *D (:N *K) *Src)
       (!= K 0)
       (&growth D Src (:Len *N))
       (<= K N))))

(RULE &output
  (input *P)
  (IF ((&painted P))
      ((&stripe (:C *Col)))
      ((&bg (:C Col)))))
