;; 2dd70a9a

(RULE &leg_dir
  (dir_elem *D))

(DET &bg DominantColor)

(RULE &leg_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &leg_node
  (input *P)
  (NOT (&leg_blocked P)))

(RULE &leg_source
  (input *P))

;; A walker crosses the grid and halts before any occupied cell: a wall, a
;; stub, or the target.
(INIT &leg Distance
  (key ((&leg_source (:P ^O))
        (&leg_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&leg_source (:P O))
           (&leg_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&leg_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&leg_node (:P Q)))
          ((&leg_source (:P O))
           (&leg_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&leg_node (:P Q))
           (= A2 O))
          ((&leg_source (:P O))
           (&leg_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&leg_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&leg_node (:P Q)))))
    (source ((:n O))
      (&leg_source (:P O))
      (&leg_dir D))))

(RULE &leg_ray
  (&leg.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &leg_end
  (&leg_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&leg_ray (:P Q) D Origin)))

(DET &source RarestColor)

(DET &target RarestColor)

(RULE &stub_dir
  (OR ((&source (:C *Col)))
      ((&target (:C Col))))
  (input *P Col)
  (input (:P *P2) Col)
  (!= P P2)
  (axis_of *D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P2) (:D D_m2) (:K K_m3)))

(RULE &leg_start
  (&source (:C *Col))
  (&stub_dir Col *P *D))

;; The open cells the walker crosses. A rim direction is one the way ahead
;; closes in: an occupied cell, or the grid edge.
(INIT &open Boundary
  (cell (P)
    (input *P *Col)
    (&bg (:C Col))))

(RULE &at_target
  (input *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&target (:C Col)))

(RULE &run
  (&leg_ray *P *D (:Origin *A))
  (dir_elem D))

(RULE &leg_edge
  (&run *A *D (:P *A2))
  (!= A2 A)
  (&open.exposed (:P A2) D)
  (NOT (&at_target (:P A2) D))
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *D2) (:A A2_m2)))

(RULE &leg_goal
  (&run (:A *P) *D (:P *E))
  (&at_target (:P E) D))

(RULE &target_side
  (input *P)
  (dir_elem *D)
  (&target (:C *Col))
  (input (:P *T) Col)
  (dir_elem D)
  (margin (:B T) D (:K *K1_m1))
  (margin (:B P) D (:K *K2_m2))
  (< K1_m1 K2_m2))

(RULE &toward
  (&leg_edge *A *D *A2 *D2)
  (&target_side (:P A2) (:D D2)))

;; The legs whose walk goes on to a last leg.
(INIT &arrive Propagation
  (source ((:n (:P A) D))
    (&leg_goal (:P *A) *D))
  (edge ((:a (:P A2) (:D D2)) (:b (:P A) D))
    (&toward *A *D *A2 *D2)))

;; The legs the walker reaches from the source.
(INIT &reach Propagation
  (source ((:n (:P A) D))
    (&leg_start (:P *A) *D))
  (edge ((:a (:P A) D) (:b (:P A2) (:D D2)))
    (&toward *A *D *A2 *D2)))

;; A leg the walker reaches from the source, whose walk goes on to arrive.
(RULE &on_path
  (&reach.reached (:n *P *D))
  (&arrive.reached (:n P D)))

(ALTS $choice "which path the task draws" $Toward
  (ALT $Jog
    (RULE &on_path
      (&leg_start (:P *A1) (:D *D1))
      (&leg_edge (:A A1) (:D D1) *A2 *D2)
      (&leg_edge (:A A2) (:D D2) (:A2 *A3) (:D2 *D3))
      (&leg_goal (:P A3) (:D D3))
      (&target (:C *Col))
      (&stub_dir Col (:D D3))
      (OR ((= *P A1)
           (= *D D1))
          ((= P A2)
           (= D D2))
          ((= P A3)
           (= D D3))))))

(RULE &path_cell
  (&on_path (:P *A) *D)
  (&run A D *P))

(RULE &output
  (OR ((&path_cell *P)
       (&source (:C *Col)))
      ((input P Col)
       (NOT (&path_cell P)))))
