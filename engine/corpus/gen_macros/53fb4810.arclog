;; 53fb4810

(RULE &bands_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &anchor_color UnchangedColor)

(DET &bg DominantColor)

(INIT &bands Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (NOT (&anchor_color (:C Col)))
         (&bands_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2)))
         (NOT (&anchor_color (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (NOT (&anchor_color (:C Col3)))
         (= P3 P)))))

(RULE &bands_component
  (&bands.class (:a *P) *Id))

(RULE &grow_dir
  (&bands_component *P *Id)
  (opposite *D (:Opp *O))
  (step_offset (:D O) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&anchor_color (:C Col)))

(RULE &grow_axis
  (&grow_dir *Id *D)
  (axis_of D *A))

(INIT &bbox BoundingBox
  (key ((&bands_component *P ^Id))
    (cell (P)
      (&bands_component *P Id))))

(RULE &period
  (&bands_component *P *Id)
  (&bbox.box (:key Id) *B)
  (&grow_axis Id *A)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K)))

(ALTS $choice "two models of the period" $Extent
  (ALT $Period
    (INIT &shift Periods
      (key ((&bands_component *P ^Id)
            (input P *Col))
        (cell (P (:v Col))
          (&bands_component *P Id)
          (input P *Col))))

    (INIT &shortest Order
      (key ((&grow_axis ^Id *A)
            (&shift.approximate_period (:key Id) A *K))
        (member ((:t K))
          (&grow_axis Id *A)
          (&shift.approximate_period A *K))
        (score ((:t K) (:S K))
          (&grow_axis Id *A)
          (&shift.approximate_period A *K))))

    (RULE &period
      (&shortest.minimal (:key *Id) (:t *K)))))

(RULE &pattern
  (&bands_component (:P *P2) *Id)
  (input (:P P2) *Col)
  (&grow_dir Id *D)
  (&period Id *K)
  (input *P)
  (axis_of D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P2) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3))
  (relative (:Base P2) (:X P) (:X_rel *V))
  (opposite D (:Opp *O))
  (margin (:B V) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Remainder 0)))

(RULE &beyond
  (&pattern *Id *P *Col)
  (NOT (&bands_component P Id)))

(RULE &output
  (input *P (:Col *C))
  (OR ((&beyond P *Col))
      ((NOT (&beyond P))
       (= Col C))))
