;; 6455b5f5

(RULE &region_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &region Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&bg (:C Col))
         (&region_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&bg (:C Col2)))
        ((input P (:Col *Col3))
         (&bg (:C Col3))
         (= P3 P)))))

(RULE &region_component
  (&region.class (:a *P) *Id))

(DET &most AnyOutNewColor)

(DET &fewest AnyOutNewColor)

(INIT &area Cardinality
  (key ((&region_component *P ^Id))
    (member ((:m P))
      (&region_component *P Id))))

(INIT &extreme Order
  (member ((:t (:V Id) (:S N)))
    (&area.size (:key *Id) *N))
  (score ((:t (:V Id) (:S N)) (:S N))
    (&area.size (:key *Id) *N)))

(RULE &paint
  (&region_component *P *Id)
  (OR ((&extreme.maximal (:t (:V Id)))
       (&most (:C *Col)))
      ((&extreme.minimal (:t (:V Id)))
       (&fewest (:C Col)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
