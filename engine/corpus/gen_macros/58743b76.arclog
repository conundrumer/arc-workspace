;; 58743b76

;; The color of the cells that are neither canvas nor key.
(DET &filler SharedColor)

(DET &bg DominantColor)

(INIT &canvas BoundingBox
  (cell ((:P P_grid))
    (input (:P *P_grid) *Col)
    (&bg (:C Col))))

(RULE &on_canvas
  (input (:P *P_grid))
  (&canvas.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

(INIT &key BoundingBox
  (cell ((:P P_grid))
    (input (:P *P_grid) *Col)
    (NOT (&filler (:C Col)))
    (NOT (&on_canvas P_grid))))

;; The canvas split into one part per key cell.
(INIT &part_sides ExtentDivisions
  (frame ((:P P_inner))
    (&on_canvas *P_inner)))

(RULE &part_axis_split1
  (&on_canvas (:P_inner *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &part_parts
  (&key.cell *P)
  (&key.box *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(RULE &part_axis
  (OR ((&on_canvas (:P_inner *P))
       (&key.cell (:P *P2))
       (&key.box *B)
       (axis_elem *A)
       (relative (:Base B) (:X P2) (:X_rel *R_m1))
       (frame_extent (:P R_m1) A *N)
       (&part_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m2))
       (edge_inset D (:K I) (:B *B1_m3))
       (edge_inset (:D O_m2) (:K I2) (:B *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *P_outer))
       (opposite D (:Opp *O_m5))
       (edge_inset D (:K R) (:B *B1_m6))
       (edge_inset (:D O_m5) (:K R2) (:B *B2_m7))
       (compose (:A B1_m6) (:B B2_m7) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&on_canvas (:P_inner P))
       (&key.cell (:P *P22))
       (&key.box (:B *B2))
       (axis_elem A)
       (relative (:Base B2) (:X P22) (:X_rel *R_m12))
       (frame_extent (:P R_m12) A (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m22))
       (edge_inset (:D D2) (:K I3) (:B *B1_m32))
       (edge_inset (:D O_m22) (:K I22) (:B *B2_m42))
       (compose (:A B1_m32) (:B B2_m42) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m52))
       (edge_inset (:D D2) (:K R3) (:B *B1_m62))
       (edge_inset (:D O_m52) (:K R22) (:B *B2_m72))
       (compose (:A B1_m62) (:B B2_m72) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&on_canvas (:P_inner P))
       (axis_elem A)
       (NOT (&part_parts A))
       (&part_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &part_tile
  (&part_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&part_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &mark
  (&on_canvas (:P_grid *P))
  (input P *Col)
  (NOT (&bg (:C Col))))

(ALTS $choice "how a mark's place in the canvas picks a key cell; the key is 2x2 in every pair, so the two ways agree there and part only on a larger key" $Shrunk
  (ALT $Corner
    (RULE &place_nearer
      (&on_canvas (:P_inner *P))
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (RULE &place_quadrant
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&place_nearer *P (:D D1))
      (&place_nearer P (:D D2)))

    (RULE &output
      (OR ((&mark *P)
           (&on_canvas (:P_grid P) *P_inner)
           (&place_quadrant (:P P_inner) (:Diag *D))
           (&key.cell (:P *P_key))
           (&key.box *B)
           (ALL ((dir_elem (:D *D_m1))
                 (relative (:Base B) (:X P_key) (:X_rel *R_m2))
                 (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                ((>= K_m3 0)))
           (ALL ((&place_quadrant (:P *P_innerm) (:Diag D))
                 (corner_dir (:C D) (:D *D_m1m))
                 (margin (:B P_key) (:D D_m1m) (:K *K1_m2))
                 (margin B (:D D_m1m) (:K *K2_m3)))
                ((= K1_m2 K2_m3)))
           (input (:P P_key) *Col))
          ((input P Col)
           (NOT (&mark P)))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&mark P)))
      ((&mark P)
       (&on_canvas (:P_grid P) *P_inner)
       (&part_tile (:P P_inner) (:P_outer *P_tile))
       (&key.cell (:P *P_key))
       (&key.box *B)
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P_key) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B) (:X P_key) (:X_rel P_tile))
       (input (:P P_key) Col))))
