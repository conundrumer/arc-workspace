;; 16de56c4

(DET &bg DominantColor)

(RULE &mark_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (axis_elem *A)
  (&mark_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across)))

(RULE &seed
  (&mark *A *Across (:P *P1) *Col)
  (&mark A Across (:P *P2) Col)
  (!= P1 P2)
  (ALL ((&mark A Across (:P *P1m) Col)
        (&mark A Across (:P *P2m) Col)
        (&mark A Across (:P *P3) Col)
        (!= P1m P2m)
        (!= P1m P3))
       ((= P2m P3))))

(RULE &rhythm
  (&seed *A *Across *Col *P1 *P2)
  (ALL ((&seed A Across (:Col *Colm))
        (&mark A Across (:P *P1m) (:Col *Col1))
        (!= Col1 Colm)
        (&mark A Across (:P *P2m) (:Col *Col2))
        (!= Col2 Colm))
       ((= P1m P2m))))

(RULE &cast_dir
  (&rhythm *A *Across)
  (axis_of *D A))

(RULE &lattice_split1
  (input (:P *Q_))
  (&rhythm (:A *A_) (:Across *Across_) *P1 *P2)
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Q_) (:D D_m1) (:K *K1_m3))
  (margin (:B Q_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X Q_) (:X_rel Across_)))

(RULE &lattice
  (&rhythm *A *Across *P1 *P2)
  (relative (:Base P1) (:X P2) (:X_rel *V))
  (axis_of *D A)
  (margin (:B V) D *K)
  (> K 0)
  (input *P)
  (&lattice_split1 (:Q_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ Across))
  (margin (:B P1) D (:K *T1))
  (divide (:T T1) (:Side K) (:Gap 0) (:Remainder *Phase))
  (margin (:B P) D (:K *Tq))
  (divide (:T Tq) (:Side K) (:Gap 0) (:Remainder Phase)))

(RULE &intruder
  (&rhythm *A *Across (:Col *Col3))
  (&lattice A Across *P)
  (&mark A Across P *Col)
  (!= Col Col3))

(RULE &cast_blocked
  (&intruder *A *Across (:Col *Col2))
  (&mark A Across *P (:Col Col2))
  (&lattice A Across P))

(RULE &cast_node
  (&rhythm *A *Across)
  (axis_of *D A)
  (input *P)
  (NOT (&cast_blocked A Across P)))

(RULE &cast_source
  (&rhythm *A *Across (:P1 *P)))

;; The rhythm advancing from the seed both ways, through the intruder's cell
;; and no further.
(INIT &cast Distance
  (key ((&cast_source (:A ^Ky_a) (:Across ^Ky_across) (:P ^O))
        (&cast_dir (:A Ky_a) (:Across Ky_across) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&cast_dir (:A Ky_a) (:Across Ky_across) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:A Ky_a) (:Across Ky_across) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:A Ky_a) (:Across Ky_across) (:P Q)))
          ((&cast_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&cast_dir (:A Ky_a) (:Across Ky_across) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:A Ky_a) (:Across Ky_across) (:P Q))
           (= A2 O))
          ((&cast_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&cast_dir (:A Ky_a) (:Across Ky_across) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:A Ky_a) (:Across Ky_across) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:A Ky_a) (:Across Ky_across) (:P Q)))))
    (source ((:n O))
      (&cast_source (:A Ky_a) (:Across Ky_across) (:P O))
      (&cast_dir (:A Ky_a) (:Across Ky_across) D))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky_a *A) (:Ky_across *Across) *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *A *Across *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray A Across (:P Q) D Origin)))

(RULE &span_axis
  (&lattice *A *Across))

(RULE &span_dir
  (&span_axis *A *Across)
  (axis4_of *D A))

(RULE &span_node
  (&span_axis *A *Across)
  (input *P))

(RULE &span_source
  (&mark *A *Across *P))

(INIT &span Distance
  (key ((&span_source (:A ^Ky_a) (:Across ^Ky_across) (:P ^O))
        (&span_dir (:A Ky_a) (:Across Ky_across) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&span_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&span_dir (:A Ky_a) (:Across Ky_across) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&span_node (:A Ky_a) (:Across Ky_across) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&span_node (:A Ky_a) (:Across Ky_across) (:P Q)))
          ((&span_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&span_dir (:A Ky_a) (:Across Ky_across) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&span_node (:A Ky_a) (:Across Ky_across) (:P Q))
           (= A2 O))
          ((&span_source (:A Ky_a) (:Across Ky_across) (:P O))
           (&span_dir (:A Ky_a) (:Across Ky_across) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&span_node (:A Ky_a) (:Across Ky_across) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&span_node (:A Ky_a) (:Across Ky_across) (:P Q)))))
    (source ((:n O))
      (&span_source (:A Ky_a) (:Across Ky_across) (:P O))
      (&span_dir (:A Ky_a) (:Across Ky_across) D))))

(RULE &span_ray
  (&span.distance (:key (:Ky_a *A) (:Ky_across *Across) *D (:O *Origin)) (:n *P) *K))

(RULE &span_end
  (&span_ray *A *Across *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray A Across (:P Q) D Origin)))

(RULE &fill
  (OR ((&cast_ray *A *Across *P)
       (&lattice A Across P))
      ((&cast_end A Across (:P *E) *D)
       (step_offset D (:V *V_m1))
       (compose (:A E) (:B V_m1) (:C P))
       (input P))))

(ALTS $choice "how far the intruder's paint reaches" $Cast
  (ALT $Span
    (RULE &span_between
      (&lattice *A *Across *P)
      (&span_axis A Across)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&span_ray A Across P D)
      (&span_ray A Across P (:D O)))

    (RULE &fill
      (&lattice *A *Across *P)
      (OR ((NOT (&intruder A Across)))
          ((&intruder A Across)
           (&span_between A Across P))))))

(RULE &paint
  (&fill (:A *Ln_a) (:Across *Ln_across) *P)
  (OR ((&intruder (:A Ln_a) (:Across Ln_across) *Col))
      ((&rhythm (:A Ln_a) (:Across Ln_across) Col)
       (NOT (&intruder (:A Ln_a) (:Across Ln_across)))
       (input P (:Col *Bg))
       (&bg (:C Bg)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
