;; afe3afe9

(INPUT edge-line "one full edge of the grid is a line of color &line_color; every other cell outside the squares is &bg_color"

  (DET_OR_RULE &line_color RarestColor)

  (DET_OR_RULE &bg_color DominantColor))

(INPUT ring-lattice "hollow squares of side &ring_side sit on a square lattice of 7 by 7 slots, with a gap of &ring_gap between neighboring slots; each square has one color"

  ;; The rectangle outlines of each color.
  (INIT &outline Outlines
    (key ((input *P ^Col)
          (NOT (&bg_color (:C Col))))
      (node (P)
        (input *P Col)
        (NOT (&bg_color (:C Col))))))

  (RULE &filled
    (&outline.box *B)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (&outline.box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0)))
    (NOT (&bg_color (:C Col))))

  (DET &ring_side TileCount)

  (RULE &square
    (&outline.box (:key *Col) *B)
    (NOT (&filled B))
    (&outline.node (:key Col) *P)
    (ALL ((&outline.node (:key (:Col *Colm)) P)
          (&outline.box (:key (:Col Colm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (&ring_side (:N *W))
    (axis_elem *A)
    (perp A (:A2 *A2_m1))
    (frame_extent (:P P_rel) A (:N W))
    (frame_extent (:P P_rel) (:A A2_m1) (:N W)))

  (RULE &line_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &line
    (input *P)
    (axis_elem *A)
    (&line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  ;; The lines between two squares, the second toward d from the first.
  (INIT &between Cardinality
    (key ((&square ^E (:B ^B1))
          (&square E (:B ^B2))
          (dir_elem ^D)
          (dir_elem D))
      (member ((:m L))
        (opposite D (:Opp *O))
        (axis_of D *A)
        (&line E A *L)
        (margin (:B L) D (:K *K1_m1))
        (margin (:B B1) D (:K *K2_m2))
        (< K1_m1 K2_m2)
        (dir_elem (:D O))
        (margin (:B L) (:D O) (:K *K1_m3))
        (margin (:B B2) (:D O) (:K *K2_m4))
        (< K1_m3 K2_m4))))

  ;; The fewest lines between two squares.
  (INIT &gaps Order
    (member ((:t N))
      (&between.size *N))
    (score ((:t N) (:S N))
      (&between.size *N)))

  (DET &ring_gap
    (&gaps.minimal (:t *K))))

(INPUT pack-gap-empty "on the pack axis, the middle lattice line holds no square")

(OUTPUT pack-side "the pack side is the line's side turned a quarter turn in sense &turn_sense"

  (RULE &unit
    (&square *B *Col))

  ;; The units' span.
  (INIT &span BoundingBox
    (cell ((:P B))
      (&unit *B)))

  ;; The sense of the quarter turn from the line's side to the pack side.
  (DET &turn_sense SenseDomain)

  ;; The lines of each lattice slot, the slot counted by its place from the
  ;; span's edge e: slots of ring_side lines, ring_gap lines apart.
  (INIT &slot BoundingBox
    (key ((&span.box *B)
          (&line *A *L)
          (axis_of (:D ^E) A)
          (relative (:Base B) (:X L) (:X_rel *L_rel))
          (margin (:B L_rel) (:D E) (:K *T))
          (&ring_side (:N *W))
          (&ring_gap (:K *G))
          (divide T (:Side W) (:Gap G) (:Part ^N)))
      (cell ((:P L))
        (&span.box *B)
        (&line *A *L)
        (axis_of (:D E) A)
        (relative (:Base B) (:X L) (:X_rel *L_rel))
        (margin (:B L_rel) (:D E) (:K *T))
        (&ring_side (:N *W))
        (&ring_gap (:K *G))
        (divide T (:Side W) (:Gap G) (:Part N)))))

  (RULE &lattice
    (&slot.box (:key *E *N) (:B *S))
    (axis_of (:D E) *A)
    (&slot.cell (:key E N) (:P *L))
    (&ring_side (:N *W))
    (axis_elem A)
    (relative (:Base S) (:X L) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A (:N W)))

  (RULE &span_line_split1
    (&span.box (:B *B_))
    (&lattice (:A *A_) *S)
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B_a_))
    (relative (:Base B_a_) (:X B_) (:X_rel *X_m1_)))

  (RULE &span_line
    (&lattice *A *S)
    (&span.box *B)
    (&span_line_split1 (:B_ B) (:A_ A) (:B_a_ *B_a) (:X_m1_ *X_m1))
    (ALL ((&lattice (:A *Am) S)
          (&span.box (:B *Bm))
          (axis_of (:D *D_m2) (:A Am))
          (opposite (:D D_m2) (:Opp *O_m3))
          (margin (:B Bm) (:D D_m2) (:K *K1_m4))
          (margin (:B Bm) (:D O_m3) (:K *K2_m5))
          (opposite (:D D_m2) (:Opp *O_m6))
          (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
          (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
          (compose (:A B1_m7) (:B B2_m8) (:C B_a))
          (relative (:Base B_a) (:X Bm) (:X_rel *Across_m1))
          (dir_elem (:D *D_m1))
          (relative (:Base B_a) (:X S) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &middle
    (&span_line *A *S)
    (&span.box *B)
    (relative (:Base B) (:X S) (:X_rel *S_rel))
    (axis_of *D A)
    (opposite D (:Opp *O_m1))
    (margin (:B S_rel) D *K)
    (margin (:B S_rel) (:D O_m1) K))

  (RULE &half
    (&unit *B *Col)
    (&middle *A *S)
    (axis_of *D A)
    (dir_elem D)
    (margin B D (:K *K1_m1))
    (margin (:B S) D (:K *K2_m2))
    (< K1_m1 K2_m2))

  (INIT &half_color Singleton
    (key ((&half ^D *Col))
      (member ((:v Col))
        (&half D *Col)))))

(OUTPUT ring-cell "each square stands for one cell of its color at its lattice slot"

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The 4-connected pieces off the background.
  (INIT &piece Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&bg_color (:C Col)))
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&bg_color (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&bg_color (:C Col3)))
           (= P3 P)))))

  (RULE &piece_component
    (&piece.class (:a *P) *Id))

  (INIT &piece_box BoundingBox
    (key ((&piece_component *P ^Id))
      (cell (P)
        (&piece_component *P Id)))))

(OUTPUT pack-lines "along each lattice line on the pack axis, the cells keep their order and slide to the pack side with no gaps between them"

  (RULE &line_defect
    (dir_elem *D)
    (input *P *Col)
    (margin (:B P) D (:K 0))
    (NOT (&line_color (:C Col))))

  (RULE &pack
    (&span.box)
    (dir_elem (:D *D0))
    (NOT (&line_defect (:D D0)))
    (&turn_sense (:S *Sn))
    (turn (:S Sn) (:D D0) (:D2 *D)))

  (RULE &axes
    (&pack *D)
    (axis_of D (:A *A_pack))
    (perp (:A A_pack) (:A2 *A_cross)))

  (RULE &unit_line_split1
    (&unit (:B *B_))
    (&span_line (:A *A_) *S)
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B_a_))
    (relative (:Base B_a_) (:X B_) (:X_rel *X_m1_)))

  (RULE &unit_line
    (&unit *B)
    (&span_line *A *S)
    (&unit_line_split1 (:B_ B) (:A_ A) (:B_a_ *B_a) (:X_m1_ *X_m1))
    (ALL ((&unit (:B *Bm))
          (&span_line (:A *Am) S)
          (axis_of (:D *D_m2) (:A Am))
          (opposite (:D D_m2) (:Opp *O_m3))
          (margin (:B Bm) (:D D_m2) (:K *K1_m4))
          (margin (:B Bm) (:D O_m3) (:K *K2_m5))
          (opposite (:D D_m2) (:Opp *O_m6))
          (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
          (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
          (compose (:A B1_m7) (:B B2_m8) (:C B_a))
          (relative (:Base B_a) (:X Bm) (:X_rel *Across_m1))
          (dir_elem (:D *D_m1))
          (relative (:Base S) (:X B_a) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (RULE &along_order_elem
    (&axes (:A_cross *Ac))
    (&unit_line *B (:A Ac) *S))

  ;; The units of each lattice line across the pack axis, in order from the
  ;; pack side.
  (INIT &along_order Order
    (key ((OR ((&along_order_elem ^S *B))
              ((&along_order_elem S (:B *B1))
               (&along_order_elem S (:B *B2))
               (&pack *D)
               (dir_elem D)
               (margin (:B B1) D (:K *K1_m1))
               (margin (:B B2) D (:K *K2_m2))
               (< K1_m1 K2_m2))))
      (member ((:t B))
        (&along_order_elem S *B))
      (before ((:a B1) (:b B2))
        (&along_order_elem S (:B *B1))
        (&along_order_elem S (:B *B2))
        (&pack *D)
        (dir_elem D)
        (margin (:B B1) D (:K *K1_m1))
        (margin (:B B2) D (:K *K2_m2))
        (< K1_m1 K2_m2)))))

(OUTPUT output-extent "the output has one row or column per lattice line across the pack axis, from the first line that holds a square to the last, and along the pack axis it holds the lattice lines that hold a square; the rest is &bg_color"

  (RULE &cross
    (&axes (:A_cross *Ac))
    (&span_line (:A Ac) *S))

  ;; Each output line's place across the pack axis.
  (INIT &cross_frame Order
    (key ((&axes (:A_cross ^Ac))
          (axis_of ^D (:A Ac)))
      (before ((:a S) (:b S2))
        (&cross *S)
        (&cross (:S *S2))
        (!= S S2)
        (&cross)
        (margin (:B S) D (:K *K1))
        (margin (:B S2) D (:K *K2))
        (< K1 K2)))
    (member ((:t S))
      (&cross *S)
      (&cross)))

  ;; The lattice lines on the pack axis that hold a unit.
  (INIT &occupied Cardinality
    (member ((:m S))
      (&axes (:A_pack *Ap))
      (&unit_line (:A Ap) *S)))

  ;; The units of each line across the pack axis.
  (INIT &line_count Cardinality
    (key ((&along_order_elem ^S *B))
      (member ((:m B))
        (&along_order_elem S *B))))

  (INIT &fullest Order
    (member ((:t N))
      (&line_count.size *N))
    (score ((:t N) (:S N))
      (&line_count.size *N))))

(ALTS $side "how the pack side is found" $TurnFromLine
  (ALT $PackTowardUniformHalf
    (OUTPUT pack-side "on each axis, the middle lattice line of the squares' span cuts the lattice into two halves; the pack side is the side of the only half whose squares share one color; undefined where an axis spans an even number of lattice lines, or where the one-colored halves are not exactly one"
      (RULE &toward
        (&half_color.value (:key *D)))

      ;; The only qualifying side.
      (INIT &toward_one Singleton
        (member ((:v D))
          (&toward *D)))

      (RULE &pack
        (&toward_one.value (:v *D))
        (NOT (&even)))))
  (ALT $PackTowardColorHalf
    (OUTPUT pack-side "on each axis, the middle lattice line of the squares' span cuts the lattice into two halves; the pack side is the side of the only half whose squares are all &band_color; undefined where an axis spans an even number of lattice lines, or where such halves are not exactly one"
      (DET &band_color SharedColor)

      (RULE &off_band
        (&half *D *Col)
        (NOT (&band_color (:C Col))))

      (RULE &toward
        (&half *D)
        (NOT (&off_band D)))

      ;; The only qualifying side.
      (INIT &toward_one Singleton
        (member ((:v D))
          (&toward *D)))

      (RULE &pack
        (&toward_one.value (:v *D))
        (NOT (&even))))))

(ALTS $piece "what one cell of the output stands for" $HollowSquare
  (ALT $ComponentUnit
    (OUTPUT ring-cell "each 4-connected piece of cells off &bg_color that fits in a &ring_side box stands for one cell, at the slot of its box; undefined where a piece holds two colors, or where the pieces are off one lattice"
      (RULE &wide_inside1
        (&piece_component (:P *P_) *Id)
        (&piece_box.box (:key Id) (:B *B_))
        (dir_elem (:D *D_m1))
        (relative (:Base B_) (:X P_) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (RULE &unit
        (&piece_box.box (:key *Id) *B)
        (ALL ((&piece_box.box (:key Id) (:B *Bm))
              (&piece_component (:P *Pm) Id)
              (relative (:Base Bm) (:X Pm) (:X_rel *P_rel))
              (axis_elem *A)
              (frame_extent (:P P_rel) A *N)
              (&ring_side (:N *W))
              (> N W))
             ((&wide_inside1 (:P_ Pm) (:B_ Bm))))
        (&piece_component *P Id)
        (input P *Col)))))

(ALTS $cross "which lattice lines across the pack axis the output holds" $LatticeSpan
  (ALT $RankedLines
    (OUTPUT output-extent "across the pack axis, one output line per lattice line that holds a square"
      (RULE &cross
        (&axes (:A_cross *Ac))
        (&unit_line (:A Ac) *S))))
  (ALT $FrameLattice
    (OUTPUT output-extent "across the pack axis, one output line per lattice line whose slot fits inside the frame"
      (RULE &cross
        (&axes (:A_cross *Ac))
        (&lattice (:A Ac) *S)))))

(ALTS $along "how long the output is along the pack axis" $OccupiedLines
  (ALT $MostRingsExtent
    (OUTPUT output-extent "along the pack axis, the output is as long as the most squares that any line holds")
    (RULE &along_extent
      (&fullest.maximal (:t *N))))
  (ALT $StoredAlongExtent
    (OUTPUT output-extent "along the pack axis, the output is &along_count long; undefined where a line holds more squares than that"
      (DET &along_count
        (ex_output *E *P)
        (dir_elem *D)
        (NOT (&line_defect E D))
        (axis_of D *A)
        (perp A *A2)
        (frame_extent P (:A A2) *N)))
    (RULE &along_extent
      (&pack)
      (&along_count *N))))

(RULE &cross_frame_pos
  (&cross_frame.rank (:key (:Ac *A) *D) (:t *M) (:R *R1))
  (&cross_frame.dual_rank (:key (:Ac A) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &even
  (&span.box)
  (axis_elem *A)
  (NOT (&middle A)))

(RULE &along_extent
  (&occupied.size *N))

(INIT &along_axis Frame
  (key ((&axes (:A_pack ^Ap)))
    (extent ((:A Ap) N)
      (&along_extent *N))))

(RULE &frame
  (&cross_frame_pos (:P_pos *P1))
  (&along_axis.cell (:P *P2))
  (compose (:A P1) (:B P2) (:C *P)))

(RULE &placed
  (&along_order.rank (:key *S) (:t *B) *R)
  (&cross_frame_pos (:M S) (:P_pos *P1))
  (&along_axis.cell (:P *P2))
  (&pack *D)
  (margin (:B P2) D (:K R))
  (compose (:A P1) (:B P2) (:C *P)))

(RULE &lost
  (&unit *B)
  (NOT (&placed B)))

(RULE &output
  (OR ((&placed *B *P)
       (&unit B *Col)
       (NOT (&lost)))
      ((&frame P)
       (NOT (&placed P))
       (&bg_color (:C Col))
       (NOT (&lost)))))
