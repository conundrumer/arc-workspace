;; ba97ae07

(INPUT background "every cell outside the two bands is `background`.")

(INPUT two-crossing-bands "one vertical band of whole columns and one horizontal band of whole rows, each of one color other than `background`, the two colors different, cross once.")

(INPUT one-band-on-top "the crossing cells all hold the color of one of the two bands, the band on top.")

(OUTPUT swap-on-top "the output is the input with every crossing cell painted the color of the band that was underneath.")

(OUTPUT rest-kept "every cell outside the crossing keeps its input color.")

(RULE &open_line_split1
  (input (:P *P_) (:Col *C))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(RULE &in_band_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(DET_OR_RULE &background DominantColor
  (ex_input (:Col *C)))

(RULE &background2
  (&background *C))

(RULE &open_line
  (input *P (:Col *C))
  (&background2 C)
  (axis_elem *A)
  (&open_line_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L)))

(RULE &in_band
  (input *P)
  (axis_elem *A)
  (&in_band_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
  (NOT (&open_line A L)))

(RULE &band_color_split1
  (&in_band (:P *P_) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(RULE &crossing
  (&in_band *P *A)
  (perp A *A2)
  (&in_band P (:A A2)))

(RULE &out_split1
  (&crossing (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(RULE &band_color
  (&in_band *P *A)
  (NOT (&crossing P))
  (&band_color_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
  (input P (:Col *C)))

(RULE &output
  (OR ((&crossing *P)
       (axis_elem *A)
       (&out_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
       (&band_color A L (:C *Col))
       (NOT (input P Col)))
      ((input P Col)
       (NOT (&crossing P)))))
