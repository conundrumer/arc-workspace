;; 2281f1f4

(DET &marker RarestColor)

(DET &fill AnyOutNewColor)

(DET &header DiagDirDomain)

(RULE &marked
  (input *P)
  (&header (:D *Diag))
  (corner_dir (:C Diag) *A *D)
  (&marker (:C *M))
  (input (:P *Q) (:Col M))
  (margin (:B Q) D (:K 0))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &cross
  (&header (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&marked *P (:D D1))
  (&marked P (:D D2)))

(ALTS $choice "what a marked line carries off the crossings" $Cross
  (ALT $Stamp
    (DET &bg DominantColor)

    (RULE &selected
      (&header (:D *Diag))
      (corner_dir (:C Diag) (:A *A_m1) (:D *Dp))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *Ds))
      (&marked *P (:D Ds))
      (NOT (margin (:B P) (:D Ds) (:K 0))))

    (RULE &output
      (OR ((&selected *P *Dp)
           (&marked P (:D Dp))
           (&fill (:C *Col)))
          ((&selected P (:Dp *Dp2))
           (NOT (&marked P (:D Dp2)))
           (&bg (:C Col)))
          ((input P Col)
           (NOT (&selected P)))))))

(RULE &output
  (OR ((&cross *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&cross P)))))
