;; 2037f2c7

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &shapes Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &shapes_component
  (&shapes.class (:a *P) *Id))

(DET &mark AnyOutNewColor)

(INIT &bbox BoundingBox
  (key ((&shapes_component *P ^Id))
    (cell (P)
      (&shapes_component *P Id))))

(RULE &filled
  (&shapes_component (:P *P2) *Id)
  (&bbox.box (:key Id) *B)
  (ALL ((&shapes_component (:P P2) (:Id *Idm))
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

(RULE &only_in
  (&filled *Id *P)
  (&shapes_component (:Id *Id2))
  (!= Id2 Id)
  (NOT (&filled (:Id Id2) P)))

(RULE &differs
  (&only_in *P))

(ALTS $choice "what counts as a disagreement" $Xor
  (ALT $Damage
    (INIT &fullest_count Cardinality
      (key ((&filled ^Id *P))
        (member ((:m P))
          (&filled Id *P))))

    (INIT &fullest Order
      (member ((:t Id))
        (&fullest_count.size (:key *Id)))
      (score ((:t Id) (:S N))
        (&fullest_count.size (:key *Id) *N)))

    (RULE &differs
      (&fullest.maximal (:t *Id))
      (&only_in Id *P))))

(INIT &view BoundingBox
  (cell (P)
    (&differs *P)))

(RULE &output
  (input (:P *P_grid))
  (&bbox.box (:B *B_copy))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B_copy) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B_copy) (:X P_grid) (:X_rel *P_shared))
  (&view.box *B)
  (ALL ((&bbox.box (:B *B_copym))
        (input (:P *P_gridm))
        (relative (:Base B_copym) (:X P_gridm) (:X_rel P_shared))
        (&view.box B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P_shared) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (relative (:Base B) (:X P_shared) (:X_rel *P))
  (IF ((&differs (:P P_shared)))
      ((&mark (:C *Col)))
      ((&bg (:C Col)))))
