;; b60334d2

(DET &blob_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &painted
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col))))

(DET &marker ChangedColor)

(DET &marker_at
  (ex_input *E *P *Col)
  (&marker (:C Col)))

(DET &blob_node
  (OR ((&painted (:E *Key) *P))
      ((&marker_at (:E Key) P))))

;; A painted cell belongs to the marker in its blob; markers join as
;; nodes because the erased center leaves the ring markerless.
(INIT &blob Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&blob_node (:Key *Ky) *P)
         (&blob_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&blob_node (:Key Ky) (:P P2)))
        ((&blob_node (:Key Ky) P)
         (= P2 P)))))

(DET &blob_component
  (&blob.class (:a *Key *P) *Id))

(RULE &marker_at2
  (input *P *Col)
  (&marker (:C Col)))

(DET &template
  (&painted *E *P *Col)
  (&blob_component (:Key E) P *Id)
  (&blob_component (:Key E) (:P *M) Id)
  (&marker_at E (:P M))
  (relative (:Base M) (:X P) (:X_rel *Off)))

(RULE &halo
  (&marker_at2 (:P *Q))
  (&template *Off *Col)
  (compose (:A Q) (:B Off) (:C *P))
  (input P))

(ALTS $choice "how a marker's ring is drawn" $Stamp
  (ALT $Halo
    (DET &side_col AnyOutNewColor)

    (DET &corner_col ChangedColor)

    (RULE &halo
      ;; Side neighbors, shared by both corner cases.
      (OR ((&marker_at2 (:P *Q))
           (&side_col (:C *Col))
           (dir_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A Q) (:B V_m1) (:C *P))
           (input P))
          ((&marker_at2 (:P *Q2))
           (&corner_col (:C Col))
           (diag_dir_elem (:D *Dg))
           (step_offset (:D Dg) (:V *V_m12))
           (compose (:A Q2) (:B V_m12) (:C P))
           (input P))))
    (ALTS $corner "the color a ring's corner cells take" $Fixed
      (ALT $Prop
        (RULE &halo
          (&marker_at2 (:P *Q) *Col)
          (diag_dir_elem (:D *Dg))
          (step_offset (:D Dg) (:V *V_m1))
          (compose (:A Q) (:B V_m1) (:C *P))
          (input P))))))

(RULE &output
  (OR ((&halo *P *Col))
      ((input P)
       (NOT (&halo P))
       (&bg (:C Col)))))
