;; 1b8318e3

(RULE &cast_dir
  (dir8_elem *D))

(DET &bg DominantColor)

(DET &block UnchangedColor)

(RULE &dot
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&block (:C Col))))

(RULE &cast_blocked
  (&dot *P))

(RULE &cast_node
  (input *P)
  (NOT (&cast_blocked P)))

(RULE &cast_source
  (&dot *P))

;; Each dot casts along its row, column, and diagonals.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &block_cell
  (input *P *Col)
  (&block (:C Col)))

(RULE &beside
  (input *P)
  (NOT (&block_cell P))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&block_cell (:P Q)))

(RULE &side
  (dir_elem *D)
  (&beside *P D))

(RULE &run
  (&cast_ray (:P *T) *D *K (:Origin *P))
  (OR ((dir_elem D)
       (&beside (:P T)))
      ((&beside (:P T) D)
       (NOT (&side (:P T))))))

;; The fewest steps among the open slides.
(INIT &shortest Order
  (key ((&run ^P *T *K))
    (member ((:t (:V T) (:S K)))
      (&run P *T *K))
    (score ((:t (:V T) (:S K)) (:S K))
      (&run P *T *K))))

(RULE &cardinal_low
  (&shortest.minimal (:key *P) (:t (:V *T)))
  (&run P T *D)
  (dir_elem D))

(RULE &arrive
  (&dot (:P *P2) *Col)
  (&shortest.minimal (:key (:P P2)) (:t (:V *P)))
  (OR ((&cardinal_low (:P P2) (:T P)))
      ((NOT (&cardinal_low (:P P2))))))

(RULE &output
  (input *P)
  (OR ((input P *Col)
       (&block (:C Col)))
      ((&arrive P Col))
      ((NOT (&block_cell P))
       (NOT (&arrive P))
       (&bg (:C Col)))))
