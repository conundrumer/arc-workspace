;; 0bb8deee

(DET &bg DominantColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

;; Divider: a line of one non-bg color.
(RULE &frame_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D (:K *K2)))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K2))
      (input *P)
      (dir_elem D)
      (margin (:B P) D (:K *K2)))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D (:K *K2))
  (&frame_rank.rank (:key D) (:t K2) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each quadrant viewed from the bounding box of the shape it holds.
(INIT &hull BoundingBox
  (key ((&frame_tile_of *P ^P_tile)
        (input P *Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (&frame_tile_of *P P_tile)
      (input P *Col)
      (NOT (&bg (:C Col))))))

(RULE &crop_cell
  (&frame_tile_of *P *P_tile)
  (input P *Col)
  (&hull.box (:key P_tile) *B)
  (ALL ((&frame_tile_of P (:P_tile *P_tilem))
        (&hull.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&crop_cell *P_tile))
  (inner ((:P P_intile))
    (&crop_cell *P_intile)))

(ALTS $choice "how the crops are reassembled" $Concat
  (ALT $Place
    (DET &shape_color
      (&frame_tile_of *E *P *P_tile)
      (ex_input E P *Col)
      (NOT (&bg (:C Col))))

    ;; A crop keeps its shape's color, so its box in the output canvas is
    ;; that color's bounding box in the example output.
    (INIT &obox BoundingBox
      (key ((ex_output ^E *P *Col)
            (&shape_color E ^P_tile Col))
        (cell (P)
          (ex_output E *P *Col)
          (&shape_color E P_tile Col))))

    (DET &tile_box
      (&obox.box (:key *P_tile) *B))

    (RULE &output
      (&crop_cell *P_tile *P_intile *Col)
      (&tile_box P_tile *B)
      (compose (:A B) (:B P_intile) (:C *P)))))

(RULE &output
  (&crop_cell *P_tile *P_intile *Col)
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
