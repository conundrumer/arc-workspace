;; a87f7484

(DET &tile_dim ConstOutDim)

(RULE &tile_val_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_val_division_side
  (axis_elem *A)
  (&tile_dim (:N *K)))

(RULE &tile_val_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_dim (:N *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_val_division_side A))
       (&tile_val_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_val_division_tile
  (&tile_val_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_val_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg SharedColor)

(RULE &tile_val
  (input (:P *P_grid) *Col)
  (&tile_val_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &ink
  (&tile_val *P_tile *P_intile *Col)
  (NOT (&bg (:C Col))))

(INIT &densest_count Cardinality
  (key ((&ink (:P_tile ^T) (:P_intile *P)))
    (member ((:m P))
      (&ink (:P_tile T) (:P_intile *P)))))

(INIT &densest Order
  (member ((:t T))
    (&densest_count.size (:key *T)))
  (score ((:t T) (:S N))
    (&densest_count.size (:key *T) *N)))

(ALTS $choice "which tile the output selects" $Count
  (ALT $Shape
    (INIT &shape_cmp Inclusion
      (pattern ((:pattern T) (:m P))
        (&ink (:P_tile *T) (:P_intile *P)))
      (observed ((:observed T) (:m P))
        (&ink (:P_tile *T) (:P_intile *P))))

    (RULE &output
      (&tile_val (:P_tile *T) (:P_intile *P) *Col)
      (&ink (:P_tile T))
      (ALL ((&ink (:P_tile *T2))
            (&shape_cmp.equal (:observed T) (:pattern T2)))
           ((= T T2))))))

(RULE &output
  (&tile_val (:P_tile *T) (:P_intile *P) *Col)
  (&densest.maximal (:t T)))
