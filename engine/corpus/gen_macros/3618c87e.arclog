;; 3618c87e

(RULE &cell_split_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
  (relative (:Base P_inner_) (:X P_) (:X_rel *P_across_)))

(DET &fall_to DirDomain)

(DET &bg DominantColor)

(DET &marker ChangedColor)

(RULE &cell_split
  (input *P *Col)
  (&fall_to *D)
  (axis_of D *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_inner_ *P_inner) (:P_across_ *P_across)))

(RULE &cleared
  (&cell_split *P *Col)
  (&marker (:C Col)))

;; Each marker cell falls on its own to the fall edge of its slice.
(INIT &fall Distance
  (key ((&cleared ^P))
    (source_distance (K)
      (&fall_to *D)
      (margin (:B P) D *K))))

(RULE &fall_dir
  (&cleared (:P *Key))
  (&fall_to *D))

(RULE &landed
  (&fall.distance (:key (:P *P2)) *K)
  (&fall_dir (:Key P2) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(ALTS $choice "two models of the fall" $PerCell
  (ALT $SliceMap
    (DET &out_slice
      (&cell_split *E *P *P_inner *P_across)
      (ex_output E P *Col))

    (DET &replaced
      (&cell_split *E *Col *P_inner *P_across)
      (ex_output E)
      (NOT (&out_slice E P_across P_inner Col)))

    (DET &slice_in
      (&replaced *E *P_across)
      (&cell_split E *Col (:P_inner *P) P_across))

    (INIT &slice_match Inclusion
      (pattern ((:m P Col))
        (&slice_in *P *Col))
      (observed ((:observed P_across) (:m (:P P_inner) Col))
        (&cell_split *Col *P_inner *P_across)))

    (DET &slice_out
      (&replaced *E *P_across)
      (&out_slice E P_across (:P_inner *P) *Col))

    (RULE &output
      (&cell_split *P (:Col *Col_in) *P_inner *P_across)
      (IF ((&slice_match.equal (:observed P_across)))
          ((&slice_out (:P P_inner) *Col))
          ((= Col Col_in))))))

(RULE &output
  (&cell_split *P (:Col *Col_in))
  (OR ((&cleared P)
       (&bg (:C *Col)))
      ((&landed P)
       (&marker (:C Col)))
      ((NOT (&cleared P))
       (NOT (&landed P))
       (= Col Col_in))))
