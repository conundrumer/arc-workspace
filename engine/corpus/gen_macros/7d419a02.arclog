;; 7d419a02

(DET &bg UnchangedColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &frame_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (&bg (:C Col)))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; Bg lines cut the bands.
(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D *K)
  (&frame_rank.rank (:key D) (:t K) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &band_axis
  (&frame_divider *A *L)
  (axis_of *D A)
  (opposite D (:Opp *O_m1))
  (margin (:B L) D (:K *K1))
  (margin (:B L) (:D O_m1) (:K *K2))
  (!= K1 0)
  (!= K2 0))

(RULE &across_axis
  (&band_axis (:A *A3))
  (perp (:A A3) (:A2 *A)))

(RULE &near_dir
  (&across_axis *A)
  (axis_of *D A))

(RULE &near_node
  (input *P))

(RULE &line_split1
  (input (:P *P_))
  (&across_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_))
  (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

(RULE &line
  (input *P)
  (&across_axis *A)
  (&line_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1)))

(RULE &near_source
  (&line (:X *P)))

;; The distance between two lines.
(INIT &near Distance
  (key ((&near_source (:P ^O))
        (&near_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&near_source (:P O))
           (&near_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&near_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&near_node (:P Q)))
          ((&near_source (:P O))
           (&near_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&near_node (:P Q))
           (= A2 O))
          ((&near_source (:P O))
           (&near_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&near_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&near_node (:P Q)))))
    (source ((:n O))
      (&near_source (:P O))
      (&near_dir D))))

(RULE &near_ray
  (&near.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &near_end
  (&near_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&near_ray (:P Q) D Origin)))

(DET &mark RarestColor)

;; What ink outside the cone turns into.
(DET &fill AnyOutNewColor)

(DET &step TileCount)

(DET &ink SharedColor)

(RULE &band_of
  (&band_axis *A)
  (&frame_part_of *P A (:P_part *T)))

(RULE &strip
  (&band_of *T))

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &mark_band
  (&mark_cell *P)
  (&band_of P *T))

(RULE &ink2
  (&ink (:C *Col)))

(RULE &step2
  (&step (:N *K)))

(RULE &near_cell
  (&line (:X *P)))

(ALTS $s "the step, one band out" $Fixed
  (ALT $Marker
    ;; The step as an extent: the block's across the bands, or its band's
    ;; along them.
    (INIT &unit BoundingBox
      (cell (P)
        (&mark_cell *P)))

    (RULE &step2
      (&across_axis *A)
      (&unit.cell *P)
      (&unit.box *B)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *K))))
  (ALT $Band
    ;; The step as an extent: the block's across the bands, or its band's
    ;; along them.
    (INIT &unit BoundingBox
      (cell (P)
        (&mark_band *T)
        (&band_of *P T)))

    (RULE &step2
      (&band_axis *A)
      (&unit.cell *P)
      (&unit.box *B)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *K)))))

(ALTS $i "the ink" $Stored
  (ALT $Derived
    (RULE &ink2
      (input *Col)
      (NOT (&bg (:C Col)))
      (NOT (&mark (:C Col))))))

(INIT &cone Propagation
  (key ((OR ((&mark_band *T)
             (&band_axis *A)
             (axis_of ^D A)
             (step_offset D (:V *V_m1))
             (compose (:A T) (:B V_m1) (:C *T2))
             (&strip (:T T2))
             (&mark_cell (:P *M))
             (&line (:P M) *X))
            ((&band_axis A)
             (axis_of D A)
             (&strip T)
             (step_offset D (:V V_m1))
             (compose (:A T) (:B V_m1) (:C T2))
             (&strip (:T T2))
             (&near_cell (:P *X0))
             (&near_ray (:P X) *K (:Origin X0))
             (&near_cell (:P X))
             (&step2 (:K *W))
             (<= K W))))
    (source ((:n (:T T2) X))
      (&mark_band *T)
      (&band_axis *A)
      (axis_of D A)
      (step_offset D (:V *V_m1))
      (compose (:A T) (:B V_m1) (:C *T2))
      (&strip (:T T2))
      (&mark_cell (:P *M))
      (&line (:P M) *X))
    (edge ((:a T (:X X0)) (:b (:T T2) X))
      (&band_axis *A)
      (axis_of D A)
      (&strip *T)
      (step_offset D (:V *V_m1))
      (compose (:A T) (:B V_m1) (:C *T2))
      (&strip (:T T2))
      (&near_cell (:P *X0))
      (&near_ray (:P *X) *K (:Origin X0))
      (&near_cell (:P X))
      (&step2 (:K *W))
      (<= K W))))

(RULE &shade
  (&cone.reached (:n *T *X)))

(RULE &faded
  (input *P *Col)
  (&ink2 Col)
  (&band_of P *T)
  (NOT (&mark_band T))
  (&line P *X)
  (NOT (&shade T X)))

(RULE &output
  (OR ((&faded *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&faded P)))))
