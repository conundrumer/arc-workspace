;; 36fdfd69

(RULE &cluster_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D3))
       (step_offset (:D D3) (:V Delta)))
      ((dir8_elem (:D *D1))
       (step_offset (:D D1) (:V *S1))
       (dir8_elem (:D *D2))
       (step_offset (:D D2) (:V *S2))
       (compose (:A S1) (:B S2) (:C Delta)))))

(DET &mark RarestColor)

;; Marks cluster across a gap of at most one cell: a cluster step is two
;; steps in any directions.
(INIT &cluster Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&mark (:C Col))
         (&cluster_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&mark (:C Col2)))
        ((input P (:Col *Col3))
         (&mark (:C Col3))
         (= P3 P)))))

(RULE &cluster_component
  (&cluster.class (:a *P) *Id))

(DET &fill AnyOutNewColor)

(INIT &bbox BoundingBox
  (key ((&cluster_component *P ^Id))
    (cell (P)
      (&cluster_component *P Id))))

(RULE &unmarked
  (input *P *Col)
  (NOT (&mark (:C Col)))
  (&bbox.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &repaint
  (&unmarked *P))

(ALTS $choice "what the fill spares within a box. No box the pairs exhibit covers a &bg cell, so on the pairs the cases agree." $Solid
  (ALT $Recolor
    (DET &bg SharedColor)

    (RULE &repaint
      (&unmarked *P *Col)
      (NOT (&bg (:C Col))))))

(RULE &output
  (OR ((&repaint *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&repaint P)))))
