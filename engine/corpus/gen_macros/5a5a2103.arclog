;; 5a5a2103

(DET &gap DivisorRatio)

(DET &tile_dim SepTileDim)

(RULE &tile_division_gap
  (axis_elem *A)
  (&gap (:K *G)))

(RULE &tile_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_side
  (axis_elem *A)
  (&tile_dim (:D *K)))

(RULE &tile_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_dim (:D *K))
       (&gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tile_dim (:D *K2))
       (NOT (&tile_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_division_side A))
       (&tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(DET &legend_dir DirDomain)

(DET &spread_axis AxisDomain)

(RULE &tile
  (input (:P *P_grid))
  (&tile_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &ink
  (&tile (:P_grid *P) *P_tile *P_intile)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &legend_tile
  (&ink *P_tile)
  (&legend_dir *D)
  (margin (:B P_tile) D (:K 0)))

(RULE &spread
  (&legend_dir *D)
  (axis_of D *A))

(ALTS $choice "which tiles are read as the legend, and the line family a legend color spreads along" $Edge
  (ALT $Footprint
    (DET &shape_tile
      (&ink *E *P_tile *Col)
      (NOT (ex_output E Col)))

    (DET &marker
      (&ink *E *P_tile (:P_intile *P))
      (NOT (&shape_tile E P_tile)))

    (INIT &glyph Inclusion
      (pattern ((:m P_intile))
        (&marker (:P *P_intile)))
      (observed ((:observed P_tile) (:m P_intile))
        (&ink *P_tile *P_intile)))

    (RULE &legend_tile
      (&glyph.equal (:observed *P_tile)))

    (RULE &spread
      (&spread_axis *A)))
  (ALT $Twin
    ;; Tiles compared against each other: both sides are intile ink sets.
    (INIT &twin Inclusion
      (pattern ((:pattern P_tile) (:m P_intile))
        (&ink *P_tile *P_intile))
      (observed ((:observed P_tile) (:m P_intile))
        (&ink *P_tile *P_intile)))

    (RULE &legend_tile
      (&twin.equal (:observed *P_tile) (:pattern *P_tile2))
      (!= P_tile P_tile2))

    (RULE &spread
      (&spread_axis *A)))
  (ALT $Line
    (RULE &tile_line_split1
      (&ink (:P_tile *P_tile_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_tile_) (:X_rel *X_m1_)))

    (RULE &tile_line
      (&ink *P_tile)
      (axis_elem *A)
      (&tile_line_split1 (:P_tile_ P_tile) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

    (INIT &busiest_count Cardinality
      (key ((&tile_line ^A ^L *P_tile))
        (member ((:m P_tile))
          (&tile_line A L *P_tile))))

    (INIT &busiest Order
      (member ((:t (:A M_a) (:L M_l)))
        (&busiest_count.size (:key (:A *M_a) (:L *M_l))))
      (score ((:t (:A M_a) (:L M_l)) (:S N))
        (&busiest_count.size (:key (:A *M_a) (:L *M_l)) *N)))

    (RULE &legend_line
      (&busiest.maximal (:t *A *L)))

    (RULE &legend_tile
      (&legend_line *A *L)
      (&tile_line A L *P_tile))

    (RULE &spread
      (&legend_line *A))))

(RULE &stamp
  (&ink *P_tile *P_intile)
  (NOT (&legend_tile P_tile)))

(RULE &tile_color
  (&ink (:P_tile *P_legend) *Col)
  (&legend_tile (:P_tile P_legend))
  (&spread *A)
  (&tile *P_tile)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P_legend) (:D D_m2) (:K *K_m3))
  (margin (:B P_tile) (:D D_m2) (:K K_m3)))

(RULE &output
  (OR ((&tile (:P_grid *P) *P_tile *P_intile)
       (&tile_color P_tile (:Col *Col_row))
       (OR ((NOT (&stamp P_intile))
            (&bg (:C *Col)))
           ((&stamp P_intile)
            (= Col Col_row))))
      ((input P Col)
       (NOT (&tile (:P_grid P))))))
