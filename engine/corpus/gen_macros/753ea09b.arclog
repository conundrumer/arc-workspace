;; 753ea09b

(RULE &regions_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(INIT &ink_mode_count Cardinality
  (key ((input *P ^Col)
        (NOT (&bg_mode.maximal (:t Col))))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg_mode.maximal (:t Col))))))

(INIT &ink_mode Order
  (member ((:t Col))
    (&ink_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&ink_mode_count.size (:key *Col) *N)))

(RULE &rail_cell
  (input *P *Col)
  (&ink_mode.maximal (:t Col)))

(INIT &regions Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P)
         (NOT (&rail_cell P))
         (&regions_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3))
         (NOT (&rail_cell (:P P3))))
        ((input P)
         (NOT (&rail_cell P))
         (= P3 P)))))

(RULE &regions_component
  (&regions.class (:a *P) *Id))

(RULE &rails_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &rails Quotient
  (edge ((:a P) (:b P3))
    (OR ((&rail_cell *P)
         (&rails_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&rail_cell (:P P3)))
        ((&rail_cell P)
         (= P3 P)))))

(RULE &rails_component
  (&rails.class (:a *P) *Id))

(RULE &rail
  (&rails_component *P *Id)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(RULE &beside
  (&regions_component *P (:Id *Region))
  (step_offset (:D *D_m1) (:V *V_m2))
  (compose (:A P) (:B V_m2) (:C *Q))
  (&rails_component (:P Q) (:Id *Rail))
  (&rail (:Id Rail)))

(RULE &between
  (&beside *Region (:Rail *Id))
  (&beside Region (:Rail *Id2))
  (!= Id Id2))

(RULE &fill
  (input *P *Col)
  (&bg_mode.maximal (:t Col))
  (&regions_component P (:Id *R))
  (&between (:Region R)))

(RULE &output
  (OR ((&fill *P)
       (&ink_mode.maximal (:t *Col)))
      ((input P Col)
       (NOT (&fill P)))))
