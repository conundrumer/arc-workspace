;; a85d4709

(DET &axis AxisDomain)

(DET &fslice_split1
  (ex_input *E (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
  (relative (:Base P_inner_) (:X P_) (:X_rel *P_across_)))

(DET &mapping_out_split1
  (ex_output *E (:P *P_) (:Col *C_out))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(RULE &cell_split_split1
  (input (:P *P_))
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
  (relative (:Base P_inner_) (:X P_) (:X_rel *P_across_)))

(DET &fslice
  (ex_input *E *P *Col)
  (&axis *A)
  (&fslice_split1 (:P_ P) (:A_ A) (:P_inner_ *P_inner) (:P_across_ *P_across)))

;; Slices with equal content share an entry.
(INIT &same Inclusion
  (pattern ((:pattern (:E S_e) (:P_across S_p_across)) (:m (:P P_inner) (:Col C)))
    (&fslice (:E *S_e) (:P_across *S_p_across) *P_inner (:Col *C)))
  (observed ((:observed (:E S_e) (:P_across S_p_across)) (:m (:P P_inner) (:Col C)))
    (&fslice (:E *S_e) (:P_across *S_p_across) *P_inner (:Col *C))))

(INIT &entry Quotient
  (equivalent ((:a (:E S_e) (:P_across S_p_across)) (:b (:E S2_e) (:P_across S2_p_across)))
    (&same.equal (:observed (:E *S_e) (:P_across *S_p_across)) (:pattern (:E *S2_e) (:P_across *S2_p_across)))))

(DET &mapping_member
  (&entry.class (:a (:E *S_e) (:P_across *S_p_across)) *Id)
  (&fslice (:E S_e) (:P_across S_p_across) *P_inner (:Col *C)))

(RULE &cell_split
  (input *P)
  (&axis *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:P_inner_ *P_inner) (:P_across_ *P_across)))

(RULE &slice_cell
  (input *P *Col)
  (&cell_split P *P_inner *P_across))

(INIT &slice_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_inner) (:Col C)))
    (&mapping_member *Id *P_inner *C))
  (observed ((:observed P_across) (:m (:P P_inner) (:Col C)))
    (&slice_cell *P_across *P_inner (:Col *C))))

(DET &mapping_out
  (&entry.class (:a *E *P_across) *Id)
  (ex_output E *P (:Col *C_out))
  (&axis *A)
  (&mapping_out_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))

(ALTS $choice "which model recolors the slice" $Lookup
  (ALT $MarkerPosition
    (DET &position_color_split1
      (ex_output *E (:P *P_) (:Col *C_out))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

    (DET &marker RarestColor)

    (DET &position_color
      (&fslice *E *P_across (:P_inner *P) (:Col *MC))
      (&marker (:C MC))
      (ex_output E (:P *P2) *Col)
      (&axis *A)
      (&position_color_split1 (:P_ P2) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))

    (RULE &output
      (&cell_split *P *P_across)
      (input (:P *P_mark) (:Col *MC))
      (&marker (:C MC))
      (&cell_split (:P P_mark) (:P_inner *P_inner_mark) P_across)
      (&position_color (:P P_inner_mark) *Col))))

(RULE &output
  (&cell_split *P *P_across)
  (&mapping_out *Id (:C_out *Col))
  (&slice_match.equal (:observed P_across) (:pattern Id)))
