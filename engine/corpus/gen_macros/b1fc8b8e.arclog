;; b1fc8b8e

(DET &ink RarestColor)

(DET &canvas Frame)

(DET &bg DominantColor)

(DET &arrange Division)

(RULE &ink_at
  (input *P *Col)
  (&ink (:C Col)))

(DET &out_cmp_pattern_member
  (ex_output *E *P *Col))

(INIT &out_cmp Inclusion
  (pattern ((:pattern E) (:m (:P M_p) (:Col M_col)))
    (&out_cmp_pattern_member *E (:P *M_p) (:Col *M_col)))
  (observed ((:observed E) (:m (:P M_p) (:Col M_col)))
    (&out_cmp_pattern_member *E (:P *M_p) (:Col *M_col))))

;; One class per set of alike pairs; the label carries identity only.
(INIT &class Quotient
  (equivalent ((:a E) (:b E2))
    (&out_cmp.equal (:observed *E) (:pattern *E2))))

(DET &class_tile
  (&class.class (:a *E) *Id)
  (ex_output E (:P *P_grid) *Col)
  (&arrange P_grid *P_intile))

(DET &unit
  (&class_tile (:P_intile *P) *Col)
  (&ink (:C Col)))

;; Placements where the unit lands fully on ink, named by their margins,
;; with the cells each one covers.
(INIT &occ Occurrences
  (cell (P)
    (&ink_at *P))
  (shape ((:P S))
    (&ink_at)
    (&unit (:P *S))))

(RULE &covers
  (&occ.occurrence (:P *B))
  (&unit (:P *S))
  (compose (:A B) (:B S) (:C *P)))

(RULE &uncovered
  (&ink_at *P)
  (NOT (&covers P)))

(DET &broken_class
  (&class.class (:a *E) *Id)
  (&uncovered E))

(DET &covered_class
  (&class.class (:a *E) *Id)
  (&ink_at E)
  (NOT (&uncovered E)))

(RULE &class2
  (OR ((&uncovered)
       (&broken_class *Id))
      ((&ink_at)
       (NOT (&uncovered))
       (&covered_class Id))))

(DET &class_grid
  (&class.class (:a *E) *Id)
  (ex_output E *P *Col))

(ALTS $detect "how the ink is classified" $Shape
  (ALT $Partition
    (RULE &forcing_item
      (&covers *B *P))

    ;; The placements are the rival pieces of an exact cover of the ink. With one
    ;; footprint the forced pieces are the reading-order peel, and the peel reaches
    ;; a partition whenever the ink has one.
    (CHOOSE &forcing
      (for ((&forcing_item ^P))
        (from (&forcing_item P *B)))
      (never
        (&forcing_item *P *B)
        (&forcing_item (:P *P2) (:B *B2))
        (&forcing_item (:P P2) B)
        (!= B B2)))

    (RULE &packed
      (&forcing *B)
      (&covers B *P))

    (RULE &unpacked
      (&ink_at *P)
      (NOT (&packed P)))

    (RULE &class2
      (OR ((&unpacked)
           (&broken_class *Id))
          ((&ink_at)
           (NOT (&unpacked))
           (&covered_class Id)))))
  (ALT $Count
    (INIT &ink_tally Cardinality
      (member ((:m P))
        (&ink_at *P)))

    (RULE &ink_count
      (&ink_tally.size *N))

    (DET &class_count
      (&class.class (:a *E) *Id)
      (&ink_count E *N))

    (RULE &class2
      (&ink_count *N)
      (&class_count *Id N))))

(ALTS $render "how a class renders" $Grid
  (ALT $Arrange
    (RULE &arrange_grid
      (&arrange *P_grid *P_intile)
      (&class_tile *Id P_intile *Col))

    (RULE &output
      (OR ((&class2 *Id)
           (&arrange_grid Id (:P_grid *P) *Col))
          ((&class2)
           (&canvas P)
           (NOT (&arrange (:P_grid P)))
           (&bg (:C Col))))))
  (ALT $Corner
    (RULE &corner_map
      (&class_tile *P_intile)
      (&canvas (:P *P_grid))
      (diag_dir_elem (:D *Diag))
      (ALL ((corner_dir (:C Diag) (:D *D_m1))
            (margin (:B P_intile) (:D D_m1) (:K *K1_m2))
            (margin (:B P_grid) (:D D_m1) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))

    (RULE &output
      (OR ((&class2 *Id)
           (&corner_map *P_intile (:P_grid *P))
           (&class_tile Id P_intile *Col))
          ((&class2)
           (&canvas P)
           (NOT (&corner_map (:P_grid P)))
           (&bg (:C Col)))))))

(RULE &output
  (&class2 *Id)
  (&class_grid Id *P *Col))
