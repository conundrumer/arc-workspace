;; 8e1813be

(DET &bg DominantColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

(DET &square VanishedColor)

;; A stripe is a line whose colored cells (neither bg nor the square) are
;; one color.
(INIT &stripe Singleton
  (key ((input *P *Col)
        (NOT (&bg (:C Col)))
        (NOT (&square (:C Col)))
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:P_line_ ^P_line) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (NOT (&bg (:C Col)))
      (NOT (&square (:C Col)))
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:P_line_ P_line) (:X_m1_ *X_m1)))))

(RULE &mixed_axis
  (&stripe.plural (:key *A)))

;; The stripes packed along their axis, in spatial order.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t P_line))
      (&stripe.value (:key A *P_line))
      (NOT (&mixed_axis A)))
    (before ((:a P_line) (:b P_line2))
      (&stripe.value (:key A *P_line))
      (NOT (&mixed_axis A))
      (&stripe.value (:key A (:P_line *P_line2)))
      (!= P_line P_line2)
      (margin (:B P_line) D (:K *K1))
      (margin (:B P_line2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

;; The square, viewed from its own frame.
(INIT &square2 BoundingBox
  (cell (P)
    (input *P *Col)
    (&square (:C Col))))

(RULE &out_split1
  (&square2.box *B)
  (&square2.cell (:P *Q))
  (relative (:Base B) (:X Q) (:X_rel *P_inner_))
  (&stripe.value (:key (:A *A_) *P_line) (:v *Col))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_inner_) (:X_rel *P_across_)))

(RULE &output
  (&stripe.value (:key *A *P_line) (:v *Col))
  (&layout_pos (:Key A) (:M P_line) *P_pos)
  (&square2.cell (:P *Q))
  (&square2.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X Q) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X Q) (:X_rel *P_inner))
  (&out_split1 (:P_inner_ P_inner) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across))
  (compose (:A P_pos) (:B P_across) (:C *P)))
