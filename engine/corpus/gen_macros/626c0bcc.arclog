;; 626c0bcc

(DET &region_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &ink ChangedColor)

;; A piece is one connected run of ink cells that the output paints alike.
(INIT &region Quotient
  (edge ((:a E Col P) (:b E Col (:P P3)))
    (OR ((ex_output *E *P *Col)
         (ex_input E P (:Col *Ink))
         (&ink (:C Ink))
         (&region_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (ex_output E (:P P3) Col)
         (ex_input E (:P P3) (:Col *Ink2))
         (&ink (:C Ink2)))
        ((ex_output E P Col)
         (ex_input E P (:Col *Ink3))
         (&ink (:C Ink3))
         (= P3 P)))))

(DET &region_component
  (&region.class (:a *E *Col *P) *Id))

;; Each piece read from its own box — the frame the catalog stores it in.
(INIT &bbox BoundingBox
  (key ((&region_component ^E *P ^Id))
    (cell (P)
      (&region_component E *P Id))))

(DET &piece_inside1
  (&region_component *E *Col (:P *P_) *Id)
  (&bbox.box (:key E Id) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &piece
  (&region_component *E *Col (:P *P2) *Id)
  (&bbox.box (:key E Id) *B)
  (NOT (&piece_inside1 (:P_ P2) (:B_ B)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

;; A placement lands every cell of a piece on ink.
(INIT &occ Occurrences
  (key ((OR ((&piece ^Col (:P *P_inner)))
            ((&piece Col)
             (input *P (:Col *Ink))
             (&ink (:C Ink)))))
    (cell (P)
      (&piece Col)
      (input *P (:Col *Ink))
      (&ink (:C Ink)))
    (shape ((:P P_inner))
      (&piece Col (:P *P_inner)))))

(RULE &covers
  (&occ.occurrence (:key *Col) (:P *P_spot))
  (&piece Col (:P *P_inner))
  (compose (:A P_spot) (:B P_inner) (:C *P)))

(RULE &clash
  (&covers *Col *P_spot (:P *Q))
  (&covers (:Col *Col2) (:P_spot *P_spot2) (:P Q))
  (OR ((!= Col Col2))
      ((!= P_spot P_spot2))))

;; Every ink cell takes a fill, and no two cells take clashing placements.
(CHOOSE &fill
  (for ((&covers ^P))
    (from (&covers *Col *P_spot P)))
  (never
    (&covers *Col *P_spot *P)
    (&covers (:Col *Col2) (:P_spot *P_spot2) (:P *P2))
    (&clash Col P_spot Col2 P_spot2)))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&ink (:C Col))))))
