;; 7491f3cf

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

;; A separator is a grid line of one color.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &frame_divider
  (&line_color.value (:key *A *L)))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D (:K *K2)))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K2))
      (input *P)
      (dir_elem D)
      (margin (:B P) D (:K *K2)))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D (:K *K2))
  (&frame_rank.rank (:key D) (:t K2) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &side_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; Each panel's box.
(INIT &panel BoundingBox
  (key ((&frame_tile_of *P ^P_tile))
    (cell (P)
      (&frame_tile_of *P P_tile))))

(RULE &panel_view
  (&panel.cell (:key *P_tile) *P)
  (&panel.box (:key P_tile) *B)
  (ALL ((&panel.cell (:key (:P_tile *P_tilem)) P)
        (&panel.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &panel_cell
  (&panel_view *P_tile *P *P_intile)
  (input P *Col))

;; The blank panel is one color.
(INIT &panel_color Singleton
  (key ((&panel_cell ^E (:P_tile ^T) *Col))
    (member ((:v Col))
      (&panel_cell E (:P_tile T) *Col))))

(DET &inked
  (&frame_tile_of *E *P_tile)
  (NOT (&panel_color.value (:key E (:T P_tile)))))

(DET &out_tile
  (&frame_tile_of *P_tile)
  (NOT (&inked P_tile)))

;; The blank panel's color is the ground.
(RULE &ground
  (&out_tile (:P_tile *T))
  (&panel_cell (:P_tile T) *Col))

(RULE &ink
  (&panel_cell *P_tile *P_intile *Col)
  (NOT (&ground Col)))

(RULE &line
  (&ink *P_tile *P_intile)
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_intile) (:B V_m1) (:C *Q))
  (&ink P_tile (:P_intile Q)))

(RULE &marker
  (&ink *P_tile *P_intile)
  (NOT (&line P_tile P_intile)))

(DET &unmarked
  (&frame_tile_of *E *P_tile)
  (NOT (&marker E P_tile)))

(DET &mask_tile
  (&marker *P_tile)
  (NOT (&unmarked P_tile)))

(RULE &mask
  (&mask_tile *P_tile))

(RULE &side_node
  (&mask (:P_tile *T))
  (&panel_cell (:P_tile T) (:P_intile *P))
  (NOT (&line (:P_tile T) (:P_intile P))))

;; The side of the mask's line that the marker sits on.
(INIT &side Propagation
  (source ((:n P))
    (&mask (:P_tile *T))
    (&marker (:P_tile T) (:P_intile *P))
    (&side_node P))
  (edge ((:a P) (:b Q))
    (&side_node *P)
    (&side_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *Q))
    (&side_node (:P Q))))

(DET &pattern
  (&frame_tile_of *P_tile)
  (NOT (&mask_tile P_tile))
  (NOT (&out_tile P_tile)))

(DET &not_top
  (&pattern *P_tile)
  (&panel_cell *E P_tile *P_intile *Col)
  (&side.reached E (:n P_intile))
  (&out_tile (:P_tile *T_out))
  (&panel_view E (:P_tile T_out) *P P_intile)
  (ex_output E P (:Col *Col2))
  (!= Col Col2))

(DET &top_tile
  (&pattern *P_tile)
  (NOT (&not_top P_tile)))

(DET &under_tile
  (&pattern *P_tile)
  (NOT (&top_tile P_tile)))

(RULE &under
  (&under_tile (:P_tile *T))
  (&panel_cell (:P_tile T) *P_intile *Col)
  (NOT (&side.reached (:n P_intile))))

(RULE &top_ink
  (&top_tile (:P_tile *T))
  (&panel_cell (:P_tile T) *P_intile *Col)
  (NOT (&ground Col))
  (OR ((&side.reached (:n P_intile)))
      ((&mask_tile (:P_tile *T_mask))
       (&line (:P_tile T_mask) P_intile))))

(RULE &out_cell
  (&out_tile (:P_tile *T))
  (&panel_view (:P_tile T) *P *P_intile))

(RULE &render
  (&out_cell *P_intile)
  (OR ((&top_ink P_intile *Col))
      ((NOT (&top_ink P_intile))
       (&under P_intile Col))
      ((NOT (&top_ink P_intile))
       (NOT (&under P_intile))
       (&ground Col))))

(RULE &output
  (input *P)
  (OR ((&out_cell P *P_intile)
       (&render P_intile *Col))
      ((NOT (&out_cell P))
       (input P Col))))
