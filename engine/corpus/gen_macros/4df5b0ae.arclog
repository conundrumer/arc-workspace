;; 4df5b0ae

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &shapes_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

;; The row starts at pack_dir; the shapes rest on the edge a quarter turn away.
(DET &pack_dir DirDomain)

(DET &rest_sense SenseDomain)

(RULE &rest_dir
  (&pack_dir (:D *D2))
  (&rest_sense *S)
  (turn S (:D D2) (:D2 *D)))

(INIT &size Cardinality
  (key ((&shapes_component (:P *P_grid) (:Id ^M)))
    (member ((:m P_grid))
      (&shapes_component (:P *P_grid) (:Id M)))))

(INIT &bbox BoundingBox
  (key ((&shapes_component (:P *P_grid) (:Id ^M)))
    (cell ((:P P_grid))
      (&shapes_component (:P *P_grid) (:Id M)))))

(RULE &shape_inner
  (&shapes_component (:P *P_grid) (:Id *M))
  (&bbox.box (:key M) *B)
  (ALL ((&shapes_component (:P P_grid) (:Id *Mm))
        (&bbox.box (:key (:M Mm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

(RULE &line
  (&shape_inner *M *P_inner)
  (&pack_dir *D)
  (margin (:B P_inner) D *K))

(INIT &row Order
  (member ((:t M K))
    (&line *M *K))
  (before ((:a M K) (:b (:M M2) (:K K2)))
    (&line *M *K)
    (&line (:M *M2) (:K *K2))
    (OR ((&size.size (:key M) *N)
         (&size.size (:key (:M M2)) (:N *N2))
         (< N N2))
        ((= M M2)
         (< K K2)))))

(RULE &paint
  (&shapes_component (:Key *Col) (:P *P_grid_in) (:Id *M))
  (&shape_inner M (:P_grid P_grid_in) *P_inner)
  (&pack_dir *D)
  (margin (:B P_inner) D *K)
  (&row.rank (:t M K) *R)
  (input *P)
  (margin (:B P) D (:K R))
  (&rest_dir (:D *D_rest))
  (margin (:B P_inner) (:D D_rest) (:K *K_m1))
  (margin (:B P) (:D D_rest) (:K K_m1)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&bg (:C Col)))))
