;; 60b61512

(RULE &objs_steps2
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(INIT &objs2 Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps2 (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component2
  (&objs2.class (:a *P) *Id))

(DET &fill AnyOutNewColor)

(INIT &bx2 BoundingBox
  (key ((&objs_component2 *P ^Id))
    (cell (P)
      (&objs_component2 *P Id))))

(RULE &region
  (input *P)
  (&bx2.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(ALTS $choice "what the region covers" $Box
  (ALT $Stamp
    (DET &objs_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (DET &objs_node
      (ex_input (:E *Key) *P *Col)
      (NOT (&bg (:C Col))))

    (INIT &objs Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&objs_node (:Key *Ky) *P)
             (&objs_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&objs_node (:Key Ky) (:P P2)))
            ((&objs_node (:Key Ky) P)
             (= P2 P)))))

    (DET &objs_component
      (&objs.class (:a *Key *P) *Id))

    (INIT &bx BoundingBox
      (key ((&objs_component (:Key ^E) *P ^Id))
        (cell (P)
          (&objs_component (:Key E) *P Id))))

    (DET &footprint_inside1
      (ex_output *E (:P *P_) *Col)
      (&bx.box (:key E) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &footprint
      (&bx.box (:key *E) *B)
      (ex_output E (:P *P2) *Col)
      (NOT (&footprint_inside1 (:P_ P2) (:B_ B)))
      (relative (:Base B) (:X P2) (:X_rel *P))
      (NOT (&bg (:C Col))))

    (RULE &region
      (input *P)
      (&bx2.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&footprint (:P P_inner)))))

(RULE &painted
  (&region *P)
  (input P *Col)
  (&bg (:C Col)))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
