;; c35c1b4c

(INPUT one-blob "one color, the blob color, forms a large connected region near the middle of the grid, and that region is the largest single-color region in the grid"

  (RULE &region8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &commonest_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &region8 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((input *P *Col)
           (&region8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (= P3 P)))))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N)))

  (INIT &commonest_color Singleton
    (member ((:v Col))
      (&commonest.maximal (:t *Col)))))

(OUTPUT mirror-union "each cell of the blob color is copied, in the blob color, to the cell that mirrors it across the grid's midline on axis &axis"

  (RULE &region4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &region4 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((input *P *Col)
           (&region4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (= P3 P)))))

  (RULE &region4_component
    (&region4.class (:a *Key *P) *Id))

  (RULE &region
    (&region4_component (:Key *Col) *P *Id))

  (INIT &color_largest_count Cardinality
    (key ((&region *P ^Col ^Id))
      (member ((:m P))
        (&region *P Col Id))))

  (DET &axis AxisDomain)

  ;; The largest regions of each color.
  (INIT &color_largest Order
    (key ((&color_largest_count.size (:key ^Col *Id)))
      (member ((:t Id))
        (&color_largest_count.size (:key Col *Id)))
      (score ((:t Id) (:S N))
        (&color_largest_count.size (:key Col *Id) *N))))

  (INIT &blob_region Singleton
    (key ((&color_largest.maximal (:key ^Col) (:t *Id)))
      (member ((:v Id))
        (&color_largest.maximal (:t *Id))))))

(OUTPUT rest-kept "every other cell keeps its input color"

  (INIT &largest_count Cardinality
    (key ((&region *P ^Id))
      (member ((:m P))
        (&region *P Id))))

  ;; The largest regions.
  (INIT &largest Order
    (member ((:t Id))
      (&largest_count.size (:key *Id)))
    (score ((:t Id) (:S N))
      (&largest_count.size (:key *Id) *N)))

  (INIT &largest_color Singleton
    (member ((:v Col))
      (&largest.maximal (:t *Id))
      (&region *Col Id)))

  (RULE &mirror
    (input *P)
    (axis_elem *A)
    (axis_inversion A (:T *G))
    (apply (:D G) P (:P_out *Q)))

  (RULE &pick_color
    (&largest_color.value (:v *Col)))

  (RULE &blob_color
    (&pick_color *Col))

  (RULE &mirror_axis
    (&axis *A))

  (RULE &source
    (&blob_color *Col)
    (input *P Col)))

(ALTS $color "which color is the blob" $Largest
  (ALT $CommonestColor
    (INPUT one-blob "the blob color is the color with the most cells; undefined where two colors tie for the most cells"
      (RULE &pick_color
        (&commonest_color.value (:v *Col))))))

(ALTS $adj "the adjacency that joins a region" $Adj4
  (ALT $Adj8
    (INPUT one-blob "diagonal contacts join a region as well"
      (RULE &region8_component
        (&region8.class (:a *Key *P) *Id))

      (RULE &region
        (&region8_component (:Key *Col) *P *Id)))))

(ALTS $source "which cells are mirrored" $AllOfColor
  (ALT $BlobOnly
    (OUTPUT mirror-union "only the cells of the largest region of the blob color are mirrored; undefined where two such regions tie"
      (RULE &blob_color
        (&pick_color *Col)
        (&blob_region.value (:key Col)))

      (RULE &source
        (&blob_color *Col)
        (&blob_region.value (:key Col) (:v *Id))
        (&region *P Col Id)))))

(ALTS $dir "which way the mirror copies" $Union
  (ALT $OneWay
    (OUTPUT mirror-union "only the blob cells on side &source_side are copied, to their mirror cells on the other side; the axis of &source_side is the mirror axis"
      ;; The side whose blob cells are copied.
      (DET &source_side DirDomain)

      (RULE &mirror_axis
        (&source_side *D)
        (axis_of D *A)))
    (RULE &paint
      (&source (:P *P2))
      (&mirror_axis (:A *Ax))
      (&mirror (:A Ax) (:P P2) (:Q *P))
      (&source_side *D)
      (dir_elem D)
      (margin (:B P2) D (:K *K1_m1))
      (margin (:B P) D (:K *K2_m2))
      (< K1_m1 K2_m2))))

(ALTS $axis "the axis the blob is mirrored across" $StoredAxis
  (ALT $IntactHalf
    (OUTPUT mirror-union "the mirror axis is the one axis that has a side whose blob cells hold the mirror of every blob cell on the other side; undefined where no axis or both axes have such a side"
      (RULE &unmatched
        (&source *P)
        (dir_elem *D)
        (axis_of D (:A *Ax))
        (&mirror (:A Ax) P *Q)
        (dir_elem D)
        (margin (:B Q) D (:K *K1_m1))
        (margin (:B P) D (:K *K2_m2))
        (< K1_m1 K2_m2)
        (NOT (&source (:P Q))))

      ;; The axes with a side that holds the mirror of the other side's blob cells.
      (INIT &intact Singleton
        (member ((:v Ax))
          (&blob_color)
          (dir_elem *D)
          (axis_of D (:A *Ax))
          (NOT (&unmatched D))))

      (RULE &mirror_axis
        (&intact.value (:v *A))))))

(RULE &paint
  (&source (:P *P2))
  (&mirror_axis (:A *Ax))
  (&mirror (:A Ax) (:P P2) (:Q *P)))

(RULE &output
  (OR ((&paint *P)
       (&blob_color *Col))
      ((input P Col)
       (&blob_color)
       (&mirror_axis)
       (NOT (&paint P)))))
