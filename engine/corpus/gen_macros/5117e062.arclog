;; 5117e062

(RULE &figures_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &figures Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&figures_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &figures_component
  (&figures.class (:a *P) *Id))

(DET &mark RarestColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &region
  (&mark_cell (:P *M))
  (&figures_component (:P M) *Id)
  (&figures_component *P Id))

(ALTS $choice "which region the mark designates" $Object
  (ALT $Touch
    ;; The ring's box covers the mark, so the mark needs no rule of its own.
    (RULE &region
      (&mark_cell (:P *M))
      (dir8_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A M) (:B V_m1) (:C *P))
      (input P)))
  (ALT $Window
    (DET &win_dim ConstOutDim)

    (INIT &win Frame
      (extent (A N)
        (&win_dim *N)
        (axis_elem *A)))

    (RULE &region
      (&win.cell (:P *W_c))
      (ALL ((opposite (:D *D_m1) (:Opp *O_m2))
            (margin (:B W_c) (:D D_m1) (:K *K1_m3))
            (margin (:B W_c) (:D O_m2) (:K *K2_m4)))
           ((= K1_m3 K2_m4)))
      (&win.cell (:P *W))
      (relative (:Base W_c) (:X W) (:X_rel *V))
      (&mark_cell (:P *M))
      (compose (:A M) (:B V) (:C *P))
      (input P))))

;; The region carries one color besides bg and the mark, and the mark takes it.
(INIT &fill Singleton
  (member ((:v Col))
    (&region *P)
    (input P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&mark (:C Col)))))

(INIT &view BoundingBox
  (cell (P)
    (&region *P)))

(RULE &output
  (input (:P *P2) (:Col *Col_in))
  (&view.box *B)
  (ALL ((input (:P P2) (:Col *Col_inm))
        (&view.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (IF ((&mark (:C Col_in)))
      ((&fill.value (:v *Col)))
      ((= Col Col_in))))
