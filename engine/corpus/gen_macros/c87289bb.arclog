;; c87289bb

(INPUT streams-from-edge "vertical streams of `stream_color` (8), each one column wide, run from the edge opposite `fall_dir` (down) toward `fall_dir` and stop short of the far edge"

  (DET &changed
    (ex_input *E *P (:Col *Col_in))
    (ex_output E P (:Col *Col_out))
    (!= Col_out Col_in))

  (DET &stream_color
    (&changed (:Col_out *C)))

  (RULE &stream
    (input *P *Col)
    (&stream_color (:C Col)))

  (RULE &streams_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &streams Quotient
    (edge ((:a P) (:b P3))
      (OR ((&stream *P)
           (&streams_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&stream (:P P3)))
          ((&stream P)
           (= P3 P))))))

(INPUT bars-in-one-line "bars of `bar_color` (2), each one cell deep along `fall_dir` and one or more cells wide, lie in one line across `fall_dir`, past the end of every stream")

(INPUT exits-in-grid "the cell past each end of a bar lies in the grid")

(OUTPUT straight-fall "a stream whose line holds no bar past its end extends in `fall_dir` to the far edge")

(OUTPUT detour-nearer-end "a stream whose line meets a bar extends to the cell before the bar, runs across along that line of cells toward the bar's nearer end to the first cell past that end, and from there falls on in `fall_dir` by these rules")

(OUTPUT tie-side "a stream that meets a bar at a cell equally far from its two ends runs toward the side a quarter turn from `fall_dir` in `tie_sense` (counterclockwise: right, where the streams fall down)")

(OUTPUT keep-input "a cell the streams do not cover keeps its color, and the streams cover no bar cell"

  (RULE &bars_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &fall_dir
    (&stream_color (:C *Col))
    (ex_input *E *P Col)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&changed E (:P Q) (:Col_out Col)))

  (DET_OR_RULE &bar_color RarestColor
    (&stream_color (:C *S))
    (&fall_dir (:D *F))
    (ex_output *E *P (:Col S))
    (step_offset (:D F) (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (ex_output E (:P Q) (:Col *C))
    (!= C S))

  (RULE &bar
    (input *P *Col)
    (&bar_color (:C Col))
    (NOT (&stream P)))

  (INIT &bars Quotient
    (edge ((:a P) (:b P3))
      (OR ((&bar *P)
           (&bars_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&bar (:P P3)))
          ((&bar P)
           (= P3 P)))))

  (RULE &bars_component
    (&bars.class (:a *P) *Id))

  ;; the turn from `fall_dir` to the side a stream takes at a bar's middle cell
  (DET &tie_sense SenseDomain)

  (INIT &bar_box BoundingBox
    (key ((&bars_component *P ^Id))
      (cell (P)
        (&bars_component *P Id))))

  (RULE &fall
    (&fall_dir *D))

  (RULE &fall_step
    (&fall (:D *F))
    (input *P)
    (step_offset (:D F) (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (input (:P Q)))

  (RULE &meet
    (&fall_step *P *Q)
    (&bars_component (:P Q) *Id))

  (RULE &end_dist
    (&meet *P *Q *Id)
    (&bar_box.box (:key Id) *B)
    (ALL ((&meet (:P *Pm) Q (:Id *Idm))
          (&bar_box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X Q) (:X_rel *Q_rel))
    (&fall (:D *F))
    (axis_of (:D F) (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of *D (:A A2_m2))
    (opposite D (:Opp *O_m3))
    (margin (:B Q_rel) D *K)
    (margin (:B Q_rel) (:D O_m3) (:K *K2)))

  (RULE &side
    (OR ((&end_dist *P *D (:K *K1) *K2)
         (< K1 K2))
        ;; At the bar's middle cell, the stream turns from the fall direction by
        ;; `tie_sense`.
        ((&end_dist P *K (:K2 K))
         (&fall (:D *F))
         (&tie_sense *S)
         (turn S (:D F) (:D2 D)))))

  (RULE &exit
    (&end_dist *P *D *K)
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) K (:B *B1_m3))
    (edge_inset D K (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A P) (:B V_m1) (:C *R))
    (step_offset D (:V *V_m6))
    (compose (:A R) (:B V_m6) (:C *X)))

  (RULE &detour_side
    (&side *P *D))

  (RULE &flow_exit
    (&detour_side *P *D)
    (&exit P D *X)
    (input (:P X)))

  ;; The streams' cells, and the cells their falls and detours reach.
  (INIT &flow Propagation
    (source ((:n P))
      (&stream *P))
    (edge ((:a P) (:b Q))
      (OR ((&fall_step *P *Q)
           (NOT (&bar (:P Q))))
          ((&flow_exit P (:X Q)))))))

(ALTS $t "the side a stream takes when it meets a bar at the bar's middle cell" $TieDir
  (ALT $TieNearerEdge
    (OUTPUT tie-side "a stream that meets a bar at its middle cell runs toward the grid edge nearer to its line; undefined where that line is the grid's center line"
      (RULE &side
        ;; At the bar's middle cell, the stream runs toward the grid edge nearer its
        ;; line.
        (OR ((&end_dist *P *D *K (:K2 K))
             (opposite D (:Opp *O_m1))
             (margin (:B P) D (:K *K1))
             (margin (:B P) (:D O_m1) (:K *K2))
             (< K1 K2))
            ((&end_dist P D (:K *K12) (:K2 *K22))
             (< K12 K22)))))))

(ALTS $e "what a stream does where the cell past the bar's end it runs toward lies outside the grid" $EdgeLeave
  (ALT $EdgeOtherSide
    (OUTPUT edge-other-side "where the cell past the end a stream runs toward lies outside the grid, the stream runs toward the bar's other end instead"
      (RULE &detour_side
        (&side *P (:D *D0))
        (&exit P (:D D0) *X)
        (OR ((NOT (input (:P X)))
             (opposite (:D D0) (:Opp *D)))
            ((input (:P X))
             (= D D0)))))))

(ALTS $l "what a stream does after a detour when its new line meets another bar" $EveryDetour
  (ALT $OneDetour
    (OUTPUT detour-nearer-end "after its first detour, the stream falls straight on to the far edge, passing over bar cells, which keep their color"
      ;; The streams' cells, and the cells their falls and detours reach.
      (INIT &flow Propagation
        (source ((:n P))
          (&stream *P))
        (edge ((:a P) (:b Q))
          (&fall_step *P *Q)
          (NOT (&bar (:P Q)))))

      (RULE &after_source
        (&flow.reached (:n *P2))
        (&flow_exit (:P P2) (:X *P)))

      (RULE &after_dir
        (&fall *D))

      (RULE &after_node
        (&fall (:D *F))
        (input *P))

      ;; After its first detour, a stream falls straight from the exit cell over
      ;; every cell but the bars'.
      (INIT &after Distance
        (key ((&after_source (:P ^O))
              (&after_dir ^D))
          (edge ((:a A2) (:b Q))
            (OR ((&after_source (:P O))
                 (&after_dir D)
                 (axis_of D *A)
                 (sub_extent (:P O) A *K)
                 (dir8_opposite D (:D2 *O_m2))
                 (edge_inset (:D O_m2) K (:B *B1_m3))
                 (edge_inset D K (:B *I_m5))
                 (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
                 (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
                 (compose (:A O) (:B V_m1) (:C *A2))
                 (&after_node (:P A2))
                 (step_offset D (:V *V_m6))
                 (compose (:A A2) (:B V_m6) (:C *Q))
                 (&after_node (:P Q)))
                ((&after_source (:P O))
                 (&after_dir D)
                 (step_offset D (:V *V_m12))
                 (compose (:A O) (:B V_m12) (:C Q))
                 (&after_node (:P Q))
                 (= A2 O))
                ((&after_source (:P O))
                 (&after_dir D)
                 (diag_dir_elem D)
                 (axis_elem (:A *A3))
                 (sub_extent (:P O) (:A A3) (:K *K2))
                 (dir8_opposite D (:D2 *O_m22))
                 (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
                 (edge_inset D (:K K2) (:B *I_m52))
                 (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
                 (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
                 (compose (:A O) (:B V_m13) (:C A2))
                 (&after_node (:P A2))
                 (step_offset D (:V *V_m62))
                 (compose (:A A2) (:B V_m62) (:C Q))
                 (&after_node (:P Q)))))
          (source ((:n O))
            (&after_source (:P O))
            (&after_dir D))))

      (RULE &after_ray
        (&after.distance (:key *D (:O *Origin)) (:n *P) *K))

      (RULE &after_end
        (&after_ray *P *D *K *Origin)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (NOT (&after_ray (:P Q) D Origin)))

      (RULE &after_cell
        (input *P)
        (NOT (&bar P))))
    (RULE &painted
      (OR ((&flow.reached (:n *P)))
          ((&flow.reached (:n *P2))
           (&detour_side (:P P2) *D)
           (&run (:P P2) D (:R P)))
          ((&after_ray P)
           (&after_cell P))))))

(ALTS $f "the direction in which the streams fall" $FallStored
  (ALT $FallFromEdge
    (INPUT streams-from-edge "every stream touches one edge, and the streams fall away from it; undefined where every stream touches two edges, or where there is no stream"
      (RULE &streams_component
        (&streams.class (:a *P) *Id))

      (RULE &touches
        (&streams_component *P *Id)
        (dir_elem (:D *E1))
        (margin (:B P) (:D E1) (:K 0)))

      (RULE &source_edge
        (dir_elem (:D *E1))
        (ALL ((&streams_component *Id))
             ((&touches Id E1))))

      (RULE &fall
        (&source_edge (:E1 *E))
        (ALL ((&source_edge (:E1 *Em))
              (&source_edge (:E1 *E2)))
             ((= Em E2)))
        (opposite (:D E) (:Opp *D))))))

(RULE &run
  (&meet *P *Id)
  (&meet (:P *R) Id)
  (dir_elem *D)
  (dir_elem D)
  (margin (:B R) D (:K *K1_m1))
  (margin (:B P) D (:K *K2_m2))
  (< K1_m1 K2_m2))

(RULE &painted
  (OR ((&flow.reached (:n *P)))
      ((&flow.reached (:n *P2))
       (&detour_side (:P P2) *D)
       (&run (:P P2) D (:R P)))))

(RULE &undefined
  (OR ((NOT (&fall)))
      ((&flow.reached (:n *P))
       (&meet P)
       (NOT (&side P)))))

(RULE &output
  (OR ((&painted *P)
       (NOT (&undefined))
       (&stream_color (:C *Col)))
      ((input P Col)
       (NOT (&painted P))
       (NOT (&undefined)))))
