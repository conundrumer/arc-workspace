;; 12997ef3

(DET &bg DominantColor)

(DET &stencil VanishedColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stencil (:C Col))))

(RULE &off_axis_split1
  (&mark (:P *P1_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P1_) (:D D_m1) (:K *K1_m3))
  (margin (:B P1_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P1_) (:X_rel *X1_)))

(RULE &off_axis_split2
  (&mark (:P *P2_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X P2_) (:X_rel *X2_)))

(RULE &layout_axis
  (axis_elem *A)
  (ALL ((&mark (:P *P1))
        (&mark (:P *P2))
        (&off_axis_split1 (:P1_ P1) (:A_ A) (:X_m1_ *X_m1) (:X1_ *X1))
        (&off_axis_split2 (:P2_ P2) (:A_ A) (:X_m2_ *X_m2) (:X2_ *X2)))
       ((= X1 X2))))

(RULE &before_split1
  (&mark (:P *P_))
  (&layout_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

(RULE &before_split2
  (&mark (:P *P2_))
  (&layout_axis (:A *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along2_))
  (relative (:Base P_along2_) (:X P2_) (:X_rel *X_m2_)))

(RULE &elem_split1
  (&mark (:P *P_))
  (&layout_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

(INIT &order Order
  (key ((&layout_axis (:A ^A2))
        (axis_of ^D (:A A2)))
    (before ((:a P) (:b P2))
      (&mark *P)
      (&layout_axis *A)
      (&before_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1))
      (&mark (:P *P2))
      (&layout_axis (:A *A22))
      (&before_split2 (:P2_ P2) (:A2_ A22) (:P_along2_ *P_along2) (:X_m2_ *X_m2))
      (!= P P2)
      (margin (:B P_along) D (:K *K1))
      (margin (:B P_along2) D (:K *K2))
      (< K1 K2)))
  (member ((:t P))
    (&mark *P)
    (&layout_axis *A)
    (&elem_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1))))

(RULE &order_pos
  (&order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
  (&order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &stencil_cell
  (input *P *Col)
  (&stencil (:C Col)))

(INIT &bbox BoundingBox
  (cell (P)
    (&stencil_cell *P)))

(INIT &place_tiling Tiling
  (outer ((:P P_tile))
    (&order_pos (:P_pos *P_tile)))
  (inner ((:P P_intile))
    (&bbox.box *B)
    (input (:P *P_grid_in))
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P_grid_in) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))))

(RULE &place
  (&layout_axis)
  (&mark (:P *P_mark) (:Col *Col_mark))
  (&order_pos (:M P_mark) (:P_pos *P_tile))
  (&bbox.box *B)
  (input (:P *P_grid_in))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid_in) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))
  (&place_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_grid_out)))

(ALTS $choice "whether a tile reproduces the box's other content" $Stamp
  (ALT $Recolor
    (RULE &output
      (&place (:P_grid_out *P) *P_grid_in *Col_mark)
      (OR ((NOT (&stencil_cell (:P P_grid_in)))
           (input (:P P_grid_in) *Col))
          ((&stencil_cell (:P P_grid_in))
           (= Col Col_mark))))))

(RULE &output
  (&place (:P_grid_out *P) *P_grid_in *Col_mark)
  (OR ((NOT (&stencil_cell (:P P_grid_in)))
       (&bg (:C *Col)))
      ((&stencil_cell (:P P_grid_in))
       (= Col Col_mark))))
