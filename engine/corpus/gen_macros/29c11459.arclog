;; 29c11459

(DET &axis AxisDomain)

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &pair
  (&mark (:P *M1) (:Col *C1))
  (&mark (:P *M2) (:Col *C2))
  (&axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B M1) (:D D_m2) (:K *K_m3))
  (margin (:B M2) (:D D_m2) (:K K_m3))
  (axis_of *D A)
  (dir_elem D)
  (margin (:B M1) D (:K *K1_m4))
  (margin (:B M2) D (:K *K2_m5))
  (< K1_m4 K2_m5))

(RULE &rays_dir
  (&pair *D (:C1 *Key)))

(RULE &rays_node
  (&pair *D (:C1 *Key))
  (input *P))

(RULE &rays_source
  (&mark *P (:Col *Key)))

(INIT &rays Distance
  (key ((&rays_source (:Key ^Ky) (:P ^O))
        (&rays_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:Key Ky) (:P O))
           (&rays_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:Key Ky) (:P Q)))
          ((&rays_source (:Key Ky) (:P O))
           (&rays_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&rays_source (:Key Ky) (:P O))
           (&rays_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&rays_source (:Key Ky) (:P O))
      (&rays_dir (:Key Ky) D))))

(RULE &rays_ray
  (&rays.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray Key (:P Q) D Origin)))

(DET &clash AnyOutNewColor)

(RULE &between
  (&pair *D *M1 *C1 *M2)
  (&axis *A)
  (opposite D (:Opp *O))
  (input *P)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B M1) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3))
  (relative (:Base M1) (:X P) (:X_rel *V1))
  (margin (:B V1) D (:K *K1))
  (>= K1 0)
  (relative (:Base M2) (:X P) (:X_rel *V2))
  (margin (:B V2) (:D O) (:K *K2))
  (>= K2 0))

(RULE &front
  (&between *P (:C1 *Col) *K1 *K2)
  (< K1 K2))

(RULE &clash_cell
  (&between *P (:K1 *K) (:K2 K)))

(ALTS $choice "which fill prior colors the row; every mark sits on its edge, so the three coincide on this data" $Meet
  (ALT $Near
    (RULE &rays_cell
      (&mark (:Col *Key))
      (input *P))

    (RULE &territory
      (OR ((&front *P *Col))
          ((&rays_ray (:Key Col) P)
           (&rays_cell (:Key Col) P))))

    (RULE &output
      (OR ((&territory *P *Col))
          ((&clash_cell P)
           (&clash (:C Col)))
          ((input P)
           (NOT (&territory P))
           (NOT (&clash_cell P))
           (&bg (:C Col))))))
  (ALT $Half
    (RULE &owner_split1
      (&mark (:P *M_) *Col)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B M_) (:D D_m1) (:K *K1_m3))
      (margin (:B M_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X M_) (:X_rel *Ac_)))

    (RULE &out_split1
      (input (:P *P_))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *Ac_)))

    (RULE &owner
      (&mark (:P *M) *Col)
      (&axis *A)
      (&owner_split1 (:M_ M) (:A_ A) (:X_m1_ *X_m1) (:Ac_ *Across))
      (axis_of *D A)
      (opposite D (:Opp *O_m2))
      (margin (:B M) D (:K *K1))
      (margin (:B M) (:D O_m2) (:K *K2))
      (< K1 K2))

    (RULE &output
      (input *P)
      (&axis *A)
      (&out_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Ac_ *Ac))
      (OR ((&owner (:Across Ac) *D *Col)
           (opposite D (:Opp *O_m2))
           (margin (:B P) D (:K *K1))
           (margin (:B P) (:D O_m2) (:K *K2))
           (< K1 K2))
          ((&owner (:Across Ac))
           (axis_of D A)
           (opposite D (:Opp *O_m3))
           (margin (:B P) D *K)
           (margin (:B P) (:D O_m3) K)
           (&clash (:C Col)))
          ((NOT (&owner (:Across Ac)))
           (&bg (:C Col)))))))

(RULE &output
  (OR ((&front *P *Col))
      ((&clash_cell P)
       (&clash (:C Col)))
      ((input P)
       (NOT (&front P))
       (NOT (&clash_cell P))
       (&bg (:C Col)))))
