;; ac0c5833

(INPUT markers "several markers of &marker_color sit on a background of &bg. Each marker is three isolated cells at three corners of a square box whose corners are &marker_stride cells apart. The fourth corner of the box, the marker's empty corner, does not hold the marker color."

  (DET_OR_RULE &bg DominantColor)

  (DET_OR_RULE &marker_stride "The distance between adjacent corners of a marker's box." TileCount SepTileCount)

  (DET &marker_color UnchangedColor))

(INPUT template "one shape of &template_color has a bounding-box corner at the empty corner of one marker, the template's marker, and lies on the far side of that corner from the marker's three cells."

  (DET_OR_RULE &template_color RarestColor)

  (RULE &side
    (input *P)
    (dir_elem *D)
    (margin (:B P) D *K)
    (> K 0))

  (RULE_OR_DET &hue_cand "A color the marker-color branch admits as the marker color."
    (&marker_color (:C *Col)))

  (RULE &hue
    (&hue_cand *Col))

  (RULE &triple
    (&hue *Col)
    (input (:P *C) Col)
    (corner_dir (:C *X) (:A *A_m1) (:D *D1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (corner_dir (:C X) (:A A2_m2) (:D *D2))
    (&side (:K *K1))
    (dir8_opposite (:D D1) (:D2 *O_m4))
    (edge_inset (:D O_m4) (:K K1) (:B *B1_m5))
    (edge_inset (:D D1) (:K K1) (:B *I_m7))
    (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
    (compose (:A C) (:B V_m3) (:C *P))
    (input P Col)
    (&side (:K *K2))
    (dir8_opposite (:D D2) (:D2 *O_m9))
    (edge_inset (:D O_m9) (:K K2) (:B *B1_m10))
    (edge_inset (:D D2) (:K K2) (:B *I_m12))
    (relative (:Base I_m12) (:X 0) (:X_rel *B2_m11))
    (compose (:A B1_m10) (:B B2_m11) (:C *V_m8))
    (compose (:A C) (:B V_m8) (:C *Q))
    (input (:P Q) Col)
    (dir8_opposite (:D D2) (:D2 *O_m14))
    (edge_inset (:D O_m14) (:K K2) (:B *B1_m15))
    (edge_inset (:D D2) (:K K2) (:B *I_m17))
    (relative (:Base I_m17) (:X 0) (:X_rel *B2_m16))
    (compose (:A B1_m15) (:B B2_m16) (:C *V_m13))
    (compose (:A P) (:B V_m13) (:C *E1))
    (input (:P E1))
    (NOT (input (:P E1) Col)))

  (RULE &square
    (&marker_stride *N))

  (RULE &box_triple
    (&square *N)
    (&hue *Col)
    (&triple Col *E1 *X *C *P *Q (:K1 N) (:K2 N)))

  (RULE &triple_cell
    (&box_triple *N *Col *E1 *C (:P *P1) (:Q *Q1))
    (OR ((= *P C))
        ((= P P1))
        ((= P Q1))))

  (RULE &split_fault
    (OR ((&box_triple *N *Col)
         (input *P Col)
         (NOT (&triple_cell N Col P)))
        ((&triple_cell N Col (:E1 *E) *C (:P *P2))
         (&triple_cell N Col (:E1 *E2) (:C *C2) (:P P2))
         (OR ((!= E E2))
             ((!= C C2))))))

  (RULE &exact_split
    (&box_triple *N *Col)
    (NOT (&split_fault N Col))))

(OUTPUT copy-per-marker "at each other marker, the template is drawn with its bounding-box corner at that marker's empty corner, extending away from the marker's three cells. Copy cells outside the grid are dropped. Undefined where no marker, or more than one, is the template's marker.")

(OUTPUT mirror "the copy is the template mirrored across each axis on which the target marker's empty corner lies on the other side of its box from the template marker's empty corner.")

(OUTPUT overlay "only the template's cells are written; every other cell keeps its input color."

  (RULE &reading_cand
    (&box_triple *N *Col))

  (RULE &rival
    (&reading_cand *N *Col)
    (&reading_cand N (:Col *Col2))
    (!= Col Col2))

  (RULE &reading
    (&reading_cand *N *Col)
    (NOT (&rival N)))

  (RULE &marker_at
    (&reading *N *Col)
    (&box_triple N Col *E1 *X))

  (RULE &tmpl
    (&reading (:N *K))
    (&template_color (:C *Col))
    (input *P Col))

  (INIT &tmpl_box BoundingBox
    (key ((&tmpl (:K ^N) *P))
      (cell (P)
        (&tmpl (:K N) *P))))

  (RULE &source_cand
    (&tmpl_box.box (:key (:N *K)) *B)
    (&marker_at (:N K) *E1 *X)
    (diag_opposite (:D X) (:Opp *X_o))
    (ALL ((&marker_at (:N *Nm) E1 (:X *Xm))
          (&tmpl_box.box (:key (:N Nm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X E1) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (ALL ((diag_opposite (:D *Xmm) (:Opp X_o))
          (&marker_at (:N *Nmm) E1 (:X Xmm))
          (&tmpl_box.box (:key (:N Nmm)) B)
          (corner_dir (:C X_o) (:D *D_m1m))
          (margin (:B E1) (:D D_m1m) (:K *K1_m2))
          (margin B (:D D_m1m) (:K *K2_m3)))
         ((= K1_m2 K2_m3))))

  (RULE &source_clash
    (&source_cand *K (:E1 *E) *X)
    (&source_cand K (:E1 *E2) (:X *X2))
    (OR ((!= E E2))
        ((!= X X2))))

  (RULE &source
    (&source_cand *K *E1 *X)
    (NOT (&source_clash K))))

(ALTS $extent "how a marker's box is sized" $StoredStride
  (ALT $DerivedStride
    (INPUT markers "the stride is the one side s at which the marker-color cells split exactly into three-corner triples of s-sided square boxes. Undefined where no side gives such a split, or more than one does."
      (RULE &reading_cand
        (&exact_split *N *Col))

      (RULE &rival
        (OR ((&reading_cand *N)
             (&reading_cand (:N *N2))
             (!= N N2))
            ((&reading_cand N *Col)
             (&reading_cand N (:Col *Col2))
             (!= Col Col2))))

      (RULE &square
        (&side (:K *N))))
    (RULE &value_of
      (&side (:K *N))))
  (ALT $RectMarker
    (INPUT markers "a marker is three marker-color cells at three corners of any axis-aligned rectangle whose sides are each at most &marker_max_side, with the fourth corner not of that color. Undefined unless each marker-color cell lies in exactly one such triple."
      (DET &admits2
        (&side *E (:K *N))
        (&side E (:K *K1))
        (<= K1 N)
        (&side E (:K *K2))
        (<= K2 N))

      (DET &hue2
        (ex_input *E)
        (&marker_color (:C *Col)))

      (DET &triple2
        (&hue2 (:E *Key) *Col)
        (ex_input (:E Key) (:P *C) Col)
        (corner_dir (:C *X) (:A *A_m1) (:D *D1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (corner_dir (:C X) (:A A2_m2) (:D *D2))
        (&side (:E Key) (:K *K1))
        (dir8_opposite (:D D1) (:D2 *O_m4))
        (edge_inset (:D O_m4) (:K K1) (:B *B1_m5))
        (edge_inset (:D D1) (:K K1) (:B *I_m7))
        (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
        (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
        (compose (:A C) (:B V_m3) (:C *P))
        (ex_input (:E Key) P Col)
        (&side (:E Key) (:K *K2))
        (dir8_opposite (:D D2) (:D2 *O_m9))
        (edge_inset (:D O_m9) (:K K2) (:B *B1_m10))
        (edge_inset (:D D2) (:K K2) (:B *I_m12))
        (relative (:Base I_m12) (:X 0) (:X_rel *B2_m11))
        (compose (:A B1_m10) (:B B2_m11) (:C *V_m8))
        (compose (:A C) (:B V_m8) (:C *Q))
        (ex_input (:E Key) (:P Q) Col)
        (dir8_opposite (:D D2) (:D2 *O_m14))
        (edge_inset (:D O_m14) (:K K2) (:B *B1_m15))
        (edge_inset (:D D2) (:K K2) (:B *I_m17))
        (relative (:Base I_m17) (:X 0) (:X_rel *B2_m16))
        (compose (:A B1_m15) (:B B2_m16) (:C *V_m13))
        (compose (:A P) (:B V_m13) (:C *E1))
        (ex_input (:E Key) (:P E1))
        (NOT (ex_input (:E Key) (:P E1) Col)))

      (DET &box_triple2
        (&admits2 (:E *Key) *N *K1 *K2)
        (&hue2 (:E Key) *Col)
        (&triple2 Key Col *E1 *X *C *P *Q K1 K2))

      (DET &triple_cell2
        (&box_triple2 *Key *N *Col *E1 *C (:P *P1) (:Q *Q1))
        (OR ((= *P C))
            ((= P P1))
            ((= P Q1))))

      (DET &split_fault2
        (OR ((&box_triple2 (:Key *E) *N *Col)
             (ex_input E *P Col)
             (NOT (&triple_cell2 (:Key E) N Col P)))
            ((&triple_cell2 (:Key E) N Col *E1 *C (:P *P2))
             (&triple_cell2 (:Key E) N Col (:E1 *E2) (:C *C2) (:P P2))
             (OR ((!= E1 E2))
                 ((!= C C2))))))

      (DET &exact_split2
        (&box_triple2 (:Key *E) *N *Col)
        (NOT (&split_fault2 E N Col)))

      (DET &unsplit
        (&side (:K *M))
        (ex_output *E)
        (&marker_color (:C *Col))
        (NOT (&exact_split2 E (:N M) Col)))

      (DET_OR_RULE &marker_max_side "The longest side a marker's box may have." SepTileCount TileCount
        (&exact_split2 *N)
        (NOT (&unsplit (:M N)))
        (ONE))

      (RULE &admits
        (&marker_max_side *N)
        (&side (:K *K1))
        (<= K1 N)
        (&side (:K *K2))
        (<= K2 N))

      (RULE &box_triple
        (&admits *N *K1 *K2)
        (&hue *Col)
        (&triple Col *E1 *X *C *P *Q K1 K2))

      (RULE &reading_cand
        (&exact_split *N *Col)))
    ;; The reading at n is the one at the open value n.
    (RULE &value_of
      (&marker_max_side *N))))

(ALTS $mcolor "where the marker color comes from" $StoredMarkerColor
  (ALT $DerivedMarkerColor
    (INPUT markers "the marker color is the one non-background color whose cells split exactly into the marker triples of the extent branch. Undefined where no such color does, or more than one does."
      (RULE &reading_cand
        (&exact_split *N *Col))

      (RULE &hue_cand
        (input *Col)
        (NOT (&bg (:C Col)))))))

(ALTS $tcolor "which cells form the template" $StoredTemplateColor
  (ALT $AnyColorTemplate
    (INPUT template "the template is every cell that is neither background nor marker color.")
    (OUTPUT overlay "each template cell is copied in its own color. Undefined where two copies write different colors to one cell."
      (RULE &tmpl
        (&reading (:N *K))
        (input *P *Col)
        (NOT (&bg (:C Col)))
        (NOT (&reading (:N K) Col))))))

(ALTS $transform "how the copy is turned" $Mirror
  (ALT $Rotate
    (OUTPUT mirror "the copy is the template turned by the rotation that carries the template marker's corner onto the target marker's corner.")
    (RULE &carry
      (c4_elem (:D *G))
      (d4_elem (:D G))
      (diag_dir_elem (:D *X))
      (diag_dir_elem (:D *X2))
      (step_offset (:D X) (:V *S_m1))
      (apply (:D G) (:P S_m1) (:P_out *S2_m2))
      (step_offset (:D X2) (:V S2_m2)))))

(ALTS $stamp "which cells a copy writes" $InkOnly
  (ALT $BoxStamp
    (OUTPUT overlay "the copy writes the template's whole bounding box, and its background cells overwrite what they cover. Undefined where one copy's background meets another copy's template cell.")
    (RULE &footprint
      (&source *K (:E1 *E))
      (&tmpl_box.box (:key (:N K)) *B)
      (input *P)
      (ALL ((&tmpl_box.box (:key (:N *Km)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base E) (:X P) (:X_rel *V))
      (OR ((&tmpl K P *Col))
          ((NOT (&tmpl K P))
           (&bg (:C Col)))))))

(RULE &value_of
  (&marker_stride *N))

(RULE &split_reading
  (&marker_at *N (:E1 *E) *X)
  (&value_of N)
  (&reading (:N *N2))
  (&value_of (:N N2))
  (NOT (&marker_at (:N N2) (:E1 E) X)))

(RULE &carry
  (d4_elem (:D *G))
  (diag_dir_elem (:D *X))
  (diag_dir_elem (:D *X2))
  (step_offset (:D X) (:V *S_m1))
  (apply (:D G) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D X2) (:V S2_m2))
  (ALL ((dir_elem *D)
        (dir_elem (:D *D2))
        (step_offset D (:V *S_m1m))
        (apply (:D G) (:P S_m1m) (:P_out *S2_m2m))
        (step_offset (:D D2) (:V S2_m2m))
        (axis_of D *A))
       ((axis_of (:D D2) A))))

(RULE &footprint
  (&source *K (:E1 *E))
  (&tmpl K *P *Col)
  (relative (:Base E) (:X P) (:X_rel *V)))

(RULE &copy
  (&source *K *X)
  (&marker_at (:N K) (:E1 *E2) (:X *X2))
  (NOT (&source K (:E1 E2)))
  (&carry X X2 *G)
  (&footprint K *V *Col)
  (apply (:D G) (:P V) (:P_out *V2))
  (compose (:A E2) (:B V2) (:C *P)))

(RULE &output
  (&source (:K *N))
  (&value_of N)
  (NOT (&split_reading))
  (input *P (:Col *C0))
  (OR ((&copy (:K N) P *Col))
      ((NOT (&copy (:K N) P))
       (= Col C0))))
