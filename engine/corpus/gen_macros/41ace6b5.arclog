;; 41ace6b5

(DET &cap_line RarestColor)

;; The direction a cap stands off the cap line; the stem hangs the other way.
(DET &grow DirDomain)

(DET &stem_line RarestColor)

(RULE &ruler
  (OR ((&cap_line (:C *Col))
       (&grow *D))
      ((&stem_line (:C Col))
       (&grow (:D *D_cap))
       (opposite (:D D_cap) (:Opp D)))))

(RULE &cast_dir
  (&ruler (:Col *Key) *D))

(RULE &cast_node
  (&ruler (:Col *Key) *D)
  (input *P))

(RULE &foot
  (input (:P *P_ink) *Col)
  (&ruler Col)
  (&grow *D)
  (margin (:B P_ink) D (:K *K_m1))
  (input *P (:Col *Col_p))
  (margin (:B P) D (:K K_m1))
  (NOT (&ruler (:Col Col_p))))

(RULE &cast_source
  (&foot (:Col *Key) *P))

;; Each ruler line casts its bars' ink away from the other line.
(INIT &cast Distance
  (key ((&cast_source (:Key ^Ky) (:P ^O))
        (&cast_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:Key Ky) (:P Q)))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&cast_source (:Key Ky) (:P O))
      (&cast_dir (:Key Ky) D))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray Key (:P Q) D Origin)))

(RULE &bar_of_split1
  (input (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *B_)))

(DET &bg DominantColor)

(DET &rest AnyOutNewColor)

(RULE &bar_of
  (input *P)
  (&grow *D)
  (axis_of D *A)
  (&bar_of_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:B_ *B)))

(RULE &bar
  (&foot *P)
  (&bar_of P *B))

(RULE &bar_cell
  (&bar *B)
  (&bar_of *P B))

(DET &foot_ink
  (&foot *E (:Col *Col_line) *P)
  (ex_output E P *Col))

(DET &stem
  (&foot_ink *Col_line *Col)
  (&stem_line (:C Col_line)))

;; How far each bar's stem reaches.
(INIT &stem_len Cardinality
  (key ((OR ((&bar ^B))
            ((&bar_cell B *P)
             (input P *Col)
             (&stem Col))))
    (member ((:m P))
      (&bar_cell B *P)
      (input P *Col)
      (&stem Col))
    (domain ()
      (&bar B))))

(DET &cap
  (&foot_ink *Col_line *Col)
  (&cap_line (:C Col_line)))

;; How tall each bar's cap stands.
(INIT &cap_len Cardinality
  (key ((OR ((&bar ^B))
            ((&bar_cell B *P)
             (input P *Col)
             (&cap Col))))
    (member ((:m P))
      (&bar_cell B *P)
      (input P *Col)
      (&cap Col))
    (domain ()
      (&bar B))))

(RULE &cast_cell
  (&ruler (:Col *Key))
  (&bar_cell *P))

(INIT &tallest Order
  (member ((:t N))
    (&cap_len.size *N))
  (score ((:t N) (:S N))
    (&cap_len.size *N)))

(RULE &cap_height
  (&tallest.maximal (:t *N)))

(ALTS $choice "every cap is drawn to one height; which height" $Tallest
  (ALT $Common
    (INIT &common_count Cardinality
      (key ((&cap_len.size (:key *B) ^N))
        (member ((:m B))
          (&cap_len.size (:key *B) N))))

    (INIT &common Order
      (member ((:t M))
        (&common_count.size (:key (:N *M))))
      (score ((:t M) (:S N))
        (&common_count.size (:key (:N *M)) *N)))

    (RULE &cap_height
      (&common.maximal (:t *N)))))

(RULE &output
  ;; Off the cap line stands the cap.
  (OR ((&cap_line (:C *Col_line))
       (&cast_ray (:Key Col_line) *P *K)
       (&cast_cell (:Key Col_line) P)
       (&cap_height *N)
       (OR ((< K N)
            (&cap *Col))
           ((>= K N)
            (&bg (:C Col)))))
      ;; Off the stem line hangs the bar's own stem.
      ((&stem_line (:C *Col_line2))
       (&cast_ray (:Key Col_line2) P (:K *K2) (:Origin *Src))
       (&cast_cell (:Key Col_line2) P)
       (&bar_of (:P Src) *B)
       (&stem_len.size (:key B) (:N *N2))
       (OR ((< K2 N2)
            (&stem Col))
           ((>= K2 N2)
            (&rest (:C Col)))))
      ;; A line the ruler's ink fills carries no bar, and keeps its cells.
      ((input P Col)
       (&bar_of P (:B *B2))
       (NOT (&bar (:B B2))))))
