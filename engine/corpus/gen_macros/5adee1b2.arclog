;; 5adee1b2

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; The edge the legend stands on.
(DET &legend_dir DirDomain)

(RULE &legend_entry
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&legend_dir *D)
  (margin (:B P) D (:K 0))
  (opposite D (:Opp *D2))
  (step_offset (:D D2) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *P_border))
  (input (:P P_border) (:Col *Col_border)))

(RULE &border_color
  (&legend_entry *Col *Col_border))

(RULE &shapes_node
  (input *P (:Col *Key))
  (&border_color (:Col Key))
  (NOT (&legend_entry P))
  (NOT (&legend_entry (:P_border P))))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(RULE &outside_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &shape_cell
  (&shapes_component *P (:Id *S)))

(INIT &bbox BoundingBox
  (key ((&shape_cell ^S *P))
    (cell (P)
      (&shape_cell S *P))))

(RULE &grown_box
  (&bbox.box (:key *S) *B)
  (input (:P *P2))
  (ALL ((&bbox.box (:key (:S *Sm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (OR ((dir8_elem *D)
       (step_offset D (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C *P))
       (input P))
      ((= P P2))))

(RULE &outside_node
  (&shape_cell (:S *Key))
  (input *P)
  (NOT (&shape_cell (:S Key) P)))

;; What the shape leaves open to the grid edge.
(INIT &outside Propagation
  (key ((OR ((&outside_node (:Key ^S) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&outside_node (:Key S) P))
            ((&outside_node (:Key S) P)
             (&outside_steps (:Delta *S2))
             (compose (:A P) (:B S2) (:C *Q))
             (&outside_node (:Key S) (:P Q)))))
    (source ((:n P))
      (&outside_node (:Key S) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&outside_node (:Key S) P))
    (edge ((:a P) (:b Q))
      (&outside_node (:Key S) *P)
      (&outside_steps (:Delta *S2))
      (compose (:A P) (:B S2) (:C *Q))
      (&outside_node (:Key S) (:P Q)))))

(RULE &painted
  (&grown_box *S *P)
  (input P (:Col *Col_in))
  (&bg (:C Col_in))
  (&outside.reached (:key S) (:n P))
  (&shapes_component (:Key *Col_s) (:Id S))
  (&border_color (:Col Col_s) (:Col_border *Col)))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
