;; 8b28cd80

;; The gap between neighboring input cells in the output.
(DET &gap ConstInDim)

(INIT &lattice_tiling Tiling
  (outer ((:P P_in))
    (input (:P *P_in)))
  (inner (P)
    (= *P 0))
  (gap (A G)
    (axis_elem *A)
    (&gap (:N *G))))

(RULE &lattice
  (&lattice_tiling.cell (:P_outer *P_in) (:P_inner 0) (:P *P_out)))

(INIT &frame Frame
  (extent (A N)
    (&lattice (:P_out *P))
    (axis_elem *A)
    (frame_extent P A *N)))

;; The direction the spiral's arm leaves the center, and the sense the spiral winds in from there.
(DET &arm DirDomain)

(DET &wind SenseDomain)

(RULE &seam
  (&arm *D)
  (&wind *S)
  (turn S (:D *D2) (:D2 D))
  (corner_dir (:C *Diag) (:A *A_m1) D)
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D D2)))

(RULE &seam_dir
  (&seam (:Diag *D)))

(RULE &seam_node
  (input *P))

(DET &bg DominantColor)

(RULE &center
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (&lattice P_in (:P_out *B)))

(RULE &seam_source
  (&center *B)
  (&arm *D)
  (step_offset D (:V *V_m1))
  (compose (:A B) (:B V_m1) (:C *P)))

;; The seam: the diagonal ray cast from the cell beside the center.
(INIT &seam2 Distance
  (key ((&seam_source (:P ^O))
        (&seam_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&seam_source (:P O))
           (&seam_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&seam_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&seam_node (:P Q)))
          ((&seam_source (:P O))
           (&seam_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&seam_node (:P Q))
           (= A2 O))
          ((&seam_source (:P O))
           (&seam_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&seam_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&seam_node (:P Q)))))
    (source ((:n O))
      (&seam_source (:P O))
      (&seam_dir D))))

(RULE &seam_ray2
  (&seam2.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &seam_ray
  (&seam_ray2 *P *D *K (:Origin *Src))
  (&frame.cell P))

(RULE &seam_end
  (&seam_ray2 *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&seam_ray2 (:P Q) D Origin)))

(RULE &ring_cell_uniform_outset1
  (&center (:B *C))
  (&frame.cell *P)
  (relative (:Base C) (:X P) (:X_rel *V))
  (dir_elem *D)
  (margin (:B V) D (:K *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m7))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
  (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
  (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m10))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
  (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
  (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
  (relative (:Base I_m1) (:X 0) (:X_rel *B_out_)))

;; The spacing between one ring and the next.
(DET &ring_gap TileDim)

(RULE &palette
  (OR ((&center *Col))
      ((&bg (:C Col)))))

(RULE &other
  (&palette *Col)
  (&palette (:Col *Col2))
  (!= Col Col2))

(RULE &ring_cell
  (&frame.cell *P)
  (&center (:B *C))
  (relative (:Base C) (:X P) (:X_rel *V))
  (dir_elem *D)
  (margin (:B V) D *K)
  (&ring_cell_uniform_outset1 (:K_ K) (:B_out_ *B_out))
  (compose (:A C) (:B B_out) (:C *B))
  (ALL ((&center (:B *Cm))
        (relative (:Base Cm) (:X P) (:X_rel *Vm))
        (dir_elem (:D *Dm))
        (margin (:B Vm) (:D Dm) (:K *Km))
        (axis_of (:D *D1_m2) (:A *A1_m3))
        (perp (:A A1_m3) (:A2 *A2_m4))
        (axis_of (:D *D2_m5) (:A A2_m4))
        (opposite (:D D1_m2) (:Opp *O_m8))
        (edge_inset (:D D1_m2) (:K Km) (:B *B1_m9))
        (edge_inset (:D O_m8) (:K Km) (:B *B2_m10))
        (compose (:A B1_m9) (:B B2_m10) (:C *B1_m6))
        (opposite (:D D2_m5) (:Opp *O_m11))
        (edge_inset (:D D2_m5) (:K Km) (:B *B1_m12))
        (edge_inset (:D O_m11) (:K Km) (:B *B2_m13))
        (compose (:A B1_m12) (:B B2_m13) (:C *B2_m7))
        (compose (:A B1_m6) (:B B2_m7) (:C *I_m1))
        (relative (:Base I_m1) (:X 0) (:X_rel *B_outm))
        (compose (:A Cm) (:B B_outm) (:C B))
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D *D_m1) (:K *K_m2))
  (margin B (:D D_m1) (:K K_m2))
  (&ring_gap (:D *G))
  (divide (:T K) (:Side G) (:Gap 0) (:Part *N) (:Remainder 0)))

;; The rings alternate between the two colors, out from the center's.
(INIT &alternate Walk
  (successor ((:p C1) (:p_next C2))
    (&other (:Col *C1) (:Col2 *C2)))
  (steps (N)
    (&ring_cell *N)))

(RULE &output
  (&ring_cell *N *P)
  (&center (:Col *C0))
  (&alternate.walk (:p0 C0) N (:p *C))
  (OR ((&seam_ray2 P)
       (&frame.cell P)
       (&other (:Col C) (:Col2 *Col)))
      ((NOT (&seam_ray P))
       (= Col C))))
