;; 67636eac

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; $ByColor — the cells of one color form a shape.
(INIT &by_color Quotient
  (equivalent ((:a P) (:b Q))
    (&ink *P)
    (input P *Col)
    (input (:P *Q) Col)))

(RULE &shape_cell
  (&by_color.class (:a *P) *Id))

(ALTS $g "what a shape is" $ByColor
  (ALT $Connected
    (RULE &connected_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    ;; $Connected — an 8-connected component forms a shape.
    (INIT &connected Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&connected_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &connected_component
      (&connected.class (:a *P) *Id))

    (RULE &shape_cell
      (&connected_component *P *Id))))

(ALTS $a "the layout axis" $Separate
  (ALT $Spread
    ;; $Spread — the shapes' joint bounding box is longer along the axis.
    (INIT &spread BoundingBox
      (cell (P)
        (&shape_cell *P)))

    (RULE &layout_axis
      (&spread.cell *P)
      (&spread.box *B)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *N_along))
      (perp A *A2)
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) (:N *N_across))
      (> N_along N_across)))
  (ALT $Long
    ;; $Long — the grid is longer along the axis.
    (RULE &layout_axis
      (input *P)
      (perp *A (:A2 *A2_m1))
      (frame_extent P A (:N *N_along))
      (frame_extent P (:A A2_m1) (:N *N_across))
      (> N_along N_across))))

;; Each shape's bounding box.
(INIT &bbox BoundingBox
  (key ((&shape_cell ^Id *P))
    (cell (P)
      (&shape_cell Id *P))))

(RULE &box_cell
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &box_line_split1
  (&box_cell *Id (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &box_line
  (&box_cell *Id *P)
  (axis_elem *A)
  (&box_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

;; The covered lines of each axis, packed: the blank lines between the
;; boxes are gone.
(INIT &packed Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t L))
      (&box_line A *L))
    (before ((:a L) (:b L2))
      (&box_line A *L)
      (&box_line A (:L *L2))
      (!= L L2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &packed_pos
  (&packed.rank (:key (:A *Key) *A *D) (:t *M) (:R *R1))
  (&packed.dual_rank (:key (:A Key) A D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &shared_line
  (&box_line (:Id *Id1) *A *L)
  (&box_line (:Id *Id2) A L)
  (!= Id1 Id2))

(RULE &layout_axis
  (axis_elem *A)
  (NOT (&shared_line A)))

(RULE &out_split1
  (input (:P *P_) *Col)
  (&layout_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &out_split2
  (&box_cell *P (:P_inner *P_inner_))
  (&layout_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X P_inner_) (:X_rel *P_across_)))

(RULE &output
  (&layout_axis *A)
  (input (:P *P2) *Col)
  (&box_cell (:P P2) *P_inner)
  (&out_split1 (:P_ P2) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (&packed_pos (:Key A) (:M L) (:P_pos *P_along))
  (&out_split2 (:P_inner_ P_inner) (:A_ A) (:X_m2_ *X_m2) (:P_across_ *P_across))
  (compose (:A P_along) (:B P_across) (:C *P)))
