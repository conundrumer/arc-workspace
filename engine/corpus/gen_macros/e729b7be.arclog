;; e729b7be

(RULE &crossing_dir
  (axis_elem *A)
  (axis4_of *D A))

(RULE &crossing_node
  (input *P))

(DET &line SharedColor)

(RULE &crossing_source
  (input *P *Col)
  (&line (:C Col)))

;; The crossing: the marker with line cells on both sides of it.
(INIT &crossing Distance
  (key ((&crossing_source (:P ^O))
        (&crossing_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&crossing_source (:P O))
           (&crossing_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&crossing_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&crossing_node (:P Q)))
          ((&crossing_source (:P O))
           (&crossing_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&crossing_node (:P Q))
           (= A2 O))
          ((&crossing_source (:P O))
           (&crossing_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&crossing_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&crossing_node (:P Q)))))
    (source ((:n O))
      (&crossing_source (:P O))
      (&crossing_dir D))))

(RULE &crossing_ray
  (&crossing.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &crossing_end
  (&crossing_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&crossing_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(INIT &d4m Agreement
  (key ((ex_output ^E *P *Col))
    (source ((:i P) (:v Col))
      (ex_output E *P *Col))
    (target ((:i P) (:v Col))
      (ex_output E *P *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (ex_output E *P *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(DET &sym
  (d4_elem *D)
  (NOT (&d4m.mismatch (:m D))))

(RULE &image
  (input (:P *P3) *Col)
  (NOT (&bg (:C Col)))
  (&sym *D)
  (apply D (:P P3) (:P_out *P)))

(ALTS $choice "which center the half turn is about" $Sym
  (ALT $Marker
    (DET &marker RarestColor)

    (RULE &crossing_between
      (input *P *Col)
      (&marker (:C Col))
      (axis_elem *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&crossing_ray P D)
      (&crossing_ray P (:D O)))

    ;; The transform taken about the crossing.
    (DET &transform D4Domain)

    (RULE &image
      (input (:P *P3) *Col)
      (&crossing_between (:P *C))
      (relative (:Base C) (:X P3) (:X_rel *V))
      (&transform *D)
      (apply D (:P V) (:P_out *V2))
      (compose (:A C) (:B V2) (:C *P)))))

(RULE &output
  (input *P (:Col *Col2))
  (OR ((&bg (:C Col2))
       (&image P *Col))
      ((NOT (&bg (:C Col2)))
       (= Col Col2))
      ((&bg (:C Col2))
       (NOT (&image P))
       (= Col Col2))))
