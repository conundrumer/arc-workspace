;; a2d730bd

(INPUT background "the most frequent color fills the grid, and its value differs between inputs")

(INPUT blocks "each non-background color forms one solid rectangle, at least two cells in each dimension")

(INPUT dots "every other non-background cell is a single cell (no 8-neighbor of a non-background color), and its color is the color of one block")

(INPUT aligned "each dot's row lies in its block's row span, or its column lies in its block's column span; the dot lies outside the block, at least two cells from it")

(OUTPUT connect "for each dot, let d be the cardinal direction from its same-color block to the dot, along the axis where the dot is outside the block's span"

  (INIT &ground_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  ;; The background: the commonest color.
  (INIT &ground Order
    (member ((:t Col))
      (&ground_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&ground_count.size (:key *Col) *N)))

  (RULE &pieces_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The pieces: the edge-joined parts of each non-background color.
  (INIT &pieces Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (NOT (&ground.maximal (:t Col)))
           (&pieces_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (NOT (&ground.maximal (:t Col)))
           (= P3 P)))))

  (RULE &pieces_component
    (&pieces.class (:a (:Col *Key) *P) *Id))

  (RULE &part
    (&pieces_component (:Key *Col) *P *Id))

  (INIT &box BoundingBox
    (key ((&part ^Id *P))
      (cell (P)
        (&part Id *P))))

  (RULE &hole
    (&box.box (:key *Id) *B)
    (input *P)
    (ALL ((input P)
          (&box.box (:key (:Id *Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&part Id P)))

  (RULE &joined
    (&part *Id *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&part Id (:P Q)))

  (RULE &joined_on
    (&joined *Id *P *D)
    (axis_of D *A))

  (RULE &block
    (&part *Id *Col)
    (NOT (&hole Id))
    (ALL ((&part Id *P)
          (axis_elem *A))
         ((&joined_on Id P A))))

  (RULE &single
    (&part *Id *P *Col)
    (NOT (&joined Id P)))

  (RULE &loose
    (OR ((&single *P *Col))
        ((&part *Id P Col)
         (&hole Id))))

  (RULE &beyond
    (&loose *P *Col)
    (&block *Id Col)
    (&box.box (:key Id) *B)
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (dir_elem *D)
    (margin (:B P_rel) D *K)
    (< K 0))

  (RULE &off_span
    (&beyond *P *Id *D)
    (axis_of D *A))

  (RULE &aligned
    (&beyond *P *Id *D)
    (axis_of D *A)
    (perp A *A2)
    (NOT (&off_span P Id (:A A2))))

  (RULE &face
    (&beyond *P *Id *D)
    (ALL ((&beyond P Id D *K)
          (&beyond P Id (:D *D2) (:K *K2))
          (!= D2 D))
         ((< K2 K))))

  (RULE &gap
    (&beyond *P *Id *D *K)
    (OR ((&face P Id D))
        ((NOT (&face P Id)))))

  (RULE &block_scan_cell
    (&block *Id *Col)
    (axis_elem (:A *Axis))
    (&box.box (:key Id) *B)
    (&part Id *P)
    (ALL ((&part (:Id *Idm) P)
          (&box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (corner_dir (:C *Corner) (:A *A_m1) (:D *D1_m2))
    (perp (:A A_m1) (:A2 *A2_m3))
    (corner_dir (:C Corner) (:A A2_m3) (:D *D2_m4))
    (margin (:B P) (:D D1_m2) (:K *K1_m5))
    (margin B (:D D1_m2) (:K K1_m5))
    (margin (:B P) (:D D2_m4) (:K *K2_m6))
    (margin B (:D D2_m4) (:K K2_m6)))

  ;; Each color's blocks in each scan order, each at its box's corner cell
  ;; toward the order's corner.
  (INIT &block_scan Order
    (key ((OR ((&block *Id ^Col)
               (axis_elem ^A)
               (&box.box (:key Id) *B)
               (&part Id (:P *Q))
               (ALL ((&part (:Id *Idm) (:P Q))
                     (&box.box (:key (:Id Idm)) B)
                     (dir_elem (:D *D_m1))
                     (relative (:Base B) (:X Q) (:X_rel *R_m2))
                     (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                    ((>= K_m3 0)))
               (corner_dir ^C (:A *A_m1) (:D *D1_m2))
               (perp (:A A_m1) (:A2 *A2_m3))
               (corner_dir C (:A A2_m3) (:D *D2_m4))
               (margin (:B Q) (:D D1_m2) (:K *K1_m5))
               (margin B (:D D1_m2) (:K K1_m5))
               (margin (:B Q) (:D D2_m4) (:K *K2_m6))
               (margin B (:D D2_m4) (:K K2_m6)))
              ((&block Id Col)
               (axis_elem A)
               (&box.box (:key Id) B)
               (&part Id (:P Q))
               (ALL ((&part (:Id *Idm2) (:P Q))
                     (&box.box (:key (:Id Idm2)) B)
                     (dir_elem (:D *D_m12))
                     (relative (:Base B) (:X Q) (:X_rel *R_m22))
                     (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                    ((>= K_m32 0)))
               (&block (:Id *Id2) Col)
               (&box.box (:key (:Id Id2)) (:B *B2))
               (&part (:Id Id2) (:P *Q2))
               (ALL ((&part (:Id *Id2m) (:P Q2))
                     (&box.box (:key (:Id Id2m)) (:B B2))
                     (dir_elem (:D *D_m1m))
                     (relative (:Base B2) (:X Q2) (:X_rel *R_m2m))
                     (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                    ((>= K_m3m 0)))
               (&block_scan_cell Col (:Corner C) (:Axis A))
               (ALL ((&block_scan_cell (:Col *Colm) (:Corner C) (:Axis *Am))
                     (&part (:Id *Idmm) (:P Q))
                     (&box.box (:key (:Id Idmm)) B)
                     (corner_dir C (:D *D_m1mm))
                     (margin (:B Q) (:D D_m1mm) (:K *K1_m2))
                     (margin B (:D D_m1mm) (:K *K2_m3)))
                    ((= K1_m2 K2_m3)))
               (ALL ((&block_scan_cell (:Col *Colmm) (:Corner C) (:Axis *Amm))
                     (&part (:Id *Id2mm) (:P Q2))
                     (&box.box (:key (:Id Id2mm)) (:B B2))
                     (corner_dir C (:D *D_m1mmm))
                     (margin (:B Q2) (:D D_m1mmm) (:K *K1_m2m))
                     (margin (:B B2) (:D D_m1mmm) (:K *K2_m3m)))
                    ((= K1_m2m K2_m3m)))
               (OR ((corner_dir C A *D)
                    (dir_elem D)
                    (margin (:B Q) D (:K *K1_m1))
                    (margin (:B Q2) D (:K *K2_m2))
                    (< K1_m1 K2_m2))
                   ((corner_dir C A D)
                    (perp A (:A2 A2_m3))
                    (corner_dir C (:A A2_m3) (:D *D2))
                    (margin (:B Q) D (:K *K_m4))
                    (margin (:B Q2) D (:K K_m4))
                    (dir_elem (:D D2))
                    (margin (:B Q) (:D D2) (:K K1_m5))
                    (margin (:B Q2) (:D D2) (:K K2_m6))
                    (< K1_m5 K2_m6))))))
      (member ((:t Q))
        (&block *Id Col)
        (axis_elem A)
        (&box.box (:key Id) *B)
        (&part Id (:P *Q))
        (ALL ((&part (:Id *Idm) (:P Q))
              (&box.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X Q) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (corner_dir C (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir C (:A A2_m3) (:D *D2_m4))
        (margin (:B Q) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B Q) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6)))
      (before ((:a Q) (:b Q2))
        (&block *Id Col)
        (axis_elem A)
        (&box.box (:key Id) *B)
        (&part Id (:P *Q))
        (ALL ((&part (:Id *Idm) (:P Q))
              (&box.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X Q) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (ALL ((&block_scan_cell (:Col *Colm) (:Corner C) (:Axis *Am))
              (&part (:Id *Idmm) (:P Q))
              (&box.box (:key (:Id Idmm)) B)
              (corner_dir C (:D *D_m1m))
              (margin (:B Q) (:D D_m1m) (:K *K1_m2))
              (margin B (:D D_m1m) (:K *K2_m3)))
             ((= K1_m2 K2_m3)))
        (&block (:Id *Id2) Col)
        (&box.box (:key (:Id Id2)) (:B *B2))
        (&part (:Id Id2) (:P *Q2))
        (ALL ((&part (:Id *Id2m) (:P Q2))
              (&box.box (:key (:Id Id2m)) (:B B2))
              (dir_elem (:D *D_m1mm))
              (relative (:Base B2) (:X Q2) (:X_rel *R_m2m))
              (margin (:B R_m2m) (:D D_m1mm) (:K *K_m3m)))
             ((>= K_m3m 0)))
        (ALL ((&block_scan_cell (:Col *Colmm) (:Corner C) (:Axis *Amm))
              (&part (:Id *Id2mm) (:P Q2))
              (&box.box (:key (:Id Id2mm)) (:B B2))
              (corner_dir C (:D *D_m1mmm))
              (margin (:B Q2) (:D D_m1mmm) (:K *K1_m2m))
              (margin (:B B2) (:D D_m1mmm) (:K *K2_m3m)))
             ((= K1_m2m K2_m3m)))
        (&block_scan_cell Col (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B Q) D (:K *K1_m1))
             (margin (:B Q2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B Q) D (:K *K_m4))
             (margin (:B Q2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B Q) (:D D2) (:K *K1_m5))
             (margin (:B Q2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  (RULE &dot
    (&single *P *Col))

  (RULE &own
    (&dot *P *Col)
    (&block *Id Col))

  (RULE &several
    (&own *P *Id)
    (&own P (:Id *Id2))
    (!= Id Id2))

  ;; The nearest blocks of the dot's color that it is aligned with.
  (INIT &near_aligned Order
    (key ((&several ^P))
      (member ((:t (:V Id) (:S K)))
        (&own P *Id)
        (&aligned P Id)
        (&gap P Id *K))
      (score ((:t (:V Id) (:S K)) (:S K))
        (&own P *Id)
        (&aligned P Id)
        (&gap P Id *K))))

  ;; The nearest blocks of the dot's color, when none is aligned with it.
  (INIT &near_any Order
    (key ((&several ^P))
      (member ((:t (:V Id) (:S K)))
        (&own P *Id)
        (NOT (&near_aligned.member))
        (&gap P Id *K))
      (score ((:t (:V Id) (:S K)) (:S K))
        (&own P *Id)
        (NOT (&near_aligned.member))
        (&gap P Id *K)))))

(OUTPUT foot "the cell just outside the block's side facing the dot, on the dot's line, and its two neighbors across d take the dot's color")

(OUTPUT line "every cell on the dot's line strictly between the block and the dot takes the dot's color")

(OUTPUT head "the dot's two neighbors across d and its neighbor one step further along d take the dot's color")

(OUTPUT clear "the dot's own cell becomes background")

(OUTPUT keep "every other cell keeps its input color"

  (DET &head_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &stretch
    (&beyond *P *Id *D)
    (&box.box (:key Id) *B)
    (axis_of D *A)
    (input (:P *X))
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P) (:D D_m2) (:K *K_m3))
    (margin (:B X) (:D D_m2) (:K K_m3))
    (relative (:Base B) X *X_rel)
    (margin (:B X_rel) D *K)
    (< K 0)
    (dir_elem D)
    (margin (:B P) D (:K *K1_m4))
    (margin (:B X) D (:K *K2_m5))
    (< K1_m4 K2_m5))

  (RULE &foot2
    (&stretch *P *Id *D (:X *F))
    (opposite D (:Opp *D_back))
    (step_offset (:D D_back) (:V *V_m1))
    (compose (:A F) (:B V_m1) (:C *G))
    (NOT (&stretch P Id D (:X G))))

  (DET &twin
    (&block *E *Id *Col)
    (&block E (:Id *Id2) Col)
    (!= Id Id2))

  (DET &plain
    (ex_output *E)
    (&single E *P *Col)
    (&block E *Id Col)
    (NOT (&twin E Col))
    (&aligned E P Id *D))

  (DET &chosen
    (&plain *E *P *Id *D)
    (&foot2 E P Id D *F)
    (&single E P *Col))

  (DET &across_dir
    (&chosen *E *P (:D *D3))
    (axis_of (:D D3) (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of *D (:A A2_m2)))

  (DET &inked
    (ex_input *E *P (:Col *Bg))
    (&ground.maximal E (:t Bg))
    (ex_output E P *Col)
    (!= Col Bg))

  (DET &across_node
    (&chosen *E (:P *Key_p) *D *F *Col)
    (&inked E *P Col)
    (margin (:B P) D (:K *K_m1))
    (margin (:B F) D (:K K_m1)))

  (DET &across_source
    (&chosen *E (:P *Key_p) *D *F *Col)
    (&inked E *P Col)
    (margin (:B P) D (:K *K_m1))
    (margin (:B F) D (:K K_m1)))

  ;; The foot: the inked cells of the dot's color on the foot center's line
  ;; across D, joined to the center.
  (INIT &across Distance
    (key ((&across_source (:E ^Ky_e) (:Key_p ^Ky_p) (:P ^O))
          (&across_dir (:E Ky_e) (:P Ky_p) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&across_source (:E Ky_e) (:Key_p Ky_p) (:P O))
             (&across_dir (:E Ky_e) (:P Ky_p) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&across_node (:E Ky_e) (:Key_p Ky_p) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&across_node (:E Ky_e) (:Key_p Ky_p) (:P Q)))
            ((&across_source (:E Ky_e) (:Key_p Ky_p) (:P O))
             (&across_dir (:E Ky_e) (:P Ky_p) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&across_node (:E Ky_e) (:Key_p Ky_p) (:P Q))
             (= A2 O))
            ((&across_source (:E Ky_e) (:Key_p Ky_p) (:P O))
             (&across_dir (:E Ky_e) (:P Ky_p) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&across_node (:E Ky_e) (:Key_p Ky_p) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&across_node (:E Ky_e) (:Key_p Ky_p) (:P Q)))))
      (source ((:n O))
        (&across_source (:E Ky_e) (:Key_p Ky_p) (:P O))
        (&across_dir (:E Ky_e) (:P Ky_p) D))))

  (DET &across_ray
    (&across.distance (:key (:Ky_e *E) (:Ky_p *Key_p) *D (:O *Origin)) (:n *P) *K))

  (DET &aim
    (&chosen *E *P *D))

  (DET &foot_offsets
    (&chosen *E *P *F)
    (OR ((&across_ray E (:Key_p P) (:P *X) (:K *N) (:Origin F))
         (> N 0))
        ((= X F)))
    (relative (:Base F) X (:X_rel *V)))

  (DET &head_node
    (OR ((&chosen *E (:P *Key_p) *D *Col)
         (&inked E *P Col)
         (dir_elem D)
         (margin (:B Key_p) D (:K *K1_m1))
         (margin (:B P) D (:K *K2_m2))
         (>= K1_m1 K2_m2))
        ((&chosen E (:P Key_p))
         (= P Key_p))))

  ;; The head: the inked cells of the dot's color no nearer the block than
  ;; the dot, joined to the dot.
  (INIT &head Propagation
    (key ((OR ((&chosen ^E ^P)
               (&head_node E (:Key_p P) P))
              ((&head_node E (:Key_p P) (:P *P2))
               (&head_steps (:Delta *S))
               (compose (:A P2) (:B S) (:C *Q))
               (&head_node E (:Key_p P) (:P Q)))))
      (source ((:n P))
        (&chosen E P)
        (&head_node E (:Key_p P) P))
      (edge ((:a P2) (:b Q))
        (&head_node E (:Key_p P) (:P *P2))
        (&head_steps (:Delta *S))
        (compose (:A P2) (:B S) (:C *Q))
        (&head_node E (:Key_p P) (:P Q)))))

  (DET &head_offsets
    (&head.reached (:key *E *P) (:n *X))
    (!= X P)
    (relative (:Base P) X (:X_rel *V)))

  ;; The drawing, in the frame where the dot lies toward `aim` from its block:
  ;; the foot around the first cell outside the block, and the head around
  ;; the dot.
  (RIGID_DET &draw
    (&aim *E *P *D)
    (&foot_offsets *E *P *V)
    (&head_offsets *E *P *V))

  (RULE &foot
    (&draw.aim (:Pose *G) *D)
    (&draw.foot_offsets (:Pose G) *V))

  (RULE &head2
    (&draw.aim (:Pose *G) *D)
    (&draw.head_offsets (:Pose G) *V))

  (RULE &foot_at
    (&foot *D *V))

  (RULE &head_at
    (&head2 *D *V))

  (RULE &stroke
    (&beyond *P *Id *D)
    (&loose P (:Col *Col_dot))
    (OR ((&foot2 P Id D *F)
         (&foot_at D *V)
         (compose (:A F) (:B V) (:C *X))
         (input (:P X))
         (= *Col Col_dot))
        ((&stretch P Id D X)
         (= Col Col_dot))
        ((&head_at D V)
         (compose (:A P) (:B V) (:C X))
         (input (:P X))
         (= Col Col_dot))
        ((= X P)
         (&ground.maximal (:t Col)))))

  (RULE &pick
    (&own *P *Id)
    (NOT (&several P)))

  (RULE &link
    (&pick *P *Id)
    (&aligned P Id *D))

  (RULE &draw2
    (&link *P *Id *D)
    (&stroke P Id D *X *Col)))

(ALTS $unaligned "what a dot outside both spans of its block gives" $NeedAligned
  (ALT $NearestFace
    (OUTPUT connect "d is the direction of the block's side with the smallest gap to the dot, and the foot and the line stand on the dot's row or column even when it misses the block. Undefined when two sides tie."
      (RULE &link
        (OR ((&pick *P *Id)
             (&face P Id *D))
            ((&pick P Id)
             (&aligned P Id D)))))
    (ALT $AlignedBlock
      (OUTPUT connect "the dot connects to the nearest block of its color that it is aligned with. Undefined when two tie on the gap. When none is aligned, NearestFace connects it to the block with the smallest gap, and SkipUnaligned keeps the dot."
        (RULE &any_tie
          (&near_any.maximal (:key *P) (:t (:V *Id)))
          (&near_any.maximal (:key P) (:t (:V *Id2)))
          (!= Id Id2))

        (RULE &pick
          (&near_any.maximal (:key *P) (:t (:V *Id)))
          (NOT (&any_tie P))))))
  (ALT $SkipUnaligned
    (OUTPUT unaligned "a dot outside both spans of its block keeps its input color"
      (RULE &skip
        (&pick *P *Id)
        (NOT (&aligned P Id))))
    (RULE &blank
      (OR ((&dot (:P *X))
           (NOT (&link (:P X)))
           (NOT (&skip (:P X))))
          ((&part *Id (:P X))
           (NOT (&dot (:P X)))
           (NOT (&block Id)))))
    (ALT $AlignedBlock
      (OUTPUT connect "the dot connects to the nearest block of its color that it is aligned with. Undefined when two tie on the gap. When none is aligned, NearestFace connects it to the block with the smallest gap, and SkipUnaligned keeps the dot."
        (RULE &skip
          (&several *P)
          (NOT (&near_aligned.member (:key P))))))
    (ALT $SkipOrphan
      (OUTPUT orphan "a dot with no block of its color keeps its input color"
        (RULE &skip
          (OR ((&pick *P *Id)
               (NOT (&aligned P Id)))
              ((&dot P)
               (NOT (&own P))))))
      (ALT $AlignedBlock
        (OUTPUT connect "the dot connects to the nearest block of its color that it is aligned with. Undefined when two tie on the gap. When none is aligned, NearestFace connects it to the block with the smallest gap, and SkipUnaligned keeps the dot."
          (RULE &skip
            (OR ((&pick *P *Id)
                 (NOT (&aligned P Id)))
                ((&dot P)
                 (NOT (&own P)))
                ((&several P)
                 (NOT (&near_aligned.member (:key P)))))))))))

(ALTS $orphan "what a dot with no block of its color gives" $NeedBlock
  (ALT $SkipOrphan
    (OUTPUT orphan "a dot with no block of its color keeps its input color"
      (RULE &skip
        (&dot *P)
        (NOT (&own P))))
    (RULE &blank
      (OR ((&dot (:P *X))
           (NOT (&link (:P X)))
           (NOT (&skip (:P X))))
          ((&part *Id (:P X))
           (NOT (&dot (:P X)))
           (NOT (&block Id)))))))

(ALTS $several "which block a dot connects to when its color has more than one" $SoleBlock
  (ALT $FirstBlock
    (OUTPUT connect "the dot connects to the first block of its color in the order &block_order. The output holds the grid of each open order."
      (RULE &first_block
        (&block_scan.minimal (:key *Col *C *A) (:t *Q))
        (&part *Id (:P Q)))

      (RULE &pick
        (OR ((&several *P)
             (&dot P *Col)
             (&first_block Col *C *A *Id))
            ((&own P Id)
             (NOT (&several P)))))))
  (ALT $AlignedBlock
    (OUTPUT connect "the dot connects to the nearest block of its color that it is aligned with. Undefined when two tie on the gap. When none is aligned, NearestFace connects it to the block with the smallest gap, and SkipUnaligned keeps the dot."
      (RULE &aligned_tie
        (&near_aligned.maximal (:key *P) (:t (:V *Id)))
        (&near_aligned.maximal (:key P) (:t (:V *Id2)))
        (!= Id Id2))

      (RULE &pick
        (OR ((&near_aligned.maximal (:key *P) (:t (:V *Id)))
             (NOT (&aligned_tie P)))
            ((&own P Id)
             (NOT (&several P))))))))

(ALTS $thin "which solid rectangles are blocks" $ThickBlock
  (ALT $ThinBlock
    (INPUT blocks "a solid rectangle of two or more cells is a block at any width"
      (RULE &block
        (&part *Id *P *Col)
        (&joined Id P)
        (NOT (&hole Id))))))

(ALTS $overlap "what two drawings that give one cell different colors give" $Clash
  (ALT $ScanOrder
    (OUTPUT overlap "the dots draw one at a time in the order &scan_order, and a later drawing paints over an earlier one. The output holds the grid of each open order."
      ;; The order the dots draw in: from corner C, with axis A primary. The pairs hold no clash, so every order is open.
      ;; TODO no-det-plan: &scan_order: the plan gives no verdict
      (DET &scan_order (ONE))

      (RULE &dot_scan_cell
        (&scan_order (:C *Corner) (:A *Axis))
        (&dot *P))

      ;; Each case's dots in each stored scan order.
      (INIT &dot_scan Order
        (key ((&scan_order ^C ^A)
              (&dot *P))
          (member ((:t P))
            (&scan_order C A)
            (&dot *P))
          (before ((:a P) (:b P2))
            (&scan_order C A)
            (&dot *P)
            (&dot (:P *P2))
            (&dot_scan_cell (:Corner C) (:Axis A))
            (OR ((corner_dir C A *D)
                 (dir_elem D)
                 (margin (:B P) D (:K *K1_m1))
                 (margin (:B P2) D (:K *K2_m2))
                 (< K1_m1 K2_m2))
                ((corner_dir C A D)
                 (perp A (:A2 *A2_m3))
                 (corner_dir C (:A A2_m3) (:D *D2))
                 (margin (:B P) D (:K *K_m4))
                 (margin (:B P2) D (:K K_m4))
                 (dir_elem (:D D2))
                 (margin (:B P) (:D D2) (:K *K1_m5))
                 (margin (:B P2) (:D D2) (:K *K2_m6))
                 (< K1_m5 K2_m6))))))

      (RULE &overdrawn
        (&draw2 *P *X)
        (&draw2 (:P *P2) X)
        (&dot_scan.before (:key (:C *C2) (:A *A2)) (:a P) (:b P2))))
    (RULE &painted
      (&draw2 *P *X *Col)
      (&scan_order (:C *C2) (:A *A2))
      (NOT (&overdrawn C2 A2 P X)))
    (ALTS $ragged "what a piece that is neither a solid rectangle nor a single cell gives" $NeedRect
      (ALT $CellDots
        (INPUT dots "each cell of such a piece is a dot"
          (RULE &dot
            (OR ((&loose *P *Col))
                ((&single P Col)))))))))

(ALTS $content "what a drawing does to a cell that is not background in the input" $PaintOver
  (ALT $PaintBgOnly
    (OUTPUT foot "only the foot cells that are background in the input take the dot's color"
      (RULE &draw2
        (&link *P *Id *D)
        (&stroke P Id D *X *Col)
        (OR ((input (:P X) (:Col *Bg))
             (&ground.maximal (:t Bg)))
            ((= X P)))))
    (OUTPUT line "only the line cells that are background in the input take the dot's color")
    (OUTPUT head "only the head cells that are background in the input take the dot's color")))

(DET &across_end
  (&across_ray *E *Key_p *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&across_ray E Key_p (:P Q) D Origin)))

;; The order whose first block of a color the dot connects to: from corner C, with axis A primary. The pairs hold one block of each color, so every order is open.
;; TODO no-det-plan: &block_order: the plan gives no verdict
(DET &block_order (ONE))

(RULE &blank
  (OR ((&dot (:P *X))
       (NOT (&link (:P X))))
      ((&part *Id (:P X))
       (NOT (&dot (:P X)))
       (NOT (&block Id)))))

(RULE &painted
  (&draw2 *X *Col))

;; Each cell under each run and scan order: painted, or else its input color.
(RULE &output
  (OR ((&painted (:X *P) *Col))
      ((input P Col)
       (NOT (&painted (:X P)))))
  (NOT (&blank (:X P))))
