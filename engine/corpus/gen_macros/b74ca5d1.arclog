;; b74ca5d1

(INPUT background "one color fills most of the grid, and differs from pair to pair")

(INPUT corner-markers "some of the four corner cells hold one non-background cell each, and the marked corners have distinct colors")

(INPUT shapes "each non-background color that no corner marker has draws one shape, whose cells need not be connected")

(INPUT key-cell "each shape has exactly one key, a cell of a corner marker's color that fits with the shape's cells in a box-size × box-size box, and each cell of a marker color off the corners is the key of exactly one shape"

  (INIT &bg_mode_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  ;; The extent on each axis of the box that holds a shape's cells and its key.
  (DET &box_size TileCount)

  (INIT &bg_mode Order
    (member ((:t Col))
      (&bg_mode_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&bg_mode_count.size (:key *Col) *N)))

  (RULE &background
    (&bg_mode.maximal (:t *Col)))

  (RULE &corner
    (input *P)
    (diag_dir_elem *D)
    (relative (:Base 0) (:X P) (:X_rel *R_m1))
    (axis_of (:D *D1_m2) (:A *A1_m3))
    (opposite (:D D1_m2) (:Opp *O1_m4))
    (perp (:A A1_m3) (:A2 *A2_m5))
    (axis_of (:D *D2_m6) (:A A2_m5))
    (opposite (:D D2_m6) (:Opp *O2_m7))
    (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
    (>= K1_m8 0)
    (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
    (>= K2_m9 0)
    (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
    (>= K3_m10 0)
    (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
    (>= K4_m11 0)
    (corner_dir (:C D) (:A *A_m12) (:D *D1_m13))
    (perp (:A A_m12) (:A2 *A2_m14))
    (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
    (margin (:B P) (:D D1_m13) (:K *K1_m16))
    (margin (:B 0) (:D D1_m13) (:K K1_m16))
    (margin (:B P) (:D D2_m15) (:K *K2_m17))
    (margin (:B 0) (:D D2_m15) (:K K2_m17)))

  (RULE &marker
    (&corner *D *P)
    (input P *Col)
    (NOT (&background Col)))

  (RULE &ink
    (input *P *Col)
    (NOT (&background Col))
    (NOT (&corner P)))

  (RULE &size
    (&box_size (:N *K)))

  (INIT &pair_box BoundingBox
    (key ((&ink ^P)
          (&ink (:P ^Q)))))

  (RULE &span
    (&pair_box.box (:key *P *Q) *B)
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (perp A *A2)
    (axis_elem (:A A2))
    (relative (:Base B) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) (:N *N2))
    (>= N N2))

  (RULE &key
    (&size)
    (&ink *P *Col)
    (&marker Col))

  (RULE &body
    (&size)
    (&ink *P *Col)
    (NOT (&key P)))

  (INIT &color_id Quotient
    (equivalent ((:a Col) (:b Col))
      (&ink *Col)))

  (RULE &shape
    (&body *P *Col)
    (&color_id.class (:a Col) *Id))

  (INIT &reach Order
    (key ((&shape ^Id *P)
          (&key (:P ^K))
          (&span (:P K) (:Q P) *N))
      (member ((:t N))
        (&shape Id *P)
        (&key (:P K))
        (&span (:P K) (:Q P) *N))
      (score ((:t N) (:S N))
        (&shape Id *P)
        (&key (:P K))
        (&span (:P K) (:Q P) *N))))

  (INIT &nearest Order
    (key ((&reach.minimal (:key *Id ^K) (:t *N)))
      (member ((:t (:V Id) (:S N)))
        (&reach.minimal (:key *Id K) (:t *N)))
      (score ((:t (:V Id) (:S N)) (:S N))
        (&reach.minimal (:key *Id K) (:t *N))))))

(INPUT shape-box "a shape's cells with its key span box-size on both axes"

  (INIT &color_box BoundingBox
    (key ((&ink *P ^Col)
          (NOT (&marker Col)))
      (cell (P)
        (&ink *P Col)
        (NOT (&marker Col)))))

  (INIT &widest Order
    (member ((:t N))
      (&color_box.box (:key *Col) *B)
      (&ink *P Col)
      (axis_elem *A)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N))
    (score ((:t N) (:S N))
      (&color_box.box (:key *Col) *B)
      (&ink *P Col)
      (axis_elem *A)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N))))

(OUTPUT swap-colors "in each shape, every shape cell takes the key's color, and the key cell takes the shape's color")

(OUTPUT stamp-corner "each marked corner gets the overlay of the boxes of every shape keyed with its color, the shape cells and the key cell alike, painted in the marker's color, with each box flush against that corner"

  (RULE &corner_cell
    (&marker *D)
    (&size *K)
    (input *P)
    (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
    (perp (:A A_m1) (:A2 *A2_m4))
    (corner_dir (:C D) (:A A2_m4) (:D *D2_m3))
    (margin (:B P) (:D D1_m2) (:K *K1))
    (margin (:B P) (:D D2_m3) (:K *K2))
    (< K1 K)
    (< K2 K))

  (INIT &corner_box BoundingBox
    (key ((&corner_cell ^D *P))
      (cell (P)
        (&corner_cell D *P)))))

(OUTPUT rest-kept "every other cell keeps its input color"

  (RULE &near
    (&span *P *Q *N)
    (&size *K)
    (<= N K))

  ;; The box of a shape's cells and a key.
  (INIT &bond_box BoundingBox
    (key ((&shape ^Id)
          (&key (:P ^K)))
      (cell (P)
        (OR ((&shape Id *P)
             (&key (:P K)))
            ((&shape Id)
             (&key (:P K))
             (= P K))))))

  (RULE &loose
    (&bond_box.box (:key *Id *K) (:B *Bx))
    (axis_elem *A)
    (axis_elem A)
    (relative (:Base Bx) (:X K) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (&size (:K *S))
    (> N S))

  (RULE &paired
    (&bond_box.box (:key *Id *K))
    (NOT (&loose Id K))))

(ALTS $g "which cells form one shape" $ColorClass
  (ALT $ShapeBySpread
    (INPUT shapes "a shape is the cells of one non-marker color that are linked by steps between cells that fit in one box-size × box-size box; undefined where a shape has no key or several keys"
      (INIT &spread Quotient
        (edge ((:a P) (:b Q))
          (&body *P *Col)
          (&body (:P *Q) Col)
          (&near P Q)))

      (RULE &shape
        (&body *P *Col)
        (&spread.class (:a P) *Id)))))

(ALTS $i "which cells are keys" $MarkerColor
  (ALT $KeyWithoutMarker
    (INPUT key-cell "a key is a non-background cell off the corners that fits in no box-size × box-size box with another cell of its color, whatever its color; a shape whose key color is on no corner swaps colors and stamps nowhere; undefined where a shape has no key or several keys"
      (RULE &crowded
        (&ink *P *Col)
        (&ink (:P *Q) Col)
        (!= P Q)
        (&near P Q))

      (RULE &key
        (&size)
        (&ink *P *Col)
        (NOT (&crowded P))))))

(ALTS $p "which shape a key belongs to" $KeyInBox
  (ALT $KeyByNearest
    (INPUT key-cell "a key belongs to the shape with the cell nearest to it by Chebyshev distance; undefined where two shapes tie for nearest, or a shape gets no key or several keys"
      (RULE &paired
        (&nearest.minimal (:key *K) (:t (:V *Id)))))))

(ALTS $b "where box-size comes from" $BoxSizeStored
  (ALT $BoxSizeFromShapes
    (INPUT shape-box "box-size is the largest extent on either axis of the cells of one non-marker color, read on each input alone; undefined on an input with no non-marker color off the corners"
      (RULE &size
        (&widest.maximal (:t *K))))))

(ALTS $a "where a keyed box lies in its corner" $StampFlush
  (ALT $StampAlignCenter
    (OUTPUT stamp-corner "each keyed box is centered in the box-size × box-size box at its corner; undefined where a box's extent and box-size differ in parity")
    (RULE &place
      (&paired *Id *K)
      (&key (:P K) *Col)
      (&marker *D Col)
      (&bond_box.box (:key Id K) (:B *Bx))
      (input (:P *Pc))
      (ALL ((&bond_box.box (:key (:Id *Idm) (:K *Km)) (:B Bx))
            (dir_elem (:D *D_m1))
            (relative (:Base Bx) (:X Pc) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((&marker D (:Col *Colm))
            (&bond_box.box (:key (:Id *Idmm) (:K *Kmm)) (:B Bx))
            (corner_dir (:C D) (:D *D_m1m))
            (margin (:B Pc) (:D D_m1m) (:K *K1_m2))
            (margin (:B Bx) (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3)))
      (&corner_cell D (:P *Q))
      (relative (:Base Pc) (:X Q) (:X_rel *V))
      (&corner_box.box (:key D) (:B *C))
      (compose (:A Bx) (:B V) (:C *Bx2))
      (relative (:Base C) (:X Bx2) (:X_rel *R))
      (ALL ((&corner_box.box (:key (:D *Dm)) (:B *Cm))
            (&bond_box.box (:key (:Id *Idmmm) (:K *Kmmm)) (:B *Bxm))
            (input (:P *Pcm))
            (&corner_cell (:D Dm) (:P *Qm))
            (relative (:Base Pcm) (:X Qm) (:X_rel *Vm))
            (compose (:A Bxm) (:B Vm) (:C *Bx2m))
            (relative (:Base Cm) (:X Bx2m) (:X_rel R))
            (opposite (:D *D_m1mm) (:Opp *O_m2))
            (margin (:B R) (:D D_m1mm) (:K *K1_m3))
            (margin (:B R) (:D O_m2) (:K *K2_m4)))
           ((= K1_m3 K2_m4))))))

(ALTS $m "what becomes of the corner box outside the stamp" $MarkerKept
  (ALT $MarkerCleared
    (OUTPUT rest-kept "the box-size × box-size box at each marked corner turns background before the stamp is painted"
      (RULE &cleared
        (&corner_cell *P)))
    (RULE &output
      (&size)
      (NOT (&broken))
      (NOT (&unplaced))
      (input *P (:Col *Col0))
      (OR ((&stamp (:Q P) *Col))
          ((&cleared P)
           (NOT (&stamp (:Q P)))
           (&background Col))
          ((&swapped (:Q P) Col)
           (NOT (&stamp (:Q P)))
           (NOT (&cleared P)))
          ((NOT (&stamp (:Q P)))
           (NOT (&cleared P))
           (NOT (&swapped (:Q P)))
           (= Col Col0))))))

(RULE &broken
  (OR ((&key (:P *K))
       (NOT (&paired K)))
      ((&paired *Id (:K *K3))
       (&paired (:Id *Id2) (:K K3))
       (!= Id Id2))
      ((&shape (:Id *Id3))
       (NOT (&paired (:Id Id3))))
      ((&paired (:Id *Id4) (:K *K4))
       (&paired (:Id Id4) (:K *K2))
       (!= K4 K2))))

(RULE &swapped
  (OR ((&paired *Id *K)
       (&shape Id (:P *Q))
       (&key (:P K) *Col))
      ((&paired (:Id *Id2) (:K Q))
       (&shape (:Id Id2) Col))))

(RULE &place
  (&paired *Id *K)
  (&key (:P K) *Col)
  (&marker *D Col)
  (&bond_box.box (:key Id K) (:B *Bx))
  (input (:P *Pc))
  (ALL ((&bond_box.box (:key (:Id *Idm) (:K *Km)) (:B Bx))
        (dir_elem (:D *D_m1))
        (relative (:Base Bx) (:X Pc) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((&marker D (:Col *Colm))
        (&bond_box.box (:key (:Id *Idmm) (:K *Kmm)) (:B Bx))
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B Pc) (:D D_m1m) (:K *K1_m2))
        (margin (:B Bx) (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (input (:P *Q))
  (relative (:Base 0) (:X Q) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (corner_dir (:C D) (:A *A_m12) (:D *D1_m13))
  (perp (:A A_m12) (:A2 *A2_m14))
  (corner_dir (:C D) (:A A2_m14) (:D *D2_m15))
  (margin (:B Q) (:D D1_m13) (:K *K1_m16))
  (margin (:B 0) (:D D1_m13) (:K K1_m16))
  (margin (:B Q) (:D D2_m15) (:K *K2_m17))
  (margin (:B 0) (:D D2_m15) (:K K2_m17))
  (relative (:Base Pc) (:X Q) (:X_rel *V)))

(RULE &unplaced
  (&paired *Id *K)
  (&key (:P K) *Col)
  (&marker Col)
  (NOT (&place Id K)))

(RULE &stamp
  (&place *Id *K *V)
  (&key (:P K) *Col)
  (OR ((&shape Id (:P *Q3)))
      ((= Q3 K)))
  (compose (:A Q3) (:B V) (:C *Q)))

(RULE &output
  (&size)
  (NOT (&broken))
  (NOT (&unplaced))
  (input *P (:Col *Col0))
  (OR ((&stamp (:Q P) *Col))
      ((&swapped (:Q P) Col)
       (NOT (&stamp (:Q P))))
      ((NOT (&stamp (:Q P)))
       (NOT (&swapped (:Q P)))
       (= Col Col0))))
