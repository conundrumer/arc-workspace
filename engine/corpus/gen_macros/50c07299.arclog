;; 50c07299

;; The direction the segment runs and travels.
(DET &dir DiagDirDomain)

(RULE &line_dir
  (&dir *D))

(RULE &line_node
  (input *P))

(DET &ink ChangedColor)

(RULE &mark
  (input *P *Col)
  (&ink (:C Col)))

(RULE &beyond
  (&mark (:P *P2))
  (ALL ((&mark (:P *Qm))
        (&dir (:D *Dm))
        (diag_dir_elem (:D Dm))
        (corner_dist (:P Qm) (:Diag Dm) (:K *K1_m1))
        (corner_dist (:P P2) (:Diag Dm) (:K *K2_m2)))
       ((>= K1_m1 K2_m2)))
  (&dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

(RULE &line_source
  (&beyond *P))

(INIT &line Distance
  (key ((&line_source (:P ^O))
        (&line_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&line_source (:P O))
           (&line_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&line_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&line_node (:P Q)))
          ((&line_source (:P O))
           (&line_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&line_node (:P Q))
           (= A2 O))
          ((&line_source (:P O))
           (&line_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&line_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&line_node (:P Q)))))
    (source ((:n O))
      (&line_source (:P O))
      (&line_dir D))))

(RULE &line_ray
  (&line.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &line_end
  (&line_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&line_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(RULE &grown
  (OR ((&mark *P))
      ((&beyond P))))

(RULE &drawn
  (&beyond (:P *B))
  (&grown (:P *P2))
  (relative (:Base P2) (:X B) (:X_rel *V))
  (compose (:A B) (:B V) (:C *P)))

(ALTS $choice "what fixes the new segment" $Turn
  (ALT $Count
    (INIT &size Cardinality
      (member ((:m P))
        (&mark *P)))

    (RULE &drawn
      (&line_ray *P *K)
      (&size.size *N)
      (<= K N))))

(RULE &output
  (OR ((&drawn *P)
       (&ink (:C *Col)))
      ((input P)
       (NOT (&drawn P))
       (&bg (:C Col)))))
