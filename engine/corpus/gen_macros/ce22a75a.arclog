;; ce22a75a

(INIT &decomp_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(DET &tile_count TileCount)

(RULE &decomp_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &decomp_division_parts
  (axis_elem *A)
  (&tile_count *N))

(RULE &decomp_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_count *N)
       (&decomp_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tile_count (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (NOT (&decomp_division_parts A))
       (&decomp_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &decomp_division_tile
  (&decomp_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&decomp_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(DET &out_fill AnyOutNewColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &decomp
  (&decomp_division_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $choice "every mark sits at the center of its arrangement tile, so three locate priors coincide on the data" $Tile
  (ALT $Tile
    (ALTS $d "the grid is 9×9, so its arrangement reads two ways" $Count
      (ALT $Size
        (DET &tile_dim TileCount)
        (RULE &decomp_division2_axis_split1
          (input (:P *P_grid_))
          (axis_elem (:A *A_))
          (axis_of (:D *D_m1) (:A A_))
          (opposite (:D D_m1) (:Opp *O_m2))
          (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
          (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
          (opposite (:D D_m1) (:Opp *O_m1))
          (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
          (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
          (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
          (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))
        (RULE &decomp_division2_side
          (axis_elem *A)
          (&tile_dim (:N *K)))
        (RULE &decomp_division2_axis
          (OR ((input *P)
               (axis_elem *A)
               (&tile_dim (:N *K))
               (axis_of *D A)
               (opposite D (:Opp *O))
               (margin (:B P) D (:K *T))
               (margin (:B P) (:D O) (:K *T2))
               (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
               (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
               (opposite D (:Opp *O_m1))
               (edge_inset D (:K I) (:B *B1_m2))
               (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
               (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
               (opposite D (:Opp *O_m4))
               (edge_inset D (:K R) (:B *B1_m5))
               (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
               (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
               (frame_extent (:P P_inner) A (:N K)))
              ((input P)
               (axis_elem A)
               (NOT (&decomp_division2_side A))
               (&decomp_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
               (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
        (RULE &decomp_division2_tile
          (&decomp_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
          (perp (:A A1) *A2)
          (&decomp_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
          (compose (:A Po1) (:B Po2) (:C *P_outer))
          (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
        (RULE &decomp
          (&decomp_division2_tile *P (:P_outer *P_tile) (:P_inner *P_intile))))))
  (ALT $Center
    (RULE &center_tile
      (&mark (:P *P_grid))
      (&decomp (:P P_grid) *P_tile *P_intile)
      (ALL ((&decomp (:P *P_gridm) (:P_tile *P_tilem) P_intile)
            (opposite (:D *D_m1) (:Opp *O_m2))
            (margin (:B P_intile) (:D D_m1) (:K *K1_m3))
            (margin (:B P_intile) (:D O_m2) (:K *K2_m4)))
           ((= K1_m3 K2_m4))))

    (RULE &output
      (&decomp *P *P_tile)
      (IF ((&center_tile P_tile))
          ((&out_fill (:C *Col)))
          ((&bg (:C Col))))))
  (ALT $Grow
    (RULE &grown
      (OR ((&mark *P))
          ((&mark (:P *M))
           (dir8_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A M) (:B V_m1) (:C P))
           (input P))))

    (RULE &output
      (OR ((&grown *P)
           (&out_fill (:C *Col)))
          ((input P)
           (NOT (&grown P))
           (&bg (:C Col)))))))

(RULE &mark_tile
  (&mark (:P *P_grid))
  (&decomp (:P P_grid) *P_tile))

(RULE &output
  (&decomp *P *P_tile)
  (IF ((&mark_tile P_tile))
      ((&out_fill (:C *Col)))
      ((&bg (:C Col)))))
