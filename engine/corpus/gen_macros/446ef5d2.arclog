;; 446ef5d2

(RULE &pieces_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(INIT &ink_size Cardinality
  (key ((input *P ^Col)
        (NOT (&bg Col)))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg Col)))))

;; The picture sits on a field and is drawn in the rest: the field is the
;; commonest ink, and the mark is the rarest.
(INIT &by_size Order
  (member ((:t (:V Col) (:S N)))
    (&ink_size.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&ink_size.size (:key *Col) *N)))

(RULE &mark
  (&by_size.minimal (:t (:V *Col))))

(INIT &pieces Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg Col))
         (NOT (&mark Col))
         (&pieces_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:Col Col2)))
         (NOT (&mark (:Col Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:Col Col3)))
         (NOT (&mark (:Col Col3)))
         (= P3 P)))))

(RULE &pieces_component
  (&pieces.class (:a *P) *Id))

(INIT &piece_area Cardinality
  (member ((:m P))
    (&pieces_component *P)))

(INIT &pbox BoundingBox
  (key ((&pieces_component *P ^Id))
    (cell (P)
      (&pieces_component *P Id))))

(RULE &piece_cell
  (&pieces_component *P *Id)
  (input P *Col))

(RULE &anchor
  (&piece_cell *Id *P)
  (&pbox.box (:key Id) *B)
  (ALL ((&piece_cell (:Id *Idm) P)
        (&pbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (step_offset (:D *Diag) (:V *V_m1))
  (ALL ((&piece_cell (:Id *Idmm) P)
        (input (:P *Qm) (:Col *Colm))
        (step_offset (:D Diag) (:V *V_m1m))
        (compose (:A P) (:B V_m1m) (:C Qm))
        (&pbox.box (:key (:Id Idmm)) B)
        (corner_dir (:C Diag) (:D *D_m1m))
        (margin (:B P) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (&mark Col))

;; A box the marked corner cell spans with a far cell, sitting at that corner
;; of the bbox.
(INIT &bbox BoundingBox
  (key ((input (:P ^Q))))
  (cell ((:P A))
    (&anchor (:P *A))))

(RULE &span
  (&anchor *Diag (:P *A))
  (&bbox.cell (:key *Q) (:P A))
  (&bbox.box (:key Q) *B)
  (ALL ((&anchor (:Diag *Diagm) (:P A))
        (&bbox.box (:key (:Q *Qm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X A) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((&bbox.box (:key (:Q *Qmm)) B)
        (corner_dir (:C Diag) (:D *D_m1m))
        (margin (:B A) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

(RULE &span_cell
  (&span *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(INIT &span_size Cardinality
  (key ((&span_cell ^B *P))
    (member ((:m P))
      (&span_cell B *P))))

(RULE &rect
  (&span_size.size (:key *B) *N)
  (&piece_area.size N))

(RULE &rect_cell
  (&rect *B)
  (&span_cell B *P))

(RULE &shape
  (&piece_cell *Id *P *Col)
  (&pbox.box (:key Id) *B)
  (ALL ((&piece_cell (:Id *Idm) P (:Col *Colm))
        (&pbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &occ Occurrences
  (key ((OR ((&rect_cell ^B *P)
             (&pieces_component ^Id))
            ((&rect B)
             (&shape Id *P_inner))))
    (cell (P)
      (&rect_cell B *P)
      (&pieces_component Id))
    (shape ((:P P_inner))
      (&rect B)
      (&shape Id *P_inner))))

(RULE &place
  (&occ.occurrence (:key *B *Id) (:P *B_occ))
  (&shape Id *P_inner *Col)
  (compose (:A B_occ) (:B P_inner) (:C *P)))

(RULE &spills_inside1
  (&place (:B *B_) *Id *B_occ (:P *P_) *Col)
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &drawn
  (&ink_size.size (:key *Col))
  (NOT (&by_size.maximal (:t (:V Col))))
  (NOT (&mark Col)))

(INIT &rim Boundary
  (key ((&pieces_component *P ^Id))
    (cell (P)
      (&pieces_component *P Id))))

(RULE &shape_rim
  (&shape *Id *P_inner *Col)
  (&pbox.box (:key Id) *B)
  (compose (:A B) (:B P_inner) (:C *P))
  (&rim.exposed (:key Id) P *D)
  (dir_elem D))

(RULE &inked_face
  (&shape_rim *Id *D *Col)
  (&drawn Col))

(RULE &fit
  (&place *B *Id *B_occ)
  (ALL ((&place B Id B_occ *P *Col)
        (margin (:B P) (:D *D_m1) (:K *K_m2))
        (margin B (:D D_m1) (:K K_m2))
        (&drawn Col))
       ((&spills_inside1 (:P_ P) (:B_ B))))
  (OR ((NOT (&anchor Id)))
      ((&pbox.box (:key Id) (:B B_occ)))))

(RULE &covers
  (&fit *B *Id (:B_occ *Cd_b))
  (&place B Id (:B_occ Cd_b) *P *Col))

(RULE &edge
  (&fit *B *Id (:B_occ *Cd_b))
  (&shape_rim Id *P_inner *D *Col)
  (compose (:A Cd_b) (:B P_inner) (:C *P))
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&rect_cell B (:P Q)))

(RULE &demand
  (&edge *B *Id *Cd_b *Q))

(RULE &face
  (&edge *B *Id *Cd_b *P *D *Q *Col)
  (&inked_face Id D))

(RULE &clash
  (OR ((&covers *B (:Id *Cd_id) *Cd_b *P)
       (&covers B (:Id *Cd2_id) (:Cd_b *Cd2_b) P)
       (OR ((!= Cd_b Cd2_b))
           ((!= Cd_id Cd2_id))))
      ((&fit B (:Id Cd_id) (:B_occ Cd_b))
       (&fit B (:Id Cd_id) (:B_occ Cd2_b))
       (!= Cd_b Cd2_b)
       (= Cd2_id Cd_id))
      ((&face B (:Id Cd_id) Cd_b (:P *P2) *D *Q *Col)
       (opposite D (:Opp *D2))
       (&face B (:Id Cd2_id) (:Cd_b Cd2_b) (:P Q) (:D D2) (:Q P2) (:Col *Col2))
       (!= Col Col2))))

(RULE &mate
  (&demand *B *Id *Cd_b *Q)
  (&covers B (:Id *Cd2_id) (:Cd_b *Cd2_b) (:P Q))
  (NOT (&clash B (:Cd_id Id) Cd_b Cd2_id Cd2_b)))

(RULE &cand
  (&fit *B *Id (:B_occ *Cd_b))
  (ALL ((&demand B (:Id *Cd_id) Cd_b *Q))
       ((&mate B (:Id Cd_id) Cd_b Q))))

(RULE &forcing_item
  (&cand *B *Id *Cd_b)
  (&covers B Id Cd_b *P))

(CHOOSE &forcing
  (for ((&forcing_item ^B ^P))
    (from (&forcing_item B P *Id *Cd_b)))
  (never
    (&forcing_item *B *Id *Cd_b)
    (&forcing_item B (:Id *Id2) (:Cd_b *Cd_b2))
    (&clash B (:Cd_id Id) Cd_b (:Cd2_id Id2) (:Cd2_b Cd_b2)))
  (never
    (&forcing_item *B *P *Id *Cd_b)
    (&forcing_item B (:P *P2) (:Id *Id2) (:Cd_b *Cd_b2))
    (&forcing_item B (:P P2) Id Cd_b)
    (OR ((!= Id Id2))
        ((!= Cd_b Cd_b2)))))

(RULE &painted
  (&forcing *B *Id *Cd_b)
  (&covers B Id Cd_b *P *Col))

(RULE &output
  (&rect *B)
  (ALL ((&rect_cell B (:P *Pm)))
       ((&painted B (:P Pm))))
  (input *P)
  (OR ((&painted B P *Col))
      ((NOT (&rect_cell B P))
       (&bg Col))))
