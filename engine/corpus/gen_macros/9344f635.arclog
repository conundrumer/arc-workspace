;; 9344f635

(DET &bg DominantColor)

;; the axis whose filled lines cover the other axis's
(DET &over AxisDomain)

(RULE &segment
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (step_offset *D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) Col)
  (axis_of D *A))

(RULE &line_col
  (input *P)
  (&segment (:P *Q) *A *Col)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &shown
  (&over *A)
  (perp A *A2)
  (OR ((&line_col *P A *Col))
      ((&line_col P (:A A2) Col)
       (NOT (&line_col P A)))))

(RULE &output
  (input *P)
  (OR ((&shown P *Col))
      ((NOT (&shown P))
       (&bg (:C Col)))))
