;; 75b8110e

(INIT &tile_ink_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (ex_input (:P *P_grid))))

(DET &tiles DivisorRatio)

(DET &tile_ink_division_axis_split1
  (ex_input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &tile_ink_division_parts
  (axis_elem *A)
  (&tiles (:K *N)))

(DET &tile_ink_division_axis
  (OR ((ex_input *P)
       (axis_elem *A)
       (&tiles (:K *N))
       (&tile_ink_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input P)
       (axis_elem A)
       (&tiles (:K *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((ex_input P)
       (axis_elem A)
       (NOT (&tile_ink_division_parts A))
       (&tile_ink_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &tile_ink_division_tile
  (&tile_ink_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_ink_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &tile_cell_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_cell_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_cell_division_parts
  (axis_elem *A)
  (&tiles (:K *N)))

(RULE &tile_cell_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tiles (:K *N))
       (&tile_cell_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tiles (:K *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_cell_division_parts A))
       (&tile_cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_cell_division_tile
  (&tile_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(RULE &tile_cell
  (input (:P *P_grid) *Col)
  (&tile_cell_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &tile_ink
  (ex_input *E (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&tile_ink_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P)))

(DET &beats
  (&tile_ink *E *P_tile *P *Col)
  (&tile_ink E (:P_tile *P_tile2) P (:Col *Col2))
  (!= Col Col2)
  (ex_output E P Col))

;; The tiles each tile beats, directly or through others: a tile pair
;; need not overlap directly.
(INIT &beaten Propagation
  (key ((OR ((&beats (:P_tile ^T) (:P_tile2 *T2)))
            ((&beats (:P_tile T))
             (&beats (:P_tile T2) (:P_tile2 *T3)))))
    (source ((:n T2))
      (&beats (:P_tile T) (:P_tile2 *T2)))
    (edge ((:a T2) (:b T3))
      (&beats (:P_tile T))
      (&beats (:P_tile *T2) (:P_tile2 *T3)))))

(INIT &order Order
  (member ((:t T))
    (&tile_ink (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&beaten.reached (:key *T) (:n *T2))))

(DET &prio
  (&order.rank (:t *P) *R))

(ALTS $choice "whether precedence ranks tiles or inks" $Order
  (ALT $Ink
    (DET &ink_rank
      (&tile_ink (:P_tile *T) (:Col *C))
      (&prio (:P T) *R))

    ;; The foremost ink at each cell, per division.
    (INIT &front_ink Order
      (key ((&ink_at ^P *Col)
            (&ink_rank (:C Col) *R))
        (member ((:t (:V Col) (:S R)))
          (&ink_at P *Col)
          (&ink_rank (:C Col) *R))
        (score ((:t (:V Col) (:S R)) (:S R))
          (&ink_at P *Col)
          (&ink_rank (:C Col) *R))))

    (RULE &output
      (OR ((&front_ink.minimal (:key *P) (:t (:V *Col))))
          ((&tile_cell (:P_intile P))
           (NOT (&ink_at P))
           (&bg (:C Col)))))
    (ALTS $d "how the grid divides into tiles" $Count
      (ALT $Size
        (DET &tile_dim
          (ex_output *P)
          (axis_elem *A)
          (frame_extent P A (:N *K)))
        (RULE &tile_cell_division2_axis_split1
          (input (:P *P_grid_))
          (axis_elem (:A *A_))
          (axis_of (:D *D_m1) (:A A_))
          (opposite (:D D_m1) (:Opp *O_m2))
          (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
          (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
          (opposite (:D D_m1) (:Opp *O_m1))
          (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
          (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
          (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
          (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))
        (RULE &tile_cell_division2_side
          (axis_elem *A)
          (&tile_dim *K))
        (RULE &tile_cell_division2_axis
          (OR ((input *P)
               (axis_elem *A)
               (&tile_dim *K)
               (axis_of *D A)
               (opposite D (:Opp *O))
               (margin (:B P) D (:K *T))
               (margin (:B P) (:D O) (:K *T2))
               (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
               (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
               (opposite D (:Opp *O_m1))
               (edge_inset D (:K I) (:B *B1_m2))
               (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
               (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
               (opposite D (:Opp *O_m4))
               (edge_inset D (:K R) (:B *B1_m5))
               (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
               (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
               (frame_extent (:P P_inner) A (:N K)))
              ((input P)
               (axis_elem A)
               (NOT (&tile_cell_division2_side A))
               (&tile_cell_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
               (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
        (RULE &tile_cell_division2_tile
          (&tile_cell_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
          (perp (:A A1) *A2)
          (&tile_cell_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
          (compose (:A Po1) (:B Po2) (:C *P_outer))
          (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
        (RULE &tile_cell
          (input (:P *P_grid) *Col)
          (&tile_cell_division2_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))))

(RULE &tile_ink2
  (&tile_cell *P_tile (:P_intile *P) *Col)
  (NOT (&bg (:C Col))))

(RULE &ink_at
  (&tile_ink2 *P *Col))

;; The foremost tile inking each cell.
(INIT &front_tile Order
  (key ((&tile_ink2 (:P_tile *T) ^P)
        (&prio (:P T) *R))
    (member ((:t (:V T) (:S R)))
      (&tile_ink2 (:P_tile *T) P)
      (&prio (:P T) *R))
    (score ((:t (:V T) (:S R)) (:S R))
      (&tile_ink2 (:P_tile *T) P)
      (&prio (:P T) *R))))

(RULE &output
  (OR ((&tile_cell (:P_intile *P))
       (NOT (&ink_at P))
       (&bg (:C *Col)))
      ((&front_tile.minimal (:key P) (:t (:V *T)))
       (&tile_ink2 (:P_tile T) P Col))))
