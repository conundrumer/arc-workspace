;; b7999b51

(INPUT distinct-extents "no two colors have the same extent on the axis of &anchor"

  ;; The edge every bar starts from.
  (DET &anchor DirDomain))

(OUTPUT extent-per-color "each color other than &background has an extent, the count of lines on the axis of &anchor that its cells span"

  (DET_OR_RULE &background DominantColor))

(OUTPUT bar-per-color "the output has one line across that axis per color, and that line holds the color's bar: the color fills its first extent cells from &anchor, and &background fills the rest")

(OUTPUT bars-ordered-by-extent "the bars stand in order of extent, the longest at &order_edge and each next one shorter"

  (RULE &axis
    (&anchor *D)
    (axis_of D *A))

  ;; The bounding box of each color's cells.
  (INIT &color_box BoundingBox
    (key ((input *P ^Col)
          (NOT (&background (:C Col))))
      (cell (P)
        (input *P Col)
        (NOT (&background (:C Col))))))

  (RULE &extent
    (&color_box.box (:key *Col) *B)
    (input *P Col)
    (&axis *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N))

  ;; The edge the longest bar stands at.
  (DET &order_edge DirDomain)

  ;; The colors in order of extent, longest first.
  (INIT &order Order
    (member ((:t Col))
      (&extent *Col))
    (before ((:a C1) (:b C2))
      (&extent (:Col *C1) (:N *N1))
      (&extent (:Col *C2) (:N *N2))
      (> N1 N2))))

(OUTPUT output-size "the output's extent on that axis is the longest bar's extent, and its extent across that axis is the count of colors"

  (INIT &bar_count Cardinality
    (member ((:m Col))
      (&extent *Col)))

  (INIT &longest Order
    (member ((:t N))
      (&extent *N))
    (score ((:t N) (:S N))
      (&extent *N)))

  (INIT &chart Frame
    (extent (A N)
      (OR ((&axis *A)
           (&longest.maximal (:t *N)))
          ((&axis (:A *A3))
           (perp (:A A3) (:A2 A))
           (&bar_count.size N)))))

  (RULE &slot_of_split1
    (&chart.cell (:P *P_))
    (&axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X P_) (:X_rel *P_slot_)))

  (RULE &slot_of
    (&chart.cell *P)
    (&axis *A)
    (&slot_of_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_slot_ *P_slot))))

(ALTS $choice "how bars of one extent are ordered" $TieUndefined
  (ALT $TieByPlace
    (OUTPUT bars-ordered-by-extent "the bars stand in order of extent, the longest at &order_edge; bars of one extent stand in order of their colors' distance from &order_edge, then from &anchor, and the model is undefined where both distances tie"
      ;; The colors in order of extent, longest first.
      (INIT &order Order
        (member ((:t Col))
          (&extent *Col))
        (before ((:a C1) (:b C2))
          (OR ((&extent (:Col *C1) (:N *N1))
               (&extent (:Col *C2) (:N *N2))
               (> N1 N2))
              ((&extent (:Col C1) *N)
               (&extent (:Col C2) N)
               (&order_edge (:D *O))
               (&color_box.box (:key (:Col C1)) (:B *B1))
               (&color_box.box (:key (:Col C2)) (:B *B2))
               (margin (:B B1) (:D O) (:K *K1))
               (margin (:B B2) (:D O) (:K *K2))
               (OR ((< K1 K2))
                   ((= K1 K2)
                    (&anchor *D)
                    (margin (:B B1) D (:K *J1))
                    (margin (:B B2) D (:K *J2))
                    (< J1 J2)))))))))
  (ALT $TieBothOrders
    (OUTPUT bars-ordered-by-extent "the bars stand in order of extent, the longest at &order_edge, and the output holds each order of the bars of one extent")
    ;; A bar line holds each color that has no more longer colors than lines
    ;; before it, and no more shorter colors than lines after it.
    (RULE &ties
      (&slot_of (:P_slot *S))
      (&order_edge (:D *O))
      (opposite (:D O) (:Opp *O2))
      (margin (:B S) (:D O) (:K *K1))
      (&order.rank (:t *X) (:R *R1))
      (<= R1 K1)
      (margin (:B S) (:D O2) (:K *K2))
      (&order.dual_rank (:t X) (:R *R2))
      (<= R2 K2)
      (ONE S)
      (ONE X))))

;; The color each bar line holds, under each resolution of a tie.
;; A bar line holds the color whose rank is its distance from the order edge.
;; Where two colors share a rank, a line holds none, and the output is not
;; total.
(RULE &ties
  (&slot_of (:P_slot *S))
  (&order_edge (:D *O))
  (margin (:B S) (:D O) (:K *R))
  (&order.rank (:t *X) R)
  (ONE S)
  (ONE X))

(RULE &output
  (&slot_of *P *P_slot)
  (&ties (:S P_slot) (:X *C))
  (&extent (:Col C) *N)
  (&anchor *D)
  (margin (:B P) D *K)
  (OR ((>= K N)
       (&background (:C *Col)))
      ((< K N)
       (= Col C))))
