;; 9edfc990

(OUTPUT spread "a walk starts at a &ink cell and steps to cardinally adjacent &bg cells; every &bg cell it reaches takes &ink"

  (RULE &flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET_OR_RULE &bg DominantColor)

  (DET &ink UnchangedColor)

  ;; The node set holds the ink as well as the field, since a seed must be a node.
  (INIT &flood Propagation
    (source ((:n P))
      (input *P *Col)
      (&ink (:C Col))
      (input P (:Col *Col2))
      (OR ((&bg (:C Col2)))
          ((&ink (:C Col2)))))
    (edge ((:a P) (:b P2))
      (input *P *Col)
      (OR ((&bg (:C Col)))
          ((&ink (:C Col))))
      (&flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (input (:P P2) (:Col *Col2))
      (OR ((&bg (:C Col2)))
          ((&ink (:C Col2)))))))

(OUTPUT keep "every other cell keeps its color")

(RULE &output
  (OR ((&flood.reached (:n *P))
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&flood.reached (:n P))))))
