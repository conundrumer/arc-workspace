;; 4e34c42c

(RULE &frags_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The field is the color that covers most of the grid.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(INIT &frags Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg Col))
         (&frags_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:Col Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:Col Col3)))
         (= P3 P)))))

(RULE &frags_component
  (&frags.class (:a *P) *Id))

(INIT &bbox BoundingBox
  (key ((&frags_component *P (:Id ^K)))
    (cell (P)
      (&frags_component *P (:Id K)))))

(RULE &content
  (input *P *Col)
  (&bbox.box (:key *K) *B)
  (ALL ((input P (:Col *Colm))
        (&bbox.box (:key (:K *Km)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &item_split1
  (&content *K (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

(RULE &motif
  (&content *K *P *Col)
  (NOT (&bg Col)))

(INIT &occ Occurrences
  (key ((OR ((&motif (:K ^K1) ^Col *P)
             (&motif (:K ^K2) Col)
             (!= K1 K2))
            ((&motif (:K K2) Col P)
             (&motif (:K K1) Col)
             (!= K1 K2))))
    (cell (P)
      (&motif (:K K1) Col *P)
      (&motif (:K K2) Col)
      (!= K1 K2))
    (shape (P)
      (&motif (:K K2) Col *P)
      (&motif (:K K1) Col)
      (!= K1 K2))))

(RULE &fitted
  (&occ.occurrence (:key (:K1 *K) (:K2 *K_other)) (:P *V_occ))
  (OR ((= *K1 K_other)
       (= *K2 K)
       (relative (:Base V_occ) (:X 0) (:X_rel *V)))
      ((= K1 K)
       (= K2 K_other)
       (= V V_occ))))

(INIT &seam_cell Singleton
  (key ((&fitted ^K1 ^K2 ^V))
    (member ((:v P))
      (&motif (:K K2) *Col (:P *P2))
      (compose (:A P2) (:B V) (:C *P))
      (&motif (:K K1) Col P))))

(RULE &join
  (&seam_cell.plural (:key *K1 *K2 *V))
  (ALL ((&content (:K K2) (:P *P2) (:Col *Col2))
        (compose (:A P2) (:B V) (:C *P1))
        (&content (:K K1) (:P P1) (:Col *Col1)))
       ((= Col1 Col2))))

(INIT &span Cardinality
  (key ((axis_elem ^A))
    (member ((:m K P_along))
      (&content *K *P)
      (&item_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1)))))

(RULE &room
  (&bbox.box (:key (:K *Base)) (:B *B_base))
  (&span.size (:key (:A *A_v)) (:N *N_v))
  (axis_of (:D *D_v) (:A A_v))
  (opposite (:D D_v) (:Opp *O_m2))
  (edge_inset (:D D_v) (:K N_v) (:B *B1_m3))
  (edge_inset (:D O_m2) (:K N_v) (:B *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *I_m1))
  (relative (:Base I_m1) (:X 0) (:X_rel *B_v))
  (perp (:A A_v) (:A2 *A_h))
  (&span.size (:key (:A A_h)) (:N *N_h))
  (axis_of (:D *D_h) (:A A_h))
  (opposite (:D D_h) (:Opp *O_m6))
  (edge_inset (:D D_h) (:K N_h) (:B *B1_m7))
  (edge_inset (:D O_m6) (:K N_h) (:B *B2_m8))
  (compose (:A B1_m7) (:B B2_m8) (:C *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B_h))
  (compose (:A B_v) (:B B_h) (:C *B_grow))
  (compose (:A B_base) (:B B_grow) (:C *B)))

(INIT &room_frame Frame
  (key ((&room ^Base *B)
        (input *P)
        (axis_elem *A)
        (axis_elem A)
        (relative (:Base B) (:X P) (:X_rel *R_m1))
        (frame_extent (:P R_m1) A *N))
    (extent (A N)
      (&room Base *B)
      (input *P)
      (axis_elem *A)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N))))

(RULE &roomy
  (&room *Base (:B *B_room))
  (&room_frame.cell (:key Base) (:P *Q_rel))
  (compose (:A B_room) (:B Q_rel) (:C *Q))
  (&bbox.box (:key *K) (:B *B_k))
  (&content K (:P *P0))
  (ALL ((&content (:K *Km) (:P P0))
        (&bbox.box (:key (:K Km)) (:B B_k))
        (dir_elem (:D *D_m1))
        (relative (:Base B_k) (:X P0) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1_m3))
  (perp (:A A_m2) (:A2 *A2_m4))
  (corner_dir (:C Diag_m1) (:A A2_m4) (:D *D2_m5))
  (margin (:B P0) (:D D1_m3) (:K *K1_m6))
  (margin (:B B_k) (:D D1_m3) (:K K1_m6))
  (margin (:B P0) (:D D2_m5) (:K *K2_m7))
  (margin (:B B_k) (:D D2_m5) (:K K2_m7))
  (relative (:Base P0) (:X Q) (:X_rel *V))
  (compose (:A B_k) (:B V) (:C *B_placed))
  (ALL ((&bbox.box (:key (:K *Kmm)) (:B *B_km))
        (&content (:K Kmm) (:P *P0m))
        (&room (:Base *Basem) (:B B_room))
        (&room_frame.cell (:key (:Base Basem)) (:P *Q_relm))
        (compose (:A B_room) (:B Q_relm) (:C *Qm))
        (relative (:Base P0m) (:X Qm) (:X_rel *Vm))
        (compose (:A B_km) (:B Vm) (:C B_placed))
        (dir_elem (:D *D_m1m))
        (relative (:Base B_room) (:X B_placed) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
       ((>= K_m3m 0))))

(INIT &layout Propagation
  (key ((OR ((&bbox.box (:key (:K ^Base))))
            ((&roomy Base (:K *K1) (:V *V1))
             (&join K1 *K2 (:V *V2))
             (compose (:A V1) (:B V2) (:C *V))
             (&roomy Base (:K K2) V))))
    (source ((:n (:K Base) V))
      (&bbox.box (:key (:K Base)))
      (= *V 0))
    (edge ((:a (:K K1) (:V V1)) (:b (:K K2) V))
      (&roomy Base (:K *K1) (:V *V1))
      (&join K1 *K2 (:V *V2))
      (compose (:A V1) (:B V2) (:C *V))
      (&roomy Base (:K K2) V))))

(RULE &scene
  (&layout.reached (:key *Base) (:n *K *V))
  (&content K (:P *P0) *Col)
  (compose (:A P0) (:B V) (:C *P)))

;; The scene's box. Every fragment box hugs its own ink, so the cells the
;; fragments cover reach as far as the scene's ink does.
(INIT &view BoundingBox
  (key ((&scene ^Base *P))
    (cell (P)
      (&scene Base *P))))

;; The output sheet is that box as a frame of its own.
(INIT &sheet Frame
  (key ((&view.cell (:key ^Base) *P)
        (&view.box (:key Base) *B)
        (axis_elem *A)
        (relative (:Base B) (:X P) (:X_rel *R_m1))
        (frame_extent (:P R_m1) A *N))
    (extent (A N)
      (&view.cell *P)
      (&view.box *B)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N))))

(RULE &paint
  (&scene *Base *P *Col)
  (&view.box (:key Base) *B)
  (ALL ((&scene (:Base *Basem) P (:Col *Colm))
        (&view.box (:key (:Base Basem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &output
  (&sheet.cell (:key *Base) *P)
  (OR ((&paint Base (:P_inner P) *Col))
      ((NOT (&paint Base (:P_inner P)))
       (&bg Col))))
