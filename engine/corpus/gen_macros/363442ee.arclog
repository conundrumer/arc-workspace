;; 363442ee

(DET &divider SharedColor)

(DET &key_side DirDomain)

(RULE &panels_divider_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &panels_divider
  (input *P *Col)
  (&divider (:C Col))
  (&key_side *D)
  (axis_of D *A)
  (&panels_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The panels the divider cuts.
(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(DET &bg DominantColor)

(DET &mark ChangedColor)

(RULE &key_ink
  (&key_side *D)
  (&panels_part_idx *P D (:N 0))
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &canvas
  (&key_side *D)
  (opposite D (:Opp *S))
  (&panels_part_idx *P (:D S) (:N 0)))

(INIT &key BoundingBox
  (cell (P)
    (&key_ink *P)))

(RULE &key_cell
  (&key.box *B)
  (&key_ink *P *Col)
  (ALL ((&key_ink P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &mark2
  (&canvas *P)
  (input P *Col)
  (&mark (:C Col)))

(RULE &paint
  (&mark2 (:P *M))
  (&key_cell (:P_intile *Ctr))
  (ALL ((opposite (:D *D_m1) (:Opp *O_m2))
        (margin (:B Ctr) (:D D_m1) (:K *K1_m3))
        (margin (:B Ctr) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4)))
  (&key_cell *P_intile *Col)
  (relative (:Base Ctr) (:X P_intile) (:X_rel *V))
  (compose (:A M) (:B V) (:C *P)))

(ALTS $choice "where a copy of the key lands over a mark" $Center
  (ALT $Tile
    (INIT &canvas_box BoundingBox
      (cell (P)
        (&canvas *P)))

    (RULE &canvas_cell
      (&canvas_box.box *B)
      (&canvas (:P *P_grid))
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_grid) (:X_rel *P_canvas)))

    (RULE &tiles_axis_split1
      (&canvas_cell (:P_canvas *P_canvas_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_canvas_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_canvas_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_canvas_) (:X_rel *X_m1_)))

    (RULE &tiles_side
      (&key.box *B)
      (&key.cell *P)
      (axis_elem *A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N *K)))

    (RULE &tiles_axis
      (OR ((&canvas_cell (:P_canvas *P))
           (&key.box *B)
           (&key.cell (:P *P2))
           (axis_elem *A)
           (relative (:Base B) (:X P2) (:X_rel *R_m1))
           (frame_extent (:P R_m1) A *N)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side N) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side N) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m2))
           (edge_inset D (:K I) (:B *B1_m3))
           (edge_inset (:D O_m2) (:K I2) (:B *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *P_outer))
           (opposite D (:Opp *O_m5))
           (edge_inset D (:K R) (:B *B1_m6))
           (edge_inset (:D O_m5) (:K R2) (:B *B2_m7))
           (compose (:A B1_m6) (:B B2_m7) (:C *P_inner))
           (frame_extent (:P P_inner) A N))
          ((&canvas_cell (:P_canvas P))
           (axis_elem A)
           (NOT (&tiles_side A))
           (&tiles_axis_split1 (:P_canvas_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &tiles_tile
      (&tiles_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tiles_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile_of
      (&canvas_cell *P_grid *P_canvas)
      (&tiles_tile (:P P_canvas) (:P_outer *P_tile) (:P_inner *P_intile)))

    (RULE &paint
      (&mark2 (:P *M))
      (&tile_of (:P_grid M) *P_tile)
      (&key_cell *P_intile *Col)
      (&tile_of (:P_grid *P) P_tile P_intile))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
