;; 8f3a5a89

(RULE &region_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &barrier_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &barrier_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &wall UnchangedColor)

(RULE &barrier_cell
  (input *P *Col)
  (&wall (:C Col)))

(RULE &barrier_flood_node
  (input *P *Col)
  (&wall (:C Col)))

(DET &bg DominantColor)

(DET &start RarestColor)

(DET &paint AnyOutNewColor)

(INIT &region Propagation
  (source ((:n P))
    (input *P *Col)
    (&start (:C Col))
    (input P (:Col *Col2))
    (NOT (&wall (:C Col2))))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (NOT (&wall (:C Col)))
    (&region_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (NOT (&wall (:C Col2)))))

(ALTS $choice "what the outside is" $Walls
  (ALT $Beyond
    (RULE &barrier_cell
      (input *P)
      (NOT (&region.reached (:n P))))

    (RULE &barrier_flood_node
      (input *P)
      (NOT (&region.reached (:n P))))))

(INIT &barrier_flood Propagation
  (source ((:n P))
    (&barrier_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (&barrier_flood_node P))
  (edge ((:a P) (:b Q))
    (&barrier_flood_node *P)
    (&barrier_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *Q))
    (&barrier_flood_node (:P Q))))

(RULE &barrier_node
  (&barrier_cell *P)
  (NOT (&barrier_flood.reached (:n P))))

;; The candidate outside cells. Those closed off from the grid edge are
;; obstacles inside the region.
(INIT &barrier Quotient
  (edge ((:a P) (:b P2))
    (OR ((&barrier_node *P)
         (&barrier_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&barrier_node (:P P2)))
        ((&barrier_node P)
         (= P2 P)))))

(RULE &barrier_component
  (&barrier.class (:a *P) *Id))

;; The inside: the grid minus the outside.
(INIT &within Boundary
  (cell (P)
    (input *P)
    (OR ((NOT (&barrier_cell P)))
        ((&barrier_component P))))
  (dir (D)
    (dir8_elem *D)))

(RULE &painted
  (&within.boundary *P)
  (&region.reached (:n P))
  (input P *Col)
  (&bg (:C Col)))

(RULE &output
  (OR ((&painted *P)
       (&paint (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
