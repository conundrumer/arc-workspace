;; 342ae2ed

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &blocks_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &blocks Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&blocks_node (:Key *Ky) *P)
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&blocks_node (:Key Ky) (:P P2)))
        ((&blocks_node (:Key Ky) P)
         (= P2 P)))))

(RULE &blocks_component
  (&blocks.class (:a *Key *P) *Id))

(RULE &shot_dir
  (diag_dir_elem *D))

(RULE &shot_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &shot_node
  (input *P)
  (NOT (&shot_blocked P)))

(INIT &bbox BoundingBox
  (key ((&blocks_component (:Key ^Col) *P ^Id))
    (cell (P)
      (&blocks_component (:Key Col) *P Id))))

(RULE &shot_source
  (&bbox.cell (:key (:Col *Blk_col) (:Id *Blk_id)) *P)
  (&bbox.box (:key (:Col Blk_col) (:Id Blk_id)) *B)
  (ALL ((&bbox.cell (:key (:Col *Blkm_col) (:Id *Blkm_id)) P)
        (&bbox.box (:key (:Col Blkm_col) (:Id Blkm_id)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1_m3))
  (perp (:A A_m2) (:A2 *A2_m4))
  (corner_dir (:C Diag_m1) (:A A2_m4) (:D *D2_m5))
  (margin (:B P) (:D D1_m3) (:K *K1_m6))
  (margin B (:D D1_m3) (:K K1_m6))
  (margin (:B P) (:D D2_m5) (:K *K2_m7))
  (margin B (:D D2_m5) (:K K2_m7)))

;; The corners shoot along the diagonals: the field carries a shot, a figure
;; stops one.
(INIT &shot Distance
  (key ((&shot_source (:P ^O))
        (&shot_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&shot_source (:P O))
           (&shot_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&shot_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&shot_node (:P Q)))
          ((&shot_source (:P O))
           (&shot_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&shot_node (:P Q))
           (= A2 O))
          ((&shot_source (:P O))
           (&shot_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&shot_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&shot_node (:P Q)))))
    (source ((:n O))
      (&shot_source (:P O))
      (&shot_dir D))))

(RULE &shot_ray
  (&shot.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &shot_end
  (&shot_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&shot_ray (:P Q) D Origin)))

(RULE &shot_full_dir
  (diag_dir_elem *D))

(RULE &shot_full_node
  (input *P))

(RULE &shot_full_source
  (&bbox.cell (:key (:Col *Blk_col) (:Id *Blk_id)) *P)
  (&bbox.box (:key (:Col Blk_col) (:Id Blk_id)) *B)
  (ALL ((&bbox.cell (:key (:Col *Blkm_col) (:Id *Blkm_id)) P)
        (&bbox.box (:key (:Col Blkm_col) (:Id Blkm_id)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1_m3))
  (perp (:A A_m2) (:A2 *A2_m4))
  (corner_dir (:C Diag_m1) (:A A2_m4) (:D *D2_m5))
  (margin (:B P) (:D D1_m3) (:K *K1_m6))
  (margin B (:D D1_m3) (:K K1_m6))
  (margin (:B P) (:D D2_m5) (:K *K2_m7))
  (margin B (:D D2_m5) (:K K2_m7)))

(INIT &shot_full Distance
  (key ((&shot_full_source (:P ^O))
        (&shot_full_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&shot_full_source (:P O))
           (&shot_full_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&shot_full_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&shot_full_node (:P Q)))
          ((&shot_full_source (:P O))
           (&shot_full_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&shot_full_node (:P Q))
           (= A2 O))
          ((&shot_full_source (:P O))
           (&shot_full_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&shot_full_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&shot_full_node (:P Q)))))
    (source ((:n O))
      (&shot_full_source (:P O))
      (&shot_full_dir D))))

(RULE &shot_full_ray
  (&shot_full.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &shot_full_end
  (&shot_full_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&shot_full_ray (:P Q) D Origin)))

(RULE &shot_cell
  (input *P *Col)
  (&bg (:C Col)))

(RULE &link
  (diag_opposite *D (:Opp *D_opp))
  (&bbox.cell (:key *Col (:Id *Id1)) (:P *P_from))
  (&bbox.box (:key Col (:Id Id1)) (:B *B1))
  (ALL ((&bbox.cell (:key (:Col *Colm) (:Id *Id1m)) (:P P_from))
        (&bbox.box (:key (:Col Colm) (:Id Id1m)) (:B B1))
        (dir_elem (:D *D_m1))
        (relative (:Base B1) (:X P_from) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((diag_opposite D (:Opp *D_oppm))
        (&bbox.cell (:key (:Col *Colmm) (:Id *Id1mm)) (:P P_from))
        (&bbox.box (:key (:Col Colmm) (:Id Id1mm)) (:B B1))
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B P_from) (:D D_m1m) (:K *K1_m2))
        (margin (:B B1) (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (&bbox.cell (:key Col (:Id *Id2)) (:P *P2))
  (&bbox.box (:key Col (:Id Id2)) (:B *B2))
  (ALL ((&bbox.cell (:key (:Col *Colmmm) (:Id *Id2m)) (:P P2))
        (&bbox.box (:key (:Col Colmmm) (:Id Id2m)) (:B B2))
        (dir_elem (:D *D_m1mm))
        (relative (:Base B2) (:X P2) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1mm) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (ALL ((diag_opposite (:D *Dm) (:Opp D_opp))
        (&bbox.cell (:key (:Col *Colmmmm) (:Id *Id2mm)) (:P P2))
        (&bbox.box (:key (:Col Colmmmm) (:Id Id2mm)) (:B B2))
        (corner_dir (:C D_opp) (:D *D_m1mmm))
        (margin (:B P2) (:D D_m1mmm) (:K *K1_m2m))
        (margin (:B B2) (:D D_m1mmm) (:K *K2_m3m)))
       ((= K1_m2m K2_m3m)))
  (!= Id1 Id2)
  (&shot_full_ray (:P P2) D *K (:Origin P_from)))

(RULE &paint
  (&link *Col *D (:P_from *P1))
  (&shot_ray *P D (:Origin P1))
  (&shot_cell P))

(ALTS $choice "how far the paint reaches between a pair's facing corners" $Cast
  (ALT $Span
    (RULE &paint
      (&link *Col *D (:P_from *P1) (:K *K_end))
      (&shot_full_ray *P D *K (:Origin P1))
      (&shot_cell P)
      (< K K_end))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
