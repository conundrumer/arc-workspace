;; 6b9890af

(DET &bg DominantColor)

(DET &frame SharedColor)

(RULE &frame_col
  (&frame (:C *Col)))

(ALTS $choice "how the frame color is found" $Stored
  (ALT $Drawn
    (INIT &drect Outlines
      (key ((input *P ^Col)
            (NOT (&bg (:C Col))))
        (node (P)
          (input *P Col)
          (NOT (&bg (:C Col))))))

    (RULE &frame_col
      (&drect.box (:key *Col)))))

(RULE &object_cell
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&frame_col Col)))

(INIT &object_box BoundingBox
  (cell (P)
    (&object_cell *P)))

(RULE &blocks_dim
  (&object_box.cell *P)
  (&object_box.box *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(INIT &frame_box BoundingBox
  (cell (P)
    (&frame_col *Col)
    (input *P Col)))

;; The cells the frame's edge lines enclose.
(INIT &hole BoundingBox
  (cell (P)
    (&frame_box.box *B)
    (input *P)
    (ALL ((&frame_box.box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0)))))

(RULE &blocks_cell
  (&blocks_dim)
  (&hole.cell (:P *P2))
  (&hole.box *B)
  (ALL ((&hole.cell (:P P2))
        (&hole.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

;; The hole divided into the object's block arrangement.
(INIT &blocks_sides ExtentDivisions
  (frame (P)
    (&blocks_cell *P)))

(RULE &blocks_axis_split1
  (&blocks_cell (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &blocks_axis
  (OR ((&blocks_cell *P)
       (&blocks_dim *A *N)
       (&blocks_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&blocks_cell P)
       (&blocks_dim A (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&blocks_cell P)
       (axis_elem A)
       (NOT (&blocks_dim A))
       (&blocks_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &blocks_tile
  (&blocks_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&blocks_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile_col
  (&object_cell (:P *P_grid) *Col)
  (&object_box.box *B)
  (ALL ((&object_cell (:P P_grid) (:Col *Colm))
        (&object_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P_tile)))

(RULE &output
  (&frame_box.box *B)
  (input (:P *P_grid))
  (ALL ((&frame_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P))
  (OR ((relative (:Base B) (:X P_grid) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (>= K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (>= K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (>= K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (>= K4_m11 0)
       (margin (:B P_grid) (:D *D_m12) (:K *K_m13))
       (margin B (:D D_m12) (:K K_m13))
       (&frame_col *Col))
      ((&hole.box (:B *B_hole))
       (relative (:Base B_hole) (:X P_grid) (:X_rel *R_m14))
       (axis_of (:D *D1_m15) (:A *A1_m16))
       (opposite (:D D1_m15) (:Opp *O1_m17))
       (perp (:A A1_m16) (:A2 *A2_m18))
       (axis_of (:D *D2_m19) (:A A2_m18))
       (opposite (:D D2_m19) (:Opp *O2_m20))
       (margin (:B R_m14) (:D D1_m15) (:K *K1_m21))
       (>= K1_m21 0)
       (margin (:B R_m14) (:D O1_m17) (:K *K2_m22))
       (>= K2_m22 0)
       (margin (:B R_m14) (:D D2_m19) (:K *K3_m23))
       (>= K3_m23 0)
       (margin (:B R_m14) (:D O2_m20) (:K *K4_m24))
       (>= K4_m24 0)
       (relative (:Base B_hole) (:X P_grid) (:X_rel *P_hole))
       (&blocks_tile (:P P_hole) (:P_outer *P_tile))
       (OR ((&tile_col P_tile Col))
           ((NOT (&tile_col P_tile))
            (&bg (:C Col)))))))
