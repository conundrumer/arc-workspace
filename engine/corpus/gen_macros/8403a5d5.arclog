;; 8403a5d5

(DET &dir DirDomain)

(DET &bg DominantColor)

(DET &mark
  (ex_input *E *P *Col)
  (NOT (&bg (:C Col))))

(DET &trail_dir
  (&mark (:E *Key))
  (&dir *D))

(DET &trail_dir_ray
  (&trail_dir *Key *D))

(DET &trail_node
  (&trail_dir *Key)
  (ex_input (:E Key) *P))

(DET &trail_source
  (&mark (:E *Key) *P))

;; The cast from the marker toward the trail direction.
(INIT &trail Distance
  (key ((&trail_source (:Key ^Ky) (:P ^O))
        (&trail_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&trail_source (:Key Ky) (:P O))
           (&trail_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&trail_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&trail_node (:Key Ky) (:P Q)))
          ((&trail_source (:Key Ky) (:P O))
           (&trail_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&trail_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&trail_source (:Key Ky) (:P O))
           (&trail_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&trail_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&trail_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&trail_source (:Key Ky) (:P O))
      (&trail_dir_ray (:Key Ky) D))))

(DET &trail_ray
  (&trail.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(DET &trail_end
  (&trail_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&trail_ray Key (:P Q) D Origin)))

(RULE &trail_dir2
  (&dir *D))

(RULE &trail_node2
  (input *P))

(RULE &marker
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &trail_source2
  (&marker *P))

;; The trail: the cells from the marker toward &dir.
(INIT &trail2 Distance
  (key ((&trail_source2 (:P ^O))
        (&trail_dir2 ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&trail_source2 (:P O))
           (&trail_dir2 D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&trail_node2 (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&trail_node2 (:P Q)))
          ((&trail_source2 (:P O))
           (&trail_dir2 D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&trail_node2 (:P Q))
           (= A2 O))
          ((&trail_source2 (:P O))
           (&trail_dir2 D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&trail_node2 (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&trail_node2 (:P Q)))))
    (source ((:n O))
      (&trail_source2 (:P O))
      (&trail_dir2 D))))

(RULE &trail_ray2
  (&trail2.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &trail_end2
  (&trail_ray2 *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&trail_ray2 (:P Q) D Origin)))

(DET &dot AnyOutNewColor)

(RULE &bar_axis
  (&dir *D)
  (axis_of D (:A *A0))
  (perp (:A A0) (:A2 *A)))

(RULE &side
  (&dir (:D *D2))
  (turn *S (:D D2) (:D2 *D)))

;; The lines one step of the walk crosses: a bar line and the gap line after it.
(DET &step_lines SepThickness)

(DET &first_side SenseDomain)

(RULE &first_edge
  (&first_side *S)
  (&side S *D))

(RULE &bar_line
  (input *P)
  (&bar_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (input (:P *Q))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &first_edge2
  (&first_edge (:D *E1)))

(RULE &walk_line
  (&trail_ray2 *P (:K *I))
  (&step_lines (:G *N))
  (divide (:T I) (:Side N) (:Gap 0) (:Part *M) (:Remainder *J)))

;; The end the gap's dot sits at flips at each step.
(INIT &flip Walk
  (successor ((:p E) (:p_next E2))
    (&side (:D *E))
    (opposite (:D E) (:Opp *E2)))
  (steps ((:N M))
    (&walk_line *M)))

(RULE &lit
  (&walk_line (:P *P2) (:J 0))
  (&bar_line (:P P2) (:Q *P)))

(ALTS $choice "how the alternating trail is produced" $Walk
  (ALT $Walk
    (ALTS $f "the first dot's side" $Stored
      (ALT $Away
        (RULE &first_edge2
          (&marker *P)
          (dir_elem (:D *E0))
          (margin (:B P) (:D E0) (:K 0))
          (&bar_axis *A)
          (axis_of (:D E0) A)
          (opposite (:D E0) (:Opp *E1))))))
  (ALT $Banner
    (DET &trail_cell
      (ex_input (:E *Key) *P))

    (DET &step_cell
      (&trail_ray (:Key *E) (:P *P2) (:K *I))
      (&trail_cell (:Key E) (:P P2))
      (&bar_axis *A)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P2) (:D D_m2) (:K *K_m3))
      (ex_output E *P *Col)
      (margin (:B P) (:D D_m2) (:K K_m3)))

    (DET &dot_step
      (&step_cell *E *I (:P *Q) (:Col *Dot))
      (&dot (:C Dot))
      (&side *S (:D *Ed))
      (margin (:B Q) (:D Ed) (:K 0)))

    ;; The trail's shifts along its axis.
    (INIT &si Periods
      (key ((&step_cell ^E (:P *Q) *Col))
        (cell ((:P Q) (:v Col))
          (&step_cell E (:P *Q) *Col))))

    (DET &si_cell
      (&step_cell (:E *Key) *P (:Col *V)))

    (DET &trail_axis
      (&dir *D)
      (axis_of D *A))

    (DET &broken
      (&si_cell (:Key *Ky) *P)
      (axis_of (:D *D_m2) *A)
      (sub_extent P A *K)
      (dir8_opposite (:D D_m2) (:D2 *O_m3))
      (edge_inset (:D O_m3) K (:B *B1_m4))
      (edge_inset (:D D_m2) K (:B *I_m6))
      (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
      (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
      (NOT (&si.period (:key (:E Ky)) A K))
      (&trail_axis A))

    ;; The shortest witnessed shift no trail breaks.
    (INIT &unbroken Order
      (member ((:t K))
        (&si_cell (:Key *Ky) *P)
        (axis_of (:D *D_m1) *A)
        (sub_extent P A *K)
        (dir8_opposite (:D D_m1) (:D2 *O_m2))
        (edge_inset (:D O_m2) K (:B *B1_m3))
        (edge_inset (:D D_m1) K (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
        (compose (:A B1_m3) (:B B2_m4) (:C *V))
        (compose (:A P) (:B V) (:C *Q))
        (&si_cell (:Key Ky) (:P Q))
        (&trail_axis A)
        (NOT (&broken K)))
      (score ((:t K) (:S K))
        (&si_cell (:Key *Ky) *P)
        (axis_of (:D *D_m1) *A)
        (sub_extent P A *K)
        (dir8_opposite (:D D_m1) (:D2 *O_m2))
        (edge_inset (:D O_m2) K (:B *B1_m3))
        (edge_inset (:D D_m1) K (:B *I_m5))
        (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
        (compose (:A B1_m3) (:B B2_m4) (:C *V))
        (compose (:A P) (:B V) (:C *Q))
        (&si_cell (:Key Ky) (:P Q))
        (&trail_axis A)
        (NOT (&broken K))))

    (DET &period
      (&unbroken.minimal (:t *N)))

    (DET &dot_slot
      (&dot_step *I *S)
      (&period *N)
      (divide (:T I) (:Side N) (:Gap 0) (:Remainder *K)))

    (RULE &dot_edge
      (&dot_slot *K *S)
      (&side S *D))

    (DET &slot
      (&step_cell (:I *K))
      (&period *N)
      (< K N))

    (INIT &slots Order
      (member ((:t K))
        (&slot *K))
      (score ((:t K) (:S K))
        (&slot *K)))

    ;; The slot cycle, advanced once per step along the trail.
    (INIT &slot_walk Walk
      (successor ((:p K) (:p_next K2))
        (&slots.cyclic_successor (:a *K) (:b *K2)))
      (steps ((:N I))
        (&trail_ray2 (:K *I))))

    (RULE &slot_at
      (&trail_ray2 *P (:K *I))
      (&slot_walk.walk (:p0 0) (:N I) (:p *K)))

    (DET &bar_step
      (&step_cell *E *I *Col)
      (&mark E Col))

    (DET &bar_slot
      (&bar_step *I)
      (&period *N)
      (divide (:T I) (:Side N) (:Gap 0) (:Remainder *K)))

    (RULE &lit
      (&slot_at (:P *P2) *K)
      (&bar_slot K)
      (&bar_line (:P P2) (:Q *P)))

    (RULE &dotted
      (&slot_at (:P *P2) *K)
      (&dot_edge K (:D *E))
      (&bar_line (:P P2) (:Q *P))
      (margin (:B P) (:D E) (:K 0))))
  (ALT $Stamp
    (DET &template_bar
      (&mark *E *P *Col)
      (ex_output E (:P *Q) Col)
      (relative (:Base P) (:X Q) (:X_rel *Delta)))

    ;; Each template offset seated on the marker, on-grid.
    (RULE &lit
      (&marker (:P *P2))
      (&template_bar *Delta)
      (compose (:A P2) (:B Delta) (:C *P))
      (input P))

    (DET &template_dot
      (&mark *E *P)
      (ex_output E (:P *Q) (:Col *Dot))
      (&dot (:C Dot))
      (relative (:Base P) (:X Q) (:X_rel *Delta)))

    (RULE &dotted
      (&marker (:P *P2))
      (&template_dot *Delta)
      (compose (:A P2) (:B Delta) (:C *P))
      (input P))))

(RULE &dotted
  (&walk_line (:P *P2) *M *J)
  (!= J 0)
  (&first_edge2 (:E1 *E0))
  (&flip.walk (:p0 E0) (:N M) (:p *E))
  (&bar_line (:P P2) (:Q *P))
  (margin (:B P) (:D E) (:K 0)))

(RULE &output
  (OR ((&lit *P)
       (&marker *Col))
      ((&dotted P)
       (&dot (:C Col)))
      ((input P)
       (NOT (&lit P))
       (NOT (&dotted P))
       (&bg (:C Col)))))
