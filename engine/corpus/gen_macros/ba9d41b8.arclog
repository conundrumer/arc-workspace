;; ba9d41b8

(INPUT solid-rectangles "the input holds one or more filled rectangles, each of one color other than `background`, each at least 3 by 3, and no two of them touch"

  (DET &hole
    (ex_input *E *P (:Col *C_in))
    (ex_output E P *Col)
    (!= Col C_in))

  (DET_OR_RULE &background DominantColor
    (&hole (:Col *C)))

  (RULE &any4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &same8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &any8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (INIT &same8 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&same8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (INIT &any4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&any4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P)))))

  (INIT &any8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&ink *P)
           (&any8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3)))
          ((&ink P)
           (= P3 P))))))

(OUTPUT outline-kept "each cell on a rectangle's outline keeps its color")

(OUTPUT checker-holes "an inside cell of a rectangle becomes `background` when the sum of its row and column distances from the rectangle's `anchor` corner has the parity `hole_parity`, and keeps its color otherwise"

  (RULE &comps_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &comps Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (NOT (&background (:C Col)))
           (&comps_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (NOT (&background (:C Col)))
           (= P3 P)))))

  (RULE &comps_component
    (&comps.class (:a (:Col *Key) *P) *Id))

  (RULE &object
    (&comps_component *P (:Id *Ob)))

  (RULE &object2
    (&object *Ob *P))

  (INIT &rim Boundary
    (key ((&object2 (:Ob ^Id) *P))
      (cell (P)
        (&object2 (:Ob Id) *P)))))

(OUTPUT rest-kept "every cell outside the rectangles keeps its color"

  (DET &casts_dir
    (&hole (:E *Key))
    (dir_elem *D))

  (DET &casts_dir_ray
    (&casts_dir *Key *D))

  (DET &casts_blocked
    (&hole (:E *Key) *P))

  (DET &casts_node
    (&casts_dir *Key)
    (ex_input (:E Key) *P)
    (NOT (&casts_blocked Key P)))

  (DET &casts_source
    (&hole (:E *Key) *P))

  ;; Casts from each hole along the rows and columns, stopped at the next hole.
  (INIT &casts Distance
    (key ((&casts_source (:Key ^Ky) (:P ^O))
          (&casts_dir_ray (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&casts_source (:Key Ky) (:P O))
             (&casts_dir_ray (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&casts_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&casts_node (:Key Ky) (:P Q)))
            ((&casts_source (:Key Ky) (:P O))
             (&casts_dir_ray (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&casts_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&casts_source (:Key Ky) (:P O))
             (&casts_dir_ray (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&casts_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&casts_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&casts_source (:Key Ky) (:P O))
        (&casts_dir_ray (:Key Ky) D))))

  (DET &casts_ray
    (&casts.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (DET &casts_end
    (&casts_ray *Key *P *D *K *Origin)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (NOT (&casts_ray Key (:P Q) D Origin)))

  (DET &casts_full_dir
    (&casts_dir *Key *D))

  (DET &casts_full_node
    (&casts_dir *Key)
    (ex_input (:E Key) *P))

  (DET &casts_full_source
    (&hole (:E *Key) *P))

  (INIT &casts_full Distance
    (key ((&casts_full_source (:Key ^Ky) (:P ^O))
          (&casts_full_dir (:Key Ky) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&casts_full_source (:Key Ky) (:P O))
             (&casts_full_dir (:Key Ky) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&casts_full_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&casts_full_node (:Key Ky) (:P Q)))
            ((&casts_full_source (:Key Ky) (:P O))
             (&casts_full_dir (:Key Ky) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&casts_full_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&casts_full_source (:Key Ky) (:P O))
             (&casts_full_dir (:Key Ky) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&casts_full_node (:Key Ky) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&casts_full_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&casts_full_source (:Key Ky) (:P O))
        (&casts_full_dir (:Key Ky) D))))

  (DET &casts_full_ray
    (&casts_full.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

  (INIT &box BoundingBox
    (key ((&object (:Ob ^Id) *P))
      (cell (P)
        (&object (:Ob Id) *P))))

  ;; The corner of each object's box the distance sum is counted from.
  (DET &anchor DiagDirDomain)

  (RULE &object_box
    (&box.box (:key (:Id *Ob)) *B))

  (RULE &punched
    (&object2 *Ob))

  (RULE &covered
    (&punched *Ob)
    (&object2 Ob *P)
    (&object_box Ob *B)
    (ALL ((&object2 (:Ob *Obm) P)
          (&object_box (:Ob Obm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0))))

  ;; The steps from a hole to the next hole on its line.
  (INIT &gaps Order
    (member ((:t K))
      (&casts_end (:Key *Ky) (:P *E) *D (:Origin *S))
      (step_offset D (:V *V_m1))
      (compose (:A E) (:B V_m1) (:C *P))
      (&casts_full_ray (:Key Ky) P D *K (:Origin S)))
    (score ((:t K) (:S K))
      (&casts_end (:Key *Ky) (:P *E) *D (:Origin *S))
      (step_offset D (:V *V_m1))
      (compose (:A E) (:B V_m1) (:C *P))
      (&casts_full_ray (:Key Ky) P D *K (:Origin S))))

  (DET &period
    (&gaps.minimal (:t *N))))

(ALTS $objects "which cells form one object" $OneColor
  (ALT $AnyColorObjects
    (INPUT solid-rectangles "a rectangle is a 4-connected set of cells of any colors other than `background`"
      (RULE &any4_component
        (&any4.class (:a *P) *Id))

      (INIT &obox BoundingBox
        (key ((&any4_component *P ^Id))
          (cell (P)
            (&any4_component *P Id))))

      (RULE &object_box
        (&obox.box (:key (:Id *Ob)) *B))

      (RULE &object2
        (&any4_component *P (:Id *Ob))))
    (ALT $Diagonal8Objects
      (INPUT solid-rectangles "a rectangle's cells join by 8-adjacency, so two rectangles that meet at a corner are one"
        (RULE &any8_component
          (&any8.class (:a *P) *Id))

        (INIT &obox BoundingBox
          (key ((&any8_component *P ^Id))
            (cell (P)
              (&any8_component *P Id))))

        (RULE &object2
          (&any8_component *P (:Id *Ob)))))))

(ALTS $adjacency "which neighbors join an object" $FourAdjacent
  (ALT $Diagonal8Objects
    (INPUT solid-rectangles "a rectangle's cells join by 8-adjacency, so two rectangles that meet at a corner are one"
      (RULE &same8_component
        (&same8.class (:a *Key *P) *Id))

      (INIT &obox BoundingBox
        (key ((&same8_component *P ^Id))
          (cell (P)
            (&same8_component *P Id))))

      (RULE &object_box
        (&obox.box (:key (:Id *Ob)) *B))

      (RULE &object2
        (&same8_component *P (:Id *Ob))))))

(ALTS $inside "which cells of an object are its outline and which its inside" $BoxInterior
  (ALT $RimInside
    (OUTPUT outline-kept "each cell of an object with a 4-neighbor outside the object, or off the grid, keeps its color"
      (RULE &covered
        (&punched *Ob)
        (&object2 Ob *P)
        (NOT (&rim.boundary (:key (:Id Ob)) P))))
    (OUTPUT checker-holes "the inside is the object's other cells")))

(ALTS $origin "the frame the distance sum is counted in" $ObjectCorner
  (ALT $GridFrame
    (OUTPUT checker-holes "the distance sum is counted from the grid's `grid_anchor` corner, and its parity is `grid_hole_parity`"
      ;; The corner of the grid the distance sum is counted from.
      (DET &grid_anchor DiagDirDomain)

      (DET &grid_hole_parity
        (&hole *P)
        (&grid_anchor *D)
        (corner_dist P (:Diag D) (:K *T))
        (&period *N)
        (divide T (:Side N) (:Gap 0) (:Remainder *K))))
    (RULE &hole2
      (&covered *P)
      (&grid_anchor *D)
      (corner_dist P (:Diag D) (:K *T))
      (&period *N)
      (divide T (:Side N) (:Gap 0) (:Remainder *K))
      (&grid_hole_parity K))
    (ALT $StoredTile
      (OUTPUT checker-holes "a 2x2 motif of holes, `tile`, repeats from the corner the distance sum is counted from, and an inside cell is a hole when its cell of the motif is one"
        ;; TODO no-det-plan: &grid_tile: the plan gives no verdict
        (DET &grid_tile))
      (RULE &hole2
        (&covered *P)
        (&grid_anchor *D)
        (corner_dir (:C D) (:A *Ax) (:D *D1_m1))
        (perp (:A Ax) (:A2 *A2_m3))
        (corner_dir (:C D) (:A A2_m3) (:D *D2_m2))
        (margin (:B P) (:D D1_m1) (:K *T1))
        (margin (:B P) (:D D2_m2) (:K *T2))
        (&grid_tile (:P *P_t))
        (perp (:A Ax) (:A2 *A2_m4))
        (frame_extent (:P P_t) (:A Ax) (:N *N1))
        (frame_extent (:P P_t) (:A A2_m4) (:N *N2))
        (divide (:T T1) (:Side N1) (:Gap 0) (:Remainder *K1))
        (divide (:T T2) (:Side N2) (:Gap 0) (:Remainder *K2))
        (corner_dir (:C D) (:A Ax) (:D *D1_m5))
        (perp (:A Ax) (:A2 *A2_m7))
        (corner_dir (:C D) (:A A2_m7) (:D *D2_m6))
        (margin (:B P_t) (:D D1_m5) (:K K1))
        (margin (:B P_t) (:D D2_m6) (:K K2))))))

(ALTS $pattern "which cells of that frame are holes" $Checker
  (ALT $StoredTile
    (OUTPUT checker-holes "a 2x2 motif of holes, `tile`, repeats from the corner the distance sum is counted from, and an inside cell is a hole when its cell of the motif is one"
      ;; The holes of the repeating motif, laid from the anchor corner.
      ;; TODO no-det-plan: &tile: the plan gives no verdict
      (DET &tile))
    (RULE &hole2
      (&covered (:Ob *Id) *P)
      (&object_box (:Ob Id) *B)
      (ALL ((&covered (:Ob *Idm) P)
            (&object_box (:Ob Idm) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_rel))
      (&anchor *D)
      (corner_dir (:C D) (:A *Ax) (:D *D1_m1))
      (perp (:A Ax) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m2))
      (margin (:B P_rel) (:D D1_m1) (:K *T1))
      (margin (:B P_rel) (:D D2_m2) (:K *T2))
      (&tile (:P *P_t))
      (perp (:A Ax) (:A2 *A2_m4))
      (frame_extent (:P P_t) (:A Ax) (:N *N1))
      (frame_extent (:P P_t) (:A A2_m4) (:N *N2))
      (divide (:T T1) (:Side N1) (:Gap 0) (:Remainder *K1))
      (divide (:T T2) (:Side N2) (:Gap 0) (:Remainder *K2))
      (corner_dir (:C D) (:A Ax) (:D *D1_m5))
      (perp (:A Ax) (:A2 *A2_m7))
      (corner_dir (:C D) (:A A2_m7) (:D *D2_m6))
      (margin (:B P_t) (:D D1_m5) (:K K1))
      (margin (:B P_t) (:D D2_m6) (:K K2)))))

(ALTS $punched "which objects are punched" $EveryObject
  (ALT $SizeThreshold
    (OUTPUT checker-holes "only a rectangle at least `min_extent` cells long on each axis is punched"
      ;; The extents of the boxes of the train inputs' objects.
      (INIT &extents Order
        (member ((:t N))
          (&object *E (:Ob *Id) *P)
          (ex_output E)
          (&box.box E (:key Id) *B)
          (axis_elem *A)
          (axis_elem A)
          (relative (:Base B) (:X P) (:X_rel *R_m1))
          (frame_extent (:P R_m1) A *N))
        (score ((:t N) (:S N))
          (&object *E (:Ob *Id) *P)
          (ex_output E)
          (&box.box E (:key Id) *B)
          (axis_elem *A)
          (axis_elem A)
          (relative (:Base B) (:X P) (:X_rel *R_m1))
          (frame_extent (:P R_m1) A *N)))

      (DET &min_extent
        (&extents.minimal (:t *N)))

      (RULE &punched
        (&object2 *Ob)
        (ALL ((&object2 Ob *P)
              (&object_box Ob *B)
              (axis_elem (:A *Ax))
              (axis_elem (:A Ax))
              (relative (:Base B) (:X P) (:X_rel *R_m1))
              (frame_extent (:P R_m1) (:A Ax) *N)
              (&min_extent (:N *M)))
             ((>= N M)))))))

(ALTS $fill "the color a hole takes" $FieldHoles
  (ALT $HoleColor
    (OUTPUT checker-holes "a hole becomes `hole_color`, stored apart from `background`"
      (DET_OR_RULE &hole_color DominantColor
        (&hole (:Col *C))))
    (RULE &hole_paint
      (&hole_color (:C *Col)))))

(DET &casts_full_end
  (&casts_full_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&casts_full_ray Key (:P Q) D Origin)))

(DET &hole_parity_inside1
  (&hole *E (:P *P_))
  (&box.box E (:key *Id) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &hole_parity
  (&hole *E *P)
  (&object E (:Ob *Id) P)
  (&box.box E (:key Id) *B)
  (NOT (&hole_parity_inside1 (:P_ P) (:B_ B)))
  (relative (:Base B) (:X P) (:X_rel *P_rel))
  (&anchor *D)
  (corner_dist (:P P_rel) (:Diag D) (:K *T))
  (&period *N)
  (divide T (:Side N) (:Gap 0) (:Remainder *K)))

(RULE &hole2
  (&covered (:Ob *Id) *P)
  (&object_box (:Ob Id) *B)
  (ALL ((&covered (:Ob *Idm) P)
        (&object_box (:Ob Idm) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_rel))
  (&anchor *D)
  (corner_dist (:P P_rel) (:Diag D) (:K *T))
  (&period *N)
  (divide T (:Side N) (:Gap 0) (:Remainder *K))
  (&hole_parity K))

(RULE &hole_paint
  (&background (:C *Col)))

(RULE &output
  (OR ((&hole2 *P)
       (&hole_paint *Col))
      ((input P Col)
       (NOT (&hole2 P)))))
