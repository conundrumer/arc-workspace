;; 58490d8a

(RULE &shapes_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &panel SharedColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&panel (:C Col))))

(RULE &on_panel
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &marker
  (&on_panel *P *P_inner)
  (input P *Col)
  (NOT (&panel (:C Col))))

(RULE &shapes_node
  (input *P (:Col *Key))
  (&marker (:Col Key))
  (NOT (&on_panel P)))

(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(DET &spread_dir DirDomain)

(RULE &spread_dir2
  (&spread_dir *D))

(RULE &spread_source
  (&marker (:P_inner *P)))

(DET &period TileCount)

(RULE &panel_cell
  (&on_panel *P_inner))

(INIT &shape_count Cardinality
  (key ((&shapes_component (:Key ^Col) *Id))
    (member ((:m Id))
      (&shapes_component (:Key Col) *Id))))

(RULE &spread_cell
  (&panel_cell (:P_inner *P)))

(ALTS $choice "the cases differ in where a row's run of copies starts" $FromMark
  (ALT $FromEdge
    (RULE &spread_dir2
      (&spread_dir (:D *D0))
      (OR ((opposite (:D D0) (:Opp *D)))
          ((= D D0))))))

(RULE &spread_dir_ray
  (&spread_dir2 *D))

(RULE &spread_node
  (&spread_dir2)
  (input *P))

(INIT &spread Distance
  (key ((&spread_source (:P ^O))
        (&spread_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&spread_source (:P O))
           (&spread_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&spread_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&spread_node (:P Q)))
          ((&spread_source (:P O))
           (&spread_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&spread_node (:P Q))
           (= A2 O))
          ((&spread_source (:P O))
           (&spread_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&spread_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&spread_node (:P Q)))))
    (source ((:n O))
      (&spread_source (:P O))
      (&spread_dir_ray D))))

(RULE &spread_ray
  (&spread.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &spread_end
  (&spread_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&spread_ray (:P Q) D Origin)))

(RULE &slot
  (&spread_ray (:P *P_inner) (:K *K_ray) (:Origin *Src))
  (&spread_cell (:P P_inner))
  (&period (:N *W))
  (divide (:T K_ray) (:Side W) (:Gap 0) (:Remainder 0))
  (&spread_dir *D)
  (opposite D (:Opp *D_back))
  (margin (:B P_inner) (:D D_back) *K))

(INIT &slot_rank Order
  (key ((&slot ^Src *K))
    (member ((:t K))
      (&slot Src *K))
    (score ((:t K) (:S K))
      (&slot Src *K))))

(RULE &copy
  (&slot *Src *P_inner *K)
  (&slot_rank.rank (:key Src) (:t K) (:R *I))
  (&marker (:P_inner Src) *Col)
  (&shape_count.size (:key Col) *N)
  (< I N))

(RULE &output
  (OR ((&copy (:P_inner *P) *Col))
      ((&panel_cell (:P_inner P))
       (NOT (&copy (:P_inner P)))
       (&panel (:C Col)))))
