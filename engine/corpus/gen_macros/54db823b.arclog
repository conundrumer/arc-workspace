;; 54db823b

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg
  (ex_input *E *P (:Col *C_in))
  (ex_output E P (:Col *C))
  (!= C_in C))

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(DET &mark RarestColor)

;; An object with no mark cells counts zero, so it wins.
(INIT &marks Cardinality
  (key ((&objs_component (:Id ^O)))
    (member ((:m P))
      (&objs_component *P (:Id O))
      (input P *Col)
      (&mark (:C Col)))
    (domain ()
      (&objs_component (:Id O)))))

(INIT &fewest Order
  (member ((:t (:V O) (:S N)))
    (&marks.size (:key *O) *N))
  (score ((:t (:V O) (:S N)) (:S N))
    (&marks.size (:key *O) *N)))

(RULE &erased_object
  (&fewest.minimal (:t (:V *O)))
  (&objs_component *P (:Id O)))

(RULE &erased_cell
  (&erased_object *P))

(ALTS $choice "the cases differ in what the erasure covers" $Cells
  (ALT $Box
    (INIT &ebox BoundingBox
      (key ((&erased_object ^O *P))
        (cell (P)
          (&erased_object O *P))))

    (RULE &erased_cell
      (input *P)
      (&ebox.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &output
  (OR ((&erased_cell *P)
       (&bg (:C *Col)))
      ((input P Col)
       (NOT (&erased_cell P)))))
