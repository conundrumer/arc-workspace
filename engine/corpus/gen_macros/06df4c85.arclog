;; 06df4c85

(DET &bg SharedColor)

(DET &gap DivisorRatio)

(DET &tile_dim TileDim)

(RULE &tile_division_gap
  (axis_elem *A)
  (&gap (:K *G)))

(RULE &tile_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_side
  (axis_elem *A)
  (&tile_dim (:D *K)))

(RULE &tile_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_dim (:D *K))
       (&gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tile_dim (:D *K2))
       (NOT (&tile_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_division_side A))
       (&tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile
  (&tile_division_tile (:P *P_grid) (:P_outer *P_tile)))

(RULE &mark
  (input (:P *P_grid) *Col)
  (&tile P_grid *P_tile)
  (NOT (&bg (:C Col))))

(RULE &bet_axis
  (&mark (:Col *Key))
  (axis_elem *A))

(RULE &bet_dir
  (&bet_axis *Key *A)
  (axis4_of *D A))

(RULE &bet_node
  (&bet_axis *Key)
  (input *P))

(RULE &bet_source
  (&mark (:P_tile *P) (:Col *Key)))

(INIT &bet Distance
  (key ((&bet_source (:Key ^Ky) (:P ^O))
        (&bet_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&bet_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&bet_node (:Key Ky) (:P Q)))
          ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&bet_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&bet_source (:Key Ky) (:P O))
           (&bet_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&bet_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&bet_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&bet_source (:Key Ky) (:P O))
      (&bet_dir (:Key Ky) D))))

(RULE &bet_ray
  (&bet.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &bet_between
  (&mark (:Col *Key))
  (&tile (:P_tile *P))
  (&bet_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&bet_ray Key P D)
  (&bet_ray Key P (:D O)))

(RULE &bet_end
  (&bet_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&bet_ray Key (:P Q) D Origin)))

(RULE &fill
  (&bet_between (:Key *Col) (:P *P_tile))
  (NOT (&mark P_tile Col)))

(ALTS $choice "The cases claim what an intervening foreign mark does" $Over
  (ALT $Around
    (RULE &fill
      (&bet_between (:Key *Col) (:P *P_tile))
      (NOT (&mark P_tile))))
  (ALT $Block
    (RULE &run_dir
      (dir_elem *D))

    (RULE &run_blocked
      (&mark (:P_tile *P)))

    (RULE &run_node
      (input *P)
      (NOT (&run_blocked P)))

    (RULE &bg_tile
      (&tile *P_tile)
      (NOT (&mark P_tile)))

    (RULE &run_source
      (&bg_tile (:P_tile *P)))

    ;; Each bg tile runs through bg tiles, halting at the first mark.
    (INIT &run Distance
      (key ((&run_source (:P ^O))
            (&run_dir ^D))
        (edge ((:a A2) (:b Q))
          (OR ((&run_source (:P O))
               (&run_dir D)
               (axis_of D *A)
               (sub_extent (:P O) A *K)
               (dir8_opposite D (:D2 *O_m2))
               (edge_inset (:D O_m2) K (:B *B1_m3))
               (edge_inset D K (:B *I_m5))
               (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
               (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
               (compose (:A O) (:B V_m1) (:C *A2))
               (&run_node (:P A2))
               (step_offset D (:V *V_m6))
               (compose (:A A2) (:B V_m6) (:C *Q))
               (&run_node (:P Q)))
              ((&run_source (:P O))
               (&run_dir D)
               (step_offset D (:V *V_m12))
               (compose (:A O) (:B V_m12) (:C Q))
               (&run_node (:P Q))
               (= A2 O))
              ((&run_source (:P O))
               (&run_dir D)
               (diag_dir_elem D)
               (axis_elem (:A *A3))
               (sub_extent (:P O) (:A A3) (:K *K2))
               (dir8_opposite D (:D2 *O_m22))
               (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
               (edge_inset D (:K K2) (:B *I_m52))
               (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
               (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
               (compose (:A O) (:B V_m13) (:C A2))
               (&run_node (:P A2))
               (step_offset D (:V *V_m62))
               (compose (:A A2) (:B V_m62) (:C Q))
               (&run_node (:P Q)))))
        (source ((:n O))
          (&run_source (:P O))
          (&run_dir D))))

    (RULE &run_ray
      (&run.distance (:key *D (:O *Origin)) (:n *P) *K))

    (RULE &run_end
      (&run_ray *P *D *K *Origin)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (NOT (&run_ray (:P Q) D Origin)))

    (RULE &reach
      (&run_end (:P *E) *D (:Origin *P_tile))
      (step_offset D (:V *V_m1))
      (compose (:A E) (:B V_m1) (:C *T2))
      (input (:P T2))
      (dir_elem D)
      (&mark (:P_tile T2) *Col))

    (RULE &fill
      (&reach *Col *D *P_tile)
      (opposite D (:Opp *O))
      (&reach Col (:D O) P_tile))))

(RULE &covered
  (&fill (:P_tile *T))
  (&tile *P_grid (:P_tile T)))

(RULE &output
  (OR ((&fill (:P_tile *T) *Col)
       (&tile (:P_grid *P) (:P_tile T)))
      ((input P Col)
       (NOT (&covered (:P_grid P))))))
