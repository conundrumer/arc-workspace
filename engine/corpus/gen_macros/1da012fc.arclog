;; 1da012fc

(INPUT legend "the cells of the legend color bound a box, and the bodies of other ink inside it are the markers")

(INPUT shapes "each body of ink outside the box is a shape")

(INPUT bands "the objects of one constellation lie in bands along the reading axis — two of them either lie wholly apart along that axis, or cover the same extent of it and lie wholly apart across it")

(INPUT read "an object precedes another in the reading order when it lies wholly ahead along the reading axis, or they meet there and it lies wholly ahead across"

  (RULE &comps_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET &bg DominantColor)

  ;; The legend box's fill.
  (DET &legend SharedColor)

  (INIT &bbox BoundingBox
    (cell (P)
      (input *P *Col)
      (&legend (:C Col))))

  (RULE &box_cell
    (input *P)
    (&bbox.box *B)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0))))

  (INIT &comps Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&bg (:C Col)))
           (IF ((&box_cell P))
               ((NOT (&legend (:C Col))))
               ())
           (&comps_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&bg (:C Col2)))
           (IF ((&box_cell (:P P3)))
               ((NOT (&legend (:C Col2))))
               ()))
          ((input P (:Col *Col3))
           (NOT (&bg (:C Col3)))
           (IF ((&box_cell P))
               ((NOT (&legend (:C Col3))))
               ())
           (= P3 P)))))

  (RULE &comps_component
    (&comps.class (:a *P) *Id))

  ;; Reading order: the corner it starts from, and the axis it runs along before stepping across. The pairs fix the axis. They leave the corner free: under each corner the two constellations pair the same way.
  (DET &corner DiagDirDomain)

  (DET &axis AxisDomain)

  (RULE &obj
    (&comps_component *Id))

  (RULE &marker
    (&comps_component *P *Id)
    (&box_cell P))

  (RULE &shape
    (&obj *Id)
    (NOT (&marker Id)))

  (RULE &peers
    (OR ((&marker (:Id *A))
         (&marker (:Id *B)))
        ((&shape (:Id A))
         (&shape (:Id B)))))

  (RULE &ahead
    (&obj (:Id *A))
    (&obj (:Id *B))
    (!= A B)
    (dir_elem *D)
    (ALL ((&comps_component *P (:Id A))
          (margin (:B P) D (:K *K1))
          (&comps_component (:P *Q) (:Id B))
          (margin (:B Q) D (:K *K2)))
         ((< K1 K2))))

  (RULE &read_dirs
    (&corner (:D *C))
    (&axis *A)
    (corner_dir C A (:D *D1))
    (perp A (:A2 *A2_m1))
    (corner_dir C (:A A2_m1) (:D *D2)))

  (INIT &reading Order
    (member ((:t Id))
      (&obj *Id))
    (before ((:a A) (:b B))
      (&peers *A *B)
      (&read_dirs *D1 *D2)
      (IF ((&ahead (:D D1) A B))
          ()
          ((NOT (&ahead (:D D1) (:A B) (:B A)))
           (&ahead (:D D2) A B)))))

  (INIT &obox BoundingBox
    (key ((&comps_component *P ^Id))
      (cell (P)
        (&comps_component *P Id))))

  ;; A box carries its distance to every edge, so from the reading corner it
  ;; reads as that corner's cell.
  (INIT &lex Order
    (member ((:t B))
      (&obox.box *B))
    (before ((:a B) (:b B2))
      (&obox.box *B)
      (&obox.box (:B *B2))
      (&corner *D)
      (&axis *A)
      (OR ((corner_dir (:C D) A (:D *D2))
           (dir_elem (:D D2))
           (margin B (:D D2) (:K *K1_m1))
           (margin (:B B2) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C D) A (:D D2))
           (perp A (:A2 *A2_m3))
           (corner_dir (:C D) (:A A2_m3) (:D *D22))
           (margin B (:D D2) (:K *K_m4))
           (margin (:B B2) (:D D2) (:K K_m4))
           (dir_elem (:D D22))
           (margin B (:D D22) (:K *K1_m5))
           (margin (:B B2) (:D D22) (:K *K2_m6))
           (< K1_m5 K2_m6))))))

(OUTPUT place "each shape takes the color of the marker whose place in the marker constellation matches the shape's place in the shape constellation"
  (APPROXIMATED "a shape and a marker have the same place when they have the same rank in the reading order"))

(OUTPUT keep "every cell outside the shapes keeps its color")

(ALTS $choice "a shape's place in the reading order — a marker is one cell, but a shape spreads over many, so two models of it." $Separated
  (ALT $Anchor
    (INPUT read "an object stands at its bounding box's reading corner, and the objects run in the reading order of those corners"
      (INIT &reading Order
        (member ((:t Id))
          (&obj *Id))
        (before ((:a Id1) (:b Id2))
          (&peers (:A *Id1) (:B *Id2))
          (&obox.box (:key (:Id Id1)) (:B *B1))
          (&obox.box (:key (:Id Id2)) (:B *B2))
          (&lex.before (:a B1) (:b B2)))))))

(RULE &shape_cell
  (&comps_component *P *Id)
  (&shape Id))

(RULE &output
  (OR ((&shape_cell *P)
       (&comps_component P *Id)
       (&reading.rank (:t Id) *R)
       (&reading.rank (:t *Id2) R)
       (&marker (:Id Id2))
       (&comps_component (:P *P_marker) (:Id Id2))
       (input (:P P_marker) *Col))
      ((input P Col)
       (NOT (&shape_cell P)))))
