;; 2546ccf6

(DET &bg DominantColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((axis_elem ^A)
        (input *P *Col)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (axis_elem A)
      (input *P *Col)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &lattice_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A cut: a line of one drawn color, all the way across.
(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &tile_box BoundingBox
  (key ((&lattice_tile_of *P ^P_tile))
    (cell (P)
      (&lattice_tile_of *P P_tile))))

(RULE &tile_cell
  (&tile_box.cell (:key *P_tile) *P)
  (&tile_box.box (:key P_tile) *B)
  (ALL ((&tile_box.cell (:key (:P_tile *P_tilem)) P)
        (&tile_box.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &tile_holds
  (&lattice_tile_of *P *P_tile)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &block_dir
  (OR ((corner_dir (:C *Diag) *D))
      ((diag_dir_elem (:D Diag))
       (= D Diag))))

(RULE &block_tile
  (&lattice_tile_of *P_tile)
  (&block_dir *Diag *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_tile) (:B V_m1) (:C *S))
  (&tile_holds *Col (:P_tile S)))

(RULE &gap
  (&block_tile *Col *P_tile *Diag)
  (NOT (&tile_holds Col P_tile))
  (ALL ((&block_dir Diag *D))
       ((&block_tile Col P_tile Diag D))))

(RULE &flip
  (&tile_cell *P_intile)
  (axis_of *D *A)
  (axis_inversion A (:T *F))
  (apply (:D F) (:P P_intile) *P_out))

(RULE &reflect
  (OR ((&flip *D *P_intile *P_out))
      ((corner_dir (:C D) (:A *A_m1) (:D *D1))
       (perp (:A A_m1) (:A2 *A2_m2))
       (corner_dir (:C D) (:A A2_m2) (:D *D2))
       (&flip (:D D1) P_intile (:P_out *P_mid))
       (&flip (:D D2) (:P_intile P_mid) P_out))))

(RULE &mirror
  (&gap *Col *P_tile (:Diag *G))
  (&block_tile Col P_tile (:Diag G) *D *S)
  (&tile_cell (:P_tile S) (:P *P_src) *P_intile)
  (&reflect D P_intile *P_out)
  (&tile_cell P_tile (:P *P_dst) (:P_intile P_out)))

(RULE &paint
  (&mirror *Col *P_src (:P_dst *P))
  (input (:P P_src) Col))

(ALTS $choice "what crosses into the missing tile" $Shape
  (ALT $Tile
    (RULE &paint
      (&mirror *P_src (:P_dst *P))
      (input (:P P_src) *Col))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
