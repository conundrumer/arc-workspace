;; 88a62173

(DET &gap SepThickness)

(DET &tile_count ConstOutDim)

(INIT &tile_val_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_val_division_gap
  (axis_elem *A)
  (&gap *G))

(RULE &tile_val_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_val_division_parts
  (axis_elem *A)
  (&tile_count *N))

(RULE &tile_val_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_count *N)
       (&gap *G)
       (&tile_val_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tile_count (:N *N2))
       (&gap (:G *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (&tile_count (:N *N3))
       (NOT (&tile_val_division_gap A))
       (&tile_val_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (axis_elem A)
       (&tile_count (:N *N4))
       (NOT (&tile_val_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_val_division_parts A))
       (&tile_val_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_val_division_tile
  (&tile_val_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_val_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &tile_val
  (input (:P *P_grid) *Col)
  (&tile_val_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $choice "how the cases find the tiles" $Count
  (ALT $Size
    (DET &tile_size ConstOutDim)

    (RULE &tile_val_division2_gap
      (axis_elem *A)
      (&gap *G))

    (RULE &tile_val_division2_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &tile_val_division2_side
      (axis_elem *A)
      (&tile_size (:N *K)))

    (RULE &tile_val_division2_axis
      (OR ((input *P)
           (axis_elem *A)
           (&tile_size (:N *K))
           (&gap *G)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (&tile_size (:N *K2))
           (NOT (&tile_val_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&tile_val_division2_side A))
           (&tile_val_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &tile_val_division2_tile
      (&tile_val_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_val_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &tile_val
      (input (:P *P_grid) *Col)
      (&tile_val_division2_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile))))
  (ALT $Cross
    (RULE &item_split1
      (input (:P *P_) *Col)
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (INIT &line_color Singleton
      (key ((input *P *Col)
            (axis_elem ^A)
            (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
        (member ((:v Col))
          (input *P *Col)
          (axis_elem A)
          (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

    (RULE &lattice_divider
      (&line_color.value (:key *A *L)))

    (RULE &lattice_on_divider
      (input *P)
      (&lattice_divider *A *L)
      (axis_of *D A)
      (margin (:B P) D (:K *K_m1))
      (margin (:B L) D (:K K_m1)))

    (INIT &lattice_rank Order
      (key ((OR ((&lattice_divider *A *L)
                 (axis_of ^D A)
                 (margin (:B L) D *K))
                ((input *P)
                 (dir_elem D)
                 (margin (:B P) D K))))
        (member ((:t K))
          (&lattice_divider *A *L)
          (axis_of D A)
          (margin (:B L) D *K))
        (score ((:t K) (:S K))
          (OR ((&lattice_divider *A *L)
               (axis_of D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
        (probe ((:t K))
          (input *P)
          (dir_elem D)
          (margin (:B P) D *K))))

    (RULE &lattice_part_idx
      (input *P)
      (axis_of *D *A)
      (NOT (&lattice_on_divider P A))
      (margin (:B P) D *K)
      (&lattice_rank.rank (:key D) (:t K) (:R *N)))

    (RULE &lattice_part_of
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&lattice_part_idx *P D (:N *N1))
      (&lattice_part_idx P (:D D2) (:N *N2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K N1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

    (RULE &lattice_tile_of
      (&lattice_part_of *P *A (:P_part *P1))
      (perp A *A2)
      (&lattice_part_of P (:A A2) (:P_part *P2))
      (compose (:A P1) (:B P2) (:C *P_tile)))

    ;; The box each tile spans.
    (INIT &bbox BoundingBox
      (key ((&lattice_tile_of *P (:P_tile ^T)))
        (cell (P)
          (&lattice_tile_of *P (:P_tile T)))))

    (RULE &tile_val
      (input (:P *P_grid) *Col)
      (&bbox.cell (:key (:T *P_tile)) (:P P_grid))
      (&bbox.box (:key (:T P_tile)) *B)
      (ALL ((input (:P P_grid) (:Col *Colm))
            (&bbox.box (:key (:T *Tm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_grid) (:X_rel *P_intile)))))

;; Tiles carrying the same pattern.
(INIT &same Inclusion
  (pattern ((:pattern T) (:m P_intile Col))
    (&tile_val (:P_tile *T) *P_intile *Col))
  (observed ((:observed T) (:m P_intile Col))
    (&tile_val (:P_tile *T) *P_intile *Col)))

;; How many tiles carry each tile's pattern.
(INIT &alike Cardinality
  (key ((&same.equal (:observed ^T) (:pattern *T2)))
    (member ((:m T2))
      (&same.equal (:observed T) (:pattern *T2)))))

(INIT &rarest Order
  (member ((:t (:V T) (:S N)))
    (&alike.size (:key *T) *N))
  (score ((:t (:V T) (:S N)) (:S N))
    (&alike.size (:key *T) *N)))

(RULE &output
  (&rarest.minimal (:t (:V *T)))
  (&tile_val (:P_tile T) (:P_intile *P) *Col))
