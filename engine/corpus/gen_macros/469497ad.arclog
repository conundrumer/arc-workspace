;; 469497ad

(RULE &diag_dir
  (diag_dir_elem (:D *Key)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &palette Cardinality
  (member ((:m Col))
    (&ink *Col))
  (domain ()))

(INIT &intile Frame
  (extent (A N)
    (axis_elem *A)
    (&palette.size *N)))

(INIT &scaled_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&intile.cell (:P *P_intile))))

(RULE &scaled
  (input (:P *P_tile) *Col)
  (&scaled_tiling.cell (:P_outer P_tile) (:P *P_grid)))

(RULE &diag_node
  (diag_dir_elem (:D *Key))
  (input *P)
  (ALL ((&scaled (:P_grid P) *Col))
       ((&bg (:C Col)))))

(RULE &broken_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

(RULE &broken
  (input *P *Col)
  (&bg (:C Col))
  (axis_elem *A)
  (&broken_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across)))

(RULE &legend_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

(INIT &block BoundingBox
  (cell ((:P P_grid))
    (&scaled *P_grid *P_tile)
    (&ink (:P P_tile))
    (ALL ((axis_elem *A)
          (&legend_split1 (:P_ P_tile) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across)))
         ((&broken Across)))))

(RULE &diag_mark
  (&block.cell *P)
  (&block.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *Key) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Key) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &diag_source
  (&diag_mark *Key *P))

(INIT &diag Distance
  (key ((&diag_source (:Key ^Ky) (:P ^O))
        (&diag_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&diag_source (:Key Ky) (:P O))
           (&diag_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&diag_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&diag_node (:Key Ky) (:P Q)))
          ((&diag_source (:Key Ky) (:P O))
           (&diag_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&diag_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&diag_source (:Key Ky) (:P O))
           (&diag_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&diag_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&diag_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&diag_source (:Key Ky) (:P O))
      (&diag_dir (:Key Ky)))))

(RULE &diag_ray
  (&diag.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &diag_end
  (&diag_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&diag_ray Key (:P Q) D Origin)))

(RULE &diag_full_dir
  (diag_dir_elem (:D *Key)))

(RULE &diag_full_node
  (diag_dir_elem (:D *Key))
  (input *P))

(RULE &diag_full_source
  (&diag_mark *Key *P))

(INIT &diag_full Distance
  (key ((&diag_full_source (:Key ^Ky) (:P ^O))
        (&diag_full_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&diag_full_source (:Key Ky) (:P O))
           (&diag_full_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&diag_full_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&diag_full_node (:Key Ky) (:P Q)))
          ((&diag_full_source (:Key Ky) (:P O))
           (&diag_full_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&diag_full_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&diag_full_source (:Key Ky) (:P O))
           (&diag_full_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&diag_full_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&diag_full_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&diag_full_source (:Key Ky) (:P O))
      (&diag_full_dir (:Key Ky)))))

(RULE &diag_full_ray
  (&diag_full.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &diag_full_end
  (&diag_full_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&diag_full_ray Key (:P Q) D Origin)))

(DET &beam AnyOutNewColor)

(RULE &diag_cell
  (diag_dir_elem (:D *Key))
  (&scaled (:P_grid *P) *Col)
  (&bg (:C Col)))

(RULE &beam_cell
  (&diag_ray (:Key *Ky) *P)
  (&diag_cell (:Key Ky) P))

(ALTS $choice "what a beam meets when it crosses non-bg ink" $Halt
  (ALT $Through
    (RULE &beam_cell
      (&diag_full_ray (:Key *Ky) *P)
      (&diag_cell (:Key Ky) P))))

(RULE &output
  (OR ((&beam_cell *P)
       (&beam (:C *Col)))
      ((&scaled (:P_grid P) Col)
       (NOT (&beam_cell P)))))
