;; aaecdb9a

(param &background Color (7))
(param &base Dir (DIR_B))
(param &column_order (Position Color)
  (grid
    (5 2 8 9 6)))

(alts $height
  (alt $HeightAllColors
    (witness height-all-colors borderline concept
      (relaxed pieces)
      (separates "height from the ordered colors' counts, or from every non-background color's count")
      (input (grid
        (7 7 7 7 7 7 7 7 7 7)
        (7 3 7 7 7 7 7 7 3 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 2 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 3 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)))
      (output $OrderedHeight (grid
        (7 2 7 7 7)))
      (output $HeightAllColors (grid
        (7 7 7 7 7)
        (7 7 7 7 7)
        (7 2 7 7 7))))))

(alts $piece
  (alt $ObjectPieces
    (witness object-pieces borderline concept
      (separates "pieces of one color, or multicolor objects counted once under each color they hold")
      (input (grid
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 2 8 8 8 2 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7)))
      (output $ColorPieces (grid
        (7 2 7 7 7)
        (7 2 8 7 7)))
      (output $ObjectPieces (grid
        (7 2 8 7 7))))))

(alts &background
  (alt &background=$Derived
    (witness background=DominantColor borderline concept
      (separates "the stored background 7, or the input's most frequent color")
      (input (grid
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 2 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 2 7 7 7)
        (7 7 7 7 7 7 7 7 6 7)
        (7 7 7 7 7 7 7 7 7 7)
        (8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)))
      (output &background=$Stored (grid
        (7 2 7 7 7)
        (7 2 8 7 6)))
      (output ($ColorPieces &background=$Derived) (grid
        (8 2 8 8 8)
        (8 2 8 8 6)))
      (output ($ObjectPieces &background=$Derived) (grid
        (8 2 8 8 6))))))
