;; 178fcbfb

(DET &bg DominantColor)

;; The family that shows at a crossing.
(DET &top_axis AxisDomain)

(DET &bare
  (ex_output *E *P)
  (axis_elem *A)
  (ex_output E (:P *Q) (:Col *Bg))
  (&bg (:C Bg))
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(DET &line_axis
  (ex_input *E *P *Col)
  (NOT (&bg (:C Col)))
  (ex_output E P)
  (axis_elem *A)
  (NOT (&bare E P A)))

(RULE &painted
  (input (:P *Q) *Col)
  (&line_axis Col *A)
  (input *P)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B Q) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3)))

(RULE &top_paint
  (&top_axis *A)
  (&painted *P A *Col))

(RULE &output
  (input *P)
  (OR ((&top_paint P *Col))
      ((NOT (&top_paint P))
       (&painted P Col))
      ((NOT (&painted P))
       (&bg (:C Col)))))
