;; 6d58a25d

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

;; The shape's color forms one object; the marker color scatters into many.
(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(DET &dir DirDomain)

(RULE &cast_dir
  (&dir *D))

(RULE &cast_node
  (input *P))

(RULE &shape_color
  (&objs_node (:Key *Col))
  (ALL ((&objs_component (:Key Col) *Id)
        (&objs_component (:Key Col) (:Id *Id2)))
       ((= Id Id2))))

(RULE &cast_source
  (input *P *Col)
  (&shape_color Col))

;; From each shape cell toward &dir, over the cells past the shape.
(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(RULE &cast_cell
  (input *P *Col)
  (NOT (&shape_color Col)))

(RULE &fill
  (&cast_ray *P *D (:Origin *Src))
  (&cast_cell P)
  (&cast_ray (:P *Q) D (:Origin Src))
  (&cast_cell (:P Q))
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))
