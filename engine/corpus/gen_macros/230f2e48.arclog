;; 230f2e48

(RULE &arms_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &arms Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&arms_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &arms_component
  (&arms.class (:a *P) *Id))

(DET &anchor RarestColor)

(RULE &arm
  (&arms_component *P *Id))

(RULE &arm_dir
  (input *P *Col)
  (&anchor (:C Col))
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&arm *Id (:P Q)))

(RULE &from_joint_dir
  (&arm_dir (:Id *Key) *D))

(RULE &from_joint_node
  (&arm_dir (:Id *Key) *D)
  (input *P))

(DET &joint RarestColor)

(RULE &joint2
  (&arm *Id *P)
  (input P *Col)
  (&joint (:C Col)))

(RULE &from_joint_source
  (&joint2 (:Id *Key) *P))

;; The stretch beyond the joint, each cell with its distance from it.
(INIT &from_joint Distance
  (key ((&from_joint_source (:Key ^Ky) (:P ^O))
        (&from_joint_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&from_joint_source (:Key Ky) (:P O))
           (&from_joint_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&from_joint_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&from_joint_node (:Key Ky) (:P Q)))
          ((&from_joint_source (:Key Ky) (:P O))
           (&from_joint_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&from_joint_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&from_joint_source (:Key Ky) (:P O))
           (&from_joint_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&from_joint_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&from_joint_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&from_joint_source (:Key Ky) (:P O))
      (&from_joint_dir (:Key Ky) D))))

(RULE &from_joint_ray
  (&from_joint.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &from_joint_end
  (&from_joint_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&from_joint_ray Key (:P Q) D Origin)))

(RULE &cross_dir
  (&arm_dir *Id (:D *D3))
  (axis_of (:D D3) (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of *D (:A A2_m2)))

(RULE &open_dir
  (&cross_dir *Id *D))

(RULE &open_blocked
  (&cross_dir *Id *D)
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &open_node
  (&cross_dir *Id *D)
  (input *P)
  (NOT (&open_blocked Id D P)))

(RULE &open_source
  (&cross_dir *Id *D)
  (&joint2 Id *P))

;; The unbroken background run leaving the joint across the arm.
(INIT &open Distance
  (key ((&open_source (:Id ^Ky_id) (:D ^Ky_d) (:P ^O))
        (&open_dir (:Id Ky_id) (:D Ky_d)))
    (edge ((:a A2) (:b Q))
      (OR ((&open_source (:Id Ky_id) (:D Ky_d) (:P O))
           (&open_dir (:Id Ky_id) (:D Ky_d))
           (axis_of (:D Ky_d) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky_d) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky_d) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&open_node (:Id Ky_id) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&open_node (:Id Ky_id) (:D Ky_d) (:P Q)))
          ((&open_source (:Id Ky_id) (:D Ky_d) (:P O))
           (&open_dir (:Id Ky_id) (:D Ky_d))
           (step_offset (:D Ky_d) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&open_node (:Id Ky_id) (:D Ky_d) (:P Q))
           (= A2 O))
          ((&open_source (:Id Ky_id) (:D Ky_d) (:P O))
           (&open_dir (:Id Ky_id) (:D Ky_d))
           (diag_dir_elem (:D Ky_d))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky_d) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky_d) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&open_node (:Id Ky_id) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&open_node (:Id Ky_id) (:D Ky_d) (:P Q)))))
    (source ((:n O))
      (&open_source (:Id Ky_id) (:D Ky_d) (:P O))
      (&open_dir (:Id Ky_id) (:D Ky_d)))))

(RULE &open_ray
  (&open.distance (:key (:Ky_id *Id) (:Ky_d *Key_d) (:Ky_d *D) (:O *Origin)) (:n *P) *K))

(RULE &open_end
  (&open_ray *Id *Key_d *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&open_ray Id Key_d (:P Q) D Origin)))

(DET &body ColorDomain)

(RULE &tail
  (&from_joint_ray (:Key *Id) *P *K)
  (&arm Id P)
  (!= K 0))

(RULE &fold_dir
  (&joint2 *Id *P)
  (&cross_dir Id *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (> K K2))

(ALTS $choice "which side of the arm the stretch turns toward" $Inward
  (ALT $Roomy
    (RULE &open_cell
      (&cross_dir *Id *D)
      (input *P *Col)
      (&bg (:C Col)))

    ;; A side with no run at all still competes, at 0.
    (INIT &room Cardinality
      (key ((OR ((&open_ray ^Id (:Key_d ^D) (:P *Q))
                 (&open_cell Id D (:P Q)))
                ((&cross_dir Id D))))
        (member ((:m Q))
          (&open_ray Id (:Key_d D) (:P *Q))
          (&open_cell Id D (:P Q)))
        (domain ()
          (&cross_dir Id D))))

    (RULE &fold_dir
      (opposite *D (:Opp *D3))
      (&room.size (:key *Id D) *N)
      (&room.size (:key Id (:D D3)) (:N *N2))
      (> N N2))))

(RULE &folded
  (&tail *Id *K)
  (&joint2 Id (:P *P2))
  (&fold_dir Id (:D *D2))
  (dir8_opposite (:D D2) (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset (:D D2) K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&folded P)
       (&body (:C *Col)))
      ((NOT (&folded P))
       (&tail P)
       (&bg (:C Col)))
      ((NOT (&folded P))
       (NOT (&tail P))
       (= Col Col_in))))
