;; 66ac4c3b

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background is the commonest color.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

(RULE &line_ink_split1
  (&ink (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *P_along_)))

(RULE &line_ink
  (&ink *P *Col)
  (axis_elem *A)
  (&line_ink_split1 (:P_ P) (:A_ A) (:P_line_ *P_line) (:P_along_ *P_along)))

;; A monochrome line's color.
(INIT &line_color Singleton
  (key ((&line_ink ^A ^P_line *Col))
    (member ((:v Col))
      (&line_ink A P_line *Col))))

;; Lines with the same ink positions.
(INIT &line_set Inclusion
  (pattern ((:pattern (:A L_a) (:P_line L_p_line)) (:m P_along))
    (&line_ink (:A *L_a) (:P_line *L_p_line) *P_along))
  (observed ((:observed (:A L_a) (:P_line L_p_line)) (:m P_along))
    (&line_ink (:A *L_a) (:P_line *L_p_line) *P_along)))

(RULE &marker_pair
  (&line_color.value (:key *A *P_line) (:v *Col))
  (&line_color.value (:key A (:P_line *P_line2)) (:v *Col2))
  (!= Col Col2)
  (&line_set.equal (:observed A P_line) (:pattern A (:P_line P_line2))))

(RULE &painted
  (OR ((&ink *P *Col))
      ((&ink (:P *P2) (:Col *Col3))
       (&marker_pair *A *P_line *P_line2 (:Col Col3) (:Col2 Col))
       (axis_inversion A (:T *F))
       (relative (:Base P_line) (:X P2) (:X_rel *V))
       (apply (:D F) (:P V) (:P_out *V_img))
       (compose (:A P_line2) (:B V_img) (:C P))
       (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
