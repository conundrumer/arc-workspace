;; 239be575

(RULE &orth_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &link ColorDomain)

(DET &mark VanishedColor)

(RULE &node
  (input *P *Col)
  (OR ((&mark (:C Col)))
      ((&link (:C Col)))))

(INIT &orth Quotient
  (edge ((:a P) (:b P3))
    (OR ((&node *P)
         (&orth_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&node (:P P3)))
        ((&node P)
         (= P3 P)))))

(RULE &orth_component
  (&orth.class (:a *P) *Id))

(RULE &orth_conn
  (&orth_component *P (:Id *I))
  (&orth_component (:P *Q) (:Id I)))

(DET &out_pos Frame)

(DET &bg DominantColor)

(RULE &mark_cell
  (input *P *Col)
  (&mark (:C Col)))

(RULE &apart
  (&mark_cell *P)
  (&mark_cell (:P *Q))
  (NOT (&orth_conn P Q)))

(ALTS $a "what an edge is" $Orth
  (ALT $Diag
    (RULE &diag_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (INIT &diag Quotient
      (edge ((:a P) (:b P3))
        (OR ((&node *P)
             (&diag_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&node (:P P3)))
            ((&node P)
             (= P3 P)))))

    (RULE &diag_component
      (&diag.class (:a *P) *Id))

    (RULE &diag_conn
      (&diag_component *P (:Id *I))
      (&diag_component (:P *Q) (:Id I)))

    (RULE &apart
      (&mark_cell *P)
      (&mark_cell (:P *Q))
      (NOT (&diag_conn P Q)))))

(ALTS $r "how the verdict renders" $Wire
  (ALT $Table
    (DET &join_paint ColorDomain)

    (DET &apart_paint DominantColor)

    (RULE &output
      (OR ((&joined)
           (&join_paint (:C *Col))
           (&out_pos *P))
          ((&apart)
           (&apart_paint (:C Col))
           (&out_pos P))))))

(RULE &joined
  (NOT (&apart)))

(RULE &output
  (OR ((&joined)
       (&link (:C *Col))
       (&out_pos *P))
      ((&apart)
       (&bg (:C Col))
       (&out_pos P))))
