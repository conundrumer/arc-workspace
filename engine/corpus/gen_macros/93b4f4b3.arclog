;; 93b4f4b3

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &closed_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &closed_flood Propagation
  (source ((:n P))
    (&closed_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P *Col)
    (&bg (:C Col)))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (&bg (:C Col))
    (&closed_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (&bg (:C Col2))))

(RULE &closed_node
  (&closed_cell *P)
  (NOT (&closed_flood.reached (:n P))))

;; The holes: the background regions closed off from the grid edge.
(INIT &closed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&closed_node *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:P P2)))
        ((&closed_node P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *P) *Id))

(RULE &hole
  (&closed_component *P (:Id *H)))

(RULE &panel
  (&hole *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(INIT &panel_box BoundingBox
  (cell (P)
    (input *P *Col)
    (&panel Col)))

(RULE &shape
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&panel Col)))

(INIT &hole_box BoundingBox
  (key ((&hole ^H *P))
    (cell (P)
      (&hole H *P))))

(INIT &shape_box BoundingBox
  (key ((&shape ^Col *P))
    (cell (P)
      (&shape Col *P))))

;; Same footprint: the two sets fill their boxes alike.
(INIT &fits Inclusion
  (pattern ((:pattern Col) (:m P_inner))
    (&shape *Col *P)
    (&shape_box.box (:key Col) *B)
    (ALL ((&shape (:Col *Colm) P)
          (&shape_box.box (:key (:Col Colm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner)))
  (observed ((:observed H) (:m P_inner))
    (&hole *H *P)
    (&hole_box.box (:key H) *B)
    (ALL ((&hole (:H *Hm) P)
          (&hole_box.box (:key (:H Hm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(RULE &output
  (&panel_box.box *B)
  (OR ((input (:P *P2) *Col)
       (&panel Col))
      ((&hole *H (:P P2))
       (&fits.equal (:observed H) (:pattern Col))))
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (>= K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (>= K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (>= K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (>= K4_m11 0)
  (relative (:Base B) (:X P2) (:X_rel *P)))
