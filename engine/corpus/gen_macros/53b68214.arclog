;; 53b68214

(DET &growth DirDomain)

(INIT &si Periods
  (cell (P (:v Col))
    (input *P *Col)))

(RULE &width
  (input *P)
  (&growth *D)
  (axis_of D *A)
  (perp A *A2)
  (frame_extent P (:A A2) (:N *W)))

;; Per-case output frame.
(INIT &frame Frame
  (extent (A (:N W))
    (&width *W)
    (axis_elem *A)))

(ALTS $choice "two models of the grown extent" $Square
  (ALT $Canvas
    (DET &out_dim ConstInDim)

    ;; Per-case output frame.
    (INIT &frame Frame
      (extent (A (:N K))
        (OR ((&growth *D)
             (axis_of D *A)
             (&out_dim (:N *K)))
            ((&width (:W K))
             (&growth (:D *D2))
             (axis_of (:D D2) (:A *A3))
             (perp (:A A3) (:A2 A))))))))

;; The input seated against the edge the growth flows away from, and the
;; pattern continuing from each input cell at every whole period on.
(RULE &output
  (&frame.cell *P)
  (input (:P *P_in) *Col)
  (&growth *D)
  (axis_of D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P_in) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3))
  (opposite D (:Opp *O))
  (margin (:B P_in) (:D O) (:K *T))
  (margin (:B P) (:D O) (:K *T2))
  (<= T T2)
  (&si.fundamental_period A *K)
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (divide (:T T2) (:Side K) (:Gap 0) (:Remainder R)))
