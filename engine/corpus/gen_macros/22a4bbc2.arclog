;; 22a4bbc2

;; Counting edge: ranks run from this edge; its axis stacks the bars.
(DET &dir DirDomain)

(RULE &run_of_dir
  (&dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(DET &bg UnchangedColor)

(RULE &cell_row_split1
  (input (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *R_))
  (relative (:Base R_) (:X P_) (:X_rel *X_m1_)))

(RULE &cell_row
  (input *P)
  (&dir *D)
  (axis_of D *A)
  (&cell_row_split1 (:P_ P) (:A_ A) (:R_ *R) (:X_m1_ *X_m1)))

(RULE &row_cell
  (&cell_row *P *R)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &row_color
  (&row_cell *R *P)
  (input P *Col))

(RULE &boundary
  (&row_color *R *Col)
  (&dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A R) (:B V_m1) (:C *R2))
  (NOT (&row_color (:R R2) Col)))

(RULE &row
  (&cell_row *R))

(RULE &run_of_blocked
  (&row (:R *P))
  (OR ((&boundary (:R P)))
      ((NOT (&row_cell (:R P))))))

(RULE &run_of_node
  (input *P)
  (NOT (&run_of_blocked P)))

(RULE &run_of_source
  (&boundary (:R *P)))

;; Rows of the run each boundary starts: it carries on away from the counting
;; edge until the next boundary or a row with no ink.
(INIT &run_of Distance
  (key ((&run_of_source (:P ^O))
        (&run_of_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_of_source (:P O))
           (&run_of_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_of_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_of_node (:P Q)))
          ((&run_of_source (:P O))
           (&run_of_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_of_node (:P Q))
           (= A2 O))
          ((&run_of_source (:P O))
           (&run_of_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_of_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_of_node (:P Q)))))
    (source ((:n O))
      (&run_of_source (:P O))
      (&run_of_dir D))))

(RULE &run_of_ray
  (&run_of.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &run_of_end
  (&run_of_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_of_ray (:P Q) D Origin)))

(DET &mark AnyOutNewColor)

;; The mark pattern along the bar sequence: mark_len marked bars, then mark_gap unmarked, repeating.
(DET &mark_len DivisorRatio)

(DET &mark_gap TileCount)

(INIT &seq Order
  (member ((:t K))
    (&boundary *R)
    (&dir *D)
    (margin (:B R) D *K))
  (score ((:t K) (:S K))
    (&boundary *R)
    (&dir *D)
    (margin (:B R) D *K)))

(ALTS $choice "what a bar is" $Run
  (ALT $Object
    (RULE &comps_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &comps_node
      (input *P (:Col *Key))
      (NOT (&bg (:C Key))))

    (INIT &comps Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&comps_node (:Key *Ky) *P)
             (&comps_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&comps_node (:Key Ky) (:P P2)))
            ((&comps_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &comps_component
      (&comps.class (:a *Key *P) *Id))

    (INIT &obj_box BoundingBox
      (key ((&comps_component *P ^Id))
        (cell (P)
          (&comps_component *P Id))))

    (RULE &obj_margin
      (&dir *D)
      (&obj_box.box (:key *Id) *B)
      (margin B D *K))

    (INIT &seq Order
      (member ((:t K))
        (&obj_margin *K))
      (score ((:t K) (:S K))
        (&obj_margin *K)))

    (RULE &mark_cell
      (&mark_margin *K)
      (&obj_margin *Id K)
      (&comps_component *P Id))))

(RULE &mark_margin
  (&seq.rank (:t *K) *R)
  (&mark_len (:K *N))
  (&mark_gap (:N *G))
  (divide (:T R) (:Side N) (:Gap G)))

(RULE &mark_cell
  (&mark_margin *K)
  (&dir *D)
  (&boundary (:R *R_top))
  (margin (:B R_top) D K)
  (&run_of_ray (:P *R) (:Origin R_top))
  (&row R)
  (&row_cell R *P))

(RULE &output
  (OR ((&mark_cell *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&mark_cell P)))))
