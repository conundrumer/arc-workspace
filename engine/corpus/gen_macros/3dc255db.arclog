;; 3dc255db

(RULE &cavity_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &comps_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(RULE &obj
  (&comps_component *P *Id))

(INIT &obj_size Cardinality
  (key ((&obj ^Id *P))
    (member ((:m P))
      (&obj Id *P))))

(RULE &holds
  (&obj *Id *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&obj (:Id *B) (:P Q))
  (&obj_size.size (:key Id) *N)
  (&obj_size.size (:key (:Id B)) (:N *N2))
  (< N N2))

(RULE &wall
  (&holds *B)
  (&obj (:Id B) *P))

(INIT &bbox BoundingBox
  (key ((&wall ^B *P))
    (cell (P)
      (&wall B *P))))

(RULE &cavity_node
  (&bbox.box (:key (:B *Key)) (:B *B_hold))
  (input *P)
  (ALL ((&bbox.box (:key (:B *Bm)) (:B B_hold))
        (dir_elem (:D *D_m1))
        (relative (:Base B_hold) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&wall (:B Key) P)))

(RULE &held
  (&holds *B *Id)
  (&obj Id *P))

;; The cavity: what the held cells reach inside the box without crossing a wall.
(INIT &cavity Propagation
  (key ((OR ((&held ^B *P)
             (&cavity_node (:Key B) P))
            ((&cavity_node (:Key B) P)
             (&cavity_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&cavity_node (:Key B) (:P Q)))))
    (source ((:n P))
      (&held B *P)
      (&cavity_node (:Key B) P))
    (edge ((:a P) (:b Q))
      (&cavity_node (:Key B) *P)
      (&cavity_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&cavity_node (:Key B) (:P Q)))))

;; The cavity runs out to that side of the bbox.
(RULE &mouth
  (&bbox.box (:key *B) (:B *B_hold))
  (&cavity.reached (:key B) (:n *P))
  (ALL ((&cavity.reached (:key (:B *Bm)) (:n P))
        (&bbox.box (:key (:B Bm)) (:B B_hold))
        (dir_elem (:D *D_m1))
        (relative (:Base B_hold) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) *D (:K *K_m1))
  (margin (:B B_hold) D (:K K_m1)))

;; The wall cell nearest a side, where it stands alone there.
(INIT &tip Singleton
  (key ((&bbox.box (:key ^B) (:B *B_hold))
        (&wall B *P)
        (ALL ((&wall (:B *Bm) P)
              (&bbox.box (:key (:B Bm)) (:B B_hold))
              (dir_elem (:D *D_m1))
              (relative (:Base B_hold) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) ^D (:K *K_m1))
        (margin (:B B_hold) D (:K K_m1)))
    (member ((:v P))
      (&bbox.box (:key B) (:B *B_hold))
      (&wall B *P)
      (ALL ((&wall (:B *Bm) P)
            (&bbox.box (:key (:B Bm)) (:B B_hold))
            (dir_elem (:D *D_m1))
            (relative (:Base B_hold) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) D (:K *K_m1))
      (margin (:B B_hold) D (:K K_m1)))))

(RULE &held_color
  (&held *B *P)
  (input P *Col))

(INIT &held_size Cardinality
  (key ((&held ^B *P))
    (member ((:m P))
      (&held B *P))))

(ALTS $choice "how the open side is read" $Pour
  (ALT $Sight
    (RULE &sight_dir
      (&wall (:B *Key))
      (dir_elem *D))

    (RULE &sight_dir_ray
      (&sight_dir *Key *D))

    (RULE &sight_node
      (&sight_dir *Key)
      (input *P)
      (NOT (&wall (:B Key) P)))

    (RULE &sight_source
      (&held (:B *Key) *P))

    (INIT &sight Distance
      (key ((&sight_source (:Key ^Ky) (:P ^O))
            (&sight_dir_ray (:Key Ky) ^D))
        (edge ((:a A2) (:b Q))
          (OR ((&sight_source (:Key Ky) (:P O))
               (&sight_dir_ray (:Key Ky) D)
               (axis_of D *A)
               (sub_extent (:P O) A *K)
               (dir8_opposite D (:D2 *O_m2))
               (edge_inset (:D O_m2) K (:B *B1_m3))
               (edge_inset D K (:B *I_m5))
               (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
               (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
               (compose (:A O) (:B V_m1) (:C *A2))
               (&sight_node (:Key Ky) (:P A2))
               (step_offset D (:V *V_m6))
               (compose (:A A2) (:B V_m6) (:C *Q))
               (&sight_node (:Key Ky) (:P Q)))
              ((&sight_source (:Key Ky) (:P O))
               (&sight_dir_ray (:Key Ky) D)
               (step_offset D (:V *V_m12))
               (compose (:A O) (:B V_m12) (:C Q))
               (&sight_node (:Key Ky) (:P Q))
               (= A2 O))
              ((&sight_source (:Key Ky) (:P O))
               (&sight_dir_ray (:Key Ky) D)
               (diag_dir_elem D)
               (axis_elem (:A *A3))
               (sub_extent (:P O) (:A A3) (:K *K2))
               (dir8_opposite D (:D2 *O_m22))
               (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
               (edge_inset D (:K K2) (:B *I_m52))
               (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
               (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
               (compose (:A O) (:B V_m13) (:C A2))
               (&sight_node (:Key Ky) (:P A2))
               (step_offset D (:V *V_m62))
               (compose (:A A2) (:B V_m62) (:C Q))
               (&sight_node (:Key Ky) (:P Q)))))
        (source ((:n O))
          (&sight_source (:Key Ky) (:P O))
          (&sight_dir_ray (:Key Ky) D))))

    (RULE &sight_ray
      (&sight.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

    (RULE &sight_end
      (&sight_ray *Key *P *D *K *Origin)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (NOT (&sight_ray Key (:P Q) D Origin)))

    (RULE &sight_stop
      (&sight_end *Key (:P *E) *D (:Origin *Src))
      (step_offset D (:V *V_m1))
      (compose (:A E) (:B V_m1) (:C *P))
      (&sight_ray Key P D *K (:Origin Src)))

    (RULE &mouth
      (&wall *B)
      (dir_elem *D)
      (NOT (&sight_stop (:Key B) D)))))

(RULE &spout
  (&mouth *B (:D *D_open))
  (opposite *D (:Opp D_open))
  (&tip.value (:key B D) (:v *P)))

(RULE &trail_dir
  (&spout *B *D))

(RULE &trail_node
  (&spout *B *D)
  (input *P))

(RULE &trail_source
  (&spout *B *D *P))

(INIT &trail Distance
  (key ((&trail_source (:B ^Ky_b) (:D ^Ky_d) (:P ^O))
        (&trail_dir (:B Ky_b) (:D Ky_d)))
    (edge ((:a A2) (:b Q))
      (OR ((&trail_source (:B Ky_b) (:D Ky_d) (:P O))
           (&trail_dir (:B Ky_b) (:D Ky_d))
           (axis_of (:D Ky_d) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky_d) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky_d) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&trail_node (:B Ky_b) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&trail_node (:B Ky_b) (:D Ky_d) (:P Q)))
          ((&trail_source (:B Ky_b) (:D Ky_d) (:P O))
           (&trail_dir (:B Ky_b) (:D Ky_d))
           (step_offset (:D Ky_d) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&trail_node (:B Ky_b) (:D Ky_d) (:P Q))
           (= A2 O))
          ((&trail_source (:B Ky_b) (:D Ky_d) (:P O))
           (&trail_dir (:B Ky_b) (:D Ky_d))
           (diag_dir_elem (:D Ky_d))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky_d) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky_d) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&trail_node (:B Ky_b) (:D Ky_d) (:P A2))
           (step_offset (:D Ky_d) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&trail_node (:B Ky_b) (:D Ky_d) (:P Q)))))
    (source ((:n O))
      (&trail_source (:B Ky_b) (:D Ky_d) (:P O))
      (&trail_dir (:B Ky_b) (:D Ky_d)))))

(RULE &trail_ray
  (&trail.distance (:key (:Ky_b *B) (:Ky_d *Key_d) (:Ky_d *D) (:O *Origin)) (:n *P) *K))

(RULE &trail_end
  (&trail_ray *B *Key_d *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&trail_ray B Key_d (:P Q) D Origin)))

(RULE &trail_cell
  (&spout *B *D)
  (input *P))

(RULE &paint
  (&trail_ray *B *P *K)
  (&trail_cell B P)
  (!= K 0)
  (&held_size.size (:key B) *N)
  (<= K N)
  (&held_color B *Col))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P (:Col *C_in))
       (NOT (&paint P))
       (OR ((&held P)
            (&bg (:C Col)))
           ((NOT (&held P))
            (= Col C_in))))))
