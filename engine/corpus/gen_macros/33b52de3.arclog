;; 33b52de3

(DET &tile_col ChangedColor)

(INIT &field BoundingBox
  (cell (P)
    (input *P *Col)
    (&tile_col (:C Col))))

(DET &gap DivisorRatio)

;; Tile extent, both axes, and the gap between tiles.
(DET &tile_dim TileCount)

(RULE &output_division_gap
  (axis_elem *A)
  (&gap (:K *G)))

(RULE &output_division_axis_split1
  (&field.box (:B *B_field))
  (&field.cell *P)
  (relative (:Base B_field) (:X P) (:X_rel *P_inner_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

(RULE &output_division_side
  (axis_elem *A)
  (&tile_dim (:N *K)))

(RULE &output_division_axis
  (OR ((&field.cell (:P *P2))
       (&field.box (:B *B_field))
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B_field) (:X P2) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B_field) (:X P2) (:X_rel *P))
       (axis_elem *A)
       (&tile_dim (:N *K))
       (&gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&field.cell (:P *P22))
       (&field.box (:B *B_field2))
       (ALL ((dir_elem (:D *D_m12))
             (relative (:Base B_field2) (:X P22) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((>= K_m32 0)))
       (relative (:Base B_field2) (:X P22) (:X_rel P))
       (axis_elem A)
       (&tile_dim (:N *K2))
       (NOT (&output_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2)))
      ((&field.cell (:P *P23))
       (&field.box (:B *B_field3))
       (ALL ((dir_elem (:D *D_m13))
             (relative (:Base B_field3) (:X P23) (:X_rel *R_m23))
             (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
            ((>= K_m33 0)))
       (relative (:Base B_field3) (:X P23) (:X_rel P))
       (axis_elem A)
       (NOT (&output_division_side A))
       (&output_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &output_division_tile
  (&output_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&output_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

;; The miniature. Its own frame is the tile arrangement, so each of its cells
;; sits at a tile place.
(INIT &mini BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&tile_col (:C Col)))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&tile_col (:C Col))))
      ((&field.cell P)
       (&field.box (:B *B_field))
       (ALL ((dir_elem (:D *D_m1))
             (relative (:Base B_field) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (relative (:Base B_field) (:X P) (:X_rel *P_inner))
       (&output_division_tile (:P P_inner) (:P_outer *P_tile))
       (input (:P *P_mini) Col)
       (&mini.cell (:P P_mini))
       (&mini.box (:B *B_mini))
       (ALL ((input (:P P_mini) (:Col *Colm))
             (dir_elem (:D *D_m1m))
             (relative (:Base B_mini) (:X P_mini) (:X_rel *R_m2m))
             (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
            ((>= K_m3m 0)))
       (relative (:Base B_mini) (:X P_mini) (:X_rel P_tile)))))
