;; 5289ad53

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The reading order the marks render in: a corner and the primary axis.
(DET &corner DiagDirDomain)

(DET &order_axis AxisDomain)

(INIT &reading2 Order
  (key ((ex_output ^E *P))
    (member ((:t P))
      (ex_output E *P))
    (before ((:a P) (:b P2))
      (ex_output E *P)
      (ex_output E (:P *P2))
      (ex_output E)
      (&corner *D)
      (&order_axis *A)
      (OR ((corner_dir (:C D) A (:D *D2))
           (dir_elem (:D D2))
           (margin (:B P) (:D D2) (:K *K1_m1))
           (margin (:B P2) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C D) A (:D D2))
           (perp A (:A2 *A2_m3))
           (corner_dir (:C D) (:A A2_m3) (:D *D22))
           (margin (:B P) (:D D2) (:K *K_m4))
           (margin (:B P2) (:D D2) (:K K_m4))
           (dir_elem (:D D22))
           (margin (:B P) (:D D22) (:K *K1_m5))
           (margin (:B P2) (:D D22) (:K *K2_m6))
           (< K1_m5 K2_m6))))))

;; Where each color's block starts: the output renders marks in colors
;; the input holds.
(INIT &first Order
  (key ((ex_input ^E ^Col))
    (member ((:t R))
      (ex_output E *P Col)
      (&reading2.rank (:key E) (:t P) *R))
    (score ((:t R) (:S R))
      (ex_output E *P Col)
      (&reading2.rank (:key E) (:t P) *R))))

;; The blocks follow one another, so a color ranks by its start.
(INIT &place Order
  (key ((&first.minimal (:key ^E) (:t *K)))
    (member ((:t K))
      (&first.minimal (:key E) (:t *K)))
    (score ((:t K) (:S K))
      (&first.minimal (:key E) (:t *K)))))

(DET &color_rank
  (&first.minimal (:key *E *Col) (:t *K))
  (&place.rank (:key E) (:t K) *R))

(RULE &mark_cell
  (input *P *Col)
  (&color_rank Col))

(INIT &blocks Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&mark_cell *Col *P)
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&mark_cell Col (:P P3)))
        ((&mark_cell Col P)
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *Key *P) *Id))

(DET &dim ConstOutDimAxis)

(RULE &mark
  (&blocks_component (:Key *Col) *Id))

(INIT &frame Frame
  (extent (A N)
    (&dim *A *N)))

(INIT &reading Order
  (member ((:t P))
    (&frame.cell *P))
  (before ((:a P) (:b P2))
    (&frame.cell *P)
    (&frame.cell (:P *P2))
    (&corner *D)
    (&order_axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (dir_elem (:D D2))
         (margin (:B P) (:D D2) (:K *K1_m1))
         (margin (:B P2) (:D D2) (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir (:C D) A (:D D2))
         (perp A (:A2 *A2_m3))
         (corner_dir (:C D) (:A A2_m3) (:D *D22))
         (margin (:B P) (:D D2) (:K *K_m4))
         (margin (:B P2) (:D D2) (:K K_m4))
         (dir_elem (:D D22))
         (margin (:B P) (:D D22) (:K *K1_m5))
         (margin (:B P2) (:D D22) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

(DET &fill
  (ex_output *Col)
  (NOT (&color_rank Col)))

(ALTS $choice "The cases claim what one mark is" $Blocks
  (ALT $Runs
    (RULE &runs_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (DET &run_axis AxisDomain)

    (RULE &edge_split1
      (&mark_cell *Col (:P *P_))
      (&run_axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

    (RULE &edge_split2
      (&mark_cell *Col (:P *P_))
      (&run_axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

    (RULE &edge_split3
      (&mark_cell *Col (:P *P2_))
      (&run_axis (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P2_) (:D D_m1) (:K *K1_m3))
      (margin (:B P2_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
      (relative (:Base X_m2_) (:X P2_) (:X_rel *L_)))

    ;; Within one line, a component is a run: a perpendicular step leaves the key.
    (INIT &runs Quotient
      (edge ((:a Col (:Line L) P) (:b Col (:Line L) (:P P3)))
        (OR ((&mark_cell *Col *P)
             (&run_axis *A)
             (&edge_split2 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
             (&runs_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&mark_cell Col (:P P3))
             (&run_axis (:A *A2))
             (&edge_split3 (:P2_ P3) (:A2_ A2) (:X_m2_ *X_m2) (:L_ L)))
            ((&mark_cell Col P)
             (&run_axis (:A *A3))
             (&edge_split1 (:P_ P) (:A_ A3) (:X_m1_ *X_m12) (:L_ L))
             (= P3 P)))))

    (RULE &runs_component
      (&runs.class (:a *Col *Line *P) *Id))

    (RULE &mark
      (&runs_component *Col *Id)))
  (ALT $Lines
    (DET &line_axis AxisDomain)

    (INIT &lines Quotient
      (equivalent ((:a P) (:b Q))
        (&mark_cell *Col *P)
        (&mark_cell Col (:P *Q))
        (&line_axis *A)
        (perp A (:A2 *A2_m1))
        (axis_of (:D *D_m2) (:A A2_m1))
        (margin (:B P) (:D D_m2) (:K *K_m3))
        (margin (:B Q) (:D D_m2) (:K K_m3))))

    (RULE &mark
      (&mark_cell *Col *P)
      (&lines.class (:a P) *Id))))

;; The marks the color's block starts after.
(INIT &preceding Cardinality
  (key ((&color_rank ^Col))
    (member ((:m Id))
      (&color_rank Col *R)
      (&color_rank (:Col *Col2) (:R *R2))
      (< R2 R)
      (&mark (:Col Col2) *Id))
    (domain ()
      (&color_rank Col))))

;; Those marks and the color's own — where its block ends.
(INIT &through Cardinality
  (key ((OR ((&preceding.member (:key ^Col) (:m *Id)))
            ((&mark Col Id))))
    (member ((:m Id))
      (OR ((&preceding.member (:m *Id)))
          ((&mark Col Id))))))

(RULE &slot
  (&reading.rank (:t *P) *R)
  (&preceding.size (:key *Col) (:N *S))
  (<= S R)
  (&through.size (:key Col) (:N *E))
  (< R E))

(RULE &output
  (&frame.cell *P)
  (OR ((&slot P *Col))
      ((NOT (&slot P))
       (&fill Col))))
