;; 358ba94e

(RULE &pieces_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &pieces Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&pieces_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &pieces_component
  (&pieces.class (:a *P) *Id))

;; Each square's own box: the crop frame, and the inside the punched cells sit in.
(INIT &bbox BoundingBox
  (key ((&pieces_component *P ^Id))
    (cell (P)
      (&pieces_component *P Id))))

(INIT &ink_count Cardinality
  (key ((&pieces_component *P ^Id))
    (member ((:m P))
      (&pieces_component *P Id))))

(RULE &score
  (&ink_count.size (:key *Id) *N))

(ALTS $choice "what the count runs over" $Ink
  (ALT $Holes
    (INIT &hole_count Cardinality
      (key ((OR ((&pieces_component ^Id))
                ((&bbox.box (:key Id) *B)
                 (input *P *Col)
                 (&bg (:C Col))
                 (ALL ((input P (:Col *Colm))
                       (&bbox.box (:key (:Id *Idm)) B)
                       (dir_elem (:D *D_m1))
                       (relative (:Base B) (:X P) (:X_rel *R_m2))
                       (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                      ((>= K_m3 0))))))
        (member ((:m P))
          (&bbox.box *B)
          (input *P *Col)
          (&bg (:C Col))
          (ALL ((input P (:Col *Colm))
                (&bbox.box (:key (:Id *Idm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0))))
        (domain ()
          (&pieces_component Id))))

    (RULE &score
      (&hole_count.size (:key *Id) *N)))
  (ALT $Cavities
    (RULE &cavity_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &cavity_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &cavity_cell
      (input *P *Col)
      (&bg (:C Col)))

    (INIT &cavity_flood Propagation
      (source ((:n P))
        (&cavity_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P *Col)
        (&bg (:C Col)))
      (edge ((:a P) (:b P2))
        (input *P *Col)
        (&bg (:C Col))
        (&cavity_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2) (:Col *Col2))
        (&bg (:C Col2))))

    (RULE &cavity_node
      (&cavity_cell *P)
      (NOT (&cavity_flood.reached (:n P))))

    (INIT &cavity Quotient
      (edge ((:a P) (:b P2))
        (OR ((&cavity_node *P)
             (&cavity_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&cavity_node (:P P2)))
            ((&cavity_node P)
             (= P2 P)))))

    (RULE &cavity_component
      (&cavity.class (:a *P) *Id))

    (INIT &cavity_count Cardinality
      (key ((&pieces_component ^Id))
        (member ((:m Id_reg))
          (&cavity_component *P (:Id *Id_reg))
          (dir_elem *D)
          (step_offset D (:V *V_m1))
          (compose (:A P) (:B V_m1) (:C *Q))
          (&pieces_component (:P Q) Id))
        (domain ()
          (&pieces_component Id))))

    (RULE &score
      (&cavity_count.size (:key *Id) *N))))

(RULE &shared
  (&score *Id *N)
  (&score (:Id *Id2) N)
  (!= Id Id2))

(RULE &output
  (&score *Id)
  (NOT (&shared Id))
  (&bbox.box (:key Id) *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
