;; 228f6490

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &wall SharedColor)

(RULE &shapes_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key)))
  (NOT (&wall (:C Key))))

;; The shapes: the loose pieces. A wall is a container, not a piece.
(INIT &shapes Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&shapes_node (:Key *Ky) *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&shapes_node (:Key Ky) (:P P2)))
        ((&shapes_node (:Key Ky) P)
         (= P2 P)))))

(RULE &shapes_component
  (&shapes.class (:a *Key *P) *Id))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_cell
  (input *P *Col)
  (NOT (&wall (:C Col))))

(INIT &closed_flood Propagation
  (source ((:n P))
    (&closed_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P *Col)
    (NOT (&wall (:C Col))))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (NOT (&wall (:C Col)))
    (&closed_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (NOT (&wall (:C Col2)))))

(RULE &closed_node
  (&closed_cell *P)
  (NOT (&closed_flood.reached (:n P))))

;; The holes: the regions the walls close off from the grid edge.
(INIT &closed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&closed_node *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:P P2)))
        ((&closed_node P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *P) *Id))

(RULE &hole
  (&closed_component *P (:Id *H)))

(RULE &shape
  (&shapes_component (:Key *Col) *P *Id))

(INIT &hbox BoundingBox
  (key ((&hole ^H *P))
    (cell (P)
      (&hole H *P))))

(INIT &sbox BoundingBox
  (key ((&shape ^Col ^Id *P))
    (cell (P)
      (&shape Col Id *P))))

;; Same footprint: the two sets fill their boxes alike.
(INIT &fits Inclusion
  (pattern ((:pattern H) (:m P_inner))
    (&hole *H *P)
    (&hbox.box (:key H) *B)
    (ALL ((&hole (:H *Hm) P)
          (&hbox.box (:key (:H Hm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner)))
  (observed ((:observed (:Col S_col) (:Id S_id)) (:m P_inner))
    (&shape (:Col *S_col) (:Id *S_id) *P)
    (&sbox.box (:key (:Col S_col) (:Id S_id)) *B)
    (ALL ((&shape (:Col *Sm_col) (:Id *Sm_id) P)
          (&sbox.box (:key (:Col Sm_col) (:Id Sm_id)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

;; The shape a color carries.
(INIT &color_shape Singleton
  (key ((&shapes_component (:Key ^Col) *Id))
    (member ((:v Id))
      (&shapes_component (:Key Col) *Id))))

(RULE &taken
  (&fits.equal (:observed *Col *Id) (:pattern *H))
  (NOT (&color_shape.plural (:key Col))))

(ALTS $choice "which shape moves, when several fit one hole" $Unique
  (ALT $AllFit
    (RULE &taken
      (&fits.equal (:observed *Col *Id) (:pattern *H))
      (ALL ((&shapes_component (:Key Col) (:Id *Idm)))
           ((&fits.equal (:observed Col (:Id Idm))))))))

(RULE &fill
  (&taken *H *Col)
  (&hole H *P))

(RULE &erase
  (&taken (:Col *S_col) (:Id *S_id))
  (&shape (:Col S_col) (:Id S_id) *P))

(RULE &output
  (OR ((&fill *P *Col))
      ((&erase P)
       (&bg (:C Col)))
      ((input P Col)
       (NOT (&fill P))
       (NOT (&erase P)))))
