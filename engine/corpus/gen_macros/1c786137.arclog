;; 1c786137

(RULE &color
  (input *Col))

(INIT &cbox BoundingBox
  (key ((input *P ^Col))
    (cell (P)
      (input *P Col))))

(RULE &misdrawn
  (OR ((&cbox.box (:key *Col) *B)
       (input *P)
       (ALL ((&cbox.box (:key (:Col *Colm)) B)
             (dir_elem (:D *D_m1m))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
            ((>= K_m3 0)))
       (margin (:B P) (:D *D_m1) (:K *K_m2))
       (margin B (:D D_m1) (:K K_m2))
       (NOT (input P Col)))
      ((&cbox.box (:key Col) (:B *B2))
       (input (:P *P2) Col)
       (ALL ((input (:P P2) (:Col *Colm2))
             (&cbox.box (:key (:Col Colm2)) (:B B2))
             (dir_elem (:D *D_m12))
             (relative (:Base B2) (:X P2) (:X_rel *R_m22))
             (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
            ((> K_m32 0))))))

(RULE &marker
  (&color *Col)
  (NOT (&misdrawn Col)))

(ALTS $choice "which color and structure count as the outline" $Rect
  (ALT $Solo
    (RULE &parts_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &parts Quotient
      (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
        (OR ((input *P *Col)
             (&parts_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) Col))
            ((input P Col)
             (= P3 P)))))

    (RULE &parts_component
      (&parts.class (:a *Key *P) *Id))

    (INIT &color_part Singleton
      (key ((&parts_component (:Key ^Col) *Id))
        (member ((:v Id))
          (&parts_component (:Key Col) *Id))))

    (RULE &marker
      (&color *Col)
      (NOT (&color_part.plural (:key Col)))))
  (ALT $Drawn
    (INIT &drect Outlines
      (key ((input *P ^Col))
        (node (P)
          (input *P Col))))

    (INIT &biggest_hole_count Cardinality
      (key ((&drect.box ^B))
        (member ((:m P))
          (input *P)
          (ALL ((dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((> K_m3 0))))))

    (INIT &biggest_hole Order
      (member ((:t B))
        (&biggest_hole_count.size (:key *B)))
      (score ((:t B) (:S N))
        (&biggest_hole_count.size (:key *B) *N)))

    (RULE &outline_box
      (&biggest_hole.maximal (:t *B))))
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&color (:Col *Key))
      (input *P (:Col *Col2))
      (!= Col2 Key))

    (RULE &closed_flood_node
      (&color (:Col *Key))
      (input *P (:Col *Col2))
      (!= Col2 Key))

    (INIT &closed_flood Propagation
      (key ((OR ((&closed_cell (:Key ^Ky) *P)
                 (dir_elem *D)
                 (margin (:B P) D (:K 0))
                 (&closed_flood_node (:Key Ky) P))
                ((&closed_flood_node (:Key Ky) P)
                 (&closed_flood_steps (:Delta *S))
                 (compose (:A P) (:B S) (:C *Q))
                 (&closed_flood_node (:Key Ky) (:P Q)))))
        (source ((:n P))
          (&closed_cell (:Key Ky) *P)
          (dir_elem *D)
          (margin (:B P) D (:K 0))
          (&closed_flood_node (:Key Ky) P))
        (edge ((:a P) (:b Q))
          (&closed_flood_node (:Key Ky) *P)
          (&closed_flood_steps (:Delta *S))
          (compose (:A P) (:B S) (:C *Q))
          (&closed_flood_node (:Key Ky) (:P Q)))))

    (RULE &closed_node
      (&closed_cell *Key *P)
      (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

    ;; Each color walls the rest of the grid off.
    (INIT &closed Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&closed_node (:Key *Ky) *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:Key Ky) (:P P2)))
            ((&closed_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *Key *P) *Id))

    (INIT &biggest_region_count Cardinality
      (key ((&closed_component (:Key ^Col) *P ^Id))
        (member ((:m P))
          (&closed_component (:Key Col) *P Id))))

    (INIT &biggest_region Order
      (member ((:t (:Col M_col) (:Id M_id)))
        (&biggest_region_count.size (:key (:Col *M_col) (:Id *M_id))))
      (score ((:t (:Col M_col) (:Id M_id)) (:S N))
        (&biggest_region_count.size (:key (:Col *M_col) (:Id *M_id)) *N)))

    (RULE &window
      (&biggest_region.maximal (:t *Col *Id))
      (&closed_component (:Key Col) *P Id))))

(RULE &outline_box
  (&marker *Col)
  (&cbox.box (:key Col) *B))

(RULE &window
  (&outline_box *B)
  (input *P)
  (ALL ((&outline_box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(INIT &window_bbox BoundingBox
  (cell (P)
    (&window *P)))

(RULE &output
  (&window_bbox.box *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (&window_bbox.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
