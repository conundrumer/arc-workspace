;; 39e1d7f9

(DET &bg SharedColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &lattice_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A divider is a drawn line that spans the grid.
(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &tile_color Singleton
  (key ((&lattice_tile_of *P ^P_tile)
        (input P *Col))
    (member ((:v Col))
      (&lattice_tile_of *P P_tile)
      (input P *Col))))

(RULE &ink
  (&tile_color.value (:key *P_tile) (:v *Col))
  (NOT (&bg (:C Col))))

(INIT &obj Quotient
  (edge ((:a P_tile) (:b P))
    (OR ((&ink *P_tile)
         (&obj_steps (:Delta *S))
         (compose (:A P_tile) (:B S) (:C *P))
         (&ink (:P_tile P)))
        ((&ink P_tile)
         (= P P_tile)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

;; An object's cell, when the object has just one; the motif clashes.
(INIT &obj_cell Singleton
  (key ((&obj_component (:P *P_tile) ^Id))
    (member ((:v P_tile))
      (&obj_component (:P *P_tile) Id))))

(RULE &motif
  (&obj_component (:P *P_tile) *Id)
  (&obj_cell.plural (:key Id))
  (&ink P_tile *Col))

(RULE &seed
  (&obj_cell.value (:v *P_tile)))

;; $Whole — every cell of the motif.
(RULE &footprint
  (&motif (:P_tile *P_tile_seat))
  (&motif (:P_tile *P_tile_motif) *Col)
  (relative (:Base P_tile_seat) (:X P_tile_motif) (:X_rel *V)))

;; $Match — the motif cell carrying the single cell's color.
(RULE &seat
  (&seed (:P_tile *P_tile_seed))
  (&ink (:P_tile P_tile_seed) *Col)
  (&motif (:P_tile *P_tile_seat) Col))

(ALTS $sp "what a copy carries" $Whole
  (ALT $Ring
    ;; $Ring — the cells beside the seating cell.
    (RULE &footprint
      (&motif (:P_tile *P_tile_seat))
      (dir8_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P_tile_seat) (:B V_m1) (:C *P_tile_motif))
      (&motif (:P_tile P_tile_motif) *Col)
      (step_offset D *V))))

(ALTS $st "which motif cell seats a copy" $Match
  (ALT $Unique
    ;; $Unique — the motif cell whose color no other motif cell carries.
    (INIT &color_cell Singleton
      (key ((&motif *P_tile ^Col))
        (member ((:v P_tile))
          (&motif *P_tile Col))))

    (RULE &seat
      (&seed (:P_tile *P_tile_seed))
      (&color_cell.value (:v *P_tile_seat))))
  (ALT $Center
    ;; $Center — the motif cell at the center of the motif's box.
    (INIT &motif_box BoundingBox
      (cell ((:P P_tile))
        (&motif *P_tile)))

    (RULE &seat
      (&seed (:P_tile *P_tile_seed))
      (&motif (:P_tile *P_tile_seat))
      (&motif_box.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P_tile_seat) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P_tile_seat) (:X_rel *P_inner))
      (ALL ((&motif_box.box (:B *Bm))
            (&motif (:P_tile *P_tile_seatm))
            (relative (:Base Bm) (:X P_tile_seatm) (:X_rel P_inner))
            (opposite (:D *D_m1m) (:Opp *O_m2))
            (margin (:B P_inner) (:D D_m1m) (:K *K1_m3))
            (margin (:B P_inner) (:D O_m2) (:K *K2_m4)))
           ((= K1_m3 K2_m4))))))

(RULE &paint
  (&seat *P_tile_seed *P_tile_seat)
  (&footprint P_tile_seat *V *Col)
  (compose (:A P_tile_seed) (:B V) (:C *P_tile)))

(RULE &paint_cell
  (&lattice_tile_of *P *P_tile)
  (&paint P_tile *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&paint_cell P *Col))
      ((NOT (&paint_cell P))
       (= Col Col_in))))
