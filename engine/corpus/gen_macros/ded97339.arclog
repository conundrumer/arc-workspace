;; ded97339

(RULE &ink_spans_dir
  (axis_elem *A)
  (axis4_of *D A))

(RULE &ink_spans_node
  (input *P))

(DET &ink RarestColor)

(RULE &ink_spans_source
  (input *P (:Col *Ink))
  (&ink (:C Ink)))

(INIT &ink_spans Distance
  (key ((&ink_spans_source (:P ^O))
        (&ink_spans_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&ink_spans_source (:P O))
           (&ink_spans_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&ink_spans_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ink_spans_node (:P Q)))
          ((&ink_spans_source (:P O))
           (&ink_spans_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&ink_spans_node (:P Q))
           (= A2 O))
          ((&ink_spans_source (:P O))
           (&ink_spans_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&ink_spans_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ink_spans_node (:P Q)))))
    (source ((:n O))
      (&ink_spans_source (:P O))
      (&ink_spans_dir D))))

(RULE &ink_spans_ray
  (&ink_spans.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &ink_spans_between
  (input *P)
  (axis_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&ink_spans_ray P D)
  (&ink_spans_ray P (:D O)))

(RULE &ink_spans_end
  (&ink_spans_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ink_spans_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(RULE &self_spans_mark
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(RULE &self_spans_axis
  (&self_spans_mark *Key)
  (axis_elem *A))

(RULE &self_spans_dir
  (&self_spans_axis *Key *A)
  (axis4_of *D A))

(RULE &self_spans_node
  (&self_spans_axis *Key)
  (input *P))

(RULE &self_spans_source
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &self_spans Distance
  (key ((&self_spans_source (:Key ^Ky) (:P ^O))
        (&self_spans_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&self_spans_source (:Key Ky) (:P O))
           (&self_spans_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&self_spans_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&self_spans_node (:Key Ky) (:P Q)))
          ((&self_spans_source (:Key Ky) (:P O))
           (&self_spans_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&self_spans_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&self_spans_source (:Key Ky) (:P O))
           (&self_spans_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&self_spans_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&self_spans_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&self_spans_source (:Key Ky) (:P O))
      (&self_spans_dir (:Key Ky) D))))

(RULE &self_spans_ray
  (&self_spans.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &self_spans_end
  (&self_spans_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&self_spans_ray Key (:P Q) D Origin)))

(ALTS $choice "which cells are marks" $Ink
  (ALT $Self
    (RULE &self_spans_between
      (&self_spans_mark *Key)
      (input *P)
      (&self_spans_axis Key *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&self_spans_ray Key P D)
      (&self_spans_ray Key P (:D O)))

    (RULE &output
      (OR ((&self_spans_between (:Key *Col) *P))
          ((input P Col)
           (NOT (&self_spans_between P)))))))

(RULE &output
  (OR ((&ink_spans_between *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&ink_spans_between P)))))
