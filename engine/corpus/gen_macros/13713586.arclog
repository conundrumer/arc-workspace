;; 13713586

(RULE &bars_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(DET &wall SharedColor)

(RULE &bars_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key)))
  (NOT (&wall (:C Key))))

(INIT &bars Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&bars_node (:Key *Ky) *P)
         (&bars_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&bars_node (:Key Ky) (:P P2)))
        ((&bars_node (:Key Ky) P)
         (= P2 P)))))

(RULE &bars_component
  (&bars.class (:a *Key *P) *Id))

(RULE &bar_cell
  (&bars_component (:Key *Col) *P *Id))

(RULE &wall_dir
  (dir_elem *D)
  (ALL ((input *P *Col)
        (margin (:B P) D (:K 0)))
       ((&wall (:C Col)))))

(RULE &shadow_dir
  (&bar_cell *Col *Id)
  (&wall_dir *D))

(RULE &shadow_dir_ray
  (&shadow_dir *Col *Id *D))

(RULE &shadow_node
  (&shadow_dir *Col *Id)
  (input *P))

(RULE &shadow_source
  (&bar_cell *Col *Id *P))

(INIT &shadow Distance
  (key ((&shadow_source (:Col ^Ky_col) (:Id ^Ky_id) (:P ^O))
        (&shadow_dir_ray (:Col Ky_col) (:Id Ky_id) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&shadow_source (:Col Ky_col) (:Id Ky_id) (:P O))
           (&shadow_dir_ray (:Col Ky_col) (:Id Ky_id) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&shadow_node (:Col Ky_col) (:Id Ky_id) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&shadow_node (:Col Ky_col) (:Id Ky_id) (:P Q)))
          ((&shadow_source (:Col Ky_col) (:Id Ky_id) (:P O))
           (&shadow_dir_ray (:Col Ky_col) (:Id Ky_id) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&shadow_node (:Col Ky_col) (:Id Ky_id) (:P Q))
           (= A2 O))
          ((&shadow_source (:Col Ky_col) (:Id Ky_id) (:P O))
           (&shadow_dir_ray (:Col Ky_col) (:Id Ky_id) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&shadow_node (:Col Ky_col) (:Id Ky_id) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&shadow_node (:Col Ky_col) (:Id Ky_id) (:P Q)))))
    (source ((:n O))
      (&shadow_source (:Col Ky_col) (:Id Ky_id) (:P O))
      (&shadow_dir_ray (:Col Ky_col) (:Id Ky_id) D))))

(RULE &shadow_ray
  (&shadow.distance (:key (:Ky_col *Col) (:Ky_id *Id) *D (:O *Origin)) (:n *P) *K))

(RULE &shadow_end
  (&shadow_ray *Col *Id *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&shadow_ray Col Id (:P Q) D Origin)))

(INIT &bar_box BoundingBox
  (key ((&bar_cell ^Col ^Id *P))
    (cell (P)
      (&bar_cell Col Id *P))))

(RULE &shadow_cell
  (&bar_cell *Col *Id)
  (input *P (:Col *Col2))
  (&bg (:C Col2)))

(INIT &paint Order
  (key ((&shadow_ray *Col *Id ^P)
        (&shadow_cell Col Id P)
        (&bar_box.box (:key Col Id) (:B *B_bar))
        (&wall_dir *D)
        (margin (:B B_bar) D *K))
    (member ((:t (:V Col) (:S K)))
      (&shadow_ray *Col *Id P)
      (&shadow_cell Col Id P)
      (&bar_box.box (:key Col Id) (:B *B_bar))
      (&wall_dir *D)
      (margin (:B B_bar) D *K))
    (score ((:t (:V Col) (:S K)) (:S K))
      (&shadow_ray *Col *Id P)
      (&shadow_cell Col Id P)
      (&bar_box.box (:key Col Id) (:B *B_bar))
      (&wall_dir *D)
      (margin (:B B_bar) D *K))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&paint.minimal (:key P))))
      ((&paint.minimal (:key P) (:t (:V Col))))))
