;; 84ba50d3

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &shape ChangedColor)

(INIT &shapes Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&shape (:C Col))
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&shape (:C Col2)))
        ((input P (:Col *Col3))
         (&shape (:C Col3))
         (= P3 P)))))

(RULE &shapes_component
  (&shapes.class (:a *P) *Id))

(DET &fall_dir DirDomain)

(RULE &mover
  (&shapes_component *Id))

(RULE &fall_dir2
  (&mover (:Id *Key))
  (&fall_dir *D))

(RULE &fall_axis
  (&fall_dir *D)
  (axis_of D *A))

(RULE &line_of_split1
  (input (:P *P_))
  (&fall_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &line_of
  (input *P)
  (&fall_axis *A)
  (&line_of_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &shape_row_cell
  (&shapes_component *P *Id)
  (&line_of P (:L *Row)))

(RULE &shift
  (input *P)
  (&fall_dir *D)
  (&fall_axis *A)
  (sub_extent P A *K)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta)))

(DET &divider ColorDomain)

;; The color of each line across the fall, when the line is uniform.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (&line_of P ^L))
    (member ((:v Col))
      (input *P *Col)
      (&line_of P L))))

(RULE &divider2
  (&line_color.value (:key *L) (:v *Col))
  (&divider (:C Col)))

(INIT &width Cardinality
  (key ((&shape_row_cell ^Id (:Row ^R) *P))
    (member ((:m P))
      (&shape_row_cell Id (:Row R) *P))))

(INIT &widest Order
  (key ((&width.size (:key ^Id *R) *N))
    (member ((:t (:V R) (:S N)))
      (&width.size (:key Id *R) *N))
    (score ((:t (:V R) (:S N)) (:S N))
      (&width.size (:key Id *R) *N))))

;; The widest row, when no other row ties it.
(INIT &unique_widest Singleton
  (key ((&widest.maximal (:key ^Id) (:t (:V *R))))
    (member ((:v R))
      (&widest.maximal (:t (:V *R))))))

(RULE &wide
  (&shape_row_cell *Id *Row *P)
  (&shape_row_cell Id Row (:P *Q))
  (!= P Q))

(RULE &stopped
  (&unique_widest.value (:key *Id) (:v *Row))
  (&wide Id Row))

(DET &bg DominantColor)

(RULE &divider_cell
  (&line_of *P *L)
  (&divider2 L))

(ALTS $choice "which row of a shape the divider stops it by" $Widest
  (ALT $Sieve
    (RULE &stopped
      (&wide *Id *Row))))

(RULE &through
  (&stopped *Id (:Row *R))
  (&shift *Delta)
  (compose (:A R) (:B Delta) (:C *R2))
  (&divider2 *L)
  (&fall_dir *D)
  (margin (:B R2) D *K)
  (margin (:B L) D (:K *K_div))
  (<= K K_div))

(RULE &fall_node
  (OR ((&mover (:Id *Key))
       (&shift (:Delta *P))
       (ALL ((&shape_row_cell (:Id Key) (:P *Pm))
             (compose (:A Pm) (:B P) (:C *Q)))
            ((input (:P Q))))
       (NOT (&through (:Id Key) (:Delta P))))
      ((&mover (:Id Key))
       (= P 0))))

(RULE &fall_node_ray
  (&fall_node *Key *P))

(RULE &fall_source
  (&fall_node *Key *P))

(INIT &fall Distance
  (key ((&fall_source (:Key ^Ky) (:P ^O))
        (&fall_dir2 (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&fall_source (:Key Ky) (:P O))
           (&fall_dir2 (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&fall_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&fall_node_ray (:Key Ky) (:P Q)))
          ((&fall_source (:Key Ky) (:P O))
           (&fall_dir2 (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&fall_node_ray (:Key Ky) (:P Q))
           (= A2 O))
          ((&fall_source (:Key Ky) (:P O))
           (&fall_dir2 (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&fall_node_ray (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&fall_node_ray (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&fall_source (:Key Ky) (:P O))
      (&fall_dir2 (:Key Ky) D))))

(RULE &fall_ray
  (&fall.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &fall_end
  (&fall_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&fall_ray Key (:P Q) D Origin)))

(RULE &landed
  (&fall_end (:Key *Id) (:P *Delta) (:Origin 0))
  (&shape_row_cell Id (:P *P2))
  (compose (:A P2) (:B Delta) (:C *P)))

(RULE &pierced
  (&divider_cell *P)
  (&landed (:P *Q))
  (&fall_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3))
  (&fall_dir *D)
  (dir_elem D)
  (margin (:B Q) D (:K *K1_m4))
  (margin (:B P) D (:K *K2_m5))
  (< K1_m4 K2_m5))

(RULE &standing
  (&divider_cell *P)
  (NOT (&pierced P)))

(RULE &output
  (input *P)
  (OR ((&landed P)
       (&shape (:C *Col)))
      ((&standing P)
       (NOT (&landed P))
       (&divider (:C Col)))
      ((NOT (&landed P))
       (NOT (&standing P))
       (&bg (:C Col)))))
