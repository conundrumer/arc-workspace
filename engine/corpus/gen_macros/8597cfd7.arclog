;; 8597cfd7

(RULE &panels_divider_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(DET &sep VanishedColor)

(DET &side DirDomain)

(RULE &panels_divider
  (input *P *Col)
  (&sep (:C Col))
  (&side *D)
  (axis_of D *A)
  (&panels_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; The panels the separator cuts, stacked along &side's axis.
(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &side_of
  (&side *D)
  (axis_of D *A)
  (axis_of (:D *S) A)
  (&panels_part_idx *P (:D S) (:N 0)))

(RULE &slice_of_split1
  (input (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *R_))
  (relative (:Base R_) (:X P_) (:X_rel *X_m1_)))

(RULE &slice_of
  (input *P)
  (&side *D)
  (axis_of D *A)
  (&slice_of_split1 (:P_ P) (:A_ A) (:R_ *R) (:X_m1_ *X_m1)))

(RULE &ink_slice
  (input *P *Col)
  (&side_of P *S)
  (&slice_of P *R))

(RULE &spans_dir
  (&ink_slice *Col *S)
  (&side (:D *D3))
  (axis_of (:D D3) *A)
  (axis4_of *D A))

(RULE &spans_node
  (&ink_slice *Col *S)
  (&side *D)
  (axis_of D *A)
  (input *P))

(RULE &spans_source
  (&ink_slice *Col *S (:R *P)))

(INIT &spans Distance
  (key ((&spans_source (:Col ^Ky_col) (:S ^Ky_s) (:P ^O))
        (&spans_dir (:Col Ky_col) (:S Ky_s) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&spans_source (:Col Ky_col) (:S Ky_s) (:P O))
           (&spans_dir (:Col Ky_col) (:S Ky_s) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&spans_node (:Col Ky_col) (:S Ky_s) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&spans_node (:Col Ky_col) (:S Ky_s) (:P Q)))
          ((&spans_source (:Col Ky_col) (:S Ky_s) (:P O))
           (&spans_dir (:Col Ky_col) (:S Ky_s) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&spans_node (:Col Ky_col) (:S Ky_s) (:P Q))
           (= A2 O))
          ((&spans_source (:Col Ky_col) (:S Ky_s) (:P O))
           (&spans_dir (:Col Ky_col) (:S Ky_s) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&spans_node (:Col Ky_col) (:S Ky_s) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&spans_node (:Col Ky_col) (:S Ky_s) (:P Q)))))
    (source ((:n O))
      (&spans_source (:Col Ky_col) (:S Ky_s) (:P O))
      (&spans_dir (:Col Ky_col) (:S Ky_s) D))))

(RULE &spans_ray
  (&spans.distance (:key (:Ky_col *Col) (:Ky_s *S) *D (:O *Origin)) (:n *P) *K))

(RULE &spans_end
  (&spans_ray *Col *S *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&spans_ray Col S (:P Q) D Origin)))

(DET &out_dim ConstOutDim)

(RULE &measure_member
  (input (:P *M) *Col)
  (&side_of (:P M) *S))

(INIT &frame Frame
  (extent (A N)
    (axis_elem *A)
    (&out_dim *N)))

(ALTS $choice "how a bar's length is measured" $Count
  (ALT $Span
    (RULE &spans_between
      (&ink_slice *Col *S)
      (&slice_of (:R *P))
      (&side *D)
      (axis_of D *A)
      (axis4_of (:D *D2) A)
      (dir8_opposite (:D D2) (:D2 *O))
      (&spans_ray Col S P (:D D2))
      (&spans_ray Col S P (:D O)))

    (RULE &measure_member
      (&spans_between *Col *S (:P *M)))))

(INIT &growth Excess
  (key ((OR ((&measure_member ^Col *S *M)
             (&side *D)
             (opposite D (:Opp S)))
            ((&measure_member Col (:S D) M)
             (&side D))))
    (plus ((:m M))
      (&measure_member Col *S *M)
      (&side *D)
      (opposite D (:Opp S)))
    (minus ((:m M))
      (&measure_member Col (:S *D) *M)
      (&side D))))

;; The winner: the color that grows the most.
(INIT &winner Order
  (member ((:t (:V Col) (:S N)))
    (&growth.excess (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&growth.excess (:key *Col) *N)))

(RULE &output
  (&frame.cell *P)
  (&winner.maximal (:t (:V *Col))))
