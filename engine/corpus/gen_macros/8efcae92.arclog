;; 8efcae92

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg VanishedColor)

;; A rectangle is a component of the non-bg cells.
(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(DET &mark RarestColor)

(INIT &winner_count Cardinality
  (key ((&comps_component *P ^Id)
        (input P *Col)
        (&mark (:C Col)))
    (member ((:m P))
      (&comps_component *P Id)
      (input P *Col)
      (&mark (:C Col)))))

(INIT &winner Order
  (member ((:t Id))
    (&winner_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&winner_count.size (:key *Id) *N)))

(INIT &view BoundingBox
  (cell (P)
    (&winner.maximal (:t *Id))
    (&comps_component *P Id)))

(RULE &output
  (input (:P *P2) *Col)
  (&view.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
