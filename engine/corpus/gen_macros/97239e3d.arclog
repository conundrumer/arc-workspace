;; 97239e3d

(RULE &reach_dir
  (dir_elem *D))

(RULE &reach_node
  (input *P))

(DET &bg DominantColor)

(DET &wall SharedColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&wall (:C Col))))

(RULE &reach_source
  (&mark *P))

;; Each mark casts along its four directions, reaching the crossings of its
;; street at their distances.
(INIT &reach Distance
  (key ((&reach_source (:P ^O))
        (&reach_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&reach_source (:P O))
           (&reach_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&reach_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&reach_node (:P Q)))
          ((&reach_source (:P O))
           (&reach_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&reach_node (:P Q))
           (= A2 O))
          ((&reach_source (:P O))
           (&reach_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&reach_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&reach_node (:P Q)))))
    (source ((:n O))
      (&reach_source (:P O))
      (&reach_dir D))))

(RULE &reach_ray
  (&reach.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &reach_end
  (&reach_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&reach_ray (:P Q) D Origin)))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_cell
  (input *P *Col)
  (NOT (&wall (:C Col))))

(INIT &closed_flood Propagation
  (source ((:n P))
    (&closed_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P *Col)
    (NOT (&wall (:C Col))))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (NOT (&wall (:C Col)))
    (&closed_flood_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (NOT (&wall (:C Col2)))))

(RULE &closed_node
  (&closed_cell *P)
  (NOT (&closed_flood.reached (:n P))))

;; A ring's hole is the bg it closes off from the grid edge.
(INIT &closed Quotient
  (edge ((:a P) (:b P2))
    (OR ((&closed_node *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:P P2)))
        ((&closed_node P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *P) *Id))

(RULE &wall_line_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &street_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &crossing_split1
  (input (:P *P_))
  (perp (:A *A_) *A2)
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &crossing_split2
  (input (:P *P_))
  (perp *A (:A2 *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
  (relative (:Base L2_) (:X P_) (:X_rel *X_m2_)))

(RULE &wall_line
  (input *P *Col)
  (&wall (:C Col))
  (axis_elem *A)
  (&wall_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &street
  (input *P)
  (axis_elem *A)
  (&street_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (NOT (&wall_line A L)))

(RULE &crossing
  (input *P)
  (perp *A *A2)
  (&crossing_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (&street A L)
  (&crossing_split2 (:P_ P) (:A2_ A2) (:L2_ *L2) (:X_m2_ *X_m2))
  (&street (:A A2) (:L L2)))

(RULE &anchor
  (&mark (:P *M) *Col)
  (&crossing *P)
  (OR ((= P M))
      ((dir_elem *D)
       (step_offset D (:V *V_m1))
       (compose (:A M) (:B V_m1) (:C P)))))

(ALTS $choice "how the marks of a color delimit their box" $Touch
  (ALT $Nearest
    (INIT &closest Order
      (key ((&reach_ray *P *K (:Origin ^M))
            (&crossing P))
        (member ((:t (:V P) (:S K)))
          (&reach_ray *P *K (:Origin M))
          (&crossing P))
        (score ((:t (:V P) (:S K)) (:S K))
          (&reach_ray *P *K (:Origin M))
          (&crossing P))))

    (RULE &anchor
      (&mark (:P *M) *Col)
      (&closest.minimal (:key M) (:t (:V *P)))))
  (ALT $Contain
    ;; The d side is the innermost street that no mark of the color lies beyond.
    (INIT &inset Order
      (key ((&mark ^Col)
            (axis_of ^D *A)
            (&street A *L)
            (margin (:B L) D *K)
            (ALL ((&mark (:P *M) Col)
                  (axis_of D (:A *Am))
                  (&street (:A Am) L)
                  (margin (:B M) D (:K *K1_m1))
                  (margin (:B L) D (:K *K2_m2)))
                 ((>= K1_m1 K2_m2))))
        (member ((:t K))
          (&mark Col)
          (axis_of D *A)
          (&street A *L)
          (margin (:B L) D *K)
          (ALL ((&mark (:P *M) Col)
                (axis_of D (:A *Am))
                (&street (:A Am) L)
                (margin (:B M) D (:K *K1_m1))
                (margin (:B L) D (:K *K2_m2)))
               ((>= K1_m1 K2_m2))))
        (score ((:t K) (:S K))
          (&mark Col)
          (axis_of D *A)
          (&street A *L)
          (margin (:B L) D *K)
          (ALL ((&mark (:P *M) Col)
                (axis_of D (:A *Am))
                (&street (:A Am) L)
                (margin (:B M) D (:K *K1_m1))
                (margin (:B L) D (:K *K2_m2)))
               ((>= K1_m1 K2_m2))))))

    (RULE &frame_axis
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&inset.maximal (:key (:Col *Key) D) (:t *K))
      (&inset.maximal (:key (:Col Key) (:D D2)) (:t *K2))
      (opposite D (:Opp *O_m1))
      (edge_inset D K (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B)))

    (RULE &frame
      (&frame_axis *Key *A (:B *B1))
      (perp A *A2)
      (&frame_axis Key (:A A2) (:B *B2))
      (compose (:A B1) (:B B2) (:C *B)))

    (RULE &span_box
      (&frame (:Key *Col) *B))))

(INIT &span BoundingBox
  (key ((&anchor ^Col *P))
    (cell (P)
      (&anchor Col *P))))

(RULE &span_box
  (&span.box (:key *Col) *B))

(RULE &painted
  (&span_box *Col *B)
  (input *P)
  (ALL ((&span_box (:Col *Colm) B)
        (dir_elem (:D *D_m1m))
        (relative (:Base B) (:X P) (:X_rel *R_m2m))
        (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (OR ((dir_elem (:D *D_m1))
       (relative (:Base B) (:X P) (:X_rel *R_m2))
       (margin (:B R_m2) (:D D_m1) (:K *K_m3))
       (<= K_m3 0))
      ((&closed_component P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
