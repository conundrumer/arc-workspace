;; 136b0064

(DET &bg DominantColor)

(RULE &cell
  (input *P *Col))

(DET &glyph_gap DivisorRatio)

(DET &glyph_size TileCount)

(DET &drawn
  (ex_output *E))

(DET &far_cell_division_cell
  (ex_input *P)
  (dir_elem (:D *Key)))

;; The divider is the gap between the panels.
(DET &divide_gap DivisorRatio)

(DET &far_cell_division_gap
  (dir_elem (:D *Key))
  (axis_of (:D Key) *A)
  (&divide_gap (:K *G)))

(DET &divisor SepTileCount)

(DET &far_cell_division_parts
  (dir_elem (:D *Key))
  (axis_of (:D Key) *A)
  (&divisor *N))

(INIT &far_cell_division_sides ExtentDivisions
  (key ((&far_cell_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&far_cell_division_cell (:Key Ky) *P))))

(DET &far_cell_division_axis_split1
  (&far_cell_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &far_cell_division_axis
  (OR ((&far_cell_division_cell *Key *P)
       (&far_cell_division_parts Key *A *N)
       (&far_cell_division_gap Key A *G)
       (&far_cell_division_sides.division (:key (:Ky Key)) A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&far_cell_division_cell Key P)
       (&far_cell_division_parts Key A (:N *N2))
       (&far_cell_division_gap Key A (:G *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&far_cell_division_cell Key P)
       (&far_cell_division_parts Key A (:N *N3))
       (NOT (&far_cell_division_gap Key A))
       (&far_cell_division_sides.division (:key (:Ky Key)) A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((&far_cell_division_cell Key P)
       (&far_cell_division_parts Key A (:N *N4))
       (NOT (&far_cell_division_gap Key A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((&far_cell_division_cell Key P)
       (axis_elem A)
       (NOT (&far_cell_division_parts Key A))
       (&far_cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &far_cell_division_tile
  (&far_cell_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&far_cell_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &far_cell
  (ex_input *E *P *Col)
  (&far_cell_division_tile (:Key *D) P *P_outer)
  (opposite D (:Opp *D2))
  (margin (:B P_outer) (:D D2) (:K 0)))

(DET &marker RarestColor)

(DET &side_defect
  (dir_elem *D)
  (&drawn *E)
  (OR ((&marker (:C *M))
       (NOT (&far_cell E D (:Col M))))
      ((&far_cell E D *Col)
       (NOT (&bg (:C Col)))
       (NOT (&marker (:C Col))))))

(DET &legend_dir
  (dir_elem *D)
  (NOT (&side_defect D)))

(INIT &parse_division3_sides ExtentDivisions
  (frame (P)
    (ex_input *P)))

(DET &parse_division3_gap
  (&legend_dir *D)
  (axis_of D *A)
  (&divide_gap (:K *G)))

(DET &parse_division3_axis_split1
  (ex_input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &parse_division3_parts
  (&legend_dir *D)
  (axis_of D *A)
  (&divisor *N))

(DET &parse_division3_axis
  (OR ((ex_input *P)
       (&legend_dir *D)
       (axis_of D *A)
       (&divisor *N)
       (&legend_dir (:D *D2))
       (axis_of (:D D2) A)
       (&divide_gap (:K *G))
       (&parse_division3_sides.division A N *K G)
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O))
       (margin (:B P) (:D D3) (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite (:D D3) (:Opp *O_m1))
       (edge_inset (:D D3) (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite (:D D3) (:Opp *O_m4))
       (edge_inset (:D D3) (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input P)
       (&legend_dir (:D *D4))
       (axis_of (:D D4) A)
       (&divisor (:N *N2))
       (&legend_dir (:D *D22))
       (axis_of (:D D22) A)
       (&divide_gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D32) A)
       (opposite (:D D32) (:Opp *O2))
       (margin (:B P) (:D D32) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D32) (:Opp *O_m12))
       (edge_inset (:D D32) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D32) (:Opp *O_m42))
       (edge_inset (:D D32) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((ex_input P)
       (&legend_dir (:D *D5))
       (axis_of (:D D5) A)
       (&divisor (:N *N3))
       (NOT (&parse_division3_gap A))
       (&parse_division3_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D23) A)
       (opposite (:D D23) (:Opp *O3))
       (margin (:B P) (:D D23) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D23) (:Opp *O_m13))
       (edge_inset (:D D23) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D23) (:Opp *O_m43))
       (edge_inset (:D D23) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((ex_input P)
       (&legend_dir (:D *D6))
       (axis_of (:D D6) A)
       (&divisor (:N *N4))
       (NOT (&parse_division3_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D24) A)
       (opposite (:D D24) (:Opp *O4))
       (margin (:B P) (:D D24) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D24) (:Opp *O_m14))
       (edge_inset (:D D24) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D24) (:Opp *O_m44))
       (edge_inset (:D D24) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((ex_input P)
       (axis_elem A)
       (NOT (&parse_division3_parts A))
       (&parse_division3_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &parse_division3_tile
  (&parse_division3_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&parse_division3_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &panel2
  (ex_input *E (:P *P_grid))
  (&parse_division3_tile (:P P_grid) *P_outer (:P_inner *P_panel)))

(DET &legend2
  (&panel2 *E *P_grid *P_outer *P_panel)
  (&legend_dir *D)
  (margin (:B P_outer) D (:K 0)))

(RULE &glyph_cell_division_gap
  (axis_elem *A)
  (&glyph_gap (:K *G)))

(DET &glyph_cell_division_axis_split12
  (&legend2 (:P_panel *P_panel_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_panel_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_panel_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_panel_) (:X_rel *X_m1_)))

(RULE &glyph_cell_division_side
  (axis_elem *A)
  (&glyph_size (:N *K)))

(DET &glyph_cell_division_axis2
  (OR ((&legend2 (:P_panel *P))
       (axis_elem *A)
       (&glyph_size (:N *Sz))
       (&glyph_gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side Sz) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side Sz) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N Sz)))
      ((&legend2 (:P_panel P))
       (axis_elem A)
       (&glyph_size (:N *Sz2))
       (NOT (&glyph_cell_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side Sz2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side Sz2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N Sz2)))
      ((&legend2 (:P_panel P))
       (axis_elem A)
       (NOT (&glyph_cell_division_side A))
       (&glyph_cell_division_axis_split12 (:P_panel_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &glyph_cell_division_tile2
  (&glyph_cell_division_axis2 *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&glyph_cell_division_axis2 P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &glyph_cell2
  (&legend2 *E (:P_grid *P) *P_panel)
  (&cell E P *Col)
  (NOT (&bg (:C Col)))
  (&glyph_cell_division_tile2 (:P P_panel) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &glyph_color2
  (&glyph_cell2 *E (:P_tile *T) *Col))

(DET &stroke_cell
  (&glyph_color2 *E *T *Col)
  (ex_output E *P Col))

(DET &run_dir_ray
  (&stroke_cell *E *T)
  (dir_elem *D))

(DET &run_node
  (&stroke_cell *E *T *P))

(DET &run_source
  (&stroke_cell *E *T *P))

;; The move tables record the stroke's direction, so runs are taken in
;; every direction.
(INIT &run Distance
  (key ((&run_source (:E ^Ky_e) (:T ^Ky_t) (:P ^O))
        (&run_dir_ray (:E Ky_e) (:T Ky_t) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&run_source (:E Ky_e) (:T Ky_t) (:P O))
           (&run_dir_ray (:E Ky_e) (:T Ky_t) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&run_node (:E Ky_e) (:T Ky_t) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&run_node (:E Ky_e) (:T Ky_t) (:P Q)))
          ((&run_source (:E Ky_e) (:T Ky_t) (:P O))
           (&run_dir_ray (:E Ky_e) (:T Ky_t) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&run_node (:E Ky_e) (:T Ky_t) (:P Q))
           (= A2 O))
          ((&run_source (:E Ky_e) (:T Ky_t) (:P O))
           (&run_dir_ray (:E Ky_e) (:T Ky_t) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&run_node (:E Ky_e) (:T Ky_t) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&run_node (:E Ky_e) (:T Ky_t) (:P Q)))))
    (source ((:n O))
      (&run_source (:E Ky_e) (:T Ky_t) (:P O))
      (&run_dir_ray (:E Ky_e) (:T Ky_t) D))))

(DET &run_ray
  (&run.distance (:key (:Ky_e *E) (:Ky_t *T) *D (:O *Origin)) (:n *P) *K))

(DET &run_end
  (&run_ray *E *T *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray E T (:P Q) D Origin)))

(INIT &parse_division_sides ExtentDivisions
  (frame (P)
    (input *P)))

(RULE &parse_division_gap
  (&legend_dir *D)
  (axis_of D *A)
  (&divide_gap (:K *G)))

(RULE &parse_division_axis_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &parse_division_parts
  (&legend_dir *D)
  (axis_of D *A)
  (&divisor *N))

(RULE &parse_division_axis
  (OR ((input *P)
       (&legend_dir *D)
       (axis_of D *A)
       (&divisor *N)
       (&legend_dir (:D *D2))
       (axis_of (:D D2) A)
       (&divide_gap (:K *G))
       (&parse_division_sides.division A N *K G)
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O))
       (margin (:B P) (:D D3) (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite (:D D3) (:Opp *O_m1))
       (edge_inset (:D D3) (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite (:D D3) (:Opp *O_m4))
       (edge_inset (:D D3) (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&legend_dir (:D *D4))
       (axis_of (:D D4) A)
       (&divisor (:N *N2))
       (&legend_dir (:D *D22))
       (axis_of (:D D22) A)
       (&divide_gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D32) A)
       (opposite (:D D32) (:Opp *O2))
       (margin (:B P) (:D D32) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D32) (:Opp *O_m12))
       (edge_inset (:D D32) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D32) (:Opp *O_m42))
       (edge_inset (:D D32) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&legend_dir (:D *D5))
       (axis_of (:D D5) A)
       (&divisor (:N *N3))
       (NOT (&parse_division_gap A))
       (&parse_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D23) A)
       (opposite (:D D23) (:Opp *O3))
       (margin (:B P) (:D D23) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D23) (:Opp *O_m13))
       (edge_inset (:D D23) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D23) (:Opp *O_m43))
       (edge_inset (:D D23) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&legend_dir (:D *D6))
       (axis_of (:D D6) A)
       (&divisor (:N *N4))
       (NOT (&parse_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D24) A)
       (opposite (:D D24) (:Opp *O4))
       (margin (:B P) (:D D24) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D24) (:Opp *O_m14))
       (edge_inset (:D D24) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D24) (:Opp *O_m44))
       (edge_inset (:D D24) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&parse_division_parts A))
       (&parse_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &parse_division_tile
  (&parse_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&parse_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &panel
  (&parse_division_tile (:P *P_grid) *P_outer (:P_inner *P_panel)))

(DET &step_ok
  (ex_output *E *P (:Col *M))
  (&marker (:C M))
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *P2))
  (ex_output E (:P P2) *Col)
  (NOT (&bg (:C Col))))

(DET &step_defect
  (dir_elem *D)
  (&drawn *E)
  (NOT (&step_ok E D)))

(DET &advance
  (dir_elem *D)
  (NOT (&step_defect D)))

(DET &glyph2
  (&glyph_cell2 *E (:P_tile *T)))

(DET &order_axis AxisDomain)

(DET &order_corner DiagDirDomain)

(INIT &order2 Order
  (key ((&glyph2 ^E *T))
    (member ((:t T))
      (&glyph2 E *T))
    (before ((:a T) (:b T2))
      (&glyph2 E *T)
      (&glyph2 E (:T *T2))
      (&glyph2 E)
      (&order_corner *D)
      (&order_axis *A)
      (OR ((corner_dir (:C D) A (:D *D2))
           (dir_elem (:D D2))
           (margin (:B T) (:D D2) (:K *K1_m1))
           (margin (:B T2) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C D) A (:D D2))
           (perp A (:A2 *A2_m3))
           (corner_dir (:C D) (:A A2_m3) (:D *D22))
           (margin (:B T) (:D D2) (:K *K_m4))
           (margin (:B T2) (:D D2) (:K K_m4))
           (dir_elem (:D D22))
           (margin (:B T) (:D D22) (:K *K1_m5))
           (margin (:B T2) (:D D22) (:K *K2_m6))
           (< K1_m5 K2_m6))))))

(DET &run_dir
  (&stroke_cell *E *T)
  (dir_elem *D))

(DET &run_len
  (&run_ray *E *T *P *D (:K *N) (:Origin *P0))
  (> N 0)
  (axis_of D *A)
  (sub_extent (:P P0) A *K)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset D K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P0) (:B V_m1) (:C P)))

(INIT &run_rim Boundary
  (key ((&stroke_cell ^E ^T *P))
    (cell (P)
      (&stroke_cell E T *P)))
  (dir (D)
    (&stroke_cell *E *T)
    (dir_elem *D)))

(DET &fit
  (&run_len *E *T *P0 *D *K *P)
  (OR ((&order2.successor (:key E) (:a T) (:b *T2))
       (&advance (:D *Da))
       (step_offset (:D Da) (:V *V_m1))
       (compose (:A P) (:B V_m1) (:C *P2))
       (&stroke_cell E (:T T2) (:P P2)))
      ((&order2.maximal (:key E) (:t T))
       (&run_rim.exposed (:key E T) P D)
       (&run_dir E T D))))

(DET &canvas2
  (&panel2 *E *P_grid *P_outer (:P_panel *P_canvas))
  (&legend_dir *D)
  (opposite D (:Opp *D_out))
  (margin (:B P_outer) (:D D_out) (:K 0)))

(DET &marker_cell2
  (&canvas2 *E (:P_grid *P) *P_canvas)
  (&cell E P *Col)
  (&marker (:C Col)))

;; The pen's walk: it stands on the marker before the first glyph, and
;; after each glyph's stroke on the end of a run the stroke can take.
(INIT &walk Propagation
  (key ((OR ((&drawn ^E)
             (&order2.minimal (:key E) (:t *T))
             (&marker_cell2 E (:P_canvas *P)))
            ((&order2.successor (:key E) (:a *T1) (:b *T2))
             (&fit E (:T T1) *P0 (:P *P2))
             (&advance (:D *Da))
             (opposite (:D Da) (:Opp *Db))
             (step_offset (:D Db) (:V *V_m1))
             (compose (:A P0) (:B V_m1) (:C P)))))
    (source ((:n T P))
      (&drawn E)
      (&order2.minimal (:t *T))
      (&marker_cell2 E (:P_canvas *P)))
    (edge ((:a (:T T1) P) (:b (:T T2) (:P P2)))
      (&order2.successor (:a *T1) (:b *T2))
      (&fit E (:T T1) *P0 (:P *P2))
      (&advance (:D *Da))
      (opposite (:D Da) (:Opp *Db))
      (step_offset (:D Db) (:V *V_m1))
      (compose (:A P0) (:B V_m1) (:C *P)))))

(DET &drew
  (&walk.reached (:key *E) (:n *T (:P *P0)))
  (&advance (:D *Da))
  (step_offset (:D Da) (:V *V_m1))
  (compose (:A P0) (:B V_m1) (:C *P1))
  (&fit E T (:P0 P1) *D *K *P))

(INIT &tally2 Cardinality
  (key ((&glyph_cell2 (:E ^K) (:P_tile ^T) *P_intile))
    (member ((:m P_intile))
      (&glyph_cell2 (:E K) (:P_tile T) *P_intile))))

(DET &glyph_count2
  (&tally2.size (:key (:K *E) *T) *N))

(DET &count_cand
  (&glyph_count2 *E *T *N)
  (&drew E T *D *K))

(DET &occurrence
  (&drawn *E)
  (&glyph2 E *T))

(DET &count_defect
  (&count_cand *N *D *K)
  (&occurrence *E *T)
  (&glyph_count2 E T N)
  (NOT (&drew E T D K)))

(DET &count_move
  (&count_cand *N *D *K)
  (NOT (&count_defect N D K)))

(ALTS $m "what identifies a glyph" $Count
  (ALT $Glyph
    (DET &footprint
      (&occurrence *E *T)
      (&glyph_cell2 E (:P_tile T) (:P_intile *P)))

    (INIT &same Inclusion
      (pattern ((:pattern (:E G_e) (:T G_t)) (:m P))
        (&footprint (:E *G_e) (:T *G_t) *P))
      (observed ((:observed (:E G_e) (:T G_t)) (:m P))
        (&footprint (:E *G_e) (:T *G_t) *P)))

    (INIT &shape Quotient
      (equivalent ((:a (:E G_e) (:T G_t)) (:b (:E G2_e) (:T G2_t)))
        (&same.equal (:observed (:E *G_e) (:T *G_t)) (:pattern (:E *G2_e) (:T *G2_t)))))

    (DET &glyph_member
      (&shape.class (:a (:E *G_e) (:T *G_t)) *Id)
      (&footprint (:E G_e) (:T G_t) *P))

    (INIT &glyph_match Inclusion
      (pattern ((:pattern Id) (:m P_intile))
        (&glyph_member *Id (:P *P_intile)))
      (observed ((:observed T) (:m P_intile))
        (&glyph_cell (:P_tile *T) *P_intile)))

    (DET &glyph_cand
      (&shape.class (:a *E *T) *Id)
      (&drew E T *D *K))

    (DET &glyph_defect
      (&glyph_cand *Id *D *K)
      (&shape.class (:a *E *T) Id)
      (NOT (&drew E T D K)))

    (DET &glyph_move
      (&glyph_cand *Id *D *K)
      (NOT (&glyph_defect Id D K)))

    (RULE &move
      (&glyph_match.equal (:observed *T) (:pattern *Id))
      (&glyph_move Id *D *K)))
  (ALT $Color
    (DET &color_cand
      (&glyph_color2 *E *T *Col)
      (&drew E T *D *K))

    (DET &color_defect
      (&color_cand *Col *D *K)
      (&occurrence *E *T)
      (&glyph_color2 E T Col)
      (NOT (&drew E T D K)))

    (DET &color_move
      (&color_cand *Col *D *K)
      (NOT (&color_defect Col D K)))

    (RULE &move
      (&glyph_color *T *Col)
      (&color_move Col *D *K))))

(ALTS $d "decompose — how the divider cuts the grid into panels" $TileCount
  (ALT $Size
    (DET &panel_size ConstOutDim)

    (RULE &parse_division2_gap
      (&legend_dir *D)
      (axis_of D *A)
      (&divide_gap (:K *G)))

    (RULE &parse_division2_axis_split1
      (input (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &parse_division2_side
      (&legend_dir *D)
      (axis_of D *A)
      (&panel_size (:N *K)))

    (RULE &parse_division2_axis
      (OR ((input *P)
           (&legend_dir *D)
           (axis_of D *A)
           (&panel_size (:N *K))
           (&legend_dir (:D *D2))
           (axis_of (:D D2) A)
           (&divide_gap (:K *G))
           (axis_of (:D *D3) A)
           (opposite (:D D3) (:Opp *O))
           (margin (:B P) (:D D3) (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite (:D D3) (:Opp *O_m1))
           (edge_inset (:D D3) (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite (:D D3) (:Opp *O_m4))
           (edge_inset (:D D3) (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&legend_dir (:D *D4))
           (axis_of (:D D4) A)
           (&panel_size (:N *K2))
           (NOT (&parse_division2_gap A))
           (axis_of (:D *D22) A)
           (opposite (:D D22) (:Opp *O2))
           (margin (:B P) (:D D22) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D22) (:Opp *O_m12))
           (edge_inset (:D D22) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D22) (:Opp *O_m42))
           (edge_inset (:D D22) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&parse_division2_side A))
           (&parse_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &parse_division2_tile
      (&parse_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&parse_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &panel
      (&parse_division2_tile (:P *P_grid) *P_outer (:P_inner *P_panel)))))

(RULE &canvas
  (&panel *P_grid *P_outer (:P_panel *P_canvas))
  (&legend_dir *D)
  (opposite D (:Opp *D_out))
  (margin (:B P_outer) (:D D_out) (:K 0)))

(RULE &legend
  (&panel *P_grid *P_outer *P_panel)
  (&legend_dir *D)
  (margin (:B P_outer) D (:K 0)))

(RULE &glyph_cell_division_axis_split1
  (&legend (:P_panel *P_panel_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_panel_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_panel_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_panel_) (:X_rel *X_m1_)))

(RULE &glyph_cell_division_axis
  (OR ((&legend (:P_panel *P))
       (axis_elem *A)
       (&glyph_size (:N *Sz))
       (&glyph_gap (:K *G))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side Sz) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side Sz) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N Sz)))
      ((&legend (:P_panel P))
       (axis_elem A)
       (&glyph_size (:N *Sz2))
       (NOT (&glyph_cell_division_gap A))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side Sz2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side Sz2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N Sz2)))
      ((&legend (:P_panel P))
       (axis_elem A)
       (NOT (&glyph_cell_division_side A))
       (&glyph_cell_division_axis_split1 (:P_panel_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &glyph_cell_division_tile
  (&glyph_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&glyph_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &glyph_cell
  (&legend (:P_grid *P) *P_panel)
  (&cell P *Col)
  (NOT (&bg (:C Col)))
  (&glyph_cell_division_tile (:P P_panel) (:P_outer *P_tile) (:P_inner *P_intile)))

(INIT &tally Cardinality
  (key ((&glyph_cell (:P_tile ^T) *P_intile))
    (member ((:m P_intile))
      (&glyph_cell (:P_tile T) *P_intile))))

(RULE &glyph_count
  (&tally.size (:key *T) *N))

(RULE &move
  (&glyph_count *T *N)
  (&count_move N *D *K))

(RULE &marker_cell
  (&canvas (:P_grid *P) *P_canvas)
  (&cell P *Col)
  (&marker (:C Col)))

(RULE &glyph
  (&glyph_cell (:P_tile *T)))

(INIT &order Order
  (member ((:t T))
    (&glyph *T))
  (before ((:a T) (:b T2))
    (&glyph *T)
    (&glyph (:T *T2))
    (&glyph)
    (&order_corner *D)
    (&order_axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (dir_elem (:D D2))
         (margin (:B T) (:D D2) (:K *K1_m1))
         (margin (:B T2) (:D D2) (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir (:C D) A (:D D2))
         (perp A (:A2 *A2_m3))
         (corner_dir (:C D) (:A A2_m3) (:D *D22))
         (margin (:B T) (:D D2) (:K *K_m4))
         (margin (:B T2) (:D D2) (:K K_m4))
         (dir_elem (:D D22))
         (margin (:B T) (:D D22) (:K *K1_m5))
         (margin (:B T2) (:D D22) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

;; The pen's walk: it stands on the marker before the first glyph, and after
;; each glyph's stroke it stands where the stroke ends.
(INIT &walk2 Propagation
  (source ((:n T P))
    (&order.minimal (:t *T))
    (&marker_cell (:P_canvas *P)))
  (edge ((:a (:T T1) P) (:b (:T T2) (:P P2)))
    (&order.successor (:a *T1) (:b *T2))
    (&canvas (:P_canvas *P))
    (&advance (:D *Da))
    (step_offset (:D Da) (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *P1))
    (&move (:T T1) *D *K)
    (dir8_opposite D (:D2 *O_m3))
    (edge_inset (:D O_m3) K (:B *B1_m4))
    (edge_inset D K (:B *I_m6))
    (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
    (compose (:A B1_m4) (:B B2_m5) (:C *V_m2))
    (compose (:A P1) (:B V_m2) (:C *P2))))

(RULE &stroke_start
  (&walk2.reached (:n *T (:P *P3)))
  (&advance *D)
  (step_offset D (:V *V_m1))
  (compose (:A P3) (:B V_m1) (:C *P)))

(RULE &stroke_end
  (&stroke_start *T (:P *P3))
  (&move T *D *K)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset D K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P3) (:B V_m1) (:C *P)))

(RULE &stroke_dir
  (&move (:T *Key) (:D *D3))
  (axis_of (:D D3) *A)
  (axis4_of *D A))

(RULE &stroke_node
  (&move (:T *Key) *D)
  (axis_of D *A)
  (input *P))

(RULE &stroke_mark
  (OR ((&stroke_start (:T *Key) *P))
      ((&stroke_end (:T Key) P))))

(RULE &stroke_source
  (&stroke_mark *Key *P))

(INIT &stroke Distance
  (key ((&stroke_source (:Key ^Ky) (:P ^O))
        (&stroke_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&stroke_source (:Key Ky) (:P O))
           (&stroke_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&stroke_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&stroke_node (:Key Ky) (:P Q)))
          ((&stroke_source (:Key Ky) (:P O))
           (&stroke_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&stroke_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&stroke_source (:Key Ky) (:P O))
           (&stroke_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&stroke_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&stroke_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&stroke_source (:Key Ky) (:P O))
      (&stroke_dir (:Key Ky) D))))

(RULE &stroke_ray
  (&stroke.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &stroke_between
  (&stroke_end (:T *Key))
  (&canvas (:P_canvas *P))
  (&move (:T Key) *D)
  (axis_of D *A)
  (axis4_of (:D *D2) A)
  (dir8_opposite (:D D2) (:D2 *O))
  (&stroke_ray Key P (:D D2))
  (&stroke_ray Key P (:D O)))

(RULE &stroke_end2
  (&stroke_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&stroke_ray Key (:P Q) D Origin)))

(RULE &glyph_color
  (&glyph_cell (:P_tile *T) *Col))

(RULE &ink
  (OR ((&stroke_between (:Key *T) *P)
       (&glyph_color T *Col))
      ((&marker_cell (:P_canvas P))
       (&marker (:C Col)))))

(RULE &output
  (&canvas (:P_canvas *P))
  (OR ((&ink P *Col))
      ((NOT (&ink P))
       (&bg (:C Col)))))
