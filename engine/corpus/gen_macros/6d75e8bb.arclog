;; 6d75e8bb

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &filled
  (input *P *Col)
  (&bg (:C Col))
  (&bbox.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(ALTS $choice "what owns a box" $Whole
  (ALT $Each
    (RULE &comps_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (INIT &comps Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&comps_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &comps_component
      (&comps.class (:a *P) *Id))

    (INIT &comp_box BoundingBox
      (key ((&comps_component *P ^Id))
        (cell (P)
          (&comps_component *P Id))))

    (RULE &filled
      (input *P *Col)
      (&bg (:C Col))
      (&comp_box.box *B)
      (ALL ((input P (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &output
  (OR ((&filled *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&filled P)))))
