;; c074846d

(INPUT pivot "the input holds one cell of color &pivot_color"

  (RULE &stick4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &recolored
    (ex_input *E *P (:Col *C_in))
    (ex_output E P (:Col *C_out))
    (!= C_in C_out))

  (DET &arm_color
    (&recolored *E (:C_in *C))
    (&recolored E (:C_out C)))

  (DET_OR_RULE &pivot_color RarestColor
    (ex_input *E *P (:Col *C))
    (&arm_color (:C *C_arm))
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *A))
    (&recolored E (:P A) (:C_in C_arm))
    (dir_elem (:D *D2))
    (step_offset (:D D2) (:V *V_m2))
    (compose (:A P) (:B V_m2) (:C *Q))
    (&recolored E (:P Q) (:C_in *C_covered) (:C_out C_arm))
    (!= C C_covered))

  (RULE &stick8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET_OR_RULE &background DominantColor
    (&recolored (:C_in *C) (:C_out *A))
    (&arm_color (:C A)))

  (INIT &stick4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&background (:C Col)))
           (&stick4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&background (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&background (:C Col3)))
           (= P3 P)))))

  (INIT &stick8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&background (:C Col)))
           (&stick8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&background (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&background (:C Col3)))
           (= P3 P))))))

(INPUT arm "the input holds a straight run of &arm_color cells, one cell wide, that starts at a neighbor of the pivot and goes away from it in one cardinal direction, of length one or more")

(INPUT blank-field "every other cell is background (0)")

(INPUT room-to-turn "the grid holds the arm's full length past the pivot in the direction the turn takes it to")

(OUTPUT swing "the output paints the arm at the pivot again, turned a quarter turn in sense &sense around the pivot: each arm cell at distance k from the pivot in direction d goes to distance k in the direction &sense turns d to, in &arm_color"

  (RULE &sight_dir
    (dir_elem *D))

  (RULE &sight_node
    (input *P))

  (RULE &pivot
    (input *P *Col)
    (&pivot_color (:C Col)))

  (RULE &sight_source
    (&pivot *P))

  (INIT &sight Distance
    (key ((&sight_source (:P ^O))
          (&sight_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&sight_source (:P O))
             (&sight_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&sight_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&sight_node (:P Q)))
            ((&sight_source (:P O))
             (&sight_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&sight_node (:P Q))
             (= A2 O))
            ((&sight_source (:P O))
             (&sight_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&sight_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&sight_node (:P Q)))))
      (source ((:n O))
        (&sight_source (:P O))
        (&sight_dir D))))

  (DET &sense
    (ex_input *E *P (:Col *C_pivot))
    (&pivot_color (:C C_pivot))
    (&arm_color (:C *C_arm))
    (step_offset *D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *A))
    (&recolored E (:P A) (:C_in C_arm))
    (step_offset (:D *D2) (:V *V_m2))
    (compose (:A P) (:B V_m2) (:C *Q))
    (&recolored E (:P Q) (:C_out C_arm))
    (turn *S D D2)))

(OUTPUT trail "each cell the arm held in the input takes &trail_color"

  (DET &trail_color
    (&recolored (:C_in *A) (:C_out *C))
    (&arm_color (:C A))))

(OUTPUT keep "every other cell, the pivot included, keeps its input color"

  (RULE &arm
    (input *P *Col)
    (&arm_color (:C Col))))

(ALTS $turn "how an arm cell's place turns about a pivot" $DirTurn
  (ALT $RotateOffsets
    (OUTPUT swing "each arm cell's offset from the pivot turns a quarter turn in &sense, wherever the cell lies")
    (RULE &turned
      (&pivot *P)
      (&arm (:P *A))
      (relative (:Base P) (:X A) (:X_rel *V))
      (&sense *S)
      (c4_turn S (:T *R))
      (apply (:D R) (:P V) (:P_out *V2))
      (compose (:A P) (:B V2) (:C *Q)))))

(ALTS $scope "which pivots an arm cell turns about" $OnePivotSet
  (ALT $PerStick
    (INPUT pivot "each 4-connected component of cells other than &background is a stick, with its own pivot cells")
    (OUTPUT swing "an arm cell turns only about the pivot cells of its own stick"
      (RULE &stick4_component
        (&stick4.class (:a *P) *Id)))
    (RULE &linked
      (&pivot *P)
      (&arm (:P *A))
      (!= P A)
      (&stick4_component P *Id)
      (&stick4_component (:P A) Id))
    (ALTS $adj "which cells join into one stick" $Join4
      (ALT $CornerJoin
        (INPUT pivot "8-adjacency joins the cells of a stick, so sticks that touch only at a corner are one stick"
          (RULE &stick8_component
            (&stick8.class (:a *P) *Id)))
        (RULE &linked
          (&pivot *P)
          (&arm (:P *A))
          (!= P A)
          (&stick8_component P *Id)
          (&stick8_component (:P A) Id))))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(RULE &linked
  (&pivot *P)
  (&arm (:P *A))
  (!= P A))

(RULE &turned
  (&sight_ray (:P *A) *D *K (:Origin *P))
  (&arm (:P A))
  (&sense *S)
  (turn S D *D2)
  (dir8_opposite (:D D2) (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset (:D D2) K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q)))

(RULE &painted
  (&linked *P *A)
  (&turned P A *Q))

(RULE &moved
  (&linked *P *A)
  (&turned P A))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&painted (:Q P))
       (&arm_color (:C *Col)))
      ((&moved (:A P))
       (NOT (&painted (:Q P)))
       (&trail_color (:C Col)))
      ((NOT (&painted (:Q P)))
       (NOT (&moved (:A P)))
       (= Col Col_in))))
