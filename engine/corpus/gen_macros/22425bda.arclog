;; 22425bda

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &collinear
  (OR ((&ink *P)
       (&ink (:P *Q))
       (axis4_elem *A)
       (perp A (:A2 *A2_m1))
       (axis_of (:D *D_m2) (:A A2_m1))
       (margin (:B P) (:D D_m2) (:K *K_m3))
       (margin (:B Q) (:D D_m2) (:K K_m3)))
      ((&ink P)
       (&ink (:P Q))
       (axis4_elem A)
       (diag_perp (:Da A) (:Da2 *A2_m12))
       (diag_axis_of (:D *D_m22) (:Da A2_m12))
       (corner_dist P (:Diag D_m22) (:K *K_m32))
       (corner_dist (:P Q) (:Diag D_m22) (:K K_m32)))))

(RULE &family
  (&ink *Col)
  (axis4_elem *A)
  (ALL ((&ink Col *P)
        (&ink Col (:P *Q)))
       ((&collinear A P Q))))

(RULE &line
  (OR ((&family *Col *A)
       (&ink Col (:P *Q))
       (input *P)
       (perp A (:A2 *A2_m1))
       (axis_of (:D *D_m2) (:A A2_m1))
       (margin (:B P) (:D D_m2) (:K *K_m3))
       (margin (:B Q) (:D D_m2) (:K K_m3)))
      ((&family Col (:A *A2))
       (&ink Col (:P *Q2))
       (input P)
       (diag_perp (:Da A2) (:Da2 *A2_m12))
       (diag_axis_of (:D *D_m22) (:Da A2_m12))
       (corner_dist P (:Diag D_m22) (:K *K_m32))
       (corner_dist (:P Q2) (:Diag D_m22) (:K K_m32)))))

(RULE &hides
  (&line (:Col *Hi) *P)
  (&line (:Col *Lo) P)
  (!= Hi Lo)
  (input P (:Col Hi)))

;; Above through any run of crossings, from each color.
(INIT &above Propagation
  (key ((&ink ^Col)))
  (edge ((:a Lo) (:b Hi))
    (&hides *Hi *Lo)))

;; Stack order: below through any run of crossings.
(INIT &stack Order
  (member ((:t Col))
    (&ink *Col))
  (before ((:a Lo) (:b Hi))
    (&above.reached (:key (:Col *Lo)) (:n *Hi))
    (!= Lo Hi)))

(INIT &row_size Cardinality
  (member ((:m R))
    (&stack.rank *R)))

;; The edge the bottom of the stack sits at.
(DET &stack_dir DirDomain)

(INIT &row_frame Frame
  (extent (A N)
    (&stack_dir *D)
    (axis_of D *A)
    (&row_size.size *N)))

(RULE &row_pos
  (&row_frame.cell *P)
  (&stack_dir *D)
  (margin (:B P) D *K)
  (&stack.rank (:R K)))

(RULE &output
  (&stack.rank (:t *Col) *R)
  (&row_pos (:K R) *P))
