;; 272f95fa

(DET &line RarestColor)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &df_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (&line (:C Col)))

(RULE &df_on_divider
  (input *P)
  (&df_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A line wholly of the line color spans the grid, so it cuts tiles apart.
(INIT &df_rank Order
  (key ((OR ((&df_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&df_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&df_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &df_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&df_on_divider P A))
  (margin (:B P) D *K)
  (&df_rank.rank (:key D) (:t K) (:R *N)))

(RULE &df_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&df_part_idx *P D (:N *N1))
  (&df_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &df_tile_of
  (&df_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&df_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &cast_dir
  (dir_elem *D))

(RULE &cast_node
  (input *P))

(RULE &center_tile
  (&df_tile_of *P_tile)
  (ALL ((&df_tile_of P_tile)
        (opposite (:D *D_m1) (:Opp *O_m2))
        (margin (:B P_tile) (:D D_m1) (:K *K1_m3))
        (margin (:B P_tile) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4))))

(RULE &cast_source
  (&center_tile (:P_tile *P)))

(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(DET &center_paint AnyOutNewColor)

(DET &painted
  (&df_tile_of *E *P *P_tile)
  (ex_output E P *Col)
  (ex_input E P (:Col *Col_in))
  (!= Col Col_in))

(DET &arm_paint
  (dir_elem *D)
  (&center_tile *E *P_tile)
  (step_offset D (:V *V_m1))
  (compose (:A P_tile) (:B V_m1) (:C *P_arm))
  (&painted E (:P_tile P_arm) *Col))

(RULE &tile_ink
  (OR ((&center_tile *P_tile)
       (&center_paint (:C *Col)))
      ((&center_tile (:P_tile *P_tile2))
       (step_offset *D (:V *V_m1))
       (compose (:A P_tile2) (:B V_m1) (:C P_tile))
       (&arm_paint D Col))))

(ALTS $choice "which tile takes which color. On a 3x3 arrangement, the one-step footprint and the cast to the edge cover the same tiles." $Plus
  (ALT $Cast
    (RULE &cast_cell
      (&df_tile_of (:P_tile *P)))

    (RULE &tile_ink
      (OR ((&center_tile *P_tile)
           (&center_paint (:C *Col)))
          ((&cast_ray (:P P_tile) *D *K)
           (&cast_cell (:P P_tile))
           (!= K 0)
           (&arm_paint D Col)))))
  (ALT $Lookup
    (DET &tile_paint
      (&painted *P_tile *Col))

    (RULE &tile_ink
      (&tile_paint *P_tile *Col))))

(RULE &paint
  (&df_tile_of *P *P_tile)
  (&tile_ink P_tile *Col))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
