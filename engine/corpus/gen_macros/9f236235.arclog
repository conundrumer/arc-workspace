;; 9f236235

(INPUT cut "lines that run the whole way across, each in one color, cut the grid into panels"

  (RULE &item_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  ;; The one color a line holds.
  (INIT &line_color Singleton
    (key ((input *P *Col)
          (axis_elem ^A)
          (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
      (member ((:v Col))
        (input *P *Col)
        (axis_elem A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

  (RULE &divider
    (&line_color.value (:key *A *L)))

  (RULE &panels_divider
    (&divider *A *L))

  (INIT &panels_rank Order
    (key ((OR ((&panels_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&panels_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&panels_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K)))))

(INPUT even "the panels are equal in size"

  ;; The panel size: the shortest run from a grid edge to a cutting line.
  (INIT &panel_size Order
    (member ((:t K))
      (&divider *A *L)
      (axis_of *D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (&divider *A *L)
      (axis_of *D A)
      (margin (:B L) D *K))))

(INPUT solid "every panel holds one color")

(OUTPUT mini "the output has one cell per panel, holding that panel's color, and &pose places the panel arrangement in the output frame"

  ;; how the panel arrangement lands in the output
  (DET &pose D4Domain))

(ALTS $choice "how the panels are found" $Cut
  (ALT $Lattice
    (INPUT cut "the cutting lines are evenly spaced, so the panels are the blocks of a lattice"
      (RULE &panel_division_cell
        (input *P)
        (&panel_size.minimal (:t *Key)))

      ;; width of a cutting line separates the derived width from the stored one
      (DET &gap SepThickness)

      (RULE &panel_division_gap
        (axis_elem *A)
        (&panel_size.minimal (:t *Key))
        (&gap *G))

      (RULE &panel_division_axis_split1
        (&panel_division_cell (:Key *Ky) (:P *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
        (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

      (RULE &panel_division_side_held
        (axis_elem *A)
        (&panel_size.minimal (:t *K)))

      (RULE &panel_division_axis
        (OR ((&panel_division_cell *Key *P)
             (axis_elem *A)
             (&panel_size.minimal (:t Key))
             (&panel_division_gap Key A *G)
             (axis_of *D A)
             (opposite D (:Opp *O))
             (margin (:B P) D (:K *T))
             (margin (:B P) (:D O) (:K *T2))
             (divide T (:Side Key) (:Gap G) (:Part *I) (:Remainder *R))
             (divide (:T T2) (:Side Key) (:Gap G) (:Part *I2) (:Remainder *R2))
             (opposite D (:Opp *O_m1))
             (edge_inset D (:K I) (:B *B1_m2))
             (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
             (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
             (opposite D (:Opp *O_m4))
             (edge_inset D (:K R) (:B *B1_m5))
             (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
             (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
             (frame_extent (:P P_inner) A (:N Key)))
            ((&panel_division_cell Key P)
             (axis_elem A)
             (&panel_size.minimal (:t Key))
             (NOT (&panel_division_gap Key A))
             (axis_of (:D *D2) A)
             (opposite (:D D2) (:Opp *O2))
             (margin (:B P) (:D D2) (:K *T3))
             (margin (:B P) (:D O2) (:K *T22))
             (divide (:T T3) (:Side Key) (:Gap 0) (:Part *I3) (:Remainder *R3))
             (divide (:T T22) (:Side Key) (:Gap 0) (:Part *I22) (:Remainder *R22))
             (opposite (:D D2) (:Opp *O_m12))
             (edge_inset (:D D2) (:K I3) (:B *B1_m22))
             (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
             (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
             (opposite (:D D2) (:Opp *O_m42))
             (edge_inset (:D D2) (:K R3) (:B *B1_m52))
             (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
             (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
             (frame_extent (:P P_inner) A (:N Key)))
            ((&panel_division_cell Key P)
             (axis_elem A)
             (NOT (&panel_division_side_held (:K Key) A))
             (&panel_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
             (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

      (RULE &panel_division_tile
        (&panel_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
        (perp (:A A1) *A2)
        (&panel_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
        (compose (:A Po1) (:B Po2) (:C *P_outer))
        (compose (:A Pi1) (:B Pi2) (:C *P_inner))))
    (RULE &panel
      (&panel_division_tile *P (:P_outer *P_tile)))))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &panel
  (&panels_tile_of *P *P_tile))

(RULE &output
  (&panel (:P *P2) *P_tile)
  (input (:P P2) *Col)
  (&pose *D)
  (apply D (:P P_tile) (:P_out *P)))
