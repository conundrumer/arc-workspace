;; 6f8cd79b

(DET &border AnyOutNewColor)

(RULE &is_border
  (input *P)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(ALTS $choice "how the interior is filled" $Passthrough
  (ALT $Repaint
    (DET &bg DominantColor)

    (RULE &output
      (OR ((&is_border *P)
           (&border (:C *Col)))
          ((input P)
           (relative (:Base 0) (:X P) (:X_rel *R_m1))
           (axis_of (:D *D1_m2) (:A *A1_m3))
           (opposite (:D D1_m2) (:Opp *O1_m4))
           (perp (:A A1_m3) (:A2 *A2_m5))
           (axis_of (:D *D2_m6) (:A A2_m5))
           (opposite (:D D2_m6) (:Opp *O2_m7))
           (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
           (> K1_m8 0)
           (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
           (> K2_m9 0)
           (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
           (> K3_m10 0)
           (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
           (> K4_m11 0)
           (&bg (:C Col)))))))

(RULE &output
  (OR ((&is_border *P)
       (&border (:C *Col)))
      ((input P Col)
       (relative (:Base 0) (:X P) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (> K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (> K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (> K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (> K4_m11 0))))
