;; 54d82841

(DET &bg DominantColor)

(DET &mark AnyOutNewColor)

(DET &fall DirDomain)

(RULE &free
  (input *P *Col)
  (&bg (:C Col))
  (dir_elem *D)
  (ALL ((step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (input (:P Q) (:Col *Colm)))
       ((&bg (:C Colm)))))

;; The cell a cup holds has one free side alone, so its free sides agree.
(INIT &lone_free Singleton
  (key ((&free ^P *D))
    (member ((:v D))
      (&free P *D))))

(RULE &aim
  (&lone_free.value (:key *P) (:v *D)))

(ALTS $choice "the cases differ on the line the mark sits in and the edge that line runs to" $Opening
  (ALT $Fall
    (RULE &aim
      (&lone_free.value (:key *P))
      (&fall *D)))
  (ALT $Center
    (RULE &cup_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &cup_node
      (input *P (:Col *Key))
      (NOT (&bg (:C Key))))

    ;; A cup is one color's connected ink: cups of unlike color touch.
    (INIT &cup Quotient
      (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
        (OR ((&cup_node (:Key *Ky) *P)
             (&cup_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&cup_node (:Key Ky) (:P P2)))
            ((&cup_node (:Key Ky) P)
             (= P2 P)))))

    (RULE &cup_component
      (&cup.class (:a *Key *P) *Id))

    (INIT &bbox BoundingBox
      (key ((&cup_component *P ^Id))
        (cell (P)
          (&cup_component *P Id))))

    ;; The cast cell is a cup cell midway between the two sides of its box.
    (RULE &aim
      (&bbox.cell (:key *Id) *P)
      (&bbox.box (:key Id) *B)
      (ALL ((&bbox.cell (:key (:Id *Idm)) P)
            (&bbox.box (:key (:Id Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&fall *D)
      (axis_of D (:A *A_m1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (axis_of (:D *D2) (:A A2_m2))
      (opposite (:D D2) (:Opp *O_m3))
      (margin (:B P_inner) (:D D2) *K)
      (margin (:B P_inner) (:D O_m3) K))))

(RULE &mark_cell
  (&aim (:P *P2) *D)
  (axis_of D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P2) (:D D_m2) (:K *K_m3))
  (input *P)
  (margin (:B P) (:D D_m2) (:K K_m3))
  (margin (:B P) D (:K 0)))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&mark_cell P))
      ((&mark (:C *Col)))
      ((= Col Col_in))))
