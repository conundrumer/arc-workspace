;; 320afe60

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &shapes Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &shapes_component
  (&shapes.class (:a *P) *Id))

(RULE &off_shape_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &off_shape_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &shape
  (&shapes_component *P *Id))

(RULE &off_shape_cell
  (input *P)
  (&shape (:Id *Key))
  (NOT (&shape (:Id Key) P)))

(RULE &off_shape_flood_node
  (input *P)
  (&shape (:Id *Key))
  (NOT (&shape (:Id Key) P)))

(INIT &off_shape_flood Propagation
  (key ((OR ((&off_shape_cell (:Key ^Ky) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&off_shape_flood_node (:Key Ky) P))
            ((&off_shape_flood_node (:Key Ky) P)
             (&off_shape_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&off_shape_flood_node (:Key Ky) (:P Q)))))
    (source ((:n P))
      (&off_shape_cell (:Key Ky) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&off_shape_flood_node (:Key Ky) P))
    (edge ((:a P) (:b Q))
      (&off_shape_flood_node (:Key Ky) *P)
      (&off_shape_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&off_shape_flood_node (:Key Ky) (:P Q)))))

(RULE &off_shape_node
  (&off_shape_cell *Key *P)
  (NOT (&off_shape_flood.reached (:key (:Ky Key)) (:n P))))

;; The grid with only this shape solid.
(INIT &off_shape Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&off_shape_node (:Key *Ky) *P)
         (&off_shape_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&off_shape_node (:Key Ky) (:P P2)))
        ((&off_shape_node (:Key Ky) P)
         (= P2 P)))))

(RULE &off_shape_component
  (&off_shape.class (:a *Key *P) *Id))

;; Where the closed shapes go; the open ones go to the opposite edge.
(DET &closed_dir DirDomain)

(DET &closed_paint AnyOutNewColor)

(DET &open_paint AnyOutNewColor)

(INIT &bbox BoundingBox
  (key ((&shape ^Id *P))
    (cell (P)
      (&shape Id *P))))

(RULE &gap
  (&bbox.box (:key *Id) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&shape Id P)))

(RULE &encloses
  (&off_shape_component (:Key *Id)))

(ALTS $choice "Two hypotheses on what stands solid while a shape is judged" $Own
  (ALT $Joint
    (RULE &off_ink_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &off_ink_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &off_ink_cell
      (input *P *Col)
      (&bg (:C Col)))

    (INIT &off_ink_flood Propagation
      (source ((:n P))
        (&off_ink_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P *Col)
        (&bg (:C Col)))
      (edge ((:a P) (:b P2))
        (input *P *Col)
        (&bg (:C Col))
        (&off_ink_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2) (:Col *Col2))
        (&bg (:C Col2))))

    (RULE &off_ink_node
      (&off_ink_cell *P)
      (NOT (&off_ink_flood.reached (:n P))))

    ;; The grid with all the ink solid.
    (INIT &off_ink Quotient
      (edge ((:a P) (:b P2))
        (OR ((&off_ink_node *P)
             (&off_ink_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&off_ink_node (:P P2)))
            ((&off_ink_node P)
             (= P2 P)))))

    (RULE &off_ink_component
      (&off_ink.class (:a *P) *Id))

    (RULE &gap
      (&bbox.box (:key *Id) *B)
      (input *P *Col)
      (ALL ((input P (:Col *Colm))
            (&bbox.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (&bg (:C Col)))

    (RULE &encloses
      (&off_ink_component *P)
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&shape *Id (:P Q)))))

(RULE &open
  (&gap *Id)
  (NOT (&encloses Id)))

(RULE &dest
  (&shape *Id)
  (&closed_dir (:D *D_closed))
  (OR ((&open Id)
       (opposite (:D D_closed) (:Opp *D))
       (&open_paint (:C *Col)))
      ((NOT (&open Id))
       (= D D_closed)
       (&closed_paint (:C Col)))))

;; Each shape slides until it touches the destination edge.
(INIT &slide Distance
  (key ((&shape ^Id *P)
        (&dest Id *D)
        (margin (:B P) D *K))
    (source_distance (K)
      (&shape Id *P)
      (&dest Id *D)
      (margin (:B P) D *K))))

(RULE &slide_dir
  (&dest (:Id *Key) *D))

(RULE &paint
  (&shape *Id (:P *P2))
  (&dest Id *Col)
  (&slide.distance (:key Id) *K)
  (&slide_dir (:Key Id) *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&paint P)))))
