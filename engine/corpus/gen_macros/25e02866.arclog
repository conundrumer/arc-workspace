;; 25e02866

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background covers the grid, and the ink is what is drawn on it. The
;; rectangles cover the ink in the same way.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

;; A panel is a connected island of ink: one rectangle with its painted cells.
;; Seen from its own box, every panel lands on the same frame — the output frame.
(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(INIT &panel_mode_count Cardinality
  (key ((&ink *P)
        (input P ^Col))
    (member ((:m P))
      (&ink *P)
      (input P Col))))

(INIT &panel_mode Order
  (member ((:t Col))
    (&panel_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&panel_mode_count.size (:key *Col) *N)))

(INIT &panel BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(RULE &panel_cell
  (&panel.cell (:key *Id) *P)
  (&panel.box (:key Id) *B)
  (ALL ((&panel.cell (:key (:Id *Idm)) P)
        (&panel.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_frame)))

(RULE &paint
  (&panel_cell *P *P_frame)
  (input P *Col)
  (NOT (&panel_mode.maximal (:t Col))))

(RULE &overlay
  (&paint *P_frame *Col))

(ALTS $choice "which painted cells a rectangle contributes" $Layer
  (ALT $Inside
    (RULE &overlay
      (&paint *P_frame *Col)
      (relative (:Base 0) (:X P_frame) (:X_rel *R_m1))
      (axis_of (:D *D1_m2) (:A *A1_m3))
      (opposite (:D D1_m2) (:Opp *O1_m4))
      (perp (:A A1_m3) (:A2 *A2_m5))
      (axis_of (:D *D2_m6) (:A A2_m5))
      (opposite (:D D2_m6) (:Opp *O2_m7))
      (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
      (> K1_m8 0)
      (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
      (> K2_m9 0)
      (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
      (> K3_m10 0)
      (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
      (> K4_m11 0))))

(RULE &output
  (OR ((&overlay (:P_frame *P) *Col))
      ((&panel_cell (:P_frame P))
       (NOT (&overlay (:P_frame P)))
       (&panel_mode.maximal (:t Col)))))
