;; a68b268e

(DET &gap SepThickness)

(INIT &tile_ink_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (ex_input (:P *P_grid))))

(DET &tiles SepTileCount)

(DET &tile_ink_division_gap
  (axis_elem *A)
  (&gap *G))

(DET &tile_ink_division_axis_split1
  (ex_input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(DET &tile_ink_division_parts
  (axis_elem *A)
  (&tiles *N))

(DET &tile_ink_division_axis
  (OR ((ex_input *P)
       (axis_elem *A)
       (&tiles *N)
       (&gap *G)
       (&tile_ink_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((ex_input P)
       (axis_elem A)
       (&tiles (:N *N2))
       (&gap (:G *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((ex_input P)
       (axis_elem A)
       (&tiles (:N *N3))
       (NOT (&tile_ink_division_gap A))
       (&tile_ink_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((ex_input P)
       (axis_elem A)
       (&tiles (:N *N4))
       (NOT (&tile_ink_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((ex_input P)
       (axis_elem A)
       (NOT (&tile_ink_division_parts A))
       (&tile_ink_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &tile_ink_division_tile
  (&tile_ink_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_ink_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &tile_cell_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(RULE &tile_cell_division_gap
  (axis_elem *A)
  (&gap *G))

(RULE &tile_cell_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_cell_division_parts
  (axis_elem *A)
  (&tiles *N))

(RULE &tile_cell_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tiles *N)
       (&gap *G)
       (&tile_cell_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (&tiles (:N *N2))
       (&gap (:G *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (axis_elem A)
       (&tiles (:N *N3))
       (NOT (&tile_cell_division_gap A))
       (&tile_cell_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (axis_elem A)
       (&tiles (:N *N4))
       (NOT (&tile_cell_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_cell_division_parts A))
       (&tile_cell_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_cell_division_tile
  (&tile_cell_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_cell_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg DominantColor)

(DET &lex_axis AxisDomain)

(RULE &tiling)

(RULE &tile_cell
  (input (:P *P_grid) *Col)
  (&tile_cell_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &tile_ink
  (ex_input *E (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&tile_ink_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P)))

(DET &beats
  (&tile_ink *E *P_tile *P *Col)
  (&tile_ink E (:P_tile *P_tile2) P (:Col *Col2))
  (!= Col Col2)
  (ex_output E P Col))

;; The tiles each tile beats, directly or through others: a tile pair
;; need not overlap directly.
(INIT &beaten Propagation
  (key ((OR ((&beats (:P_tile ^T) (:P_tile2 *T2)))
            ((&beats (:P_tile T))
             (&beats (:P_tile T2) (:P_tile2 *T3)))))
    (source ((:n T2))
      (&beats (:P_tile T) (:P_tile2 *T2)))
    (edge ((:a T2) (:b T3))
      (&beats (:P_tile T))
      (&beats (:P_tile *T2) (:P_tile2 *T3)))))

(INIT &order Order
  (member ((:t T))
    (&tile_ink (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&beaten.reached (:key *T) (:n *T2))))

(DET &lex_corner
  (&order.minimal (:t *T))
  (corner_dist (:P T) (:Diag *D) (:K 0)))

(DET &prio
  (&order.rank (:t *P) *R))

(ALTS $choice "whether the overlay ranks by tile (spatial) precedence, as a rule or a stored table, or by ink (chromatic) precedence, a stored table" $Scan
  (ALT $Scan
    (ALTS $d "how the grid divides into tiles, indistinguishable here since every grid is 9×9" $Count
      (ALT $Size
        (DET &tile_dim
          (ex_output *P)
          (axis_elem *A)
          (frame_extent P A (:N *K)))
        (RULE &tile_cell_division2_gap
          (axis_elem *A)
          (&gap *G))
        (RULE &tile_cell_division2_axis_split1
          (input (:P *P_grid_))
          (axis_elem (:A *A_))
          (axis_of (:D *D_m1) (:A A_))
          (opposite (:D D_m1) (:Opp *O_m2))
          (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
          (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
          (opposite (:D D_m1) (:Opp *O_m1))
          (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
          (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
          (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
          (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))
        (RULE &tile_cell_division2_side
          (axis_elem *A)
          (&tile_dim *K))
        (RULE &tile_cell_division2_axis
          (OR ((input *P)
               (axis_elem *A)
               (&tile_dim *K)
               (&gap *G)
               (axis_of *D A)
               (opposite D (:Opp *O))
               (margin (:B P) D (:K *T))
               (margin (:B P) (:D O) (:K *T2))
               (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
               (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
               (opposite D (:Opp *O_m1))
               (edge_inset D (:K I) (:B *B1_m2))
               (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
               (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
               (opposite D (:Opp *O_m4))
               (edge_inset D (:K R) (:B *B1_m5))
               (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
               (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
               (frame_extent (:P P_inner) A (:N K)))
              ((input P)
               (axis_elem A)
               (&tile_dim (:K *K2))
               (NOT (&tile_cell_division2_gap A))
               (axis_of (:D *D2) A)
               (opposite (:D D2) (:Opp *O2))
               (margin (:B P) (:D D2) (:K *T3))
               (margin (:B P) (:D O2) (:K *T22))
               (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
               (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
               (opposite (:D D2) (:Opp *O_m12))
               (edge_inset (:D D2) (:K I3) (:B *B1_m22))
               (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
               (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
               (opposite (:D D2) (:Opp *O_m42))
               (edge_inset (:D D2) (:K R3) (:B *B1_m52))
               (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
               (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
               (frame_extent (:P P_inner) A (:N K2)))
              ((input P)
               (axis_elem A)
               (NOT (&tile_cell_division2_side A))
               (&tile_cell_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
               (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
        (RULE &tile_cell_division2_tile
          (&tile_cell_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
          (perp (:A A1) *A2)
          (&tile_cell_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
          (compose (:A Po1) (:B Po2) (:C *P_outer))
          (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
        (RULE &tile_cell
          (input (:P *P_grid) *Col)
          (&tile_cell_division2_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile))))))
  (ALT $Order
    ;; The foremost tile inking each cell.
    (INIT &front_tile Order
      (key ((&tile_ink2 (:P_tile *T) ^P)
            (&prio (:P T) *R))
        (member ((:t (:V T) (:S R)))
          (&tile_ink2 (:P_tile *T) P)
          (&prio (:P T) *R))
        (score ((:t (:V T) (:S R)) (:S R))
          (&tile_ink2 (:P_tile *T) P)
          (&prio (:P T) *R))))

    (RULE &output
      (OR ((&front_tile.minimal (:key *P) (:t (:V *T)))
           (&tile_ink2 (:P_tile T) P *Col))
          ((&tiling)
           (&tile_cell (:P_intile P))
           (NOT (&ink_at P))
           (&bg (:C Col))))))
  (ALT $Ink
    (DET &ink_rank
      (&tile_ink (:P_tile *T) (:Col *C))
      (&prio (:P T) *R))

    ;; The foremost ink at each cell.
    (INIT &front_ink Order
      (key ((&ink_at ^P *Col)
            (&ink_rank (:C Col) *R))
        (member ((:t (:V Col) (:S R)))
          (&ink_at P *Col)
          (&ink_rank (:C Col) *R))
        (score ((:t (:V Col) (:S R)) (:S R))
          (&ink_at P *Col)
          (&ink_rank (:C Col) *R))))

    (RULE &output
      (OR ((&front_ink.minimal (:key *P) (:t (:V *Col))))
          ((&tiling)
           (&tile_cell (:P_intile P))
           (NOT (&ink_at P))
           (&bg (:C Col)))))))

(RULE &tile_ink2
  (&tile_cell *P_tile (:P_intile *P) *Col)
  (NOT (&bg (:C Col))))

(RULE &ink_at
  (&tile_ink2 *P *Col))

(INIT &lex Order
  (member ((:t T))
    (&tile_ink2 (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&tile_ink2 (:P_tile *T))
    (&tile_ink2 (:P_tile *T2))
    (&lex_corner (:D *C))
    (&lex_axis *A)
    (OR ((corner_dir C A *D)
         (dir_elem D)
         (margin (:B T) D (:K *K1_m1))
         (margin (:B T2) D (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir C A D)
         (perp A (:A2 *A2_m3))
         (corner_dir C (:A A2_m3) (:D *D2))
         (margin (:B T) D (:K *K_m4))
         (margin (:B T2) D (:K K_m4))
         (dir_elem (:D D2))
         (margin (:B T) (:D D2) (:K *K1_m5))
         (margin (:B T2) (:D D2) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

;; The earliest tile in the scan inking each cell.
(INIT &front_scan Order
  (key ((&tile_ink2 (:P_tile *T) ^P)
        (&lex.rank (:t T) *R))
    (member ((:t (:V T) (:S R)))
      (&tile_ink2 (:P_tile *T) P)
      (&lex.rank (:t T) *R))
    (score ((:t (:V T) (:S R)) (:S R))
      (&tile_ink2 (:P_tile *T) P)
      (&lex.rank (:t T) *R))))

(RULE &output
  (OR ((&tiling)
       (&tile_cell (:P_intile *P))
       (NOT (&ink_at P))
       (&bg (:C *Col)))
      ((&front_scan.minimal (:key P) (:t (:V *T)))
       (&tile_ink2 (:P_tile T) P Col))))
