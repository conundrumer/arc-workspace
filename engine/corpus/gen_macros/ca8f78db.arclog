;; ca8f78db

(DET &noise ChangedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&noise (:C Col))))

(INIT &si2 Periods
  (cell (P (:v Col))
    (&clean *P *Col)))

(ALTS $choice "how a corrupted cell's replacement is found" $Shift
  (ALT $Period
    (INIT &si Periods
      (key ((ex_output ^E *P *Col))
        (cell (P (:v Col))
          (ex_output E *P *Col))))

    (DET &si_mismatch
      (ex_output (:E *Key) *P)
      (axis_of (:D *D_m2) *A)
      (sub_extent P A *K)
      (dir8_opposite (:D D_m2) (:D2 *O_m3))
      (edge_inset (:D O_m3) K (:B *B1_m4))
      (edge_inset (:D D_m2) K (:B *I_m6))
      (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
      (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
      (NOT (&si.period (:key (:E Key)) A K)))

    (INIT &unbroken Order
      (key ((ex_output *P)
            (axis_of (:D *D_m2) ^A)
            (sub_extent P A *K)
            (dir8_opposite (:D D_m2) (:D2 *O_m3))
            (edge_inset (:D O_m3) K (:B *B1_m4))
            (edge_inset (:D D_m2) K (:B *I_m6))
            (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
            (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
            (NOT (&si_mismatch A K)))
        (member ((:t K))
          (ex_output *P)
          (axis_of (:D *D_m2) A)
          (sub_extent P A *K)
          (dir8_opposite (:D D_m2) (:D2 *O_m3))
          (edge_inset (:D O_m3) K (:B *B1_m4))
          (edge_inset (:D D_m2) K (:B *I_m6))
          (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
          (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
          (NOT (&si_mismatch A K)))
        (score ((:t K) (:S K))
          (ex_output *P)
          (axis_of (:D *D_m2) A)
          (sub_extent P A *K)
          (dir8_opposite (:D D_m2) (:D2 *O_m3))
          (edge_inset (:D O_m3) K (:B *B1_m4))
          (edge_inset (:D D_m2) K (:B *I_m6))
          (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
          (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
          (NOT (&si_mismatch A K)))))

    (DET &period
      (&unbroken.minimal (:key *A) (:t *K)))

    (RULE &peer
      (input *P (:Col *N))
      (&noise (:C N))
      (&period *A *K)
      (axis_of *D A)
      (&clean (:P *Q) *Col)
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P) (:D D_m2) (:K *K_m3))
      (margin (:B Q) (:D D_m2) (:K K_m3))
      (margin (:B P) D (:K *T_p))
      (divide (:T T_p) (:Side K) (:Gap 0) (:Remainder *R))
      (margin (:B Q) D (:K *T_q))
      (divide (:T T_q) (:Side K) (:Gap 0) (:Remainder R)))

    (RULE &output
      (OR ((&peer *P *Col))
          ;; Clean cells pass through under every case.
          ((&clean P Col)))))
  (ALT $Rows
    (DET &line_cell_split1
      (ex_output *E (:P *P_) *Col)
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
      (relative (:Base Along_) (:X P_) (:X_rel *Across_)))

    (DET &line_cell
      (ex_output *E *P *Col)
      (axis_elem *A)
      (&line_cell_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:Across_ *Across)))

    (DET &bg DominantColor)

    (DET &pattern_line
      (&line_cell *E *A *Across *Col)
      (NOT (&bg (:C Col))))

    ;; The colors the pattern lines carry at each position along the line.
    (INIT &pattern_at Singleton
      (key ((&line_cell ^E ^A *Across ^Along *Col)
            (&pattern_line E A Across))
        (member ((:v Col))
          (&line_cell E A *Across Along *Col)
          (&pattern_line E A Across))))

    (DET &axis_mismatch
      (&pattern_at.plural (:key *A)))

    (DET &axis
      (axis_elem *A)
      (NOT (&axis_mismatch A)))

    (RULE &pattern_row_split1
      (&clean (:P *P_) *Col)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *Across_)))

    (RULE &out_split1
      (input (:P *P_) (:Col *N))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
      (relative (:Base Along_) (:X P_) (:X_rel *Across_)))

    (RULE &pattern_row
      (&clean *P *Col)
      (NOT (&bg (:C Col)))
      (&axis *A)
      (&pattern_row_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:Across_ *Across)))

    (RULE &output
      (OR ((input *P (:Col *N))
           (&noise (:C N))
           (&axis *A)
           (&out_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:Across_ *Across))
           (OR ((NOT (&pattern_row Across))
                (&bg (:C *Col)))
               ((&pattern_row Across)
                (&clean (:P *Q) Col)
                (axis_of (:D *D_m1) A)
                (opposite (:D D_m1) (:Opp *O_m2))
                (margin (:B Q) (:D D_m1) (:K *K1_m3))
                (margin (:B Q) (:D O_m2) (:K *K2_m4))
                (opposite (:D D_m1) (:Opp *O_m5))
                (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m6))
                (edge_inset (:D O_m5) (:K K2_m4) (:B *B2_m7))
                (compose (:A B1_m6) (:B B2_m7) (:C Along))
                (relative (:Base Along) (:X Q) (:X_rel *Across2))
                (&pattern_row (:Across Across2)))))
          ;; Clean cells pass through under every case.
          ((&clean P Col))))))

(RULE &output
  ;; Clean cells pass through under every case.
  (OR ((&clean *P *Col))
      ((input P (:Col *N))
       (&noise (:C N))
       (&clean (:P *P_2))
       (axis_of (:D *D_m1) *A)
       (sub_extent (:P P_2) A *K)
       (dir8_opposite (:D D_m1) (:D2 *O_m2))
       (edge_inset (:D O_m2) K (:B *B1_m3))
       (edge_inset (:D D_m1) K (:B *I_m5))
       (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
       (compose (:A B1_m3) (:B B2_m4) (:C *Delta))
       (ALL ((&clean (:P *Pm))
             (axis_of (:D *D_m2) A)
             (sub_extent (:P Pm) A K)
             (dir8_opposite (:D D_m2) (:D2 *O_m3))
             (edge_inset (:D O_m3) K (:B *B1_m4))
             (edge_inset (:D D_m2) K (:B *I_m6))
             (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
             (compose (:A B1_m4) (:B B2_m5) (:C *V_m1)))
            ((&si2.period A K)))
       (compose (:A P) (:B Delta) (:C *P2))
       (&clean (:P P2) Col))))
