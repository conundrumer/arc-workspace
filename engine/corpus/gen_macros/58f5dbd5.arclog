;; 58f5dbd5

(RULE &comps_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The ground is the commonest color.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg_mode.maximal (:t Key))))

(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(INIT &bg_mode_count2 Cardinality
  (key ((ex_input ^E *P ^Col))
    (member ((:m P))
      (ex_input E *P Col))))

(INIT &bg_mode2 Order
  (key ((&bg_mode_count2.size (:key ^E *Col)))
    (member ((:t Col))
      (&bg_mode_count2.size (:key E *Col)))
    (score ((:t Col) (:S N))
      (&bg_mode_count2.size (:key E *Col) *N))))

;; The output's blocks stand the border's width inside its frame.
(INIT &bbox BoundingBox
  (key ((ex_output ^E *P *Col)
        (NOT (&bg_mode2.maximal (:key E) (:t Col))))
    (cell (P)
      (ex_output E *P *Col)
      (NOT (&bg_mode2.maximal (:t Col))))))

(DET &border
  (&bbox.box *B)
  (dir_elem *D)
  (margin B D *K))

(RULE &crop_box_uniform_outset1
  (&border (:K *K_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m7))
  (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
  (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
  (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m10))
  (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
  (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
  (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
  (relative (:Base I_m1) (:X 0) (:X_rel *B_wide_)))

(INIT &comp_box BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(RULE &pierced
  (&comp_box.box (:key *Id) *B)
  (input *P)
  (ALL ((&comp_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&comp_box.cell (:key Id) P)))

(RULE &block
  (&comps_component (:Key *Col) *P *Id)
  (NOT (&pierced Id)))

(INIT &block_box BoundingBox
  (key ((&block ^Col *P))
    (cell (P)
      (&block Col *P))))

(RULE &block_inner
  (&block *Col *P)
  (&block_box.box (:key Col) *B)
  (ALL ((&block (:Col *Colm) P)
        (&block_box.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &key_cell
  (input *P *Col)
  (&block Col)
  (NOT (&block Col P)))

(INIT &key_box BoundingBox
  (key ((&key_cell ^Col *P))
    (cell (P)
      (&key_cell Col *P))))

(RULE &key_inner
  (&key_cell *Col *P)
  (&key_box.box (:key Col) *B)
  (ALL ((&key_cell (:Col *Colm) P)
        (&key_box.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; $Center — the key centered in the block.
(RULE &hole
  (&block_inner *Col *P (:P_inner *P_blk))
  (&key_inner Col (:P_inner *P_key))
  (relative (:Base P_key) (:X P_blk) (:X_rel *B))
  (ALL ((&key_inner (:Col *Colm) (:P_inner *P_keym))
        (&block_inner (:Col Colm) (:P *Pm) (:P_inner *P_blkm))
        (relative (:Base P_keym) (:X P_blkm) (:X_rel B))
        (opposite (:D *D_m1) (:Opp *O_m2))
        (margin B (:D D_m1) (:K *K1_m3))
        (margin B (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4))))

;; $Crop — the block box let out by the border on every edge.
(INIT &blocks_box BoundingBox
  (cell (P)
    (&block *P)))

(RULE &crop_box
  (&blocks_box.box (:B *B_blocks))
  (&border *K)
  (&crop_box_uniform_outset1 (:K_ K) (:B_wide_ *B_wide))
  (compose (:A B_wide) (:B B_blocks) (:C *B)))

(RULE &view
  (&crop_box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_out)))

(ALTS $punch "punch — where the key lands on the block" $Center
  (ALT $Interior
    ;; $Interior — the key fills the block less its rim.
    (INIT &rim Boundary
      (key ((&block ^Col *P))
        (cell (P)
          (&block Col *P))))

    (INIT &inside_box BoundingBox
      (key ((&block ^Col *P)
            (NOT (&rim.boundary (:key Col) P)))
        (cell (P)
          (&block Col *P)
          (NOT (&rim.boundary P)))))

    (RULE &hole
      (&inside_box.cell (:key *Col) *P)
      (&inside_box.box (:key Col) *B)
      (ALL ((&inside_box.cell (:key (:Col *Colm)) P)
            (&inside_box.box (:key (:Col Colm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&key_inner Col P_inner))))

(ALTS $frame "frame — where the output frame comes from" $Crop
  (ALT $Arrange
    ;; $Arrange — each block at its place in the arrangement, inside the border.
    ;; A block's place is its rank from each of the four edges; blocks level with
    ;; each other share a rank, so a band of them lands in one row.
    (INIT &lane Order
      (key ((dir_elem ^D))
        (member ((:t K))
          (&block_box.box *B)
          (margin B D *K))
        (score ((:t K) (:S K))
          (&block_box.box *B)
          (margin B D *K))))

    (RULE &tile_edge
      (&block_box.box (:key (:Col *Key)) *B)
      (dir_elem *D)
      (margin B D (:K *K2))
      (&lane.rank (:key D) (:t K2) (:R *K)))

    (RULE &tile_axis
      (axis_of *D *A)
      (opposite D (:Opp *D2))
      (&tile_edge *Key D (:K *K1))
      (&tile_edge Key (:D D2) (:K *K2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K K1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B)))

    (RULE &tile
      (&tile_axis *Key *A (:B *B1))
      (perp A *A2)
      (&tile_axis Key (:A A2) (:B *B2))
      (compose (:A B1) (:B B2) (:C *B)))

    (INIT &view_tiling Tiling
      (key ((&border ^K))
        (gap (A (:G K))
          (axis_elem *A)))
      (outer ((:P P_tile))
        (&tile (:B *P_tile)))
      (inner ((:P P_inner))
        (&block_inner *P_inner)))

    (RULE &view_uniform_inset1
      (&view_tiling.cell (:key (:K *K_)) (:P_outer *P_tile) *P_inner (:P *P_lat))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &view
      (&block_inner *Col *P *P_inner)
      (&tile (:Key Col) (:B *P_tile))
      (&view_tiling.cell (:key *K) (:P_outer P_tile) P_inner (:P *P_lat))
      (&view_uniform_inset1 (:K_ K) (:B_ *B))
      (compose (:A B) (:B P_lat) (:C *P_out)))

    (INIT &arrange_frame Frame
      (extent (A N)
        (&view *P_out)
        (axis_elem *A)
        (frame_extent (:P P_out) A *N)))

    (RULE &output
      (OR ((&arrange_frame.cell *P)
           (NOT (&view (:P_out P)))
           (&bg_mode.maximal (:t *Col)))
          ((&view (:P *P2) (:P_out P))
           (&hole (:P P2))
           (&bg_mode.maximal (:t Col)))
          ((&view (:P *P22) (:P_out P))
           (input (:P P22) Col)
           (NOT (&hole (:P P22))))))))

(RULE &output
  (OR ((&view (:P *P2) (:P_out *P))
       (&hole (:P P2))
       (&bg_mode.maximal (:t *Col)))
      ((&view (:P *P22) (:P_out P))
       (input (:P P22) Col)
       (NOT (&hole (:P P22))))))
