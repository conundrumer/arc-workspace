;; 48d8fb45

(RULE &blob_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

;; The shapes; the mark is a cell of the one it touches.
(INIT &blob Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&blob_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &blob_component
  (&blob.class (:a *P) *Id))

(DET &mark RarestColor)

(RULE &mark2
  (input *P *Col)
  (&mark (:C Col)))

(RULE &marked
  (&mark2 (:P *M))
  (&blob_component (:P M) (:Id *I))
  (&blob_component *P (:Id I))
  (NOT (&mark2 P))
  (input P *Col))

;; The marked shape's box, and the grid seen from it.
(INIT &bbox BoundingBox
  (cell (P)
    (&marked *P)))

(ALTS $choice "where the crop's box comes from, and what it keeps inside it" $Object
  (ALT $Interior
    (RULE &output
      (&bbox.box *B)
      (input (:P *P2) *Col)
      (ALL ((input (:P P2) (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P2) (:X_rel *P))))
  (ALT $Window
    ;; The window's box, as margins from the mark's cell.
    (DET &win_box BoxDomain)

    (RULE &window
      (&mark2 (:P *M))
      (&win_box (:B *B_mark))
      (compose (:A M) (:B B_mark) (:C *B)))

    (RULE &output
      (&window *B)
      (input (:P *P2) *Col)
      (ALL ((input (:P P2) (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P2) (:X_rel *P)))))

(RULE &output
  (&bbox.box *B)
  (input (:P *P2))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&marked (:P P2) *Col))
      ((NOT (&marked (:P P2)))
       (&bg (:C Col)))))
