;; 6a980be1

(DET &line UnchangedColor)

(RULE &line_axis
  (input *P (:Col *C))
  (&line C)
  (step_offset *D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) (:Col C))
  (axis_of D *A))

(RULE &strip_span_dir
  (&line_axis *A)
  (perp A *A2)
  (axis4_of *D (:A A2)))

(RULE &strip_span_node
  (input *P))

(RULE &line_cell
  (input *P)
  (input (:P *Q) (:Col *C))
  (&line C)
  (&line_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &strip_span_source
  (&line_cell *P))

;; The strip: between the lines, across them.
(INIT &strip_span Distance
  (key ((&strip_span_source (:P ^O))
        (&strip_span_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&strip_span_source (:P O))
           (&strip_span_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&strip_span_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&strip_span_node (:P Q)))
          ((&strip_span_source (:P O))
           (&strip_span_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&strip_span_node (:P Q))
           (= A2 O))
          ((&strip_span_source (:P O))
           (&strip_span_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&strip_span_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&strip_span_node (:P Q)))))
    (source ((:n O))
      (&strip_span_source (:P O))
      (&strip_span_dir D))))

(RULE &strip_span_ray
  (&strip_span.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &strip_span_between
  (input *P)
  (&line_axis *A)
  (perp A *A2)
  (axis4_of *D (:A A2))
  (dir8_opposite D (:D2 *O))
  (&strip_span_ray P D)
  (&strip_span_ray P (:D O)))

(RULE &strip_span_end
  (&strip_span_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&strip_span_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &pattern UnchangedColor)

(RULE &frame_color
  (input *P (:Col *C))
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(RULE &strip_span_axis
  (&line_axis (:A *A3))
  (perp (:A A3) (:A2 *A)))

(RULE &strip_in
  (&strip_span_between *P)
  (NOT (&line_cell P))
  (relative (:Base 0) (:X P) (:X_rel *R_m1))
  (axis_of (:D *D1_m2) (:A *A1_m3))
  (opposite (:D D1_m2) (:Opp *O1_m4))
  (perp (:A A1_m3) (:A2 *A2_m5))
  (axis_of (:D *D2_m6) (:A A2_m5))
  (opposite (:D D2_m6) (:Opp *O2_m7))
  (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
  (> K1_m8 0)
  (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
  (> K2_m9 0)
  (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
  (> K3_m10 0)
  (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
  (> K4_m11 0)
  (input P (:Col *C)))

;; The shortest shift along the lines under which the strip agrees with itself.
(INIT &strip_shift Periods
  (cell (P (:v C))
    (&strip_in *P *C)))

(RULE &strip_out
  (&strip_in (:P *Q) *C)
  (input *P)
  (&line_axis *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B Q) (:D D_m2) (:K *K_m3))
  (margin (:B P) (:D D_m2) (:K K_m3))
  (&strip_shift.fundamental_period A *K)
  (axis_of *D A)
  (margin (:B Q) D (:K *T))
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (margin (:B P) D (:K *T2))
  (divide (:T T2) (:Side K) (:Gap 0) (:Remainder R)))

(RULE &on_pattern_line
  (OR ((input *P)
       (&strip_out (:P *Q) *C)
       (&pattern C)
       (&strip_span_axis (:A *A2))
       (perp (:A A2) (:A2 *A2_m1))
       (axis_of (:D *D_m2) (:A A2_m1))
       (margin (:B P) (:D D_m2) (:K *K_m3))
       (margin (:B Q) (:D D_m2) (:K K_m3)))
      ((input P)
       (&strip_out (:P *Q2) (:C *C2))
       (&pattern (:C C2))
       (&strip_span_axis (:A *A22))
       (diag_perp (:Da A22) (:Da2 *A2_m12))
       (diag_axis_of (:D *D_m22) (:Da A2_m12))
       (corner_dist P (:Diag D_m22) (:K *K_m32))
       (corner_dist (:P Q2) (:Diag D_m22) (:K K_m32)))))

(RULE &output
  (OR ((&line_cell *P)
       (&line (:C *Col)))
      ((&strip_out P (:C Col)))
      ((input P)
       (NOT (&strip_span_between P))
       (IF ((&on_pattern_line P))
           ((&frame_color (:C Col)))
           ((&bg (:C Col)))))))
