;; 575b1a71

(DET &mark ChangedColor)

(RULE &mark_line_split1
  (input (:P *P_) (:Col *M))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(DET &rank_dir DirDomain)

(RULE &mark_line
  (input *P (:Col *M))
  (&mark (:C M))
  (&rank_dir *D)
  (axis_of D *A)
  (&mark_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &order_axis
  (&mark_line)
  (&rank_dir *D)
  (axis_of D *A))

;; The lines holding a mark, ordered along that axis.
(INIT &order Order
  (key ((&order_axis ^A)
        (axis_of ^D A))
    (before ((:a L) (:b L2))
      (&mark_line *L)
      (&mark_line (:L *L2))
      (!= L L2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2)))
  (member ((:t L))
    (&mark_line *L)))

(RULE &order_pos
  (&order.rank (:key *A *D) (:t *M) (:R *R1))
  (&order.dual_rank (:key A D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &rank
  (&mark_line *P *L)
  (&order_pos (:M L) *P_pos)
  (&rank_dir *D)
  (margin (:B P_pos) D (:K *R)))

(DET &rank_color
  (&rank *E *P *R)
  (ex_output E P (:Col *C)))

(RULE &output
  (OR ((&rank *P *R)
       (&rank_color R (:C *Col)))
      ((input P Col)
       (NOT (&mark (:C Col))))))
