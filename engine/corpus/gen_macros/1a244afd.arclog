;; 1a244afd

(RULE &sight_dir
  (input)
  (dir_elem *D))

(RULE &sight_dir_ray
  (&sight_dir *D))

(RULE &sight_node
  (&sight_dir)
  (input *P))

(DET &pivot UnchangedColor)

(RULE &sight_source
  (input *P *Col)
  (&pivot (:C Col)))

;; Each pivot looks along its row and column for pointers.
(INIT &sight Distance
  (key ((&sight_source (:P ^O))
        (&sight_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:P O))
           (&sight_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:P Q)))
          ((&sight_source (:P O))
           (&sight_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:P Q))
           (= A2 O))
          ((&sight_source (:P O))
           (&sight_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:P Q)))))
    (source ((:n O))
      (&sight_source (:P O))
      (&sight_dir_ray D))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &pointer ChangedColor)

(DET &mark AnyOutNewColor)

(DET &sense SenseDomain)

(RULE &sight_cell
  (input *P *Col)
  (&pointer (:C Col)))

(RULE &cand
  (dir_elem *D)
  (&sight_ray (:P *Pointer) D *K (:Origin *Pivot))
  (&sight_cell (:P Pointer)))

(RULE &forcing_item
  (&cand (:Pivot *P) (:Pointer *Q))
  (OR ((= *P_cell P))
      ((= P_cell Q))))

;; The unique pairing: a candidate is kept when using every pivot and
;; pointer exactly once forces it — an exact cover of the cells by
;; two-cell pieces.
(CHOOSE &forcing
  (for ((&forcing_item ^P_cell))
    (from (&forcing_item P_cell *P *Q)))
  (never
    (&forcing_item *P_cell *P *Q)
    (&forcing_item (:P_cell *P_cell2) (:P *P2) (:Q *Q2))
    (&forcing_item (:P_cell P_cell2) P Q)
    (OR ((!= P P2))
        ((!= Q Q2)))))

(RULE &pair
  (&forcing (:P *Pivot) (:Q *Pointer))
  (&cand Pivot Pointer *D *K))

(RULE &mark_dir
  (&sense *S)
  (turn S *D (:D2 *D_out)))

(ALTS $choice "what turns it" $Turn
  (ALT $Table
    (DET &turn_map
      (&pair *E (:Pivot *P) *D *K)
      (ex_output E (:P *Q) *Col)
      (&mark (:C Col))
      (relative (:Base P) (:X Q) (:X_rel *V))
      (dir_elem (:D *D_out))
      (dir8_opposite (:D D_out) (:D2 *O_m1))
      (edge_inset (:D O_m1) K (:B *B1_m2))
      (edge_inset (:D D_out) K (:B *I_m4))
      (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C V)))

    (RULE &mark_dir
      (&turn_map *D *D_out))))

(RULE &mark2
  (&pair (:Pivot *P2) *D *K)
  (&mark_dir D *D_out)
  (dir8_opposite (:D D_out) (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset (:D D_out) K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(RULE &output
  (OR ((&mark2 *P)
       (&mark (:C *Col)))
      ((input P (:Col *Col_in))
       (NOT (&mark2 P))
       (OR ((&pointer (:C Col_in))
            (&bg (:C Col)))
           ((NOT (&pointer (:C Col_in)))
            (= Col Col_in))))))
