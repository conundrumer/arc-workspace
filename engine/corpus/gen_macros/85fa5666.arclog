;; 85fa5666

(RULE &sq_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &square UnchangedColor)

(RULE &sq_node
  (input *P *Col)
  (&square (:C Col)))

(INIT &sq Quotient
  (edge ((:a P) (:b P2))
    (OR ((&sq_node *P)
         (&sq_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&sq_node (:P P2)))
        ((&sq_node P)
         (= P2 P)))))

(RULE &sq_component
  (&sq.class (:a *P) *Id))

(RULE &ray_dir
  (diag_dir_elem (:D *Key)))

(RULE &ray_node
  (diag_dir_elem (:D *Key))
  (input *P))

(INIT &bbox BoundingBox
  (key ((&sq_component *P ^Id))
    (cell (P)
      (&sq_component *P Id))))

(RULE &seat
  (&sq_component (:P *P2) *Id)
  (&bbox.box (:key Id) *B)
  (ALL ((&sq_component (:P P2) (:Id *Idm))
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P2) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P2) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6))
  (step_offset D (:V *V_m7))
  (compose (:A P2) (:B V_m7) (:C *P)))

(RULE &ray_source
  (&seat (:D *Key) *P))

;; Each seat casts outward along its own corner's diagonal: the key is the
;; cast direction.
(INIT &ray Distance
  (key ((&ray_source (:Key ^Ky) (:P ^O))
        (&ray_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&ray_source (:Key Ky) (:P O))
           (&ray_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&ray_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&ray_node (:Key Ky) (:P Q)))
          ((&ray_source (:Key Ky) (:P O))
           (&ray_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&ray_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&ray_source (:Key Ky) (:P O))
           (&ray_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&ray_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&ray_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&ray_source (:Key Ky) (:P O))
      (&ray_dir (:Key Ky)))))

(RULE &ray_ray
  (&ray.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &ray_end
  (&ray_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&ray_ray Key (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &turn D4Domain)

(RULE &source
  (&turn (:D *R))
  (d4_elem (:D R))
  (diag_dir_elem (:D *D_from))
  (diag_dir_elem (:D *D_to))
  (step_offset (:D D_from) (:V *S_m1))
  (apply (:D R) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D D_to) (:V S2_m2)))

(RULE &ray_cell
  (input *P)
  (diag_dir_elem (:D *Key)))

(ALTS $choice "which corner a mark moves to" $Turn
  (ALT $Table
    (DET &corner_from
      (&seat *E *Id (:D *D_to) (:P *Q))
      (ex_output E (:P Q) *Col)
      (&seat E Id (:D *D_from) (:P *Q_from))
      (ex_input E (:P Q_from) Col))

    (RULE &source
      (&corner_from *D_to *D_from))))

(RULE &lit
  (&ray_ray (:Key *D) *P D (:Origin *Q))
  (&ray_cell (:Key D) P)
  (&seat *Id D (:P Q))
  (&source (:D_to D) *D_from)
  (&seat Id (:D D_from) (:P *Q_from))
  (input (:P Q_from) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&lit P *Col))
      ((&square (:C Col_in))
       (= Col Col_in))
      ((NOT (&lit P))
       (NOT (&square (:C Col_in)))
       (&bg (:C Col)))))
