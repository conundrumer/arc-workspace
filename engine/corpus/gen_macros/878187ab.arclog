;; 878187ab

(DET &bg DominantColor)

(INIT &marks Cardinality
  (key ((input (:P *P_grid_in) ^Col)
        (NOT (&bg (:C Col))))
    (member ((:m P_grid_in))
      (input (:P *P_grid_in) Col)
      (NOT (&bg (:C Col))))))

(INIT &counts Order
  (member ((:t N))
    (&marks.size *N))
  (score ((:t N) (:S N))
    (&marks.size *N)))

(DET &long_axis AxisDomain)

(INIT &box Frame
  (extent (A N)
    (&long_axis (:A *A_long))
    (OR ((perp (:A A_long) (:A2 *A))
         (&counts.minimal (:t *N)))
        ((= A A_long)
         (&counts.maximal (:t N))))))

(DET &anchor DiagDirDomain)

(RULE &x_edge
  (&anchor (:D *Diag))
  (&long_axis (:A *A_long))
  (perp (:A A_long) (:A2 *A))
  (corner_dir (:C Diag) A *D))

(RULE &xdiag_diagonal
  (&box.cell *P)
  (&x_edge (:D *E))
  (corner_dir (:C *Diag) (:D E))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) (:K *Ring))
  (margin (:B P) (:D D2_m3) (:K Ring)))

(DET &fill AnyOutNewColor)

(DET &canvas_side ConstOutDim)

(INIT &canvas Frame
  (extent (A N)
    (axis_elem *A)
    (&canvas_side *N)))

(DET &x_color
  (ex_output (:Col *C))
  (NOT (&bg C))
  (NOT (&fill C)))

(RULE &paint
  (&canvas.cell (:P *P_grid_out))
  (&box.cell (:P *P_inner))
  (&anchor (:D *Diag))
  (ALL ((corner_dir (:C Diag) (:D *D_m1))
        (margin (:B P_grid_out) (:D D_m1) (:K *K1_m2))
        (margin (:B P_inner) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (IF ((&xdiag_diagonal (:P P_inner)))
      ((&x_color (:C *Col)))
      ((&fill (:C Col)))))

(RULE &output
  (&canvas.cell *P)
  (OR ((&paint (:P_grid_out P) *Col))
      ((NOT (&paint (:P_grid_out P)))
       (&bg (:C Col)))))
