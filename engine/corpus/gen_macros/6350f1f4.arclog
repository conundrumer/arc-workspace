;; 6350f1f4

(DET &noise ChangedColor)

(DET &sep SharedColor)

(RULE &content
  (input *P *Col)
  (NOT (&sep (:C Col)))
  (NOT (&noise (:C Col))))

(RULE &content_line_split1
  (&content (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &content_line
  (&content *P)
  (axis_elem *A)
  (&content_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &lattice_divider_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &lattice_divider
  (input *P)
  (axis_elem *A)
  (&lattice_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (NOT (&content_line L)))

(RULE &lattice_on_divider
  (input *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &block BoundingBox
  (key ((&lattice_tile_of *P ^P_tile))
    (cell (P)
      (&lattice_tile_of *P P_tile))))

(RULE &block_cell
  (&lattice_tile_of *P *P_tile)
  (&block.box (:key P_tile) *B)
  (ALL ((&lattice_tile_of P (:P_tile *P_tilem))
        (&block.box (:key (:P_tile P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &cell
  (&block_cell *P *P_tile *P_intile)
  (&content P *Col))

;; A block showing two colors is a copy of the template; a solid field
;; shows one.
(INIT &block_color Singleton
  (key ((&cell ^P_tile *Col))
    (member ((:v Col))
      (&cell P_tile *Col))))

(RULE &template
  (&block_color.plural (:key *P_tile))
  (&cell P_tile *P_intile *Col))

(INIT &dominant_count Cardinality
  (key ((&template *P_intile ^Col))
    (member ((:m P_intile))
      (&template *P_intile Col))))

(INIT &dominant Order
  (member ((:t Col))
    (&dominant_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&dominant_count.size (:key *Col) *N)))

(RULE &minor_cell
  (&template (:P_intile *P) *Col)
  (NOT (&dominant.maximal (:t Col))))

(ALTS $choice "what each block becomes" $Expand
  (ALT $Invert
    (RULE &solid
      (&cell *P_tile *P_intile *Col)
      (&template P_intile (:Col *C2))
      (!= Col C2))

    (RULE &solid_color
      (&solid *P_tile)
      (&cell P_tile *Col))

    (RULE &output
      (OR ((&block_cell *P *P_tile *P_intile)
           (IF ((&solid P_tile))
               ((&template P_intile *Col))
               ((&template Col)
                (NOT (&solid_color Col)))))
          ((input P)
           (NOT (&lattice_tile_of P))
           (&sep (:C Col)))))))

(RULE &output
  (OR ((input *P)
       (NOT (&lattice_tile_of P))
       (&sep (:C *Col)))
      ((&block_cell P *P_tile *P_intile)
       (IF ((&minor_cell (:P P_tile)))
           ((&template P_intile Col))
           ((&dominant.maximal (:t Col)))))))
