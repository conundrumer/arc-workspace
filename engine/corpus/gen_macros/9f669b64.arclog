;; 9f669b64

(INPUT background "every cell not in one of three objects is the background color")

(INPUT wedge "one object is a wedge. It narrows toward one side, and its narrow end touches the projectile.")

(INPUT projectile "one solid rectangle touches the wedge's narrow end. Its width across the launch direction is even.")

(INPUT target "one solid rectangle lies in line with the projectile, on the side away from the wedge. It spans the projectile's whole width across the launch direction, and it extends past the projectile on both sides. It may touch the projectile or lie across a background gap.")

(OUTPUT launch-direction "the projectile moves in the direction that points from the wedge through the projectile")

(OUTPUT wedge-stays "the wedge keeps its cells")

(OUTPUT projectile-to-edge "the projectile moves in the launch direction until its far side touches the grid edge. Its old cells become background."

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET_OR_RULE &bg DominantColor)

  (RULE &piece_node
    (input *P (:Col *Key))
    (NOT (&bg (:C Key))))

  (INIT &piece Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&piece_node (:Key *Ky) *P)
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&piece_node (:Key Ky) (:P P2)))
          ((&piece_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &piece_component
    (&piece.class (:a *Key *P) *Id))

  (RULE &obj
    (&piece_component *P *Id))

  (INIT &hull BoundingBox
    (key ((&obj ^Id *P))
      (cell (P)
        (&obj Id *P))))

  (RULE &hole
    (&hull.box (:key *Id) *B)
    (input *P)
    (ALL ((&hull.box (:key (:Id *Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&obj Id P)))

  (RULE &rect
    (&hull.box (:key *Id))
    (NOT (&hole Id)))

  (RULE &touch
    (&obj *Id *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&obj (:Id *Id2) (:P Q))
    (!= Id Id2))

  (RULE &beyond
    (&hull.box (:key *Id) *B)
    (&hull.box (:key (:Id *Id2)) (:B *B2))
    (!= Id Id2)
    (opposite *D (:Opp *D_back))
    (&obj Id *P)
    (ALL ((&obj (:Id *Idm) P)
          (&hull.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D D_back) (:K *K_m1))
    (margin B (:D D_back) (:K K_m1))
    (dir_elem D)
    (margin (:B P) D (:K *K1_m2))
    (margin (:B B2) D (:K *K2_m3))
    (< K1_m2 K2_m3))

  (RULE &roles
    (&touch (:Id *W) (:Id2 *P))
    (NOT (&rect (:Id W)))
    (&rect (:Id P))
    (&rect (:Id *T))
    (!= T P))

  (RULE &shot
    (&roles *W *P *T)
    (&beyond (:Id W) (:Id2 P) (:D *D_back))
    (opposite (:D D_back) (:Opp *D)))

  ;; The projectile moves toward D until it rests against the grid edge.
  (INIT &fall Distance
    (key ((&shot ^P ^D))
      (source_distance (K)
        (&obj (:Id P) (:P *Q))
        (margin (:B Q) D *K)))))

(OUTPUT target-split "the center line of the projectile's path cuts the target in two halves. Each half shifts outward, away from that line and across the launch direction, by half the projectile's width."

  ;; Each object's lines across each direction, ranked from that edge.
  (INIT &lines Order
    (key ((&obj ^Id *P)
          (dir_elem ^D)
          (margin (:B P) D *K))
      (member ((:t K))
        (&obj Id *P)
        (dir_elem D)
        (margin (:B P) D *K))
      (score ((:t K) (:S K))
        (&obj Id *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &half_line
    (&lines.rank (:key *Id *D) (:t *K) *R)
    (&lines.dual_rank (:key Id D) (:t K) (:R *R2))
    (< R R2))

  (RULE &halves
    (&shot *P *T *D)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2)))

  ;; The count of the object's lines in its half toward D.
  (INIT &half_width Cardinality
    (key ((OR ((&half_line ^Id ^D *K))
              ((&hull.box (:key Id))
               (dir_elem D))))
      (member ((:m K))
        (&half_line Id D *K))
      (domain ()
        (&hull.box (:key Id))
        (dir_elem D))))

  ;; The projectile's center line cuts the target.
  (RULE &half
    (&halves *P *T *D *E1)
    (&obj (:Id T) (:P *Q))
    (margin (:B Q) (:D E1) (:K *K_q))
    (&half_line (:Id P) (:D E1) *K)
    (<= K_q K))

  ;; The projectile's lines each half covers ahead of the projectile.
  (INIT &cover Cardinality
    (key ((OR ((&half ^P ^T ^D *Q (:E1 ^E))
               (&hull.box (:key (:Id P)) *B)
               (dir_elem D)
               (margin (:B Q) D (:K *K1_m1))
               (margin B D (:K *K2_m2))
               (< K1_m1 K2_m2)
               (margin (:B Q) (:D E) *K)
               (&obj (:Id P) (:P *Q2))
               (margin (:B Q2) (:D E) K))
              ((&halves P T D (:E1 E)))))
      (member ((:m K))
        (&half P T D *Q (:E1 E))
        (&hull.box (:key (:Id P)) *B)
        (dir_elem D)
        (margin (:B Q) D (:K *K1_m1))
        (margin B D (:K *K2_m2))
        (< K1_m1 K2_m2)
        (margin (:B Q) (:D E) *K)
        (&obj (:Id P) (:P *Q2))
        (margin (:B Q2) (:D E) K))
      (domain ()
        (&halves P T D (:E1 E))))))

(OUTPUT path-clear "the cells in the projectile's path that the moved projectile does not cover are background")

(ALTS $roles "which objects are the wedge, the projectile, and the target" $Touch
  (ALT $ProjectileBetween
    (INPUT projectile "the projectile is the object with the other two wholly on opposite sides of it along one axis. The target is the one of those two that is a solid rectangle spanning the projectile across that axis, and the wedge is the other."
      (RULE &roles
        (&beyond (:Id *T) (:Id2 *P) *D)
        (opposite D (:Opp *D2))
        (&beyond (:Id *W) (:Id2 P) (:D D2))
        (&rect (:Id T))
        (ALL ((&hull.box (:key (:Id P)) *B)
              (&hull.box (:key (:Id T)) (:B *B2))
              (!= P T)
              (axis_of D (:A *A_m1))
              (perp (:A A_m1) (:A2 *A2_m2))
              (axis_of (:D *E) (:A A2_m2))
              (dir_elem (:D E))
              (margin (:B B2) (:D E) (:K *K1_m3))
              (margin B (:D E) (:K *K2_m4)))
             ((< K1_m3 K2_m4)))))))

(ALTS $launch "the direction the projectile moves" $FromWedge
  (ALT $TowardTarget
    (OUTPUT launch-direction "the projectile moves toward the side on which the target lies wholly beyond it"
      (RULE &shot
        (&roles *P *T)
        (&beyond (:Id T) (:Id2 P) *D))))
  (ALT $WedgeTip
    (OUTPUT launch-direction "the projectile moves toward the side the wedge narrows to: off its back side, every wedge cell has a wedge cell behind it"
      (RULE &unbacked
        (&hull.box (:key *Id) *B)
        (&obj Id *P)
        (opposite *D (:Opp *D_back))
        (step_offset (:D D_back) (:V *V_m6))
        (compose (:A P) (:B V_m6) (:C *Q))
        (NOT (&obj Id (:P Q)))
        (OR ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3))
             (< K_m3 0))
            ((margin (:B P) (:D D_back) (:K *K1_m4))
             (margin B (:D D_back) (:K *K2_m5))
             (!= K1_m4 K2_m5))))

      (RULE &stepped
        (&hull.box (:key *Id) *B)
        (&obj Id *P)
        (dir_elem *D)
        (step_offset D (:V *V_m6))
        (compose (:A P) (:B V_m6) (:C *Q))
        (NOT (&obj Id (:P Q)))
        (OR ((dir_elem (:D *D_m1))
             (relative (:Base B) (:X P) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3))
             (< K_m3 0))
            ((margin (:B P) D (:K *K1_m4))
             (margin B D (:K *K2_m5))
             (!= K1_m4 K2_m5))))

      (RULE &shot
        (&roles *W *P *T)
        (&stepped (:Id W) *D)
        (NOT (&unbacked (:Id W) D))))))

(ALTS $stop "where the projectile stops" $ToEdge
  (ALT $StopPerAxis
    (OUTPUT projectile-to-edge "along &far_axis, the projectile's leading side stops on the target's far side. Along the other axis, its trailing side stops on the target's near side."
      ;; The axis on which the projectile stops by its leading side.
      (DET &far_axis AxisDomain)

      (RULE &anchor
        (OR ((axis_of *D *A)
             (NOT (&far_axis A))
             (opposite D (:Opp *D_anchor)))
            ((&far_axis (:A *A2))
             (axis_of D (:A A2))
             (= D_anchor D)))))
    (RULE &travel
      (&shot *P *T *D)
      (&anchor D (:D_anchor *D_a))
      (axis_of D *A)
      (&hull.box (:key (:Id P)) *B)
      (&obj (:Id P) (:P *Q))
      (ALL ((&obj (:Id *Pm) (:P Q))
            (&hull.box (:key (:Id Pm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X Q) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B Q) (:D D_a) (:K *K_m1))
      (margin B (:D D_a) (:K K_m1))
      (&hull.box (:key (:Id T)) (:B *B2))
      (&obj (:Id T) (:P *Q2))
      (ALL ((&obj (:Id *Tm) (:P Q2))
            (&hull.box (:key (:Id Tm)) (:B B2))
            (dir_elem (:D *D_m1m))
            (relative (:Base B2) (:X Q2) (:X_rel *R_m2m))
            (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
           ((>= K_m3m 0)))
      (margin (:B Q2) (:D D_a) (:K *K_m2))
      (margin (:B B2) (:D D_a) (:K K_m2))
      (perp A (:A2 *A2_m3))
      (axis_of (:D *D_m4) (:A A2_m3))
      (margin (:B Q) (:D D_m4) (:K *K_m5))
      (margin (:B Q2) (:D D_m4) (:K K_m5))
      (relative (:Base Q) (:X Q2) (:X_rel *V)))))

(ALTS $shift "how far each target half moves" $HalfWidth
  (ALT $ShiftOne
    (OUTPUT target-split "each half shifts by &shift. A cell on the cut line is in neither half, and the model is undefined."
      (DET &shift DivisorRatio))
    (RULE &amount
      (&halves *P *T *D *E1)
      (&shift *K)))
  (ALT $OddFloor
    (OUTPUT target-split "each half shifts by the count of projectile lines strictly on its side of the projectile's center line. A cell on the cut line is in neither half, and the model is undefined.")
    (RULE &amount
      (&halves *P *T *D *E1)
      (&half_width.size (:key (:Id P) (:D E1)) (:N *K))))
  (ALT $PushOut
    (OUTPUT target-split "each half shifts by the count of the projectile's lines it covers ahead of the projectile. A cell on the cut line is in neither half, and the model is undefined.")
    (RULE &amount
      (&cover.size (:key *P *T *D (:E *E1)) (:N *K)))))

(ALTS $split "where the target is cut" $PathCenter
  (ALT $SplitTargetCenter
    (OUTPUT target-split "the target's own center line cuts it in two halves. A cell on that line is in neither half, and the model is undefined."
      (RULE &half
        (&halves *P *T *D *E1)
        (&obj (:Id T) (:P *Q))
        (margin (:B Q) (:D E1) (:K *K_q))
        (&half_line (:Id T) (:D E1) *K)
        (<= K_q K)))))

(RULE &fall_dir
  (&shot (:P *Id) *D))

(RULE &travel
  (&shot *P *T *D)
  (&fall.distance (:key P D) *K)
  (&fall_dir (:Id P) D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V)))

(RULE &flies
  (&shot (:P *P2) *T *D)
  (&travel (:P P2) T D *V)
  (&obj (:Id P2) (:P *P_cell))
  (input (:P P_cell) *Col)
  (compose (:A P_cell) (:B V) (:C *P)))

(RULE &center_line
  (&lines.rank (:key *Id *D) (:t *K) *R)
  (&lines.dual_rank (:key Id D) (:t K) R))

(RULE &amount
  (&halves *P *T *D *E1)
  (&half_width.size (:key (:Id P) (:D E1)) (:N *K))
  (NOT (&center_line (:Id P) (:D E1))))

(RULE &lands
  (&shot (:P *P2) *T *D)
  (&half (:P P2) T D (:Q *P) (:E1 *E))
  (&amount (:P P2) T D (:E1 E) *K)
  (dir8_opposite (:D E) (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset (:D E) K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q)))

(RULE &stranded
  (&shot *T)
  (&obj (:Id T) *P)
  (NOT (&lands P)))

(RULE &ground
  (&shot (:P *P_id) *T)
  (input *P (:Col *Col_in))
  (OR ((&obj (:Id P_id) P)
       (&bg (:C *Col)))
      ((NOT (&obj (:Id P_id) P))
       (NOT (&obj (:Id T) P))
       (= Col Col_in))
      ((&obj (:Id T) P)
       (&bg (:C Col)))))

(RULE &ambiguous
  (&shot *P *T *D)
  (&shot (:P *P2) (:T *T2) (:D *D2))
  (OR ((!= P P2))
      ((!= T T2))
      ((!= D D2))))

(RULE &ready
  (&shot *P *T *D)
  (NOT (&ambiguous))
  (&travel P T D)
  (NOT (&stranded)))

;; The moved projectile over the moved target over the ground.
(RULE &output
  (&ready)
  (input *P)
  (OR ((&flies P *Col))
      ((&lands (:P *P2) (:Q P))
       (NOT (&flies P))
       (input (:P P2) Col))
      ((&ground P Col)
       (NOT (&flies P))
       (NOT (&lands (:Q P))))))
