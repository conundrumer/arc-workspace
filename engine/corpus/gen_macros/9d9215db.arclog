;; 9d9215db

(INPUT lattice "the ink sits on a lattice of every other cell, held one blank cell in from the grid's border")

(INPUT rings "the lattice peels into square rings, one per distance from the nearest lattice edge, and each inked cell sits on one of them")

(INPUT nesting "the inked rings run consecutively from the outermost")

(INPUT corner-ink "every inked ring holds ink at one of its four corners")

(INPUT patch "a ring's ink away from its corners sits one step along the ring from a corner")

(OUTPUT draw "the output draws one ring per ring that holds ink")

(OUTPUT seat "each drawn ring sits on the ring it came from"

  (RULE &peel_depth_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The blank border the lattice sits inside.
  (DET &margin DivisorRatio)

  (RULE &lat_division_axis_uniform_inset1
    (&margin (:K *M_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K M_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K M_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K M_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K M_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (DET &lat_gap DivisorRatio)

  ;; A lattice cell is one grid cell, with one blank cell to the next.
  (DET &lat_size DivisorRatio)

  (RULE &lat_division_axis_uniform_inset2
    (&margin (:K *M_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K M_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K M_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K M_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K M_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &lat_division_gap
    (axis_elem *A)
    (&lat_gap (:K *G)))

  (RULE &lat_division_axis_split1
    (&margin (:K *M))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m7))
    (edge_inset (:D D1_m1) (:K M) (:B *B1_m8))
    (edge_inset (:D O_m7) (:K M) (:B *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m10))
    (edge_inset (:D D2_m4) (:K M) (:B *B1_m11))
    (edge_inset (:D O_m10) (:K M) (:B *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B))
    (input (:P *P_grid))
    (relative (:Base B) (:X P_grid) (:X_rel *P_rel_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_rel_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_rel_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m13))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m14))
    (edge_inset (:D O_m13) (:K K2_m4) (:B *B2_m15))
    (compose (:A B1_m14) (:B B2_m15) (:C *Pi_))
    (relative (:Base Pi_) (:X P_rel_) (:X_rel *X_m1_)))

  (RULE &lat_division_axis_uniform_inset3
    (&margin (:K *M_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K M_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K M_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K M_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K M_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &lat_division_side
    (axis_elem *A)
    (&lat_size *K))

  (RULE &lat_division_axis
    (OR ((input (:P *P_grid))
         (&margin (:K *M))
         (&lat_division_axis_uniform_inset1 (:M_ M) (:B_ *B))
         (ALL ((&margin (:K *Mm))
               (axis_of (:D *D1_m1) (:A *A1_m2))
               (perp (:A A1_m2) (:A2 *A2_m3))
               (axis_of (:D *D2_m4) (:A A2_m3))
               (opposite (:D D1_m1) (:Opp *O_m7))
               (edge_inset (:D D1_m1) (:K Mm) (:B *B1_m8))
               (edge_inset (:D O_m7) (:K Mm) (:B *B2_m9))
               (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5m))
               (opposite (:D D2_m4) (:Opp *O_m10))
               (edge_inset (:D D2_m4) (:K Mm) (:B *B1_m11))
               (edge_inset (:D O_m10) (:K Mm) (:B *B2_m12))
               (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6m))
               (compose (:A B1_m5m) (:B B2_m6m) (:C B))
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (relative (:Base B) (:X P_grid) (:X_rel *P))
         (axis_elem *A)
         (&lat_size *K)
         (&lat_gap (:K *G))
         (axis_of *D A)
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T))
         (margin (:B P) (:D O) (:K *T2))
         (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
         (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
         (frame_extent (:P P_inner) A (:N K)))
        ((input (:P *P_grid2))
         (&margin (:K *M2))
         (&lat_division_axis_uniform_inset2 (:M_ M2) (:B_ *B2))
         (ALL ((&margin (:K *Mm2))
               (axis_of (:D *D1_m12) (:A *A1_m22))
               (perp (:A A1_m22) (:A2 *A2_m32))
               (axis_of (:D *D2_m42) (:A A2_m32))
               (opposite (:D D1_m12) (:Opp *O_m72))
               (edge_inset (:D D1_m12) (:K Mm2) (:B *B1_m82))
               (edge_inset (:D O_m72) (:K Mm2) (:B *B2_m92))
               (compose (:A B1_m82) (:B B2_m92) (:C *B1_m5m2))
               (opposite (:D D2_m42) (:Opp *O_m102))
               (edge_inset (:D D2_m42) (:K Mm2) (:B *B1_m112))
               (edge_inset (:D O_m102) (:K Mm2) (:B *B2_m122))
               (compose (:A B1_m112) (:B B2_m122) (:C *B2_m6m2))
               (compose (:A B1_m5m2) (:B B2_m6m2) (:C B2))
               (dir_elem (:D *D_m12))
               (relative (:Base B2) (:X P_grid2) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (relative (:Base B2) (:X P_grid2) (:X_rel P))
         (axis_elem A)
         (&lat_size (:K *K2))
         (NOT (&lat_division_gap A))
         (axis_of (:D *D2) A)
         (opposite (:D D2) (:Opp *O2))
         (margin (:B P) (:D D2) (:K *T3))
         (margin (:B P) (:D O2) (:K *T22))
         (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
         (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
         (opposite (:D D2) (:Opp *O_m12))
         (edge_inset (:D D2) (:K I3) (:B *B1_m22))
         (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
         (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
         (opposite (:D D2) (:Opp *O_m42))
         (edge_inset (:D D2) (:K R3) (:B *B1_m52))
         (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
         (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
         (frame_extent (:P P_inner) A (:N K2)))
        ((input (:P *P_grid3))
         (&margin (:K *M3))
         (&lat_division_axis_uniform_inset3 (:M_ M3) (:B_ *B3))
         (ALL ((&margin (:K *Mm3))
               (axis_of (:D *D1_m13) (:A *A1_m23))
               (perp (:A A1_m23) (:A2 *A2_m33))
               (axis_of (:D *D2_m43) (:A A2_m33))
               (opposite (:D D1_m13) (:Opp *O_m73))
               (edge_inset (:D D1_m13) (:K Mm3) (:B *B1_m83))
               (edge_inset (:D O_m73) (:K Mm3) (:B *B2_m93))
               (compose (:A B1_m83) (:B B2_m93) (:C *B1_m53))
               (opposite (:D D2_m43) (:Opp *O_m103))
               (edge_inset (:D D2_m43) (:K Mm3) (:B *B1_m113))
               (edge_inset (:D O_m103) (:K Mm3) (:B *B2_m123))
               (compose (:A B1_m113) (:B B2_m123) (:C *B2_m63))
               (compose (:A B1_m53) (:B B2_m63) (:C B3))
               (dir_elem (:D *D_m13))
               (relative (:Base B3) (:X P_grid3) (:X_rel *R_m23))
               (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
              ((>= K_m33 0)))
         (relative (:Base B3) (:X P_grid3) (:X_rel P))
         (axis_elem A)
         (NOT (&lat_division_side A))
         (&lat_division_axis_split1 (:P_rel_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

  (RULE &lat_division_tile
    (&lat_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&lat_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (RULE &lat_uniform_inset1
    (&margin (:K *M_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K M_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K M_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K M_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K M_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &lat
    (input (:P *P_grid))
    (&margin (:K *M))
    (&lat_uniform_inset1 (:M_ M) (:B_ *B))
    (ALL ((&margin (:K *Mm))
          (axis_of (:D *D1_m1) (:A *A1_m2))
          (perp (:A A1_m2) (:A2 *A2_m3))
          (axis_of (:D *D2_m4) (:A A2_m3))
          (opposite (:D D1_m1) (:Opp *O_m7))
          (edge_inset (:D D1_m1) (:K Mm) (:B *B1_m8))
          (edge_inset (:D O_m7) (:K Mm) (:B *B2_m9))
          (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
          (opposite (:D D2_m4) (:Opp *O_m10))
          (edge_inset (:D D2_m4) (:K Mm) (:B *B1_m11))
          (edge_inset (:D O_m10) (:K Mm) (:B *B2_m12))
          (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
          (compose (:A B1_m5) (:B B2_m6) (:C B))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P_grid) (:X_rel *P_rel))
    (&lat_division_tile (:P P_rel) (:P_outer *P_lat)))

  (INIT &peel Boundary
    (cell ((:P P_lat))
      (&lat *P_lat)))

  (INIT &peel_depth Distance
    (edge ((:a P_lat) (:b P_lat2))
      (&lat *P_lat)
      (&peel_depth_steps (:Delta *S))
      (compose (:A P_lat) (:B S) (:C *P_lat2))
      (&lat (:P_lat P_lat2)))
    (source ((:n P))
      (&peel.boundary *P)))

  (RULE &elem_uniform_inset1
    (&peel_depth.distance (:n *P_lat) (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &score_uniform_inset1
    (&peel_depth.distance (:n *P_lat) (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (DET_OR_RULE &bg DominantColor)

  (RULE &ink
    (&lat *P_grid *P_lat)
    (input (:P P_grid) *Col)
    (NOT (&bg Col)))

  ;; Distances from a lattice cell to the four corners of its own ring; the
  ;; lowest of them runs along that ring.
  (INIT &reach Order
    (key ((OR ((&peel_depth.distance (:n ^P_lat) *K)
               (&elem_uniform_inset1 (:K_ K) (:B_ *B))
               (relative (:Base B) (:X P_lat) (:X_rel *P_rel))
               (diag_dir_elem (:D *Diag))
               (corner_dist (:P P_rel) Diag (:K *J)))
              ((&peel_depth.distance (:n P_lat) K)
               (&score_uniform_inset1 (:K_ K) (:B_ B))
               (relative (:Base B) (:X P_lat) (:X_rel P_rel))
               (diag_dir_elem (:D Diag))
               (corner_dist (:P P_rel) Diag (:K J)))))
      (member ((:t J))
        (&peel_depth.distance (:n P_lat) *K)
        (&elem_uniform_inset1 (:K_ K) (:B_ *B))
        (relative (:Base B) (:X P_lat) (:X_rel *P_rel))
        (diag_dir_elem (:D *Diag))
        (corner_dist (:P P_rel) Diag (:K *J)))
      (score ((:t J) (:S J))
        (&peel_depth.distance (:n P_lat) *K)
        (&score_uniform_inset1 (:K_ K) (:B_ *B))
        (relative (:Base B) (:X P_lat) (:X_rel *P_rel))
        (diag_dir_elem (:D *Diag))
        (corner_dist (:P P_rel) Diag (:K *J)))))

  (RULE &place
    (&peel_depth.distance (:n *P_lat) *K)
    (&reach.minimal (:key P_lat) (:t *J)))

  (RULE &source
    (&ink *P_lat)
    (&place P_lat *K))

  (INIT &order Order
    (member ((:t K))
      (&source *K))
    (score ((:t K) (:S K))
      (&source *K))))

(OUTPUT corners "a drawn ring's four corner cells take the color of the ink at a corner of the ring it came from")

(OUTPUT sides "the rest of a drawn ring takes the color of the ink away from the corners of the ring it came from")

(OUTPUT blank "every other cell takes the background"

  (RULE &corner_uniform_inset1
    (&peel_depth.distance (:n *P_lat) (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m1))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K_) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m4))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m6))
    (edge_inset (:D O_m4) (:K K_) (:B *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

  (RULE &corner
    (&peel_depth.distance (:n *P_lat) *K)
    (&corner_uniform_inset1 (:K_ K) (:B_ *B))
    (diag_dir_elem (:D *Diag))
    (ALL ((&peel_depth.distance (:n P_lat) (:K *Km))
          (axis_of (:D *D1_m1) (:A *A1_m2))
          (perp (:A A1_m2) (:A2 *A2_m3))
          (axis_of (:D *D2_m4) (:A A2_m3))
          (opposite (:D D1_m1) (:Opp *O_m7))
          (edge_inset (:D D1_m1) (:K Km) (:B *B1_m8))
          (edge_inset (:D O_m7) (:K Km) (:B *B2_m9))
          (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
          (opposite (:D D2_m4) (:Opp *O_m10))
          (edge_inset (:D D2_m4) (:K Km) (:B *B1_m11))
          (edge_inset (:D O_m10) (:K Km) (:B *B2_m12))
          (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
          (compose (:A B1_m5) (:B B2_m6) (:C B))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P_lat) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (ALL ((&peel_depth.distance (:n P_lat) (:K *Kmm))
          (axis_of (:D *D1_m1m) (:A *A1_m2m))
          (perp (:A A1_m2m) (:A2 *A2_m3m))
          (axis_of (:D *D2_m4m) (:A A2_m3m))
          (opposite (:D D1_m1m) (:Opp *O_m7m))
          (edge_inset (:D D1_m1m) (:K Kmm) (:B *B1_m8m))
          (edge_inset (:D O_m7m) (:K Kmm) (:B *B2_m9m))
          (compose (:A B1_m8m) (:B B2_m9m) (:C *B1_m5m))
          (opposite (:D D2_m4m) (:Opp *O_m10m))
          (edge_inset (:D D2_m4m) (:K Kmm) (:B *B1_m11m))
          (edge_inset (:D O_m10m) (:K Kmm) (:B *B2_m12m))
          (compose (:A B1_m11m) (:B B2_m12m) (:C *B2_m6m))
          (compose (:A B1_m5m) (:B B2_m6m) (:C B))
          (corner_dir (:C Diag) (:D *D_m1m))
          (margin (:B P_lat) (:D D_m1m) (:K *K1_m2))
          (margin B (:D D_m1m) (:K *K2_m3)))
         ((= K1_m2 K2_m3))))

  (RULE &side_place
    (&place *P_lat *J)
    (NOT (&corner P_lat)))

  ;; The side ink reaches every place of the ring but its corners.
  (RULE &copy
    (&side_place (:J *J_out))
    (&side_place (:J *J_src))))

(ALTS $seat "which ring a drawn ring sits on" $Own
  (ALT $Nest
    (OUTPUT seat "the drawn rings take the outermost rings, in the order of the rings they came from")
    (RULE &draw
      (&order.rank (:t *K) (:R *K_out))
      (&place *P_lat (:K K_out) (:J *J_out))
      (&ink (:P_lat *Q_lat) *Col)
      (&place (:P_lat Q_lat) K (:J *J_src))
      (OR ((&corner P_lat)
           (&corner (:P_lat Q_lat)))
          ((&copy J_out J_src))))))

(ALTS $src "what makes a ring one the output draws" $AnyInk
  (ALT $CornerInk
    (OUTPUT draw "the output draws one ring per ring that holds ink at one of its corners"
      (RULE &source
        (&ink *P_lat)
        (&corner P_lat)
        (&place P_lat *K)))))

(ALTS $sp "how far the side ink reaches along the ring it draws" $Full
  (ALT $Span
    (OUTPUT sides "a drawn ring's cells no nearer a corner than the side ink is to a corner of the ring it came from take that ink's color"
      ;; The side ink reaches the places no nearer a corner than the ink itself.
      (RULE &copy
        (&side_place (:J *J_out))
        (&side_place (:J *J_src))
        (>= J_out J_src)))))

(RULE &draw
  (&source *K)
  (&place *P_lat K (:J *J_out))
  (&ink (:P_lat *Q_lat) *Col)
  (&place (:P_lat Q_lat) K (:J *J_src))
  (OR ((&corner P_lat)
       (&corner (:P_lat Q_lat)))
      ((&copy J_out J_src))))

(RULE &drawn
  (&lat *P_grid *P_lat)
  (&draw P_lat))

(RULE &output
  (OR ((&lat (:P_grid *P) *P_lat)
       (&draw P_lat *Col))
      ((input P)
       (NOT (&drawn (:P_grid P)))
       (&bg Col))))
