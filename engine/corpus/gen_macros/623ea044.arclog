;; 623ea044

(RULE &diag_dir
  (diag_dir_elem *D))

(RULE &diag_node
  (input *P))

(DET &bg DominantColor)

(RULE &diag_source
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &diag Distance
  (key ((&diag_source (:P ^O))
        (&diag_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&diag_source (:P O))
           (&diag_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&diag_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&diag_node (:P Q)))
          ((&diag_source (:P O))
           (&diag_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&diag_node (:P Q))
           (= A2 O))
          ((&diag_source (:P O))
           (&diag_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&diag_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&diag_node (:P Q)))))
    (source ((:n O))
      (&diag_source (:P O))
      (&diag_dir D))))

(RULE &diag_ray
  (&diag.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &diag_end
  (&diag_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&diag_ray (:P Q) D Origin)))

(RULE &output
  (input *P)
  (OR ((&diag_ray P (:Origin *Src))
       (input (:P Src) *Col))
      ((NOT (&diag_ray P))
       (&bg (:C Col)))))
