;; be03b35f

(DET &frame Frame)

(DET &correspondence_corner_anchor1
  (diag_dir_elem (:D *Diag_))
  (&frame (:P *P_anchor_))
  (ex_input *E (:P *P_in_) *Col)
  (corner_dir (:C Diag_) (:D *D_m1))
  (margin (:B P_anchor_) (:D D_m1) (:K *K1_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K2_m3))
  (!= K1_m2 K2_m3))

(DET &source_corner_anchor1
  (diag_dir_elem (:D *Diag_))
  (&frame (:P *P_anchor_))
  (ex_input *E (:P *P_in_) *Col)
  (corner_dir (:C Diag_) (:D *D_m1))
  (margin (:B P_anchor_) (:D D_m1) (:K *K1_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K2_m3))
  (!= K1_m2 K2_m3))

(DET &d4m_src_corner_anchor1
  (diag_dir_elem (:D *Diag_))
  (&frame (:P *P_anchor_))
  (ex_input *E (:P *P_in_) *Col)
  (corner_dir (:C Diag_) (:D *D_m1))
  (margin (:B P_anchor_) (:D D_m1) (:K *K1_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K2_m3))
  (!= K1_m2 K2_m3))

;; Each quadrant's anchored cells must map onto the whole output.
(INIT &d4m Agreement
  (key ((OR ((diag_dir_elem (:D ^Diag))
             (ex_input ^E (:P *P_in) *Col)
             (ex_output E)
             (&frame (:P *P_anchor))
             (NOT (&correspondence_corner_anchor1 (:Diag_ Diag) (:P_anchor_ P_anchor) (:P_in_ P_in)))
             (d4_elem *D)
             (apply D (:P P_anchor) (:P_out *Q)))
            ((diag_dir_elem (:D Diag))
             (ex_input E (:P P_in) Col)
             (ex_output E)
             (&frame (:P P_anchor))
             (NOT (&source_corner_anchor1 (:Diag_ Diag) (:P_anchor_ P_anchor) (:P_in_ P_in))))
            ((diag_dir_elem (:D Diag))
             (ex_output E *P Col))))
    (source ((:i P_anchor) (:v Col))
      (diag_dir_elem (:D Diag))
      (ex_input E (:P *P_in) *Col)
      (ex_output E)
      (&frame (:P *P_anchor))
      (NOT (&source_corner_anchor1 (:Diag_ Diag) (:P_anchor_ P_anchor) (:P_in_ P_in))))
    (target ((:i P) (:v Col))
      (diag_dir_elem (:D Diag))
      (ex_output E *P *Col))
    (correspondence ((:m D) (:i P_anchor) (:j Q))
      (diag_dir_elem (:D Diag))
      (ex_input E (:P *P_in) *Col)
      (ex_output E)
      (&frame (:P *P_anchor))
      (NOT (&correspondence_corner_anchor1 (:Diag_ Diag) (:P_anchor_ P_anchor) (:P_in_ P_in)))
      (d4_elem *D)
      (apply D (:P P_anchor) (:P_out *Q)))))

(DET &broken
  (&d4m.mismatch (:key *E *Diag) (:m *D4))
  (ex_output E))

(DET &d4m_src
  (diag_dir_elem (:D *Diag))
  (ex_input *E (:P *P_in) (:Col *V))
  (ex_output E)
  (&frame *P)
  (NOT (&d4m_src_corner_anchor1 (:Diag_ Diag) (:P_anchor_ P) (:P_in_ P_in))))

(DET &template
  (&d4m_src *E *Diag)
  (d4_elem (:D *D4))
  (NOT (&d4m.mismatch (:key E Diag) (:m D4)))
  (ex_output E)
  (NOT (&broken Diag D4)))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&template *Diag (:D4 *D))
  (&frame (:P *P_anchor))
  (ALL ((&template Diag (:D4 *Dm))
        (input (:P P_grid_in) (:Col *Colm))
        (corner_dir (:C Diag) (:D *D_m1))
        (margin (:B P_anchor) (:D D_m1) (:K *K1_m2))
        (margin (:B P_grid_in) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (apply D (:P P_anchor) (:P_out *P)))
