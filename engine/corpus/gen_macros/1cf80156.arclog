;; 1cf80156

(DET &bg DominantColor)

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &output
  (input (:P *P_grid) *Col)
  (&bbox.box *B)
  (ALL ((input (:P P_grid) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P_grid) (:X_rel *P)))
