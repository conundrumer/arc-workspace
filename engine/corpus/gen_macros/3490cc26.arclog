;; 3490cc26

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &blocks Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *P) *Id))

(RULE &sight_dir
  (dir_elem *D))

(INIT &bb BoundingBox
  (key ((&blocks_component *P ^Id))
    (cell (P)
      (&blocks_component *P Id))))

(RULE &block
  (&bb.box (:key *Id) *B)
  (&blocks_component *P Id)
  (input P *Col))

(RULE &sight_blocked
  (&block (:B *P)))

(RULE &sight_node
  (input *P)
  (NOT (&sight_blocked P)))

(RULE &sight_source
  (&block (:B *P)))

;; Blocks look along their lines, and each block stops the look behind it.
(INIT &sight Distance
  (key ((&sight_source (:P ^O))
        (&sight_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:P O))
           (&sight_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:P Q)))
          ((&sight_source (:P O))
           (&sight_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:P Q))
           (= A2 O))
          ((&sight_source (:P O))
           (&sight_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:P Q)))))
    (source ((:n O))
      (&sight_source (:P O))
      (&sight_dir D))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(RULE &sight_full_dir
  (dir_elem *D))

(RULE &sight_full_node
  (input *P))

(RULE &sight_full_source
  (&block (:B *P)))

(INIT &sight_full Distance
  (key ((&sight_full_source (:P ^O))
        (&sight_full_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_full_source (:P O))
           (&sight_full_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_full_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_full_node (:P Q)))
          ((&sight_full_source (:P O))
           (&sight_full_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_full_node (:P Q))
           (= A2 O))
          ((&sight_full_source (:P O))
           (&sight_full_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_full_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_full_node (:P Q)))))
    (source ((:n O))
      (&sight_full_source (:P O))
      (&sight_full_dir D))))

(RULE &sight_full_ray
  (&sight_full.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_full_end
  (&sight_full_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_full_ray (:P Q) D Origin)))

(DET &seed RarestColor)

(DET &path AnyOutNewColor)

(RULE &blocks_node
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &seed_block
  (&block *B *Col)
  (&seed (:C Col)))

;; The chain stands at a block and steps to the nearest block it sees and
;; does not hold, so a tie forks the walk. The partition it carries: the
;; blocks it holds (taken) and the rest (untaken).
(INIT &state Unfold
  (start ((:t B))
    (&seed_block *B))
  (initial_taken ((:item B))
    (&seed_block *B))
  (initial_untaken ((:item B))
    (&block *B)
    (NOT (&seed_block B)))
  (score ((:t B) (:item X) (:S K))
    (&sight_end (:P *E) *D (:Origin *B))
    (step_offset D (:V *V_m1))
    (compose (:A E) (:B V_m1) (:C *X))
    (&sight_full_ray (:P X) D *K (:Origin B)))
  (step ((:t B) (:t2 X))
    (&sight_end (:P *E) *D (:Origin *B))
    (step_offset D (:V *V_m1))
    (compose (:A E) (:B V_m1) (:C *X))
    (input (:P X))
    (&state.take (:t B) (:item X))))

(INIT &span BoundingBox
  (key ((&state.take (:t ^B) (:item ^B2)))
    (cell ((:P B3))
      (OR ((= *B3 B))
          ((= B3 B2))))))

(RULE &link_cell
  (&span.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&blocks_node P)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&link_cell P)))
      ((&link_cell P)
       (&path (:C Col)))))
