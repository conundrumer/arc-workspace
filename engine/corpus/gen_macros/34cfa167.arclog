;; 34cfa167

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; The corner blocks' color.
(DET &block_color SharedColor)

(INIT &blocks Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&block_color (:C Col))
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&block_color (:C Col2)))
        ((input P (:Col *Col3))
         (&block_color (:C Col3))
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *P) *Id))

;; The corner the arms run toward; the other block sits there.
(DET &arm_corner DiagDirDomain)

(RULE &arm_perp
  (&arm_corner (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) *D)
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2)))

(RULE &arm_dir
  (&arm_perp *D))

(RULE &cast_dir
  (&arm_dir (:D *Key)))

(RULE &cast_node
  (&arm_dir (:D *Key))
  (input *P))

(INIT &bbox BoundingBox
  (key ((&blocks_component *P ^Id))
    (cell (P)
      (&blocks_component *P Id))))

;; The block at the arms' corner stands alone; the other carries the arms.
(INIT &from_corner Order
  (member ((:t (:V Id) (:S K)))
    (&bbox.box (:key *Id) *B)
    (&arm_corner (:D *Diag))
    (corner_dist (:P B) Diag *K))
  (score ((:t (:V Id) (:S K)) (:S K))
    (&bbox.box (:key *Id) *B)
    (&arm_corner (:D *Diag))
    (corner_dist (:P B) Diag *K)))

(RULE &template
  (&from_corner.maximal (:t (:V *Id))))

(RULE &cast_source
  (&arm_dir (:D *Key))
  (&template (:Id *T))
  (&bbox.cell (:key (:Id T)) *P)
  (&bbox.box (:key (:Id T)) *B)
  (ALL ((&bbox.cell (:key (:Id *Tm)) P)
        (&bbox.box (:key (:Id Tm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) (:D Key) (:K *K_m1))
  (margin B (:D Key) (:K K_m1)))

;; Each arm casts from the template block's side, so a mark's distance is
;; read off the block's edge.
(INIT &cast Distance
  (key ((&cast_source (:Key ^Ky) (:P ^O))
        (&cast_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:Key Ky) (:P Q)))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&cast_source (:Key Ky) (:P O))
      (&cast_dir (:Key Ky)))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray Key (:P Q) D Origin)))

(RULE &block_offset
  (&template (:Id *T))
  (&bbox.box (:key (:Id T)) *B)
  (&bbox.box (:key *Id) (:B *B2))
  (relative (:Base B) (:X B2) (:X_rel *V)))

(RULE &axis_offset_split1
  (&block_offset (:V *V_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B V_) (:D D_m1) (:K *K1_m3))
  (margin (:B V_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V_axis_))
  (relative (:Base V_axis_) (:X V_) (:X_rel *X_m1_)))

(RULE &side_split1
  (&block_offset *Id (:V *V_))
  (axis_of (:D *D2) (:A *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B V_) (:D D_m1) (:K *K1_m3))
  (margin (:B V_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V_axis_))
  (relative (:Base V_axis_) (:X V_) (:X_rel *X_m1_)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(DET &period TileCount)

;; The ground the figure sits on.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(RULE &standalone
  (&from_corner.minimal (:t (:V *Id))))

(RULE &axis_offset
  (&block_offset (:V *V2))
  (axis_elem *A)
  (&axis_offset_split1 (:V_ V2) (:A_ A) (:V_axis_ *V) (:X_m1_ *X_m1)))

(RULE &corner_delta
  (&axis_offset *A (:V *V1))
  (perp A *A2)
  (&axis_offset (:A A2) (:V *V2))
  (compose (:A V1) (:B V2) (:C *V)))

(RULE &cast_cell
  (&arm_dir (:D *Key))
  (input *P))

(RULE &arm_mark
  (&cast_ray (:Key *D) *P D *K)
  (&cast_cell (:Key D) P)
  (!= K 0)
  (input P *Col)
  (NOT (&bg Col)))

(RULE &arm
  (&arm_mark *D *K *Col))

(INIT &span Order
  (key ((&arm ^D *K))
    (member ((:t K))
      (&arm D *K))
    (score ((:t K) (:S K))
      (&arm D *K))))

(RULE &period2
  (&arm_dir *D)
  (&period (:N *K)))

(RULE &run
  (&cast_ray (:Key *D) *P D *K (:Origin *Src))
  (&cast_cell (:Key D) P)
  (!= K 0)
  (opposite D (:Opp *D2))
  (&standalone (:Id *S))
  (&bbox.box (:key (:Id S)) *B)
  (dir_elem (:D D2))
  (margin (:B P) (:D D2) (:K *K1_m1))
  (margin B (:D D2) (:K *K2_m2))
  (< K1_m1 K2_m2))

(RULE &side
  (&arm_perp *D *D2)
  (axis_of (:D D2) (:A *A2))
  (&block_offset *Id (:V *V2))
  (&side_split1 (:V_ V2) (:A2_ A2) (:V_axis_ *V) (:X_m1_ *X_m1))
  (OR ((&template Id)
       (opposite (:D D2) (:Opp *D_out)))
      ((&standalone Id)
       (= D_out D2))))

(ALTS $choice "the distance at which the marks repeat, which the pairs do not separate" $Given
  (ALT $Extend
    (RULE &period2
      (&arm_mark *D *P (:K *K_last))
      (&span.maximal (:key D) (:t K_last))
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&cast_ray (:Key D) (:P Q) D *K)
      (&cast_cell (:Key D) (:P Q)))))

(RULE &rail
  (&run *D *P *K)
  (&period2 D (:K *N))
  (divide (:T K) (:Side N) (:Gap 0) (:Remainder *R))
  (&arm D (:K R) *Col))

(RULE &paint
  ;; A corner block.
  (OR ((&blocks_component (:P *P2) *Id)
       (&template Id)
       (&block_color (:C *Col))
       (&corner_delta *V)
       (compose (:A P2) (:B V) (:C *P)))
      ;; A rail cell.
      ((&rail *D (:P *Q) Col)
       (&side D (:V *V2))
       (compose (:A Q) (:B V2) (:C P)))
      ;; The plain line one cell outside a rail.
      ((&span.minimal (:key (:D *D2)) (:t *K_near))
       (&arm (:D D2) (:K K_near) Col)
       (&template (:Id *T))
       (&bbox.box (:key (:Id T)) *B)
       (&run (:D D2) (:P *Q2) *Src)
       (&bbox.cell (:key (:Id T)) (:P Src))
       (ALL ((&run (:D *Dm) (:P *Qm) Src)
             (&bbox.box (:key (:Id *Tm)) B)
             (dir_elem (:D *D_m1))
             (relative (:Base B) (:X Src) (:X_rel *R_m2))
             (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
            ((>= K_m3 0)))
       (margin (:B Src) (:D *D_out) (:K *K_m1))
       (margin B (:D D_out) (:K K_m1))
       (&side (:D D2) (:V *V3) D_out)
       (compose (:A Q2) (:B V3) (:C *P_rail))
       (step_offset (:D D_out) (:V *V_m2))
       (compose (:A P_rail) (:B V_m2) (:C P)))))

(RULE &output
  (OR ((&paint *P *Col)
       (input P))
      ((input P)
       (&bg Col)
       (NOT (&paint P)))))
