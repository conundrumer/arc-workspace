;; a78176bb

(INPUT diagonal-line "one straight diagonal line of one color runs from grid edge to grid edge; its color is not &bg and not &wedge_color, and it changes from input to input"

  (DET &wedge_color ChangedColor)

  (DET_OR_RULE &bg DominantColor))

(INPUT wedges "one or two right-triangle wedges of &wedge_color touch the line, each with its hypotenuse along the line and filling a staircase that grows away from it; no two wedges are on one side of the line")

(OUTPUT erase-wedges "every &wedge_color cell becomes &bg")

(OUTPUT keep-line "the line stays in the output unchanged")

(OUTPUT offset-line "for each wedge, a new line of the line's color is drawn parallel to the line, on the wedge's side, at diagonal offset k + 1 + &gap from it, where k is the wedge's largest diagonal offset from the line; the new line runs from grid edge to grid edge"

  (RULE &wedges_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &wedge
    (input *P *Col)
    (&wedge_color (:C Col)))

  (INIT &wedges Quotient
    (edge ((:a P) (:b P3))
      (OR ((&wedge *P)
           (&wedges_steps (:Delta *S2))
           (compose (:A P) (:B S2) (:C *P3))
           (&wedge (:P P3)))
          ((&wedge P)
           (= P3 P)))))

  (RULE &wedges_component
    (&wedges.class (:a *P) *Id))

  ;; the empty diagonals between a wedge's far corner and its new line
  (DET &gap DivisorRatio)

  (INIT &wedge_box BoundingBox
    (key ((&wedges_component *P ^Id))
      (cell (P)
        (&wedges_component *P Id)))))

(OUTPUT rest-background "every other output cell is &bg"

  (RULE &ink
    (input *Col)
    (NOT (&bg (:C Col))))

  (RULE &aligned
    (&ink *Col)
    (input *P Col)
    (input (:P *Q) Col)
    (diag_axis_elem *Da)
    (diag_perp Da (:Da2 *A2_m1))
    (diag_axis_of (:D *D_m2) (:Da A2_m1))
    (corner_dist P (:Diag D_m2) (:K *K_m3))
    (corner_dist (:P Q) (:Diag D_m2) (:K K_m3)))

  (RULE &collinear
    (&ink *Col)
    (diag_axis_elem *Da)
    (ALL ((input *P Col)
          (input (:P *Q) Col))
         ((&aligned Da P Q))))

  (RULE &line_axis
    (&collinear *Col *Da)
    (diag_perp Da (:Da2 *DA2))
    (NOT (&collinear Col (:Da DA2))))

  (INIT &line_color Singleton
    (member ((:v Col))
      (&ink *Col)
      (NOT (&wedge_color (:C Col)))))

  (RULE &line
    (&line_color.value (:v *Col))
    (&line_axis Col *Da))

  (RULE &side
    (&wedges_component *P (:Id *Pc))
    (&line *Col (:Da *DA))
    (input (:P *Q) Col)
    (diag_perp (:Da DA) (:Da2 *DA2))
    (diag_axis_of (:D *Diag) (:Da DA2))
    (diag_dir_elem (:D Diag))
    (corner_dist P Diag (:K *K1_m1))
    (corner_dist (:P Q) Diag (:K *K2_m2))
    (< K1_m1 K2_m2))

  (RULE &beyond
    (input *P)
    (&gap *K)
    (corner_dir (:C *Diag) *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *P1))
    (dir8_opposite D (:D2 *O_m3))
    (edge_inset (:D O_m3) K (:B *B1_m4))
    (edge_inset D K (:B *I_m6))
    (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
    (compose (:A B1_m4) (:B B2_m5) (:C *V_m2))
    (compose (:A P1) (:B V_m2) (:C *Q)))

  (RULE &reach
    (&side *Pc *Diag)
    (&wedges_component (:P *P2) (:Id Pc))
    (&beyond Diag (:P P2) (:Q *P)))

  (RULE &passed
    (&reach *Pc *Diag *P)
    (&reach Pc Diag (:P *Q))
    (diag_dir_elem (:D Diag))
    (corner_dist (:P Q) Diag (:K *K1_m1))
    (corner_dist P Diag (:K *K2_m2))
    (< K1_m1 K2_m2))

  (RULE &far
    (&reach *Pc *Diag *P)
    (NOT (&passed Pc P))))

(ALTS $axis "where the line's axis comes from" $ReadAxis
  (ALT $StoredAxis
    (INPUT diagonal-line "the line runs along the diagonal axis &axis; undefined where it runs along the other diagonal"
      (DET &axis DiagAxisDomain)

      (RULE &line_axis
        (&collinear *Col *Da)
        (&axis Da)))))

(ALTS $wedge "which cells are the wedges" $StoredWedgeColor
  (ALT $DerivedWedgeColor
    (INPUT diagonal-line "the line's color is the one color whose cells all lie on one diagonal; undefined where no color, or more than one, does"
      (INIT &line_color Singleton
        (member ((:v Col))
          (&line_axis *Col)))

      (RULE &wedge
        (&line (:Col *Col_line))
        (input *P *Col)
        (&ink Col)
        (!= Col Col_line)))
    (INPUT wedges "the wedges are every non-&bg cell not of the line's color")))

(ALTS $spacing "how far out a wedge's new line goes" $LegPlusGap
  (ALT $NeighborLine
    (OUTPUT offset-line "the new line passes through the wedge's farthest in-grid 8-neighbor outside the wedges, with no &gap"
      (RULE &reach
        (&side *Pc *Diag)
        (&wedges_component (:P *P2) (:Id Pc))
        (step_offset (:D *D_m1) (:V *V_m2))
        (compose (:A P2) (:B V_m2) (:C *P))
        (input P)
        (NOT (&wedge P)))))
  (ALT $LegByExtent
    (OUTPUT offset-line "k is the side of the wedge's bounding box"
      (RULE &reach
        (&side *Pc *Diag)
        (&wedge_box.box (:key (:Id Pc)) *B)
        (&beyond Diag (:P *P2) (:Q *P))
        (ALL ((&beyond (:Diag *Diagm) (:P P2) (:Q *Qm))
              (&wedge_box.box (:key (:Id *Pcm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P2) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (ALL ((&side (:Pc *Pcmm) Diag)
              (&beyond Diag (:P P2) (:Q *Qmm))
              (&wedge_box.box (:key (:Id Pcmm)) B)
              (corner_dir (:C Diag) (:D *D_m1m))
              (margin (:B P2) (:D D_m1m) (:K *K1_m2))
              (margin B (:D D_m1m) (:K *K2_m3)))
             ((= K1_m2 K2_m3)))))))

(ALTS $lines "how many new lines a side of the line gets" $PerWedge
  (ALT $PerSide
    (OUTPUT offset-line "each side of the line with a wedge gets one new line, placed for the wedge whose line goes farthest out"
      (RULE &outdone
        (&far *Diag *P)
        (&far Diag (:P *Q))
        (diag_dir_elem (:D Diag))
        (corner_dist (:P Q) Diag (:K *K1_m1))
        (corner_dist P Diag (:K *K2_m2))
        (< K1_m1 K2_m2)))
    (RULE &anchor
      (&far *P)
      (NOT (&outdone P)))))

(RULE &anchor
  (&far *P))

(RULE &lit
  (OR ((&line *Col)
       (input *P Col))
      ((&anchor (:P *Q))
       (&line Col (:Da *DA))
       (input P)
       (diag_perp (:Da DA) (:Da2 *A2_m1))
       (diag_axis_of (:D *D_m2) (:Da A2_m1))
       (corner_dist P (:Diag D_m2) (:K *K_m3))
       (corner_dist (:P Q) (:Diag D_m2) (:K K_m3)))))

(RULE &output
  (OR ((&lit *P *Col))
      ((&bg (:C Col))
       (OR ((input P Col))
           ((&wedge P)))
       (NOT (&lit P)))))
