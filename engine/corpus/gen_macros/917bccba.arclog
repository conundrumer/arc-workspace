;; 917bccba

(DET &bg DominantColor)

;; The rectangle corner the cross moves to.
(DET &corner DiagDirDomain)

(RULE &ink_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &outline Outlines
  (key ((&ink_cell ^Col *P))
    (node (P)
      (&ink_cell Col *P))))

(RULE &rect
  (&outline.box (:key *Col) *B))

(ALTS $rect "Which ink draws the rectangle." $Outline
  (ALT $Contained
    (INIT &contained BoundingBox
      (key ((&ink_cell ^Col *P)
            (ALL ((&ink_cell Col (:P *Pm))
                  (dir_elem (:D *D_m1))
                  (relative (:Base 0) (:X Pm) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((> K_m3 0))))
        (cell (P)
          (&ink_cell Col *P)
          (ALL ((&ink_cell Col (:P *Pm))
                (dir_elem (:D *D_m1))
                (relative (:Base 0) (:X Pm) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((> K_m3 0))))))

    (RULE &rect
      (&contained.box (:key *Col) *B))))

(ALTS $landing "Where the cross's lines come to meet." $Corner
  (ALT $Slide
    (RULE &slide_dir_ray
      (&rect)
      (&corner (:D *Key)))

    (RULE &box_border
      (input *P)
      (&rect *B)
      (ALL ((&rect B)
            (dir_elem (:D *D_m1m))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
           ((>= K_m3 0)))
      (margin (:B P) (:D *D_m1) (:K *K_m2))
      (margin B (:D D_m1) (:K K_m2)))

    (RULE &slide_dir
      (&rect)
      (&corner (:D *Key)))

    (RULE &slide_blocked
      (&slide_dir *Key)
      (&box_border *P))

    (RULE &slide_node
      (&rect)
      (&corner (:D *Key))
      (input *P)
      (NOT (&slide_blocked Key P)))

    (INIT &cross_rim Boundary
      (key ((&ink_cell ^Col *P))
        (cell (P)
          (&ink_cell Col *P))))

    (RULE &center
      (&cross_col *Col)
      (&ink_cell Col *P)
      (NOT (&cross_rim.boundary (:key Col) P)))

    (RULE &slide_source
      (&slide_dir *Key)
      (&center *P))

    (INIT &slide Distance
      (key ((&slide_source (:Key ^Ky) (:P ^O))
            (&slide_dir_ray (:Key Ky)))
        (edge ((:a A2) (:b Q))
          (OR ((&slide_source (:Key Ky) (:P O))
               (&slide_dir_ray (:Key Ky))
               (axis_of (:D Ky) *A)
               (sub_extent (:P O) A *K)
               (dir8_opposite (:D Ky) (:D2 *O_m2))
               (edge_inset (:D O_m2) K (:B *B1_m3))
               (edge_inset (:D Ky) K (:B *I_m5))
               (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
               (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
               (compose (:A O) (:B V_m1) (:C *A2))
               (&slide_node (:Key Ky) (:P A2))
               (step_offset (:D Ky) (:V *V_m6))
               (compose (:A A2) (:B V_m6) (:C *Q))
               (&slide_node (:Key Ky) (:P Q)))
              ((&slide_source (:Key Ky) (:P O))
               (&slide_dir_ray (:Key Ky))
               (step_offset (:D Ky) (:V *V_m12))
               (compose (:A O) (:B V_m12) (:C Q))
               (&slide_node (:Key Ky) (:P Q))
               (= A2 O))
              ((&slide_source (:Key Ky) (:P O))
               (&slide_dir_ray (:Key Ky))
               (diag_dir_elem (:D Ky))
               (axis_elem (:A *A3))
               (sub_extent (:P O) (:A A3) (:K *K2))
               (dir8_opposite (:D Ky) (:D2 *O_m22))
               (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
               (edge_inset (:D Ky) (:K K2) (:B *I_m52))
               (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
               (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
               (compose (:A O) (:B V_m13) (:C A2))
               (&slide_node (:Key Ky) (:P A2))
               (step_offset (:D Ky) (:V *V_m62))
               (compose (:A A2) (:B V_m62) (:C Q))
               (&slide_node (:Key Ky) (:P Q)))))
        (source ((:n O))
          (&slide_source (:Key Ky) (:P O))
          (&slide_dir_ray (:Key Ky)))))

    (RULE &slide_ray
      (&slide.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

    (RULE &slide_end
      (&slide_ray *Key *P *D *K *Origin)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (NOT (&slide_ray Key (:P Q) D Origin)))

    (RULE &landing
      (&corner *D)
      (&slide_end (:Key D) (:P *E) (:D *D_2))
      (step_offset (:D D_2) (:V *V_m1))
      (compose (:A E) (:B V_m1) (:C *P))
      (input P))))

(RULE &cross_col
  (&ink_cell *Col)
  (&rect)
  (NOT (&rect Col)))

(RULE &landing
  (input *P)
  (&rect *B)
  (&corner *D)
  (ALL ((&rect B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((&rect B)
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B P) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

(RULE &rect_cell
  (input *P *Col)
  (&rect Col))

(RULE &cross
  (&landing (:P *P_c))
  (input *P)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P_c) (:D D_m2) (:K K_m3)))

(RULE &output
  (input *P (:Col *C))
  (OR ((&cross P)
       (NOT (&rect_cell P))
       (&cross_col *Col))
      ((&rect_cell P)
       (= Col C))
      ((NOT (&rect_cell P))
       (NOT (&cross P))
       (&bg (:C Col)))))
