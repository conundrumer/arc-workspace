;; 8cb8642d

(DET &bg DominantColor)

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(RULE &cell_of
  (&comps_component *P *Id))

(INIT &bbox BoundingBox
  (key ((&cell_of ^Id *P))
    (cell (P)
      (&cell_of Id *P))))

(RULE &hole
  (&bbox.box (:key *Id) *B)
  (&cell_of Id *P)
  (ALL ((&cell_of (:Id *Idm) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

;; The inside, viewed from its own frame.
(INIT &hole_box BoundingBox
  (key ((&hole ^Id *P))
    (cell (P)
      (&hole Id *P))))

(RULE &hole_view
  (&hole *Id *P)
  (&hole_box.box (:key Id) *B)
  (ALL ((&hole (:Id *Idm) P)
        (&hole_box.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &join_axis
  (&hole_view (:Id *Key))
  (axis_elem *A))

(RULE &join_dir
  (&join_axis *Key *A)
  (axis4_of *D A))

(RULE &join_node
  (&join_axis *Key)
  (input *P))

(RULE &arm
  (&hole_view *Id *P_inner)
  (diag_dir_elem (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (opposite (:D D1) (:Opp *O_m3))
  (margin (:B P_inner) (:D D1) *K)
  (margin (:B P_inner) (:D O_m3) (:K *K1))
  (opposite (:D D2) (:Opp *O_m4))
  (margin (:B P_inner) (:D D2) K)
  (margin (:B P_inner) (:D O_m4) (:K *K2))
  (<= K K1)
  (<= K K2))

(RULE &arm_end
  (&arm *Id *P_inner *Diag)
  (diag_opposite (:D Diag) (:Opp *D_in))
  (step_offset (:D D_in) (:V *V_m1))
  (compose (:A P_inner) (:B V_m1) (:C *Q))
  (NOT (&arm Id (:P_inner Q) Diag)))

(RULE &join_source
  (&arm_end (:Id *Key) (:P_inner *P)))

;; The line joining two arm ends.
(INIT &join Distance
  (key ((&join_source (:Key ^Ky) (:P ^O))
        (&join_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&join_source (:Key Ky) (:P O))
           (&join_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&join_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&join_node (:Key Ky) (:P Q)))
          ((&join_source (:Key Ky) (:P O))
           (&join_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&join_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&join_source (:Key Ky) (:P O))
           (&join_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&join_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&join_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&join_source (:Key Ky) (:P O))
      (&join_dir (:Key Ky) D))))

(RULE &join_ray
  (&join.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &join_between
  (&hole_view (:Id *Key) (:P_inner *P))
  (&join_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&join_ray Key P D)
  (&join_ray Key P (:D O)))

(RULE &join_end
  (&join_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&join_ray Key (:P Q) D Origin)))

(RULE &frame_color_inside1
  (&cell_of *Id (:P *P_))
  (&bbox.box (:key Id) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &marker_color
  (&hole *Id *P)
  (input P *Col)
  (ALL ((&bbox.box (:key Id) *B)
        (&cell_of Id (:P *Pm))
        (margin (:B Pm) (:D *D_m1) (:K *K_m2))
        (margin B (:D D_m1) (:K K_m2))
        (input (:P Pm) Col))
       ((&frame_color_inside1 (:P_ Pm) (:B_ B)))))

(RULE &drawn
  (OR ((&arm *Id *P_inner))
      ((&join_between (:Key Id) (:P P_inner)))))

(ALTS $choice "how the inside's drawn cells are found" $Join
  (ALT $Medial
    ;; The nearest edges of each inside cell.
    (INIT &nearest Order
      (key ((&hole_view ^P *P_inner)
            (dir_elem *D)
            (margin (:B P_inner) D *K))
        (member ((:t (:V D) (:S K)))
          (&hole_view P *P_inner)
          (dir_elem *D)
          (margin (:B P_inner) D *K))
        (score ((:t (:V D) (:S K)) (:S K))
          (&hole_view P *P_inner)
          (dir_elem *D)
          (margin (:B P_inner) D *K))))

    (RULE &drawn
      (&hole_view *Id *P *P_inner)
      (&nearest.minimal (:key P) (:t (:V *D1)))
      (&nearest.minimal (:key P) (:t (:V *D2)))
      (!= D1 D2))))

(RULE &output
  (OR ((&hole_view *Id *P *P_inner)
       (IF ((&drawn Id P_inner))
           ((&marker_color Id *Col))
           ((&bg (:C Col)))))
      ((input P Col)
       (NOT (&hole P)))))
