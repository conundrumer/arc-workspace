;; c9f8e694

(DET &axis AxisDomain)

(RULE &cell_slice_split1
  (input (:P *P_) *Col)
  (&axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(DET &targets ChangedColor)

(DET &anchor DirDomain)

(RULE &cell_slice
  (input *P *Col)
  (&axis *A)
  (&cell_slice_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across)))

(RULE &slice_repl
  (&cell_slice *P *Col *P_across)
  (&anchor *D)
  (margin (:B P) D (:K 0)))

(ALTS $choice "what supplies the slice's replacement color" $Anchor
  (ALT $Unique
    (DET &bg SharedColor)

    (RULE &slice_repl
      (&cell_slice *Col *P_across)
      (NOT (&targets (:C Col)))
      (NOT (&bg (:C Col))))))

(RULE &output
  (&cell_slice *P (:Col *Col2) *P_across)
  (IF ((&targets (:C Col2)))
      ((&slice_repl P_across *Col))
      ((= Col Col2))))
