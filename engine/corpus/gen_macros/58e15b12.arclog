;; 58e15b12

(DET &bg DominantColor)

(DET &bar_axis AxisDomain)

(DET &overlap AnyOutNewColor)

(INIT &bbox BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &trace
  (&bar_axis *A)
  (perp A *A2)
  (&bbox.cell (:key *Col) (:P *P2))
  (&bbox.box (:key Col) *B)
  (axis_elem A)
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (ALL ((&bbox.cell (:key (:Col *Colm)) (:P P2))
        (&bbox.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P2) (:D *D_out) (:K *K_m2))
  (margin B (:D D_out) (:K K_m2))
  (axis_of (:D D_out) (:A A2))
  (opposite (:D D_out) (:Opp *O_out))
  (axis_of (:D *D_step) A)
  (opposite (:D D_step) (:Opp *O_step))
  (input *P)
  (relative (:Base P2) (:X P) (:X_rel *V))
  (margin (:B V) (:D O_out) *K)
  (margin (:B V) (:D O_step) (:K *T))
  (divide T (:Side N) (:Gap 0) (:Part K) (:Remainder 0)))

(INIT &drawn Singleton
  (key ((&trace *Col ^P))
    (member ((:v Col))
      (&trace *Col P))))

(RULE &output
  (input *P)
  (OR ((&drawn.value (:key P) (:v *Col)))
      ((&drawn.plural (:key P))
       (&overlap (:C Col)))
      ((NOT (&drawn.member (:key P)))
       (&bg (:C Col)))))
