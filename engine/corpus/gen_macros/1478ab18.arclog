;; 1478ab18

(RULE &span_axis
  (axis4_elem *A))

(RULE &span_dir
  (&span_axis *A)
  (axis4_of *D A))

(RULE &span_node
  (&span_axis)
  (input *P))

(RULE &diag_dir
  (diag_dir_elem *D))

(RULE &diag_node
  (input *P))

(DET &mark RarestColor)

(RULE &mark2
  (input *P *Col)
  (&mark (:C Col)))

(RULE &diag_source
  (&mark2 *P))

;; Marks cast along the diagonals, seeing only marks.
(INIT &diag Distance
  (key ((&diag_source (:P ^O))
        (&diag_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&diag_source (:P O))
           (&diag_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&diag_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&diag_node (:P Q)))
          ((&diag_source (:P O))
           (&diag_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&diag_node (:P Q))
           (= A2 O))
          ((&diag_source (:P O))
           (&diag_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&diag_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&diag_node (:P Q)))))
    (source ((:n O))
      (&diag_source (:P O))
      (&diag_dir D))))

(RULE &diag_ray
  (&diag.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &aligned
  (&diag_ray (:P *Q) *K (:Origin *P))
  (&mark2 (:P Q))
  (!= K 0))

;; $Longest — the widest separation any diagonal mark pair reaches.
(INIT &far Order
  (member ((:t (:V P) (:S K)))
    (&aligned *P *K))
  (score ((:t (:V P) (:S K)) (:S K))
    (&aligned *P *K)))

(RULE &hyp
  (&far.maximal (:t (:V *P))))

(RULE &corner_cell_split1
  (&aligned (:P *P_) *Q)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

(RULE &corner_cell_split2
  (&aligned *P (:Q *Q_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Q_) (:D D_m1) (:K *K1_m3))
  (margin (:B Q_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X Q_) (:X_rel *Q_across_)))

(RULE &corner_cell
  (&aligned *P *Q)
  (axis_elem *A)
  (&corner_cell_split1 (:P_ P) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1))
  (&corner_cell_split2 (:Q_ Q) (:A_ A) (:X_m2_ *X_m2) (:Q_across_ *Q_across))
  (compose (:A P_along) (:B Q_across) (:C *Cor)))

(RULE &diag_end
  (&diag_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&diag_ray (:P Q) D Origin)))

(DET &ink AnyOutNewColor)

(ALTS $l "which mark pair spans the hypotenuse" $Longest
  (ALT $Cornered
    ;; $Cornered — a mark sits at one of the pair's two box corners.
    (RULE &hyp
      (&aligned *P *Q)
      (&corner_cell P Q *Cor)
      (&mark2 (:P Cor)))))

(ALTS $v "which box corner carries the right angle" $Free
  (ALT $Pointed
    ;; $Pointed — the corner a mark stands diagonally next to.
    (RULE &right_angle
      (&corner_cand (:Cor *P))
      (diag_dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *P_near))
      (&mark2 (:P P_near))))
  (ALT $Inside
    ;; $Inside — the corner whose closed triangle holds a non-vertex mark. Viewed
    ;; from the hypotenuse pair's box, the hypotenuse is the diagonal from a
    ;; corner next to Cor's, and the triangle is the cells on Cor's side of it:
    ;; no farther from the edge the two corners share than from the other edge
    ;; of that next corner.
    (INIT &tri BoundingBox
      (cell (P)
        (&hyp *P)))

    (RULE &right_angle
      (&corner_cand (:Cor *P))
      (&tri.box *B)
      (ALL ((&corner_cand (:Cor P))
            (&tri.box B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (corner_dir (:C *Dc) *A (:D *D1))
      (ALL ((corner_dir (:C Dc) (:A *Am) (:D *D1m))
            (perp (:A Am) (:A2 *A2_m2m))
            (corner_dir (:C Dc) (:A A2_m2m) (:D *D2_m1m))
            (&corner_cand (:Cor P))
            (&tri.box B)
            (corner_dir (:C Dc) (:D *D_m1m))
            (margin (:B P) (:D D_m1m) (:K *K1_m2))
            (margin B (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3)))
      (perp A (:A2 *A2_m2))
      (corner_dir (:C Dc) (:A A2_m2) (:D *D2_m1))
      (corner_dir (:C *Dh) A (:D D1))
      (perp A (:A2 *A2_m4))
      (corner_dir (:C Dh) (:A A2_m4) (:D *D2_m3))
      (!= Dh Dc)
      (&mark2 (:P *M))
      (NOT (&hyp (:P M)))
      (!= M P)
      (ALL ((&tri.box B)
            (dir_elem (:D *D_m1mm))
            (relative (:Base B) (:X M) (:X_rel *R_m2m))
            (margin (:B R_m2m) (:D D_m1mm) (:K *K_m3m)))
           ((>= K_m3m 0)))
      (relative (:Base B) (:X M) (:X_rel *P_inner))
      (corner_dir (:C Dh) A (:D *D1_m5))
      (perp A (:A2 *A2_m7))
      (corner_dir (:C Dh) (:A A2_m7) (:D *D2_m6))
      (margin (:B P_inner) (:D D1_m5) (:K *K1))
      (margin (:B P_inner) (:D D2_m6) (:K *K2))
      (<= K1 K2))))

(RULE &corner_cand
  (&hyp *P)
  (&hyp (:P *Q))
  (&corner_cell P Q *Cor))

;; $Free — the corner the marks left open.
(RULE &right_angle
  (&corner_cand (:Cor *P))
  (NOT (&mark2 P)))

(RULE &vertex
  (OR ((&hyp *P))
      ((&right_angle P))))

(RULE &span_source
  (&vertex *P))

;; The three vertices cast at each other: a cell with vertices on both sides of
;; one of its lines lies on the side joining them.
(INIT &span Distance
  (key ((&span_source (:P ^O))
        (&span_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&span_source (:P O))
           (&span_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&span_node (:P Q)))
          ((&span_source (:P O))
           (&span_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&span_node (:P Q))
           (= A2 O))
          ((&span_source (:P O))
           (&span_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&span_node (:P Q)))))
    (source ((:n O))
      (&span_source (:P O))
      (&span_dir D))))

(RULE &span_ray
  (&span.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &span_between
  (input *P)
  (&span_axis *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&span_ray P D)
  (&span_ray P (:D O)))

(RULE &span_end
  (&span_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray (:P Q) D Origin)))

(RULE &paint
  (&span_between *P)
  (NOT (&mark2 P)))

(RULE &output
  (OR ((&paint *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&paint P)))))
