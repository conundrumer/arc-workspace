;; abc82100

(INPUT background "the background is &bg"

  (DET_OR_RULE &bg DominantColor))

(INPUT legend-shape "each legend has a shape drawn in &key, one 8-connected component of that color. The key color occurs nowhere else."

  (DET &key VanishedColor))

(INPUT legend-domino "next to each shape, outside its bounding box on the box's center line, sits a domino of two cells in two colors other than the background and the key. The domino lies on the axis that runs out from the box. Its near cell touches the box edge, and its far cell is one step further out.")

(INPUT legend-pair "the far cell's color is the source color, and the near cell's color is the target color. Each source color belongs to one legend.")

(INPUT scene-cells "outside the legends, the grid has single cells of source colors, and it can have cells of other colors")

(INPUT clear-stamps "no two stamps of different target colors write one cell, and no stamp writes a cell that keeps a color other than background")

(OUTPUT key-site "a domino is a key of a shape when its near cell lies just outside the shape's bounding box, within the box's row or column span, and its far cell lies one step further out. Every key forms a legend with the shape."

  (RULE &shape_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &shape Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (&key (:C Col))
           (&shape_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (&key (:C Col2)))
          ((input P (:Col *Col3))
           (&key (:C Col3))
           (= P3 P)))))

  (RULE &shape_component
    (&shape.class (:a *P) *Id))

  (RULE &ink
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&key (:C Col))))

  (RULE &ink_pair
    (&ink (:P *N))
    (opposite *D (:Opp *D_back))
    (step_offset D (:V *V_m1))
    (compose (:A N) (:B V_m1) (:C *F))
    (&ink (:P F))
    (step_offset (:D D_back) (:V *V_m2))
    (compose (:A N) (:B V_m2) (:C *A)))

  (RULE &domino
    (&ink_pair *A *N *F *D)
    (input (:P N) *Col)
    (input (:P F) (:Col *Col_f))
    (!= Col Col_f))

  (INIT &hull BoundingBox
    (key ((&shape_component *P ^Id))
      (cell (P)
        (&shape_component *P Id))))

  (RULE &side_key
    (&domino *A *N *F *D)
    (&hull.box (:key *Id) *B)
    (ALL ((&domino A (:N *Nm) (:F *Fm) (:D *Dm))
          (&hull.box (:key (:Id *Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X A) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B A) D (:K *K_m1))
    (margin B D (:K K_m1)))

  (RULE &key_domino
    (&side_key *Id *A *N *F))

  (RULE &key_scan_cell
    (&key_domino *Id (:N *P))
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  ;; The near cells of a shape's keys, in each order.
  (INIT &key_scan Order
    (key ((&key_domino ^Id *N)
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t N))
        (&key_domino Id *N)
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a N) (:b N2))
        (&key_domino Id *N)
        (diag_dir_elem (:D C))
        (axis_elem A)
        (&key_domino Id (:N *N2))
        (&key_scan_cell Id (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B N) D (:K *K1_m1))
             (margin (:B N2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B N) D (:K *K_m4))
             (margin (:B N2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B N) (:D D2) (:K *K1_m5))
             (margin (:B N2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6)))))))

(OUTPUT anchor "the anchor of a legend is the cell one step past the near cell, away from the far cell")

(OUTPUT erase "every legend cell (shape, near, far) and every cell of a source color becomes background")

(OUTPUT stamp "for each scene cell of a source color, the shape of that color's legend is drawn in the legend's target color, moved so that the anchor lands on that cell. Cells that fall off the grid are dropped. All stamps read the input, so the stamps do not chain."

  (RULE &layer_cell
    (input *P)
    (diag_dir_elem (:D *Corner))
    (axis_elem (:A *Axis)))

  ;; The grid's cells, in each order.
  (INIT &layer Order
    (key ((input *P)
          (diag_dir_elem (:D ^C))
          (axis_elem ^A))
      (member ((:t P))
        (input *P)
        (diag_dir_elem (:D C))
        (axis_elem A))
      (before ((:a P) (:b P2))
        (input *P)
        (diag_dir_elem (:D C))
        (axis_elem A)
        (input (:P *P2))
        (&layer_cell (:Corner C) (:Axis A))
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6)))))))

(OUTPUT keep "every other cell keeps its input color"

  (RULE &legend
    (&key_domino *Id *A *N *F))

  (RULE &legend_cell
    (&legend *Id *N *F)
    (OR ((&shape_component *P Id))
        ((= P N))
        ((= P F))))

  (RULE &cleared
    (OR ((&legend_cell *P))
        ((&legend *F)
         (input (:P F) *Col)
         (input P Col))))

  (RULE &write
    (&legend *Id *A *N *F)
    (input (:P F) *Col)
    (input (:P N) (:Col *Tg))
    (input *P Col)
    (NOT (&legend_cell P))
    (&shape_component (:P *X) Id)
    (relative (:Base A) X (:X_rel *V))
    (compose (:A P) (:B V) (:C *T)))

  (RULE &paint
    (&write *T (:Tg *Col))))

(ALTS $colors "whether a domino's two cells can share a color" $TwoColors
  (ALT $SameColorDomino
    (INPUT legend-domino "the domino's two cells can share a color, which is then both the source and the target color"
      (RULE &domino
        (&ink_pair *A *N *F *D)))))

(ALTS $site "which dominoes are keys of a shape" $BoxSide
  (ALT $AnchorTouch
    (OUTPUT key-site "a domino is a key of a shape when its anchor is a shape cell or 8-adjacent to one, and holds the background or the key color. The domino can point from any side, and it need not touch the box."
      (RULE &key_domino
        (&domino *A *N *F)
        (input (:P A) *Col)
        (OR ((&bg (:C Col)))
            ((&key (:C Col))))
        (OR ((&shape_component (:P A) *Id))
            ((&shape_component (:P *Q) Id)
             (step_offset (:D *D_m1) (:V *V_m2))
             (compose (:A Q) (:B V_m2) (:C A)))))))
  (ALT $CenterLine
    (OUTPUT key-site "the near cell also sits on the box's center row or center column"
      (RULE &key_domino
        (&side_key *Id *A *N *F *D)
        (&hull.box (:key Id) *B)
        (ALL ((&side_key (:Id *Idm) A (:N *Nm) (:F *Fm) (:D *Dm))
              (&hull.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X A) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base B) (:X A) (:X_rel *A_rel))
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *E) (:A A2_m2))
        (opposite (:D E) (:Opp *O_m3))
        (margin (:B A_rel) (:D E) *K)
        (margin (:B A_rel) (:D O_m3) K)))))

(ALTS $per_shape "which keys of a shape form legends" $EveryKey
  (ALT $FirstKey
    (OUTPUT key-site "only the first key of a shape, in &key_order, forms a legend. The other dominoes and their source cells keep their colors."
      ;; The reading order, from corner c along axis a, whose first key of a shape forms the legend. No pair has two keys on one shape, so every order stays open.
      ;; TODO no-det-plan: &key_order: the plan gives no verdict
      (DET &key_order (ONE))

      ;; The first key of each shape under each key order in use.
      (RULE &legend
        (&key_order *C (:A *A_k))
        (&key_scan.minimal (:key *Id C (:A A_k)) (:t *N))
        (&key_domino Id *A N *F)))))

(ALTS $order "which color a cell takes when stamps of two target colors write it" $Unordered
  (ALT $ScanOrder
    (OUTPUT stamp "where stamps overlap, the stamp of the legend that comes later covers the earlier one. Legends are ordered by the first cell of their shape, then by their near cell, in &layer_order."
      ;; The reading order of the legends, from corner c along axis a. No pair has overlapping stamps, so every order stays open.
      ;; TODO no-det-plan: &layer_order: the plan gives no verdict
      (DET &layer_order (ONE))

      (RULE &trailing
        (&shape_component *P *Id)
        (&shape_component (:P *Q) Id)
        (&layer.before (:key *C *A) (:a Q) (:b P)))

      (RULE &lead
        (&shape_component *P *Id)
        (&layer.member (:key *C *A) (:t P))
        (NOT (&trailing C A Id P)))

      (RULE &buried
        (&write *T *Id *N)
        (&write T (:Id *Id2) (:N *N2))
        (&lead *C *A Id *P)
        (&lead C A (:Id Id2) (:P *P2))
        (OR ((&layer.before (:key C A) (:a P) (:b P2)))
            ((= Id Id2)
             (&layer.before (:key C A) (:a N) (:b N2)))))

      (RULE &paint
        (&write *T *Id *N (:Tg *Col))
        (&layer_order *C *A)
        (NOT (&buried C A T Id N))))))

(ALTS $cover "whether a stamp covers a kept cell" $StampOver
  (ALT $KeepOnTop
    (OUTPUT keep "a kept cell other than background shows over the stamps"
      (RULE &kept
        (input *P *Col)
        (NOT (&bg (:C Col)))
        (NOT (&cleared P))))
    (RULE &shown
      (&paint *T *Col)
      (NOT (&kept (:P T))))))

(ALTS $keyless "what happens to key-colored cells that no domino keys" $KeepKeyless
  (ALT $EraseKeyColor
    (OUTPUT erase "every key-colored cell becomes background, keyed or not"
      (RULE &cleared
        (OR ((&shape_component *P))
            ((OR ((&legend_cell P))
                 ((&legend *F)
                  (input (:P F) *Col)
                  (input P Col)))))))))

(RULE &shown
  (&paint *T *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&shown (:T P) *Col))
      ((&cleared P)
       (NOT (&shown (:T P)))
       (&bg (:C Col)))
      ((NOT (&shown (:T P)))
       (NOT (&cleared P))
       (= Col Col_in))))
