;; 2697da3f

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &fig BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &fig_extent
  (&fig.cell *P)
  (&fig.box *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N))

(RULE &arm_margin_uniform_inset1
  (&fig_extent *A (:N *Depth_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K Depth_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K Depth_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K Depth_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K Depth_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *Around_)))

;; The edge the input-oriented copy sits against.
(DET &arm DirDomain)

;; The group carrying the copy to the other arms.
(DET &sym SymDomain)

(RULE &arm_margin
  (&arm *D)
  (opposite D (:Opp *D_far))
  (axis_of D *A)
  (&fig_extent A (:N *Depth))
  (&arm_margin_uniform_inset1 (:Depth_ Depth) (:Around_ *Around))
  (edge_inset D (:K Depth) (:B *I_m1))
  (relative (:Base I_m1) (:X 0) (:X_rel *Back))
  (compose (:A Around) (:B Back) (:C *Depths))
  (perp A *A2)
  (&fig_extent (:A A2) (:N *Span))
  (edge_inset (:D D_far) (:K Span) (:B *Blank))
  (compose (:A Depths) (:B Blank) (:C *B)))

(RULE &placed
  (&ink (:P *P2) *Col)
  (&fig.box *B)
  (ALL ((&ink (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_inner))
  (&arm_margin (:B *B_arm))
  (compose (:A B_arm) (:B P_inner) (:C *P)))

;; The margins already span the canvas, so a placed cell reads its extent.
(INIT &canvas Frame
  (extent (A N)
    (axis_elem *A)
    (&placed *P)
    (frame_extent P A *N)))

(RULE &painted
  (&placed (:P *P3) *Col)
  (&sym *S)
  (sym_member S (:D *R))
  (apply (:D R) (:P P3) (:P_out *P)))

(RULE &output
  (OR ((&painted *P *Col))
      ((&canvas.cell P)
       (NOT (&painted P))
       (&bg (:C Col)))))
