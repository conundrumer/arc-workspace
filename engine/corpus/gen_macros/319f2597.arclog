;; 319f2597

;; The mark's color.
(DET &mark RarestColor)

;; The color that resists the cast.
(DET &spare UnchangedColor)

(RULE &cross
  (input (:P *Q) *Col)
  (&mark (:C Col))
  (input *P)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(RULE &painted
  (&cross *P)
  (input P *Col)
  (NOT (&spare (:C Col))))

(ALTS $choice "what color the cast paints with" $Spread
  (ALT $Paint
    ;; The color the cast lays down.
    (DET &paint RarestColor)

    (RULE &output
      (OR ((&painted *P)
           (&paint (:C *Col)))
          ((input P Col)
           (NOT (&painted P)))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&painted P)))
      ((&painted P)
       (&mark (:C Col)))))
