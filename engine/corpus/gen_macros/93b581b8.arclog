;; 93b581b8

(DET &bg DominantColor)

;; Carries a block corner onto the corner its color fills.
(DET &transform D4Domain)

(INIT &block BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &corner_color
  (input *P *Col)
  (&block.box *B)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

;; The copy clears the block's own extent, so it touches the block at the corner.
(RULE &reach
  (&block.box *B)
  (input *P)
  (axis_of *D *A)
  (axis_elem A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K)))

(ALTS $choice "what fixes how far a copy clears the block" $Abut
  (ALT $Stride
    (DET &stride TileCount)

    (RULE &reach
      (dir_elem *D)
      (&stride (:N *K)))))

(RULE &copy
  (&block.box (:B *B3))
  (corner_dir (:C *E1) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C E1) (:A A2_m2) (:D *D2))
  (&reach (:D D1) (:K *K1))
  (dir8_opposite (:D D1) (:D2 *O_m4))
  (edge_inset (:D O_m4) (:K K1) (:B *B1_m5))
  (edge_inset (:D D1) (:K K1) (:B *I_m7))
  (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
  (compose (:A B3) (:B V_m3) (:C *B1))
  (&reach (:D D2) (:K *K2))
  (dir8_opposite (:D D2) (:D2 *O_m9))
  (edge_inset (:D O_m9) (:K K2) (:B *B1_m10))
  (edge_inset (:D D2) (:K K2) (:B *I_m12))
  (relative (:Base I_m12) (:X 0) (:X_rel *B2_m11))
  (compose (:A B1_m10) (:B B2_m11) (:C *V_m8))
  (compose (:A B1) (:B V_m8) (:C *B)))

(RULE &painted
  (input *P)
  (&copy (:E1 *E) (:B *B2))
  (ALL ((&copy (:E1 *Em) (:B B2))
        (dir_elem (:D *D_m1))
        (relative (:Base B2) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (&transform *D)
  (d4_elem D)
  (diag_dir_elem (:D *C))
  (diag_dir_elem (:D E))
  (step_offset (:D C) (:V *S_m1))
  (apply D (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D E) (:V S2_m2))
  (&corner_color (:D C) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
