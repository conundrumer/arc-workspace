;; 4938f0c2

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(DET &marker RarestColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&marker (:C Col))))

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(DET &sym SymDomain)

(INIT &block BoundingBox
  (cell (P)
    (input *P *Col)
    (&marker (:C Col))))

(RULE &img
  (&ink (:P *P2) *Col)
  (&block.box *B)
  (relative (:Base B) (:X P2) (:X_rel *V))
  (&sym *S)
  (sym_member S *D)
  (apply D (:P V) (:P_out *V2))
  (compose (:A B) (:B V2) (:C *P)))

(INIT &obj_box BoundingBox
  (key ((&obj_component *P ^Id))
    (cell (P)
      (&obj_component *P Id))))

(RULE &obj_quad
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&obj_box.box (:key *Id) (:B *B_obj))
  (&block.box (:B *B_block))
  (dir_elem (:D D1))
  (margin (:B B_obj) (:D D1) (:K *K1_m3))
  (margin (:B B_block) (:D D1) (:K *K2_m4))
  (< K1_m3 K2_m4)
  (dir_elem (:D D2))
  (margin (:B B_obj) (:D D2) (:K *K1_m5))
  (margin (:B B_block) (:D D2) (:K *K2_m6))
  (< K1_m5 K2_m6))

(ALTS $choice "where an image lands; the pairs cannot separate the cases: in every pair the shape abuts the block, and each object fills the corner of its box that faces the block" $Mirror
  (ALT $Seat
    (RULE &anchor
      (&obj_quad *Id (:Diag *Q))
      (diag_opposite (:D Q) (:Opp *Q_face))
      (&obj_box.box (:key Id) (:B *B_obj))
      (input *P)
      (ALL ((&obj_box.box (:key (:Id *Idm)) (:B B_obj))
            (dir_elem (:D *D_m1))
            (relative (:Base B_obj) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((diag_opposite (:D *Qm) (:Opp Q_face))
            (&obj_box.box (:key (:Id *Idmm)) (:B B_obj))
            (corner_dir (:C Q_face) (:D *D_m1m))
            (margin (:B P) (:D D_m1m) (:K *K1_m2))
            (margin (:B B_obj) (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))

    (RULE &img
      (&ink (:P *P2) *Col)
      (&obj_component (:P P2) *Id)
      (&anchor Id (:P *P0))
      (relative (:Base P0) (:X P2) (:X_rel *V))
      (&sym *S)
      (sym_member S *D)
      (apply D (:P V) (:P_out *V2))
      (&obj_quad Id (:Diag *Q))
      (d4_elem D)
      (diag_dir_elem (:D Q))
      (diag_dir_elem (:D *Q2))
      (step_offset (:D Q) (:V *S_m1))
      (apply D (:P S_m1) (:P_out *S2_m2))
      (step_offset (:D Q2) (:V S2_m2))
      (&block.cell (:P *P_c))
      (&block.box (:B *B_block))
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B_block) (:X P_c) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((d4_elem (:D *Dm))
            (diag_dir_elem (:D *Qm))
            (step_offset (:D Qm) (:V *S_m1m))
            (apply (:D Dm) (:P S_m1m) (:P_out *S2_m2m))
            (step_offset (:D Q2) (:V S2_m2m))
            (corner_dir (:C Q2) (:D *D_m1m))
            (margin (:B P_c) (:D D_m1m) (:K *K1_m2))
            (margin (:B B_block) (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3)))
      (step_offset (:D Q2) (:V *V_m3))
      (compose (:A P_c) (:B V_m3) (:C *P_seat))
      (compose (:A P_seat) (:B V2) (:C *P))))
  (ALT $SeatCell
    (RULE &anchor
      (&obj_quad *Id (:Diag *Q))
      (diag_opposite (:D Q) (:Opp *Q_face))
      (&obj_component *P Id)
      (&obj_box.box (:key Id) (:B *B_obj))
      (ALL ((&obj_component P (:Id *Idm))
            (&obj_box.box (:key (:Id Idm)) (:B B_obj))
            (dir_elem (:D *D_m1))
            (relative (:Base B_obj) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((diag_opposite (:D *Qm) (:Opp Q_face))
            (&obj_component P (:Id *Idmm))
            (&obj_box.box (:key (:Id Idmm)) (:B B_obj))
            (corner_dir (:C Q_face) (:D *D_m1m))
            (margin (:B P) (:D D_m1m) (:K *K1_m2))
            (margin (:B B_obj) (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3))))

    (RULE &img
      (&ink (:P *P2) *Col)
      (&obj_component (:P P2) *Id)
      (&anchor Id (:P *P0))
      (relative (:Base P0) (:X P2) (:X_rel *V))
      (&sym *S)
      (sym_member S *D)
      (apply D (:P V) (:P_out *V2))
      (&obj_quad Id (:Diag *Q))
      (d4_elem D)
      (diag_dir_elem (:D Q))
      (diag_dir_elem (:D *Q2))
      (step_offset (:D Q) (:V *S_m1))
      (apply D (:P S_m1) (:P_out *S2_m2))
      (step_offset (:D Q2) (:V S2_m2))
      (&block.cell (:P *P_c))
      (&block.box (:B *B_block))
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B_block) (:X P_c) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (ALL ((d4_elem (:D *Dm))
            (diag_dir_elem (:D *Qm))
            (step_offset (:D Qm) (:V *S_m1m))
            (apply (:D Dm) (:P S_m1m) (:P_out *S2_m2m))
            (step_offset (:D Q2) (:V S2_m2m))
            (corner_dir (:C Q2) (:D *D_m1m))
            (margin (:B P_c) (:D D_m1m) (:K *K1_m2))
            (margin (:B B_block) (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3)))
      (step_offset (:D Q2) (:V *V_m3))
      (compose (:A P_c) (:B V_m3) (:C *P_seat))
      (compose (:A P_seat) (:B V2) (:C *P)))))

(RULE &output
  (input *P (:Col *C0))
  (OR ((&img P *Col))
      ((NOT (&img P))
       (= Col C0))))
