;; 045e512c

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(RULE &object
  (&objs_component (:Key *Col) *P *Id))

(INIT &biggest_count Cardinality
  (key ((&object ^Id *P))
    (member ((:m P))
      (&object Id *P))))

;; The template is the largest object.
(INIT &biggest Order
  (member ((:t Id))
    (&biggest_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&biggest_count.size (:key *Id) *N)))

(RULE &shape
  (&biggest.maximal (:t *Id))
  (&object Id *P))

;; Where each object seats on the template: the translations that carry
;; every cell of the object onto a template cell.
(INIT &seating Occurrences
  (key ((OR ((&object ^Id *P))
            ((&object Id)
             (&shape P))))
    (cell (P)
      (&object Id)
      (&shape *P))
    (shape (P)
      (&object Id *P))))

(RULE &span
  (input *P)
  (axis_elem *A)
  (sub_extent P A *K))

(RULE &toward
  (&span *K)
  (dir8_elem *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Delta)))

(RULE &fits
  (&seating.occurrence (:key *Id) (:P *M))
  (relative (:Base M) (:X 0) (:X_rel *Delta))
  (&toward *K Delta))

(INIT &reach Order
  (key ((&fits ^Id *Delta *K))
    (member ((:t (:V Delta) (:S K)))
      (&fits Id *Delta *K))
    (score ((:t (:V Delta) (:S K)) (:S K))
      (&fits Id *Delta *K))))

(RULE &step
  (&reach.maximal (:key *Id) (:t (:V *Delta))))

(RULE &march_source
  (&shape *P))

(RULE &march_cell
  (input *P))

(ALTS $choice "what fixes the step's length" $Reach
  (ALT $Stride
    (DET &stride TileCount)

    (RULE &step
      (&fits *Id *Delta *K)
      (&stride (:N K))))
  (ALT $Abut
    (DET &gap DivisorRatio)

    (INIT &sbox BoundingBox
      (cell (P)
        (&shape *P)))

    (RULE &step
      (&fits *Id *Delta)
      (&sbox.box *B)
      (&shape *P)
      (axis_elem *A)
      (perp A *A2)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A *N)
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) N)
      (&toward *D (:K N) (:Delta *S1))
      (&gap (:K *G))
      (&toward D (:K G) (:Delta *S2))
      (compose (:A S1) (:B S2) (:C Delta)))))

(RULE &march_dir
  (&step *Delta)
  (&toward *D Delta))

(RULE &march_dir_ray
  (&march_dir *D))

(RULE &march_node
  (&march_dir)
  (input *P))

;; The template's cells, cast along each step's direction.
(INIT &march Distance
  (key ((&march_source (:P ^O))
        (&march_dir_ray ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&march_source (:P O))
           (&march_dir_ray D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&march_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&march_node (:P Q)))
          ((&march_source (:P O))
           (&march_dir_ray D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&march_node (:P Q))
           (= A2 O))
          ((&march_source (:P O))
           (&march_dir_ray D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&march_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&march_node (:P Q)))))
    (source ((:n O))
      (&march_source (:P O))
      (&march_dir_ray D))))

(RULE &march_ray
  (&march.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &march_end
  (&march_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&march_ray (:P Q) D Origin)))

(RULE &copy
  (&step *Id *Delta)
  (&toward *D *K Delta)
  (&march_ray *P D (:K *J))
  (&march_cell P)
  (> J 0)
  (divide (:T J) (:Side K) (:Gap 0) (:Remainder 0)))

(RULE &output
  (OR ((&copy *Id *P)
       (&object Id *Col))
      ((input P Col)
       (NOT (&copy P)))))
