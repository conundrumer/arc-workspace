;; b7fb29bc

(INPUT box-outline "a one-cell-wide rectangle outline of &frame_color (3) on a field of &background (0), closed on all four sides"

  (DET_OR_RULE &frame_color RarestColor)

  (DET_OR_RULE &background DominantColor))

(INPUT one-dot "exactly one cell of &frame_color (3) inside the box, apart from the outline; it can touch the outline"

  ;; The box: the bounding box of the frame-color cells.
  (INIT &frame BoundingBox
    (cell (P)
      (input *P *Col)
      (&frame_color (:C Col))))

  (RULE_OR_DET &frame.box "The box: the bounding box of the frame-color cells.")

  (RULE &in_box
    (&frame.box *B)
    (input *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0))))

  (RULE &dot
    (&in_box (:P *O))
    (input (:P O) *Col)
    (&frame_color (:C Col)))

  (INIT &the_dot Singleton
    (member ((:v O))
      (&dot *O))))

(OUTPUT square-rings "each background cell inside the box takes a color from its Chebyshev distance to the dot: &ring_colors at odd distance first, then at even distance, so the rings alternate outward from the dot"

  (RULE &dot_dist_uniform_outset1
    (&dot *O)
    (input *P)
    (relative (:Base O) (:X P) (:X_rel *P_rel))
    (dir_elem *D)
    (margin (:B P_rel) D (:K *K_))
    (axis_of (:D *D1_m1) (:A *A1_m2))
    (perp (:A A1_m2) (:A2 *A2_m3))
    (axis_of (:D *D2_m4) (:A A2_m3))
    (opposite (:D D1_m1) (:Opp *O_m7))
    (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
    (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
    (opposite (:D D2_m4) (:Opp *O_m10))
    (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
    (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
    (relative (:Base I_m1) (:X 0) (:X_rel *B_out_)))

  ;; the ring color at odd and at even distance from the dot
  (DET &ring_colors ColorColorDomain)

  (RULE &dot_dist
    (&dot *O)
    (input *P)
    (relative (:Base O) (:X P) (:X_rel *P_rel))
    (dir_elem *D)
    (margin (:B P_rel) D *K)
    (&dot_dist_uniform_outset1 (:K_ K) (:B_out_ *B_out))
    (compose (:A O) (:B B_out) (:C *B))
    (ALL ((&dot (:O *Om))
          (relative (:Base Om) (:X P) (:X_rel *P_relm))
          (dir_elem (:D *Dm))
          (margin (:B P_relm) (:D Dm) (:K *Km))
          (axis_of (:D *D1_m2) (:A *A1_m3))
          (perp (:A A1_m3) (:A2 *A2_m4))
          (axis_of (:D *D2_m5) (:A A2_m4))
          (opposite (:D D1_m2) (:Opp *O_m8))
          (edge_inset (:D D1_m2) (:K Km) (:B *B1_m9))
          (edge_inset (:D O_m8) (:K Km) (:B *B2_m10))
          (compose (:A B1_m9) (:B B2_m10) (:C *B1_m6))
          (opposite (:D D2_m5) (:Opp *O_m11))
          (edge_inset (:D D2_m5) (:K Km) (:B *B1_m12))
          (edge_inset (:D O_m11) (:K Km) (:B *B2_m13))
          (compose (:A B1_m12) (:B B2_m13) (:C *B2_m7))
          (compose (:A B1_m6) (:B B2_m7) (:C *I_m1))
          (relative (:Base I_m1) (:X 0) (:X_rel *B_outm))
          (compose (:A Om) (:B B_outm) (:C B))
          (dir_elem (:D *D_m1m))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D *D_m1) (:K *K_m2))
    (margin B (:D D_m1) (:K K_m2)))

  (INIT &nearest Order
    (key ((&dot_dist ^P *K))
      (member ((:t K))
        (&dot_dist P *K))
      (score ((:t K) (:S K))
        (&dot_dist P *K))))

  ;; The two ring colors alternate, one advance per ring.
  (INIT &colors Walk
    (successor ((:p A) (:p_next B))
      (&ring_colors (:C_from *Odd) (:C_to *Even))
      (OR ((= *A Even)
           (= *B Odd))
          ((= A Odd)
           (= B Even))))
    (steps ((:N K))
      (&dot_dist *K))))

(OUTPUT clip-to-box "rings cover only the cells inside the outline, and they stop at the outline"

  (RULE &enclosed_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &enclosed_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &enclosed_cell
    (input *P *Col)
    (NOT (&frame_color (:C Col))))

  (INIT &enclosed_flood Propagation
    (source ((:n P))
      (&enclosed_cell *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (input P *Col)
      (NOT (&frame_color (:C Col))))
    (edge ((:a P) (:b P2))
      (input *P *Col)
      (NOT (&frame_color (:C Col)))
      (&enclosed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (input (:P P2) (:Col *Col2))
      (NOT (&frame_color (:C Col2)))))

  (RULE &enclosed_node
    (&enclosed_cell *P)
    (NOT (&enclosed_flood.reached (:n P))))

  ;; The cells the frame-color cells close off from the grid edge.
  (INIT &enclosed Quotient
    (edge ((:a P) (:b P2))
      (OR ((&enclosed_node *P)
           (&enclosed_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&enclosed_node (:P P2)))
          ((&enclosed_node P)
           (= P2 P))))))

(OUTPUT keep-rest "the outline, the dot, and every cell outside the box keep their input colors")

(ALTS $dot_find "how the dot is found" $FrameDot
  (ALT $AnyInkDot
    (INPUT one-dot "the dot is the one non-background cell inside the box, of any color"
      (RULE &dot
        (&in_box (:P *O))
        (input (:P O) *Col)
        (NOT (&background (:C Col)))))))

(ALTS $dot_count "how many dots the rings grow from" $OneDot
  (ALT $NearestDot
    (INPUT one-dot "the box holds one or more dots; undefined where it holds none")
    (OUTPUT square-rings "a cell's distance is its Chebyshev distance to the nearest dot")
    (RULE &cell_dist
      (&nearest.minimal (:key *P) (:t *K)))))

(ALTS $region "which cells the rings fill" $BoxInside
  (ALT $EnclosedRegion
    (OUTPUT clip-to-box "rings fill the background cells that the frame-color cells close off from the grid edge; the input is unchanged where the outline is broken"
      (RULE &enclosed_component
        (&enclosed.class (:a *P) *Id)))
    (RULE &ring_cell
      (&enclosed_component *P)
      (input P (:Col *Bg))
      (&background (:C Bg)))))

(RULE &ring_cell
  (&in_box *P)
  (input P (:Col *Bg))
  (&background (:C Bg)))

(RULE &cell_dist
  (&the_dot.value (:v *O))
  (&dot_dist O *P *K))

(RULE &output
  (OR ((&ring_cell *P)
       (&cell_dist P *K)
       (&ring_colors (:C_to *Even))
       (&colors.walk (:p0 Even) (:N K) (:p *Col)))
      ((input P Col)
       (NOT (&ring_cell P)))))
