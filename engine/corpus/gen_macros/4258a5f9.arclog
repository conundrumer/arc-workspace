;; 4258a5f9

(DET &marker RarestColor)

(DET &halo AnyOutNewColor)

(RULE &marker_at
  (input *P *Col)
  (&marker (:C Col)))

(RULE &halo2
  (&marker_at (:P *M))
  (&halo (:C *Col))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A M) (:B V_m1) (:C *P))
  (input P))

(ALTS $choice "every marker sits away from the grid edge, on an otherwise empty field, so the program's edge clipping and its passthrough over ink go unwitnessed here" $Grow
  (ALT $Stamp
    (DET &blob_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (DET &mark
      (ex_input *E *P *Col)
      (&marker (:C Col)))

    (DET &stamped
      (ex_output *E *P *Col)
      (OR ((&mark E P))
          ((ex_input E P (:Col *Col_in))
           (!= Col_in Col))))

    ;; Each stamp with its marker, one 8-connected blob.
    (INIT &blob Quotient
      (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
        (OR ((&stamped *E *P)
             (&blob_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&stamped E (:P P3)))
            ((&stamped E P)
             (= P3 P)))))

    (DET &blob_component
      (&blob.class (:a *Key *P) *Id))

    ;; Two markers in one blob leave its cells no unique source.
    (INIT &blob_marker Singleton
      (key ((&mark ^E *P)
            (&blob_component (:Key E) P ^Id))
        (member ((:v P))
          (&mark E *P)
          (&blob_component (:Key E) P Id))))

    (DET &template
      (&blob_marker.value (:key *E *Id) (:v *M))
      (&blob_component (:Key E) *P Id)
      (&stamped E P *Col)
      (relative (:Base M) (:X P) (:X_rel *Delta)))

    (RULE &halo2
      (&marker_at (:P *Q))
      (&template (:Delta *Off) *Col)
      (compose (:A Q) (:B Off) (:C *P))
      (input P))))

(RULE &output
  (OR ((&halo2 *P *Col))
      ((input P Col)
       (NOT (&halo2 P)))))
