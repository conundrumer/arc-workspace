;; a395ee82

(INPUT background "one color fills most of the grid")

(INPUT objects "cells of one color that touch at an edge or a corner form one object"

  (RULE &joined4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &palette_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &palette Order
    (member ((:t Col))
      (&palette_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&palette_count.size (:key *Col) *N)))

  (RULE &bg
    (&palette.maximal (:t *Col)))

  (RULE &fg
    (input *Col)
    (NOT (&bg Col)))

  (INIT &joined4 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (&fg Col)
           (&joined4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (&fg Col)
           (= P3 P))))))

(INPUT shape "one object has more than one cell, in one color S; its bounding box is h rows by w columns"

  (RULE &joined8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &joined8 Quotient
    (edge ((:a Col P) (:b Col (:P P3)))
      (OR ((input *P *Col)
           (&fg Col)
           (&joined8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (&fg Col)
           (= P3 P)))))

  (RULE &joined8_component
    (&joined8.class (:a (:Col *Key) *P) *Id))

  (RULE &object
    (&joined8_component (:Key *Col) *P *Id))

  (INIT &size Cardinality
    (key ((&object ^Id *P))
      (member ((:m P))
        (&object Id *P))))

  (INIT &largest Order
    (member ((:t (:V Id) (:S N)))
      (&size.size (:key *Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&size.size (:key *Id) *N)))

  (INIT &biggest Singleton
    (member ((:v Id))
      (&largest.maximal (:t (:V *Id))))))

(INPUT dots "every other object is a single cell, a dot, and the dots sit on a lattice with a step of &dot_step on both axes; exactly one dot has the color S, and that dot is the anchor; all the other dots are the markers, in one color C, which is neither S nor the background"

  (RULE &multi
    (&object *Id *P)
    (&object Id (:P *Q))
    (!= P Q))

  (RULE &dot
    (&object *Id *Col *P)
    (NOT (&multi Id)))

  (DET &dot_step TileCount)

  (RULE &repeated
    (&dot *P *Col)
    (&dot (:P *Q) Col)
    (!= P Q))

  (INIT &lone Singleton
    (member ((:v Col))
      (&dot *Col)
      (NOT (&repeated Col)))))

(OUTPUT lattice "each dot takes the lattice offset (di, dj): its row and column distances from the anchor, counted in steps of &dot_step"

  (INIT &sole Singleton
    (member ((:v Id))
      (&multi *Id)))

  (RULE &shape
    (&sole.value (:v *Id))
    (&object Id (:Col *S)))

  (INIT &anchor Singleton
    (member ((:v P))
      (&shape *S)
      (&dot *P (:Col S))))

  (RULE &markers_of)

  (RULE &read
    (&shape))

  (RULE &reserved
    (&read)
    (&shape (:S *Col)))

  (INIT &ink Singleton
    (member ((:v C))
      (&read)
      (&markers_of)
      (&dot (:Col *C))
      (NOT (&reserved (:Col C)))))

  (RULE &marker
    (&markers_of)
    (&ink.value (:v *C))
    (&dot *P (:Col C)))

  (RULE &paint
    (OR ((&anchor.value (:v *Q))
         (&ink.value (:v *Col)))
        ((&marker (:P Q))
         (&shape (:S Col)))))

  (RULE &item_split1
    (&paint (:Q *Q2_))
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q2_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q2_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X Q2_) (:X_rel *X_m1_)))

  (RULE &item_split2
    (&anchor.value (:v *P_))
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_p_))
    (relative (:Base L_p_) (:X P_) (:X_rel *X_m2_)))

  (RULE &item_split3
    (&paint (:Q *Q_))
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_q_))
    (relative (:Base L_q_) (:X Q_) (:X_rel *X_m3_)))

  (RULE &pitch
    (&read)
    (&dot_step (:N *K)))

  (RULE &on_step
    (&pitch *K)
    (&anchor.value (:v *P))
    (&paint *Q)
    (relative (:Base P) (:X Q) (:X_rel *V))
    (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1))
    (perp (:A A_m2) (:A2 *A2_m3))
    (corner_dir (:C Diag_m1) (:A A2_m3) (:D *D2))
    (opposite (:D D1) (:Opp *O1))
    (opposite (:D D2) (:Opp *O2))
    (margin (:B V) (:D O1) (:K *T1))
    (margin (:B V) (:D O2) (:K *T2))
    (divide (:T T1) (:Side K) (:Gap 0) (:Part *N1) (:Remainder 0))
    (divide (:T T2) (:Side K) (:Gap 0) (:Part *N2) (:Remainder 0))
    (dir8_opposite (:D D1) (:D2 *O_m5))
    (edge_inset (:D O_m5) (:K N1) (:B *B1_m6))
    (edge_inset (:D D1) (:K N1) (:B *I_m8))
    (relative (:Base I_m8) (:X 0) (:X_rel *B2_m7))
    (compose (:A B1_m6) (:B B2_m7) (:C *V_m4))
    (compose (:A 0) (:B V_m4) (:C *I1))
    (dir8_opposite (:D D2) (:D2 *O_m10))
    (edge_inset (:D O_m10) (:K N2) (:B *B1_m11))
    (edge_inset (:D D2) (:K N2) (:B *I_m13))
    (relative (:Base I_m13) (:X 0) (:X_rel *B2_m12))
    (compose (:A B1_m11) (:B B2_m12) (:C *V_m9))
    (compose (:A I1) (:B V_m9) (:C *I)))

  ;; The dot lines past the anchor's line toward d, up to the dot's own.
  (INIT &rungs Cardinality
    (key ((OR ((&anchor.value (:v *P))
               (&paint ^Q)
               (dir_elem ^D)
               (opposite D (:Opp *O))
               (dir_elem (:D O))
               (margin (:B Q) (:D O) (:K *K1_m1))
               (margin (:B P) (:D O) (:K *K2_m2))
               (>= K1_m1 K2_m2))
              ((&anchor.value (:v P))
               (&paint Q)
               (&paint (:Q *Q2))
               (axis_of D *A)
               (&item_split1 (:Q2_ Q2) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
               (&item_split2 (:P_ P) (:A_ A) (:L_p_ *L_p) (:X_m2_ *X_m2))
               (&item_split3 (:Q_ Q) (:A_ A) (:L_q_ *L_q) (:X_m3_ *X_m3))
               (dir_elem D)
               (margin (:B L) D (:K *K1_m4))
               (margin (:B L_p) D (:K *K2_m5))
               (< K1_m4 K2_m5)
               (dir_elem D)
               (margin (:B L) D (:K *K1_m6))
               (margin (:B L_q) D (:K *K2_m7))
               (>= K1_m6 K2_m7))))
      (member ((:m L))
        (&anchor.value (:v *P))
        (&paint Q)
        (&paint (:Q *Q2))
        (axis_of D *A)
        (&item_split1 (:Q2_ Q2) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
        (&item_split2 (:P_ P) (:A_ A) (:L_p_ *L_p) (:X_m2_ *X_m2))
        (&item_split3 (:Q_ Q) (:A_ A) (:L_q_ *L_q) (:X_m3_ *X_m3))
        (dir_elem D)
        (margin (:B L) D (:K *K1_m4))
        (margin (:B L_p) D (:K *K2_m5))
        (< K1_m4 K2_m5)
        (dir_elem D)
        (margin (:B L) D (:K *K1_m6))
        (margin (:B L_q) D (:K *K2_m7))
        (>= K1_m6 K2_m7))
      (domain ()
        (&anchor.value (:v *P))
        (&paint Q)
        (dir_elem D)
        (opposite D (:Opp *O))
        (dir_elem (:D O))
        (margin (:B Q) (:D O) (:K *K1_m1))
        (margin (:B P) (:D O) (:K *K2_m2))
        (>= K1_m1 K2_m2)))))

(OUTPUT stamp "for each dot, the output draws the shape's cells moved by di · (h + &stamp_gap) rows and dj · (w + &stamp_gap) columns, clipped at the grid edge; the anchor's stamp covers the shape's own place"

  (INIT &box BoundingBox
    (key ((&object ^Id *P))
      (cell (P)
        (&object Id *P))))

  (DET &shape_cell
    (&sole.value *E (:v *Id))
    (&object E Id (:Col *S) *P))

  (DET &gap
    (&shape_cell *E)
    (ex_input E *P)
    (dir_elem *D)
    (margin (:B P) D (:K *G)))

  (DET &covered
    (&gap *E *G)
    (&sole.value E (:v *Id))
    (&box.box E (:key Id) *B)
    (&shape_cell E *P)
    (corner_dir (:C *Diag_m1) *A (:D *D1))
    (perp A (:A2 *A2_m2))
    (corner_dir (:C Diag_m1) (:A A2_m2) (:D *D2))
    (perp A *A2)
    (opposite (:D D1) (:Opp *O1))
    (opposite (:D D2) (:Opp *O2))
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (margin (:B P_rel) (:D O1) (:K *K1))
    (margin (:B P_rel) (:D O2) (:K *K2))
    (ex_input E (:P *Q))
    (relative (:Base B) (:X Q) (:X_rel *Q_rel))
    (margin (:B Q_rel) (:D O1) (:K *T1))
    (margin (:B Q_rel) (:D O2) (:K *T2))
    (axis_elem A)
    (relative (:Base B) (:X Q) (:X_rel *R_m3))
    (frame_extent (:P R_m3) A (:N *N1))
    (axis_elem (:A A2))
    (relative (:Base B) (:X Q) (:X_rel *R_m4))
    (frame_extent (:P R_m4) (:A A2) (:N *N2))
    (divide (:T T1) (:Side N1) (:Gap G) (:Remainder K1))
    (divide (:T T2) (:Side N2) (:Gap G) (:Remainder K2)))

  (DET &gap_defect
    (ex_output *E (:P *Q) (:Col *S))
    (&shape_cell E S)
    (&gap E *G)
    (NOT (&covered E G Q)))

  (DET &stamp_gap
    (&gap *E (:G *K))
    (ex_output E)
    (NOT (&gap_defect (:G K)))))

(OUTPUT stamp-color "the anchor's stamp is drawn in C, and each marker's stamp in S")

(OUTPUT erase "every other cell of the output is the background")

(ALTS $objects "which cells join into one object" $CornerJoin
  (ALT $EdgeAdjacency
    (INPUT objects "cells of one color that share an edge form one object"
      (RULE &joined4_component
        (&joined4.class (:a (:Col *Key) *P) *Id))

      (RULE &object
        (&joined4_component (:Key *Col) *P *Id)))))

(ALTS $shape "which object is the shape" $OnePiece
  (ALT $LargestPiece
    (INPUT shape "the largest object is the shape, in its color S, and the other objects of more than one cell are erased; undefined when two objects tie for largest"
      (RULE &shape
        (&biggest.value (:v *Id))
        (&object Id (:Col *S))))
    (ALTS $markers "which cells are the markers" $SingleDots
      (ALT $MarkersByColor
        (INPUT dots "every cell of the one non-background color other than S is a marker, and that color is C; undefined when there is more than one such color"
          (INIT &ink Singleton
            (member ((:v C))
              (OR ((&read)
                   (&markers_of)
                   (&dot (:Col *C))
                   (NOT (&reserved (:Col C))))
                  ((&read)
                   (&markers_of)
                   (&fg (:Col C))
                   (NOT (&reserved (:Col C)))))))
          (RULE &marker
            (&markers_of)
            (&ink.value (:v *C))
            (input *P (:Col C))))))))

(ALTS $anchor "which dot is the anchor" $ShapeColorDot
  (ALT $AnchorNearest
    (INPUT dots "of the dots in S, the anchor is the one whose summed taxicab distance to the markers is least, and the other dots in S are erased; undefined at a tie"
      (RULE &line_split1
        (input (:P *P_))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *L_))
        (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

      (RULE_OR_DET &line "The lines of the grid on each axis, axis-only."
        (input *P)
        (axis_elem *A)
        (&line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

      ;; Each dot in S, scored by its summed taxicab distance to the markers: each
      ;; marker counts the lines past the dot up to its own, on both axes.
      (INIT &span Cardinality
        (key ((&shape *S)
              (&dot ^P (:Col S))
              (&marker (:P *M))
              (&line *A *L)
              (axis_of *D A)
              (dir_elem D)
              (margin (:B M) D (:K *K1_m1))
              (margin (:B P) D (:K *K2_m2))
              (< K1_m1 K2_m2)
              (dir_elem D)
              (margin (:B L) D (:K *K1_m3))
              (margin (:B P) D (:K *K2_m4))
              (< K1_m3 K2_m4)
              (dir_elem D)
              (margin (:B L) D (:K *K1_m5))
              (margin (:B M) D (:K *K2_m6))
              (>= K1_m5 K2_m6))
          (member ((:m M A L))
            (&shape *S)
            (&dot P (:Col S))
            (&marker (:P *M))
            (&line *A *L)
            (axis_of *D A)
            (dir_elem D)
            (margin (:B M) D (:K *K1_m1))
            (margin (:B P) D (:K *K2_m2))
            (< K1_m1 K2_m2)
            (dir_elem D)
            (margin (:B L) D (:K *K1_m3))
            (margin (:B P) D (:K *K2_m4))
            (< K1_m3 K2_m4)
            (dir_elem D)
            (margin (:B L) D (:K *K1_m5))
            (margin (:B M) D (:K *K2_m6))
            (>= K1_m5 K2_m6))))

      (INIT &nearest Order
        (member ((:t (:V P) (:S N)))
          (&span.size (:key *P) *N))
        (score ((:t (:V P) (:S N)) (:S N))
          (&span.size (:key *P) *N)))

      (INIT &anchor Singleton
        (member ((:v P))
          (&nearest.minimal (:t (:V *P)))))))
  (ALT $AnchorMinority
    (INPUT dots "the anchor is the dot whose color no other dot has, and the markers are the other dots, all in one color C; undefined when no color, or more than one, occurs on one dot alone"
      (INIT &anchor Singleton
        (member ((:v P))
          (&read)
          (&lone.value (:v *A))
          (&dot *P (:Col A))))

      (RULE &reserved
        (&read)
        (&lone.value (:v *Col))))))

(ALTS $lattice "how a dot's place gives the block of its stamp" $StoredStep
  (ALT $StepGcd
    (OUTPUT lattice "the step is the largest at which every marker lies on the anchor's lattice"
      (RULE &pitch
        (&anchor.value (:v *P))
        (axis_elem *A)
        (sub_extent P A *K))

      (INIT &steps Order
        (member ((:t K))
          (&pitch *K)
          (ALL ((&marker (:P *M)))
               ((&on_step K (:Q M)))))
        (score ((:t K) (:S K))
          (&pitch *K)
          (ALL ((&marker (:P *M)))
               ((&on_step K (:Q M)))))))
    (RULE &place
      (&steps.maximal (:t *K))
      (&on_step K *Q *I)))
  (ALT $LatticeRank
    (OUTPUT lattice "on each axis, a dot's offset is its line's rank among the dots' distinct lines, less the anchor's")
    (RULE &place
      (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1))
      (perp (:A A_m2) (:A2 *A2_m3))
      (corner_dir (:C Diag_m1) (:A A2_m3) (:D *D2))
      (&rungs.size (:key *Q (:D D1)) (:N *N1))
      (&rungs.size (:key Q (:D D2)) (:N *N2))
      (dir8_opposite (:D D1) (:D2 *O_m5))
      (edge_inset (:D O_m5) (:K N1) (:B *B1_m6))
      (edge_inset (:D D1) (:K N1) (:B *I_m8))
      (relative (:Base I_m8) (:X 0) (:X_rel *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *V_m4))
      (compose (:A 0) (:B V_m4) (:C *I1))
      (dir8_opposite (:D D2) (:D2 *O_m10))
      (edge_inset (:D O_m10) (:K N2) (:B *B1_m11))
      (edge_inset (:D D2) (:K N2) (:B *I_m13))
      (relative (:Base I_m13) (:X 0) (:X_rel *B2_m12))
      (compose (:A B1_m11) (:B B2_m12) (:C *V_m9))
      (compose (:A I1) (:B V_m9) (:C *I)))))

(ALTS $content "what one stamp copies" $ShapeCells
  (ALT $BoxStamp
    (OUTPUT stamp "each stamp copies the shape's bounding box; a cell in S takes the stamp's color, and a cell of any other color keeps its color")
    (RULE &source
      (&shape *Id)
      (&box.box (:key Id) *B)
      (input *P *Col)
      (ALL ((input P (:Col *Colm))
            (&box.box (:key (:Id *Idm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &place
  (&on_step *Q *I))

(RULE &astray
  (&marker (:P *M))
  (NOT (&place (:Q M))))

(RULE &block
  (&shape *Id)
  (&box.box (:key Id) *B)
  (&stamp_gap (:K *G))
  (corner_dir (:C *Diag_m1) *A (:D *D1))
  (perp A (:A2 *A2_m2))
  (corner_dir (:C Diag_m1) (:A A2_m2) (:D *D2))
  (perp A *A2)
  (opposite (:D D1) (:Opp *O1))
  (opposite (:D D2) (:Opp *O2))
  (input (:P *X))
  (relative (:Base B) X *X_rel)
  (margin (:B X_rel) (:D O1) (:K *T1))
  (margin (:B X_rel) (:D O2) (:K *T2))
  (axis_elem A)
  (relative (:Base B) X (:X_rel *R_m3))
  (frame_extent (:P R_m3) A (:N *N1))
  (axis_elem (:A A2))
  (relative (:Base B) X (:X_rel *R_m4))
  (frame_extent (:P R_m4) (:A A2) (:N *N2))
  (divide (:T T1) (:Side N1) (:Gap G) (:Part *K1) (:Remainder 0))
  (divide (:T T2) (:Side N2) (:Gap G) (:Part *K2) (:Remainder 0))
  (dir8_opposite (:D D1) (:D2 *O_m6))
  (edge_inset (:D O_m6) (:K K1) (:B *B1_m7))
  (edge_inset (:D D1) (:K K1) (:B *I_m9))
  (relative (:Base I_m9) (:X 0) (:X_rel *B2_m8))
  (compose (:A B1_m7) (:B B2_m8) (:C *V_m5))
  (compose (:A 0) (:B V_m5) (:C *I1))
  (dir8_opposite (:D D2) (:D2 *O_m11))
  (edge_inset (:D O_m11) (:K K2) (:B *B1_m12))
  (edge_inset (:D D2) (:K K2) (:B *I_m14))
  (relative (:Base I_m14) (:X 0) (:X_rel *B2_m13))
  (compose (:A B1_m12) (:B B2_m13) (:C *V_m10))
  (compose (:A I1) (:B V_m10) (:C *I))
  (dir8_opposite (:D D1) (:D2 *O_m16))
  (edge_inset (:D O_m16) (:K T1) (:B *B1_m17))
  (edge_inset (:D D1) (:K T1) (:B *I_m19))
  (relative (:Base I_m19) (:X 0) (:X_rel *B2_m18))
  (compose (:A B1_m17) (:B B2_m18) (:C *V_m15))
  (compose (:A 0) (:B V_m15) (:C *V1))
  (dir8_opposite (:D D2) (:D2 *O_m21))
  (edge_inset (:D O_m21) (:K T2) (:B *B1_m22))
  (edge_inset (:D D2) (:K T2) (:B *I_m24))
  (relative (:Base I_m24) (:X 0) (:X_rel *B2_m23))
  (compose (:A B1_m22) (:B B2_m23) (:C *V_m20))
  (compose (:A V1) (:B V_m20) (:C *V)))

(RULE &source
  (&shape *Id (:S *Col))
  (&object Id Col *P))

(RULE &stamped
  (&paint *Q (:Col *C_stamp))
  (&place Q *I)
  (&block I *V)
  (&source (:P *P3) (:Col *C_own))
  (compose (:A P3) (:B V) (:C *P))
  (input P)
  (&shape *S)
  (OR ((= C_own S)
       (= *Col C_stamp))
      ((!= C_own S)
       (= Col C_own))))

(RULE &ready
  (&anchor.value)
  (&marker)
  (NOT (&astray)))

(RULE &output
  (&ready)
  (OR ((&stamped *P *Col))
      ((input P)
       (&bg Col)
       (NOT (&stamped P)))))
