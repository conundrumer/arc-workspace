;; 642248e4

;; An edge of two colors is no line.
(INIT &line Singleton
  (key ((dir_elem ^D))
    (member ((:v Col))
      (input *P *Col)
      (margin (:B P) D (:K 0)))))

(DET &changed
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col_in))
  (!= Col Col_in))

(DET &grew
  (ex_input *E *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&changed E (:P Q)))

(DET &no_growth
  (ex_input *E *P *Col)
  (ex_output E)
  (NOT (&grew E P)))

(DET &mark
  (ex_input *E *Col)
  (ex_output E)
  (NOT (&no_growth Col)))

(RULE &tail
  (input (:P *P2) (:Col *Col_mark))
  (&mark (:Col Col_mark))
  (&line.value (:key *D) (:v *Col))
  (opposite D (:Opp *O_m1))
  (margin (:B P2) D *K)
  (margin (:B P2) (:D O_m1) (:K *K2))
  (< K K2)
  (step_offset D (:V *V_m2))
  (compose (:A P2) (:B V_m2) (:C *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&tail P *Col))
      ((NOT (&tail P))
       (= Col Col_in))))
