;; 8f2ea7aa

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; $Crop — the ink's bounding box, tiled by itself.
(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &shape
  (input (:P *P2) *Col)
  (&bbox.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

(ALTS $pa "the shape and the output decomposition" $Crop
  (ALT $Divide
    (DET &tile_dim TileCount)

    (RULE &block_division_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &block_division_side
      (axis_elem *A)
      (&tile_dim (:N *K)))

    (RULE &block_division_axis
      (OR ((input *P)
           (axis_elem *A)
           (&tile_dim (:N *K))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (NOT (&block_division_side A))
           (&block_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &block_division_tile
      (&block_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&block_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &block
      (&block_division_tile (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

    (RULE &cell
      (&block *P_grid *P_tile *P_intile))

    (RULE &shape
      (&block (:P_grid *P2) *P_tile (:P_intile *P))
      (input (:P P2) *Col)
      (&block (:P_grid *P_ink) P_tile)
      (&ink (:P P_ink)))))

(ALTS $f "fill color" $Stamp
  (ALT $Mask
    ;; $Mask — the shape scaled up, masked by itself.
    (RULE &output
      (&cell (:P_grid *P) *P_tile *P_intile)
      (IF ((&active (:P P_intile)))
          ((&shape (:P P_tile) *Col))
          ((&bg (:C Col)))))))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&shape (:P *P_tile)))
  (inner ((:P P_intile))
    (&shape (:P *P_intile))))

(RULE &cell
  (&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))

(RULE &active
  (&shape *P *Col)
  (NOT (&bg (:C Col))))

;; $Stamp — copies of the shape at its active cells.
(RULE &output
  (&cell (:P_grid *P) *P_tile *P_intile)
  (IF ((&active (:P P_tile)))
      ((&shape (:P P_intile) *Col))
      ((&bg (:C Col)))))
