;; b0f4d537

(INPUT two-panels "a full column of &divider cells, running top to bottom, splits the input into two panels."

  (DET &divider VanishedColor)

  (RULE &mixed_line_split1
    (input (:P *P_) (:Col *C))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (RULE &mixed_line_split2
    (input (:P *Q_) (:Col *C2))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X Q_) (:X_rel *X_m2_)))

  (RULE &item_split1
    (input (:P *P_) (:Col *C))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (INIT &commonest_count Cardinality
    (key ((input *P (:Col ^C)))
      (member ((:m P))
        (input *P (:Col C)))))

  (INIT &commonest Order
    (member ((:t C))
      (&commonest_count.size (:key *C)))
    (score ((:t C) (:S N))
      (&commonest_count.size (:key *C) *N)))

  (INIT &full_line_color Singleton
    (member ((:v C))
      (input *P (:Col *C))
      (axis_elem *A)
      (&item_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1))
      (ALL ((input (:P *Pm) (:Col *Cm))
            (&mixed_line_split1 (:P_ Pm) (:A_ A) (:X_ X) (:X_m1_ *X_m1m))
            (input (:P *Q) (:Col *C2))
            (&mixed_line_split2 (:Q_ Q) (:A_ A) (:X_ X) (:X_m2_ *X_m2)))
           ((= Cm C2)))
      (NOT (&commonest.maximal (:t C))))))

(INPUT key-panel "one panel holds the key at its top end, and &divider cells fill the rest of that panel.")

(INPUT key-grid "the key's rows and its columns each alternate between gaps and lines &key_band wide, with a gap at each end; each line row is a line of one color across the key, each line column is a line of one color down the key, each cell off both lines is 0, each crossing cell has the color of one of its two lines, and no key cell is &marker or &divider."

  (DET &marker3 VanishedColor)

  ;; The width of each line and each gap of the key.
  (DET &key_band DivisorRatio)

  (RULE &marker4
    (&marker3 *C))

  (RULE &marker
    (&marker4 *C)))

(INPUT field "the other panel is the field, of 0 cells and &marker cells, with no line at its border and no two lines adjacent.")

(INPUT field-markers "the field has as many line rows and as many line columns as the key; a &marker cell sits at both ends of each line, on the field border, and at each crossing of a line row with a line column, and nowhere else.")

(OUTPUT find-panels "the field is the panel that holds &marker cells; the key is the cells of the other panel that are not &divider."

  (RULE &panel_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &divider2
    (&divider *C))

  (RULE &broken_line_split1
    (input (:P *P_) (:Col *C))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (RULE &broken_line
    (&divider2)
    (input *P (:Col *C))
    (NOT (&divider2 C))
    (axis_elem *A)
    (&broken_line_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1)))

  (RULE &cut_axis
    (axis_elem *A))

  (RULE &divider_line_split1
    (input (:P *P_) (:Col *C))
    (&cut_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (RULE &divider_line
    (&divider2 *C)
    (input *P (:Col C))
    (&cut_axis *A)
    (&divider_line_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1))
    (NOT (&broken_line A X)))

  (INIT &panel Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P)
           (&divider2)
           (NOT (&divider_line P))
           (&panel_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3))
           (NOT (&divider_line (:P P3))))
          ((input P)
           (&divider2)
           (NOT (&divider_line P))
           (= P3 P)))))

  (RULE &panel_component
    (&panel.class (:a *P) *Id))

  (INIT &filled Singleton
    (member ((:v Id))
      (&panel_component *P *Id)
      (input P (:Col *C))
      (&divider2 C))))

(OUTPUT field-lines "a line row of the field is a row whose two border cells are &marker; a line column is a column whose two border cells are &marker.")

(OUTPUT stretch-key "the output has the field's size. Counted from either end, the k-th line row of the field takes the key's k-th line row, and each other row takes the key row off the lines that has as many line rows before it as that row has; columns map the same way. Each output cell is the key cell at its mapped row and column. Undefined where the two ends give a cell different colors, or where a row or column takes no key row or column from one end."

  (INIT &marked Singleton
    (member ((:v Id))
      (&panel_component *P *Id)
      (input P (:Col *C))
      (&marker3 C)))

  (RULE &field_panel
    (&marked.value (:v *Id)))

  (RULE &field_cell
    (&field_panel *Id)
    (&panel_component *P Id)
    (input P *Col))

  (INIT &field_box BoundingBox
    (cell (P)
      (&field_cell *P)))

  (RULE &field3
    (&field_cell (:P *P2) *Col)
    (&field_box.box *B)
    (ALL ((&field_cell (:P P2) (:Col *Cm))
          (&field_box.box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P2) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P2) (:X_rel *P)))

  (RULE &field
    (&field3 *P *Col))

  (RULE &line_end_split1
    (&field (:P *P_) (:Col *C))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (RULE &field_idx_split1
    (&field3 (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

  (RULE &key_panel
    (&marked.value (:v *Id0))
    (&panel_component *Id)
    (!= Id Id0))

  (RULE &key_panel_cell
    (&key_panel *Id)
    (&panel_component *P Id)
    (input P *Col))

  (RULE &key_cell
    (&key_panel_cell *P *Col)
    (NOT (&divider2 (:C Col))))

  (INIT &key_box BoundingBox
    (cell (P)
      (&key_cell *P)))

  (RULE &key
    (&key_cell (:P *P2) *Col)
    (&key_box.box *B)
    (ALL ((&key_cell (:P P2) (:Col *Cm))
          (&key_box.box B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P2) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P2) (:X_rel *P)))

  (RULE &key_idx_split1
    (&key (:P *Q_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X Q_) (:X_rel *X_m1_)))

  (RULE &takes_cell_split1
    (&field3 (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X1_))
    (relative (:Base X1_) (:X P_) (:X_rel *X2_)))

  (RULE &takes_cell_split2
    (&key (:P *Q_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *K1_))
    (relative (:Base K1_) (:X Q_) (:X_rel *K2_)))

  (RULE &item_split2
    (&key (:P *Q_) (:Col *C))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_))
    (relative (:Base X_) (:X Q_) (:X_rel *X2_)))

  (RULE &line_end
    (&field *P *Col)
    (axis_elem *A)
    (&line_end_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1))
    (perp A *A2)
    (axis_of *D (:A A2))
    (margin (:B P) D (:K 0)))

  (RULE &marked_end
    (&line_end *A *X *D (:Col *C))
    (&marker C))

  (RULE &both_marked
    (&marked_end *A *X)
    (ALL ((&line_end A X (:Col *C)))
         ((&marker C))))

  (RULE &field_idx
    (&field3 *P)
    (&marker4)
    (axis_elem *A)
    (&field_idx_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1)))

  (RULE &read_idx
    (&field_idx *A *X))

  (RULE &field_line
    (&both_marked *A *X))

  (RULE &field_gap
    (&read_idx *A *X)
    (NOT (&field_line A X)))

  ;; The field lines between each field index and edge d.
  (INIT &before Cardinality
    (key ((OR ((&read_idx *A ^X)
               (axis_of ^D A))
              ((&field_line A (:X *X2))
               (&field_idx A X)
               (axis_of D A)
               (dir_elem D)
               (margin (:B X2) D (:K *K1_m1))
               (margin (:B X) D (:K *K2_m2))
               (< K1_m1 K2_m2))))
      (member ((:m X2))
        (&field_line *A (:X *X2))
        (&field_idx A X)
        (axis_of D A)
        (dir_elem D)
        (margin (:B X2) D (:K *K1_m1))
        (margin (:B X) D (:K *K2_m2))
        (< K1_m1 K2_m2))
      (domain ()
        (&read_idx *A X)
        (axis_of D A))))

  (RULE &key_idx
    (&key (:P *Q))
    (axis_elem *A)
    (&key_idx_split1 (:Q_ Q) (:A_ A) (:X_ *X) (:X_m1_ *X_m1)))

  (RULE &key_gap
    (&key_idx *A *X)
    (axis_of *D A)
    (margin (:B X) D (:K *T))
    (&key_band (:K *W))
    (divide T (:Side W) (:Gap W) (:Part *N)))

  (RULE &key_line
    (&key_idx *A *X)
    (axis_of *D A)
    (NOT (&key_gap D X))
    (step_offset D (:V *V_m1))
    (compose (:A X) (:B V_m1) (:C *X2))
    (&key_gap D (:X X2) *N))

  (RULE &gap_takes
    (&field_gap *X)
    (&before.size (:key *D X) *N)
    (&key_gap D (:X *X_key) N))

  (RULE &takes
    (OR ((&field_line *X)
         (&before.size (:key *D X) *N)
         (&key_line D (:X *X_key) N))
        ((&gap_takes D X X_key))))

  (RULE &untaken
    (&read_idx *A *X)
    (axis_of *D A)
    (NOT (&takes D X)))

  (RULE &takes_cell
    (&field3 *P)
    (axis_elem *A)
    (&takes_cell_split1 (:P_ P) (:A_ A) (:X1_ *X1) (:X2_ *X2))
    (&takes (:D *D1) (:X X1) (:X_key *K1))
    (NOT (&untaken (:X X1)))
    (NOT (&untaken (:X X2)))
    (&takes (:D *D2) (:X X2) (:X_key *K2))
    (&key (:P *Q))
    (&takes_cell_split2 (:Q_ Q) (:A_ A) (:K1_ K1) (:K2_ K2)))

  ;; The colors of a key line off its crossings.
  (INIT &line_color Singleton
    (key ((&key_line ^X))
      (member ((:v C))
        (&key (:P *Q) (:Col *C))
        (axis_elem *A)
        (&item_split2 (:Q_ Q) (:A_ A) (:X_ X) (:X2_ *X2))
        (&key_gap (:X X2))))))

(ALTS $l "how the field's line rows and line columns are found" $LineByBothEnds
  (ALT $LineByEitherEnd
    (OUTPUT field-lines "a line is a row or column with &marker at either of its border cells."
      (RULE &field_line
        (&marked_end *A *X))))
  (ALT $LineByHeaderEdge
    (OUTPUT field-lines "a line row has &marker at its border cell on the edge of the corner &header, and a line column at its border cell on the corner's other edge. The output holds the grid of each value of &header."
      ;; The field of each example: the box of its marker cells.
      (INIT &marks BoundingBox
        (key ((ex_input ^E *P (:Col *C))
              (&marker3 C))
          (cell (P)
            (ex_input E *P (:Col *C))
            (&marker3 C))))

      (DET &field_inside1
        (ex_input *E (:P *P_) (:Col *C))
        (&marks.box (:key E) (:B *B_))
        (dir_elem (:D *D_m1))
        (relative (:Base B_) (:X P_) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0))

      (DET &field2
        (ex_input *E (:P *P2) *Col)
        (&marks.box (:key E) *B)
        (NOT (&field_inside1 (:P_ P2) (:B_ B)))
        (relative (:Base B) (:X P2) (:X_rel *P)))

      (DET &line_end_split12
        (&field2 (:E *K) (:P *P_) (:Col *C))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_))
        (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

      (DET &line_end2
        (&field2 *E *P *Col)
        (axis_elem *A)
        (&line_end_split12 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1))
        (perp A *A2)
        (axis_of *D (:A A2))
        (margin (:B P) D (:K 0)))

      (DET &marker2
        (ex_input *E)
        (&marker3 *C))

      (DET &marked_end2
        (&line_end2 *E *A *X *D (:Col *C))
        (&marker2 E C))

      (DET &unmarked_end2
        (&line_end2 *E *A *X (:Col *C))
        (NOT (&marker2 E C)))

      (DET &both_marked2
        (&marked_end2 *E *A *X)
        (NOT (&unmarked_end2 E A X)))

      (DET &misread
        (ex_output *E)
        (&marked_end2 E *A *X *D)
        (NOT (&both_marked2 E A X))
        (perp A *A2)
        (corner_dir (:C *H) (:A A2) D))

      (DET &header
        (diag_dir_elem *D)
        (NOT (&misread (:H D)))
        (ONE))

      (RULE &field_line
        (&header (:D *H))
        (&marked_end *A *X *D)
        (perp A *A2)
        (corner_dir (:C H) (:A A2) D))))
  (ALT $LineByCrossing
    (OUTPUT field-lines "the lines are the rows and the columns of the &marker cells off the field border."
      (RULE &field_line_split1
        (&field3 (:P *P_) (:Col *C))
        (axis_elem (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_))
        (relative (:Base X_) (:X P_) (:X_rel *X_m12_)))

      (RULE &field_line
        (&field3 *P (:Col *C))
        (&marker4 C)
        (relative (:Base 0) (:X P) (:X_rel *R_m1))
        (axis_of (:D *D1_m2) (:A *A1_m3))
        (opposite (:D D1_m2) (:Opp *O1_m4))
        (perp (:A A1_m3) (:A2 *A2_m5))
        (axis_of (:D *D2_m6) (:A A2_m5))
        (opposite (:D D2_m6) (:Opp *O2_m7))
        (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
        (> K1_m8 0)
        (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
        (> K2_m9 0)
        (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
        (> K3_m10 0)
        (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
        (> K4_m11 0)
        (axis_elem *A)
        (&field_line_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m12_ *X_m12))))))

(ALTS $d "what fills the output" $Stretch
  (ALT $DrawLines
    (OUTPUT stretch-key "rows and columns map as in the concept; a cell on one line takes that line's color, the one color its key line holds off the crossings, a crossing takes the key's crossing cell, and every other cell is &background. Undefined where a key line holds more than one color off the crossings."
      (RULE &out_split1
        (&takes_cell *P (:Q *Q_) *D1 *D2)
        (axis_of (:D D1) (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B Q_) (:D D_m1) (:K *K1_m3))
        (margin (:B Q_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *K1_))
        (relative (:Base K1_) (:X Q_) (:X_rel *K2_)))

      (DET_OR_RULE &background DominantColor))
    (RULE &output
      (&takes_cell *P *Q *D1 *D2)
      (axis_of (:D D1) *A)
      (&out_split1 (:Q_ Q) (:A_ A) (:K1_ *K1) (:K2_ *K2))
      (OR ((&key_line (:D D1) (:X K1))
           (&key_line (:D D2) (:X K2))
           (&key (:P Q) *Col))
          ((&key_line (:D D1) (:X K1))
           (&key_gap (:D D2) (:X K2))
           (&line_color.value (:key (:X K1)) (:v Col)))
          ((&key_gap (:D D1) (:X K1))
           (&key_gap (:D D2) (:X K2))
           (&background (:C Col)))))))

(ALTS $g "which key gap row a field gap row takes" $GapByCount
  (ALT $GapToEnd
    (OUTPUT stretch-key "each row off the field's lines takes the key's gap row at the edge the lines are counted from, and columns likewise."
      (RULE &gap_takes
        (&field_gap *A *X)
        (axis_of *D A)
        (&key_gap D (:X *X_key) (:N 0))))))

(ALTS $f "which panel is the field and which is the key" $FieldByMarker
  (ALT $KeyByFill
    (OUTPUT find-panels "the key is the cells, not &divider, of the panel that &divider cells partly fill, and the field is the other panel. Undefined where both panels or neither panel holds &divider cells."
      (RULE &key_panel
        (&filled.value (:v *Id)))

      (RULE &field_panel
        (&filled.value (:v *Id0))
        (&panel_component *Id)
        (!= Id Id0)))
    (ALTS $m "how the marker color is found" $MarkerStored
      (ALT $MarkerFromField
        (OUTPUT field-lines "the marker is the field's color other than its commonest color. Undefined where the field holds more or fewer than two colors."
          (INIT &field_ground_count Cardinality
            (key ((&field_cell *P (:Col ^C)))
              (member ((:m P))
                (&field_cell *P (:Col C)))))
          (INIT &field_ground Order
            (member ((:t C))
              (&field_ground_count.size (:key *C)))
            (score ((:t C) (:S N))
              (&field_ground_count.size (:key *C) *N)))
          (INIT &field_mark Singleton
            (member ((:v C))
              (&field_cell (:Col *C))
              (NOT (&field_ground.maximal (:t C)))))
          (RULE &marker4
            (&field_mark.value (:v *C))))))))

(ALTS $v "how the divider color is found" $DividerStored
  (ALT $DividerFromFullLine
    (INPUT two-panels "a full row or column of one color other than the input's commonest color, the divider, splits the input into two panels. Undefined where no such color, or more than one, exists."
      (RULE &divider2
        (&full_line_color.value (:v *C))))))

(ALTS $y "whether the panel layout is read from its stored orientation" $LayoutFree
  (ALT $LayoutStored
    (INPUT two-panels "the divider is a full line of &divider cells along the axis of &key_end.")
    (OUTPUT find-panels "the key is the cells of the key panel nearer its &key_end edge than every line across the panel that holds only &divider cells."
      (RULE &unfilled_split1
        (&key_panel_cell (:P *P_) (:Col *C))
        (axis_of *D (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_))
        (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

      (RULE &filled_line_split1
        (&key_panel_cell (:P *P_))
        (axis_of *D (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B P_) (:D D_m1) (:K *K1_m3))
        (margin (:B P_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_))
        (relative (:Base X_) (:X P_) (:X_rel *X_m1_)))

      ;; The end of the key panel, along the divider, where the key sits.
      (DET &key_end DirDomain)

      (RULE &cut_axis
        (&key_end *D)
        (axis_of D (:A *A2))
        (perp (:A A2) (:A2 *A)))

      (RULE &unfilled
        (&key_panel_cell *P (:Col *C))
        (NOT (&divider2 C))
        (&key_end *D)
        (axis_of D *A)
        (&unfilled_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1)))

      (RULE &filled_line
        (&key_panel_cell *P)
        (&key_end *D)
        (axis_of D *A)
        (&filled_line_split1 (:P_ P) (:A_ A) (:X_ *X) (:X_m1_ *X_m1))
        (NOT (&unfilled X)))

      (RULE &past_fill
        (&key_panel_cell *P)
        (&filled_line *X)
        (&key_end *D)
        (dir_elem D)
        (margin (:B P) D (:K *K1_m1))
        (margin (:B X) D (:K *K2_m2))
        (>= K1_m1 K2_m2))

      (RULE &key_cell
        (&key_panel_cell *P *Col)
        (NOT (&past_fill P))))))

(RULE &output
  (&takes_cell *P *Q)
  (&key (:P Q) *Col))
