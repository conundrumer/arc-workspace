;; 56dc2b01

(RULE &sight_dir
  (dir_elem *D))

(RULE &sight_node
  (input *P))

(DET &mover ChangedColor)

(RULE &mover_cell
  (input *P *Col)
  (&mover (:C Col)))

(RULE &sight_source
  (&mover_cell *P))

;; The anchor lies toward one edge from the mover, on a shared line.
(INIT &sight Distance
  (key ((&sight_source (:P ^O))
        (&sight_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:P O))
           (&sight_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:P Q)))
          ((&sight_source (:P O))
           (&sight_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:P Q))
           (= A2 O))
          ((&sight_source (:P O))
           (&sight_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:P Q)))))
    (source ((:n O))
      (&sight_source (:P O))
      (&sight_dir D))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(DET &bg DominantColor)

(DET &anchor RarestColor)

(DET &back AnyOutNewColor)

(RULE &anchor_cell
  (input *P *Col)
  (&anchor (:C Col)))

(RULE &move_dir
  (dir_elem *D)
  (&sight_ray *P D)
  (&anchor_cell P))

;; The mover travels until it meets the line.
(INIT &gravity Distance
  (source_distance (K)
    (OR ((&mover_cell *P)
         (&move_dir *D)
         (margin (:B P) D *K))
        ((&mover_cell (:P *P3))
         (&move_dir (:D *D2))
         (&anchor_cell (:P *P2))
         (gap (:D D2) (:P P3) (:Q P2) K)))))

(RULE &landed
  (&gravity.distance *K)
  (&move_dir *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (&mover_cell (:P *P3))
  (compose (:A P3) (:B V) (:C *P)))

(INIT &bbox BoundingBox
  (cell (P)
    (&landed *P)))

(RULE &back_line
  (&move_dir *D)
  (opposite D (:Opp *O))
  (&landed (:P *P2))
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (margin (:B P2) (:D O) (:K *K_m1))
  (margin B (:D O) (:K K_m1))
  (step_offset (:D O) (:V *V_m2))
  (compose (:A P2) (:B V_m2) (:C *P_back))
  (input *P)
  (margin (:B P_back) (:D O) (:K *K_m3))
  (margin (:B P) (:D O) (:K K_m3)))

(RULE &cleared
  (OR ((input *P *Col)
       (NOT (&mover_cell P)))
      ((&mover_cell P)
       (&bg (:C Col)))))

(RULE &output
  (OR ((&landed *P)
       (&mover (:C *Col)))
      ((&back_line P)
       (&back (:C Col)))
      ((&cleared P Col)
       (NOT (&landed P))
       (NOT (&back_line P)))))
