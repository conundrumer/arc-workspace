;; ac2e8ecf

(INPUT background "every cell outside the shapes is the background color")

(INPUT single-color-objects "each shape is one 4-connected set of cells of one color; shapes of different colors may touch"

  (DET_OR_RULE &background DominantColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (RULE &shapes8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &shapes8 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&shapes8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P))))))

(INPUT two-kinds "each shape is either a hollow rectangle (a one-cell-thick rectangle outline that closes off an interior of background) or a cross (a horizontal bar and a vertical bar that cross, closing off nothing)")

(OUTPUT kind "a shape that by itself closes off a region from the grid edge, under 4-adjacency, is a rectangle; every other shape is a cross"

  (RULE &shapes4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &shapes4 Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((&ink *P *Col)
           (&shapes4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ink (:P P3) Col))
          ((&ink P Col)
           (= P3 P)))))

  (RULE &shapes4_component
    (&shapes4.class (:a *Key *P) *Id))

  (RULE &own8_steps
    (step_offset (:V *Delta)))

  (RULE &shape
    (&shapes4_component *P (:Id *Sh)))

  (RULE &off_shape
    (&shape *Sh)
    (input *P)
    (NOT (&shape Sh P)))

  (RULE &pockets_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &pockets_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &pockets_cell
    (input *P *Col)
    (&background (:C Col)))

  (INIT &pockets_flood Propagation
    (source ((:n P))
      (&pockets_cell *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (input P *Col)
      (&background (:C Col)))
    (edge ((:a P) (:b P2))
      (input *P *Col)
      (&background (:C Col))
      (&pockets_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *P2))
      (input (:P P2) (:Col *Col2))
      (&background (:C Col2))))

  (RULE &pockets_node
    (&pockets_cell *P)
    (NOT (&pockets_flood.reached (:n P))))

  (INIT &rim Boundary
    (key ((&shape (:Sh ^Id) *P))
      (cell (P)
        (&shape (:Sh Id) *P))))

  ;; The cells the grid edge reaches outside the shape, stepping to any of the
  ;; eight neighbors.
  (INIT &own8 Propagation
    (key ((OR ((&off_shape (:Sh ^Id) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0)))
              ((&off_shape (:Sh Id) P)
               (&own8_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&off_shape (:Sh Id) (:P P2)))))
      (source ((:n P))
        (&off_shape (:Sh Id) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0)))
      (edge ((:a P) (:b P2))
        (&off_shape (:Sh Id) *P)
        (&own8_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&off_shape (:Sh Id) (:P P2)))))

  ;; The regions all the shapes together close off.
  (INIT &pockets Quotient
    (edge ((:a P) (:b P2))
      (OR ((&pockets_node *P)
           (&pockets_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&pockets_node (:P P2)))
          ((&pockets_node P)
           (= P2 P))))))

(OUTPUT rectangles-rise "the rectangles, as rigid objects, fall under Gravity toward closed_dir, with only the other rectangles and the grid edge as obstacles"

  (INIT &box BoundingBox
    (key ((&shape (:Sh ^Id) *P))
      (cell (P)
        (&shape (:Sh Id) *P))))

  (RULE &box_cell
    (&box.box (:key (:Id *Sh)) *B)
    (input *P)
    (ALL ((&box.box (:key (:Id *Shm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))))

(OUTPUT crosses-sink "the crosses, as rigid objects, fall under Gravity toward open_dir, with only the other crosses and the grid edge as obstacles")

(OUTPUT compose "the output is the background with every shape drawn at its settled place; no settled rectangle overlaps a settled cross"

  (RULE &own_flood_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &own_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &own_cell
    (&off_shape (:Sh *Key) *P))

  (INIT &own_flood Propagation
    (key ((OR ((&own_cell (:Key ^Id) *P)
               (dir_elem *D)
               (margin (:B P) D (:K 0))
               (&off_shape (:Sh Id) P))
              ((&off_shape (:Sh Id) P)
               (&own_flood_steps (:Delta *S))
               (compose (:A P) (:B S) (:C *P2))
               (&off_shape (:Sh Id) (:P P2)))))
      (source ((:n P))
        (&own_cell (:Key Id) *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&off_shape (:Sh Id) P))
      (edge ((:a P) (:b P2))
        (&off_shape (:Sh Id) *P)
        (&own_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&off_shape (:Sh Id) (:P P2)))))

  (RULE &own_node
    (&own_cell *Key *P)
    (NOT (&own_flood.reached (:key (:Id Key)) (:n P))))

  ;; The regions the shape closes off by itself.
  (INIT &own Quotient
    (edge ((:a (:Id Ky) P) (:b (:Id Ky) (:P P2)))
      (OR ((&own_node (:Key *Ky) *P)
           (&own_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&own_node (:Key Ky) (:P P2)))
          ((&own_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &own_component
    (&own.class (:a (:Id *Key) *P) *Id))

  ;; The edge the rectangles fall toward.
  (DET &closed_dir DirDomain)

  ;; The edge the crosses fall toward.
  (DET &open_dir DirDomain)

  (RULE &rectangle
    (&own_component (:Key *Sh)))

  (RULE &cross
    (&shape *Sh)
    (NOT (&rectangle Sh)))

  (RULE &rise_body
    (&shape *Sh *P))

  (RULE &sink_body
    (&shape *Sh *P))

  (RULE &sink_dir
    (&open_dir *D))

  (INIT &rise Distance
    (weight ((:a Id2) (:b Id) (:W K2))
      (&rectangle (:Sh *Id))
      (&rise_body (:Sh Id) *P)
      (&closed_dir *D)
      (&rectangle (:Sh *Id2))
      (&rise_body (:Sh Id2) (:P *P2))
      (!= Id Id2)
      (gap D P (:Q P2) (:K *K2)))
    (source_distance ((:n Id) (:K K2))
      (&rectangle (:Sh *Id))
      (&rise_body (:Sh Id) *P)
      (&closed_dir *D)
      (margin (:B P) D (:K *K2))))

  (RULE &rise_dir
    (&closed_dir *D))

  (INIT &sink Distance
    (weight ((:a Id2) (:b Id) (:W K2))
      (&cross (:Sh *Id))
      (&sink_dir)
      (&sink_body (:Sh Id) *P)
      (&rise_dir)
      (&sink_dir *D)
      (&cross (:Sh *Id2))
      (&sink_body (:Sh Id2) (:P *P2))
      (!= Id Id2)
      (gap D P (:Q P2) (:K *K2)))
    (source_distance ((:n Id) (:K K2))
      (&cross (:Sh *Id))
      (&sink_dir)
      (&sink_body (:Sh Id) *P)
      (&rise_dir)
      (&sink_dir *D)
      (margin (:B P) D (:K *K2))))

  (RULE &sink_dir_gravity
    (&rise_dir)
    (&sink_dir *D))

  (RULE &risen
    (&rise.distance (:n *Id) (:K *K_2))
    (&rise_dir *D)
    (dir8_opposite D (:D2 *O_m1))
    (edge_inset (:D O_m1) (:K K_2) (:B *B1_m2))
    (edge_inset D (:K K_2) (:B *I_m4))
    (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *V))
    (&shape (:Sh Id) (:P *P2))
    (input (:P P2) *Col)
    (compose (:A P2) (:B V) (:C *P)))

  (RULE &sunk
    (&sink.distance (:n *Id) (:K *K_2))
    (&sink_dir_gravity *D)
    (dir8_opposite D (:D2 *O_m1))
    (edge_inset (:D O_m1) (:K K_2) (:B *B1_m2))
    (edge_inset D (:K K_2) (:B *I_m4))
    (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *V))
    (&shape (:Sh Id) (:P *P2))
    (input (:P P2) *Col)
    (compose (:A P2) (:B V) (:C *P))))

(ALTS $s "how cells group into shapes" $Components4
  (ALT $Components8
    (INPUT single-color-objects "each shape is one 8-connected set of cells of one color"
      (RULE &shapes8_component
        (&shapes8.class (:a *Key *P) *Id))

      (RULE &shape
        (&shapes8_component *P (:Id *Sh))))))

(ALTS $k "which shapes are rectangles" $OwnClosure
  (ALT $SolidCountsClosed
    (OUTPUT kind "a shape that by itself closes off a region, or that fills its bounding box, is a rectangle"
      (RULE &gap
        (&box_cell *Sh *P)
        (NOT (&shape Sh P)))

      (RULE &rectangle
        (OR ((&own_component (:Key *Sh)))
            ((&shape Sh)
             (NOT (&gap Sh)))))))
  (ALT $CrossingSinks
    (OUTPUT kind "a shape with a cell whose four neighbors all lie in the shape is a cross; every other shape is a rectangle"
      (RULE &rectangle
        (&shape *Sh)
        (ALL ((&shape Sh *P))
             ((&rim.boundary (:key (:Id Sh)) P))))))
  (ALT $ClosedAgainstDiagonal
    (OUTPUT kind "a shape is a rectangle only when its region stays closed off from the grid edge with the background passing between two cells that touch at a corner"
      (RULE &rectangle
        (&off_shape *Sh *P)
        (NOT (&own8.reached (:key (:Id Sh)) (:n P))))))
  (ALT $ClosedInGrid
    (OUTPUT kind "a shape that borders a region that all the shapes together close off from the grid edge is a rectangle"
      (RULE &pockets_component
        (&pockets.class (:a *P) *Id))

      (RULE &rectangle
        (&pockets_component *P)
        (dir_elem *D)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (&shape *Sh (:P Q))))))

(ALTS $o "where the crosses' heading comes from" $OpenStored
  (ALT $OpenDirOpposite
    (OUTPUT crosses-sink "the crosses fall toward the edge opposite closed_dir"
      (RULE &sink_dir
        (&closed_dir (:D *D_closed))
        (opposite (:D D_closed) (:Opp *D))))))

(ALTS $c "what part of a falling shape meets an obstacle" $StackByCells
  (ALT $StackByBbox
    (OUTPUT rectangles-rise "a rectangle stops where its bounding box meets the bounding box of another rectangle"
      (RULE &rise_body
        (&box_cell *Sh *P))

      (RULE &sink_body
        (&box_cell *Sh *P)))
    (OUTPUT crosses-sink "a cross stops where its bounding box meets the bounding box of another cross"))
  (ALT $StackRectanglesByBbox
    (OUTPUT rectangles-rise "a rectangle stops where its bounding box meets the bounding box of another rectangle"
      (RULE &rise_body
        (&box_cell *Sh *P)))))

(ALTS $m "the output where a settled rectangle and a settled cross share a cell" $Apart
  (ALT $RectanglesOnTop
    (OUTPUT compose "where a settled rectangle and a settled cross share a cell, the rectangle's color shows")
    (RULE &output
      (OR ((&risen *P *Col)
           (&sink_dir))
          ((&sunk P Col)
           (NOT (&risen P)))
          ((input P)
           (&background (:C Col))
           (NOT (&risen P))
           (NOT (&sunk P))))))
  (ALT $CrossesOnTop
    (OUTPUT compose "where a settled rectangle and a settled cross share a cell, the cross's color shows")
    (RULE &output
      (OR ((&sunk *P *Col))
          ((&risen P Col)
           (&sink_dir)
           (NOT (&sunk P)))
          ((input P)
           (&background (:C Col))
           (NOT (&risen P))
           (NOT (&sunk P)))))))

(RULE &output
  (OR ((input *P)
       (&background (:C *Col))
       (NOT (&risen P))
       (NOT (&sunk P)))
      ((&risen P Col)
       (&sink_dir)
       (NOT (&sunk P)))
      ((&sunk P Col)
       (NOT (&risen P)))))
