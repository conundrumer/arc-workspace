;; a32d8b75

(INPUT separator "one or more full lines of &sep split the grid into panels. One panel is the field, and each other panel is a legend."

  (DET &trained
    (ex_output *E))

  (DET &dropped
    (&trained *E)
    (ex_input E (:Col *C))
    (NOT (ex_output (:Col C))))

  (DET &dropped_missing
    (&dropped *C)
    (&trained *E)
    (NOT (ex_input E (:Col C))))

  (DET &full_line_split1
    (ex_input *E (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &line_mixed_split1
    (ex_input *E (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &line_mixed_split2
    (ex_input *E (:P *Q_) (:Col *Col2))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X Q_) (:X_rel *X_m2_)))

  (DET &line_mixed
    (ex_input *E *P *Col)
    (axis_elem *A)
    (&line_mixed_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (ex_input E (:P *Q) (:Col *Col2))
    (&line_mixed_split2 (:Q_ Q) (:A_ A) (:L_ L) (:X_m2_ *X_m2))
    (!= Col Col2))

  (DET &full_line
    (ex_input *E *P *Col)
    (axis_elem *A)
    (&full_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (NOT (&line_mixed E A L Col)))

  (DET &sep_missing
    (&dropped *C)
    (&trained *E)
    (NOT (&full_line E (:Col C))))

  (DET &sep
    (&dropped *C)
    (NOT (&dropped_missing C))
    (NOT (&sep_missing C))))

(INPUT field "the field is the one panel that holds no &sep cell")

(INPUT legend "a legend holds four parts on a &bg ground. A framed box is a square of &box_side cells on a side, closed off by &sep or by the grid edge. - a pattern: a rectangle filled with exactly two colors - a mask: a shape of one color, apart from the pattern - an anchor box: a framed box with one &anchor cell at a corner and &bg elsewhere - an arrow box: a framed box with &arrow at its center and at one edge-neighbor of the center, and &bg elsewhere"

  (DET &cell
    (&trained *E)
    (ex_input E *P *Col))

  (DET &line_break_split12
    (&cell (:E *Ky) (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &line_break2
    (&cell *E *P *Col)
    (NOT (&sep (:C Col)))
    (axis_elem *A)
    (&line_break_split12 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

  (DET &separator_split12
    (&cell (:E *Ky) (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (DET &separator2
    (&cell *E *P)
    (axis_elem *A)
    (&separator_split12 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (NOT (&line_break2 E A L)))

  (DET &panels_divider2
    (&separator2 *E *A *L))

  (DET &panels_on_divider2
    (&cell *E *P)
    (&panels_divider2 E *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  (INIT &panels_rank2 Order
    (key ((OR ((&panels_divider2 (:E ^Ky) *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((&cell (:E Ky) *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&panels_divider2 (:E Ky) *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&panels_divider2 (:E Ky) *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((&cell (:E Ky) *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (&cell (:E Ky) *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (DET &panels_part_idx2
    (&cell *E *P)
    (axis_of *D *A)
    (NOT (&panels_on_divider2 E P A))
    (margin (:B P) D *K)
    (&panels_rank2.rank (:key (:Ky E) D) (:t K) (:R *N)))

  (DET &panels_part_of2
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&panels_part_idx2 *E *P D (:N *N1))
    (&panels_part_idx2 E P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (DET &panels_tile_of2
    (&panels_part_of2 *E *P *A (:P_part *P1))
    (perp A *A2)
    (&panels_part_of2 E P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (DET &panel_cell2
    (&panels_tile_of2 *E *P (:P_tile *Pl))
    (&cell E P *Col))

  (DET &sep_panel2
    (&panel_cell2 *E *Pl *Col)
    (&sep (:C Col)))

  (DET &legend2
    (&sep_panel2 *E *Pl))

  (DET &legend_cell2
    (&legend2 *E *Pl)
    (&panel_cell2 E Pl *P *Col)
    (NOT (&sep (:C Col))))

  (RULE &region_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The regions of a legend that &sep closes off.
  (INIT &region2 Quotient
    (edge ((:a Ky Pl P) (:b Ky Pl (:P P3)))
      (OR ((&legend_cell2 (:E *Ky) *Pl *P)
           (&region_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&legend_cell2 (:E Ky) Pl (:P P3)))
          ((&legend_cell2 (:E Ky) Pl P)
           (= P3 P)))))

  (DET &region_component2
    (&region2.class (:a *Ky *Pl *P) *Id))

  (INIT &region_box2 BoundingBox
    (key ((&region_component2 ^Ky *P ^Id))
      (cell (P)
        (&region_component2 Ky *P Id))))

  (DET &region_gap_inside12
    (&panel_cell2 (:E *Ky) *Pl (:P *P_))
    (&region_box2.box (:key Ky *Id) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET &region_gap2
    (&region_component2 (:Ky *E) *Pl *Id)
    (&region_box2.box (:key (:Ky E) Id) *B)
    (&panel_cell2 E Pl *P)
    (NOT (&region_gap_inside12 (:P_ P) (:B_ B)))
    (NOT (&region_component2 (:Ky E) Pl P Id)))

  (DET &square
    (&region_component2 (:Ky *E) *P *Id)
    (&region_box2.box (:key (:Ky E) Id) *B)
    (NOT (&region_gap2 E Id))
    (axis_elem *A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (perp A *A2)
    (axis_elem (:A A2))
    (relative (:Base B) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) N))

  (DET &box_side_missing
    (&square *N)
    (&trained *E)
    (NOT (&square E N)))

  (DET &box_side
    (&square (:N *K))
    (NOT (&box_side_missing (:N K))))

  (DET &off_side2
    (&region_component2 (:Ky *E) *P *Id)
    (&region_box2.box (:key (:Ky E) Id) *B)
    (axis_elem *A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N)
    (NOT (&box_side (:K N))))

  (DET &framed2
    (&region_component2 (:Ky *E) *Pl *Id)
    (&region_box2.box (:key (:Ky E) Id) *B)
    (NOT (&region_gap2 E Id))
    (NOT (&off_side2 E Id)))

  (DET &box_ink_inside12
    (&panel_cell2 (:E *Ky) *Pl (:P *P_) *Col)
    (&framed2 (:E Ky) Pl (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET &bg
    (&dropped *C)
    (NOT (&dropped_missing C))
    (NOT (&sep C)))

  (DET &box_ink2
    (&framed2 *E *Pl *B)
    (&panel_cell2 E Pl *P *Col)
    (NOT (&box_ink_inside12 (:P_ P) (:B_ B)))
    (NOT (&bg (:C Col))))

  (DET &arrow_cand_inside12
    (&box_ink2 (:E *Ky) (:B *B_) (:P *P_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (DET &arrow_cand_centered12
    (&box_ink2 (:E *Ky) *B *P)
    (relative (:Base B) (:X P) (:X_rel *S_))
    (opposite (:D *D_m1) (:Opp *O_m2))
    (margin (:B S_) (:D D_m1) (:K *K1_m3))
    (margin (:B S_) (:D O_m2) (:K *K2_m4))
    (!= K1_m3 K2_m4))

  (DET &anchor_cand_inside12
    (&box_ink2 (:E *Ky) (:B *B_) (:P *P_) *Col)
    (&framed2 (:E Ky) *Pl (:B B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &line_break_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &separator_split1
    (input (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (RULE &separator
    (input *P)
    (axis_elem *A)
    (&separator_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
    (ALL ((input (:P *Pm) *Col)
          (&line_break_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
         ((&sep (:C Col)))))

  (RULE &panels_divider
    (&separator *A *L))

  (RULE &panels_on_divider
    (input *P)
    (&panels_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  (INIT &panels_rank Order
    (key ((OR ((&panels_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&panels_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&panels_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &panels_part_idx
    (input *P)
    (axis_of *D *A)
    (NOT (&panels_on_divider P A))
    (margin (:B P) D *K)
    (&panels_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &panels_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&panels_part_idx *P D (:N *N1))
    (&panels_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE &panels_tile_of
    (&panels_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&panels_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (RULE &panel_cell
    (&panels_tile_of *P (:P_tile *Pl))
    (input P *Col))

  (RULE &sep_panel
    (&panel_cell *Pl *Col)
    (&sep (:C Col)))

  (RULE &legend
    (&sep_panel *Pl))

  (RULE &legend_cell
    (&legend *Pl)
    (&panel_cell Pl *P *Col)
    (NOT (&sep (:C Col))))

  ;; The regions of a legend that &sep closes off.
  (INIT &region Quotient
    (edge ((:a Pl P) (:b Pl (:P P3)))
      (OR ((&legend_cell *Pl *P)
           (&region_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&legend_cell Pl (:P P3)))
          ((&legend_cell Pl P)
           (= P3 P)))))

  (RULE &region_component
    (&region.class (:a (:Pl *Key) *P) *Id))

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &region_box BoundingBox
    (key ((&region_component *P ^Id))
      (cell (P)
        (&region_component *P Id))))

  (RULE &region_gap
    (&region_component (:Key *Pl) *Id)
    (&region_box.box (:key Id) *B)
    (&panel_cell Pl *P)
    (ALL ((&panel_cell (:Pl *Plm) P)
          (&region_box.box (:key (:Id *Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&region_component (:Key Pl) P Id)))

  (RULE &framed
    (&region_component (:Key *Pl) *Id)
    (&region_box.box (:key Id) *B)
    (NOT (&region_gap Id))
    (ALL ((&region_component *P Id)
          (&region_box.box (:key Id) (:B *Bm))
          (axis_elem *A)
          (relative (:Base Bm) (:X P) (:X_rel *R_m1))
          (frame_extent (:P R_m1) A *N))
         ((&box_side (:K N)))))

  (RULE &in_box_inside1
    (&panel_cell *Pl (:P *P_))
    (&framed Pl (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &ground_ink
    (&legend_cell *Pl *P *Col)
    (NOT (&bg (:C Col)))
    (ALL ((&framed (:Pl *Plm) *B)
          (&panel_cell (:Pl Plm) P))
         ((&in_box_inside1 (:P_ P) (:B_ B)))))

  (INIT &piece Quotient
    (edge ((:a Pl P) (:b Pl (:P P3)))
      (OR ((&ground_ink *Pl *P)
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&ground_ink Pl (:P P3)))
          ((&ground_ink Pl P)
           (= P3 P)))))

  (RULE &piece_component
    (&piece.class (:a (:Pl *Key) *P) *Id))

  (INIT &piece_box BoundingBox
    (key ((&piece_component *P ^Id))
      (cell (P)
        (&piece_component *P Id))))

  (RULE &piece_color
    (&piece_component (:Key *Pl) *P *Id)
    (&ground_ink Pl P *Col))

  (RULE &source_piece
    (&piece_component (:Key *Pl) *Id)
    (&piece_color Id (:Col *C1))
    (&piece_color Id (:Col *C2))
    (!= C1 C2))

  (RULE &source
    (&source_piece *Pl *Id)
    (&piece_box.box (:key Id) *B)
    (&piece_component (:Key Pl) *P Id)
    (&ground_ink Pl P *Col)
    (ALL ((&piece_component (:Key *Plm) P (:Id *Idm))
          (&piece_box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *T)))

  (RULE &pattern_color
    (&source *Pl *Col)
    (NOT (&bg (:C Col))))

  (INIT &mask_color_count Cardinality
    (key ((&source_piece ^Pl)
          (&ground_ink Pl *P ^Col)
          (NOT (&pattern_color Pl Col)))
      (member ((:m P))
        (&source_piece Pl)
        (&ground_ink Pl *P Col)
        (NOT (&pattern_color Pl Col)))))

  (DET &arrow_cand2
    (&box_ink2 *E *B *P)
    (NOT (&arrow_cand_inside12 (:P_ P) (:B_ B)))
    (relative (:Base B) (:X P) (:X_rel *S))
    (NOT (&arrow_cand_centered12 (:S_ S)))
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&box_ink2 E B (:P Q)))

  (DET &arrow_extra2
    (&arrow_cand2 *E *B *P *Q)
    (&box_ink2 E B (:P *R))
    (!= R P)
    (!= R Q))

  (DET &arrow_pair2
    (&framed2 *E *Pl *B)
    (&arrow_cand2 E B *P *D *Q)
    (&box_ink2 E B P *Col)
    (&box_ink2 E B (:P Q) Col)
    (NOT (&arrow_extra2 E B P Q)))

  (DET &arrow_in
    (&arrow_pair2 *E *Col))

  (DET &arrow_missing
    (&arrow_in *Col)
    (&trained *E)
    (NOT (&arrow_in E Col)))

  (DET &arrow
    (&arrow_in (:Col *C))
    (NOT (&arrow_missing (:Col C))))

  (RULE &box_ink
    (&framed *Pl *B)
    (&panel_cell Pl *P *Col)
    (ALL ((&panel_cell (:Pl *Plm) P (:Col *Colm))
          (&framed (:Pl Plm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (NOT (&bg (:C Col))))

  ;; The reading order: the corner it starts from, and the axis it runs along first.
  (DET &reading_corner DiagDirDomain)

  (DET &reading_axis AxisDomain)

  (DET &box_other_ink2
    (&box_ink2 *E *B *P)
    (&box_ink2 E B (:P *Q))
    (!= P Q))

  (DET &anchor_cand2
    (&framed2 *E *Pl *B)
    (&box_ink2 E B *P *Col)
    (NOT (&anchor_cand_inside12 (:P_ P) (:B_ B)))
    (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
    (perp (:A A_m1) (:A2 *A2_m3))
    (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
    (margin (:B P) (:D D1_m2) (:K *K1_m5))
    (margin B (:D D1_m2) (:K K1_m5))
    (margin (:B P) (:D D2_m4) (:K *K2_m6))
    (margin B (:D D2_m4) (:K K2_m6))
    (NOT (&box_other_ink2 E B P)))

  (DET &anchor_in
    (&anchor_cand2 *E *Col))

  (DET &anchor_missing
    (&anchor_in *Col)
    (&trained *E)
    (NOT (&anchor_in E Col)))

  (DET &anchor
    (&anchor_in (:Col *C))
    (NOT (&anchor_missing (:Col C))))

  (RULE &reading_corner2
    (&reading_corner (:D *C)))

  (RULE &box_start
    (&framed *Pl *B)
    (&reading_corner2 *C)
    (&panel_cell Pl *P)
    (ALL ((&panel_cell (:Pl *Plm) P)
          (&framed (:Pl Plm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (ALL ((&reading_corner2 C)
          (&panel_cell (:Pl *Plmm) P)
          (&framed (:Pl Plmm) B)
          (corner_dir C (:D *D_m1m))
          (margin (:B P) (:D D_m1m) (:K *K1_m2))
          (margin B (:D D_m1m) (:K *K2_m3)))
         ((= K1_m2 K2_m3))))

  (INIT &box_order Order
    (key ((&box_start ^Pl ^C *P))
      (member ((:t P))
        (&box_start Pl C *P))
      (before ((:a P) (:b P2))
        (&box_start Pl C *P)
        (&box_start Pl C (:P *P2))
        (&box_start Pl C)
        (&reading_axis *A)
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  (RULE &first_box
    (&box_order.minimal (:key *Pl *C) (:t *P))
    (&box_start Pl *B C P))

  (INIT &ink_order Order
    (key ((&first_box ^C ^B))
      (member ((:t P))
        (&box_ink B *P))
      (before ((:a P) (:b P2))
        (&box_ink B *P)
        (&box_ink B (:P *P2))
        (&reading_axis *A)
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  (RULE &piece_start
    (&piece_box.box (:key *Id) *B)
    (&reading_corner2 *C)
    (&panel_cell *Pl *P)
    (ALL ((&panel_cell (:Pl *Plm) P)
          (&piece_box.box (:key (:Id *Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (ALL ((&reading_corner2 C)
          (&panel_cell (:Pl *Plmm) P)
          (&piece_box.box (:key (:Id *Idmm)) B)
          (corner_dir C (:D *D_m1m))
          (margin (:B P) (:D D_m1m) (:K *K1_m2))
          (margin B (:D D_m1m) (:K *K2_m3)))
         ((= K1_m2 K2_m3))))

  (INIT &piece_order Order
    (key ((&piece_start ^Pl ^C *P))
      (member ((:t P))
        (&piece_start Pl C *P))
      (before ((:a P) (:b P2))
        (&piece_start Pl C *P)
        (&piece_start Pl C (:P *P2))
        (&piece_start Pl C)
        (&reading_axis *A)
        (OR ((corner_dir C A *D)
             (dir_elem D)
             (margin (:B P) D (:K *K1_m1))
             (margin (:B P2) D (:K *K2_m2))
             (< K1_m1 K2_m2))
            ((corner_dir C A D)
             (perp A (:A2 *A2_m3))
             (corner_dir C (:A A2_m3) (:D *D2))
             (margin (:B P) D (:K *K_m4))
             (margin (:B P2) D (:K K_m4))
             (dir_elem (:D D2))
             (margin (:B P) (:D D2) (:K *K1_m5))
             (margin (:B P2) (:D D2) (:K *K2_m6))
             (< K1_m5 K2_m6))))))

  (INIT &mask_color Order
    (key ((&mask_color_count.size (:key ^Pl *Col)))
      (member ((:t Col))
        (&mask_color_count.size (:key Pl *Col)))
      (score ((:t Col) (:S N))
        (&mask_color_count.size (:key Pl *Col) *N)))))

(INPUT order "in each legend the pattern stands above the mask, and the anchor box above the arrow box")

(INPUT legend-left "a legend stands left of the field")

(INPUT mask-color "the mask color is not a pattern color")

(OUTPUT crop "the output is the field, with its size and content, before the stamps"

  (RULE &field_cell
    (&panel_cell *Pl *P)
    (NOT (&sep_panel Pl)))

  (INIT &field_box BoundingBox
    (cell (P)
      (&field_cell *P))))

(OUTPUT orient "the mask's bounding box, read as a set of cells, turns by the rotation that takes &ref_dir onto the arrow direction, from the center arrow cell to the other one"

  (RULE &mask_cell
    (&source_piece *Pl *Id)
    (&ground_ink Pl *P)
    (NOT (&piece_component (:Key Pl) P Id)))

  (INIT &mask_box BoundingBox
    (key ((&mask_cell ^Pl *P))
      (cell (P)
        (&mask_cell Pl *P))))

  ;; The arrow direction at which the mask does not turn.
  (DET &ref_dir DirDomain))

(OUTPUT scale "each cell of the turned mask becomes a block the size of the pattern")

(OUTPUT anchor "the blocks are placed flush with the field corner that is the corner of the anchor cell in its box, and cut at the field edge")

(OUTPUT swap "the stamp is the pattern with its two colors exchanged. The stamp does not turn.")

(OUTPUT stamp "each block at a mask cell takes the stamp, and every other field cell keeps its color. Each legend stamps its own mask on the same field. Where two stamps overlap, the later one in &stamp_order shows."

  (RULE &arrow_cand
    (&box_ink *B *P)
    (ALL ((&box_ink B P)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *S))
    (ALL ((&box_ink (:B *Bm) (:P *Pm))
          (relative (:Base Bm) (:X Pm) (:X_rel S))
          (opposite (:D *D_m1m) (:Opp *O_m2))
          (margin (:B S) (:D D_m1m) (:K *K1_m3))
          (margin (:B S) (:D O_m2) (:K *K2_m4)))
         ((= K1_m3 K2_m4)))
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&box_ink B (:P Q)))

  (RULE &arrow_pair
    (&framed *Pl *B)
    (&arrow_cand B *P *D *Q)
    (&box_ink B P *Col)
    (&box_ink B (:P Q) Col)
    (ALL ((&box_ink B (:P *R))
          (!= R P))
         ((= R Q))))

  ;; The side whose legend stamps first, so that the later stamp shows where two stamps overlap. No pair has overlapping stamps, so both sides stay open.
  ;; TODO no-det-plan: &stamp_order: the plan gives no verdict
  (DET &stamp_order (ONE))

  (RULE &anchor_cand
    (&framed *Pl *B)
    (&box_ink B *P *Col)
    (ALL ((&box_ink B P (:Col *Colm))
          (&framed (:Pl *Plm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
    (perp (:A A_m1) (:A2 *A2_m3))
    (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
    (margin (:B P) (:D D1_m2) (:K *K1_m5))
    (margin B (:D D1_m2) (:K K1_m5))
    (margin (:B P) (:D D2_m4) (:K *K2_m6))
    (margin B (:D D2_m4) (:K K2_m6))
    (ALL ((&box_ink B (:P *Q)))
         ((= P Q))))

  (RULE &pattern_many
    (&pattern_color *Pl (:Col *C1))
    (&pattern_color Pl (:Col *C2))
    (&pattern_color Pl (:Col *C3))
    (!= C1 C2)
    (!= C1 C3)
    (!= C2 C3))

  (RULE &swapped
    (&pattern_color *Pl *Col)
    (&pattern_color Pl (:Col *Col2))
    (!= Col Col2)
    (NOT (&pattern_many Pl))))

(ALTS $arrow "how the arrow box is found" $ArrowColor
  (ALT $ArrowByShape
    (INPUT legend "the arrow box is the framed box with two cells of one color, any color, at its center and at one edge-neighbor of the center. Undefined where no framed box has that shape.")
    (RULE &arrow_dir
      (&arrow_pair *Pl *D))))

(ALTS $pattern "how the pattern is found" $PatternRect
  (ALT $StampFirst
    (INPUT legend "the pattern is the bounding-box subgrid of the first piece in reading order, and the mask is every other piece outside the framed boxes"
      (RULE &source_piece
        (&piece_order.minimal (:key *Pl *C) (:t *P))
        (&piece_start Pl *Id C P))

      (RULE &source
        (&source_piece *Pl *Id)
        (&piece_box.box (:key Id) *B)
        (&panel_cell Pl *P *Col)
        (ALL ((&panel_cell (:Pl *Plm) P (:Col *Colm))
              (&piece_box.box (:key (:Id *Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (relative (:Base B) (:X P) (:X_rel *T))))
    (OUTPUT swap "a stamp with exactly two colors other than &bg is swapped, and any other stamp is kept as it is")
    (RULE &stamp_color
      (OR ((&source *Pl *T *Col)
           (NOT (&bg (:C Col)))
           (NOT (&swapped Pl)))
          ((&source Pl T (:Col *C))
           (&swapped Pl (:Col C) (:Col2 Col)))
          ((&source Pl T Col)
           (&bg (:C Col)))))))

(ALTS $mask "how the mask is found" $MaskShape
  (ALT $MaskByColor
    (INPUT legend "the mask is every cell outside the framed boxes of the most common color that is not a pattern color. With no such color, the legend stamps nothing."
      (RULE &mask_cell
        (&mask_color.maximal (:key *Pl) (:t *Col))
        (&ground_ink Pl *P Col)))))

(ALTS $anchor "how the anchor box is found" $AnchorColor
  (ALT $AnchorByPosition
    (INPUT legend "the anchor box is the first framed box in reading order. Its first non-&bg cell in reading order, of any color, gives the corner when it is at a corner, and the corner the reading starts from otherwise. Undefined where the legend has no framed box."
      (RULE &first_at_corner
        (&ink_order.minimal (:key *B *C) (:t *P))
        (ALL ((&ink_order.minimal (:key B (:C *Cm)) (:t P))
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
        (margin (:B P) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B P) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6))))
    (RULE &anchor_corner
      (&first_box *Pl *C *B)
      (OR ((&first_at_corner B C *Diag))
          ((NOT (&first_at_corner B C))
           (= Diag C)))))
  (ALT $AnchorByShape
    (INPUT legend "the anchor box is the framed box with one non-&bg cell, of any color, at a corner. Undefined where no framed box has that shape.")
    (RULE &anchor_corner
      (&anchor_cand *Pl *Diag))))

(ALTS $field "how the field and the legends are found" $NoSepPanel
  (ALT $FieldByPosition
    (INPUT field "with one separator, the legend is the panel on the &legend_side of it and the field is the panel past it. With two or more, the two end panels are legends and the field lies between them. Undefined where a panel taken as a legend holds no legend."
      (DET &two_separators2
        (&separator2 *E *A (:L *L1))
        (&separator2 E A (:L *L2))
        (!= L1 L2))

      (RULE &two_separators
        (&separator *A (:L *L1))
        (&separator A (:L *L2))
        (!= L1 L2))

      (DET &side2
        (&separator2 *E *A)
        (axis_of *D A))

      (DET &legend_end
        (&side2 *E *D)
        (&panels_part_idx2 E *P D (:N 0))
        (&panels_tile_of2 E P (:P_tile *Pl))
        (&sep_panel2 E Pl))

      (DET &legend_side_missing
        (&legend_end *D)
        (&trained *E)
        (NOT (&legend_end E D)))

      (DET &legend_side
        (&legend_end *D)
        (NOT (&legend_side_missing D)))

      (DET &legend2
        (&legend_side *D)
        (&panel_cell2 *E *Pl *P)
        (OR ((&panels_part_idx2 E P D (:N 0)))
            ((axis_of D *A)
             (&two_separators2 E A)
             (opposite D (:Opp *D2))
             (&panels_part_idx2 E P (:D D2) (:N 0)))))

      (RULE &legend
        (&legend_side *D)
        (&panel_cell *Pl *P)
        (OR ((&panels_part_idx P D (:N 0)))
            ((axis_of D *A)
             (&two_separators A)
             (opposite D (:Opp *D2))
             (&panels_part_idx P (:D D2) (:N 0)))))

      (RULE &separator_toward
        (input *P)
        (axis_of *D *A)
        (&separator A *L)
        (dir_elem D)
        (margin (:B L) D (:K *K1_m1))
        (margin (:B P) D (:K *K2_m2))
        (< K1_m1 K2_m2))

      (RULE &field_cell
        (&legend_side *D)
        (axis_of D *A)
        (opposite D (:Opp *D2))
        (&separator_toward *P D)
        (OR ((NOT (&two_separators A)))
            ((&two_separators A)
             (&separator_toward P (:D D2))))))))

(RULE &arrow_dir
  (&arrow_pair *Pl *D *Col)
  (&arrow (:C Col)))

(RULE &mask_turn
  (&arrow_dir *Pl *D)
  (&ref_dir (:D *D0))
  (c4_elem (:D *G))
  (d4_elem (:D G))
  (dir_elem (:D D0))
  (dir_elem D)
  (step_offset (:D D0) (:V *S_m1))
  (apply (:D G) (:P S_m1) (:P_out *S2_m2))
  (step_offset D (:V S2_m2)))

(RULE &stamp_frame
  (&source_piece *Pl *Id)
  (&piece_box.box (:key Id) *B)
  (&panel_cell Pl *P)
  (ALL ((&panel_cell (:Pl *Plm) P)
        (&piece_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *T)))

(INIT &scaled_tiling Tiling
  (outer ((:P Q))
    (&mask_cell *Pl *P)
    (&mask_box.box (:key Pl) *B)
    (ALL ((&mask_cell (:Pl *Plm) P)
          (&mask_box.box (:key (:Pl Plm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *S))
    (&mask_turn Pl *G)
    (apply (:D G) (:P S) (:P_out *Q)))
  (inner ((:P T))
    (&stamp_frame *T)))

(RULE &field_at
  (&field_cell *P)
  (input P *Col)
  (&field_box.box *B)
  (ALL ((&field_cell P)
        (&field_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &anchor_corner
  (&anchor_cand *Pl *Diag *Col)
  (&anchor (:C Col)))

(RULE &stamp_color
  (OR ((&source *Pl *T (:Col *C))
       (&swapped Pl (:Col C) (:Col2 *Col)))
      ((&source Pl T Col)
       (&bg (:C Col)))))

(RULE &case)

(RULE &scaled
  (&case)
  (&legend *Pl)
  (&mask_cell Pl *P)
  (&mask_box.box (:key Pl) *B)
  (ALL ((&mask_cell (:Pl *Plm) P)
        (&mask_box.box (:key (:Pl Plm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *S))
  (&mask_turn Pl *G)
  (apply (:D G) (:P S) (:P_out *Q))
  (&stamp_frame Pl *T)
  (&scaled_tiling.cell (:P_outer Q) (:P_inner T) (:P *P_s)))

(RULE &cover
  (&scaled *Pl *T *P_s)
  (&anchor_corner Pl *Diag)
  (corner_dir (:C Diag) (:A *Ax) (:D *D1_m1))
  (perp (:A Ax) (:A2 *A2_m3))
  (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m2))
  (margin (:B P_s) (:D D1_m1) (:K *K1))
  (margin (:B P_s) (:D D2_m2) (:K *K2))
  (&field_at *P_inner)
  (corner_dir (:C Diag) (:A Ax) (:D *D1_m4))
  (perp (:A Ax) (:A2 *A2_m6))
  (corner_dir (:C Diag) (:A A2_m6) (:D *D2_m5))
  (margin (:B P_inner) (:D D1_m4) (:K K1))
  (margin (:B P_inner) (:D D2_m5) (:K K2)))

(RULE &hidden
  (&cover *Pl *P_inner)
  (opposite *D (:Opp *D2))
  (&cover (:Pl *Pl2) P_inner)
  (dir_elem (:D D2))
  (margin (:B Pl2) (:D D2) (:K *K1_m1))
  (margin (:B Pl) (:D D2) (:K *K2_m2))
  (< K1_m1 K2_m2))

(RULE &ready
  (&case)
  (&legend *Pl)
  (&mask_turn Pl)
  (&anchor_corner Pl)
  (&stamp_frame Pl))

(RULE &unready
  (&case)
  (&legend *Pl)
  (NOT (&ready Pl)))

(RULE &side
  (&separator *A)
  (axis_of *D A))

(RULE &shown
  (OR ((&side *D)
       (&cover *Pl *T *P_inner)
       (NOT (&hidden D Pl P_inner))
       (&stamp_color Pl T *Col)
       (NOT (&unready)))
      ((&side D)
       (&case)
       (&field_at P_inner Col)
       (NOT (&cover P_inner))
       (NOT (&unready)))))

(RULE &output
  (&stamp_order *D)
  (&shown D (:P_inner *P) *Col))

(DET &concept)
