;; 234bbc79

;; The chain runs toward this edge; the piece at the near end stays put.
(DET &chain_dir DirDomain)

(DET &bg DominantColor)

(RULE &inked_line_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &inked_line
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&chain_dir *D)
  (axis_of D *A)
  (&inked_line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(INIT &packed Order
  (key ((axis_of (:D ^D2) ^A))
    (member ((:t L))
      (&inked_line *L)
      (&chain_dir *D)
      (axis_of D A))
    (before ((:a L) (:b L2))
      (&inked_line *L)
      (&inked_line (:L *L2))
      (!= L L2)
      (&chain_dir *D)
      (axis_of D A)
      (margin (:B L) (:D D2) (:K *K1))
      (margin (:B L2) (:D D2) (:K *K2))
      (< K1 K2))))

(RULE &packed_pos
  (&packed.rank (:key *A (:D2 *D)) (:t *M) (:R *R1))
  (&packed.dual_rank (:key A (:D2 D)) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &joint VanishedColor)

(RULE &obj_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key)))
  (NOT (&joint (:C Key))))

(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

(RULE &packed_axis
  (&chain_dir *D)
  (axis_of D *A))

(RULE &remap_split1
  (input (:P *P_))
  (&packed_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *Across_)))

(RULE &joint_of
  (input *P *Col)
  (&joint (:C Col))
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&obj_component (:P Q) *Id))

(RULE &remap
  (input (:P *P_grid))
  (&packed_axis *A)
  (&remap_split1 (:P_ P_grid) (:A_ A) (:L_ *L) (:Across_ *Across))
  (&packed_pos (:M L) (:P_pos *L_pack))
  (compose (:A L_pack) (:B Across) (:C *P_pack)))

(RULE &piece_joint
  (&joint_of *Id *P)
  (&remap (:P_grid P) *P_pack))

(RULE &piece_cell
  (OR ((&obj_component *P *Id)
       (&remap (:P_grid P) *P_pack))
      ((&piece_joint Id P_pack))))

;; A piece leads with the joint furthest along the chain and trails with the
;; joint furthest back. An end piece carries one joint and does both with it.
(INIT &ends Order
  (key ((&piece_joint ^Id *P_pack)
        (&chain_dir *D)
        (opposite D (:Opp *D_back))
        (margin (:B P_pack) (:D D_back) *K))
    (member ((:t (:V P_pack) (:S K)))
      (&piece_joint Id *P_pack)
      (&chain_dir *D)
      (opposite D (:Opp *D_back))
      (margin (:B P_pack) (:D D_back) *K))
    (score ((:t (:V P_pack) (:S K)) (:S K))
      (&piece_joint Id *P_pack)
      (&chain_dir *D)
      (opposite D (:Opp *D_back))
      (margin (:B P_pack) (:D D_back) *K))))

(RULE &lead_joint
  (&ends.maximal (:key *Id) (:t (:V *P_pack))))

(RULE &trail_joint
  (&ends.minimal (:key *Id) (:t (:V *P_pack))))

(RULE &link
  (&lead_joint *Id (:P_pack *P_lead))
  (&chain_dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_lead) (:B V_m1) (:C *P_next))
  (&trail_joint (:Id *Id2) (:P_pack *P_trail))
  (margin (:B P_next) D (:K *K_m2))
  (margin (:B P_trail) D (:K K_m2)))

;; Where each piece's trailing joint ends up, walked down the chain from the
;; piece with nothing linking into it, which keeps its place. Once a piece is
;; set down, the piece it links to sets its trailing joint beside the joint
;; the first one leads with.
(INIT &chain Propagation
  (source ((:n Id (:P_dest P)))
    (&trail_joint *Id (:P_pack *P))
    (NOT (&link (:Id2 Id))))
  (edge ((:a Id P_dest) (:b (:Id Id2) (:P_dest P_dest2)))
    (&link *Id *Id2)
    (&remap (:P_pack *P_dest))
    (&trail_joint Id *P_pack)
    (relative (:Base P_pack) (:X P_dest) (:X_rel *Delta))
    (&lead_joint Id (:P_pack *P_lead))
    (compose (:A P_lead) (:B Delta) (:C *P_lead_dest))
    (&chain_dir *D)
    (step_offset D (:V *V_m1))
    (compose (:A P_lead_dest) (:B V_m1) (:C *P_dest2))))

(RULE &slide
  (&trail_joint *Id *P_pack)
  (&chain.reached (:n Id *P_dest))
  (relative (:Base P_pack) (:X P_dest) (:X_rel *Delta)))

(RULE &place
  (&slide *Id *Delta)
  (&piece_cell Id *P_pack)
  (compose (:A P_pack) (:B Delta) (:C *P_dest)))

(RULE &output
  (OR ((&place *Id (:P_dest *P))
       (&obj_component (:Key *Col) Id))
      ((&remap (:P_pack P))
       (NOT (&place (:P_dest P)))
       (&bg (:C Col)))))
