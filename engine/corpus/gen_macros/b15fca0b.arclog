;; b15fca0b

(INPUT two-endpoints "the input holds exactly two cells of endpoint_color")

(INPUT walls "every other cell that is not background is a wall cell of color 1")

(INPUT connected "the two endpoints are joined by a 4-adjacent walk whose inner cells are all background")

(INPUT unique-shortest "exactly one such walk has the fewest steps")

(OUTPUT copy "every cell keeps its input color unless a rule below paints it")

(OUTPUT shortest-path "each inner cell of the shortest 4-adjacent walk from one endpoint to the other, through background cells only, takes path_color"

  (DET_OR_RULE &endpoint_color RarestColor)

  (DET_OR_RULE &background DominantColor)

  (RULE &way)

  (RULE &end
    (input *P *Col)
    (&endpoint_color Col))

  (RULE &pair
    (&end (:P *A))
    (&end (:P *B))
    (!= A B))

  (RULE &crowded
    (&pair *A *B)
    (&end (:P *C))
    (!= C A)
    (!= C B))

  (RULE &open
    (input *P *Col)
    (&background Col))

  ;; A step to a neighbor, from a cell the walk may cross or from a.
  (RULE &link
    (&way)
    (&pair *A *B)
    (OR ((&open (:P *V_x)))
        ((= V_x A)))
    (dir_elem (:D *V_d))
    (dir_elem (:D *V2_d))
    (step_offset (:D V2_d) (:V *V_m1))
    (compose (:A V_x) (:B V_m1) (:C *V2_x))
    (OR ((&open (:P V2_x)))
        ((&end (:P V2_x)))))

  ;; The fewest steps from a to each visit.
  (INIT &steps Distance
    (key ((OR ((&link ^A ^B *V_x *V_d *V2_x *V2_d))
              ((&way)
               (&pair A B)
               (dir_elem *D))))
      (edge ((:a (:X V_x) (:D V_d)) (:b (:X V2_x) (:D V2_d)))
        (&link A B *V_x *V_d *V2_x *V2_d))
      (source ((:n (:X A) D))
        (&way)
        (&pair A B)
        (dir_elem *D))))

  ;; The fewest steps from a to b.
  (INIT &arrival Order
    (key ((&steps.distance (:key ^A ^B) (:n (:X B)) (:K *N)))
      (member ((:t N))
        (&steps.distance (:n (:X B)) (:K *N)))
      (score ((:t N) (:S N))
        (&steps.distance (:n (:X B)) (:K *N)))))

  ;; The visits of every fewest-step walk from a to b, traced back from b.
  (INIT &back Propagation
    (key ((OR ((&arrival.minimal (:key ^A ^B) (:t *N))
               (&steps.distance (:key A B) (:n (:X B) *D) (:K N)))
              ((&steps.predecessor (:key A B) (:b (:X *V2_x) (:D *V2_d)) (:a (:X *V_x) (:D *V_d))))))
      (source ((:n (:X B) D))
        (&arrival.minimal (:t *N))
        (&steps.distance (:n (:X B) *D) (:K N)))
      (edge ((:a (:X V2_x) (:D V2_d)) (:b (:X V_x) (:D V_d)))
        (&steps.predecessor (:b (:X *V2_x) (:D *V2_d)) (:a (:X *V_x) (:D *V_d))))))

  (RULE &stop
    (&back.reached (:key *A *B) (:n *X *D))
    (NOT (&end (:P X)))
    (&steps.distance (:key A B) (:n X D) (:K *N)))

  (RULE &tie
    (&stop *A *B (:X *X1) *N)
    (&stop A B (:X *X2) N)
    (!= X1 X2))

  (RULE &undefined
    (OR ((NOT (&pair)))
        ((&tie))
        ((&pair *A *B)
         (NOT (&arrival.minimal (:key A B))))
        ((&crowded))))

  ;; One output, painting every fewest-step walk.
  (RULE &resolved
    (NOT (&undefined))))

(ALTS $cost "what the route minimizes" $Steps
  (ALT $FewestTurns
    (OUTPUT shortest-path "each inner cell of the walk with the fewest straight runs, and of those the fewest steps, takes path_color"
      (RULE &run_source
        (&way)
        (OR ((&open *P))
            ((&end P))))

      (RULE &run_dir
        (&way)
        (dir_elem *D))

      (RULE &run_dir_ray
        (&run_dir *D))

      (RULE &run_blocked
        (&way)
        (input *P)
        (NOT (&open P)))

      (RULE &run_node
        (&run_dir)
        (input *P)
        (NOT (&run_blocked P)))

      ;; The straight runs a walk may take.
      (INIT &run Distance
        (key ((&run_source (:P ^O))
              (&run_dir_ray ^D))
          (edge ((:a A2) (:b Q))
            (OR ((&run_source (:P O))
                 (&run_dir_ray D)
                 (axis_of D *A)
                 (sub_extent (:P O) A *K)
                 (dir8_opposite D (:D2 *O_m2))
                 (edge_inset (:D O_m2) K (:B *B1_m3))
                 (edge_inset D K (:B *I_m5))
                 (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
                 (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
                 (compose (:A O) (:B V_m1) (:C *A2))
                 (&run_node (:P A2))
                 (step_offset D (:V *V_m6))
                 (compose (:A A2) (:B V_m6) (:C *Q))
                 (&run_node (:P Q)))
                ((&run_source (:P O))
                 (&run_dir_ray D)
                 (step_offset D (:V *V_m12))
                 (compose (:A O) (:B V_m12) (:C Q))
                 (&run_node (:P Q))
                 (= A2 O))
                ((&run_source (:P O))
                 (&run_dir_ray D)
                 (diag_dir_elem D)
                 (axis_elem (:A *A3))
                 (sub_extent (:P O) (:A A3) (:K *K2))
                 (dir8_opposite D (:D2 *O_m22))
                 (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
                 (edge_inset D (:K K2) (:B *I_m52))
                 (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
                 (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
                 (compose (:A O) (:B V_m13) (:C A2))
                 (&run_node (:P A2))
                 (step_offset D (:V *V_m62))
                 (compose (:A A2) (:B V_m62) (:C Q))
                 (&run_node (:P Q)))))
          (source ((:n O))
            (&run_source (:P O))
            (&run_dir_ray D))))

      (RULE &run_ray
        (&run.distance (:key *D (:O *Origin)) (:n *P) *K))

      (RULE &run_end
        (&run_ray *P *D *K *Origin)
        (step_offset D (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (NOT (&run_ray (:P Q) D Origin)))

      (RULE &leg
        (OR ((&run_ray (:P *Q) *D (:Origin *P))
             (dir_elem D)
             (!= Q P))
            ((&run_end (:P *E) D (:Origin P))
             (step_offset D (:V *V_m1))
             (compose (:A E) (:B V_m1) (:C Q))
             (input (:P Q))
             (dir_elem D)
             (&end (:P Q)))))

      ;; The fewest straight runs from a to each cell.
      (INIT &runs Distance
        (key ((&pair ^A))
          (edge ((:a P) (:b Q))
            (&leg *P *Q)
            (OR ((&open P))
                ((= P A))))
          (source ((:n A))
            (&way))))

      ;; The cells of every fewest-run walk from a to b, traced back from b.
      (INIT &run_back Propagation
        (key ((OR ((&runs.source (:key ^A) (:n A))
                   (&pair A ^B))
                  ((&runs.predecessor (:key A) (:b *Q) (:a *P))
                   (&pair A B))))
          (source ((:n B))
            (&runs.source (:key A) (:n A))
            (&pair A B))
          (edge ((:a Q) (:b P))
            (&runs.predecessor (:key A) (:b *Q) (:a *P))
            (&pair A B))))

      (RULE &route_leg
        (&run_back.reached (:key *A *B) (:n *Q))
        (&runs.predecessor (:key A) (:b Q) (:a *P))
        (&leg P *D Q))

      (RULE &leg_step
        (&route_leg *A *B *P *D *Q)
        (OR ((&leg P D (:Q *X)))
            ((= X P)))
        (step_offset D (:V *V_m1))
        (compose (:A X) (:B V_m1) (:C *Y))
        (OR ((= Y Q))
            ((&leg (:P Y) D Q))))

      ;; A step goes on along its run, or starts the next run where one ends. The
      ;; walk's first run starts from the seed visit of its own direction.
      (RULE &link
        (&leg_step *A *B *P (:X *V_x) (:D *V2_d) (:Y *V2_x))
        (OR ((= P V_x)
             (&route_leg A B (:D *V_d) (:Q V_x)))
            ((= V_d V2_d)))))
    (INPUT unique-shortest "exactly one walk has the fewest straight runs and, of those, the fewest steps")))

(ALTS $pass "the cells the route can cross" $Background
  (ALT $PassNonWall
    (INPUT walls "the walls are the cells of wall_color")
    (OUTPUT shortest-path "the walk crosses every cell that is neither a wall nor an endpoint, and its inner cells take path_color"
      (DET &wall_color UnchangedColor)

      (RULE &open
        (input *P *Col)
        (NOT (&wall_color (:C Col)))
        (NOT (&endpoint_color Col))))))

(ALTS $tie "what is painted when fewest-step walks tie" $Unique
  (ALT $TieAny
    (INPUT unique-shortest "several walks may have the fewest steps, and each of them gives one output"
      (RULE &undefined
        (OR ((NOT (&pair)))
            ((&pair *A *B)
             (NOT (&arrival.minimal (:key A B))))
            ((&crowded))))

      (RULE &next
        (&stop *A *B (:X *V_x) (:D *V_d) *N)
        (&stop A B (:X *V2_x) (:D *V2_d) (:N *N2))
        (&steps.predecessor (:key A B) (:b (:X V2_x) (:D V2_d)) (:a (:X V_x) (:D V_d))))

      (RULE &ties_item
        (&stop *A *B *X *D *N))

      ;; One fewest-step walk per pair of endpoints, a step's visit to each slot.
      (CHOOSE &ties
        (for ((&ties_item ^A ^B ^N))
          (from (&ties_item A B N *X *D)))
        (never
          (&ties_item *A *B *N *X *D)
          (&ties_item A B (:N *N2) X D)
          (!= N N2))
        (never
          (&ties_item *A *B *N *X *D)
          (&ties_item A B (:N *N2) (:X *X2) (:D *D2))
          (&next A B N N2)
          (NOT (&steps.predecessor (:key A B) (:b (:X X2) (:D D2)) (:a X D)))))

      (RULE &walk_cell
        (&ties *A *B *X))

      (RULE &walked
        (&stop))

      (RULE &resolved
        (NOT (&undefined))
        (OR ((ALL ((&walk_cell (:A *Am) (:B *Bm) (:X *Xm)))
                  ((&walk_cell (:A Bm) (:B Am) (:X Xm)))))
            ((NOT (&walked))))))
    (RULE &paint
      (&resolved)
      (&ties (:X *P)))
    (ALT $NoRouteKeep
      (INPUT connected "the endpoints may have no walk joining them, and then nothing is painted"
        (RULE &undefined
          (OR ((NOT (&pair)))
              ((&crowded)))))
      (ALT $AllPairs
        (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
          (RULE &undefined
            (NOT (&pair))))))
    (ALT $AllPairs
      (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
        (RULE &undefined
          (OR ((NOT (&pair)))
              ((&pair *A *B)
               (NOT (&arrival.minimal (:key A B)))))))))
  (ALT $TieUnion
    (INPUT unique-shortest "several walks may have the fewest steps, and the inner cells of all of them take path_color"
      (RULE &undefined
        (OR ((NOT (&pair)))
            ((&pair *A *B)
             (NOT (&arrival.minimal (:key A B))))
            ((&crowded)))))
    (ALT $NoRouteKeep
      (INPUT connected "the endpoints may have no walk joining them, and then nothing is painted"
        (RULE &undefined
          (OR ((NOT (&pair)))
              ((&crowded)))))
      (ALT $AllPairs
        (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
          (RULE &undefined
            (NOT (&pair))))))
    (ALT $AllPairs
      (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
        (RULE &undefined
          (OR ((NOT (&pair)))
              ((&pair *A *B)
               (NOT (&arrival.minimal (:key A B))))))))))

(ALTS $gap "what is given when no walk joins the endpoints" $Joined
  (ALT $NoRouteKeep
    (INPUT connected "the endpoints may have no walk joining them, and then nothing is painted"
      (RULE &undefined
        (OR ((NOT (&pair)))
            ((&tie))
            ((&crowded)))))
    (ALT $AllPairs
      (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
        (RULE &undefined
          (OR ((NOT (&pair)))
              ((&tie))))))))

(ALTS $ends "how many endpoints the scene holds" $TwoEnds
  (ALT $AllPairs
    (INPUT two-endpoints "the input holds two or more cells of endpoint_color, and the walk between each two of them is painted"
      (RULE &undefined
        (OR ((NOT (&pair)))
            ((&tie))
            ((&pair *A *B)
             (NOT (&arrival.minimal (:key A B)))))))))

(DET &path_color AnyOutNewColor)

(RULE &paint
  (&resolved)
  (&stop (:X *P)))

(RULE &output
  (OR ((&paint *P)
       (&path_color (:C *Col)))
      ((&resolved)
       (input P Col)
       (NOT (&paint P)))))
