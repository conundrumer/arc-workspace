;; 5dbc8537

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background is the commonest color.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &bg
  (&field.maximal (:t *Col)))

(RULE &inked_line_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &panels_divider_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &panels_divider
  (input *P)
  (axis_elem *A)
  (&panels_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
  (ALL ((input (:P *Pm) *Col)
        (&inked_line_split1 (:P_ Pm) (:A_ A) (:L_ L) (:X_m1_ *X_m1m)))
       ((&bg Col))))

(RULE &panels_on_divider
  (input *P)
  (&panels_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &panels_rank Order
  (key ((OR ((&panels_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&panels_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&panels_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &panels_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&panels_on_divider P A))
  (margin (:B P) D *K)
  (&panels_rank.rank (:key D) (:t K) (:R *N)))

(RULE &panels_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&panels_part_idx *P D (:N *N1))
  (&panels_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &panels_tile_of
  (&panels_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&panels_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &piece_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &panel
  (&panels_tile_of *P (:P_tile *P_panel))
  (input P *Col))

;; The template is the panel whose ink is all one color.
(INIT &panel_ink Singleton
  (key ((&panel (:P_panel ^T) *Col)
        (NOT (&bg Col)))
    (member ((:v Col))
      (&panel (:P_panel T) *Col)
      (NOT (&bg Col)))))

(RULE &template
  (&panel_ink.value (:key (:T *P_panel)) (:v *Col)))

(INIT &piece Quotient
  (edge ((:a P) (:b P3))
    (OR ((&panel (:P_panel *T) *P *Col)
         (NOT (&template (:P_panel T)))
         (NOT (&bg Col))
         (&piece_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&panel (:P_panel *T2) (:P P3) (:Col *Col2))
         (NOT (&template (:P_panel T2)))
         (NOT (&bg (:Col Col2))))
        ((&panel (:P_panel *T3) P (:Col *Col3))
         (NOT (&template (:P_panel T3)))
         (NOT (&bg (:Col Col3)))
         (= P3 P)))))

(RULE &piece_component
  (&piece.class (:a *P) *Id))

(RULE &hole
  (&panel (:P_panel *T) *P *Col)
  (&template (:P_panel T))
  (&bg Col))

(RULE &piece_cell
  (&piece_component *P (:Id *O))
  (input P *Col))

;; A piece's pattern, read from its own bbox.
(INIT &bbox BoundingBox
  (key ((&piece_cell ^O *P))
    (cell (P)
      (&piece_cell O *P))))

(RULE &shape
  (&piece_cell *O *P *Col)
  (&bbox.box (:key O) *B)
  (ALL ((&piece_cell (:O *Om) P (:Col *Colm))
        (&bbox.box (:key (:O Om)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; Where a piece lands with each of its cells on a hole.
(INIT &occ Occurrences
  (key ((OR ((&shape ^O *P_inner))
            ((&shape O)
             (&hole *P))))
    (cell (P)
      (&shape O)
      (&hole *P))
    (shape ((:P P_inner))
      (&shape O *P_inner))))

(RULE &covers
  (&occ.occurrence (:key *O) (:P *P_spot))
  (&shape O *P_inner *Col)
  (compose (:A P_spot) (:B P_inner) (:C *P)))

(RULE &reading_elem
  (diag_dir_elem (:D *Diag))
  (axis_elem (:A *Axis)))

(INIT &congruent Inclusion
  (pattern ((:pattern O) (:m P_inner Col))
    (&shape *O *P_inner *Col))
  (observed ((:observed O) (:m P_inner Col))
    (&shape *O *P_inner *Col)))

(RULE &reads_cell
  (&reading_elem *Diag *Axis)
  (OR ((&bbox.box (:B *P)))
      ((&occ.occurrence P))))

;; The order a reading puts the positions in: where the pieces sit, and
;; where they may go.
(INIT &reads Order
  (key ((&reads_cell ^Diag ^Axis *P))
    (member ((:t P))
      (&reads_cell Diag Axis *P))
    (before ((:a Q) (:b P))
      (&reads_cell Diag Axis (:P *Q))
      (&reads_cell Diag Axis *P)
      (&reading_elem Diag Axis)
      (OR ((corner_dir (:C Diag) (:A Axis) (:D *D2))
           (dir_elem (:D D2))
           (margin (:B Q) (:D D2) (:K *K1_m1))
           (margin (:B P) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2))
          ((corner_dir (:C Diag) (:A Axis) (:D D2))
           (perp (:A Axis) (:A2 *A2_m3))
           (corner_dir (:C Diag) (:A A2_m3) (:D *D22))
           (margin (:B Q) (:D D2) (:K *K_m4))
           (margin (:B P) (:D D2) (:K K_m4))
           (dir_elem (:D D22))
           (margin (:B Q) (:D D22) (:K *K1_m5))
           (margin (:B P) (:D D22) (:K *K2_m6))
           (< K1_m5 K2_m6))))))

(RULE &pruning_item
  (&reading_elem *Diag *Axis)
  (&occ.occurrence (:key *O) (:P *P_spot)))

;; A candidate stands while the other pieces still find a joint placement
;; beside it. Overlap conflicts under every reading; each reading adds its
;; own tie-break among congruent pieces.
(CHOOSE &pruning
  (for ((&pruning_item ^Diag ^Axis ^O))
    (from (&pruning_item Diag Axis O *P_spot)))
  (never
    (&pruning_item *Diag *Axis *O *P_spot)
    (&pruning_item (:Diag *Diag2) (:Axis *Axis2) (:O *O2) (:P_spot *P_spot2))
    (&reading_elem (:Diag Diag2) (:Axis Axis2))
    (&covers O P_spot *P)
    (&covers (:O O2) (:P_spot P_spot2) P))
  (never
    (&pruning_item *Diag *Axis *O *P_spot)
    (&pruning_item (:Diag *Diag2) (:Axis *Axis2) (:O *O2) (:P_spot *P_spot2))
    (&congruent.equal (:observed O) (:pattern O2))
    (!= O O2)
    (&bbox.box (:key O) *B)
    (&bbox.box (:key (:O O2)) (:B *B2))
    (&reads.before (:key (:Diag Diag2) (:Axis Axis2)) (:a B) (:b B2))
    (&occ.occurrence (:key O) (:P P_spot))
    (&occ.occurrence (:key (:O O2)) (:P P_spot2))
    (&reads.before (:key (:Diag Diag2) (:Axis Axis2)) (:a P_spot2) (:b P_spot))))

(INIT &view BoundingBox
  (cell (P)
    (&panel (:P_panel *T) *P)
    (&template (:P_panel T))))

(RULE &output
  (&view.cell (:P *P2))
  (&view.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&panel (:P_panel *T) (:P P2) *Col)
       (&template (:P_panel T) Col))
      ((&pruning *O *P_spot)
       (&covers O P_spot (:P P2) Col))))
