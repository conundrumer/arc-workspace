;; 94414823

(DET &wall SharedColor)

(RULE &wall_cell
  (input *P *Col)
  (&wall (:C Col)))

(INIT &outline Outlines
  (node (P)
    (&wall_cell *P)))

(RULE &inner
  (&outline.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&wall (:C Col))))

(ALTS $choice "how the inside of the wall is delimited" $Rect
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (input *P)
      (NOT (&wall_cell P)))

    (INIT &closed_flood Propagation
      (source ((:n P))
        (&closed_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P)
        (NOT (&wall_cell P)))
      (edge ((:a P) (:b P2))
        (input *P)
        (NOT (&wall_cell P))
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2))
        (NOT (&wall_cell (:P P2)))))

    (RULE &closed_node
      (&closed_cell *P)
      (NOT (&closed_flood.reached (:n P))))

    (INIT &closed Quotient
      (edge ((:a P) (:b P2))
        (OR ((&closed_node *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:P P2)))
            ((&closed_node P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *P) *Id))

    (RULE &inner
      (&closed_component *P))))

(INIT &inner_box BoundingBox
  (cell (P)
    (&inner *P)))

(RULE &placed
  (input *P)
  (&inner_box.box *B)
  (relative (:Base B) (:X P) (:X_rel *P_rel)))

(RULE &quad_nearer
  (&placed (:P_rel *P))
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &quad_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&quad_nearer *P (:D D1))
  (&quad_nearer P (:D D2)))

(RULE &on_diag
  (&placed *P *P_rel)
  (&quad_quadrant (:P P_rel) *Diag)
  (diag_axis_of (:D Diag) *Da))

(RULE &output
  (OR ((&inner *P)
       (&on_diag P (:Da *DA))
       (&mark (:P *P_mark) *Col)
       (&on_diag (:P P_mark) (:Da DA)))
      ((input P Col)
       (NOT (&inner P)))))
