;; 4b6b68e5

(RULE &objects_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &objects_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

;; Touching cells of one color make an object; a lone cell is a speck.
(INIT &objects Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objects_node (:Key *Ky) *P)
         (&objects_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objects_node (:Key Ky) (:P P2)))
        ((&objects_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objects_component
  (&objects.class (:a *Key *P) *Id))

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &outline
  (&objects_component (:Key *Col) *P *Id)
  (&objects_component (:Key Col) (:P *Q) Id)
  (!= P Q))

(RULE &closed_cell
  (&outline (:Id *Key))
  (input *P)
  (NOT (&outline (:Id Key) P)))

(RULE &closed_flood_node
  (&outline (:Id *Key))
  (input *P)
  (NOT (&outline (:Id Key) P)))

(INIT &closed_flood Propagation
  (key ((OR ((&closed_cell (:Key ^Ky) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&closed_flood_node (:Key Ky) P))
            ((&closed_flood_node (:Key Ky) P)
             (&closed_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&closed_flood_node (:Key Ky) (:P Q)))))
    (source ((:n P))
      (&closed_cell (:Key Ky) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&closed_flood_node (:Key Ky) P))
    (edge ((:a P) (:b Q))
      (&closed_flood_node (:Key Ky) *P)
      (&closed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&closed_flood_node (:Key Ky) (:P Q)))))

(RULE &closed_node
  (&closed_cell *Key *P)
  (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

;; The cells each outline closes off from the grid edge.
(INIT &closed Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&closed_node (:Key *Ky) *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:Key Ky) (:P P2)))
        ((&closed_node (:Key Ky) P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *Key *P) *Id))

(RULE &trapped
  (&closed_component (:Key *Id) *P (:Id *Region))
  (input P *Col)
  (NOT (&bg (:C Col))))

(INIT &shape_specks_count Cardinality
  (key ((&trapped ^Id *P ^Col))
    (member ((:m P))
      (&trapped Id *P Col))))

(INIT &shape_specks Order
  (key ((&shape_specks_count.size (:key ^Id *Col)))
    (member ((:t Col))
      (&shape_specks_count.size (:key Id *Col)))
    (score ((:t Col) (:S N))
      (&shape_specks_count.size (:key Id *Col) *N))))

(RULE &fill
  (&closed_component (:Key *Id) *P)
  (&shape_specks.maximal (:key Id) (:t *Col)))

(ALTS $choice "whether the commonest color is tallied over a whole outline or per cavity" $Shape
  (ALT $Region
    (INIT &region_specks_count Cardinality
      (key ((&trapped ^Id (:Region ^R) *P ^Col))
        (member ((:m P))
          (&trapped Id (:Region R) *P Col))))

    (INIT &region_specks Order
      (key ((&region_specks_count.size (:key ^Id (:R ^Region) *Col)))
        (member ((:t Col))
          (&region_specks_count.size (:key Id (:R Region) *Col)))
        (score ((:t Col) (:S N))
          (&region_specks_count.size (:key Id (:R Region) *Col) *N))))

    (RULE &fill
      (&closed_component (:Key *Id) *P (:Id *R))
      (&region_specks.maximal (:key Id (:Region R)) (:t *Col)))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&fill P *Col))
      ((&outline P)
       (= Col Col_in))
      ((NOT (&outline P))
       (NOT (&fill P))
       (&bg (:C Col)))))
