;; 484b58aa

(DET &hole ChangedColor)

(RULE &intact
  (input *P *Col)
  (NOT (&hole (:C Col))))

(RULE &damaged
  (input *P *Col)
  (&hole (:C Col)))

(INIT &si Periods
  (cell (P (:v Col))
    (&intact *P *Col)))

(RULE &period_at
  (&damaged *P)
  (&si.fundamental_period *A *K))

(ALTS $choice "the scope the period is measured over" $Lattice
  (ALT $Lines
    (DET &axis AxisDomain)

    (RULE &cell_split1
      (&intact (:P *P_) *Col)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

    (RULE &period_at_split1
      (&damaged (:P *P_))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

    (INIT &si_line Periods
      (key ((&intact *P *Col)
            (&axis *A)
            (&cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ ^L)))
        (cell (P (:v Col))
          (&intact *P *Col)
          (&axis *A)
          (&cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ L)))))

    (RULE &period_at
      (&damaged *P)
      (&axis *A)
      (&period_at_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L))
      (&si_line.fundamental_period (:key L) A *K))))

(RULE &axis_agree
  (&damaged *P)
  (input (:P *Q))
  (axis_of *D *A)
  (OR ((&period_at P A *K)
       (margin (:B P) D (:K *T))
       (divide T (:Side K) (:Gap 0) (:Remainder *R))
       (margin (:B Q) D (:K *T2))
       (divide (:T T2) (:Side K) (:Gap 0) (:Remainder R)))
      ((NOT (&period_at P A))
       (margin (:B P) D (:K *K_m1))
       (margin (:B Q) D (:K K_m1)))))

(RULE &orbit
  (&axis_agree *P *A *Q)
  (perp A *A2)
  (&axis_agree P (:A A2) Q))

(RULE &output
  ;; Intact cells pass through under every case.
  (OR ((&intact *P *Col))
      ((&orbit P *Q)
       (&intact (:P Q) Col))))
