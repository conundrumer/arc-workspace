;; 95990924

(RULE &squares_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &squares Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&squares_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &squares_component
  (&squares.class (:a *P) *Id))

(INIT &sbox BoundingBox
  (key ((&squares_component *P ^Id))
    (cell (P)
      (&squares_component *P Id))))

(RULE &seat
  (input (:P *P2))
  (&sbox.box (:key *Id) *B)
  (ALL ((input (:P P2))
        (&sbox.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (step_offset *D (:V *V_m1))
  (ALL ((input (:P P2))
        (input (:P *Qm))
        (step_offset D (:V *V_m1m))
        (compose (:A P2) (:B V_m1m) (:C Qm))
        (&sbox.box (:key (:Id *Idmm)) B)
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B P2) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3)))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(DET &added
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col2))
  (!= Col Col2))

(DET &corner_paint
  (&seat *E *P *D)
  (&added E P *Col))

(RULE &painted
  (&seat *P *D)
  (&corner_paint D *Col))

(ALTS $choice "where a square's four seats are found" $Corners
  (ALT $Contact
    (RULE &beside
      (input *P)
      (NOT (&ink P))
      (dir8_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q))
      (&ink (:P Q)))

    (RULE &side
      (dir_elem *D)
      (&beside *P D))

    (RULE &corner_only
      (diag_dir_elem *D)
      (&beside *P D)
      (NOT (&side P)))

    (RULE &painted
      (&corner_only *P (:D *D_back))
      (diag_opposite (:D D_back) (:Opp *D))
      (&corner_paint D *Col)))
  (ALT $Stamp
    ;; A square with its seats: what the stored picture frames.
    (INIT &pic BoundingBox
      (key ((OR ((&squares_component ^E *P ^Id))
                ((&seat E Id P))))
        (cell (P)
          (OR ((&squares_component E *P Id))
              ((&seat E Id P))))))

    (DET &square_inside1
      (&squares_component *E (:P *P_) *Id)
      (&pic.box (:key E Id) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &mark_inside1
      (&seat *E *Id (:P *P_))
      (&pic.box (:key E Id) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &square
      (&pic.box (:key *E *Id) *B)
      (&squares_component E (:P *P2) Id)
      (NOT (&square_inside1 (:P_ P2) (:B_ B)))
      (relative (:Base B) (:X P2) (:X_rel *P))
      (ex_input E (:P P2) *Col))

    (INIT &occ Occurrences
      (cell (P (:v Col))
        (input *P *Col))
      (shape (P (:v Col))
        (&square *P *Col)))

    (DET &mark
      (&pic.box (:key *E *Id) *B)
      (&seat E Id (:P *P2))
      (NOT (&mark_inside1 (:P_ P2) (:B_ B)))
      (relative (:Base B) (:X P2) (:X_rel *P))
      (&added E (:P P2) *Col))

    (RULE &painted
      (&occ.occurrence (:P *M))
      (&mark (:P *P_pic) *Col)
      (compose (:A M) (:B P_pic) (:C *P))
      (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
