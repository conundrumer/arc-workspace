;; 85b81ff1

;; The edge the least-inked unit sits at.
(DET &least_dir DirDomain)

(RULE &axis
  (&least_dir *D)
  (axis_of D *A))

(INIT &decompose_division_sides ExtentDivisions
  (frame ((:P P_grid))
    (input (:P *P_grid))))

(DET &gap DivisorRatio)

(DET &tile_count SepTileCount)

(RULE &decompose_division_gap
  (&axis *A)
  (&gap (:K *G)))

(RULE &decompose_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &decompose_division_parts
  (&axis *A)
  (&tile_count *N))

(RULE &decompose_division_axis
  (OR ((input *P)
       (&axis *A)
       (&tile_count *N)
       (&gap (:K *G))
       (&decompose_division_sides.division A N *K G)
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (&axis A)
       (&tile_count (:N *N2))
       (&gap (:K *G2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((input P)
       (&axis A)
       (&tile_count (:N *N3))
       (NOT (&decompose_division_gap A))
       (&decompose_division_sides.division A (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) A)
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K3)))
      ((input P)
       (&axis A)
       (&tile_count (:N *N4))
       (NOT (&decompose_division_gap A))
       (frame_extent P A (:N *K4))
       (axis_of (:D *D4) A)
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K4))
       (frame_extent (:P P_outer) A (:N N4)))
      ((input P)
       (axis_elem A)
       (NOT (&decompose_division_parts A))
       (&decompose_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &decompose_division_tile
  (&decompose_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&decompose_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &decompose
  (&decompose_division_tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &bg RarestColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(ALTS $choice "which kind of unit is reordered, and how" $Tile
  (ALT $Tile
    (ALTS $d "which parameter fixes the tile decomposition" $Count
      (ALT $Size
        (DET &tile_size SepTileDim)
        (RULE &decompose_division2_gap
          (&axis *A)
          (&gap (:K *G)))
        (RULE &decompose_division2_axis_split1
          (input (:P *P_grid_))
          (axis_elem (:A *A_))
          (axis_of (:D *D_m1) (:A A_))
          (opposite (:D D_m1) (:Opp *O_m2))
          (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
          (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
          (opposite (:D D_m1) (:Opp *O_m1))
          (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
          (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
          (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
          (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))
        (RULE &decompose_division2_side
          (&axis *A)
          (&tile_size (:D *K)))
        (RULE &decompose_division2_axis
          (OR ((input *P)
               (&axis *A)
               (&tile_size (:D *K))
               (&gap (:K *G))
               (axis_of *D A)
               (opposite D (:Opp *O))
               (margin (:B P) D (:K *T))
               (margin (:B P) (:D O) (:K *T2))
               (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
               (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
               (opposite D (:Opp *O_m1))
               (edge_inset D (:K I) (:B *B1_m2))
               (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
               (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
               (opposite D (:Opp *O_m4))
               (edge_inset D (:K R) (:B *B1_m5))
               (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
               (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
               (frame_extent (:P P_inner) A (:N K)))
              ((input P)
               (&axis A)
               (&tile_size (:D *K2))
               (NOT (&decompose_division2_gap A))
               (axis_of (:D *D2) A)
               (opposite (:D D2) (:Opp *O2))
               (margin (:B P) (:D D2) (:K *T3))
               (margin (:B P) (:D O2) (:K *T22))
               (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
               (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
               (opposite (:D D2) (:Opp *O_m12))
               (edge_inset (:D D2) (:K I3) (:B *B1_m22))
               (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
               (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
               (opposite (:D D2) (:Opp *O_m42))
               (edge_inset (:D D2) (:K R3) (:B *B1_m52))
               (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
               (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
               (frame_extent (:P P_inner) A (:N K2)))
              ((input P)
               (axis_elem A)
               (NOT (&decompose_division2_side A))
               (&decompose_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
               (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))
        (RULE &decompose_division2_tile
          (&decompose_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
          (perp (:A A1) *A2)
          (&decompose_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
          (compose (:A Po1) (:B Po2) (:C *P_outer))
          (compose (:A Pi1) (:B Pi2) (:C *P_inner)))
        (RULE &decompose
          (&decompose_division2_tile *P (:P_outer *P_tile) (:P_inner *P_intile))))))
  (ALT $Lines
    (RULE &line_hole_split1
      (input (:P *P_) *Col)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &line_hole
      (input *P *Col)
      (&bg (:C Col))
      (&axis *A)
      (&line_hole_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

    (RULE &line_ink_split1
      (&ink (:P *P_))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &line_ink
      (&ink *P)
      (&axis *A)
      (&line_ink_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

    (RULE &sortable
      (&line_ink *L)
      (&line_hole L))

    (INIT &line_order Order
      (key ((&axis ^A)
            (axis_of ^D A))
        (before ((:a L) (:b L2))
          (&sortable *L)
          (&sortable (:L *L2))
          (!= L L2)
          (margin (:B L) D (:K *K1))
          (margin (:B L2) D (:K *K2))
          (< K1 K2)))
      (member ((:t L))
        (&sortable *L)))

    (RULE &line_order_pos
      (&line_order.rank (:key *A *D) (:t *M) (:R *R1))
      (&line_order.dual_rank (:key A D) (:t M) (:R *R2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K R1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

    (RULE &out_split1
      (input (:P *P_grid_out_))
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_out_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_out_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_out_))
      (relative (:Base L_out_) (:X P_grid_out_) (:X_rel *Across_)))

    (RULE &out_split2
      (input (:P *P_) *Col)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (INIT &line_tally Cardinality
      (key ((&sortable ^L))
        (member ((:m P))
          (&line_ink L *P))))

    (INIT &line_rank Order
      (member ((:t N))
        (&line_tally.size *N))
      (score ((:t N) (:S N))
        (&line_tally.size *N)))

    (RULE &output
      (OR ((input *P)
           (&axis *A)
           (&out_split1 (:P_grid_out_ P) (:A_ A) (:L_out_ *L_out) (:Across_ *Across))
           (&line_order_pos (:M L_out) *P_pos)
           (&least_dir *D)
           (margin (:B P_pos) D (:K *R))
           (&line_tally.size (:key (:L *L_in)) *N)
           (&line_rank.rank (:t N) R)
           (compose (:A L_in) (:B Across) (:C *P_grid_in))
           (input (:P P_grid_in) *Col))
          ((input P Col)
           (&axis (:A *A2))
           (&out_split2 (:P_ P) (:A_ A2) (:L_ *L) (:X_m1_ *X_m1))
           (NOT (&sortable L))))))
  (ALT $Objects
    (RULE &obj_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &obj Quotient
      (edge ((:a P) (:b P3))
        (OR ((&ink *P)
             (&obj_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink (:P P3)))
            ((&ink P)
             (= P3 P)))))

    (RULE &obj_component
      (&obj.class (:a *P) *Id))

    (RULE &before_split1
      (&obj_component (:P *P_) *Id)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (RULE &before_split2
      (&obj_component (:P *P2_) (:Id *Id2))
      (&axis (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P2_) (:D D_m1) (:K *K1_m3))
      (margin (:B P2_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
      (relative (:Base L2_) (:X P2_) (:X_rel *X_m2_)))

    (RULE &elem_split1
      (&obj_component (:P *P_) *Id)
      (&axis (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *L_))
      (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

    (INIT &obj_order Order
      (key ((&axis (:A ^A2))
            (axis_of ^D (:A A2)))
        (before ((:a Id) (:b Id2))
          (&obj_component *P *Id)
          (&axis *A)
          (&before_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
          (&obj_component (:P *P2) (:Id *Id2))
          (&axis (:A *A22))
          (&before_split2 (:P2_ P2) (:A2_ A22) (:L2_ *L2) (:X_m2_ *X_m2))
          (!= Id Id2)
          (margin (:B L) D (:K *K1))
          (margin (:B L2) D (:K *K2))
          (< K1 K2)))
      (member ((:t Id))
        (&obj_component *P *Id)
        (&axis *A)
        (&elem_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))))

    (RULE &obj_order_pos
      (&obj_order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
      (&obj_order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
      (opposite D (:Opp *O_m1))
      (edge_inset D (:K R1) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

    (INIT &obj_size Cardinality
      (key ((&obj_component *P ^Id))
        (member ((:m P))
          (&obj_component *P Id))))

    (INIT &obj_rank Order
      (member ((:t N))
        (&obj_size.size *N))
      (score ((:t N) (:S N))
        (&obj_size.size *N)))

    (INIT &obj_box BoundingBox
      (key ((&obj_component *P ^Id))
        (cell (P)
          (&obj_component *P Id))))

    (RULE &moved
      (input (:P *P2) *Col)
      (&obj_component (:P P2) (:Id *Id_src))
      (&obj_size.size (:key (:Id Id_src)) *N)
      (&obj_rank.rank (:t N) *R)
      (&obj_order_pos (:M *Id_dst) *P_pos)
      (&least_dir *D)
      (margin (:B P_pos) D (:K R))
      (&obj_box.box (:key (:Id Id_src)) (:B *B_src))
      (&obj_box.box (:key (:Id Id_dst)) (:B *B_dst))
      (relative (:Base B_src) (:X B_dst) (:X_rel *V))
      (compose (:A P2) (:B V) (:C *P)))

    (RULE &output
      (OR ((&moved *P *Col))
          ((input P)
           (NOT (&moved P))
           (&bg (:C Col)))))))

(INIT &tile_ink Cardinality
  (key ((&decompose ^P_tile))
    (member ((:m P))
      (&decompose *P P_tile)
      (&ink P))
    (domain ()
      (&decompose P_tile))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile_in))
    (&tile_ink.size (:key (:P_tile *P_tile_in))))
  (inner ((:P P_intile))
    (&decompose *P_intile))
  (gap (A G)
    (&axis *A)
    (&gap (:K *G))))

(INIT &tile_rank Order
  (member ((:t N))
    (&tile_ink.size *N))
  (score ((:t N) (:S N))
    (&tile_ink.size *N)))

(RULE &output
  (OR ((&decompose *P (:P_tile *P_tile_out) *P_intile)
       (&least_dir *D)
       (margin (:B P_tile_out) D (:K *R))
       (&tile_ink.size (:key (:P_tile *P_tile_in)) *N)
       (&tile_rank.rank (:t N) R)
       (&output_tiling.cell (:P_outer P_tile_in) (:P_inner P_intile) (:P *P_grid_in))
       (input (:P P_grid_in) *Col))
      ((input P Col)
       (NOT (&decompose P)))))
