;; 37ce87bb

(RULE &line_of_split1
  (input (:P *P_))
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_line_)))

(DET &base DirDomain)

(DET &add SharedColor)

(DET &sub UnchangedColor)

(DET &result AnyOutNewColor)

(DET &bg DominantColor)

(DET &pitch TileCount)

(RULE &line_of
  (input *P)
  (&base *D)
  (axis_of D *A)
  (&line_of_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_line_ *P_line)))

(RULE &bar_line
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&line_of P *P_line))

;; The summed height: add cells beyond sub cells.
(INIT &height Excess
  (plus ((:m P))
    (input *P *Col)
    (&add (:C Col)))
  (minus ((:m P))
    (input *P *Col)
    (&sub (:C Col))))

;; One pitch across from a bar line, on a barless grid line: a candidate
;; off the grid, and one that lands on a neighbor bar, both drop out.
(RULE &result_line
  (&bar_line (:P_line *P_line3))
  (&base *D)
  (axis_of D (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *D2) (:A A2_m2))
  (&pitch (:N *K))
  (dir8_opposite (:D D2) (:D2 *O_m4))
  (edge_inset (:D O_m4) K (:B *B1_m5))
  (edge_inset (:D D2) K (:B *I_m7))
  (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
  (compose (:A P_line3) (:B V_m3) (:C *P_line))
  (&line_of P_line)
  (NOT (&bar_line P_line)))

(ALTS $choice "where the result line stands" $Next
  (ALT $Edge
    (DET &sense SenseDomain)

    (DET &margin DivisorRatio)

    (RULE &result_line
      (&line_of *P_line)
      (&base *D)
      (&sense *S)
      (turn S D *D2)
      (&margin *K)
      (margin (:B P_line) (:D D2) K))))

(RULE &result_cell
  (&line_of *P *P_line)
  (&result_line P_line)
  (&base *D)
  (margin (:B P) D *K)
  (&height.excess *N)
  (< K N))

(RULE &output
  (OR ((&result_cell *P)
       (&result (:C *Col)))
      ((input P Col)
       (NOT (&result_cell P)))))
