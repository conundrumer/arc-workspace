;; 28a6681f

(INPUT vessel "Walls of every other color hold a body of water.")

(OUTPUT settle "The water settles under gravity as the first open cells of one fill order, as many as there are water cells. The water falls and slides to the cup it reaches, a cup fills by level from its bottom, and water that rises over a rim pours into the next cup, in the pour sense first."

  (RULE &cup_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &gravity DirDomain)

  (DET &bg DominantColor)

  (DET &water SharedColor)

  (RULE &wall
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&water (:C Col))))

  (RULE &open
    (input *P)
    (NOT (&wall P)))

  (RULE &row_split1
    (input (:P *P_))
    (axis_of *D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Y_))
    (relative (:Base Y_) (:X P_) (:X_rel *X_m1_)))

  (RULE &row
    (input *P)
    (&gravity *D)
    (axis_of D *A)
    (&row_split1 (:P_ P) (:A_ A) (:Y_ *Y) (:X_m1_ *X_m1)))

  (RULE &cup_node
    (&row (:Y *Key))
    (&open *P)
    (&gravity *D)
    (dir_elem D)
    (margin (:B Key) D (:K *K1_m1))
    (margin (:B P) D (:K *K2_m2))
    (>= K1_m1 K2_m2))

  ;; The cups of each row: the components of the open cells at or below it.
  (INIT &cup Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&cup_node (:Key *Ky) *P)
           (&cup_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&cup_node (:Key Ky) (:P P2)))
          ((&cup_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &cup_component
    (&cup.class (:a *Key *P) *Id))

  (RULE &lateral
    (&gravity (:D *D2))
    (axis_of (:D D2) (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of *D (:A A2_m2)))

  (RULE &run_dir
    (&open)
    (&lateral *D))

  (RULE &run_node
    (&open *P))

  (RULE &run_source
    (&open *P))

  (INIT &run Distance
    (key ((&run_source (:P ^O))
          (&run_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&run_source (:P O))
             (&run_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&run_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&run_node (:P Q)))
            ((&run_source (:P O))
             (&run_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&run_node (:P Q))
             (= A2 O))
            ((&run_source (:P O))
             (&run_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&run_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&run_node (:P Q)))))
      (source ((:n O))
        (&run_source (:P O))
        (&run_dir D))))

  (RULE &run_ray
    (&run.distance (:key *D (:O *Origin)) (:n *P) *K))

  ;; The sense the water pours in. The pairs fix neither, so both stay open.
  ;; TODO no-det-plan: &pour_sense: the plan gives no verdict
  (DET &pour_sense (ONE))

  (RULE &up
    (&gravity (:D *D2))
    (opposite (:D D2) (:Opp *D)))

  (RULE &pour
    (&pour_sense *S)
    (&gravity (:D *D2))
    (turn S (:D D2) (:D2 *D)))

  (RULE &parcel
    (input *P *Col)
    (&water (:C Col)))

  (RULE &hangs
    (&open *P)
    (&gravity *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&open (:P Q)))

  (RULE &drains
    (&lateral *D)
    (&run_ray (:P *Q) D (:K *N) (:Origin *P))
    (> N 0)
    (&hangs (:P Q)))

  (RULE &step
    (&pour_sense *S)
    (&open *P)
    (OR ((&hangs P)
         (&gravity *D)
         (step_offset D (:V *V_m1))
         (compose (:A P) (:B V_m1) (:C *Q)))
        ((NOT (&hangs P))
         (&pour S (:D *L))
         (&drains P (:D L))
         (step_offset (:D L) (:V *V_m2))
         (compose (:A P) (:B V_m2) (:C Q)))
        ((NOT (&hangs P))
         (&pour S (:D *L3))
         (NOT (&drains P (:D L3)))
         (opposite (:D L3) (:Opp *L2))
         (&drains P (:D L2))
         (step_offset (:D L2) (:V *V_m3))
         (compose (:A P) (:B V_m3) (:C Q)))))

  (RULE &rest
    (&open *P)
    (NOT (&hangs P))
    (NOT (&drains P)))

  ;; The cells whose water comes to rest at r, by the steps back from r.
  (INIT &sink Distance
    (key ((OR ((&pour_sense ^S)
               (&rest (:P ^R)))
              ((&rest (:P R))
               (&step S *P *Q))))
      (edge ((:a Q) (:b P))
        (&rest (:P R))
        (&step S *P *Q))
      (source ((:n R))
        (&pour_sense S)
        (&rest (:P R)))))

  (RULE &lands
    (&sink.distance (:key *S *R) (:n *P)))

  (RULE &lex_cell
    (&parcel (:P *P2))
    (&lands (:S *Key) (:P P2) (:R *P)))

  ;; The cell the water reaches first: the first place it rests, from
  ;; gravity's far edge, in the pour direction.
  (INIT &lex Order
    (key ((&lex_cell (:Key ^Ky) *P))
      (member ((:t P))
        (&lex_cell (:Key Ky) *P))
      (before ((:a Q) (:b P))
        (&lex_cell (:Key Ky) (:P *Q))
        (&lex_cell (:Key Ky) *P)
        (input)
        (&pour (:S Ky) (:D *L))
        (&gravity *D)
        (corner_dir (:C *Diag) (:A *A_m1) D)
        (perp (:A A_m1) (:A2 *A2_m2))
        (corner_dir (:C Diag) (:A A2_m2) (:D L))
        (&pour_sense (:S Ky))
        (&gravity (:D *D2))
        (axis_of (:D D2) *A)
        (OR ((corner_dir (:C Diag) A (:D *D3))
             (dir_elem (:D D3))
             (margin (:B Q) (:D D3) (:K *K1_m3))
             (margin (:B P) (:D D3) (:K *K2_m4))
             (< K1_m3 K2_m4))
            ((corner_dir (:C Diag) A (:D D3))
             (perp A (:A2 *A2_m5))
             (corner_dir (:C Diag) (:A A2_m5) (:D *D22))
             (margin (:B Q) (:D D3) (:K *K_m6))
             (margin (:B P) (:D D3) (:K K_m6))
             (dir_elem (:D D22))
             (margin (:B Q) (:D D22) (:K *K1_m7))
             (margin (:B P) (:D D22) (:K *K2_m8))
             (< K1_m7 K2_m8))))))

  (RULE &inner
    (&cup_component (:Key *Yc) *P (:Id *C))
    (&up (:D *U))
    (step_offset (:D U) (:V *V_m1))
    (compose (:A Yc) (:B V_m1) (:C *Yp))
    (&cup_component (:Key Yp) P (:Id *Cp)))

  (RULE &mouth
    (&cup_component (:Key *Y) (:P *M) (:Id *C))
    (&row (:P M) Y)
    (&up (:D *U))
    (step_offset (:D U) (:V *V_m1))
    (compose (:A M) (:B V_m1) (:C *M2))
    (&open (:P M2)))

  (RULE &away
    (&inner *Yc *C *Yp *Cp)
    (&rest (:P *R))
    (&cup_component (:Key Yp) (:P R) (:Id Cp))
    (NOT (&cup_component (:Key Yc) (:P R) (:Id C)))
    (&mouth (:Y Yc) C *M)
    (&lateral *D)
    (dir_elem D)
    (margin (:B M) D (:K *K1_m1))
    (margin (:B R) D (:K *K2_m2))
    (< K1_m1 K2_m2))

  ;; Each cup the water fills, with the cell its water lands on: the inner
  ;; cup that holds the landing keeps it, and another inner cup takes the
  ;; water that pours in over its first mouth on the side of the landing.
  (INIT &descent Distance
    (key ((OR ((&lex.minimal (:key (:Ky ^S)) (:t *R))
               (&cup_component (:Key *Y) (:P R) (:Id *C))
               (&up (:D *U))
               (margin (:B Y) (:D U) (:K 0)))
              ((&pour_sense S)
               (&rest (:P R))
               (&inner *Yc C *Yp *Cp)
               (&cup_component (:Key Yc) (:P R) (:Id C)))
              ((&away (:Yp *Yp3) (:Cp *Cp3) R (:Yc *Yc2) C (:D *L))
               (opposite (:D L) (:Opp *L2))
               (&mouth (:Y Yc2) C *M)
               (ALL ((&mouth (:Y Yc2) C (:M *M2))
                     (margin (:B M2) (:D L2) (:K *K1_m1))
                     (margin (:B M) (:D L2) (:K *K2_m2)))
                    ((>= K1_m1 K2_m2)))
               (&lands S (:P M) (:R *R2)))))
      (edge ((:a (:Y Yp) (:C Cp) R) (:b (:Y Yc) C (:R R3)))
        (OR ((&away *Yp *Cp *R *Yc *C (:D *L))
             (opposite (:D L) (:Opp *L2))
             (&mouth (:Y Yc) C *M)
             (ALL ((&mouth (:Y Yc) C (:M *M2))
                   (margin (:B M2) (:D L2) (:K *K1_m1))
                   (margin (:B M) (:D L2) (:K *K2_m2)))
                  ((>= K1_m1 K2_m2)))
             (&lands S (:P M) (:R *R3)))
            ((&pour_sense S)
             (&rest (:P R))
             (&inner Yc C Yp Cp)
             (&cup_component (:Key Yc) (:P R) (:Id C))
             (= R3 R))))
      (source ((:n Y C R))
        (&lex.minimal (:key (:Ky S)) (:t *R))
        (&cup_component (:Key *Y) (:P R) (:Id *C))
        (&up (:D *U))
        (margin (:B Y) (:D U) (:K 0)))))

  (RULE &entry
    (&descent.distance (:key *S) (:n *Y *C *R)))

  (RULE &first_cup
    (OR ((&entry *S (:Y *Yp) (:C *Cp) *R)
         (&inner (:Yc *Y) (:C *C1) Yp Cp)
         (&cup_component (:Key Y) (:P R) (:Id C1))
         (&inner (:Yc Y) (:C *C2) Yp Cp)
         (!= C1 C2))
        ((&entry S (:Y *Yp2) (:C *Cp2) (:R *R2))
         (&away (:Yp Yp2) (:Cp Cp2) (:R R2) (:Yc Y) (:C C1) (:D *L1))
         (&away (:Yp Yp2) (:Cp Cp2) (:R R2) (:Yc Y) (:C C2) (:D *L2))
         (OR ((&pour S (:D L1))
              (NOT (&pour S (:D L2))))
             ((= L1 L2)
              (!= C1 C2)
              (&mouth Y (:C C1) (:M *M1))
              (&mouth Y (:C C2) (:M *M2))
              (dir_elem (:D L1))
              (margin (:B M2) (:D L1) (:K *K1_m1))
              (margin (:B M1) (:D L1) (:K *K2_m2))
              (< K1_m1 K2_m2))))))

  (RULE &upto
    (OR ((&entry *S *Y *C)
         (&row *P Y)
         (&cup_component (:Key Y) P (:Id C))
         (&cup_component (:Key Y) (:P *Q) (:Id C)))
        ((&first_cup S (:Y *Y2) *C1 *C2)
         (&cup_component (:Key Y2) (:P Q) (:Id C1))
         (&cup_component (:Key Y2) P (:Id C2)))))

  (INIT &filled Cardinality
    (key ((&upto ^S ^P *Q))
      (member ((:m Q))
        (&upto S P *Q))))

  (INIT &amount Cardinality
    (member ((:m P))
      (&parcel *P))
    (domain ()
      (input))))

(RULE &run_end
  (&run_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&run_ray (:P Q) D Origin)))

(RULE &settled
  (input *P (:Col *C))
  (&pour_sense *S)
  (OR ((&filled.size (:key S P) (:N *N1))
       (&amount.size *N)
       (<= N1 N)
       (&water (:C *Col)))
      ((&wall P)
       (= Col C))
      ((&upto S P *Q)
       (NOT (&upto S (:P Q) (:Q P)))
       (&filled.size (:key S (:P Q)) (:N N1))
       (&amount.size N)
       (>= N1 N)
       (&bg (:C Col)))
      ((&open P)
       (NOT (&upto S P (:Q P)))
       (&bg (:C Col)))))

(RULE &output
  (&settled *S *P *Col))
