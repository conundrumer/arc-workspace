;; 9b4c17c4

(param &ink Color (2))
(param &slide (Color Dir) (1 DIR_R) (8 DIR_L))

(alts $choice
  (alt $Pack
    (witness shared-line borderline $Pack
      (relaxed lane)
      (separates "$Flush from $Pack: two shapes on one field share their rows, and the whole shape flush to the edge overlaps the nearer shape while the packed rows keep every cell")
      (input (grid
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 2 2 1 2 2 1 1 8 8 2 8)
        (1 2 2 1 2 2 1 1 8 8 2 8)
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 1 1 1 1 1 1 1 8 8 8 8)))
      (output concept (grid
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 1 1 1 1 1 2 2 2 8 8 8)
        (1 1 1 1 1 1 2 2 2 8 8 8)
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 1 1 1 1 1 1 1 8 8 8 8)))
      (output $Pack (grid
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 1 1 1 2 2 2 2 2 8 8 8)
        (1 1 1 1 2 2 2 2 2 8 8 8)
        (1 1 1 1 1 1 1 1 8 8 8 8)
        (1 1 1 1 1 1 1 1 8 8 8 8))))))
