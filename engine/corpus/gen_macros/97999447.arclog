;; 97999447

(DET &ray_dir DirDomain)

(RULE &rays_dir
  (&ray_dir *D))

(RULE &rays_node
  (input *P))

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &rays_source
  (&mark *P))

(INIT &rays Distance
  (key ((&rays_source (:P ^O))
        (&rays_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&rays_source (:P O))
           (&rays_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&rays_node (:P Q)))
          ((&rays_source (:P O))
           (&rays_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&rays_node (:P Q))
           (= A2 O))
          ((&rays_source (:P O))
           (&rays_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&rays_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&rays_node (:P Q)))))
    (source ((:n O))
      (&rays_source (:P O))
      (&rays_dir D))))

(RULE &rays_ray
  (&rays.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &rays_end
  (&rays_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&rays_ray (:P Q) D Origin)))

(DET &alt_color AnyOutNewColor)

(RULE &on_ray
  (&rays_ray *P *K (:Origin *Src))
  (&mark (:P Src) (:Col *M)))

;; Each dot color's two-color cycle, one advance per ray step.
(INIT &colors Walk
  (key ((OR ((&mark (:Col ^M))
             (&alt_color (:C *Alt))
             (OR ((= *A M)
                  (= *B Alt))
                 ((= A Alt)
                  (= B M))))
            ((&on_ray M *K))))
    (successor ((:p A) (:p_next B))
      (&mark (:Col M))
      (&alt_color (:C *Alt))
      (OR ((= *A M)
           (= *B Alt))
          ((= A Alt)
           (= B M))))
    (steps ((:N K))
      (&on_ray M *K))))

(ALTS $choice "how the ray is colored" $Toggle
  (ALT $Mask
    (DET &dot
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col)))
      (ex_output E))

    (DET &ray_col
      (&dot *E (:P *M))
      (&ray_dir *D)
      (ex_input E *P)
      (margin (:B P) D (:K *I))
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) (:K I) (:B *B1_m3))
      (edge_inset D (:K I) (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A M) (:B V_m1) (:C *Q))
      (ex_output E (:P Q) *Col))

    (DET &cand
      (&ray_col (:I *W))
      (!= W 0))

    ;; The colors one ray carries at each slot of a candidate period.
    (INIT &slot_color Singleton
      (key ((&cand ^W)
            (&ray_col ^E ^M *I *Col)
            (divide (:T I) (:Side W) (:Gap 0) (:Remainder ^K)))
        (member ((:v Col))
          (&cand W)
          (&ray_col E M *I *Col)
          (divide (:T I) (:Side W) (:Gap 0) (:Remainder K)))))

    (DET &mismatch
      (&slot_color.plural (:key *W)))

    ;; The shortest period no ray breaks.
    (INIT &unbroken Order
      (member ((:t W))
        (&cand *W)
        (NOT (&mismatch W)))
      (score ((:t W) (:S W))
        (&cand *W)
        (NOT (&mismatch W))))

    (DET &period
      (&unbroken.minimal (:t *N)))

    (DET &slot
      (&ray_col (:I *K))
      (&period *N)
      (< K N))

    (INIT &slots Order
      (member ((:t K))
        (&slot *K))
      (score ((:t K) (:S K))
        (&slot *K)))

    ;; A step along the ray advances the slot cycle.
    (INIT &slot_walk Walk
      (successor ((:p K) (:p_next K2))
        (&slots.cyclic_successor (:a *K) (:b *K2)))
      (steps ((:N K))
        (&on_ray *K)))

    (RULE &ray_slot
      (&on_ray *P *M (:K *K2))
      (&slot_walk.walk (:p0 0) (:N K2) (:p *K)))

    (DET &mask
      (&ray_col *E *M *I *Col)
      (&dot E (:P M) (:Col *Mc))
      (!= Col Mc)
      (&period *N)
      (divide (:T I) (:Side N) (:Gap 0) (:Remainder *K)))

    (RULE &output
      (OR ((&ray_slot *P *K)
           (&mask K *Col))
          ((&ray_slot P (:M Col) (:K *K2))
           (NOT (&mask (:K K2))))
          ((input P Col)
           (NOT (&on_ray P)))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&on_ray P)))
      ((&on_ray P *M *K)
       (&colors.walk (:key M) (:p0 M) (:N K) (:p Col)))))
