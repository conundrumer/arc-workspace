;; 3f7978a0

(DET &bar RarestColor)

(DET &axis AxisDomain)

(DET &cap ColorDomain)

(RULE &bar2
  (input *P *Col)
  (&bar (:C Col)))

(RULE &stepped
  (&bar2 (:P *P3))
  (&axis *A)
  (axis_of *D A)
  (step_offset D (:V *V_m1))
  (compose (:A P3) (:B V_m1) (:C *P)))

(INIT &hull BoundingBox
  (cell (P)
    (OR ((&bar2 *P))
        ((&stepped P)
         (input P *Col)
         (&cap (:C Col))))))

(ALTS $choice "the region's extent along the axis" $Cap
  (ALT $Grow
    (INIT &hull BoundingBox
      (cell (P)
        (OR ((&bar2 *P))
            ((&stepped P)))))))

(RULE &output
  (input (:P *P2) *Col)
  (&hull.box *B)
  (ALL ((input (:P P2) (:Col *Colm))
        (&hull.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))
