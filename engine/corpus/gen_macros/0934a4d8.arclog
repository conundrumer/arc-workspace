;; 0934a4d8

(DET &mask RarestColor)

(DET &cell
  (ex_input *E *P *Col)
  (NOT (&mask (:C Col))))

(DET &cell_split_split1
  (&cell *E (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *Across_)))

(DET &cell_split
  (&cell *E *P *Col)
  (axis_elem *A)
  (&cell_split_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:Across_ *Across)))

(DET &apos_split1
  (ex_input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X P_) (:X_rel *X_m1_)))

(DET &apos
  (ex_input *P)
  (axis_elem *A)
  (&apos_split1 (:P_ P) (:A_ A) (:Along_ *Along) (:X_m1_ *X_m1)))

(DET &ext_cand
  (&apos *A *Along)
  (sub_extent (:P Along) A *K)
  (axis_of *D A)
  (edge_inset D K *B))

(DET &ext_map
  (&ext_cand *A *B)
  (&apos A *Along)
  (axis_inversion A (:T *F))
  (compose (:A Along) B (:C *Lm))
  (apply (:D F) (:P Lm) (:P_out *L_img))
  (&apos A (:Along *Along2))
  (compose (:A Along2) B (:C L_img)))

(DET &ext_mismatch
  (&ext_map *A *B (:Along *L1) (:Along2 *L2))
  (&cell_split *E A (:Along L1) (:Across *X) (:Col *C1))
  (&cell_split E A (:Along L2) (:Across X) (:Col *C2))
  (!= C2 C1))

(DET &ext_pair
  (&ext_map *A *B (:Along *L1) (:Along2 *L2))
  (!= L1 L2)
  (&cell_split *E A (:Along L1) (:Across *X))
  (&cell_split E A (:Along L2) (:Across X)))

(DET &axis_ext
  (&ext_pair *A *B)
  (NOT (&ext_mismatch A B)))

(DET &mosaic_margin
  (&axis_ext (:A *A1) (:B *B1))
  (perp (:A A1) *A2)
  (&axis_ext (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(DET &mcell
  (&cell *E (:P *P2) *Col)
  (&mosaic_margin *B)
  (compose (:A P2) B (:C *P)))

(DET &cand_count
  (&mcell *P)
  (axis_elem *A)
  (sub_extent P A (:K *N)))

(DET &cand_tile_division_cell
  (&mcell *P)
  (&cand_count (:N *Key)))

(INIT &cand_tile_division_sides ExtentDivisions
  (key ((&cand_tile_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&cand_tile_division_cell (:Key Ky) *P))))

(DET &cand_tile_division_axis_split1
  (&cand_tile_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &cand_tile_division_parts_held
  (axis_elem *A)
  (&cand_count *N))

(DET &cand_tile_division_axis
  (OR ((&cand_tile_division_cell *Key *P)
       (axis_elem *A)
       (&cand_count (:N Key))
       (&cand_tile_division_sides.division (:key (:Ky Key)) A (:N Key) *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&cand_tile_division_cell Key P)
       (axis_elem A)
       (&cand_count (:N Key))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N Key)))
      ((&cand_tile_division_cell Key P)
       (axis_elem A)
       (NOT (&cand_tile_division_parts_held (:N Key) A))
       (&cand_tile_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(DET &cand_tile_division_tile
  (&cand_tile_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&cand_tile_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; The hole: the masked cells.
(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&mask (:C Col))))

(RULE &mosaic
  (input (:P *P_grid))
  (&mosaic_margin *B)
  (compose (:A P_grid) B (:C *P_mosaic)))

(INIT &output_division_sides ExtentDivisions
  (frame ((:P Pm))
    (&bbox.cell *P)
    (&mosaic (:P_grid P) (:P_mosaic *Pm))))

(DET &broken
  (&mcell *E *P (:Col *V))
  (d4_elem *D)
  (apply D P (:P_out *P2))
  (&mcell E (:P P2) (:Col *V2))
  (!= V2 V))

(DET &cand_tile
  (&cand_tile_division_tile (:Key *N) *P (:P_outer *P_tile)))

(DET &cand_broken
  (&cand_tile *N (:P *Pm) *P_tile)
  (&broken (:P Pm) *D))

(DET &cand_sym
  (&cand_tile *N *P_tile)
  (d4_elem *D)
  (NOT (&cand_broken N P_tile D)))

;; The tile count is the coarsest decomposition whose tile labels differ.
(INIT &nonuniform Order
  (member ((:t N))
    (&cand_sym *N (:P_tile *T1) *D)
    (&cand_tile N (:P_tile *T2))
    (NOT (&cand_sym N (:P_tile T2) D)))
  (score ((:t N) (:S N))
    (&cand_sym *N (:P_tile *T1) *D)
    (&cand_tile N (:P_tile *T2))
    (NOT (&cand_sym N (:P_tile T2) D))))

;; Each tile's group is the named subgroup matching its unbroken set.
(INIT &symid Inclusion
  (pattern ((:pattern S) (:m D))
    (sym_member *S *D))
  (observed ((:observed T) (:m D))
    (&nonuniform.minimal (:t *N))
    (&cand_sym N (:P_tile *T) *D)))

(DET &tile_sym
  (&symid.equal (:observed *P_tile) (:pattern *S)))

(RULE &tile_count
  (&tile_sym (:P_tile *T))
  (axis_elem *A)
  (frame_extent (:P T) A *N))

(RULE &output_division_axis_split1
  (&mosaic (:P_grid *P) (:P_mosaic *Pm_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Pm_) (:D D_m1) (:K *K1_m3))
  (margin (:B Pm_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X Pm_) (:X_rel *X_m1_)))

(RULE &output_division_parts
  (axis_elem *A)
  (&tile_count *N))

(RULE &output_division_axis
  (OR ((&bbox.cell (:P *P2))
       (&mosaic (:P_grid P2) (:P_mosaic *P))
       (axis_elem *A)
       (&tile_count *N)
       (&output_division_sides.division A N *K (:G 0))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((&bbox.cell (:P *P22))
       (&mosaic (:P_grid P22) (:P_mosaic P))
       (axis_elem A)
       (&tile_count (:N *N2))
       (frame_extent P A (:N *K2))
       (axis_of (:D *D2) A)
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) A (:N K2))
       (frame_extent (:P P_outer) A (:N N2)))
      ((&bbox.cell (:P *P23))
       (&mosaic (:P_grid P23) (:P_mosaic P))
       (axis_elem A)
       (NOT (&output_division_parts A))
       (&output_division_axis_split1 (:Pm_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &output_division_tile
  (&output_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&output_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; The mosaic's own symmetries, per example.
(INIT &inv Agreement
  (key ((&mcell ^E *P *Col))
    (source ((:i P) (:v Col))
      (&mcell E *P *Col))
    (target ((:i P) (:v Col))
      (&mcell E *P *Col))
    (correspondence ((:m D) (:i P) (:j Q))
      (&mcell E *P *Col)
      (d4_elem *D)
      (apply D P (:P_out *Q)))))

(RULE &output
  (&bbox.cell (:P *P3))
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P3) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P3) (:X_rel *P))
  (&mosaic (:P_grid P3) (:P_mosaic *Pm))
  (&output_division_tile (:P Pm) (:P_outer *T))
  (&tile_sym (:P_tile T) *S)
  (sym_member S *D)
  (apply D (:P Pm) (:P_out *P2m))
  (&mosaic (:P_grid *P2) (:P_mosaic P2m))
  (input (:P P2) *Col)
  (NOT (&mask (:C Col))))
