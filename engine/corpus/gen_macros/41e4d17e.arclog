;; 41e4d17e

(RULE &objects_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &objects Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&objects_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &objects_component
  (&objects.class (:a *P) *Id))

;; The color the lines are drawn in.
(DET &paint AnyOutNewColor)

(RULE &caster
  (&objects_component *P (:Id *Ca)))

(ALTS $choice "a square's outline and its hole share a center, so what casts is underdetermined" $Object
  (ALT $Hole
    (RULE &holes_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &holes_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &holes_cell
      (input *P *Col)
      (&bg (:C Col)))

    (INIT &holes_flood Propagation
      (source ((:n P))
        (&holes_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (input P *Col)
        (&bg (:C Col)))
      (edge ((:a P) (:b P2))
        (input *P *Col)
        (&bg (:C Col))
        (&holes_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (input (:P P2) (:Col *Col2))
        (&bg (:C Col2))))

    (RULE &holes_node
      (&holes_cell *P)
      (NOT (&holes_flood.reached (:n P))))

    (INIT &holes Quotient
      (edge ((:a P) (:b P2))
        (OR ((&holes_node *P)
             (&holes_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&holes_node (:P P2)))
            ((&holes_node P)
             (= P2 P)))))

    (RULE &holes_component
      (&holes.class (:a *P) *Id))

    (RULE &caster
      (&holes_component *P (:Id *Ca)))))

(INIT &frame BoundingBox
  (key ((&caster (:Ca ^Id) *P))
    (cell (P)
      (&caster (:Ca Id) *P))))

(RULE &painted
  (input *P *Col)
  (&bg (:C Col))
  (input (:P *P_c))
  (&frame.box *B)
  (ALL ((&frame.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P_c) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3m)))
       ((>= K_m3m 0)))
  (relative (:Base B) (:X P_c) (:X_rel *P_inner))
  (ALL ((&frame.box (:B *Bm))
        (input (:P *P_cm))
        (relative (:Base Bm) (:X P_cm) (:X_rel P_inner))
        (opposite (:D *D_m1m) (:Opp *O_m2))
        (margin (:B P_inner) (:D D_m1m) (:K *K1_m3))
        (margin (:B P_inner) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4)))
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P_c) (:D D_m2) (:K K_m3)))

(RULE &output
  (input *P (:Col *C_in))
  (IF ((&painted P))
      ((&paint (:C *Col)))
      ((= Col C_in))))
