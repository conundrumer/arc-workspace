;; 7e02026e

(DET &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &field SharedColor)

(DET &mark AnyOutNewColor)

(DET &changed
  (ex_input *E *P (:Col *C1))
  (&field (:C C1))
  (ex_output E P (:Col *C2))
  (&mark (:C C2)))

(INIT &comps Quotient
  (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
    (OR ((&changed *E *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&changed E (:P P3)))
        ((&changed E P)
         (= P3 P)))))

(DET &comps_component
  (&comps.class (:a *Key *P) *Id))

(DET &comp_cell
  (&comps_component (:Key *E) *P *Id))

(INIT &comp_size Cardinality
  (key ((&comp_cell ^E ^Id *P))
    (member ((:m P))
      (&comp_cell E Id *P))))

(INIT &smallest Order
  (member ((:t (:E K_e) (:Id K_id) (:S N)))
    (&comp_size.size (:key (:E *K_e) (:Id *K_id)) *N))
  (score ((:t (:E K_e) (:Id K_id) (:S N)) (:S N))
    (&comp_size.size (:key (:E *K_e) (:Id *K_id)) *N)))

;; The smallest changed component is a single stamp.
(INIT &stamp BoundingBox
  (key ((&smallest.minimal (:t ^E ^Id)))
    (cell (P)
      (&comp_cell E Id *P))))

(DET &shape_inside1
  (&stamp.cell (:key (:E *K_e) (:Id *K_id)) (:P *P_))
  (&stamp.box (:key (:E K_e) (:Id K_id)) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &field_at
  (input *P *Col)
  (&field (:C Col)))

(DET &shape
  (&stamp.cell (:key (:E *K_e) (:Id *K_id)) (:P *P2))
  (&stamp.box (:key (:E K_e) (:Id K_id)) *B)
  (NOT (&shape_inside1 (:P_ P2) (:B_ B)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

(INIT &occ Occurrences
  (cell (P)
    (&field_at *P))
  (shape (P)
    (&shape *P)))

(RULE &shape_covered
  (&occ.occurrence (:P *M))
  (&shape (:P *S))
  (compose (:A M) (:B S) (:C *P)))

(ALTS $choice "how the plus footprint is found" $Shape
  (ALT $Flank
    (INIT &exposed Boundary
      (cell (P)
        (&field_at *P)))

    (RULE &flanked
      (&field_at *P)
      (NOT (&exposed.boundary P)))

    (RULE &flank_covered
      (OR ((&flanked *P))
          ((&flanked (:P *P3))
           (dir_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A P3) (:B V_m1) (:C P)))))

    (RULE &output
      (OR ((&flank_covered *P)
           (&mark (:C *Col)))
          ((input P Col)
           (NOT (&flank_covered P)))))))

(RULE &output
  (OR ((&shape_covered *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&shape_covered P)))))
