;; 543a7ed5

(RULE &outside_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &shape_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &shape_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Each shape and the box that bounds it.
(INIT &shape Quotient
  (edge ((:a P) (:b P3))
    (OR ((&shape_cell *P)
         (&shape_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&shape_cell (:P P3)))
        ((&shape_cell P)
         (= P3 P)))))

(RULE &shape_component
  (&shape.class (:a *P) *Id))

(DET &fill AnyOutNewColor)

(DET &outline AnyOutNewColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

;; The bg the shapes leave open to the grid edge.
(INIT &outside Propagation
  (source ((:n P))
    (&bg_cell *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0)))
  (edge ((:a P) (:b P2))
    (&bg_cell *P)
    (&outside_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&bg_cell (:P P2))))

(INIT &shape_box BoundingBox
  (key ((&shape_component *P ^Id))
    (cell (P)
      (&shape_component *P Id))))

(RULE &within
  (input *P)
  (&shape_box.box (:key *Id) *B)
  (ALL ((&shape_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &fill_cell
  (&bg_cell *P)
  (NOT (&outside.reached (:n P))))

(RULE &outline_cell
  (&outside.reached (:n *P))
  (&shape_cell (:P *P_shape))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_shape) (:B V_m1) (:C P)))

(ALTS $fill "which bg counts as inside a shape" $Enclosed
  (ALT $Boxed
    (RULE &fill_cell
      (&bg_cell *P)
      (&within P))))

(ALTS $outline "which bg counts as just outside a shape" $Band
  (ALT $Ring
    (DET &ring_width DivisorRatio)

    (RULE &ring_box_uniform_outset1
      (&ring_width (:K *K_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m7))
      (edge_inset (:D D1_m1) (:K K_) (:B *B1_m8))
      (edge_inset (:D O_m7) (:K K_) (:B *B2_m9))
      (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m10))
      (edge_inset (:D D2_m4) (:K K_) (:B *B1_m11))
      (edge_inset (:D O_m10) (:K K_) (:B *B2_m12))
      (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *I_m1))
      (relative (:Base I_m1) (:X 0) (:X_rel *B_frame_)))

    (RULE &ring_box
      (&shape_box.box (:key *Id) (:B *B_shape))
      (&ring_width *K)
      (&ring_box_uniform_outset1 (:K_ K) (:B_frame_ *B_frame))
      (compose (:A B_frame) (:B B_shape) (:C *B)))

    (RULE &ring
      (input *P)
      (&ring_box *Id *B)
      (ALL ((&ring_box (:Id *Idm) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (NOT (&within Id P)))

    (RULE &outline_cell
      (&bg_cell *P)
      (&ring P))))

(RULE &output
  (OR ((&fill_cell *P)
       (&fill (:C *Col)))
      ((&outline_cell P)
       (&outline (:C Col)))
      ((input P Col)
       (NOT (&fill_cell P))
       (NOT (&outline_cell P)))))
