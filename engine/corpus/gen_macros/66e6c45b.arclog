;; 66e6c45b

(RULE &gdp_nearer
  (input *P)
  (dir_elem *D)
  (opposite D (:Opp *O_m1))
  (margin (:B P) D *K)
  (margin (:B P) (:D O_m1) (:K *K2))
  (< K K2))

(RULE &gdp_quadrant
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (&gdp_nearer *P (:D D1))
  (&gdp_nearer P (:D D2)))

(RULE &gdp_diag_cell
  (&gdp_quadrant *P *Diag)
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) (:K *Ring))
  (margin (:B P) (:D D2_m3) (:K Ring)))

(DET &bg DominantColor)

(RULE &shape
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &target
  (&shape (:P *P2) *Col)
  (&gdp_quadrant (:P P2) *Diag)
  (&gdp_diag_cell *P Diag (:Ring 0)))

(INIT &bb BoundingBox
  (cell (P)
    (&shape *P)))

(ALTS $choice "hypotheses of the motion" $Quad
  (ALT $Stretch
    (RULE &target
      (&shape (:P *P2) *Col)
      (&bb.box *B)
      (ALL ((&shape (:P P2) (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (&gdp_diag_cell *P *Diag (:Ring 0))
      (ALL ((&gdp_diag_cell (:P *P_cornerm) Diag (:Ring 0))
            (&shape (:P P2) (:Col *Colmm))
            (corner_dir (:C Diag) (:D *D_m1m))
            (margin (:B P2) (:D D_m1m) (:K *K1_m2))
            (margin B (:D D_m1m) (:K *K2_m3)))
           ((= K1_m2 K2_m3)))))
  (ALT $Explode
    (RULE &target
      (&shape (:P *P2) *Col)
      (&bb.box *B)
      (ALL ((&shape (:P P2) (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
      (margin (:B P2) (:D D1_m2) (:K *K1_m5))
      (margin B (:D D1_m2) (:K K1_m5))
      (margin (:B P2) (:D D2_m4) (:K *K2_m6))
      (margin B (:D D2_m4) (:K K2_m6))
      (step_offset (:D Diag) (:V *V_m7))
      (compose (:A P2) (:B V_m7) (:C *P))))
  (ALT $Table
    (DET &cand
      (ex_input *E (:P *P_in) (:Col *C))
      (NOT (&bg C))
      (ex_output E (:P *P_out) (:Col C)))

    (DET &broken
      (&cand *P_in *P_out)
      (ex_output *E)
      (NOT (&cand E P_in P_out)))

    (DET &pair
      (&cand *P_in *P_out)
      (NOT (&broken P_in P_out)))

    (INIT &ident Quotient
      (equivalent ((:a P_in) (:b P_in))
        (&pair *P_in)))

    (DET &in_label
      (&pair (:P_in *P))
      (&ident.class (:a P) *Id))

    (DET &out_label
      (&pair *P_in (:P_out *P))
      (&ident.class (:a P_in) *Id))

    (RULE &map
      (&in_label (:P *P_in) *Id)
      (&out_label (:P *P_out) Id))

    (RULE &target
      (input (:P *P_in) *Col)
      (&map P_in (:P_out *P)))))

(RULE &output
  (OR ((&target *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&target P)))))
