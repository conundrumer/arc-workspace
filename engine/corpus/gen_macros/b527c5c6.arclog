;; b527c5c6

(INPUT bars "the input holds solid rectangles of &bar_color on &background, apart from one another, each at least two cells thick and longer along one axis than across it"

  (DET_OR_RULE &background DominantColor)

  (DET &bar_color UnchangedColor))

(INPUT one-mark-per-bar "each bar holds exactly one cell of &mark_color, on one of its long sides, with at least the bar's thickness less one cells of that side on each side of it; the bar holds no other color"

  (DET &mark_color RarestColor))

(INPUT clear-paths "the beam of each bar crosses only &background cells, so no beam meets another bar or another beam")

(OUTPUT beam-direction "a bar's beam leaves the side of the bar that holds its mark, toward the grid edge that side faces, and runs from the cell next to the bar up to that grid edge; where the mark sits on more than one side, the model is undefined")

(OUTPUT beam-core "the beam's center line is the mark's line across the bar; outside the bar, each of its cells takes &mark_color")

(OUTPUT beam-flanks "on each side of the center line, the beam is as wide as the bar's extent across the marked side less one (the distance from the mark to the bar's far side), and each flank cell takes &bar_color; a flank cell past the grid edge is dropped")

(OUTPUT keep-rest "every cell outside the beams keeps its input color"

  (RULE &piece_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The pieces: the components of the non-background cells.
  (INIT &piece Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&background Col))
           (&piece_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&background (:Col Col2))))
          ((input P (:Col *Col3))
           (NOT (&background (:Col Col3)))
           (= P3 P)))))

  (RULE &piece_component
    (&piece.class (:a *P) *Id))

  (RULE &mark_cand
    (&piece_component *P *Id)
    (input P *Col)
    (&mark_color (:C Col)))

  (INIT &mark Singleton
    (key ((&mark_cand ^Id *P))
      (member ((:v P))
        (&mark_cand Id *P))))

  (INIT &piece_box BoundingBox
    (key ((&piece_component *P ^Id))
      (cell (P)
        (&piece_component *P Id))))

  (RULE &mark_side
    (&mark.value (:key *Id) (:v *Q))
    (&piece_box.box (:key Id) *B)
    (ALL ((&mark.value (:key (:Id *Idm)) (:v Q))
          (&piece_box.box (:key (:Id Idm)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B Q) *D (:K *K_m1))
    (margin B D (:K K_m1)))

  (INIT &side Singleton
    (key ((&mark_side ^Id *D))
      (member ((:v D))
        (&mark_side Id *D))))

  (RULE &beam
    (&side.value (:key *Id) (:v *D))
    (&mark.value (:key Id) (:v *Q))
    (&piece_box.box (:key Id) *B))

  (RULE &foot_split1
    (&beam *Q (:B *B_) *D)
    (axis_of D (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B_slab_))
    (relative (:Base B_slab_) (:X B_) (:X_rel *X_m1_)))

  (RULE &body_cand
    (&piece_box.box (:key *Id))
    (&bar_color (:C *Col)))

  (INIT &body Singleton
    (key ((&body_cand ^Id *Col))
      (member ((:v Col))
        (&body_cand Id *Col))))

  ;; The foot lies within the bar's rows or columns across the marked side.
  (RULE &foot
    (&beam *Q *B *D)
    (axis_of D *A)
    (&foot_split1 (:B_ B) (:A_ A) (:B_slab_ *B_slab) (:X_m1_ *X_m1))
    (input (:P *F))
    (ALL ((&beam (:Q *Qm) (:B *Bm) (:D *Dm))
          (axis_of (:D Dm) (:A *Am))
          (axis_of (:D *D_m2) (:A Am))
          (opposite (:D D_m2) (:Opp *O_m3))
          (margin (:B Bm) (:D D_m2) (:K *K1_m4))
          (margin (:B Bm) (:D O_m3) (:K *K2_m5))
          (opposite (:D D_m2) (:Opp *O_m6))
          (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
          (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
          (compose (:A B1_m7) (:B B2_m8) (:C B_slab))
          (relative (:Base B_slab) (:X Bm) (:X_rel *Across_m1))
          (dir_elem (:D *D_m1))
          (relative (:Base B_slab) (:X F) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (diag_axis_elem *Da)
    (diag_perp Da (:Da2 *A2_m2))
    (diag_axis_of (:D *D_m3) (:Da A2_m2))
    (corner_dist (:P Q) (:Diag D_m3) (:K *K_m4))
    (corner_dist (:P F) (:Diag D_m3) (:K K_m4)))

  (RULE &beam_cell
    (&foot *Q *F)
    (&beam Q *D)
    (axis_of D *A)
    (input *P)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B F) (:D D_m2) (:K *K_m3))
    (margin (:B P) (:D D_m2) (:K K_m3))
    (dir_elem D)
    (margin (:B P) D (:K *K1_m4))
    (margin (:B Q) D (:K *K2_m5))
    (< K1_m4 K2_m5))

  (RULE &stroke
    (&beam_cell *Q *F *P))

  (RULE &flank
    (&stroke *Q *F *P)
    (!= F Q)
    (&piece_component (:P Q) *Id)
    (&body.value (:key Id) (:v *Col))))

(ALTS $side "which side of the bar the beam leaves" $MarkSide
  (ALT $LongSide
    (OUTPUT beam-direction "the beam leaves the long side of the bar that holds the mark, and the flank width is the bar's thickness less one; undefined on a square bar, on a mark on a short side away from the corners, and on a bar one cell thick"
      ;; A long side: the bar is thinner across it than along it.
      (RULE &mark_side
        (&mark.value (:key *Id) (:v *Q))
        (&piece_box.box (:key Id) *B)
        (ALL ((&mark.value (:key (:Id *Idm)) (:v Q))
              (&piece_box.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X Q) (:X_rel *R_m2m))
              (margin (:B R_m2m) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B Q) *D (:K *K_m1))
        (margin B D (:K K_m1))
        (axis_of D *A)
        (perp A *A2)
        (axis_elem A)
        (relative (:Base B) (:X Q) (:X_rel *R_m2))
        (frame_extent (:P R_m2) A (:N *N1))
        (axis_elem (:A A2))
        (relative (:Base B) (:X Q) (:X_rel *R_m3))
        (frame_extent (:P R_m3) (:A A2) (:N *N2))
        (< N1 N2)))))

(ALTS $span "how far the flanks reach along the marked side" $PastEnd
  (ALT $ClipToBar
    (OUTPUT beam-flanks "a flank line outside the bar's span along the marked side is dropped; undefined where the concept is"
      ;; The foot lies within the bar.
      (RULE &foot
        (&beam *Q *B)
        (input (:P *F))
        (ALL ((&beam (:Q *Qm) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X F) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3m)))
             ((>= K_m3m 0)))
        (diag_axis_elem *Da)
        (diag_perp Da (:Da2 *A2_m1))
        (diag_axis_of (:D *D_m2) (:Da A2_m1))
        (corner_dist (:P Q) (:Diag D_m2) (:K *K_m3))
        (corner_dist (:P F) (:Diag D_m2) (:K K_m3))))))

(ALTS $block "what a beam does at a non-background cell on its path" $PaintOver
  (ALT $Underlay
    (OUTPUT beam-core "a beam cell takes its color only where the input is &background, and the beam runs on past the cell; undefined where the concept is"
      (RULE &stroke
        (&beam_cell *Q *F *P)
        (input P *Col)
        (&background Col)))
    (OUTPUT beam-flanks "a flank cell takes &bar_color only where the input is &background"))
  (ALT $Blocked
    (OUTPUT beam-direction "each line of the beam ends at the cell before its first non-background cell; undefined where the concept is"
      (RULE &stopped
        (&beam_cell *Q *F *D *P)
        (&beam_cell Q F D (:P *P2))
        (input (:P P2) *Col)
        (NOT (&background Col))
        (dir_elem D)
        (margin (:B P2) D (:K *K1_m1))
        (margin (:B P) D (:K *K2_m2))
        (>= K1_m1 K2_m2))

      (RULE &stroke
        (&beam_cell *Q *F *P)
        (NOT (&stopped Q F P))))))

(ALTS $overlap "the color of a cell where two beams give different colors" $NoOverlap
  (ALT $CoreOnTop
    (OUTPUT core-on-top "where beams overlap, a core cell covers a flank cell; undefined where two flanks or two cores of different colors overlap"
      (RULE &core
        (&stroke *Q (:F Q) *P)))
    (RULE &paint
      (OR ((&flank *P *Col)
           (NOT (&core P)))
          ((&stroke *Q (:F Q) P)
           (input (:P Q) Col))))))

(ALTS $colors "where the beam's colors come from" $StoredColors
  (ALT $OwnColors
    (INPUT bars "each non-background piece is a solid rectangle of one color with one cell of another color; undefined where a piece is not such a rectangle")
    (INPUT one-mark-per-bar "the mark is the piece's one cell of the other color")
    (OUTPUT beam-core "the core takes the mark's color"
      (RULE &repeated
        (&piece_component (:P *P1) *Id)
        (input (:P P1) *Col)
        (&piece_component (:P *P2) Id)
        (input (:P P2) Col)
        (!= P1 P2))

      (RULE &mark_cand
        (&piece_component *P *Id)
        (input P *Col)
        (NOT (&repeated Id Col)))

      (RULE &body_cand
        (&repeated *Id *Col)))
    (OUTPUT beam-flanks "the flanks take the rectangle's color")
    (RULE &bad_piece
      (OR ((&hollow *Id))
          ((&piece_box.box (:key Id))
           (OR ((NOT (&mark.value (:key Id))))
               ((NOT (&body.value (:key Id))))))))))

(RULE &hollow
  (&piece_box.box (:key *Id) *B)
  (input *P)
  (ALL ((&piece_box.box (:key (:Id *Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&piece_component P Id)))

(RULE &bad_piece
  (OR ((&hollow *Id))
      ((&piece_box.box (:key Id))
       (OR ((NOT (&mark.value (:key Id))))
           ((NOT (&body.value (:key Id))))))
      ;; A piece with a cell of neither color.
      ((&piece_component *P Id)
       (input P *Col)
       (NOT (&mark_color (:C Col)))
       (NOT (&bar_color (:C Col))))))

(RULE &undefined
  (OR ((&bad_piece))
      ((&mark.value (:key *Id))
       (NOT (&side.value (:key Id))))))

(RULE &paint
  (OR ((&stroke *Q (:F Q) *P)
       (input (:P Q) *Col))
      ((&flank P Col))))

(RULE &output
  (NOT (&undefined))
  (input *P (:Col *Col_in))
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (= Col Col_in))))
