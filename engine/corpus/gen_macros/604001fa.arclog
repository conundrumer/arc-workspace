;; 604001fa

(RULE &object_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

(RULE &object_node
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &object Quotient
  (edge ((:a P) (:b P2))
    (OR ((&object_node *P)
         (&object_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&object_node (:P P2)))
        ((&object_node P)
         (= P2 P)))))

(RULE &object_component
  (&object.class (:a *P) *Id))

(DET &mark RarestColor)

(INIT &bbox BoundingBox
  (key ((&object_component *P ^Id)
        (input P *Col)
        (&mark (:C Col)))
    (cell (P)
      (&object_component *P Id)
      (input P *Col)
      (&mark (:C Col)))))

(RULE &filled_corner_inside1
  (&bbox.cell (:key *Id) (:P *P_))
  (&bbox.box (:key Id) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(RULE &missing_corner
  (&bbox.cell (:key *Id))
  (diag_dir_elem (:D *Diag))
  (ALL ((&bbox.cell (:key Id) *P)
        (&bbox.box (:key Id) *B)
        (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
        (perp (:A A_m1) (:A2 *A2_m3))
        (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
        (margin (:B P) (:D D1_m2) (:K *K1_m5))
        (margin B (:D D1_m2) (:K K1_m5))
        (margin (:B P) (:D D2_m4) (:K *K2_m6))
        (margin B (:D D2_m4) (:K K2_m6)))
       ((&filled_corner_inside1 (:P_ P) (:B_ B)))))

(RULE &shape_cell
  (&object_component *P *Id)
  (input P *Col)
  (NOT (&mark (:C Col))))

(DET &corner_color
  (&missing_corner *E *Id *Diag)
  (&shape_cell E *P Id)
  (ex_output E P *Col))

(RULE &output
  (input *P)
  (OR ((&shape_cell P *Id)
       (&missing_corner Id *Diag)
       (&corner_color Diag *Col))
      ((NOT (&shape_cell P))
       (&bg (:C Col)))))
