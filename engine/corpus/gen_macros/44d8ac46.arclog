;; 44d8ac46

(DET &regions_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &fill AnyOutNewColor)

(DET &regions_node
  (ex_output (:E *Key) *P *Col)
  (&fill (:C Col)))

;; The output's fill cells; their components are the filled holes.
(INIT &regions Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&regions_node (:Key *Ky) *P)
         (&regions_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&regions_node (:Key Ky) (:P P2)))
        ((&regions_node (:Key Ky) P)
         (= P2 P)))))

(DET &regions_component
  (&regions.class (:a *Key *P) *Id))

(RULE &shape_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(INIT &shape Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&shape_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&bg (:C Col2))))
        ((input P (:Col *Col3))
         (NOT (&bg (:C Col3)))
         (= P3 P)))))

(RULE &shape_component
  (&shape.class (:a *P) *Id))

(RULE &boxed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &shape_box BoundingBox
  (key ((&shape_component *P ^Id))
    (cell (P)
      (&shape_component *P Id))))

(INIT &boxed Quotient
  (edge ((:a P) (:b P3))
    (OR ((&shape_box.box *B)
         (&bg_cell *P)
         (ALL ((dir_elem (:D *D_m1))
               (relative (:Base B) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (&boxed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&shape_box.box (:B *B2))
         (&bg_cell (:P P3))
         (ALL ((dir_elem (:D *D_m1m))
               (relative (:Base B2) (:X P3) (:X_rel *R_m2m))
               (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
              ((>= K_m3m 0))))
        ((&shape_box.box (:B *B3))
         (&bg_cell P)
         (ALL ((dir_elem (:D *D_m12))
               (relative (:Base B3) (:X P) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (= P3 P)))))

(RULE &boxed_component
  (&boxed.class (:a *P) *Id))

(RULE &hole
  (&boxed_component *P (:Id *H)))

(ALTS $r "what a hole is" $Box
  (ALT $Enclose
    (RULE &closed_flood_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (RULE &closed_cell
      (&bg_cell *P))

    (INIT &closed_flood Propagation
      (source ((:n P))
        (&closed_cell *P)
        (dir_elem *D)
        (margin (:B P) D (:K 0))
        (&bg_cell P))
      (edge ((:a P) (:b P2))
        (&bg_cell *P)
        (&closed_flood_steps (:Delta *S))
        (compose (:A P) (:B S) (:C *P2))
        (&bg_cell (:P P2))))

    (RULE &closed_node
      (&closed_cell *P)
      (NOT (&closed_flood.reached (:n P))))

    (INIT &closed Quotient
      (edge ((:a P) (:b P2))
        (OR ((&closed_node *P)
             (&closed_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P2))
             (&closed_node (:P P2)))
            ((&closed_node P)
             (= P2 P)))))

    (RULE &closed_component
      (&closed.class (:a *P) *Id))

    (RULE &hole
      (&closed_component *P (:Id *H)))))

(ALTS $t "which holes take the fill" $Block
  (ALT $Sym
    (RULE &sym_src
      (&cell *Key (:P *P2))
      (&bbox.box (:key (:Id Key)) *B)
      (ALL ((&cell (:Key *Km) (:P P2))
            (&bbox.box (:key (:Id Km)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P2) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P2) (:X_rel *P)))

    (INIT &sym Agreement
      (key ((OR ((&cell (:Key ^Id) *P)
                 (&bbox.box (:key Id) *B)
                 (ALL ((&cell (:Key *Km) P)
                       (&bbox.box (:key (:Id Km)) B)
                       (dir_elem (:D *D_m1))
                       (relative (:Base B) (:X P) (:X_rel *R_m2))
                       (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                      ((>= K_m3 0)))
                 (relative (:Base B) (:X P) (:X_rel *P_inner)))
                ((&sym_src (:Key Id) P))))
        (source ((:i P_inner))
          (&cell (:Key Id) *P)
          (&bbox.box *B)
          (ALL ((&cell (:Key *Km) P)
                (&bbox.box (:key (:Id Km)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (relative (:Base B) (:X P) (:X_rel *P_inner)))
        (target ((:i P))
          (&sym_src (:Key Id) *P))
        (correspondence ((:m D) (:i P_inner) (:j Q))
          (&cell (:Key Id) *P)
          (&bbox.box *B)
          (ALL ((&cell (:Key *Km) P)
                (&bbox.box (:key (:Id Km)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (relative (:Base B) (:X P) (:X_rel *P_inner))
          (d4_elem *D)
          (apply D (:P P_inner) (:P_out *Q)))))

    ;; The transforms every filled hole survives, named as a subgroup.
    (INIT &named Inclusion
      (pattern ((:pattern S) (:m D))
        (sym_member *S *D))
      (observed ((:m D))
        (d4_elem *D)
        (NOT (&sym.mismatch (:m D)))))

    (DET &hole_sym
      (&named.equal (:pattern *S)))

    (RULE &sym_gap
      (&hole_sym *S)
      (sym_member S *D)
      (&sym.mismatch (:key (:Id *H)) (:m D)))

    (RULE &filled
      (&hole *H)
      (NOT (&sym_gap H)))))

(RULE &cell
  (&hole (:H *Key) *P))

(INIT &bbox BoundingBox
  (key ((&cell (:Key ^Id) *P))
    (cell (P)
      (&cell (:Key Id) *P))))

(RULE &box_gap
  (&bbox.box (:key (:Id *H)) *B)
  (input *P)
  (ALL ((&bbox.box (:key (:Id *Hm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (NOT (&hole H P)))

(RULE &filled
  (&hole *H *P)
  (&bbox.box (:key (:Id H)) *B)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (perp A *A2)
  (axis_elem (:A A2))
  (relative (:Base B) (:X P) (:X_rel *R_m2))
  (frame_extent (:P R_m2) (:A A2) N)
  (NOT (&box_gap H)))

(RULE &painted
  (&hole (:H *Id) *P)
  (&filled (:H Id)))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))
