;; 952a094c

(DET &bg DominantColor)

;; The corner a mark heads for, as the transform of the corner it leaves.
(DET &eject D4Domain)

(RULE &drawn
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The drawn rectangle.
(INIT &bb BoundingBox
  (cell (P)
    (&drawn *P)))

(RULE &corner
  (&bb.box *B)
  (&drawn *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (corner_dir (:C *D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin B (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin B (:D D2_m4) (:K K2_m6)))

(RULE &inner
  (&corner *D (:P *P_c))
  (diag_opposite D (:Opp *D_in))
  (step_offset (:D D_in) (:V *V_m1))
  (compose (:A P_c) (:B V_m1) (:C *P)))

(RULE &mark
  (&inner *D *P)
  (input P *Col)
  (NOT (&bg (:C Col))))

(ALTS $choice "what a mark is, and which corner it leaves from" $Corner
  (ALT $Quadrant
    (RULE &enclosed
      (input *P *Col)
      (NOT (&bg (:C Col)))
      (&bb.box *B)
      (ALL ((input P (:Col *Colm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((> K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_rel)))

    (RULE &quad_nearer
      (&enclosed (:P_rel *P))
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (RULE &quad_quadrant
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&quad_nearer *P (:D D1))
      (&quad_nearer P (:D D2)))

    (RULE &mark
      (&enclosed *P *Col *P_rel)
      (&quad_quadrant (:P P_rel) (:Diag *D)))))

(RULE &landing
  (&mark *D *Col)
  (&eject (:D *R))
  (d4_elem (:D R))
  (diag_dir_elem D)
  (diag_dir_elem (:D *D_out))
  (step_offset D (:V *S_m1))
  (apply (:D R) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D D_out) (:V S2_m2))
  (&corner (:D D_out) (:P *P_c))
  (step_offset (:D D_out) (:V *V_m3))
  (compose (:A P_c) (:B V_m3) (:C *P)))

(RULE &output
  (OR ((&landing *P *Col))
      ((input P (:Col *Col_in))
       (NOT (&landing P))
       (IF ((&mark P))
           ((&bg (:C Col)))
           ((= Col Col_in))))))
