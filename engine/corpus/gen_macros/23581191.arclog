;; 23581191

(DET &bg DominantColor)

(DET &cross_color AnyOutNewColor)

(RULE &cross
  (input (:P *Q) *Col)
  (NOT (&bg (:C Col)))
  (input *P)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B Q) (:D D_m2) (:K K_m3)))

(INIT &cover_color Singleton
  (key ((&cross ^P *Col))
    (member ((:v Col))
      (&cross P *Col))))

(RULE &collide
  (&cover_color.plural (:key *P)))

(ALTS $choice "what counts as a meeting" $Color
  (ALT $Mark
    (INIT &cover_mark Singleton
      (key ((&cross ^P *Q))
        (member ((:v Q))
          (&cross P *Q))))

    (RULE &collide
      (&cover_mark.plural (:key *P)))))

(RULE &output
  (input *P)
  (OR ((&collide P)
       (&cross_color (:C *Col)))
      ((&cross P Col)
       (NOT (&collide P)))
      ((NOT (&cross P))
       (&bg (:C Col)))))
