;; 1190e5a7

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:P_line_ ^P_line) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:P_line_ P_line) (:X_m1_ *X_m1)))))

(RULE &bands_node
  (&line_color.member (:key (:A *Key) (:P_line *P)) (:v *Col))
  (NOT (&line_color.value (:v Col))))

(RULE &bands_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

;; A band is a run of adjacent non-divider lines — one row or column of
;; regions. A divider color is one that fills a whole line.
(INIT &bands Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&bands_node (:Key *Ky) *P)
         (&bands_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&bands_node (:Key Ky) (:P P2)))
        ((&bands_node (:Key Ky) P)
         (= P2 P)))))

(RULE &bands_component
  (&bands.class (:a *Key *P) *Id))

;; One output line per band. Band line sets are disjoint runs, as OrderFrame
;; assumes.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t B))
      (&bands_component (:Key A) (:P *P_line) (:Id *B)))
    (before ((:a B) (:b B2))
      (&bands_component (:Key A) (:P *P_line) (:Id *B))
      (&bands_component (:Key A) (:P *P_line2) (:Id *B2))
      (!= B B2)
      (margin (:B P_line) D (:K *K1))
      (margin (:B P_line2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &out_split1
  (input (:P *P_in_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_in_) (:X_rel *P_line2_)))

(RULE &output
  (input (:P *P_in) *Col)
  (axis_elem *A)
  (perp A *A2)
  (&out_split1 (:P_in_ P_in) (:A_ A) (:P_line_ *P_line) (:P_line2_ *P_line2))
  (&bands_component (:Key A) (:P P_line) (:Id *B))
  (&bands_component (:Key A2) (:P P_line2) (:Id *B2))
  (&layout_pos (:Key A) (:M B) *P_pos)
  (&layout_pos (:Key A2) (:M B2) (:P_pos *P_pos2))
  (compose (:A P_pos) (:B P_pos2) (:C *P)))
