;; a096bf4d

(INPUT tile-lattice "full rows and full columns of &separator cut the grid into a lattice of equal tiles, with a separator line along each grid edge"

  (DET &separator SharedColor)

  (INIT &border Singleton
    (member ((:v Col))
      (input *P *Col)
      (dir_elem *D)
      (margin (:B P) D (:K 0)))))

(INPUT common-tile "at each tile position, most tiles hold the same color; together those colors form the common tile (a frame of one color around a 2×2 interior of the frame color and a pattern color)")

(INPUT marks "a mark is a tile cell whose color differs from the common tile's color at that position"

  (RULE &separator2
    (&separator (:C *Col)))

  (RULE &lattice_cell
    (&separator2)
    (input *P))

  (RULE &item_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  (INIT &line_color Singleton
    (key ((input *P *Col)
          (axis_elem ^A)
          (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
      (member ((:v Col))
        (input *P *Col)
        (axis_elem A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

  (RULE &lattice_divider
    (&line_color.value (:key *A *L) (:v *Col))
    (&separator2 Col))

  (RULE &lattice_on_divider
    (&lattice_cell *P)
    (&lattice_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  (INIT &lattice_rank Order
    (key ((OR ((&lattice_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((&lattice_cell *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&lattice_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&lattice_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((&lattice_cell *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (&lattice_cell *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &lattice_part_idx
    (&lattice_cell *P)
    (axis_of *D *A)
    (NOT (&lattice_on_divider P A))
    (margin (:B P) D *K)
    (&lattice_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &lattice_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&lattice_part_idx *P D (:N *N1))
    (&lattice_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE &lattice_tile_of
    (&lattice_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&lattice_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (INIT &tile_box BoundingBox
    (key ((&lattice_tile_of (:P *P_grid) ^P_tile))
      (cell ((:P P_grid))
        (&lattice_tile_of (:P *P_grid) P_tile))))

  (RULE &tile_cell
    (input (:P *P_grid) *Col)
    (&tile_box.box (:key *P_tile) *B)
    (ALL ((input (:P P_grid) (:Col *Colm))
          (&tile_box.box (:key (:P_tile *P_tilem)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P_grid) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P_grid) (:X_rel *P_intile)))

  (INIT &common_count Cardinality
    (key ((&tile_cell *P_tile ^P_intile ^Col))
      (member ((:m P_tile))
        (&tile_cell *P_tile P_intile Col))))

  (INIT &common Order
    (key ((&common_count.size (:key ^P_intile *Col)))
      (member ((:t Col))
        (&common_count.size (:key P_intile *Col)))
      (score ((:t Col) (:S N))
        (&common_count.size (:key P_intile *Col) *N))))

  ;; The number of tile positions where the common tile holds each color.
  (INIT &palette Cardinality
    (key ((&common.maximal (:key *P_intile) (:t ^Col)))
      (member ((:m P_intile))
        (&common.maximal (:key *P_intile) (:t Col)))))

  (INIT &pattern Order
    (member ((:t (:V Col) (:S N)))
      (&palette.size (:key *Col) *N))
    (score ((:t (:V Col) (:S N)) (:S N))
      (&palette.size (:key *Col) *N))))

(INPUT every-mark-paired "each mark has at least one other mark of the same color at the same tile position, in a tile of the same tile row or the same tile column")

(OUTPUT span-fill "for two marks of the same color at the same tile position, in tiles of the same tile row or tile column, each tile from one of those tiles to the other, both included, takes that color at that position")

(OUTPUT rest-kept "every other cell keeps its input color"

  (RULE &in_scope
    (&common.maximal (:key *P_intile)))

  (RULE &mark
    (&in_scope *P_intile)
    (&tile_cell *P_tile P_intile *Col)
    (NOT (&common.maximal (:key P_intile) (:t Col))))

  (RULE &span_mark
    (&mark (:P_tile *P) *P_intile *Col))

  (RULE &span_axis
    (&span_mark *P_intile *Col)
    (axis_elem *A))

  (RULE &span_dir
    (&span_axis *P_intile *Col *A)
    (axis4_of *D A))

  (RULE &span_node
    (&span_axis *P_intile *Col)
    (input *P))

  (RULE &span_source
    (&mark (:P_tile *P) *P_intile *Col))

  (INIT &span Distance
    (key ((&span_source (:P_intile ^Ky_p_intile) (:Col ^Ky_col) (:P ^O))
          (&span_dir (:P_intile Ky_p_intile) (:Col Ky_col) ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&span_source (:P_intile Ky_p_intile) (:Col Ky_col) (:P O))
             (&span_dir (:P_intile Ky_p_intile) (:Col Ky_col) D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&span_node (:P_intile Ky_p_intile) (:Col Ky_col) (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&span_node (:P_intile Ky_p_intile) (:Col Ky_col) (:P Q)))
            ((&span_source (:P_intile Ky_p_intile) (:Col Ky_col) (:P O))
             (&span_dir (:P_intile Ky_p_intile) (:Col Ky_col) D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&span_node (:P_intile Ky_p_intile) (:Col Ky_col) (:P Q))
             (= A2 O))
            ((&span_source (:P_intile Ky_p_intile) (:Col Ky_col) (:P O))
             (&span_dir (:P_intile Ky_p_intile) (:Col Ky_col) D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&span_node (:P_intile Ky_p_intile) (:Col Ky_col) (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&span_node (:P_intile Ky_p_intile) (:Col Ky_col) (:P Q)))))
      (source ((:n O))
        (&span_source (:P_intile Ky_p_intile) (:Col Ky_col) (:P O))
        (&span_dir (:P_intile Ky_p_intile) (:Col Ky_col) D))))

  (RULE &span_ray
    (&span.distance (:key (:Ky_p_intile *P_intile) (:Ky_col *Col) *D (:O *Origin)) (:n *P) *K))

  (RULE &span_between
    (&span_mark *P_intile *Col)
    (&tile_box.box (:key (:P_tile *P)))
    (&span_axis P_intile Col *A)
    (axis4_of *D A)
    (dir8_opposite D (:D2 *O))
    (&span_ray P_intile Col P D)
    (&span_ray P_intile Col P (:D O)))

  (RULE &span_cell
    (&span_between *P_intile *Col (:P *P_tile))
    (NOT (&mark P_tile P_intile Col))))

(ALTS $scope "which tile cells can be marks" $WholeTile
  (ALT $Interior
    (INPUT marks "a mark is a cell inside the tile's outer ring whose color differs from the common tile's color at that position"
      (RULE &in_scope
        (&common.maximal (:key *P_intile))
        (relative (:Base 0) (:X P_intile) (:X_rel *R_m1))
        (axis_of (:D *D1_m2) (:A *A1_m3))
        (opposite (:D D1_m2) (:Opp *O1_m4))
        (perp (:A A1_m3) (:A2 *A2_m5))
        (axis_of (:D *D2_m6) (:A A2_m5))
        (opposite (:D D2_m6) (:Opp *O2_m7))
        (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
        (> K1_m8 0)
        (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
        (> K2_m9 0)
        (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
        (> K3_m10 0)
        (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
        (> K4_m11 0))))
  (ALT $PatternPositions
    (INPUT marks "a mark is a tile cell at a position where the common tile holds its less frequent color, and whose color differs from that color"
      (RULE &in_scope
        (&common.maximal (:key *P_intile) (:t *Col))
        (&pattern.minimal (:t (:V Col)))))))

(ALTS $base "what a mark differs from" $CommonColor
  (ALT $OffPalette
    (INPUT marks "a mark is a tile cell whose color is none of the common tile's colors"
      (RULE &mark
        (&in_scope *P_intile)
        (&tile_cell *P_tile P_intile *Col)
        (NOT (&palette.size (:key Col)))))))

(ALTS $target "which tiles a span paints" $EveryTile
  (ALT $KeepMarks
    (OUTPUT span-fill "for two marks of the same color at the same tile position, in tiles of the same tile row or tile column, each tile from one of those tiles to the other whose cell at that position is not a mark takes that color at that position")
    (RULE &paint
      (&span_cell *P_tile *P_intile *Col)
      (NOT (&mark P_tile P_intile))
      (&tile_cell P_tile P_intile (:P_grid *P)))))

(ALTS $sep "where the separator color comes from" $StoredSeparator
  (ALT $DerivedSeparator
    (INPUT tile-lattice "full rows and full columns of the one color of the grid's border ring cut the grid into a lattice of equal tiles, with a separator line along each grid edge; the branch is undefined where the border ring is not one color"
      (RULE &separator2
        (&border.value (:v *Col))))))

(RULE &span_end
  (&span_ray *P_intile *Col *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray P_intile Col (:P Q) D Origin)))

(RULE &open_edge
  (&lattice_tile_of *P)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(RULE &paint
  (&span_cell *P_tile *P_intile *Col)
  (&tile_cell P_tile P_intile (:P_grid *P)))

(RULE &output
  (&separator2)
  (NOT (&open_edge))
  (input *P (:Col *Col_in))
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (= Col Col_in))))
