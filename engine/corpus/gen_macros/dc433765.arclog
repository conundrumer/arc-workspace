;; dc433765

(DET &bg DominantColor)

(DET &mover ChangedColor)

(DET &target UnchangedColor)

(RULE &mover_at
  (input *P *Col)
  (&mover (:C Col)))

(RULE &target_at
  (input *P *Col)
  (&target (:C Col)))

(RULE &axis_step
  (&mover_at (:P *Pm))
  (&target_at (:P *Pt))
  (axis_of *D *A)
  (OR ((dir_elem D)
       (margin (:B Pt) D (:K *K1_m1))
       (margin (:B Pm) D (:K *K2_m2))
       (< K1_m1 K2_m2)
       (step_offset D (:V *S)))
      ((margin (:B Pm) D (:K *K_m3))
       (margin (:B Pt) D (:K K_m3))
       (= S 0))))

(RULE &moved
  (&mover_at (:P *Pm))
  (perp (:A *A1) *A2)
  (&axis_step (:A A1) (:S *S1))
  (&axis_step (:A A2) (:S *S2))
  (compose (:A Pm) (:B S1) (:C *P1))
  (compose (:A P1) (:B S2) (:C *P)))

(RULE &output
  (OR ((&target_at *P)
       (&target (:C *Col)))
      ((&moved P)
       (&mover (:C Col)))
      ((input P)
       (NOT (&target_at P))
       (NOT (&moved P))
       (&bg (:C Col)))))
