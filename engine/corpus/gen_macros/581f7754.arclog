;; 581f7754

(RULE &objs_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

(INIT &objs Quotient
  (edge ((:a P) (:b P3))
    (OR ((&ink *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&ink (:P P3)))
        ((&ink P)
         (= P3 P)))))

(RULE &objs_component
  (&objs.class (:a *P) *Id))

(RULE &obj_cell
  (&objs_component *P *Id)
  (&ink P *Col))

(INIT &sole Singleton
  (key ((&obj_cell ^Id *P ^Col))
    (member ((:v P))
      (&obj_cell Id *P Col))))

(RULE &shift_split1
  (&sole.value (:key *Id *Col) (:v *M_))
  (axis_of *D (:A *Ax_))
  (axis_of (:D *D_m1) (:A Ax_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B M_) (:D D_m1) (:K *K1_m3))
  (margin (:B M_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Along_))
  (relative (:Base Along_) (:X M_) (:X_rel *X_m1_)))

;; The object's sole cell.
(INIT &lone Singleton
  (key ((&obj_cell ^Id *P))
    (member ((:v P))
      (&obj_cell Id *P))))

(RULE &anchor
  (&lone.value (:v *P))
  (&ink P *Col)
  (dir_elem *D)
  (margin (:B P) D (:K 0)))

(RULE &shift_split2
  (&anchor (:P *A_) *Col *D)
  (axis_of D (:A *Ax_))
  (axis_of (:D *D_m1) (:A Ax_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B A_) (:D D_m1) (:K *K1_m3))
  (margin (:B A_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X A_) (:X_rel *Across_)))

(RULE &shift
  (&sole.value (:key *Id *Col) (:v *M))
  (&anchor (:P *A) Col *D)
  (axis_of D (:A *Ax))
  (&shift_split1 (:M_ M) (:Ax_ Ax) (:Along_ *Along) (:X_m1_ *X_m1))
  (&shift_split2 (:A_ A) (:Ax_ Ax) (:X_m2_ *X_m2) (:Across_ *Across))
  (compose (:A Along) (:B Across) (:C *T))
  (relative (:Base M) (:X T) (:X_rel *V)))

(RULE &moved
  (&obj_cell *Id (:P *P2) *Col)
  (&shift Id *V)
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (&bg_mode.maximal (:t Col)))))
