;; 833966f4

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(INIT &perm_tiling Tiling
  (key ((&divide_axis ^A))
    (gap (A G)
      (&divide_gap (:K *G)))))

(DET &pair
  (ex_input *E (:P *P_in) *Col)
  (ex_output E (:P *P_out) Col))

(INIT &ident Quotient
  (equivalent ((:a P_in) (:b P_in))
    (&pair *P_in)))

(DET &in_label
  (&pair (:P_in *P))
  (&ident.class (:a P) *Id))

(DET &out_label
  (&pair *P_in (:P_out *P))
  (&ident.class (:a P_in) *Id))

(RULE &map
  (&in_label (:P *P_in) *Id)
  (&out_label (:P *P_out) Id))

(RULE &perm
  (&map *P_in *P_out))

(ALTS $choice "how the permutation is derived" $LabeledGrids
  (ALT $Count
    (DET &divisor SepTileCount)

    (RULE &part_division_cell
      (input *P)
      (&divide_axis (:A *Key)))

    (INIT &part_division_sides ExtentDivisions
      (key ((&part_division_cell (:Key ^Ky) *P))
        (frame (P)
          (&part_division_cell (:Key Ky) *P))))

    (RULE &part_division_gap_held
      (&divide_axis *A)
      (&divide_gap (:K *G)))

    (RULE &part_division_axis_split1
      (&part_division_cell (:Key *Ky) (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &part_division_parts_held
      (&divide_axis *A)
      (&divisor *N))

    (RULE &part_division_axis
      (OR ((&part_division_cell *Key *P)
           (axis_elem *A)
           (OR ((!= A Key))
               ((NOT (&part_division_parts_held (:A Key)))))
           (&part_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&part_division_cell Key P)
           (&divide_axis (:A Key))
           (&divisor *N)
           (&divide_gap (:K *G))
           (&part_division_sides.division (:key (:Ky Key)) (:A Key) N *K G)
           (axis_of *D (:A Key))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K))
           (= A Key))
          ((&part_division_cell Key P)
           (&divide_axis (:A Key))
           (&divisor (:N *N2))
           (&divide_gap (:K *G2))
           (frame_extent P (:A Key) (:N *K2))
           (axis_of (:D *D2) (:A Key))
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K2))
           (frame_extent (:P P_outer) (:A Key) (:N N2))
           (= A Key))
          ((&part_division_cell Key P)
           (&divide_axis (:A Key))
           (&divisor (:N *N3))
           (OR ((!= Key Key))
               ((NOT (&part_division_gap_held (:A Key)))))
           (&part_division_sides.division (:key (:Ky Key)) (:A Key) (:N N3) (:K *K3) (:G 0))
           (axis_of (:D *D3) (:A Key))
           (opposite (:D D3) (:Opp *O3))
           (margin (:B P) (:D D3) (:K *T4))
           (margin (:B P) (:D O3) (:K *T23))
           (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
           (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
           (opposite (:D D3) (:Opp *O_m13))
           (edge_inset (:D D3) (:K I4) (:B *B1_m23))
           (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
           (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
           (opposite (:D D3) (:Opp *O_m43))
           (edge_inset (:D D3) (:K R4) (:B *B1_m53))
           (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
           (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K3))
           (= A Key))
          ((&part_division_cell Key P)
           (&divide_axis (:A Key))
           (&divisor (:N *N4))
           (OR ((!= Key Key))
               ((NOT (&part_division_gap_held (:A Key)))))
           (frame_extent P (:A Key) (:N *K4))
           (axis_of (:D *D4) (:A Key))
           (opposite (:D D4) (:Opp *O4))
           (margin (:B P) (:D D4) (:K *T5))
           (margin (:B P) (:D O4) (:K *T24))
           (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
           (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
           (opposite (:D D4) (:Opp *O_m14))
           (edge_inset (:D D4) (:K I5) (:B *B1_m24))
           (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
           (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
           (opposite (:D D4) (:Opp *O_m44))
           (edge_inset (:D D4) (:K R5) (:B *B1_m54))
           (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
           (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K4))
           (frame_extent (:P P_outer) (:A Key) (:N N4))
           (= A Key))))

    (RULE &part_division_tile
      (&part_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&part_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &part_split1
      (&part_division_tile (:Key *A_) (:P *P_grid) *P_outer (:P_inner *P_slab_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
      (relative (:Base P_inner_) (:X P_slab_) (:X_rel *X_m1_)))

    (RULE &part
      (&part_division_tile (:Key *A) (:P *P_grid) *P_outer (:P_inner *P_slab))
      (&part_split1 (:P_slab_ P_slab) (:A_ A) (:P_inner_ *P_inner) (:X_m1_ *X_m1)))

    (RULE &perm
      (&part (:P_grid *P_in) *P_outer *P_inner)
      (&perm_tiling.cell (:key *A) P_outer (:P_inner *P_inner_out) (:P *P_out))
      (axis_inversion A (:T *F))
      (apply (:D F) (:P P_inner) (:P_out P_inner_out)))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (OR ((&perm (:P_in P_grid_in) (:P_out *P)))
          ((NOT (&part (:P_grid P_grid_in)))
           (= P P_grid_in))))

    (INIT &perm_tiling Tiling
      (key ((&divide_axis ^A))
        (inner ((:P P_inner_out))
          (&part *P_inner)
          (axis_inversion A (:T *F))
          (apply (:D F) (:P P_inner) (:P_out *P_inner_out)))
        (gap (A G)
          (&divide_gap (:K *G))))
      (outer ((:P P_outer))
        (&part *P_outer))))
  (ALT $Size
    (RULE &part_division2_cell
      (input *P)
      (&divide_axis (:A *Key)))

    (DET &tile_size SepTileCount)

    (RULE &part_division2_gap_held
      (&divide_axis *A)
      (&divide_gap (:K *G)))

    (RULE &part_division2_axis_split1
      (&part_division2_cell (:Key *Ky) (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &part_division2_side_held
      (&divide_axis *A)
      (&tile_size (:N *K)))

    (RULE &part_division2_axis
      (OR ((&part_division2_cell *Key *P)
           (axis_elem *A)
           (OR ((!= A Key))
               ((NOT (&part_division2_side_held (:A Key)))))
           (&part_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&part_division2_cell Key P)
           (&divide_axis (:A Key))
           (&tile_size (:N *K))
           (&divide_gap (:K *G))
           (axis_of *D (:A Key))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K))
           (= A Key))
          ((&part_division2_cell Key P)
           (&divide_axis (:A Key))
           (&tile_size (:N *K2))
           (OR ((!= Key Key))
               ((NOT (&part_division2_gap_held (:A Key)))))
           (axis_of (:D *D2) (:A Key))
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K2))
           (= A Key))))

    (RULE &part_division2_tile
      (&part_division2_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&part_division2_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &part_split2
      (&part_division2_tile (:Key *A_) (:P *P_grid) *P_outer (:P_inner *P_slab_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_))
      (relative (:Base P_inner_) (:X P_slab_) (:X_rel *X_m1_)))

    (RULE &part
      (&part_division2_tile (:Key *A) (:P *P_grid) *P_outer (:P_inner *P_slab))
      (&part_split2 (:P_slab_ P_slab) (:A_ A) (:P_inner_ *P_inner) (:X_m1_ *X_m1)))

    (RULE &perm
      (&part (:P_grid *P_in) *P_outer *P_inner)
      (&perm_tiling.cell (:key *A) P_outer (:P_inner *P_inner_out) (:P *P_out))
      (axis_inversion A (:T *F))
      (apply (:D F) (:P P_inner) (:P_out P_inner_out)))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (OR ((&perm (:P_in P_grid_in) (:P_out *P)))
          ((NOT (&part (:P_grid P_grid_in)))
           (= P P_grid_in))))

    (INIT &perm_tiling Tiling
      (key ((&divide_axis ^A))
        (inner ((:P P_inner_out))
          (&part *P_inner)
          (axis_inversion A (:T *F))
          (apply (:D F) (:P P_inner) (:P_out *P_inner_out)))
        (gap (A G)
          (&divide_gap (:K *G))))
      (outer ((:P P_outer))
        (&part *P_outer)))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&perm (:P_in P_grid_in) (:P_out *P)))
