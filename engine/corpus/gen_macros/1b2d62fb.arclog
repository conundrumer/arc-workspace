;; 1b2d62fb

(DET &tile_decompose Division)

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(DET &combine PanelCombine)

(RULE &decompose
  (&tile_decompose *P *P_outer *P_inner))

(ALTS $d "how the grid splits into its two tiles" $Table
  (ALT $Count
    (INIT &decompose_division_sides ExtentDivisions
      (frame ((:P P_grid))
        (input (:P *P_grid))))

    (DET &divisor SepTileCount)

    (RULE &decompose_division_gap
      (&divide_axis *A)
      (&divide_gap (:K *G)))

    (RULE &decompose_division_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &decompose_division_parts
      (&divide_axis *A)
      (&divisor *N))

    (RULE &decompose_division_axis
      (OR ((input *P)
           (&divide_axis *A)
           (&divisor *N)
           (&divide_gap (:K *G))
           (&decompose_division_sides.division A N *K G)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&divide_axis A)
           (&divisor (:N *N2))
           (&divide_gap (:K *G2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N2)))
          ((input P)
           (&divide_axis A)
           (&divisor (:N *N3))
           (NOT (&decompose_division_gap A))
           (&decompose_division_sides.division A (:N N3) (:K *K3) (:G 0))
           (axis_of (:D *D3) A)
           (opposite (:D D3) (:Opp *O3))
           (margin (:B P) (:D D3) (:K *T4))
           (margin (:B P) (:D O3) (:K *T23))
           (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
           (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
           (opposite (:D D3) (:Opp *O_m13))
           (edge_inset (:D D3) (:K I4) (:B *B1_m23))
           (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
           (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
           (opposite (:D D3) (:Opp *O_m43))
           (edge_inset (:D D3) (:K R4) (:B *B1_m53))
           (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
           (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K3)))
          ((input P)
           (&divide_axis A)
           (&divisor (:N *N4))
           (NOT (&decompose_division_gap A))
           (frame_extent P A (:N *K4))
           (axis_of (:D *D4) A)
           (opposite (:D D4) (:Opp *O4))
           (margin (:B P) (:D D4) (:K *T5))
           (margin (:B P) (:D O4) (:K *T24))
           (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
           (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
           (opposite (:D D4) (:Opp *O_m14))
           (edge_inset (:D D4) (:K I5) (:B *B1_m24))
           (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
           (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
           (opposite (:D D4) (:Opp *O_m44))
           (edge_inset (:D D4) (:K R5) (:B *B1_m54))
           (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
           (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K4))
           (frame_extent (:P P_outer) A (:N N4)))
          ((input P)
           (axis_elem A)
           (NOT (&decompose_division_parts A))
           (&decompose_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &decompose_division_tile
      (&decompose_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&decompose_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &decompose
      (&decompose_division_tile *P *P_outer *P_inner)))
  (ALT $Size
    ;; Two 5×3 subgrids side by side, separated by a column.
    (DET &frame_dim ConstOutDimAxis)

    (RULE &decompose_division2_gap
      (&divide_axis *A)
      (&divide_gap (:K *G)))

    (RULE &decompose_division2_axis_split1
      (input (:P *P_grid_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

    (RULE &decompose_division2_side
      (&divide_axis *A)
      (&frame_dim A (:N *K)))

    (RULE &decompose_division2_axis
      (OR ((input *P)
           (&divide_axis *A)
           (&frame_dim A (:N *K))
           (&divide_gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (&divide_axis A)
           (&frame_dim A (:N *K2))
           (NOT (&decompose_division2_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input P)
           (axis_elem A)
           (NOT (&decompose_division2_side A))
           (&decompose_division2_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &decompose_division2_tile
      (&decompose_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&decompose_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &decompose
      (&decompose_division2_tile *P *P_outer *P_inner))))

(ALTS $b "how the two tiles' cells combine into the output color" $Lookup
  (ALT $Nor
    (DET &frame Frame)

    (DET &bg ChangedColor)

    (DET &out_fill AnyOutNewColor)

    (RULE &filled
      (input (:P *P_grid_in) *Col)
      (NOT (&bg (:C Col)))
      (&decompose (:P P_grid_in) (:P_inner *O)))

    (RULE &output
      (&frame *P)
      (OR ((NOT (&filled (:O P)))
           (&out_fill (:C *Col)))
          ((&filled (:O P))
           (&bg (:C Col)))))))

(INIT &combine_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_outer) (:Col C)))
    (&combine *Id (:P *P_outer) *C))
  (observed ((:observed P_grid_out) (:m (:P P_tile) (:Col C)))
    (&decompose (:P *P_grid_in) (:P_outer *P_tile) (:P_inner *P_grid_out))
    (input (:P P_grid_in) (:Col *C))))

(RULE &output
  (&combine *Id (:C_out *Col))
  (&combine_match.equal (:observed *P) (:pattern Id)))
