;; e633a9e5

(DET &cand
  (ex_input *E (:P *P_in) (:Col *C))
  (ex_output E (:P *P_out) (:Col C)))

(DET &broken
  (&cand *P_in *P_out)
  (ex_output *E)
  (NOT (&cand E P_in P_out)))

(DET &pair
  (&cand *P_in *P_out)
  (NOT (&broken P_in P_out)))

(DET &tile_line_split1
  (&pair *P_in (:P_out *P_out_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_out_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_out_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_out_) (:X_rel *X_m1_)))

(DET &tile_line
  (&pair *P_in *P_out)
  (axis_elem *A)
  (&tile_line_split1 (:P_out_ P_out) (:A_ A) (:P_along_ *P_along) (:X_m1_ *X_m1)))

(INIT &tile_dim Cardinality
  (key ((&tile_line ^P_in ^A *P_along))
    (member ((:m P_along))
      (&tile_line P_in A *P_along))))

(DET &ext_split1
  (&tile_dim.size (:key (:P_in *P_in_) (:A *A_)) *N)
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_along_))
  (relative (:Base P_along_) (:X P_in_) (:X_rel *X_m1_)))

(DET &fat DimDiff)

(DET &ext
  (&tile_dim.size (:key *P_in *A) *N)
  (&ext_split1 (:P_in_ P_in) (:A_ A) (:P_along_ *P) (:X_m1_ *X_m1)))

(RULE &ext_in_use
  (OR ((&fat (:D *N)))
      ((&ext N))))

(INIT &ext_pos_frame Frame
  (key ((&ext_in_use ^N)
        (axis_elem ^A))))

(DET &ext_pos
  (&ext_pos_frame.cell (:key *N *A) *P))

(RULE &fat_pos
  (&fat (:D *N))
  (&ext_pos *A N (:P *P_in_ax)))

(RULE &ax_pos
  (input (:P *P_tile))
  (axis_of *D *A)
  (OR ((margin (:B P_tile) D (:K 0))
       (&fat_pos A *P_in_ax))
      ((opposite D (:Opp *O_m1))
       (margin (:B P_tile) D *K)
       (margin (:B P_tile) (:D O_m1) (:K *K2))
       (!= K 0)
       (!= K2 0)
       (= P_in_ax 0))))

(ALTS $choice "how a cell's tile size is found" $Edge
  (ALT $Table
    (RULE &line_pos
      (&ext *A (:P *P_along) *N)
      (&ext_pos A N (:P *P_in_ax)))

    (RULE &ax_pos_split1
      (input (:P *P_))
      (&line_pos (:A *A_) (:P_along *P_along_) (:P_in_ax *Pi))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C P_along_))
      (relative (:Base P_along_) (:X P_) (:X_rel *X_m1_)))

    (RULE &ax_pos
      (input (:P *P_tile))
      (&ax_pos_split1 (:P_ P_tile) (:A_ *A) (:P_along_ *P_along) (:X_m1_ *X_m1))
      (&line_pos A P_along *P_in_ax)))
  (ALT $Map
    (INIT &ident Quotient
      (equivalent ((:a P_in) (:b P_in))
        (&pair *P_in)))

    (DET &dst
      (&pair *P_in (:P_out *P))
      (&ident.class (:a P_in) *Id))

    (DET &src
      (&pair (:P_in *P))
      (&ident.class (:a P) *Id))

    (RULE &map
      (&src (:P *P_in) *Id)
      (&dst (:P *P_out) Id))

    (RULE &output
      (input (:P *P_in) *Col)
      (&map P_in (:P_out *P)))))

(RULE &tile
  (input (:P *P_tile) *Col)
  (perp (:A *A1) *A2)
  (&ax_pos P_tile (:A A1) (:P_in_ax *P1))
  (&ax_pos P_tile (:A A2) (:P_in_ax *P2))
  (compose (:A P1) (:B P2) (:C *P_intile)))

;; The output lines the tiles between edge d and the tile cover.
(INIT &lines_before Cardinality
  (key ((&tile ^P_tile)
        (dir_elem ^D))
    (member ((:m Q_tile (:P_in_ax Pi)))
      (&tile P_tile)
      (dir_elem D)
      (axis_of D *A)
      (input (:P *Q_tile))
      (perp A (:A2 *A2_m1))
      (axis_of (:D *D_m2) (:A A2_m1))
      (margin (:B P_tile) (:D D_m2) (:K *K_m3))
      (margin (:B Q_tile) (:D D_m2) (:K K_m3))
      (dir_elem D)
      (margin (:B Q_tile) D (:K *K1_m4))
      (margin (:B P_tile) D (:K *K2_m5))
      (< K1_m4 K2_m5)
      (&ax_pos (:P_tile Q_tile) A (:P_in_ax *Pi)))
    (domain ()
      (&tile P_tile)
      (dir_elem D))))

(RULE &edge_off
  (&lines_before.size (:key *D *P_tile) (:N *K))
  (edge_inset D K (:B *P_off)))

(RULE &axis_off
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&edge_off D *P_tile (:P_off *P1))
  (&edge_off (:D D2) P_tile (:P_off *P2))
  (compose (:A P1) (:B P2) (:C *P_off)))

(RULE &tile_offset
  (perp (:A *A1) *A2)
  (&axis_off (:A A1) *P_tile (:P_off *P1))
  (&axis_off (:A A2) P_tile (:P_off *P2))
  (compose (:A P1) (:B P2) (:C *P_off)))

(RULE &output
  (&tile *P_tile *P_intile *Col)
  (&tile_offset P_tile *P_off)
  (compose (:A P_off) (:B P_intile) (:C *P)))
