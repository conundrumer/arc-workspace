;; aabf363d

(DET &bg DominantColor)

(DET &marker_corner DiagDirDomain)

(RULE &marker
  (input *P *Col)
  (&marker_corner (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m3))
  (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m4))
  (margin (:B P) (:D D1_m2) (:K *K1_m5))
  (margin (:B 0) (:D D1_m2) (:K K1_m5))
  (margin (:B P) (:D D2_m4) (:K *K2_m6))
  (margin (:B 0) (:D D2_m4) (:K K2_m6)))

(INIT &color_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(ALTS $choice "which model identifies the marker color" $Anchor
  (ALT $ByCount
    (DET &marker_count DivisorRatio)

    (RULE &marker
      (input *P *Col)
      (&marker_count *K)
      (&color_count.size (:key Col) (:N K))))
  (ALT $Minority
    (INIT &rarest Order
      (member ((:t (:V Col) (:S N)))
        (&color_count.size (:key *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&color_count.size (:key *Col) *N)))

    (RULE &marker
      (input *P *Col)
      (&rarest.minimal (:t (:V Col))))))

(RULE &output
  (OR ((&marker *P)
       (&bg (:C *Col)))
      ((&marker)
       (input P Col)
       (&bg (:C Col)))
      ((input P (:Col *Col2))
       (NOT (&bg (:C Col2)))
       (&marker Col)
       (NOT (&marker P)))))
