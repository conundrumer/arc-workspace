;; 458e3a53

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

;; A uniform line spans the grid, so it divides tiles rather than sit in one.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

(RULE &tiles_divider
  (&line_color.value (:key *A *L)))

(RULE &tiles_on_divider
  (input *P)
  (&tiles_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &tiles_rank Order
  (key ((OR ((&tiles_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&tiles_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&tiles_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &tiles_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&tiles_on_divider P A))
  (margin (:B P) D *K)
  (&tiles_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiles_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiles_part_idx *P D (:N *N1))
  (&tiles_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &tiles_tile_of
  (&tiles_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiles_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &tile_color Singleton
  (key ((&tiles_tile_of *P ^P_tile)
        (input P *Col))
    (member ((:v Col))
      (&tiles_tile_of *P P_tile)
      (input P *Col))))

(RULE &before_split1
  (&tile_color.value (:key (:P_tile *P_tile_)))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_tile_) (:X_rel *X_m1_)))

(RULE &before_split2
  (&tile_color.value (:key (:P_tile *P_tile2_)))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L2_))
  (relative (:Base L2_) (:X P_tile2_) (:X_rel *X_m2_)))

(RULE &elem_split1
  (&tile_color.value (:key (:P_tile *P_tile_)))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_tile_) (:X_rel *X_m1_)))

;; One output line per tile line that holds a one-color tile.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t L))
      (&tile_color.value (:key *P_tile))
      (&elem_split1 (:P_tile_ P_tile) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))
    (before ((:a L) (:b L2))
      (&tile_color.value (:key *P_tile))
      (&before_split1 (:P_tile_ P_tile) (:A_ A) (:L_ *L) (:X_m1_ *X_m1))
      (&tile_color.value (:key (:P_tile *P_tile2)))
      (&before_split2 (:P_tile2_ P_tile2) (:A_ A) (:L2_ *L2) (:X_m2_ *X_m2))
      (!= L L2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) (:A Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) (:A Key) D) (:t M) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_pos)))

(RULE &out_split1
  (&tile_color.value (:key (:P_tile *P_tile_)) (:v *Col))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_tile_) (:X_rel *L2_)))

(RULE &output
  (&tile_color.value (:key *P_tile) (:v *Col))
  (axis_elem *A)
  (perp A *A2)
  (&out_split1 (:P_tile_ P_tile) (:A_ A) (:L_ *L) (:L2_ *L2))
  (&layout_pos (:Key A) (:M L) *P_pos)
  (&layout_pos (:Key A2) (:M L2) (:P_pos *P_pos2))
  (compose (:A P_pos) (:B P_pos2) (:C *P)))
