;; 9b5080bb

(INPUT panels "two panels of distinct colors, each one region of one color, hold figures of a third color; a figure lies inside one panel, touching no other region")

(INPUT figure "a figure is a rectangle with single-cell defects on its sides: a bump, a figure cell just outside a side, or a dent, a side cell the figure lacks; each side lies where most of the figure's lines end"

  (RULE &regions_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  ;; The regions of one color.
  (INIT &regions Quotient
    (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
      (OR ((input *P *Col)
           (&regions_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) Col))
          ((input P Col)
           (= P3 P)))))

  (RULE &regions_component
    (&regions.class (:a *Key *P) *Id))

  (RULE &touches
    (&regions_component *P *Id)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&regions_component (:P Q) (:Id *Id2))
    (!= Id Id2))

  ;; The one region beside a figure: its panel.
  (INIT &panel_of Singleton
    (key ((&touches ^Id *Id2))
      (member ((:v Id2))
        (&touches Id *Id2))))

  (RULE &figure
    (&panel_of.value (:key *Id))
    (&regions_component *P Id))

  (RULE &cell_split1
    (&figure *Id (:P *P_))
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

  ;; The figure's extent on each of its lines.
  (INIT &line_box BoundingBox
    (key ((&figure ^Id *P)
          (axis_elem ^A)
          (&cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ ^L)))
      (cell (P)
        (&figure Id *P)
        (axis_elem A)
        (&cell_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ L)))))

  (INIT &side_end_count Cardinality
    (key ((&line_box.box (:key ^Id *A *L) *B)
          (axis_of ^D A)
          (margin B D ^K))
      (member ((:m L))
        (&line_box.box (:key Id *A *L) *B)
        (axis_of D A)
        (margin B D K))))

  ;; Where most of the figure's lines end toward each side.
  (INIT &side_end Order
    (key ((&side_end_count.size (:key ^Id ^D *K)))
      (member ((:t K))
        (&side_end_count.size (:key Id D *K)))
      (score ((:t K) (:S N))
        (&side_end_count.size (:key Id D *K) *N))))

  ;; The 2×2 square a body cell lies in.
  ;; TODO no-det-plan: &square: the plan gives no verdict
  (DET &square)

  ;; The 2×2 blocks of each figure.
  (INIT &block Occurrences
    (key ((OR ((&figure ^Id *P))
              ((&figure Id)
               (&square (:P *S)))))
      (cell (P)
        (&figure Id *P))
      (shape ((:P S))
        (&figure Id)
        (&square (:P *S)))))

  (RULE &body
    (&block.occurrence (:key *Id) (:P *M))
    (&square (:P *S))
    (compose (:A M) (:B S) (:C *P)))

  (INIT &body_box BoundingBox
    (key ((&body ^Id *P))
      (cell (P)
        (&body Id *P))))

  (INIT &figure_box BoundingBox
    (key ((&figure ^Id *P))
      (cell (P)
        (&figure Id *P))))

  ;; The figure's cells on the line of its box toward each side; a bump is the
  ;; one such cell.
  (INIT &edge_cell Singleton
    (key ((&figure_box.box (:key ^Id) *B)
          (&figure Id *P)
          (ALL ((&figure (:Id *Idm) P)
                (&figure_box.box (:key (:Id Idm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))
          (margin (:B P) ^D (:K *K_m1))
          (margin B D (:K K_m1)))
      (member ((:v P))
        (&figure_box.box (:key Id) *B)
        (&figure Id *P)
        (ALL ((&figure (:Id *Idm) P)
              (&figure_box.box (:key (:Id Idm)) B)
              (dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) D (:K *K_m1))
        (margin B D (:K K_m1))))))

(OUTPUT mark "each defect is marked with the other panel's color across the side: the side cell at the defect and the cell just outside it")

(OUTPUT keep "every other cell keeps its color")

(ALTS $choice "how a figure's rectangle is read from its cells" $Majority
  (ALT $Body
    (INPUT figure "a figure's body is its cells that lie in a 2×2 block of the figure; the rectangle is the body's box, and the figure has single-cell defects on its sides: a bump, a figure cell just outside a side, or a dent, a side cell the figure lacks")
    (RULE &rect
      (&body_box.box (:key *Id) *B)))
  (ALT $Lone
    (INPUT figure "a figure is a rectangle with single-cell defects on its sides: a bump, a figure cell just outside a side, or a dent, a side cell the figure lacks; a bump is the one figure cell on a line of the figure's box, and the rectangle is the box with those lines pulled in"
      (RULE &lone_rect_edge
        (&figure_box.box (:key (:Id *Key)) *B)
        (dir_elem *D)
        (OR ((NOT (&edge_cell.value (:key (:Id Key) D)))
             (margin B D *K))
            ((&edge_cell.value (:key (:Id Key) D) (:v *P))
             (opposite D (:Opp *O))
             (step_offset (:D O) (:V *V_m1))
             (compose (:A P) (:B V_m1) (:C *Q))
             (margin (:B Q) D K))))

      (RULE &lone_rect_axis
        (axis_of *D *A)
        (opposite D (:Opp *D2))
        (&lone_rect_edge *Key D (:K *K1))
        (&lone_rect_edge Key (:D D2) (:K *K2))
        (opposite D (:Opp *O_m1))
        (edge_inset D (:K K1) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *B)))

      (RULE &lone_rect
        (&lone_rect_axis *Key *A (:B *B1))
        (perp A *A2)
        (&lone_rect_axis Key (:A A2) (:B *B2))
        (compose (:A B1) (:B B2) (:C *B))))
    (RULE &rect
      (&lone_rect (:Key *Id) *B))))

(RULE &majority_rect_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&side_end.maximal (:key (:Id *Key) D) (:t *K))
  (&side_end.maximal (:key (:Id Key) (:D D2)) (:t *K2))
  (opposite D (:Opp *O_m1))
  (edge_inset D K (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B)))

(RULE &majority_rect
  (&majority_rect_axis *Key *A (:B *B1))
  (perp A *A2)
  (&majority_rect_axis Key (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(RULE &panel
  (&panel_of.value (:v *Id))
  (&regions_component (:Key *Col) Id))

(RULE &mark_color
  (&panel_of.value (:key *Id) (:v *H))
  (&panel (:Id H) (:Col *Col3))
  (&panel *Col)
  (!= Col Col3))

(RULE &rect
  (&majority_rect (:Key *Id) *B))

(RULE &defect
  (&rect *Id *B)
  (input *P)
  (ALL ((&rect (:Id *Idm) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (margin (:B P) *D (:K *K_m1))
  (margin B D (:K K_m1))
  (OR ((NOT (&figure Id P)))
      ((step_offset D (:V *V_m2))
       (compose (:A P) (:B V_m2) (:C *Q))
       (&figure Id (:P Q)))))

(RULE &mark
  (&defect *Id *D (:P *P2))
  (&mark_color Id *Col)
  (OR ((step_offset D (:V *V_m1))
       (compose (:A P2) (:B V_m1) (:C *P)))
      ((= P P2))))

(RULE &output
  (OR ((&mark *P *Col))
      ((input P Col)
       (NOT (&mark P)))))
