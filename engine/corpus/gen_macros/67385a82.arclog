;; 67385a82

(DET &ink SharedColor)

(DET &mark AnyOutNewColor)

(RULE &ink2
  (input *P *Col)
  (&ink (:C Col)))

(RULE &grouped
  (&ink2 *P)
  (dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *P2))
  (&ink2 (:P P2)))

(RULE &output
  (OR ((&grouped *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&grouped P)))))
