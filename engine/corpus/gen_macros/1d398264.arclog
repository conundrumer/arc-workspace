;; 1d398264

(RULE &burst_dir
  (dir8_elem (:D *Key)))

(RULE &burst_node
  (dir8_elem (:D *Key))
  (input *P))

(DET &bg DominantColor)

(RULE &block
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &border Boundary
  (cell (P)
    (&block *P))
  (dir (D)
    (dir8_elem *D)))

(RULE &center
  (&block *P)
  (NOT (&border.boundary P)))

(RULE &burst_source
  (dir8_elem (:D *Key))
  (&center (:P *C))
  (step_offset (:D Key) (:V *V_m1))
  (compose (:A C) (:B V_m1) (:C *P)))

;; Each cell around the center casts along the direction that reaches it.
(INIT &burst Distance
  (key ((&burst_source (:Key ^Ky) (:P ^O))
        (&burst_dir (:Key Ky)))
    (edge ((:a A2) (:b Q))
      (OR ((&burst_source (:Key Ky) (:P O))
           (&burst_dir (:Key Ky))
           (axis_of (:D Ky) *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite (:D Ky) (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset (:D Ky) K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&burst_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&burst_node (:Key Ky) (:P Q)))
          ((&burst_source (:Key Ky) (:P O))
           (&burst_dir (:Key Ky))
           (step_offset (:D Ky) (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&burst_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&burst_source (:Key Ky) (:P O))
           (&burst_dir (:Key Ky))
           (diag_dir_elem (:D Ky))
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite (:D Ky) (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset (:D Ky) (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&burst_node (:Key Ky) (:P A2))
           (step_offset (:D Ky) (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&burst_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&burst_source (:Key Ky) (:P O))
      (&burst_dir (:Key Ky)))))

(RULE &burst_ray
  (&burst.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &burst_end
  (&burst_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&burst_ray Key (:P Q) D Origin)))

(RULE &burst_cell
  (input *P)
  (dir8_elem (:D *Key)))

(RULE &painted
  (&burst_ray (:Key *Ky) *P *K (:Origin *Src))
  (&burst_cell (:Key Ky) P)
  (!= K 0)
  (input (:P Src) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&painted P *Col))
      ((NOT (&painted P))
       (= Col Col_in))))
