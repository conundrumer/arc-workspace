;; aba27056

(INPUT background "every cell outside the container is &background"

  (DET_OR_RULE &background DominantColor))

(INPUT container "one object of one color other than &background is the outline of a rectangle, with one side broken by one opening: a run of background cells along that side's line, which does not include the corners of the rectangle"

  (RULE &runs_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &box BoundingBox
    (cell (P)
      (input *P *Col)
      (NOT (&background (:C Col)))))

  (RULE &corner_inside1
    (input (:P *P_))
    (&box.box (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &opening
    (&box.box *B)
    (input *P *Col)
    (&background (:C Col))
    (ALL ((input P (:Col *Colm))
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) *D (:K *K_m1))
    (margin B D (:K K_m1))
    (ALL ((&box.box (:B *Bm))
          (corner_dir (:C *Diag_m1) (:A *A_m2) (:D *D1_m3))
          (perp (:A A_m2) (:A2 *A2_m4))
          (corner_dir (:C Diag_m1) (:A A2_m4) (:D *D2_m5))
          (margin (:B P) (:D D1_m3) (:K *K1_m6))
          (margin (:B Bm) (:D D1_m3) (:K K1_m6))
          (margin (:B P) (:D D2_m5) (:K *K2_m7))
          (margin (:B Bm) (:D D2_m5) (:K K2_m7)))
         ((&corner_inside1 (:P_ P) (:B_ Bm)))))

  (INIT &runs Quotient
    (edge ((:a P) (:b P3))
      (OR ((&opening *P)
           (&runs_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&opening (:P P3)))
          ((&opening P)
           (= P3 P)))))

  (RULE &runs_component
    (&runs.class (:a *P) *Id))

  (INIT &one_run Singleton
    (member ((:v Id))
      (&runs_component *Id))))

(INPUT interior "the cells strictly inside the rectangle are all &background")

(OUTPUT fill-interior "every cell strictly inside the rectangle becomes &fill_color"

  (DET &fill_color AnyOutNewColor))

(OUTPUT fill-opening "every cell of the opening becomes &fill_color"

  (RULE &source
    (&opening *P *D))

  (RULE &end
    (&source *P *D)
    (axis_of D (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *E1) (:A A2_m2))
    (step_offset (:D E1) (:V *V_m3))
    (compose (:A P) (:B V_m3) (:C *Q))
    (NOT (&source (:P Q) D)))

  (RULE &light_mark
    (OR ((&source *P (:D *Key)))
        ((&end P *D (:E1 *E))
         (corner_dir (:C Key) (:A *A_m1) D)
         (perp (:A A_m1) (:A2 *A2_m2))
         (corner_dir (:C Key) (:A A2_m2) (:D E)))))

  (RULE &light_dir_ray
    (&light_mark *Key))

  (RULE &light_node
    (&light_mark *Key)
    (input *P))

  (RULE &light_source
    (&light_mark *Key *P))

  (INIT &light Distance
    (key ((&light_source (:Key ^Ky) (:P ^O))
          (&light_dir_ray (:Key Ky)))
      (edge ((:a A2) (:b Q))
        (OR ((&light_source (:Key Ky) (:P O))
             (&light_dir_ray (:Key Ky))
             (axis_of (:D Ky) *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite (:D Ky) (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset (:D Ky) K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&light_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&light_node (:Key Ky) (:P Q)))
            ((&light_source (:Key Ky) (:P O))
             (&light_dir_ray (:Key Ky))
             (step_offset (:D Ky) (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&light_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&light_source (:Key Ky) (:P O))
             (&light_dir_ray (:Key Ky))
             (diag_dir_elem (:D Ky))
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite (:D Ky) (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset (:D Ky) (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&light_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&light_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&light_source (:Key Ky) (:P O))
        (&light_dir_ray (:Key Ky))))))

(OUTPUT beam "from the opening, a band as wide as the opening goes straight out, perpendicular to the broken side and away from the interior, to the grid edge; every cell of that band becomes &fill_color")

(OUTPUT diagonal-rays "from each end cell of the opening, a diagonal ray goes out to the grid edge, each step one line farther from the interior and one line farther from the band; every cell of each ray becomes &fill_color")

(OUTPUT rest-kept "every other cell keeps its input color")

(ALTS $openings "what the box does when its outline has more than one opening" $OneOpening
  (ALT $EachOpening
    (INPUT container "the outline may be broken by any number of openings, each a maximal run of background cells on a side line, off the corners")
    (OUTPUT fill-opening "every cell of each opening becomes &fill_color")
    (OUTPUT beam "each opening casts its own band")
    (OUTPUT diagonal-rays "each opening casts its own two rays")
    (RULE &output
      (input *P (:Col *C_in))
      (IF ((&painted P))
          ((&fill_color (:C *Col)))
          ((= Col C_in)))))
  (ALT $SideSpan
    (INPUT container "the outline may be broken by any number of openings; on each broken side, the stretch of the side line from its first to its last background cell counts as one opening")
    (OUTPUT beam "each stretch casts one band as wide as the stretch, and only background cells of the band take &fill_color"
      ;; A cell of side D between two openings of that side, the openings included.
      (RULE &source
        (&box.box *B)
        (input *P)
        (ALL ((dir_elem (:D *D_m1))
              (relative (:Base B) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) *D (:K *K_m1))
        (margin B D (:K K_m1))
        (&opening (:P *Q1) D)
        (&opening (:P *Q2) D)
        (axis_of D (:A *A_m2))
        (perp (:A A_m2) (:A2 *A2_m3))
        (axis_of (:D *E) (:A A2_m3))
        (opposite (:D E) (:Opp *F))
        (dir_elem (:D E))
        (margin (:B P) (:D E) (:K *K1_m4))
        (margin (:B Q1) (:D E) (:K *K2_m5))
        (>= K1_m4 K2_m5)
        (dir_elem (:D F))
        (margin (:B P) (:D F) (:K *K1_m6))
        (margin (:B Q2) (:D F) (:K *K2_m7))
        (>= K1_m6 K2_m7)))
    (OUTPUT diagonal-rays "the two rays leave from the outer ends of each stretch, and only background cells of a ray take &fill_color")
    (RULE &reach
      (input *P *Col)
      (&background (:C Col)))

    (RULE &output
      (input *P (:Col *C_in))
      (IF ((&painted P))
          ((&fill_color (:C *Col)))
          ((= Col C_in))))))

(ALTS $paint "what a cell of another color in the interior or in the light's path becomes" $PaintAll
  (ALT $PaintBackground
    (OUTPUT fill-interior "only background cells of the interior take &fill_color"
      (RULE &kept
        (input *P *Col)
        (NOT (&background (:C Col)))))
    (OUTPUT beam "only background cells of the band take &fill_color")
    (OUTPUT diagonal-rays "only background cells of a ray take &fill_color")
    (RULE &painted
      (OR ((&light_ray *P)
           (&light_cell P))
          ((&box_interior P)))
      (NOT (&kept P)))))

(RULE &light_ray
  (&light.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

(RULE &light_end
  (&light_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&light_ray Key (:P Q) D Origin)))

(RULE &box_interior
  (&box.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((> K_m3 0))))

(RULE &light_dir
  (&light_mark *Key))

(RULE &reach
  (input *P))

(RULE &light_cell
  (&light_dir *Key)
  (&reach *P))

(RULE &painted
  (OR ((&light_ray *P)
       (&light_cell P))
      ((&box_interior P))))

(RULE &undefined
  (NOT (&one_run.value)))

(RULE &output
  (input *P (:Col *C_in))
  (NOT (&undefined))
  (IF ((&painted P))
      ((&fill_color (:C *Col)))
      ((= Col C_in))))
