;; 9aaea919

(INPUT field "the commonest color is the background")

(INPUT stacks "same-shaped diamonds pile in stacks that stand on the base edge, one blank row between stacked diamonds")

(INPUT bars "a bar lies on the base edge under a stack, spanning its width")

(OUTPUT spend "the diamonds of a stack under a spend bar turn the spent color")

(OUTPUT transfer "a stack under a gain bar grows by one diamond per spent diamond, each new diamond stacked on the one below it with the same blank gap, in the stack's own color"

  (RULE &shapes_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &palette_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &palette Order
    (member ((:t Col))
      (&palette_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&palette_count.size (:key *Col) *N)))

  (RULE &bg
    (&palette.maximal (:t *Col)))

  (RULE &shapes_node
    (input *P (:Col *Key))
    (NOT (&bg (:Col Key))))

  (INIT &shapes Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&shapes_node (:Key *Ky) *P)
           (&shapes_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&shapes_node (:Key Ky) (:P P2)))
          ((&shapes_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &shapes_component
    (&shapes.class (:a *Key *P) *Id))

  (RULE &shape
    (&shapes_component *P *Id))

  (INIT &bbox BoundingBox
    (key ((&shape ^Id *P))
      (cell (P)
        (&shape Id *P))))

  ;; The edge the bars lie on; stacks grow away from it.
  (DET &base DirDomain)

  (RULE &stack_axis
    (&base (:D *B))
    (axis_of (:D B) *A))

  (RULE &span_split1
    (&bbox.box (:key *Id) (:B *B_))
    (&stack_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X B_) (:X_rel *S_)))

  ;; Blank rows between stacked diamonds.
  (DET &gap DivisorRatio)

  ;; The bar color that spends the stack above it.
  (DET &spend SharedColor)

  ;; The bar color that gains the spent diamonds.
  (DET &gain VanishedColor)

  (RULE &grow
    (&base (:D *B))
    (opposite (:D B) (:Opp *D)))

  (RULE &shape_color
    (&shapes_component (:Key *Col) *Id))

  (RULE &bar
    (&shape *Id *P)
    (&base (:D *B))
    (margin (:B P) (:D B) (:K 0)))

  (RULE &diamond
    (&shape *Id)
    (NOT (&bar Id)))

  (RULE &span
    (&bbox.box (:key *Id) *B)
    (&stack_axis *A)
    (&span_split1 (:B_ B) (:A_ A) (:X_m1_ *X_m1) (:S_ *S)))

  (RULE &under
    (&diamond *Id)
    (&bar (:Id *M))
    (&span Id *S)
    (&span (:Id M) S))

  (RULE &spent
    (&under *Id *M)
    (&shape_color (:Id M) *Col)
    (&spend (:C Col)))

  (RULE &gaining
    (&under *Id *M)
    (&shape_color (:Id M) *Col)
    (&gain (:C Col)))

  ;; The diamonds of a gaining stack, from the base edge up.
  (INIT &stack_order Order
    (key ((&gaining *Id ^M))
      (member ((:t Id))
        (&gaining *Id M))
      (before ((:a Id) (:b Id2))
        (&gaining *Id M)
        (&gaining (:Id *Id2) M)
        (&bbox.box (:key Id) *B)
        (&bbox.box (:key (:Id Id2)) (:B *B2))
        (&grow *D)
        (dir_elem D)
        (margin (:B B2) D (:K *K1_m1))
        (margin B D (:K *K2_m2))
        (< K1_m1 K2_m2))))

  (RULE &top
    (&stack_order.maximal (:t *Id)))

  (RULE &height
    (&top (:Id *T))
    (&bbox.box (:key (:Id T)) *B)
    (&shape (:Id T) *P)
    (&stack_axis *A)
    (axis_elem A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A *N))

  (RULE &lift
    (&height *T *N)
    (&grow *D)
    (input *P)
    (dir8_opposite D (:D2 *O_m2))
    (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
    (edge_inset D (:K N) (:B *I_m5))
    (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
    (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q1))
    (&gap (:K *G))
    (dir8_opposite D (:D2 *O_m7))
    (edge_inset (:D O_m7) (:K G) (:B *B1_m8))
    (edge_inset D (:K G) (:B *I_m10))
    (relative (:Base I_m10) (:X 0) (:X_rel *B2_m9))
    (compose (:A B1_m8) (:B B2_m9) (:C *V_m6))
    (compose (:A Q1) (:B V_m6) (:C *Q)))

  (INIT &spent_count Cardinality
    (member ((:m Id))
      (&spent *Id)))

  ;; The top diamond lifted once per spent diamond.
  (INIT &grown Walk
    (key ((OR ((&lift ^T *P *Q))
              ((&top (:Id T))
               (&spent_count.size *N))))
      (successor ((:p P) (:p_next Q))
        (&lift T *P *Q))
      (steps (N)
        (&top (:Id T))
        (&spent_count.size *N)))))

(OUTPUT erase "the bars are erased")

;; The color a spent diamond takes.
(DET &spent_color AnyOutNewColor)

(RULE &added
  (&top (:Id *T))
  (&shape (:Id T) (:P *P2))
  (&grown.walk (:key T) (:p0 P2) (:N *K) (:p *P))
  (!= K 0))

(RULE &render
  (OR ((&added *T *P)
       (&shape_color (:Id T) *Col))
      ((&shape *Id P)
       (&diamond Id)
       (IF ((&spent Id))
           ((&spent_color (:C Col)))
           ((input P Col))))))

(RULE &output
  (OR ((input *P)
       (&render P *Col))
      ((input P)
       (NOT (&render P))
       (&bg Col))))
