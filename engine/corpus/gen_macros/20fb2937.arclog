;; 20fb2937

(DET &blob_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; Which side of the cutting line the header sits on.
(DET &header_dir DirDomain)

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

;; The cut: a line of a single non-bg color.
(RULE &cut_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D *K)
  (&cut_rank.rank (:key D) (:t K) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &side
  (&cut_divider *A)
  (axis_of *D A)
  (&cut_tile_of *P (:P_tile *P_part))
  (margin (:B P_part) D (:K 0)))

;; Each part's box, which that part is viewed from.
(INIT &hdr_box BoundingBox
  (cell (P)
    (&header_dir *D)
    (&side D *P)))

(RULE &header
  (&hdr_box.cell *P)
  (&hdr_box.box *B)
  (ALL ((&hdr_box.cell P)
        (&hdr_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_hdr))
  (input P *Col))

(DET &blob_node
  (&header (:E *Key) (:P_hdr *P) *Col)
  (NOT (&bg (:C Col))))

;; The header's colored blobs: the swatches and the key marks.
(INIT &blob Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&blob_node (:Key *Ky) *P)
         (&blob_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&blob_node (:Key Ky) (:P P2)))
        ((&blob_node (:Key Ky) P)
         (= P2 P)))))

(DET &blob_component
  (&blob.class (:a *Key *P) *Id))

;; Which side of a band the swatch sits on; the key mark takes the other. Bands run across this direction's axis.
(DET &swatch_dir DirDomain)

(RULE &band_axis
  (&swatch_dir *D)
  (axis_of D (:A *A2))
  (perp (:A A2) (:A2 *A)))

;; The gap between bands; layers abut, so they have none.
(DET &band_gap DivisorRatio)

(INIT &blob_box BoundingBox
  (key ((&blob_component (:Key ^E) *P ^Id))
    (cell (P)
      (&blob_component (:Key E) *P Id))))

(DET &tile_dim
  (&swatch_dir *D)
  (&blob_box.box (:key (:E *Ky_e) (:Id *Ky_id)) *B)
  (margin B D (:K 0))
  (&blob_box.cell (:key (:E Ky_e) (:Id Ky_id)) *P)
  (axis_elem *A)
  (relative (:Base B) (:X P) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A (:N *K)))

(DET &tile_count_division_gap_held
  (&tile_dim *A *K)
  (&band_axis A)
  (&band_gap (:K *G)))

(DET &tile_count_division_axis_split1
  (&header (:P_hdr *P_hdr_))
  (axis_elem (:A *A2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_hdr_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_hdr_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_hdr_) (:X_rel *X_m1_)))

(DET &tile_count_division_side_held
  (&tile_dim *A *K)
  (&band_axis A))

(DET &tile_count_division_axis
  (OR ((&header (:P_hdr *P))
       (&tile_dim (:A *Key_a) *K)
       (&band_axis (:A Key_a))
       (axis_elem *A)
       (OR ((!= A Key_a))
           ((NOT (&tile_count_division_side_held (:A Key_a) K))))
       (&tile_count_division_axis_split1 (:P_hdr_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&header (:P_hdr P))
       (&tile_dim (:A Key_a) K)
       (&band_axis (:A Key_a))
       (&band_gap (:K *G))
       (axis_of *D (:A Key_a))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key_a) (:N K))
       (= A Key_a))
      ((&header (:P_hdr P))
       (&tile_dim (:A Key_a) K)
       (&band_axis (:A Key_a))
       (OR ((!= Key_a Key_a))
           ((NOT (&tile_count_division_gap_held (:A Key_a) K))))
       (axis_of (:D *D2) (:A Key_a))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key_a) (:N K))
       (= A Key_a))))

(DET &tile_count_division_tile
  (&tile_count_division_axis (:Key_a *A) *K *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_count_division_axis (:Key_a A) K P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &tile_count_division2_cell
  (&header (:P_hdr *P))
  (&tile_dim (:A *Key)))

(DET &tile_count_division2_axis_split1
  (&tile_count_division2_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(DET &tile_count_division2_side_held
  (&tile_dim *A *K))

(DET &tile_count_division2_axis
  (OR ((&tile_count_division2_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&tile_count_division2_side_held (:A Key)))))
       (&tile_count_division2_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&tile_count_division2_cell Key P)
       (&tile_dim (:A Key) *K)
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K))
       (= A Key))))

(DET &tile_count_division2_tile
  (&tile_count_division2_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_count_division2_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &header_cell_division_cell
  (&header (:P_hdr *P))
  (&band_axis (:A *Key)))

(INIT &header_cell_division_sides ExtentDivisions
  (key ((&header_cell_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&header_cell_division_cell (:Key Ky) *P))))

(DET &tile_count
  (OR ((&header *E *P_hdr)
       (&tile_count_division_tile *A (:P P_hdr) (:P_outer *P_band))
       (frame_extent (:P P_band) A *N))
      ((&header (:E *E2) (:P_hdr *P_hdr2))
       (&tile_count_division2_tile (:Key A) (:P P_hdr2) (:P_outer *P_band2))
       (&band_axis (:A *A2))
       (perp (:A A2) (:A2 A))
       (frame_extent (:P P_band2) A N))))

(RULE &header_cell_division_gap_held
  (&band_axis *A)
  (&band_gap (:K *G)))

(RULE &header_cell_division_axis_split1
  (&header_cell_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &header_cell_division_parts_held
  (&band_axis *A)
  (&tile_count A *N))

(RULE &header_cell_division_axis
  (OR ((&header_cell_division_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&header_cell_division_parts_held (:A Key)))))
       (&header_cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&header_cell_division_cell Key P)
       (&band_axis (:A Key))
       (&tile_count (:A Key) *N)
       (&band_gap (:K *G))
       (&header_cell_division_sides.division (:key (:Ky Key)) (:A Key) N *K G)
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K))
       (= A Key))
      ((&header_cell_division_cell Key P)
       (&band_axis (:A Key))
       (&tile_count (:A Key) (:N *N2))
       (&band_gap (:K *G2))
       (frame_extent P (:A Key) (:N *K2))
       (axis_of (:D *D2) (:A Key))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap G2) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap G2) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K2))
       (frame_extent (:P P_outer) (:A Key) (:N N2))
       (= A Key))
      ((&header_cell_division_cell Key P)
       (&band_axis (:A Key))
       (&tile_count (:A Key) (:N *N3))
       (OR ((!= Key Key))
           ((NOT (&header_cell_division_gap_held (:A Key)))))
       (&header_cell_division_sides.division (:key (:Ky Key)) (:A Key) (:N N3) (:K *K3) (:G 0))
       (axis_of (:D *D3) (:A Key))
       (opposite (:D D3) (:Opp *O3))
       (margin (:B P) (:D D3) (:K *T4))
       (margin (:B P) (:D O3) (:K *T23))
       (divide (:T T4) (:Side K3) (:Gap 0) (:Part *I4) (:Remainder *R4))
       (divide (:T T23) (:Side K3) (:Gap 0) (:Part *I23) (:Remainder *R23))
       (opposite (:D D3) (:Opp *O_m13))
       (edge_inset (:D D3) (:K I4) (:B *B1_m23))
       (edge_inset (:D O_m13) (:K I23) (:B *B2_m33))
       (compose (:A B1_m23) (:B B2_m33) (:C P_outer))
       (opposite (:D D3) (:Opp *O_m43))
       (edge_inset (:D D3) (:K R4) (:B *B1_m53))
       (edge_inset (:D O_m43) (:K R23) (:B *B2_m63))
       (compose (:A B1_m53) (:B B2_m63) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K3))
       (= A Key))
      ((&header_cell_division_cell Key P)
       (&band_axis (:A Key))
       (&tile_count (:A Key) (:N *N4))
       (OR ((!= Key Key))
           ((NOT (&header_cell_division_gap_held (:A Key)))))
       (frame_extent P (:A Key) (:N *K4))
       (axis_of (:D *D4) (:A Key))
       (opposite (:D D4) (:Opp *O4))
       (margin (:B P) (:D D4) (:K *T5))
       (margin (:B P) (:D O4) (:K *T24))
       (divide (:T T5) (:Side K4) (:Gap 0) (:Part *I5) (:Remainder *R5))
       (divide (:T T24) (:Side K4) (:Gap 0) (:Part *I24) (:Remainder *R24))
       (opposite (:D D4) (:Opp *O_m14))
       (edge_inset (:D D4) (:K I5) (:B *B1_m24))
       (edge_inset (:D O_m14) (:K I24) (:B *B2_m34))
       (compose (:A B1_m24) (:B B2_m34) (:C P_outer))
       (opposite (:D D4) (:Opp *O_m44))
       (edge_inset (:D D4) (:K R5) (:B *B1_m54))
       (edge_inset (:D O_m44) (:K R24) (:B *B2_m64))
       (compose (:A B1_m54) (:B B2_m64) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K4))
       (frame_extent (:P P_outer) (:A Key) (:N N4))
       (= A Key))))

(RULE &header_cell_division_tile
  (&header_cell_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&header_cell_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(INIT &header_cell_division2_sides ExtentDivisions
  (key ((perp ^A ^A2))
    (frame ((:P P_hdr))
      (&header *P_hdr)
      (&header_cell_division_tile (:Key A) (:P P_hdr)))))

(RULE &header_cell_division2_axis_split1
  (&header (:P_hdr *P_hdr_))
  (axis_elem (:A *A3_))
  (axis_of (:D *D_m1) (:A A3_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_hdr_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_hdr_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_hdr_) (:X_rel *X_m1_)))

(RULE &header_cell_division2_parts_held
  (perp *A *A2)
  (&tile_count (:A A2) (:N *N2)))

(RULE &header_cell_division2_axis
  (OR ((&header (:P_hdr *P))
       (&header_cell_division_tile (:Key *Key_a) P)
       (perp (:A Key_a) *A2)
       (axis_elem *A)
       (OR ((!= A A2))
           ((NOT (&header_cell_division2_parts_held (:A Key_a) A2))))
       (&header_cell_division2_axis_split1 (:P_hdr_ P) (:A3_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&header (:P_hdr P))
       (&header_cell_division_tile (:Key Key_a) P)
       (perp (:A Key_a) A2)
       (&tile_count (:A A2) (:N *N2))
       (&header_cell_division2_sides.division (:key (:A Key_a) A2) (:A A2) (:N N2) *K (:G 0))
       (axis_of *D (:A A2))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A A2) (:N K))
       (= A A2))
      ((&header (:P_hdr P))
       (&header_cell_division_tile (:Key Key_a) P)
       (perp (:A Key_a) A2)
       (&tile_count (:A A2) (:N *N22))
       (frame_extent P (:A A2) (:N *K2))
       (axis_of (:D *D2) (:A A2))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A A2) (:N K2))
       (frame_extent (:P P_outer) (:A A2) (:N N22))
       (= A A2))))

(RULE &header_cell_division2_tile
  (&header_cell_division2_axis (:Key_a *A) *A2 *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) (:A2 *A22))
  (&header_cell_division2_axis (:Key_a A) A2 P (:A A22) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(RULE &header_cell_split1
  (&header_cell_division_tile (:Key *A_) (:P *P_hdr) (:P_outer *P_band) (:P_inner *P_slab_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_band_))
  (relative (:Base P_inner_band_) (:X P_slab_) (:X_rel *X_m1_)))

(RULE &header_cell_split2
  (&header_cell_division2_tile *A (:A2 *A2_) (:P *P_hdr) (:P_outer *P_layer) (:P_inner *P_slab2_))
  (axis_of (:D *D_m1) (:A A2_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_slab2_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_slab2_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_layer_))
  (relative (:Base P_inner_layer_) (:X P_slab2_) (:X_rel *X_m2_)))

(INIT &fld_box BoundingBox
  (cell (P)
    (&header_dir *D)
    (opposite D (:Opp *D2))
    (&side (:D D2) *P)))

(RULE &field
  (&fld_box.cell *P)
  (&fld_box.box *B)
  (ALL ((&fld_box.cell P)
        (&fld_box.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_fld))
  (input P *Col))

(RULE &header_cell
  (&header *P_hdr *Col)
  (&header_cell_division_tile (:Key *A) (:P P_hdr) (:P_outer *P_band) (:P_inner *P_slab))
  (&header_cell_split1 (:P_slab_ P_slab) (:A_ A) (:P_inner_band_ *P_inner_band) (:X_m1_ *X_m1))
  (&header_cell_division2_tile A *A2 (:P P_hdr) (:P_outer *P_layer) (:P_inner *P_slab2))
  (&header_cell_split2 (:P_slab2_ P_slab2) (:A2_ A2) (:P_inner_layer_ *P_inner_layer) (:X_m2_ *X_m2))
  (compose (:A P_inner_band) (:B P_inner_layer) (:C *P_intile)))

(ALTS $d "what the header's cut reads" $Count
  (ALT $Size
    (RULE &header_cell_division3_cell
      (&header (:P_hdr *P))
      (&band_axis (:A *Key)))

    (RULE &header_cell_division3_gap_held
      (&band_axis *A)
      (&band_gap (:K *G)))

    (RULE &header_cell_division3_axis_split1
      (&header_cell_division3_cell (:Key *Ky) (:P *P_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &header_cell_division3_side_held
      (&band_axis *A)
      (&tile_dim A *K))

    (RULE &header_cell_division3_axis
      (OR ((&header_cell_division3_cell *Key *P)
           (axis_elem *A)
           (OR ((!= A Key))
               ((NOT (&header_cell_division3_side_held (:A Key)))))
           (&header_cell_division3_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&header_cell_division3_cell Key P)
           (&band_axis (:A Key))
           (&tile_dim (:A Key) *K)
           (&band_gap (:K *G))
           (axis_of *D (:A Key))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K))
           (= A Key))
          ((&header_cell_division3_cell Key P)
           (&band_axis (:A Key))
           (&tile_dim (:A Key) (:K *K2))
           (OR ((!= Key Key))
               ((NOT (&header_cell_division3_gap_held (:A Key)))))
           (axis_of (:D *D2) (:A Key))
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key) (:N K2))
           (= A Key))))

    (RULE &header_cell_division3_tile
      (&header_cell_division3_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&header_cell_division3_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &header_cell_division4_axis_split1
      (&header (:P_hdr *P_hdr_))
      (axis_elem (:A *A3_))
      (axis_of (:D *D_m1) (:A A3_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_hdr_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_hdr_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_hdr_) (:X_rel *X_m1_)))

    (RULE &header_cell_division4_side_held
      (perp *A *A2)
      (&tile_dim (:A A2) (:K *K2)))

    (RULE &header_cell_division4_axis
      (OR ((&header (:P_hdr *P))
           (&header_cell_division3_tile (:Key *Key_a) P)
           (perp (:A Key_a) *A2)
           (axis_elem *A)
           (OR ((!= A A2))
               ((NOT (&header_cell_division4_side_held (:A Key_a) A2))))
           (&header_cell_division4_axis_split1 (:P_hdr_ P) (:A3_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&header (:P_hdr P))
           (&header_cell_division3_tile (:Key Key_a) P)
           (perp (:A Key_a) A2)
           (&tile_dim (:A A2) (:K *K2))
           (axis_of *D (:A A2))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K2) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K2) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A A2) (:N K2))
           (= A A2))))

    (RULE &header_cell_division4_tile
      (&header_cell_division4_axis (:Key_a *A) *A2 *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) (:A2 *A22))
      (&header_cell_division4_axis (:Key_a A) A2 P (:A A22) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &header_cell_split3
      (&header_cell_division3_tile (:Key *A_) (:P *P_hdr) (:P_outer *P_band) (:P_inner *P_slab_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_band_))
      (relative (:Base P_inner_band_) (:X P_slab_) (:X_rel *X_m1_)))

    (RULE &header_cell_split4
      (&header_cell_division4_tile *A (:A2 *A2_) (:P *P_hdr) (:P_outer *P_layer) (:P_inner *P_slab2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_slab2_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_slab2_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_inner_layer_))
      (relative (:Base P_inner_layer_) (:X P_slab2_) (:X_rel *X_m2_)))

    (RULE &header_cell
      (&header *P_hdr *Col)
      (&header_cell_division3_tile (:Key *A) (:P P_hdr) (:P_outer *P_band) (:P_inner *P_slab))
      (&header_cell_split3 (:P_slab_ P_slab) (:A_ A) (:P_inner_band_ *P_inner_band) (:X_m1_ *X_m1))
      (&header_cell_division4_tile A *A2 (:P P_hdr) (:P_outer *P_layer) (:P_inner *P_slab2))
      (&header_cell_split4 (:P_slab2_ P_slab2) (:A2_ A2) (:P_inner_layer_ *P_inner_layer) (:X_m2_ *X_m2))
      (compose (:A P_inner_band) (:B P_inner_layer) (:C *P_intile)))))

(ALTS $paint "what a marked field cell becomes" $Neighbor
  (ALT $Stamp
    (DET &hit
      (&mark *E *P_fld *P_band)
      (&swatch_color E P_band *Col)
      (ex_output E (:P *Q) Col))

    (DET &offset
      (&hit (:P_fld *P) *Q)
      (relative (:Base P) (:X Q) (:X_rel *Delta)))

    (DET &missed
      (&offset *Delta)
      (ex_output *E)
      (&mark E (:P_fld *P) *P_band)
      (&swatch_color E P_band *Col)
      (compose (:A P) (:B Delta) (:C *Q))
      (NOT (ex_output E (:P Q) Col)))

    (DET &shape
      (&offset *Delta)
      (NOT (&missed Delta)))

    (RULE &paint
      (&mark (:P_fld *P) *P_band)
      (&swatch_color P_band *Col)
      (&shape *Delta)
      (compose (:A P) (:B Delta) (:C *P_fld))
      (&field P_fld)))
  (ALT $Blit
    (RULE &paint
      (&mark (:P_fld *P) *P_band)
      (&swatch P_band (:P_intile *S) *Col)
      (&band_key P_band (:P_intile *P_key))
      (relative (:Base P_key) (:X S) (:X_rel *Delta))
      (compose (:A P) (:B Delta) (:C *P_fld))
      (&field P_fld))))

(RULE &swatch
  (&header_cell *P_layer *P_band *P_intile *Col)
  (&swatch_dir *D)
  (margin (:B P_layer) D (:K 0)))

(RULE &swatch_color
  (&swatch *P_band *Col))

(RULE &band_key
  (&header_cell *P_layer *P_band *P_intile *Col)
  (NOT (&bg (:C Col)))
  (&swatch_dir *D)
  (opposite D (:Opp *D2))
  (margin (:B P_layer) (:D D2) (:K 0)))

(RULE &mark
  (&field *P_fld *Col)
  (&band_key *P_band Col))

(RULE &paint
  (&mark (:P_fld *P) *P_band)
  (&swatch_color P_band *Col)
  (&field *P_fld)
  (OR ((= P_fld P))
      ((dir8_elem *D)
       (step_offset D (:V *V_m1))
       (compose (:A P) (:B V_m1) (:C P_fld)))))

(RULE &output
  (OR ((&paint (:P_fld *P) *Col))
      ((&field (:P_fld P))
       (NOT (&paint (:P_fld P)))
       (&bg (:C Col)))))
