;; 332efdb3

(RULE &on_tile_division_cell
  (input *P)
  (axis_elem (:A *Key)))

(DET &tile_gap DivisorRatio)

(DET &tile_size DivisorRatio)

(RULE &on_tile_division_gap_held
  (axis_elem *A)
  (&tile_gap (:K *G)))

(RULE &on_tile_division_axis_split1
  (&on_tile_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &on_tile_division_side_held
  (axis_elem *A)
  (&tile_size *K))

(RULE &on_tile_division_axis
  (OR ((&on_tile_division_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&on_tile_division_side_held (:A Key)))))
       (&on_tile_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&on_tile_division_cell Key P)
       (axis_elem (:A Key))
       (&tile_size *K)
       (&tile_gap (:K *G))
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K))
       (= A Key))
      ((&on_tile_division_cell Key P)
       (axis_elem (:A Key))
       (&tile_size (:K *K2))
       (OR ((!= Key Key))
           ((NOT (&on_tile_division_gap_held (:A Key)))))
       (axis_of (:D *D2) (:A Key))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K2))
       (= A Key))))

(RULE &on_tile_division_tile
  (&on_tile_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&on_tile_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &bg AnyOutNewColor)

(DET &dot DominantColor)

(RULE &on_tile
  (&on_tile_division_tile *P))

(ALTS $choice "which model reconstructs the wallpaper" $Stripes
  (ALT $Motif
    (INIT &si Periods
      (key ((ex_output ^E *P *Col))
        (cell (P (:v Col))
          (ex_output E *P *Col))))

    (DET &si_mismatch
      (ex_output (:E *Key) *P)
      (axis_of (:D *D_m2) *A)
      (sub_extent P A *K)
      (dir8_opposite (:D D_m2) (:D2 *O_m3))
      (edge_inset (:D O_m3) K (:B *B1_m4))
      (edge_inset (:D D_m2) K (:B *I_m6))
      (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
      (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
      (NOT (&si.period (:key (:E Key)) A K)))

    (INIT &unbroken Order
      (key ((ex_output *P)
            (axis_of (:D *D_m2) ^A)
            (sub_extent P A *K)
            (dir8_opposite (:D D_m2) (:D2 *O_m3))
            (edge_inset (:D O_m3) K (:B *B1_m4))
            (edge_inset (:D D_m2) K (:B *I_m6))
            (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
            (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
            (NOT (&si_mismatch A K)))
        (member ((:t K))
          (ex_output *P)
          (axis_of (:D *D_m2) A)
          (sub_extent P A *K)
          (dir8_opposite (:D D_m2) (:D2 *O_m3))
          (edge_inset (:D O_m3) K (:B *B1_m4))
          (edge_inset (:D D_m2) K (:B *I_m6))
          (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
          (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
          (NOT (&si_mismatch A K)))
        (score ((:t K) (:S K))
          (ex_output *P)
          (axis_of (:D *D_m2) A)
          (sub_extent P A *K)
          (dir8_opposite (:D D_m2) (:D2 *O_m3))
          (edge_inset (:D O_m3) K (:B *B1_m4))
          (edge_inset (:D D_m2) K (:B *I_m6))
          (relative (:Base I_m6) (:X 0) (:X_rel *B2_m5))
          (compose (:A B1_m4) (:B B2_m5) (:C *V_m1))
          (NOT (&si_mismatch A K)))))

    (DET &period
      (&unbroken.minimal (:key *A) (:t *K)))

    (DET &window
      (ex_output *E (:P *Q))
      (diag_dir_elem (:D *Diag))
      (corner_dir (:C Diag) *A (:D *D1_m1))
      (perp A (:A2 *A2_m3))
      (corner_dir (:C Diag) (:A A2_m3) (:D *D2_m2))
      (margin (:B Q) (:D D1_m1) (:K *K1))
      (margin (:B Q) (:D D2_m2) (:K *K2))
      (&period A (:K *S1))
      (<= K1 S1)
      (perp A *A2)
      (&period (:A A2) (:K *S2))
      (<= K2 S2))

    ;; Each window's cells in the motif's own frame.
    (INIT &wframe BoundingBox
      (key ((&window ^E ^Diag *Q))
        (cell ((:P Q))
          (&window E Diag *Q))))

    (DET &motif_inside1
      (&window *E (:Diag *Dg) (:Q *Q_))
      (&wframe.box (:key E (:Diag Dg)) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X Q_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &motif
      (&window *E (:Diag *Dg) *Q)
      (&wframe.box (:key E (:Diag Dg)) *B)
      (NOT (&motif_inside1 (:Q_ Q) (:B_ B)))
      (relative (:Base B) (:X Q) (:X_rel *P))
      (ex_output E (:P Q) (:Col *C)))

    (RULE &lattice_phase
      (OR ((input *P))
          ((&motif P)))
      (corner_dir (:C *Dg) *A (:D *D1_m1))
      (perp A (:A2 *A2_m3))
      (corner_dir (:C Dg) (:A A2_m3) (:D *D2_m2))
      (margin (:B P) (:D D1_m1) (:K *T))
      (margin (:B P) (:D D2_m2) (:K *T2))
      (perp A *A2)
      (&period A *K)
      (divide T (:Side K) (:Gap 0) (:Remainder *R))
      (&period (:A A2) (:K *K2))
      (divide (:T T2) (:Side K2) (:Gap 0) (:Remainder *R2)))

    ;; The motif seats at every corner, and each cell takes the motif cell at
    ;; its place in the lattice.
    (RULE &output
      (&motif (:P *Pm) (:C *Col))
      (&lattice_phase *Dg *A (:P Pm) *R *R2)
      (input *P)
      (&lattice_phase Dg A P R R2)))
  (ALT $Inset
    ;; The dots span the interior frame, so their distance to a grid edge is
    ;; the border's width there.
    (INIT &bbox BoundingBox
      (key ((ex_output ^E *P *Col)
            (&dot (:C Col)))
        (cell (P)
          (ex_output E *P *Col)
          (&dot (:C Col)))))

    (DET &border_width
      (&bbox.box *B)
      (dir_elem *D)
      (margin B D *K))

    (RULE &interior_tile_division_axis_uniform_inset1
      (&border_width (:K *K1_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K1_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K1_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K1_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K1_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &interior_tile_division_axis_uniform_inset2
      (&border_width (:K *K1_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K1_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K1_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K1_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K1_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &interior_tile_division_gap
      (axis_elem *A)
      (&tile_gap (:K *G)))

    (RULE &interior_tile_division_axis_split1
      (&border_width (:K *K1))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m7))
      (edge_inset (:D D1_m1) (:K K1) (:B *B1_m8))
      (edge_inset (:D O_m7) (:K K1) (:B *B2_m9))
      (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m10))
      (edge_inset (:D D2_m4) (:K K1) (:B *B1_m11))
      (edge_inset (:D O_m10) (:K K1) (:B *B2_m12))
      (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B))
      (input *P)
      (relative (:Base B) (:X P) (:X_rel *P_inner_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m13))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m14))
      (edge_inset (:D O_m13) (:K K2_m4) (:B *B2_m15))
      (compose (:A B1_m14) (:B B2_m15) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &interior_tile_division_axis_uniform_inset3
      (&border_width (:K *K1_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K1_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K1_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K1_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K1_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &interior_tile_division_side
      (axis_elem *A)
      (&tile_size *K))

    (RULE &interior_tile_division_axis
      (OR ((input (:P *P2))
           (&border_width (:K *K1))
           (&interior_tile_division_axis_uniform_inset1 (:K1_ K1) (:B_ *B))
           (ALL ((&border_width (:K *K1m))
                 (axis_of (:D *D1_m1) (:A *A1_m2))
                 (perp (:A A1_m2) (:A2 *A2_m3))
                 (axis_of (:D *D2_m4) (:A A2_m3))
                 (opposite (:D D1_m1) (:Opp *O_m7))
                 (edge_inset (:D D1_m1) (:K K1m) (:B *B1_m8))
                 (edge_inset (:D O_m7) (:K K1m) (:B *B2_m9))
                 (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5m))
                 (opposite (:D D2_m4) (:Opp *O_m10))
                 (edge_inset (:D D2_m4) (:K K1m) (:B *B1_m11))
                 (edge_inset (:D O_m10) (:K K1m) (:B *B2_m12))
                 (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6m))
                 (compose (:A B1_m5m) (:B B2_m6m) (:C B))
                 (dir_elem (:D *D_m1))
                 (relative (:Base B) (:X P2) (:X_rel *R_m2))
                 (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                ((>= K_m3 0)))
           (relative (:Base B) (:X P2) (:X_rel *P))
           (axis_elem *A)
           (&tile_size *K)
           (&tile_gap (:K *G))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap G) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap G) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input (:P *P22))
           (&border_width (:K *K12))
           (&interior_tile_division_axis_uniform_inset2 (:K1_ K12) (:B_ *B2))
           (ALL ((&border_width (:K *K1m2))
                 (axis_of (:D *D1_m12) (:A *A1_m22))
                 (perp (:A A1_m22) (:A2 *A2_m32))
                 (axis_of (:D *D2_m42) (:A A2_m32))
                 (opposite (:D D1_m12) (:Opp *O_m72))
                 (edge_inset (:D D1_m12) (:K K1m2) (:B *B1_m82))
                 (edge_inset (:D O_m72) (:K K1m2) (:B *B2_m92))
                 (compose (:A B1_m82) (:B B2_m92) (:C *B1_m5m2))
                 (opposite (:D D2_m42) (:Opp *O_m102))
                 (edge_inset (:D D2_m42) (:K K1m2) (:B *B1_m112))
                 (edge_inset (:D O_m102) (:K K1m2) (:B *B2_m122))
                 (compose (:A B1_m112) (:B B2_m122) (:C *B2_m6m2))
                 (compose (:A B1_m5m2) (:B B2_m6m2) (:C B2))
                 (dir_elem (:D *D_m12))
                 (relative (:Base B2) (:X P22) (:X_rel *R_m22))
                 (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                ((>= K_m32 0)))
           (relative (:Base B2) (:X P22) (:X_rel P))
           (axis_elem A)
           (&tile_size (:K *K2))
           (NOT (&interior_tile_division_gap A))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2)))
          ((input (:P *P23))
           (&border_width (:K *K13))
           (&interior_tile_division_axis_uniform_inset3 (:K1_ K13) (:B_ *B3))
           (ALL ((&border_width (:K *K1m3))
                 (axis_of (:D *D1_m13) (:A *A1_m23))
                 (perp (:A A1_m23) (:A2 *A2_m33))
                 (axis_of (:D *D2_m43) (:A A2_m33))
                 (opposite (:D D1_m13) (:Opp *O_m73))
                 (edge_inset (:D D1_m13) (:K K1m3) (:B *B1_m83))
                 (edge_inset (:D O_m73) (:K K1m3) (:B *B2_m93))
                 (compose (:A B1_m83) (:B B2_m93) (:C *B1_m53))
                 (opposite (:D D2_m43) (:Opp *O_m103))
                 (edge_inset (:D D2_m43) (:K K1m3) (:B *B1_m113))
                 (edge_inset (:D O_m103) (:K K1m3) (:B *B2_m123))
                 (compose (:A B1_m113) (:B B2_m123) (:C *B2_m63))
                 (compose (:A B1_m53) (:B B2_m63) (:C B3))
                 (dir_elem (:D *D_m13))
                 (relative (:Base B3) (:X P23) (:X_rel *R_m23))
                 (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
                ((>= K_m33 0)))
           (relative (:Base B3) (:X P23) (:X_rel P))
           (axis_elem A)
           (NOT (&interior_tile_division_side A))
           (&interior_tile_division_axis_split1 (:P_inner_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &interior_tile_division_tile
      (&interior_tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&interior_tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &interior_tile_uniform_inset1
      (&border_width (:K *K1_))
      (axis_of (:D *D1_m1) (:A *A1_m2))
      (perp (:A A1_m2) (:A2 *A2_m3))
      (axis_of (:D *D2_m4) (:A A2_m3))
      (opposite (:D D1_m1) (:Opp *O_m1))
      (edge_inset (:D D1_m1) (:K K1_) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K1_) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
      (opposite (:D D2_m4) (:Opp *O_m4))
      (edge_inset (:D D2_m4) (:K K1_) (:B *B1_m6))
      (edge_inset (:D O_m4) (:K K1_) (:B *B2_m7))
      (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
      (compose (:A B1_m5) (:B B2_m6) (:C *B_)))

    (RULE &interior_tile
      (input *P)
      (&border_width (:K *K1))
      (&interior_tile_uniform_inset1 (:K1_ K1) (:B_ *B))
      (ALL ((&border_width (:K *K1m))
            (axis_of (:D *D1_m1) (:A *A1_m2))
            (perp (:A A1_m2) (:A2 *A2_m3))
            (axis_of (:D *D2_m4) (:A A2_m3))
            (opposite (:D D1_m1) (:Opp *O_m7))
            (edge_inset (:D D1_m1) (:K K1m) (:B *B1_m8))
            (edge_inset (:D O_m7) (:K K1m) (:B *B2_m9))
            (compose (:A B1_m8) (:B B2_m9) (:C *B1_m5))
            (opposite (:D D2_m4) (:Opp *O_m10))
            (edge_inset (:D D2_m4) (:K K1m) (:B *B1_m11))
            (edge_inset (:D O_m10) (:K K1m) (:B *B2_m12))
            (compose (:A B1_m11) (:B B2_m12) (:C *B2_m6))
            (compose (:A B1_m5) (:B B2_m6) (:C B))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&interior_tile_division_tile (:P P_inner)))

    (RULE &output
      (input *P)
      (IF ((&interior_tile P))
          ((&dot (:C *Col)))
          ((&bg (:C Col)))))))

(RULE &output
  (input *P)
  (IF ((&on_tile P))
      ((&bg (:C *Col)))
      ((&dot (:C Col)))))
