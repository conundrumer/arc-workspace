;; 32e9702f

(DET &dir DirDomain)

(DET &bg ChangedColor)

(DET &fill AnyOutNewColor)

(RULE &moved
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (&dir *D)
  (step_offset D (:V *V_m1))
  (compose (:A P2) (:B V_m1) (:C *P))
  (input P))

(RULE &output
  (OR ((&moved *P *Col))
      ((input P)
       (NOT (&moved P))
       (&fill (:C Col)))))
