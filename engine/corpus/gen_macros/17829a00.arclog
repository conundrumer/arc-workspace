;; 17829a00

(RULE &obj_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(DET &bg DominantColor)

;; The axis the borders cap at both ends.
(DET &axis AxisDomain)

(RULE &border_cell
  (&axis *A)
  (axis_of *D A)
  (input *P)
  (margin (:B P) D (:K 0)))

(RULE &inner_cell
  (input *P)
  (NOT (&border_cell P)))

(RULE &obj_node
  (&inner_cell *P)
  (input P (:Col *Key))
  (NOT (&bg (:C Key))))

(INIT &obj Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&obj_node (:Key *Ky) *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&obj_node (:Key Ky) (:P P2)))
        ((&obj_node (:Key Ky) P)
         (= P2 P)))))

(RULE &obj_component
  (&obj.class (:a *Key *P) *Id))

(RULE &move_dir
  (&obj_component (:Key *Col) *Id)
  (&border_cell *D *P)
  (input P Col))

;; Each object travels until it meets its border.
(INIT &gravity Distance
  (key ((OR ((&obj_component *P ^Id)
             (&move_dir Id *D)
             (margin (:B P) D *K))
            ((&obj_component P Id)
             (&move_dir Id D)
             (&move_dir Id (:D *D2))
             (&border_cell (:D D2) (:P *P2))
             (gap D P (:Q P2) K))))
    (source_distance (K)
      (OR ((&obj_component *P Id)
           (&move_dir Id *D)
           (margin (:B P) D *K))
          ((&obj_component (:P *P3) Id)
           (&move_dir Id (:D *D3))
           (&move_dir Id (:D *D2))
           (&border_cell (:D D2) (:P *P2))
           (gap (:D D3) (:P P3) (:Q P2) K))))))

(RULE &landed
  (&gravity.distance (:key *Id) *K)
  (&move_dir Id *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (&obj_component (:Key *Col) (:P *P3) Id)
  (compose (:A P3) (:B V) (:C *P)))

(RULE &output
  (OR ((&border_cell *P)
       (input P *Col))
      ((&landed P Col))
      ((&inner_cell P)
       (NOT (&landed P))
       (&bg (:C Col)))))
