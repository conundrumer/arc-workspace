;; 2bcee788

(DET &bg DominantColor)

(DET &ground AnyOutNewColor)

(DET &marker RarestColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &marker_cell
  (&ink *P *Col)
  (&marker (:C Col)))

(ALTS $l "which ink is the marker" $Stored
  (ALT $Minority
    (INIT &size Cardinality
      (key ((&ink *P ^Col))
        (member ((:m P))
          (&ink *P Col))))

    (INIT &rare Order
      (member ((:t (:V Col) (:S N)))
        (&size.size (:key *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&size.size (:key *Col) *N)))

    (RULE &marker_cell
      (&ink *P *Col)
      (&rare.minimal (:t (:V Col))))))

(ALTS $w "the wall — the mirror is the center of the box its two lines bound" $Edge
  (ALT $Seam
    (INIT &wall BoundingBox
      (cell ((:P Q))
        (&mark_dir *D)
        (&marker_cell (:P *M))
        (input *P)
        (margin (:B P) D (:K *K_m1))
        (margin (:B M) D (:K K_m1))
        (OR ((opposite D (:Opp *D_back))
             (step_offset (:D D_back) (:V *V_m2))
             (compose (:A P) (:B V_m2) (:C *Q)))
            ((= Q P))))))
  (ALT $Image
    (INIT &wall BoundingBox
      (cell ((:P Q))
        (&mark_dir *D)
        (input (:P *Q))
        (OR ((&shape_box.box *B)
             (margin (:B Q) D (:K *K_m1))
             (margin B D (:K K_m1)))
            ((&marker_cell (:P *M))
             (margin (:B Q) D (:K *K_m2))
             (margin (:B M) D (:K K_m2))))))))

(RULE &shape_cell
  (&ink *P)
  (NOT (&marker_cell P)))

(INIT &shape_box BoundingBox
  (cell (P)
    (&shape_cell *P)))

(RULE &short_of
  (dir_elem *D)
  (&marker_cell (:P *M))
  (margin (:B M) D *K)
  (&shape_box.box *B)
  (margin B D (:K *K0))
  (>= K K0))

(RULE &mark_dir
  (dir_elem *D)
  (NOT (&short_of D)))

(INIT &wall BoundingBox
  (cell ((:P Q))
    (&mark_dir *D)
    (&shape_box.box *B)
    (input *P)
    (margin (:B P) D (:K *K_m1))
    (margin B D (:K K_m1))
    (OR ((step_offset D (:V *V_m2))
         (compose (:A P) (:B V_m2) (:C *Q)))
        ((= Q P)))))

(RULE &mirror
  (&mark_dir *D)
  (axis_of D *A)
  (axis_inversion A *T)
  (&shape_cell *P)
  (&wall.box *B)
  (relative (:Base B) (:X P) (:X_rel *V))
  (apply (:D T) (:P V) (:P_out *V2))
  (compose (:A B) (:B V2) (:C *Q))
  (input (:P Q)))

(RULE &paint
  (&shape_cell (:P *P2))
  (input (:P P2) *Col)
  (OR ((&mirror (:P P2) (:Q *P)))
      ((= P P2))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&ground (:C Col)))))
