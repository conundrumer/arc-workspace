;; 760b3cac

(DET &tile_dim TileCount)

(RULE &tile_division_axis_split1
  (input (:P *P_grid_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_grid_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_grid_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_grid_) (:X_rel *X_m1_)))

(RULE &tile_division_side
  (axis_elem *A)
  (&tile_dim (:N *K)))

(RULE &tile_division_axis
  (OR ((input *P)
       (axis_elem *A)
       (&tile_dim (:N *K))
       (axis_of *D A)
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
       (frame_extent (:P P_inner) A (:N K)))
      ((input P)
       (axis_elem A)
       (NOT (&tile_division_side A))
       (&tile_division_axis_split1 (:P_grid_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

(RULE &tile_division_tile
  (&tile_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&tile_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

(DET &pattern UnchangedColor)

(RULE &tile
  (input (:P *P_grid))
  (&tile_division_tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(RULE &pattern_tile
  (input (:P *P_grid) *Col)
  (&pattern (:C Col))
  (&tile P_grid *P_tile))

(INIT &mirror_tiling Tiling
  (outer ((:P T_pat))
    (&pattern_tile (:P_tile *T_pat)))
  (inner ((:P Q_intile))
    (&tile *P_intile)
    (axis_inversion (:T *F))
    (apply (:D F) (:P P_intile) (:P_out *Q_intile))))

(DET &marker UnchangedColor)

;; The axis the marker's corner points along.
(DET &axis AxisDomain)

(RULE &marker_cell
  (input (:P *P_grid) *Col)
  (&marker (:C Col))
  (&tile P_grid *P_tile *P_intile))

(RULE &dir
  (&marker_cell *P_intile)
  (corner_dist (:P P_intile) *Diag (:K 0))
  (&axis *A)
  (corner_dir (:C Diag) A *D))

(ALTS $choice "how the marker's pointing direction is read" $Corner
  (ALT $Lean
    (DET &facing
      (&marker_cell *E (:P_tile *T_mark))
      (&pattern_tile E (:P_tile *T_pat))
      (dir_elem *D)
      (step_offset D (:V *V_m1))
      (compose (:A T_mark) (:B V_m1) (:C T_pat)))

    (RULE &dir
      (&facing (:D *D_near))
      (&marker_cell (:P_intile *P_near))
      (margin (:B P_near) (:D D_near) (:K 0))
      (opposite (:D D_near) (:Opp *D_far))
      (&marker_cell (:P_intile *P_far))
      (margin (:B P_far) (:D D_far) (:K 0))
      (axis_of (:D D_near) (:A *A_m1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (axis_of *D (:A A2_m2))
      (dir_elem D)
      (margin (:B P_near) D (:K *K1_m3))
      (margin (:B P_far) D (:K *K2_m4))
      (< K1_m3 K2_m4))))

(RULE &mirror
  (&dir *D)
  (&mirror_tiling.cell (:P_outer *T_pat) (:P_inner *Q_intile) (:P *Q_grid))
  (step_offset D (:V *V_m1))
  (compose (:A T_pat) (:B V_m1) (:C *T_out))
  (&tile *P_grid (:P_tile T_out) *P_intile)
  (axis_of D *A)
  (axis_inversion A (:T *F))
  (apply (:D F) (:P P_intile) (:P_out Q_intile)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&mirror (:P_grid P))))
      ((&mirror (:P_grid P) *Q_grid)
       (input (:P Q_grid) Col))))
