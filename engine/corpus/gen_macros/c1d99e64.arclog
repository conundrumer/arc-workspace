;; c1d99e64

(RULE &has_ink_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(RULE &on_bg_line_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(DET &bg RarestColor)

(DET &line AnyOutNewColor)

(RULE &on_bg_line
  (input *P)
  (axis_elem *A)
  (&on_bg_line_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across))
  (ALL ((input (:P *Pm) *Col)
        (&has_ink_split1 (:P_ Pm) (:A_ A) (:X_m1_ *X_m1m) (:P_across_ P_across)))
       ((&bg (:C Col)))))

(RULE &output
  (OR ((&on_bg_line *P)
       (&line (:C *Col)))
      ((input P Col)
       (NOT (&on_bg_line P)))))
