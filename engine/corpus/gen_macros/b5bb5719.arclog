;; b5bb5719

(INPUT seed-row "the line at the edge opposite &grow_dir holds cells of the two colors of &swap, with &background cells among them, and every other cell is &background"

  (DET &grow_dir DirDomain)

  (DET_OR_RULE &background DominantColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&background Col)))

  (DET &swap
    (ex_input *Col)
    (NOT (&background Col))
    (ex_input (:Col *Col2))
    (NOT (&background (:Col Col2)))
    (!= Col Col2))

  (INIT &seed_edge Singleton
    (member ((:v D))
      (dir_elem *D)
      (ALL ((&ink *P))
           ((margin (:B P) D (:K 0)))))))

(OUTPUT fill-under-pair "row by row in &grow_dir, a &background cell whose two diagonal neighbors in the row before it are both filled becomes filled")

(OUTPUT swap-side-neighbor "a filled cell takes the color that &swap pairs with the color of its diagonal neighbor in the row before it on the read side, the side a quarter turn in &read_sense from &grow_dir"

  (RULE &grow
    (&grow_dir *D))

  ;; the turn from the grow direction to the read side
  (DET &read_sense SenseDomain)

  (RULE &bearing
    (&grow (:D *D_grow))
    (opposite (:D D_grow) (:Opp *D_back))
    (&read_sense *S)
    (turn S (:D D_grow) (:D2 *D_read)))

  (RULE &above
    (&bearing *D_back *D_read)
    (opposite (:D D_read) (:Opp *D_far))
    (input (:P *Q))
    (step_offset (:D D_back) (:V *V_m1))
    (compose (:A Q) (:B V_m1) (:C *Q0))
    (step_offset (:D D_read) (:V *V_m2))
    (compose (:A Q0) (:B V_m2) (:C *P_read))
    (step_offset (:D D_far) (:V *V_m3))
    (compose (:A Q0) (:B V_m3) (:C *P_far)))

  (RULE &seed
    (&grow)
    (&ink *P))

  (INIT &fill Propagation
    (source ((:n P))
      (&seed *P))
    (join ((:a P_read) (:b P_far) (:c Q))
      (&above *Q *P_read *P_far)
      (input (:P Q) *Col)
      (&background Col)))

  (RULE &filled
    (&fill.reached (:n *Q))
    (NOT (&seed (:P Q))))

  (RULE &head
    (&filled *Q)
    (&bearing *D_back *D_read)
    (corner_dir (:C *D) (:A *A_m1) (:D D_back))
    (perp (:A A_m1) (:A2 *A2_m2))
    (corner_dir (:C D) (:A A2_m2) (:D D_read))
    (margin (:B Q) (:D D_back) *K)
    (dir8_opposite D (:D2 *O_m4))
    (edge_inset (:D O_m4) K (:B *B1_m5))
    (edge_inset D K (:B *I_m7))
    (relative (:Base I_m7) (:X 0) (:X_rel *B2_m6))
    (compose (:A B1_m5) (:B B2_m6) (:C *V_m3))
    (compose (:A Q) (:B V_m3) (:C *P)))

  (INIT &flips Walk
    (successor ((:p Col) (:p_next Col2))
      (&swap *Col *Col2))
    (steps ((:N K))
      (&head *K))))

(OUTPUT keep-rest "every other cell keeps its input color"

  (RULE &span_axis
    (&grow *D)
    (axis_of D (:A *A_grow))
    (perp (:A A_grow) (:A2 *A)))

  (RULE &span_dir
    (&span_axis *A)
    (axis4_of *D A))

  (RULE &span_node
    (&span_axis)
    (input *P))

  (RULE &span_source
    (&grow)
    (&ink *P))

  (INIT &span Distance
    (key ((&span_source (:P ^O))
          (&span_dir ^D))
      (edge ((:a A2) (:b Q))
        (OR ((&span_source (:P O))
             (&span_dir D)
             (axis_of D *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite D (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset D K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&span_node (:P A2))
             (step_offset D (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&span_node (:P Q)))
            ((&span_source (:P O))
             (&span_dir D)
             (step_offset D (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&span_node (:P Q))
             (= A2 O))
            ((&span_source (:P O))
             (&span_dir D)
             (diag_dir_elem D)
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite D (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset D (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&span_node (:P A2))
             (step_offset D (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&span_node (:P Q)))))
      (source ((:n O))
        (&span_source (:P O))
        (&span_dir D))))

  (RULE &span_ray
    (&span.distance (:key *D (:O *Origin)) (:n *P) *K))

  (INIT &paint Propagation
    (source ((:n P Col))
      (&seed *P)
      (input P *Col))
    (edge ((:a (:P P_read) Col) (:b (:P Q) (:Col Col2)))
      (&filled *Q)
      (&above Q *P_read)
      (&swap *Col *Col2))))

(ALTS $s "which cells fill" $UnderPair
  (ALT $SpanTriangle
    (OUTPUT fill-under-pair "the &background cells of the triangle under the span from the seed row's first to its last filled cell fill, row by row in &grow_dir; undefined where a triangle cell's read side diagonal neighbor is &background"
      (RULE &span_between
        (&grow)
        (input *P)
        (&span_axis *A)
        (axis4_of *D A)
        (dir8_opposite D (:D2 *O))
        (&span_ray P D)
        (&span_ray P (:D O)))

      (RULE &seed
        (&span_between *P)))))

(ALTS $pa "which color a filled cell takes" $SwapSide
  (ALT $MixedTakesOtherSide
    (OUTPUT swap-side-neighbor "under two cells of one color, a filled cell takes that color's &swap partner, and under two cells of different colors, it takes the color of the neighbor opposite the read side; undefined where both neighbors have one color outside &swap"
      (RULE &hue
        (OR ((input *Col))
            ((&swap (:Col2 Col)))))

      (INIT &paint Propagation
        (source ((:n P Col))
          (&seed *P)
          (input P *Col))
        (join ((:a (:P P_read) (:Col Col1)) (:b (:P P_far) (:Col Col2)) (:c (:P Q) Col))
          (&filled *Q)
          (&above Q *P_read *P_far)
          (&hue (:Col *Col1))
          (&hue (:Col *Col2))
          (OR ((= Col1 Col2)
               (&swap (:Col Col1) (:Col2 *Col)))
              ((!= Col1 Col2)
               (= Col Col2)))))))
  (ALT $DiagonalHead
    (OUTPUT swap-side-neighbor "a filled cell takes the color of the seed row cell at the head of its read side diagonal, passed through &swap once per row between the two; undefined where that head is a color outside &swap")
    (RULE &tint
      (&head *Q *K *P)
      (input P (:Col *Col0))
      (&flips.walk (:p0 Col0) (:N K) (:p *Col)))))

(ALTS $h "where the grow direction comes from" $StoredGrow
  (ALT $GrowFromSeedEdge
    (INPUT seed-row "the line at one edge holds every cell outside &background, and the pyramid grows away from that edge; undefined where no edge line or more than one holds every such cell"
      (RULE &grow
        (&seed_edge.value (:v *D_edge))
        (opposite (:D D_edge) (:Opp *D))))))

(RULE &span_end
  (&span_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray (:P Q) D Origin)))

(RULE &tint
  (&paint.reached (:n (:P *Q) *Col)))

(RULE &output
  (&grow)
  (input *P (:Col *Col_in))
  (IF ((&filled (:Q P)))
      ((&tint (:Q P) *Col))
      ((= Col Col_in))))
