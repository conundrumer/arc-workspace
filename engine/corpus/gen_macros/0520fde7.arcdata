(param &tile_dim number (3))
(param &tile_decompose (Position Position Position) (Division
  ((:A AXIS_V) (:Count 1) (:Size 3) (:Gap 0))
  ((:A AXIS_H) (:Count 2) (:Size 3) (:Gap 1))))
(param &divide_axis Axis (AXIS_H))
(param &divide_gap number (1))
(param &divisor number (2))
(param &combine (Ident Color Position Color)
  (0 0 (grid
    (0 0)))
  (1 0 (grid
    (1 0)))
  (2 0 (grid
    (0 1)))
  (3 2 (grid
    (1 1))))
(param &bg Color (0))
(param &out_fill Color (2))
