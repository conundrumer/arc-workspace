;; 45737921

(RULE &obj_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &obj Quotient
  (edge ((:a P) (:b P3))
    (OR ((&figure *P)
         (&obj_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&figure (:P P3)))
        ((&figure P)
         (= P3 P)))))

(RULE &obj_component
  (&obj.class (:a *P) *Id))

(RULE &obj_color
  (&obj_component *P *Id)
  (&figure P *Col))

(RULE &swap
  (&obj_color *Id *Col)
  (&obj_color Id (:Col *Col2))
  (!= Col Col2))

(RULE &output
  (OR ((&obj_component *P *Id)
       (&figure P (:Col *C))
       (&swap Id (:Col C) (:Col2 *Col)))
      ((input P Col)
       (&bg (:C Col)))))
