;; 4aab4007

(DET &hole ChangedColor)

;; The corner the bands and the legend are anchored at.
(DET &corner DiagDirDomain)

;; How deep the bands run from the corner's edges.
(DET &border_width TileCount)

;; The axis the stripes run along.
(DET &stripe_axis DiagAxisDomain)

(RULE &intact
  (input *P *Col)
  (NOT (&hole (:C Col))))

(RULE &corner_dists
  (input *P)
  (&corner (:D *Diag))
  (corner_dir (:C Diag) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C Diag) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) (:K *K1))
  (margin (:B P) (:D D2_m3) (:K *K2)))

(RULE &band_cell
  (&corner_dists *P (:K1 *K) *K2)
  (<= K K2)
  (&border_width *N)
  (< K N))

(RULE &damaged
  (input *P *Col)
  (&hole (:C Col)))

;; The legend is what every example paints alike; the stripes differ
;; from example to example.
(INIT &steady Singleton
  (key ((&intact *E *P *Col)
        (NOT (&band_cell E P))
        (&corner_dists E P ^K1 ^K2)
        (<= K1 K2))
    (member ((:v Col))
      (&intact *E *P *Col)
      (NOT (&band_cell E P))
      (&corner_dists E P K1 K2)
      (<= K1 K2))))

(DET &legend
  (&steady.value (:key *K1 *K2)))

(RULE &legend_cell
  (&corner_dists *P *K1 *K2)
  (&legend K1 K2))

(RULE &stripe
  (input *P)
  (NOT (&band_cell P))
  (NOT (&legend_cell P)))

(DET &band_color
  (&band_cell *E *P *K)
  (&intact E P *Col))

(ALTS $choice "how a damaged band cell finds its color" $Stored
  (ALT $Uniform
    (RULE &output
      (OR ((&damaged *P)
           (&band_cell P *K)
           (&band_cell (:P *Q) K)
           (&intact (:P Q) *Col))
          ((&intact P Col))
          ((&damaged P)
           (&stripe P)
           (&stripe (:P *Q2))
           (&intact (:P Q2) Col)
           (&stripe_axis (:Da *A))
           (diag_perp (:Da A) (:Da2 *A2_m1))
           (diag_axis_of (:D *D_m2) (:Da A2_m1))
           (corner_dist P (:Diag D_m2) (:K *K_m3))
           (corner_dist (:P Q2) (:Diag D_m2) (:K K_m3)))))))

(RULE &output
  (OR ((&intact *P *Col))
      ((&damaged P)
       (&stripe P)
       (&stripe (:P *Q))
       (&intact (:P Q) Col)
       (&stripe_axis (:Da *A))
       (diag_perp (:Da A) (:Da2 *A2_m1))
       (diag_axis_of (:D *D_m2) (:Da A2_m1))
       (corner_dist P (:Diag D_m2) (:K *K_m3))
       (corner_dist (:P Q) (:Diag D_m2) (:K K_m3)))
      ((&damaged P)
       (&band_cell P *K)
       (&band_color K Col))))
