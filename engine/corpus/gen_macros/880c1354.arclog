;; 880c1354

;; The colors of the band between the regions. They stay put.
(DET &fixed UnchangedColor)

;; The sense in which a region's color moves to the next region.
(DET &sense SenseDomain)

(RULE &region
  (input *P (:Col *C))
  (NOT (&fixed C)))

(RULE &border_step
  (input *P)
  (&sense *S)
  (turn S *D (:D2 *D_step))
  (margin (:B P) D (:K 0))
  (step_offset (:D D_step) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q)))

;; The border cells a walk from region cell p reaches, passing over band cells.
(INIT &onward Propagation
  (key ((&region ^P))
    (source ((:n Q))
      (&border_step P *Q)))
  (edge ((:a P2) (:b Q))
    (&border_step (:P *P2) *Q)
    (input (:P P2) (:Col *C))
    (&fixed C)))

(RULE &next_cell
  (&onward.reached (:key *P) (:n *Q))
  (&region (:P Q)))

(RULE &next_color
  (&region *P *C)
  (&next_cell P *Q)
  (&region (:P Q) (:C *C_next))
  (!= C_next C))

(ALTS $choice "what a region is" $ByColor
  (ALT $ByObject
    (RULE &obj_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &obj Quotient
      (edge ((:a (:Key C) P) (:b (:Key C) (:P P3)))
        (OR ((&region *P *C)
             (&obj_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&region (:P P3) C))
            ((&region P C)
             (= P3 P)))))

    (RULE &obj_component
      (&obj.class (:a *Key *P) *Id))

    (RULE &next_obj
      (&obj_component *P *Id)
      (&next_cell P *Q)
      (&obj_component (:P Q) (:Id *Id_next))
      (!= Id_next Id))

    (RULE &output
      (OR ((&obj_component *P (:Id *Id_next))
           (&next_obj *Id Id_next)
           (&obj_component (:Key *C) Id))
          ((input P (:Col C))
           (&fixed C))))))

(RULE &output
  (OR ((input *P (:Col *C))
       (&fixed C))
      ((&region P (:C *C_next))
       (&next_color C C_next))))
