;; 65b59efc

(DET &bg DominantColor)

;; The scene: the drawn content, cut from its bg canvas.
(INIT &scene BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &cell
  (&scene.box *B)
  (input (:P *P2) *Col)
  (ALL ((input (:P P2) (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P)))

(RULE &lattice_divider_split1
  (&cell (:P *P_) *Col)
  (perp (:A *A_run) (:A2 *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m2_)))

(DET &sep VanishedColor)

(RULE &lattice_divider
  (&cell *P *Col)
  (&sep (:C Col))
  (axis_of *D (:A *A_run))
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&cell (:P Q) Col)
  (perp (:A A_run) (:A2 *A))
  (&lattice_divider_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m2_ *X_m2)))

(RULE &lattice_on_divider
  (&cell *P)
  (&lattice_divider *A *L)
  (axis_of *D A)
  (margin (:B P) D (:K *K_m1))
  (margin (:B L) D (:K K_m1)))

;; A separator line is dashed: the separator color runs along it, so two
;; adjacent separator cells lie on it. A lone separator cell is where a tile
;; line crosses one.
(INIT &lattice_rank Order
  (key ((OR ((&lattice_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((&cell *P)
             (dir_elem D)
             (margin (:B P) D K))))
    (member ((:t K))
      (&lattice_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&lattice_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((&cell *P)
           (dir_elem D)
           (margin (:B P) D K))))
    (probe ((:t K))
      (&cell *P)
      (dir_elem D)
      (margin (:B P) D *K))))

(RULE &lattice_part_idx
  (&cell *P)
  (axis_of *D *A)
  (NOT (&lattice_on_divider P A))
  (margin (:B P) D *K)
  (&lattice_rank.rank (:key D) (:t K) (:R *N)))

(RULE &lattice_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&lattice_part_idx *P D (:N *N1))
  (&lattice_part_idx P (:D D2) (:N *N2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K N1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

(RULE &lattice_tile_of
  (&lattice_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&lattice_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each tile's box.
(INIT &tile BoundingBox
  (key ((&lattice_tile_of *P ^P_tile))
    (cell (P)
      (&lattice_tile_of *P P_tile))))

(RULE &tile_cell_split1
  (&tile.cell (:key (:P_tile *P_tile_)) *P)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_tile_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_tile_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_band_))
  (relative (:Base P_band_) (:X P_tile_) (:X_rel *P_strip_)))

;; The edge the template band lies on.
(DET &template_side DirDomain)

(RULE &tile_cell
  (&cell *P *Col)
  (&tile.cell (:key *P_tile) P)
  (&tile.box (:key P_tile) *B)
  (ALL ((&cell P (:Col *Colm))
        (&tile.box (:key (:P_tile *P_tilem)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_intile))
  (&template_side *D)
  (axis_of D *A)
  (&tile_cell_split1 (:P_tile_ P_tile) (:A_ A) (:P_band_ *P_band) (:P_strip_ *P_strip)))

(RULE &marker_cell
  (&tile_cell *P_band *P_intile *Col)
  (&template_side *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_band) (:B V_m1) (:C *P_tb))
  (margin (:B P_tb) D (:K 0)))

(RULE &template_cell
  (&tile_cell *P_band *P_strip *P_intile *Col)
  (&template_side *D)
  (margin (:B P_band) D (:K 0)))

(INIT &output_tiling Tiling
  (outer ((:P P_outer))
    (&marker_cell (:P_intile *P_outer)))
  (inner ((:P P_inner))
    (&template_cell (:P_intile *P_inner))))

(RULE &legend_cell
  (&tile_cell *P_band *P_strip *Col)
  (&template_side *D)
  (opposite D (:Opp *D2))
  (margin (:B P_band) (:D D2) (:K 0)))

(RULE &painted
  (&marker_cell (:P_intile *P_outer) (:Col *C))
  (NOT (&bg C))
  (&template_cell *P_strip (:P_intile *P_inner) (:Col C))
  (&legend_cell P_strip *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (&output_tiling.cell *P_outer *P_inner *P)
  (OR ((&painted P_outer P_inner *Col))
      ((NOT (&painted P_outer P_inner))
       (&bg (:C Col)))))
