;; 6a1e5592

(RULE &sprites_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &sprite ChangedColor)

(INIT &sprites Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&sprite (:C Col))
         (&sprites_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&sprite (:C Col2)))
        ((input P (:Col *Col3))
         (&sprite (:C Col3))
         (= P3 P)))))

(RULE &sprites_component
  (&sprites.class (:a *P) *Id))

(DET &bg DominantColor)

(DET &wall UnchangedColor)

(DET &fill AnyOutNewColor)

;; The notches: the bg cells inside the wall's box.
(INIT &wall2 BoundingBox
  (cell (P)
    (input *P *Col)
    (&wall (:C Col))))

(RULE &notch
  (&wall2.box *B)
  (input *P *Col)
  (ALL ((input P (:Col *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (&bg (:C Col)))

;; A placement of a sprite: a translation landing every cell off the wall.
(INIT &occ Occurrences
  (key ((OR ((&sprites_component (:P *S) ^Id))
            ((&sprites_component Id)
             (input *P *Col)
             (NOT (&wall (:C Col))))))
    (cell (P)
      (&sprites_component Id)
      (input *P *Col)
      (NOT (&wall (:C Col))))
    (shape ((:P S))
      (&sprites_component (:P *S) Id))))

(RULE &covers
  (&occ.occurrence (:key *Id) (:P *V))
  (&occ.shape (:key Id) (:P *S))
  (compose (:A V) (:B S) (:C *P)))

(RULE &forcing_item
  (&covers *Id *V *P)
  (&notch P))

(CHOOSE &forcing
  (for ((&forcing_item ^P))
    (from (&forcing_item P *Id *V)))
  (never
    (&forcing_item *Id *V)
    (&forcing_item Id (:V *V2))
    (&occ.occurrence (:key Id) (:P V))
    (&occ.occurrence (:key Id) (:P V2))
    (!= V V2))
  (never
    (&forcing_item *Id *V)
    (&forcing_item (:Id *Id2) (:V *V2))
    (&covers Id V *P)
    (&covers (:Id Id2) (:V V2) P)
    (OR ((!= Id Id2))
        ((!= V V2))))
  (never
    (&forcing_item *P *Id *V)
    (&forcing_item (:P *P2) (:Id *Id2) (:V *V2))
    (&forcing_item (:P P2) Id V)
    (OR ((!= Id Id2))
        ((!= V V2)))))

(RULE &plugged
  (&forcing *Id *V)
  (&covers Id V *P))

(RULE &output
  (OR ((input *P *Col)
       (&wall (:C Col)))
      ((&plugged P)
       (&fill (:C Col)))
      ((input P (:Col *C_in))
       (NOT (&wall (:C C_in)))
       (NOT (&notch P))
       (NOT (&plugged P))
       (&bg (:C Col)))))
