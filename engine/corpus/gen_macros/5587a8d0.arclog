;; 5587a8d0

(RULE &ring_depth_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &patch_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; One id per patch.
(INIT &patch Quotient
  (equivalent ((:a P) (:b Q))
    (&patch_cell *P *Col)
    (&patch_cell (:P *Q) Col)))

(ALTS $choice "what a patch is, data-equivalent on this task since each color forms one blob in every pair; a color lying in two blobs would separate the cases" $ByColor
  (ALT $ByObject
    (RULE &blob_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &blob Quotient
      (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
        (OR ((&patch_cell *P *Col)
             (&blob_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&patch_cell (:P P3) Col))
            ((&patch_cell P Col)
             (= P3 P)))))

    (RULE &blob_component
      (&blob.class (:a *Key *P) *Id))

    ;; One id per patch.
    (INIT &patch Quotient
      (equivalent ((:a P) (:b Q))
        (OR ((&patch_cell *P *Col)
             (&patch_cell (:P *Q) Col))
            ((&blob_component (:Key *Ky) P (:Id *I))
             (&blob_component (:Key Ky) (:P Q) (:Id I))))))))

(RULE &patch_of
  (&patch.class (:a *P) *Id))

(INIT &tally Cardinality
  (key ((&patch_of *P ^Id))
    (member ((:m P))
      (&patch_of *P Id))))

(RULE &patch_size
  (&patch_of *Id)
  (&tally.size (:key Id) *N))

(INIT &nest Order
  (member ((:t Id))
    (&patch_size *Id))
  (before ((:a Id) (:b Id2))
    (&patch_size *Id *N)
    (&patch_size (:Id *Id2) (:N *N2))
    (> N N2)))

(RULE &center_uniform_inset1
  (&nest.rank (:t *Id) (:R *R_))
  (axis_of (:D *D1_m1) (:A *A1_m2))
  (perp (:A A1_m2) (:A2 *A2_m3))
  (axis_of (:D *D2_m4) (:A A2_m3))
  (opposite (:D D1_m1) (:Opp *O_m1))
  (edge_inset (:D D1_m1) (:K R_) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R_) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *B1_m5))
  (opposite (:D D2_m4) (:Opp *O_m4))
  (edge_inset (:D D2_m4) (:K R_) (:B *B1_m6))
  (edge_inset (:D O_m4) (:K R_) (:B *B2_m7))
  (compose (:A B1_m6) (:B B2_m7) (:C *B2_m6))
  (compose (:A B1_m5) (:B B2_m6) (:C *P_)))

(RULE &center
  (&nest.maximal (:t *Id))
  (&nest.rank (:t Id) *R)
  (&center_uniform_inset1 (:R_ R) (:P_ *P)))

;; The output square, the frame the center sits in.
(INIT &square Frame
  (extent (A N)
    (&center (:P *C))
    (axis_elem *A)
    (frame_extent (:P C) A *N)))

;; The square's rings, from its edge inward.
(INIT &ring Boundary
  (cell (P)
    (&square.cell *P)))

(INIT &ring_depth Distance
  (edge ((:a P) (:b P2))
    (&square.cell *P)
    (&ring_depth_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (&square.cell (:P P2)))
  (source ((:n P))
    (&ring.boundary *P)))

(RULE &patch_color
  (&patch_of *P *Id)
  (&patch_cell P *Col))

;; Each patch draws the ring as deep as the count of larger patches.
(RULE &output
  (&ring_depth.distance (:n *P) *K)
  (&nest.rank (:t *Id) (:R K))
  (&patch_color Id *Col))
