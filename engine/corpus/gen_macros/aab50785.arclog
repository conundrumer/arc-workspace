;; aab50785

(INPUT marker-blocks "every input holds an even number of blocks of &marker_color, and no other cell has that color; a block is a placement of &block_shape whose cells all have the marker color"

  (DET &pieces_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &marker_color VanishedColor)

  (DET &pieces_node
    (ex_input (:E *Key) *P (:Col *K))
    (&marker_color (:C K)))

  (INIT &pieces Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&pieces_node (:Key *Ky) *P)
           (&pieces_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&pieces_node (:Key Ky) (:P P2)))
          ((&pieces_node (:Key Ky) P)
           (= P2 P)))))

  (DET &pieces_component
    (&pieces.class (:a *Key *P) *Id))

  (INIT &piece_box BoundingBox
    (key ((&pieces_component (:Key ^E) *P ^Id))
      (cell (P)
        (&pieces_component (:Key E) *P Id))))

  (DET &block_shape_inside1
    (&pieces_component (:Key *E) (:P *P_) *Id)
    (&piece_box.box (:key E Id) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &pieces4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &pieces4 Quotient
    (edge ((:a (:Key K) P) (:b (:Key K) (:P P3)))
      (OR ((input *P (:Col *K))
           (&pieces4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col K)))
          ((input P (:Col K))
           (= P3 P)))))

  (RULE &pieces4_component
    (&pieces4.class (:a *Key *P) *Id))

  (RULE &pieces8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (DET &block_shape
    (&pieces_component (:Key *E) (:P *P2) *Id)
    (&piece_box.box (:key E Id) *B)
    (NOT (&block_shape_inside1 (:P_ P2) (:B_ B)))
    (relative (:Base B) (:X P2) (:X_rel *P)))

  (INIT &window_blocks Occurrences
    (key ((OR ((input *P (:Col ^K)))
              ((input (:Col K))
               (&block_shape (:P *S)))))
      (cell (P)
        (input *P (:Col K)))
      (shape ((:P S))
        (input (:Col K))
        (&block_shape (:P *S)))))

  (RULE &found
    (&window_blocks.occurrence (:key *K) (:P *B)))

  (DET &bg DominantColor)

  (RULE &piece
    (&pieces4_component (:Key *K) *P (:Id *Pc)))

  (INIT &piece_box2 BoundingBox
    (key ((&piece (:Pc ^Id) *P))
      (cell (P)
        (&piece (:Pc Id) *P))))

  (INIT &pieces8 Quotient
    (edge ((:a (:Key K) P) (:b (:Key K) (:P P3)))
      (OR ((input *P (:Col *K))
           (&pieces8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col K)))
          ((input P (:Col K))
           (= P3 P)))))

  (INIT &piece_shape Inclusion
    (pattern ((:m S))
      (&block_shape (:P *S)))
    (observed ((:observed Pc) (:m P_rel))
      (&piece *Pc *P)
      (&piece_box2.box (:key (:Id Pc)) *B)
      (ALL ((&piece (:Pc *Pcm) P)
            (&piece_box2.box (:key (:Id Pcm)) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_rel))))

  (RULE &candidate
    (&found *K *B)
    (NOT (&bg (:C K))))

  (INIT &derived_marker Singleton
    (member ((:v K))
      (&candidate *K))))

(INPUT noise-field "the other cells are a field of 0 with scattered cells of the other colors, and those colors form no block")

(INPUT block-pairs "the blocks pair off; the two blocks of a pair cover the same lines across &pair_axis, their band, with at least one cell between them"

  (RULE &block
    (&marker_color (:C *K))
    (&found K *B))

  ;; The axis the two blocks of a pair lie along.
  (DET &pair_axis AxisDomain)

  (RULE &beyond
    (&block (:B *B1))
    (&block (:B *B2))
    (&pair_axis *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B B1) (:D D_m2) (:K *K_m3))
    (margin (:B B2) (:D D_m2) (:K K_m3))
    (axis_of *D A)
    (margin (:B B1) D (:K *K1))
    (margin (:B B2) D (:K *K2))
    (< K1 K2))

  ;; The blocks of each band that holds two or more, ranked from edge D.
  (INIT &band_rank Order
    (key ((OR ((OR ((&beyond (:B1 *B) ^D))
                   ((&beyond (:B2 B) D))))
              ((&beyond *B1 *B2 D))))
      (member ((:t B))
        (OR ((&beyond (:B1 *B) D))
            ((&beyond (:B2 B) D))))
      (before ((:a B1) (:b B2))
        (&beyond *B1 *B2 D)))))

(INPUT equal-gaps "in one input, every pair has the same number of cells between its two blocks")

(INPUT disjoint-rows "the bands of different pairs do not overlap")

(OUTPUT window "each pair gives a window: the cells of its band strictly between its two blocks")

(OUTPUT copy-window "the window's cells are copied unchanged, 0 included")

(OUTPUT stack "the windows stack across &pair_axis, in the order of their bands, and form the output"

  (RULE &gap_split1
    (&beyond (:B1 *B1_) *B2 *D)
    (&pair_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B1_) (:D D_m1) (:K *K1_m3))
    (margin (:B B1_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
    (relative (:Base X_m1_) (:X B1_) (:X_rel *Band_)))

  (RULE &gap_split2
    (input (:P *P_))
    (&pair_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
    (relative (:Base X_m2_) (:X P_) (:X_rel *Line_)))

  (RULE &gap
    (&beyond *B1 *B2 *D)
    (input *P)
    (&pair_axis *A)
    (&gap_split1 (:B1_ B1) (:A_ A) (:X_m1_ *X_m1) (:Band_ *Band))
    (&gap_split2 (:P_ P) (:A_ A) (:X_m2_ *X_m2) (:Line_ *Line))
    (ALL ((input (:P *Pm))
          (&pair_axis (:A *Am))
          (axis_of (:D *D_m2) (:A Am))
          (opposite (:D D_m2) (:Opp *O_m3))
          (margin (:B Pm) (:D D_m2) (:K *K1_m4))
          (margin (:B Pm) (:D O_m3) (:K *K2_m5))
          (opposite (:D D_m2) (:Opp *O_m6))
          (edge_inset (:D D_m2) (:K K1_m4) (:B *B1_m7))
          (edge_inset (:D O_m6) (:K K2_m5) (:B *B2_m8))
          (compose (:A B1_m7) (:B B2_m8) (:C *Along_m1))
          (relative (:Base Along_m1) (:X Pm) (:X_rel Line))
          (&beyond (:B1 *B1m) (:B2 *B2m) (:D *Dm))
          (axis_of (:D *D_m10) (:A Am))
          (opposite (:D D_m10) (:Opp *O_m11))
          (margin (:B B1m) (:D D_m10) (:K *K1_m12))
          (margin (:B B1m) (:D O_m11) (:K *K2_m13))
          (opposite (:D D_m10) (:Opp *O_m14))
          (edge_inset (:D D_m10) (:K K1_m12) (:B *B1_m15))
          (edge_inset (:D O_m14) (:K K2_m13) (:B *B2_m16))
          (compose (:A B1_m15) (:B B2_m16) (:C *Along_m9))
          (relative (:Base Along_m9) (:X B1m) (:X_rel Band))
          (dir_elem (:D *D_m1))
          (relative (:Base Band) (:X Line) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (opposite D (:Opp *O))
    (margin (:B P) (:D O) (:K *K1))
    (margin (:B B1) (:D O) (:K *J1))
    (< K1 J1)
    (margin (:B P) D (:K *K2))
    (margin (:B B2) D (:K *J2))
    (< K2 J2))

  (RULE &crossed
    (&beyond *B1 (:B2 *B) *D)
    (&beyond (:B1 B) *B2 D))

  (RULE &adjacent
    (&beyond *B1 *B2 *D)
    (NOT (&crossed B1 B2 D)))

  (RULE &span
    (&adjacent *B1 *B2 *D))

  (INIT &window BoundingBox
    (key ((&span ^B1 ^B2 *D)
          (&gap B1 B2 D *P))
      (cell (P)
        (&span B1 B2 *D)
        (&gap B1 B2 D *P))))

  (RULE &win
    (&window.box (:B *W)))

  (RULE &window_cell_split1
    (&win *W)
    (input *P *Col)
    (relative (:Base W) (:X P) (:X_rel *P_inner_))
    (&pair_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_col_))
    (relative (:Base P_col_) (:X P_inner_) (:X_rel *X_m1_)))

  (RULE &window_cell_split2
    (input (:P *P_) *Col)
    (&pair_axis (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
    (relative (:Base X_m2_) (:X P_) (:X_rel *Line_)))

  ;; The windows of one band stack in their order along the pair axis: the one nearer edge D goes nearer the stack edge that a quarter turn in sense S reaches from D. No pair has a band with two windows, so both senses stay open.
  ;; TODO no-det-plan: &band_sense: the plan gives no verdict
  (DET &band_sense (ONE))

  (RULE &window_cell
    (&win *W)
    (input *P *Col)
    (ALL ((input P (:Col *Colm))
          (&win W)
          (dir_elem (:D *D_m1))
          (relative (:Base W) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base W) (:X P) (:X_rel *P_inner))
    (&pair_axis *A)
    (&window_cell_split1 (:P_inner_ P_inner) (:A_ A) (:P_col_ *P_col) (:X_m1_ *X_m1))
    (&window_cell_split2 (:P_ P) (:A_ A) (:X_m2_ *X_m2) (:Line_ *Line)))

  (RULE &window_line
    (&window_cell *W *Line))

  (RULE &stack_dir
    (&pair_axis (:A *A0))
    (perp (:A A0) (:A2 *A))
    (axis_of *D A))

  (RULE &band_stack_elem
    (&stack_dir *D)
    (&window_line *W *Line))

  ;; One window per band: the windows stack in the order of their bands, each
  ;; window's lines in their own order.
  (INIT &band_stack Order
    (key ((OR ((&band_stack_elem ^D (:W *T_w) (:Line *T_line)))
              ((&band_stack_elem D (:W *W1) (:Line *L1))
               (&band_stack_elem D (:W *W2) (:Line *L2))
               (OR ((margin (:B W1) D (:K *K1))
                    (margin (:B W2) D (:K *K2))
                    (< K1 K2))
                   ((= W1 W2)
                    (margin (:B L1) D (:K K1))
                    (margin (:B L2) D (:K K2))
                    (< K1 K2))))))
      (member ((:t (:W T_w) (:Line T_line)))
        (&band_stack_elem D (:W *T_w) (:Line *T_line)))
      (before ((:a (:W W1) (:Line L1)) (:b (:W W2) (:Line L2)))
        (&band_stack_elem D (:W *W1) (:Line *L1))
        (&band_stack_elem D (:W *W2) (:Line *L2))
        (OR ((margin (:B W1) D (:K *K1))
             (margin (:B W2) D (:K *K2))
             (< K1 K2))
            ((= W1 W2)
             (margin (:B L1) D (:K K1))
             (margin (:B L2) D (:K K2))
             (< K1 K2)))))))

(ALTS $reading "how a block is found" $WindowBlocks
  (ALT $ComponentBlocks
    (INPUT marker-blocks "a block is an edge-connected piece of the marker color whose cells, read in its bounding box, are &block_shape"
      (RULE &found
        (&piece_shape.equal (:observed *Id))
        (&piece (:Pc Id) *K)
        (&piece_box2.box (:key Id) *B)))
    (ALTS $shape "the shape of a block under ComponentBlocks" $StoredShape
      (ALT $DerivedShape
        (INPUT marker-blocks "a block is any piece of the marker color that fills its bounding box"
          (RULE &holed
            (&piece *Pc *K)
            (&piece_box2.box (:key (:Id Pc)) *B)
            (input *P)
            (ALL ((&piece_box2.box (:key (:Id *Pcm)) B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0)))
            (NOT (&piece Pc K P)))
          (RULE &found
            (&piece (:Pc *Id) *K)
            (&piece_box2.box (:key Id) *B)
            (NOT (&holed (:Pc Id))))
          ;; A block one line thick: some cell lies on two opposite edges of it.
          (RULE &thin
            (&found *B)
            (input *P)
            (ALL ((&found B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0)))
            (margin (:B P) *D (:K *K_m1))
            (margin B D (:K K_m1))
            (opposite D (:Opp *O))
            (margin (:B P) (:D O) (:K *K_m2))
            (margin B (:D O) (:K K_m2)))
          (RULE &candidate
            (&found *K *B)
            (NOT (&bg (:C K)))
            (NOT (&thin B))))))
    (ALTS $conn "which cells join into one piece under ComponentBlocks" $Conn4
      (ALT $Conn8
        (INPUT marker-blocks "diagonal neighbors also join into one piece"
          (RULE &pieces8_component
            (&pieces8.class (:a *Key *P) *Id))
          (RULE &piece
            (&pieces8_component (:Key *K) *P (:Id *Pc))))))))

(ALTS $marker "where the marker color comes from" $StoredMarker
  (ALT $DeriveMarker
    (INPUT marker-blocks "the marker color is the one color other than &bg that has a block; under DerivedShape only a block that spans two lines on each axis counts, as a marker and as a block; undefined when no color or several colors have one"
      (RULE &block
        (&derived_marker.value (:v *K))
        (&candidate K *B)))))

(ALTS $lone "what a band with one block gives" $LoneUndefined
  (ALT $LoneSkip
    (OUTPUT lone-skip "a band with one block gives no window")
    (RULE &defect
      ;; A span with no cell between its blocks.
      (OR ((&span *B1 *B2)
           (NOT (&window.box (:key B1 B2))))
          ((&crossed))))
    (ALT $OuterSpan
      ;; A span with no cell between its blocks.
      (RULE &defect
        (&span *B1 *B2)
        (NOT (&window.box (:key B1 B2)))))
    (ALT $PairLeftRight
      (RULE &defect
        (OR ((&opens *B *D)
             (NOT (&beyond (:B1 B) D)))
            ;; A span with no cell between its blocks.
            ((&span *B1 *B2)
             (NOT (&window.box (:key B1 B2)))))))
    (ALT $ConsecutiveWindows
      ;; A span with no cell between its blocks.
      (RULE &defect
        (&span *B1 *B2)
        (NOT (&window.box (:key B1 B2)))))))

(ALTS $crowd "what a band with more than two blocks gives" $TwoPerBand
  (ALT $OuterSpan
    (OUTPUT window "a band with more than two blocks gives one window, from its first block to its last, and the blocks between are copied"
      ;; The first and the last block of a band.
      (RULE &span
        (&beyond *B1 *B2 *D)
        (NOT (&beyond (:B2 B1) D))
        (NOT (&beyond (:B1 B2) D))))
    (RULE &defect
      ;; A span with no cell between its blocks.
      (OR ((&span *B1 *B2)
           (NOT (&window.box (:key B1 B2))))
          ((&block *B)
           (NOT (&beyond (:B1 B)))))))
  (ALT $PairLeftRight
    (INPUT block-pairs "the blocks of a band pair off in their order along &pair_axis; undefined on an odd count")
    (OUTPUT stack "the windows of one band stack in their order along &pair_axis, turned onto the stack axis by &band_sense"
      (RULE &window_stack_elem
        (&stack_dir *D)
        (&band_sense *S)
        (&window_line *W *Line))

      (RULE &before_split1
        (&window_stack_elem *D *S (:W *W1_) (:Line *L1))
        (&pair_axis (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B W1_) (:D D_m1) (:K *K1_m3))
        (margin (:B W1_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
        (relative (:Base X_m1_) (:X W1_) (:X_rel *Band1_)))

      (RULE &before_split2
        (&window_stack_elem *D *S (:W *W2_) (:Line *L2))
        (&pair_axis (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B W2_) (:D D_m1) (:K *K1_m3))
        (margin (:B W2_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
        (relative (:Base X_m2_) (:X W2_) (:X_rel *Band2_)))

      ;; The blocks of a pair.
      (DET &pair_size TileCount)

      (RULE &opens
        (&band_rank.rank (:key *D) (:t *B) (:R *K))
        (&pair_size *N)
        (divide (:T K) (:Side N) (:Gap 0) (:Remainder 0)))

      (RULE &span
        (&opens (:B *B1) *D)
        (&adjacent B1 *B2 D))

      ;; The windows stack in the order of their bands, the windows of one band in
      ;; their order along the pair axis, turned onto the stack axis, and each
      ;; window's lines in their own order.
      (INIT &window_stack Order
        (key ((OR ((&window_stack_elem ^D ^S (:W *T_w) (:Line *T_line)))
                  ((&window_stack_elem D S (:W *W1) (:Line *L1))
                   (&window_stack_elem D S (:W *W2) (:Line *L2))
                   (&pair_axis *A)
                   (&before_split1 (:W1_ W1) (:A_ A) (:X_m1_ *X_m1) (:Band1_ *Band1))
                   (&before_split2 (:W2_ W2) (:A_ A) (:X_m2_ *X_m2) (:Band2_ *Band2))
                   (OR ((margin (:B Band1) D (:K *K1))
                        (margin (:B Band2) D (:K *K2))
                        (< K1 K2))
                       ((= Band1 Band2)
                        (turn S (:D *D_pair) (:D2 D))
                        (margin (:B W1) (:D D_pair) (:K K1))
                        (margin (:B W2) (:D D_pair) (:K K2))
                        (< K1 K2))
                       ((= W1 W2)
                        (margin (:B L1) D (:K K1))
                        (margin (:B L2) D (:K K2))
                        (< K1 K2))))))
          (member ((:t (:W T_w) (:Line T_line)))
            (&window_stack_elem D S (:W *T_w) (:Line *T_line)))
          (before ((:a (:W W1) (:Line L1)) (:b (:W W2) (:Line L2)))
            (&window_stack_elem D S (:W *W1) (:Line *L1))
            (&window_stack_elem D S (:W *W2) (:Line *L2))
            (&pair_axis *A)
            (&before_split1 (:W1_ W1) (:A_ A) (:X_m1_ *X_m1) (:Band1_ *Band1))
            (&before_split2 (:W2_ W2) (:A_ A) (:X_m2_ *X_m2) (:Band2_ *Band2))
            (OR ((margin (:B Band1) D (:K *K1))
                 (margin (:B Band2) D (:K *K2))
                 (< K1 K2))
                ((= Band1 Band2)
                 (turn S (:D *D_pair) (:D2 D))
                 (margin (:B W1) (:D D_pair) (:K K1))
                 (margin (:B W2) (:D D_pair) (:K K2))
                 (< K1 K2))
                ((= W1 W2)
                 (margin (:B L1) D (:K K1))
                 (margin (:B L2) D (:K K2))
                 (< K1 K2))))))

      (RULE &turned_slot
        (&window_stack.rank (:key *D *S) (:t *W *Line) (:R *K1))
        (&window_stack.dual_rank (:key D S) (:t W Line) (:R *K2))
        (opposite D (:Opp *O_m1))
        (edge_inset D (:K K1) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *P_row))))
    (RULE &defect
      (OR ((&opens *B *D)
           (NOT (&beyond (:B1 B) D)))
          ;; A span with no cell between its blocks.
          ((&span *B1 *B2)
           (NOT (&window.box (:key B1 B2))))
          ((&block (:B *B3))
           (NOT (&beyond (:B1 B3))))))

    (RULE &output
      (&placed *W *Line *P_col *Col)
      (OR ((&slot W Line *P_row))
          ((&turned_slot *S W Line P_row)))
      (compose (:A P_row) (:B P_col) (:C *P))
      (NOT (&defect)))
    (ALT $PadWidest
      (RULE &output
        (&flush_placed (:E1 *E) *W *Line *P_col *Col)
        (&turned_slot *S W Line *P_row)
        (compose (:A P_row) (:B P_col) (:C *P))
        (NOT (&defect)))))
  (ALT $ConsecutiveWindows
    (OUTPUT window "each two adjacent blocks of a band bound a window"
      (RULE &turned_slot
        (&window_stack.rank (:key *D *S) (:t *W *Line) (:R *K1))
        (&window_stack.dual_rank (:key D S) (:t W Line) (:R *K2))
        (opposite D (:Opp *O_m1))
        (edge_inset D (:K K1) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *P_row))))
    (OUTPUT stack "the windows of one band stack in their order along &pair_axis, turned onto the stack axis by &band_sense"
      (RULE &window_stack_elem
        (&stack_dir *D)
        (&band_sense *S)
        (&window_line *W *Line))

      (RULE &before_split1
        (&window_stack_elem *D *S (:W *W1_) (:Line *L1))
        (&pair_axis (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B W1_) (:D D_m1) (:K *K1_m3))
        (margin (:B W1_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
        (relative (:Base X_m1_) (:X W1_) (:X_rel *Band1_)))

      (RULE &before_split2
        (&window_stack_elem *D *S (:W *W2_) (:Line *L2))
        (&pair_axis (:A *A_))
        (axis_of (:D *D_m1) (:A A_))
        (opposite (:D D_m1) (:Opp *O_m2))
        (margin (:B W2_) (:D D_m1) (:K *K1_m3))
        (margin (:B W2_) (:D O_m2) (:K *K2_m4))
        (opposite (:D D_m1) (:Opp *O_m1))
        (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
        (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
        (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
        (relative (:Base X_m2_) (:X W2_) (:X_rel *Band2_)))

      ;; The windows stack in the order of their bands, the windows of one band in
      ;; their order along the pair axis, turned onto the stack axis, and each
      ;; window's lines in their own order.
      (INIT &window_stack Order
        (key ((OR ((&window_stack_elem ^D ^S (:W *T_w) (:Line *T_line)))
                  ((&window_stack_elem D S (:W *W1) (:Line *L1))
                   (&window_stack_elem D S (:W *W2) (:Line *L2))
                   (&pair_axis *A)
                   (&before_split1 (:W1_ W1) (:A_ A) (:X_m1_ *X_m1) (:Band1_ *Band1))
                   (&before_split2 (:W2_ W2) (:A_ A) (:X_m2_ *X_m2) (:Band2_ *Band2))
                   (OR ((margin (:B Band1) D (:K *K1))
                        (margin (:B Band2) D (:K *K2))
                        (< K1 K2))
                       ((= Band1 Band2)
                        (turn S (:D *D_pair) (:D2 D))
                        (margin (:B W1) (:D D_pair) (:K K1))
                        (margin (:B W2) (:D D_pair) (:K K2))
                        (< K1 K2))
                       ((= W1 W2)
                        (margin (:B L1) D (:K K1))
                        (margin (:B L2) D (:K K2))
                        (< K1 K2))))))
          (member ((:t (:W T_w) (:Line T_line)))
            (&window_stack_elem D S (:W *T_w) (:Line *T_line)))
          (before ((:a (:W W1) (:Line L1)) (:b (:W W2) (:Line L2)))
            (&window_stack_elem D S (:W *W1) (:Line *L1))
            (&window_stack_elem D S (:W *W2) (:Line *L2))
            (&pair_axis *A)
            (&before_split1 (:W1_ W1) (:A_ A) (:X_m1_ *X_m1) (:Band1_ *Band1))
            (&before_split2 (:W2_ W2) (:A_ A) (:X_m2_ *X_m2) (:Band2_ *Band2))
            (OR ((margin (:B Band1) D (:K *K1))
                 (margin (:B Band2) D (:K *K2))
                 (< K1 K2))
                ((= Band1 Band2)
                 (turn S (:D *D_pair) (:D2 D))
                 (margin (:B W1) (:D D_pair) (:K K1))
                 (margin (:B W2) (:D D_pair) (:K K2))
                 (< K1 K2))
                ((= W1 W2)
                 (margin (:B L1) D (:K K1))
                 (margin (:B L2) D (:K K2))
                 (< K1 K2)))))))
    (RULE &defect
      ;; A span with no cell between its blocks.
      (OR ((&span *B1 *B2)
           (NOT (&window.box (:key B1 B2))))
          ((&block *B)
           (NOT (&beyond (:B1 B))))))

    (RULE &output
      (&placed *W *Line *P_col *Col)
      (OR ((&slot W Line *P_row))
          ((&turned_slot *S W Line P_row)))
      (compose (:A P_row) (:B P_col) (:C *P))
      (NOT (&defect)))
    (ALT $PadWidest
      (RULE &output
        (&flush_placed (:E1 *E) *W *Line *P_col *Col)
        (&turned_slot *S W Line *P_row)
        (compose (:A P_row) (:B P_col) (:C *P))
        (NOT (&defect))))))

(ALTS $width "what windows of unequal width give" $EqualWidths
  (ALT $PadWidest
    (OUTPUT pad-widest "a window narrower than the widest keeps flush with edge &flush of the pair axis, and &bg fills the rest of its lines out to the widest window's width"
      ;; The pair-axis edge a narrower window keeps flush with. No pair has windows of unequal width, so both edges stay open.
      ;; TODO no-det-plan: &flush: the plan gives no verdict
      (DET &flush (ONE))

      (RULE &wider
        (&win (:W *W1))
        (&win (:W *W2))
        (input *P)
        (&pair_axis *A)
        (axis_elem A)
        (relative (:Base W1) (:X P) (:X_rel *R_m1))
        (frame_extent (:P R_m1) A (:N *N1))
        (axis_elem A)
        (relative (:Base W2) (:X P) (:X_rel *R_m2))
        (frame_extent (:P R_m2) A (:N *N2))
        (< N1 N2))

      (RULE &column
        (&window_cell *W (:P_col *Q))
        (NOT (&wider (:W1 W))))

      (RULE &landing
        (&window_cell *W *P_col)
        (&flush (:D *E1))
        (&column *Q)
        (margin (:B P_col) (:D E1) (:K *K_m1))
        (margin (:B Q) (:D E1) (:K K_m1)))

      (RULE &flush_placed
        (OR ((&window_cell *W (:P_col *P_col2) *Line *Col)
             (&landing W *E1 (:P_col P_col2) (:Q *P_col)))
            ((&window_line W Line)
             (&flush (:D E1))
             (&column (:Q P_col))
             (NOT (&landing W E1 (:Q P_col)))
             (&bg (:C Col))))))
    (RULE &output
      (OR ((&placed *W *Line *P_col *Col))
          ((&flush_placed (:E1 *E) W Line P_col Col)))
      (&slot W Line *P_row)
      (compose (:A P_row) (:B P_col) (:C *P))
      (NOT (&defect)))))

(RULE &defect
  ;; A span with no cell between its blocks.
  (OR ((&span *B1 *B2)
       (NOT (&window.box (:key B1 B2))))
      ((&block *B)
       (NOT (&beyond (:B1 B))))
      ((&crossed))))

(RULE &placed
  (&window_cell *W *P_col *Line *Col))

(RULE &slot
  (&band_stack.rank (:key *D) (:t *W *Line) (:R *K1))
  (&band_stack.dual_rank (:key D) (:t W Line) (:R *K2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K K1) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_row)))

(RULE &output
  (&placed *W *Line *P_col *Col)
  (&slot W Line *P_row)
  (compose (:A P_row) (:B P_col) (:C *P))
  (NOT (&defect)))
