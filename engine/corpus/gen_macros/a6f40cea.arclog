;; a6f40cea

(INPUT background "one color fills most of the grid")

(INPUT window "one rectangle has a one-cell frame of the frame color, and its interior is one uniform fill color, which may equal the background; it is the largest frame of the frame color, and smaller ones may stand elsewhere as decoys")

(INPUT outlines "each other figure is the one-cell outline of an axis-aligned rectangle; part of the outline lies under the window and does not show, and the visible part spans the rectangle's full bounding box, possibly in several pieces")

(INPUT outline-colors "an outline has one color, or two colors that alternate cell by cell along it, so that a cell's color depends only on its checkerboard class")

(OUTPUT crop-interior "the output is the window interior, filled with the interior's fill color"

  (DET &frame_color VanishedColor)

  (RULE &frame_src
    (&frame_color (:C *Col)))

  (INIT &rings Outlines
    (key ((&frame_src ^Col))
      (node (P)
        (input *P Col))))

  (RULE &hole
    (&rings.box *B)
    (input *P)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((> K_m3 0))))

  (INIT &interior_box BoundingBox
    (key ((&hole ^B *P))
      (cell (P)
        (&hole B *P)))))

(OUTPUT group-outline "each outline is one rectangle the generator drew in full before the window covered it"
  (APPROXIMATED "an outline is the set of non-background cells outside the window whose colors connect by adjacency; pieces that share a color belong to one outline"))

(OUTPUT complete-rectangle "the rectangle of an outline is the bounding box of its visible cells, and the outline is the perimeter of that box")

(OUTPUT draw-hidden "each perimeter cell inside the window interior is painted at its place in the interior")

(OUTPUT parity-color "a painted cell takes the color that the outline's visible cells have in its checkerboard class; undefined where one class holds two colors"

  (RULE &pieces_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (INIT &commonest_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N)))

  (INIT &fill Singleton
    (key ((&hole ^B *P)
          (input P *Col))
      (member ((:v Col))
        (&hole B *P)
        (input P *Col))))

  (RULE &candidate
    (&frame_src *Col)
    (&rings.box (:key Col) *B)
    (&fill.value (:key B) (:v *F))
    (!= F Col))

  (INIT &window_count Cardinality
    (key ((&candidate ^B))
      (member ((:m P))
        (&hole B *P))))

  (INIT &window Order
    (member ((:t B))
      (&window_count.size (:key *B)))
    (score ((:t B) (:S N))
      (&window_count.size (:key *B) *N)))

  (RULE &pieces_node
    (&window.maximal (:t *Key))
    (input *P *Col)
    (NOT (&commonest.maximal (:t Col)))
    (dir_elem (:D *D_m1))
    (relative (:Base Key) (:X P) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (INIT &pieces Quotient
    (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
      (OR ((&pieces_node (:Key *Ky) *P)
           (&pieces_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P2))
           (&pieces_node (:Key Ky) (:P P2)))
          ((&pieces_node (:Key Ky) P)
           (= P2 P)))))

  (RULE &pieces_component
    (&pieces.class (:a *Key *P) *Id))

  (RULE &piece_color
    (&pieces_component (:Key *B) *P *Id)
    (input P *Col))

  (RULE &joined
    (&piece_color *B *Id *Col)
    (&piece_color B (:Id *Id2) Col))

  ;; An outline is what a chain of joins connects.
  (INIT &outline_id Quotient
    (edge ((:a (:Win B) Id) (:b (:Win B) (:Id Id3)))
      (OR ((&joined *B *Id (:Id2 *Id3)))
          ((&piece_color B Id)
           (= Id3 Id)))))

  (RULE &outline
    (&pieces_component (:Key *Win) *P (:Id *Id2))
    (&outline_id.class (:a Win (:Id Id2)) *Id))

  (INIT &outline_box BoundingBox
    (key ((&outline ^Win ^Id *P))
      (cell (P)
        (&outline Win Id *P))))

  (RULE &perimeter
    (&outline_box.box (:key *Win *Id) (:B *B_o))
    (input *P)
    (ALL ((&outline_box.box (:key (:Win *Om_win) (:Id *Om_id)) (:B B_o))
          (dir_elem (:D *D_m1m))
          (relative (:Base B_o) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1m) (:K *K_m3)))
         ((>= K_m3 0)))
    (margin (:B P) (:D *D_m1) (:K *K_m2))
    (margin (:B B_o) (:D D_m1) (:K K_m2)))

  ;; The checkerboard classes: the cells joined by diagonal steps.
  (INIT &checker Quotient
    (edge ((:a P) (:b Q))
      (input *P)
      (OR ((diag_dir_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A P) (:B V_m1) (:C *Q))
           (input (:P Q)))
          ((= Q P)))))

  (RULE &phase
    (&outline *Win *Id (:P *P0))
    (input (:P P0) *Col)
    (&checker.class (:a P0) (:Id *C))
    (&checker.class (:a *P) (:Id C)))

  (INIT &perimeter_len Cardinality
    (key ((&perimeter ^Win ^Id *P))
      (member ((:m P))
        (&perimeter Win Id *P))))

  ;; The perimeter as a cycle: along each side, a quarter turn from the side's
  ;; edge.
  (INIT &loop Walk
    (key ((OR ((&outline_box.box (:key (:Win ^O_win) (:Id ^O_id)) (:B *B_o))
               (&perimeter (:Win O_win) (:Id O_id) *P)
               (ALL ((&perimeter (:Win *Om_win) (:Id *Om_id) P)
                     (&outline_box.box (:key (:Win Om_win) (:Id Om_id)) (:B B_o))
                     (dir_elem (:D *D_m1))
                     (relative (:Base B_o) (:X P) (:X_rel *R_m2))
                     (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                    ((>= K_m3 0)))
               (margin (:B P) *D (:K *K_m1))
               (margin (:B B_o) D (:K K_m1))
               (turn ^S D *D2)
               (step_offset (:D D2) (:V *V_m2))
               (compose (:A P) (:B V_m2) (:C *Q))
               (&perimeter (:Win O_win) (:Id O_id) (:P Q)))
              ((&perimeter_len.size (:key (:Win O_win) (:Id O_id)) *N)
               (sense_elem S))))
      (successor ((:p P) (:p_next Q))
        (&outline_box.box (:key (:Win O_win) (:Id O_id)) (:B *B_o))
        (&perimeter (:Win O_win) (:Id O_id) *P)
        (ALL ((&perimeter (:Win *Om_win) (:Id *Om_id) P)
              (&outline_box.box (:key (:Win Om_win) (:Id Om_id)) (:B B_o))
              (dir_elem (:D *D_m1))
              (relative (:Base B_o) (:X P) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B P) *D (:K *K_m1))
        (margin (:B B_o) D (:K K_m1))
        (turn S D *D2)
        (step_offset (:D D2) (:V *V_m2))
        (compose (:A P) (:B V_m2) (:C *Q))
        (&perimeter (:Win O_win) (:Id O_id) (:P Q)))
      (steps (N)
        (&perimeter_len.size (:key (:Win O_win) (:Id O_id)) *N)
        (sense_elem S))))

  (RULE &orbit
    (&outline *Win *Id (:P *P0))
    (&loop.walk (:key (:O_win Win) (:O_id Id) *S) (:p0 P0) *N)
    (> N 0)
    (&perimeter_len.size (:key Win Id) (:N *Len))
    (divide (:T Len) (:Side N) (:Gap 0) (:Remainder 0))
    (&loop.walk (:key (:O_win Win) (:O_id Id) S) (:p0 P0) (:N *M) (:p *P))
    (divide (:T M) (:Side N) (:Gap 0) (:Remainder 0)))

  (INIT &period Order
    (key ((&orbit ^Win ^Id *N)
          (ALL ((&orbit Win Id N *P0 *P)
                (&outline Win Id P)
                (input (:P P0) *Col)
                (input P (:Col *Col2)))
               ((= Col Col2))))
      (member ((:t N))
        (&orbit Win Id *N)
        (ALL ((&orbit Win Id N *P0 *P)
              (&outline Win Id P)
              (input (:P P0) *Col)
              (input P (:Col *Col2)))
             ((= Col Col2))))
      (score ((:t N) (:S N))
        (&orbit Win Id *N)
        (ALL ((&orbit Win Id N *P0 *P)
              (&outline Win Id P)
              (input (:P P0) *Col)
              (input P (:Col *Col2)))
             ((= Col Col2)))))))

(ALTS $src "where the frame color comes from" $FrameColor
  (ALT $DeriveFrameColor
    (INPUT window "the window is the largest one-cell ring of any non-background color whose interior is one color other than the ring's"
      (RULE &frame_src
        (input *Col)
        (NOT (&commonest.maximal (:t Col)))))))

(ALTS $pick "which ring of the frame color is the window" $Largest
  (ALT $OccludedWindow
    (INPUT window "the window is the largest ring of the frame color that some outline cell touches; undefined where no outline cell touches one"
      (RULE &occluding
        (&candidate *B)
        (input *P *Col)
        (NOT (&commonest.maximal (:t Col)))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3))
        (< K_m3 0)
        (dir_elem *D)
        (step_offset D (:V *V_m4))
        (compose (:A P) (:B V_m4) (:C *Q))
        (ALL ((input (:P *Pm) (:Col *Colm))
              (dir_elem (:D *Dm))
              (step_offset (:D Dm) (:V *V_m1))
              (compose (:A Pm) (:B V_m1) (:C Q))
              (dir_elem (:D *D_m1m))
              (relative (:Base B) (:X Q) (:X_rel *R_m2m))
              (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
             ((>= K_m3m 0)))
        (margin (:B Q) (:D *D_m5) (:K *K_m6))
        (margin B (:D D_m5) (:K K_m6)))

      (INIT &window_count Cardinality
        (key ((&candidate ^B)
              (&occluding B))
          (member ((:m P))
            (&hole B *P)))))))

(ALTS $part "which hidden cells an outline paints" $Complete
  (ALT $Complete
    (ALTS $color "the color a hidden perimeter cell takes" $Parity
      (ALT $PerimeterPeriod
        (OUTPUT parity-color "along the perimeter of the completed rectangle, a hidden cell takes the color of its class under the smallest period that the visible cells fit; undefined where its class holds no visible cell")
        (RULE &paint
          (&period.minimal (:key (:Win *B) (:Id *Oid)) (:t *N))
          (&orbit (:Win B) (:Id Oid) N *P0 *P)
          (input (:P P0) *Col)))))
  (ALT $ContactCorner
    (OUTPUT complete-rectangle "no rectangle is completed; an outline is read by its contacts and the window sides they lie on, where a contact is a frame cell other than a corner that an outline cell enters from outside"
      (RULE &contact
        (&outline *Win *Id *P)
        (opposite *D (:Opp *D_in))
        (step_offset (:D D_in) (:V *V_m1))
        (compose (:A P) (:B V_m1) (:C *Q))
        (ALL ((&outline Win (:Id *Oidm) (:P *Pm))
              (opposite (:D *Dm) (:Opp *D_inm))
              (step_offset (:D D_inm) (:V *V_m1m))
              (compose (:A Pm) (:B V_m1m) (:C Q))
              (dir_elem (:D *D_m1))
              (relative (:Base Win) (:X Q) (:X_rel *R_m2))
              (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
             ((>= K_m3 0)))
        (margin (:B Q) D (:K *K_m2))
        (margin (:B Win) D (:K K_m2))
        (step_offset (:D D_in) (:V *V_m3))
        (compose (:A Q) (:B V_m3) (:C *Q_in))
        (&hole (:B Win) (:P Q_in)))

      (RULE &touched
        (&contact *Win *Id *D))

      (RULE &bent
        (&touched *Win *Id *D)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *D2) (:A A2_m2))
        (&touched Win Id (:D D2)))

      (RULE &far
        (&contact *Win *Id *D *Q)
        (axis_of D (:A *A_m1))
        (perp (:A A_m1) (:A2 *A2_m2))
        (axis_of (:D *D2) (:A A2_m2))
        (ALL ((axis_of D (:A *A_m1m))
              (perp (:A A_m1m) (:A2 *A2_m2m))
              (axis_of (:D D2) (:A A2_m2m))
              (&contact Win Id D (:Q *Q2))
              (margin (:B Q) (:D D2) (:K *K1_m3))
              (margin (:B Q2) (:D D2) (:K *K2_m4)))
             ((>= K1_m3 K2_m4))))

      (RULE &contact_cell
        (axis_of *D *A)
        (&hole (:B *Win) *P)
        (perp A (:A2 *A2_m3))
        (axis_of (:D *D_m4) (:A A2_m3))
        (margin (:B P) (:D D_m4) (:K *K_m5))
        (OR ((&contact Win *Id D *Q)
             (opposite D (:Opp *D2))
             (&touched Win Id (:D D2))
             (NOT (&bent Win Id)))
            ((&far Win Id D D2 Q)
             (&far Win Id (:D D2) (:D2 D) (:Q *Q2))
             (dir_elem D)
             (margin (:B Q2) D (:K *K1_m1))
             (margin (:B P) D (:K *K2_m2))
             (>= K1_m1 K2_m2)))
        (margin (:B Q) (:D D_m4) (:K K_m5))))
    (OUTPUT draw-hidden "an outline that touches two opposite sides alone paints a full line across the interior at each contact; each pair of perpendicular sides it touches gives an L, whose arm from each side runs from that side's contact furthest from the other side to the other arm; an outline that touches one side alone paints nothing")
    (RULE &paint
      (&contact_cell (:Win *B) (:Id *Oid) *P)
      (&phase (:Win B) (:Id Oid) *Col P))))

(ALTS $group "which pieces form one outline" $ByColor
  (ALT $MonoMerge
    (OUTPUT group-outline "only one-color pieces join by a shared color, and each piece of two or more colors stands alone"
      (RULE &joined
        (&piece_color *B *Id *Col)
        (ALL ((&piece_color B Id (:Col *Colm))
              (&piece_color B Id (:Col *Col2)))
             ((= Colm Col2)))
        (&piece_color B (:Id *Id2) Col)
        (ALL ((&piece_color B (:Id Id2) (:Col *Colmm))
              (&piece_color B (:Id Id2) (:Col *Col2m)))
             ((= Colmm Col2m)))))))

(RULE &paint
  (&perimeter (:Win *B) (:Id *Oid) *P)
  (&phase (:Win B) (:Id Oid) *Col P))

(RULE &output
  (&window.maximal (:t *B))
  (&interior_box.box (:key B) (:B *B_int))
  (&hole B (:P *P2))
  (ALL ((&hole (:B *Bm) (:P P2))
        (&interior_box.box (:key (:B Bm)) (:B B_int))
        (dir_elem (:D *D_m1))
        (relative (:Base B_int) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B_int) (:X P2) (:X_rel *P))
  (OR ((&paint B (:P P2) *Col))
      ((NOT (&paint B (:P P2)))
       (&fill.value (:key B) (:v Col)))))
