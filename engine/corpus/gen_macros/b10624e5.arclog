;; b10624e5

(INPUT cross "one full row and one full column of &divider_color cross at the center and cut the grid into four equal quadrants on a field of &bg"

  (DET_OR_RULE &divider_color SharedColor)

  (DET_OR_RULE &bg DominantColor))

(INPUT template-quadrant "the top-left quadrant holds one figure: a solid square of &core_color with blocks of other colors attached around it"

  (RULE &item_split1
    (input (:P *P_) *Col)
    (axis_elem (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *L_))
    (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

  ;; The color of each line of the grid that holds one color alone.
  (INIT &line_color Singleton
    (key ((axis_elem ^A)
          (input *P *Col)
          (&item_split1 (:P_ P) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1)))
      (member ((:v Col))
        (axis_elem A)
        (input *P *Col)
        (&item_split1 (:P_ P) (:A_ A) (:L_ L) (:X_m1_ *X_m1)))))

  (RULE_OR_DET &quad_divider "The quadrants the full lines of a divider color cut."
    (&line_color.value (:key *A *L) (:v *Col))
    (&divider_color (:C Col)))

  (RULE &quad_on_divider
    (input *P)
    (&quad_divider *A *L)
    (axis_of *D A)
    (margin (:B P) D (:K *K_m1))
    (margin (:B L) D (:K K_m1)))

  ;; The quadrants the full lines of a divider color cut.
  (INIT &quad_rank Order
    (key ((OR ((&quad_divider *A *L)
               (axis_of ^D A)
               (margin (:B L) D *K))
              ((input *P)
               (dir_elem D)
               (margin (:B P) D K))))
      (member ((:t K))
        (&quad_divider *A *L)
        (axis_of D A)
        (margin (:B L) D *K))
      (score ((:t K) (:S K))
        (OR ((&quad_divider *A *L)
             (axis_of D A)
             (margin (:B L) D *K))
            ((input *P)
             (dir_elem D)
             (margin (:B P) D K))))
      (probe ((:t K))
        (input *P)
        (dir_elem D)
        (margin (:B P) D *K))))

  (RULE &quad_part_idx
    (input *P)
    (axis_of *D *A)
    (NOT (&quad_on_divider P A))
    (margin (:B P) D *K)
    (&quad_rank.rank (:key D) (:t K) (:R *N)))

  (RULE &quad_part_of
    (axis_of *D *A)
    (opposite D (:Opp *D2))
    (&quad_part_idx *P D (:N *N1))
    (&quad_part_idx P (:D D2) (:N *N2))
    (opposite D (:Opp *O_m1))
    (edge_inset D (:K N1) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K N2) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *P_part)))

  (RULE_OR_DET &quad_tile_of "The quadrants the full lines of a divider color cut."
    (&quad_part_of *P *A (:P_part *P1))
    (perp A *A2)
    (&quad_part_of P (:A A2) (:P_part *P2))
    (compose (:A P1) (:B P2) (:C *P_tile)))

  (DET &core_color SharedColor)

  (RULE &quad_cell
    (&quad_tile_of *P (:P_tile *T))
    (input P *Col))

  (INIT &shared Singleton
    (member ((:v Col))
      (&quad_cell *Col)
      (NOT (&bg (:C Col)))
      (ALL ((&quad_cell *T))
           ((&quad_cell T Col))))))

(INPUT lone-cores "each other quadrant holds one solid square of &core_color and nothing else")

(OUTPUT template "the template is the one quadrant that holds a color other than &bg and &core_color")

(OUTPUT keep-input "each input cell stays in the output unless a rule below paints it")

(OUTPUT mirror "the figure a lone core gets is the template quadrant reflected across each divider that lies between the template quadrant and that core's quadrant: one reflection for a side neighbor, both for the diagonal quadrant"

  (RULE &piece4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &piece8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (RULE &core_col
    (&core_color (:C *Col)))

  (INIT &template Singleton
    (member ((:v T))
      (&core_col)
      (&quad_cell *T *Col)
      (NOT (&bg (:C Col)))
      (NOT (&core_col Col))))

  (RULE_OR_DET &template.value)

  (RULE &tmpl_ink
    (&template.value (:v *T))
    (&quad_cell T *P *Col)
    (NOT (&bg (:C Col))))

  (INIT &piece8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&tmpl_ink *P)
           (&piece8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&tmpl_ink (:P P3)))
          ((&tmpl_ink P)
           (= P3 P)))))

  (INIT &piece4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&tmpl_ink *P)
           (&piece4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&tmpl_ink (:P P3)))
          ((&tmpl_ink P)
           (= P3 P))))))

(OUTPUT scale "on each axis, the template's blocks of side u, the largest side on whose lattice aligned to the template core the template quadrant is constant, number k = t / u across the template core. Each such block becomes a block of side s / k, where s is the lone core's extent on that axis, laid out so that the template core's blocks land on the lone core. The model is undefined where k does not divide s")

(OUTPUT paint "each cell of a lone core's quadrant that the scaled figure covers with a block of a color other than &bg takes that color. A block's part outside the quadrant is dropped"

  ;; Each quadrant's core.
  (INIT &core BoundingBox
    (key ((&core_col *Col)
          (&quad_cell ^T *P Col))
      (cell (P)
        (&core_col *Col)
        (&quad_cell T *P Col))))

  (RULE &side_cand_division_axis_split1
    (&core.box (:key *T) *B)
    (&core.cell (:key T) *P)
    (relative (:Base B) (:X P) (:X_rel *P_in_))
    (axis_elem (:A *A2_))
    (axis_of (:D *D_m1) (:A A2_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
    (relative (:Base Pi_) (:X P_in_) (:X_rel *X_m1_)))

  (RULE &side_cand_division_side_held_inside1
    (&core.cell (:key *T) (:P *P_))
    (&core.box (:key T) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &side_cand_division_axis
    (OR ((&template.value (:v *T))
         (&core.box (:key T) *B)
         (&core.cell (:key T) (:P *P2))
         (ALL ((&core.cell (:key (:T *Tm)) (:P P2))
               (&core.box (:key (:T Tm)) B)
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P2) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (relative (:Base B) (:X P2) (:X_rel *P))
         (sub_extent P (:A *Key_a) (:K *U))
         (axis_elem *A)
         (OR ((!= A Key_a))
             ((ALL ((&template.value (:v *Tmmm))
                    (&core.box (:key (:T Tmmm)) (:B *Bmm))
                    (&core.cell (:key (:T Tmmm)) (:P *Pmm))
                    (relative (:Base Bmm) (:X Pmm) (:X_rel *P_inmm))
                    (sub_extent (:P P_inmm) (:A Key_a) (:K U)))
                   ((&side_cand_division_side_held_inside1 (:P_ Pmm) (:B_ Bmm))))))
         (&side_cand_division_axis_split1 (:P_in_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
        ((&template.value (:v *T4))
         (&core.box (:key (:T T4)) (:B *B3))
         (&core.cell (:key (:T T4)) (:P *P3))
         (ALL ((&core.cell (:key (:T *Tm2)) (:P P3))
               (&core.box (:key (:T Tm2)) (:B B3))
               (dir_elem (:D *D_m12))
               (relative (:Base B3) (:X P3) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (relative (:Base B3) (:X P3) (:X_rel P))
         (sub_extent P (:A Key_a) (:K U))
         (&template.value (:v *T2))
         (&core.box (:key (:T T2)) (:B *B2))
         (&core.cell (:key (:T T2)) (:P *P22))
         (ALL ((&core.cell (:key (:T *T2m)) (:P P22))
               (&core.box (:key (:T T2m)) (:B B2))
               (dir_elem (:D *D_m1m))
               (relative (:Base B2) (:X P22) (:X_rel *R_m2m))
               (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
              ((>= K_m3m 0)))
         (relative (:Base B2) (:X P22) (:X_rel *P_in2))
         (sub_extent (:P P_in2) (:A Key_a) (:K U))
         (axis_of *D (:A Key_a))
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T3))
         (margin (:B P) (:D O) (:K *T22))
         (divide (:T T3) (:Side U) (:Gap 0) (:Part *I) (:Remainder *R))
         (divide (:T T22) (:Side U) (:Gap 0) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
         (frame_extent (:P P_inner) (:A Key_a) (:N U))
         (= A Key_a))))

  (RULE &side_cand_division_tile
    (&side_cand_division_axis (:Key_a *A) *U *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&side_cand_division_axis (:Key_a A) U P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (RULE &side_cand_division2_axis_split1
    (&core.box (:key *T) *B)
    (&core.cell (:key T) *P)
    (relative (:Base B) (:X P) (:X_rel *P_in_))
    (axis_elem (:A *A2_))
    (axis_of (:D *D_m1) (:A A2_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_in_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_in_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
    (relative (:Base Pi_) (:X P_in_) (:X_rel *X_m1_)))

  (RULE &side_cand_division2_side_held_inside1
    (&core.cell (:key *T) (:P *P_))
    (&core.box (:key T) (:B *B_))
    (dir_elem (:D *D_m1))
    (relative (:Base B_) (:X P_) (:X_rel *R_m2))
    (margin (:B R_m2) (:D D_m1) (:K *K_m3))
    (< K_m3 0))

  (RULE &side_cand_division2_axis
    (OR ((&template.value (:v *T))
         (&core.box (:key T) *B)
         (&core.cell (:key T) (:P *P2))
         (ALL ((&core.cell (:key (:T *Tm)) (:P P2))
               (&core.box (:key (:T Tm)) B)
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P2) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (relative (:Base B) (:X P2) (:X_rel *P))
         (frame_extent P (:A *Key_a) (:N *U))
         (axis_elem *A)
         (OR ((!= A Key_a))
             ((ALL ((&template.value (:v *Tmmm))
                    (&core.box (:key (:T Tmmm)) (:B *Bmm))
                    (&core.cell (:key (:T Tmmm)) (:P *Pmm))
                    (relative (:Base Bmm) (:X Pmm) (:X_rel *P_inmm))
                    (frame_extent (:P P_inmm) (:A Key_a) (:N U)))
                   ((&side_cand_division2_side_held_inside1 (:P_ Pmm) (:B_ Bmm))))))
         (&side_cand_division2_axis_split1 (:P_in_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
        ((&template.value (:v *T4))
         (&core.box (:key (:T T4)) (:B *B3))
         (&core.cell (:key (:T T4)) (:P *P3))
         (ALL ((&core.cell (:key (:T *Tm2)) (:P P3))
               (&core.box (:key (:T Tm2)) (:B B3))
               (dir_elem (:D *D_m12))
               (relative (:Base B3) (:X P3) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (relative (:Base B3) (:X P3) (:X_rel P))
         (frame_extent P (:A Key_a) (:N U))
         (&template.value (:v *T2))
         (&core.box (:key (:T T2)) (:B *B2))
         (&core.cell (:key (:T T2)) (:P *P22))
         (ALL ((&core.cell (:key (:T *T2m)) (:P P22))
               (&core.box (:key (:T T2m)) (:B B2))
               (dir_elem (:D *D_m1m))
               (relative (:Base B2) (:X P22) (:X_rel *R_m2m))
               (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
              ((>= K_m3m 0)))
         (relative (:Base B2) (:X P22) (:X_rel *P_in2))
         (frame_extent (:P P_in2) (:A Key_a) (:N U))
         (axis_of *D (:A Key_a))
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T3))
         (margin (:B P) (:D O) (:K *T22))
         (divide (:T T3) (:Side U) (:Gap 0) (:Part *I) (:Remainder *R))
         (divide (:T T22) (:Side U) (:Gap 0) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
         (frame_extent (:P P_inner) (:A Key_a) (:N U))
         (= A Key_a))))

  (RULE &side_cand_division2_tile
    (&side_cand_division2_axis (:Key_a *A) *U *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&side_cand_division2_axis (:Key_a A) U P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (RULE &lone
    (&template.value (:v *T2))
    (&core.box (:key *T) *B)
    (!= T T2))

  (RULE &side_cand
    (OR ((&template.value (:v *T))
         (&core.box (:key T) *B)
         (&core.cell (:key T) *P)
         (ALL ((&core.cell (:key (:T *Tm)) P)
               (&core.box (:key (:T Tm)) B)
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X P) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (relative (:Base B) (:X P) (:X_rel *P_in))
         (&side_cand_division_tile *A *U (:P P_in) (:P_outer *P_blk))
         (frame_extent (:P P_blk) A *N))
        ((&template.value (:v *T2))
         (&core.box (:key (:T T2)) (:B *B2))
         (&core.cell (:key (:T T2)) (:P *P2))
         (ALL ((&core.cell (:key (:T *Tm2)) (:P P2))
               (&core.box (:key (:T Tm2)) (:B B2))
               (dir_elem (:D *D_m12))
               (relative (:Base B2) (:X P2) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (relative (:Base B2) (:X P2) (:X_rel *P_in2))
         (&side_cand_division2_tile A U (:P P_in2) (:P_outer *P_blk2))
         (frame_extent (:P P_blk2) A N))))

  (RULE &tmpl_idx
    (&side_cand *A *U)
    (axis_of *D A)
    (&template.value (:v *T))
    (&core.box (:key T) *B)
    (&quad_cell T *P)
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (margin (:B P_rel) D (:K *X))
    (divide (:T X) (:Side U) (:Gap 0) (:Part *N)))

  (RULE &mixed
    (&tmpl_idx *U (:P *P1) *D *N)
    (&tmpl_idx U (:P *P2) D N)
    (axis_of D *A)
    (perp A (:A2 *A2_m1))
    (axis_of (:D *D_m2) (:A A2_m1))
    (margin (:B P1) (:D D_m2) (:K *K_m3))
    (margin (:B P2) (:D D_m2) (:K K_m3))
    (input (:P P1) (:Col *Col1))
    (input (:P P2) (:Col *Col2))
    (!= Col1 Col2))

  ;; The template's block side on each axis: the largest that leaves the template
  ;; quadrant constant on its blocks.
  (INIT &side Order
    (key ((&side_cand ^A *U)
          (NOT (&mixed A U)))
      (member ((:t U))
        (&side_cand A *U)
        (NOT (&mixed A U)))
      (score ((:t U) (:S U))
        (&side_cand A *U)
        (NOT (&mixed A U)))))

  (INIT &lone_side_division_sides ExtentDivisions
    (key ((&side.maximal (:key ^A))))
    (frame ((:P Q_in))
      (&lone (:T *L) *B)
      (&core.cell (:key (:T L)) (:P *Q))
      (ALL ((&core.cell (:key (:T *Lm)) (:P Q))
            (&lone (:T Lm) B)
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X Q) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X Q) (:X_rel *Q_in))))

  (RULE &lone_side_division_axis_split1
    (&lone (:T *L) *B)
    (&core.cell (:key (:T L)) (:P *Q))
    (relative (:Base B) (:X Q) (:X_rel *Q_in_))
    (axis_elem (:A *A2_))
    (axis_of (:D *D_m1) (:A A2_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B Q_in_) (:D D_m1) (:K *K1_m3))
    (margin (:B Q_in_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
    (relative (:Base Pi_) (:X Q_in_) (:X_rel *X_m1_)))

  (RULE &lone_side_division_parts_held
    (&side.maximal (:key *A) (:t *U))
    (&side_cand A U *N))

  (RULE &lone_side_division_axis
    (OR ((&lone (:T *L) *B)
         (&core.cell (:key (:T L)) (:P *Q))
         (ALL ((&core.cell (:key (:T *Lm)) (:P Q))
               (&lone (:T Lm) B)
               (dir_elem (:D *D_m1))
               (relative (:Base B) (:X Q) (:X_rel *R_m2))
               (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
              ((>= K_m3 0)))
         (relative (:Base B) (:X Q) (:X_rel *P))
         (&side.maximal (:key (:A *Key)))
         (axis_elem *A)
         (OR ((!= A Key))
             ((NOT (&lone_side_division_parts_held (:A Key)))))
         (&lone_side_division_axis_split1 (:Q_in_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
         (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
        ((&lone (:T *L2) (:B *B2))
         (&core.cell (:key (:T L2)) (:P *Q2))
         (ALL ((&core.cell (:key (:T *Lm2)) (:P Q2))
               (&lone (:T Lm2) (:B B2))
               (dir_elem (:D *D_m12))
               (relative (:Base B2) (:X Q2) (:X_rel *R_m22))
               (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
              ((>= K_m32 0)))
         (relative (:Base B2) (:X Q2) (:X_rel P))
         (&side.maximal (:key (:A Key)))
         (&side.maximal (:key (:A Key)) (:t *U))
         (&side_cand (:A Key) U *N)
         (&lone_side_division_sides.division (:key (:A Key)) (:A Key) N (:K *K2) (:G 0))
         (axis_of *D (:A Key))
         (opposite D (:Opp *O))
         (margin (:B P) D (:K *T))
         (margin (:B P) (:D O) (:K *T2))
         (divide T (:Side K2) (:Gap 0) (:Part *I) (:Remainder *R))
         (divide (:T T2) (:Side K2) (:Gap 0) (:Part *I2) (:Remainder *R2))
         (opposite D (:Opp *O_m1))
         (edge_inset D (:K I) (:B *B1_m2))
         (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
         (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
         (opposite D (:Opp *O_m4))
         (edge_inset D (:K R) (:B *B1_m5))
         (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
         (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
         (frame_extent (:P P_inner) (:A Key) (:N K2))
         (= A Key))
        ((&lone (:T *L3) (:B *B3))
         (&core.cell (:key (:T L3)) (:P *Q3))
         (ALL ((&core.cell (:key (:T *Lm3)) (:P Q3))
               (&lone (:T Lm3) (:B B3))
               (dir_elem (:D *D_m13))
               (relative (:Base B3) (:X Q3) (:X_rel *R_m23))
               (margin (:B R_m23) (:D D_m13) (:K *K_m33)))
              ((>= K_m33 0)))
         (relative (:Base B3) (:X Q3) (:X_rel P))
         (&side.maximal (:key (:A Key)))
         (&side.maximal (:key (:A Key)) (:t *U2))
         (&side_cand (:A Key) (:U U2) (:N *N2))
         (frame_extent P (:A Key) (:N *K22))
         (axis_of (:D *D2) (:A Key))
         (opposite (:D D2) (:Opp *O2))
         (margin (:B P) (:D D2) (:K *T3))
         (margin (:B P) (:D O2) (:K *T22))
         (divide (:T T3) (:Side K22) (:Gap 0) (:Part *I3) (:Remainder *R3))
         (divide (:T T22) (:Side K22) (:Gap 0) (:Part *I22) (:Remainder *R22))
         (opposite (:D D2) (:Opp *O_m12))
         (edge_inset (:D D2) (:K I3) (:B *B1_m22))
         (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
         (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
         (opposite (:D D2) (:Opp *O_m42))
         (edge_inset (:D D2) (:K R3) (:B *B1_m52))
         (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
         (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
         (frame_extent (:P P_inner) (:A Key) (:N K22))
         (frame_extent (:P P_outer) (:A Key) (:N N2))
         (= A Key))))

  (RULE &lone_side_division_tile
    (&lone_side_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
    (perp (:A A1) *A2)
    (&lone_side_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
    (compose (:A Po1) (:B Po2) (:C *P_outer))
    (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

  (RULE &lone_side_split1
    (&lone_side_division_tile (:Key *A_) (:P *Q_in) (:P_inner *P_slab_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
    (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *Q_blk_))
    (relative (:Base Q_blk_) (:X P_slab_) (:X_rel *X_m1_)))

  (RULE &tmpl_block
    (&side.maximal (:key *A) (:t *U))
    (axis_of *D A)
    (&tmpl_idx U *P D *N))

  (RULE &lone_side
    (&lone *T *B)
    (&core.cell (:key T) (:P *Q))
    (ALL ((&core.cell (:key (:T *Lm)) (:P Q))
          (&lone (:T Lm) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X Q) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X Q) (:X_rel *Q_in))
    (&lone_side_division_tile (:Key *A) (:P Q_in) (:P_inner *P_slab))
    (&lone_side_split1 (:P_slab_ P_slab) (:A_ A) (:Q_blk_ *Q_blk) (:X_m1_ *X_m1))
    (frame_extent (:P Q_blk) A (:N *V)))

  (RULE &lone_idx
    (&lone *T *B)
    (&lone_side T *A *V)
    (axis_of *D A)
    (input (:P *Q))
    (relative (:Base B) (:X Q) (:X_rel *Q_rel))
    (margin (:B Q_rel) D (:K *X))
    (divide (:T X) (:Side V) (:Gap 0) (:Part *N)))

  (RULE_OR_DET &mirror "Direction D at lone quadrant L, as the template quadrant sees it: reversed across each divider between the two."
    (&template.value (:v *T2))
    (&lone *T)
    (dir_elem *D)
    (OR ((margin (:B T2) D (:K *K1_m2))
         (margin (:B T) D (:K *K2_m3))
         (!= K1_m2 K2_m3)
         (opposite D (:Opp *E1)))
        ((margin (:B T2) D (:K *K_m1))
         (margin (:B T) D (:K K_m1))
         (= E1 D))))

  (RULE &scaled
    (&lone_idx *T *Q (:D *D1) (:N *N1))
    (&mirror T (:D D1) *E1)
    (&tmpl_block *P (:D E1) (:N N1))
    (axis_of (:D D1) (:A *A_m1))
    (perp (:A A_m1) (:A2 *A2_m2))
    (axis_of (:D *D2) (:A A2_m2))
    (&lone_idx T Q (:D D2) (:N *N2))
    (&mirror T (:D D2) (:E1 *E2))
    (&tmpl_block P (:D E2) (:N N2)))

  (RULE &figure
    (&tmpl_ink *P *Col)))

(ALTS $clip "what happens to the part of a scaled figure that leaves the lone core's quadrant" $QuadrantClip
  (ALT $GridClip
    (OUTPUT paint "each grid cell that the scaled figure covers with a block of a color other than &bg takes that color, over the dividers and the other quadrants too; a block's part off the grid is dropped; undefined where two figures give one cell different colors")
    (RULE &paint
      (&scaled *Q *P)
      (&figure P *Col))))

(ALTS $core "how the core color is known" $StoredCore
  (ALT $CoreByQuadrants
    (OUTPUT core-by-quadrants "the core color is the one color other than &bg that every quadrant holds, in place of &core_color; nothing is painted where no one color is"
      (RULE &core_col
        (&shared.value (:v *Col))))))

(ALTS $extent "what the template carries" $WholeQuadrant
  (ALT $FigureOnly
    (OUTPUT mirror "only the 8-connected piece of cells other than &bg that holds the template core is reflected, in place of the whole template quadrant"
      (RULE &piece8_component
        (&piece8.class (:a *P) *Id))

      (RULE &tmpl_core
        (&template.value (:v *T))
        (&core.cell (:key T) *P))

      (RULE &figure
        (&tmpl_core (:P *P0))
        (&piece8_component (:P P0) *Id)
        (&piece8_component *P Id)
        (input P *Col)))
    (ALTS $adj "which cells join the figure's piece" $Adjacency8
      (ALT $Adjacency4
        (OUTPUT mirror "the piece joins cells that share a side"
          (RULE &piece4_component
            (&piece4.class (:a *P) *Id))
          (RULE &figure
            (&tmpl_core (:P *P0))
            (&piece4_component (:P P0) *Id)
            (&piece4_component *P Id)
            (input P *Col)))))))

(RULE &unscaled
  (&lone (:T *L))
  (&side.maximal (:key *A))
  (NOT (&lone_side (:T L) A)))

(RULE &paint
  (&scaled (:T *L) *Q *P)
  (&quad_tile_of (:P Q) (:P_tile L))
  (&figure P *Col))

(RULE &output
  (NOT (&unscaled))
  (OR ((&paint (:Q *P) *Col))
      ((input P Col)
       (NOT (&paint (:Q P))))))
