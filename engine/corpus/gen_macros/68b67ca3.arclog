;; 68b67ca3

(DET &cand
  (ex_input *E (:P *P_in) (:Col *C))
  (ex_output E (:P *P_out) (:Col C)))

(DET &broken
  (&cand *P_in *P_out)
  (ex_output *E)
  (NOT (&cand E P_in P_out)))

(DET &pair
  (&cand *P_in *P_out)
  (NOT (&broken P_in P_out)))

(INIT &ident Quotient
  (equivalent ((:a P_in) (:b P_in))
    (&pair *P_in)))

(DET &in_label
  (&pair (:P_in *P))
  (&ident.class (:a P) *Id))

(DET &out_label
  (&pair *P_in (:P_out *P))
  (&ident.class (:a P_in) *Id))

(RULE &map
  (&in_label (:P *P_in) *Id)
  (&out_label (:P *P_out) Id))

(DET &anchor DiagDirDomain)

(RULE &perm
  (&map *P_in *P_out))

(ALTS $choice "out's choice column (decompose)" $LabeledGrids
  (ALT $Count
    (DET &divisor ConstOutDim)

    (INIT &perm_division_sides ExtentDivisions
      (frame ((:P P_grid_in))
        (input (:P *P_grid_in))))

    (RULE &perm_division_axis_split1
      (input (:P *P_grid_in_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_in_) (:X_rel *X_m1_)))

    (RULE &perm_division_parts
      (axis_elem *A)
      (&divisor *N))

    (RULE &perm_division_axis
      (OR ((input *P)
           (axis_elem *A)
           (&divisor *N)
           (&perm_division_sides.division A N *K (:G 0))
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (&divisor (:N *N2))
           (frame_extent P A (:N *K2))
           (axis_of (:D *D2) A)
           (opposite (:D D2) (:Opp *O2))
           (margin (:B P) (:D D2) (:K *T3))
           (margin (:B P) (:D O2) (:K *T22))
           (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
           (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
           (opposite (:D D2) (:Opp *O_m12))
           (edge_inset (:D D2) (:K I3) (:B *B1_m22))
           (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
           (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m42))
           (edge_inset (:D D2) (:K R3) (:B *B1_m52))
           (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
           (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
           (frame_extent (:P P_inner) A (:N K2))
           (frame_extent (:P P_outer) A (:N N2)))
          ((input P)
           (axis_elem A)
           (NOT (&perm_division_parts A))
           (&perm_division_axis_split1 (:P_grid_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &perm_division_tile
      (&perm_division_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&perm_division_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &perm
      (&perm_division_tile (:P *P_in) (:P_outer *P_out) (:P_inner *P_intile))
      (&anchor *D)
      (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin (:B P_intile) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P_intile) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6))))
  (ALT $Size
    (DET &tile_size DivisorRatio)

    (RULE &perm_division2_axis_split1
      (input (:P *P_grid_in_))
      (axis_elem (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_grid_in_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_grid_in_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_grid_in_) (:X_rel *X_m1_)))

    (RULE &perm_division2_side
      (axis_elem *A)
      (&tile_size *K))

    (RULE &perm_division2_axis
      (OR ((input *P)
           (axis_elem *A)
           (&tile_size *K)
           (axis_of *D A)
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C *P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C *P_inner))
           (frame_extent (:P P_inner) A (:N K)))
          ((input P)
           (axis_elem A)
           (NOT (&perm_division2_side A))
           (&perm_division2_axis_split1 (:P_grid_in_ P) (:A_ A) (:Pi_ P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel P_outer)))))

    (RULE &perm_division2_tile
      (&perm_division2_axis *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&perm_division2_axis P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &perm
      (&perm_division2_tile (:P *P_in) (:P_outer *P_out) (:P_inner *P_intile))
      (&anchor *D)
      (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
      (perp (:A A_m1) (:A2 *A2_m3))
      (corner_dir (:C D) (:A A2_m3) (:D *D2_m4))
      (margin (:B P_intile) (:D D1_m2) (:K *K1_m5))
      (margin (:B 0) (:D D1_m2) (:K K1_m5))
      (margin (:B P_intile) (:D D2_m4) (:K *K2_m6))
      (margin (:B 0) (:D D2_m4) (:K K2_m6)))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&perm (:P_in P_grid_in) (:P_out *P)))
