;; 12422b43

(DET &bg DominantColor)

(DET &marker SharedColor)

(DET &flow DirDomain)

(RULE &cell_line
  (input *P *Col)
  (&flow *D)
  (opposite D (:Opp *O))
  (margin (:B P) (:D O) (:K *R)))

(RULE &ink
  (&cell_line *P *Col *R)
  (NOT (&bg (:C Col)))
  (NOT (&marker (:C Col))))

(RULE &ink_line
  (&ink *R))

(RULE &marker_line
  (&cell_line *Col *R)
  (&marker (:C Col)))

(RULE &unit
  (&ink *P *Col *R)
  (&marker_line R))

(INIT &pat_len Cardinality
  (member ((:m R))
    (&ink_line *R)))

(INIT &unit_len Cardinality
  (member ((:m R))
    (&marker_line *R)))

(RULE &copy
  (&unit (:P *P1) *Col)
  (&pat_len.size *N)
  (&flow *D)
  (dir8_opposite D (:D2 *O_m2))
  (edge_inset (:D O_m2) (:K N) (:B *B1_m3))
  (edge_inset D (:K N) (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P1) (:B V_m1) (:C *P_seat))
  (input *P)
  (perp *A (:A2 *A2_m6))
  (axis_of (:D *D_m7) (:A A2_m6))
  (margin (:B P_seat) (:D D_m7) (:K *K_m8))
  (margin (:B P) (:D D_m7) (:K K_m8))
  (axis_of D A)
  (relative (:Base P_seat) (:X P) (:X_rel *V))
  (opposite D (:Opp *O))
  (margin (:B V) (:D O) (:K *T))
  (&unit_len.size (:N *K))
  (divide T (:Side K) (:Gap 0) (:Remainder 0)))

(ALTS $choice "two models place the copies" $Stamp
  (ALT $Tile
    ;; The remainder: cells of the non-ink lines.
    (INIT &region_box BoundingBox
      (cell (P)
        (&cell_line *P *R)
        (NOT (&ink_line R))))

    (RULE &copy_division_axis_split1
      (&region_box.box *B)
      (&region_box.cell *P)
      (relative (:Base B) (:X P) (:X_rel *P_inner_))
      (axis_elem (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_inner_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_inner_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_inner_) (:X_rel *X_m1_)))

    (RULE &copy_division_side_held
      (&flow *D)
      (axis_of D *A)
      (&unit_len.size (:N *K)))

    (RULE &copy_division_axis
      (OR ((&region_box.cell (:P *P2))
           (&region_box.box *B)
           (ALL ((dir_elem (:D *D_m1))
                 (relative (:Base B) (:X P2) (:X_rel *R_m2))
                 (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                ((>= K_m3 0)))
           (relative (:Base B) (:X P2) (:X_rel *P))
           (&flow *D)
           (axis_of D (:A *Key_a))
           (axis_elem *A)
           (OR ((!= A Key_a))
               ((NOT (&copy_division_side_held D (:A Key_a)))))
           (&copy_division_axis_split1 (:P_inner_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((&region_box.cell (:P *P22))
           (&region_box.box (:B *B2))
           (ALL ((dir_elem (:D *D_m12))
                 (relative (:Base B2) (:X P22) (:X_rel *R_m22))
                 (margin (:B R_m22) (:D D_m12) (:K *K_m32)))
                ((>= K_m32 0)))
           (relative (:Base B2) (:X P22) (:X_rel P))
           (&flow D)
           (axis_of D (:A Key_a))
           (&unit_len.size (:N *K))
           (axis_of (:D *D2) (:A Key_a))
           (opposite (:D D2) (:Opp *O))
           (margin (:B P) (:D D2) (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite (:D D2) (:Opp *O_m1))
           (edge_inset (:D D2) (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite (:D D2) (:Opp *O_m4))
           (edge_inset (:D D2) (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key_a) (:N K))
           (= A Key_a))))

    (RULE &copy_division_tile
      (&copy_division_axis *D (:Key_a *A) *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&copy_division_axis D (:Key_a A) P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    (RULE &copy_split1
      (&copy_division_tile *D (:A *A_) (:P *P_inner) (:P_inner *P_slab_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_slab_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_slab_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *P_intile_))
      (relative (:Base P_intile_) (:X P_slab_) (:X_rel *X_m1_)))

    (RULE &copy
      (&region_box.cell *P)
      (&region_box.box *B)
      (ALL ((dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0)))
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&copy_division_tile *D *A (:P P_inner) (:P_inner *P_slab))
      (&copy_split1 (:P_slab_ P_slab) (:A_ A) (:P_intile_ *P_intile) (:X_m1_ *X_m1))
      (opposite D (:Opp *O))
      (margin (:B P_intile) (:D O) (:K *R))
      (&unit (:P *P_u) *Col R)
      (perp A (:A2 *A2_m2))
      (axis_of (:D *D_m3) (:A A2_m2))
      (margin (:B P) (:D D_m3) (:K *K_m4))
      (margin (:B P_u) (:D D_m3) (:K K_m4)))))

(RULE &output
  (OR ((&copy *P *Col))
      ((input P Col)
       (NOT (&copy P)))))
