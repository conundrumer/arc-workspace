;; ac605cbb

(INPUT seed-colors-keyed "each seed's color is a key of the stamp, and no color occurs on more than one seed")

(INPUT stamps-fit "each seed's stamp lies inside the grid")

(INPUT stamps-meet-at-lines "two stamps share no cell other than a cell that is a line cell of both, and no line cell of a stamp lands on a seed")

(OUTPUT keep-input "each input cell keeps its color unless a rule below paints it")

(OUTPUT stamp-path "at each seed, the stamp of the seed's color is drawn from the seed: its line cells in line_color and its end cell in the seed's color")

(OUTPUT cross-cell "a cell that is a line cell of two stamps is cross_color")

(OUTPUT cross-ray "from each crossing cell, the cells toward cross_dir up to the grid edge are cross_color"

  (DET &cross_dir DiagDirDomain)

  (INIT &ground_count Cardinality
    (key ((ex_input *E *P ^Col))
      (member ((:m E P))
        (ex_input *E *P Col))))

  ;; The grids' ground color; the seeds are the exception to it.
  (INIT &ground Order
    (member ((:t Col))
      (&ground_count.size (:key *Col)))
    (score ((:t Col) (:S Count))
      (&ground_count.size (:key *Col) (:N *Count))))

  (DET &seed
    (ex_input *E (:P *S) (:Col *C))
    (NOT (&ground.maximal (:t C)))
    (ex_output E))

  (DET &changed
    (&seed *E *S)
    (ex_output E *P *Col)
    (ex_input E P (:Col *Col_in))
    (!= Col Col_in)
    (relative (:Base S) (:X P) (:X_rel *V)))

  (DET &stamp_end
    (&seed *E *S *C)
    (&changed E S *V (:Col C)))

  (RULE &seed2
    (input *P (:Col *C))
    (&stamp_end C))

  (RULE &drawn
    (&seed2 (:P *S)))

  (DET &line_mark
    (&seed *E *S *C)
    (&changed E S *V *Col)
    (!= Col C))

  (DET &line_defect
    (&line_mark *V)
    (&seed *E *S *C)
    (NOT (&line_mark E S V)))

  (DET &stamp_line
    (&seed *E *S *C)
    (&line_mark E S *V)
    (NOT (&line_defect C V)))

  (RULE &placed_line
    (&seed2 (:P *S) *C)
    (&stamp_line C *V)
    (compose (:A S) (:B V) (:C *P)))

  (RULE &line_cell
    (&drawn *S)
    (&placed_line S *P)
    (input P))

  (RULE &two_lines
    (&line_cell *P (:S *S1))
    (&line_cell P (:S *S2))
    (!= S1 S2))

  (RULE &crossing
    (&two_lines *P))

  (RULE &ray_dir
    (&crossing *P)
    (&cross_dir (:D *Dg)))

  (RULE &cross_ray_dir
    (&ray_dir (:Dg *Key)))

  (RULE &placed_end
    (&seed2 (:P *S) *C)
    (&stamp_end C *V)
    (compose (:A S) (:B V) (:C *P)))

  (RULE &end_cell
    (&drawn *S)
    (&placed_end S *P *C)
    (input P))

  (RULE &occupied
    (OR ((&seed2 *P))
        ((&line_cell P))
        ((&end_cell P))))

  (RULE &cross_ray_blocked
    (&ray_dir (:Dg *Key))
    (&occupied *P))

  (RULE &cross_ray_node
    (&ray_dir (:Dg *Key))
    (input *P)
    (NOT (&cross_ray_blocked Key P)))

  (RULE &cross_ray_source
    (&ray_dir *P (:Dg *Key)))

  (INIT &cross_ray Distance
    (key ((&cross_ray_source (:Key ^Ky) (:P ^O))
          (&cross_ray_dir (:Key Ky)))
      (edge ((:a A2) (:b Q))
        (OR ((&cross_ray_source (:Key Ky) (:P O))
             (&cross_ray_dir (:Key Ky))
             (axis_of (:D Ky) *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite (:D Ky) (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset (:D Ky) K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&cross_ray_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&cross_ray_node (:Key Ky) (:P Q)))
            ((&cross_ray_source (:Key Ky) (:P O))
             (&cross_ray_dir (:Key Ky))
             (step_offset (:D Ky) (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&cross_ray_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&cross_ray_source (:Key Ky) (:P O))
             (&cross_ray_dir (:Key Ky))
             (diag_dir_elem (:D Ky))
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite (:D Ky) (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset (:D Ky) (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&cross_ray_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&cross_ray_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&cross_ray_source (:Key Ky) (:P O))
        (&cross_ray_dir (:Key Ky)))))

  (RULE &cross_ray_ray
    (&cross_ray.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

  (RULE &cross_ray_full_dir
    (&ray_dir (:Dg *Key)))

  (RULE &cross_ray_full_node
    (&ray_dir (:Dg *Key))
    (input *P))

  (RULE &cross_ray_full_source
    (&ray_dir *P (:Dg *Key)))

  (INIT &cross_ray_full Distance
    (key ((&cross_ray_full_source (:Key ^Ky) (:P ^O))
          (&cross_ray_full_dir (:Key Ky)))
      (edge ((:a A2) (:b Q))
        (OR ((&cross_ray_full_source (:Key Ky) (:P O))
             (&cross_ray_full_dir (:Key Ky))
             (axis_of (:D Ky) *A)
             (sub_extent (:P O) A *K)
             (dir8_opposite (:D Ky) (:D2 *O_m2))
             (edge_inset (:D O_m2) K (:B *B1_m3))
             (edge_inset (:D Ky) K (:B *I_m5))
             (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
             (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
             (compose (:A O) (:B V_m1) (:C *A2))
             (&cross_ray_full_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m6))
             (compose (:A A2) (:B V_m6) (:C *Q))
             (&cross_ray_full_node (:Key Ky) (:P Q)))
            ((&cross_ray_full_source (:Key Ky) (:P O))
             (&cross_ray_full_dir (:Key Ky))
             (step_offset (:D Ky) (:V *V_m12))
             (compose (:A O) (:B V_m12) (:C Q))
             (&cross_ray_full_node (:Key Ky) (:P Q))
             (= A2 O))
            ((&cross_ray_full_source (:Key Ky) (:P O))
             (&cross_ray_full_dir (:Key Ky))
             (diag_dir_elem (:D Ky))
             (axis_elem (:A *A3))
             (sub_extent (:P O) (:A A3) (:K *K2))
             (dir8_opposite (:D Ky) (:D2 *O_m22))
             (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
             (edge_inset (:D Ky) (:K K2) (:B *I_m52))
             (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
             (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
             (compose (:A O) (:B V_m13) (:C A2))
             (&cross_ray_full_node (:Key Ky) (:P A2))
             (step_offset (:D Ky) (:V *V_m62))
             (compose (:A A2) (:B V_m62) (:C Q))
             (&cross_ray_full_node (:Key Ky) (:P Q)))))
      (source ((:n O))
        (&cross_ray_full_source (:Key Ky) (:P O))
        (&cross_ray_full_dir (:Key Ky)))))

  (RULE &cross_ray_full_ray
    (&cross_ray_full.distance (:key (:Ky *Key) (:Ky *D) (:O *Origin)) (:n *P) *K))

  (DET &line_color OutNewColor)

  (DET &cross_color AnyOutNewColor)

  (RULE &line_hidden
    (&crossing *P))

  (RULE &stamp_paint
    (OR ((&crossing *P)
         (&cross_color (:C *Col)))
        ((&line_cell P)
         (NOT (&line_hidden P))
         (&line_color (:C Col)))
        ((&end_cell P (:C Col)))))

  (RULE &cross_ray_cell
    (&ray_dir (:Dg *Key))
    (input *P)))

(ALTS $ink "what the ray does at a cell that a seed or a stamp occupies" $RayPaintsInk
  (ALT $RayUnderInk
    (OUTPUT cross-ray "the ray goes on to the grid edge and paints only the cells that no seed or stamp occupies")
    (RULE &ray_paint
      (&cross_ray_full_ray *P *K)
      (&cross_ray_cell P)
      (!= K 0)
      (NOT (&occupied P))))
  (ALT $RayStopsAtInk
    (OUTPUT cross-ray "the ray ends before the first cell that a seed or a stamp occupies")
    (RULE &ray_paint
      (&cross_ray_ray *P *K)
      (&cross_ray_cell P)
      (!= K 0))))

(ALTS $heading "the diagonal direction of the ray from a crossing" $RayStoredDir
  (ALT $RayAlongHorizontalLine
    (OUTPUT cross-ray "on the axis across ray_fixed_dir, the ray takes the step direction of the stamp line that runs along that axis through the crossing, and on the other axis it takes ray_fixed_dir; undefined where no stamp, or two stamps, run along that axis through a crossing"
      ;; The ray's direction on the axis that no crossing stamp sets.
      (DET &ray_fixed_dir DirDomain)

      (RULE &runs
        (&line_cell *P *S)
        (dir_elem *D)
        (opposite D (:Opp *D_back))
        (dir_elem (:D D_back))
        (margin (:B S) (:D D_back) (:K *K1_m1))
        (margin (:B P) (:D D_back) (:K *K2_m2))
        (< K1_m1 K2_m2)
        (step_offset (:D D_back) (:V *V_m3))
        (compose (:A P) (:B V_m3) (:C *Q))
        (OR ((= Q S))
            ((&placed_line S (:P Q)))))

      (RULE &follow_run
        (&runs *S *P *D)
        (axis_of D *A)
        (&ray_fixed_dir (:D *D_fixed))
        (axis_of (:D D_fixed) (:A *A_fixed))
        (perp (:A A_fixed) (:A2 A)))

      (RULE &two_follow_runs
        (&follow_run (:S *S1) *P)
        (&follow_run (:S *S2) P)
        (!= S1 S2))

      (RULE &ray_dir
        (&crossing *P)
        (&follow_run P *D)
        (NOT (&two_follow_runs P))
        (&ray_fixed_dir (:D *D_fixed))
        (corner_dir (:C *Dg) *A D)
        (perp A (:A2 *A2_m1))
        (corner_dir (:C Dg) (:A A2_m1) (:D D_fixed)))

      (RULE &heading_void
        (&crossing *P)
        (OR ((NOT (&follow_run P)))
            ((&two_follow_runs P)))))
    (RULE &live
      (NOT (&heading_void)))))

(ALTS $end "what a cell gets where one stamp's end cell meets another stamp's line cell" $EndLineClash
  (ALT $EndOverLine
    (OUTPUT end-over-line "where a stamp's end cell meets another stamp's line cell, the end cell's color shows and the cell is no crossing"
      (RULE &crossing
        (&two_lines *P)
        (NOT (&end_cell P)))

      (RULE &line_hidden
        (OR ((&end_cell *P))
            ((&crossing P))))))
  (ALT $LineOverEnd
    (OUTPUT line-over-end "where a stamp's end cell meets another stamp's line cell, line_color shows, and the cell is a crossing only where it is a line cell of two stamps"
      (RULE &end_hidden
        (&end_cell *P)
        (&line_cell P))

      (RULE &stamp_paint
        (OR ((&crossing *P)
             (&cross_color (:C *Col)))
            ((&line_cell P)
             (NOT (&line_hidden P))
             (&line_color (:C Col)))
            ((&end_cell P (:C Col))
             (NOT (&end_hidden P)))))))
  (ALT $CrossAtEndCell
    (OUTPUT cross-cell "a cell that two stamps reach, at a line cell or at the end cell, is cross_color and casts the ray"
      (RULE &crossing
        (OR ((&line_cell *P (:S *S1)))
            ((&end_cell P (:S S1))))
        (OR ((&line_cell P (:S *S2)))
            ((&end_cell P (:S S2))))
        (!= S1 S2))

      (RULE &end_hidden
        (&crossing *P)
        (&end_cell P))

      (RULE &stamp_paint
        (OR ((&crossing *P)
             (&cross_color (:C *Col)))
            ((&line_cell P)
             (NOT (&line_hidden P))
             (&line_color (:C Col)))
            ((&end_cell P (:C Col))
             (NOT (&end_hidden P))))))))

(ALTS $seed "what a seed's cell gets where another stamp's cell lands on it" $StampOverSeed
  (ALT $SeedOverStamp
    (OUTPUT keep-input "a seed keeps its color over any stamp")
    (RULE &covered
      (&stamp_paint *P)
      (NOT (&seed2 P)))))

(ALTS $grid "what is drawn of a stamp that reaches past the grid edge" $ClipStampToGrid
  (ALT $DropStampOffGrid
    (OUTPUT stamp-path "a stamp whose end cell lies outside the grid is not drawn"
      (RULE &drawn
        (&placed_end *S *P)
        (input P)))))

(RULE &cross_ray_end
  (&cross_ray_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cross_ray_ray Key (:P Q) D Origin)))

(RULE &cross_ray_full_end
  (&cross_ray_full_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cross_ray_full_ray Key (:P Q) D Origin)))

(RULE &covered
  (&stamp_paint *P))

(RULE &live)

(RULE &ray_paint
  (&cross_ray_full_ray *P *K)
  (&cross_ray_cell P)
  (!= K 0))

(RULE &output
  (OR ((&live)
       (&ray_paint *P)
       (&cross_color (:C *Col)))
      ((&live)
       (&covered P)
       (NOT (&ray_paint P))
       (&stamp_paint P Col))
      ((&live)
       (input P Col)
       (NOT (&ray_paint P))
       (NOT (&covered P)))))
