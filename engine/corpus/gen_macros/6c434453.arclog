;; 6c434453

(DET &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &changed
  (ex_input *E *P (:Col *C1))
  (ex_output E P (:Col *C2))
  (!= C1 C2))

(INIT &comps Quotient
  (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
    (OR ((&changed *E *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&changed E (:P P3)))
        ((&changed E P)
         (= P3 P)))))

(DET &comps_component
  (&comps.class (:a *Key *P) *Id))

(INIT &frame BoundingBox
  (key ((&comps_component (:Key ^E) *P ^Id))
    (cell (P)
      (&comps_component (:Key E) *P Id))))

(DET &ring_cell_inside1
  (&frame.cell (:key *E *Id) (:P *P_))
  (&frame.box (:key E Id) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &ring_cell
  (&frame.cell (:key *E *Id) *P)
  (&frame.box (:key E Id) *B)
  (NOT (&ring_cell_inside1 (:P_ P) (:B_ B)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; Every ring reads the same source and the same replacement.
(INIT &src_read Singleton
  (key ((&ring_cell *E *P ^P_inner)
        (ex_input E P *Col))
    (member ((:v Col))
      (&ring_cell *E *P P_inner)
      (ex_input E P *Col))))

(DET &src
  (&src_read.value (:key (:P_inner *P)) (:v *Col)))

(INIT &occ Occurrences
  (cell (P (:v Col))
    (input *P *Col))
  (shape (P (:v Col))
    (&src *P *Col)))

(INIT &dst_read Singleton
  (key ((&ring_cell *E *P ^P_inner)
        (ex_output E P *Col))
    (member ((:v Col))
      (&ring_cell *E *P P_inner)
      (ex_output E P *Col))))

(DET &dst
  (&dst_read.value (:key (:P_inner *P)) (:v *Col)))

(RULE &stamped
  (&occ.occurrence (:P *M))
  (&dst (:P *S) *Col)
  (compose (:A M) (:B S) (:C *P)))

(ALTS $choice "how the ring and its replacement are found" $Stamp
  (ALT $Flank
    (DET &bg DominantColor)

    (DET &ink RarestColor)

    (DET &fill AnyOutNewColor)

    (RULE &bg_at
      (input *P *Col)
      (&bg (:C Col)))

    (RULE &ink_at
      (input *P *Col)
      (&ink (:C Col)))

    (RULE &hole
      (&bg_at *P)
      (ALL ((dir_elem *D)
            (step_offset D (:V *V_m1))
            (compose (:A P) (:B V_m1) (:C *Q)))
           ((&ink_at (:P Q)))))

    (RULE &replaced
      (&hole (:P *P2))
      (OR ((dir_elem *D)
           (step_offset D (:V *V_m1))
           (compose (:A P2) (:B V_m1) (:C *P))
           (&fill (:C *Col)))
          ((= P P2)
           (&fill (:C Col)))
          ((diag_dir_elem D)
           (step_offset D (:V *V_m2))
           (compose (:A P2) (:B V_m2) (:C P))
           (&bg (:C Col)))))

    (RULE &output
      (OR ((&replaced *P *Col))
          ((input P Col)
           (NOT (&replaced P)))))))

(RULE &output
  (OR ((&stamped *P *Col))
      ((input P Col)
       (NOT (&stamped P)))))
