;; 9c1e755f

(INPUT rail "each connected run of the rail color is a rail, a straight bar")

(INPUT swatch "each connected group of cells of the other colors, neither background nor rail, is a swatch: a block that hangs off one side of a rail at one end of the rail")

(INPUT fit "the rail's length is a multiple of the swatch's length along it")

(OUTPUT keep "every input cell keeps its color")

(OUTPUT repeat "the swatch repeats along its rail: copies of the swatch, moved along the rail by multiples of the swatch's own length, paint the field the rail spans along its axis and the swatch spans across it"

  (RULE &rails_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET &rail SharedColor)

  (INIT &rails Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (&rail (:C Col))
           (&rails_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (&rail (:C Col2)))
          ((input P (:Col *Col3))
           (&rail (:C Col3))
           (= P3 P)))))

  (RULE &rails_component
    (&rails.class (:a *P) *Id))

  (RULE &swatches_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (DET_OR_RULE &bg DominantColor)

  (INIT &swatches Quotient
    (edge ((:a P) (:b P3))
      (OR ((input *P *Col)
           (NOT (&bg (:C Col)))
           (NOT (&rail (:C Col)))
           (&swatches_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (input (:P P3) (:Col *Col2))
           (NOT (&bg (:C Col2)))
           (NOT (&rail (:C Col2))))
          ((input P (:Col *Col3))
           (NOT (&bg (:C Col3)))
           (NOT (&rail (:C Col3)))
           (= P3 P)))))

  (RULE &swatches_component
    (&swatches.class (:a *P) *Id))

  (RULE &rail2
    (&rails_component *P (:Id *X)))

  (RULE &swatch
    (&swatches_component *P (:Id *Y))
    (input P *Col))

  (RULE &hangs
    (&rail2 *X *P)
    (dir_elem *D)
    (step_offset D (:V *V_m1))
    (compose (:A P) (:B V_m1) (:C *Q))
    (&swatch *Y (:P Q)))

  (RULE &rail_axis
    (&hangs *Y *D)
    (axis_of D (:A *A_across))
    (perp (:A A_across) (:A2 *A)))

  (INIT &rail_box BoundingBox
    (key ((&rail2 ^X *P))
      (cell (P)
        (&rail2 X *P))))

  (RULE &field_split1
    (&rail_box.box (:key *X) (:B *B_rail_))
    (&rail_axis *Y (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_rail_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_rail_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *B_along_))
    (relative (:Base B_along_) (:X B_rail_) (:X_rel *X_m1_)))

  (INIT &swatch_box BoundingBox
    (key ((&swatch ^Y *P))
      (cell (P)
        (&swatch Y *P))))

  (RULE &field_split2
    (&swatch_box.box (:key *Y) (:B *B_swatch_))
    (&rail_axis Y (:A *A_))
    (axis_of (:D *D_m1) (:A A_))
    (opposite (:D D_m1) (:Opp *O_m2))
    (margin (:B B_swatch_) (:D D_m1) (:K *K1_m3))
    (margin (:B B_swatch_) (:D O_m2) (:K *K2_m4))
    (opposite (:D D_m1) (:Opp *O_m1))
    (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
    (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
    (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
    (relative (:Base X_m2_) (:X B_swatch_) (:X_rel *B_across_)))

  (RULE &field
    (&hangs *Y *X)
    (&rail_axis Y *A)
    (&rail_box.box (:key X) (:B *B_rail))
    (&field_split1 (:B_rail_ B_rail) (:A_ A) (:B_along_ *B_along) (:X_m1_ *X_m1))
    (&swatch_box.box (:key Y) (:B *B_swatch))
    (&field_split2 (:B_swatch_ B_swatch) (:A_ A) (:X_m2_ *X_m2) (:B_across_ *B_across))
    (compose (:A B_along) (:B B_across) (:C *B))))

(ALTS $choice "where the copies are anchored" $Swatch
  (ALT $FarEnd
    (OUTPUT repeat "the swatch slides flush to the rail's far end, and copies of it there, moved back along the rail by multiples of its own length, paint the field"
      (RULE &far_end
        (&field *Y *B)
        (&swatch_box.box (:key Y) (:B *B_swatch))
        (relative (:Base B) (:X B_swatch) (:X_rel *B_rel))
        (dir_elem *D)
        (margin (:B B_rel) D *K)
        (> K 0)))
    ;; The swatch slid flush to the far end.
    (RULE &first_copy
      (&swatch *Y (:P *P2) *Col)
      (&far_end Y *D *K)
      (dir8_opposite D (:D2 *O_m2))
      (edge_inset (:D O_m2) K (:B *B1_m3))
      (edge_inset D K (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A P2) (:B V_m1) (:C *P)))))

(RULE &first_copy
  (&swatch *Y *P *Col))

(RULE &copy
  (&first_copy *Y (:P *P2) *Col)
  (&rail_axis Y *A)
  (axis_of *D A)
  (&swatch_box.box (:key Y) *B)
  (axis_elem A)
  (relative (:Base B) (:X P2) (:X_rel *R_m1))
  (frame_extent (:P R_m1) A *N)
  (&field Y (:B *B_field))
  (input *P)
  (ALL ((&field (:Y *Ym) (:B B_field))
        (dir_elem (:D *D_m1))
        (relative (:Base B_field) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (perp A (:A2 *A2_m2))
  (axis_of (:D *D_m3) (:A A2_m2))
  (margin (:B P2) (:D D_m3) (:K *K_m4))
  (margin (:B P) (:D D_m3) (:K K_m4))
  (margin (:B P2) D (:K *T_p))
  (divide (:T T_p) (:Side N) (:Gap 0) (:Remainder *R))
  (margin (:B P) D (:K *T_q))
  (divide (:T T_q) (:Side N) (:Gap 0) (:Remainder R)))

(RULE &output
  (OR ((&copy *P *Col))
      ((input P Col)
       (NOT (&copy P)))))
