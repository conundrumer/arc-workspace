;; d406998b

(DET &anchor DirDomain)

(DET &dot RarestColor)

(DET &mark AnyOutNewColor)

(DET &mark_run DivisorRatio)

(DET &keep_run DivisorRatio)

(RULE &dot_dist
  (input *P (:Col *Dot))
  (&dot (:C Dot))
  (&anchor *D)
  (margin (:B P) D *K))

(RULE &stripe_marked
  (&dot_dist *P (:K *T))
  (&mark_run *K)
  (&keep_run (:K *G))
  (divide T (:Side K) (:Gap G)))

(ALTS $choice "two models of what alternates, tagged on out's Choice" $Stripes
  (ALT $Sequence
    (INIT &o Order
      (member ((:t K))
        (&dot_dist *K))
      (score ((:t K) (:S K))
        (&dot_dist *K)))

    (RULE &seq_marked
      (&dot_dist *P *K)
      (&o.rank (:t K) *R)
      (&mark_run (:K *Kr))
      (&keep_run (:K *G))
      (divide (:T R) (:Side Kr) (:Gap G)))

    (RULE &output
      (OR ((&seq_marked *P)
           (&mark (:C *Col)))
          ((input P Col)
           (NOT (&seq_marked P)))))))

(RULE &output
  (OR ((&stripe_marked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&stripe_marked P)))))
