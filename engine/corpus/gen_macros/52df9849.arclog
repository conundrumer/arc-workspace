;; 52df9849

(DET &bg DominantColor)

(RULE &obj
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &reaches
  (OR ((&obj (:P *Q) *Col)
       (input *P)
       (dir8_elem *D)
       (dir_elem D)
       (margin (:B P) D (:K *K1_m1))
       (margin (:B Q) D (:K *K2_m2))
       (>= K1_m1 K2_m2))
      ((&obj (:P *Q2) Col)
       (input P)
       (dir8_elem D)
       (diag_dir_elem D)
       (corner_dist P (:Diag D) (:K *K1_m12))
       (corner_dist (:P Q2) (:Diag D) (:K *K2_m22))
       (>= K1_m12 K2_m22))))

(RULE &sweep
  (OR ((axis4_of *D *A)
       (dir8_opposite D *D2)
       (&reaches *Col D *P)
       (&reaches Col (:D D2) P)
       (&obj (:P *Q) Col)
       (perp A (:A2 *A2_m1))
       (axis_of (:D *D_m2) (:A A2_m1))
       (margin (:B P) (:D D_m2) (:K *K_m3))
       (margin (:B Q) (:D D_m2) (:K K_m3)))
      ((axis4_of (:D *D3) A)
       (dir8_opposite (:D D3) (:D2 *D22))
       (&reaches Col (:D D3) P)
       (&reaches Col (:D D22) P)
       (&obj (:P *Q2) Col)
       (diag_perp (:Da A) (:Da2 *A2_m12))
       (diag_axis_of (:D *D_m22) (:Da A2_m12))
       (corner_dist P (:Diag D_m22) (:K *K_m32))
       (corner_dist (:P Q2) (:Diag D_m22) (:K K_m32)))))

(RULE &unsupported
  (&sweep *Col *A *P)
  (input P (:Col *Bg))
  (&bg (:C Bg)))

(RULE &hidden
  (&sweep *Col *A *P)
  (NOT (&unsupported Col A))
  (NOT (input P Col)))

(RULE &output
  (OR ((&hidden *P *Col))
      ((input P Col)
       (NOT (&hidden P)))))
