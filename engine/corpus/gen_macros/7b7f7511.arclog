;; 7b7f7511

(DET &copies TileCount)

(RULE &dup_cell_division_cell
  (input *P)
  (axis_elem (:A *Key)))

(INIT &dup_cell_division_sides ExtentDivisions
  (key ((&dup_cell_division_cell (:Key ^Ky) *P))
    (frame (P)
      (&dup_cell_division_cell (:Key Ky) *P))))

(RULE &dup_cell_division_axis_split1
  (&dup_cell_division_cell (:Key *Ky) (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
  (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

(RULE &dup_cell_division_parts_held
  (axis_elem *A)
  (&copies *N))

(RULE &dup_cell_division_axis
  (OR ((&dup_cell_division_cell *Key *P)
       (axis_elem *A)
       (OR ((!= A Key))
           ((NOT (&dup_cell_division_parts_held (:A Key)))))
       (&dup_cell_division_axis_split1 (:P_ P) (:A_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
       (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
      ((&dup_cell_division_cell Key P)
       (axis_elem (:A Key))
       (&copies *N)
       (&dup_cell_division_sides.division (:key (:Ky Key)) (:A Key) N *K (:G 0))
       (axis_of *D (:A Key))
       (opposite D (:Opp *O))
       (margin (:B P) D (:K *T))
       (margin (:B P) (:D O) (:K *T2))
       (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
       (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
       (opposite D (:Opp *O_m1))
       (edge_inset D (:K I) (:B *B1_m2))
       (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
       (opposite D (:Opp *O_m4))
       (edge_inset D (:K R) (:B *B1_m5))
       (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
       (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K))
       (= A Key))
      ((&dup_cell_division_cell Key P)
       (axis_elem (:A Key))
       (&copies (:N *N2))
       (frame_extent P (:A Key) (:N *K2))
       (axis_of (:D *D2) (:A Key))
       (opposite (:D D2) (:Opp *O2))
       (margin (:B P) (:D D2) (:K *T3))
       (margin (:B P) (:D O2) (:K *T22))
       (divide (:T T3) (:Side K2) (:Gap 0) (:Part *I3) (:Remainder *R3))
       (divide (:T T22) (:Side K2) (:Gap 0) (:Part *I22) (:Remainder *R22))
       (opposite (:D D2) (:Opp *O_m12))
       (edge_inset (:D D2) (:K I3) (:B *B1_m22))
       (edge_inset (:D O_m12) (:K I22) (:B *B2_m32))
       (compose (:A B1_m22) (:B B2_m32) (:C P_outer))
       (opposite (:D D2) (:Opp *O_m42))
       (edge_inset (:D D2) (:K R3) (:B *B1_m52))
       (edge_inset (:D O_m42) (:K R22) (:B *B2_m62))
       (compose (:A B1_m52) (:B B2_m62) (:C P_inner))
       (frame_extent (:P P_inner) (:A Key) (:N K2))
       (frame_extent (:P P_outer) (:A Key) (:N N2))
       (= A Key))))

(RULE &dup_cell_division_tile
  (&dup_cell_division_axis *Key *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
  (perp (:A A1) *A2)
  (&dup_cell_division_axis Key P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
  (compose (:A Po1) (:B Po2) (:C *P_outer))
  (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

;; The grid as &copies slabs along A: what each within-slab cell holds.
(INIT &dup_cell Singleton
  (key ((input *P *Col)
        (&dup_cell_division_tile (:Key ^A) P ^P_inner))
    (member ((:v Col))
      (input *P *Col)
      (&dup_cell_division_tile (:Key A) P P_inner))))

(RULE &dup_mismatch
  (&dup_cell.plural (:key *A)))

(ALTS $choice "how the repeat count is fixed" $Dup
  (ALT $Tile
    (RULE &tile_cell_division_axis_split1
      (input (:P *P_))
      (axis_elem (:A *A2_))
      (axis_of (:D *D_m1) (:A A2_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *Pi_))
      (relative (:Base Pi_) (:X P_) (:X_rel *X_m1_)))

    (RULE &tile_cell_division_side_held
      (input *P)
      (sub_extent P *A *K))

    (RULE &tile_cell_division_axis
      (OR ((input *P)
           (sub_extent P (:A *Key_a) *K)
           (axis_elem *A)
           (OR ((!= A Key_a))
               ((NOT (&tile_cell_division_side_held (:A Key_a) K))))
           (&tile_cell_division_axis_split1 (:P_ P) (:A2_ A) (:Pi_ *P_inner) (:X_m1_ *X_m1))
           (relative (:Base P_inner) (:X P_inner) (:X_rel *P_outer)))
          ((input P)
           (sub_extent P (:A Key_a) K)
           (input (:P *P2))
           (sub_extent (:P P2) (:A Key_a) K)
           (axis_of *D (:A Key_a))
           (opposite D (:Opp *O))
           (margin (:B P) D (:K *T))
           (margin (:B P) (:D O) (:K *T2))
           (divide T (:Side K) (:Gap 0) (:Part *I) (:Remainder *R))
           (divide (:T T2) (:Side K) (:Gap 0) (:Part *I2) (:Remainder *R2))
           (opposite D (:Opp *O_m1))
           (edge_inset D (:K I) (:B *B1_m2))
           (edge_inset (:D O_m1) (:K I2) (:B *B2_m3))
           (compose (:A B1_m2) (:B B2_m3) (:C P_outer))
           (opposite D (:Opp *O_m4))
           (edge_inset D (:K R) (:B *B1_m5))
           (edge_inset (:D O_m4) (:K R2) (:B *B2_m6))
           (compose (:A B1_m5) (:B B2_m6) (:C P_inner))
           (frame_extent (:P P_inner) (:A Key_a) (:N K))
           (= A Key_a))))

    (RULE &tile_cell_division_tile
      (&tile_cell_division_axis (:Key_a *A) *K *P (:A *A1) (:P_outer *Po1) (:P_inner *Pi1))
      (perp (:A A1) *A2)
      (&tile_cell_division_axis (:Key_a A) K P (:A A2) (:P_outer *Po2) (:P_inner *Pi2))
      (compose (:A Po1) (:B Po2) (:C *P_outer))
      (compose (:A Pi1) (:B Pi2) (:C *P_inner)))

    ;; The grid as K-sized slabs along A, for every proper K: what each
    ;; within-slab cell holds.
    (INIT &tile_cell Singleton
      (key ((input *P *Col)
            (&tile_cell_division_tile ^A ^K P ^P_inner))
        (member ((:v Col))
          (input *P *Col)
          (&tile_cell_division_tile A K P P_inner))))

    (RULE &tile_mismatch
      (&tile_cell.plural (:key *A *K)))

    (RULE &output
      (&tile_cell.value (:key *A *K (:P_inner *P)) (:v *Col))
      (NOT (&tile_mismatch A K)))))

(RULE &output
  (&dup_cell.value (:key *A (:P_inner *P)) (:v *Col))
  (NOT (&dup_mismatch A)))
