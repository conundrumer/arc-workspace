;; 11e1fe23

(RULE &dray_dir
  (diag_dir_elem *D))

(RULE &dray_node
  (input *P))

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &dray_source
  (&mark *P))

(INIT &dray Distance
  (key ((&dray_source (:P ^O))
        (&dray_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&dray_source (:P O))
           (&dray_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&dray_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&dray_node (:P Q)))
          ((&dray_source (:P O))
           (&dray_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&dray_node (:P Q))
           (= A2 O))
          ((&dray_source (:P O))
           (&dray_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&dray_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&dray_node (:P Q)))))
    (source ((:n O))
      (&dray_source (:P O))
      (&dray_dir D))))

(RULE &dray_ray
  (&dray.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &dray_end
  (&dray_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&dray_ray (:P Q) D Origin)))

(DET &center_paint AnyOutNewColor)

;; The marks' bounding box, read by $Shrink and $Converge alike.
(INIT &bbox BoundingBox
  (cell (P)
    (&mark *P)))

(RULE &view
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &center
  (&view *P *P_inner)
  (ALL ((&view (:P *Pm) P_inner)
        (opposite (:D *D_m1) (:Opp *O_m2))
        (margin (:B P_inner) (:D D_m1) (:K *K1_m3))
        (margin (:B P_inner) (:D O_m2) (:K *K2_m4)))
       ((= K1_m3 K2_m4))))

(RULE &mini
  (&center (:P *C))
  (OR ((&mark (:P *P_mark) *Col)
       (&bbox.box *B)
       (relative (:Base B) (:X P_mark) (:X_rel *R_m1))
       (axis_of (:D *D1_m2) (:A *A1_m3))
       (opposite (:D D1_m2) (:Opp *O1_m4))
       (perp (:A A1_m3) (:A2 *A2_m5))
       (axis_of (:D *D2_m6) (:A A2_m5))
       (opposite (:D D2_m6) (:Opp *O2_m7))
       (margin (:B R_m1) (:D D1_m2) (:K *K1_m8))
       (>= K1_m8 0)
       (margin (:B R_m1) (:D O1_m4) (:K *K2_m9))
       (>= K2_m9 0)
       (margin (:B R_m1) (:D D2_m6) (:K *K3_m10))
       (>= K3_m10 0)
       (margin (:B R_m1) (:D O2_m7) (:K *K4_m11))
       (>= K4_m11 0)
       (corner_dir (:C *Diag) (:A *A_m12) (:D *D1_m13))
       (perp (:A A_m12) (:A2 *A2_m14))
       (corner_dir (:C Diag) (:A A2_m14) (:D *D2_m15))
       (margin (:B P_mark) (:D D1_m13) (:K *K1_m16))
       (margin B (:D D1_m13) (:K K1_m16))
       (margin (:B P_mark) (:D D2_m15) (:K *K2_m17))
       (margin B (:D D2_m15) (:K K2_m17))
       (step_offset (:D Diag) (:V *V_m18))
       (compose (:A C) (:B V_m18) (:C *P)))
      ((&center_paint (:C Col))
       (= P C))))

(ALTS $choice "how a mark finds its step" $Shrink
  (ALT $Converge
    (RULE &place_nearer
      (&view (:P_inner *P))
      (dir_elem *D)
      (opposite D (:Opp *O_m1))
      (margin (:B P) D *K)
      (margin (:B P) (:D O_m1) (:K *K2))
      (< K K2))

    (RULE &place_quadrant
      (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
      (perp (:A A_m1) (:A2 *A2_m2))
      (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
      (&place_nearer *P (:D D1))
      (&place_nearer P (:D D2)))

    (RULE &mini
      (&center (:P *C))
      (OR ((&mark (:P *P_mark) *Col)
           (&view (:P P_mark) *P_inner)
           (&place_quadrant (:P P_inner) *Diag)
           (step_offset (:D Diag) (:V *V_m1))
           (compose (:A C) (:B V_m1) (:C *P)))
          ((&center_paint (:C Col))
           (= P C)))))
  (ALT $Cross
    (RULE &sees
      (&dray_ray *P *D *K (:Origin *M))
      (!= K 0))

    (RULE &mini
      (&sees (:P *C))
      (ALL ((&mark (:P *Mm)))
           ((&sees (:M Mm) (:P C))))
      (OR ((&sees *M (:P C) *D)
           (&mark (:P M) *Col)
           (diag_opposite D (:Opp *D_back))
           (step_offset (:D D_back) (:V *V_m1))
           (compose (:A C) (:B V_m1) (:C *P)))
          ((&center_paint (:C Col))
           (= P C))))))

(RULE &output
  (OR ((&mini *P *Col))
      ((input P Col)
       (NOT (&mini P)))))
