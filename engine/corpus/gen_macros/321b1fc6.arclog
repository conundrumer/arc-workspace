;; 321b1fc6

(RULE &blocks_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &blank VanishedColor)

(INIT &blocks Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (&blank (:C Col))
         (&blocks_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (&blank (:C Col2)))
        ((input P (:Col *Col3))
         (&blank (:C Col3))
         (= P3 P)))))

(RULE &blocks_component
  (&blocks.class (:a *P) *Id))

(DET &bg DominantColor)

(RULE &template
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&blank (:C Col))))

(INIT &block_box BoundingBox
  (key ((&blocks_component *P ^Id))
    (cell (P)
      (&blocks_component *P Id))))

(INIT &tmpl_box BoundingBox
  (cell (P)
    (&template *P)))

(RULE &shift
  (&tmpl_box.box (:B *P_tmpl_box))
  (&block_box.box (:B *P_block_box))
  (relative (:Base P_tmpl_box) (:X P_block_box) (:X_rel *V)))

(RULE &image
  (&template (:P *P_tmpl) *Col)
  (&shift *V)
  (compose (:A P_tmpl) (:B V) (:C *P)))

(RULE &output
  (input *P)
  (OR ((&image P *Col))
      ((NOT (&image P))
       (&bg (:C Col)))))
