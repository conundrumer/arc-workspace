;; a6953f00

;; The grid edge whose corners the crop anchors at.
(DET &crop_side DirDomain)

(RULE &crop_corner
  (&crop_side (:D *D2))
  (corner_dir (:C *D) (:D D2)))

(DET &frame Frame)

(RULE &corner
  (&crop_corner *D)
  (ONE))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&frame *P)
  (&corner *D)
  (ALL ((input (:P P_grid_in) (:Col *Colm))
        (corner_dir (:C D) (:D *D_m1))
        (margin (:B P) (:D D_m1) (:K *K1_m2))
        (margin (:B P_grid_in) (:D D_m1) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))
