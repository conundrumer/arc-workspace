;; 992798f6

(DET &bg DominantColor)

(RULE &span_dir
  (axis4_elem *A)
  (axis4_of *D A))

(RULE &span_node
  (input *P))

;; The mark the diagonal leg leaves.
(DET &diag_mark RarestColor)

;; The mark the straight leg runs up to.
(DET &straight_mark RarestColor)

(RULE &toward
  (&straight_mark (:C *C_s))
  (input (:P *P_s) (:Col C_s))
  (&diag_mark (:C *C_d))
  (input (:P *P_d) (:Col C_d))
  (corner_dir (:C *Diag) (:A *A_m1) (:D *D1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C Diag) (:A A2_m2) (:D *D2))
  (dir_elem (:D D1))
  (margin (:B P_d) (:D D1) (:K *K1_m3))
  (margin (:B P_s) (:D D1) (:K *K2_m4))
  (< K1_m3 K2_m4)
  (dir_elem (:D D2))
  (margin (:B P_d) (:D D2) (:K *K1_m5))
  (margin (:B P_s) (:D D2) (:K *K2_m6))
  (< K1_m5 K2_m6))

(RULE &leg_dir
  (&toward *Diag)
  (diag_opposite (:D Diag) (:Opp *D)))

(RULE &leg_blocked
  (input *P)
  (&straight_mark (:C *Col))
  (input (:P *P_s) Col)
  (axis_elem *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P_s) (:D D_m2) (:K K_m3)))

(RULE &leg_node
  (input *P)
  (NOT (&leg_blocked P)))

(RULE &leg_source
  (&diag_mark (:C *Col))
  (input *P Col))

;; The diagonal leg, cast from the diag mark and halted by the straight mark's
;; own lines, so it ends on the line beside that mark.
(INIT &leg Distance
  (key ((&leg_source (:P ^O))
        (&leg_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&leg_source (:P O))
           (&leg_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&leg_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&leg_node (:P Q)))
          ((&leg_source (:P O))
           (&leg_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&leg_node (:P Q))
           (= A2 O))
          ((&leg_source (:P O))
           (&leg_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&leg_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&leg_node (:P Q)))))
    (source ((:n O))
      (&leg_source (:P O))
      (&leg_dir D))))

(RULE &leg_ray
  (&leg.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &leg_end
  (&leg_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&leg_ray (:P Q) D Origin)))

(RULE &elbow
  (&leg_end (:P *E) *D)
  (step_offset D (:V *V_m1))
  (compose (:A E) (:B V_m1) (:C *P_stop))
  (input (:P P_stop))
  (dir8_opposite D (:D2 *D_back))
  (step_offset (:D D_back) (:V *V_m2))
  (compose (:A P_stop) (:B V_m2) (:C *P)))

(RULE &tip
  (&straight_mark (:C *Col))
  (input (:P *P_s) Col)
  (&toward *Diag)
  (step_offset (:D Diag) (:V *V_m1))
  (compose (:A P_s) (:B V_m1) (:C *P)))

(RULE &span_source
  (OR ((&diag_mark (:C *Col))
       (input *P Col))
      ((&elbow P))
      ((&tip P))))

;; The path spans its three points: the diag mark to the elbow down the
;; diagonal, the elbow to the tip along the line they share. The domain is
;; background only, so the marks keep their own color.
(INIT &span Distance
  (key ((&span_source (:P ^O))
        (&span_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&span_source (:P O))
           (&span_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&span_node (:P Q)))
          ((&span_source (:P O))
           (&span_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&span_node (:P Q))
           (= A2 O))
          ((&span_source (:P O))
           (&span_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&span_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&span_node (:P Q)))))
    (source ((:n O))
      (&span_source (:P O))
      (&span_dir D))))

(RULE &span_ray
  (&span.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &span_between
  (input *P *Col)
  (&bg (:C Col))
  (axis4_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&span_ray P D)
  (&span_ray P (:D O)))

(RULE &span_end
  (&span_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&span_ray (:P Q) D Origin)))

(DET &path AnyOutNewColor)

(RULE &output
  (OR ((&span_between *P)
       (&path (:C *Col)))
      ((input P Col)
       (NOT (&span_between P)))))
