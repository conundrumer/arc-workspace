;; 12eac192

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; Touching cells of one ink color. A cell holds one color, so the color
;; keys nothing downstream: the label alone names the component.
(INIT &comps Quotient
  (edge ((:a Col P) (:b Col (:P P3)))
    (OR ((input *P *Col)
         (NOT (&bg (:C Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) Col))
        ((input P Col)
         (NOT (&bg (:C Col)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a (:Col *Key) *P) *Id))

(DET &max_size TileCount)

(DET &paint AnyOutNewColor)

(RULE &comp_cell
  (&comps_component *P (:Id *K)))

(INIT &comp_size Cardinality
  (key ((&comp_cell (:K ^Id) *P))
    (member ((:m P))
      (&comp_cell (:K Id) *P))))

(RULE &repaint
  (&comp_cell *K *P)
  (&comp_size.size (:key (:Id K)) *N)
  (&max_size (:N *Max))
  (<= N Max)
  (&paint (:C *Col)))

(ALTS $choice "what makes a component small" $Threshold
  (ALT $Lookup
    (DET &size_paint
      (&comp_cell *E (:K *Id) *P)
      (&comp_size.size E (:key Id) *N)
      (ex_input E P (:Col *C_in))
      (ex_output E P *Col)
      (!= Col C_in))

    (RULE &repaint
      (&comp_cell *K *P)
      (&comp_size.size (:key (:Id K)) *N)
      (&size_paint N *Col))))

(RULE &output
  (OR ((&repaint *P *Col))
      ((input P Col)
       (NOT (&repaint P)))))
