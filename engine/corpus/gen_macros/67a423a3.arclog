;; 67a423a3

(RULE &cell_line_split1
  (input (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *L_)))

(DET &bg DominantColor)

(DET &ring AnyOutNewColor)

(RULE &cell_line
  (input *P)
  (axis_elem *A)
  (&cell_line_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:L_ *L)))

(RULE &gapped
  (&cell_line *P *A *L)
  (input P *Col)
  (&bg (:C Col)))

(RULE &line
  (&cell_line *A *L)
  (NOT (&gapped A L)))

(ALTS $choice "what a line is" $Span
  (ALT $Color
    (INIT &color_line Singleton
      (key ((&cell_line *P ^A *L)
            (input P ^Col)
            (NOT (&bg (:C Col))))
        (member ((:v L))
          (&cell_line *P A *L)
          (input P Col)
          (NOT (&bg (:C Col))))))

    (RULE &line
      (&color_line.value (:key *A) (:v *L)))))

(RULE &crossing
  (&cell_line *P *A *L)
  (&line A L)
  (perp A *A2)
  (&cell_line P (:A A2) (:L *L2))
  (&line (:A A2) (:L L2)))

(RULE &ring2
  (&crossing (:P *C))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A C) (:B V_m1) (:C *P)))

(RULE &output
  (input *P (:Col *C_in))
  (IF ((&ring2 P))
      ((&ring (:C *Col)))
      ((= Col C_in))))
