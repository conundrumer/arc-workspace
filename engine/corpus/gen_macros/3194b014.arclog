;; 3194b014

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &comps_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

;; Noise makes runs of its own, but only small ones.
(INIT &comps Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&comps_node (:Key *Ky) *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&comps_node (:Key Ky) (:P P2)))
        ((&comps_node (:Key Ky) P)
         (= P2 P)))))

(RULE &comps_component
  (&comps.class (:a *Key *P) *Id))

(RULE &comp_cell
  (&comps_component (:Key *Col) *P *Id))

(INIT &biggest_count Cardinality
  (key ((&comp_cell (:Col ^K_col) (:Id ^K_id) *P))
    (member ((:m P))
      (&comp_cell (:Col K_col) (:Id K_id) *P))))

(DET &out_pos Frame)

(ALTS $choice "what \"biggest\" measures" $Cells
  (ALT $Span
    (INIT &bbox BoundingBox
      (key ((&comp_cell ^Col ^Id *P))
        (cell (P)
          (&comp_cell Col Id *P))))

    (INIT &biggest_count Cardinality
      (key ((&bbox.box (:key (:Col ^K_col) (:Id ^K_id)) *B)
            (input *P)
            (ALL ((&bbox.box (:key (:Col *Km_col) (:Id *Km_id)) B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0))))
        (member ((:m P))
          (&bbox.box (:key (:Col K_col) (:Id K_id)) *B)
          (input *P)
          (ALL ((&bbox.box (:key (:Col *Km_col) (:Id *Km_id)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0))))))))

(INIT &biggest Order
  (member ((:t (:Col K_col) (:Id K_id)))
    (&biggest_count.size (:key *K_col *K_id)))
  (score ((:t (:Col K_col) (:Id K_id)) (:S N))
    (&biggest_count.size (:key *K_col *K_id) *N)))

(RULE &output
  (&biggest.maximal (:t *Col))
  (&out_pos *P))
