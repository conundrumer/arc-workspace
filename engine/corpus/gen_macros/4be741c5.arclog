;; 4be741c5

(RULE &touch
  (dir_elem *D)
  (input *P *Col)
  (margin (:B P) D (:K 0)))

(RULE &band_axis
  (perp (:A *A2) (:A2 *A))
  (ALL ((input *Col)
        (axis_of *D (:A A2)))
       ((&touch Col D))))

(RULE &line_split1
  (input (:P *P_))
  (&band_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X P_) (:X_rel *X_m1_)))

(RULE &line
  (input *P)
  (&band_axis *A)
  (&line_split1 (:P_ P) (:A_ A) (:L_ *L) (:X_m1_ *X_m1)))

(RULE &band_line
  (input *P *Col)
  (&line P *L))

(ALTS $choice "which lines count as a band's own: presence of its color, or where its color is commonest. The two agree except on a band whose color is nowhere the commonest." $Present
  (ALT $Majority
    (INIT &commonest_count Cardinality
      (key ((input *P ^Col)
            (&line P ^L))
        (member ((:m P))
          (input *P Col)
          (&line P L))))

    (INIT &commonest Order
      (key ((&commonest_count.size (:key ^L *Col)))
        (member ((:t Col))
          (&commonest_count.size (:key L *Col)))
        (score ((:t Col) (:S N))
          (&commonest_count.size (:key L *Col) *N))))

    (RULE &band_line
      (&commonest.maximal (:key *L) (:t *Col)))))

;; A band's leading line, as its distance to one end of the stack.
(INIT &lead Order
  (key ((&band_line ^Col *L)
        (&band_axis *A)
        (axis_of ^D A)
        (margin (:B L) D *K))
    (member ((:t K))
      (&band_line Col *L)
      (&band_axis *A)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (&band_line Col *L)
      (&band_axis *A)
      (axis_of D A)
      (margin (:B L) D *K))))

;; The bands rank by their leading lines.
(INIT &place Order
  (key ((&lead.minimal (:key ^D) (:t *K)))
    (member ((:t K))
      (&lead.minimal (:key D) (:t *K)))
    (score ((:t K) (:S K))
      (&lead.minimal (:key D) (:t *K)))))

(RULE &output
  (&lead.minimal (:key *D *Col) (:t *K))
  (&place.rank (:key D) (:t K) *R)
  (&place.dual_rank (:key D) (:t K) (:R *R2))
  (opposite D (:Opp *O_m1))
  (edge_inset D (:K R) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K R2) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P)))
