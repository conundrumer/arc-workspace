;; 855e0971

(RULE &item_split1
  (input (:P *P_) *Col)
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

(DET &marker RarestColor)

;; The one non-marker color of each line. A line is keyed by the axis it
;; lies across and its position along that axis.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (NOT (&marker (:C Col)))
        (axis_elem ^A)
        (&item_split1 (:P_ P) (:A_ A) (:P_line_ ^P_line) (:X_m1_ *X_m1)))
    (member ((:v Col))
      (input *P *Col)
      (NOT (&marker (:C Col)))
      (axis_elem A)
      (&item_split1 (:P_ P) (:A_ A) (:P_line_ P_line) (:X_m1_ *X_m1)))))

(RULE &mixed
  (&line_color.plural (:key *A)))

(RULE &stack_axis
  (axis_elem *A)
  (NOT (&mixed A)))

(RULE &band_of_split1
  (input (:P *P_))
  (&stack_axis (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *P_line_))
  (relative (:Base P_line_) (:X P_) (:X_rel *X_m1_)))

(RULE &band_of
  (input *P)
  (&stack_axis *A)
  (&band_of_split1 (:P_ P) (:A_ A) (:P_line_ *P_line) (:X_m1_ *X_m1))
  (&line_color.value (:key A P_line) (:v *Col)))

(RULE &cast_cell
  (&band_of (:Col *Key))
  (input *P))

(RULE &cast_dir
  (&band_of (:Col *Key))
  (&stack_axis *A)
  (axis_of *D A))

(RULE &cast_dir_ray
  (&cast_dir *Key *D))

(RULE &cast_node
  (&cast_dir *Key)
  (input *P)
  (ALL ()
       ((&band_of P (:Col Key)))))

(RULE &cast_source
  (&band_of *P (:Col *Key))
  (input P (:Col *M))
  (&marker (:C M)))

;; Each marker casts along the stacking axis, keyed by its band's color;
;; cells outside that band block it.
(INIT &cast Distance
  (key ((&cast_source (:Key ^Ky) (:P ^O))
        (&cast_dir_ray (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:Key Ky) (:P O))
           (&cast_dir_ray (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:Key Ky) (:P Q)))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir_ray (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&cast_source (:Key Ky) (:P O))
           (&cast_dir_ray (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&cast_source (:Key Ky) (:P O))
      (&cast_dir_ray (:Key Ky) D))))

(RULE &cast_ray
  (&cast.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &cast_clear
  (&cast_ray *Key *P *D *K (:Origin *Src))
  (&cast_cell Key P))

(RULE &cast_end
  (&cast_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray Key (:P Q) D Origin)))

(RULE &output
  (input *P (:Col *C_in))
  (OR ((&cast_ray (:Key *Ky) P)
       (&cast_cell (:Key Ky) P)
       (&marker (:C *Col)))
      ((NOT (&cast_clear P))
       (= Col C_in))))
