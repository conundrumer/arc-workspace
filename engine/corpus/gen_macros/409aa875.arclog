;; 409aa875

(DET &bg DominantColor)

;; The color a shot leaves, and the color where more than one lands.
(DET &mark UnchangedColor)

(DET &clash AnyOutNewColor)

;; How far a shot travels.
(DET &reach NumberDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &dir8_flank
  (OR ((corner_dir (:C *D) (:D *E1)))
      ((corner_dir (:C E1) D))))

(INIT &exposed Boundary
  (cell (P)
    (&ink *P))
  (dir (D)
    (dir8_elem *D)))

(RULE &no_arm
  (&dir8_flank (:D *G) (:E1 *E))
  (&exposed.exposed *P (:D E)))

(RULE &apex2
  (&ink *P)
  (dir8_elem (:D *G))
  (NOT (&no_arm P G)))

(RULE &arrow
  (&apex2 (:P *P_apex) *G)
  (dir8_opposite (:D G) (:D2 *Aim)))

(RULE &arrow_cell
  (&apex2 (:P *P_apex) *G)
  (OR ((&dir8_flank (:D G) (:E1 *E))
       (step_offset (:D E) (:V *V_m1))
       (compose (:A P_apex) (:B V_m1) (:C *P)))
      ((= P P_apex))))

(ALTS $choice "how an arrowhead is read" $Local
  (ALT $Glyph
    (DET &comps_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (DET &ink_in
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col))))

    (INIT &comps Quotient
      (edge ((:a (:Key E) P) (:b (:Key E) (:P P3)))
        (OR ((&ink_in *E *P)
             (&comps_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&ink_in E (:P P3)))
            ((&ink_in E P)
             (= P3 P)))))

    (DET &comps_component
      (&comps.class (:a *Key *P) *Id))

    (DET &landed
      (ex_output *E *P *Col)
      (NOT (&bg (:C Col)))
      (ex_input E P (:Col *Bg))
      (&bg (:C Bg)))

    (DET &unarmed
      (&ink_in *E (:P *A))
      (dir8_elem (:D *G))
      (OR ((corner_dir (:C G) (:D *F)))
          ((corner_dir (:C F) (:D G))))
      (step_offset (:D F) (:V *V_m1))
      (compose A (:B V_m1) (:C *Q))
      (NOT (&ink_in E (:P Q))))

    (DET &launch
      (&landed *E *P)
      (dir8_opposite *D (:D2 *D_back))
      (&reach (:N *K))
      (dir8_opposite (:D D_back) (:D2 *O_m2))
      (edge_inset (:D O_m2) K (:B *B1_m3))
      (edge_inset (:D D_back) K (:B *I_m5))
      (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
      (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
      (compose (:A P) (:B V_m1) (:C *A))
      (&ink_in E (:P A))
      (NOT (&unarmed E A (:G D_back))))

    (INIT &bbox BoundingBox
      (key ((&launch ^E ^A))
        (cell (P)
          (&comps_component (:Key E) (:P A) *Id)
          (&comps_component (:Key E) *P Id))))

    (DET &mark_view_inside1
      (&bbox.cell (:key (:E *K_e) (:A *K_a)) (:P *P_))
      (&bbox.box (:key (:E K_e) (:A K_a)) (:B *B_))
      (dir_elem (:D *D_m1))
      (relative (:Base B_) (:X P_) (:X_rel *R_m2))
      (margin (:B R_m2) (:D D_m1) (:K *K_m3))
      (< K_m3 0))

    (DET &mark_view
      (&bbox.cell (:key *E *A) *P)
      (&bbox.box (:key E A) *B)
      (NOT (&mark_view_inside1 (:P_ P) (:B_ B)))
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    (INIT &same Agreement
      (key ((OR ((&mark_view (:E ^K_e) (:A ^K_a) *P_inner)
                 (&bbox.cell (:key (:E ^K2_e) (:A ^K2_a))))
                ((&bbox.cell (:key (:E K_e) (:A K_a)))
                 (&mark_view (:E K2_e) (:A K2_a) P_inner))))
        (source ((:i P_inner))
          (&mark_view (:E K_e) (:A K_a) *P_inner)
          (&bbox.cell (:key (:E K2_e) (:A K2_a))))
        (target ((:i P_inner))
          (&bbox.cell (:key (:E K_e) (:A K_a)))
          (&mark_view (:E K2_e) (:A K2_a) *P_inner))
        (correspondence ((:m D) (:i P_inner) (:j Q))
          (&mark_view (:E K_e) (:A K_a) *P_inner)
          (&bbox.cell (:key (:E K2_e) (:A K2_a)))
          (d4_elem *D)
          (apply D (:P P_inner) (:P_out *Q)))))

    (DET &same_src
      (&mark_view (:E *Key_k_e) (:A *Key_k_a) (:P_inner *P))
      (&bbox.cell (:key (:E *Key_k2_e) (:A *Key_k2_a))))

    ;; Each launching mark is one copy of its class's chart, in its own pose;
    ;; the classes are the marks that are D4 images of each other.
    (INIT &cls Quotient
      (equivalent ((:a (:E K_e) (:A K_a)) (:b (:E K2_e) (:A K2_a)))
        (&same_src (:Key_k_e *K_e) (:Key_k_a *K_a) (:Key_k2_e *K2_e) (:Key_k2_a *K2_a))
        (d4_elem *D)
        (NOT (&same.mismatch (:key K_e K_a K2_e K2_a) (:m D)))))

    (DET &aim
      (&cls.class (:a *E *A) *Id)
      (&launch E A *D))

    (DET &apex
      (&cls.class (:a *E *A) *Id)
      (&mark_view E A (:P A) (:P_inner *P)))

    (DET &shape
      (&cls.class (:a *E *A) *Id)
      (&mark_view E A (:P_inner *P)))

    ;; The arrowhead catalog: each footprint, the cell its shot leaves from,
    ;; and where that shot heads.
    (RIGID_DET &glyph
      (&shape *E *A *Id *P)
      (&apex *E *A *Id *P)
      (&aim *E *A *Id *D))

    (INIT &occ Occurrences
      (key ((OR ((&glyph.shape (:Pose ^D) ^Id (:P *S)))
                ((&glyph.shape (:Pose D) Id)
                 (&ink *P))))
        (cell (P)
          (&glyph.shape (:Pose D) Id)
          (&ink *P))
        (shape ((:P S))
          (&glyph.shape (:Pose D) Id (:P *S)))))

    (RULE &placed
      (&occ.occurrence (:key *Id *D) (:P *B))
      (&glyph.apex (:Pose D) Id (:P *P_a))
      (compose (:A B) (:B P_a) (:C *P_apex)))

    (RULE &arrow
      (&placed *Id *D *P_apex)
      (&glyph.aim (:Pose D) Id (:D *Aim)))

    (RULE &arrow_cell
      (&placed *Id *D *B *P_apex)
      (&glyph.shape (:Pose D) Id (:P *S))
      (compose (:A B) (:B S) (:C *P)))))

(RULE &shot
  (&arrow *P_apex *Aim)
  (&reach (:N *K))
  (dir8_opposite (:D Aim) (:D2 *O_m2))
  (edge_inset (:D O_m2) K (:B *B1_m3))
  (edge_inset (:D Aim) K (:B *I_m5))
  (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
  (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
  (compose (:A P_apex) (:B V_m1) (:C *P))
  (input P))

(INIT &lander Singleton
  (key ((&shot ^P (:P_apex *A)))
    (member ((:v A))
      (&shot P (:P_apex *A)))))

(RULE &paint
  (OR ((&lander.value (:key *P))
       (&mark (:C *Col)))
      ((&lander.plural (:key P))
       (&clash (:C Col)))
      ((&shot (:P *P_hit))
       (&arrow_cell (:P_apex *A) (:P P_hit))
       (&arrow_cell (:P_apex A) P)
       (&mark (:C Col)))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
