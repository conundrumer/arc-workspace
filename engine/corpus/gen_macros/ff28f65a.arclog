;; ff28f65a

(DET &out_pos Frame)

(RULE &diag_diagonal
  (&out_pos *P)
  (diag_dir_elem *D)
  (corner_dir (:C D) (:A *A_m1) (:D *D1_m2))
  (perp (:A A_m1) (:A2 *A2_m4))
  (corner_dir (:C D) (:A A2_m4) (:D *D2_m3))
  (margin (:B P) (:D D1_m2) (:K *Ring))
  (margin (:B P) (:D D2_m3) (:K Ring)))

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &block_color ChangedColor)

(RULE &on
  (input *P (:Col *C))
  (&block_color C))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((&on *P)
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&on (:P P3)))
        ((&on P)
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(DET &block_shape Frame)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(DET &lex_corner DiagDirDomain)

(DET &lex_axis AxisDomain)

(INIT &bbox BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(INIT &same Inclusion
  (pattern ((:m P))
    (&block_shape *P))
  (observed ((:observed O) (:m P_inner))
    (&bbox.cell (:key (:Id *O)) *P)
    (&bbox.box (:key (:Id O)) *B)
    (ALL ((&bbox.cell (:key (:Id *Om)) P)
          (&bbox.box (:key (:Id Om)) B)
          (dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(INIT &blocks Cardinality
  (member ((:m Id))
    (&same.equal (:observed *Id))))

(RULE &total
  (&blocks.size *N))

(INIT &lex Order
  (member ((:t P))
    (&diag_diagonal *P))
  (before ((:a P) (:b P2))
    (&diag_diagonal *P)
    (&diag_diagonal (:P *P2))
    (&lex_corner *D)
    (&lex_axis *A)
    (OR ((corner_dir (:C D) A (:D *D2))
         (dir_elem (:D D2))
         (margin (:B P) (:D D2) (:K *K1_m1))
         (margin (:B P2) (:D D2) (:K *K2_m2))
         (< K1_m1 K2_m2))
        ((corner_dir (:C D) A (:D D2))
         (perp A (:A2 *A2_m3))
         (corner_dir (:C D) (:A A2_m3) (:D *D22))
         (margin (:B P) (:D D2) (:K *K_m4))
         (margin (:B P2) (:D D2) (:K K_m4))
         (dir_elem (:D D22))
         (margin (:B P) (:D D22) (:K *K1_m5))
         (margin (:B P2) (:D D22) (:K *K2_m6))
         (< K1_m5 K2_m6)))))

(ALTS $detect "two models detect the blocks" $Object
  (ALT $Placement
    (INIT &occ Occurrences
      (cell (P)
        (&on *P))
      (shape (P)
        (&block_shape *P)))

    (INIT &placements Cardinality
      (member ((:m P))
        (&occ.occurrence *P)))

    (RULE &total
      (&placements.size *N))))

(ALTS $render "the count renders two ways" $Fill
  (ALT $Lookup
    (DET &lookup_grid
      (&blocks.size *E *N)
      (ex_output E *P *Col))

    (RULE &output
      (&total *N)
      (&lookup_grid N *P *Col))))

;; Mark along that order, as far as the count reaches.
(RULE &marked
  (&lex.rank (:t *P) (:R *K))
  (&total *N)
  (< K N))

(RULE &output
  (&out_pos *P)
  (&total)
  (IF ((&marked P))
      ((&mark (:C *Col)))
      ((&bg (:C Col)))))
