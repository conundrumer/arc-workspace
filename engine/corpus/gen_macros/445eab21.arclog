;; 445eab21

(RULE &closed_flood_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &closed_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &closed_cell
  (&ink (:Col *Key))
  (input *P (:Col *Col2))
  (!= Col2 Key))

(RULE &closed_flood_node
  (&ink (:Col *Key))
  (input *P (:Col *Col2))
  (!= Col2 Key))

(INIT &closed_flood Propagation
  (key ((OR ((&closed_cell (:Key ^Ky) *P)
             (dir_elem *D)
             (margin (:B P) D (:K 0))
             (&closed_flood_node (:Key Ky) P))
            ((&closed_flood_node (:Key Ky) P)
             (&closed_flood_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *Q))
             (&closed_flood_node (:Key Ky) (:P Q)))))
    (source ((:n P))
      (&closed_cell (:Key Ky) *P)
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (&closed_flood_node (:Key Ky) P))
    (edge ((:a P) (:b Q))
      (&closed_flood_node (:Key Ky) *P)
      (&closed_flood_steps (:Delta *S))
      (compose (:A P) (:B S) (:C *Q))
      (&closed_flood_node (:Key Ky) (:P Q)))))

(RULE &closed_node
  (&closed_cell *Key *P)
  (NOT (&closed_flood.reached (:key (:Ky Key)) (:n P))))

;; What each color closes off from the grid edge.
(INIT &closed Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&closed_node (:Key *Ky) *P)
         (&closed_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&closed_node (:Key Ky) (:P P2)))
        ((&closed_node (:Key Ky) P)
         (= P2 P)))))

(RULE &closed_component
  (&closed.class (:a *Key *P) *Id))

(DET &out_dim ConstOutDim)

(INIT &bbox BoundingBox
  (key ((&ink *P ^Col))
    (cell (P)
      (&ink *P Col))))

;; $Enclose, $Box and $Area count a cell set.
(INIT &measure Cardinality
  (key ((&closed_component (:Key ^Col) *P))
    (member ((:m P))
      (&closed_component (:Key Col) *P))))

(INIT &canvas Frame
  (extent (A N)
    (axis_elem *A)
    (&out_dim *N)))

(ALTS $choice "what \"bigger\" measures" $Enclose
  (ALT $Box
    ;; $Enclose, $Box and $Area count a cell set.
    (INIT &measure Cardinality
      (key ((&bbox.box (:key ^Col) *B)
            (input *P (:Col *Col2))
            (&bg (:C Col2))
            (ALL ((input P (:Col *Col2m))
                  (&bbox.box (:key (:Col *Colm)) B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0))))
        (member ((:m P))
          (&bbox.box *B)
          (input *P (:Col *Col2))
          (&bg (:C Col2))
          (ALL ((input P (:Col *Col2m))
                (&bbox.box (:key (:Col *Colm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))))))
  (ALT $Area
    ;; $Enclose, $Box and $Area count a cell set.
    (INIT &measure Cardinality
      (key ((&bbox.box (:key ^Col) *B)
            (input *P)
            (ALL ((&bbox.box (:key (:Col *Colm)) B)
                  (dir_elem (:D *D_m1))
                  (relative (:Base B) (:X P) (:X_rel *R_m2))
                  (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
                 ((>= K_m3 0))))
        (member ((:m P))
          (&bbox.box *B)
          (input *P)
          (ALL ((&bbox.box (:key (:Col *Colm)) B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))))))
  (ALT $Extent
    (DET &axis AxisDomain)

    (INIT &winner Order
      (member ((:t (:V Col) (:S N)))
        (OR ((&measure.size (:key *Col) *N))
            ((&axis *A)
             (&bbox.cell (:key Col) *P)
             (&bbox.box (:key Col) *B)
             (axis_elem A)
             (relative (:Base B) (:X P) (:X_rel *R_m1))
             (frame_extent (:P R_m1) A N))))
      (score ((:t (:V Col) (:S N)) (:S N))
        (OR ((&measure.size (:key *Col) *N))
            ((&axis *A)
             (&bbox.cell (:key Col) *P)
             (&bbox.box (:key Col) *B)
             (axis_elem A)
             (relative (:Base B) (:X P) (:X_rel *R_m1))
             (frame_extent (:P R_m1) A N)))))))

(INIT &winner Order
  (member ((:t (:V Col) (:S N)))
    (&measure.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&measure.size (:key *Col) *N)))

(RULE &output
  (&canvas.cell *P)
  (&winner.maximal (:t (:V *Col))))
