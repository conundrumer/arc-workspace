;; 88bcf3b4

(RULE &objs_steps
  (OR ((dir_elem *D)
       (step_offset D (:V *Delta)))
      ((diag_dir_elem (:D *D2))
       (step_offset (:D D2) (:V Delta)))))

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The background is the commonest color.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &bg
  (&bg_mode.maximal (:t *Col)))

(RULE &objs_node
  (input *P (:Col *Key))
  (NOT (&bg (:Col Key))))

(INIT &objs Quotient
  (edge ((:a (:Key Ky) P) (:b (:Key Ky) (:P P2)))
    (OR ((&objs_node (:Key *Ky) *P)
         (&objs_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P2))
         (&objs_node (:Key Ky) (:P P2)))
        ((&objs_node (:Key Ky) P)
         (= P2 P)))))

(RULE &objs_component
  (&objs.class (:a *Key *P) *Id))

(RULE &object
  (&objs_component *P *Id))

(RULE &bent_split1
  (&object *Id (:P *P_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *X_)))

(RULE &bent_split2
  (&object *Id (:P *Q_))
  (axis_elem (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Q_) (:D D_m1) (:K *K1_m3))
  (margin (:B Q_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m2_))
  (relative (:Base X_m2_) (:X Q_) (:X_rel *X2_)))

(RULE &pole
  (&object *Id *P)
  (&object Id (:P *Q))
  (!= P Q)
  (axis_elem *A)
  (ALL ((&object Id (:P *Pm))
        (&object Id (:P *Qm))
        (&bent_split1 (:P_ Pm) (:A_ A) (:X_m1_ *X_m1) (:X_ *X))
        (&bent_split2 (:Q_ Qm) (:A_ A) (:X_m2_ *X_m2) (:X2_ *X2)))
       ((= X X2))))

(RULE &elem_split1
  (&object (:Id *Obj) (:P *Q_))
  (&pole (:Id *Pole) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Q_) (:D D_m1) (:K *K1_m3))
  (margin (:B Q_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X Q_) (:X_rel *X_m1_)))

(RULE &score_split1
  (&object (:Id *Obj) (:P *Q_))
  (&pole (:Id *Pole) (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B Q_) (:D D_m1) (:K *K1_m3))
  (margin (:B Q_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *L_))
  (relative (:Base L_) (:X Q_) (:X_rel *X_m1_)))

(RULE &heading
  (&pole *Id *A)
  (axis_of (:D *D_foot) A)
  (&object Id *P)
  (margin (:B P) (:D D_foot) (:K 0))
  (opposite (:D D_foot) (:Opp *T)))

;; The tip: the pole cell farthest from its foot.
(INIT &reach Order
  (key ((&heading ^Id *T)
        (&object Id *P)
        (margin (:B P) (:D T) *K))
    (member ((:t (:V P) (:S K)))
      (&heading Id *T)
      (&object Id *P)
      (margin (:B P) (:D T) *K))
    (score ((:t (:V P) (:S K)) (:S K))
      (&heading Id *T)
      (&object Id *P)
      (margin (:B P) (:D T) *K))))

(RULE &tip
  (&reach.minimal (:key *Id) (:t (:V *P))))

(RULE &worm
  (&tip (:Id *Pole) (:P *Tip))
  (&heading (:Id Pole) *T)
  (axis_of (:D T) (:A *A_m1))
  (perp (:A A_m1) (:A2 *A2_m2))
  (axis_of (:D *S) (:A A2_m2))
  (step_offset (:D S) (:V *V_m3))
  (compose (:A Tip) (:B V_m3) (:C *Root))
  (&object (:Id *W) (:P Root)))

;; Object sizes: the worm keeps its cell count.
(INIT &size Cardinality
  (key ((&object ^Id *P))
    (member ((:m P))
      (&object Id *P))))

;; The target: the object with the cell nearest ahead of the tip, among the
;; cells beyond the tip along the heading and not across the pole's line
;; from the worm.
(INIT &nearest Order
  (key ((&worm ^W *Pole *S)
        (&tip (:Id Pole) (:P *Tip))
        (&heading (:Id Pole) *T)
        (&object (:Id *Obj) (:P *Q))
        (!= Obj W)
        (dir_elem (:D T))
        (margin (:B Q) (:D T) (:K *K1_m1))
        (margin (:B Tip) (:D T) (:K *K2_m2))
        (< K1_m1 K2_m2)
        (margin (:B Q) (:D T) *K)
        (margin (:B Q) (:D S) (:K *K_s))
        (margin (:B Tip) (:D S) (:K *K_tip))
        (<= K_s K_tip))
    (member ((:t (:V Obj) (:S K)))
      (&worm W *Pole *S)
      (&tip (:Id Pole) (:P *Tip))
      (&heading (:Id Pole) *T)
      (&object (:Id *Obj) (:P *Q))
      (!= Obj W)
      (dir_elem (:D T))
      (margin (:B Q) (:D T) (:K *K1_m1))
      (margin (:B Tip) (:D T) (:K *K2_m2))
      (< K1_m1 K2_m2)
      (margin (:B Q) (:D T) *K)
      (margin (:B Q) (:D S) (:K *K_s))
      (margin (:B Tip) (:D S) (:K *K_tip))
      (<= K_s K_tip))
    (score ((:t (:V Obj) (:S K)) (:S K))
      (&worm W *Pole *S)
      (&tip (:Id Pole) (:P *Tip))
      (&heading (:Id Pole) *T)
      (&object (:Id *Obj) (:P *Q))
      (!= Obj W)
      (dir_elem (:D T))
      (margin (:B Q) (:D T) (:K *K1_m1))
      (margin (:B Tip) (:D T) (:K *K2_m2))
      (< K1_m1 K2_m2)
      (margin (:B Q) (:D T) *K)
      (margin (:B Q) (:D S) (:K *K_s))
      (margin (:B Tip) (:D S) (:K *K_tip))
      (<= K_s K_tip))))

(INIT &silhouette Order
  (key ((OR ((&nearest.maximal (:key ^W) (:t (:V *Obj)))
             (&object (:Id Obj) (:P *Q))
             (&worm W *Pole *S)
             (&pole (:Id Pole) *A)
             (&elem_split1 (:Q_ Q) (:A_ A) (:L_ ^L) (:X_m1_ *X_m1))
             (margin (:B Q) (:D S) *K))
            ((&nearest.maximal (:key W) (:t (:V Obj)))
             (&object (:Id Obj) (:P Q))
             (&worm W Pole S)
             (&pole (:Id Pole) A)
             (&score_split1 (:Q_ Q) (:A_ A) (:L_ L) (:X_m1_ X_m1))
             (margin (:B Q) (:D S) K))))
    (member ((:t (:V Q) (:S K)))
      (&nearest.maximal (:key W) (:t (:V *Obj)))
      (&object (:Id Obj) (:P *Q))
      (&worm W *Pole *S)
      (&pole (:Id Pole) *A)
      (&elem_split1 (:Q_ Q) (:A_ A) (:L_ L) (:X_m1_ *X_m1))
      (margin (:B Q) (:D S) *K))
    (score ((:t (:V Q) (:S K)) (:S K))
      (&nearest.maximal (:key W) (:t (:V *Obj)))
      (&object (:Id Obj) (:P *Q))
      (&worm W *Pole *S)
      (&pole (:Id Pole) *A)
      (&score_split1 (:Q_ Q) (:A_ A) (:L_ L) (:X_m1_ *X_m1))
      (margin (:B Q) (:D S) *K))))

(RULE &contour
  (&silhouette.minimal (:key *W) (:t (:V *Q)))
  (&worm W *S)
  (step_offset (:D S) (:V *V_m1))
  (compose (:A Q) (:B V_m1) (:C *P))
  (input P))

(RULE &next
  (&contour *W *P)
  (&worm W *Pole *S)
  (&heading (:Id Pole) *T)
  (step_offset (:D T) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *P2))
  (axis_of (:D S) (:A *A2))
  (perp (:A A2) (:A2 *A2_m2))
  (axis_of (:D *D_m3) (:A A2_m2))
  (margin (:B P2) (:D D_m3) (:K *K_m4))
  (&contour W (:P *Q))
  (margin (:B Q) (:D D_m3) (:K K_m4)))

(RULE &depart
  (&worm *W *Pole *S)
  (&heading (:Id Pole) *T)
  (opposite (:D S) (:Opp *S_back))
  (corner_dir (:C *D) (:A *A_m1) (:D T))
  (perp (:A A_m1) (:A2 *A2_m2))
  (corner_dir (:C D) (:A A2_m2) (:D S_back)))

(RULE &arrive
  (&contour *W (:P *G))
  (OR ((&next W (:P G) (:Q *S_g))
       (= *P G))
      ((NOT (&next W (:P G)))
       (= P G)
       (= S_g G))))

;; The walk: from the root, the first goal is the contour's first cell; each
;; step heads toward the goal, and once no goal is left, away.
(INIT &walk Distance
  (key ((OR ((&worm ^W *Root)
             (&contour W (:P *G))
             (NOT (&next W (:Q G)))
             (OR ((= Root G)
                  (&arrive W G (:P *S_p) *S_g))
                 ((!= Root G)
                  (= S_p Root)
                  (= S_g G))))
            ((input *P)
             (&contour W (:P G))
             (!= P G)
             (dir_elem (:D *D2))
             (dir_elem (:D D2))
             (margin (:B G) (:D D2) (:K *K1_m1))
             (margin (:B P) (:D D2) (:K *K2_m2))
             (< K1_m1 K2_m2)
             (OR ((dir_elem (:D *D22))
                  (dir_elem (:D D22))
                  (margin (:B G) (:D D22) (:K *K1_m6))
                  (margin (:B P) (:D D22) (:K *K2_m7))
                  (< K1_m6 K2_m7)
                  (corner_dir (:C *D) (:A *A_m8) (:D D2))
                  (perp (:A A_m8) (:A2 *A2_m9))
                  (corner_dir (:C D) (:A A2_m9) (:D D22)))
                 ((axis_of (:D D2) *A)
                  (perp A (:A2 *A2_m3))
                  (axis_of (:D *D_m4) (:A A2_m3))
                  (margin (:B P) (:D D_m4) (:K *K_m5))
                  (margin (:B G) (:D D_m4) (:K K_m5))
                  (= D D2)))
             (step_offset D (:V *V_m10))
             (compose (:A P) (:B V_m10) (:C *Q))
             (OR ((= Q G)
                  (&arrive W G (:P S_p) S_g))
                 ((!= Q G)
                  (= S_p Q)
                  (= S_g G))))
            ((input (:P *P3))
             (&depart W (:D *D4))
             (step_offset (:D D4) (:V *V_m1))
             (compose (:A P3) (:B V_m1) (:C *Q2))
             (input (:P Q2)))))
    (edge ((:a P G) (:b (:P S_p) (:G S_g)))
      (OR ((input *P)
           (&contour W (:P *G))
           (!= P G)
           (dir_elem (:D *D2))
           (dir_elem (:D D2))
           (margin (:B G) (:D D2) (:K *K1_m1))
           (margin (:B P) (:D D2) (:K *K2_m2))
           (< K1_m1 K2_m2)
           (OR ((dir_elem (:D *D22))
                (dir_elem (:D D22))
                (margin (:B G) (:D D22) (:K *K1_m6))
                (margin (:B P) (:D D22) (:K *K2_m7))
                (< K1_m6 K2_m7)
                (corner_dir (:C *D) (:A *A_m8) (:D D2))
                (perp (:A A_m8) (:A2 *A2_m9))
                (corner_dir (:C D) (:A A2_m9) (:D D22)))
               ((axis_of (:D D2) *A)
                (perp A (:A2 *A2_m3))
                (axis_of (:D *D_m4) (:A A2_m3))
                (margin (:B P) (:D D_m4) (:K *K_m5))
                (margin (:B G) (:D D_m4) (:K K_m5))
                (= D D2)))
           (step_offset D (:V *V_m10))
           (compose (:A P) (:B V_m10) (:C *Q))
           (OR ((= Q G)
                (&arrive W G (:P *S_p) *S_g))
               ((!= Q G)
                (= S_p Q)
                (= S_g G))))
          ((input P)
           (&depart W (:D *D3))
           (step_offset (:D D3) (:V *V_m1))
           (compose (:A P) (:B V_m1) (:C S_p))
           (input (:P S_p))
           (= G P)
           (= S_g S_p))))
    (source ((:n (:P S_p) (:G S_g)))
      (&worm W *Root)
      (&contour W (:P *G))
      (NOT (&next W (:Q G)))
      (OR ((= Root G)
           (&arrive W G (:P *S_p) *S_g))
          ((!= Root G)
           (= S_p Root)
           (= S_g G))))))

(RULE &body
  (&walk.distance (:key *W) (:n *P) (:K *R))
  (&size.size (:key (:Id W)) *N)
  (< R N))

(RULE &worm_cell
  (&worm *W)
  (&object (:Id W) *P))

(RULE &output
  (OR ((&body *W *P)
       (&objs_component (:Key *Col) (:Id W)))
      ((input P (:Col *Col_in))
       (NOT (&body P))
       (IF ((&worm_cell P))
           ((&bg Col))
           ((= Col Col_in))))))
