;; 2685904e

;; Edge the separator and the pattern line are measured from; the canvas and the bar lie the other way.
(DET &base_dir DirDomain)

(RULE &canvas_dir
  (&base_dir (:D *B))
  (opposite (:D B) (:Opp *D)))

(RULE &cast_dir
  (&canvas_dir *D))

(RULE &cast_node
  (input *P))

(DET &sep_dist SepTileCount)

(RULE &sep_cell
  (input *P)
  (&base_dir *D)
  (&sep_dist (:N *K))
  (margin (:B P) D K))

(RULE &cast_source
  (&sep_cell *P))

(INIT &cast Distance
  (key ((&cast_source (:P ^O))
        (&cast_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&cast_source (:P O))
           (&cast_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&cast_node (:P Q)))
          ((&cast_source (:P O))
           (&cast_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&cast_node (:P Q))
           (= A2 O))
          ((&cast_source (:P O))
           (&cast_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&cast_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&cast_node (:P Q)))))
    (source ((:n O))
      (&cast_source (:P O))
      (&cast_dir D))))

(RULE &cast_ray
  (&cast.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &cast_end
  (&cast_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&cast_ray (:P Q) D Origin)))

(DET &pattern_dist DivisorRatio)

(DET &bg DominantColor)

(RULE &bar_cell
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&canvas_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &pattern_cell
  (input *P *Col)
  (&base_dir *D)
  (&pattern_dist *K)
  (margin (:B P) D K))

(INIT &length Cardinality
  (member ((:m P))
    (&bar_cell *P)))

(INIT &freq Cardinality
  (key ((&pattern_cell *P ^Col))
    (member ((:m P))
      (&pattern_cell *P Col))))

(RULE &band_cell
  (&length.size *N)
  (&cast_ray *P *K)
  (!= K 0)
  (<= K N))

(RULE &paint
  (&band_cell *P)
  (&length.size *N)
  (&freq.size (:key *Col) N)
  (&pattern_cell (:P *P_pat) Col)
  (&base_dir *D)
  (axis_of D *A)
  (perp A (:A2 *A2_m1))
  (axis_of (:D *D_m2) (:A A2_m1))
  (margin (:B P) (:D D_m2) (:K *K_m3))
  (margin (:B P_pat) (:D D_m2) (:K K_m3)))

(ALTS $choice "what an unselected band cell holds" $Passthrough
  (ALT $Repaint
    (RULE &output
      (OR ((&paint *P *Col))
          ((&band_cell P)
           (NOT (&paint P))
           (&bg (:C Col)))
          ((input P Col)
           (NOT (&band_cell P)))))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))
