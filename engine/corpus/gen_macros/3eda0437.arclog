;; 3eda0437

(DET &bg SharedColor)

(DET &paint AnyOutNewColor)

(RULE &hole
  (input *P *Col)
  (&bg (:C Col)))

(INIT &span BoundingBox
  (key ((&hole ^P)
        (&hole (:P ^Q)))))

(RULE &box
  (&span.box *B))

(RULE &box_ink
  (&box *B)
  (input *P)
  (NOT (&hole P))
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &hole_box
  (&box *B)
  (NOT (&box_ink B)))

(RULE &hole_cell
  (&hole_box *B)
  (&hole *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &region
  (&hole_cell *B *P)
  (diag_dir_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&hole_cell B (:P Q)))

(INIT &size Cardinality
  (key ((&region ^B))
    (member ((:m P))
      (&hole_cell B *P))))

(RULE &score
  (&size.size (:key *B) *N))

(ALTS $choice "the score that ranks hole boxes" $Area
  (ALT $Block
    ;; The block's side.
    (DET &block TileCount)

    (RULE &square
      (&block (:N *K))
      (&hole_box *B)
      (&span.box (:key *P) B)
      (perp *A *A2)
      (axis_elem A)
      (relative (:Base B) (:X P) (:X_rel *R_m1))
      (frame_extent (:P R_m1) A (:N K))
      (axis_elem (:A A2))
      (relative (:Base B) (:X P) (:X_rel *R_m2))
      (frame_extent (:P R_m2) (:A A2) (:N K)))

    ;; How many such squares a box holds.
    (INIT &seat Cardinality
      (key ((&hole_box ^B))
        (member ((:m B_sq))
          (&square (:B *B_sq))
          (ALL ((dir_elem (:D *D_m1))
                (relative (:Base B) (:X B_sq) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0))))))

    (RULE &score
      (&seat.size (:key *B) *N))))

(INIT &best Order
  (member ((:t (:V B) (:S N)))
    (&score *B *N))
  (score ((:t (:V B) (:S N)) (:S N))
    (&score *B *N)))

(RULE &filled
  (&best.maximal (:t (:V *B)))
  (&hole_cell B *P))

(RULE &output
  (OR ((&filled *P)
       (&paint (:C *Col)))
      ((input P Col)
       (NOT (&filled P)))))
