;; 1e0a9b12

(DET &grav DirDomain)

(DET &bg DominantColor)

;; Each ink cell travels toward the gravity edge and stops against the ink
;; already packed ahead of it.
(INIT &pack Distance
  (weight ((:a P2) (:b P) (:W K))
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (&grav *D)
    (input (:P *P2) (:Col *Col2))
    (NOT (&bg (:C Col2)))
    (!= P P2)
    (gap D P (:Q P2) *K))
  (source_distance ((:n P) K)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (&grav *D)
    (margin (:B P) D *K)))

(RULE &fallen
  (input (:P *P2) *Col)
  (&pack.distance (:n P2) *K)
  (&grav *D)
  (dir8_opposite D (:D2 *O_m1))
  (edge_inset (:D O_m1) K (:B *B1_m2))
  (edge_inset D K (:B *I_m4))
  (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (OR ((&fallen *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&fallen P)))))
