;; 896d5239

(RULE &sight_dir
  (diag_dir_elem *D))

(RULE &sight_node
  (input *P))

(DET &mark RarestColor)

(RULE &mark2
  (input *P *Col)
  (&mark (:C Col)))

(RULE &sight_source
  (&mark2 *P))

;; Marks sight each other along the diagonals, through whatever lies between.
(INIT &sight Distance
  (key ((&sight_source (:P ^O))
        (&sight_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&sight_source (:P O))
           (&sight_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&sight_node (:P Q)))
          ((&sight_source (:P O))
           (&sight_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&sight_node (:P Q))
           (= A2 O))
          ((&sight_source (:P O))
           (&sight_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&sight_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&sight_node (:P Q)))))
    (source ((:n O))
      (&sight_source (:P O))
      (&sight_dir D))))

(RULE &sight_ray
  (&sight.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &sight_end
  (&sight_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&sight_ray (:P Q) D Origin)))

(DET &fill AnyOutNewColor)

;; The most diagonal steps between consecutive arm marks.
(DET &reach TileCount)

(RULE &hop
  (diag_dir_elem (:D *Diag))
  (&sight_ray (:P *G) (:D Diag) *K (:Origin *G2))
  (&mark2 (:P G))
  (!= K 0)
  (&reach (:N *R))
  (<= K R))

;; The arm marks: a chain of hops from the mark, the first hop starting it.
(INIT &chain Propagation
  (key ((OR ((&hop ^Diag (:G2 ^A) *G))
            ((&mark2 (:P A))
             (&hop Diag *G2 G))))
    (source ((:n G))
      (&hop Diag (:G2 A) *G))
    (edge ((:a G2) (:b G))
      (&mark2 (:P A))
      (&hop Diag *G2 *G))))

(RULE &arm
  (&chain.reached (:key *A *Diag) (:n *G)))

(RULE &apex
  (&mark2 (:P *A))
  (dir_elem *D)
  (ALL ((corner_dir (:C *Diag) D))
       ((&arm A Diag))))

(RULE &filled
  (&apex *A *D)
  (input *P)
  (NOT (&mark2 P))
  (ALL ((corner_dir (:C *Diagm) D)
        (diag_dir_elem (:D Diagm))
        (corner_dist (:P A) (:Diag Diagm) (:K *K1_m1))
        (corner_dist P (:Diag Diagm) (:K *K2_m2)))
       ((>= K1_m1 K2_m2)))
  (corner_dir (:C *Diag) D)
  (&arm A Diag *G)
  (margin (:B P) D (:K *Kq))
  (margin (:B G) D (:K *Kg))
  (>= Kq Kg))

(RULE &output
  (OR ((&filled *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&filled P)))))
