;; a04b2602

(INPUT field "the grid is a field of &background"

  (DET &background SharedColor))

(INPUT blocks "solid rectangles of &block_color stand on the field; each rectangle is the bounding box of one 4-connected component of &block_color, and every cell in that box is &block_color or &mark_color"

  (DET &block_color SharedColor)

  (DET_OR_RULE &mark_color RarestColor)

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (INIT &ink_mode_count Cardinality
    (key ((&ink *P ^Col))
      (member ((:m P))
        (&ink *P Col))))

  (INIT &ink_mode Order
    (member ((:t Col))
      (&ink_mode_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&ink_mode_count.size (:key *Col) *N)))

  (INIT &block_ink Singleton
    (member ((:v Col))
      (&ink_mode.maximal (:t *Col))))

  (INIT &mark_ink Singleton
    (member ((:v Col))
      (&ink *Col)
      (NOT (&block_ink.value (:v Col)))))

  (RULE_OR_DET &mark_ink.value))

(OUTPUT inside-mark "a &mark_color cell is an inside mark when it lies inside a rectangle; a &mark_color cell outside every rectangle is a stray mark and triggers nothing"
  (APPROXIMATED "a &mark_color cell is an inside mark when it lies in the bounding box of a 4-connected component of &block_color")

  (RULE &block4_steps
    (dir_elem *D)
    (step_offset D (:V *Delta)))

  (RULE &roles
    (&block_color (:C *C_block))
    (&mark_color (:C *C_mark)))

  (RULE &block
    (input *P *Col)
    (&roles (:C_block Col)))

  (INIT &block4 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&block *P)
           (&block4_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&block (:P P3)))
          ((&block P)
           (= P3 P)))))

  (RULE &block4_component
    (&block4.class (:a *P) *Id))

  (RULE &block8_steps
    (OR ((dir_elem *D)
         (step_offset D (:V *Delta)))
        ((diag_dir_elem (:D *D2))
         (step_offset (:D D2) (:V Delta)))))

  (INIT &block8 Quotient
    (edge ((:a P) (:b P3))
      (OR ((&block *P)
           (&block8_steps (:Delta *S))
           (compose (:A P) (:B S) (:C *P3))
           (&block (:P P3)))
          ((&block P)
           (= P3 P)))))

  (RULE &block8_component
    (&block8.class (:a *P) *Id))

  (RULE &mark
    (input *P *Col)
    (&roles (:C_mark Col)))

  (INIT &box4 BoundingBox
    (key ((&block4_component *P ^Id))
      (cell (P)
        (&block4_component *P Id))))

  (INIT &box8 BoundingBox
    (key ((&block8_component *P ^Id))
      (cell (P)
        (&block8_component *P Id))))

  ;; The smallest box that holds a block's box and a mark.
  (INIT &hull BoundingBox
    (key ((&box4.box (:key ^Id) *B)
          (&mark ^P)
          (OR ((= *B_part B))
              ((= B_part P))))
      (cell ((:P B_part))
        (&box4.box (:key Id) *B)
        (&mark P)
        (OR ((= *B_part B))
            ((= B_part P)))))))

(OUTPUT halo "each inside mark paints &halo_color on the eight cells around it, clipped to the grid; the halo covers block, field, and stray mark cells alike"

  (DET &halo_color AnyOutNewColor))

(OUTPUT marks-kept "inside marks keep &mark_color, also where the halo of a neighboring inside mark covers them")

(OUTPUT rest-kept "every other cell keeps its input color")

(ALTS $trigger "which mark cells get a halo" $InBox
  (ALT $InBox
    (ALTS $r "the region that counts as a rectangle" $FourConnected
      (ALT $EightConnected
        (OUTPUT inside-mark "a &mark_color cell is an inside mark when it lies in the bounding box of an 8-connected component of &block_color")
        (RULE &inside_mark
          (&mark *P)
          (&box8.box *B)
          (ALL ((&mark P)
                (&box8.box B)
                (dir_elem (:D *D_m1))
                (relative (:Base B) (:X P) (:X_rel *R_m2))
                (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
               ((>= K_m3 0)))))
      (ALT $NonzeroBox
        (OUTPUT inside-mark "a &mark_color cell is an inside mark when the smallest box that holds it and the bounding box of a 4-connected component of &block_color holds no &background cell outside that component's box"
          (RULE &hull_field
            (&hull.box (:key *Id *P) (:B *B_h))
            (&box4.box (:key Id) *B)
            (input (:P *Q) *Col)
            (&background (:C Col))
            (ALL ((input (:P Q) (:Col *Colm))
                  (&hull.box (:key (:Id *Idm) (:P *Pm)) (:B B_h))
                  (dir_elem (:D *D_m1m))
                  (relative (:Base B_h) (:X Q) (:X_rel *R_m2m))
                  (margin (:B R_m2m) (:D D_m1m) (:K *K_m3m)))
                 ((>= K_m3m 0)))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X Q) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3))
            (< K_m3 0)))
        (RULE &inside_mark
          (&hull.box (:key *Id *P))
          (NOT (&hull_field Id P))))))
  (ALT $ThreeNeighbours
    (OUTPUT inside-mark "a &mark_color cell is an inside mark when at least two of its four neighbours are &block_color")
    (RULE &inside_mark
      (&mark *P)
      (dir_elem (:D *D1))
      (step_offset (:D D1) (:V *V_m1))
      (compose (:A P) (:B V_m1) (:C *Q1))
      (&block (:P Q1))
      (dir_elem (:D *D2))
      (step_offset (:D D2) (:V *V_m2))
      (compose (:A P) (:B V_m2) (:C *Q2))
      (&block (:P Q2))
      (!= D1 D2))))

(ALTS $roles "where the block and mark colors come from" $StoredRoles
  (ALT $DerivedRoles
    (INPUT blocks "the grid holds two colors besides &background; the more frequent is the block color and the other the mark color; a grid with another count of such colors, or with two equally frequent, has no reading"
      (RULE &roles
        (&block_ink.value (:v *C_block))
        (&mark_ink.value (:v *C_mark))))))

(RULE &inside_mark
  (&mark *P)
  (&box4.box *B)
  (ALL ((&mark P)
        (&box4.box B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &halo
  (&inside_mark (:P *P2))
  (step_offset (:D *D_m1) (:V *V_m2))
  (compose (:A P2) (:B V_m2) (:C *P))
  (input P)
  (NOT (&inside_mark P)))

(RULE &output
  (OR ((&halo *P)
       (&halo_color (:C *Col)))
      ((input P Col)
       (&roles)
       (NOT (&halo P)))))
