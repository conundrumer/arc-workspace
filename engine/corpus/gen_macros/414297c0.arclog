;; 414297c0

(DET &bg DominantColor)

(INIT &canvas_count Cardinality
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg (:C Col))))))

(DET &ink SharedColor)

;; The canvas covers more cells than anything else on the background.
(INIT &canvas Order
  (member ((:t Col))
    (&canvas_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&canvas_count.size (:key *Col) *N)))

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&canvas.maximal (:t Col))))

(RULE &canvas_view
  (input *P)
  (&bbox.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_out)))

(RULE &dot
  (&canvas_view *P *P_out)
  (input P *Col)
  (NOT (&canvas.maximal (:t Col))))

(RULE &outside
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&canvas_view P)))

(RULE &key
  (&dot *Col)
  (&outside *P Col))

(RULE &ink_cell
  (&outside *P (:Col *Ink))
  (&ink (:C Ink)))

(ALTS $sp "how far a glyph runs from its key" $Near
  (ALT $Object
    (RULE &obj_steps
      (OR ((dir_elem *D)
           (step_offset D (:V *Delta)))
          ((diag_dir_elem (:D *D2))
           (step_offset (:D D2) (:V Delta)))))

    (INIT &obj Quotient
      (edge ((:a P) (:b P3))
        (OR ((&outside *P)
             (&obj_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&outside (:P P3)))
            ((&outside P)
             (= P3 P)))))

    (RULE &obj_component
      (&obj.class (:a *P) *Id))

    (RULE &glyph
      (&key *P *Col)
      (&obj_component P (:Id *I))
      (&obj_component (:P *Q) (:Id I))
      (!= Q P)
      (&ink_cell (:P Q) *Ink)
      (relative (:Base P) (:X Q) (:X_rel *V)))))

(ALTS $pt "which of the cells off the canvas a glyph is drawn in" $Stored
  (ALT $Copied
    (RULE &ink_cell
      (&outside *P (:Col *Ink)))))

(RULE &glyph
  (&key *P *Col)
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&ink_cell (:P Q) *Ink)
  (step_offset D *V))

(RULE &stamp
  (&dot (:P_out *P_dot) (:Col *Col2))
  (&glyph (:Col Col2) *V (:Ink *Col))
  (compose (:A P_dot) (:B V) (:C *P_out))
  (&canvas_view P_out))

(RULE &output
  (OR ((&stamp (:P_out *P) *Col))
      ((&canvas_view (:P *P2) (:P_out P))
       (input (:P P2) Col)
       (NOT (&stamp (:P_out P))))))
