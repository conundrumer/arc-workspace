;; 17b80ad2

(DET &dir DirDomain)

(DET &mark SharedColor)

(RULE &marked_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(RULE &marked
  (input *P *Col)
  (&mark (:C Col))
  (&dir *D)
  (margin (:B P) D (:K 0))
  (axis_of D *A)
  (&marked_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across)))

(DET &bg DominantColor)

(RULE &flow_source_split1
  (input (:P *P_) *Col)
  (axis_of *D (:A *A_))
  (axis_of (:D *D_m1) (:A A_))
  (opposite (:D D_m1) (:Opp *O_m2))
  (margin (:B P_) (:D D_m1) (:K *K1_m3))
  (margin (:B P_) (:D O_m2) (:K *K2_m4))
  (opposite (:D D_m1) (:Opp *O_m1))
  (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
  (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
  (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
  (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

(ALTS $choice "data-equivalent here, since every mark sits on the bottom edge; diverges when marks sit on another edge" $Dir
  (ALT $Edge
    (RULE &marked_split2
      (input (:P *P_) *Col)
      (axis_of *D (:A *A_))
      (axis_of (:D *D_m1) (:A A_))
      (opposite (:D D_m1) (:Opp *O_m2))
      (margin (:B P_) (:D D_m1) (:K *K1_m3))
      (margin (:B P_) (:D O_m2) (:K *K2_m4))
      (opposite (:D D_m1) (:Opp *O_m1))
      (edge_inset (:D D_m1) (:K K1_m3) (:B *B1_m2))
      (edge_inset (:D O_m1) (:K K2_m4) (:B *B2_m3))
      (compose (:A B1_m2) (:B B2_m3) (:C *X_m1_))
      (relative (:Base X_m1_) (:X P_) (:X_rel *P_across_)))

    (RULE &marked
      (input *P *Col)
      (&mark (:C Col))
      (dir_elem *D)
      (margin (:B P) D (:K 0))
      (axis_of D *A)
      (&marked_split2 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ *P_across)))))

(RULE &flow_dir
  (&marked (:D *Key))
  (opposite (:D Key) (:Opp *D)))

(RULE &flow_blocked
  (&marked (:D *Key))
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &flow_node
  (&marked (:D *Key))
  (opposite (:D Key) (:Opp *O))
  (input *P)
  (NOT (&flow_blocked Key P)))

(RULE &flow_source
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&marked *P_across (:D *Key))
  (axis_of (:D Key) *A)
  (&flow_source_split1 (:P_ P) (:A_ A) (:X_m1_ *X_m1) (:P_across_ P_across)))

;; Ink flows away from the mark edge through bg; ink occludes.
(INIT &flow Distance
  (key ((&flow_source (:Key ^Ky) (:P ^O))
        (&flow_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&flow_source (:Key Ky) (:P O))
           (&flow_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&flow_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&flow_node (:Key Ky) (:P Q)))
          ((&flow_source (:Key Ky) (:P O))
           (&flow_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&flow_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&flow_source (:Key Ky) (:P O))
           (&flow_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&flow_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&flow_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&flow_source (:Key Ky) (:P O))
      (&flow_dir (:Key Ky) D))))

(RULE &flow_ray
  (&flow.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &flow_end
  (&flow_ray *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&flow_ray Key (:P Q) D Origin)))

(RULE &flow_cell
  (&marked (:D *Key))
  (input *P))

(RULE &painted
  (&flow_ray *P (:Origin *P_ink))
  (&flow_cell P)
  (input (:P P_ink) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
