;; 83eb0a57

(RULE &comps_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(INIT &field_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(INIT &comps Quotient
  (edge ((:a P) (:b P3))
    (OR ((input *P *Col)
         (NOT (&field.maximal (:t Col)))
         (&comps_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (input (:P P3) (:Col *Col2))
         (NOT (&field.maximal (:t Col2))))
        ((input P (:Col *Col3))
         (NOT (&field.maximal (:t Col3)))
         (= P3 P)))))

(RULE &comps_component
  (&comps.class (:a *P) *Id))

(INIT &size Cardinality
  (key ((&comps_component *P ^Id))
    (member ((:m P))
      (&comps_component *P Id))))

(INIT &largest Order
  (member ((:t (:V Id) (:S N)))
    (&size.size (:key *Id) *N))
  (score ((:t (:V Id) (:S N)) (:S N))
    (&size.size (:key *Id) *N)))

(INIT &bbox BoundingBox
  (key ((&comps_component *P ^Id))
    (cell (P)
      (&comps_component *P Id))))

(RULE &rect
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (ALL ((&bbox.cell (:key (:Id *Idm)) P)
        (&bbox.box (:key (:Id Idm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (input P *Col))

(RULE &canvas
  (&largest.maximal (:t (:V *Id)))
  (&rect Id (:P_inner *P) *Col))

(INIT &body_count Cardinality
  (key ((&canvas *P ^Col))
    (member ((:m P))
      (&canvas *P Col))))

(INIT &body Order
  (member ((:t Col))
    (&body_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&body_count.size (:key *Col) *N)))

;; A rectangle in canvas colors: its marks keep their color, its body takes
;; the canvas body color.
(INIT &occ Occurrences
  (key ((OR ((&rect ^Id)
             (&canvas *P *Col))
            ((&rect Id *P_inner (:Col *C))
             (OR ((NOT (&canvas (:Col C)))
                  (&body.maximal (:t Col)))
                 ((&canvas (:Col C))
                  (= Col C))))))
    (cell (P (:v Col))
      (&rect Id)
      (&canvas *P *Col))
    (shape ((:P P_inner) (:v Col))
      (&rect Id *P_inner (:Col *C))
      (OR ((NOT (&canvas (:Col C)))
           (&body.maximal (:t *Col)))
          ((&canvas (:Col C))
           (= Col C))))))

(RULE &layer
  (&occ.occurrence (:key *Id) (:P *M))
  (&rect Id *P_inner *Col)
  (compose (:A M) (:B P_inner) (:C *P)))

;; The smallest layer at each cell lies on top.
(INIT &top Order
  (key ((&layer *Id ^P)
        (&size.size (:key Id) *N))
    (member ((:t (:V Id) (:S N)))
      (&layer *Id P)
      (&size.size (:key Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&layer *Id P)
      (&size.size (:key Id) *N))))

(RULE &output
  (&top.minimal (:key *P) (:t (:V *Id)))
  (&layer Id P *Col))
