;; aa18de87

(DET &axis AxisDomain)

(RULE &axis_spans_dir
  (&axis *A)
  (axis4_of *D A))

(RULE &axis_spans_node
  (input *P))

(DET &bg DominantColor)

(RULE &axis_spans_source
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &axis_spans Distance
  (key ((&axis_spans_source (:P ^O))
        (&axis_spans_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&axis_spans_source (:P O))
           (&axis_spans_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&axis_spans_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&axis_spans_node (:P Q)))
          ((&axis_spans_source (:P O))
           (&axis_spans_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&axis_spans_node (:P Q))
           (= A2 O))
          ((&axis_spans_source (:P O))
           (&axis_spans_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&axis_spans_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&axis_spans_node (:P Q)))))
    (source ((:n O))
      (&axis_spans_source (:P O))
      (&axis_spans_dir D))))

(RULE &axis_spans_ray
  (&axis_spans.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &axis_spans_between
  (input *P (:Col *Bg))
  (&bg (:C Bg))
  (&axis *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&axis_spans_ray P D)
  (&axis_spans_ray P (:D O)))

(RULE &axis_spans_end
  (&axis_spans_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&axis_spans_ray (:P Q) D Origin)))

(RULE &iso_spans_dir
  (axis_elem *A)
  (axis4_of *D A))

(RULE &iso_spans_node
  (input *P))

(RULE &iso_spans_source
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &iso_spans Distance
  (key ((&iso_spans_source (:P ^O))
        (&iso_spans_dir ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&iso_spans_source (:P O))
           (&iso_spans_dir D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&iso_spans_node (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&iso_spans_node (:P Q)))
          ((&iso_spans_source (:P O))
           (&iso_spans_dir D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&iso_spans_node (:P Q))
           (= A2 O))
          ((&iso_spans_source (:P O))
           (&iso_spans_dir D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&iso_spans_node (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&iso_spans_node (:P Q)))))
    (source ((:n O))
      (&iso_spans_source (:P O))
      (&iso_spans_dir D))))

(RULE &iso_spans_ray
  (&iso_spans.distance (:key *D (:O *Origin)) (:n *P) *K))

(RULE &iso_spans_end
  (&iso_spans_ray *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&iso_spans_ray (:P Q) D Origin)))

(DET &fill AnyOutNewColor)

(ALTS $choice "which lines fill" $Axis
  (ALT $Iso
    (RULE &iso_spans_between
      (input *P (:Col *Bg))
      (&bg (:C Bg))
      (axis_elem *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&iso_spans_ray P D)
      (&iso_spans_ray P (:D O)))

    (RULE &output
      (OR ((&iso_spans_between *P)
           (&fill (:C *Col)))
          ((input P Col)
           (NOT (&iso_spans_between P)))))))

(RULE &output
  (OR ((&axis_spans_between *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&axis_spans_between P)))))
