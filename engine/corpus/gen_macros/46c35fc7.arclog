;; 46c35fc7

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &ring
  (input (:P *P_hole))
  (NOT (&ink (:P P_hole)))
  (ALL ((dir8_elem (:D *Dm))
        (step_offset (:D Dm) (:V *V_m1m))
        (compose (:A P_hole) (:B V_m1m) (:C *Q)))
       ((&ink (:P Q))))
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A P_hole) (:B V_m1) (:C *P))
  (&ink P *Col))

(DET &move_defect
  (&ring *E *P_hole *D *Col)
  (dir8_elem (:D *D_out))
  (step_offset (:D D_out) (:V *V_m1))
  (compose (:A P_hole) (:B V_m1) (:C *P_out))
  (ex_output E (:P P_out) (:Col *Col2))
  (!= Col2 Col))

(DET &turned
  (c4_turn *S (:T *R))
  (d4_elem (:D R))
  (dir8_elem *D)
  (dir8_elem (:D *D_out))
  (step_offset D (:V *S_m1))
  (apply (:D R) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D D_out) (:V S2_m2)))

(DET &corner_sense_defect
  (&turned *S *D *D_out)
  (diag_dir_elem D)
  (&move_defect D D_out))

(DET &landed
  (&ring *E *P_hole *D *Col)
  (step_offset (:D *D_out) (:V *V_m1))
  (compose (:A P_hole) (:B V_m1) (:C *P_out))
  (ex_output E (:P P_out) Col))

(DET &move
  (&landed *D *D_out)
  (NOT (&move_defect D D_out)))

(DET &corner_sense
  (&move *D *D_out)
  (diag_dir_elem D)
  (&turned *S D D_out)
  (NOT (&corner_sense_defect S)))

(DET &edge_sense_defect
  (&turned *S *D *D_out)
  (dir_elem D)
  (&move_defect D D_out))

(DET &edge_sense
  (&move *D *D_out)
  (dir_elem D)
  (&turned *S D D_out)
  (NOT (&edge_sense_defect S)))

(RULE &moved
  (OR ((diag_dir_elem *D)
       (&corner_sense *S))
      ((dir_elem D)
       (&edge_sense S)))
  (c4_turn S (:T *R))
  (d4_elem (:D R))
  (dir8_elem D)
  (dir8_elem (:D *D_out))
  (step_offset D (:V *S_m1))
  (apply (:D R) (:P S_m1) (:P_out *S2_m2))
  (step_offset (:D D_out) (:V S2_m2)))

(ALTS $choice "what the move around each ring is" $Rotate
  (ALT $Cycle
    (DET &cycle_sense SenseDomain)

    (DET &corner_step TileDim)

    (DET &edge_step NumberDomain)

    (INIT &cycle Walk
      (successor ((:p D_from) (:p_next D_to))
        (&cycle_sense *S)
        (turn S *D *D2)
        (corner_dir (:C *D_diag) (:A *A_m1) D)
        (perp (:A A_m1) (:A2 *A2_m2))
        (corner_dir (:C D_diag) (:A A2_m2) (:D D2))
        (OR ((= *D_from D)
             (= *D_to D_diag))
            ((= D_from D_diag)
             (= D_to D2))))
      (steps (N)
        (OR ((&corner_step (:D *N)))
            ((&edge_step N)))))

    (RULE &moved
      (OR ((diag_dir_elem *D)
           (&corner_step (:D *N)))
          ((dir_elem D)
           (&edge_step N)))
      (&cycle.walk (:p0 D) N (:p *D_out))))
  (ALT $Table
    (RULE &moved
      (&move *D *D_out))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&ring P)))
      ((&ring *P_hole *D Col)
       (&moved D *D_out)
       (step_offset (:D D_out) (:V *V_m1))
       (compose (:A P_hole) (:B V_m1) (:C P)))))
