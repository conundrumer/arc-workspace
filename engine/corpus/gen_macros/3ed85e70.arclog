;; 3ed85e70

(RULE &ground_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(RULE &shapes_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &legend_bg UnchangedColor)

;; The legend's background spans the grid, so it reaches an edge. The field
;; carries blocks of that color too, and those sit clear of every edge.
(INIT &ground Propagation
  (source ((:n P))
    (input *P)
    (dir_elem *D)
    (margin (:B P) D (:K 0))
    (input P *Col)
    (&legend_bg (:C Col)))
  (edge ((:a P) (:b P2))
    (input *P *Col)
    (&legend_bg (:C Col))
    (&ground_steps (:Delta *S))
    (compose (:A P) (:B S) (:C *P2))
    (input (:P P2) (:Col *Col2))
    (&legend_bg (:C Col2))))

(INIT &panel BoundingBox
  (cell (P)
    (&ground.reached (:n *P))))

(RULE &panel_cell
  (&panel.box *B)
  (input *P)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(RULE &legend_cell
  (input *P *Col)
  (&panel_cell P)
  (NOT (&legend_bg (:C Col))))

(INIT &shapes Quotient
  (edge ((:a P) (:b P3))
    (OR ((&legend_cell *P)
         (&shapes_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&legend_cell (:P P3)))
        ((&legend_cell P)
         (= P3 P)))))

(RULE &shapes_component
  (&shapes.class (:a *P) *Id))

(RULE &clues_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &field_bg DominantColor)

(RULE &field_cell
  (input *P *Col)
  (NOT (&panel_cell P))
  (NOT (&field_bg (:C Col))))

(INIT &clues Quotient
  (edge ((:a P) (:b P3))
    (OR ((&field_cell *P)
         (&clues_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&field_cell (:P P3)))
        ((&field_cell P)
         (= P3 P)))))

(RULE &clues_component
  (&clues.class (:a *P) *Id))

(RULE &shape_cell
  (&shapes_component *P (:Id *S))
  (&legend_cell P *Col))

(RULE &clue_cell
  (&clues_component *P (:Id *K))
  (&field_cell P *Col))

(INIT &clue_palette Singleton
  (key ((&clue_cell ^K *Col))
    (member ((:v Col))
      (&clue_cell K *Col))))

(INIT &clue_box BoundingBox
  (key ((&clue_cell ^K *P))
    (cell (P)
      (&clue_cell K *P))))

(INIT &layer_box BoundingBox
  (key ((&shape_cell ^S *P ^Col))
    (cell (P)
      (&shape_cell S *P Col))))

(RULE &piece
  (&clue_palette.plural (:key *K))
  (&shape_cell *S))

(INIT &occ Occurrences
  (key ((&piece ^K ^S))
    (cell (P (:v Col))
      (&shape_cell S *P *Col))
    (shape (P (:v Col))
      (&clue_cell K *P *Col))))

(RULE &place
  (OR ((&clue_palette.value (:key *K) (:v *Col))
       (&clue_box.cell (:key K) *P)
       (&clue_box.box (:key K) (:B *B_clue))
       (&layer_box.box (:key *S Col) (:B *B_layer))
       (perp *A *A2)
       (axis_elem A)
       (relative (:Base B_clue) (:X P) (:X_rel *R_m1))
       (frame_extent (:P R_m1) A (:N *N1))
       (axis_elem (:A A2))
       (relative (:Base B_clue) (:X P) (:X_rel *R_m2))
       (frame_extent (:P R_m2) (:A A2) (:N *N2))
       (axis_elem A)
       (relative (:Base B_layer) (:X P) (:X_rel *R_m3))
       (frame_extent (:P R_m3) A (:N N1))
       (axis_elem (:A A2))
       (relative (:Base B_layer) (:X P) (:X_rel *R_m4))
       (frame_extent (:P R_m4) (:A A2) (:N N2))
       (relative (:Base B_layer) (:X B_clue) (:X_rel *V)))
      ((&occ.occurrence (:key (:K *K2) S) (:P *V_clue))
       (relative (:Base V_clue) (:X 0) (:X_rel V)))))

(RULE &stamp
  (&place *S *V)
  (&shape_cell S (:P *P_shape) *Col)
  (compose (:A P_shape) (:B V) (:C *P)))

(RULE &output
  (OR ((&stamp *P *Col))
      ((input P Col)
       (NOT (&stamp P)))))
