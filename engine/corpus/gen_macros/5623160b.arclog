;; 5623160b

(DET &bg DominantColor)

;; The color that stays put and points.
(DET &anchor UnchangedColor)

(RULE &part
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&anchor (:C Col))))

(INIT &hue Quotient
  (equivalent ((:a P) (:b Q))
    (&part *P *Col)
    (&part (:P *Q) Col)))

(RULE &group
  (&hue.class (:a *P) *Id))

(ALTS $choice "what one piece is" $ByColor
  (ALT $ByRun
    (RULE &run_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    (INIT &run Quotient
      (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
        (OR ((&part *P *Col)
             (&run_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (&part (:P P3) Col))
            ((&part P Col)
             (= P3 P)))))

    (RULE &run_component
      (&run.class (:a *Key *P) *Id))

    (RULE &group
      (&run_component *P *Id)))
  (ALT $ByLayer
    (RULE &assembly_steps
      (dir_elem *D)
      (step_offset D (:V *Delta)))

    ;; The anchors glue the assembly, so they join the region they hold together.
    (INIT &assembly Quotient
      (edge ((:a P) (:b P3))
        (OR ((input *P *Col)
             (NOT (&bg (:C Col)))
             (&assembly_steps (:Delta *S))
             (compose (:A P) (:B S) (:C *P3))
             (input (:P P3) (:Col *Col2))
             (NOT (&bg (:C Col2))))
            ((input P (:Col *Col3))
             (NOT (&bg (:C Col3)))
             (= P3 P)))))

    (RULE &assembly_component
      (&assembly.class (:a *P) *Id))

    (RULE &group
      (&assembly_component *P *Id))))

(RULE &piece_cell
  (&group *P *Id)
  (&part P *Col))

(RULE &move_dir
  (&piece_cell *Id *Col *P)
  (step_offset (:D *D_anchor) (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (input (:P Q) (:Col *Col_a))
  (&anchor (:C Col_a))
  (opposite *D (:Opp D_anchor)))

;; Each piece travels until it reaches the edge ahead.
(INIT &slide Distance
  (key ((&piece_cell ^Id ^Col *P)
        (&move_dir Id Col *D)
        (margin (:B P) D *K))
    (source_distance (K)
      (&piece_cell Id Col *P)
      (&move_dir Id Col *D)
      (margin (:B P) D *K))))

(RULE &ink
  (OR ((input *P *Col)
       (&anchor (:C Col)))
      ((&piece_cell (:Id *Pc_id) Col (:P *P2))
       (&slide.distance (:key (:Id Pc_id) Col) *K)
       (&move_dir (:Id Pc_id) Col *D)
       (dir8_opposite D (:D2 *O_m1))
       (edge_inset (:D O_m1) K (:B *B1_m2))
       (edge_inset D K (:B *I_m4))
       (relative (:Base I_m4) (:X 0) (:X_rel *B2_m3))
       (compose (:A B1_m2) (:B B2_m3) (:C *V))
       (compose (:A P2) (:B V) (:C P)))))

(RULE &output
  (OR ((&ink *P *Col))
      ((input P)
       (&bg (:C Col))
       (NOT (&ink P)))))
