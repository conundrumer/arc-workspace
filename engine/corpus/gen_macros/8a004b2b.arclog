;; 8a004b2b

(RULE &block_steps
  (dir_elem *D)
  (step_offset D (:V *Delta)))

(DET &bg DominantColor)

;; The color of the cells that bound the frame.
(DET &marker SharedColor)

;; The frame is the box the markers bound; the output is its interior.
(INIT &frame BoundingBox
  (cell (P)
    (input *P *Col)
    (&marker (:C Col))))

(RULE &frame_view
  (input *P)
  (&frame.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &frame_cell
  (&frame_view (:P *P2) (:P_inner *P))
  (input (:P P2) *Col))

(RULE &block_ink
  (&frame_cell *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&marker (:C Col))))

(INIT &block Quotient
  (edge ((:a (:Key Col) P) (:b (:Key Col) (:P P3)))
    (OR ((&block_ink *P *Col)
         (&block_steps (:Delta *S))
         (compose (:A P) (:B S) (:C *P3))
         (&block_ink (:P P3) Col))
        ((&block_ink P Col)
         (= P3 P)))))

(RULE &block_component
  (&block.class (:a *Key *P) *Id))

;; The ink outside the frame, in its own box.
(INIT &blueprint BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&frame_view P))))

(INIT &block_box BoundingBox
  (key ((&block_component *P ^Id))
    (cell (P)
      (&block_component *P Id))))

;; A tile is a square with a block's side.
(INIT &tile Frame
  (extent (A (:N K))
    (&block_box.cell (:key *Id) *P)
    (&block_box.box (:key Id) *B)
    (axis_elem *A)
    (relative (:Base B) (:X P) (:X_rel *R_m1))
    (frame_extent (:P R_m1) A (:N *K))
    (perp A *A2)
    (axis_elem (:A A2))
    (relative (:Base B) (:X P) (:X_rel *R_m2))
    (frame_extent (:P R_m2) (:A A2) (:N K))))

(INIT &drawing_tiling Tiling
  (outer ((:P P_tile))
    (&blueprint.cell *P)
    (&blueprint.box *B)
    (ALL ((dir_elem (:D *D_m1))
          (relative (:Base B) (:X P) (:X_rel *R_m2))
          (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
         ((>= K_m3 0)))
    (relative (:Base B) (:X P) (:X_rel *P_tile)))
  (inner ((:P P_intile))
    (&tile.cell (:P *P_intile))))

(RULE &drawing
  (&blueprint.cell (:P *P2))
  (input (:P P2) *Col)
  (&blueprint.box *B)
  (ALL ((dir_elem (:D *D_m1))
        (relative (:Base B) (:X P2) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (relative (:Base B) (:X P2) (:X_rel *P_tile))
  (&drawing_tiling.cell (:P_outer P_tile) *P))

;; The drawing sits where every block cell lands on a drawing cell of its
;; color.
(INIT &seat Occurrences
  (cell (P (:v Col))
    (&drawing *P *Col))
  (shape (P (:v Col))
    (&block_ink *P *Col)))

(RULE &painted
  (&seat.occurrence (:P *P_seat))
  (&frame_cell *P)
  (compose (:A P_seat) (:B P) (:C *P_draw))
  (&drawing (:P P_draw) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((&frame_cell P Col)
       (NOT (&painted P)))))
