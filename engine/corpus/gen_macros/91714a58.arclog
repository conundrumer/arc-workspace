;; 91714a58

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The rectangles each color draws. An outline spans at least two cells on
;; each axis, so a run one cell wide draws none.
(INIT &outline Outlines
  (key ((&ink *P ^Col))
    (node (P)
      (&ink *P Col))))

;; The one color a rectangle holds, absent where it holds more than one.
(INIT &rect_color Singleton
  (key ((&outline.box ^B))
    (member ((:v C))
      (input *P (:Col *C))
      (ALL ((input P (:Col *Cm))
            (dir_elem (:D *D_m1))
            (relative (:Base B) (:X P) (:X_rel *R_m2))
            (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
           ((>= K_m3 0))))))

(RULE &rect_cell
  (&rect_color.value (:key *B) (:v *Col))
  (input *P)
  (ALL ((&rect_color.value (:key B) (:v *Colm))
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0))))

(INIT &biggest_count Cardinality
  (key ((&rect_cell ^B *P))
    (member ((:m P))
      (&rect_cell B *P))))

;; The solid rectangle holding the most cells.
(INIT &biggest Order
  (member ((:t B))
    (&biggest_count.size (:key *B)))
  (score ((:t B) (:S N))
    (&biggest_count.size (:key *B) *N)))

(RULE &keep
  (&biggest.maximal (:t *B))
  (&rect_cell B *Col *P))

(ALTS $choice "Which cells form the figure." $Rect
  (ALT $Thick
    ;; The 2x2 square a thick cell lies in.
    ;; TODO no-det-plan: &square: the plan gives no verdict
    (DET &square)

    ;; The 2x2 squares of each color.
    (INIT &block Occurrences
      (key ((OR ((&ink *P ^Col))
                ((&ink Col)
                 (&square (:P *S)))))
        (cell (P)
          (&ink *P Col))
        (shape ((:P S))
          (&ink Col)
          (&square (:P *S)))))

    (RULE &keep
      (&block.occurrence (:key *Col) (:P *M))
      (&square (:P *S))
      (compose (:A M) (:B S) (:C *P)))))

(RULE &output
  (input *P)
  (OR ((&keep P *Col))
      ((NOT (&keep P))
       (&bg (:C Col)))))
