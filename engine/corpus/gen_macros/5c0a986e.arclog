;; 5c0a986e

(DET &bg DominantColor)

(INIT &bx BoundingBox
  (key ((ex_input ^E *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (ex_input E *P Col)
      (NOT (&bg (:C Col))))))

(DET &heading_inside1
  (&bx.cell (:key *E *Col) (:P *P_))
  (&bx.box (:key E Col) (:B *B_))
  (dir_elem (:D *D_m1))
  (relative (:Base B_) (:X P_) (:X_rel *R_m2))
  (margin (:B R_m2) (:D D_m1) (:K *K_m3))
  (< K_m3 0))

(DET &new_ink
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Bg))
  (&bg (:C Bg)))

(DET &heading_corner_anchor1
  (&bx.cell (:key *E *Col) (:P *P_))
  (&new_ink E Col (:P *Q))
  (step_offset (:D *D_) (:V *V_m1))
  (compose (:A P_) (:B V_m1) (:C Q))
  (&bx.box (:key E Col) (:B *B_))
  (corner_dir (:C D_) (:D *D_m1))
  (margin (:B P_) (:D D_m1) (:K *K1_m2))
  (margin (:B B_) (:D D_m1) (:K *K2_m3))
  (!= K1_m2 K2_m3))

(DET &heading
  (&bx.cell (:key *E *Col) *P)
  (&bx.box (:key E Col) *B)
  (NOT (&heading_inside1 (:P_ P) (:B_ B)))
  (step_offset *D (:V *V_m1))
  (NOT (&heading_corner_anchor1 (:D_ D) (:P_ P) (:B_ B)))
  (compose (:A P) (:B V_m1) (:C *Q))
  (&new_ink E Col (:P Q)))

(RULE &beam_cell
  (&heading (:Col *Key))
  (input *P (:Col *Bg))
  (&bg (:C Bg)))

(RULE &beam_dir
  (&heading (:Col *Key) *D))

(RULE &beam_node
  (&heading (:Col *Key) *D)
  (input *P))

;; Each ink color's block, as the box bounding it.
(INIT &bx2 BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &beam_source
  (&heading (:Col *Key) *D)
  (&bx2.cell (:key (:Col Key)) *P)
  (&bx2.box (:key (:Col Key)) *B)
  (ALL ((&bx2.cell (:key (:Col *Colm)) P)
        (&bx2.box (:key (:Col Colm)) B)
        (dir_elem (:D *D_m1))
        (relative (:Base B) (:X P) (:X_rel *R_m2))
        (margin (:B R_m2) (:D D_m1) (:K *K_m3)))
       ((>= K_m3 0)))
  (ALL ((&heading (:Col *Colmm) D)
        (&bx2.cell (:key (:Col Colmm)) P)
        (&bx2.box (:key (:Col Colmm)) B)
        (corner_dir (:C D) (:D *D_m1m))
        (margin (:B P) (:D D_m1m) (:K *K1_m2))
        (margin B (:D D_m1m) (:K *K2_m3)))
       ((= K1_m2 K2_m3))))

;; The ray a block casts.
(INIT &beam Distance
  (key ((&beam_source (:Key ^Ky) (:P ^O))
        (&beam_dir (:Key Ky) ^D))
    (edge ((:a A2) (:b Q))
      (OR ((&beam_source (:Key Ky) (:P O))
           (&beam_dir (:Key Ky) D)
           (axis_of D *A)
           (sub_extent (:P O) A *K)
           (dir8_opposite D (:D2 *O_m2))
           (edge_inset (:D O_m2) K (:B *B1_m3))
           (edge_inset D K (:B *I_m5))
           (relative (:Base I_m5) (:X 0) (:X_rel *B2_m4))
           (compose (:A B1_m3) (:B B2_m4) (:C *V_m1))
           (compose (:A O) (:B V_m1) (:C *A2))
           (&beam_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m6))
           (compose (:A A2) (:B V_m6) (:C *Q))
           (&beam_node (:Key Ky) (:P Q)))
          ((&beam_source (:Key Ky) (:P O))
           (&beam_dir (:Key Ky) D)
           (step_offset D (:V *V_m12))
           (compose (:A O) (:B V_m12) (:C Q))
           (&beam_node (:Key Ky) (:P Q))
           (= A2 O))
          ((&beam_source (:Key Ky) (:P O))
           (&beam_dir (:Key Ky) D)
           (diag_dir_elem D)
           (axis_elem (:A *A3))
           (sub_extent (:P O) (:A A3) (:K *K2))
           (dir8_opposite D (:D2 *O_m22))
           (edge_inset (:D O_m22) (:K K2) (:B *B1_m32))
           (edge_inset D (:K K2) (:B *I_m52))
           (relative (:Base I_m52) (:X 0) (:X_rel *B2_m42))
           (compose (:A B1_m32) (:B B2_m42) (:C *V_m13))
           (compose (:A O) (:B V_m13) (:C A2))
           (&beam_node (:Key Ky) (:P A2))
           (step_offset D (:V *V_m62))
           (compose (:A A2) (:B V_m62) (:C Q))
           (&beam_node (:Key Ky) (:P Q)))))
    (source ((:n O))
      (&beam_source (:Key Ky) (:P O))
      (&beam_dir (:Key Ky) D))))

(RULE &beam_ray2
  (&beam.distance (:key (:Ky *Key) *D (:O *Origin)) (:n *P) *K))

(RULE &beam_ray
  (&beam_ray2 *Key *P *D *K (:Origin *Src))
  (&beam_cell Key P))

(RULE &beam_end
  (&beam_ray2 *Key *P *D *K *Origin)
  (step_offset D (:V *V_m1))
  (compose (:A P) (:B V_m1) (:C *Q))
  (NOT (&beam_ray2 Key (:P Q) D Origin)))

(RULE &output
  (OR ((&beam_ray2 (:Key *Col) *P)
       (&beam_cell (:Key Col) P))
      ((input P Col)
       (NOT (&beam_ray P)))))
