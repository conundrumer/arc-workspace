;; 913fb3ed

(INIT &ground_count Cardinality
  (key ((ex_input *E *P ^Col))
    (member ((:m E P))
      (ex_input *E *P Col))))

;; The grids' ground color; dots are the exception to it.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S Count))
    (&ground_count.size (:key *Col) (:N *Count))))

(DET &dot
  (ex_input *E *P (:Col *M))
  (NOT (&ground.maximal (:t M))))

(DET &neighbor_cell
  (&dot *E (:P *Q) *M)
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A Q) (:B V_m1) (:C *P))
  (ex_output E P *Col)
  (relative (:Base Q) (:X P) (:X_rel *Off)))

(DET &border
  (&neighbor_cell (:M *Mark) *Col))

(RULE &painted
  (input (:P *Q) (:Col *M))
  (&border (:Mark M) *Col)
  (dir8_elem *D)
  (step_offset D (:V *V_m1))
  (compose (:A Q) (:B V_m1) (:C *P))
  (input P))

(ALTS $choice "What the eight cells around a dot come from." $Ring
  (ALT $Stamp
    (DET &template
      (&neighbor_cell (:M *Mark) *Off *Col))

    (RULE &painted
      (input (:P *Q) (:Col *M))
      (&template (:Mark M) *Off *Col)
      (compose (:A Q) (:B Off) (:C *P))
      (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))
