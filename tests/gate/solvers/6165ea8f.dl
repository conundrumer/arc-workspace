// 6165ea8f
// @draft
// @keywords: markers d4 rank pairwise congruent
// input: a line at one edge of the grid lists colors, one cell each. Away
//  from that line, each listed color draws one shape.
// output: the output is a comparison matrix over the listed colors, taken in
//  the order the list gives them. Each color labels one row and one column,
//  in a header line along each edge of the header corner. Every matrix entry
//  is a square block, blocks separated by a gap. The block where two colors
//  meet is params.alike when a D4 element carries one shape onto the other
//  and params.unlike when none does; the diagonal, where a color meets
//  itself, and the corner the two header lines share are bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The edge the color list runs along.
    .decl legend_dir(d: Dir) legend_dir(DIR_R).

    // The output corner the two header lines meet at. Its diagonal carries
    // the blocks where a color meets itself.
    .decl header_corner(d: DiagDir) header_corner(DIAG_TL).

    // Tile lines the header takes before the colors' own.
    .decl header(n: number) header(1).

    // One matrix entry, drawn as a square block, with gap cells between.
    .decl block(n: number) block(2).
    .decl gap(g: number) gap(1).

    // What a block says about the two shapes it stands for.
    .decl alike(col: Color) alike(2).
    .decl unlike(col: Color) unlike(5).
}

.init params = Params

// --- the color list ---

.decl legend_axis(a: Axis)
legend_axis(A) :- params.legend_dir(D), axis_of(D, A2), perp(A2, A).

.decl legend(col: Color, p: Position)
legend(Col, P) :-
    in(P, Col), !params.bg(Col),           // an ordinary color
    params.legend_dir(D), dist(P, D, 0).   // on the list's edge

.init order = OrderFrame<Unit, Color>
order.axis($U(), A) :- legend_axis(A).
order.member($U(), Col, L) :- legend(Col, P), legend_axis(A), split(P, A, L, _).

// --- the shapes ---

.decl shape_cell(col: Color, p: Position)
shape_cell(Col, P) :-
    in(P, Col), !params.bg(Col),
    params.legend_dir(D), !dist(P, D, 0).   // off the list's edge

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- shape_cell(Col, P).

// Each shape's cells, in its own box frame.
.decl shape_inner(col: Color, p_inner: Position)
shape_inner(Col, P_inner) :- shape_cell(Col, P), bbox.box(Col, B), crop(P, B, P_inner).

// Each ordered pair of shapes, both read in their own box frames.
.type Pair = [a: Color, b: Color]
.init cong = D4Map<Pair, Unit>
cong.src([A, B], P_inner, $U()) :- shape_inner(A, P_inner), shape_inner(B, _).
cong.dst([A, B], P_inner, $U()) :- shape_inner(A, _), shape_inner(B, P_inner).

// One D4 element carries A's shape onto B's, and its inverse carries B's
// back: the two shapes are the same shape.
.decl same_shape(a: Color, b: Color)
same_shape(A, B) :- cong.map([A, B], D), d4_inverse(D, D_back), cong.map([B, A], D_back).

// --- the matrix ---

// The color's row and its column, as tile lines on each axis. The list's
// order carries over to the axis it runs along.
.decl slot(col: Color, a: Axis, p: Position)
slot(Col, A, P) :-
    order.pos($U(), Col, P_order), legend_axis(A),
    params.header_corner(Cn), diag_dirs(Cn, A, D, _),
    params.header(K), edge_inset(D, K, Delta), compose(P_order, Delta, P).
slot(Col, A2, P2) :-
    slot(Col, A, P), perp(A, A2),
    params.header_corner(Cn), diag_axis_of(Cn, DA), diag_flip_of(DA, T),
    apply(T, P, P2).                                // rows and columns transpose

.init tile_line = AxisFrame<Unit>
tile_line.extent($U(), A, N) :- slot(_, A, P), axis_dim(P, A, N).

.decl tile_color(p_tile: Position, col: Color)
tile_color(P_tile, Col) :-
    slot(C2, A2, P2), perp(A, A2), compose(P1, P2, P_tile),  // a tile on a color's slot
    ( tile_line.cell($U(), A, P1), !slot(_, A, P1), Col = C2  // the header line names the slot
    ; slot(C1, A, P1), C1 != C2,                              // another color meets it there
      ( same_shape(C1, C2), params.alike(Col)
      ; !same_shape(C1, C2), params.unlike(Col)
      )
    ).

// --- the output ---

.init entry = Frame2D<Unit>
entry.extent($U(), A, N) :- axis_elem(A), params.block(N).

.decl painted(p: Position, col: Color)
painted(P_grid_out, Col) :-
    tile_color(P_tile, Col), entry.cell($U(), P_intile), params.gap(G),
    concat_2d(P_tile, P_intile, G, P_grid_out).

.init sheet = Frame2D<Unit>
sheet.extent($U(), A, N) :- painted(P, _), axis_elem(A), axis_dim(P, A, N).

out(P_grid_out, Col) :-
    sheet.cell($U(), P_grid_out),
    ( painted(P_grid_out, Col)                    // a matrix entry
    ; !painted(P_grid_out, _), params.bg(Col)     // the gaps, the diagonal, the corner
    ).

.comp Determine {
    // Gap cells stand between the blocks, so each block is one component.
    .init ink = Components<Example>
    ink.node(E, P) :- ex_out(E, P, Col), !params.bg(Col).

    .type EId = [e: Example, id: Ident]
    .init blk = Bbox<EId>
    blk.cell([E, Id], P) :- ink.label(E, P, Id).

    .decl block(n: number)
    block(N) :- blk.cell([E, Id], P), blk.box([E, Id], B), box_extent(B, P, _, N).

    .decl cand_gap(g: number)
    cand_gap(G) :- ex_out(_, P, _), axis_elem(A), sub_extent(P, A, G).

    .decl tiled(e: Example, g: number, p: Position, p_tile: Position)
    tiled(E, G, P, P_tile) :-
        ex_out(E, P, _), cand_gap(G), block(K), divide_by_size_2d(P, K, G, P_tile, _).

    // A gap that leaves an inked cell outside every block.
    .decl loose(g: number)
    loose(G) :- ex_out(E, P, Col), !params.bg(Col), cand_gap(G), !tiled(E, G, P, _).

    .decl gap(g: number)
    gap(G) :- cand_gap(G), !loose(G).

    // How far each inked tile lies from the header corner. The nearest one
    // is the first color's label, which sits at the head of its own line.
    .decl ring(k: number)
    ring(K) :-
        ex_out(E, P, Col), !params.bg(Col), gap(G), tiled(E, G, P, P_tile),
        params.header_corner(Cn), corner_dist(P_tile, Cn, K).

    .init near = Extremes<Unit>
    near.cand($U(), K) :- ring(K).

    .decl header(n: number)
    header(N) :- near.low($U(), N).
}
