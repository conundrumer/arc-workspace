;; inputs 28f2115fc5521cf6d2d712122f920cbb2c3414c091a607218e3210d4e3670720 programs/solvers/fc4aaf52.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; fc4aaf52

(param &bg Color (8))
(param &moved_half Dir (DIR_T))
(param &slide_sense Sense (SENSE_CW))

(alts $s
  (alt $CellClear
    (witness gapped-cut-row borderline concept
      (relaxed contiguous-cut-row)
      (separates "the cut rows are broken by a gap (cols 1 and 3 of rows 2-3): the concept slides the top half 3, past the other cut row's span; $CellClear slides it 1, the least move at which no cell sits over a cell; $CutCount slides it 2, the cut row's cell count; the layer branches are undefined, as both colors touch the outside")
      (input (grid
        (8 8 8 8 8 8 8 8)
        (8 4 4 4 8 8 8 8)
        (8 9 8 9 8 8 8 8)
        (8 9 8 9 8 8 8 8)
        (8 4 4 4 8 8 8 8)
        (8 8 8 8 8 8 8 8)))
      (output ($Clear $Swap) (grid
        (8 8 8 8 8 8 8 8)
        (8 8 8 8 9 9 9 8)
        (8 8 8 8 4 8 4 8)
        (8 4 8 4 8 8 8 8)
        (8 9 9 9 8 8 8 8)
        (8 8 8 8 8 8 8 8)))
      (output $CellClear (grid
        (8 8 8 8 8 8 8 8)
        (8 8 9 9 9 8 8 8)
        (8 8 4 8 4 8 8 8)
        (8 4 8 4 8 8 8 8)
        (8 9 9 9 8 8 8 8)
        (8 8 8 8 8 8 8 8)))
      (output $LayerReverse $LayerShiftIn $LayerShiftOut undefined)
      (output $CutCount (grid
        (8 8 8 8 8 8 8 8)
        (8 8 8 9 9 9 8 8)
        (8 8 8 4 8 4 8 8)
        (8 4 8 4 8 8 8 8)
        (8 9 9 9 8 8 8 8)
        (8 8 8 8 8 8 8 8)))))
  (alt $CutCount
    (witness gapped-cut-row borderline concept)))

(alts $r
  (alt $LayerReverse
    (witness three-layers variant $LayerReverse
      (relaxed two-colors)
      (separates "the shape nests three colors: the concept's swap has no single other color and is undefined; $LayerReverse exchanges the outer and inner colors and keeps the middle; $LayerShiftOut gives each layer the color inside it; $LayerShiftIn the color around it")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 4 4 4 4 4 8 8 8 8 8 8)
        (8 4 9 9 9 4 8 8 8 8 8 8)
        (8 4 9 2 9 4 8 8 8 8 8 8)
        (8 4 9 2 9 4 8 8 8 8 8 8)
        (8 4 9 9 9 4 8 8 8 8 8 8)
        (8 4 4 4 4 4 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $Swap undefined)
      (output $LayerReverse (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 2 2 2 2 2 8)
        (8 8 8 8 8 8 2 9 9 9 2 8)
        (8 8 8 8 8 8 2 9 4 9 2 8)
        (8 2 9 4 9 2 8 8 8 8 8 8)
        (8 2 9 9 9 2 8 8 8 8 8 8)
        (8 2 2 2 2 2 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $LayerShiftIn (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 2 2 2 2 2 8)
        (8 8 8 8 8 8 2 4 4 4 2 8)
        (8 8 8 8 8 8 2 4 9 4 2 8)
        (8 2 4 9 4 2 8 8 8 8 8 8)
        (8 2 4 4 4 2 8 8 8 8 8 8)
        (8 2 2 2 2 2 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $LayerShiftOut (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 9 9 9 9 9 8)
        (8 8 8 8 8 8 9 2 2 2 9 8)
        (8 8 8 8 8 8 9 2 4 2 9 8)
        (8 9 2 4 2 9 8 8 8 8 8 8)
        (8 9 2 2 2 9 8 8 8 8 8 8)
        (8 9 9 9 9 9 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))))
  (alt $LayerShiftOut
    (witness three-layers variant $LayerReverse))
  (alt $LayerShiftIn
    (witness three-layers variant $LayerReverse)))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor borderline concept
      (separates "the shape's outer color 4 outnumbers 8: the stored background 8 keeps 4 and 9 as the shape and slides its top half 1; the derived background 4 takes the 8 and 9 cells as the shape and slides its top half off the frame")
      (input (grid
        (4 4 4 4 4 8)
        (4 4 9 4 4 8)
        (8 8 9 8 8 8)
        (8 8 9 8 8 8)
        (4 4 9 4 4 8)
        (4 4 4 4 4 8)))
      (output ($Swap &bg=$Stored) (grid
        (8 9 9 9 9 9)
        (8 9 9 4 9 9)
        (8 8 8 4 8 8)
        (8 8 4 8 8 8)
        (9 9 4 9 9 8)
        (9 9 9 9 9 8)))
      (output $LayerReverse $LayerShiftIn $LayerShiftOut undefined)
      (output &bg=$Derived (grid
        (4 4 4 4 4 4)
        (4 4 4 4 4 4)
        (4 4 4 4 4 4)
        (9 9 8 9 9 9)
        (4 4 8 4 4 9)
        (4 4 4 4 4 9))))))
