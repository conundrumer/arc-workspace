;; inputs 041a4e0d71cc92cbfa8a9ac0087a8b589d0b8cddfefbd47e8cdd3ec40496a3e2 programs/solvers/11e1fe23.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 11e1fe23

(DET &bg DominantColor)

(DET &center_paint AnyOutNewColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The marks' bounding box, read by $Shrink and $Converge alike.
(INIT &bbox BoundingBox
  (cell (P)
    (&mark *P)))

(RULE &view
  (input *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &center
  (&view *P *P_inner)
  (centered (:P P_inner)))

(RULE &mini
  (&center (:P *C))
  (OR ((&mark (:P *P_mark) *Col)
       (&bbox.box *B)
       (inside (:A P_mark) B)
       (same_corner (:D *Diag) (:P1 P_mark) (:P2 B))
       (neighbor (:P C) (:D Diag) (:Q *P)))
      ((&center_paint (:C Col))
       (= P C))))

(ALTS $choice "how a mark finds its step" $Shrink
  (ALT $Converge
    (RULE &place_nearer
      (&view (:P_inner *P))
      (dist_pair P *D *K *K2)
      (< K K2))

    (RULE &place_quadrant
      (diag_dirs (:D *Diag) *D1 *D2)
      (&place_nearer *P (:D D1))
      (&place_nearer P (:D D2)))

    (RULE &mini
      (&center (:P *C))
      (OR ((&mark (:P *P_mark) *Col)
           (&view (:P P_mark) *P_inner)
           (&place_quadrant (:P P_inner) *Diag)
           (neighbor (:P C) (:D Diag) (:Q *P)))
          ((&center_paint (:C Col))
           (= P C)))))
  (ALT $Cross
    (INIT &dray Ray
      (source (P)
        (&mark *P))
      (node (P)
        (input *P))
      (dir (D)
        (diag_dir_elem *D)))

    (RULE &sees
      (&dray.ray *P *D *K (:Origin *M))
      (!= K 0))

    (RULE &unseen
      (&sees *P)
      (&mark (:P *M))
      (NOT (&sees M P)))

    (RULE &mini
      (&sees (:P *C))
      (NOT (&unseen (:P C)))
      (OR ((&sees *M (:P C) *D)
           (&mark (:P M) *Col)
           (diag_opposite D (:Opp *D_back))
           (neighbor (:P C) (:D D_back) (:Q *P)))
          ((&center_paint (:C Col))
           (= P C))))))

(RULE &output
  (OR ((&mini *P *Col))
      ((input P Col)
       (NOT (&mini P)))))

(OUT (&output ^P ^Col))
