(alts $c
  (alt $LargeByCount
    (witness thin-copy-strip borderline concept
      (separates "the copy shows one row of blocks and has fewer cells than the 3 shape: matching gives the 2 shape; taking the shape with the most cells as the copy finds no match and gives no output")
