(exclude ($FromPlace $Lost $FloorMoves) "A reading undefined where objects collide gives, wherever it is defined, the grid the same reading gives with either collision rule; of those readings only the concept case is a case.")
(exclude ($FromPlace $Clamp $FloorMoves) "A reading undefined where objects collide gives, wherever it is defined, the grid the same reading gives with either collision rule; of those readings only the concept case is a case.")
(exclude ($Clash &background=$Derived) "undefined where objects collide, and elsewhere it gives the output of the $LargerOnTop case")
(exclude ($Clash &floor_cell=$Stored) "undefined where objects collide, and elsewhere it gives the output of the $LargerOnTop case")
(exclude ($FloorLineOnly &floor_cell=$Stored) "the stored cells fix the floor, so these cases are equivalent to those that take $FloorColor")
(exclude ($FloorMoves &floor_cell=$Stored) "the stored cells fix the floor, so these cases are equivalent to those that take $FloorColor")

(alts $s
  (alt $FloorDerived
