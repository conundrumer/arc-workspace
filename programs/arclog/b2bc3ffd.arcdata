(alts $e
  (alt $FloorLineOnly
    (witness floor-colored-object borderline concept
      (separates "an object in the floor color stands on the floor: every floor-colored cell as floor keeps it; only the floor line as floor makes it jump by 2")
      (input (grid
        (7 7 7 7 7 7 7 7)
