(param &background Color (7))
(param &floor_side Dir (DIR_B))
(param &floor_color Color (8))

(exclude ($Clash $Clamp) "A reading undefined where objects collide gives, wherever it is defined, the grid the same reading gives with either collision rule; of those readings only the concept case is a case.")
(exclude ($Clash $Wrap) "A reading undefined where objects collide gives, wherever it is defined, the grid the same reading gives with either collision rule; of those readings only the concept case is a case.")
