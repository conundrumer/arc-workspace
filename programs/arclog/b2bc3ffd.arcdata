        (7 7 7 7 7 7 7 8)
        (7 7 7 7 7 7 7 8)
        (7 7 7 7 7 7 7 8)
        (8 6 7 7 7 7 7 7)))
      (output ($FloorDerived $FromPlace $Lost $SmallerOnTop &floor_cell=$Stored) (grid
        (7 7 7 7 7 7 7 5)
