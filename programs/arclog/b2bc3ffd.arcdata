(alts $ov
  (alt $Clamp
    (witness overflow borderline any
      (relaxed fits)
      (separates "an object whose count is more than the rows above it: the cells past the top edge are lost, the object stops against the top edge, or the cells wrap round onto the floor line, which gives no grid")
      (input (grid
