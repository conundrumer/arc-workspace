      (output ($FloorStored $FromPlace $Wrap &floor_cell=$Stored) ($FloorStored $FromFloor $Wrap &floor_cell=$Stored) ($FloorLineOnly $Wrap) undefined)
      (output ($FloorColor $FromPlace $Wrap $SmallerOnTop &floor_cell=$Derived) ($FloorMoves $SmallerOnTop) (grid
        (8 7 7 7 7 7 7 7)
