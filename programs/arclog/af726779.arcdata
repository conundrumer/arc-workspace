(param &background Color (3))
(param &growth_dir Dir (DIR_B))
(param &level_step number (2))
(param &level_colors (number Color) (0 7) (1 6))
(param &level_succ (Color Color) (7 6) (6 7))

(alts $color
  (alt $EvenColorOfBase
    (witness base-color-2 variant $EvenColorOfBase
      (relaxed base-line)
      (separates "a base line of color 2: the concept colors the even levels 7, $EvenColorOfBase colors them 2, and $ColorBySuccession has no color after 2 and adds no level")
      (input (grid
        (3 3 3 3 3 3 3 3 3)
        (3 2 3 2 3 2 3 2 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $Parity (grid
        (3 3 3 3 3 3 3 3 3)
        (3 2 3 2 3 2 3 2 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 6 3 6 3 6 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 7 3 7 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 6 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $ColorBySuccession (grid
        (3 3 3 3 3 3 3 3 3)
        (3 2 3 2 3 2 3 2 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $EvenColorOfBase $EvenColorRarest (grid
        (3 3 3 3 3 3 3 3 3)
        (3 2 3 2 3 2 3 2 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 6 3 6 3 6 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 2 3 2 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 6 3 3 3 3)
        (3 3 3 3 3 3 3 3 3))))
    (witness mixed-base borderline concept
      (relaxed base-line)
      (separates "a base line with one mark of 2 among marks of 7: $EvenColorOfBase finds no one color of the marks and draws no even level, $EvenColorRarest colors the even levels 2, and $ColorBySuccession adds no level")
      (input (grid
        (3 3 3 3 3 3 3 3 3)
        (3 7 3 7 3 2 3 7 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $Parity (grid
        (3 3 3 3 3 3 3 3 3)
        (3 7 3 7 3 2 3 7 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 6 3 6 3 6 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 7 3 7 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 6 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $ColorBySuccession (grid
        (3 3 3 3 3 3 3 3 3)
        (3 7 3 7 3 2 3 7 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $EvenColorOfBase (grid
        (3 3 3 3 3 3 3 3 3)
        (3 7 3 7 3 2 3 7 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 6 3 6 3 6 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 6 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))
      (output $EvenColorRarest (grid
        (3 3 3 3 3 3 3 3 3)
        (3 7 3 7 3 2 3 7 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 6 3 6 3 6 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 2 3 2 3 3 3)
        (3 3 3 3 3 3 3 3 3)
        (3 3 3 3 6 3 3 3 3)
        (3 3 3 3 3 3 3 3 3)))))
  (alt $EvenColorRarest
    (witness base-color-2 variant $EvenColorOfBase)
    (witness mixed-base borderline concept))
  (alt $ColorBySuccession
    (witness base-color-2 variant $EvenColorOfBase)))

(alts $scope
  (alt $Pooled
    (witness two-lines borderline $Pooled
      (relaxed background)
      (relaxed base-line)
      (separates "a second marked line four rows below the first, beside the first line's level 2: $PerLine grows a stack from each line, and $Pooled pools the two lines' marks on that row and grows one stack from them, which reaches two rows further")
      (input (grid
        (3 3 3 3 3 3 3 3 3 3 3)
        (7 3 7 3 7 3 7 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 7 3 7 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)))
      (output $PerLine (grid
        (3 3 3 3 3 3 3 3 3 3 3)
        (7 3 7 3 7 3 7 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 6 3 6 3 6 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 7 3 7 3 7 3 7 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 6 3 3 3 6 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)))
      (output $Pooled (grid
