        (7 3 7 3 7 3 7 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 6 3 6 3 6 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 7 3 7 3 7 3 7 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 6 3 6 3 6 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 7 3 7 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3))))))

(alts &background
  (alt &background=$Derived
    (witness background=DominantColor variant &background=$Derived
      (relaxed background)
      (separates "`background=DominantColor` from the stored value: train 0 with 3 and 0 swapped")
      (input (grid
