(param &shape.member (Ident Position)
  (0 (grid
    (_ 1 _)
    (1 1 1)
    (_ 1 _)))
  (1 (grid
    (1)
    (1)
    (1)))
  (2 (grid
    (1)
    (1)))
  (3 (grid
    (1 1)
    (_ 1)))
  (4 (grid
    (1 1 _)
    (_ 1 1)))
  (5 (grid
    (1 1 1)
    (1 1 1))))
(param &shape.pose2 (Ident D4)
  (0 D4_ID)
  (1 D4_ID)
  (2 D4_ID)
  (3 D4_ID)
  (4 D4_ID)
  (5 D4_ID))
(param &shape_color (Ident Color) (0 3) (1 2) (2 9) (3 4) (4 8) (5 5))
(param &box_key.extent (Ident Axis number)
  (0 AXIS_V 3)
  (0 AXIS_H 3)
  (1 AXIS_V 3)
  (1 AXIS_H 1)
  (2 AXIS_V 2)
  (2 AXIS_H 1)
  (3 AXIS_V 2)
