        (7 7 7 5 5 5 7 7 2)
        (7 7 7 7 7 7 7 7 7)
        (4 4 7 7 7 7 7 4 4)
        (7 4 7 7 7 6 1 7 4)
        (7 7 7 7 7 6 1 7 7)))
      (output $PerColorPieces (grid
