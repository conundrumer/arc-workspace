  (1 D4_ID)
  (2 D4_ID)
  (3 D4_ID)
  (4 D4_ID)
  (5 D4_ID))
(param &box_key_size (Ident number) (0 5) (1 3) (2 2) (3 3) (4 4) (5 6))
(param &box_key_color (Ident Color) (0 3) (1 2) (2 9) (3 4) (4 8) (5 5))

(exclude ($KeyedOnly $SizeBoxKey) "A case other than the concept that leaves a piece with no key undefined gives the grid of its $KeepUnknown copy wherever it is defined.")
(exclude ($KeyedOnly $NonBgCells) "A case other than the concept that leaves a piece with no key undefined gives the grid of its $KeepUnknown copy wherever it is defined.")
(exclude ($KeyedOnly &fg=$Derived) "subsumed by its $KeepUnknown copy, which gives the same grid wherever every piece has a key")

(alts $cells
  (alt $NonBgCells
    (witness other-color-piece borderline $NonBgCells
      (relaxed field)
      (separates "the plus is drawn in 1. The concept and $KeepUnknown leave it 1; $NonBgCells, $PerColorPieces and bg=DominantColor paint it 3.")
      (input (grid
        (7 1 7 7 6 6 7 7 7)
        (1 1 1 7 7 6 6 7 7)
        (7 1 7 7 7 7 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 7 7 7 7 7 7)
        (6 6 7 7 7 7 7 6 6)
        (7 6 7 7 7 6 7 7 6)
        (7 7 7 7 7 6 7 7 7)))
      (output ($FgPieces &fg=$Stored) (grid
        (7 1 7 7 8 8 7 7 7)
        (1 1 1 7 7 8 8 7 7)
        (7 1 7 7 7 7 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 7 7 7 7 7 7)
        (4 4 7 7 7 7 7 4 4)
        (7 4 7 7 7 9 7 7 4)
        (7 7 7 7 7 9 7 7 7)))
      (output &fg=$Derived (grid
        (7 3 7 7 6 6 7 7 7)
        (3 3 3 7 7 6 6 7 7)
        (7 3 7 7 7 7 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 7 7 7 7 7 7)
        (6 6 7 7 7 7 7 6 6)
        (7 6 7 7 7 6 7 7 6)
        (7 7 7 7 7 6 7 7 7)))
      (output $NonBgCells (grid
        (7 3 7 7 8 8 7 7 7)
        (3 3 3 7 7 8 8 7 7)
        (7 3 7 7 7 7 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 7 7 7 7 7 7)
        (4 4 7 7 7 7 7 4 4)
        (7 4 7 7 7 9 7 7 4)
        (7 7 7 7 7 9 7 7 7))))))

(alts $split
  (alt $PerColorPieces
    (witness two-color-piece borderline $PerColorPieces
      (relaxed field)
      (separates "a vertical domino of 1 touches the vertical domino of 6 side by side. The concept paints the 6 domino 9 and leaves the 1 domino; $PerColorPieces paints both 9; $NonBgCells reads one 2x2 piece with no key and is undefined.")
      (input (grid
        (7 6 7 7 6 6 7 7 7)
        (6 6 6 7 7 6 6 7 7)
        (7 6 7 7 7 7 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 6 6 6 7 7 6)
