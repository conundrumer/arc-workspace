        (7 7 7 7 7 7 7 7 7)
        (4 4 7 7 7 7 7 4 4)
        (7 4 7 7 7 9 7 7 4)
        (7 7 7 7 7 9 7 7 7))))))

(alts $unknown
  (alt $KeepUnknown
    (witness t-tetromino borderline concept)))

(alts &fg
  (alt &fg=$Derived
    (witness fg=RarestColor variant &fg=$Derived
      (relaxed field)
      (separates "colors of field and pieces swapped: the pieces are 7 on a field of 6. The concept reads the 6 field as one piece with no key and is undefined; fg=RarestColor and bg=DominantColor recolor the 7 pieces; $KeepUnknown returns the input.")
      (input (grid
