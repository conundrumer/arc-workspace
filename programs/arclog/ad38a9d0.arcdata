        (6 6 6 6 6 6 6 6 6)
        (4 4 6 6 6 6 6 4 4)
        (6 4 6 6 6 9 6 6 4)
        (6 6 6 6 6 9 6 6 6))))))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor variant &bg=$Derived
      (relaxed field)
      (separates "colors of field and pieces swapped: the pieces are 7 on a field of 6. $NonBgCells reads the 6 field as one piece with no key and is undefined; bg=DominantColor takes 6 as the field and recolors the 7 pieces.")
