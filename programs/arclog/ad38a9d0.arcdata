        (3 3 3 7 7 8 8 7 7)
        (7 3 7 7 7 7 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 5 5 5 7 7 2)
        (7 7 7 7 7 7 7 7 7)
        (4 4 7 7 7 7 7 4 4)
        (7 4 7 7 7 9 9 7 4)
        (7 7 7 7 7 9 9 7 7))))))

(alts $key
  (alt $SizeBoxKey
    (witness t-tetromino borderline concept
      (relaxed known-shapes)
      (separates "a T-tetromino stands where the Z was. The concept has no key for it under any value of shape_sym and is undefined; $SizeBoxKey matches it to the Z by its 4 cells and 2x3 box and paints it 8; $KeepUnknown leaves it 6.")
      (input (grid
        (7 6 7 7 7 6 7 7 7)
        (6 6 6 7 6 6 6 7 7)
        (7 6 7 7 7 7 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 6 6 6 7 7 6)
        (7 7 7 7 7 7 7 7 7)
        (6 6 7 7 7 7 7 6 6)
        (7 6 7 7 7 6 7 7 6)
        (7 7 7 7 7 6 7 7 7)))
      (output concept undefined)
      (output ($ShapeKey $KeepUnknown) (grid
