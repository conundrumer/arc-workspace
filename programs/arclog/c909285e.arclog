;; inputs e2a7184d37d87aee90641390a91b64ce638ed3f3b0ec2156aacb9141eac3b737 programs/solvers/c909285e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c909285e

(INPUT one-outline "one rectangle outline, one cell wide, sits on the pattern; it is a square in every input."

  (INIT &color_size Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &fewest Order
    (member ((:t (:V Col) (:S N)))
      (&color_size.size (:key *Col) *N))
    (score ((:t (:V Col) (:S N)) (:S N))
      (&color_size.size (:key *Col) *N)))

  (INIT &body8 Connectivity
    (key ((input *P ^Col))
      (node (P)
        (input *P Col)))
    (step ((:Delta S))
      (OR ((diag_dir_elem *D)
           (step_offset D (:V *S)))
          ((dir_elem (:D *D2))
           (step_offset (:D D2) (:V S))))))

  (INIT &body4 Connectivity
    (key ((input *P ^Col))
      (node (P)
        (input *P Col)))))

(INPUT outline-color-unique "the outline's color appears nowhere else in the input.")

(OUTPUT crop-outline "the output is the input cropped to the outline's box, the outline included, with every cell copied as it is."

  (INIT &outlines Outlines
    (key ((input *P ^Col))
      (node (P)
        (input *P Col))))

  (RULE &stray
    (&outlines.box (:key *Col) *B)
    (input *P Col)
    (OR ((NOT (inside (:A P) B)))
        ((interior (:A P) B))))

  (RULE &source_color
    (&outlines.box (:key *Col) *B)
    (NOT (&stray Col B)))

  ;; The one proposed color; two proposed colors leave the case undefined.
  (INIT &chosen Singleton
    (member ((:v Col))
      (&source_color *Col)))

  (INIT &box BoundingBox
    (cell (P)
      (&chosen.value (:v *Col))
      (input *P Col))))

(ALTS $choice "which cells give the box that is cropped" $Outline
  (ALT $RarestColor
    (INPUT one-outline "the box is the bounding box of the color that covers the fewest cells; undefined where two colors tie for fewest."
      (RULE &source_color
        (&fewest.minimal (:t (:V *Col)))))
    (INPUT outline-color-unique "no claim; the cells of the rarest color may lie anywhere."))
  (ALT $OneBodyColor
    (INPUT one-outline "the box is the bounding box of the one color whose cells form one body; undefined where no color does, or more than one does."
      (RULE &split_color
        (&body8.component (:key *Col) (:Id *Id1))
        (&body8.component (:key Col) (:Id *Id2))
        (!= Id1 Id2))

      (RULE &source_color
        (input *Col)
        (NOT (&split_color Col))))
    (ALTS $adjacency "which cells of one color join into one body" $CornerContact
      (ALT $EdgeContact
        (INPUT one-outline "the body is joined by 4-adjacency."
          (RULE &split_color
            (&body4.component (:key *Col) (:Id *Id1))
            (&body4.component (:key Col) (:Id *Id2))
            (!= Id1 Id2))))))
  (ALT $InteriorColor
    (INPUT one-outline "the box is the bounding box of the one color that no edge cell holds; undefined where no color, or more than one, keeps off the edge."
      (RULE &edge_color
        (input *P *Col)
        (margin (:B P) *D (:K 0)))

      (RULE &source_color
        (input *Col)
        (NOT (&edge_color Col))))))

(RULE &output
  (&box.box *B)
  (input (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(OUT (&output ^P ^Col))
