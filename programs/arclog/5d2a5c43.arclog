;; inputs 6ebf832f12c2384475d6d990afd86549008596a5591ed8d120aaa60e09652db2 programs/solvers/5d2a5c43.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5d2a5c43

(DET &frame_dim ConstOutDimAxis)

;; width of the separator between the two tiles
(DET &gap DivisorRatio)

(DET &arr_dim SepTileCountAxis)

(INIT &tile_decompose_outer Frame
  (extent (A N)
    (&arr_dim *A *N)))

(INIT &tile_decompose_inner Frame
  (extent (A N)
    (&frame_dim *A *N)))

(INIT &tile_decompose_tiling Tiling
  (outer (P)
    (&tile_decompose_outer.cell *P))
  (inner (P)
    (&tile_decompose_inner.cell *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &divide_axis AxisDomain)

(DET &combine PanelCombine)

(RULE &decompose
  (&tile_decompose_tiling.cell *P *P_outer *P_inner))

(ALTS $d "how the two tiles are found" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&frame_dim A (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(ALTS $b "how a pair of tile cells combines into the output cell's color" $Lookup
  (ALT $Or
    (INIT &frame_frame Frame
      (extent (A N)
        (&frame_dim *A *N)))

    (DET &bg ChangedColor)

    (DET &out_fill AnyOutNewColor)

    (RULE &filled
      (input (:P *P_grid_in) *Col)
      (NOT (&bg (:C Col)))
      (&decompose (:P P_grid_in) (:P_inner *O)))

    (RULE &output
      (&frame_frame.cell *P)
      (IF ((&filled (:O P)))
          ((&out_fill (:C *Col)))
          ((&bg (:C Col)))))))

(INIT &combine_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_outer) (:Col C)))
    (&combine *Id (:P *P_outer) *C))
  (observed ((:observed P_grid_out) (:m (:P P_tile) (:Col C)))
    (&decompose (:P *P_grid_in) (:P_outer *P_tile) (:P_inner *P_grid_out))
    (input (:P P_grid_in) (:Col *C))))

(RULE &output
  (&combine *Id (:C_out *Col))
  (&combine_match.equal (:observed *P) (:pattern Id)))

(OUT (&output ^P ^Col))
