;; inputs b2890634f66eb24d274b025365cfdd04281a875bd60f47c8cdbcb1e886def218 programs/solvers/97d7923e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 97d7923e

;; The edge the headers lie on. The runs go inward from it, and the bars lie along its axis.
(DET &head_dir DirDomain)

(RULE &inward
  (&head_dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

;; The train pairs admit a second color; the DominantColor proposer, exact here, fixes this value.
(DET &bg DominantColor)

(RULE &run_node
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

;; Every run of one color, inward.
(INIT &run Ray
  (key ((OR ((&run_node (:Key ^Ky) *P))
            ((&run_node (:Key Ky))
             (&inward (:D *D_in)))))
    (source (P)
      (&run_node (:Key Ky) *P))
    (node (P)
      (&run_node (:Key Ky) *P))
    (dir ((:D D_in))
      (&run_node (:Key Ky))
      (&inward (:D *D_in)))))

(RULE &run_run_full
  (&run.ray (:key (:Ky *V0)) (:P *V3) (:D *V2) (:K *N) (:Origin *V1))
  (!= N 0))

(RULE &header
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&head_dir *D)
  (margin (:B P) D (:K 0)))

(RULE &reach
  (&header *Col *P)
  (&inward (:D *D_in))
  (&run.end (:key (:Ky Col)) (:P *P_end) (:D D_in) (:Origin P))
  (&head_dir *D)
  (margin (:B P_end) D *K))

(RULE &bar
  (input (:P *P_cap) *Col)
  (NOT (&bg (:C Col)))
  (&inward (:D *D_in))
  (neighbor (:P P_cap) (:D D_in) (:Q *P_first))
  (input (:P P_first) (:Col *Body))
  (NOT (&bg (:C Body)))
  (!= Body Col)
  (&run.end (:key (:Ky Body)) (:P *P_last) (:D D_in) (:Origin P_first))
  (neighbor (:P P_last) (:D D_in) (:Q *P_tail))
  (input (:P P_tail) Col))

(RULE &bar_cell
  (&bar *Col *P_cap *Body *P_first)
  (&inward (:D *D_in))
  (OR ((&run_run_full (:V0 Body) (:V1 P_first) (:V2 D_in) (:V3 *P)))
      ((= P P_first))))

(INIT &bar_size Cardinality
  (key ((&bar_cell ^Col ^P_cap *P))
    (member ((:m P))
      (&bar_cell Col P_cap *P))))

(INIT &bar_ord Order
  (key ((OR ((&bar ^Col *P_cap))
            ((&bar_size.size (:key Col P_cap) *N))))
    (member ((:t P_cap))
      (&bar Col *P_cap))
    (score ((:t P_cap) (:S N))
      (&bar_size.size (:key Col *P_cap) *N))))

(ALTS $choice "how the bars of one cap color rank" $Size
  (ALT $Head
    (INIT &bar_ord Order
      (key ((&bar ^Col *P_cap))
        (member ((:t P_cap))
          (&bar Col *P_cap))
        (score ((:t P_cap) (:S K))
          (&bar Col *P_cap)
          (&head_dir *D)
          (margin (:B P_cap) D *K))))

    ;; The nearest first.
    (RULE &taken
      (&reach (:Col *Key) *K)
      (&bar_ord.rank (:key (:Col Key)) (:t *P_cap) (:R K)))))

;; The longest first.
(RULE &taken
  (&reach (:Col *Key) *K)
  (&bar_ord.dual_rank (:key (:Col Key)) (:t *P_cap) (:R K)))

(RULE &fill
  (&taken (:Key *Col) *P_cap)
  (&bar_cell Col P_cap *P))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))

(OUT (&output ^P ^Col))
