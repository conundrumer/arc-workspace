(alts $f
  (alt $AxisByShape
    (witness short-axis-facing variant concept
      (separates "the blocks face along the vertical axis of a 10x12 frame, its shorter axis; the concept fills rows 3-4 and 5-6, $AxisByShape takes the horizontal axis, finds no two blocks at its ends, and is undefined")
      (input (grid
        (3 3 3 3 3 3 3 3 3 3 3 3)
        (3 8 8 8 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 8 8 8 3)
        (3 3 3 3 3 3 3 3 3 3 3 3)
