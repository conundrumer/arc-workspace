;; inputs d1dd993f5a04692f42a78ce79f6998b53d79638a8e33f1f3c4e171822d1eabee programs/solvers/12997ef3.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 12997ef3

(DET &bg DominantColor)

(DET &stencil VanishedColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&stencil (:C Col))))

(RULE &off_axis
  (&mark (:P *P1))
  (&mark (:P *P2))
  (split (:P P1) *A (:Across *X1))
  (split (:P P2) A (:Across *X2))
  (!= X1 X2))

(RULE &layout_axis
  (axis_elem *A)
  (NOT (&off_axis A)))

(INIT &order Order
  (key ((&layout_axis (:A ^A2))
        (axis_of ^D (:A A2)))
    (before ((:a P) (:b P2))
      (&mark *P)
      (&layout_axis *A)
      (split P A (:Along *P_along))
      (&mark (:P *P2))
      (&layout_axis (:A *A22))
      (split (:P P2) (:A A22) (:Along *P_along2))
      (!= P P2)
      (margin (:B P_along) D (:K *K1))
      (margin (:B P_along2) D (:K *K2))
      (< K1 K2)))
  (member ((:t P))
    (&mark *P)
    (&layout_axis *A)
    (split P A (:Along *P_along))))

(RULE &order_pos
  (&order.rank (:key (:A2 *A) *D) (:t *M) (:R *R1))
  (&order.dual_rank (:key (:A2 A) D) (:t M) (:R *R2))
  (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

(RULE &stencil_cell
  (input *P *Col)
  (&stencil (:C Col)))

(INIT &bbox BoundingBox
  (cell (P)
    (&stencil_cell *P)))

(INIT &place_tiling Tiling
  (outer ((:P P_tile))
    (&mark (:P *P_mark))
    (&order_pos (:M P_mark) (:P_pos *P_tile)))
  (inner ((:P P_intile))
    (&bbox.box *B)
    (input (:P *P_grid_in))
    (inside (:A P_grid_in) B)
    (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))))

(RULE &place
  (&layout_axis)
  (&mark (:P *P_mark) (:Col *Col_mark))
  (&order_pos (:M P_mark) (:P_pos *P_tile))
  (&bbox.box *B)
  (input (:P *P_grid_in))
  (inside (:A P_grid_in) B)
  (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))
  (&place_tiling.cell (:P_outer P_tile) (:P_inner P_intile) (:P *P_grid_out)))

(ALTS $choice "whether a tile reproduces the box's other content" $Stamp
  (ALT $Recolor
    (RULE &output
      (&place (:P_grid_out *P) *P_grid_in *Col_mark)
      (OR ((NOT (&stencil_cell (:P P_grid_in)))
           (input (:P P_grid_in) *Col))
          ((&stencil_cell (:P P_grid_in))
           (= Col Col_mark))))))

(RULE &output
  (&place (:P_grid_out *P) *P_grid_in *Col_mark)
  (OR ((NOT (&stencil_cell (:P P_grid_in)))
       (&bg (:C *Col)))
      ((&stencil_cell (:P P_grid_in))
       (= Col Col_mark))))

(OUT (&output ^P ^Col))
