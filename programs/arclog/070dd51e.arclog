;; inputs fb079684722d960f1f5b79558e57fa8514b7d6f107b1b787bffc59b9040f2636 programs/solvers/070dd51e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 070dd51e

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bet Ray
  (key ((OR ((&mark ^Col *P))
            ((&mark Col)
             (axis_elem *A)
             (axis4_of *D A))
            ((&mark Col)
             (input P))))
    (source (P)
      (&mark Col *P))
    (node (P)
      (&mark Col)
      (input *P))
    (dir (D)
      (&mark Col)
      (axis_elem *A)
      (axis4_of *D A))))

(RULE &bet_between
  (&mark (:Col *Key))
  (input *P)
  (axis_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&bet.ray (:key (:Col Key)) P D)
  (&bet.ray (:key (:Col Key)) P (:D O)))

(DET &over_axis AxisDomain)

(RULE &line_axis
  (&mark *Col *P)
  (&mark Col (:P *Q))
  (!= P Q)
  (axis_elem *A)
  (same_line A P Q))

(RULE &span
  (&bet_between (:Key *Col) *P)
  (&line_axis Col *A))

(RULE &over_span
  (&span *P *A)
  (&over_axis A))

(RULE &top_span
  (OR ((&span *P *Col *A)
       (&over_axis A))
      ((&span P Col)
       (NOT (&over_span P)))))

(ALTS $choice "Cases split what a span may paint" $PaintAll
  (ALT $PaintBg
    (RULE &output
      (OR ((input *P (:Col *Bg))
           (&bg (:C Bg))
           (OR ((&top_span P *Col))
               ((NOT (&top_span P))
                (= Col Bg))))
          ((input P Col)
           (NOT (&bg (:C Col))))))))

(RULE &output
  (OR ((&top_span *P *Col))
      ((input P Col)
       (NOT (&top_span P)))))

(OUT (&output ^P ^Col))
