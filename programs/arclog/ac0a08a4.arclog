;; inputs 822571de5e2bc71103f9f5acd071cfb45b5cf8033bdb17a0b0f6d83bd05e06fb programs/solvers/ac0a08a4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; ac0a08a4

(DET &bg DominantColor)

(RULE &on
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &cell_count Cardinality
  (member ((:m P))
    (&on *P)))

(INIT &block Frame
  (extent (A N)
    (axis_elem *A)
    (&cell_count.size *N)))

(ALTS $choice "how N is counted" $Cells
  (ALT $Colors
    (INIT &palette Cardinality
      (member ((:m Col))
        (&on *Col)))

    (INIT &block Frame
      (extent (A N)
        (axis_elem *A)
        (&palette.size *N)))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&block.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&block.cell (:P *P_intile))
  (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
