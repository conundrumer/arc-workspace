;; inputs 1b6e78bff80f43a158ce16a7e9098b8f58b94b74e5b9a335e95133b5f890373a programs/solvers/6d0160f0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6d0160f0

(DET &gap DivisorRatio)

(DET &tile_dim SepTileCount)

(INIT &tile_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A K)
    (axis_elem *A)
    (&tile_dim (:N *K)))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &bg DominantColor)

(DET &marker RarestColor)

(RULE &marked
  (input *P *Col)
  (&marker (:C Col))
  (&tile_division.tile P (:P_outer *P_src) (:P_inner *P_dst)))

(RULE &output
  (OR ((&tile_division.tile *P (:P_outer *P_tile) (:P_inner *P_intile))
       (OR ((&marked *P_src (:P_dst P_tile))
            (&tile_division.tile (:P *P_in) (:P_outer P_src) (:P_inner P_intile))
            (input (:P P_in) *Col))
           ((NOT (&marked (:P_dst P_tile)))
            (&bg (:C Col)))))
      ((input P Col)
       (NOT (&tile_division.tile P)))))

(OUT (&output ^P ^Col))
