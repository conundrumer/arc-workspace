;; inputs 61e74d091cada01477d0187d6f4843f26d27374a21054cb83ee63001988a6560 programs/solvers/90f3ed37.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 90f3ed37

(DET &bg DominantColor)

;; The direction the shapes run in.
(DET &grow_dir DirDomain)

;; The side, across the growth, that the shapes align on.
(DET &align_sense SenseDomain)

;; The color the completion is drawn in.
(DET &mark AnyOutNewColor)

(RULE &anchor_corner
  (&grow_dir (:D *D2))
  (opposite (:D D2) (:Opp *Back))
  (&align_sense *S)
  (turn S (:D D2) (:D2 *D_align))
  (diag_dirs *D (:D1 Back) (:D2 D_align)))

(RULE &grow_axis
  (&grow_dir *D)
  (axis_of D *A))

(RULE &fg
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &runs Connectivity
  (node ((:P L))
    (&fg *P)
    (&grow_axis *A)
    (split P A (:Across *L))))

(RULE &shape
  (&fg *P)
  (&grow_axis *A)
  (split P A (:Across *L))
  (&runs.component (:P L) *Id))

(ALTS $parse "What a shape is." $Lines
  (ALT $Objects
    (INIT &blobs Connectivity
      (node (P)
        (&fg *P))
      (step ((:Delta S))
        (OR ((diag_dir_elem *D)
             (step_offset D (:V *S)))
            ((dir_elem (:D *D2))
             (step_offset (:D D2) (:V S))))))

    (RULE &shape
      (&blobs.component *P *Id))))

(ALTS $select "Which shape is the full one." $Edge
  (ALT $Furthest
    (INIT &nearest Order
      (member ((:t (:V Id) (:S K)))
        (&shortfall *Id *K))
      (score ((:t (:V Id) (:S K)) (:S K))
        (&shortfall *Id *K)))

    (RULE &template
      (&nearest.minimal (:t (:V *Id))))))

(ALTS $anchor "What a shape's anchor is read from." $Extent
  (ALT $Ink
    (INIT &corner_cell Order
      (key ((&shape ^Id *P)
            (&anchor_corner (:D *Diag))
            (corner_dist P Diag *K))
        (member ((:t (:V P) (:S K)))
          (&shape Id *P)
          (&anchor_corner (:D *Diag))
          (corner_dist P Diag *K))
        (score ((:t (:V P) (:S K)) (:S K))
          (&shape Id *P)
          (&anchor_corner (:D *Diag))
          (corner_dist P Diag *K))))

    (RULE &anchor
      (&corner_cell.minimal (:key *Id) (:t (:V *P))))))

(ALTS $place "How the full shape lands on a shape." $Corner
  (ALT $Across
    (RULE &seat
      (&shift *Id_full *Id *V)
      (&shape (:Id Id_full) (:P *P_full))
      (&grow_axis *A)
      (split (:P V) A (:Across *V_across))
      (compose (:A P_full) (:B V_across) (:C *P)))))

(INIT &bb BoundingBox
  (key ((&shape ^Id *P))
    (cell (P)
      (&shape Id *P))))

(RULE &anchor
  (&bb.box (:key *Id) *B)
  (&anchor_corner (:D *Diag))
  (input *P)
  (inside (:A P) B)
  (same_corner (:D Diag) (:P1 P) (:P2 B)))

(RULE &shortfall
  (&bb.box (:key *Id) *B)
  (&grow_dir *D)
  (margin B D *K))

(RULE &template
  (&shortfall *Id (:K 0)))

(RULE &shift
  (&template (:Id *Id_full))
  (&anchor (:Id Id_full) (:P *A_full))
  (&anchor *Id (:P *A))
  (relative (:Base A_full) (:X A) (:X_rel *V)))

(RULE &seat
  (&shift *Id_full *Id *V)
  (&shape (:Id Id_full) (:P *P_full))
  (compose (:A P_full) (:B V) (:C *P)))

(RULE &restored
  (&seat *Id *P)
  (input P)
  (&bb.box (:key Id) *B)
  (&grow_dir *D)
  (nearer D P (:Q B)))

(RULE &output
  (OR ((&restored *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&restored P)))))

(OUT (&output ^P ^Col))
