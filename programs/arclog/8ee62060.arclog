;; inputs 81809f7234a48c9821fa81f8dbf111bc33ba14a2de7a0431913ae749ec708759 programs/solvers/8ee62060.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8ee62060

(INPUT diagonal "the grid divides into blocks of &block_size, and the blocks that hold content sit on one diagonal of the block-grid."

  (DET &block_size TileDim)

  (INIT &block_division Division
    (cell (P)
      (input *P))
    (side (A K)
      (axis_elem *A)
      (&block_size (:D *K))))

  (INIT &block_src_division Division
    (cell (P)
      (input *P))
    (side (A K)
      (axis_elem *A)
      (&block_size (:D *K))))

  (RULE &block_src
    (input (:P *P2) (:Col *V))
    (&block_src_division.tile (:P P2) (:P_outer *P) (:P_inner *Key)))

  ;; At each within-block offset, the input's block-grid, matched against
  ;; itself.
  (INIT &block Agreement
    (key ((OR ((input *P *Col)
               (&block_division.tile P (:P_outer *P_block) (:P_inner ^P_local)))
              ((&block_src (:Key P_local) (:P P_block) (:V Col)))))
      (source ((:P P_block) (:v Col))
        (input *P *Col)
        (&block_division.tile P (:P_outer *P_block) (:P_inner P_local)))
      (target ((:P P_block) (:v Col))
        (&block_src (:Key P_local) (:P *P_block) (:V *Col))))))

(OUTPUT swap "each block keeps its contents, and moves in the block-grid by each D4 element that moves some block of the input onto a block of other content; the model is undefined where two such elements put different colors on one cell.")

(INIT &output_tiling Tiling
  (key ((OR ((&block_src (:P *P_block_in) (:V ^Col))
             (&block.mismatch *D)
             (apply D (:P P_block_in) (:P_out *P_block_out)))
            ((&block_src (:Key *P_local) (:V Col)))))
    (outer ((:P P_block_out))
      (&block_src (:P *P_block_in) (:V Col))
      (&block.mismatch *D)
      (apply D (:P P_block_in) (:P_out *P_block_out)))
    (inner ((:P P_local))
      (&block_src (:Key *P_local) (:V Col)))))

(RULE &output
  (&block_src (:Key *P_local) (:P *P_block_in) (:V *Col))
  (&block.mismatch *D)
  (apply D (:P P_block_in) (:P_out *P_block_out))
  (&output_tiling.cell (:key Col) (:P_outer P_block_out) (:P_inner P_local) *P))

(OUT (&output ^P ^Col))
