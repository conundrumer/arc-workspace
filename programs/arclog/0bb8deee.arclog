;; inputs 2ca699de7d0656fd15b91ca50633d722838beb4a9157c669b178324dc52b19fc programs/solvers/0bb8deee.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 0bb8deee

(DET &bg DominantColor)

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

;; Divider: a line of one non-bg color.
(RULE &frame_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D (:K *K2)))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K2))
      (input *P)
      (margin (:B P) D (:K *K2)))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D (:K *K2))
  (&frame_rank.rank (:key D) (:t K2) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each quadrant viewed from the bounding box of the shape it holds.
(INIT &hull BoundingBox
  (key ((&frame_tile_of *P ^P_tile)
        (input P *Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (&frame_tile_of *P P_tile)
      (input P *Col)
      (NOT (&bg (:C Col))))))

(RULE &crop_cell
  (&frame_tile_of *P *P_tile)
  (input P *Col)
  (&hull.box (:key P_tile) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(INIT &output_tiling Tiling
  (key ((OR ((&crop_cell *P_tile ^Col))
            ((&crop_cell *P_intile Col))))
    (outer ((:P P_tile))
      (&crop_cell *P_tile Col))
    (inner ((:P P_intile))
      (&crop_cell *P_intile Col))))

(ALTS $choice "how the crops are reassembled" $Concat
  (ALT $Place
    (DET &shape_color
      (&frame_tile_of *E *P *P_tile)
      (ex_input E P *Col)
      (NOT (&bg (:C Col))))

    ;; A crop keeps its shape's color, so its box in the output canvas is
    ;; that color's bounding box in the example output.
    (INIT &obox BoundingBox
      (key ((ex_output ^E *P *Col)
            (&shape_color E ^P_tile Col))
        (cell (P)
          (ex_output E *P *Col)
          (&shape_color E P_tile Col))))

    (DET &tile_box
      (&obox.box (:key *P_tile) *B))

    (RULE &output
      (&crop_cell *P_tile *P_intile *Col)
      (&tile_box P_tile *B)
      (compose (:A B) (:B P_intile) (:C *P)))))

(RULE &output
  (&crop_cell *P_tile *P_intile *Col)
  (&output_tiling.cell (:key Col) (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
