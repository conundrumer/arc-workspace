;; inputs 85e82c1a18da5897ec5cdc42ef115bfce50fc3403eb2b5729a42dbdce9d65e33 programs/solvers/90c28cc7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 90c28cc7

(DET &bg DominantColor)

(INIT &region_box BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

;; The bounding box, read in its own frame, with the bg cells inside it.
(RULE &region
  (input (:P *P2) *Col)
  (&region_box.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(ALTS $choice "What the layout's region is." $Box
  (ALT $Cells
    (RULE &region
      (input *P *Col)
      (NOT (&bg (:C Col))))))

(RULE &line_cell
  (&region *P *Col)
  (split P *A (:Along *P_line) (:Across *P_across)))

(RULE &differ
  (&line_cell *A *P_line (:P_across *X) *Col)
  (axis_of *D A)
  (neighbor (:P P_line) D (:Q *P_line2))
  (&line_cell A (:P_line P_line2) (:P_across X) (:Col *Col2))
  (!= Col Col2))

(RULE &uncut
  (&line_cell *A (:P_line *L))
  (&line_cell A (:P_line *L2))
  (axis_of *D A)
  (neighbor (:P L) D (:Q L2))
  (NOT (&differ A (:P_line L) (:P_line2 L2))))

;; A band is a run of lines that no boundary cuts.
(INIT &bands Quotient
  (edge ((:a A (:P_line L)) (:b A P_line))
    (OR ((&uncut *A *L (:L2 *P_line)))
        ((&line_cell A (:P_line L))
         (= P_line L)))))

;; One output line per band. Band line sets are disjoint runs, as OrderFrame
;; assumes.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t Bd))
      (&bands.class (:a A (:P_line *L)) (:Id *Bd)))
    (before ((:a Bd) (:b Bd2))
      (&bands.class (:a A (:P_line *L)) (:Id *Bd))
      (&bands.class (:a A (:P_line *L2)) (:Id *Bd2))
      (!= Bd Bd2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) D) (:t M) (:R *R2))
  (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

(RULE &output
  (&line_cell *A (:P_line *L) (:P_across *L2) *Col)
  (perp A *A2)
  (&bands.class (:a A (:P_line L)) (:Id *Bd))
  (&bands.class (:a (:A A2) (:P_line L2)) (:Id *Bd2))
  (&layout_pos (:Key A) (:M Bd) (:P_pos *P_line))
  (&layout_pos (:Key A2) (:M Bd2) (:P_pos *P_line2))
  (compose (:A P_line) (:B P_line2) (:C *P)))

(OUT (&output ^P ^Col))
