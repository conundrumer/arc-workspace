;; inputs fb58884c4244101dcd5468a0834fc4fa1f7102fd1f584db4f6d0bd92be74f563 programs/solvers/f5b8619d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; f5b8619d

(DET &axis AxisDomain)

(DET &bg DominantColor)

(RULE &marked
  (input *P *Col)
  (&bg (:C Col))
  (input (:P *Q) (:Col *M))
  (NOT (&bg (:C M)))
  (&axis *A)
  (same_line A P Q))

(DET &shade AnyOutNewColor)

(RULE &repainted
  (OR ((&marked *P)
       (&shade (:C *Col)))
      ((input P Col)
       (NOT (&marked P)))))

;; 2×2 tile arrangement.
(DET &tile_dim ScaleRatio)

(INIT &tile_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&tile_dim (:K *N))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&tile_frame.cell (:P *P_tile)))
  (inner ((:P P_in))
    (&repainted (:P *P_in))))

(RULE &output
  (&repainted (:P *P_in) *Col)
  (&output_tiling.cell (:P_inner P_in) *P))

(OUT (&output ^P ^Col))
