(alts $select
  (alt $MarkerByColor
    (witness marker-color variant concept
      (relaxed one-marker)
      (separates "a marker of color 3 in place of 8: $MarkerByColor finds no cell of color 8 and gives the input; every other branch draws the staircase from the 3 cell")
      (input (grid
