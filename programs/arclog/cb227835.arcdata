(alts $choice
  (alt $NonBackground
    (witness markers-mixed-colors borderline $NonBackground
      (relaxed two-markers)
      (separates "One mark is 8 and the other is 2: the concept finds one marker of the stored color and returns the input; the rarest-color reading (a tie of 8 and 2) and the non-background reading take both marks and draw the outline.")
