  (alt &background=$Derived
    (witness background=DominantColor variant concept
      (relaxed two-markers)
      (separates "The field is 5 and the marks are 8: the concept and the rarest-color reading draw the outline on the 5 field; the non-background reading at the stored background 0 finds every cell a marker and is undefined; with the background derived as the dominant color it draws the outline.")
