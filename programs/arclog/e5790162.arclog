;; inputs 9dc1791663d941d82164ea323f7ff0a8731a98a93eb9b2adabec1cfa32718ace programs/solvers/e5790162.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e5790162

(INPUT start-cell "one cell of path_color 3 sits on the frame edge opposite start_dir, and every other cell that is not background 0 is a marker."

  (DET &painted
    (ex_output *E *P *Col)
    (ex_input E P (:Col *Col0))
    (!= Col Col0))

  (DET_OR_RULE &background DominantColor
    (&painted *E *P)
    (ex_input E P (:Col *C)))

  (DET &path_color
    (&painted *Col))

  (DET &line
    (&path_color *Col)
    (ex_output *E *P Col))

  (DET &turn_sense
    (&line *E *P)
    (opposite (:D *W) (:Opp *W_back))
    (neighbor P (:D W) *Q)
    (ex_input E (:P Q) *Col)
    (NOT (&line E (:P Q)))
    (NOT (&background (:C Col)))
    (neighbor P (:D W_back) (:Q *P_back))
    (&line E (:P P_back))
    (turn *S (:D W) (:D2 *W2))
    (neighbor P (:D W2) (:Q *R))
    (&line E (:P R)))

  (INIT &plain Singleton
    (member ((:v Col))
      (input *Col)
      (NOT (&background (:C Col)))
      (NOT (&turn_sense Col)))))

(INPUT every-marker-met "each marker is the cell directly ahead of the line at one of its turns.")

(INPUT line-exits "the line reaches the frame edge without a crossing of itself and without a marker directly ahead of a cell where it turns.")

(OUTPUT walk "the line starts at the start cell with heading start_dir, and steps one cell along the heading at a time."

  (RULE &marker
    (input *P *Col)
    (&turn_sense Col *S))

  (RULE &line_color
    (&path_color *Col))

  (RULE &start
    (&line_color *Col)
    (input *P Col))

  (RULE &sight_blocked
    (&start (:P *Key))
    (&marker *P))

  (RULE &sight_dir
    (&start (:P *Key))
    (dir_elem *D))

  ;; The first marker in line with a start cell, toward each direction.
  (INIT &sight Ray
    (key ((OR ((&start ^P))
              ((&sight_dir (:Key P) *D))
              ((&sight_dir (:Key P))
               (input (:P *P2))
               (NOT (&sight_blocked (:Key P) (:P P2))))))
      (source (P)
        (&start P))
      (node ((:P P2))
        (&sight_dir (:Key P))
        (input (:P *P2))
        (NOT (&sight_blocked (:Key P) (:P P2))))
      (dir (D)
        (&sight_dir (:Key P) *D))))

  (INIT &sight_full Ray
    (key ((OR ((&start ^P))
              ((&sight_dir (:Key P) *D))
              ((&sight_dir (:Key P))
               (input (:P *P2)))))
      (source (P)
        (&start P))
      (node ((:P P2))
        (&sight_dir (:Key P))
        (input (:P *P2)))
      (dir (D)
        (&sight_dir (:Key P) *D))))

  (RULE &sight_stop_full
    (&sight.end (:key (:P *V0)) (:P *E1) (:D *V2) (:Origin *V4))
    (neighbor (:P E1) (:D V2) (:Q *V1))
    (&sight_full.ray (:key (:P V0)) (:P V1) (:D V2) (:K *V3) (:Origin V4)))

  (INIT &nearest Order
    (key ((&sight_stop_full (:V0 ^P) (:V2 *D) (:V3 *K) (:V4 P))
          (dir_elem D))
      (member ((:t (:V D) (:S K)))
        (&sight_stop_full (:V0 P) (:V2 *D) (:V3 *K) (:V4 P))
        (dir_elem D))
      (score ((:t (:V D) (:S K)) (:S K))
        (&sight_stop_full (:V0 P) (:V2 *D) (:V3 *K) (:V4 P))
        (dir_elem D)))))

(OUTPUT turn-at-marker "when the next cell ahead is a marker, the line turns a quarter turn in the sense turn_sense gives for that marker's color, and continues from the cell it is at.")

(OUTPUT stop-at-edge "the line stops when the next cell ahead is outside the frame.")

(OUTPUT paint-line "each cell the line visits takes path_color, and every other cell keeps its input color."

  (DET &start_dir
    (&path_color *Col)
    (ex_input *E *P Col)
    (dir_elem *D)
    (neighbor P D *Q)
    (&painted E (:P Q)))

  (RULE &aim
    (&start *P)
    (&start_dir *D))

  (RULE &turn_at
    (input *P)
    (dir_elem (:D *W))
    (neighbor P (:D W) *Q)
    (&marker (:P Q) *S)
    (turn S (:D W) (:D2 *W2)))

  (RULE &turned
    (&turn_at *P *W *W2))

  (RULE &passable
    (input *P)
    (NOT (&marker P)))

  ;; The line's walk: from each start cell along its heading, turning in place
  ;; where a marker is ahead and stepping onto a passable cell otherwise.
  (INIT &walk Propagation
    (source ((:n P (:W D)))
      (&start *P)
      (&aim P *D))
    (edge ((:a P W) (:b (:P S2_p) (:W S2_w)))
      (input *P)
      (OR ((&turned P *W (:W2 *S2_w))
           (= *S2_p P))
          ((dir_elem (:D W))
           (neighbor P (:D W) (:Q S2_p))
           (&passable (:P S2_p))
           (= S2_w W))))))

(ALTS $h "what gives the heading of the line's first step" $StoredDir
  (ALT $HeadAwayFromEdge
    (OUTPUT walk "the line heads away from the one frame edge the start cell is on; undefined where the start cell is on no frame edge or on two."
      (RULE &aim
        (&start *P)
        (margin (:B P) (:D *D2) (:K 0))
        (opposite (:D D2) (:Opp *D)))))
  (ALT $HeadTowardMarker
    (OUTPUT walk "the line heads toward the nearest marker in line with the start cell; undefined where no marker is in line with it, or where two are nearest at one distance."
      (RULE &aim
        (&nearest.minimal (:key *P) (:t (:V *D)))))))

(ALTS $c "what gives the color of the start cell and of the line" $StoredColor
  (ALT $StartIsNonMarker
    (INPUT start-cell "the start cell's color is the one color of the input that is not background and has no turn_sense row; undefined where the input holds no such color or more than one."
      (RULE &line_color
        (&plain.value (:v *Col))))))

(ALTS $b "what the line does when a marker is directly ahead after a turn" $TurnAgain
  (ALT $StopWhenBlocked
    (OUTPUT turn-at-marker "the line stops where a marker is directly ahead of it after a turn."
      (RULE &turned
        (&turn_at *P *W *W2)
        (NOT (&turn_at P (:W W2)))))))

(ALTS $t "what the line does when it meets its own trail" $CrossTrail
  (ALT $StopAtTrail
    (OUTPUT walk "the line stops before a cell it has already visited."

      ;; The step count at which each line reaches each state.
      (INIT &trail Distance
        (key ((OR ((&walk.source (:n (:P ^S) (:W *N_w))))
                  ((&walk.source (:n (:P S)))
                   (&walk.edge (:a (:P *S1_p) (:W *S1_w)) (:b (:P *S2_p) (:W *S2_w))))))
          (edge ((:a (:P S1_p) (:W S1_w)) (:b (:P S2_p) (:W S2_w)))
            (&walk.source (:n (:P S)))
            (&walk.edge (:a (:P *S1_p) (:W *S1_w)) (:b (:P *S2_p) (:W *S2_w))))
          (source ((:n (:P S) (:W N_w)))
            (&walk.source (:n (:P S) (:W *N_w))))))

      (RULE &crossing
        (&trail.distance (:key (:S *L)) (:n *P *W) *K)
        (&trail.edge (:key (:S L)) (:a P W) (:b (:P *Q) W))
        (&trail.distance (:key (:S L)) (:n (:P Q)) (:K *K2))
        (<= K2 K))

      (RULE &past_crossing
        (&trail.distance (:key (:S *L)) (:n *P *W) *K)
        (&crossing L (:K *K2))
        (< K2 K)))
    (RULE &visited
      (&trail.distance (:key (:S *P0)) (:n *P (:W *S_w)))
      (NOT (&past_crossing (:L P0) P (:W S_w))))))

(ALTS $x "which cells the line passes over" $PassNonMarker
  (ALT $OnlyBackgroundPassable
    (OUTPUT walk "the line stops before a cell that is not background."
      (RULE &passable
        (input *P *Col)
        (&background (:C Col))))))

(RULE &unaimed
  (OR ((&start *P)
       (NOT (&aim P)))
      ((&aim P (:D *D1))
       (&aim P (:D *D2))
       (!= D1 D2))))

(RULE &visited
  (&walk.reached (:n *P)))

(RULE &undefined
  (OR ((NOT (&line_color)))
      ((&start *P)
       (&unaimed P))))

(RULE &output
  (NOT (&undefined))
  (OR ((&visited *P)
       (&line_color *Col))
      ((input P Col)
       (NOT (&visited P)))))

(DET &background_determined
  (&painted *E *P)
  (ex_input E P *Col))

(OUT (&output ^P ^Col))
