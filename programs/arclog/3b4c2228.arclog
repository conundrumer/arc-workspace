;; inputs e8c908d87fb4e440530a4cf1a1a53da53b2c4a7dd171c6edd90e38a838b270d3 programs/solvers/3b4c2228.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3b4c2228

(DET &out_diag DiagDirDomain)

(DET &out_dim ConstOutDim)

(INIT &out_pos_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&out_dim *N)))

(RULE &diag_diagonal
  (&out_pos_frame.cell *P)
  (&out_diag *D)
  (diag_dist P (:Diag D) (:K1 *Ring) (:K2 Ring)))

(DET &block_color VanishedColor)

(DET &block_dim TileCount)

(INIT &block_shape_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&block_dim *N)))

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(RULE &on
  (input *P *Col)
  (&block_color (:C Col)))

(INIT &comps Connectivity
  (node (P)
    (&on *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(INIT &same Inclusion
  (pattern ((:m P))
    (&block_shape_frame.cell *P))
  (observed ((:observed O) (:m P_inner))
    (&bbox.cell (:key (:Id *O)) *P)
    (&bbox.box (:key (:Id O)) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner))))

(INIT &blocks Cardinality
  (member ((:m Id))
    (&same.equal (:observed *Id)))
  (domain ()
    (input)))

(RULE &total
  (&blocks.size *N))

(ALTS $detect "how the block shape's occurrences are found" $Object
  (ALT $Placement
    (INIT &occ Occurrences
      (cell (P)
        (&on *P))
      (shape (P)
        (&block_shape_frame.cell *P)))

    (INIT &placements Cardinality
      (member ((:m P))
        (&occ.occurrence *P)))

    (RULE &total
      (&placements.size *N))))

(ALTS $render "how the count renders" $Tally
  (ALT $Lookup
    (DET &lookup_grid
      (&blocks.size *E *N)
      (ex_output E *P *Col))

    (RULE &output
      (&total *N)
      (&lookup_grid N *P *Col))))

(RULE &marked
  (&diag_diagonal *P (:Ring *K))
  (&total *N)
  (< K N))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((&out_pos_frame.cell P)
       (&total)
       (NOT (&marked P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
