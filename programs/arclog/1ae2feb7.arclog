;; inputs 49d97e46cd9b330d5da7c382c61351cdf4de365b3d0f1fff7439f9c3d1ca7401 programs/solvers/1ae2feb7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1ae2feb7

;; Runs and the pattern they claim extend along this axis; the separator is one line across it.
(DET &axis AxisDomain)

(RULE &cell_split
  (input *P)
  (&axis *A)
  (split P A (:Along *P_along) (:Across *P_line)))

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &sep_count Cardinality
  (key ((&ink *P)
        (&cell_split P ^P_along))
    (member ((:m P))
      (&ink *P)
      (&cell_split P P_along))))

;; The separator is the fullest line across the run axis.
(INIT &sep Order
  (member ((:t P_along))
    (&sep_count.size (:key *P_along)))
  (score ((:t P_along) (:S N))
    (&sep_count.size (:key *P_along) *N)))

(RULE &cut_divider
  (&sep.maximal (:t *L))
  (&axis *A))

(RULE &cut_on_divider
  (input *P)
  (&cut_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

;; The two sides the separator cuts.
(INIT &cut_rank Order
  (key ((OR ((&cut_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&cut_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&cut_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &cut_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&cut_on_divider P A))
  (margin (:B P) D *K)
  (&cut_rank.rank (:key D) (:t K) (:R *N)))

(RULE &cut_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&cut_part_idx *P D (:N *N1))
  (&cut_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &cut_tile_of
  (&cut_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&cut_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &side
  (&axis *A)
  (axis_of *D A)
  (&cut_part_idx *P D (:N 0)))

(RULE &ink_dir
  (&side *P *D)
  (&ink P))

(RULE &canvas_dir
  (&ink_dir (:D *D_ink))
  (opposite (:D D_ink) (:Opp *D)))

(RULE &canvas
  (&canvas_dir *D)
  (&side *P D))

(INIT &runs Connectivity
  (key ((&ink *P ^Col)
        (&cell_split P ^P_line)
        (&ink_dir *D)
        (&side P D))
    (node (P)
      (&ink *P Col)
      (&cell_split P P_line)
      (&ink_dir *D)
      (&side P D))))

;; A run's box: its margin toward the canvas measures how far it sits from
;; the separator.
(INIT &run_box BoundingBox
  (key ((&runs.component *P ^Id))
    (cell (P)
      (&runs.component *P Id))))

;; The canvas's box, so offset 0 in its frame sits against the separator.
(INIT &canvas_box BoundingBox
  (cell (P)
    (&canvas *P)))

(RULE &canvas_off
  (&canvas *P)
  (&canvas_box.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&cell_split P *P_line)
  (&ink_dir *D)
  (margin (:B P_inner) D (:K *Off)))

(RULE &claim
  (&canvas_off *P *P_line *Off)
  (&runs.component *Id (:key P_line))
  (&axis *A)
  (&run_box.box (:key Id) *B)
  (box_extent B P A (:N *W))
  (divide (:T Off) (:Side W) (:Gap 0) (:Remainder 0)))

;; Where several runs claim one cell, the one nearest the separator wins.
(INIT &won Order
  (key ((&claim ^P *Id)
        (&canvas_dir *D)
        (&run_box.box (:key Id) *B)
        (margin B D *K))
    (member ((:t (:V Id) (:S K)))
      (&claim P *Id)
      (&canvas_dir *D)
      (&run_box.box (:key Id) *B)
      (margin B D *K))
    (score ((:t (:V Id) (:S K)) (:S K))
      (&claim P *Id)
      (&canvas_dir *D)
      (&run_box.box (:key Id) *B)
      (margin B D *K))))

(RULE &painted
  (&won.minimal (:key *P) (:t (:V *Id)))
  (&runs.component Id (:key *Col)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&painted P *Col))
      ((NOT (&canvas P))
       (= Col Col_in))
      ((&canvas P)
       (NOT (&painted P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
