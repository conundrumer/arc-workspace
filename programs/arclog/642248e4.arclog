;; inputs ae6d56ae0ee048bb79ad92ab3228b85698f871793c7a053dde263c0a6853bf23 programs/solvers/642248e4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 642248e4

;; An edge of two colors is no line.
(INIT &line Singleton
  (key ((dir_elem ^D))
    (member ((:v Col))
      (input *P *Col)
      (margin (:B P) D (:K 0)))))

(DET &changed
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col_in))
  (!= Col Col_in))

(DET &grew
  (ex_input *E *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (&changed E (:P Q)))

(DET &no_growth
  (ex_input *E *P *Col)
  (ex_output E)
  (NOT (&grew E P)))

(DET &mark
  (ex_input *E *Col)
  (ex_output E)
  (NOT (&no_growth Col)))

(RULE &tail
  (input (:P *P2) (:Col *Col_mark))
  (&mark (:Col Col_mark))
  (&line.value (:key *D) (:v *Col))
  (dist_pair (:P P2) D *K *K2)
  (< K K2)
  (neighbor (:P P2) D (:Q *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&tail P *Col))
      ((NOT (&tail P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
