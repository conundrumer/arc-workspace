;; inputs c984cce6a72be550181992121bf1179d3021bccbbf9eef21d223f1fbefcd8755 programs/solvers/5b6cbef5.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5b6cbef5

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg SharedColor)

(INIT &output_tiling2 Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile) (:Col *C_gate))
    (&bg (:C C_gate)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(RULE &output
  (OR ((input (:P *P_tile) (:Col *C_gate))
       (NOT (&bg (:C C_gate)))
       (input (:P *P_intile) *Col)
       (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
      ((&output_tiling2.cell P)
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
