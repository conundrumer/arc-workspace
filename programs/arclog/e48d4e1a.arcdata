;; inputs 54837a1b22507dbbd834bce39ef8fa01588ba22176a035789059c45f3aec07d3 programs/solvers/e48d4e1a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e48d4e1a

(param &bg Color (0))
(param &mark_color Color (5))
(param &shift_dir DiagDir (DIAG_BL))
(param &mark_corner DiagDir (DIAG_TR))
(param &mark_edge Dir (DIR_R))

(alts $h
  (alt $ShiftFromMarkCorner
    (witness marks-top-left borderline $ShiftFromMarkCorner
      (relaxed mark-stack)
      (separates "the marks run down the left edge from the top-left corner: the concept moves the cross toward the bottom-left, $ShiftFromMarkCorner toward the bottom-right, and $CountMarkRun finds no run at the top-right corner and keeps the cross in place")
      (input (grid
        (5 0 0 0 0 8 0 0 0 0)
        (5 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)))
      (output ($FixedCorner $CountAll) (grid
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)))
      (output $CountMarkRun (grid
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)))
      (output $ShiftFromMarkCorner (grid
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0)
        (0 0 0 0 0 0 0 8 0 0))))))

(alts $c
  (alt $CountMarkRun
    (witness gapped-marks borderline concept
      (relaxed mark-stack)
      (separates "the two marks have a gap between them: the concept counts two, and $CountMarkRun counts the run of one from the corner")
      (input (grid
        (0 0 0 0 0 8 0 0 0 5)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 5)
        (0 0 0 0 0 8 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)))
      (output $CountAll (grid
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)))
      (output $CountMarkRun (grid
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0)
        (0 0 0 0 8 0 0 0 0 0))))))

(alts $e
  (alt $WrapShift
    (witness shift-past-edge borderline concept
      (separates "the moved row passes the bottom edge: the concept drops it and keeps the moved column, and $WrapShift brings it back at row 1; $RefusePastEdge is undefined")
      (input (grid
        (0 0 0 0 0 3 0 0 0 5)
        (0 0 0 0 0 3 0 0 0 5)
        (0 0 0 0 0 3 0 0 0 5)
        (0 0 0 0 0 3 0 0 0 0)
        (0 0 0 0 0 3 0 0 0 0)
        (0 0 0 0 0 3 0 0 0 0)
        (0 0 0 0 0 3 0 0 0 0)
        (0 0 0 0 0 3 0 0 0 0)
        (3 3 3 3 3 3 3 3 3 3)
        (0 0 0 0 0 3 0 0 0 0)))
      (output $DropPastEdge (grid
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)))
      (output $WrapShift (grid
        (0 0 3 0 0 0 0 0 0 0)
        (3 3 3 3 3 3 3 3 3 3)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0)
        (0 0 3 0 0 0 0 0 0 0))))))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor variant &bg=$Derived
      (relaxed full-cross)
      (separates "the field is 7: the concept moves the cross and paints the rest 0, and bg=DominantColor paints the rest 7")
      (input (grid
        (7 7 7 7 7 8 7 7 7 5)
        (7 7 7 7 7 8 7 7 7 5)
        (7 7 7 7 7 8 7 7 7 7)
        (8 8 8 8 8 8 8 8 8 8)
        (7 7 7 7 7 8 7 7 7 7)
        (7 7 7 7 7 8 7 7 7 7)
        (7 7 7 7 7 8 7 7 7 7)
        (7 7 7 7 7 8 7 7 7 7)
        (7 7 7 7 7 8 7 7 7 7)
        (7 7 7 7 7 8 7 7 7 7)))
      (output &bg=$Stored (grid
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)))
      (output &bg=$Derived (grid
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (8 8 8 8 8 8 8 8 8 8)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7)
        (7 7 7 8 7 7 7 7 7 7))))))

(alts &mark_color
  (alt &mark_color=$Derived
    (witness mark_color=RarestColor variant &mark_color=$Derived
      (relaxed mark-stack)
      (separates "the marks are 1, not 5: the concept counts no marks and keeps the cross in place, mark_color=RarestColor counts the two 1 cells and moves the cross two steps, and $ShiftFromMarkCorner finds no 5 at a corner and is undefined")
      (input (grid
        (0 0 0 0 0 8 0 0 0 1)
        (0 0 0 0 0 8 0 0 0 1)
        (0 0 0 0 0 8 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)))
      (output ($FixedCorner &mark_color=$Stored) (grid
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)
        (0 0 0 0 0 8 0 0 0 0)))
      (output &mark_color=$Derived (grid
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)
        (0 0 0 8 0 0 0 0 0 0)))
      (output $ShiftFromMarkCorner undefined))))
