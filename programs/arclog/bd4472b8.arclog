;; inputs c2638d68c85365af030661bd214acac5423d9a203445dfb2c8413a5cdcc34999 programs/solvers/bd4472b8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; bd4472b8

(DET &body_start SepThickness)

(DET &copies SepThickness)

(DET &header_dir DirDomain)

(INIT &fill_division Division
  (key ((&header_dir ^D)
        (axis_of D ^A))
    (cell ((:P P_body))
      (input (:P *P_b))
      (&body_start (:G *K))
      (edge_inset D K *B)
      (inside (:A P_b) B)
      (relative (:Base B) (:X P_b) (:X_rel *P_body)))
    (parts (A N)
      (&copies (:G *N)))))

(DET &diag DiagAxisDomain)

(RULE &stripe
  (input (:P *P_h) *Col)
  (&header_dir *D)
  (margin (:B P_h) D (:K 0))
  (&diag *Da)
  (reflection (:A Da) *T)
  (apply (:D T) (:P P_h) (:P_out *P_ht))
  (axis_of D *A)
  (split (:P P_ht) A (:Along *P_stack)))

(RULE &fill
  (input *P)
  (&fill_division.tile (:key *D *A) (:P *P_body) (:P_inner *P_slab))
  (split (:P P_slab) A (:Along *P_inner))
  (&body_start (:G *K))
  (edge_inset D K *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel P_body))
  (&stripe (:P_stack P_inner) *Col))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&fill P)))
      ((&fill P Col))))

(OUT (&output ^P ^Col))
