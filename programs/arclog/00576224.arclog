;; inputs 35e2f21bd44e565ecdd1873fdc65ff3141e22f89df16ba80caae09edfc749b71 programs/solvers/00576224.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 00576224

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (key ((OR ((&tile_d4 (:Pt *P_tile) (:T ^D)))
            ((input (:P *P_in))
             (&tile_d4 (:T D))
             (apply D (:P P_in) (:P_out *P_intile)))))
    (outer ((:P P_tile))
      (&tile_d4 (:Pt *P_tile) (:T D)))
    (inner ((:P P_intile))
      (input (:P *P_in))
      (&tile_d4 (:T D))
      (apply D (:P P_in) (:P_out *P_intile)))))

(DET &arr_dim ScaleRatio)

(INIT &arr_pos_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&arr_dim (:K *N))))

;; Bands stack along band_axis; plain bands at both stack ends.
(DET &band_axis AxisDomain)

(RULE &anchor
  (&band_axis *A)
  (axis_of *D A))

(DET &tf D4Domain)

(ALTS $choice "three models of the tile arrangement, data-equivalent on this task" $Lookup
  (ALT $Alt
    ;; The input transformed by &tf once per band step away from the
    ;; anchor edge: the anchor-edge band is plain, and each band step applies
    ;; &tf once more.
    (INIT &alternate Walk
      (successor ((:p P) (:p_next P_img))
        (input *P)
        (&tf (:D *F))
        (apply (:D F) P (:P_out *P_img)))
      (steps ((:N K))
        (&arr_pos_frame.cell (:P *T))
        (&anchor *D)
        (margin (:B T) D *K)))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (&arr_pos_frame.cell (:P *T)))
      (inner ((:P P_intile))
        (input (:P *P_in))
        (&alternate.walk (:p0 P_in) (:p *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&output_tiling2.cell (:P_outer *T) (:P_inner *P_intile) *P)
      (&anchor *D)
      (margin (:B T) D *K)
      (&alternate.walk (:p0 P_in) (:N K) (:p P_intile))))
  (ALT $Mid
    (INIT &output_tiling3 Tiling
      (outer ((:P T))
        (&arr_pos_frame.cell (:P *T)))
      (inner ((:P P_intile))
        (input (:P *P_in))
        (&tf (:D *F))
        (apply (:D F) (:P P_in) (:P_out *P_intile))))

    (INIT &output_tiling4 Tiling
      (outer ((:P T))
        (&arr_pos_frame.cell (:P *T)))
      (inner ((:P P_in))
        (input (:P *P_in))))

    (RULE &output
      (OR ((input (:P *P_in) *Col)
           (&output_tiling3.cell (:P_outer *T) (:P_inner *P_intile) *P)
           (&anchor *D)
           (dist_pair (:P T) D *K (:K2 K))
           (&tf (:D *F))
           (apply (:D F) (:P P_in) (:P_out P_intile)))
          ((input (:P *P_in2) Col)
           (&output_tiling4.cell (:P_outer *T2) (:P_inner P_in2) P)
           (&anchor (:D *D2))
           (dist_pair (:P T2) (:D D2) (:K *K1) *K2)
           (!= K1 K2))))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:key D) (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
