;; inputs 219824fa9a81df5f4417905e9a15234ff67fc4e1ff22a545490645e2fbe1da5c programs/solvers/84db8fc4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 84db8fc4

(DET &bg ChangedColor)

(DET &outside_fill AnyOutNewColor)

(DET &enclosed_fill AnyOutNewColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &outside Flood
  (node (P)
    (&bg_cell *P))
  (source (P)
    (&bg_cell *P)
    (margin (:B P) *D (:K 0))))

(RULE &output
  (OR ((&bg_cell *P)
       (IF ((&outside.reached P))
           ((&outside_fill (:C *Col)))
           ((&enclosed_fill (:C Col)))))
      ((input P Col)
       (NOT (&bg_cell P)))))

(OUT (&output ^P ^Col))
