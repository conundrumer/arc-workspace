;; inputs e6758c2c01200500ebe83039861de6437fce3b417fabd731fba0746ebec29a46 programs/solvers/d4f3cd78.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d4f3cd78

(INPUT one-walled-box "one rectangular outline of &wall_color, at least 3 cells on each side, on a field of background 0, with an empty interior"

  (INIT &counts_count Cardinality
    (key ((ex_input ^E *P ^Col))
      (member ((:m P))
        (ex_input E *P Col))))

  (INIT &rarest Order
    (key ((&counts_count.size (:key ^E *Col) *N))
      (member ((:t (:V Col) (:S N)))
        (&counts_count.size (:key E *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&counts_count.size (:key E *Col) *N))))

  (DET &not_rarest
    (&rarest.minimal (:t (:V *C)))
    (ex_input *E)
    (NOT (&rarest.minimal (:key E) (:t (:V C)))))

  (DET_OR_RULE &wall_color RarestColor
    (&rarest.minimal (:t (:V *C)))
    (NOT (&not_rarest C))))

(INPUT one-gap "the outline lacks exactly one cell, which is on a side and not at a corner")

(OUTPUT fill-interior "each cell strictly inside the bounding box of the &wall_color cells takes &fill_color"

  (RULE &wall
    (input *P *Col)
    (&wall_color (:C Col)))

  (DET &fill_color
    (ex_output *E (:Col *C))
    (NOT (ex_input E (:Col C))))

  (INIT &walls Connectivity
    (node (P)
      (&wall *P)))

  (INIT &object_box BoundingBox
    (key ((&walls.component *P ^Id))
      (cell (P)
        (&walls.component *P Id))))

  (RULE &open
    (input *P)
    (NOT (&wall P)))

  ;; The cells closed off from the edge with no cell sealed.
  (INIT &closed Enclosure
    (cell (P)
      (&open *P)))

  ;; The cells closed off from the edge once G is sealed.
  (INIT &sealed Enclosure
    (key ((&open (:P ^G)))
      (cell (P)
        (&open *P)
        (!= P G)))))

(OUTPUT fill-gap "each cell of that box's border, not at a corner, that is not &wall_color is a gap, and takes &fill_color")

(OUTPUT stream-out "from each gap, each cell in a straight line outward, perpendicular to the gap's side and away from the interior, takes &fill_color, up to the grid edge"

  (INIT &hull BoundingBox
    (cell (P)
      (&wall *P)))

  (RULE &basin_wall
    (&hull.box *B)
    (&wall *P))

  (RULE &basin_corner
    (&basin_wall *B)
    (input *P)
    (inside (:A P) B)
    (same_corner (:P1 P) (:P2 B)))

  (RULE &gap
    (&basin_wall *B)
    (input *P)
    (inside (:A P) B)
    (same_dist *D (:P1 P) (:P2 B))
    (NOT (&basin_corner B P))
    (NOT (&basin_wall B P)))

  (INIT &stream_frame Frame
    (extent (A N)
      (&gap *P)
      (frame_extent P *A *N)))

  (INIT &counts Order
    (key ((&counts_count.size (:key ^E *Col)))
      (member ((:t Col))
        (&counts_count.size (:key E *Col)))
      (score ((:t Col) (:S N))
        (&counts_count.size (:key E *Col) *N))))

  (DET &not_commonest
    (&counts.maximal (:t *C))
    (ex_input *E)
    (NOT (&counts.maximal (:key E) (:t C))))

  (DET_OR_RULE &background DominantColor
    (&counts.maximal (:t *C))
    (NOT (&not_commonest C)))

  (RULE &bg
    (input *P *Col)
    (&background (:C Col)))

  (RULE &stream_blocked
    (input *P)
    (NOT (&bg P)))

  ;; The line from each gap toward each direction.
  (INIT &stream Ray
    (source (P)
      (&gap *P))
    (node (P)
      (&stream_frame.cell *P)
      (NOT (&stream_blocked P)))
    (dir (D)
      (dir_elem *D))))

(OUTPUT keep-rest "every other cell keeps its input color"

  (INIT &stream_full Ray
    (source (P)
      (&gap *P))
    (node (P)
      (&stream_frame.cell *P))
    (dir (D)
      (dir_elem *D)))

  (RULE &water
    (&basin_wall *B)
    (input *P)
    (interior (:A P) B)))

(ALTS $interior "which cells the water fills, and where the gaps are" $ColorHull
  (ALT $EachObject
    (OUTPUT fill-interior "the bounding box is taken once per 4-connected component of &wall_color cells")
    (OUTPUT fill-gap "the gaps of a component are the cells of its own box's border, not at a corner, that are not cells of that component")
    (OUTPUT stream-out "the stream runs from each gap of each component"
      (RULE &basin_wall
        (&walls.component *P *Id)
        (&object_box.box (:key Id) *B))))
  (ALT $SealedRegion
    (OUTPUT fill-interior "the interior is the set of non-&wall_color cells that a walk from the grid edge reaches until one non-wall cell, the gap, is sealed, and no walk reaches once it is"
      (RULE &sealed_off
        (&sealed.enclosed (:key *G) *P)
        (NOT (&closed.enclosed P)))

      (RULE &inlet
        (&sealed_off *G *P)
        (dir_elem *D)
        (neighbor (:P G) D (:Q P)))

      (RULE &gap
        (&inlet (:G *P) (:D *D_in))
        (ALL ((&inlet (:G P) (:D *D1))
              (&inlet (:G P) (:D *D2)))
             ((= D1 D2)))
        (opposite (:D D_in) (:Opp *D)))

      (RULE &water
        (&gap (:P *G))
        (&sealed_off G *P)))
    (OUTPUT fill-gap "the gap is that sealed cell, where exactly one of its neighbors is in the interior, and the stream leaves it away from that neighbor; where no such cell exists, nothing is painted")))

(ALTS $obstacle "what the fill does to a cell of another color that it covers" $Overwrite
  (ALT $PaintBackgroundOnly
    (OUTPUT fill-interior "only the &background cells inside take &fill_color")
    (OUTPUT fill-gap "the gap takes &fill_color only where it is &background")
    (OUTPUT stream-out "only the &background cells along the stream take &fill_color, and the stream runs on to the edge")
    (RULE &paint
      (OR ((&water *P)
           (&bg P))
          ((&gap (:P *G) *D)
           (&stream_full.ray P D (:Origin G))
           (input P)
           (&bg P))))
    (ALTS $stop "where the stream ends" $ToEdge
      (ALT $StreamStops
        (OUTPUT stream-out "the stream ends before the first non-&background cell on its line")
        (RULE &paint
          (OR ((&water *P)
               (&bg P))
              ((&gap (:P *G) *D)
               (&stream.ray P D (:Origin G))
               (input P)
               (&bg P))))))))

(RULE &paint
  (OR ((&water *P))
      ((&gap (:P *G) *D)
       (&stream_full.ray P D (:Origin G))
       (input P))))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&paint P))
      ((&fill_color (:C *Col)))
      ((= Col Col_in))))

(OUT (&output ^P ^Col))
