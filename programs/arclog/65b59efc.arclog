;; inputs 4dc697f3bd6d77831794a464005870f76be5c49a9b0cb162ca7681fb9308159b programs/solvers/65b59efc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 65b59efc

(DET &bg DominantColor)

;; The scene: the drawn content, cut from its bg canvas.
(INIT &scene BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &cell
  (&scene.box *B)
  (input (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(DET &sep VanishedColor)

(RULE &tiling_divider
  (&cell *P *Col)
  (&sep (:C Col))
  (axis_of *D (:A *A_run))
  (neighbor P D *Q)
  (&cell (:P Q) Col)
  (perp (:A A_run) (:A2 *A))
  (split P A (:Along *L)))

(RULE &tiling_on_divider
  (&cell *P)
  (&tiling_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

;; A separator line is dashed: the separator color runs along it, so two
;; adjacent separator cells lie on it. A lone separator cell is where a tile
;; line crosses one.
(INIT &tiling_rank Order
  (key ((OR ((&tiling_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((&cell *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&tiling_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&tiling_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((&cell *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (&cell *P)
      (margin (:B P) D *K))))

(RULE &tiling_part_idx
  (&cell *P)
  (axis_of *D *A)
  (NOT (&tiling_on_divider P A))
  (margin (:B P) D *K)
  (&tiling_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiling_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiling_part_idx *P D (:N *N1))
  (&tiling_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &tiling_tile_of
  (&tiling_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiling_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; The edge the template band lies on.
(DET &template_side DirDomain)

;; Each tile's box.
(INIT &tile BoundingBox
  (key ((&tiling_tile_of *P ^P_tile))
    (cell (P)
      (&tiling_tile_of *P P_tile))))

(RULE &tile_cell
  (&cell *P *Col)
  (&tile.cell (:key *P_tile) P)
  (&tile.box (:key P_tile) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_intile))
  (&template_side *D)
  (axis_of D *A)
  (split (:P P_tile) A (:Along *P_band) (:Across *P_strip)))

(RULE &marker_cell
  (&tile_cell *P_band *P_intile *Col)
  (&template_side *D)
  (neighbor (:P P_band) D (:Q *P_tb))
  (margin (:B P_tb) D (:K 0)))

(RULE &template_cell
  (&tile_cell *P_band *P_strip *P_intile *Col)
  (&template_side *D)
  (margin (:B P_band) D (:K 0)))

(INIT &output_tiling Tiling
  (outer ((:P P_outer))
    (&marker_cell (:P_intile *P_outer)))
  (inner ((:P P_inner))
    (&template_cell (:P_intile *P_inner))))

(RULE &legend_cell
  (&tile_cell *P_band *P_strip *Col)
  (&template_side *D)
  (opposite D (:Opp *D2))
  (margin (:B P_band) (:D D2) (:K 0)))

(RULE &painted
  (&marker_cell (:P_intile *P_outer) (:Col *C))
  (NOT (&bg C))
  (&template_cell *P_strip (:P_intile *P_inner) (:Col C))
  (&legend_cell P_strip *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (&output_tiling.cell *P_outer *P_inner *P)
  (OR ((&painted P_outer P_inner *Col))
      ((NOT (&painted P_outer P_inner))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
