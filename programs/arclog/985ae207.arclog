;; inputs e6b8e3f5a4c09da3c591ea4648cdccb2c6a603a5bb0e831203936303b112eb81 programs/solvers/985ae207.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 985ae207

;; The train pairs admit a second color; the DominantColor proposer, exact here, fixes this value.
(DET &bg DominantColor)

(RULE &ring
  (input *P (:Col *Cp))
  (NOT (&bg (:C Cp)))
  (neighbor P *D *Q)
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &gap
  (&ring *P *Col)
  (neighbor P *D *Q)
  (NOT (input (:P Q) Col)))

(RULE &mark
  (input *P (:Col *C_center))
  (NOT (&bg (:C C_center)))
  (&ring P (:Col *Cr))
  (NOT (&gap P (:Col Cr)))
  (!= Cr C_center))

(RULE &mark_cell
  (OR ((&mark (:P *P_mark))
       (neighbor (:P P_mark) *D (:Q *P)))
      ((&mark (:P P_mark))
       (= P P_mark))))

(RULE &block
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&mark_cell P)))

(INIT &mbox BoundingBox
  (key ((&mark_cell (:P_mark ^Pm) *P))
    (cell (P)
      (&mark_cell (:P_mark Pm) *P))))

(RULE &march
  (axis_of *D *A)
  (&mbox.box (:key (:Pm *P_mark)) *B)
  (box_extent B (:P P_mark) A (:N *K)))

(ALTS $choice "what fixes the march's pitch" $Abut
  (ALT $Stride
    (DET &pitch TileCount)

    (RULE &march
      (&mark (:P *P_mark))
      (dir_elem *D)
      (&pitch (:N *K)))))

(RULE &step_copy
  (&march *P_mark *D *K)
  (axis_of D *A)
  (opposite D (:Opp *O))
  (input (:P *Q))
  (same_line A (:P P_mark) Q)
  (relative (:Base P_mark) (:X Q) (:X_rel *V))
  (margin (:B V) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Part *N) (:Remainder 0)))

(RULE &copy_cell
  (&mark_cell *P_mark (:P *X))
  (input (:P X) *Col)
  (relative (:Base P_mark) X (:X_rel *V))
  (&step_copy P_mark *Q)
  (compose (:A Q) (:B V) (:C *P)))

(RULE &at_block
  (&mark (:P *P_mark) (:C_center *Cc))
  (&copy_cell P_mark *Q *P)
  (&block (:Col Cc) P))

(RULE &landing
  (&step_copy *P_mark *D *Q *N)
  (&at_block P_mark Q))

(RULE &landed_before
  (&step_copy *P_mark *D *N)
  (&landing P_mark D (:N *N2))
  (< N2 N))

(RULE &copy
  (&step_copy *P_mark *D *Q *N)
  (&landing P_mark D (:N *N2))
  (<= N N2)
  (NOT (&landed_before P_mark D N)))

(RULE &paint
  (&copy (:P_mark *Pm) *Q)
  (&copy_cell (:P_mark Pm) Q *P *Col)
  (input P))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P Col)
       (NOT (&paint P)))))

(OUT (&output ^P ^Col))
