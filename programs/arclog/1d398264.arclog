;; inputs b86453329fd20f60952ff1cef0652c8ff1e7bf90c563902d2b89dab282457172 programs/solvers/1d398264.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1d398264

(DET &bg DominantColor)

(RULE &block
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &border Boundary
  (cell (P)
    (&block *P))
  (dir (D)
    (dir8_elem *D)))

(RULE &center
  (&block *P)
  (NOT (&border.boundary P)))

;; Each cell around the center casts along the direction that reaches it.
(INIT &burst Ray
  (key ((dir8_elem ^D))
    (source (P)
      (&center (:P *C))
      (neighbor (:P C) D (:Q *P)))
    (dir (D)))
  (node (P)
    (input *P)))

(RULE &painted
  (&burst.ray *P *K (:Origin *Src))
  (!= K 0)
  (input (:P Src) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&painted P *Col))
      ((NOT (&painted P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
