;; inputs ed2e772ea9e9efb69b08f7ef94d70ed899266cba56bec3bee6405d09609db3d4 programs/solvers/d9fac9be.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d9fac9be

(DET &bg DominantColor)

(DET &out_dim ConstOutDimAxis)

(INIT &out_pos_frame Frame
  (extent (A N)
    (&out_dim *A *N)))

(DET &dim TileCount)

(RULE &ink
  (input (:Col *C))
  (NOT (&bg C)))

(INIT &box Frame
  (extent (A (:N K))
    (axis_elem *A)
    (&dim (:N *K))))

(INIT &outline Boundary
  (cell (P)
    (&box.cell *P)))

(INIT &occ Occurrences
  (key ((&ink (:C ^Col)))
    (cell (P)
      (input *P Col)))
  (shape ((:P S))
    (&outline.boundary (:P *S))))

(ALTS $choice "how the boxed cell is identified (data-equivalent on this task)" $Box
  (ALT $Ring
    (RULE &defect
      (input *P)
      (&ink (:C *A))
      (neighbor P *D (:Q *P2))
      (NOT (input (:P P2) (:Col A))))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (&ink (:C *A))
      (!= A Col)
      (NOT (&defect (:P P_grid_in) A))
      (&out_pos_frame.cell *P)))
  (ALT $Full
    (RULE &inked
      (input *P *Col)
      (NOT (&bg (:C Col))))

    (RULE &gap
      (input *P)
      (neighbor P *D (:Q *P2))
      (NOT (&inked (:P P2))))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (NOT (&gap (:P P_grid_in)))
      (&out_pos_frame.cell *P))))

(RULE &output
  (&occ.occurrence (:key (:Col *Col2)) (:P *M))
  (&box.cell (:P *P_ctr))
  (centered (:P P_ctr))
  (compose (:A M) (:B P_ctr) (:C *P_grid_in))
  (input (:P P_grid_in) *Col)
  (!= Col Col2)
  (&out_pos_frame.cell *P))

(OUT (&output ^P ^Col))
