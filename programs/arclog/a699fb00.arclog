;; inputs c2ada69876159a20987e04f3dfbd78389d943c5b44564fa5df93502f518fa17f programs/solvers/a699fb00.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; a699fb00

(DET &axis AxisDomain)

(DET &bg DominantColor)

(DET &dot RarestColor)

(DET &fill AnyOutNewColor)

(RULE &flanked
  (input *P (:Col *Bg))
  (&bg (:C Bg))
  (&dot (:C *Dot))
  (&axis *A)
  (axis_of *D A)
  (opposite D (:Opp *D2))
  (neighbor P D (:Q *Q1))
  (input (:P Q1) (:Col Dot))
  (neighbor P (:D D2) (:Q *Q2))
  (input (:P Q2) (:Col Dot)))

(ALTS $choice "which bg cells count as gaps" $Flank
  (ALT $Span
    (INIT &spans Ray
      (source ((:P Q))
        (input (:P *Q) (:Col *Dot))
        (&dot (:C Dot)))
      (node (P)
        (input *P))
      (dir (D)
        (&axis *A)
        (axis4_of *D A)))

    (RULE &spans_between
      (input *P (:Col *Bg))
      (&bg (:C Bg))
      (&axis *A)
      (axis4_of *D A)
      (dir8_opposite D (:D2 *O))
      (&spans.ray P D)
      (&spans.ray P (:D O)))

    (RULE &output
      (OR ((&spans_between *P)
           (&fill (:C *Col)))
          ((input P Col)
           (NOT (&spans_between P)))))))

(RULE &output
  (OR ((&flanked *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&flanked P)))))

(OUT (&output ^P ^Col))
