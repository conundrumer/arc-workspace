;; inputs 2303272c796b3142c37eb133609bf6876e0b1805fc67e500feae631d39ee91ce programs/solvers/855e0971.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 855e0971

(DET &marker RarestColor)

;; The one non-marker color of each line. A line is keyed by the axis it
;; lies across and its position along that axis.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (NOT (&marker (:C Col)))
        (axis_elem ^A)
        (split P A (:Along ^P_line)))
    (member ((:v Col))
      (input *P *Col)
      (NOT (&marker (:C Col)))
      (split P A (:Along P_line)))))

(RULE &stack_axis
  (axis_elem *A)
  (NOT (&line_color.plural (:key A))))

(RULE &band_of
  (input *P)
  (&stack_axis *A)
  (split P A (:Along *P_line))
  (&line_color.value (:key A P_line) (:v *Col)))

(RULE &cast_blocked
  (&band_of (:Col *Key))
  (input *P)
  (NOT (&band_of P (:Col Key))))

(RULE &cast_dir
  (&band_of (:Col *Key))
  (&stack_axis *A)
  (axis_of *D A))

;; Each marker casts along the stacking axis, keyed by its band's color;
;; cells outside that band block it.
(INIT &cast Ray
  (key ((OR ((&band_of *P ^Col)
             (input P (:Col *M))
             (&marker (:C M)))
            ((&cast_dir (:Key Col) *D))
            ((&cast_dir (:Key Col))
             (input P)
             (NOT (&cast_blocked (:Key Col) P)))))
    (source (P)
      (&band_of *P Col)
      (input P (:Col *M))
      (&marker (:C M)))
    (node (P)
      (&cast_dir (:Key Col))
      (input *P)
      (NOT (&cast_blocked (:Key Col) P)))
    (dir (D)
      (&cast_dir (:Key Col) *D))))

(RULE &output
  (input *P (:Col *C_in))
  (IF ((&cast.ray P))
      ((&marker (:C *Col)))
      ((= Col C_in))))

(OUT (&output ^P ^Col))
