;; inputs ed30e51aa1ecbce98eed44d3ea42242604351a30cb5749c61fe4820b0f25b176 programs/solvers/913fb3ed.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 913fb3ed

(INIT &ground_count Cardinality
  (key ((ex_input *E *P ^Col))
    (member ((:m E P))
      (ex_input *E *P Col))))

;; The grids' ground color; dots are the exception to it.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S Count))
    (&ground_count.size (:key *Col) (:N *Count))))

(DET &dot
  (ex_input *E *P (:Col *M))
  (NOT (&ground.maximal (:t M))))

(DET &neighbor_cell
  (&dot *E (:P *Q) *M)
  (neighbor (:P Q) *D (:Q *P))
  (ex_output E P *Col)
  (relative (:Base Q) (:X P) (:X_rel *Off)))

(DET &border
  (&neighbor_cell (:M *Mark) *Col))

(RULE &painted
  (input (:P *Q) (:Col *M))
  (&border (:Mark M) *Col)
  (neighbor (:P Q) *D (:Q *P))
  (input P))

(ALTS $choice "What the eight cells around a dot come from." $Ring
  (ALT $Stamp
    (DET &template
      (&neighbor_cell (:M *Mark) *Off *Col))

    (RULE &painted
      (input (:P *Q) (:Col *M))
      (&template (:Mark M) *Off *Col)
      (compose (:A Q) (:B Off) (:C *P))
      (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))

(OUT (&output ^P ^Col))
