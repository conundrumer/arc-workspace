;; inputs 2922dc63bd003296bd11fc8ea557a8740884b8abad94702e60a64c8ce6b7835d programs/solvers/3dc255db.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3dc255db

(DET &bg DominantColor)

(INIT &comps Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &obj_size Cardinality
  (key ((&comps.component ^Id *P))
    (member ((:m P))
      (&comps.component Id *P))))

(RULE &holds
  (&comps.component *Id *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (&comps.component (:Id *B) (:P Q))
  (&obj_size.size (:key Id) *N)
  (&obj_size.size (:key (:Id B)) (:N *N2))
  (< N N2))

(RULE &wall
  (&holds *B)
  (&comps.component (:Id B) *P))

(INIT &bbox BoundingBox
  (key ((&wall ^B *P))
    (cell (P)
      (&wall B *P))))

(RULE &held
  (&holds *B *Id)
  (&comps.component Id *P))

;; The cavity: what the held cells reach inside the box without crossing a wall.
(INIT &cavity Flood
  (key ((OR ((&bbox.box (:key ^B) (:B *B_hold))
             (input *P)
             (inside (:A P) (:B B_hold))
             (NOT (&wall B P)))
            ((&held B P))))
    (node (P)
      (&bbox.box (:key B) (:B *B_hold))
      (input *P)
      (inside (:A P) (:B B_hold))
      (NOT (&wall B P)))
    (source (P)
      (&held B *P))))

;; The cavity runs out to that side of the bbox.
(RULE &mouth
  (&bbox.box (:key *B) (:B *B_hold))
  (&cavity.reached (:key B) *P)
  (inside (:A P) (:B B_hold))
  (same_dist *D (:P1 P) (:P2 B_hold)))

;; The wall cell nearest a side, where it stands alone there.
(INIT &tip Singleton
  (key ((&bbox.box (:key ^B) (:B *B_hold))
        (&wall B *P)
        (inside (:A P) (:B B_hold))
        (same_dist ^D (:P1 P) (:P2 B_hold)))
    (member ((:v P))
      (&bbox.box (:key B) (:B *B_hold))
      (&wall B *P)
      (inside (:A P) (:B B_hold))
      (same_dist D (:P1 P) (:P2 B_hold)))))

(RULE &held_color
  (&held *B *P)
  (input P *Col))

(INIT &held_size Cardinality
  (key ((&held ^B *P))
    (member ((:m P))
      (&held B *P))))

(ALTS $choice "how the open side is read" $Pour
  (ALT $Sight
    (RULE &sight_dir
      (&wall (:B *Key))
      (dir_elem *D))

    (INIT &sight_frame Frame
      (key ((&held ^B *P)
            (frame_extent P *A *N))
        (extent (A N)
          (&held B *P)
          (frame_extent P *A *N))))

    (INIT &sight Ray
      (key ((OR ((&held ^B *P))
                ((&sight_dir (:Key B) *D))
                ((&sight_frame.cell (:key B) P)
                 (NOT (&wall B P)))))
        (source (P)
          (&held B *P))
        (node (P)
          (&sight_frame.cell (:key B) *P)
          (NOT (&wall B P)))
        (dir (D)
          (&sight_dir (:Key B) *D))))

    (INIT &sight_full Ray
      (key ((OR ((&held ^B *P))
                ((&sight_dir (:Key B) *D))
                ((&sight_frame.cell (:key B) P))))
        (source (P)
          (&held B *P))
        (node (P)
          (&sight_frame.cell (:key B) *P))
        (dir (D)
          (&sight_dir (:Key B) *D))))

    (RULE &sight_stop_full
      (&sight.end (:key (:B *V0)) (:P *E1) (:D *V2) (:Origin *V4))
      (neighbor (:P E1) (:D V2) (:Q *V1))
      (&sight_full.ray (:key (:B V0)) (:P V1) (:D V2) (:K *V3) (:Origin V4)))

    (RULE &mouth
      (&wall *B)
      (dir_elem *D)
      (NOT (&sight_stop_full (:V0 B) (:V2 D))))))

(RULE &spout
  (&mouth *B (:D *D_open))
  (opposite *D (:Opp D_open))
  (&tip.value (:key B D) (:v *P)))

(INIT &trail_frame Frame
  (key ((&spout ^B ^D *P)
        (frame_extent P *A *N))
    (extent (A N)
      (&spout B D *P)
      (frame_extent P *A *N))))

(INIT &trail Ray
  (key ((OR ((&spout ^B ^D))
            ((&trail_frame.cell (:key B D) *P))))
    (source (P)
      (&spout B D *P))
    (node (P)
      (&trail_frame.cell (:key B D) *P))
    (dir (D)
      (&spout B D))))

(RULE &trail_cell
  (&spout *B *D)
  (input))

(RULE &paint
  (&trail.ray (:key *B) *P *K)
  (&trail_cell B)
  (input P)
  (!= K 0)
  (&held_size.size (:key B) *N)
  (<= K N)
  (&held_color B *Col))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P (:Col *C_in))
       (NOT (&paint P))
       (OR ((&held P)
            (&bg (:C Col)))
           ((NOT (&held P))
            (= Col C_in))))))

(OUT (&output ^P ^Col))
