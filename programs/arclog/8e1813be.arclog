;; inputs e0f5a9ce0301efd85f582a03d51ff2384bb9c4052a9b27f00ce7917c16d6cd58 programs/solvers/8e1813be.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8e1813be

(DET &bg DominantColor)

(DET &square VanishedColor)

;; A stripe is a line whose colored cells (neither bg nor the square) are
;; one color.
(INIT &stripe Singleton
  (key ((input *P *Col)
        (NOT (&bg (:C Col)))
        (NOT (&square (:C Col)))
        (axis_elem ^A)
        (split P A (:Along ^P_line)))
    (member ((:v Col))
      (input *P *Col)
      (NOT (&bg (:C Col)))
      (NOT (&square (:C Col)))
      (split P A (:Along P_line)))))

;; The stripes packed along their axis, in spatial order.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t P_line))
      (&stripe.value (:key A *P_line))
      (NOT (&stripe.plural (:key A))))
    (before ((:a P_line) (:b P_line2))
      (&stripe.value (:key A *P_line))
      (NOT (&stripe.plural (:key A)))
      (&stripe.value (:key A (:P_line *P_line2)))
      (!= P_line P_line2)
      (margin (:B P_line) D (:K *K1))
      (margin (:B P_line2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) D) (:t M) (:R *R2))
  (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

;; The square, viewed from its own frame.
(INIT &square2 BoundingBox
  (cell (P)
    (input *P *Col)
    (&square (:C Col))))

(RULE &output
  (&stripe.value (:key *A *P_line) (:v *Col))
  (&layout_pos (:Key A) (:M P_line) *P_pos)
  (&square2.cell (:P *Q))
  (&square2.box *B)
  (inside (:A Q) B)
  (relative (:Base B) (:X Q) (:X_rel *P_inner))
  (split (:P P_inner) A (:Across *P_across))
  (compose (:A P_pos) (:B P_across) (:C *P)))

(OUT (&output ^P ^Col))
