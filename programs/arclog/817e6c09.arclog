;; inputs eea0fa37572b849caf757ea1eb5006225899c28f0062288e822e6ce8e2bb4958 programs/solvers/817e6c09.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 817e6c09

(DET &anchor DirDomain)

(DET &ink RarestColor)

(DET &mark AnyOutNewColor)

;; alternation rhythm: run of marked, run of kept
(DET &mark_run DivisorRatio)

(DET &keep_run DivisorRatio)

(INIT &blocks Connectivity
  (node (P)
    (input *P *Col)
    (&ink (:C Col))))

(INIT &bbox BoundingBox
  (key ((&blocks.component *P ^Id))
    (cell (P)
      (&blocks.component *P Id))))

(RULE &block_dist
  (&anchor *D)
  (&bbox.box (:key *Id) *B)
  (margin B D *K))

(INIT &seq Order
  (member ((:t K))
    (&block_dist *K))
  (score ((:t K) (:S K))
    (&block_dist *K)))

(RULE &marked
  (&blocks.component *P *Id)
  (&block_dist Id *K)
  (&seq.rank (:t K) *R)
  (&mark_run (:K *Kr))
  (&keep_run (:K *G))
  (divide (:T R) (:Side Kr) (:Gap G)))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&marked P)))))

(OUT (&output ^P ^Col))
