;; inputs a8ae879e086354f47024668e22f666cad1ca0beb77f4de920cceedd1a550d97f programs/solvers/9a4bb226.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 9a4bb226

(INPUT blocks "the ink forms separate blocks, each a filled rectangle"

  (DET &bg DominantColor)

  (INIT &blocks Connectivity
    (node (P)
      (input *P *Col)
      (NOT (&bg (:C Col)))))

  (INIT &bbox BoundingBox
    (key ((&blocks.component *P ^Id))
      (cell (P)
        (&blocks.component *P Id)))))

(INPUT counts "one block has three colors and every other block has two")

(OUTPUT most "the output is the block with the most colors"

  (INIT &colors Cardinality
    (key ((&blocks.component *P ^Id)
          (input P *Col))
      (member ((:m Col))
        (&blocks.component *P Id)
        (input P *Col))))

  (INIT &most Order
    (member ((:t (:V Id) (:S N)))
      (&colors.size (:key *Id) *N))
    (score ((:t (:V Id) (:S N)) (:S N))
      (&colors.size (:key *Id) *N))))

(ALTS $choice "which block is picked" $Most
  (ALT $Fixed
    (OUTPUT most "the output is the block with the stored color count"
      ;; How many colors the picked block has.
      (DET &palette ConstOutDim))
    (RULE &picked
      (&colors.size (:key *Id) *N)
      (&palette N)))
  (ALT $Odd
    (OUTPUT most "the output is the block whose color count no other block has"
      (RULE &shared
        (&colors.size (:key *Id) *N)
        (&colors.size (:key (:Id *Id2)) N)
        (!= Id Id2)))
    (RULE &picked
      (&colors.size (:key *Id))
      (NOT (&shared Id)))))

(RULE &picked
  (&most.maximal (:t (:V *Id))))

(RULE &output
  (&picked *Id)
  (&bbox.box (:key Id) *B)
  (input (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(OUT (&output ^P ^Col))
