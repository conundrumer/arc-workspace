;; inputs 7007bfd0982a54a7bff34dcc00b15aca3ab5ed33821dd71f5a4ff9a74f8bd7b7 programs/solvers/8fff9e47.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8fff9e47

(DET &block_size TileCount)

(INIT &block_division Division
  (cell ((:P P_grid_in))
    (input (:P *P_grid_in)))
  (side (A K)
    (axis_elem *A)
    (&block_size (:N *K))))

(RULE &block
  (input (:P *P_grid_in) *Col)
  (&block_division.tile (:P P_grid_in) (:P_outer *P_tile) (:P_inner *P_intile)))

;; One ring per block.
(INIT &rings Cardinality
  (member ((:m P_tile))
    (&block *P_tile)))

;; A quarter is one cell per ring wide.
(INIT &quarter Frame
  (extent (A N)
    (axis_elem *A)
    (&rings.size *N)))

(INIT &out_frame_tiling Tiling
  (outer ((:P P_intile))
    (&block *P_intile))
  (inner ((:P P_inner))
    (&quarter.cell (:P *P_inner))))

;; The output frame peels into concentric rings.
(INIT &peel Boundary
  (cell (P)
    (&out_frame_tiling.cell *P)))

(INIT &peel_depth CellDistance
  (node (P)
    (&out_frame_tiling.cell *P))
  (source (P)
    (&peel.boundary *P)))

;; The order the blocks nest in, outermost first.
(DET &corner DiagDirDomain)

(DET &axis AxisDomain)

;; The blocks in nesting order: rank 0 is the outermost ring.
(INIT &nesting Order
  (member ((:t P_tile))
    (&block *P_tile))
  (score ((:t P_tile) (:S K1))
    (&block *P_tile)
    (&corner *D)
    (&axis *A)
    (diag_dist (:P P_tile) (:Diag D) A *K1 *K2))
  (secondary_score ((:t P_tile) (:S K2))
    (&block *P_tile)
    (&corner *D)
    (&axis *A)
    (diag_dist (:P P_tile) (:Diag D) A *K1 *K2)))

(RULE &output
  (&peel_depth.distance *P *K)
  (&nesting.rank (:t *P_tile) (:R K))
  (&out_frame_tiling.cell (:P_outer *P_intile) P)
  (&block P_tile P_intile *Col))

(OUT (&output ^P ^Col))
