;; inputs fde0c5538106f250291958c9abd99558891f5523b0bb7caf3f86ccc13a6631b3 programs/solvers/d0f5fe59.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d0f5fe59

(INPUT shapes-on-background "a field of color `background` with one or more shapes, each a group of non-background cells joined through sides or corners"

  (INIT &palette_count Cardinality
    (key ((ex_input ^E *P ^Col))
      (member ((:m P))
        (ex_input E *P Col))))

  (INIT &palette Order
    (key ((&palette_count.size (:key ^E *Col)))
      (member ((:t Col))
        (&palette_count.size (:key E *Col)))
      (score ((:t Col) (:S N))
        (&palette_count.size (:key E *Col) *N))))

  (DET &uneven
    (&palette.maximal (:t *Col))
    (ex_output *E)
    (NOT (&palette.maximal (:key E) (:t Col))))

  (DET_OR_RULE &background DominantColor
    (&palette.maximal (:t *C))
    (NOT (&uneven (:Col C))))

  (RULE &ink
    (input *P *Col)
    (NOT (&background (:C Col))))

  (RULE &shape_cell
    (&ink *P))

  (INIT &side_shapes Connectivity
    (node (P)
      (&shape_cell *P))))

(INPUT one-shape-color "every shape is of one color, the shape color"

  (INIT &mark_color Singleton
    (member ((:v Col))
      (&ink *Col)))

  (RULE_OR_DET &mark_color.value))

(OUTPUT square-of-count "the output is an N×N grid, where N is the number of shapes"

  (INIT &corner_shapes Connectivity
    (node (P)
      (&shape_cell *P))
    (step ((:Delta S))
      (OR ((diag_dir_elem *D)
           (step_offset D (:V *S)))
          ((dir_elem (:D *D2))
           (step_offset (:D D2) (:V S))))))

  (RULE &shape
    (&corner_shapes.component *P (:Id *S)))

  (INIT &shapes Cardinality
    (member ((:m Id))
      (&shape (:S *Id))))

  (INIT &form_box BoundingBox
    (key ((&shape (:S ^Id) *P))
      (cell (P)
        (&shape (:S Id) *P))))

  (RULE &form
    (&shape *S *P)
    (&form_box.box (:key (:Id S)) *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner)))

  (INIT &same_form Inclusion
    (pattern ((:pattern S) (:m P_inner))
      (&form *S *P_inner))
    (observed ((:observed S) (:m P_inner))
      (&form *S *P_inner))))

(OUTPUT diagonal-marks "the output cells on the `diagonal` of the square take the shape color, and every other cell takes `background`"

  (INIT &commonest_count Cardinality
    (key ((&ink *P ^Col))
      (member ((:m P))
        (&ink *P Col))))

  (INIT &commonest Order
    (member ((:t Col))
      (&commonest_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key *Col) *N))))

(ALTS $adj "how the cells of a shape join" $CornerAdjacency
  (ALT $SideAdjacency
    (INPUT shapes-on-background "the cells of a shape join through sides only; undefined where the concept is"
      (RULE &shape
        (&side_shapes.component *P (:Id *S))))))

(ALTS $cells "which cells make up the shapes" $AllInk
  (ALT $AllInk
    (ALTS $mark "which color the marks take" $ShapeColor
      (ALT $CommonestShapeColor
        (INPUT one-shape-color "dropped")
        (OUTPUT diagonal-marks "the marks take the color that most shape cells have; undefined where that color ties")
        (RULE &mark
          (&commonest.maximal (:t *Col))))))
  (ALT $ShapesOfOneColor
    (INPUT shapes-on-background "the shapes are the groups of cells of `shape_color`, and cells of other colors are ignored; undefined where the input has no cell of `shape_color`"
      ;; The shapes are the rarest color of every train input.
      (INIT &scarcity Order
        (key ((&palette_count.size (:key ^E *Col) *N))
          (member ((:t (:V Col) (:S N)))
            (&palette_count.size (:key E *Col) *N))
          (score ((:t (:V Col) (:S N)) (:S N))
            (&palette_count.size (:key E *Col) *N))))

      (DET &not_rarest
        (&scarcity.minimal (:t (:V *Col)))
        (ex_output *E)
        (NOT (&scarcity.minimal (:key E) (:t (:V Col)))))

      (DET_OR_RULE &shape_color RarestColor
        (&scarcity.minimal (:t (:V *C)))
        (NOT (&not_rarest (:Col C))))

      (RULE &shape_cell
        (input *P *Col)
        (&shape_color (:C Col))))
    (INPUT one-shape-color "dropped")
    (OUTPUT diagonal-marks "the marks take `shape_color`")
    (RULE &mark_of
      (&shape_color (:C *Col)))))

(ALTS $counted "what the count counts" $EveryShape
  (ALT $DistinctForms
    (OUTPUT square-of-count "N is the number of shape forms up to translation; undefined where the concept is"
      (INIT &forms Quotient
        (equivalent ((:a Id) (:b Id2))
          (&same_form.equal (:observed *Id) (:pattern *Id2))))

      (INIT &shapes Cardinality
        (member ((:m Cls))
          (&forms.class (:Id *Cls)))))))

(DET &diagonal DiagAxisDomain)

(INIT &square Frame
  (extent (A N)
    (&shapes.size *N)
    (axis_elem *A)))

(RULE &marks_diagonal
  (&square.cell *P)
  (&diagonal *Da)
  (diag_axis_of *D Da)
  (diag_dist P (:Diag D) (:K1 *Ring) (:K2 Ring)))

(RULE &mark
  (&mark_color.value (:v *Col)))

(RULE &mark_of
  (&mark *Col))

(RULE &output
  (OR ((&marks_diagonal *P)
       (&mark_of *Col))
      ((&square.cell P)
       (NOT (&marks_diagonal P))
       (&background (:C Col)))))

(OUT (&output ^P ^Col))
