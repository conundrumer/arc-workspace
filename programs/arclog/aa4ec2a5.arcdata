(alts $owner
  (alt $BboxHole
    (witness nested-shape borderline $PerShapeOutline
      (relaxed holes)
      (separates "$BboxHole, $AdjacentHoled and $PerShapeOutline from the concept: a plain 2x2 shape sits inside the hole of a ring. The concept keeps the inner shape 1 and fills the rest of the hole 6. $BboxHole fills the inner shape 6 too. $AdjacentHoled turns the inner shape 8. $PerShapeOutline keeps it 1 and draws its outline 2 over the hole. $SizeLookup stores no color for a hole of 21 cells, or for the $BboxHole hole of 25 cells, so each $SizeLookup case is undefined.")
      (input (grid
        (4 4 4 4 4 4 4 4 4 4 4)
        (4 1 1 1 1 1 1 1 4 4 4)
        (4 1 4 4 4 4 4 1 4 4 4)
        (4 1 4 4 4 4 4 1 4 4 4)
