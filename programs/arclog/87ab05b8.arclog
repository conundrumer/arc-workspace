;; inputs 1d55dc2f9d6de0b91ee0b53f65eb298974e0429bd1bb2e68c5de3d9b7ad3ec88 programs/solvers/87ab05b8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 87ab05b8

(DET &divisor TileCount)

(DET &marker RarestColor)

(RULE &marker2
  (input *P *Col)
  (&marker (:C Col)))

(INIT &region_division Division
  (key ((&divisor ^N))
    (parts (A N)
      (axis_elem *A)))
  (cell ((:P P_m))
    (&marker2 (:P *P_m))))

(INIT &region_division2 Division
  (key ((&region_division.tile (:key ^N)))
    (parts (A N)
      (axis_elem *A)))
  (cell (P)
    (input *P)))

(DET &bg DominantColor)

;; $Count — the marker's tile in a &divisor arrangement.
(RULE &region
  (&region_division.tile (:key *N) (:P_outer *P_tile))
  (&region_division2.tile (:key N) *P (:P_outer P_tile)))

(RULE &fill_color
  (&marker (:C *Col)))

(ALTS $l "locate the region" $Count
  (ALT $Block
    (DET &tile_dim TileCount)

    (INIT &region_division3 Division
      (key ((&tile_dim (:N ^K)))
        (side (A K)
          (axis_elem *A)))
      (cell ((:P P_m))
        (&marker2 (:P *P_m))))

    (INIT &region_division4 Division
      (key ((&region_division3.tile (:key ^K)))
        (side (A K)
          (axis_elem *A)))
      (cell (P)
        (input *P)))

    ;; $Block — the marker's block in a &tile_dim tiling.
    (RULE &region
      (&region_division3.tile (:key *K) (:P_outer *P_tile))
      (&region_division4.tile (:key K) *P (:P_outer P_tile))))
  (ALT $Corner
    (RULE &dp_nearer
      (&marker2 *P)
      (dist_pair P *D *K *K2)
      (< K K2))

    (RULE &dp_quadrant
      (diag_dirs (:D *Diag) *D1 *D2)
      (&dp_nearer *P (:D D1))
      (&dp_nearer P (:D D2)))

    (DET &block_dim TileCount)

    (RULE &region
      (input *P)
      (&dp_quadrant *Diag)
      (&block_dim *N)
      (diag_dist P Diag *K1 *K2)
      (< K1 N)
      (< K2 N))))

(ALTS $f "fill color" $Marker
  (ALT $Fixed
    (DET &fill RarestColor)

    (RULE &fill_color
      (&fill (:C *Col)))))

(RULE &output
  (OR ((&region *P)
       (&fill_color *Col))
      ((input P)
       (NOT (&region P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
