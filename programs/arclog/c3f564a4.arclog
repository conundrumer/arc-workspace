;; inputs f6368dfcb3cc0bf3be017ce8718a52a6cbb43c078dbdc39cf3004ab010918df1 programs/solvers/c3f564a4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c3f564a4

(DET &noise ChangedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&noise (:C Col))))

(INIT &si Periods
  (cell (P (:v Col))
    (&clean *P *Col)))

(ALTS $choice "how a noise cell finds its clean counterpart" $Shift
  (ALT $Diag
    (DET &diag DiagAxisDomain)

    (RULE &output
      (OR ((input *P (:Col *N))
           (&noise (:C N))
           (&diag (:Da *DA))
           (&clean (:P *Q) *Col)
           (same_line (:A DA) P Q))
          ;; Clean cells pass through under every case.
          ((&clean P Col))))))

(RULE &output
  ;; Clean cells pass through under every case.
  (OR ((&clean *P *Col))
      ((input P (:Col *N))
       (&noise (:C N))
       (&si.period *A *K)
       (axis_of *D A)
       (jump_offset D K (:V *Delta))
       (compose (:A P) (:B Delta) (:C *P2))
       (&clean (:P P2) Col))))

(OUT (&output ^P ^Col))
