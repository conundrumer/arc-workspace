;; inputs 9ff217f0c14f1fab56c70c9bbb4c70ecc69ade88b6b9e26b283b2616ef89e4d8 programs/solvers/e7639916.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e7639916

(INPUT scattered-marks "on a field of 0, the input holds 3 single cells of 8, and no two of them touch.")

(OUTPUT bbox-outline "each cell on the edge of the bounding box of the marks, the cells that are not background, that is not a mark becomes `outline-color`."

  (DET_OR_RULE &bg DominantColor)

  (RULE &mark
    (input *P *Col)
    (NOT (&bg (:C Col))))

  (INIT &marks_box BoundingBox
    (cell (P)
      (&mark *P))))

(OUTPUT keep-rest "every other cell keeps its input color, so the marks stay on the outline and the inside of the box stays background.")

(ALTS $choice "Which cells are the marks whose box is outlined" $NonBg
  (ALT $MarkColorStored
    (OUTPUT bbox-outline "the marks are the cells of a stored `mark-color`, and the background is not read; on an input with no cell of that color the input returns."
      (DET_OR_RULE &mark_color RarestColor
        (ex_input (:Col *C))
        (NOT (&bg C)))

      (RULE &mark
        (input *P *Col)
        (&mark_color (:C Col))))))

(RULE &outline
  (&marks_box.box *B)
  (input *P)
  (inside (:A P) B)
  (same_dist (:P1 P) (:P2 B))
  (NOT (&mark P)))

(DET &outline_color
  (ex_input *E *P (:Col *C_in))
  (ex_output E P (:Col *C))
  (!= C C_in))

(RULE &output
  (input *P (:Col *Col0))
  (IF ((&outline P))
      ((&outline_color (:C *Col)))
      ((= Col Col0))))

(OUT (&output ^P ^Col))
