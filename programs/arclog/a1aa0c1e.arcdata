        (0 0 0 0 0 0 0 9 0)
        (0 0 0 0 0 0 0 9 0)
        (8 8 0 0 0 0 0 9 5)
        (3 3 3 0 0 0 0 9 0)))
      (output ($ByColor $WidthFromLevels $TopGap &background=$Stored) (grid
        (0 0 0 0 0 0 0 9 0)
        (0 0 0 0 0 0 0 9 5)
        (0 0 0 0 0 0 0 9 0)
        (0 0 0 0 0 0 0 9 0)
        (0 0 0 0 0 0 0 9 0)
        (8 8 0 0 0 0 0 9 0)
        (3 3 3 0 0 0 0 9 0)))
      (output ($DerivedFloor $StoredWidth $Climb $BlankColumn &background=$Stored) (grid
