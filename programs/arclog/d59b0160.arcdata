        (4 7 1 3 7 7 7 7 7 7)
        (7 7 7 3 7 0 0 0 7 7)
        (4 7 7 3 7 0 4 0 7 7)
        (3 3 3 3 7 0 1 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 0 4 0 7 0 0 0 7 7)
        (7 4 1 0 7 2 0 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)))
