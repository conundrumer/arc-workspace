        (7 7 7 3 7 0 0 0 7 7)
        (4 7 7 3 7 0 4 0 7 7)
        (3 3 3 3 7 0 1 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 0 0 0 7 7)
        (7 7 7 7 7 2 0 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)))
      (output $StoredLegendCount (grid
        (4 7 1 3 7 7 7 7 7 7)
        (7 7 7 3 7 0 0 0 7 7)
        (4 7 7 3 7 0 4 0 7 7)
        (3 3 3 3 7 0 1 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)
        (7 0 4 0 7 0 0 0 7 7)
        (7 4 1 0 7 2 0 0 7 7)
        (7 7 7 7 7 7 7 7 7 7)))))
  (alt $StoredLegendCount
    (witness four-color-legend variant concept
      (separates "The legend holds four colors, and one panel holds three of them. The every-color test keeps that panel; the stored count of 3 erases it.")
