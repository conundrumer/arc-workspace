        (7 7 7 3 7 7 7 7)
        (2 7 9 3 7 7 7 7)
        (3 3 3 3 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (0 4 0 7 0 4 0 7)
        (1 0 2 7 1 2 9 7)))
      (output ($EveryColor &legend_area=$Derived) $LegendMultiset (grid
