  (alt $HeightFromInput
    (witness tall-strip variant $HeightFromPipe
      (relaxed pieces-in-a-strip)
      (separates "a strip of three rows holding two three-row bars, with the table holding an entry for a three-row bar: the stored height keeps 8 rows; $HeightFromInput makes the frame 12 rows, four times the strip's; $HeightFromInputDiff makes it 9, the strip's 3 plus 6; $HeightFromPipe makes it 7; $FixedLengths drops two rows per bar")
      (assign &piece_glyph
        (0 (grid
          (1)
          (1)))
        (1 (grid
