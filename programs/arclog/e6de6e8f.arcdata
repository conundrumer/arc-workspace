      (separates "train0's input with a blank column on each side, so 0 outnumbers 2: the stored colors give train0's output; bg=RarestColor takes 2 as the background and fills the frame with 2")
      (input (grid
        (0 2 0 0 0 2 0 2 0 2 0 0 2 0)
        (0 2 2 0 2 2 0 2 0 2 2 0 2 0)))
