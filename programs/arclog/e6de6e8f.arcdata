(alts &pipe_color
  (alt &pipe_color=$Derived
    (witness pipe_color=DominantColor variant &pipe_color=$Derived
      (relaxed pieces-in-a-strip)
      (separates "train0's input with its pieces in 4: the stored pipe color 2 finds no piece and leaves only the source; pipe_color=DominantColor takes 4, the commonest color, and lays train0's pipe in 4")
      (input (grid
        (4 0 0 0 4 0 4 0 4 0 0 4)
        (4 4 0 4 4 0 4 0 4 4 0 4)))
      (output ($HeightFromInput $StoredWidth) ($HeightFromInput $WidthFromInputDiff) ($HeightFromInputDiff $StoredWidth) ($HeightFromInputDiff $WidthFromInputDiff) ($StoredHeight $StoredWidth &pipe_color=$Stored) ($StoredHeight $WidthFromInputDiff) (grid
