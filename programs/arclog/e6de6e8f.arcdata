(alts $width
  (alt $WidthFromSteps
    (witness five-steps variant concept
      (separates "five L pieces and one bar: the stored width keeps 7 columns; $WidthFromSteps and $WidthFromInputDiff make the frame 11 columns, the strip's 16 less 5, with the source at column 3")
      (input (grid
        (2 0 0 0 2 0 2 0 0 0 2 0 2 0 0 2)
        (2 2 0 2 2 0 2 2 0 2 2 0 2 2 0 2)))
      (output $StoredWidth (grid
