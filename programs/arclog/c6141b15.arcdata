        (7 7 7 7 7 1 1 1 7 7 7 7 7)
        (7 7 7 7 7 7 1 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7 7 7 7))))))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor variant &bg=$Derived
      (relaxed background)
      (separates "The train1 input on a field of 3 in place of 7. The background derived as the commonest color reads 3 and gives the swap on that field; the stored background 7 makes the field an object, and the parse is undefined.")
      (input (grid
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 9 3 3 3 3 3 3 3 3)
