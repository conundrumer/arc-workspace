;; inputs 1c5494afede70ee7103f7226b4ab3765fb3280842631e2d870bb82a3ebbc17ed programs/solvers/06df4c85.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 06df4c85

(DET &bg SharedColor)

(DET &gap DivisorRatio)

(DET &tile_dim TileDim)

(INIT &tile_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A K)
    (axis_elem *A)
    (&tile_dim (:D *K)))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(RULE &mark
  (input (:P *P_grid) *Col)
  (&tile_division.tile (:P P_grid) (:P_outer *P_tile))
  (NOT (&bg (:C Col))))

(INIT &bet_frame Frame
  (key ((&mark (:P_tile *T) ^Col)
        (frame_extent (:P T) *A *N))
    (extent (A N)
      (&mark (:P_tile *T) Col)
      (frame_extent (:P T) *A *N))))

(INIT &bet Ray
  (key ((OR ((&mark (:P_tile *T) ^Col))
            ((&mark Col)
             (axis_elem *A)
             (axis4_of *D A))
            ((&bet_frame.cell (:key Col) *P))))
    (source ((:P T))
      (&mark (:P_tile *T) Col))
    (node (P)
      (&bet_frame.cell (:key Col) *P))
    (dir (D)
      (&mark Col)
      (axis_elem *A)
      (axis4_of *D A))))

(RULE &bet_between
  (&mark (:Col *Key))
  (&tile_division.tile (:P_outer *P))
  (axis_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&bet.ray (:key (:Col Key)) P D)
  (&bet.ray (:key (:Col Key)) P (:D O)))

(RULE &fill
  (&bet_between (:Key *Col) (:P *P_tile))
  (NOT (&mark P_tile Col)))

(ALTS $choice "The cases claim what an intervening foreign mark does" $Over
  (ALT $Around
    (RULE &fill
      (&bet_between (:Key *Col) (:P *P_tile))
      (NOT (&mark P_tile))))
  (ALT $Block
    (RULE &bg_tile
      (&tile_division.tile (:P_outer *P_tile))
      (NOT (&mark P_tile)))

    (INIT &run_frame Frame
      (extent (A N)
        (&bg_tile (:P_tile *T))
        (frame_extent (:P T) *A *N)))

    ;; Each bg tile runs through bg tiles, halting at the first mark.
    (INIT &run Ray
      (source ((:P T))
        (&bg_tile (:P_tile *T)))
      (node (P)
        (&run_frame.cell *P)
        (NOT (&mark (:P_tile P))))
      (dir (D)
        (dir_elem *D)))

    (INIT &run_full Ray
      (source ((:P T))
        (&bg_tile (:P_tile *T)))
      (node (P)
        (&run_frame.cell *P))
      (dir (D)
        (dir_elem *D)))

    (RULE &run_stop_full
      (&run.end (:P *E1) (:D *V2) (:Origin *V4))
      (neighbor (:P E1) (:D V2) (:Q *V1))
      (&run_full.ray (:P V1) (:D V2) (:K *V3) (:Origin V4)))

    (RULE &reach
      (&run_stop_full (:V1 *T2) (:V2 *D) (:V4 *P_tile))
      (dir_elem D)
      (&mark (:P_tile T2) *Col))

    (RULE &fill
      (&reach *Col *D *P_tile)
      (opposite D (:Opp *O))
      (&reach Col (:D O) P_tile))))

(RULE &covered
  (&fill (:P_tile *T))
  (&tile_division.tile (:P *P_grid) (:P_outer T)))

(RULE &output
  (OR ((&fill (:P_tile *T) *Col)
       (&tile_division.tile *P (:P_outer T)))
      ((input P Col)
       (NOT (&covered (:P_grid P))))))

(OUT (&output ^P ^Col))
