        (1 1 1 1 1 4 4)
        (1 1 1 1 4 4 4)
        (1 1 1 4 4 4 4)
        (1 1 4 4 4 4 4)
        (1 4 4 4 4 4 4)))
      (output ($DerivedBarColor $AnchorDerived &bg=$Stored) ($DerivedBarColor $AnyEdgeAnchor &bg=$Stored) ($DerivedBarColor $PerBar &bg=$Stored) undefined))))
