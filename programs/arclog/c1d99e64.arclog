;; inputs d4b9a74fb86a9d688ccc5c3c93b35fc305bf0459136836411470fa0c0d671906 programs/solvers/c1d99e64.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c1d99e64

(DET &bg RarestColor)

(DET &line AnyOutNewColor)

(RULE &has_ink
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (split P *A (:Across *P_across)))

(RULE &on_bg_line
  (input *P)
  (split P *A (:Across *P_across))
  (NOT (&has_ink A P_across)))

(RULE &output
  (OR ((&on_bg_line *P)
       (&line (:C *Col)))
      ((input P Col)
       (NOT (&on_bg_line P)))))

(OUT (&output ^P ^Col))
