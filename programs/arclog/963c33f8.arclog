;; inputs 5572598fba2d54fb5c19897b6f966f1a981224d2d6026a2e64054516f90f998b programs/solvers/963c33f8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 963c33f8

(DET &bg DominantColor)

(DET &fall DirDomain)

;; the debris the piece travels through
(DET &solid ColorDomain)

;; the piece color that debris stops; the piece's other cells pass through
(DET &stop RarestColor)

(RULE &piece
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&solid (:C Col)))
  (&fall *D)
  (axis_of D *A)
  (split P A (:Across *P_across)))

(RULE &shift
  (&piece *P)
  (&fall *D)
  (axis_of D *A)
  (sub_extent P A *K)
  (jump_offset D K *V))

(RULE &blocked
  (&piece *P_across *P *Col)
  (&shift *V)
  (compose (:A P) (:B V) (:C *P2))
  (OR ((NOT (input (:P P2))))
      ((&stop (:C Col))
       (input (:P P2) (:Col *Col2))
       (&solid (:C Col2)))))

(RULE &slide_node
  (&piece (:P_across *Key))
  (OR ((&shift (:V *P))
       (NOT (&blocked (:P_across Key) (:V P))))
      ((= P 0))))

;; Each line stands where it is, and travels through the displacements that
;; nothing blocks.
(INIT &slide Ray
  (key ((OR ((&slide_node (:Key ^Ky) *P))
            ((&piece (:P_across Ky))
             (&fall *D))))
    (source (P)
      (&slide_node (:Key Ky) *P))
    (node (P)
      (&slide_node (:Key Ky) *P))
    (dir (D)
      (&piece (:P_across Ky))
      (&fall *D))))

(RULE &landed
  (&piece *P_across (:P *P3) *Col)
  (&slide.end (:key (:Ky P_across)) (:P *V) (:Origin 0))
  (compose (:A P3) (:B V) (:C *P)))

(RULE &output
  (OR ((&landed *P *Col))
      ((input P (:Col *Col_in))
       (NOT (&landed P))
       (IF ((&piece P))
           ((&bg (:C Col)))
           ((= Col Col_in))))))

(OUT (&output ^P ^Col))
