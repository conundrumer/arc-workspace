;; inputs 9e57413ce8ac64378f4969e8141155fa4455e697dba4810786e618497cc62d3b programs/solvers/f18ec8cc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; f18ec8cc

(param &from Dir (DIR_L))
(param &shift number (1))

(exclude ($SolidLines $Cycle))

(alts $p
  (alt $SolidLines
    (witness tie-in-first-stripe borderline $SolidLines
      (relaxed dots)
      (separates "the first stripe's center line holds 5, 1 and 7 once each, so it has no single commonest color; the concept and $RotateColumns are undefined; $SolidLines cuts between the adjacent solid lines (2,3) and (6,7) and moves the 5 stripe to the right end")
      (input (grid
        (5 5 5 7 7 7 7 1 1 1 1)
        (5 1 5 7 7 1 7 1 7 1 1)
        (5 7 5 7 5 7 7 1 1 5 1)))
      (output $Commonest undefined)
      (output $SolidLines (grid
        (7 7 7 7 1 1 1 1 5 5 5)
        (7 7 1 7 1 7 1 1 5 1 5)
        (7 5 7 7 1 1 5 1 5 7 5))))
    (witness edge-dots-first-stripe borderline concept
      (relaxed dots)
      (separates "every line of the first stripe holds a dot, so none of them is solid; the concept and $RotateColumns read the 5 stripe by each line's commonest color and move it to the right end; $SolidLines finds no cut before the 1 stripe, so it takes the 5 and 7 stripes as one run and moves that run to the right end")
      (input (grid
        (5 5 7 7 7 7 1 1 1)
        (5 1 5 7 1 7 1 5 1)
        (7 5 5 7 7 7 1 1 1)))
      (output $Commonest (grid
        (7 7 7 1 1 1 5 5 7)
        (7 1 7 1 5 1 5 1 5)
        (7 7 7 1 1 1 7 5 5)))
      (output $SolidLines (grid
        (1 1 1 5 5 7 7 7 7)
        (1 5 1 5 1 5 7 1 7)
        (1 1 1 7 5 5 7 7 7))))
    (witness mixed-later-run borderline concept
      (relaxed dots)
      (separates "every line of the first stripe holds a dot, and the 1 and 3 stripes meet at a dotted line, so no cut falls between their solid lines; the concept and $RotateColumns move the 5 stripe to the right end; $SolidLines & $RotateColumns moves the 5 and 7 stripes, its first run, to the right end; $SolidLines is undefined, as its last run holds solid lines of 1 and of 3")
      (input (grid
        (5 5 7 7 7 7 1 1 1 3 3)
        (5 1 5 7 1 7 1 5 1 1 3)
        (7 5 5 7 7 7 1 1 1 3 3)))
      (output $Commonest (grid
        (7 7 7 1 1 1 3 3 5 5 7)
        (7 1 7 1 5 1 1 3 5 1 5)
        (7 7 7 1 1 1 3 3 7 5 5)))
      (output $SolidLines (grid
        (1 1 1 3 3 5 5 7 7 7 7)
        (1 5 1 1 3 5 1 5 7 1 7)
        (1 1 1 3 3 7 5 5 7 7 7))))))

(alts $r
  (alt $RotateColumns
    (witness tie-in-later-stripe borderline $RotateColumns
      (relaxed dots)
      (separates "the 4-wide first stripe's lines each have one commonest color, but the center lines of the 7 and 1 stripes each hold three colors once; the concept (stripes as runs of lines with one commonest color) is undefined there; $RotateColumns needs only the first stripe and rotates the lines by its width 4; $SolidLines cuts between adjacent solid lines and gives the same cycle")
      (input (grid
        (5 5 5 5 7 7 7 1 1 1)
        (5 1 5 5 7 5 7 1 7 1)
        (5 5 7 5 7 1 7 1 5 1)))
      (output concept undefined)
      (output $RotateColumns (grid
        (7 7 7 1 1 1 5 5 5 5)
        (7 5 7 1 7 1 5 1 5 5)
        (7 1 7 1 5 1 5 5 7 5))))))
