;; inputs bbf6f39885460a3ab6e366a243c870a55a3579ebcbb07d0077a330c8af5122b7 programs/solvers/880c1354.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 880c1354

;; The colors of the band between the regions. They stay put.
(DET &fixed UnchangedColor (SET))

;; The sense in which a region's color moves to the next region.
(DET &sense SenseDomain)

(RULE &region
  (input *P (:Col *C))
  (NOT (&fixed C)))

(RULE &border_step
  (input *P)
  (&sense *S)
  (turn S *D (:D2 *D_step))
  (margin (:B P) D (:K 0))
  (neighbor P (:D D_step) *Q)
  (input (:P Q)))

;; The border cells a walk from region cell p reaches, passing over band cells.
(INIT &onward Propagation
  (key ((&region ^P))
    (source ((:n Q))
      (&border_step P *Q)))
  (edge ((:a P2) (:b Q))
    (&border_step (:P *P2) *Q)
    (input (:P P2) (:Col *C))
    (&fixed C)))

(RULE &next_cell
  (&onward.reached (:key *P) (:n *Q))
  (&region (:P Q)))

(RULE &next_color
  (&region *P *C)
  (&next_cell P *Q)
  (&region (:P Q) (:C *C_next))
  (!= C_next C))

(ALTS $choice "what a region is" $ByColor
  (ALT $ByObject
    (INIT &obj Connectivity
      (key ((&region *P ^C))
        (node (P)
          (&region *P C))))

    (RULE &next_obj
      (&obj.component *P *Id)
      (&next_cell P *Q)
      (&obj.component (:P Q) (:Id *Id_next))
      (!= Id_next Id))

    (RULE &output
      (OR ((&obj.component *P (:Id *Id_next))
           (&next_obj *Id Id_next)
           (&obj.component (:key *C) Id))
          ((input P (:Col C))
           (&fixed C))))))

(RULE &output
  (OR ((input *P (:Col *C))
       (&fixed C))
      ((&region P (:C *C_next))
       (&next_color C C_next))))

(OUT (&output ^P ^C))
