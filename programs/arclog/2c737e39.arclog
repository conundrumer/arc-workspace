;; inputs 24b61c8c1cceafde7fa09c0d4aa0d7dbe3cb9456b748e5fa2ef823c0aa9fe08a programs/solvers/2c737e39.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 2c737e39

(DET &bg DominantColor)

(DET &mark SharedColor)

(INIT &obj Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(RULE &drawing
  (&obj.component *P *Id)
  (&obj.component (:P *Q) Id)
  (!= P Q))

(RULE &drawn
  (&obj.component *P *Id)
  (&drawing Id)
  (input P *Col))

(RULE &shift
  (&drawn *P *Col)
  (&mark (:C Col))
  (input (:P *Q) Col)
  (NOT (&drawn (:P Q)))
  (relative (:Base P) (:X Q) (:X_rel *V)))

(RULE &footprint
  (&drawn *P))

(ALTS $choice "what the copy carries" $Transparent
  (ALT $Opaque
    (INIT &bbox BoundingBox
      (cell (P)
        (&drawn *P)))

    (RULE &footprint
      (&bbox.box *B)
      (input *P)
      (inside (:A P) B))))

(RULE &stamp
  (&footprint (:P *P2))
  (input (:P P2) (:Col *C))
  (&shift *V)
  (compose (:A P2) (:B V) (:C *P))
  (input P)
  (OR ((&mark C)
       (&bg (:C *Col)))
      ((NOT (&mark C))
       (= Col C))))

(RULE &output
  (OR ((&stamp *P *Col))
      ((input P Col)
       (NOT (&stamp P)))))

(OUT (&output ^P ^Col))
