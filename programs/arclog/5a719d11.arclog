;; inputs 9606947ed2474241b57226744e6ecae9b8a44fd1f13aafa0a5a9112d021fa3e4 programs/solvers/5a719d11.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5a719d11

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

(RULE &frame_on_divider
  (input *P)
  (&line_color.value (:key *A *L))
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &frame_rank Order
  (key ((OR ((&line_color.value (:key *A *L))
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&line_color.value (:key *A *L))
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&line_color.value (:key *A *L))
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D *K)
  (&frame_rank.rank (:key D) (:t K) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each panel's box, so paired panels share a cell vocabulary.
(INIT &panel BoundingBox
  (key ((&frame_tile_of *P (:P_tile ^T)))
    (cell (P)
      (&frame_tile_of *P (:P_tile T)))))

(RULE &panel_cell
  (&panel.cell (:key *T) (:P *P_grid))
  (&panel.box (:key T) *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_intile)))

(INIT &ground_count Cardinality
  (key ((&panel_cell ^T *P_grid)
        (input (:P P_grid) ^Col))
    (member ((:m P_grid))
      (&panel_cell T *P_grid)
      (input (:P P_grid) Col))))

;; The axis a panel pairs across.
(DET &pair_axis AxisDomain)

;; The ground a panel is drawn on: its commonest color.
(INIT &ground Order
  (key ((&ground_count.size (:key ^T *Col)))
    (member ((:t Col))
      (&ground_count.size (:key T *Col)))
    (score ((:t Col) (:S N))
      (&ground_count.size (:key T *Col) *N))))

(RULE &mark
  (&panel_cell *T *P_grid *P_intile)
  (input (:P P_grid) *Col)
  (NOT (&ground.maximal (:key T) (:t Col))))

(RULE &output
  (OR ((&panel_cell *T (:P_grid *P) *P_intile)
       (&pair_axis *A)
       (axis_inversion A (:T *D))
       (apply D (:P T) (:P_out *T2))
       (IF ((&mark (:T T2) P_intile))
           ((&ground.maximal (:key (:T T2)) (:t *Col)))
           ((&ground.maximal (:key T) (:t Col)))))
      ((input P Col)
       (NOT (&frame_tile_of P)))))

(OUT (&output ^P ^Col))
