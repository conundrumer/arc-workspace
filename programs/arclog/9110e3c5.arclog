;; inputs 646651e11594ce7efde5887c2fd9d756497173aac89cecf30d06f813e49e90a3 programs/solvers/9110e3c5.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 9110e3c5

(DET &bg SharedColor)

(RULE &ink_cell
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &common_count Cardinality
  (key ((&ink_cell *P ^Col))
    (member ((:m P))
      (&ink_cell *P Col))))

(INIT &common Order
  (member ((:t Col))
    (&common_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&common_count.size (:key *Col) *N)))

(DET &glyph
  (&common.maximal *E (:t *Key))
  (ex_output E *P *Col))

(ALTS $choice "what makes a color the ink" $Count
  (ALT $Object
    ;; Touching cells of one color.
    (INIT &comps Connectivity
      (key ((&ink_cell *P ^Col))
        (node (P)
          (&ink_cell *P Col))))

    (INIT &comp_size Cardinality
      (key ((&comps.component *P ^Id))
        (member ((:m P))
          (&comps.component *P Id))))

    ;; Each color scored by the largest component it forms.
    (INIT &biggest Order
      (member ((:t (:V Col) (:S N)))
        (&comps.component (:key *Col) *Id)
        (&comp_size.size (:key Id) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&comps.component (:key *Col) *Id)
        (&comp_size.size (:key Id) *N)))

    (RULE &output
      (&biggest.maximal (:t (:V *Key)))
      (&glyph Key *P *Col))))

(RULE &output
  (&common.maximal (:t *Key))
  (&glyph Key *P *Col))

(OUT (&output ^P ^Col))
