(alts $c
  (alt $ThirdColorShape
    (witness recolored-shape variant $ThirdColorShape
      (relaxed field-with-holes)
      (relaxed one-shape)
      (separates "the template is drawn in green: ThirdColorShape and the rarest-color derivation take green as the shape color and stamp green copies, the concept finds no red cell and returns the input")
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 3 3 3 3 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output ($StoredShape &shape_color=$Stored) (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 3 3 3 3 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
