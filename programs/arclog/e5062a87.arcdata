        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 2 2 2 2 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output ($SeatOnShape $Join4) (grid
