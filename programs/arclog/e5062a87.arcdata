        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output $ExclusiveFits (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 0 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5))))))

(alts $adj
  (alt $Join8
    (witness diagonal-template borderline $Join8
      (relaxed one-shape)
      (separates "the template is a vertical domino with a cell touching it at a corner: PerObject with 4-adjacency stamps the lone cell on every black cell, Join8 stamps the whole drawing")
      (input (grid
        (5 5 5 5 0 5 5 5 5 5)
        (5 5 5 5 0 5 5 5 0 5)
        (5 0 5 0 5 5 0 5 5 5)
        (5 0 5 0 5 5 0 0 5 5)
        (5 0 0 0 0 5 5 5 0 5)
        (5 5 5 0 5 0 5 0 0 5)
        (0 5 0 0 5 0 5 5 5 5)
        (5 5 5 0 0 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 5 2 5)))
      (output ($OwnOrientation $WholeShape) $Join8 (grid
        (5 5 5 5 0 5 5 5 5 5)
        (5 5 5 5 0 5 5 5 0 5)
        (5 2 5 2 5 5 0 5 5 5)
        (5 2 5 2 5 5 0 0 5 5)
        (5 0 2 0 2 5 5 5 0 5)
        (5 5 5 2 5 0 5 0 0 5)
        (0 5 0 2 5 0 5 5 5 5)
        (5 5 5 0 2 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 5 2 5)))
      (output ($AllFits $Join4) (grid
        (5 5 5 5 2 5 5 5 5 5)
        (5 5 5 5 2 5 5 5 2 5)
        (5 2 5 2 5 5 2 5 5 5)
        (5 2 5 2 5 5 2 2 5 5)
        (5 2 2 2 2 5 5 5 2 5)
        (5 5 5 2 5 2 5 2 2 5)
        (2 5 2 2 5 2 5 5 5 5)
        (5 5 5 2 2 2 5 2 5 2)
        (2 5 5 5 5 2 5 2 5 2)
        (5 2 2 2 2 2 5 5 2 5)))
      (output ($ExclusiveFits $Join4) (grid
        (5 5 5 5 0 5 5 5 5 5)
        (5 5 5 5 0 5 5 5 2 5)
        (5 0 5 0 5 5 0 5 5 5)
        (5 0 5 0 5 5 0 2 5 5)
        (5 0 2 0 2 5 5 5 0 5)
        (5 5 5 0 5 0 5 2 0 5)
        (2 5 2 0 5 0 5 5 5 5)
        (5 5 5 0 2 0 5 2 5 0)
        (2 5 5 5 5 0 5 2 5 0)
        (5 2 2 2 2 0 5 5 2 5)))
      (output $MirrorCopies (grid
        (5 5 5 5 0 5 5 5 5 5)
        (5 5 5 5 2 5 5 5 0 5)
        (5 2 5 2 5 5 0 5 5 5)
        (5 2 5 2 5 5 0 0 5 5)
        (5 0 2 0 2 5 5 5 0 5)
        (5 5 5 2 5 0 5 0 0 5)
        (0 5 0 2 5 0 5 5 5 5)
        (5 5 5 0 2 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 5 2 5))))))

(alts $f
  (alt $PerObject
    (witness two-templates borderline $PerObject
      (relaxed one-shape)
      (separates "a second red bar at row 8 cols 5-8: PerObject stamps each bar at the two runs of four, the concept reads both bars as one footprint, which fits nowhere")
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 2 2 2 2 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output $WholeShape (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
