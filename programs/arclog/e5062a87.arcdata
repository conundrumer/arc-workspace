(alts &field_color
  (alt &field_color=$Derived
    (witness field_color=DominantColor borderline concept
      (separates "black outnumbers gray: the derivation takes black as the field, so the gray cells are the seats and no copy fits; NonFieldSeat at its stored field color and the concept paint the carved 3x2 hole")
      (input (grid
        (5 5 5 5 5 0 0 0 5 0)
        (5 0 0 5 0 0 0 5 0 0)
        (5 0 0 5 0 0 5 0 0 0)
        (5 0 0 5 0 5 0 0 0 5)
        (5 5 5 5 5 0 0 0 5 0)
        (0 0 0 5 0 0 0 5 0 0)
        (0 0 5 0 0 0 2 2 0 0)
        (0 5 0 0 0 5 2 2 0 5)
