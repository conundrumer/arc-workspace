        (0 5 0 0 0 5 2 2 0 5)
        (5 0 0 0 5 0 2 2 5 0)
        (0 0 0 5 0 0 0 5 0 0)))
      (output ($HoleSeat &field_color=$Derived) undefined)
      (output $SeatOnShape (grid
