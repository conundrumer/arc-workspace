(param &identity D4 (D4_ID))
(param &hole_color Color (0))
(param &field_color Color (5))
(param &shape_color Color (2))
(param &mirror_axis Axis (AXIS_V))

(exclude ($ExclusiveFits $MirrorCopies) "Mirrored copies with exclusive fits fail train1, so that combination is no case.")

(alts $o
  (alt $MirrorCopies
    (witness mirrored-hole ordinary concept
      (separates "a hole in the shape of the template mirrored top to bottom, at (0,8), (0,9), (1,8), (2,8): MirrorCopies paints it, the concept keeps it black")
      (input (grid
        (5 5 5 5 0 5 5 5 0 0)
        (5 5 5 5 0 5 5 5 0 5)
        (5 0 5 0 5 5 0 5 0 5)
        (5 0 5 0 5 5 0 0 5 5)
        (5 0 0 0 0 5 5 5 0 5)
        (5 5 5 0 5 0 5 0 0 5)
        (0 5 0 0 5 0 5 5 5 5)
        (5 5 5 0 0 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 2 2 5)))
      (output $OwnOrientation (grid
        (5 5 5 5 0 5 5 5 0 0)
        (5 5 5 5 0 5 5 5 0 5)
        (5 2 5 2 5 5 0 5 0 5)
        (5 2 5 2 5 5 0 0 5 5)
        (5 2 2 2 2 5 5 5 0 5)
        (5 5 5 2 5 0 5 0 0 5)
        (0 5 0 2 5 0 5 5 5 5)
        (5 5 5 2 2 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 2 2 5)))
      (output $MirrorCopies (grid
        (5 5 5 5 0 5 5 5 2 2)
        (5 5 5 5 0 5 5 5 2 5)
        (5 2 5 2 5 5 0 5 2 5)
        (5 2 5 2 5 5 0 0 5 5)
        (5 2 2 2 2 5 5 5 0 5)
        (5 5 5 2 5 0 5 0 0 5)
        (0 5 0 2 5 0 5 5 5 5)
        (5 5 5 2 2 0 5 2 5 0)
        (0 5 5 5 5 0 5 2 5 0)
        (5 0 0 0 0 0 5 2 2 5))))))

(alts $s
  (alt $NonFieldSeat
    (witness third-color borderline concept
      (relaxed field-with-holes)
      (separates "a cell of a third color at (3,8) ends a run of three black cells: NonFieldSeat paints the run and that cell, the concept keeps them")
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 3 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output ($HoleSeat $StoredShape &shape_color=$Stored) (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 2 2 2 2 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 3 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output &shape_color=$Derived (grid
        (3 5 5 5 5 3 3 5 3 5)
        (5 3 5 3 3 3 3 5 5 5)
        (5 5 5 5 5 3 5 3 3 5)
        (5 3 5 5 5 3 3 3 3 5)
        (5 5 5 5 3 3 5 3 5 5)
        (5 2 2 2 2 5 3 3 3 3)
        (3 5 5 5 5 5 5 3 5 5)
        (3 3 5 5 5 3 3 5 5 3)
        (5 3 5 5 3 5 3 5 3 5)
        (5 5 3 5 3 5 5 5 5 5)))
      (output $ThirdColorShape undefined)
      (output $NonFieldSeat (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 2 2 2 2 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 2 2 2 2 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5))))))

(alts $t
  (alt $SeatOnShape
    (witness fit-over-template ordinary concept
      (separates "a black cell at (5,0) beside the bar: SeatOnShape paints it, since the bar shifted one column left covers it and three template cells; the concept keeps it black")
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (0 2 2 2 2 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output $OffShape (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 2 2 2 2 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (0 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output $SeatOnShape (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 2 2 2 2 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (2 2 2 2 2 5 2 2 2 2)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5))))))

(alts $x
  (alt $ExclusiveFits
    (witness overlapping-fits borderline concept
      (relaxed placements-disjoint)
      (separates "a run of five black cells, row 1 cols 3-7, holds two overlapping fits of the 1x4 bar: the concept paints the whole run, ExclusiveFits paints neither fit")
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 0 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
        (5 5 5 5 0 0 5 0 5 5)
        (5 2 2 2 2 5 0 0 0 0)
        (0 5 5 5 5 5 5 0 5 5)
        (0 0 5 5 5 0 0 5 5 0)
        (5 0 5 5 0 5 0 5 0 5)
        (5 5 0 5 0 5 5 5 5 5)))
      (output $AllFits (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 2 2 2 2 2 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
