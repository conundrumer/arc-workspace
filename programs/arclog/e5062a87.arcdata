  (alt &paint_color=$Stored
    (witness paint_color=stored ordinary concept
      (separates "a stored paint color apart from the shape color: the branch paints the fits in that color, the concept in the shape color")
      (assign &paint_color (3))
      (input (grid
        (0 5 5 5 5 0 0 5 0 5)
        (5 0 5 0 0 0 0 5 5 5)
        (5 5 5 5 5 0 5 0 0 5)
        (5 0 5 5 5 0 0 0 5 5)
