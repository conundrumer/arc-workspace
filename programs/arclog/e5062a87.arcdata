        (0 0 5 0 0 0 2 2 0 0)
        (0 5 0 0 0 5 2 2 0 5)
        (5 0 0 0 5 0 2 2 5 0)
        (0 0 0 5 0 0 0 5 0 0))))))

(alts &shape_color
  (alt &shape_color=$Derived
    (witness shape_color=RarestColor borderline concept
      (separates "gray is the rarest color: the derivation takes the two gray cells as the shape and paints gray at their fits, the concept stamps the red bar")
      (input (grid
        (2 2 2 0)
        (5 0 0 0)
        (0 5 0 0)))
      (output ($OffShape &field_color=$Stored &shape_color=$Stored) (grid
        (2 2 2 0)
        (5 2 2 2)
        (0 5 0 0)))
      (output ($WholeShape &shape_color=$Derived) (grid
        (2 2 2 0)
        (5 5 5 0)
        (0 5 5 5)))
      (output ($HoleSeat &field_color=$Derived) undefined)
      (output ($Join4 &shape_color=$Derived) (grid
        (2 2 2 5)
        (5 5 5 5)
        (5 5 5 5)))
      (output $SeatOnShape (grid
        (2 2 2 2)
        (5 2 2 2)
        (0 5 0 0)))
      (output ($NonFieldSeat &field_color=$Derived) (grid
        (2 2 2 0)
        (5 0 0 0)
        (0 5 0 0))))))

