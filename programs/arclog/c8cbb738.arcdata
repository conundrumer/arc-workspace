;; inputs eeab8315b8a5c17cba511b453e9353402728581222d5f1777cbaaae4d75b4cbc programs/solvers/c8cbb738.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c8cbb738

(param &marks_per_figure number (4))

(alts $frame
  (alt $UnionFrame
    (witness no-square-figure variant $UnionFrame
      (relaxed largest-figure-is-square)
      (separates "No figure is a square, and a 3x5 rectangle is the widest figure: the concept pads to a 5x5 square, $UnionFrame crops to the 3x5 box of the centered figures, and $SquareFigureFrame crops to the 3x3 box of the diamond and drops the rectangle.")
      (input (grid
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 4 3 3 3 4 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 4 3 3 3 4 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 1 3 3 3)
        (3 3 3 3 3 3 1 3 1 3 3)
        (3 3 3 3 3 3 3 1 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)))
      (output $LargestSquare (grid
        (3 3 3 3 3)
        (4 3 1 3 4)
        (3 1 3 1 3)
        (4 3 1 3 4)
        (3 3 3 3 3)))
      (output $UnionFrame (grid
        (4 3 1 3 4)
        (3 1 3 1 3)
        (4 3 1 3 4)))
      (output $SquareFigureFrame (grid
        (3 1 3)
        (1 3 1)
        (3 1 3)))))
  (alt $SquareFigureFrame
    (witness rectangle-outgrows-square borderline $UnionFrame
      (relaxed largest-figure-is-square)
      (separates "A 3x5 rectangle is wider than the 3x3 square: the concept gives a 5x5 square, $UnionFrame the 3x5 box of the centered figures, and $SquareFigureFrame the 3x3 box of the square, which drops the rectangle.")
      (input (grid
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 8 3 8 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)
        (3 8 3 8 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 1 3 3)
        (3 3 4 3 3 3 4 1 3 1 3)
        (3 3 3 3 3 3 3 3 1 3 3)
        (3 3 4 3 3 3 4 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3)))
      (output $LargestSquare (grid
        (3 3 3 3 3)
        (4 8 1 8 4)
        (3 1 3 1 3)
        (4 8 1 8 4)
        (3 3 3 3 3)))
      (output $UnionFrame (grid
        (4 8 1 8 4)
        (3 1 3 1 3)
        (4 8 1 8 4)))
      (output $SquareFigureFrame (grid
        (8 1 8)
        (1 3 1)
        (8 1 8))))))

(alts $figures
  (alt $CountedClasses
    (witness stray-dot borderline concept
      (relaxed one-figure-per-color)
      (separates "A color has one cell: the concept stacks it as a figure on the output's center, and $CountedClasses drops it because it does not have 4 cells.")
      (input (grid
        (8 3 8 3 3)
        (3 3 3 3 3)
        (8 3 8 1 3)
        (3 3 1 3 1)
        (2 3 3 1 3)))
      (output $EveryColorClass (grid
        (8 1 8)
        (1 2 1)
        (8 1 8)))
      (output ($CountedClasses &marks_per_figure=$Stored) (grid
        (8 1 8)
        (1 3 1)
        (8 1 8)))
      (output &marks_per_figure=TileCount undefined)
      (output &marks_per_figure=TileDim (grid
        (2))))))

(alts &marks_per_figure
  (alt &marks_per_figure=TileCount
    (witness marks_per_figure=TileCount borderline concept
      (relaxed one-figure-per-color)
      (separates "A color has 2 cells on a 5x5 grid, beside a 4-cell corner figure: the stored count 4 keeps the corner figure, and the count TileCount derives from the grid's side keeps the 2-cell figure alone.")
      (input (grid
        (8 3 8 3 3)
        (3 3 3 3 3)
        (8 3 8 3 3)
        (3 3 3 3 3)
        (3 2 3 2 3)))
      (output $EveryColorClass (grid
        (8 3 8)
        (2 3 2)
        (8 3 8)))
      (output ($CountedClasses &marks_per_figure=$Stored) (grid
        (8 3 8)
        (3 3 3)
        (8 3 8)))
      (output ($LargestSquare &marks_per_figure=TileCount) ($LargestSquare &marks_per_figure=TileDim) (grid
        (3 3 3)
        (2 3 2)
        (3 3 3)))
      (output ($SquareFigureFrame $CountedClasses) undefined)
      (output ($UnionFrame $CountedClasses) (grid
        (2 3 2)))))
  (alt &marks_per_figure=TileDim
    (witness marks_per_figure=TileDim borderline concept
      (relaxed one-figure-per-color)
      (separates "A color has 2 cells on a 5x5 grid, beside a 4-cell corner figure: the stored count 4 keeps the corner figure, and the count TileDim derives from the grid's side keeps the 2-cell figure alone.")
      (input (grid
        (8 3 8 3 3)
        (3 3 3 3 3)
        (8 3 8 3 3)
        (3 3 3 3 3)
        (3 2 3 2 3)))
      (output $EveryColorClass (grid
        (8 3 8)
        (2 3 2)
        (8 3 8)))
      (output ($CountedClasses &marks_per_figure=$Stored) (grid
        (8 3 8)
        (3 3 3)
        (8 3 8)))
      (output ($LargestSquare &marks_per_figure=TileCount) ($LargestSquare &marks_per_figure=TileDim) (grid
        (3 3 3)
        (2 3 2)
        (3 3 3)))
      (output ($SquareFigureFrame $CountedClasses) undefined)
      (output ($UnionFrame $CountedClasses) (grid
        (2 3 2))))))
