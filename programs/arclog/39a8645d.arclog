;; inputs 3978997d2894c0de86ba337502ee59bc0f49e8c425c9de5172279ba4736ea7e9 programs/solvers/39a8645d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 39a8645d

(DET &bg DominantColor)

(INIT &pieces Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox BoundingBox
  (key ((&pieces.component *P ^Id))
    (cell (P)
      (&pieces.component *P Id))))

(RULE &shape_cell
  (&bbox.box (:key *Id) *B)
  (&pieces.component *P Id)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &same_shape Inclusion
  (pattern ((:pattern Id) (:m P_inner))
    (&shape_cell *Id *P_inner))
  (observed ((:observed Id) (:m P_inner))
    (&shape_cell *Id *P_inner)))

(RULE &copy
  (&same_shape.equal (:observed *Id) (:pattern *Id2))
  (&pieces.component (:key *Col) Id)
  (&pieces.component (:key Col) (:Id Id2)))

(INIT &commonest_count Cardinality
  (key ((&copy ^Id *Id2))
    (member ((:m Id2))
      (&copy Id *Id2))))

;; The pieces with the most copies.
(INIT &commonest Order
  (member ((:t Id))
    (&commonest_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&commonest_count.size (:key *Id) *N)))

(RULE &output
  (&commonest.maximal (:t *Id))
  (&bbox.box (:key Id) *B)
  (input (:P *P2))
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((&pieces.component (:key *Col) (:P P2) Id))
      ((NOT (&pieces.component (:P P2) Id))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
