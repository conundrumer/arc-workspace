;; inputs dd7b2cb16b58bd8883d7d15197e12031ff23d880ef1d1f7c3fb85475efffd2df programs/solvers/60b61512.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 60b61512

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bx2 BoundingBox
  (key ((&objs.component *P ^Id))
    (cell (P)
      (&objs.component *P Id))))

(RULE &region
  (input *P)
  (&bx2.box *B)
  (inside (:A P) B))

(ALTS $choice "what the region covers" $Box
  (ALT $Stamp
    (INIT &objs2 Connectivity
      (key ((ex_input ^E *P *Col)
            (NOT (&bg (:C Col))))
        (node (P)
          (ex_input E *P *Col)
          (NOT (&bg (:C Col)))))
      (step ((:Delta S))
        (OR ((diag_dir_elem *D)
             (step_offset D (:V *S)))
            ((dir_elem (:D *D2))
             (step_offset (:D D2) (:V S))))))

    (INIT &bx BoundingBox
      (key ((&objs2.component (:key ^E) *P ^Id))
        (cell (P)
          (&objs2.component (:key E) *P Id))))

    (DET &footprint
      (&bx.box (:key *E) *B)
      (ex_output E (:P *P2) *Col)
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P))
      (NOT (&bg (:C Col))))

    (RULE &region
      (input *P)
      (&bx2.box *B)
      (inside (:A P) B)
      (relative (:Base B) (:X P) (:X_rel *P_inner))
      (&footprint (:P P_inner)))))

(RULE &painted
  (&region *P)
  (input P *Col)
  (&bg (:C Col)))

(RULE &output
  (OR ((&painted *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&painted P)))))

(OUT (&output ^P ^Col))
