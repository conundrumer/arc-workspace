;; inputs 4b82d9dcd4a9a2fea26a0f09ae485953f6c5b97986c667707dd2aec26ba4654f programs/solvers/d4b1c2b1.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d4b1c2b1

(INIT &palette Cardinality
  (member ((:m Col))
    (input *Col)))

(INIT &block Frame
  (extent (A N)
    (axis_elem *A)
    (&palette.size *N)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&block.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&output_tiling.cell (:P_outer P_tile) *P))

(OUT (&output ^P ^Col))
