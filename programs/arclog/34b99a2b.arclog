;; inputs 59c54aab6e25476b4f72ca2019c21bf00e837f6ad8fa0831e88775a1f36f3792 programs/solvers/34b99a2b.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 34b99a2b

(DET &frame_dim ConstOutDimAxis)

;; Two 5×4 subgrids side by side, with a 1-column gap.
(DET &arr_dim SepTileCountAxis)

(DET &gap DivisorRatio)

(INIT &tile_decompose_outer Frame
  (extent (A N)
    (&arr_dim *A *N)))

(INIT &tile_decompose_inner Frame
  (extent (A N)
    (&frame_dim *A *N)))

(INIT &tile_decompose_tiling Tiling
  (outer (P)
    (&tile_decompose_outer.cell *P))
  (inner (P)
    (&tile_decompose_inner.cell *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(DET &combine PanelCombine)

(RULE &decompose
  (&tile_decompose_tiling.cell *P *P_outer *P_inner))

(ALTS $d "how the grid decomposes into two subgrids" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&frame_dim A (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(ALTS $b "how the two subgrids' colors combine into the output cell" $Lookup
  (ALT $Xor
    (INIT &frame_frame Frame
      (extent (A N)
        (&frame_dim *A *N)))

    (DET &bg DominantColor)

    (DET &out_fill AnyOutNewColor)

    (DET &fill_at DivisorRatio)

    (INIT &filled Cardinality
      (key ((OR ((input (:P *P_grid_in) *Col)
                 (NOT (&bg (:C Col)))
                 (&decompose (:P P_grid_in) (:P_inner ^P_grid_out)))
                ((&frame_frame.cell (:P P_grid_out)))))
        (member ((:m P_grid_in))
          (input (:P *P_grid_in) *Col)
          (NOT (&bg (:C Col)))
          (&decompose (:P P_grid_in) (:P_inner P_grid_out)))
        (domain ()
          (&frame_frame.cell (:P P_grid_out)))))

    (RULE &output
      (&filled.size (:key (:P_grid_out *P)) *N)
      (IF ((&fill_at (:K N)))
          ((&out_fill (:C *Col)))
          ((&bg (:C Col)))))))

(INIT &combine_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_outer) (:Col C)))
    (&combine *Id (:P *P_outer) *C))
  (observed ((:observed P_grid_out) (:m (:P P_tile) (:Col C)))
    (&decompose (:P *P_grid_in) (:P_outer *P_tile) (:P_inner *P_grid_out))
    (input (:P P_grid_in) (:Col *C))))

(RULE &output
  (&combine *Id (:C_out *Col))
  (&combine_match.equal (:observed *P) (:pattern Id)))

(OUT (&output ^P ^Col))
