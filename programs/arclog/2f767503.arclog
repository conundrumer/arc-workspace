;; inputs 53813b9503ee988c4efc0afff4960fda325948a4378b842ed18674acd8b0cbe9 programs/solvers/2f767503.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 2f767503

(DET &bg DominantColor)

(DET &speck ColorDomain)

(DET &eye RarestColor)

(DET &lens UnchangedColor)

(RULE &eye2
  (input *P *Col)
  (&eye (:C Col)))

(RULE &speck2
  (input *P *Col)
  (&speck (:C Col)))

(RULE &aim
  (&eye2 *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (input (:P Q) *Col)
  (&lens (:C Col)))

(INIT &sight Ray
  (source (P)
    (&eye2 *P))
  (node (P)
    (input *P))
  (dir (D)
    (&aim *D)))

(INIT &objs Flood
  (node (P)
    (&speck2 *P))
  (source (P)
    (&sight.ray *P)
    (&speck2 P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&objs.reached P)
       (&bg (:C *Col)))
      ((NOT (&objs.reached P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
