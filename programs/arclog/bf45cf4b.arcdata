(alts $o
  (alt $MaskByColor
    (witness mask-in-two-pieces variant $MaskByColor
      (relaxed mask-shape)
      (separates "The single-color shape falls into two pieces that touch neither by side nor by corner. The concept finds three objects and is undefined; $MaskByColor takes both pieces of that color as one mask and stamps the tile on each of its cells.")
      (input (grid
        (4 4 4 4 4 4 4 4 4 4 4 4)
        (4 4 4 4 4 4 2 2 4 4 4 4)
        (4 4 4 4 4 4 2 4 4 2 4 4)
        (4 4 4 4 4 4 4 4 4 2 4 4)
        (4 4 4 4 4 4 4 4 4 4 4 4)
        (4 8 3 8 4 4 4 4 4 4 4 4)
        (4 3 4 3 4 4 4 4 4 4 4 4)
        (4 8 3 8 4 4 4 4 4 4 4 4)
        (4 4 4 4 4 4 4 4 4 4 4 4)
        (4 4 4 4 4 4 4 4 4 4 4 4)
        (4 4 4 4 4 4 4 4 4 4 4 4)
        (4 4 4 4 4 4 4 4 4 4 4 4)))
      (output $Connected undefined)
      (output $MaskByColor (grid
        (8 3 8 8 3 8 4 4 4 4 4 4)
        (3 4 3 3 4 3 4 4 4 4 4 4)
        (8 3 8 8 3 8 4 4 4 4 4 4)
        (8 3 8 4 4 4 4 4 4 8 3 8)
        (3 4 3 4 4 4 4 4 4 3 4 3)
        (8 3 8 4 4 4 4 4 4 8 3 8)
        (4 4 4 4 4 4 4 4 4 8 3 8)
        (4 4 4 4 4 4 4 4 4 3 4 3)
        (4 4 4 4 4 4 4 4 4 8 3 8))))))

