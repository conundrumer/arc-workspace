(alts $t
  (alt $TileBoxCrop
    (witness mask-cell-in-tile-box borderline concept
      (relaxed pattern-tile)
      (separates "A mask cell lies inside the tile's bounding box, in a background corner of the tile, without touching the tile. The concept copies that corner as background; $TileBoxCrop copies the mask color there into every stamped copy.")
      (input (grid
