(alts $overlap
  (alt $BackgroundBlocks
    (witness drawing-covers-key foreign concept
      (separates "The drawing lands on the key. Its blocks paint over the key dots at (1,5) and (5,1); painting only background cells keeps those dots; the block of the key's background point also clears the dot at (5,5) when it is painted.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 8 3 8 4 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 1 8 8 8 6 8 8 8 8 8 8)
