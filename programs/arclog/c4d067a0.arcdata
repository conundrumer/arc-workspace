        (7 7 7 8 9 9 9 8 5 5 5 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))))
  (alt $UnderlayDrawing
    (witness drawing-covers-key foreign concept)))

(alts $edge
  (alt $NoClip
    (witness drawing-off-grid borderline concept
      (relaxed fits-grid)
      (separates "The grid ends at row 11, inside the drawing's last row of blocks. Clipping draws that row's top line; a reading that needs the whole drawing inside the grid is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 4 8 4 8 8 8 8 4 4 4 8 8 4 4 4 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 4 4 4 8 8 4 4 4 8 8 8 8 8 8 8)
        (8 1 8 1 8 8 8 8 4 4 4 8 8 4 4 4 8 8 8 8 8 8 8)
