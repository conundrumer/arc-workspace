;; inputs a4c31c4beb1eab481d9affc5726f986d380ef06fa5ff6a6519f1825de1869ed8 programs/solvers/5833af48.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5833af48

(DET &bg VanishedColor)

;; The stamp's own off-color, which no other block holds.
(DET &blank RarestColor)

(DET &ink SharedColor)

(INIT &blocks Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &bbox BoundingBox
  (key ((&blocks.component ^Id *P))
    (cell (P)
      (&blocks.component Id *P))))

(RULE &block_inner
  (&blocks.component *Id *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

;; The monochrome block is the canvas, and its one color is the fill.
(INIT &uni Singleton
  (key ((&blocks.component ^Id *P)
        (input P *Col))
    (member ((:v Col))
      (&blocks.component Id *P)
      (input P *Col))))

(RULE &stamp
  (&blocks.component *Id *P)
  (input P *Col)
  (&blank (:C Col)))

(RULE &plan
  (&blocks.component *Id)
  (NOT (&uni.value (:key Id)))
  (NOT (&stamp Id)))

(RULE &plan_cell
  (&plan *Id)
  (&block_inner Id (:P *P2) (:P_inner *P))
  (input (:P P2) *Col))

;; The canvas seen as the output frame, divided into stamp-sized tiles.
(INIT &tiles Division
  (cell ((:P P_grid_out))
    (&uni.value (:key *Id))
    (&block_inner Id (:P_inner *P_grid_out)))
  (side (A K)
    (&stamp *Id)
    (&blocks.component Id *P)
    (&bbox.box (:key Id) *B)
    (box_extent B P *A (:N *K))))

(RULE &footprint
  (&stamp *Id)
  (&block_inner Id *P (:P_inner *P_intile))
  (input P *Col)
  (&ink (:C Col)))

(INIT &plan_parts Division
  (cell ((:P P_inner))
    (&plan_cell (:P *P_inner)))
  (parts (A N)
    (&tiles.tile (:P_outer *P_tile))
    (frame_extent (:P P_tile) *A *N)))

;; A part's pixel color, absent where the part holds more than one.
(INIT &part_color Singleton
  (key ((&plan_cell (:P *P_inner) *Col)
        (&plan_parts.tile (:P P_inner) (:P_outer ^P_tile)))
    (member ((:v Col))
      (&plan_cell (:P *P_inner) *Col)
      (&plan_parts.tile (:P P_inner) (:P_outer P_tile)))))

(RULE &marked
  (&part_color.value (:key *P_tile) (:v *Col))
  (&ink (:C Col)))

(ALTS $choice "how the plan's pixels map onto the canvas's tiles" $Ratio
  (ALT $Blocks
    (INIT &pixel_cand_division Division
      (key ((&plan_cell *P)
            (sub_extent P ^A (:K ^S)))
        (cell (P)
          (&plan_cell *P)
          (sub_extent P A (:K S)))
        (side (A (:K S))
          (&plan_cell *P)
          (sub_extent P A (:K S)))))

    (INIT &pixel_cand_division2 Division
      (key ((&plan_cell *P)
            (frame_extent P ^A (:N ^S)))
        (cell (P)
          (&plan_cell *P)
          (frame_extent P A (:N S)))
        (side (A (:K S))
          (&plan_cell *P)
          (frame_extent P A (:N S)))))

    (RULE &pixel_cand
      (OR ((&pixel_cand_division.tile (:key *A *S)))
          ((&pixel_cand_division2.tile (:key A S)))))

    (INIT &band_color_division Division
      (key ((&pixel_cand ^A ^S))
        (side (A (:K S))))
      (cell (P)
        (&plan_cell *P)))

    (INIT &band_color Singleton
      (key ((&band_color_division.tile (:key ^A ^S) *P ^P_outer)
            (&plan_cell P *Col)
            (split P A (:Across ^P_across)))
        (member ((:v Col))
          (&band_color_division.tile (:key A S) *P P_outer)
          (&plan_cell P *Col)
          (split P A (:Across P_across)))))

    ;; The pixels are as large as the plan allows.
    (INIT &pixel_size Order
      (key ((&pixel_cand ^A *S)
            (NOT (&band_color.plural (:key A S))))
        (member ((:t S))
          (&pixel_cand A *S)
          (NOT (&band_color.plural (:key A S))))
        (score ((:t S) S)
          (&pixel_cand A *S)
          (NOT (&band_color.plural (:key A S))))))

    (INIT &pixels Division
      (cell (P)
        (&plan_cell *P))
      (side (A (:K S))
        (&pixel_size.maximal (:key *A) (:t *S))))

    (RULE &marked
      (&plan_cell *P *Col)
      (&ink (:C Col))
      (&pixels.tile P (:P_outer *P_tile)))))

(RULE &inked
  (&tiles.tile *P (:P_outer *P_tile) (:P_inner *P_intile))
  (&marked P_tile)
  (&footprint P_intile))

(RULE &output
  (&tiles.tile *P)
  (IF ((&inked P))
      ((&ink (:C *Col)))
      ((&uni.value (:v Col)))))

(OUT (&output ^P ^Col))
