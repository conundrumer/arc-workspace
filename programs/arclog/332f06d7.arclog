;; inputs c16ce89687dd83a1de3612d92c6dca35d4665a3a4e0e20d906ab83264d1504c6 programs/solvers/332f06d7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 332f06d7

(DET &bg UnchangedColor)

(RULE &open
  (input *P *Col)
  (NOT (&bg (:C Col))))

(DET &piece ChangedColor)

(RULE &piece_cell
  (input *P *Col)
  (&piece (:C Col)))

;; The piece fits at a relative when its every cell lands in the corridor.
(INIT &fits Occurrences
  (cell (P)
    (&open *P))
  (shape (P)
    (&piece_cell *P)))

(RULE &slide_dir
  (&fits.occurrence (:P *Delta))
  (dir_elem *D))

;; From each fitting placement, the piece slides toward each edge until it
;; meets the background.
(INIT &slide Distance
  (key ((&slide_dir ^Delta ^D)
        (&fits.occurrence (:P Delta))
        (dir_elem D))
    (source_distance (K)
      (OR ((&piece_cell *P)
           (compose (:A P) (:B Delta) (:C *P2))
           (margin (:B P2) D *K))
          ((&piece_cell (:P *P4))
           (compose (:A P4) (:B Delta) (:C *P22))
           (input (:P *P3) *Col)
           (&bg (:C Col))
           (gap D (:P P22) (:Q P3) K))))))

(RULE &slide_travel_full
  (&slide.distance (:key *Delta *D) *K)
  (&slide_dir Delta D)
  (jump_offset D K (:V *V2)))

(DET &corridor ColorDomain)

(RULE &halt
  (&slide_travel_full *Delta *D (:V2 *V))
  (!= V 0)
  (compose (:A Delta) (:B V) (:C *Delta2)))

;; The stops of the journey: the piece starts where it stands and slides on.
(INIT &journey Propagation
  (source ((:n N))
    (= *N 0))
  (edge ((:a Delta) (:b Delta2))
    (&halt *Delta *Delta2)))

(RULE &covered
  (&journey.reached (:n *Delta))
  (&piece_cell (:P *P3))
  (compose (:A P3) (:B Delta) (:C *P)))

;; A stop with one way on has the corridor ending at it: that one way is the
;; way the piece came.
(INIT &onward Singleton
  (key ((&halt ^Delta *D))
    (member ((:v D))
      (&halt Delta *D))))

(RULE &rest
  (&journey.reached (:n *Delta))
  (!= Delta 0)
  (&onward.value (:key Delta)))

(ALTS $choice "where the piece comes to rest" $Corridor
  (ALT $Goal
    (DET &marker RarestColor)

    ;; What the marker still reaches with the piece standing at a stop.
    (INIT &ahead Flood
      (key ((&journey.reached (:n ^Delta)))
        (node (P)
          (&open *P)
          (NOT (&covered Delta P))))
      (source (P)
        (input *P *Col)
        (&marker (:C Col))))

    (RULE &short_of
      (&covered (:Delta *Delta2) *P)
      (&ahead.reached (:key *Delta) P)
      (!= Delta Delta2))

    (RULE &rest
      (&journey.reached (:n *Delta))
      (NOT (&short_of Delta)))))

(RULE &landed
  (&rest *Delta)
  (&covered Delta *P))

(RULE &output
  (OR ((&landed *P)
       (&piece (:C *Col)))
      ((&rest)
       (OR ((&piece_cell P)
            (&corridor (:C Col)))
           ((input P Col)
            (NOT (&piece_cell P))))
       (NOT (&landed P)))))

(OUT (&output ^P ^Col))
