(exclude ($MinSizeNoise $TwoAxisUndefined) "The concept case, and every case with a non-concept branch at both class points. A case with the concept branch at one class point is undefined on that point's shapes, and the case that adds a branch there subsumes it.")
(exclude ($NoAxisUndefined $TwoAxisThird) "The concept case, and every case with a non-concept branch at both class points. A case with the concept branch at one class point is undefined on that point's shapes, and the case that adds a branch there subsumes it.")
(exclude ($NoAxisUndefined $TwoAxisErased) "The concept case, and every case with a non-concept branch at both class points. A case with the concept branch at one class point is undefined on that point's shapes, and the case that adds a branch there subsumes it.")
(exclude ($NoAxisThird $TwoAxisUndefined) "The concept case, and every case with a non-concept branch at both class points. A case with the concept branch at one class point is undefined on that point's shapes, and the case that adds a branch there subsumes it.")
(exclude ($NoAxisErased $TwoAxisUndefined) "The concept case, and every case with a non-concept branch at both class points. A case with the concept branch at one class point is undefined on that point's shapes, and the case that adds a branch there subsumes it.")
