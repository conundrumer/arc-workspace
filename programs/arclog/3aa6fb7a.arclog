;; inputs 3a5defb4029512996b53b833d3874ee6197c8a100ef61715d6afab64dc46d75a programs/solvers/3aa6fb7a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3aa6fb7a

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &empty
  (input *P *Col)
  (&bg (:C Col)))

(RULE &mark
  (&empty *P)
  (diag_dirs (:D *G) *D1 *D2)
  (neighbor P (:D D1) (:Q *Q1))
  (&ink (:P Q1))
  (neighbor P (:D D2) (:Q *Q2))
  (&ink (:P Q2))
  (neighbor P (:D G) (:Q *Q3))
  (&ink (:P Q3)))

(ALTS $choice "what marks a cell" $Corner
  (ALT $Box
    (INIT &parts Connectivity
      (node (P)
        (&ink *P)))

    (INIT &part_box BoundingBox
      (key ((&parts.component *P ^Id))
        (cell (P)
          (&parts.component *P Id))))

    (RULE &mark
      (&empty *P)
      (&part_box.box *B)
      (inside (:A P) B))))

(RULE &output
  (OR ((&mark *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&mark P)))))

(OUT (&output ^P ^Col))
