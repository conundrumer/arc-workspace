;; inputs 4b908f41cfb46f7d79559619be671720ac4b97f8212e1f2593959dd0910eb546 programs/solvers/1990f7a8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1990f7a8

(DET &bg DominantColor)

;; The shapes, each with its own bounding box.
(INIT &obj Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox2 BoundingBox
  (key ((&obj.component *P ^Id))
    (cell (P)
      (&obj.component *P Id))))

(RULE &quad_cell
  (&bbox2.box (:key (:Id *Key)) (:B *P)))

(INIT &obj2 Connectivity
  (key ((ex_input ^E *P *Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (ex_input E *P *Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox BoundingBox
  (key ((&obj2.component (:key ^E) *P ^Id))
    (cell (P)
      (&obj2.component (:key E) *P Id))))

(DET &block_dim
  (&bbox.box (:key (:E *Ky_e) (:Id *Ky_id)) *B)
  (&bbox.cell (:key (:E Ky_e) (:Id Ky_id)) *P)
  (perp *A *A2)
  (box_extent B P A (:N *K))
  (box_extent B P (:A A2) (:N K)))

(DET &out_dim ConstOutDim)

(INIT &frame_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&out_dim *N)))

(DET &gap NumberDomain)

(INIT &block_division Division
  (cell ((:P P_grid_out))
    (&frame_frame.cell (:P *P_grid_out)))
  (side (A K)
    (axis_elem *A)
    (&block_dim *K))
  (gap (A G)
    (axis_elem *A)
    (&gap (:N *G))))

(ALTS $choice "which corner a shape claims" $Grid
  (ALT $Span
    ;; The four boxes' joint span, and each box's margins inside it.
    (INIT &span BoundingBox
      (cell (P)
        (&obj.node *P)))

    (RULE &quad_cell
      (&bbox2.box (:key (:Id *Key)) *B)
      (&span.box (:B *B_span))
      (relative (:Base B_span) (:X B) (:X_rel *P)))))

(RULE &quad_nearer
  (&quad_cell *Key *P)
  (dist_pair P *D *K *K2)
  (< K K2))

(RULE &quad_quadrant
  (diag_dirs (:D *Diag) *D1 *D2)
  (&quad_nearer *Key *P (:D D1))
  (&quad_nearer Key P (:D D2)))

(RULE &paint
  (&obj.component (:P *P_grid_in) *Id)
  (input (:P P_grid_in) *Col)
  (&bbox2.box (:key Id) *B)
  (inside (:A P_grid_in) B)
  (relative (:Base B) (:X P_grid_in) (:X_rel *P_intile))
  (&quad_quadrant (:Key Id) *Diag)
  (&block_division.tile *P (:P_outer *P_tile) (:P_inner P_intile))
  (corner_dist (:P P_tile) Diag (:K 0)))

(RULE &output
  (OR ((&paint *P *Col))
      ((&frame_frame.cell P)
       (NOT (&paint P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
