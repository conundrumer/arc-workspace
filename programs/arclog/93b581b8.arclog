;; inputs 884ef56dac2c95f528bb55a40bbae832df848eb40a66fa4d00209ed9807abef7 programs/solvers/93b581b8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 93b581b8

(DET &bg DominantColor)

;; Carries a block corner onto the corner its color fills.
(DET &transform D4Domain)

(INIT &block BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &corner_color
  (input *P *Col)
  (&block.box *B)
  (inside (:A P) B)
  (same_corner *D (:P1 P) (:P2 B)))

;; The copy clears the block's own extent, so it touches the block at the corner.
(RULE &reach
  (&block.box *B)
  (input *P)
  (axis_of *D *A)
  (box_extent B P A (:N *K)))

(ALTS $choice "what fixes how far a copy clears the block" $Abut
  (ALT $Stride
    (DET &stride TileCount)

    (RULE &reach
      (dir_elem *D)
      (&stride (:N *K)))))

(RULE &copy
  (&block.box (:B *B3))
  (diag_dirs (:D *E1) *D1 *D2)
  (&reach (:D D1) (:K *K1))
  (jump (:P B3) (:D D1) (:K K1) (:Q *B1))
  (&reach (:D D2) (:K *K2))
  (jump (:P B1) (:D D2) (:K K2) (:Q *B)))

(RULE &painted
  (input *P)
  (&copy (:E1 *E) (:B *B2))
  (inside (:A P) (:B B2))
  (&transform *D)
  (apply_diag_dir D (:Dir *C) (:Dir_out E))
  (&corner_color (:D C) *Col))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))

(OUT (&output ^P ^Col))
