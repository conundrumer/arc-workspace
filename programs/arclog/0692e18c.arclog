;; inputs ff0447a02dd344adba687ce5b56916fe2ae27da49f548de7fc4a5fdff29c81b5 programs/solvers/0692e18c.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 0692e18c

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg SharedColor)

(RULE &active
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &stamped
  (&cell_tiling.cell (:P *P_grid) (:P_outer *P_tile) (:P_inner *P_intile))
  (&active (:P P_tile))
  (NOT (&active (:P P_intile))))

(RULE &output
  (OR ((&stamped (:P_grid *P) *P_tile)
       (input (:P P_tile) *Col))
      ((&cell_tiling.cell P)
       (&bg (:C Col))
       (NOT (&stamped (:P_grid P))))))

(OUT (&output ^P ^Col))
