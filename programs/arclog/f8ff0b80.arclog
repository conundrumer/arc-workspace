;; inputs 20148b2bf7001a405452fd0810f54700300ce68a4b2c06b20d8149a69edeb08d programs/solvers/f8ff0b80.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; f8ff0b80

(DET &rank_dir DirDomain)

(RULE &col_dir
  (&rank_dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(DET &bg DominantColor)

;; Cell count per non-bg color.
(INIT &color_count Cardinality
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg (:C Col))))))

;; Dense rank over the distinct counts, ascending (fewest first).
(INIT &o Order
  (member ((:t N))
    (&color_count.size *N))
  (score ((:t N) (:S N))
    (&color_count.size *N)))

(RULE &color_rank
  (&color_count.size (:key *Col) *N)
  (&o.rank (:t N) *R))

;; Output frame: 1D axis anchored at &rank_dir. Placing ascending rank from
;; the opposite edge seats the largest count at the rank_dir edge.
(INIT &col_size Cardinality
  (member ((:m R))
    (&color_rank *R)))

(INIT &col_frame Frame
  (extent (A N)
    (&col_dir *D)
    (axis_of D *A)
    (&col_size.size *N)))

(RULE &col_pos
  (&col_frame.cell *P)
  (&col_dir *D)
  (margin (:B P) D *K)
  (&color_rank (:R K)))

(RULE &output
  (&color_rank *Col (:R *Rk))
  (&col_pos (:K Rk) *P))

(OUT (&output ^P ^Col))
