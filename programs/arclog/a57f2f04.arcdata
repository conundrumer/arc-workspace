        (8 8 8 8 8 8 8 0 0 0 0 0 0 8)
        (8 8 8 8 8 8 8 0 0 0 0 0 0 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $DiagPanel (grid
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 2 0 2 2 0 8 8 8 8 8 8 8)
        (8 0 2 2 0 2 2 8 8 8 8 8 8 8)
        (8 2 0 2 2 0 2 8 8 8 8 8 8 8)
