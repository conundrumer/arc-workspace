        (8 8 0 0 0 0 8 8)
        (8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8))))))

(alts $marks
  (alt $ColorBox
    (witness two-colors variant concept
      (relaxed motif)
      (separates "A 6x6 panel whose 3x3 motif holds a 4 at its top-left corner and 2s elsewhere. The concept tiles the box of all marks; $ColorBox, with its scan orders narrowed to the two from the top-left corner, takes the 4's one-cell box as the tile and fills the panel with 4.")
      (assign &scan (DIAG_TL AXIS_V) (DIAG_TL AXIS_H))
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
