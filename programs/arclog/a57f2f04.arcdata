(alts $blank
  (alt $DeriveBlank
    (witness blank-6 variant $DeriveBlank
      (separates "The panel's blank is 6. At the stored blank 0 the concept takes every panel cell as a mark, and returns the input; $DeriveBlank reads 6 as the panel's most frequent color and tiles the motif.")
      (input (grid
        (8 8 8 8 8 8 8 8)
        (8 2 2 6 6 6 6 8)
        (8 6 2 2 6 6 6 8)
        (8 2 6 2 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 8 8 8 8 8 8 8)))
      (output ($StoredBlank $AllMarks $MarkBox) (grid
        (8 8 8 8 8 8 8 8)
