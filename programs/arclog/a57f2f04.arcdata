(alts $extent
  (alt $ComponentBbox
    (witness l-panel foreign concept
      (relaxed panels)
      (separates "An L-shaped panel whose box has a 3x3 corner of field. The concept tiles the panel cells only; $ComponentBbox tiles the whole box and writes over the field corner.")
      (input (grid
