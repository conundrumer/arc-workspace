        (8 8 8 8 8 8 8 0 3 0 0 3 0 8)
        (8 8 8 8 8 8 8 3 0 3 3 0 3 8)
        (8 8 8 8 8 8 8 3 3 3 3 3 3 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output ($DiagPanel $CornerBox) undefined)
      (output ($DiagPanel $MarkBox) (grid
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 2 2 0 0 0 0 8 8 8 8 8 8 8)
        (8 0 2 2 0 0 0 8 8 8 8 8 8 8)
        (8 2 0 2 0 0 0 8 8 8 8 8 8 8)
        (8 0 0 0 0 0 0 8 8 8 8 8 8 8)
        (8 0 0 0 0 0 0 8 8 8 8 8 8 8)
