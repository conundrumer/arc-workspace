        (8 2 6 2 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 6 6 6 6 6 6 8)
        (8 8 8 8 8 8 8 8)))
      (output ($StoredBlank $CornerBox) ($StoredBlank $ColorBox) undefined)
      (output ($CornerBox $ComponentBbox) (grid
