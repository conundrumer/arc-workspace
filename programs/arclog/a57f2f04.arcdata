        (8 2 2 6 2 2 6 8)
        (8 6 2 2 6 2 2 8)
        (8 2 6 2 2 6 2 8)
        (8 8 8 8 8 8 8 8)))
      (output ($DeriveBlank $CornerBox $PanelCells &field=$Derived) (grid
        (8 8 8 8 8 8 8 8)
        (8 2 2 6 6 6 6 6)
        (8 6 2 2 6 6 6 2)
        (8 2 6 2 6 6 6 2)
        (8 6 6 6 6 6 6 8)
        (8 6 6 6 6 6 6 6)
        (8 6 6 6 6 6 6 2)
        (8 2 6 2 8 2 6 2)))
      (output ($DeriveBlank $MarkBox $ComponentBbox) (grid
        (2 2 6 2 2 6 2 2)
        (6 2 2 6 2 2 6 2)
        (2 6 2 2 6 2 2 6)
        (2 2 6 2 2 6 2 2)
        (6 2 2 6 2 2 6 2)
        (2 6 2 2 6 2 2 6)
        (2 2 6 2 2 6 2 2)
        (6 2 2 6 2 2 6 2)))
      (output ($DeriveBlank $MarkBox $PanelCells &field=$Derived) (grid
        (2 2 6 2 2 6 2 2)
        (6 2 2 6 6 6 6 2)
        (2 6 2 2 6 6 6 6)
        (2 2 6 2 6 6 6 2)
        (6 6 6 6 6 6 6 2)
        (2 6 6 6 6 6 6 6)
        (2 6 6 6 6 6 6 2)
        (6 2 2 6 2 2 6 2))))
    (witness solid-motif borderline concept
      (relaxed tile)
      (separates "A 4x4 panel with a solid 3x3 motif of 2 at its top-left: the 2s outnumber the blanks, and the motif's height does not divide the panel's. The concept fills the panel with 2; $DeriveBlank reads 2 as the blank and the blank cells as the marks, and returns the input, or is undefined under $CornerBox.")
      (input (grid
        (8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8)
        (8 8 2 2 2 0 8 8)
        (8 8 2 2 2 0 8 8)
        (8 8 2 2 2 0 8 8)
        (8 8 0 0 0 0 8 8)
        (8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8)))
