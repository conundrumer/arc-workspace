(alts $find
  (alt $ComponentBbox
    (witness broken-outline foreign $ComponentBbox
      (relaxed boxes)
      (separates "$ComponentBbox from the concept: one outline cell of a 5×5 box is background. The concept finds no solid outline and leaves the box as it is. $ComponentBbox boxes the frame-colored component, whose bounding box is still 5×5, and fills it by position.")
      (input (grid
        (8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8)
        (8 8 0 0 8 0 0 8 8)
        (8 8 0 8 0 8 0 8 8)
        (8 8 0 0 0 0 0 8 8)
