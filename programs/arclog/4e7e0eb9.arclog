;; inputs 5d09014b0213d1b4c1d3c95f26f1102bf4fa3f5a19d9238b281a0752dfb5702c programs/solvers/4e7e0eb9.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 4e7e0eb9

(DET &bg DominantColor)

;; The color a grid line holds, when it holds just one.
(INIT &line_col Singleton
  (key ((ex_input ^E *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (ex_input E *P *Col)
      (split P A (:Along L)))))

(DET &parts_divider
  (&line_col.value (:key (:E *Key) *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(DET &parts_on_divider
  (ex_input (:E *Key) *P)
  (&parts_divider Key *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

;; The separator lines cut the grid into parts.
(INIT &parts_rank Order
  (key ((OR ((&parts_divider (:Key ^Ky) *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((ex_input (:E Ky) *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&parts_divider (:Key Ky) *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&parts_divider (:Key Ky) *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((ex_input (:E Ky) *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (ex_input (:E Ky) *P)
      (margin (:B P) D *K))))

(DET &parts_part_idx
  (ex_input (:E *Key) *P)
  (axis_of *D *A)
  (NOT (&parts_on_divider Key P A))
  (margin (:B P) D *K)
  (&parts_rank.rank (:key (:Ky Key) D) (:t K) (:R *N)))

(DET &parts_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&parts_part_idx *Key *P D (:N *N1))
  (&parts_part_idx Key P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(DET &parts_tile_of
  (&parts_part_of *Key *P *A (:P_part *P1))
  (perp A *A2)
  (&parts_part_of Key P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; The border between a section's edge and its field.
(DET &margin DivisorRatio)

(INIT &part_box BoundingBox
  (key ((&parts_tile_of (:Key ^E) *P (:P_tile ^P_part)))
    (cell (P)
      (&parts_tile_of (:Key E) *P (:P_tile P_part)))))

(DET &section
  (&part_box.cell (:key (:E *Ky_e) (:P_part *Ky_p_part)) *P)
  (&part_box.box (:key (:E Ky_e) (:P_part Ky_p_part)) *B)
  (perp *A *A2)
  (box_extent B P A (:N *K))
  (box_extent B P (:A A2) (:N K)))

(DET &sep DivisorRatio)

(INIT &section_cell_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (side (A (:K N))
    (axis_elem *A)
    (&section (:K *N)))
  (gap (A G)
    (axis_elem *A)
    (&sep (:K *G))))

(RULE &field_cell
  (&section_cell_division.tile (:P *P_grid) (:P_outer *P_sec) (:P_inner *P_insec))
  (&margin *K)
  (uniform_inset K *B)
  (inside (:A P_insec) B)
  (relative (:Base B) (:X P_insec) (:X_rel *P_field)))

(RULE &quad_nearer
  (&field_cell (:P_field *P))
  (dist_pair P *D *K *K2)
  (< K K2))

(RULE &quad_quadrant
  (diag_dirs (:D *Diag) *D1 *D2)
  (&quad_nearer *P (:D D1))
  (&quad_nearer P (:D D2)))

(DET &blank ChangedColor)

(RULE &block_cell
  (&field_cell *P_grid *P_sec *P_field)
  (&quad_quadrant (:P P_field) (:Diag *Blk)))

(RULE &block_col
  (&block_cell *P_grid *P_sec *Blk)
  (input (:P P_grid) *Col))

(RULE &mid_cell
  (&field_cell *P_grid *P_sec *P_field)
  (dist_pair (:P P_field) *D *K (:K2 K))
  (axis_of D *A))

(RULE &mid_bg
  (&mid_cell *P_grid *P_sec *A)
  (input (:P P_grid) *Col)
  (&bg (:C Col)))

;; No bg cell on the line.
(RULE &divider
  (&section_cell_division.tile (:P_outer *P_sec))
  (axis_elem *A)
  (NOT (&mid_bg P_sec A)))

;; The one color the blocks other than &blank carry.
(INIT &unblank Singleton
  (key ((&block_col ^P_sec *Col)
        (NOT (&blank (:C Col))))
    (member ((:v Col))
      (&block_col P_sec *Col)
      (NOT (&blank (:C Col))))))

(RULE &fill
  (&unblank.value (:key *P_sec) (:v *Col)))

(ALTS $i "which halving lines are dividers" $Whole
  (ALT $Any
    ;; An inked cell on the line, away from where the two lines cross. The
    ;; crossing cell lies on both lines, so it tells neither of them apart.
    (RULE &divider
      (&mid_cell *P_grid *P_sec *P_field *A)
      (NOT (centered (:P P_field)))
      (input (:P P_grid) *Col)
      (NOT (&bg (:C Col))))))

(ALTS $f "the color an undivided section takes" $Blank
  (ALT $Rarest
    (INIT &block_tally Cardinality
      (key ((&block_col ^P_sec *Blk ^Col))
        (member ((:m Blk))
          (&block_col P_sec *Blk Col))))

    (INIT &rarest Order
      (key ((&block_tally.size (:key ^P_sec *Col) *N))
        (member ((:t (:V Col) (:S N)))
          (&block_tally.size (:key P_sec *Col) *N))
        (score ((:t (:V Col) (:S N)) (:S N))
          (&block_tally.size (:key P_sec *Col) *N))))

    (RULE &fill
      (&rarest.minimal (:key *P_sec) (:t (:V *Col))))))

(RULE &side_img
  (&section_cell_division.tile (:P_outer *P_sec))
  (axis_of *D *A)
  (IF ((&divider P_sec A))
      ((opposite D (:Opp *D_img)))
      ((= D_img D))))

(RULE &block_img
  (diag_dirs (:D *Blk) *A *D1 *D2)
  (&side_img *P_sec (:D D1) (:D_img *E1))
  (&side_img P_sec (:D D2) (:D_img *E2))
  (diag_dirs (:D *Img) A (:D1 E1) (:D2 E2)))

(RULE &output
  (OR ((&block_cell (:P_grid *P) *P_sec *Blk)
       (&divider P_sec)
       (&block_img P_sec Blk *Img)
       (&block_col P_sec (:Blk Img) *Col))
      ((&block_cell (:P_grid P) (:P_sec *P_sec2))
       (NOT (&divider (:P_sec P_sec2)))
       (&fill (:P_sec P_sec2) Col))
      ((input P Col)
       (NOT (&block_cell (:P_grid P))))))

(OUT (&output ^P ^Col))
