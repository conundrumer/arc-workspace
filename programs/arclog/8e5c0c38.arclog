;; inputs 53e08da268f15dd29846ac6b0f212f761170f0be44c7c0f2ff809d03f7322063 programs/solvers/8e5c0c38.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8e5c0c38

(INIT &ground_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The axis the flip inverts.
(DET &mirror_axis AxisDomain)

;; The background is the commonest color.
(INIT &ground Order
  (member ((:t Col))
    (&ground_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&ground_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&ground.maximal (:t Col))))

(INIT &hue Quotient
  (equivalent ((:a P) (:b Q))
    (&ink *P *Col)
    (&ink (:P *Q) Col)))

(RULE &shape
  (&hue.class (:a *P) (:Id *Ky)))

(ALTS $choice "what a shape is" $ByColor
  (ALT $ByObject
    (INIT &piece Connectivity
      (node (P)
        (&ink *P))
      (step ((:Delta S))
        (OR ((diag_dir_elem *D)
             (step_offset D (:V *S)))
            ((dir_elem (:D *D2))
             (step_offset (:D D2) (:V S))))))

    (RULE &shape
      (&piece.component *P (:Id *Ky)))))

(RULE &mirrored
  (&shape *Ky *P)
  (&mirror_axis *A)
  (axis_inversion A (:T *D))
  (apply D P (:P_out *P_flip))
  (&shape Ky (:P *Q))
  (same_line A P Q)
  (relative (:Base P_flip) (:X Q) (:X_rel *Delta)))

(INIT &fit_count Cardinality
  (key ((&mirrored ^Ky ^Delta *P))
    (member ((:m P))
      (&mirrored Ky Delta *P))))

;; The figure's axis: the placement that lands the most cells.
(INIT &fit Order
  (key ((&fit_count.size (:key (:Ky ^Id) *Delta)))
    (member ((:t Delta))
      (&fit_count.size (:key (:Ky Id) *Delta)))
    (score ((:t Delta) (:S N))
      (&fit_count.size (:key (:Ky Id) *Delta) *N))))

(RULE &ties
  (&fit.maximal (:key *Id) (:t *Delta))
  (ONE Id))

(RULE &kept
  (&ties *Id *Delta)
  (&mirrored (:Ky Id) Delta *P))

(RULE &output
  (input *P (:Col *Col_in))
  (&ties)
  (OR ((NOT (&kept P))
       (&ground.maximal (:t *Col)))
      ((&kept P)
       (= Col Col_in))))

(OUT (&output ^P ^Col))
