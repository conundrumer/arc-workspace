;; inputs 96473ac8e2935b174dc15f7cc98151ddb0139d3bb635806b11c9b37a7330a049 programs/solvers/963f59bc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 963f59bc

(DET &bg DominantColor)

(DET &shape SharedColor)

(RULE &shape_cell
  (input *P *Col)
  (&shape (:C Col)))

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&shape (:C Col))))

(RULE &anchor
  (&mark (:P *P_mark) *Col)
  (&shape_cell (:P *P_src))
  (axis_inversion *A (:T *F)) (axis_elem A)
  (same_line A (:P P_mark) (:Q P_src)))

(RULE &copy
  (&anchor *P_mark *Col *F *P_src)
  (&shape_cell (:P *P2))
  (relative (:Base P_src) (:X P2) (:X_rel *V))
  (apply (:D F) (:P V) (:P_out *V_img))
  (compose (:A P_mark) (:B V_img) (:C *P))
  (input P))

(RULE &output
  (OR ((&copy *P *Col))
      ((input P Col)
       (NOT (&copy P)))))

(OUT (&output ^P ^Col))
