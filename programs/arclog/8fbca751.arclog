;; inputs 686734cac2f95891949868cebd62241889e4c5cdca17fd2e4218c4b7d7a5e196 programs/solvers/8fbca751.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8fbca751

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A group is what line sharing connects.
(INIT &group Quotient
  (edge ((:a P) (:b Q))
    (&ink *P)
    (&ink (:P *Q))
    (axis_elem *A)
    (same_line A P Q)))

(INIT &group_box BoundingBox
  (key ((&group.class (:a *P) ^Id))
    (cell (P)
      (&group.class (:a *P) Id))))

(RULE &filled
  (input *P *Col)
  (&bg (:C Col))
  (&group_box.box *B)
  (inside (:A P) B))

(RULE &output
  (input *P (:Col *Col_in))
  (IF ((&filled P))
      ((&fill (:C *Col)))
      ((= Col Col_in))))

(OUT (&output ^P ^Col))
