;; inputs 5122a16b537a20acbcdead93c28b209ea6e6ef216802b2589ff9f48e97f37404 programs/solvers/6d58a25d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6d58a25d

(DET &bg DominantColor)

(DET &dir DirDomain)

;; The shape's color forms one object; the marker color scatters into many.
(INIT &objs Connectivity
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (node (P)
      (input *P Col)
      (NOT (&bg (:C Col)))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(RULE &scattered
  (&objs.component (:key *Col) *Id)
  (&objs.component (:key Col) (:Id *Id2))
  (!= Id Id2))

(RULE &shape_color
  (&objs.node (:key *Col))
  (NOT (&scattered Col)))

;; From each shape cell toward &dir, over the cells past the shape.
(INIT &cast Ray
  (source (P)
    (input *P *Col)
    (&shape_color Col))
  (node (P)
    (input *P))
  (dir (D)
    (&dir *D)))

(RULE &cast_cell
  (input *P *Col)
  (NOT (&shape_color Col)))

(RULE &fill
  (&cast.ray *P *D (:Origin *Src))
  (&cast_cell P)
  (&cast.ray (:P *Q) D (:Origin Src))
  (&cast_cell (:P Q))
  (input (:P Q) *Col)
  (NOT (&bg (:C Col))))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))

(OUT (&output ^P ^Col))
