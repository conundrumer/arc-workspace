;; inputs c1581f2a8f5a793f6db0a0940becb9c174ac62f3490c2836ca2aa9964e867d1f programs/solvers/5b692c0f.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5b692c0f

;; The color the axis and the off-axis mark are drawn in.
(DET &mark UnchangedColor)

(DET &bg DominantColor)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &obj_mark
  (&objs.component *Id *P)
  (input P *Col)
  (&mark (:C Col)))

(INIT &line_pick_count Cardinality
  (key ((&obj_mark ^Id *P)
        (axis_elem ^A)
        (split P A (:Across ^L)))
    (member ((:m P))
      (&obj_mark Id *P)
      (split P A (:Across L)))))

(INIT &bbox BoundingBox
  (key ((&objs.component ^Id *P))
    (cell (P)
      (&objs.component Id *P))))

(RULE &box_cell
  (&bbox.box (:key *Id) *B)
  (input *P)
  (inside (:A P) B))

;; The fold's line is the object's commonest mark line.
(INIT &line_pick Order
  (key ((&line_pick_count.size (:key ^Id (:A *M_a) (:L *M_l))))
    (member ((:t (:A M_a) (:L M_l)))
      (&line_pick_count.size (:key Id (:A *M_a) (:L *M_l))))
    (score ((:t (:A M_a) (:L M_l)) (:S N))
      (&line_pick_count.size (:key Id (:A *M_a) (:L *M_l)) *N))))

(RULE &fold
  (&line_pick.maximal (:key *Id) (:t (:A *A3) *L))
  (perp (:A A3) (:A2 *A)))

(RULE &side
  (&box_cell *Id *P)
  (&fold Id *A *L)
  (axis_of *D A)
  (nearer D P (:Q L)))

(INIT &side_pick_count Cardinality
  (key ((&side ^Id ^D *P)
        (&obj_mark Id P))
    (member ((:m P))
      (&side Id D *P)
      (&obj_mark Id P))))

(RULE &mirror
  (&box_cell *Id *P)
  (&fold Id *A *L)
  (axis_inversion A (:T *F))
  (relative (:Base L) (:X P) (:X_rel *V))
  (apply (:D F) (:P V) (:P_out *V2))
  (compose (:A L) (:B V2) (:C *P_out))
  (input (:P P_out)))

(ALTS $choice "which side is the source" $Mark
  (ALT $Count
    (INIT &side_pick_count Cardinality
      (key ((&side ^Id ^D *P)
            (&objs.component Id P))
        (member ((:m P))
          (&side Id D *P)
          (&objs.component Id P))))))

;; The source side is the side holding most of the case's cells.
(INIT &side_pick Order
  (key ((&side_pick_count.size (:key ^Id *D)))
    (member ((:t D))
      (&side_pick_count.size (:key Id *D)))
    (score ((:t D) (:S N))
      (&side_pick_count.size (:key Id *D) *N))))

(RULE &fill
  (&side_pick.maximal (:key *Id) (:t *D))
  (&side Id D (:P *Q))
  (input (:P Q) *Col)
  (&mirror Id (:P Q) (:P_out *P)))

(RULE &output
  (OR ((&fill *P *Col))
      ((input P Col)
       (NOT (&fill P)))))

(OUT (&output ^P ^Col))
