;; inputs 379819a90a7ebc085c2cef4d736644ea22cea39dc43668a8924d46cd71d03b1a programs/solvers/9ecd008a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 9ecd008a

(DET &mask VanishedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&mask (:C Col))))

;; The hole: the masked cells.
(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&mask (:C Col))))

(RULE &hole_cell
  (&bbox.cell *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(ALTS $choice "which D4 elements the grid is symmetric under" $Full
  (ALT $Detect
    ;; Self-symmetry of the clean cells.
    (INIT &sym Agreement
      (source (P (:v Col))
        (&clean *P *Col))
      (target (P (:v Col))
        (&clean *P *Col)))

    (RULE &output
      (&hole_cell (:P *P3) (:P_inner *P))
      (apply *D (:P P3) (:P_out *P2))
      (NOT (&sym.conflict D))
      (&clean (:P P2) *Col))))

(RULE &output
  (&hole_cell (:P *P3) (:P_inner *P))
  (apply *D (:P P3) (:P_out *P2))
  (&clean (:P P2) *Col))

(OUT (&output ^P ^Col))
