;; inputs e5df601a1b382c1772f25e84a5457d1a0b328d2ce5ae1f15f760a2d177ab0fad programs/solvers/33b52de3.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 33b52de3

(DET &tile_col ChangedColor)

(INIT &field BoundingBox
  (cell (P)
    (input *P *Col)
    (&tile_col (:C Col))))

(DET &gap DivisorRatio)

;; Tile extent, both axes, and the gap between tiles.
(DET &tile_dim TileCount)

(INIT &output_division Division
  (cell ((:P P_inner))
    (&field.cell *P)
    (&field.box (:B *B_field))
    (inside (:A P) (:B B_field))
    (relative (:Base B_field) (:X P) (:X_rel *P_inner)))
  (side (A K)
    (axis_elem *A)
    (&tile_dim (:N *K)))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &bg DominantColor)

;; The miniature. Its own frame is the tile arrangement, so each of its cells
;; sits at a tile place.
(INIT &mini BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))
    (NOT (&tile_col (:C Col)))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&tile_col (:C Col))))
      ((&field.cell P)
       (&field.box (:B *B_field))
       (inside (:A P) (:B B_field))
       (relative (:Base B_field) (:X P) (:X_rel *P_inner))
       (&output_division.tile (:P P_inner) (:P_outer *P_tile))
       (input (:P *P_mini) Col)
       (&mini.cell (:P P_mini))
       (&mini.box (:B *B_mini))
       (inside (:A P_mini) (:B B_mini))
       (relative (:Base B_mini) (:X P_mini) (:X_rel P_tile)))))

(OUT (&output ^P ^Col))
