;; inputs c9ae99f83252af871d89daa84582b5c06f0d28eb62d2836a0fbbfe9f0448ce52 programs/solvers/17cae0c1.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 17cae0c1

(DET &tile_axis AxisDomain)

;; A panel is square and spans the strip, so its width is the strip's extent
;; across the tiling axis.
(RULE &size
  (input *P)
  (&tile_axis *A)
  (perp A *A2)
  (frame_extent P (:A A2) (:N *K)))

(INIT &panel_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid))
    (&size))
  (side (A (:K Sz))
    (&tile_axis *A)
    (&size (:K *Sz))))

(DET &bg ChangedColor)

(RULE &mark
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&panel_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &panel_mark
  (&mark *E (:P_tile *Tile) (:P_intile *P))
  (ex_output E))

;; Panels carrying the same glyph share a catalog entry.
(INIT &same Inclusion
  (pattern ((:pattern (:E Ep_e) (:Tile Ep_tile)) (:m P))
    (&panel_mark (:E *Ep_e) (:Tile *Ep_tile) *P))
  (observed ((:observed (:E Ep_e) (:Tile Ep_tile)) (:m P))
    (&panel_mark (:E *Ep_e) (:Tile *Ep_tile) *P)))

(INIT &entry Quotient
  (equivalent ((:a (:E Ep_e) (:Tile Ep_tile)) (:b (:E Ep2_e) (:Tile Ep2_tile)))
    (&same.equal (:observed (:E *Ep_e) (:Tile *Ep_tile)) (:pattern (:E *Ep2_e) (:Tile *Ep2_tile)))))

(DET &glyph_member
  (&entry.class (:a (:E *Ep_e) (:Tile *Ep_tile)) *Id)
  (&panel_mark (:E Ep_e) (:Tile Ep_tile) *P))

(INIT &glyph Inclusion
  (pattern ((:pattern Id) (:m P))
    (&glyph_member *Id *P))
  (observed ((:observed P_tile) (:m P))
    (&mark *P_tile (:P_intile *P))))

(DET &glyph_color
  (&entry.class (:a *E (:Tile *P_tile)) *Id)
  (ex_output E (:P *P_grid) *Col)
  (&panel_division.tile E (:P P_grid) (:P_outer P_tile)))

(RULE &output
  (&panel_division.tile *P (:P_outer *P_tile))
  (&glyph.equal (:observed P_tile) (:pattern *Id))
  (&glyph_color Id *Col))

(OUT (&output ^P ^Col))
