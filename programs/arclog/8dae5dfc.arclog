;; inputs fa0a74c0e5dedf908c2fa09b6cf5d099b194740f32a420371431180c4105209d programs/solvers/8dae5dfc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8dae5dfc

(DET &bg DominantColor)

;; An object is a component of the non-background cells.
(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

;; The objects peel into rings; depth counts the rings outside a cell.
(INIT &peel Boundary
  (cell (P)
    (&objs.component *P)))

(INIT &peel_depth CellDistance
  (node (P)
    (&objs.component *P))
  (source (P)
    (&peel.boundary *P)))

;; A layer is a same-color component of an object: adjacent rings of one
;; color fuse.
(INIT &fused Connectivity
  (key ((&objs.component *P)
        (input P ^Col))
    (node (P)
      (&objs.component *P)
      (input P Col))))

;; A layer's depth is the depth of its outermost ring.
(INIT &layer_depth Order
  (key ((&fused.component *P ^Id)
        (&peel_depth.distance P *K))
    (member ((:t K))
      (&fused.component *P Id)
      (&peel_depth.distance P *K))
    (score ((:t K) (:S K))
      (&fused.component *P Id)
      (&peel_depth.distance P *K))))

(RULE &nest_elem
  (&objs.component *P (:Id *Obj))
  (&fused.component P *Id))

;; The layers of an object, ordered from the outside in.
(INIT &nest Order
  (key ((&nest_elem ^Obj *Id))
    (member ((:t Id))
      (&nest_elem Obj *Id))
    (score ((:t Id) (:S K))
      (&nest_elem Obj *Id)
      (&layer_depth.minimal (:key Id) (:t *K)))))

(RULE &output
  ;; The background stays.
  (OR ((input *P *Col)
       (&bg (:C Col)))
      ;; A layer takes the color of the layer as deep from the inside as it is from
      ;; the outside.
      ((&fused.component P *Id)
       (&nest.rank (:key *Obj) (:t Id) *R)
       (&nest.dual_rank (:key Obj) (:t *Id2) R)
       (&fused.component (:P *P2) (:Id Id2))
       (input (:P P2) Col))))

(OUT (&output ^P ^Col))
