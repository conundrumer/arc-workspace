;; inputs c6a86852d080f1e4facb64923d7eb41b7ffb6c115950cad4deeac4b3f0bfafff programs/solvers/7ddcd7ec.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7ddcd7ec

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &block
  (&ink *P)
  (dir_elem *D)
  (neighbor P D *Q)
  (&ink (:P Q)))

(RULE &tail
  (&block (:P *Q))
  (diag_dir_elem *D)
  (neighbor (:P Q) D (:Q *P))
  (&ink P)
  (NOT (&block P)))

;; Each tail casts along its own diagonal, away from the block.
(INIT &cast Ray
  (key ((OR ((&tail *P ^D))
            ((diag_dir_elem D))))
    (source (P)
      (&tail *P D))
    (node (P)
      (diag_dir_elem D)
      (input *P))
    (dir (D)
      (diag_dir_elem D))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&cast.ray P (:Origin *Src))
       (&ink (:P Src) *Col))
      ((NOT (&cast.ray P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
