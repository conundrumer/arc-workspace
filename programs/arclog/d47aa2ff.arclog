;; inputs 4680f6104703f1adba813e7324d363778206a227a9ac9e0bfbd6a5847d1bcfe8 programs/solvers/d47aa2ff.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d47aa2ff

(DET &panel_axis AxisDomain)

(DET &panel_count SepTileCount)

(DET &panel_gap DivisorRatio)

(INIT &cell_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (&panel_axis *A)
    (&panel_count *N))
  (gap (A G)
    (&panel_axis *A)
    (&panel_gap (:K *G))))

(DET &bg DominantColor)

(DET &cell2
  (ex_input *E (:P *P_grid) *Col)
  (&cell_division.tile (:P P_grid) (:P_outer *P_panel) (:P_inner *P)))

(RULE &cell
  (input (:P *P_grid) *Col)
  (&cell_division.tile (:P P_grid) (:P_outer *P_panel) (:P_inner *P)))

(DET &ink2
  (&cell2 *E *P_panel *P *Col)
  (NOT (&bg (:C Col))))

(DET &missing2
  (&cell2 *E *P *Col)
  (&bg (:C Col)))

(DET &only_fill
  (&ink2 *E *P_panel *P)
  (&missing2 E P)
  (ex_output E P *Col))

(ALTS $choice "how the split is found, data-equivalent on this task" $Count
  (ALT $Size
    (DET &panel_size ConstOutDim)

    (INIT &cell_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A (:K W))
        (&panel_axis *A)
        (&panel_size (:N *W)))
      (gap (A G)
        (&panel_axis *A)
        (&panel_gap (:K *G))))

    (RULE &cell
      (input (:P *P_grid) *Col)
      (&cell_division2.tile (:P P_grid) (:P_outer *P_panel) (:P_inner *P)))))

(RULE &ink
  (&cell *P_panel *P *Col)
  (NOT (&bg (:C Col))))

(RULE &missing
  (&cell *P *Col)
  (&bg (:C Col)))

(RULE &full
  (&cell *P)
  (NOT (&missing P)))

;; The ink colors the panels put on a cell.
(INIT &agree Singleton
  (key ((&ink ^P *Col))
    (member ((:v Col))
      (&ink P *Col))))

(RULE &output
  ;; One-sided ink is marked with its panel's color.
  (OR ((&ink *P_panel *P)
       (&missing P)
       (&only_fill P_panel *Col))
      ((&cell P)
       (NOT (&ink P))
       (&bg (:C Col)))
      ((&full P)
       (OR ((&agree.value (:key P) (:v Col)))
           ((&agree.plural (:key P))
            (&bg (:C Col)))))))

(OUT (&output ^P ^Col))
