        (8 8 8 8 8 2 2 2 8 8)
        (8 8 8 8 8 8 8 8 2 8)
        (8 8 8 8 8 8 8 8 2 8)))))
  (alt $MarkerInCopyStep
    (witness bar-template variant $NoOverlapStep)))

