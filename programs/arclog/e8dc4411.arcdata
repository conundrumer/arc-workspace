        (8 0 0 0 8 8 8 8 8 8)
        (8 8 2 2 2 8 8 8 8 8)
        (8 8 8 2 2 2 8 8 8 8)
        (8 8 8 8 2 2 2 8 8 8)
        (8 8 8 8 8 2 2 2 8 8)
        (8 8 8 8 8 8 2 2 2 8)
        (8 8 8 8 8 8 8 2 2 2)))
      (output ($SpanStep $MirroredCopies) (grid
