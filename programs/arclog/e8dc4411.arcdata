(param &shape_color Color (0))

(exclude ($MarkerInCopyStep $PastTipDirection) "Wherever the past-tip direction is defined, the adjacent-cell direction gives the same direction, so the past-tip direction stays only where the step and the copies take the branches no witnessed adjacent-cell case shares.")
(exclude ($MirroredCopies $PastTipDirection) "Wherever the past-tip direction is defined, the adjacent-cell direction gives the same direction, so the past-tip direction stays only where the step and the copies take the branches no witnessed adjacent-cell case shares.")
(exclude ($RotatedCopies $PastTipDirection) "Wherever the past-tip direction is defined, the adjacent-cell direction gives the same direction, so the past-tip direction stays only where the step and the copies take the branches no witnessed adjacent-cell case shares.")

(alts $st
  (alt $NoOverlapStep
    (witness bar-template variant $NoOverlapStep
      (separates "a template that is a horizontal bar of three cells, with the marker diagonally past its right end: the concept steps by the bar's diagonal extent (2) and leaves the marker apart from the copies, $NoOverlapStep and $MarkerInCopyStep step by 1 so that the first copy holds the marker, $MirroredCopies turns every other copy into a vertical bar")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8)
        (8 0 0 0 8 8 8 8 8 8)
        (8 8 8 8 2 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8)
