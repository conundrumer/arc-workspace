;; inputs 4ff01caa315f0b6c9a07f759eedfd44efa89a8e0085eb55d017e83df982015a0 programs/solvers/3befdf3e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3befdf3e

(DET &bg DominantColor)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

;; The wall is the object's rim; the core is what it holds.
(INIT &rim Boundary
  (key ((&objs.component ^Id *P))
    (cell (P)
      (&objs.component Id *P))))

(INIT &arm_frame Frame
  (key ((&rim.exposed (:key ^Id) *P ^D)
        (dir_elem D)
        (frame_extent P *A *N))
    (extent (A N)
      (&rim.exposed (:key Id) *P D)
      (dir_elem D)
      (frame_extent P *A *N))))

(RULE &core
  (&objs.component (:Id *O) *P)
  (NOT (&rim.boundary (:key (:Id O)) P)))

(RULE &wall_col
  (&rim.boundary (:key (:Id *O)) *P)
  (input P *Col))

(RULE &core_col
  (&core *O *P)
  (input P *Col))

(INIT &core_box BoundingBox
  (key ((&core (:O ^Id) *P))
    (cell (P)
      (&core (:O Id) *P))))

(RULE &arm_mark
  (&rim.exposed (:key *Id) *P *D)
  (dir_elem D))

(INIT &arm Ray
  (key ((OR ((&rim.exposed (:key ^Id) *P ^D)
             (dir_elem D))
            ((&arm_mark Id D))
            ((&arm_frame.cell (:key Id D) P))))
    (source (P)
      (&rim.exposed (:key Id) *P D)
      (dir_elem D))
    (node (P)
      (&arm_frame.cell (:key Id D) *P))
    (dir (D)
      (&arm_mark Id D))))

(RULE &arm_cell
  (&arm_mark *Id *D)
  (input))

(RULE &paint
  (OR ((&rim.boundary (:key (:Id *O)) *P)
       (&core_col O *Col))
      ((&core (:O *O2) P)
       (&wall_col (:O O2) Col))
      ((&arm.ray (:key *Id *D) P D *K)
       (&arm_cell Id D)
       (input P)
       (!= K 0)
       (axis_of D *A)
       (&core_box.box (:key Id) *B)
       (box_extent B P A *N)
       (<= K N)
       (&wall_col (:O Id) Col))))

(ALTS $choice "how the figure is built" $Cast
  (ALT $Lookup
    (RULE &core_size
      (&core *O *P)
      (&core_box.box (:key (:Id O)) *B)
      (box_extent B P *A *N)
      (perp A *A2)
      (box_extent B P (:A A2) N))

    ;; The figure an object leaves: the output ink its own cells sit in.
    (INIT &figs Connectivity
      (key ((ex_output ^E *P *Col)
            (NOT (&bg (:C Col))))
        (node (P)
          (ex_output E *P *Col)
          (NOT (&bg (:C Col))))))

    (DET &fig
      (&objs.component *E *Id (:P *Q))
      (&figs.component (:key E) (:P Q) (:Id *F))
      (&figs.component (:key E) *P (:Id F)))

    ;; The figure's own box — the frame the catalog stores.
    (INIT &fig_box BoundingBox
      (key ((&fig ^E ^Id *P))
        (cell (P)
          (&fig E Id *P))))

    (DET &fig_cell
      (&fig *E *Id *P)
      (&fig_box.box (:key E Id) *B)
      (inside (:A P) B)
      (relative (:Base B) (:X P) (:X_rel *P_fig)))

    (DET &fig_view
      (&core_size *E (:O *Id) *N)
      (&fig_cell E Id *P *P_fig)
      (ex_output E P *Col))

    (DET &fig_core
      (&fig_view *E *Id *N (:P_fig *P) *Col)
      (&core_col E (:O Id) Col))

    (INIT &core_in_fig BoundingBox
      (key ((&fig_cell ^E ^Id *P *P_fig)
            (&core E (:O Id) P))
        (cell ((:P P_fig))
          (&fig_cell E Id *P *P_fig)
          (&core E (:O Id) P))))

    (DET &fig_core_box
      (&core_size *E (:O *Id) *N)
      (&core_in_fig.box (:key E Id) *B))

    (DET &fig_wall
      (&fig_view *E *Id *N (:P_fig *P) *Col)
      (&wall_col E (:O Id) Col))

    (RULE &paint
      (OR ((&fig_wall *N (:P *P_fig))
           (&wall_col *O *Col))
          ((&fig_core N (:P P_fig))
           (&core_col O Col)))
      (&fig_core_box N (:B *B_fig))
      (relative (:Base B_fig) (:X P_fig) (:X_rel *P_inner))
      (&core_size O N)
      (&core_box.box (:key (:Id O)) *B)
      (compose (:A B) (:B P_inner) (:C *P))
      (input P))))

(RULE &output
  (OR ((&paint *P *Col))
      ((input P)
       (NOT (&paint P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
