;; inputs 03e7d353d2d370c99efe495275840a11ee23ddbdcbbfcb795f623d61d86f319b programs/solvers/3f7978a0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3f7978a0

(DET &bar RarestColor)

(DET &axis AxisDomain)

(DET &cap ColorDomain)

(RULE &bar2
  (input *P *Col)
  (&bar (:C Col)))

(RULE &stepped
  (&bar2 (:P *P3))
  (&axis *A)
  (axis_of *D A)
  (neighbor (:P P3) D (:Q *P)))

(INIT &hull BoundingBox
  (cell (P)
    (OR ((&bar2 *P))
        ((&stepped P)
         (input P *Col)
         (&cap (:C Col))))))

(ALTS $choice "the region's extent along the axis" $Cap
  (ALT $Grow
    (INIT &hull BoundingBox
      (cell (P)
        (OR ((&bar2 *P))
            ((&stepped P)))))))

(RULE &output
  (input (:P *P2) *Col)
  (&hull.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(OUT (&output ^P ^Col))
