;; inputs 29859c0ec2677066a9250e67d40af6a007c3d1392ae1a027ec1e6b0e96821bd1 programs/solvers/6ea4a07e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6ea4a07e

(DET &bg SharedColor)

(DET &recolor VanishedNewPairs)

(RULE &fill
  (input *Col)
  (&recolor (:C_from Col) (:C_to *C)))

(RULE &output
  (OR ((input *P (:Col *Col2))
       (&bg (:C Col2))
       (&fill (:C *Col)))
      ((input P (:Col *Col22))
       (NOT (&bg (:C Col22)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
