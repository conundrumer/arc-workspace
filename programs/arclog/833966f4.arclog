;; inputs 382ff7eef725a1d8287ea00bbd3670f739a5a8e19c7035f560974ef6d7de5879 programs/solvers/833966f4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 833966f4

(DET &pair
  (ex_input *E (:P *P_in) *Col)
  (ex_output E (:P *P_out) Col))

(INIT &ident Quotient
  (equivalent ((:a P_in) (:b P_in))
    (&pair *P_in)))

(DET &in_label
  (&pair (:P_in *P))
  (&ident.class (:a P) *Id))

(DET &out_label
  (&pair *P_in (:P_out *P))
  (&ident.class (:a P_in) *Id))

(RULE &map
  (&in_label (:P *P_in) *Id)
  (&out_label (:P *P_out) Id))

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(ALTS $choice "how the permutation is derived" $LabeledGrids
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &part_division Division
      (key ((&divide_axis ^A))
        (parts (A N)
          (&divisor *N))
        (gap (A G)
          (&divide_gap (:K *G))))
      (cell ((:P P_grid))
        (input (:P *P_grid))))

    (RULE &part
      (&part_division.tile (:key *A) (:P *P_grid) *P_outer (:P_inner *P_slab))
      (split (:P P_slab) A (:Along *P_inner)))

    (RULE &perm
      (&part (:P_grid *P_in) *P_outer *P_inner)
      (&perm_tiling.cell (:key *A) P_outer (:P_inner *P_inner_out) (:P *P_out))
      (axis_inversion A (:T *F))
      (apply (:D F) (:P P_inner) (:P_out P_inner_out)))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (OR ((&perm (:P_in P_grid_in) (:P_out *P)))
          ((NOT (&part (:P_grid P_grid_in)))
           (= P P_grid_in))))

    (INIT &perm_tiling Tiling
      (key ((&divide_axis ^A))
        (inner ((:P P_inner_out))
          (&part *P_inner)
          (axis_inversion A (:T *F))
          (apply (:D F) (:P P_inner) (:P_out *P_inner_out)))
        (gap (A G)
          (&part)
          (&divide_gap (:K *G))))
      (outer ((:P P_outer))
        (&part *P_outer))))
  (ALT $Size
    (DET &tile_size SepTileCount)

    (INIT &part_division2 Division
      (key ((&divide_axis ^A))
        (side (A K)
          (&tile_size (:N *K)))
        (gap (A G)
          (&divide_gap (:K *G))))
      (cell ((:P P_grid))
        (input (:P *P_grid))))

    (RULE &part
      (&part_division2.tile (:key *A) (:P *P_grid) *P_outer (:P_inner *P_slab))
      (split (:P P_slab) A (:Along *P_inner)))

    (RULE &perm
      (&part (:P_grid *P_in) *P_outer *P_inner)
      (&perm_tiling.cell (:key *A) P_outer (:P_inner *P_inner_out) (:P *P_out))
      (axis_inversion A (:T *F))
      (apply (:D F) (:P P_inner) (:P_out P_inner_out)))

    (RULE &output
      (input (:P *P_grid_in) *Col)
      (OR ((&perm (:P_in P_grid_in) (:P_out *P)))
          ((NOT (&part (:P_grid P_grid_in)))
           (= P P_grid_in))))

    (INIT &perm_tiling Tiling
      (key ((&divide_axis ^A))
        (inner ((:P P_inner_out))
          (&part *P_inner)
          (axis_inversion A (:T *F))
          (apply (:D F) (:P P_inner) (:P_out *P_inner_out)))
        (gap (A G)
          (&part)
          (&divide_gap (:K *G))))
      (outer ((:P P_outer))
        (&part *P_outer)))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&map (:P_in P_grid_in) (:P_out *P)))

(OUT (&output ^P ^Col))
