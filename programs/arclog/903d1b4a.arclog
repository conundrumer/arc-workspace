;; inputs 4dfab82f24e1d91121c5c8bceabe6524c15a9a03b56ddd8adbea102fa06873e7 programs/solvers/903d1b4a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 903d1b4a

(DET &noise ChangedColor)

(RULE &clean
  (input *P *Col)
  (NOT (&noise (:C Col))))

(ALTS $choice "which D4 elements can repair a corrupted cell" $Full
  (ALT $Detect
    ;; Self-symmetry of the clean cells.
    (INIT &sym Agreement
      (source (P (:v Col))
        (&clean *P *Col))
      (target (P (:v Col))
        (&clean *P *Col)))

    (RULE &output
      (OR ((&clean *P *Col))
          ((input P (:Col *N))
           (&noise (:C N))
           (apply *D P (:P_out *P2))
           (NOT (&sym.conflict D))
           (&clean (:P P2) Col))))))

(RULE &output
  (OR ((&clean *P *Col))
      ((input P (:Col *N))
       (&noise (:C N))
       (apply *D P (:P_out *P2))
       (&clean (:P P2) Col))))

(OUT (&output ^P ^Col))
