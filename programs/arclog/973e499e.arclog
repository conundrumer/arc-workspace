;; inputs 3419b97909311f9580949d042d16860060df4c23203e011791b322e060406a4d programs/solvers/973e499e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 973e499e

(INIT &output_tiling Tiling
  (key ((OR ((input (:P *P_tile) ^Col))
            ((input (:P *P_intile) Col))))
    (outer ((:P P_tile))
      (input (:P *P_tile) Col))
    (inner ((:P P_intile))
      (input (:P *P_intile) Col))))

(INIT &output_tiling2 Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg AnyOutNewColor)

(RULE &output
  (OR ((&output_tiling.cell (:key *Col) *P))
      ((input (:P *P_tile) (:Col *Col_m))
       (input (:P *P_intile) (:Col *Col_i))
       (!= Col_m Col_i)
       (&bg (:C Col))
       (&output_tiling2.cell (:P_outer P_tile) (:P_inner P_intile) P))))

(OUT (&output ^P ^Col))
