;; inputs 99c6d05d06ce9266b31769b50dd2390c763f4061288ce93f4c752ebc19a17b4b programs/solvers/8b28cd80.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8b28cd80

;; The gap between neighboring input cells in the output.
(DET &gap ConstInDim)

(INIT &spread_tiling Tiling
  (outer ((:P P_in))
    (input (:P *P_in)))
  (inner (P)
    (= *P 0))
  (gap (A G)
    (axis_elem *A)
    (&gap (:N *G))))

(RULE &spread
  (&spread_tiling.cell (:P_outer *P_in) (:P_inner 0) (:P *P_out)))

(INIT &frame Frame
  (extent (A N)
    (&spread (:P_out *P))
    (frame_extent P *A *N)))

;; The direction the spiral's arm leaves the center, and the sense the spiral winds in from there.
(DET &arm DirDomain)

(DET &bg DominantColor)

(RULE &center
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (&spread P_in (:P_out *B)))

(DET &wind SenseDomain)

(RULE &seam
  (&arm *D)
  (&wind *S)
  (turn S (:D *D2) (:D2 D))
  (diag_dirs (:D *Diag) (:D1 D) D2))

(INIT &seam_frame Frame
  (extent (A N)
    (&center *B)
    (&arm *D)
    (neighbor (:P B) D (:Q *P))
    (frame_extent P *A *N)))

;; The seam: the diagonal ray cast from the cell beside the center.
(INIT &seam2 Ray
  (source (P)
    (&center *B)
    (&arm *D)
    (neighbor (:P B) D (:Q *P)))
  (node (P)
    (&seam_frame.cell *P))
  (dir ((:D Dg))
    (&seam (:Diag *Dg))))

(RULE &seam_ray
  (&seam2.ray *P *D *K (:Origin *Src))
  (&frame.cell P))

;; The spacing between one ring and the next.
(DET &ring_gap TileDim)

(RULE &palette
  (OR ((&center *Col))
      ((&bg (:C Col)))))

(RULE &other
  (&palette *Col)
  (&palette (:Col *Col2))
  (!= Col Col2))

(RULE &ring_cell
  (&frame.cell *P)
  (&center (:B *C))
  (relative (:Base C) (:X P) (:X_rel *V))
  (margin (:B V) *D *K)
  (uniform_outset K (:B *B_out))
  (compose (:A C) (:B B_out) (:C *B))
  (inside (:A P) B)
  (same_dist (:P1 P) (:P2 B))
  (&ring_gap (:D *G))
  (divide (:T K) (:Side G) (:Gap 0) (:Part *N) (:Remainder 0)))

;; The rings alternate between the two colors, out from the center's.
(INIT &alternate Walk
  (successor ((:p C1) (:p_next C2))
    (&other (:Col *C1) (:Col2 *C2)))
  (steps (N)
    (&ring_cell *N)))

(RULE &output
  (&ring_cell *N *P)
  (&center (:Col *C0))
  (&alternate.walk (:p0 C0) N (:p *C))
  (OR ((&seam2.ray P)
       (&frame.cell P)
       (&other (:Col C) (:Col2 *Col)))
      ((NOT (&seam_ray P))
       (= Col C))))

(OUT (&output ^P ^Col))
