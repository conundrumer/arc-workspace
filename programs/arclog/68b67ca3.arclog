;; inputs 607f7813d73cabb66c872571c131036314482328735fa6f493e132e2bc28206d programs/solvers/68b67ca3.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 68b67ca3

(DET &cand
  (ex_input *E (:P *P_in) (:Col *C))
  (ex_output E (:P *P_out) (:Col C)))

(DET &broken
  (&cand *P_in *P_out)
  (ex_output *E)
  (NOT (&cand E P_in P_out)))

(DET &pair
  (&cand *P_in *P_out)
  (NOT (&broken P_in P_out)))

(INIT &ident Quotient
  (equivalent ((:a P_in) (:b P_in))
    (&pair *P_in)))

(DET &in_label
  (&pair (:P_in *P))
  (&ident.class (:a P) *Id))

(DET &out_label
  (&pair *P_in (:P_out *P))
  (&ident.class (:a P_in) *Id))

(RULE &map
  (&in_label (:P *P_in) *Id)
  (&out_label (:P *P_out) Id))

(DET &anchor DiagDirDomain)

(RULE &perm
  (&map *P_in *P_out))

(ALTS $choice "out's choice column (decompose)" $LabeledGrids
  (ALT $Count
    (DET &divisor ConstOutDim)

    (INIT &perm_division Division
      (cell ((:P P_grid_in))
        (input (:P *P_grid_in)))
      (parts (A N)
        (axis_elem *A)
        (&divisor *N)))

    (RULE &perm
      (&perm_division.tile (:P *P_in) (:P_outer *P_out) (:P_inner *P_intile))
      (&anchor *D)
      (same_corner D (:P1 P_intile) (:P2 0))))
  (ALT $Size
    (DET &tile_size DivisorRatio)

    (INIT &perm_division2 Division
      (cell ((:P P_grid_in))
        (input (:P *P_grid_in)))
      (side (A K)
        (axis_elem *A)
        (&tile_size *K)))

    (RULE &perm
      (&perm_division2.tile (:P *P_in) (:P_outer *P_out) (:P_inner *P_intile))
      (&anchor *D)
      (same_corner D (:P1 P_intile) (:P2 0)))))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&perm (:P_in P_grid_in) (:P_out *P)))

(OUT (&output ^P ^Col))
