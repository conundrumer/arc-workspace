        (7 7 7 7 7 2 2 2)))
      (output &background=$Stored (grid
        (9 9 9 9 9 9 9 9)
        (9 9 9 9 9 9 9 9)
        (7 9 9 9 9 9 9 9)
        (7 7 7 7 7 7 9 9)
        (7 7 7 7 2 2 2 2)
        (7 7 7 7 2 2 2 2)
        (7 7 7 7 2 2 2 2)
        (7 7 7 7 2 2 2 2)))
      (output &background=$Derived (grid
