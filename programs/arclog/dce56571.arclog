;; inputs 59076dcce61480a3bfbe185f3a545aa5aae7c29a96a6871337c6f58316806b1a programs/solvers/dce56571.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; dce56571

(DET &bg DominantColor)

(DET &axis AxisDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &ink_count Cardinality
  (member ((:m P))
    (&ink *P)))

(RULE &center_line
  (input *P)
  (&axis *A)
  (perp A *A2)
  (axis_of (:D *D2) (:A A2))
  (dist_pair P (:D D2) (:K *Kc) (:K2 Kc))
  (axis_of *D A)
  (dist_pair P D *K *K2)
  (<= K K2))

;; Order over the line's cells by distance to the nearer axis edge. A cell's
;; rank_desc counts the cells farther from the edges: the cells more central
;; than it.
(INIT &centrality Order
  (member ((:t P))
    (&center_line *P))
  (score ((:t P) (:S K))
    (&center_line *P *K)))

(RULE &band_cell
  (&ink_count.size *N)
  (&centrality.dual_rank (:t *P) (:R *M))
  (< M N))

(INIT &band_size Cardinality
  (member ((:m P))
    (&band_cell *P)))

(RULE &line_cell
  (&band_cell *P)
  (&band_size.size *N)
  (&ink_count.size N))

(RULE &output
  (OR ((&line_cell *P)
       (&ink *Col))
      ((input P)
       (&line_cell)
       (NOT (&line_cell P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
