;; inputs d4328afed5c1ec7428efcd7df9ce668a981e98f0fb760594b9413d31196a45cd programs/solvers/1f85a75f.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1f85a75f

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; The color node sets are disjoint, so ids separate groups across colors.
(INIT &grp Connectivity
  (key ((&ink *P ^Col))
    (node (P)
      (&ink *P Col)))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &biggest_count Cardinality
  (key ((&grp.component *P ^Id))
    (member ((:m P))
      (&grp.component *P Id))))

(INIT &biggest Order
  (member ((:t Id))
    (&biggest_count.size (:key *Id)))
  (score ((:t Id) (:S N))
    (&biggest_count.size (:key *Id) *N)))

(RULE &shape
  (&biggest.maximal (:t *Id))
  (&grp.component *P Id))

(INIT &bbox BoundingBox
  (cell (P)
    (&shape *P)))

(ALTS $l "find the shape" $Big
  (ALT $Rare
    (INIT &cell_count Cardinality
      (key ((&ink *P ^Col))
        (member ((:m P))
          (&ink *P Col))))

    ;; Both take every cell of the color scoring lowest.
    (INIT &color_score Order
      (member ((:t (:V Col) (:S N)))
        (&cell_count.size (:key *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&cell_count.size (:key *Col) *N)))

    (RULE &shape
      (&color_score.minimal (:t (:V *Col)))
      (&ink *P Col)))
  (ALT $Intact
    (INIT &group_count Cardinality
      (key ((&grp.component (:key ^Col) *Id))
        (member ((:m Id))
          (&grp.component (:key Col) *Id))))

    ;; Both take every cell of the color scoring lowest.
    (INIT &color_score Order
      (member ((:t (:V Col) (:S N)))
        (&group_count.size (:key *Col) *N))
      (score ((:t (:V Col) (:S N)) (:S N))
        (&group_count.size (:key *Col) *N)))

    (RULE &shape
      (&color_score.minimal (:t (:V *Col)))
      (&ink *P Col))))

(ALTS $r "fill the box" $Keep
  (ALT $Crop
    (RULE &output
      (input (:P *P_grid) *Col)
      (&bbox.box *B)
      (inside (:A P_grid) B)
      (relative (:Base B) (:X P_grid) (:X_rel *P)))))

(RULE &output
  (input (:P *P_grid))
  (&bbox.box *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P))
  (IF ((&shape (:P P_grid)))
      ((input (:P P_grid) *Col))
      ((&bg (:C Col)))))

(OUT (&output ^P ^Col))
