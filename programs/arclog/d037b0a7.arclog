;; inputs a5aeede9af284335301b7e0e0eec5455d8e594f97073d2422ef92e4afd60af07 programs/solvers/d037b0a7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d037b0a7

(DET &bg DominantColor)

(DET &dir DirDomain)

(RULE &flow_blocked
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &flow Ray
  (source (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P)
    (NOT (&flow_blocked P)))
  (dir (D)
    (&dir *D)))

(RULE &output
  (OR ((&flow.ray *P (:Origin *P_mark))
       (input (:P P_mark) *Col))
      ((input P Col)
       (NOT (&flow.ray P)))))

(OUT (&output ^P ^Col))
