;; inputs 2cd5fc56555d15a5a563173bed4f19312f2247e26afa54c05e6cfdadb76058c1 programs/solvers/7ee1c6ea.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7ee1c6ea

(DET &bg SharedColor)

(DET &frame SharedColor)

(RULE &frame_cell
  (input *P *Col)
  (&frame (:C Col)))

(INIT &fbox BoundingBox
  (cell (P)
    (&frame_cell *P)))

(RULE &within
  (input *P)
  (&fbox.box *B)
  (interior (:A P) B))

(ALTS $i "which cells count as inside the outline" $Box
  (ALT $Enclose
    (INIT &closed Enclosure
      (cell (P)
        (input *P)
        (NOT (&frame_cell P))))

    (RULE &within
      (&closed.enclosed *P))))

(ALTS $pal "which two colors trade places" $Held
  (ALT $Field
    (RULE &ink
      (input *Col)
      (NOT (&bg (:C Col)))
      (NOT (&frame (:C Col))))))

(RULE &ink
  (&within *P)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &swap
  (&ink *Col)
  (&ink (:Col *Col2))
  (!= Col Col2))

(RULE &traded
  (&within *P)
  (input P (:Col *Col3))
  (&swap (:Col Col3) (:Col2 *Col)))

(RULE &output
  (OR ((&traded *P *Col))
      ((input P Col)
       (NOT (&traded P)))))

(OUT (&output ^P ^Col))
