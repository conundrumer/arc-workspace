;; inputs 98e92203984d8ac5e6da44202e66cc6f409b3c19a46ba2a0100ffac6e9b3ff3d programs/solvers/32e9702f.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 32e9702f

(DET &dir DirDomain)

(DET &bg ChangedColor)

(DET &fill AnyOutNewColor)

(RULE &moved
  (input (:P *P2) *Col)
  (NOT (&bg (:C Col)))
  (&dir *D)
  (neighbor (:P P2) D (:Q *P))
  (input P))

(RULE &output
  (OR ((&moved *P *Col))
      ((input P)
       (NOT (&moved P))
       (&fill (:C Col)))))

(OUT (&output ^P ^Col))
