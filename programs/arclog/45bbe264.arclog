;; inputs bb9bcd61bb947a85a4957e8b242494e563e80fb31a7141f20a45c07f2a555428 programs/solvers/45bbe264.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 45bbe264

(DET &bg DominantColor)

(DET &cross_color AnyOutNewColor)

(RULE &cross
  (input (:P *Q) *Col)
  (NOT (&bg (:C Col)))
  (input *P)
  (axis_elem *A)
  (same_line A P Q))

(INIT &cover_color Singleton
  (key ((&cross ^P *Col))
    (member ((:v Col))
      (&cross P *Col))))

(RULE &collide
  (&cover_color.plural (:key *P)))

(ALTS $choice "what counts as a meeting" $Color
  (ALT $Mark
    (INIT &cover_mark Singleton
      (key ((&cross ^P *Q))
        (member ((:v Q))
          (&cross P *Q))))

    (RULE &collide
      (&cover_mark.plural (:key *P)))))

(RULE &output
  (input *P)
  (OR ((&collide P)
       (&cross_color (:C *Col)))
      ((&cross P Col)
       (NOT (&collide P)))
      ((NOT (&cross P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
