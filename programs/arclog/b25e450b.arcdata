(exclude ($SpanUndefined $RecolorTrack) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($SpanUndefined $NonFieldColor) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($SpanUndefined $AwayFromNearestEdge) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($SpanUndefined $Diagonal) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($SpanUndefined $Mirror) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($SpanUndefined $EightConnected) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($TouchedEdge $SpanStays) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($TouchedEdge $Diagonal) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($TouchedEdge $Mirror) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($TouchedEdge $EightConnected) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
