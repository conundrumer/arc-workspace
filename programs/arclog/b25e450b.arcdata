(param &trail_color Color (7))
(param &block_color Color (0))
(param &field_color Color (5) (7))

(exclude ($CornerUndefined $RecolorTrack) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
(exclude ($CornerUndefined $NonFieldColor) "A case of $Block other than the concept case that takes $TouchedEdge, $CornerUndefined or $SpanUndefined is subsumed by the case that takes $AwayFromNearestEdge & $Band, $Diagonal or $SpanStays in its place: those branches only widen where the model is defined. $PerLine with $AwayFromNearestEdge fails Fit.")
