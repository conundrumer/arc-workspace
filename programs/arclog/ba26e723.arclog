;; inputs 397ac52041ed7ba7637b95a0a577b5f88d7295aaf8f0d483e9c4951ae5bf00c9 programs/solvers/ba26e723.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; ba26e723

(DET &anchor DirDomain)

(DET &period ConstInDim)

(DET &phase NumberDomain)

(DET &mapping ChangedPairs)

(RULE &on_stride
  (input *P)
  (&anchor *D)
  (&period (:N *W))
  (&phase (:N *K))
  (margin (:B P) D (:K *T))
  (divide T (:Side W) (:Gap 0) (:Remainder K)))

(RULE &recolored
  (input *P *Col)
  (&mapping (:C_from Col))
  (&on_stride P))

(RULE &output
  (OR ((input *P (:Col *Col_in))
       (&mapping (:C_from Col_in) (:C_to *Col))
       (&on_stride P))
      ((input P Col)
       (NOT (&recolored P)))))

(OUT (&output ^P ^Col))
