;; inputs 358548293cbdbecf464f4fde012361f506263b1db890e840df44fc3a62d69942 programs/solvers/ea786f4a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; ea786f4a

(DET &ink RarestColor)

(RULE &dot
  (input *P (:Col *Ink))
  (&ink (:C Ink)))

;; Diagonal rays from the dot toward every corner.
(INIT &xrays Ray
  (source ((:P Q))
    (&dot (:P *Q)))
  (node (P)
    (input *P))
  (dir (D)
    (diag_dir_elem *D)))

(RULE &x_cell
  (&xrays.ray *P))

(ALTS $choice "where the X comes from" $Dot
  (ALT $Grid
    (RULE &dg_diagonal
      (input *P)
      (diag_dist P (:Diag *D) (:K1 *Ring) (:K2 Ring)))

    (RULE &x_cell
      (&dg_diagonal *P))))

(RULE &output
  (OR ((&x_cell *P)
       (&ink (:C *Col)))
      ((input P Col)
       (NOT (&x_cell P)))))

(OUT (&output ^P ^Col))
