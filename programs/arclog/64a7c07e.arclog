;; inputs 9a6dc5cd5245c93794f1f9a7cb8a9a6c1b70e06a9bd759477b069c6646dcb681 programs/solvers/64a7c07e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 64a7c07e

(DET &bg DominantColor)

(DET &move_dir DirDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; A blob holds together through diagonal contact.
(INIT &blob Connectivity
  (node (P)
    (&ink *P))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox BoundingBox
  (key ((&blob.component *P ^Id))
    (cell (P)
      (&blob.component *P Id))))

(RULE &landed
  (&blob.component (:P *P2) *Id)
  (&ink (:P P2) *Col)
  (&move_dir *D)
  (axis_of D *A)
  (&bbox.box (:key Id) *B)
  (box_extent B (:P P2) A *N)
  (jump (:P P2) D (:K N) (:Q *P)))

(RULE &output
  (input *P)
  (OR ((&landed P *Col))
      ((NOT (&landed P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
