;; inputs 16c66944e7824a98a5b2c13674737c5cdf53b47c75fc922542b3be6ecd5d6b4c programs/solvers/c3202e5a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c3202e5a

(param &bg Color (0))

(exclude ($OneColor $IgnoreDividerInk))
(exclude ($FewestColors $IgnoreDividerInk))
(exclude ($NoBackground $IgnoreDividerInk))

(alts $sel
  (alt $FewestColors
    (witness empty-tile borderline concept
      (relaxed one-mono-tile)
      (separates "One tile holds no marks beside the one-color tile. The concept crops the one-color tile; the fewest-colors readings crop the empty tile.")
      (input (grid
        (0 5 0 8 1 0 0 8 0 3 0)
        (5 0 0 8 0 0 2 8 0 0 0)
        (0 0 5 8 0 1 0 8 6 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 7 8 0 0 0 8 6 0 0)
        (2 0 0 8 0 0 0 8 0 0 1)
        (0 0 9 8 0 0 0 8 0 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 2 0 8 0 0 1)
        (3 0 0 8 0 0 6 8 0 0 0)
        (0 0 7 8 0 0 0 8 4 0 0)))
      (output $MostOfOneColor concept (grid
        (0 5 0)
        (5 0 0)
        (0 0 5)))
      (output $FewestColors $NoBackground (grid
        (0 0 0)
        (0 0 0)
        (0 0 0)))))
  (alt $MostOfOneColor
    (witness sparse-mono-tile ordinary concept
      (separates "The one-color tile holds 2 marks, and a two-color tile holds 4 marks of one color. The concept crops the one-color tile; the most-of-one-color reading crops the other tile.")
      (input (grid
        (0 4 0 8 6 0 6 8 0 3 0)
        (0 0 0 8 0 6 0 8 0 0 0)
        (0 0 4 8 6 0 1 8 6 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 7 8 0 9 0 8 6 0 0)
        (2 0 0 8 0 0 0 8 0 0 1)
        (0 0 9 8 0 4 0 8 0 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 2 0 8 0 0 1)
        (3 0 0 8 0 0 6 8 0 0 0)
        (0 0 7 8 0 0 0 8 4 0 0)))
      (output $FewestColors $NoBackground concept (grid
        (0 4 0)
        (0 0 0)
        (0 0 4)))
      (output $MostOfOneColor (grid
        (6 0 6)
        (0 6 0)
        (6 0 1)))))
  (alt $NoBackground
    (witness empty-tile borderline concept)
    (witness solid-two-color-tile borderline concept
      (separates "One tile is filled with two colors and no background cell, beside a sparse one-color tile. The concept crops the one-color tile; the fewest-cell-colors reading counts two colors in each and is undefined.")
      (input (grid
        (0 5 0 8 1 0 0 8 0 3 0)
        (5 0 0 8 0 0 2 8 0 0 0)
        (0 0 5 8 0 1 0 8 6 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 7 8 1 2 1 8 6 0 0)
        (2 0 0 8 2 1 2 8 0 0 1)
        (0 0 9 8 1 2 1 8 0 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 2 0 8 0 0 1)
        (3 0 0 8 0 0 6 8 0 0 0)
        (0 0 7 8 0 0 0 8 4 0 0)))
      (output $FewestColors concept (grid
        (0 5 0)
        (5 0 0)
        (0 0 5)))
      (output $MostOfOneColor (grid
        (1 2 1)
        (2 1 2)
        (1 2 1)))
      (output $NoBackground undefined))
    (witness solid-tile foreign concept
      (relaxed one-mono-tile)
      (separates "One tile is solid in one color beside a sparse one-color tile. The concept crops the sparse tile, the one-color tile that holds background cells; the fewest-mark-colors reading finds two one-color tiles and is undefined; the fewest-cell-colors and most-of-one-color readings crop the solid tile.")
      (input (grid
        (0 5 0 8 1 0 0 8 0 3 0)
        (5 0 0 8 0 0 2 8 0 0 0)
        (0 0 5 8 0 1 0 8 6 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 7 8 6 6 6 8 6 0 0)
        (2 0 0 8 6 6 6 8 0 0 1)
        (0 0 9 8 6 6 6 8 0 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 2 0 8 0 0 1)
        (3 0 0 8 0 0 6 8 0 0 0)
        (0 0 7 8 0 0 0 8 4 0 0)))
      (output concept (grid
        (0 5 0)
        (5 0 0)
        (0 0 5)))
      (output $FewestColors undefined)
      (output $MostOfOneColor $NoBackground (grid
        (6 6 6)
        (6 6 6)
        (6 6 6))))))

(alts $ink
  (alt $IgnoreDividerInk
    (witness divider-ink-heavy ordinary concept
      (separates "A tile holds 5 cells of the divider color and one other mark, and the one-color tile holds 4 marks. Counting divider-colored cells, the most-of-one-color reading crops the first tile; leaving them out, it crops the one-color tile, as the concept does.")
      (input (grid
        (3 0 3 8 8 8 0 8 0 3 0)
        (0 3 0 8 8 0 8 8 0 0 0)
        (0 0 3 8 0 8 2 8 6 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 7 8 0 9 0 8 6 0 0)
        (2 0 0 8 0 0 0 8 0 0 1)
        (0 0 9 8 0 4 0 8 0 0 0)
        (8 8 8 8 8 8 8 8 8 8 8)
        (0 0 0 8 0 2 0 8 0 0 1)
        (3 0 0 8 0 0 6 8 0 0 0)
        (0 0 7 8 0 0 0 8 4 0 0)))
      (output $FewestColors $NoBackground concept $IgnoreDividerInk (grid
        (3 0 3)
        (0 3 0)
        (0 0 3)))
      (output ($MostOfOneColor $CountDividerInk) (grid
        (8 8 0)
        (8 0 8)
        (0 8 2))))))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor borderline concept
      (separates "Color 1 outnumbers color 0. Read with background 1, the tile of 1s and one 3 has one mark color, and the tile of 0s and 2s has two; the concept, with background 0, crops the tile of 0s and 2s.")
      (input (grid
        (0 2 0 8 1 1 0 8 1 1 0)
        (0 0 2 8 1 4 1 8 1 5 1)
        (2 0 0 8 0 1 1 8 0 1 1)
        (8 8 8 8 8 8 8 8 8 8 8)
        (1 1 0 8 1 1 1 8 1 1 0)
        (1 6 1 8 1 3 1 8 1 7 1)
        (0 1 1 8 1 1 1 8 0 1 1)
        (8 8 8 8 8 8 8 8 8 8 8)
        (1 1 0 8 1 1 0 8 1 1 0)
        (1 9 1 8 1 4 1 8 1 6 1)
        (0 1 1 8 0 1 1 8 0 1 1)))
      (output $FewestColors ($OneColor &bg=$Stored) (grid
        (0 2 0)
        (0 0 2)
        (2 0 0)))
      (output $MostOfOneColor &bg=$Derived (grid
        (1 1 1)
        (1 3 1)
        (1 1 1)))
      (output $NoBackground undefined))))
