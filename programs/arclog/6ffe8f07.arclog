;; inputs c60667a1e0cb580f6c4ca5de884f3901ea6dd51c012636bfffbf95bf84a9cfef programs/solvers/6ffe8f07.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6ffe8f07

(DET &wall UnchangedColor)

(RULE &cast_blocked
  (input *P *Col)
  (&wall (:C Col)))

(DET &source UnchangedColor)

(INIT &cast Ray
  (source (P)
    (input *P *Col)
    (&source (:C Col)))
  (node (P)
    (input *P)
    (NOT (&cast_blocked P)))
  (dir (D)
    (dir_elem *D)))

(RULE &cast_cell
  (input *P *Col)
  (NOT (&source (:C Col))))

(RULE &cast_clear
  (&cast.ray *P *D *K (:Origin *Src))
  (&cast_cell P))

(DET &beam AnyOutNewColor)

(RULE &output
  (OR ((&cast.ray *P)
       (&cast_cell P)
       (&beam (:C *Col)))
      ((input P Col)
       (NOT (&cast_clear P)))))

(OUT (&output ^P ^Col))
