;; inputs 61766312be924bc98135720b64be4d9ae4306ab39d7c0bef12ace8a681015443 programs/solvers/00d62c1b.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 00d62c1b

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &bg_cell
  (input *P *Col)
  (&bg (:C Col)))

(INIT &outside Flood
  (node (P)
    (&bg_cell *P))
  (source (P)
    (&bg_cell *P)
    (margin (:B P) *D (:K 0))))

(RULE &enclosed
  (&bg_cell *P)
  (NOT (&outside.reached P)))

(RULE &output
  (OR ((&enclosed *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&enclosed P)))))

(OUT (&output ^P ^Col))
