;; inputs ebde0428b80427ada45a8ed3146b865af6a8faa0b13202cff83f90c8298d55b1 programs/solvers/759f3fd3.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 759f3fd3

(DET &cross RarestColor)

;; The ring beside the center.
(DET &first_ring DominantColor)

;; The cross cells. Their rim is the arms; the crossing is the one cell
;; off it.
(INIT &cross2 Boundary
  (cell (P)
    (input *P (:Col *C))
    (&cross C)))

;; Square rings growing out from the crossing.
(INIT &rings Distance
  (edge ((:a Q) (:b P))
    (input (:P *Q))
    (neighbor (:P Q) *D (:Q *P))
    (input P))
  (source ((:n P))
    (&cross2.cell *P)
    (NOT (&cross2.boundary P))))

(RULE &ring
  (input *P *Col)
  (NOT (&cross (:C Col)))
  (&rings.distance (:n P) *K))

(DET &ring_cycle
  (&ring *E *P *K)
  (ex_output E P (:Col *C))
  (neighbor P *D *Q)
  (&ring E (:P Q) (:K *K2))
  (< K K2)
  (ex_output E (:P Q) (:Col *C_next)))

(RULE &ring_succ
  (OR ((&ring_cycle *C *C_next))
      ((&cross C)
       (&first_ring (:C C_next)))))

;; Ring colors: the cross color advanced one step per ring.
(INIT &colors Walk
  (successor ((:p C) (:p_next C2))
    (&ring_succ *C (:C_next *C2)))
  (steps ((:N K))
    (&ring *K)))

(ALTS $choice "how ring colors are computed" $Cycle
  (ALT $Period
    (DET &bg DominantColor)

    (DET &fill AnyOutNewColor)

    (DET &period TileCount)

    (RULE &filled
      (&ring *P *K)
      (&period (:N *W))
      (divide (:T K) (:Side W) (:Gap 0) (:Remainder 0)))

    (RULE &output
      (OR ((&ring *P)
           (IF ((&filled P))
               ((&fill (:C *Col)))
               ((&bg (:C Col)))))
          ((input P Col)
           (&cross (:C Col)))))))

(RULE &output
  (OR ((input *P *Col)
       (&cross (:C Col)))
      ((&ring P *K)
       (&cross *C)
       (&colors.walk (:p0 C) (:N K) (:p Col)))))

(OUT (&output ^P ^Col))
