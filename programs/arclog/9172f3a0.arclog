;; inputs a4fa91e82bb9bf36fa571b9fe7244f597eae53cab08e55a5b8b1e8924a9bfbfc programs/solvers/9172f3a0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 9172f3a0

(DET &scale ConstInDim)

(INIT &intile_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&scale *N)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&intile_frame.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&output_tiling.cell (:P_outer P_tile) *P))

(OUT (&output ^P ^Col))
