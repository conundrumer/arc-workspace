;; inputs 4cb89a6bdb55b8a06939862edd97445ba6215baded174842866baa02bcecb0c4 programs/solvers/e98196ab.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e98196ab

(DET &bg DominantColor)

(DET &tile_dim ConstOutDimAxis)

(DET &arr_dim SepTileCountAxis)

(DET &gap DivisorRatio)

(INIT &tile_decompose_outer Frame
  (extent (A N)
    (&arr_dim *A *N)))

(INIT &tile_decompose_inner Frame
  (extent (A N)
    (&tile_dim *A *N)))

(INIT &tile_decompose_tiling Tiling
  (outer (P)
    (&tile_decompose_outer.cell *P))
  (inner (P)
    (&tile_decompose_inner.cell *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(RULE &decompose
  (&tile_decompose_tiling.cell *P *P_outer *P_inner))

(ALTS $choice "out's choice column (decompose)" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&tile_dim A (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(RULE &ink
  (input (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&decompose (:P P_grid) (:P_inner *P)))

(RULE &output
  (OR ((&ink *P *Col))
      ((&decompose (:P_inner P))
       (NOT (&ink P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
