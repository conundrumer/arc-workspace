;; inputs ebb88db131394f4a94101cc6f69e9785eaefc79563d7cb5aa55a294b6a6ed19b programs/solvers/22168020.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 22168020

(DET &bg DominantColor)

(DET &fill_axis AxisDomain)

(RULE &spans_mark
  (input *P (:Col *Key))
  (NOT (&bg (:C Key))))

(RULE &spans_axis
  (&spans_mark *Key)
  (&fill_axis *A))

(INIT &spans Ray
  (key ((OR ((input (:P *Q) ^Col)
             (NOT (&bg (:C Col))))
            ((&spans_axis (:Key Col) *A)
             (axis4_of *D A))
            ((&spans_axis (:Key Col))
             (input *P))))
    (source ((:P Q))
      (input (:P *Q) Col)
      (NOT (&bg (:C Col))))
    (node (P)
      (&spans_axis (:Key Col))
      (input *P))
    (dir (D)
      (&spans_axis (:Key Col) *A)
      (axis4_of *D A))))

(RULE &spans_between
  (&spans_mark *Key)
  (input *P)
  (&spans_axis Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&spans.ray (:key (:Col Key)) P D)
  (&spans.ray (:key (:Col Key)) P (:D O)))

(RULE &output
  (OR ((&spans_between (:Key *Col) *P))
      ((input P Col)
       (NOT (&spans_between P)))))

(OUT (&output ^P ^Col))
