        (4 4 4 0 0 0 8 8 4 4 4)
        (4 4 4 0 0 0 0 0 4 4 4)
        (0 0 0 4 4 4 0 0 0 0 0)
        (0 0 0 4 4 4 0 0 0 0 0)
        (0 0 0 4 4 4 0 0 0 0 0))))))

