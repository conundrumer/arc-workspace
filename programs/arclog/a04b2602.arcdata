(alts $r
  (alt $FourConnected
    (witness split-narrow borderline concept
      (separates "$FourConnected from the concept: a row of marks crosses a two-wide rectangle and splits its 3 cells in two. $FourConnected boxes each half and leaves the row outside both; the concept spans the two boxes, finds no field cell in the span, and haloes both marks.")
