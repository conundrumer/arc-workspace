;; inputs e58b2373c2bd1a4043f60ca389aeb72af0998cfa93cd59a18ca26ad9cbe22a56 programs/solvers/a68b268e.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; a68b268e

(DET &gap SepThickness)

(DET &tiles SepTileCount)

(INIT &tile_cell_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (axis_elem *A)
    (&tiles *N))
  (gap (A G)
    (axis_elem *A)
    (&gap *G)))

(INIT &tile_ink_division Division
  (cell ((:P P_grid))
    (ex_input (:P *P_grid)))
  (parts (A N)
    (axis_elem *A)
    (&tiles *N))
  (gap (A G)
    (axis_elem *A)
    (&gap *G)))

(DET &bg DominantColor)

(DET &lex_axis AxisDomain)

(RULE &tiling)

(RULE &tile_cell
  (input (:P *P_grid) *Col)
  (&tile_cell_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(DET &tile_ink
  (ex_input *E (:P *P_grid) *Col)
  (NOT (&bg (:C Col)))
  (&tile_ink_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P)))

(DET &beats
  (&tile_ink *E *P_tile *P *Col)
  (&tile_ink E (:P_tile *P_tile2) P (:Col *Col2))
  (!= Col Col2)
  (ex_output E P Col))

;; The tiles each tile beats, directly or through others: a tile pair
;; need not overlap directly.
(INIT &beaten Propagation
  (key ((OR ((&beats (:P_tile ^T) (:P_tile2 *T2)))
            ((&beats (:P_tile T))
             (&beats (:P_tile T2) (:P_tile2 *T3)))))
    (source ((:n T2))
      (&beats (:P_tile T) (:P_tile2 *T2)))
    (edge ((:a T2) (:b T3))
      (&beats (:P_tile T))
      (&beats (:P_tile *T2) (:P_tile2 *T3)))))

(INIT &order Order
  (member ((:t T))
    (&tile_ink (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&beaten.reached (:key *T) (:n *T2))))

(DET &lex_corner
  (&order.minimal (:t *T))
  (corner_dist (:P T) (:Diag *D) (:K 0)))

(DET &prio
  (&order.rank (:t *P) *R))

(ALTS $choice "whether the overlay ranks by tile (spatial) precedence, as a rule or a stored table, or by ink (chromatic) precedence, a stored table" $Scan
  (ALT $Scan
    (ALTS $d "how the grid divides into tiles, indistinguishable here since every grid is 9×9" $Count
      (ALT $Size
        (DET &tile_dim
          (ex_output *P)
          (frame_extent P *A (:N *K)))
        (INIT &tile_cell_division2 Division
          (cell ((:P P_grid))
            (input (:P *P_grid)))
          (side (A K)
            (axis_elem *A)
            (&tile_dim *K))
          (gap (A G)
            (axis_elem *A)
            (&gap *G)))
        (RULE &tile_cell
          (input (:P *P_grid) *Col)
          (&tile_cell_division2.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile))))))
  (ALT $Order
    (RULE &tile_cell2
      (input (:P *P_grid) *Col)
      (&tile_cell_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

    (RULE &tile_ink22
      (&tile_cell2 *P_tile (:P_intile *P) *Col)
      (NOT (&bg (:C Col))))

    ;; The foremost tile inking each cell.
    (INIT &front_tile Order
      (key ((&tile_ink2 (:P_tile *T) ^P)
            (&prio (:P T) *R))
        (member ((:t (:V T) (:S R)))
          (&tile_ink2 (:P_tile *T) P)
          (&prio (:P T) *R))
        (score ((:t (:V T) (:S R)) (:S R))
          (&tile_ink2 (:P_tile *T) P)
          (&prio (:P T) *R))))

    (RULE &output
      (OR ((&front_tile.minimal (:key *P) (:t (:V *T)))
           (&tile_ink22 (:P_tile T) P *Col))
          ((&tiling)
           (&tile_cell (:P_intile P))
           (NOT (&tile_ink2 P))
           (&bg (:C Col))))))
  (ALT $Ink
    (DET &ink_rank
      (&tile_ink (:P_tile *T) (:Col *C))
      (&prio (:P T) *R))

    ;; The foremost ink at each cell.
    (INIT &front_ink Order
      (key ((&tile_ink2 ^P *Col)
            (&ink_rank (:C Col) *R))
        (member ((:t (:V Col) (:S R)))
          (&tile_ink2 P *Col)
          (&ink_rank (:C Col) *R))
        (score ((:t (:V Col) (:S R)) (:S R))
          (&tile_ink2 P *Col)
          (&ink_rank (:C Col) *R))))

    (RULE &output
      (OR ((&front_ink.minimal (:key *P) (:t (:V *Col))))
          ((&tiling)
           (&tile_cell (:P_intile P))
           (NOT (&tile_ink2 P))
           (&bg (:C Col)))))))

(RULE &tile_ink2
  (&tile_cell *P_tile (:P_intile *P) *Col)
  (NOT (&bg (:C Col))))

(INIT &lex Order
  (member ((:t T))
    (&tile_ink2 (:P_tile *T)))
  (score ((:t T) (:S K1))
    (&tile_ink2 (:P_tile *T))
    (&lex_corner (:D *Diag))
    (&lex_axis *A)
    (diag_dist (:P T) Diag A *K1 *K2))
  (secondary_score ((:t T) (:S K2))
    (&tile_ink2 (:P_tile *T))
    (&lex_corner (:D *Diag))
    (&lex_axis *A)
    (diag_dist (:P T) Diag A *K1 *K2)))

;; The earliest tile in the scan inking each cell.
(INIT &front_scan Order
  (key ((&tile_ink2 (:P_tile *T) ^P)
        (&lex.rank (:t T) *R))
    (member ((:t (:V T) (:S R)))
      (&tile_ink2 (:P_tile *T) P)
      (&lex.rank (:t T) *R))
    (score ((:t (:V T) (:S R)) (:S R))
      (&tile_ink2 (:P_tile *T) P)
      (&lex.rank (:t T) *R))))

(RULE &output
  (OR ((&tiling)
       (&tile_cell (:P_intile *P))
       (NOT (&tile_ink2 P))
       (&bg (:C *Col)))
      ((&front_scan.minimal (:key P) (:t (:V *T)))
       (&tile_ink2 (:P_tile T) P Col))))

(OUT (&output ^P ^Col))
