        (5)
        (5)))
      (output $Conn4 (grid
        (6)
        (6)
        (6))))))

(alts $rank
  (alt $FirstScan
    (witness narrow-ends borderline concept
      (relaxed apart)
      (separates "$FirstScan from the concept: each kept object's top and bottom lines are narrower than its middle")
      (input (grid
