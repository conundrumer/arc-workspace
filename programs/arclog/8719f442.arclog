;; inputs 4c55bbc160512d7107ded5117e3535a067a1e6cfc709be5b1bd6f91eb1301504 programs/solvers/8719f442.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8719f442

(DET &ring_width TileDim)

(RULE &seat_delta
  (&ring_width (:D *K))
  (uniform_inset K (:B *P)))

(RULE &seated
  (input (:P *P_in))
  (&seat_delta (:P *Delta))
  (compose (:A P_in) (:B Delta) (:C *P_tile)))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&seated *P_tile))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(INIT &cell_tiling2 Tiling
  (outer ((:P P_tile))
    (&seated (:P_tile *P_seat))
    (neighbor (:P P_seat) (:Q *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg ColorDomain)

(DET &fill ColorDomain)

(RULE &active
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &cell
  (OR ((&cell_tiling.cell (:P_outer *P_tile) (:P_inner *P_intile) (:P *P_grid)))
      ((&cell_tiling2.cell (:P_outer P_tile) (:P_inner P_intile) (:P P_grid)))))

(RULE &copy
  (&active (:P *P_in))
  (&seated P_in (:P_tile *P_seat))
  (margin (:B P_in) *D (:K 0))
  (neighbor (:P P_seat) D (:Q *P_tile)))

(RULE &block
  (input (:P *P_in) *Col)
  (&seated P_in *P_tile))

(ALTS $choice "which color the block's cells take — data-equivalent on this task, whose inputs are one fg color with a fg center" $Scaled
  (ALT $Stored
    (RULE &block
      (&active (:P *P_in))
      (&seated P_in *P_tile)
      (&fill (:C *Col))))
  (ALT $Hub
    (RULE &block
      (&seated *P_in *P_tile)
      (OR ((&active (:P P_in)))
          ((centered (:P P_in))))
      (&fill (:C *Col)))))

(RULE &output
  (&cell (:P_grid *P) *P_tile *P_intile)
  (OR ((&block P_tile *Col))
      ((&copy P_tile)
       (input (:P P_intile) Col))
      ((NOT (&block P_tile))
       (NOT (&copy P_tile))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
