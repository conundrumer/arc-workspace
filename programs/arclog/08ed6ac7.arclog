;; inputs 38edb5685a911fdd8ae5a3c30ad2d457de973de67ba3bdab6835ce2605a47037 programs/solvers/08ed6ac7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 08ed6ac7

(DET &ink ChangedColor)

(DET &axis AxisDomain)

(RULE &ink2
  (input *P *Col)
  (&ink (:C Col)))

(INIT &objs Connectivity
  (node (P)
    (&ink2 *P)))

(INIT &obj_size Cardinality
  (key ((&objs.component *P ^Id))
    (member ((:m P))
      (&objs.component *P Id))))

(RULE &bar_size
  (&obj_size.size *N))

(DET &line_cell
  (ex_input *E *P *Col)
  (&ink (:C Col))
  (&axis *A)
  (split P A (:Across *B)))

(INIT &line_size Cardinality
  (key ((&line_cell ^E ^B *P))
    (member ((:m P))
      (&line_cell E B *P))))

(DET &bar_color
  (&line_size.size (:key *E *B) *N)
  (&line_cell E B *P)
  (ex_output E P *Col))

(INIT &seq Order
  (key ((&line_size.size (:key ^E) *N))
    (member ((:t N))
      (&line_size.size (:key E) *N))
    (score ((:t N) (:S N))
      (&line_size.size (:key E) *N))))

(DET &tall_color
  (&seq.dual_rank (:key *E) (:t *N) *R)
  (&bar_color E N *Col))

(ALTS $s "what a bar is" $Object
  (ALT $Line
    (RULE &line_cell2
      (&ink2 *P)
      (&axis *A)
      (split P A (:Across *B)))

    (INIT &line_size2 Cardinality
      (key ((&line_cell2 ^B *P))
        (member ((:m P))
          (&line_cell2 B *P))))

    (RULE &bar_size
      (&line_size2.size *N))

    (RULE &output
      (OR ((&line_cell2 *B *P)
           (&line_size2.size (:key B) *N)
           (&size_color N *Col))
          ((input P Col)
           (NOT (&ink (:C Col))))))))

(ALTS $a "which end of the size order is rank 0" $Tall
  (ALT $Short
    (DET &short_color
      (&seq.rank (:key *E) (:t *N) *R)
      (&bar_color E N *Col))

    (RULE &size_color
      (&seq2.rank (:t *N) *R)
      (&short_color R *Col))))

(INIT &seq2 Order
  (member ((:t N))
    (&bar_size *N))
  (score ((:t N) (:S N))
    (&bar_size *N)))

(RULE &size_color
  (&seq2.dual_rank (:t *N) *R)
  (&tall_color R *Col))

(RULE &output
  (OR ((&objs.component *P *Id)
       (&obj_size.size (:key Id) *N)
       (&size_color N *Col))
      ((input P Col)
       (NOT (&ink (:C Col))))))

(OUT (&output ^P ^Col))
