;; inputs 0b94627f57885a5268b398247c7b72dc199ef279072a413093de2cb82d13ad0b programs/solvers/c3e719e8.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c3e719e8

(INPUT unique-mode "one color is strictly more common in the input than every other color"

  (INIT &palette_count Cardinality
    (key ((input *P ^Col))
      (member ((:m P))
        (input *P Col))))

  (INIT &palette Order
    (member ((:t Col))
      (&palette_count.size (:key *Col)))
    (score ((:t Col) (:S N))
      (&palette_count.size (:key *Col) *N)))

  (INIT &commonest Singleton
    (member ((:v Col))
      (&palette.maximal (:t *Col)))))

(OUTPUT block-layout "the output is the input's height times its height in rows and its width times its width in columns, cut into blocks of the input's size, and block (i, j) stands for input cell (i, j)")

(OUTPUT copy-where-mode "a block whose input cell has the most common color is a copy of the input")

(OUTPUT blank-elsewhere "every other block is filled with the background")

(ALTS $choice "what gates when colors tie for the most cells" $Sole
  (ALT $TiesAllGate
    (INPUT unique-mode "none; defined on every input")
    (OUTPUT copy-where-mode "a block whose input cell has one of the colors tied for the most cells is a copy of the input")
    (RULE &gate
      (input (:P *P_tile) *Col)
      (&palette.maximal (:t Col)))

    (RULE &blank
      (input (:P *P_tile) *Col)
      (NOT (&palette.maximal (:t Col)))))
  (ALT $TiesNoneGate
    (INPUT unique-mode "none; defined on every input")
    (OUTPUT copy-where-mode "a block whose input cell's color has strictly more cells than every other color is a copy of the input, so on a tie every block is blank")
    (RULE &blank
      (input (:P *P_tile) *Col)
      (NOT (&commonest.value (:v Col))))))

(RULE &gate
  (input (:P *P_tile) *Col)
  (&commonest.value (:v Col)))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (&gate *P_tile))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(RULE &blank
  (input (:P *P_tile) *Col)
  (NOT (&commonest.plural))
  (NOT (&commonest.value (:v Col))))

(INIT &output_tiling2 Tiling
  (outer ((:P P_tile))
    (&blank *P_tile))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(INIT &background_tiling Tiling
  (key ((&commonest.value ^E)
        (ex_output E))
    (outer ((:P P_tile))
      (ex_input E (:P *P_tile)))
    (inner ((:P P_intile))
      (ex_input E (:P *P_intile)))))

(DET &background
  (ex_input *E (:P *P_tile) (:Col *C_gate))
  (&background_tiling.cell (:key E) (:P_outer P_tile) *P)
  (NOT (&commonest.value E (:v C_gate)))
  (ex_output E P (:Col *C)))

(RULE &output
  (OR ((&gate *P_tile)
       (input (:P *P_intile) *Col)
       (&output_tiling.cell (:P_outer P_tile) (:P_inner P_intile) *P))
      ((&blank (:P_tile *P_tile2))
       (&output_tiling2.cell (:P_outer P_tile2) P)
       (&background (:C Col)))))

(OUT (&output ^P ^Col))
