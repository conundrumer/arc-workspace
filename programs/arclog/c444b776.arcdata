        (0 0 3 0 4 0 0 3 0)
        (2 0 0 0 4 2 0 0 0)
        (0 0 0 7 4 0 0 0 7)
        (4 4 4 4 4 4 4 4 4)
        (0 2 0 0 4 0 2 0 0)
        (0 0 3 0 4 0 0 3 0)
        (2 0 0 0 4 2 0 0 0)
        (0 0 0 7 4 0 0 0 7)))
      (output $StoredTiling (grid
