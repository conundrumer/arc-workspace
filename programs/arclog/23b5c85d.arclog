;; inputs a2c2661b2382b1a0214c1065c4bda94079960e545c4eef26535ed7162dd2d12b programs/solvers/23b5c85d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 23b5c85d

(DET &bg SharedColor)

(INIT &boxes BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &obj_cell
  (input *P)
  (&boxes.box (:key *Col) *B)
  (inside (:A P) B))

(ALTS $s "the object's cells" $Box
  (ALT $Visible
    (RULE &obj_cell
      (&boxes.cell (:key *Col) *P))))

(ALTS $r "fill the box" $Keep
  (ALT $Crop
    (RULE &output
      (&sel.minimal (:t (:V *Col_win)))
      (input (:P *P_grid) *Col)
      (&boxes.box (:key (:Col Col_win)) *B)
      (inside (:A P_grid) B)
      (relative (:Base B) (:X P_grid) (:X_rel *P)))))

(INIT &size Cardinality
  (key ((&obj_cell ^Col *P))
    (member ((:m P))
      (&obj_cell Col *P))))

(INIT &sel Order
  (member ((:t (:V Col) (:S N)))
    (&size.size (:key *Col) *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&size.size (:key *Col) *N)))

(RULE &output
  (&sel.minimal (:t (:V *Col_win)))
  (input (:P *P_grid))
  (&boxes.box (:key (:Col Col_win)) *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P))
  (OR ((NOT (&obj_cell (:Col Col_win) (:P P_grid)))
       (&bg (:C *Col)))
      ((&obj_cell (:Col Col_win) (:P P_grid))
       (= Col Col_win))))

(OUT (&output ^P ^Col))
