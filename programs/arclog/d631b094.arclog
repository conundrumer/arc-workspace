;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d631b094

(DET &bg SharedColor)

(DET &bar_axis AxisDomain)

(RULE &on
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &total Cardinality
  (member ((:m P))
    (&on *P)))

(INIT &bar Frame
  (key ((&bar_axis ^A))
    (extent (A N)
      (&total.size *N))))

(OUT (&bar.cell ^P) (&on ^Col))
