;; inputs 6aebe74e4692001b4634ff9a27dfe094426e5ac28db608344037d040a9e0678f programs/solvers/25d487eb.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 25d487eb

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &body_count Cardinality
  (key ((&ink *P ^Col))
    (member ((:m P))
      (&ink *P Col))))

(INIT &body Order
  (member ((:t Col))
    (&body_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&body_count.size (:key *Col) *N)))

(RULE &mark
  (&ink *P *Col)
  (NOT (&body.maximal (:t Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &cast_dir
  (&mark *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (same_dist (:D *D_base) (:P1 P) (:P2 B))
  (opposite (:D D_base) (:Opp *D)))

(RULE &rays_cell
  (input *P *Col)
  (&bg (:C Col)))

(ALTS $choice "the cast direction" $Away
  (ALT $Open
    (INIT &margins Order
      (member ((:t (:V D) (:S K)))
        (&bbox.box *B)
        (margin B *D *K))
      (score ((:t (:V D) (:S K)) (:S K))
        (&bbox.box *B)
        (margin B *D *K)))

    (RULE &cast_dir
      (&margins.maximal (:t (:V *D))))))

;; The cast reports background cells only, so the arrowhead's own cells pass
;; under the ray.
(INIT &rays Ray
  (source (P)
    (&mark *P))
  (node (P)
    (input *P))
  (dir (D)
    (&cast_dir *D)))

(RULE &beam
  (&rays.ray *P (:Origin *Src))
  (&rays_cell P)
  (&mark (:P Src) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&beam P *Col))
      ((NOT (&beam P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
