;; inputs 1a6e7ca93a285cb6d233ca026a46842d21526c044f0b47e792896d6d5d8842ba programs/solvers/c7d4e6ad.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c7d4e6ad

(DET &targets ChangedColor)

(DET &axis AxisDomain)

(DET &anchor DirDomain)

(RULE &cell_slice
  (input *P *Col)
  (&axis *A)
  (split P A (:Across *P_across)))

(RULE &slice_repl
  (&cell_slice *P *Col *P_across)
  (&anchor *D)
  (margin (:B P) D (:K 0)))

(ALTS $choice "what supplies the slice's replacement color" $Anchor
  (ALT $Unique
    (DET &bg DominantColor)

    (RULE &slice_repl
      (&cell_slice *P *Col *P_across)
      (NOT (&targets (:C Col)))
      (NOT (&bg (:C Col))))))

(RULE &output
  (&cell_slice *P (:Col *Col2) *P_across)
  (IF ((&targets (:C Col2)))
      ((&slice_repl P_across *Col))
      ((= Col Col2))))

(OUT (&output ^P ^Col))
