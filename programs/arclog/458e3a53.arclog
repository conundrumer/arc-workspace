;; inputs d3037c105c96fa445ebac252be33305d1954f21799c79cb48d66ef6a53220c66 programs/solvers/458e3a53.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 458e3a53

;; A uniform line spans the grid, so it divides tiles rather than sit in one.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

(RULE &tiles_on_divider
  (input *P)
  (&line_color.value (:key *A *L))
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &tiles_rank Order
  (key ((OR ((&line_color.value (:key *A *L))
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&line_color.value (:key *A *L))
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&line_color.value (:key *A *L))
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &tiles_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&tiles_on_divider P A))
  (margin (:B P) D *K)
  (&tiles_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiles_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiles_part_idx *P D (:N *N1))
  (&tiles_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &tiles_tile_of
  (&tiles_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiles_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &tile_color Singleton
  (key ((&tiles_tile_of *P ^P_tile)
        (input P *Col))
    (member ((:v Col))
      (&tiles_tile_of *P P_tile)
      (input P *Col))))

;; One output line per tile line that holds a one-color tile.
(INIT &layout Order
  (key ((axis_elem ^A)
        (axis_of ^D A))
    (member ((:t L))
      (&tile_color.value (:key *P_tile))
      (split (:P P_tile) A (:Along *L)))
    (before ((:a L) (:b L2))
      (&tile_color.value (:key *P_tile))
      (split (:P P_tile) A (:Along *L))
      (&tile_color.value (:key (:P_tile *P_tile2)))
      (split (:P P_tile2) A (:Along *L2))
      (!= L L2)
      (margin (:B L) D (:K *K1))
      (margin (:B L2) D (:K *K2))
      (< K1 K2))))

(RULE &layout_pos
  (&layout.rank (:key (:A *Key) *D) (:t *M) (:R *R1))
  (&layout.dual_rank (:key (:A Key) D) (:t M) (:R *R2))
  (axis_inset D (:K1 R1) (:K2 R2) (:B *P_pos)))

(RULE &output
  (&tile_color.value (:key *P_tile) (:v *Col))
  (perp *A *A2)
  (split (:P P_tile) A (:Along *L) (:Across *L2))
  (&layout_pos (:Key A) (:M L) *P_pos)
  (&layout_pos (:Key A2) (:M L2) (:P_pos *P_pos2))
  (compose (:A P_pos) (:B P_pos2) (:C *P)))

(OUT (&output ^P ^Col))
