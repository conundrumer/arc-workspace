;; inputs 730eed26682a7e6d043f533def42f74bb0739c920c40568afffa59b5d65b7d8b programs/solvers/3631a71a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3631a71a

(DET &mask ChangedColor)

(RULE &masked
  (input *P *Col)
  (&mask (:C Col)))

(DET &apos
  (ex_input *P)
  (split P *A *Along))

(DET &cand
  (&apos *A *Along)
  (axis_of (:D *Flush) A)
  (OR ((sub_extent (:P Along) A *K))
      ((= K 0))))

(DET &band_map
  (&cand *A *Flush *K)
  (&apos A *Along)
  (axis_inversion A (:T *F))
  (apply (:D F) (:P Along) (:P_out *L_flip))
  (jump (:P L_flip) (:D Flush) K (:Q *Along2))
  (&apos A (:Along Along2)))

(DET &cell_split
  (ex_input *E *P *Col)
  (NOT (&mask (:C Col)))
  (split P *A *Along *Across))

(DET &broken
  (&band_map *A *Flush *K (:Along *L1) (:Along2 *L2))
  (&cell_split *E A (:Along L1) (:Across *X) (:Col *C1))
  (&cell_split E A (:Along L2) (:Across X) (:Col *C2))
  (!= C1 C2))

(DET &witnessed
  (&band_map *A *Flush *K (:Along *L1) (:Along2 *L2))
  (!= L1 L2)
  (&cell_split *E A (:Along L1) (:Across *X))
  (&cell_split E A (:Along L2) (:Across X)))

(DET &mirror_band
  (&witnessed *A *Flush *K)
  (NOT (&broken A Flush K)))

(RULE &mirror
  (input *P)
  (&mirror_band *A (:Flush *D) *K)
  (axis_inversion A (:T *F))
  (apply (:D F) P (:P_out *P_flip))
  (jump (:P P_flip) D K *Q)
  (input (:P Q)))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&masked P)))
      ((&masked P)
       (&mirror P *Q)
       (NOT (&masked (:P Q)))
       (input (:P Q) Col))))

(OUT (&output ^P ^Col))
