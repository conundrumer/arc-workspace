;; inputs 5e123305b513ba58e5a1de8b905f3d4d70aa6a449544e26c8239b5871669749f programs/solvers/7acdf6d3.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7acdf6d3

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &comps Connectivity
  (key ((&ink *P ^Col))
    (node (P)
      (&ink *P Col)))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(DET &hollow_axis AxisDomain)

(RULE &hollow_axis2
  (&comps.component (:Id *Key))
  (&hollow_axis *A))

(INIT &hollow_frame Frame
  (key ((&comps.component *P ^Id)
        (frame_extent P *A *N))
    (extent (A N)
      (&comps.component *P Id)
      (frame_extent P *A *N))))

;; The hollow: bg cells with the container on both sides along the axis.
(INIT &hollow Ray
  (key ((OR ((&comps.component *P ^Id))
            ((&hollow_axis2 (:Key Id) *A)
             (axis4_of *D A))
            ((&hollow_frame.cell (:key Id) P))))
    (source (P)
      (&comps.component *P Id))
    (node (P)
      (&hollow_frame.cell (:key Id) *P))
    (dir (D)
      (&hollow_axis2 (:Key Id) *A)
      (axis4_of *D A))))

(RULE &hollow_between
  (&comps.component (:Id *Key))
  (input *P *Col)
  (&bg (:C Col))
  (&hollow_axis2 Key *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&hollow.ray (:key (:Id Key)) P D)
  (&hollow.ray (:key (:Id Key)) P (:D O)))

(INIT &hollow_size Cardinality
  (key ((&hollow_between (:Key ^Id) *P))
    (member ((:m P))
      (&hollow_between (:Key Id) *P))))

(INIT &pieces Cardinality
  (key ((&ink *P ^Col))
    (member ((:m P))
      (&ink *P Col))))

(RULE &fit
  (&hollow_size.size (:key *Id) *N)
  (&pieces.size (:key *Col) N)
  (&comps.component Id (:key (:Col *Col2)))
  (!= Col Col2))

(RULE &move
  (OR ((&fit *Id *Col)
       (&hollow_between (:Key Id) *P))
      ((&fit (:Col *Col2))
       (input P (:Col Col2))
       (&bg (:C Col)))))

(RULE &output
  (OR ((&move *P *Col))
      ((input P Col)
       (NOT (&move P)))))

(OUT (&output ^P ^Col))
