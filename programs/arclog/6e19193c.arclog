;; inputs fc8c4ae96d0063e6c6dcb8cd460ae7f44872c6344bbb2a24bca548e7548cbbb5 programs/solvers/6e19193c.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6e19193c

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &objs Connectivity
  (node (P)
    (&ink *P)))

(RULE &paint
  (&objs.component *P *Id)
  (input P *Col))

(INIT &bbox BoundingBox
  (key ((&objs.component *P ^Id))
    (cell (P)
      (&objs.component *P Id))))

(RULE &tip
  (&bbox.box (:key *Id) *B)
  (input *P)
  (inside (:A P) B)
  (same_corner *D (:P1 P) (:P2 B))
  (NOT (&ink P)))

(INIT &ray Ray
  (key ((OR ((&tip ^Id *P))
            ((&tip Id *D))))
    (source (P)
      (&tip Id *P))
    (node (P)
      (&tip Id *D)
      (input *P))
    (dir (D)
      (&tip Id *D))))

(RULE &ray_cell
  (&paint (:Id *Key))
  (input))

(RULE &trail
  (&ray.ray (:key *Id) *P *K)
  (&ray_cell (:Key Id))
  (input P)
  (!= K 0)
  (&paint Id *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&trail P *Col))
      ((NOT (&trail P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
