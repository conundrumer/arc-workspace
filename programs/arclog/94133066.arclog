;; inputs d843f8efefeb6b85ebca72bda507e5159ee354a1e7fc266aa6557f5cd7bffb1e programs/solvers/94133066.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 94133066

(INIT &commonest_count Cardinality
  (key ((ex_output ^E *P ^Col))
    (member ((:m P))
      (ex_output E *P Col))))

;; Each train output is the panel, which the field covers for the most part.
(INIT &commonest Order
  (key ((&commonest_count.size (:key ^E *Col)))
    (member ((:t Col))
      (&commonest_count.size (:key E *Col)))
    (score ((:t Col) (:S N))
      (&commonest_count.size (:key E *Col) *N))))

(DET &field
  (&commonest.maximal (:t *C)))

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&field (:C Col))))

(RULE &panel
  (input *P *Col)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &outside
  (input *P *Col)
  (&bbox.box *B)
  (NOT (inside (:A P) B)))

(RULE &placed
  (&panel *P_inner *Col)
  (&outside (:P *P_grid_in) Col)
  (apply *D (:P P_inner) (:P_out *P_grid_out)))

(RULE &broken
  (&placed *D (:P_grid_out *P1) (:P_grid_in *Q1))
  (&placed D (:P_grid_out *P2) (:P_grid_in *Q2))
  (relative (:Base P1) (:X P2) (:X_rel *V))
  (relative (:Base Q1) (:X Q2) (:X_rel *V2))
  (!= V V2))

(ALTS $choice "how much of the turned marks' arrangement the outside cells keep" $Congruent
  (ALT $Ordered
    (RULE &broken
      (&placed *D (:P_grid_out *P1) (:P_grid_in *Q1))
      (&placed D (:P_grid_out *P2) (:P_grid_in *Q2))
      (dir_elem (:D *Dir))
      (IF ((nearer (:D Dir) (:P P1) (:Q P2)))
          ((NOT (nearer (:D Dir) (:P Q1) (:Q Q2))))
          ((nearer (:D Dir) (:P Q1) (:Q Q2)))))))

(RULE &pose
  (d4_elem *D)
  (NOT (&broken D)))

(RULE &output
  (&panel *P_inner *Col)
  (&pose *D)
  (apply D (:P P_inner) (:P_out *P)))

(OUT (&output ^P ^Col))
