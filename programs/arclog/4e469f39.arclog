;; inputs 30c8ce6b1a8fb5bb0e07cfe1f2224e7a6dca5ef0e45595ee964ad40018760825 programs/solvers/4e469f39.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 4e469f39

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(DET &open_dir DirDomain)

;; Ink objects, each with its own bounding box.
(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(INIT &bbox BoundingBox
  (key ((&objs.component *P (:Id ^O)))
    (cell (P)
      (&objs.component *P (:Id O)))))

(RULE &gap
  (input *P *Col)
  (&bg (:C Col))
  (&bbox.box (:key *O) *B)
  (&open_dir *D)
  (inside (:A P) B)
  (same_dist D (:P1 P) (:P2 B)))

(ALTS $choice "two models of the gapped wall, which the pairs do not separate: every gap sits on a top wall" $Dir
  (ALT $Hole
    (RULE &gap
      (input *P *Col)
      (&bg (:C Col))
      (&bbox.box (:key *O) *B)
      (inside (:A P) B)
      (same_dist *D (:P1 P) (:P2 B)))))

(RULE &arm_dir
  (&gap *O (:D *D2) *P)
  (&bbox.box (:key O) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (perp_dir (:D D2) (:D2 *D))
  (dist_pair (:P P_inner) D *K *K2)
  (> K K2))

;; The fill leaves through the gap and runs along the outside of the wall.
(INIT &spill Ray
  (key ((OR ((&gap ^O *D *P)
             (neighbor P D (:Q *P_out)))
            ((&arm_dir O D))))
    (source ((:P P_out))
      (&gap O *D *P)
      (neighbor P D (:Q *P_out)))
    (node (P)
      (&arm_dir O *D)
      (input *P))
    (dir (D)
      (&arm_dir O *D))))

(RULE &spill_cell
  (&arm_dir (:O *Key))
  (input))

(RULE &paint
  (OR ((input *P *Col)
       (&bg (:C Col))
       (&bbox.box *B)
       (inside (:A P) B))
      ((&spill.ray P)
       (&spill_cell)
       (input P))))

(RULE &output
  (OR ((&paint *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&paint P)))))

(OUT (&output ^P ^Col))
