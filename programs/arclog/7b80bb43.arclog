;; inputs 943785cf21cd2e29165dac4c27c205c6a180621dfd9844a780247208a02609a0 programs/solvers/7b80bb43.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7b80bb43

(INIT &bg_mode_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

;; The pair's dominant color is the background.
(INIT &bg_mode Order
  (member ((:t Col))
    (&bg_mode_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&bg_mode_count.size (:key *Col) *N)))

(RULE &ink
  (input *P *Col)
  (NOT (&bg_mode.maximal (:t Col))))

(RULE &flanked
  (&ink *P)
  (opposite *D (:Opp *D_opp))
  (neighbor P D *Q)
  (&ink (:P Q))
  (neighbor P (:D D_opp) (:Q *Q2))
  (&ink (:P Q2)))

(RULE &chain
  (&ink *P)
  (NOT (&flanked P))
  (diag_dir_elem *D)
  (neighbor P D *Q)
  (&ink (:P Q))
  (NOT (&flanked (:P Q))))

(RULE &cast_blocked
  (&ink *P)
  (NOT (&chain P)))

(RULE &straight
  (&chain *P)
  (opposite *D (:Opp *D_in))
  (neighbor P (:D D_in) *Q)
  (&ink (:P Q)))

(INIT &cast Ray
  (key ((OR ((&straight *P ^D))
            ((dir_elem D))))
    (source (P)
      (&straight *P D))
    (node (P)
      (dir_elem D)
      (input *P)
      (NOT (&cast_blocked P)))
    (dir (D)
      (dir_elem D))))

(INIT &cast_full Ray
  (key ((OR ((&straight *P ^D))
            ((dir_elem D))))
    (source (P)
      (&straight *P D))
    (node (P)
      (dir_elem D)
      (input *P))
    (dir (D)
      (dir_elem D))))

(RULE &cast_stop_full
  (&cast.end (:key (:D *V0)) (:P *E1) (:D *V2) (:Origin *V4))
  (neighbor (:P E1) (:D V2) (:Q *V1))
  (&cast_full.ray (:key (:D V0)) (:P V1) (:D V2) (:K *V3) (:Origin V4)))

(RULE &fill
  (&cast.ray (:key *D) *P *K (:Origin *Src))
  (!= K 0)
  (&cast_stop_full (:V0 D) (:V4 Src))
  (input (:P Src) *Col))

(RULE &cleared
  (&chain *P)
  (NOT (&cast_stop_full (:V4 P))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&fill P *Col))
      ((NOT (&fill P))
       (&cleared P)
       (&bg_mode.maximal (:t Col)))
      ((NOT (&fill P))
       (NOT (&cleared P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
