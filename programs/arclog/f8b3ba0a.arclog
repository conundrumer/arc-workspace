;; inputs 559a2c209ad1ea4d30adadac23d83ccc9e071c0c1f7fe48da92c56bc3429ab9c programs/solvers/f8b3ba0a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; f8b3ba0a

(DET &rank_dir DirDomain)

(RULE &col_dir
  (&rank_dir (:D *D2))
  (opposite (:D D2) (:Opp *D)))

(DET &bg DominantColor)

(INIT &cell_count Cardinality
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (member ((:m P))
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &count_of
  (&cell_count.size (:key *Col) *N))

(ALTS $choice "what is counted for each color" $Cells
  (ALT $Blocks
    (INIT &comps Connectivity
      (node (P)
        (input *P *Col)
        (NOT (&bg (:C Col)))))

    (INIT &block_count Cardinality
      (key ((&comps.component *P *Id)
            (input P ^Col))
        (member ((:m Id))
          (&comps.component *P *Id)
          (input P Col))))

    (RULE &count_of
      (&block_count.size (:key *Col) *N)))
  (ALT $Tiling
    (DET &ink
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col)))
      (ex_output E))

    ;; The frame the non-bg cells span: the grid inside the separator border,
    ;; with each ink cell's place in it.
    (INIT &span BoundingBox
      (key ((&ink ^E *P))
        (cell (P)
          (&ink E *P))))

    (INIT &tile_gap_divisions ExtentDivisions
      (key ((&span.cell (:key ^E) *P)
            (&span.box (:key E) *B)
            (inside (:A P) B)
            (relative (:Base B) (:X P) (:X_rel *P_inner)))
        (frame ((:P P_inner))
          (&span.cell (:key E) *P)
          (&span.box (:key E) *B)
          (inside (:A P) B)
          (relative (:Base B) (:X P) (:X_rel *P_inner)))))

    (DET &border_width
      (&span.box *B)
      (margin B *D *K))

    (RULE &core_cell
      (input *P)
      (&border_width *K)
      (uniform_inset K *B)
      (inside (:A P) B)
      (relative (:Base B) (:X P) (:X_rel *P_inner)))

    (INIT &blocks Connectivity
      (key ((&ink ^E *P))
        (node (P)
          (&ink E *P))))

    (INIT &bbox BoundingBox
      (key ((&blocks.component (:key ^E) *P ^Id))
        (cell (P)
          (&blocks.component (:key E) *P Id))))

    (DET &tile_dim
      (&bbox.cell (:key (:E *Blk_e) (:Id *Blk_id)) *P)
      (&bbox.box (:key (:E Blk_e) (:Id Blk_id)) *B)
      (box_extent B P *A (:N *K)))

    ;; Blocks along an axis: the distinct offsets their boxes sit at.
    (INIT &tile_count Cardinality
      (key ((&bbox.box (:key ^E *Id) *B)
            (dir_elem ^D)
            (margin B D *K))
        (member ((:m K))
          (&bbox.box (:key E *Id) *B)
          (margin B D *K))))

    (DET &tile_gap
      (&tile_gap_divisions.division (:key *E) *A *N *K *G)
      (&tile_count.size (:key E *D) N)
      (axis_of D A)
      (&tile_dim A K))

    (INIT &tiling Division
      (cell ((:P P_inner))
        (input *P *Col)
        (NOT (&bg (:C Col)))
        (&core_cell P *P_inner))
      (side (A K)
        (&tile_dim *A *K))
      (gap (A G)
        (&tile_dim *A *K)
        (&tile_gap *G)))

    (RULE &tile_color
      (input *P *Col)
      (&core_cell P *P_inner)
      (&tiling.tile (:P P_inner) (:P_outer *P_tile)))

    (INIT &tile_count2 Cardinality
      (key ((&tile_color *P_tile ^Col))
        (member ((:m P_tile))
          (&tile_color *P_tile Col))))

    (RULE &count_of
      (&tile_count2.size (:key *Col) *N))))

;; Ranked colors: the max-count color is dominant and drops out; the rest
;; take dense ranks over their counts, fewest first.
(INIT &dominant Order
  (member ((:t (:V Col) (:S N)))
    (&count_of *Col *N))
  (score ((:t (:V Col) (:S N)) (:S N))
    (&count_of *Col *N)))

(RULE &minority_count
  (&count_of *Col *N)
  (NOT (&dominant.maximal (:t (:V Col)))))

(INIT &o Order
  (member ((:t N))
    (&minority_count *N))
  (score ((:t N) (:S N))
    (&minority_count *N)))

(RULE &minority_rank
  (&minority_count *Col *N)
  (&o.rank (:t N) *R))

;; Output frame: 1D axis anchored at &rank_dir, per choice. Placing ascending
;; rank from the opposite edge puts the largest count at the rank_dir edge.
(INIT &col_size Cardinality
  (member ((:m R))
    (&minority_rank *R)))

(INIT &col_frame Frame
  (extent (A N)
    (&col_dir *D)
    (axis_of D *A)
    (&col_size.size *N)))

(RULE &col_pos
  (&col_frame.cell *P)
  (&col_dir *D)
  (margin (:B P) D *K)
  (&minority_rank (:R K)))

(RULE &output
  (&minority_rank *Col (:R *Rk))
  (&col_pos (:K Rk) *P))

(OUT (&output ^P ^Col))
