;; inputs b16ba58b483a5970036a8e846cc80efbb46798ad593f8b2e781429985466f3b8 programs/solvers/46c35fc7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 46c35fc7

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &ring
  (input (:P *P_hole))
  (NOT (&ink (:P P_hole)))
  (ALL ((neighbor (:P P_hole) (:D *Dm) *Q))
       ((&ink (:P Q))))
  (neighbor (:P P_hole) *D (:Q *P))
  (&ink P *Col))

(DET &move_defect
  (&ring *E *P_hole *D *Col)
  (neighbor (:P P_hole) (:D *D_out) (:Q *P_out))
  (ex_output E (:P P_out) (:Col *Col2))
  (!= Col2 Col))

(RULE &turned
  (c4_turn *S (:T *R))
  (apply_dir8 (:D R) (:Dir *D) (:Dir_out *D_out)))

(DET &corner_sense_defect
  (&turned *S *D *D_out)
  (diag_dir_elem D)
  (&move_defect D D_out))

(DET &landed
  (&ring *E *P_hole *D *Col)
  (neighbor (:P P_hole) (:D *D_out) (:Q *P_out))
  (ex_output E (:P P_out) Col))

(DET &move
  (&landed *D *D_out)
  (NOT (&move_defect D D_out)))

(DET &corner_sense
  (&move *D *D_out)
  (diag_dir_elem D)
  (&turned *S D D_out)
  (NOT (&corner_sense_defect S)))

(DET &edge_sense_defect
  (&turned *S *D *D_out)
  (dir_elem D)
  (&move_defect D D_out))

(DET &edge_sense
  (&move *D *D_out)
  (dir_elem D)
  (&turned *S D D_out)
  (NOT (&edge_sense_defect S)))

(RULE &moved
  (OR ((diag_dir_elem *D)
       (&corner_sense *S))
      ((dir_elem D)
       (&edge_sense S)))
  (c4_turn S (:T *R))
  (apply_dir8 (:D R) (:Dir D) (:Dir_out *D_out)))

(ALTS $choice "what the move around each ring is" $Rotate
  (ALT $Cycle
    (DET &cycle_sense SenseDomain)

    (DET &corner_step TileDim)

    (DET &edge_step NumberDomain)

    (INIT &cycle Walk
      (successor ((:p D_from) (:p_next D_to))
        (&cycle_sense *S)
        (turn S *D *D2)
        (diag_dirs (:D *D_diag) (:D1 D) D2)
        (OR ((= *D_from D)
             (= *D_to D_diag))
            ((= D_from D_diag)
             (= D_to D2))))
      (steps (N)
        (OR ((&corner_step (:D *N)))
            ((&edge_step N)))))

    (RULE &moved
      (OR ((diag_dir_elem *D)
           (&corner_step (:D *N)))
          ((dir_elem D)
           (&edge_step N)))
      (&cycle.walk (:p0 D) N (:p *D_out))))
  (ALT $Table
    (RULE &moved
      (&move *D *D_out))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&ring P)))
      ((&ring *P_hole *D Col)
       (&moved D *D_out)
       (neighbor (:P P_hole) (:D D_out) (:Q P)))))

(OUT (&output ^P ^Col))
