;; inputs b3acc703ac0fc7c898466a90ec67feaf374c6a9e7d8c980b84a59318b7e3c411 programs/solvers/7c008303.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7c008303

(DET &bg DominantColor)

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

;; Divider: a line of one non-bg color.
(RULE &frame_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (NOT (&bg (:C Col))))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D *K)
  (&frame_rank.rank (:key D) (:t K) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; Each quadrant's box.
(INIT &tile_box BoundingBox
  (key ((&frame_tile_of *P ^P_tile))
    (cell (P)
      (&frame_tile_of *P P_tile))))

(RULE &tile_extent
  (&tile_box.cell (:key *P_tile) *P)
  (&tile_box.box (:key P_tile) *B)
  (box_extent B P *A *N))

(RULE &quadrant_cell
  (&tile_box.cell (:key *P_tile) *P)
  (input P *Col)
  (&tile_box.box (:key P_tile) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &filled
  (&quadrant_cell *P_tile *Col)
  (NOT (&bg (:C Col))))

(RULE &role
  (&filled (:P_tile *T_key))
  (&filled (:P_tile *T_pat))
  (&tile_extent (:P_tile T_key) *A (:N *N_key))
  (&tile_extent (:P_tile T_pat) A (:N *N_pat))
  (< N_key N_pat))

;; The pattern divided into one block per key cell.
(INIT &blocks Division
  (cell ((:P P_intile))
    (&role *T_pat)
    (&quadrant_cell (:P_tile T_pat) *P_intile))
  (parts (A N)
    (&role *T_key)
    (&tile_extent (:P_tile T_key) *A *N)))

(RULE &output
  (&role *T_key *T_pat)
  (&quadrant_cell (:P_tile T_pat) (:P_intile *P) (:Col *C))
  (OR ((NOT (&bg C))
       (&blocks.tile P (:P_outer *P_block))
       (&quadrant_cell (:P_tile T_key) (:P_intile P_block) *Col))
      ((&bg C)
       (= Col C))))

(OUT (&output ^P ^Col))
