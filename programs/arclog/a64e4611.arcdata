(param &margin number (1))
(param &region_side number (7))

(exclude ($LargestArea $ChannelChain) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($LargestArea $ChannelRect) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($LargestArea $PerpendicularChannels) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($LargestArea $SideEmpty) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($LargestArea $BandEdgeMargin) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($EveryRegion $ClearLine $BandEdgeMargin) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($ChannelChain $StopAtBand $AnyHeading $SideEmpty) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($EveryRegion $ChannelChain $StopAtBand $AnyHeading $BandEdgeMargin) "Arms off every side of every arm, each painted over any color to its piece's far side, cover the pairs' noise: these cases fit no pair.EveryRegion's bands are wide enough to have green beside their margin on the grid edge, and the lanes from that green fill the margin: wherever these cases are defined, they give the output of the OpenEdge copy.")
(exclude ($AnyHeading $BandAnchor $ClearLine $LargestArea $OpenEdge $StopAtBand &background=$Derived) "wherever it is defined, it gives the output of the TiedBands copy")

