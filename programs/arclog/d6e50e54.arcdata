(exclude ($Along $Always $BlockStored $MarkStored $Merge $OffLineUndefined $RestKept $TouchLands $Within &mark_color=$Derived) "Subsumption: wherever it is defined, it gives the output of the OffLineErase copy")

(alts $l
  (alt $NearestLands
    (witness two-within-reach variant concept
      (separates "A 4x4 block with two marks within reach, 2 above and 3 to the right. The concept lands both on the block; $NearestLands lands only the nearer one and stops the other just outside.")
