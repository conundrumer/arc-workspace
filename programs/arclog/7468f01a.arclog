;; inputs fabe298461e56c96166d3d84c72ecbf0e9d1d0ebe46f070fcdf4eef0e4a53db8 programs/solvers/7468f01a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7468f01a

(DET &bg DominantColor)

(DET &transform D4Domain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&ink *P)))

(RULE &output
  (&ink (:P *P2) *Col)
  (&bbox.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P_inner))
  (&transform *D)
  (apply D (:P P_inner) (:P_out *P)))

(OUT (&output ^P ^Col))
