      (output concept undefined)
      (output $BgDefault (grid
        (6 6 5 2 2 2 5 1 1)
        (6 5 5 5 2 5 5 5 1)
        (5 5 5 5 5 5 5 5 5)
        (2 5 5 0 0 0 5 5 3)
        (2 2 5 0 0 0 5 3 3)
        (2 5 5 0 0 0 5 5 3)
        (5 5 5 5 5 5 5 5 5)
        (8 5 5 5 4 5 5 5 9)
        (8 8 5 4 4 4 5 9 9)))
      (output $FillDefault (grid
        (6 6 5 2 2 2 5 1 1)
        (6 5 5 5 2 5 5 5 1)
        (5 5 5 5 5 5 5 5 5)
        (2 5 5 5 5 5 5 5 3)
