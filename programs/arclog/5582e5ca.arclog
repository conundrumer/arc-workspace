;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 5582e5ca

(INIT &tally_count Cardinality
  (key ((input *P ^Col))
    (member ((:m P))
      (input *P Col))))

(INIT &tally Order
  (member ((:t Col))
    (&tally_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&tally_count.size (:key *Col) *N)))

(ALTS $choice "the fill color: two models, data-equivalent on this task since the winning color appears exactly 3 times in every pair" $Mode
  (ALT $Count
    (DET &target ConstInDim)

    (RULE &output
      (input *P)
      (&tally_count.size (:key *Col) *N)
      (&target N))))

(RULE &output
  (input *P)
  (&tally.maximal (:t *Col)))

(OUT (&output ^P ^Col))
