;; inputs 0b6c55ef1c107e7708a7710831950d36b93f3500aa6d830f8ea8fc02af954832 programs/solvers/6773b310.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6773b310

(DET &divide_gap SepThickness)

(DET &divisor ConstOutDim)

(INIT &tile_cell_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (axis_elem *A)
    (&divisor *N))
  (gap (A G)
    (axis_elem *A)
    (&divide_gap *G)))

(DET &marker RarestColor)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(RULE &tile_cell
  (input (:P *P_grid) *Col)
  (&tile_cell_division.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $m "what marks a tile" $Pair
  (ALT $Count
    (DET &pair_count TileCount)

    ;; A count→value table is defeated: the test exhibits a zero-marker tile,
    ;; absent from train.
    (INIT &markers Cardinality
      (key ((OR ((&tile_marker ^P_tile *P_intile))
                ((&tile_cell P_tile))))
        (member ((:m P_intile))
          (&tile_marker P_tile *P_intile))
        (domain ()
          (&tile_cell P_tile))))

    (RULE &output
      (&markers.size (:key (:P_tile *P)) *N)
      (IF ((&pair_count N))
          ((&mark (:C *Col)))
          ((&bg (:C Col)))))))

(ALTS $d "what fixes the tiling" $TileCount
  (ALT $Size
    (DET &tile_size ConstOutDim)

    (INIT &tile_cell_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (axis_elem *A)
        (&tile_size (:N *K)))
      (gap (A G)
        (axis_elem *A)
        (&divide_gap *G)))

    (RULE &tile_cell
      (input (:P *P_grid) *Col)
      (&tile_cell_division2.tile (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))))

(RULE &tile_marker
  (&tile_cell *P_tile *P_intile *Col)
  (&marker (:C Col)))

(RULE &paired
  (&tile_marker *P_tile (:P_intile *P1))
  (&tile_marker P_tile (:P_intile *P2))
  (!= P1 P2))

(RULE &output
  (OR ((&paired (:P_tile *P))
       (&mark (:C *Col)))
      ((&tile_cell (:P_tile P))
       (NOT (&paired (:P_tile P)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
