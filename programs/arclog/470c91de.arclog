;; inputs 905e61acc53478dc8b7b262b8bc79f506623657e02a97b3ccb0954f7755415aa programs/solvers/470c91de.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 470c91de

(DET &bg DominantColor)

(DET &marker ChangedColor)

(INIT &bx BoundingBox
  (key ((input *P ^Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (input *P Col)
      (NOT (&bg (:C Col))))))

(RULE &corner_cell
  (&bx.box (:key *Col) *B)
  (input *P)
  (inside (:A P) B)
  (same_corner *D (:P1 P) (:P2 B)))

(RULE &slide
  (&corner_cell *Col *D *P)
  (input P (:Col *M))
  (&marker (:C M))
  (NOT (&marker (:C Col))))

(ALTS $choice "what names the corner" $Mark
  (ALT $Gap
    ;; The bitten corner. Two bites name no single direction, so `value` drops them.
    (INIT &gap Singleton
      (key ((&corner_cell ^Col *D *P)
            (NOT (&bx.cell (:key Col) P)))
        (member ((:v D))
          (&corner_cell Col *D *P)
          (NOT (&bx.cell (:key Col) P)))))

    (RULE &ragged
      (&bx.box (:key *Col) *B)
      (input *P)
      (inside (:A P) B)
      (NOT (&bx.cell (:key Col) P))
      (NOT (&corner_cell Col P)))

    (RULE &slide
      (&gap.value (:key *Col) (:v *D))
      (NOT (&ragged Col)))))

(RULE &painted
  (&slide *Col *D)
  (&bx.box (:key Col) *B)
  (input (:P *P2))
  (inside (:A P2) B)
  (neighbor (:P P2) D (:Q *P))
  (input P))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P)
       (NOT (&painted P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
