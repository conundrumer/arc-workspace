(exclude ($Components8 $Apart) "The concept case, and every case that draws where the kinds meet. Any other case is undefined there, and the case that draws the rectangles there gives its output wherever it is defined.")
(exclude ($SolidCountsClosed $Apart) "The concept case, and every case that draws where the kinds meet. Any other case is undefined there, and the case that draws the rectangles there gives its output wherever it is defined.")
(exclude ($CrossingSinks $Apart) "The concept case, and every case that draws where the kinds meet. Any other case is undefined there, and the case that draws the rectangles there gives its output wherever it is defined.")
(exclude ($ClosedAgainstDiagonal $Apart) "The concept case, and every case that draws where the kinds meet. Any other case is undefined there, and the case that draws the rectangles there gives its output wherever it is defined.")
(exclude ($ClosedInGrid $Apart) "The concept case, and every case that draws where the kinds meet. Any other case is undefined there, and the case that draws the rectangles there gives its output wherever it is defined.")
