        (3 3 3 3 1 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3 3 3 3 3)))
      (output ($TieFarFromValley $ValleyTieSide $StoredGround) (grid
