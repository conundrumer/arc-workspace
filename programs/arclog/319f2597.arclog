;; inputs bae40a85a26fd6f03d1565ead453ccad24b99a8313f3f2e6dbea5267bec653c0 programs/solvers/319f2597.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 319f2597

;; The mark's color.
(DET &mark RarestColor)

;; The color that resists the cast.
(DET &spare UnchangedColor)

(RULE &cross
  (input (:P *Q) *Col)
  (&mark (:C Col))
  (input *P)
  (axis_elem *A)
  (same_line A P Q))

(RULE &painted
  (&cross *P)
  (input P *Col)
  (NOT (&spare (:C Col))))

(ALTS $choice "what color the cast paints with" $Spread
  (ALT $Paint
    ;; The color the cast lays down.
    (DET &paint RarestColor)

    (RULE &output
      (OR ((&painted *P)
           (&paint (:C *Col)))
          ((input P Col)
           (NOT (&painted P)))))))

(RULE &output
  (OR ((input *P *Col)
       (NOT (&painted P)))
      ((&painted P)
       (&mark (:C Col)))))

(OUT (&output ^P ^Col))
