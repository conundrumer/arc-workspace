;; aaef0977

(param &bg Color (7))
(param &cycle_succ (Color Color)
  (3 4)
  (4 0)
  (0 5)
  (5 2)
  (2 8)
  (8 9)
  (9 6)
  (6 1)
  (1 3))

(alts $choice
  (alt $NearestSeed
    (witness two-seeds variant $NearestSeed
      (relaxed seed)
      (separates "$NearestSeed from the concept: two seeds of different colors at an odd Manhattan distance, so no cell is equidistant from both. The concept needs exactly one seed and is undefined; $NearestSeed rings each cell from its nearer seed.")
      (input (grid
        (7 7 7 7 7 7 7 7)
        (7 3 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7)
        (7 7 7 7 7 5 7 7)
        (7 7 7 7 7 7 7 7)))
      (output concept undefined)
      (output $NearestSeed (grid
        (0 4 0 5 2 8 9 6)
        (4 3 4 0 5 2 8 9)
        (0 4 0 5 2 6 1 3)
        (5 0 5 2 6 9 6 1)
        (2 5 2 6 9 8 9 6)
        (8 2 6 9 8 2 8 9)
        (1 6 9 8 2 5 2 8)
        (3 1 6 9 8 2 8 9))))))

(alts &bg
  (alt &bg=$Derived
    (witness bg=DominantColor borderline &bg=$Derived
      (relaxed field)
      (separates "`bg=DominantColor` from the stored value: the input of `other-field`")
      (input (grid
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 5 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)))
      (output ($OneSeed &bg=$Stored) undefined)
      (output $NearestSeed (grid
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 5 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)
        (3 3 3 3 3 3 3 3)))
      (output &bg=$Derived (grid
        (4 3 1 3 4 0 5 2)
        (3 1 6 1 3 4 0 5)
        (1 6 9 6 1 3 4 0)
        (6 9 8 9 6 1 3 4)
        (9 8 2 8 9 6 1 3)
        (8 2 5 2 8 9 6 1)
        (9 8 2 8 9 6 1 3)
        (6 9 8 9 6 1 3 4))))))
