;; inputs 7f7db93f784e9a722b4fc7d91f3fde76abd6bdca11fbd4c7f846b190da065f70 programs/solvers/780d0b14.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 780d0b14

(DET &bg DominantColor)

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

(RULE &frame_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (&bg (:C Col)))

(RULE &frame_on_divider
  (input *P)
  (&frame_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

;; Divider: a line of bg alone.
(INIT &frame_rank Order
  (key ((OR ((&frame_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&frame_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&frame_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &frame_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&frame_on_divider P A))
  (margin (:B P) D *K)
  (&frame_rank.rank (:key D) (:t K) (:R *N)))

(RULE &frame_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&frame_part_idx *P D (:N *N1))
  (&frame_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &frame_tile_of
  (&frame_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&frame_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

;; The one ink color of each tile.
(INIT &tile_color Singleton
  (key ((&frame_tile_of *P ^P_tile)
        (input P *Col)
        (NOT (&bg (:C Col))))
    (member ((:v Col))
      (&frame_tile_of *P P_tile)
      (input P *Col)
      (NOT (&bg (:C Col))))))

(RULE &output
  (&tile_color.value (:key (:P_tile *P)) (:v *Col)))

(OUT (&output ^P ^Col))
