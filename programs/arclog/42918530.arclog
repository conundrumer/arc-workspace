;; inputs e58e54aafd273d459ad2c7145d79f160e57e43774949aa53ee9259a27ccb70a1 programs/solvers/42918530.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 42918530

(DET &bg DominantColor)

(RULE &inked_line
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (split P *A (:Along *L)))

(RULE &tiling_divider
  (input *P)
  (split P *A (:Along *L))
  (NOT (&inked_line A L)))

(RULE &tiling_on_divider
  (input *P)
  (&tiling_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &tiling_rank Order
  (key ((OR ((&tiling_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&tiling_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&tiling_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &tiling_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&tiling_on_divider P A))
  (margin (:B P) D *K)
  (&tiling_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiling_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiling_part_idx *P D (:N *N1))
  (&tiling_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &tiling_tile_of
  (&tiling_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiling_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(INIT &bbox BoundingBox
  (key ((&tiling_tile_of *P (:P_tile ^T)))
    (cell (P)
      (&tiling_tile_of *P (:P_tile T)))))

(RULE &box_view
  (&tiling_tile_of *P (:P_tile *T))
  (&bbox.box (:key T) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_intile)))

(RULE &box_color
  (&tiling_tile_of *P (:P_tile *T))
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &outline
  (&box_view *P_intile)
  (margin (:B P_intile) *D (:K 0)))

(RULE &ink
  (&box_view *T *P *P_intile)
  (input P *Col)
  (NOT (&bg (:C Col))))

(RULE &design
  (&ink *T *P_intile)
  (NOT (&outline P_intile)))

(RULE &group_design
  (&box_color *T *Col)
  (&design T *P_intile))

(RULE &show
  (OR ((&ink *T *P_intile))
      ((&box_color T *Col)
       (NOT (&design T))
       (&group_design Col P_intile))))

(ALTS $choice "which boxes of a group take the group's design" $Fill
  (ALT $Merge
    (RULE &show
      (OR ((&box_color *T *Col)
           (&group_design Col *P_intile))
          ((&ink T P_intile))))))

(RULE &output
  (OR ((&box_view *T *P *P_intile)
       (OR ((&show T P_intile)
            (&box_color T *Col))
           ((NOT (&show T P_intile))
            (&bg (:C Col)))))
      ((input P)
       (NOT (&tiling_tile_of P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
