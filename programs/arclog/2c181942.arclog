;; inputs bd8c904aae3cd9284956f753821216788a7d9b84520ab975c143afbab665a84d programs/solvers/2c181942.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 2c181942

(DET &bg DominantColor)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &obj_color Singleton
  (key ((&objs.component ^Id *P)
        (input P *Col))
    (member ((:v Col))
      (&objs.component Id *P)
      (input P *Col))))

(RULE &hub
  (&objs.component *Id *P)
  (&obj_color.plural (:key Id)))

(INIT &hub_box BoundingBox
  (cell (P)
    (&hub *P)))

(RULE &bar
  (&hub *P)
  (&hub_box.box *B)
  (inside (:A P) B)
  (same_dist *D (:P1 P) (:P2 B))
  (input P *Col))

(RULE &seat
  (&bar *D (:P *P2))
  (neighbor (:P P2) D (:Q *P)))

(RULE &piece
  (&obj_color.value (:key *Id) (:v *Col))
  (&bar *D Col))

(INIT &bbox BoundingBox
  (key ((&piece ^Id))
    (cell (P)
      (&objs.component Id *P))))

(RULE &side_cell
  (&bbox.cell (:key *Id) *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (same_dist *D (:P1 P) (:P2 B))
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &side_sym Agreement
  (key ((&side_cell ^Id ^D *P_inner))
    (source ((:P P_inner))
      (&side_cell Id D *P_inner))
    (target ((:P P_inner))
      (&side_cell Id D *P_inner))))

(RULE &notch
  (&side_cell *Id *D)
  (axis_of D *A)
  (perp A *A2)
  (axis_inversion (:A A2) (:T *F))
  (NOT (&side_sym.mismatch (:key Id D) (:D F))))

(RULE &dock_cell
  (&piece *Id *D)
  (opposite D (:Opp *D_faced))
  (&notch Id (:D *D_notch))
  (c4_elem (:D *G))
  (apply_dir (:D G) (:Dir D_notch) (:Dir_out D_faced))
  (&side_cell Id (:D D_notch) (:P_inner *P_notch))
  (apply (:D G) (:P P_notch) (:P_out *P_turned_notch))
  (&seat D (:P *P_seat))
  (relative (:Base P_turned_notch) (:X P_seat) (:X_rel *V))
  (&bbox.cell (:key Id) *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (apply (:D G) (:P P_inner) (:P_out *P_turned))
  (compose (:A P_turned) (:B V) (:C *P_grid)))

;; The notch fills the seat: the cells a candidate puts on the seat's line
;; are the seat's.
(INIT &mate Inclusion
  (pattern ((:pattern D) (:m P_seat))
    (&seat *D (:P *P_seat)))
  (observed ((:observed Id G V) (:m P_grid))
    (&dock_cell *Id *G *V *P_grid)
    (&piece Id *D)
    (&seat D (:P *P_seat))
    (same_dist D (:P1 P_grid) (:P2 P_seat))))

(RULE &placed
  (&dock_cell *Id *G *V (:P_grid *P))
  (&piece Id *D)
  (&mate.equal (:observed Id G V) (:pattern D)))

(RULE &paint
  (OR ((&hub *P)
       (input P *Col))
      ((&placed *Id P)
       (&piece Id Col))))

(RULE &output
  (input *P)
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
