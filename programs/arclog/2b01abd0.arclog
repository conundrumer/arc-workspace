;; inputs 71457bed62d6148976ce33a6879d5a9579c407804bb46e6639ad219780ce83b3 programs/solvers/2b01abd0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 2b01abd0

(DET &bg DominantColor)

(DET &line UnchangedColor)

(RULE &line_cell
  (input *P *Col)
  (&line (:C Col)))

(RULE &line_axis
  (&line_cell *P)
  (&line_cell (:P *Q))
  (!= P Q)
  (axis_elem *A)
  (same_line A P Q))

(RULE &line_at
  (&line_cell (:P *F))
  (&line_axis *A)
  (perp A *A2)
  (split (:P F) (:A A2) (:Along *L)))

(RULE &mirror
  (input *P)
  (&line_axis *A)
  (perp A *A2)
  (axis_inversion (:A A2) (:T *F4))
  (&line_at A *L)
  (relative (:Base L) (:X P) (:X_rel *V))
  (apply (:D F4) (:P V) (:P_out *V2))
  (compose (:A L) (:B V2) (:C *Q))
  (input (:P Q)))

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&line (:C Col))))

(RULE &swap
  (&figure *Col)
  (&figure (:Col *Col2))
  (!= Col Col2))

(RULE &ink
  (OR ((&figure *P (:Col *C))
       (&swap (:Col C) (:Col2 *Col)))
      ((&figure (:P *P2) Col)
       (&mirror (:P P2) (:Q P)))))

(RULE &output
  (OR ((&ink *P *Col))
      ((input P Col)
       (NOT (&ink P)))))

(OUT (&output ^P ^Col))
