;; inputs e91c11338b1c2be34275539c3b1452407027904720526bd823ef1bcd7ff45138 programs/solvers/3de23699.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3de23699

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (key ((&ink *P ^Col))
    (cell (P)
      (&ink *P Col))))

(RULE &hole
  (&bbox.box (:key *Col) *B)
  (input *P)
  (interior (:A P) B))

(RULE &escapes
  (&ink *Col)
  (&ink *P (:Col *Col2))
  (NOT (&hole Col P)))

(RULE &mark
  (&ink *Col)
  (&ink (:Col *Col2))
  (!= Col Col2)
  (NOT (&escapes Col Col2)))

;; The box the output crops to.
(INIT &hole_bbox BoundingBox
  (cell (P)
    (&mark *Col)
    (&hole Col *P)))

(RULE &output
  (&mark (:Col *Col2))
  (&hole (:Col Col2) (:P *P2))
  (&hole_bbox.box *B)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P))
  (OR ((NOT (&ink (:P P2)))
       (&bg (:C *Col)))
      ((&ink (:P P2))
       (= Col Col2))))

(OUT (&output ^P ^Col))
