;; inputs a3021fc1d4df6bd8d7c3ac693e1c37b995e158791a12f72a5343238e0a7fee74 programs/solvers/6b9890af.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 6b9890af

(DET &bg DominantColor)

(DET &frame SharedColor)

(RULE &frame_col
  (&frame (:C *Col)))

(ALTS $choice "how the frame color is found" $Stored
  (ALT $Drawn
    (INIT &drect Outlines
      (key ((input *P ^Col)
            (NOT (&bg (:C Col))))
        (node (P)
          (input *P Col)
          (NOT (&bg (:C Col))))))

    (RULE &frame_col
      (&drect.box (:key *Col)))))

(INIT &frame_box BoundingBox
  (cell (P)
    (&frame_col *Col)
    (input *P Col)))

;; The cells the frame's edge lines enclose.
(INIT &hole BoundingBox
  (cell (P)
    (&frame_box.box *B)
    (input *P)
    (interior (:A P) B)))

(RULE &object_cell
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (NOT (&frame_col Col)))

(INIT &object_box BoundingBox
  (cell (P)
    (&object_cell *P)))

(RULE &tile_col
  (&object_cell (:P *P_grid) *Col)
  (&object_box.box *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_tile)))

(RULE &blocks_dim
  (&object_box.cell *P)
  (&object_box.box *B)
  (box_extent B P *A *N))

;; The hole divided into the object's block arrangement.
(INIT &blocks Division
  (cell ((:P P_hole))
    (&blocks_dim)
    (&hole.cell *P)
    (&hole.box *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_hole)))
  (parts (A N)
    (&blocks_dim *A *N)))

(RULE &output
  (&frame_box.box *B)
  (input (:P *P_grid))
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P))
  (OR ((inside (:A P_grid) B)
       (same_dist (:P1 P_grid) (:P2 B))
       (&frame_col *Col))
      ((&hole.box (:B *B_hole))
       (inside (:A P_grid) (:B B_hole))
       (relative (:Base B_hole) (:X P_grid) (:X_rel *P_hole))
       (&blocks.tile (:P P_hole) (:P_outer *P_tile))
       (OR ((&tile_col P_tile Col))
           ((NOT (&tile_col P_tile))
            (&bg (:C Col)))))))

(OUT (&output ^P ^Col))
