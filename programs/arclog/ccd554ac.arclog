(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(RULE &output
  (&output_tiling.cell (:P_inner *P_intile) *P)
  (input (:P P_intile) *Col))

(OUT (&output ^P ^Col))
