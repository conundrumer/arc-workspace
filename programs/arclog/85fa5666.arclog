;; inputs bff20398b9aae22eb7a75fc20ece3d4e8e8dcfd775b9c033fe84ad5a8b387354 programs/solvers/85fa5666.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 85fa5666

(DET &square UnchangedColor)

(INIT &sq Connectivity
  (node (P)
    (input *P *Col)
    (&square (:C Col))))

(INIT &bbox BoundingBox
  (key ((&sq.component *P ^Id))
    (cell (P)
      (&sq.component *P Id))))

(RULE &seat
  (&sq.component (:P *P2) *Id)
  (&bbox.box (:key Id) *B)
  (inside (:A P2) B)
  (same_corner *D (:P1 P2) (:P2 B))
  (neighbor (:P P2) D (:Q *P)))

(INIT &ray_frame Frame
  (key ((&seat ^D (:P *Q))
        (frame_extent (:P Q) *A *N))
    (extent (A N)
      (&seat D (:P *Q))
      (frame_extent (:P Q) *A *N))))

(DET &bg DominantColor)

(DET &turn D4Domain)

(RULE &source
  (&turn (:D *R))
  (apply_diag_dir (:D R) (:Dir *D_from) (:Dir_out *D_to)))

;; Each seat casts outward along its own corner's diagonal: the key is the
;; cast direction.
(INIT &ray Ray
  (key ((OR ((&seat ^D (:P *Q)))
            ((diag_dir_elem D))
            ((&ray_frame.cell (:key D) *P))))
    (source ((:P Q))
      (&seat D (:P *Q)))
    (node (P)
      (&ray_frame.cell (:key D) *P))
    (dir (D)
      (diag_dir_elem D))))

(ALTS $choice "which corner a mark moves to" $Turn
  (ALT $Table
    (DET &corner_from
      (&seat *E *Id (:D *D_to) (:P *Q))
      (ex_output E (:P Q) *Col)
      (&seat E Id (:D *D_from) (:P *Q_from))
      (ex_input E (:P Q_from) Col))

    (RULE &source
      (&corner_from *D_to *D_from))))

(RULE &lit
  (&ray.ray (:key *D) *P D (:Origin *Q))
  (input P)
  (diag_dir_elem D)
  (&seat *Id D (:P Q))
  (&source (:D_to D) *D_from)
  (&seat Id (:D D_from) (:P *Q_from))
  (input (:P Q_from) *Col))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&lit P *Col))
      ((&square (:C Col_in))
       (= Col Col_in))
      ((NOT (&lit P))
       (NOT (&square (:C Col_in)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
