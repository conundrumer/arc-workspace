        (7 7 7 5 7 2 7 5 7 2 7))))))

(alts $mk
  (alt $MarkerColor
    (witness marker-color variant $MarkerColor
      (relaxed center-markers)
      (relaxed one-source)
      (separates "the markers are 5 while the dividers stay 0: the stored marker color 5 stamps the copies; the concept takes each 5-marked tile for a source and is undefined")
      (assign &marker_color (5))
      (input (grid
