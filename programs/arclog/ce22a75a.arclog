;; inputs 44b2cacf996f64dbde66e5ea830ad77211c2870b44ede88f2cb2d33eb82e0658 programs/solvers/ce22a75a.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; ce22a75a

(DET &tile_count TileCount)

(INIT &decomp_division Division
  (cell ((:P P_grid))
    (input (:P *P_grid)))
  (parts (A N)
    (axis_elem *A)
    (&tile_count *N)))

(DET &bg DominantColor)

(DET &out_fill AnyOutNewColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &decomp
  (&decomp_division.tile *P (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $choice "every mark sits at the center of its arrangement tile, so three locate priors coincide on the data" $Tile
  (ALT $Tile
    (ALTS $d "the grid is 9×9, so its arrangement reads two ways" $Count
      (ALT $Size
        (DET &tile_dim TileCount)
        (INIT &decomp_division2 Division
          (cell ((:P P_grid))
            (input (:P *P_grid)))
          (side (A K)
            (axis_elem *A)
            (&tile_dim (:N *K))))
        (RULE &decomp
          (&decomp_division2.tile *P (:P_outer *P_tile) (:P_inner *P_intile))))))
  (ALT $Center
    (RULE &center_tile
      (&mark (:P *P_grid))
      (&decomp (:P P_grid) *P_tile *P_intile)
      (centered (:P P_intile)))

    (RULE &output
      (&decomp *P *P_tile)
      (IF ((&center_tile P_tile))
          ((&out_fill (:C *Col)))
          ((&bg (:C Col))))))
  (ALT $Grow
    (RULE &grown
      (OR ((&mark *P))
          ((&mark (:P *M))
           (neighbor (:P M) *D (:Q P))
           (input P))))

    (RULE &output
      (OR ((&grown *P)
           (&out_fill (:C *Col)))
          ((input P)
           (NOT (&grown P))
           (&bg (:C Col)))))))

(RULE &mark_tile
  (&mark (:P *P_grid))
  (&decomp (:P P_grid) *P_tile))

(RULE &output
  (&decomp *P *P_tile)
  (IF ((&mark_tile P_tile))
      ((&out_fill (:C *Col)))
      ((&bg (:C Col)))))

(OUT (&output ^P ^Col))
