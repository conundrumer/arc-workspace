;; inputs 16294d8a46179eb7e829afb51df0adc56a670946646370dde938fc59cf5dc402 programs/solvers/dbc1a6ce.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; dbc1a6ce

(DET &bg DominantColor)

(INIT &spans Ray
  (source ((:P Q))
    (input (:P *Q) *Col)
    (NOT (&bg (:C Col))))
  (node (P)
    (input *P))
  (dir (D)
    (axis_elem *A)
    (axis4_of *D A)))

(RULE &spans_between
  (input *P (:Col *Bg))
  (&bg (:C Bg))
  (axis_elem *A)
  (axis4_of *D A)
  (dir8_opposite D (:D2 *O))
  (&spans.ray P D)
  (&spans.ray P (:D O)))

(DET &fill AnyOutNewColor)

(RULE &output
  (OR ((&spans_between *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&spans_between P)))))

(OUT (&output ^P ^Col))
