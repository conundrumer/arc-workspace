;; inputs 41ca89efcdad44ba675448f02591ea3393572164659ec75787482219e542226f programs/solvers/7fe24cdd.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7fe24cdd

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (key ((OR ((&tile_d4 (:Pt *P_tile) (:T ^D)))
            ((input (:P *P_in))
             (&tile_d4 (:T D))
             (apply D (:P P_in) (:P_out *P_intile)))))
    (outer ((:P P_tile))
      (&tile_d4 (:Pt *P_tile) (:T D)))
    (inner ((:P P_intile))
      (input (:P *P_in))
      (&tile_d4 (:T D))
      (apply D (:P P_in) (:P_out *P_intile)))))

(ALTS $choice "how each tile's rotation is set" $Table
  (ALT $Spin
    (DET &side
      (ex_input *E *P)
      (frame_extent P *A (:N *K)))

    (INIT &tile_cell_division Division
      (key ((&side ^E ^K))
        (cell ((:P P_grid))
          (ex_output E (:P *P_grid)))
        (side (A K)
          (axis_elem *A))))

    (DET &tile_cell
      (ex_output *E (:P *P_grid) *Col)
      (&tile_cell_division.tile (:key E) (:P P_grid) (:P_outer *P_tile) (:P_inner *P_intile)))

    (DET &turned
      (&tile_cell *E *P_tile (:P_intile *P) *Col)
      (NOT (ex_input E P Col)))

    (DET &shown
      (&tile_cell *E *P_tile)
      (NOT (&turned E P_tile)))

    (DET &missed
      (&shown *P_tile)
      (ex_output *E)
      (NOT (&shown E P_tile)))

    (DET &anchor
      (&shown (:P_tile *P))
      (NOT (&missed (:P_tile P))))

    (INIT &output_tiling2 Tiling
      (key ((c4_elem (:D ^R)))
        (outer ((:P P_tile))
          (&anchor (:P *P_anchor))
          (apply (:D R) (:P P_anchor) (:P_out *P_tile)))
        (inner ((:P P_intile))
          (input (:P *P_in))
          (apply (:D R) (:P P_in) (:P_out *P_intile)))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&output_tiling2.cell (:key *R) (:P_inner *P_intile) *P)
      (apply (:D R) (:P P_in) (:P_out P_intile)))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:key D) (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
