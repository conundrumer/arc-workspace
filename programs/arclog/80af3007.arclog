;; inputs df84d388f0edef69ffb21e7ec597c17769b94a055d10b576cad369e2bcfd95ce programs/solvers/80af3007.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 80af3007

(DET &ink RarestColor)

;; The picture: the box the ink occupies.
(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (&ink (:C Col))))

;; A pixel's side, in cells.
(DET &scale TileCount)

(INIT &pixel_cell_division Division
  (cell ((:P P_inner))
    (input *P)
    (&bbox.box *B)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_inner)))
  (side (A K)
    (axis_elem *A)
    (&scale (:N *K))))

(RULE &pixel_cell
  (input *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&pixel_cell_division.tile (:P P_inner) (:P_outer *P_tile)))

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (&pixel_cell *P_tile))
  (inner ((:P P_intile))
    (&pixel_cell (:P_tile *P_intile))))

(DET &bg DominantColor)

(RULE &inked
  (&pixel_cell *P *P_tile)
  (input P *Col)
  (&ink (:C Col)))

(RULE &stamp
  (&cell_tiling.cell *P (:P_outer *P_tile) (:P_inner *P_intile))
  (&inked P_tile)
  (&inked (:P_tile P_intile)))

(RULE &output
  (&cell_tiling.cell *P)
  (IF ((&stamp P))
      ((&ink (:C *Col)))
      ((&bg (:C Col)))))

(OUT (&output ^P ^Col))
