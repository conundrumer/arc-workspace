;; inputs 8ddbf85d2e1523834c932a22a9fbef3376c764d58377fe61ab205a4b0a7caf11 programs/solvers/539a4f51.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 539a4f51

(DET &scale ScaleRatio)

(INIT &tiles Frame
  (extent (A N)
    (axis_elem *A)
    (&scale (:K *N))))

(INIT &frame_cell_tiling Tiling
  (outer ((:P P_tile))
    (&tiles.cell (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg ChangedColor)

(DET &corner DiagDirDomain)

(RULE &frame_cell
  (&frame_cell_tiling.cell (:P *P_grid)))

(ALTS $choice "two models of the output frame" $Scale
  (ALT $Canvas
    (DET &out_dim ConstOutDim)

    (INIT &canvas Frame
      (extent (A N)
        (axis_elem *A)
        (&out_dim *N)))

    (RULE &frame_cell
      (&canvas.cell (:P *P_grid)))))

(RULE &cell
  (OR ((input *P))
      ((&frame_cell (:P_grid P)))))

(RULE &shell
  (&cell *P)
  (&corner (:D *Diag))
  (diag_dist P Diag (:K1 *K) *K2)
  (<= K2 K))

(RULE &shell_color
  (input *P *Col)
  (&shell P *K)
  (NOT (&bg (:C Col))))

;; The shown shells close into a cycle, and an output shell index walks that
;; many steps around it from the corner shell.
(INIT &cyc Order
  (member ((:t K))
    (&shell_color *K))
  (score ((:t K) (:S K))
    (&shell_color *K)))

(INIT &wrap Walk
  (successor ((:p K) (:p_next K2))
    (&cyc.cyclic_successor (:a *K) (:b *K2)))
  (steps ((:N K))
    (&shell *K)))

(RULE &output
  (&frame_cell (:P_grid *P))
  (&shell P *K)
  (&wrap.walk (:p0 0) (:N K) (:p *K2))
  (&shell_color (:K K2) *Col))

(OUT (&output ^P ^Col))
