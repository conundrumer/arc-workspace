;; inputs 0b1d52e51f4e3bc6e4e4b807abe064a295aec6415d23606ee3d3a74648630de5 programs/solvers/c59eb873.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c59eb873

(DET &scale ScaleRatio)

(INIT &intile_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&scale (:K *N))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&intile_frame.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&output_tiling.cell (:P_outer P_tile) *P))

(OUT (&output ^P ^Col))
