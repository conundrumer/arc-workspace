(param &background Color (8))

(alts $color
  (alt $InnermostColor
    (witness wide-core variant $InnermostColor
      (separates "The object's core color 1 has more cells than its outline color 3. The cases that count paint the halo 3; the $InnermostColor cases paint it 1.")
      (input (grid
        (8 8 8 8 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8)
        (8 3 1 1 1 1 1 3 8)
        (8 3 1 1 1 1 1 3 8)
        (8 3 1 1 1 1 1 3 8)
        (8 3 1 1 1 1 1 3 8)
        (8 3 1 1 1 1 1 3 8)
        (8 3 3 3 3 3 3 3 8)
        (8 8 8 8 8 8 8 8 8)))
      (output $RareColor (grid
        (8 3 3 3 3 3 3 3 8)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (3 8 8 8 8 8 8 8 3)
        (8 3 3 3 3 3 3 3 8)))
      (output $InnermostColor (grid
        (8 1 1 1 1 1 1 1 8)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (1 8 8 8 8 8 8 8 1)
        (8 1 1 1 1 1 1 1 8))))))

(alts $bg
  (alt $RarestWithBackground
    (witness bg-rarest borderline concept
      (separates "The background 8 has fewer cells than each color of the object. The $RarestWithBackground cases pick 8 and paint no halo; the background=DominantColor copies read 3 as the background; the other cases paint the halo 1.")
      (input (grid
        (8 8 3 3 3)
        (8 3 3 3 3)
        (3 3 1 1 3)
        (3 3 1 1 3)
        (3 3 3 3 3)))
      (output ($ObjectCount &background=$Stored) ($InnermostColor &background=$Stored) (grid
        (8 1 8 8 8)
        (1 8 8 8 8)
        (8 8 8 8 8)
        (8 8 8 8 8)
        (8 8 8 8 8)))
      (output ($InnermostColor $AllCells &background=$Derived) undefined)
      (output ($Conn4 &background=$Derived) (grid
        (3 3 8 3 3)
        (3 8 1 1 3)
        (8 1 3 3 1)
        (3 1 3 3 1)
        (3 3 1 1 3)))
      (output ($ObjectCount $AllCells &background=$Derived) (grid
        (3 3 8 3 3)
        (3 8 8 8 3)
        (8 8 3 3 8)
        (3 8 3 3 8)
        (3 3 8 8 3)))
      (output $RarestWithBackground (grid
        (8 8 8 8 8)
        (8 8 8 8 8)
        (8 8 8 8 8)
        (8 8 8 8 8)
        (8 8 8 8 8))))))

(alts $region
  (alt $ExteriorHalo
    (witness ring-hole variant concept
      (separates "The object encloses one background cell. The $Touching cases paint it 1, since it touches the object; the $ExteriorHalo cases leave it 8, since it does not reach the grid edge.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8 8 8 8 8)
        (8 3 1 3 3 3 3 3 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8 8 8 8 8)
        (8 3 3 3 8 3 3 3 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8 8 8 8 8)
        (8 3 3 3 3 3 3 3 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $Touching (grid
        (8 1 1 1 1 1 1 1 8 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 1 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (8 1 1 1 1 1 1 1 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output $ExteriorHalo (grid
        (8 1 1 1 1 1 1 1 8 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (1 8 8 8 8 8 8 8 1 8 8 8 8)
        (8 1 1 1 1 1 1 1 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $scope
  (alt $PerObject
    (witness two-objects variant $PerObject
      (relaxed one-object)
      (separates "Two separate objects each hold a core color. The cases that count over all cells paint both halos 1, the rarest color over both objects; the $PerObject cases paint each halo with its own object's core color, 1 and 2; $InnermostColor over all cells finds 1 and 2 at one level and is undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 3 3 3 8 8 8 4 4 4 4 4 8 8)
        (8 3 1 3 8 8 8 4 4 2 4 4 8 8)
        (8 3 3 3 8 8 8 4 4 2 4 4 8 8)
        (8 8 8 8 8 8 8 4 4 4 4 4 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output ($RareColor $AllCells) (grid
        (8 1 1 1 8 8 8 1 1 1 1 1 8 8)
        (1 8 8 8 1 8 1 8 8 8 8 8 1 8)
        (1 8 8 8 1 8 1 8 8 8 8 8 1 8)
        (1 8 8 8 1 8 1 8 8 8 8 8 1 8)
        (8 1 1 1 8 8 1 8 8 8 8 8 1 8)
        (8 8 8 8 8 8 8 1 1 1 1 1 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)))
      (output ($InnermostColor $AllCells) undefined)
      (output $PerObject (grid
        (8 1 1 1 8 8 8 2 2 2 2 2 8 8)
        (1 8 8 8 1 8 2 8 8 8 8 8 2 8)
        (1 8 8 8 1 8 2 8 8 8 8 8 2 8)
        (1 8 8 8 1 8 2 8 8 8 8 8 2 8)
        (8 1 1 1 8 8 2 8 8 8 8 8 2 8)
        (8 8 8 8 8 8 8 2 2 2 2 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 8 8 8))))))

(alts $conn
  (alt $PerObject8
    (witness corner-touch variant $PerObject
      (relaxed one-object)
      (separates "Two pieces touch at one corner. Taken as two 4-connected objects, each has rarest color 1, and $Conn4 paints every halo 1; taken as one 8-connected object, the rarest color is 2, and $PerObject8 paints every halo 2, as the cases that count over all cells do. The $InnermostColor cases find two colors at one level and are undefined.")
      (input (grid
        (8 8 8 8 8 8 8 8 8 8 8 8)
        (8 3 3 3 3 3 8 8 8 8 8 8)
        (8 3 1 2 2 3 8 8 8 8 8 8)
        (8 3 3 3 3 3 8 8 8 8 8 8)
        (8 8 8 8 8 8 4 4 4 4 4 8)
        (8 8 8 8 8 8 4 1 1 4 4 8)
        (8 8 8 8 8 8 4 4 4 4 4 8)
        (8 8 8 8 8 8 8 8 8 8 8 8)))
      (output ($RareColor $AllCells) ($RareColor $PerObject8) (grid
        (8 2 2 2 2 2 8 8 8 8 8 8)
        (2 8 8 8 8 8 2 8 8 8 8 8)
        (2 8 8 8 8 8 2 8 8 8 8 8)
        (2 8 8 8 8 8 2 2 2 2 2 8)
        (8 2 2 2 2 2 8 8 8 8 8 2)
        (8 8 8 8 8 2 8 8 8 8 8 2)
        (8 8 8 8 8 2 8 8 8 8 8 2)
        (8 8 8 8 8 8 2 2 2 2 2 8)))
      (output $InnermostColor undefined)
      (output ($ObjectCount $Conn4) (grid
        (8 1 1 1 1 1 8 8 8 8 8 8)
        (1 8 8 8 8 8 1 8 8 8 8 8)
        (1 8 8 8 8 8 1 8 8 8 8 8)
        (1 8 8 8 8 8 1 1 1 1 1 8)
        (8 1 1 1 1 1 8 8 8 8 8 1)
        (8 8 8 8 8 1 8 8 8 8 8 1)
        (8 8 8 8 8 1 8 8 8 8 8 1)
        (8 8 8 8 8 8 1 1 1 1 1 8))))))

