;; inputs 863929cf103a71e4c3a07457bb4c87a5d7fa3d56cfc88e40b97a3649a6a201b3 programs/solvers/cf98881b.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; cf98881b

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(DET &divisor SepTileCount)

(INIT &cand_division Division
  (cell ((:P P_grid_in))
    (ex_input (:P *P_grid_in)))
  (parts (A N)
    (&divide_axis *A)
    (&divisor *N))
  (gap (A G)
    (&divide_axis *A)
    (&divide_gap (:K *G))))

(DET &frame_dim ConstOutDim)

(INIT &frame_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&frame_dim *N)))

(DET &bg DominantColor)

(DET &arr_dim SepTileCountAxis)

(DET &gap DivisorRatio)

(INIT &tile_decompose_outer Frame
  (extent (A N)
    (&arr_dim *A *N)))

(INIT &tile_decompose_inner Frame
  (extent (A N)
    (axis_elem *A)
    (&frame_dim *N)))

(INIT &tile_decompose_tiling Tiling
  (outer (P)
    (&tile_decompose_outer.cell *P))
  (inner (P)
    (&tile_decompose_inner.cell *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &stack_dir DirDomain)

(RULE &decompose
  (&tile_decompose_tiling.cell *P *P_outer *P_inner))

(DET &cand
  (ex_input *E (:P *P_grid_in) *Col)
  (NOT (&bg (:C Col)))
  (&cand_division.tile (:P P_grid_in) (:P_outer *P_tile) (:P_inner *O)))

(DET &beats
  (&cand *E *O *P_tile *Col)
  (&cand E O (:P_tile *P_tile2) (:Col *Col2))
  (!= Col Col2)
  (ex_output E (:P O) Col))

(INIT &order Order
  (member ((:t T))
    (&cand (:P_tile *T)))
  (before ((:a T) (:b T2))
    (&beats (:P_tile *T) (:P_tile2 *T2))))

(DET &pane_rank
  (&order.rank (:t *P_tile) *R))

(ALTS $d "decompose" $Table
  (ALT $Count
    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&frame_dim (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(ALTS $b "priority" $Spatial
  (ALT $Palette
    (DET &ink_rank
      (&cand (:P_tile *T) (:Col *C))
      (&pane_rank (:P_tile T) *R))

    ;; The top-priority color competing at the cell.
    (INIT &front_ink Order
      (key ((&cand2 ^O *Col)
            (&ink_rank (:C Col) *R))
        (member ((:t (:V Col) (:S R)))
          (&cand2 O *Col)
          (&ink_rank (:C Col) *R))
        (score ((:t (:V Col) (:S R)) (:S R))
          (&cand2 O *Col)
          (&ink_rank (:C Col) *R))))

    (RULE &output
      (OR ((&front_ink.minimal (:key (:O *P)) (:t (:V *Col))))
          ((&frame_frame.cell P)
           (&bg (:C Col))
           (NOT (&cand2 (:O P)))))))
  (ALT $Stack
    ;; The top-priority pane competing at the cell.
    (INIT &front_pane Order
      (key ((&cand2 ^O (:P_tile *T))
            (&pane_rank (:P_tile T) *R))
        (member ((:t (:V T) (:S R)))
          (&cand2 O (:P_tile *T))
          (&pane_rank (:P_tile T) *R))
        (score ((:t (:V T) (:S R)) (:S R))
          (&cand2 O (:P_tile *T))
          (&pane_rank (:P_tile T) *R))))

    (RULE &output
      (OR ((&front_pane.minimal (:key (:O *P)) (:t (:V *T)))
           (&cand2 (:O P) (:P_tile T) *Col))
          ((&frame_frame.cell P)
           (&bg (:C Col))
           (NOT (&cand2 (:O P))))))))

(RULE &cand2
  (input (:P *P_grid_in) *Col)
  (NOT (&bg (:C Col)))
  (&decompose (:P P_grid_in) (:P_outer *P_tile) (:P_inner *O)))

;; The competing pane nearest the stack edge.
(INIT &nearest_pane Order
  (key ((&cand2 ^O (:P_tile *T))
        (&stack_dir *D)
        (margin (:B T) D *K))
    (member ((:t (:V T) (:S K)))
      (&cand2 O (:P_tile *T))
      (&stack_dir *D)
      (margin (:B T) D *K))
    (score ((:t (:V T) (:S K)) (:S K))
      (&cand2 O (:P_tile *T))
      (&stack_dir *D)
      (margin (:B T) D *K))))

(RULE &output
  (OR ((&frame_frame.cell *P)
       (&bg (:C *Col))
       (NOT (&cand2 (:O P))))
      ((&nearest_pane.minimal (:key (:O P)) (:t (:V *T)))
       (&cand2 (:O P) (:P_tile T) Col))))

(OUT (&output ^P ^Col))
