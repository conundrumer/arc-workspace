(param &noise_color Color (6))

(alts $n
  (alt $NoiseByPeriod
    (witness noise-of-another-color variant $NoiseByPeriod
      (relaxed noise-overwrites)
      (separates "the scattered noise is 5, not 6: the stored noise color finds no noise, no period shorter than the grid fits, and the input comes back unchanged; deriving the noise color as the one whose removal leaves a repeating pattern finds 5 and wipes it")
