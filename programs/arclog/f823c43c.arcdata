        (3 6 1 3 6 1)
        (3 1 1 3 1 1)
        (3 3 3 3 3 3)
        (3 6 1 3 6 1)
        (3 1 1 3 1 1)))
      (output $HiddenPhaseTakesDominant (grid
        (3 3 3 3 3 3)
        (3 3 1 3 3 1)
        (3 1 1 3 1 1)
        (3 3 3 3 3 3)
        (3 3 1 3 3 1)
        (3 1 1 3 1 1)))
      (output $IsometryOrbit (grid
