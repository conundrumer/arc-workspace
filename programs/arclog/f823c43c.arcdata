        (7 7 7 7 7 7 7 7 7 7 7 7)
        (7 7 7 7 7 7 7 7 7 7 7 7)
        (7 8 7 7 8 7 7 8 7 7 8 7)
        (7 7 7 7 7 7 7 7 7 7 7 7)))
      (output $IsometryOrbit undefined))))

(alts $h
  (alt $HiddenPhaseKeepsNoise
    (witness tile-place-all-hidden borderline $IsometryOrbit
      (relaxed phase-visible)
      (separates "every copy of the top-left cell of the 2 by 2 block is noise while the other cells still fix the 3 by 3 tile: the concept is undefined, one branch keeps the noise there, one fills the background, and the mirror symmetry the visible cells show fills the block")
      (input (grid
        (3 3 3 6 3 3)
        (3 6 1 3 6 1)
        (3 1 1 3 1 1)
        (3 3 3 3 3 3)
        (3 6 1 3 6 1)
        (3 1 6 3 1 1)))
      (output $HiddenUndefined undefined)
      (output $HiddenPhaseKeepsNoise (grid
