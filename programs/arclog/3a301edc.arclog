;; inputs 4bfee9acfa62bb87d5c278f266b2cfd952daae18d4ea73cdb419e22c4cecf40b programs/solvers/3a301edc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 3a301edc

(DET &bg DominantColor)

(RULE &fig
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &fig_box BoundingBox
  (cell (P)
    (&fig *P)))

(RULE &rect_color
  (&fig *P)
  (&fig_box.box *B)
  (inside (:A P) B)
  (same_dist (:P1 P) (:P2 B))
  (input P *Col))

(RULE &blk_color
  (&fig *P)
  (input P *Col)
  (NOT (&rect_color Col)))

(INIT &blk_box BoundingBox
  (cell (P)
    (input *P *Col)
    (&blk_color Col)))

(RULE &thick_axis
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&blk_box.box (:B *B4))
  (&blk_box.cell *P)
  (box_extent (:B B4) P (:A *A4) *N)
  (axis_of D (:A A4))
  (&blk_box.box (:B *B2))
  (&blk_box.cell (:P *P2))
  (box_extent (:B B2) (:P P2) (:A *A2) (:N *N2))
  (axis_of (:D D2) (:A A2))
  (axis_inset D (:K1 N) (:K2 N2) *B))

(RULE &thick
  (&thick_axis *A (:B *B1))
  (perp A *A2)
  (&thick_axis (:A A2) (:B *B2))
  (compose (:A B1) (:B B2) (:C *B)))

(RULE &fig_cover
  (&fig_box.box *B)
  (input *P)
  (inside (:A P) B))

(RULE &ring_box
  (&fig_box.box (:B *B_fig))
  (&thick (:B *B_thick))
  (relative (:Base B_thick) (:X B_fig) (:X_rel *B)))

(RULE &ring_cover
  (input *P)
  (&ring_box *B)
  (inside (:A P) B))

(RULE &ring
  (&ring_cover *P)
  (NOT (&fig_cover P)))

(ALTS $wrap "What the ring goes around." $Box
  (ALT $Cells
    (RULE &ring
      (&ring_cover *P)
      (NOT (&fig P)))))

(ALTS $render "What the output shows." $Outset
  (ALT $Nest
    (RULE &blk_cover
      (&blk_box.box *B)
      (input *P)
      (inside (:A P) B))

    (RULE &output
      (OR ((&fig_cover *P)
           (IF ((&blk_cover P))
               ((&blk_color *Col))
               ((&rect_color Col))))
          ((input P)
           (NOT (&fig_cover P))
           (IF ((&ring P))
               ((&blk_color Col))
               ((&bg (:C Col)))))))))

(RULE &output
  (OR ((&ring *P)
       (&blk_color *Col))
      ((input P Col)
       (NOT (&ring P)))))

(OUT (&output ^P ^Col))
