;; inputs 608d262e6c82b38eb3b48c0874f748edda69c0e84404a49193f237e8524a1a14 programs/solvers/c48954c1.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c48954c1

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (key ((OR ((&tile_d4 (:Pt *P_tile) (:T ^D)))
            ((input (:P *P_in))
             (&tile_d4 (:T D))
             (apply D (:P P_in) (:P_out *P_intile)))))
    (outer ((:P P_tile))
      (&tile_d4 (:Pt *P_tile) (:T D)))
    (inner ((:P P_intile))
      (input (:P *P_in))
      (&tile_d4 (:T D))
      (apply D (:P P_in) (:P_out *P_intile)))))

(DET &arr_dim ConstInDim)

(INIT &arr_pos_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&arr_dim *N)))

(ALTS $choice "how each tile's content is derived" $Lookup
  (ALT $Mirror
    (RULE &axis_centered
      (&arr_pos_frame.cell (:P *P_tile))
      (axis_of *D *A)
      (dist_pair (:P P_tile) D *K (:K2 K)))

    (RULE &mirror
      (input *P)
      (&arr_pos_frame.cell (:P *P_tile))
      (axis_elem *A)
      (OR ((NOT (&axis_centered P_tile A))
           (axis_inversion A (:T *F))
           (apply (:D F) P (:P_out *P_img)))
          ((&axis_centered P_tile A)
           (= P_img P))))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (input (:P *P_in))
        (perp (:A *A1))
        (&mirror (:A A1) (:P_tile *T) (:P P_in)))
      (inner ((:P P_intile))
        (perp *A2)
        (&mirror (:A A2) (:P_img *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (perp (:A *A1) *A2)
      (&mirror (:A A1) (:P_tile *T) (:P P_in) (:P_img *P1))
      (&mirror (:A A2) (:P_tile T) (:P P1) (:P_img *P_intile))
      (&output_tiling2.cell (:P_outer T) (:P_inner P_intile) *P)))
  (ALT $Unfold
    (RULE &tile_off
      (&arr_pos_frame.cell (:P *P_tile))
      (&arr_pos_frame.cell (:P *C))
      (centered (:P C))
      (relative (:Base C) (:X P_tile) (:X_rel *V))
      (axis_of *D *A)
      (margin (:B V) D *K)
      (>= K 0))

    ;; The input reflected across a shared boundary on each axis, once per tile
    ;; step away from the center tile along that axis.
    (INIT &reflect Walk
      (key ((OR ((input *P)
                 (axis_elem ^A)
                 (axis_inversion A (:T *F))
                 (apply (:D F) P (:P_out *P_img)))
                ((&tile_off A *K))))
        (successor ((:p P) (:p_next P_img))
          (input *P)
          (axis_elem A)
          (axis_inversion A (:T *F))
          (apply (:D F) P (:P_out *P_img)))
        (steps ((:N K))
          (&tile_off A *K))))

    (INIT &output_tiling3 Tiling
      (outer ((:P T))
        (perp (:A *A1))
        (&tile_off (:P_tile *T) (:A A1) (:K *K1))
        (&reflect.walk (:key (:A A1)) (:N K1)))
      (inner ((:P P_intile))
        (perp (:A *A1) *A2)
        (&tile_off (:A A2) (:K *K2))
        (&reflect.walk (:key (:A A1)) (:p *P1))
        (&reflect.walk (:key (:A A2)) (:p0 P1) (:N K2) (:p *P_intile))))

    (RULE &output
      (input (:P *P_in) *Col)
      (perp (:A *A1) *A2)
      (&tile_off (:P_tile *T) (:A A1) (:K *K1))
      (&tile_off (:P_tile T) (:A A2) (:K *K2))
      (&reflect.walk (:key (:A A1)) (:p0 P_in) (:N K1) (:p *P1))
      (&reflect.walk (:key (:A A2)) (:p0 P1) (:N K2) (:p *P_intile))
      (&output_tiling3.cell (:P_outer T) (:P_inner P_intile) *P))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:key D) (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
