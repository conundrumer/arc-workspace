;; inputs 819c404b33bd29b6eb13ab0ad205644aa2b2d1f1465acd5d273265ad9a4dd058 programs/solvers/c9f8e694.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c9f8e694

(DET &targets ChangedColor)

(DET &axis AxisDomain)

(DET &anchor DirDomain)

(RULE &cell_slice
  (input *P *Col)
  (&axis *A)
  (split P A (:Across *P_across)))

(RULE &slice_repl
  (&cell_slice *P *Col *P_across)
  (&anchor *D)
  (margin (:B P) D (:K 0)))

(ALTS $choice "what supplies the slice's replacement color" $Anchor
  (ALT $Unique
    (DET &bg SharedColor)

    (RULE &slice_repl
      (&cell_slice *Col *P_across)
      (NOT (&targets (:C Col)))
      (NOT (&bg (:C Col))))))

(RULE &output
  (&cell_slice *P (:Col *Col2) *P_across)
  (IF ((&targets (:C Col2)))
      ((&slice_repl P_across *Col))
      ((= Col Col2))))

(OUT (&output ^P ^Col))
