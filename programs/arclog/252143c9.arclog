;; inputs aa2f06a5738e6bbbe991f2098a0c5eeda0644ab61a17497679b3934882c28646 programs/solvers/252143c9.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 252143c9

(RULE &dp_nearer
  (input *P)
  (dist_pair P *D *K *K2)
  (< K K2))

(RULE &dp_quadrant
  (diag_dirs (:D *Diag) *D1 *D2)
  (&dp_nearer *P (:D D1))
  (&dp_nearer P (:D D2)))

(DET &bg DominantColor)

(RULE &center
  (input *P)
  (centered P))

(RULE &quad_color
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&dp_quadrant P *Diag))

(RULE &target
  (&center *P)
  (input P *Col)
  (&quad_color *Diag Col))

(INIT &ray Ray
  (source (P)
    (&center *P))
  (node (P)
    (input *P))
  (dir (D)
    (&target (:Diag *D))))

(RULE &output
  (input *P)
  (IF ((&ray.ray P))
      ((&target *Col))
      ((&bg (:C Col)))))

(OUT (&output ^P ^Col))
