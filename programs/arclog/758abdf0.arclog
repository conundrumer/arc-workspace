;; inputs f91d4c237804917c8c54501e77acb9e84a64271cda0ec7bae8d0b8fc2eb5c584 programs/solvers/758abdf0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 758abdf0

;; The color an edge line holds throughout.
(INIT &edge Singleton
  (key ((dir_elem ^D))
    (member ((:v Col))
      (input *P *Col)
      (margin (:B P) D (:K 0)))))

(DET &wall UnchangedColor)

(RULE &away
  (&edge.value (:key (:D *D2)) (:v *Col))
  (&wall (:C Col))
  (opposite (:D D2) (:Opp *D)))

;; The run length at which a run leaves.
(DET &full TileDim)

(DET &mark RarestColor)

;; Runs of marks along the away axis. Components within one line: the
;; perpendicular steps connect nothing.
(INIT &runs Connectivity
  (key ((input *P *Col)
        (&mark (:C Col))
        (&away (:D *A))
        (axis_of (:D A) (:A *Ax))
        (split P (:A Ax) (:Across ^L)))
    (node (P)
      (input *P *Col)
      (&mark (:C Col))
      (&away (:D *A))
      (axis_of (:D A) (:A *Ax))
      (split P (:A Ax) (:Across L)))))

(INIT &len Cardinality
  (key ((&runs.component ^Id *P))
    (member ((:m P))
      (&runs.component Id *P))))

(RULE &landing_cell
  (&runs.component (:Id *Key) *P)
  (&len.size (:key (:Id Key)) *N)
  (&full (:D N)))

;; A full run slides away from the wall until it lands against the far edge.
(INIT &landing Distance
  (key ((&landing_cell (:Key ^Id)))
    (source_distance (K)
      (&runs.component Id *P)
      (&len.size (:key Id) *N)
      (&full (:D N))
      (&away (:D *A))
      (margin (:B P) (:D A) *K))))

(RULE &landing_dir
  (&landing_cell)
  (&away *D))

(RULE &landing_travel_full
  (&landing.distance (:key (:Id *V0)) *K)
  (&landing_dir *D)
  (&landing_cell (:Key V0))
  (jump_offset D K (:V *V2)))

(DET &bg DominantColor)

(RULE &placed
  (OR ((&len.size (:key *Id) *N)
       (&full (:D *F))
       (< N F)
       (&runs.component Id (:P *P2))
       (&away (:D *A))
       (neighbor (:P P2) (:D A) (:Q *P))
       (&mark (:C *Col)))
      ((&landing_cell (:Key *Id2) (:P *P22))
       (&landing_travel_full (:V0 Id2) (:V2 *V))
       (compose (:A P22) (:B V) (:C P))
       (&wall (:C Col)))))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&placed P *Col))
      ((NOT (&placed P))
       (&landing_cell P)
       (&bg (:C Col)))
      ((NOT (&placed P))
       (NOT (&landing_cell P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
