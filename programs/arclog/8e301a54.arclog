;; inputs dc64ddef871e109ed5403266b7ee132651ef010aee09051ea38600b8c7e5e91c programs/solvers/8e301a54.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 8e301a54

(DET &bg DominantColor)

(DET &move_dir DirDomain)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &hue_size Cardinality
  (key ((&ink *P ^Col))
    (member ((:m P))
      (&ink *P Col))))

(RULE &shape_cell
  (&ink *P *Col)
  (&hue_size.size (:key Col) *N))

(ALTS $choice "what a shape is" $Hue
  (ALT $Object
    (INIT &objects Connectivity
      (node (P)
        (&ink *P)))

    (INIT &object_size Cardinality
      (key ((&objects.component *P ^Id))
        (member ((:m P))
          (&objects.component *P Id))))

    (RULE &shape_cell
      (&objects.component *P *Id)
      (&object_size.size (:key Id) *N))))

(RULE &landed
  (&shape_cell (:P *P2) *N)
  (&ink (:P P2) *Col)
  (&move_dir *D)
  (jump (:P P2) D (:K N) (:Q *P)))

(RULE &output
  (input *P)
  (OR ((&landed P *Col))
      ((NOT (&landed P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
