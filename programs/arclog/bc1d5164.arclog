;; inputs b85d0753d54935b510ba6cec9ef40c4ac7f1b9f0199db17f1275b752012ad92e programs/solvers/bc1d5164.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; bc1d5164

(DET &bg DominantColor)

(DET &frame_dim ConstOutDim)

(INIT &frame_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&frame_dim *N)))

(RULE &contribution
  (input (:P *P_in) *Col)
  (NOT (&bg (:C Col)))
  (&frame_frame.cell (:P *P_out))
  (same_corner (:D *Diag) (:P1 P_in) (:P2 P_out)))

(RULE &output
  (OR ((&contribution (:P_out *P) *Col))
      ((&frame_frame.cell P)
       (NOT (&contribution (:P_out P)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
