;; inputs 93fe43f0b7d872073e1cf09bd4008078babb6e4997ee5738e5dbc770e4bc3e45 programs/solvers/4c5c2cf0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 4c5c2cf0

(DET &bg DominantColor)

(DET &group SymDomain)

(RULE &shape_cell2
  (input *P *Col)
  (NOT (&bg (:C Col))))

;; Each shape's bounding box.
(INIT &bbox2 BoundingBox
  (key ((&shape_cell2 ^Col *P))
    (cell (P)
      (&shape_cell2 Col *P))))

(RULE &shape_inner
  (&shape_cell2 *Col *P)
  (&bbox2.box (:key Col) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(INIT &inv Agreement
  (key ((&shape_inner ^Col *P_inner))
    (source ((:P P_inner))
      (&shape_inner Col *P_inner))
    (target ((:P P_inner))
      (&shape_inner Col *P_inner))))

(INIT &sym Inclusion
  (pattern ((:pattern S) (:m D))
    (&group *S)
    (sym_member S *D))
  (observed ((:observed Col) (:m D))
    (&shape_inner *Col)
    (d4_elem *D)
    (NOT (&inv.mismatch (:key Col) D))))

(RULE &pivot2
  (&sym.superset (:observed *Col)))

(ALTS $choice "how the pivot is found; the two ways agree on every pair" $Fixed
  (ALT $Known
    (DET &shape_cell
      (ex_input *E *P *Col)
      (NOT (&bg (:C Col))))

    (INIT &bbox BoundingBox
      (key ((&shape_cell ^E ^Col *P))
        (cell (P)
          (&shape_cell E Col *P))))

    (DET &gained
      (ex_output *E *P *Col)
      (NOT (ex_input E P Col)))

    (DET &pivot
      (&shape_cell *E *Col)
      (ex_output E)
      (NOT (&gained E Col)))

    (DET &pivot_shape
      (&pivot *E *Col)
      (&shape_cell E Col (:P *P2))
      (&bbox.box (:key E Col) *B)
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P)))

    (INIT &known Inclusion
      (pattern ((:m P))
        (&pivot_shape *P))
      (observed ((:observed Col) (:m P_inner))
        (&shape_inner *Col *P_inner)))

    (RULE &pivot2
      (&known.equal (:observed *Col)))))

(RULE &copy
  (&shape_cell2 *Col (:P *P2))
  (&pivot2 (:Col *Pivot))
  (&bbox2.box (:key (:Col Pivot)) *B)
  (relative (:Base B) (:X P2) (:X_rel *P_rel))
  (&group *S)
  (sym_member S *D)
  (apply D (:P P_rel) (:P_out *P_rel2))
  (compose (:A B) (:B P_rel2) (:C *P))
  (input P))

(RULE &output
  (OR ((&copy *P *Col))
      ((input P)
       (&pivot2)
       (NOT (&copy P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
