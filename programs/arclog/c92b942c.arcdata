;; inputs 7d0367ddca8edeeb366d1b8fcff346202271aa42a644089c0348635df4528d08 programs/solvers/c92b942c.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; c92b942c

(param &background Color (0))
(param &tile_count number (3))
(param &line_axis Axis (AXIS_H))
(param &line_color Color (1))
(param &diag_dirs DiagDir (DIAG_TL) (DIAG_BR))
(param &diag_color Color (3))

(alts $lc
  (alt $LineOverCorner
    (witness adjacent-mark-rows variant concept
      (separates "Marks on adjacent rows of the tiled grid put a corner of each mark on the line of the other: the concept paints the corner 3 over the line, and $LineOverCorner keeps the line 1 there.")
      (input (grid
        (0 5 0 0)
        (0 0 0 5)
        (0 0 0 0)))
      (output $CornerOverLine (grid
        (1 5 3 1 1 5 3 1 1 5 3 1)
        (1 1 3 5 1 1 3 5 1 1 3 5)
        (3 0 0 0 3 0 0 0 3 0 0 0)
        (1 5 3 1 1 5 3 1 1 5 3 1)
        (1 1 3 5 1 1 3 5 1 1 3 5)
        (3 0 0 0 3 0 0 0 3 0 0 0)
        (1 5 3 1 1 5 3 1 1 5 3 1)
        (1 1 3 5 1 1 3 5 1 1 3 5)
        (0 0 0 0 3 0 0 0 3 0 0 0)))
      (output $LineOverCorner (grid
        (1 5 1 1 1 5 1 1 1 5 1 1)
        (1 1 1 5 1 1 1 5 1 1 1 5)
        (3 0 0 0 3 0 0 0 3 0 0 0)
        (1 5 1 1 1 5 1 1 1 5 1 1)
        (1 1 1 5 1 1 1 5 1 1 1 5)
        (3 0 0 0 3 0 0 0 3 0 0 0)
        (1 5 1 1 1 5 1 1 1 5 1 1)
        (1 1 1 5 1 1 1 5 1 1 1 5)
        (0 0 0 0 3 0 0 0 3 0 0 0))))))

(alts $cm
  (alt $CornerOverMark
    (witness diagonal-marks variant concept
      (separates "Two marks one diagonal step apart each fall on a corner of the other: the concept keeps both marks, and $CornerOverMark paints them 3.")
      (input (grid
        (0 0 0)
        (0 5 0)
        (0 0 5)))
      (output $MarkKept (grid
        (3 0 0 3 0 0 3 0 0)
        (1 5 1 1 5 1 1 5 1)
        (1 1 5 1 1 5 1 1 5)
        (3 0 0 3 0 0 3 0 0)
        (1 5 1 1 5 1 1 5 1)
        (1 1 5 1 1 5 1 1 5)
        (3 0 0 3 0 0 3 0 0)
        (1 5 1 1 5 1 1 5 1)
        (1 1 5 1 1 5 1 1 5)))
      (output $CornerOverMark (grid
        (3 0 0 3 0 0 3 0 0)
        (1 3 1 1 3 1 1 3 1)
        (1 1 3 1 1 3 1 1 3)
        (3 0 0 3 0 0 3 0 0)
        (1 3 1 1 3 1 1 3 1)
        (1 1 3 1 1 3 1 1 3)
        (3 0 0 3 0 0 3 0 0)
        (1 3 1 1 3 1 1 3 1)
        (1 1 3 1 1 3 1 1 3))))))

(alts &background
  (alt &background=$Derived
    (witness background=DominantColor borderline concept
      (relaxed marks-on-background)
      (separates "The marks outnumber the 0 cells: the concept keeps 0 as background and decorates the 5 marks, and background=DominantColor takes 5 as background and decorates the 0 cells as marks. The marks also sit on adjacent rows and diagonal steps apart, so $LineOverCorner and $CornerOverMark give outputs of their own.")
      (input (grid
        (5 5)
        (5 0)))
      (output ($CornerOverLine $MarkKept &background=$Stored) (grid
        (5 5 5 5 5 5)
        (5 3 5 3 5 3)
        (5 5 5 5 5 5)
        (5 3 5 3 5 3)
        (5 5 5 5 5 5)
        (5 3 5 3 5 3)))
      (output $CornerOverMark (grid
        (5 3 5 3 5 5)
        (3 3 3 3 3 3)
        (5 3 5 3 5 3)
        (3 3 3 3 3 3)
        (5 3 5 3 5 3)
        (5 3 3 3 3 3)))
      (output &background=$Derived (grid
        (3 5 3 5 3 5)
        (1 0 1 0 1 0)
        (3 5 3 5 3 5)
        (1 0 1 0 1 0)
        (3 5 3 5 3 5)
        (1 0 1 0 1 0)))
      (output $LineOverCorner (grid
        (5 5 5 5 5 5)
        (5 1 5 1 5 1)
        (5 5 5 5 5 5)
        (5 1 5 1 5 1)
        (5 5 5 5 5 5)
        (5 1 5 1 5 1))))))
