;; inputs 8430eea134cc0dbd82e7d32f6e7be798c5ef8f4cd2b06fc2ed648c9b2a8cf570 programs/solvers/007bbfb7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 007bbfb7

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg SharedColor)

(RULE &active
  (input *P *Col)
  (NOT (&bg (:C Col))))

(ALTS $choice "the fill color" $Stamp
  (ALT $Mask
    (RULE &output
      (OR ((&cell_tiling.cell *P (:P_outer *P_tile) (:P_inner *P_intile))
           (&active (:P P_intile))
           (input (:P P_tile) *Col))
          ((&cell_tiling.cell P (:P_inner *P_intile2))
           (NOT (&active (:P P_intile2)))
           (&bg (:C Col)))))))

(RULE &output
  (OR ((&cell_tiling.cell *P (:P_outer *P_tile) (:P_inner *P_intile))
       (&active (:P P_tile))
       (input (:P P_intile) *Col))
      ((&cell_tiling.cell P (:P_outer *P_tile2))
       (NOT (&active (:P P_tile2)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
