(alts &bg
  (alt &bg=$Derived
    (witness bg=RarestColor variant &bg=$Derived
      (relaxed catalog)
      (separates "`bg=RarestColor` from the stored value: train 0 with 0 and 1 swapped")
      (input (grid
        (5 5 5 5 1 5 5 5 5 1 5 5 5 5)
        (5 5 5 5 1 5 1 1 5 1 1 5 5 1)
        (5 5 5 5 1 5 1 1 5 1 1 5 5 1)
        (5 5 5 5 1 5 5 5 5 1 5 5 5 5)))
      (output $Lookup undefined)
      (output ($HoleBox &bg=$Stored) (grid
        (2 2 2)
        (2 2 2)
        (2 2 2)))
      (output &bg=$Derived (grid
        (2 2 2)
        (8 8 8)
        (3 3 3))))))

(alts &row_tile
  (alt &row_tile=$Stored
    (witness row_tile=stored borderline &row_tile=$Stored
      (separates "row_tile=stored from the derived correspondence, at a stored correspondence that sends row 0 to the middle tile and row 1 to the first: the derived correspondence matches each row to the tile at its index and gives 2, 8, 3; the stored one gives 8, 2, 3.")
      (assign &row_tile ((0 2 0 2) (0 0 1 1)) ((0 2 1 1) (0 0 1 1)) ((0 2 2 0) (0 0 1 1)) ((1 1 0 2) (0 0 0 2)) ((1 1 1 1) (0 0 0 2)) ((1 1 2 0) (0 0 0 2)) ((2 0 0 2) (0 0 2 0)) ((2 0 1 1) (0 0 2 0)) ((2 0 2 0) (0 0 2 0)))
      (input (grid
        (5 5 5 5 0 5 5 5 5 0 5 5 5 5)
        (5 5 5 5 0 5 0 0 5 0 0 5 5 0)
        (5 5 5 5 0 5 0 0 5 0 0 5 5 0)
        (5 5 5 5 0 5 5 5 5 0 5 5 5 5)))
      (output &row_tile=$Derived (grid
        (2 2 2)
        (8 8 8)
        (3 3 3)))
      (output &row_tile=$Stored (grid
        (8 8 8)
        (2 2 2)
        (3 3 3))))))
