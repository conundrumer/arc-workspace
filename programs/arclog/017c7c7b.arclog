;; inputs dc20473bf0beaa72e0fe8a700c01d69d1ef7c88a23776e992c0b74a1fd424ba9 programs/solvers/017c7c7b.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 017c7c7b

(DET &dir DirDomain)

(DET &extent ConstOutDim)

(RULE &axis
  (&dir *D)
  (axis_of D *A))

(DET &bg ChangedColor)

(DET &ink AnyOutNewColor)

(RULE &cell_line
  (input *P *Col)
  (&axis *A)
  (split P A (:Across *Line)))

;; Output frame: the input grown along &dir to &extent.
(INIT &frame Frame
  (extent (A N)
    (OR ((&axis *A)
         (&extent *N))
        ((input *P)
         (&axis (:A *A3))
         (perp (:A A3) (:A2 A))
         (frame_extent P A N)))))

(RULE &base
  (&frame.cell *P)
  (&cell_line (:P *P_grid_in) *Line *Col)
  (&dir *D)
  (opposite D (:Opp *O))
  (same_slab (:D O) (:P1 P_grid_in) (:P2 P)))

(INIT &si_line Periods
  (key ((&cell_line *P ^Line *Col))
    (cell (P (:v Col))
      (&cell_line *P Line *Col))))

(RULE &period_at
  (&axis *A)
  (&si_line.fundamental_period (:key *Line) A *K))

(ALTS $choice "the period's scope" $Line
  (ALT $Grid
    (INIT &si_grid Periods
      (cell (P (:v Col))
        (input *P *Col)))

    ;; The grid's period, so every line takes it.
    (RULE &period_at
      (&cell_line *Line)
      (&axis *A)
      (&si_grid.fundamental_period A *K))))

(RULE &fill
  (&frame.cell *P)
  (&axis *A)
  (split P A (:Across *Line))
  (&period_at Line *K)
  (&dir *D)
  (opposite D (:Opp *O))
  (margin (:B P) (:D O) (:K *T))
  (divide T (:Side K) (:Gap 0) (:Remainder *R))
  (&base Line (:P *Q) *Col)
  (margin (:B Q) (:D O) (:K R)))

(RULE &output
  (&fill *P (:Col *C))
  (OR ((NOT (&bg C))
       (&ink (:C *Col)))
      ((&bg C)
       (= Col C))))

(OUT (&output ^P ^Col))
