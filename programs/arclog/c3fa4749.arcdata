(param &min_block_cells number (7))

(alts $place
  (alt $MouthOnBlockSide
    (witness interior-block variant $MouthOnBlockSide
      (relaxed blocks)
      (separates "A block stands clear of the grid border, and a dead-end channel opens through its left side at a cell of 9: the concept finds the channel joined to the field and keeps it, and $MouthOnBlockSide fills it with 9 from that side.")
      (input (grid
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 9 1 6 5 5 5 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 5 5 5 5 5 5 2 3 4)
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4)))
      (output $GridBorder (grid
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 9 1 6 5 5 5 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 5 5 5 5 5 5 2 3 4)
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4)))
      (output $MouthOnBlockSide (grid
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 9 9 9 5 5 5 2 3 4)
        (1 2 3 5 5 5 5 5 5 4 6 7)
        (3 4 6 5 5 5 5 5 5 7 1 2)
        (6 7 1 5 5 5 5 5 5 2 3 4)
        (1 2 3 4 6 7 1 2 3 4 6 7)
        (3 4 6 7 1 2 3 4 6 7 1 2)
        (6 7 1 2 3 4 6 7 1 2 3 4))))))

(alts $adj
  (alt $Adjacency8
    (witness diagonal-step borderline $Adjacency8
      (separates "A dead-end channel runs in from the top border and steps diagonally once: the concept fills the part before the step with 9 and keeps the part after it, and $Adjacency8 fills the whole channel with 9.")
      (input (grid
        (1 2 5 5 9 5 5 5 3 4)
        (3 4 5 5 3 5 5 5 6 7)
        (6 7 5 5 5 7 5 5 1 2)
        (1 2 5 5 5 2 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4)))
      (output $Orthogonal (grid
        (1 2 5 5 9 5 5 5 3 4)
        (3 4 5 5 9 5 5 5 6 7)
        (6 7 5 5 5 7 5 5 1 2)
        (1 2 5 5 5 2 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4)))
      (output $Adjacency8 (grid
        (1 2 5 5 9 5 5 5 3 4)
        (3 4 5 5 9 5 5 5 6 7)
        (6 7 5 5 5 9 5 5 1 2)
        (1 2 5 5 5 9 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4))))))

(alts $mouths
  (alt $WalledAnyMouth
    (witness two-cell-mouth borderline $WalledAnyMouth
      (separates "A dead-end channel meets the top border at two cells, both 9: the concept keeps it, and $WalledAnyMouth fills it with 9.")
      (input (grid
        (1 2 5 5 9 9 5 5 3 4)
        (3 4 5 5 3 7 5 5 6 7)
        (6 7 5 5 2 5 5 5 1 2)
        (1 2 5 5 5 5 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4)))
      (output $OneMouth (grid
        (1 2 5 5 9 9 5 5 3 4)
        (3 4 5 5 3 7 5 5 6 7)
        (6 7 5 5 2 5 5 5 1 2)
        (1 2 5 5 5 5 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4)))
      (output $WalledAnyMouth (grid
        (1 2 5 5 9 9 5 5 3 4)
        (3 4 5 5 9 9 5 5 6 7)
        (6 7 5 5 9 5 5 5 1 2)
        (1 2 5 5 5 5 5 5 3 4)
        (3 4 5 5 5 5 5 5 6 7)
        (6 7 5 5 5 5 5 5 1 2)
        (1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4))))))

(alts &min_block_cells
  (alt &min_block_cells=$Derived
    (witness min_block_cells=ConstInDim ordinary concept
      (separates "A 16x16 grid holds a 4x4 block whose 14-cell region is cut by a two-cell dead-end channel from the top border: the concept counts the region a block and fills the channel with 9, and min_block_cells=ConstInDim takes the grid's side, 16, as the least block size, finds no block, and keeps the channel.")
      (input (grid
        (1 2 3 4 6 7 5 9 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 5 3 5 5 1 2 3 4 6 7)
        (6 7 1 2 3 4 5 5 5 5 3 4 6 7 1 2)
        (1 2 3 4 6 7 5 5 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)))
      (output &min_block_cells=$Stored (grid
        (1 2 3 4 6 7 5 9 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 5 9 5 5 1 2 3 4 6 7)
        (6 7 1 2 3 4 5 5 5 5 3 4 6 7 1 2)
        (1 2 3 4 6 7 5 5 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)))
      (output &min_block_cells=$Derived (grid
        (1 2 3 4 6 7 5 9 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 5 3 5 5 1 2 3 4 6 7)
        (6 7 1 2 3 4 5 5 5 5 3 4 6 7 1 2)
        (1 2 3 4 6 7 5 5 5 5 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4)
        (3 4 6 7 1 2 3 4 6 7 1 2 3 4 6 7)
        (6 7 1 2 3 4 6 7 1 2 3 4 6 7 1 2)
        (1 2 3 4 6 7 1 2 3 4 6 7 1 2 3 4))))))
