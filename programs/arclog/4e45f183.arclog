;; inputs c89002b218a51a0da1480d9958ffe442bd2c8a60135ee603ebc73e790209e578 programs/solvers/4e45f183.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 4e45f183

(DET &line_width DivisorRatio)

(RULE &field_cell
  (input (:P *P_grid))
  (&line_width (:K *G))
  (uniform_inset (:K G) *B)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_field)))

(DET &tile_count TileCount)

(INIT &tile_division Division
  (cell ((:P P_field))
    (&field_cell *P_field))
  (parts (A N)
    (axis_elem *A)
    (&tile_count *N))
  (gap (A G)
    (axis_elem *A)
    (&line_width (:K *G))))

(RULE &tile
  (&field_cell *P_grid *P_field)
  (&tile_division.tile (:P P_field) (:P_outer *P_tile) (:P_inner *P_intile)))

(ALTS $d "what the ruling is read by" $Count
  (ALT $Size
    (DET &tile_side TileCount)

    (INIT &tile_division2 Division
      (cell ((:P P_field))
        (&field_cell *P_field))
      (side (A K)
        (axis_elem *A)
        (&tile_side (:N *K)))
      (gap (A G)
        (axis_elem *A)
        (&line_width (:K *G))))

    (RULE &tile
      (&field_cell *P_grid *P_field)
      (&tile_division2.tile (:P P_field) (:P_outer *P_tile) (:P_inner *P_intile)))))

(ALTS $l "where the marks sit" $Reach
  (ALT $Bulk
    (RULE &mark_side
      (&mark *P_tile *P_intile)
      (dist_pair (:P P_intile) *D *K *K2)
      (< K K2))

    (INIT &bulk Excess
      (key ((OR ((&mark_side ^P_tile *P_intile ^D))
                ((&mark_side P_tile P_intile (:D *D2))
                 (opposite D (:Opp D2)))))
        (plus ((:m P_intile))
          (&mark_side P_tile *P_intile D))
        (minus ((:m P_intile))
          (&mark_side P_tile *P_intile (:D *D2))
          (opposite D (:Opp D2)))))

    (RULE &lean
      (&bulk.excess (:key *P_tile *D)))))

(INIT &field_count Cardinality
  (key ((&tile *P_grid)
        (input (:P P_grid) ^Col))
    (member ((:m P_grid))
      (&tile *P_grid)
      (input (:P P_grid) Col))))

;; The field is one color everywhere but the marks.
(INIT &field Order
  (member ((:t Col))
    (&field_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&field_count.size (:key *Col) *N)))

(RULE &mark
  (&tile *P_grid *P_tile *P_intile)
  (input (:P P_grid) *Col)
  (NOT (&field.maximal (:t Col))))

(INIT &mark_box BoundingBox
  (key ((&mark ^P_tile *P_intile))
    (cell ((:P P_intile))
      (&mark P_tile *P_intile))))

(RULE &lean
  (&mark_box.box (:key *P_tile) *B)
  (dist_pair (:P B) *D *K *K2)
  (< K K2))

(RULE &balanced
  (&mark *P_tile)
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (NOT (&lean P_tile D))
  (NOT (&lean P_tile (:D D2))))

(RULE &tile_line
  (&tile *P_tile)
  (split (:P P_tile) *A (:Along *P_axis)))

(RULE &seat_line
  (&tile_line *A *P_axis)
  (OR ((&lean *P_tile *D)
       (axis_of D A)
       (margin (:B P_axis) D (:K 0)))
      ((&balanced P_tile A)
       (centered (:P P_axis)))))

(RULE &seat
  (&seat_line *P_tile *A (:P_axis *P1))
  (perp A *A2)
  (&seat_line P_tile (:A A2) (:P_axis *P2))
  (compose (:A P1) (:B P2) (:C *P_seat)))

(RULE &output
  (OR ((&tile (:P_grid *P_grid_in) *P_tile *P_intile)
       (input (:P P_grid_in) *Col)
       (&seat P_tile *P_seat)
       (&tile (:P_grid *P) (:P_tile P_seat) P_intile))
      ((input P Col)
       (NOT (&tile (:P_grid P))))))

(OUT (&output ^P ^Col))
