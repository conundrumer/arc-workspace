;; inputs b2bbda2e547446e7a8b7a77f60369e95466c1d6721f1672103bf669f539b6dfb programs/solvers/e57337a4.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e57337a4

(INIT &canvas_count Cardinality
  (key ((input *P (:Col ^C)))
    (member ((:m P))
      (input *P (:Col C)))))

(DET &divisor ConstOutDim)

(INIT &tile_of_division Division
  (cell (P)
    (input *P))
  (parts (A N)
    (axis_elem *A)
    (&divisor *N)))

(DET &mark RarestColor)

(INIT &canvas Order
  (member ((:t C))
    (&canvas_count.size (:key *C)))
  (score ((:t C) (:S N))
    (&canvas_count.size (:key *C) *N)))

(RULE &tile_of
  (&tile_of_division.tile (:P *P_grid) (:P_outer *P_tile)))

(ALTS $choice "Decomposition hypothesis (data-equivalent on 15×15)" $Count
  (ALT $Size
    (DET &tile DivisorRatio)

    (INIT &tile_of_division2 Division
      (cell (P)
        (input *P))
      (side (A K)
        (axis_elem *A)
        (&tile *K)))

    (RULE &tile_of
      (&tile_of_division2.tile (:P *P_grid) (:P_outer *P_tile)))))

(RULE &marked
  (input *P *Col)
  (&mark (:C Col))
  (&tile_of (:P_grid P) *P_tile))

(RULE &output
  (OR ((&marked (:P_tile *P))
       (&mark (:C *Col)))
      ((&tile_of (:P_tile P))
       (NOT (&marked (:P_tile P)))
       (&canvas.maximal (:t Col)))))

(OUT (&output ^P ^Col))
