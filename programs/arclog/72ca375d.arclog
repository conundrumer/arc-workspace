;; inputs de7fa9fa87b6fc2f344c8158fea99634b6671abccd5e1f6ea1932eb9523c197a programs/solvers/72ca375d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 72ca375d

(DET &bg DominantColor)

(DET &sym D4Domain)

(INIT &pieces Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox BoundingBox
  (key ((&pieces.component *P ^Id))
    (cell (P)
      (&pieces.component *P Id))))

(RULE &cropped
  (&bbox.box (:key *Id) *B)
  (input (:P *P_grid) *Col)
  (inside (:A P_grid) B)
  (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

;; The crop's own symmetries.
(INIT &inv Agreement
  (key ((&cropped ^Id (:P_inner *P) *Col))
    (source (P (:v Col))
      (&cropped Id (:P_inner *P) *Col))
    (target (P (:v Col))
      (&cropped Id (:P_inner *P) *Col))))

(RULE &chosen
  (&sym *D)
  (&cropped *Id)
  (d4_elem D)
  (NOT (&inv.mismatch (:key Id) D)))

(ALTS $choice "where the symmetry test comes from — data-equivalent on this task, since the crop that &sym fixes is the one crop with a symmetry" $Stored
  (ALT $Any
    (RULE &inv_has_sym_full
      (&cropped (:Id *V0))
      (d4_elem *D)
      (NOT (d4_identity D))
      (NOT (&inv.mismatch (:key (:Id V0)) D)))

    (RULE &chosen
      (&inv_has_sym_full (:V0 *Id)))))

(RULE &output
  (&chosen *Id)
  (&cropped Id (:P_inner *P) *Col))

(OUT (&output ^P ^Col))
