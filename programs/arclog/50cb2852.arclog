;; inputs f2cffad953281efdaf3bf47327f141580b909d81a8055ef8c366ce67f821de21 programs/solvers/50cb2852.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 50cb2852

(DET &bg DominantColor)

(DET &fill AnyOutNewColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &comps Connectivity
  (node (P)
    (&ink *P)))

(INIT &bbox BoundingBox
  (key ((&comps.component *P ^Id))
    (cell (P)
      (&comps.component *P Id))))

(RULE &inner_cell
  (&bbox.box *B)
  (input *P)
  (interior (:A P) B))

(ALTS $choice "how the interior is picked" $Box
  (ALT $Erode
    (INIT &exposed Boundary
      (cell (P)
        (&ink *P)))

    (RULE &inner_cell
      (&ink *P)
      (NOT (&exposed.boundary P)))))

(RULE &output
  (OR ((&inner_cell *P)
       (&fill (:C *Col)))
      ((input P Col)
       (NOT (&inner_cell P)))))

(OUT (&output ^P ^Col))
