;; inputs 5d52aa05d68458c2a00529cb225faaaf7794e705b7123c5563e92bacc973cbc6 programs/solvers/a6953f00.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; a6953f00

;; The grid edge whose corners the crop anchors at.
(DET &crop_side DirDomain)

(RULE &crop_corner
  (&crop_side (:D *D2))
  (corner_dir (:C *D) (:D D2)))

(DET &frame_dim ConstOutDim)

(INIT &frame_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&frame_dim *N)))

(RULE &corner
  (&crop_corner *D)
  (ONE))

(RULE &output
  (input (:P *P_grid_in) *Col)
  (&frame_frame.cell *P)
  (&corner *D)
  (same_corner D (:P1 P) (:P2 P_grid_in)))

(OUT (&output ^P ^Col))
