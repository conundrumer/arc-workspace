;; inputs dbbb5d5db8f9a8cbb88cf13e3b841698d3a2fe1a3565d0e4335270f07294cc9e programs/solvers/cce03e0d.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; cce03e0d

(INIT &cell_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (input (:P *P_intile))))

(DET &bg ColorDomain)

(DET &stamp ColorDomain)

(RULE &active
  (input *P *Col)
  (&stamp (:C Col)))

(RULE &output
  (OR ((&cell_tiling.cell *P (:P_outer *P_tile) (:P_inner *P_intile))
       (&active (:P P_tile))
       (input (:P P_intile) *Col))
      ((&cell_tiling.cell P (:P_outer *P_tile2))
       (NOT (&active (:P P_tile2)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
