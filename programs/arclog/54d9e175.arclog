;; inputs fdb6f1a278441e83c04594ae29f57e0887f6c56e2d6c5b2347c1b41ffdc54b4b programs/solvers/54d9e175.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 54d9e175

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^L)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along L)))))

(DET &separator UnchangedColor)

(RULE &tiling_divider
  (&line_color.value (:key *A *L) (:v *Col))
  (&separator (:C Col)))

(RULE &tiling_on_divider
  (input *P)
  (&tiling_divider *A *L)
  (axis_of *D A)
  (same_dist D (:P1 P) (:P2 L)))

(INIT &tiling_rank Order
  (key ((OR ((&tiling_divider *A *L)
             (axis_of ^D A)
             (margin (:B L) D *K))
            ((input *P)
             (margin (:B P) D K))))
    (member ((:t K))
      (&tiling_divider *A *L)
      (axis_of D A)
      (margin (:B L) D *K))
    (score ((:t K) (:S K))
      (OR ((&tiling_divider *A *L)
           (axis_of D A)
           (margin (:B L) D *K))
          ((input *P)
           (margin (:B P) D K))))
    (probe ((:t K))
      (input *P)
      (margin (:B P) D *K))))

(RULE &tiling_part_idx
  (input *P)
  (axis_of *D *A)
  (NOT (&tiling_on_divider P A))
  (margin (:B P) D *K)
  (&tiling_rank.rank (:key D) (:t K) (:R *N)))

(RULE &tiling_part_of
  (axis_of *D *A)
  (opposite D (:Opp *D2))
  (&tiling_part_idx *P D (:N *N1))
  (&tiling_part_idx P (:D D2) (:N *N2))
  (axis_inset D (:K1 N1) (:K2 N2) (:B *P_part)))

(RULE &tiling_tile_of
  (&tiling_part_of *P *A (:P_part *P1))
  (perp A *A2)
  (&tiling_part_of P (:A A2) (:P_part *P2))
  (compose (:A P1) (:B P2) (:C *P_tile)))

(RULE &tile
  (&tiling_tile_of *P *P_tile))

;; The one output color each input color takes, over every train cell.
(INIT &image Singleton
  (key ((ex_input *E *P (:Col ^Col_in))
        (ex_output E P (:Col *Col_out)))
    (member ((:v Col_out))
      (ex_input *E *P (:Col Col_in))
      (ex_output E P (:Col *Col_out)))))

(DET &mapping
  (&image.value (:key (:Col_in *C_cell)) (:v *C_fill))
  (!= C_cell C_fill))

(ALTS $choice "the cases read the regions differently" $Lines
  (ALT $Period
    (DET &gap DivisorRatio)

    (DET &tile_size SepTileCount)

    (INIT &tile_division Division
      (cell (P)
        (input *P))
      (side (A K)
        (axis_elem *A)
        (&tile_size (:N *K)))
      (gap (A G)
        (axis_elem *A)
        (&gap (:K *G))))

    (RULE &tile
      (&tile_division.tile *P (:P_outer *P_tile))))
  (ALT $Flood
    ;; The runs of cells the separator walls off from one another.
    (INIT &region Connectivity
      (node (P)
        (input *P *Col)
        (NOT (&separator (:C Col)))))

    (RULE &same_region
      (&region.component *P *Id)
      (&region.component (:P *Q) Id))))

(RULE &same_region
  (&tile *P *P_tile)
  (&tile (:P *Q) P_tile))

(RULE &paint
  (&same_region *P *Q)
  (input (:P Q) (:Col *Col2))
  (&mapping (:C_cell Col2) (:C_fill *Col)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&paint P *Col))
      ((NOT (&paint P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
