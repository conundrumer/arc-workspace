;; inputs b96dc2dc23ce525d7ae85efa290380ebf231ccb31cb611b3cf475a0f3b623880 programs/solvers/1a2e2828.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1a2e2828

(DET &out_dim ConstOutDimAxis)

(INIT &out_pos_frame Frame
  (extent (A N)
    (&out_dim *A *N)))

(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Across ^P_across)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Across P_across)))))

(RULE &output
  (&line_color.value (:v *Col))
  (&out_pos_frame.cell *P))

(OUT (&output ^P ^Col))
