;; inputs f30d1f437ad01980e42472e07929b67c30128f272a040128782c7b146eecf781 programs/solvers/7d7772cc.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 7d7772cc

;; A line of one color, keyed by its normal axis.
(INIT &line_color Singleton
  (key ((input *P *Col)
        (axis_elem ^A)
        (split P A (:Along ^P_line)))
    (member ((:v Col))
      (input *P *Col)
      (split P A (:Along P_line)))))

;; A color is thin when every cell of it borders another color or the edge.
(INIT &thin Boundary
  (key ((input *P ^Col))
    (cell (P)
      (input *P Col))))

(RULE &fence
  (input *P *Col)
  (&line_color.value (:v Col))
  (ALL ((input (:P *Pm) Col))
       ((&thin.boundary (:key Col) (:P Pm)))))

(INIT &pen BoundingBox
  (cell (P)
    (&fence *P)))

(RULE &penned
  (input *P)
  (&pen.box *B)
  (inside (:A P) B))

(RULE &free_cell
  (input *P)
  (NOT (&penned P)))

(INIT &free_bg_count Cardinality
  (key ((&free_cell *P)
        (input P ^Col))
    (member ((:m P))
      (&free_cell *P)
      (input P Col))))

(INIT &free_bg Order
  (member ((:t Col))
    (&free_bg_count.size (:key *Col)))
  (score ((:t Col) (:S N))
    (&free_bg_count.size (:key *Col) *N)))

(RULE &mark
  (&free_cell *P)
  (input P *Col)
  (NOT (&free_bg.maximal (:t Col))))

(RULE &open_dir
  (&pen.box *B)
  (dir_elem *D)
  (NOT (margin B D (:K 0))))

(RULE &heading
  (&mark *P *Col)
  (&open_dir (:D *D2))
  (axis_of (:D D2) *A)
  (&fence (:P *S))
  (&pen.box *B)
  (inside (:A S) B)
  (same_dist (:D D2) (:P1 S) (:P2 B))
  (same_line A P (:Q S))
  (opposite (:D D2) (:Opp *D_in))
  (neighbor (:P S) (:D D_in) (:Q *G))
  (IF ((input (:P G) Col))
      ((= *D D_in))
      ((= D D2))))

;; Each mark slides along its heading until the fence or the grid edge.
(INIT &slide Distance
  (key ((&heading ^D))
    (weight ((:a P2) (:b P) (:W K))
      (&heading *P D)
      (&heading (:P *P2) D)
      (!= P P2)
      (gap D P (:Q P2) *K))
    (source_distance ((:n P) K)
      (OR ((&heading *P D)
           (margin (:B P) D *K))
          ((&heading P D)
           (&fence (:P *S))
           (gap D P (:Q S) K))))))

(RULE &slide_travel_full
  (&slide.distance (:key (:D *V0)) (:n *V1) *K)
  (&heading (:D V0))
  (jump_offset (:D V0) K (:V *V2)))

(RULE &rest
  (&mark (:P *P2) *Col)
  (&heading (:P P2) *D)
  (&slide_travel_full (:V0 D) (:V1 P2) (:V2 *V))
  (compose (:A P2) (:B V) (:C *P)))

(RULE &output
  (input *P (:Col *Col_in))
  (OR ((&rest P *Col))
      ((NOT (&rest P))
       (&mark P)
       (&free_bg.maximal (:t Col)))
      ((NOT (&rest P))
       (NOT (&mark P))
       (= Col Col_in))))

(OUT (&output ^P ^Col))
