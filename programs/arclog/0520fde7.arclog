;; inputs 6f01547bdab3ba7e1ad2169ec4ca17c22d66f90084751e9b7b154916acba49a6 programs/solvers/0520fde7.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 0520fde7

;; a tile's extent on both axes
(DET &tile_dim ConstOutDim)

(DET &arr_dim SepTileCountAxis)

(DET &gap DivisorRatio)

(INIT &tile_decompose_outer Frame
  (extent (A N)
    (&arr_dim *A *N)))

(INIT &tile_decompose_inner Frame
  (extent (A N)
    (axis_elem *A)
    (&tile_dim *N)))

(INIT &tile_decompose_tiling Tiling
  (outer (P)
    (&tile_decompose_outer.cell *P))
  (inner (P)
    (&tile_decompose_inner.cell *P))
  (gap (A G)
    (axis_elem *A)
    (&gap (:K *G))))

(DET &divide_axis AxisDomain)

(DET &divide_gap DivisorRatio)

(DET &combine PanelCombine)

(RULE &decompose
  (&tile_decompose_tiling.cell *P *P_outer *P_inner))

(ALTS $d "decompose" $Table
  (ALT $Count
    (DET &divisor SepTileCount)

    (INIT &decompose_division Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (parts (A N)
        (&divide_axis *A)
        (&divisor *N))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division.tile *P *P_outer *P_inner)))
  (ALT $Size
    (INIT &decompose_division2 Division
      (cell ((:P P_grid))
        (input (:P *P_grid)))
      (side (A K)
        (&divide_axis *A)
        (&tile_dim (:N *K)))
      (gap (A G)
        (&divide_axis *A)
        (&divide_gap (:K *G))))

    (RULE &decompose
      (&decompose_division2.tile *P *P_outer *P_inner))))

(ALTS $b "combine" $Lookup
  (ALT $And
    (DET &bg ChangedColor)

    (DET &out_fill AnyOutNewColor)

    (RULE &unfilled
      (input (:P *P_grid_in) *Col)
      (&bg (:C Col))
      (&decompose (:P P_grid_in) (:P_inner *P)))

    (RULE &output
      (&decompose (:P_inner *P))
      (OR ((NOT (&unfilled P))
           (&out_fill (:C *Col)))
          ((&unfilled P)
           (&bg (:C Col)))))))

(INIT &combine_match Inclusion
  (pattern ((:pattern Id) (:m (:P P_outer) (:Col C)))
    (&combine *Id (:P *P_outer) *C))
  (observed ((:observed P_grid_out) (:m (:P P_tile) (:Col C)))
    (&decompose (:P *P_grid_in) (:P_outer *P_tile) (:P_inner *P_grid_out))
    (input (:P P_grid_in) (:Col *C))))

(RULE &output
  (&combine *Id (:C_out *Col))
  (&combine_match.equal (:observed *P) (:pattern Id)))

(OUT (&output ^P ^Col))
