;; inputs 58999b4c4d3b051566bc4bc98d697af0a649e4e56e650ad9889b9271367d5d6f programs/solvers/11852cab.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 11852cab

(DET &bg DominantColor)

(INIT &bbox2 BoundingBox
  (key ((ex_output ^E *P *Col)
        (NOT (&bg (:C Col))))
    (cell (P)
      (ex_output E *P *Col)
      (NOT (&bg (:C Col))))))

(DET &inner2
  (ex_output *E *P)
  (&bbox2.box (:key E) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(DET &figure2
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col)))
  (&inner2 E P *P_inner))

(INIT &self2 Agreement
  (key ((&figure2 ^E (:P_inner *P) *Col))
    (source (P (:v Col))
      (&figure2 E (:P_inner *P) *Col))
    (target (P (:v Col))
      (&figure2 E (:P_inner *P) *Col))))

(DET &self_map2
  (&figure2 *E)
  (d4_elem *D)
  (NOT (&self2.mismatch (:key E) D)))

(INIT &bbox BoundingBox
  (cell (P)
    (input *P *Col)
    (NOT (&bg (:C Col)))))

(RULE &inner
  (input *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner)))

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col)))
  (&inner P *P_inner))

(INIT &self Agreement
  (source (P (:v Col))
    (&figure (:P_inner *P) *Col))
  (target (P (:v Col))
    (&figure (:P_inner *P) *Col)))

(RULE &self_map
  (&figure)
  (d4_elem *D)
  (NOT (&self.mismatch D)))

(DET &missing
  (ex_output *E)
  (d4_elem *D)
  (NOT (&self_map2 E D)))

;; Name the shared set as a subgroup value.
(INIT &named Inclusion
  (pattern ((:pattern S) (:m D))
    (sym_member *S *D))
  (observed ((:m D))
    (d4_elem *D)
    (NOT (&missing D))))

(DET &sym
  (&named.equal (:pattern *S)))

(RULE &transform
  (&sym *S)
  (sym_member S *D))

(ALTS $choice "the transforms the case admits" $Stored
  (ALT $Derived
    (RULE &transform
      (&figure)
      (d4_elem *D)
      (NOT (&self.conflict D)))))

(RULE &paint
  (&figure *P_inner *Col)
  (&transform *D)
  (apply D (:P P_inner) (:P_out *P_inner2))
  (&inner (:P *P_grid) (:P_inner P_inner2)))

(RULE &output
  (OR ((&paint (:P_grid *P) *Col))
      ((input P Col)
       (NOT (&paint (:P_grid P))))))

(OUT (&output ^P ^Col))
