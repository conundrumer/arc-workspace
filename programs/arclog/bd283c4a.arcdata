(param &start_corner DiagDir (DIAG_BL))
(param &fill_axis Axis (AXIS_V))

(alts $choice
  (alt $TieFirstCell
    (witness tied-counts borderline concept
      (relaxed distinct-counts)
      (separates "two colors have equal counts: the concept gives one output for each order of the tied colors, and $TieFirstCell gives the one in which the color whose first cell comes earlier in the raster order goes first")
      (input (grid
        (4 4 8 9 4 9 4 4 9 4)
        (4 9 4 4 5 4 4 5 9 4)
        (5 9 9 4 5 9 4 5 9 4)
        (5 9 4 4 5 9 4 9 4 4)
        (5 9 4 9 4 4 4 4 5 4)
        (5 5 4 5 4 4 5 4 5 4)
        (5 5 4 5 4 5 5 4 4 4)
        (5 9 4 9 4 5 9 4 4 9)
        (5 9 4 9 4 4 9 5 4 8)
        (4 9 4 4 9 4 9 5 4 4)))
      (output concept
        (grid
          (4 4 4 4 4 9 9 5 5 8)
          (4 4 4 4 4 9 9 5 5 8)
          (4 4 4 4 4 9 9 5 5 5)
          (4 4 4 4 4 9 9 5 5 5)
          (4 4 4 4 4 9 9 5 5 5)
          (4 4 4 4 4 9 9 5 5 5)
          (4 4 4 4 4 9 9 9 5 5)
          (4 4 4 4 4 9 9 9 5 5)
          (4 4 4 4 4 9 9 9 5 5)
          (4 4 4 4 4 9 9 9 5 5))
        (grid
          (4 4 4 4 4 5 5 9 9 8)
          (4 4 4 4 4 5 5 9 9 8)
          (4 4 4 4 4 5 5 9 9 9)
          (4 4 4 4 4 5 5 9 9 9)
          (4 4 4 4 4 5 5 9 9 9)
          (4 4 4 4 4 5 5 9 9 9)
          (4 4 4 4 4 5 5 5 9 9)
          (4 4 4 4 4 5 5 5 9 9)
          (4 4 4 4 4 5 5 5 9 9)
          (4 4 4 4 4 5 5 5 9 9)))
      (output $TieFirstCell (grid
        (4 4 4 4 4 5 5 9 9 8)
        (4 4 4 4 4 5 5 9 9 8)
        (4 4 4 4 4 5 5 9 9 9)
        (4 4 4 4 4 5 5 9 9 9)
        (4 4 4 4 4 5 5 9 9 9)
        (4 4 4 4 4 5 5 9 9 9)
        (4 4 4 4 4 5 5 5 9 9)
        (4 4 4 4 4 5 5 5 9 9)
        (4 4 4 4 4 5 5 5 9 9)
        (4 4 4 4 4 5 5 5 9 9))))))

(alts &out_dim
  (alt &out_dim=$Stored
    (witness out_dim=stored variant concept
      (separates "a 5x20 input of 100 cells: the concept fills a 5x20 frame, and the stored size fills a 10x10 frame")
      (input (grid
        (4 4 8 9 4 9 4 4 9 4 4 9 4 4 5 4 4 5 9 4)
        (5 9 9 4 5 9 4 5 9 4 5 9 4 4 5 9 4 9 4 4)
        (5 9 4 9 4 4 4 4 5 4 5 9 4 9 4 4 9 4 5 4)
        (5 9 4 5 4 5 9 4 4 4 5 9 4 9 4 5 9 4 4 9)
        (5 9 4 9 4 4 9 5 4 8 4 9 4 4 9 4 9 5 4 4)))
      (output &out_dim=$Derived (grid
        (4 4 4 4 4 4 4 4 4 4 9 9 9 9 9 5 5 5 5 8)
        (4 4 4 4 4 4 4 4 4 4 9 9 9 9 9 9 5 5 5 8)
        (4 4 4 4 4 4 4 4 4 4 9 9 9 9 9 9 5 5 5 5)
        (4 4 4 4 4 4 4 4 4 4 9 9 9 9 9 9 5 5 5 5)
        (4 4 4 4 4 4 4 4 4 4 9 9 9 9 9 9 5 5 5 5)))
      (output &out_dim=$Stored (grid
        (4 4 4 4 4 9 9 5 5 8)
        (4 4 4 4 4 9 9 9 5 8)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5)
        (4 4 4 4 4 9 9 9 5 5))))))
