;; inputs 9cdb6591921ab5a6ba36ccca7200bb9c7fec4a4ab4bf2a026b06abf1e9cac8f3 programs/solvers/1e81d6f9.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1e81d6f9

(DET &target_corner DiagDirDomain)

(DET &target_offset DivisorRatio)

(DET &bg DominantColor)

(RULE &target_pos
  (input *P)
  (&target_corner (:D *Diag))
  (&target_offset *K)
  (diag_dist P Diag (:K1 K) (:K2 K)))

(RULE &target_color
  (input *P (:Col *C))
  (&target_pos P))

(RULE &kept
  (&target_pos *P))

(ALTS $choice "what is kept" $Marker
  (ALT $Bbox
    (DET &mask_color UnchangedColor)

    (RULE &mask
      (input *P (:Col *MaskCol))
      (&mask_color (:C MaskCol)))

    ;; The mask region at the corner: the component touching the corner's two edges,
    ;; so a stray mask cell elsewhere stays out.
    (INIT &region Flood
      (node (P)
        (&mask *P))
      (source (P)
        (&mask *P)
        (&target_corner (:D *Diag))
        (corner_dir (:C Diag) *D)
        (margin (:B P) D (:K 0))))

    (INIT &bbox BoundingBox
      (cell (P)
        (&region.reached *P)))

    (RULE &kept
      (input *P)
      (&bbox.box *B)
      (inside (:A P) B))))

(RULE &output
  (input *P (:Col *Col2))
  (OR ((&target_color (:C Col2))
       (NOT (&kept P))
       (&bg (:C *Col)))
      ((NOT (&target_color (:C Col2)))
       (= Col Col2))
      ((&kept P)
       (= Col Col2))))

(OUT (&output ^P ^Col))
