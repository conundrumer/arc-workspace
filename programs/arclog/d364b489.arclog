;; inputs 9ae22d2fa17b412020c9926736cbcdc368d57626da786406dde4484786c59b37 programs/solvers/d364b489.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d364b489

(DET &marker RarestColor)

(RULE &marker_at2
  (input *P *Col)
  (&marker (:C Col)))

(DET &marker_at
  (ex_input *E *P *Col)
  (&marker (:C Col)))

(DET &painted
  (ex_output *E *P *Col)
  (OR ((&marker_at E P))
      ((ex_input E P (:Col *Col_in))
       (!= Col_in Col))))

;; A painted cell belongs to the marker in its 4-connected blob.
(INIT &blob Connectivity
  (key ((&painted ^E *P))
    (node (P)
      (&painted E *P))))

(DET &template
  (&painted *E *P *Col)
  (&blob.component (:key E) P *Id)
  (&blob.component (:key E) (:P *M) Id)
  (&marker_at E (:P M))
  (relative (:Base M) (:X P) (:X_rel *Delta)))

(DET &arm
  (&template (:Delta *Off) *Col)
  (dir_elem *D)
  (step_offset D (:V Off)))

(RULE &arm_halo
  (&marker_at2 (:P *Q))
  (&arm *D *Col)
  (neighbor (:P Q) D (:Q *P))
  (input P))

(ALTS $choice "data-equivalent on this task" $Arms
  (ALT $Stamp
    (RULE &stamp_halo
      (&marker_at2 (:P *Q))
      (&template (:Delta *Off) *Col)
      (compose (:A Q) (:B Off) (:C *P))
      (input P))

    (RULE &output
      (OR ((&stamp_halo *P *Col))
          ((input P Col)
           (NOT (&stamp_halo P)))))))

(RULE &output
  (OR ((&arm_halo *P *Col))
      ((input P Col)
       (NOT (&arm_halo P)))))

(OUT (&output ^P ^Col))
