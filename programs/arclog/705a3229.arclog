;; inputs 4abda286ea553573231538c295bc96e9f2f2702cfcdf22e5301e0bf3369f90f8 programs/solvers/705a3229.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 705a3229

(DET &bg DominantColor)

(RULE &mark
  (input *P *Col)
  (NOT (&bg (:C Col))))

(RULE &cast
  (&mark *Col *P)
  (dist_pair P *D *K *K2)
  (< K K2))

(INIT &rays Ray
  (key ((OR ((&mark ^Col *P))
            ((&cast Col *D))))
    (source (P)
      (&mark Col *P))
    (node (P)
      (&cast Col *D)
      (input *P))
    (dir (D)
      (&cast Col *D))))

(RULE &rays_cell
  (&mark (:Col *Key))
  (input))

(RULE &arm
  (&rays.ray (:key *Col) *P)
  (&rays_cell (:Key Col))
  (input P))

(RULE &output
  (OR ((&arm *P *Col))
      ((input P Col)
       (NOT (&arm P)))))

(OUT (&output ^P ^Col))
