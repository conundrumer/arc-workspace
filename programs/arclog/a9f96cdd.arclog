;; inputs 23f9a9dc49b4a0f4eb436420329f07d8b909da10a03ae3bc4f656e3572fc716a programs/solvers/a9f96cdd.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; a9f96cdd

(DET &bg DominantColor)

(DET &marker ChangedColor)

(RULE &marker_at
  (input *P *Col)
  (&marker (:C Col)))

(DET &template
  (ex_output *E *P *Col)
  (NOT (&bg (:C Col)))
  (ex_input E (:P *M) (:Col *Cm))
  (&marker (:C Cm))
  (relative (:Base M) (:X P) (:X_rel *Off)))

(DET &arm
  (&template *Off *Col)
  (diag_dir_elem *D)
  (step_offset D (:V Off)))

(RULE &halo
  (&marker_at (:P *Q))
  (&arm (:D *Diag) *Col)
  (neighbor (:P Q) (:D Diag) (:Q *P))
  (input P))

(ALTS $choice "how the marker's halo is painted" $Arms
  (ALT $Stamp
    (RULE &halo
      (&marker_at (:P *Q))
      (&template *Off *Col)
      (compose (:A Q) (:B Off) (:C *P))
      (input P))))

(RULE &output
  (OR ((&halo *P *Col))
      ((input P)
       (NOT (&halo P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
