;; inputs b4f97222257e6e8c0129d4258ebbfbca301b4ad16f70c146b4333b6057bb9fae programs/solvers/ce9e57f2.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; ce9e57f2

(DET &bar RarestColor)

(DET &mark AnyOutNewColor)

(DET &base DirDomain)

;; Bars keyed by their line's across position.
(INIT &bars BoundingBox
  (key ((input *P *Col)
        (&bar (:C Col))
        (&base *D)
        (axis_of D *A)
        (split P A (:Across ^Ac)))
    (cell (P)
      (input *P *Col)
      (&bar (:C Col))
      (&base *D)
      (axis_of D *A)
      (split P A (:Across Ac)))))

(RULE &marked
  (&bars.cell (:key *Ac) *P)
  (&bars.box (:key Ac) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&base *D)
  (dist_pair (:P P_inner) D *K *K2)
  (< K K2))

(RULE &output
  (OR ((&marked *P)
       (&mark (:C *Col)))
      ((input P Col)
       (NOT (&marked P)))))

(OUT (&output ^P ^Col))
