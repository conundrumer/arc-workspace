;; inputs bf8a9c0c390c9a650704d1cad339e6ad45dcc124ceeb632153628ddc024347b2 programs/solvers/95990924.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 95990924

(DET &bg DominantColor)

(RULE &ink
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &squares Connectivity
  (node (P)
    (&ink *P)))

(INIT &sbox BoundingBox
  (key ((&squares.component *P ^Id))
    (cell (P)
      (&squares.component *P Id))))

(RULE &seat
  (input (:P *P2))
  (&sbox.box (:key *Id) *B)
  (inside (:A P2) B)
  (same_corner *D (:P1 P2) (:P2 B))
  (neighbor (:P P2) D (:Q *P))
  (input P))

(DET &added
  (ex_output *E *P *Col)
  (ex_input E P (:Col *Col2))
  (!= Col Col2))

(DET &corner_paint
  (&seat *E *P *D)
  (&added E P *Col))

(RULE &painted
  (&seat *P *D)
  (&corner_paint D *Col))

(ALTS $choice "where a square's four seats are found" $Corners
  (ALT $Contact
    (RULE &beside
      (input *P)
      (NOT (&ink P))
      (neighbor P *D *Q)
      (&ink (:P Q)))

    (RULE &side
      (dir_elem *D)
      (&beside *P D))

    (RULE &corner_only
      (diag_dir_elem *D)
      (&beside *P D)
      (NOT (&side P)))

    (RULE &painted
      (&corner_only *P (:D *D_back))
      (diag_opposite (:D D_back) (:Opp *D))
      (&corner_paint D *Col)))
  (ALT $Stamp
    ;; A square with its seats: what the stored picture frames.
    (INIT &pic BoundingBox
      (key ((OR ((&squares.component ^E *P ^Id))
                ((&seat E Id P))))
        (cell (P)
          (OR ((&squares.component E *P Id))
              ((&seat E Id P))))))

    (DET &square
      (&pic.box (:key *E *Id) *B)
      (&squares.component E (:P *P2) Id)
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P))
      (ex_input E (:P P2) *Col))

    (INIT &occ Occurrences
      (cell (P (:v Col))
        (input *P *Col))
      (shape (P (:v Col))
        (&square *P *Col)))

    (DET &mark
      (&pic.box (:key *E *Id) *B)
      (&seat E Id (:P *P2))
      (inside (:A P2) B)
      (relative (:Base B) (:X P2) (:X_rel *P))
      (&added E (:P P2) *Col))

    (RULE &painted
      (&occ.occurrence (:P *M))
      (&mark (:P *P_pic) *Col)
      (compose (:A M) (:B P_pic) (:C *P))
      (input P))))

(RULE &output
  (OR ((&painted *P *Col))
      ((input P Col)
       (NOT (&painted P)))))

(OUT (&output ^P ^Col))
