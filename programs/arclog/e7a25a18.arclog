;; inputs 39e1fe664d30ee2c9249276bb1105684289d17f962c96b0293b7b4dec656ce3a programs/solvers/e7a25a18.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; e7a25a18

(INPUT one-frame "the input holds one square outline of color `frame_color`, one cell thick, on a field of `background`."

  (INIT &common_count Cardinality
    (key ((ex_input ^E *P ^Col))
      (member ((:m P))
        (ex_input E *P Col))))

  ;; The commonest color of every input.
  (INIT &common Order
    (key ((&common_count.size (:key ^E *Col)))
      (member ((:t Col))
        (&common_count.size (:key E *Col)))
      (score ((:t Col) (:S N))
        (&common_count.size (:key E *Col) *N))))

  (DET &background_defect
    (&common.maximal (:t *C))
    (ex_input *E)
    (NOT (&common.maximal (:key E) (:t C))))

  (DET_OR_RULE &background DominantColor
    (&common.maximal (:t *C))
    (NOT (&background_defect C)))

  (INIT &outlines Outlines
    (key ((input *P ^Col)
          (NOT (&background (:C Col))))
      (node (P)
        (input *P Col)
        (NOT (&background (:C Col)))))))

(INPUT quad-pattern "inside the frame, on `background`, lies one solid square pattern made of four equal square blocks in a 2×2 arrangement, each block one color, none of them `frame_color` or `background`.")

(INPUT pattern-fits-inside "the pattern's side divides the side of the frame's inside, by the ratio 2.")

(OUTPUT crop-to-frame "the output is the frame's box, with the frame drawn in its color on its border.")

(OUTPUT scale-pattern "the inside of the frame is the pattern scaled up on each axis by the ratio of the inside's side to the pattern's side, so each block of the pattern fills the matching quadrant of the inside."

  (DET &border_col
    (ex_output *P (:Col *C))
    (margin (:B P) *D (:K 0)))

  (DET &frame_color_defect
    (&border_col *C)
    (&border_col (:C *Col2))
    (!= Col2 C))

  (DET &frame_color
    (&border_col *C)
    (NOT (&frame_color_defect C)))

  (INIT &frame_cells BoundingBox
    (cell (P)
      (input *P *Col)
      (&frame_color (:C Col))))

  (RULE &frame
    (&frame_cells.box *B)
    (&frame_color (:C *Col)))

  (RULE &inside_cell
    (&frame *B)
    (input *P)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_rel))
    (interior (:A P_rel) (:B 0)))

  (RULE &pattern_cell
    (&inside_cell *P)
    (input P *Col)
    (NOT (&background (:C Col))))

  (INIT &pattern_box BoundingBox
    (cell (P)
      (&pattern_cell *P)))

  (RULE &tile_col
    (&pattern_box.box *B)
    (input *P *Col)
    (inside (:A P) B)
    (relative (:Base B) (:X P) (:X_rel *P_tile)))

  (RULE &block_cand
    (&tile_col (:P_tile *P))
    (axis_elem *A)
    (OR ((sub_extent P A (:K *N)))
        ((frame_extent P A N))))

  (INIT &block_defect_division Division
    (key ((&block_cand ^A ^N))
      (parts (A N)))
    (cell (P)
      (&tile_col (:P_tile *P))))

  (INIT &block_defect_division2 Division
    (key ((&block_defect_division.tile (:key ^A ^N) ^P)
          (&tile_col (:P_tile P) (:Col ^C1))
          (split P A (:Across ^X)))
      (cell ((:P Q))
        (&block_defect_division.tile (:key A N) P)
        (&tile_col (:P_tile P) (:Col C1))
        (&tile_col (:P_tile *Q))
        (split P A (:Across X)))
      (parts (A N)
        (&block_defect_division.tile (:key A N) P)
        (&tile_col (:P_tile P) (:Col C1))
        (split P A (:Across X)))))

  (INIT &block_count_division Division
    (key ((&block_cand ^A ^N))
      (parts (A N)))
    (cell (P)
      (&tile_col (:P_tile *P))))

  (INIT &block_count_division2 Division
    (key ((&block_cand ^A ^N))
      (parts (A N)))
    (cell (P)
      (&tile_col (:P_tile *P))))

  (INIT &inside_box BoundingBox
    (cell (P)
      (&inside_cell *P)))

  (RULE &inside_view
    (&inside_box.box *B)
    (&inside_cell (:P *P_grid))
    (inside (:A P_grid) B)
    (relative (:Base B) (:X P_grid) (:X_rel *P_inner)))

  (RULE &scale
    (&inside_view *P_inner)
    (&tile_col *P_tile)
    (frame_extent (:P P_inner) *A (:N *Ext))
    (frame_extent (:P P_tile) A *N)
    (tile_size Ext N (:G 0) *K))

  (INIT &scaled Division
    (cell ((:P P_inner))
      (&scale *A *K)
      (&inside_view *P_inner))
    (side (A K)
      (&scale *A *K)))

  (RULE &block_defect
    (&block_defect_division.tile (:key *A *N) *P *P_outer)
    (&block_defect_division2.tile (:key A N P *C1 *X) (:P *Q) P_outer)
    (&tile_col (:P_tile Q) (:Col *C2))
    (!= C1 C2)
    (split (:P Q) A (:Across X)))

  (INIT &block_count Order
    (key ((OR ((&block_count_division.tile (:key ^A *N))
               (NOT (&block_defect A N)))
              ((&block_count_division2.tile (:key A N))
               (NOT (&block_defect A N)))))
      (member ((:t N))
        (&block_count_division.tile (:key A *N))
        (NOT (&block_defect A N)))
      (score ((:t N) (:S N))
        (&block_count_division2.tile (:key A *N))
        (NOT (&block_defect A N)))))

  (INIT &inside_parts Division
    (cell ((:P P_inner))
      (&block_count.minimal (:key *A) (:t *N))
      (&inside_view *P_inner))
    (parts (A N)
      (&block_count.minimal (:key *A) (:t *N))))

  (INIT &pattern_parts Division
    (cell ((:P P_tile))
      (&block_count.minimal (:key *A) (:t *N))
      (&tile_col *P_tile))
    (parts (A N)
      (&block_count.minimal (:key *A) (:t *N)))))

(ALTS $fill "what fills the frame's inside" $Scaled
  (ALT $BlockGrid
    (OUTPUT scale-pattern "the pattern is read as a grid of single-color blocks, as few per side on each axis as the pattern allows; the inside is cut into as many equal parts per side, and each part takes the color of the matching block; undefined where the inside's side is not a multiple of that count.")
    (RULE &fill
      (&inside_view (:P_grid *P) *P_inner)
      (&inside_parts.tile (:P P_inner) (:P_outer *P_part))
      (&pattern_parts.tile (:P *P_tile) (:P_outer P_part))
      (&tile_col P_tile *Col))))

(ALTS $frame "how the frame is found" $ByColor
  (ALT $FrameByOutline
    (INPUT one-frame "the frame is the one rectangle outline, of any color, whose inside holds a cell of another color that is not `background`, and the frame's color is that outline's color; undefined where no such outline or more than one stands."
      (RULE &frame
        (&outlines.box (:key *Col) *B)
        (input *P (:Col *Col2))
        (!= Col2 Col)
        (NOT (&background (:C Col2)))
        (inside (:A P) B)
        (relative (:Base B) (:X P) (:X_rel *P_rel))
        (interior (:A P_rel) (:B 0))))))

(ALTS $pattern "where the pattern is read" $InsideFrame
  (ALT $PatternAnywhere
    (INPUT quad-pattern "the pattern is the bounding box of every cell, anywhere in the grid, that is neither `background` nor the frame's color."
      (RULE &pattern_cell
        (&frame (:Col *Col_frame))
        (input *P *Col)
        (NOT (&background (:C Col)))
        (!= Col Col_frame)))))

(RULE &fill
  (&inside_view (:P_grid *P) *P_inner)
  (&scaled.tile (:P P_inner) (:P_outer *P_tile))
  (&tile_col P_tile *Col))

(RULE &output
  ;; The output is the frame's box: the inside filled, the border in the frame's color.
  (OR ((&fill (:P *P2) *Col)
       (&frame *B)
       (inside (:A P2) B)
       (relative (:Base B) (:X P2) (:X_rel *P)))
      ((&frame (:B *B2) Col)
       (input (:P *P22))
       (inside (:A P22) (:B B2))
       (relative (:Base B2) (:X P22) (:X_rel P))
       (NOT (interior (:A P) (:B 0))))))

(OUT (&output ^P ^Col))
