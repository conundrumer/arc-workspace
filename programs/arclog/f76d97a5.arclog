;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; f76d97a5

(DET &marker SharedColor)

(DET &bg AnyOutNewColor)

(RULE &main
  (input *Col)
  (NOT (&marker (:C Col))))

(RULE &output
  (OR ((input *P (:Col *Col2))
       (&marker (:C Col2))
       (&main *Col))
      ((input P (:Col *Col22))
       (NOT (&marker (:C Col22)))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
