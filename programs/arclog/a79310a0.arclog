;; inputs 12ae49a92fcab1d4dd17bdb6814476fd196c042bc30b2250a6492b6d95a745ac programs/solvers/a79310a0.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; a79310a0

(DET &ink ChangedColor)

(DET &mark AnyOutNewColor)

(DET &bg DominantColor)

(DET &shift_dir DirDomain)

(DET &shift_k DivisorRatio)

(RULE &shift_image
  (input (:P *P_in) *Col)
  (&ink (:C Col))
  (&shift_dir *D)
  (&shift_k *K)
  (jump (:P P_in) D K (:Q *P))
  (input P))

(RULE &output
  (OR ((&shift_image *P)
       (&mark (:C *Col)))
      ((input P)
       (NOT (&shift_image P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
