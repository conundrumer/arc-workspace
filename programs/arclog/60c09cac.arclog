;; inputs fcaf4d00ae25b58b4916341c4bae9f0ee4ae25a4300d7ce81a2df1c439250d03 programs/solvers/60c09cac.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 60c09cac

(DET &scale ScaleRatio)

(INIT &intile_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&scale (:K *N))))

(INIT &output_tiling Tiling
  (outer ((:P P_tile))
    (input (:P *P_tile)))
  (inner ((:P P_intile))
    (&intile_frame.cell (:P *P_intile))))

(RULE &output
  (input (:P *P_tile) *Col)
  (&output_tiling.cell (:P_outer P_tile) *P))

(OUT (&output ^P ^Col))
