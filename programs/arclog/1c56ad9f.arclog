;; inputs 2488ca971ec7fb078f06cd3ec4894ede964cbf113c156495cbeab8c34af8cd8a programs/solvers/1c56ad9f.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 1c56ad9f

(DET &bg DominantColor)

(DET &anchor DirDomain)

(DET &period TileCount)

(RULE &figure
  (input *P *Col)
  (NOT (&bg (:C Col))))

(INIT &bbox BoundingBox
  (cell (P)
    (&figure *P)))

(RULE &phase
  (&bbox.cell *P)
  (&bbox.box *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (&anchor *D)
  (margin (:B P_inner) D (:K *T))
  (&period *N)
  (divide T (:Side N) (:Gap 0) (:Remainder *K)))

;; Where each phase's lines seat on their example's output: the
;; translations that carry every cell of the phase onto an output cell
;; of its color.
(INIT &seating Occurrences
  (key ((OR ((&figure ^E *P *Col)
             (&phase E P ^K))
            ((&phase E K)
             (ex_output E P Col))))
    (cell (P (:v Col))
      (&phase E K)
      (ex_output E *P *Col))
    (shape (P (:v Col))
      (&figure E *P *Col)
      (&phase E P K))))

(DET &wave
  (&seating.occurrence (:key *K) (:P *V))
  (&anchor *D)
  (turn *S D (:D2 *D_step))
  (step_offset (:D D_step) V))

(RULE &step_dir
  (&wave *K *S)
  (&anchor (:D *D2))
  (turn S (:D D2) (:D2 *D)))

(RULE &moved
  (&figure (:P *P2) *Col)
  (&phase (:P P2) *K)
  (OR ((&step_dir K *D)
       (neighbor (:P P2) D (:Q *P)))
      ((NOT (&step_dir K))
       (= P P2))))

(RULE &output
  (input *P)
  (OR ((&moved P *Col))
      ((NOT (&moved P))
       (&bg (:C Col)))))

(OUT (&output ^P ^Col))
