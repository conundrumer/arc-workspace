;; cf5fd0ad

(param &copies number (2))
(param &quadrant_transform (Position D4)
  (grid
    (D4_HT D4_CW)
    (D4_CC D4_ID)))
(param &anchor Position
  (grid
    (_ _)
    (_ 1)))
(param &tile_transform (Position D4)
  (grid
    (D4_HT D4_HT D4_CW D4_CW)
    (D4_HT D4_HT D4_CW D4_CW)
    (D4_CC D4_CC D4_ID D4_ID)
    (D4_CC D4_CC D4_ID D4_ID)))

(alts $source
  (alt $CounterSpin
    (witness off-spin-table ordinary concept
      (separates "a quadrant table that no anchored counter-spin gives (top-left untransformed): the concept turns the top-left quadrant by that table; $CounterSpin and $TileTable keep the stored arrangement")
      (assign &quadrant_transform
        (grid
          (D4_ID D4_CW)
          (D4_CC D4_ID)))
      (input (grid
        (8 3 8)
        (8 8 8)
        (2 8 8)))
      (output concept (grid
        (8 3 8 8 3 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (2 8 8 2 8 8 8 8 8 8 8 8)
        (8 3 8 8 3 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (2 8 8 2 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)))
      (output $CounterSpin $TileTable (grid
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8))))))

(alts $choice
  (alt $TileTable
    (witness three-copies ordinary concept
      (separates "three copies per quadrant: the concept and $CounterSpin repeat each turned input three times on each axis, 18x18; $TileTable keeps its stored 4x4 tile layout, 12x12")
      (assign &copies (3))
      (input (grid
        (8 3 8)
        (8 8 8)
        (2 8 8)))
      (output $Quadrants (grid
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 8 8 3 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 3 8 8 8 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 8 8 2 2 8 8 2 8 8 2 8 8)))
      (output $TileTable (grid
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 8 3 8 8 3)
        (8 3 8 8 3 8 8 8 8 8 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8)
        (8 8 8 8 8 8 8 3 8 8 3 8)
        (3 8 8 3 8 8 8 8 8 8 8 8)
        (8 8 2 8 8 2 2 8 8 2 8 8))))))
