(alts $unaligned
  (alt $NearestFace
    (witness unaligned-dot borderline $SkipUnaligned
      (relaxed aligned)
      (separates "the $NearestFace and $SkipUnaligned cases from the concept: the dot is outside both spans of its block. The $NearestFace cases draw toward the side with the smaller gap, with the foot off the block; the $SkipUnaligned cases keep the dot; the concept is undefined.")
