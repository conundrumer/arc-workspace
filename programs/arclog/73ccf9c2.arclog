;; inputs b8856becd8c318813efa6742fbd35b285f9ff4175b6fd3b45e0a00368b6880a0 programs/solvers/73ccf9c2.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 73ccf9c2

(DET &bg DominantColor)

(DET &sym D4Domain)

(INIT &objs Connectivity
  (node (P)
    (input *P *Col)
    (NOT (&bg (:C Col))))
  (step ((:Delta S))
    (OR ((diag_dir_elem *D)
         (step_offset D (:V *S)))
        ((dir_elem (:D *D2))
         (step_offset (:D D2) (:V S))))))

(INIT &bbox BoundingBox
  (key ((&objs.component ^Id *P))
    (cell (P)
      (&objs.component Id *P))))

(RULE &figure
  (&objs.component *Id *P)
  (&bbox.box (:key Id) *B)
  (inside (:A P) B)
  (relative (:Base B) (:X P) (:X_rel *P_inner))
  (input P *Col))

(INIT &inv Agreement
  (key ((&figure ^Id (:P_inner *P) *Col))
    (source (P (:v Col))
      (&figure Id (:P_inner *P) *Col))
    (target (P (:v Col))
      (&figure Id (:P_inner *P) *Col))))

(RULE &output
  (&sym (:D *F))
  (&inv.mismatch (:key *Id) (:D F))
  (&bbox.box (:key Id) *B)
  (input (:P *P2) *Col)
  (inside (:A P2) B)
  (relative (:Base B) (:X P2) (:X_rel *P)))

(OUT (&output ^P ^Col))
