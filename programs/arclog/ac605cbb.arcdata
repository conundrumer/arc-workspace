(alts $grid
  (alt $DropStampOffGrid
    (witness stamp-off-grid borderline concept
      (relaxed stamps-fit)
      (separates "The 6 stamp from the seed at (3,3) reaches past the top edge. The concept draws the part of the stamp inside the grid, the line cells (0,3)-(2,3); DropStampOffGrid draws none of it.")
      (input (grid
