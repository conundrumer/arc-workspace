;; inputs d5a1a2de2265040856956aa96c7845fa3306fa838e9cfd849d2d723d502d785c programs/solvers/59341089.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; 59341089

(DET &tile_d4 TileD4)

(INIT &output_tiling Tiling
  (key ((OR ((&tile_d4 (:Pt *P_tile) (:T ^D)))
            ((input (:P *P_in))
             (&tile_d4 (:T D))
             (apply D (:P P_in) (:P_out *P_intile)))))
    (outer ((:P P_tile))
      (&tile_d4 (:Pt *P_tile) (:T D)))
    (inner ((:P P_intile))
      (input (:P *P_in))
      (&tile_d4 (:T D))
      (apply D (:P P_in) (:P_out *P_intile)))))

(ALTS $choice "data-equivalent on this task" $Lookup
  (ALT $Unfold
    (DET &arr_dim ScaleRatioAxis)

    (INIT &arr_pos_frame Frame
      (extent (A N)
        (&arr_dim *A (:K *N))))

    (DET &anchor DirDomain)

    ;; The input reflected across the shared boundary, once per tile step away
    ;; from the anchor-end tile.
    (INIT &reflect Walk
      (successor ((:p P) (:p_next P_img))
        (input *P)
        (&anchor *D)
        (axis_of D *A)
        (axis_inversion A (:T *F))
        (apply (:D F) P (:P_out *P_img)))
      (steps ((:N K))
        (&arr_pos_frame.cell (:P *T))
        (&anchor *D)
        (margin (:B T) D *K)))

    (INIT &output_tiling2 Tiling
      (outer ((:P T))
        (&arr_pos_frame.cell (:P *T)))
      (inner ((:P P_intile))
        (&reflect.walk (:p0 *P) (:p *P_intile))
        (input P)))

    (RULE &output
      (&output_tiling2.cell (:P_outer *T) (:P_inner *P_intile) *P)
      (&anchor *D)
      (margin (:B T) D *K)
      (&reflect.walk (:p0 *P2) (:N K) (:p P_intile))
      (input (:P P2) *Col))))

(RULE &output
  (input (:P *P_in) *Col)
  (&tile_d4 (:Pt *P_tile) (:T *D))
  (apply D (:P P_in) (:P_out *P_intile))
  (&output_tiling.cell (:key D) (:P_outer P_tile) (:P_inner P_intile) *P))

(OUT (&output ^P ^Col))
