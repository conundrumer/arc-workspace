;; inputs 895b3fcc4f16207db5719531ee0fdc153e0cbbf99a191b8776f3321611800a89 programs/solvers/d10ecb37.dl
;; converter 1959b92f94886749d7d46dce9a29f9528f73630e5f2a59eda18069ab421bbc43
;; d10ecb37

(DET &diag DiagDirDomain)

(DET &window_dim ConstOutDim)

(INIT &window_frame Frame
  (extent (A N)
    (axis_elem *A)
    (&window_dim *N)))

(ALTS $choice "how the corner block is located" $Corner
  (ALT $Block
    (DET &tile_dim ConstOutDim)

    (INIT &output_division Division
      (cell ((:P P_in))
        (input (:P *P_in)))
      (side (A K)
        (axis_elem *A)
        (&tile_dim (:N *K))))

    (RULE &output
      (input (:P *P_in) *Col)
      (&output_division.tile (:P P_in) (:P_outer *P_tile) (:P_inner *P))
      (&diag *D)
      (same_corner D (:P1 P_tile) (:P2 0)))))

(RULE &output
  (input (:P *P_in) *Col)
  (&window_frame.cell *P)
  (&diag *D)
  (same_corner D (:P1 P) (:P2 P_in)))

(OUT (&output ^P ^Col))
