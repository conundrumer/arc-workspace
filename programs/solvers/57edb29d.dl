// 57edb29d
// draft
// concept: objects crop scale induce
// Solid colored rectangles sit on the background. Each carries the same
// design of marks, inset from its own edges, and the rectangles differ in
// size. One rectangle carries no mark. The output is that rectangle with
// the design on it.
//
// A mark holds its distance to the nearer edge on each axis, so the design
// keeps its corners and its middle stretches. A rectangle too narrow to
// separate two corners shows them merged, so the design is the union of
// what the rectangles carry.
// TODO: discuss if removing stretch makes it simpler

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(4).
}

.init params = Params

// --- panels ---

.init panel = Components<Unit>
panel.node($U(), P) :- in(P, Col), !params.bg(Col).

// Each panel's bounding box.
.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- panel.label($U(), P, Id).

// The field color, read on the border, where no mark sits.
.decl field(id: Ident, col: Color)
field(Id, Col) :- bbox.cell(Id, P), bbox.box(Id, B), box_edge(P, B, _), in(P, Col).

// A panel's cells, in the panel's own frame.
.decl panel_inner(id: Ident, p: Position, p_inner: Position)
panel_inner(Id, P, P_inner) :- bbox.cell(Id, P), bbox.box(Id, B), crop(P, B, P_inner).

// A mark: a panel cell off the field color.
.decl mark(id: Ident, p_inner: Position, col: Color)
mark(Id, P_inner, Col) :- panel_inner(Id, P, P_inner), in(P, Col), !field(Id, Col).

// The cells of the panel that carries no mark — the one the design goes on.
.decl target_cell(id: Ident, p_inner: Position)
target_cell(Id, P_inner) :- panel_inner(Id, _, P_inner), !mark(Id, _, _).

// A mark's anchor on one axis: its distance to the nearer edge of its
// panel. A centered mark anchors to both.
.decl anchor(p_inner: Position, d: Dir, k: number)
anchor(P_inner, D, K) :- mark(_, P_inner, _), dist_pair(P_inner, D, K, K2), K <= K2.

// A target cell that repeats a mark's anchor on one axis.
.decl anchored(p_inner: Position, m_inner: Position, a: Axis)
anchored(P_inner, M_inner, A) :-
    target_cell(_, P_inner),
    anchor(M_inner, D, K), axis_of(D, A), dist(P_inner, D, K).

// The design on the target: a mark anchored on both axes at once.
.decl design(p_inner: Position, col: Color)
design(P_inner, Col) :-
    mark(_, M_inner, Col), perp(A, A2),
    anchored(P_inner, M_inner, A), anchored(P_inner, M_inner, A2).

.decl out(p: Position, col: Color)
out(P_inner, Col) :-
    target_cell(Id, P_inner),
    ( design(P_inner, Col)                  // design cell
    ; !design(P_inner, _), field(Id, Col)   // field elsewhere
    ).
