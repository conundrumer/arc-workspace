// ac0c2ac3
// @draft
// @keywords: rings markers depth rank
// @scene square-odd: the input is a square grid with an odd side, so it has
//  one center cell, and its rings are the cells at each Chebyshev distance
//  from that center
// @scene one-mark-per-ring: on a field of params.bg, each ring holds exactly
//  one mark, a cell of another color, and no two marks share a color
// @rule fill-ring: the output has the input's frame, and every cell of a ring
//  takes the color of the mark that lies on that ring

// what a ring is
.type Rings =
    // @claim square-odd
    CenterRings {}
    // @scene square-odd: the grid may have any shape, and its rings are the
    //  cells at each distance from the nearest grid edge
    // @witness wide-grid: borderline $DepthRings & $EmptyBg & $ScanLast
    //     @relaxed square-odd
    // @witness long-grid: borderline $DepthRings & $EmptyBg & $ScanLast
    //     @relaxed square-odd
  | DepthRings {}

// what a ring with no mark gets
.type Unmarked =
    // @claim one-mark-per-ring
    NeedsMark {}
    // @rule empty-bg: a ring with no mark keeps params.bg
    // @witness empty-ring: borderline $EmptyBg
    //     @relaxed one-mark-per-ring
  | EmptyBg {}
    // @rule fill-ring: the output is a square with one ring per marked ring,
    //  and its rings, outermost first, take the colors of the marked rings,
    //  outermost first
    // @witness empty-ring: borderline $EmptyBg
  | RankRings {}

// what a ring with two marks gets
.type Shared =
    // @claim one-mark-per-ring
    OneMark {}
    // @rule fill-ring: a ring takes the color of its mark that comes last in
    //  the scan from the corner of a params.scan_order along its axis first.
    //  Undefined where the open scan orders pick marks of different colors.
    // @witness shared-color: borderline $ScanLast
    //     @relaxed one-mark-per-ring
    // @witness mixed-ring: borderline $ScanLast
    //     @relaxed one-mark-per-ring
    //     @reassigned scan_order
  | ScanLast {}

.type Choice = [rings: Rings, unmarked: Unmarked, shared: Shared]

// A reading of the rings: the geometry, and the box the rings are measured
// from, the center cell for CenterRings or the frame for DepthRings.
.type Reading = [g: Rings, o: Box]

// A ring under one reading.
.type Ring = [r: Reading, k: number]

// A ring under one scan order.
.type Scan = [ring: Ring, c: DiagDir, a: Axis]

// The marks of one example, in one scan order.
.type ExScan = [e: Example, c: DiagDir, a: Axis]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed one-mark-per-ring
    // @ignore: derive concept — wherever it is defined, it gives the output of
    //  the EmptyBg & ScanLast copy
    .decl bg(c: Color) bg(7).

    // --- $ScanLast ---
    // the scan starts at this corner and runs along this axis first
    .decl scan_order(d: DiagDir, a: Axis)
    scan_order(DIAG_TL, AXIS_V). scan_order(DIAG_TL, AXIS_H).
    scan_order(DIAG_TR, AXIS_V). scan_order(DIAG_TR, AXIS_H).
    scan_order(DIAG_BL, AXIS_V). scan_order(DIAG_BL, AXIS_H).
    scan_order(DIAG_BR, AXIS_V). scan_order(DIAG_BR, AXIS_H).
}

.init params = Params

.decl rings_choice(g: Rings)
rings_choice($CenterRings()). rings_choice($DepthRings()).

.decl unmarked_choice(u: Unmarked)
unmarked_choice($EmptyBg()). unmarked_choice($RankRings()).

// The concept case, and the combinations no other case subsumes. Each
// non-concept case with NeedsMark gives its EmptyBg twin's output wherever
// it is defined, and with OneMark its ScanLast twin's.
.decl impl_choice(ch: Choice)
impl_choice([$CenterRings(), $NeedsMark(), $OneMark()]).
impl_choice([G, U, $ScanLast()]) :- rings_choice(G), unmarked_choice(U).

.decl shared_choice(s: Shared)
shared_choice($OneMark()). shared_choice($ScanLast()).

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.decl reading(r: Reading)
.decl ring(r: Reading, p: Position, k: number)

// --- $CenterRings ---
reading([$CenterRings(), C]) :- in(C, _), centered(C).
// P lies on ring K about center O: on the outline of the square that reaches
// K cells past O on every side.
ring(R, P, K) :-
    reading(R), R = [$CenterRings(), O],
    in(P, _), relative(O, P, P_rel), dir_elem(D), dist(P_rel, D, K),
    uniform_outset(K, B_out), compose(O, B_out, B), box_edge(P, B, _).

// --- $DepthRings ---
reading([$DepthRings(), ZERO]).

// P lies on ring K: on the outline of the frame inset by K on every side.
ring(R, P, K) :-
    reading(R), R = [$DepthRings(), _],
    in(P, _), dir_elem(D), dist(P, D, K), uniform_inset(K, B), box_edge(P, B, _).

// --- shared ---
.decl mark_ring(r: Reading, k: number, p: Position, col: Color)
mark_ring(R, K, P, Col) :- mark(P, Col), ring(R, P, K).

.decl marked(r: Reading, k: number)
marked(R, K) :- mark_ring(R, K, _, _).

// The color of ring K under shared reading S.
.decl ring_color(r: Reading, s: Shared, k: number, col: Color)

// --- $OneMark ---
.decl crowded(r: Reading, k: number)
crowded(R, K) :- mark_ring(R, K, P, _), mark_ring(R, K, Q, _), P != Q.

ring_color(R, $OneMark(), K, Col) :- mark_ring(R, K, _, Col), !crowded(R, K).

// --- $ScanLast ---
// @claim fill-ring
// @ignore rank: store — the program reads only the last mark of the scan, not the ranks
.init scan = LexOrder<Scan>
scan.cell([[R, K], C, A], P) :-
    mark_ring(R, K, P, _), params.scan_order(C, A).
scan.corner([Ri, C, A], C) :- scan.cell([Ri, C, A], _).
scan.axis([Ri, C, A], A) :- scan.cell([Ri, C, A], _).

// The last mark's color, kept where every open scan order agrees.
// @claim fill-ring
.init last = Unanimous<Ring, Color>
last.item(Ri, Col) :- scan.last([Ri, _, _], P), mark(P, Col).

ring_color(R, $ScanLast(), K, Col) :- last.value([R, K], Col).

// --- shared ---
// The output under one reading, and the cells its frame holds.
.decl draw(r: Reading, u: Unmarked, s: Shared, p: Position, col: Color)
.decl frame(r: Reading, u: Unmarked, p: Position)

// --- $NeedsMark ---
draw(R, $NeedsMark(), S, P, Col) :- ring(R, P, K), ring_color(R, S, K, Col).
frame(R, $NeedsMark(), P) :- ring(R, P, _).

// --- $EmptyBg ---
draw(R, $EmptyBg(), S, P, Col) :-
    ring(R, P, K), shared_choice(S),
    ( ring_color(R, S, K, Col)
    ; !marked(R, K), params.bg(Col) ).
frame(R, $EmptyBg(), P) :- ring(R, P, _).

// --- $RankRings ---
// The marked rings, outermost first.
// @ignore last: store — no case that stores it fits the pairs along with the
//  case that differs from it by that branch alone, so no grid gives a witness
// @claim fill-ring
.init nest = Order<Reading, number>
nest.elem(R, K) :- marked(R, K).

// --- $CenterRings & $RankRings ---
// farther from the center lies outside
nest.before(R, K, K2) :- marked(R, K), marked(R, K2), R = [$CenterRings(), _], K > K2.

// --- $DepthRings & $RankRings ---
// nearer the edge lies outside
nest.before(R, K, K2) :- marked(R, K), marked(R, K2), R = [$DepthRings(), _], K < K2.

// --- $RankRings ---
// The output square: its center lies as deep as the innermost marked ring's
// rank, and its cells lie up to that many cells from the center on each axis.
.decl canvas(r: Reading, p: Position)
canvas(R, P) :-
    nest.last(R, K), nest.rank(R, K, N), uniform_inset(N, C),  // the center
    nest.rank(R, _, K1), nest.rank(R, _, K2),
    axis_of(D1, A), perp(A, A2), axis_of(D2, A2),
    jump(C, D1, K1, Q), jump(Q, D2, K2, P).

draw(R, $RankRings(), S, P, Col) :-
    canvas(R, P),
    nest.rank(R, K, J), uniform_inset(J, B), box_edge(P, B, _),  // on the Jth ring from outside
    ring_color(R, S, K, Col).
frame(R, $RankRings(), P) :- canvas(R, P).

// --- shared ---
// Some reading of G leaves a cell of its frame without a color.
.decl blank(g: Rings, u: Unmarked, s: Shared)
blank(G, U, S) :- frame([G, O], U, P), shared_choice(S), !draw([G, O], U, S, P, _).

// The readings of one geometry join: a cell they color differently gets
// both colors, and a frame size they disagree on gives two frames.
out(P, Col, [G, U, S]) :- impl_choice([G, U, S]), draw([G, _], U, S, P, Col), !blank(G, U, S).

.comp Determine {
    // The marks of each example, in each scan order.
    .init order = LexOrder<ExScan>
    order.cell([E, C, A], P) :-
        ex_in(E, P, Col), !params.bg(Col), diag_dir_elem(C), axis_elem(A).
    order.corner([E, C, A], C) :- order.cell([E, C, A], _).
    order.axis([E, C, A], A) :- order.cell([E, C, A], _).

    // A mark of color Col comes after mark Q.
    .decl later(e: Example, c: DiagDir, a: Axis, q: Position, col: Color)
    later(E, C, A, Q, Col) :- order.before([E, C, A], Q, R), ex_in(E, R, Col).

    // The output gives mark Q another color, and no mark of that color comes
    // after Q.
    .decl scan_clash(c: DiagDir, a: Axis)
    scan_clash(C, A) :-
        order.cell([E, C, A], Q), ex_in(E, Q, Col_in), ex_out(E, Q, Col), Col != Col_in,
        !later(E, C, A, Q, Col).

    .decl scan_order(c: DiagDir, a: Axis)
    scan_order(C, A) :- diag_dir_elem(C), axis_elem(A), !scan_clash(C, A).
}
