// ac0c2ac3
// @draft
// @keywords: rings markers depth rank
// @scene square-odd: the input is a square grid with an odd side, so it has
//  one center cell, and its rings are the cells at each Chebyshev distance
//  from that center
// @scene one-mark-per-ring: on a field of params.bg, each ring holds exactly
//  one mark, a cell of another color, and no two marks share a color
// @rule fill-ring: the output has the input's frame, and every cell of a ring
//  takes the color of the mark that lies on that ring

// what a ring is
.type Rings =
    // @claim square-odd
    CenterRings {}
    // @scene square-odd: the grid may have any shape, and its rings are the
    //  cells at each distance from the nearest grid edge
    // @witness wide-grid: borderline $DepthRings & $EmptyBg
    //     @relaxed square-odd
    // @witness long-grid: borderline $DepthRings & $EmptyBg
    //     @relaxed square-odd
  | DepthRings {}

// what a ring with no mark gets
.type Unmarked =
    // @claim one-mark-per-ring
    NeedsMark {}
    // @rule empty-bg: a ring with no mark keeps params.bg
    // @witness empty-ring: borderline $EmptyBg
    //     @relaxed one-mark-per-ring
  | EmptyBg {}
    // @rule fill-ring: the output is a square with one ring per marked ring,
    //  and its rings, outermost first, take the colors of the marked rings,
    //  outermost first
    // @witness empty-ring: borderline $EmptyBg
  | RankRings {}

.type Choice = [rings: Rings, unmarked: Unmarked]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed one-mark-per-ring
    // @ignore: derive concept — wherever it is defined, it gives the output of
    //  the $EmptyBg case
    // @ignore: derive $EmptyBg — it is equivalent to $EmptyBg with the stored
    //  bg: on a square odd grid where the stored bg gives an output, the stored
    //  bg is the dominant color, and a 1x1 grid gives one output under both
    .decl bg(c: Color) bg(7).
}

.init params = Params

.decl rings_choice(g: Rings)
rings_choice($CenterRings()). rings_choice($DepthRings()).

.decl unmarked_choice(u: Unmarked)
unmarked_choice($EmptyBg()). unmarked_choice($RankRings()).

// The concept case, and each geometry with each non-concept unmarked branch.
.decl impl_choice(ch: Choice)
impl_choice([$CenterRings(), $NeedsMark()]).
impl_choice([G, U]) :- rings_choice(G), unmarked_choice(U).

.decl ring(g: Rings, p: Position, k: number)

// --- $CenterRings ---
// P lies on ring K about center O: on the outline of the square that reaches
// K cells past O on every side.
ring($CenterRings(), P, K) :-
    in(O, _), centered(O),
    in(P, _), relative(O, P, P_rel), dir_elem(D), dist(P_rel, D, K),
    uniform_outset(K, B_out), compose(O, B_out, B), box_edge(P, B, _).

// --- $DepthRings ---
// P lies on ring K: on the outline of the frame inset by K on every side.
ring($DepthRings(), P, K) :-
    in(P, _), dir_elem(D), dist(P, D, K), uniform_inset(K, B), box_edge(P, B, _).

// --- shared ---
.decl mark_ring(g: Rings, k: number, p: Position, col: Color)
mark_ring(G, K, P, Col) :- in(P, Col), !params.bg(Col), ring(G, P, K).  // a mark: a cell not of params.bg

.decl marked(g: Rings, k: number)
marked(G, K) :- mark_ring(G, K, _, _).

.decl crowded(g: Rings, k: number)
crowded(G, K) :- mark_ring(G, K, P, _), mark_ring(G, K, Q, _), P != Q.

// The color of ring K: the color of its one mark.
.decl ring_color(g: Rings, k: number, col: Color)
ring_color(G, K, Col) :- mark_ring(G, K, _, Col), !crowded(G, K).

// The output under one geometry, and the cells its frame holds.
.decl draw(g: Rings, u: Unmarked, p: Position, col: Color)
.decl frame(g: Rings, u: Unmarked, p: Position)

// --- $NeedsMark ---
draw(G, $NeedsMark(), P, Col) :- ring(G, P, K), ring_color(G, K, Col).
frame(G, $NeedsMark(), P) :- ring(G, P, _).

// --- $EmptyBg ---
draw(G, $EmptyBg(), P, Col) :-
    ring(G, P, K),
    ( ring_color(G, K, Col)
    ; !marked(G, K), params.bg(Col) ).
frame(G, $EmptyBg(), P) :- ring(G, P, _).

// --- $RankRings ---
// The marked rings, outermost first.
// @ignore last: store — no case that stores it fits the pairs along with the
//  case that differs from it by that branch alone, so no grid gives a witness
// @claim fill-ring
.init nest = Order<Rings, number>
nest.elem(G, K) :- marked(G, K).

// --- $RankRings ---
// A marked ring's score is its distance K: from the center under
// $CenterRings, from the nearest edge under $DepthRings.
nest.score(G, K, K) :- marked(G, K).

// The count of marked rings outside ring K, and the innermost marked ring.
.decl outer_rank(g: Rings, k: number, r: number)
.decl innermost(g: Rings, k: number)

// --- $CenterRings & $RankRings ---
// farther from the center lies outside
outer_rank($CenterRings(), K, R) :- nest.rank_desc($CenterRings(), K, R).
innermost($CenterRings(), K) :- nest.first($CenterRings(), K).

// --- $DepthRings & $RankRings ---
// nearer the edge lies outside
outer_rank($DepthRings(), K, R) :- nest.rank($DepthRings(), K, R).
innermost($DepthRings(), K) :- nest.last($DepthRings(), K).

// --- $RankRings ---
// The output square: its center lies as deep as the innermost marked ring's
// rank, and its cells lie up to that many cells from the center on each axis.
.decl canvas(g: Rings, p: Position)
canvas(G, P) :-
    innermost(G, K), outer_rank(G, K, N), uniform_inset(N, C),  // the center
    outer_rank(G, _, K1), outer_rank(G, _, K2),
    axis_of(D1, A), perp(A, A2), axis_of(D2, A2),
    jump(C, D1, K1, Q), jump(Q, D2, K2, P).

draw(G, $RankRings(), P, Col) :-
    canvas(G, P),
    outer_rank(G, K, J), uniform_inset(J, B), box_edge(P, B, _),  // on the Jth ring from outside
    ring_color(G, K, Col).
frame(G, $RankRings(), P) :- canvas(G, P).

// --- shared ---
// The geometry leaves a cell of its frame without a color.
.decl blank(g: Rings, u: Unmarked)
blank(G, U) :- frame(G, U, P), !draw(G, U, P, _).

out(P, Col, [G, U]) :- impl_choice([G, U]), draw(G, U, P, Col), !blank(G, U).

.comp Determine {
    // Each ring of a train input holds a mark, and the output paints every
    // ring with its mark's color, so the field color is the one color that
    // every train input holds and no train output holds.

    // Some train input lacks the color.
    .decl lacking(c: Color)
    lacking(Col) :- ex_in(_, _, Col), ex_out(E, _, _), !ex_in(E, _, Col).

    .decl bg(c: Color)
    bg(Col) :- ex_in(E, _, Col), ex_out(E, _, _), !ex_out(_, _, Col), !lacking(Col).
}
