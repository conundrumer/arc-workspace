// 025d127b
// @keywords: objects move
// input: 8-connected shapes
// output: Each shape advances one cell toward params.dir. A cell steps
//  unless it sits on the shape's leading edge, or its landing site is
//  itself stuck.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_R).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init shapes = Components8<Unit>
shapes.node($U(), P) :- ink(P, _).

.init shape_box = Bbox<Ident>
shape_box.cell(Id, P) :- shapes.label($U(), P, Id).

// Where a cell would land.
.decl target(p: Position, p2: Position)
target(P, P2) :- ink(P, _), params.dir(D), neighbor(P, D, P2).

// A cell is stuck when the unbroken run of ink ahead of it reaches its
// shape's leading edge: a cast back from each leading-edge cell through ink.
// A landing site adjacent to its source is in the source's own shape, so
// the pile-up needs no shape key.
.init pile = Ray<Unit>
pile.dir($U(), D2) :- params.dir(D), opposite(D, D2).
pile.cell($U(), P) :- ink(P, _).
pile.mark($U(), P) :-
    shapes.label($U(), P, Id), shape_box.box(Id, B),  // a shape cell, with its shape's box
    params.dir(D), box_edge(P, B, D).                 // on the box's leading edge
pile.blocked($U(), P) :- in(P, Col), params.bg(Col).

.decl stuck(p: Position)
stuck(P) :- pile.clear($U(), P, _, _, _).

.decl slid(p: Position, col: Color)
slid(P, Col)  :- ink(P, Col), stuck(P).
slid(P2, Col) :- ink(P, Col), !stuck(P), target(P, P2).

out(P, Col) :- slid(P, Col).
out(P, Col) :- in(P, _), params.bg(Col), !slid(P, _).
