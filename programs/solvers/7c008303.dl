// 7c008303
// @draft
// @keywords: decompose crop scale select
// input: a cross of one full row and one full column, cutting the grid into
//  four quadrants: a small key, a large pattern, and two blank quadrants
// output: The output is the pattern, divided into one block per key cell,
//  with each inked cell recolored by the key cell of its block.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.type Line = [a: Axis, l: Position]

.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

.init frame = DividerTiles<Unit>
frame.cell($U(), P) :- in(P, _).

// Divider: a line of one non-bg color.
frame.divider($U(), A, L) :- line_color.value([A, L], Col), !params.bg(Col).

// Each quadrant's box.
.init tile_box = Bbox<Position>
tile_box.cell(P_tile, P) :- frame.tile_of($U(), P, P_tile).

// A quadrant's extent along a.
.decl tile_extent(p_tile: Position, a: Axis, n: number)
tile_extent(P_tile, A, N) :-
    tile_box.cell(P_tile, P), tile_box.box(P_tile, B), box_extent(B, P, A, N).

// A quadrant's cell, in the quadrant's own frame.
.decl quadrant_cell(p_tile: Position, p_intile: Position, col: Color)
quadrant_cell(P_tile, P_intile, Col) :-
    tile_box.cell(P_tile, P), in(P, Col), tile_box.box(P_tile, B), crop(P, B, P_intile).

// A quadrant holding a non-bg cell.
.decl filled(p_tile: Position)
filled(P_tile) :- quadrant_cell(P_tile, _, Col), !params.bg(Col).

// The key is the smaller filled quadrant; the pattern is the larger.
.decl role(t_key: Position, t_pat: Position)
role(T_key, T_pat) :-
    filled(T_key), filled(T_pat),
    tile_extent(T_key, A, N_key), tile_extent(T_pat, A, N_pat), N_key < N_pat.

// The pattern divided into one block per key cell.
.init blocks = Divide2D<Unit>
blocks.cell(P_intile) :- role(_, T_pat), quadrant_cell(T_pat, P_intile, _).
blocks.dim($U(), A, N) :- role(T_key, _), tile_extent(T_key, A, N).
blocks.gap(0).

out(P_intile, Col) :-
    role(T_key, T_pat), quadrant_cell(T_pat, P_intile, C),       // pattern cell
    ( params.bg(C), Col = C                                      // blank stays
    ; !params.bg(C), blocks.tile($U(), P_intile, P_block, _),    // inked: its block
      quadrant_cell(T_key, P_block, Col)                         // takes the key's color there
    ).
