// 11e1fe23
// concept: scale move cross
// Colored marks sit at the corners of a square. The output keeps the marks
// and adds a small copy of them at the square's center: each mark's color one
// diagonal step out, and the center painted. The cases differ in how a mark
// finds its step. $Shrink reads the corner of the marks' bounding box the mark
// occupies; $Converge reads the quadrant of the box it lies in; $Cross drops
// the box and meets the diagonal rays the marks cast.

#include "../lib.dl"

.type Choice = Shrink {} | Converge {} | Cross {}

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl center_paint(col: Color) center_paint(5).
}

.init params = Params

// --- program ---

.decl impl_choice(ch: Choice)
impl_choice($Shrink()). impl_choice($Converge()). impl_choice($Cross()).

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.decl mini(p: Position, col: Color, ch: Choice)

// The marks' bounding box, read by $Shrink and $Converge alike.
.init box = BoxFrame<Unit>
box.cell($U(), P) :- mark(P, _).
box.grid($U(), P) :- in(P, _).

// The box's center.
.decl center(p: Position)
center(P) :- box.inner($U(), P, P_in), centered(P_in).

// --- Shrink ---

mini(P, Col, $Shrink()) :-
    center(C),
    ( params.center_paint(Col), P = C                         // the center
    ; box.corner($U(), P_mark, Diag), mark(P_mark, Col),      // a mark at its box corner
      neighbor(C, Diag, P)
    ).

// --- Converge ---

.init place = DiagPlacement<Unit>
place.cell($U(), P_in) :- box.inner($U(), _, P_in).

mini(P, Col, $Converge()) :-
    center(C),
    ( params.center_paint(Col), P = C                         // the center
    ; mark(P_mark, Col), box.inner($U(), P_mark, P_in),       // a mark in the box's frame
      place.quadrant($U(), P_in, Diag),                       // the quadrant it lies in
      neighbor(C, Diag, P)
    ).

// --- Cross ---

.init dray = Ray<Unit>
dray.dir($U(), D)  :- diag_dir_elem(D).
dray.cell($U(), P) :- in(P, _).
dray.mark($U(), P) :- mark(P, _).

// On mark M's diagonal toward D, past M itself.
.decl sees(m: Position, p: Position, d: Dir8)
sees(M, P, D) :- dray.ray($U(), P, D, K, M), K != 0.

.decl unseen(p: Position)
unseen(P) :- sees(_, P, _), mark(M, _), !sees(M, P, _).

mini(P, Col, $Cross()) :-
    sees(_, C, _), !unseen(C),                                // where every mark's diagonals meet
    ( params.center_paint(Col), P = C                         // the meeting cell
    ; sees(M, C, D), mark(M, Col),                            // a ray that reached it
      diag_opposite(D, D_back), neighbor(C, D_back, P)        // one step back toward its mark
    ).

// --- out ---

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- mini(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !mini(P, _, Ch).
