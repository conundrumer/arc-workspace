// 11e1fe23
// @keywords: scale move cross
// input: colored marks sit at the corners of a square.
// output: the output keeps the marks and adds a small copy of them at the
//  square's center: each mark's color one diagonal step out, and the center
//  painted. the cases differ in how a mark finds its step:

// how a mark finds its step
.type Choice =
    // the corner of the marks' bounding box the mark occupies
    Shrink {}
    // the quadrant of the box it lies in
  | Converge {}
    // drops the box and meets the diagonal rays the marks cast
  | Cross {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl center_paint(col: Color) center_paint(5).
}

.init params = Params

// --- program ---

.decl impl_choice(ch: Choice)
impl_choice($Shrink()). impl_choice($Converge()). impl_choice($Cross()).

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.decl mini(p: Position, col: Color, ch: Choice)

// The marks' bounding box, read by $Shrink and $Converge alike.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- mark(P, _).

// The grid cells the box covers, in the box's own frame.
.decl view(p: Position, p_inner: Position)
view(P, P_inner) :- in(P, _), bbox.box($U(), B), crop(P, B, P_inner).

// The box's center.
.decl center(p: Position)
center(P) :- view(P, P_inner), centered(P_inner).

// --- $Shrink ---

mini(P, Col, $Shrink()) :-
    center(C),
    ( params.center_paint(Col), P = C                         // the center
    ; mark(P_mark, Col), bbox.box($U(), B),
      box_corner(P_mark, B, Diag),                            // a mark at its box corner
      neighbor(C, Diag, P)
    ).

// --- $Converge ---

.init place = DiagPlacement<Unit>
place.cell($U(), P_inner) :- view(_, P_inner).

mini(P, Col, $Converge()) :-
    center(C),
    ( params.center_paint(Col), P = C                         // the center
    ; mark(P_mark, Col), view(P_mark, P_inner),               // a mark in the box's frame
      place.quadrant($U(), P_inner, Diag),                    // the quadrant it lies in
      neighbor(C, Diag, P)
    ).

// --- $Cross ---

.init dray = Ray<Unit>
dray.dir($U(), D)  :- diag_dir_elem(D).
dray.cell($U(), P) :- in(P, _).
dray.mark($U(), P) :- mark(P, _).

// On mark M's diagonal toward D, past M itself.
.decl sees(m: Position, p: Position, d: Dir8)
sees(M, P, D) :- dray.ray($U(), P, D, K, M), K != 0.

.decl unseen(p: Position)
unseen(P) :- sees(_, P, _), mark(M, _), !sees(M, P, _).

mini(P, Col, $Cross()) :-
    sees(_, C, _), !unseen(C),                                // where every mark's diagonals meet
    ( params.center_paint(Col), P = C                         // the meeting cell
    ; sees(M, C, D), mark(M, Col),                            // a ray that reached it
      diag_opposite(D, D_back), neighbor(C, D_back, P)        // one step back toward its mark
    ).

// --- out ---

out(P, Col, Ch) :- mini(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !mini(P, _, Ch).
