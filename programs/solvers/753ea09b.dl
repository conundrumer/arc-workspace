// 753ea09b
// draft
// concept: objects border enclose
// Two rails run edge to edge across the grid, with rungs of a second ink
// color between them; the bg between the rails takes the rail color.
//
// The bg is the commonest color and the rail color the commonest ink. A
// rail is an 8-connected rail-colored component that touches the grid
// edge, so rail-colored fragments off the edge are not rails. The non-rail
// cells split into 4-connected regions, and a region beside two distinct
// rails lies between them.

#include "../lib.dl"

.comp Params {}

.init params = Params

.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.init ink_mode = Mode<Unit, Color, Position>
ink_mode.item($U(), Col, P) :- in(P, Col), !bg_mode.mode($U(), Col).

.decl rail_cell(p: Position)
rail_cell(P) :- in(P, Col), ink_mode.mode($U(), Col).

.init rails = Components8<Unit>
rails.node($U(), P) :- rail_cell(P).

// A rail reaches the grid edge.
.decl rail(id: Ident)
rail(Id) :- rails.label($U(), P, Id), dir_elem(D), dist(P, D, 0).

.init regions = Components<Unit>
regions.node($U(), P) :- in(P, _), !rail_cell(P).

// A region touches a rail.
.decl beside(region: Ident, rail: Ident)
beside(R, Id) :- regions.label($U(), P, R), neighbor(P, _, Q), rails.label($U(), Q, Id), rail(Id).

// A region beside two distinct rails lies between them.
.decl between(region: Ident)
between(R) :- beside(R, Id), beside(R, Id2), Id != Id2.

.decl fill(p: Position)
fill(P) :- in(P, Col), bg_mode.mode($U(), Col), regions.label($U(), P, R), between(R).

.decl out(p: Position, col: Color)
out(P, Col) :- fill(P), ink_mode.mode($U(), Col).
out(P, Col) :- in(P, Col), !fill(P).
