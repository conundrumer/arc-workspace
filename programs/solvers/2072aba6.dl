// 2072aba6
// @keywords: scale wallpaper stamp
// output: 2x scale-up: ink cells become checkered tiles, bg cells blank
//  tiles.

// Two models of the checker phase, tagged on out's Choice. They coincide at
// scale 2: every tile anchors at even parity.
.type Choice =
    // each ink cell hosts a stored template
    Table {}
    // one grid-global checkerboard, corner-anchored, masked to the scaled ink
    // silhouette
  | Checker {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).
    .decl ink(c: Color) ink(5).

    .decl scale(k: number) scale(2).
    .decl intile(p: Position)
    intile(P) :- scale(K), helpers.frame_pos([K, K], P).

    // --- $Table ---
    .decl template(p: Position, col: Color)
    GRID_2x2(template,
        1, 2,
        2, 1)

    // --- $Checker ---
    // Even frame dims: both corners of seed_diag seed the same phase.
    .decl seed_diag(da: DiagAxis) seed_diag(DAXIS_DG).
    .decl corner(d: DiagDir)
    corner(D) :- seed_diag(DA), diag_axis_of(D, DA).
    // The color at each phase of the cycle, phase 0 at the anchor corner.
    .decl phase_color(k: number, col: Color)
    phase_color(0, 1).
    phase_color(1, 2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Table()). impl_choice($Checker()).

// Output decomposition: input cell as tile index × intile position.
.decl cell(p_grid: Position, p_tile: Position, p_intile: Position)
cell(P_grid_out, P_tile, P_intile) :-
    in(P_tile, _), params.intile(P_intile),       // tile × intile
    concat_2d(P_tile, P_intile, 0, P_grid_out).   // 2D recompose

// Output cells over ink input cells — the scaled silhouette.
.decl inked(p_grid: Position, p_intile: Position)
inked(P_grid_out, P_intile) :-
    cell(P_grid_out, P_tile, P_intile),
    in(P_tile, Ink), params.ink(Ink).

// Blank outside the silhouette — shared.
out(P_grid_out, Bg, Ch) :-
    impl_choice(Ch), cell(P_grid_out, _, _),
    !inked(P_grid_out, _), params.bg(Bg).

// --- $Table ---
out(P_grid_out, Col, $Table()) :-
    inked(P_grid_out, P_intile), params.template(P_intile, Col).

// --- $Checker ---
// The length of the color cycle.
.init phases = Tally<Unit, number>
phases.item($U(), K) :- params.phase_color(K, _).
phases.domain($U()).

// Grid-global coloring: each unit step from the anchor corner advances the
// color cycle by one phase.
.decl checker(p: Position, col: Color)
checker(P, Col) :-
    cell(P, _, _),                                       // output frame cell
    params.corner(Diag), corner_dist(P, Diag, T),        // steps from the anchor corner
    phases.tally($U(), N), stride(T, N, 0, _, K),        // folded into the cycle
    params.phase_color(K, Col).

out(P_grid_out, Col, $Checker()) :-
    inked(P_grid_out, _), checker(P_grid_out, Col).

.comp Determine {
    // The output cells over ink input cells, with their place in the tile.
    .decl inked(e: Example, p_grid: Position, p_intile: Position, col: Color)
    inked(E, P_grid_out, P_intile, Col) :-
        ex_in(E, P_tile, Ink), params.ink(Ink),            // ink input cell
        params.intile(P_intile),
        concat_2d(P_tile, P_intile, 0, P_grid_out),        // its output tile cell
        ex_out(E, P_grid_out, Col).

    // Every ink cell's output tile.
    .decl template(p: Position, col: Color)
    template(P_intile, Col) :- inked(_, _, P_intile, Col).

    // The cycle is as long as the colors the silhouette holds.
    .init phases = Tally<Unit, Color>
    phases.item($U(), Col) :- inked(_, _, _, Col).
    phases.domain($U()).

    .decl phase_color(k: number, col: Color)
    phase_color(K, Col) :-
        inked(_, P, _, Col),                                 // a silhouette cell
        params.corner(Diag), corner_dist(P, Diag, T),        // steps from the anchor corner
        phases.tally($U(), N), stride(T, N, 0, _, K).        // folded into the cycle
}
