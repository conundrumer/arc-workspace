// 2072aba6
// concept: scale wallpaper stamp
// 2× scale-up: ink cells become checkered tiles, bg cells blank tiles.
// Two models of the checker phase, tagged on out's Choice:
//   $Tile    — each ink cell hosts a stored template.
//   $Checker — one grid-global checkerboard, corner-anchored, masked to
//              the scaled ink silhouette.
//
// Coincide at scale 2: every tile anchors at even parity.

#include "../lib.dl"

.type Choice = Tile {} | Checker {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- shared ---
    .decl bg(c: Color)   bg(0).
    .decl ink(c: Color)  ink(5).

    .decl intile(p: Position)
    intile(P) :- helpers.frame_pos([2, 2], P).

    // --- Tile ---
    .decl template(p: Position, col: Color)
    GRID_2x2(template,
        1, 2,
        2, 1)

    // --- Checker ---
    .decl corner(d: DiagDir)        corner(DIAG_TL).
    .decl corner_color(col: Color)  corner_color(1).

    .decl alt(c1: Color, c2: Color)
    alt(1, 2).
    alt(B, A) :- alt(A, B).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl choice(ch: Choice)
choice($Tile()). choice($Checker()).

// Output decomposition: input cell as tile index × intile position.
.decl cell(p_grid: Position, p_tile: Position, p_intile: Position)
cell(P_grid_out, P_tile, P_intile) :-
    in(P_tile, _), c.intile(P_intile),            // tile × intile
    concat_2d(P_tile, P_intile, 0, P_grid_out).   // 2D recompose

// Output cells over ink input cells — the scaled silhouette.
.decl inked(p_grid: Position, p_intile: Position)
inked(P_grid_out, P_intile) :-
    cell(P_grid_out, P_tile, P_intile),
    in(P_tile, Ink), c.ink(Ink).

.decl out(p: Position, col: Color, ch: Choice)

// Blank outside the silhouette — shared.
out(P_grid_out, Bg, Ch) :-
    choice(Ch), cell(P_grid_out, _, _),
    !inked(P_grid_out, _), c.bg(Bg).

// --- Tile ---
out(P_grid_out, Col, $Tile()) :-
    inked(P_grid_out, P_intile), c.template(P_intile, Col).

// --- Checker ---
// Grid-global 2-coloring: seeded at a corner, each unit step swaps color.
.decl checker(p: Position, col: Color)
checker(P, Col) :-
    cell(P, _, _),                                  // output frame cell
    c.corner(Diag), diag_dist(P, Diag, _, 0, 0),    // at the anchor corner
    c.corner_color(Col).
checker(P2, Col2) :-
    checker(P1, Col1), c.alt(Col1, Col2),                 // next color in the cycle
    dir_elem(D), step_delta(D, S), compose(P1, S, P2),    // any unit step
    cell(P2, _, _).                                       // still on the output frame

out(P_grid_out, Col, $Checker()) :-
    inked(P_grid_out, _), checker(P_grid_out, Col).

.output out(IO=stdout)
