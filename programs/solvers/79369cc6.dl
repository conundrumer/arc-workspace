// 79369cc6
// draft
// keywords: markers stamp d4
// input: The template is the bounding box of the fill-colored cells; its
//  other cells carry the mark color.
// output: Wherever a D4 image of the template's mark cells appears in the
//  grid, the image's fill cells are painted in the fill color. A placement
//  whose fill cell lands on a mark is not a match. A stamp may hang off the
//  grid edge: its marks must all be on the grid, its fill cells need not.

.decl out(p: Position, col: Color)

.comp Params {
    // The color the stamp paints, and the color the stamp matches on.
    .decl fill(c: Color) fill(4).
    .decl mark(c: Color) mark(6).
}

.init params = Params

// --- the template ---

// The template's box, bounding the fill cells.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.fill(Col).

// The template's D4 images, each in its own frame.
.decl image(d: D4, p_inner: Position, col: Color)
image(D, P_turned, Col) :-
    bbox.box($U(), B), in(P, Col), crop(P, B, P_inner),   // a template cell, in the box's frame
    d4_elem(D), apply(D, P_inner, P_turned).

// --- the placements ---

// Each image's mark cells, sought among the grid's mark cells.
.init occ = Occurrences<D4, Unit>
occ.shape(D, P_inner, $U()) :- image(D, P_inner, Col), params.mark(Col).
occ.cell(D, P, $U()) :- d4_elem(D), in(P, Col), params.mark(Col).

// Where an occurrence's fill cells land.
.decl fill_at(d: D4, m: Position, p: Position)
fill_at(D, M, P) :-
    occ.occurrence(D, M), image(D, P_inner, Col), params.fill(Col), compose(M, P_inner, P).

// A placement whose fill cell lands on a mark is not a match.
.decl blocked(d: D4, m: Position)
blocked(D, M) :- fill_at(D, M, P), occ.cell(D, P, $U()).

.decl stamped(p: Position)
stamped(P) :- fill_at(D, M, P), !blocked(D, M).

out(P, Col) :-
    in(P, Col_in),
    ( stamped(P), params.fill(Col)    // painted by a stamp
    ; !stamped(P), Col = Col_in       // kept
    ).
