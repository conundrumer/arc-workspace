// a3325580
// @draft
// @keywords: objects color-class count rank
// @scene objects: a field of params.bg holds one-color objects, each a
//  connected group of cells, cells that touch at a corner included, and no
//  two objects share a color
// @scene apart: the objects with the largest cell count occupy disjoint
//  ranges along params.layout_axis
// @rule largest: the output keeps each object whose cell count equals the
//  largest cell count in the input
// @rule order: the kept objects are ordered from an end of
//  params.layout_axis by a key, the distance from that end to the object's
//  nearest cell, and objects with the same key may take either order; the
//  output is undefined where the two ends give different orders
// @rule columns: the output has one line per kept object, laid out in that
//  order from that end, each filled with that object's color
// @rule height: each line is as long as the largest cell count

// what the cell count and the order are taken over
.type Piece =
    // @claim largest
    Objects {conn: Connect}
    // @rule largest: each color's cells form one unit wherever they lie, and
    //  the colors with the largest total cell count are kept
    // @witness split-color: variant concept
    //     @relaxed objects
  | ColorClass {}

// which cells join one object
.type Connect =
    // @claim objects
    Conn8 {}
    // @scene objects: only cells that share a side join one object
    // @witness diagonal-link: borderline concept
  | Conn4 {}

// which distance to the end of params.layout_axis orders the kept units
.type Rank =
    // @claim order
    NearEdge {}
    // @rule order: the key is read over the unit's line nearest an edge
    //  across params.layout_axis alone, and the output is undefined where the
    //  two edges give different orders
    // @witness narrow-ends: borderline concept
    //     @relaxed apart
  | FirstScan {}

.type Choice = [piece: Piece, rank: Rank]

.type TiebreakResolution =
    End {} | Sit {line: Position, id: Ident, rest: TiebreakResolution}

.decl out(p: Position, col: Color, ch: Choice, res: TiebreakResolution)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed objects
    .decl bg(col: Color) bg(0).

    // The axis the kept units are ordered along and laid out along.
    .decl layout_axis(a: Axis) layout_axis(AXIS_H).
}

.init params = Params

// A unit, under the piece reading that finds it.
.type Part = [pc: Piece, id: Ident]

// A unit, read toward an edge.
.type Lean = [part: Part, d: Dir]

// A case's order from one corner: the corner's side on params.layout_axis is
// the lead end, and its other side the scan edge.
.type View = [ch: Choice, c: DiagDir]

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl piece_choice(pc: Piece)
piece_choice($Objects($Conn8())). piece_choice($Objects($Conn4())). piece_choice($ColorClass()).

.decl cell(pc: Piece, id: Ident, p: Position)

// @claim largest height
.init size = Tally<Part, Position>
size.item([Pc, Id], P) :- cell(Pc, Id, P).

// @claim largest height
.init largest = Extremes<Piece>
largest.cand(Pc, N) :- size.tally([Pc, _], N).

.decl kept(pc: Piece, id: Ident)
kept(Pc, Id) :- size.tally([Pc, Id], N), largest.high(Pc, N).

// @claim columns
.init kept_count = Tally<Piece, Ident>
kept_count.item(Pc, Id) :- kept(Pc, Id).

// The lead end of each corner: its side on the layout axis.
.decl lead_end(c: DiagDir, l: Dir)
lead_end(C, L) :- diag_dir_elem(C), params.layout_axis(A), dir_of(C, A, L).

.init chart = Frame2D<Piece>
chart.extent(Pc, A, K) :- params.layout_axis(A), kept_count.tally(Pc, K).
chart.extent(Pc, A2, N) :- params.layout_axis(A), perp(A, A2), largest.high(Pc, N).

// The chart's line each output cell lies on.
.decl line_of(pc: Piece, p: Position, p_line: Position)
line_of(Pc, P, P_line) :- chart.cell(Pc, P), params.layout_axis(A), split(P, A, P_line, _).

// @claim order
.init obox = Bbox<Part>
obox.cell([Pc, Id], P) :- cell(Pc, Id, P).

.decl view(w: View)

// @claim order
.init order = Order<View, Ident>
order.elem([[Pc, K], C], Id) :- view([[Pc, K], C]), kept(Pc, Id).

// A unit sits no nearer the lead edge than the count of units before it;
// seating them all leaves each the lines of its own tie.
.init ties = TiebreakResolutions<View, Position, Ident>

// A case whose corners give different seatings.
.decl split_res(ch: Choice)
split_res(Ch) :-
    ties.resolution([Ch, C], Res), view([Ch, C2]), !ties.resolution([Ch, C2], Res).

// Each line takes the color of the unit seated on it, where every corner
// gives the same seatings.
out(P, Col, [Pc, K], Res) :-
    line_of(Pc, P, P_line), ties.assign([[Pc, K], _], Res, P_line, Id),
    cell(Pc, Id, Q), in(Q, Col), !split_res([Pc, K]).

// --- $Conn8 ---

// @claim objects
.init objs8 = Components8<Color>
objs8.node(Col, P) :- ink(P, Col).

cell($Objects($Conn8()), Id, P) :- objs8.label(_, P, Id).

// --- $Conn4 ---

// @claim objects
.init objs4 = Components<Color>
objs4.node(Col, P) :- ink(P, Col).

cell($Objects($Conn4()), Id, P) :- objs4.label(_, P, Id).

// --- $ColorClass ---

.init classes = Canon<Position>
classes.equiv(P, Q) :- ink(P, Col), ink(Q, Col).

cell($ColorClass(), Id, P) :- classes.id(P, Id).

// --- $NearEdge ---

view([[Pc, $NearEdge()], C]) :- piece_choice(Pc), diag_dir_elem(C).

ties.cand([[Pc, $NearEdge()], C], P_line, Id) :-
    view([[Pc, $NearEdge()], C]), lead_end(C, L), line_of(Pc, _, P_line), dist(P_line, L, N),
    order.rank([[Pc, $NearEdge()], C], Id, R), R <= N.

order.score([[Pc, $NearEdge()], C], Id, K) :-
    lead_end(C, L), obox.box([Pc, Id], B), dist(B, L, K).

// --- $FirstScan ---

view([[Pc, $FirstScan()], C]) :- piece_choice(Pc), diag_dir_elem(C).

ties.cand([[Pc, $FirstScan()], C], P_line, Id) :-
    view([[Pc, $FirstScan()], C]), lead_end(C, L), line_of(Pc, _, P_line), dist(P_line, L, N),
    order.rank([[Pc, $FirstScan()], C], Id, R), R <= N.

// A unit's line nearest the scan edge.
// @claim order
.init head = Bbox<Lean>
head.cell([[Pc, Id], S], P) :-
    diag_dir_elem(C), params.layout_axis(A), diag_dirs(C, A, _, S),   // scan edge
    obox.box([Pc, Id], B), dist(B, S, K),
    cell(Pc, Id, P), dist(P, S, K).

order.score([[Pc, $FirstScan()], C], Id, K) :-
    view([[Pc, $FirstScan()], C]), params.layout_axis(A), diag_dirs(C, A, L, S),  // lead end, scan edge
    head.box([[Pc, Id], S], B), dist(B, L, K).

.comp Determine {
    // An edge some output contradicts: a line across its axis holds two colors.
    .decl clash(d: Dir)
    clash(D) :-
        ex_out(E, P, C1), ex_out(E, Q, C2), C1 != C2, dir_elem(D), same_dist(D, P, Q).

    .decl layout_axis(a: Axis)
    layout_axis(A) :- dir_elem(D), !clash(D), axis_of(D, A).
}
