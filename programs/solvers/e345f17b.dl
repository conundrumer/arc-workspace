// Layout: 1×2 horizontally-side-by-side 4×4 subgrids. Output is the per-cell pair-fold.
//
// Cartesian over (decompose, body) impls; out's choice column tags each:
//
//   decompose:
//     $Tile() — pre-tabulated in Consts via tile_pos
//     $Div()  — derived in body via the divide primitive (c.divide_axis, c.divisor)
//
//   body:
//     $SetMatch(d) — combine table keyed on (outer pos, color); count-trick match
//     $Nor(d)      — NOR via negation-of-existence: no non-BG input contribution

#include "../lib.dl"

.type DecChoice = Tile {} | Div {}
.type Choice = SetMatch { d: DecChoice } | Nor { d: DecChoice }

.comp Consts {
    .decl frame(p: Position)
    frame(P) :- frame_pos([4, 4], P).

    // --- Tile decompose data ----------------------------------------------
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :- tile_pos([1, 2], [4, 4], [0, 0], P_grid, P_tile, P_intile).

    // --- Div decompose data -----------------------------------------------
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(HORIZONTAL).

    // --- SetMatch body data -----------------------------------------------
    .decl combine_member(eid: number, p_outer: Position, c: Color)
    .decl combine_out(eid: number, c_out: Color)

    combine_member(0, [0,0,0,1], 0). combine_member(0, [0,0,1,0], 0). combine_out(0, 4).
    combine_member(1, [0,0,0,1], 0). combine_member(1, [0,0,1,0], 5). combine_out(1, 0).
    combine_member(2, [0,0,0,1], 6). combine_member(2, [0,0,1,0], 0). combine_out(2, 0).
    combine_member(3, [0,0,0,1], 6). combine_member(3, [0,0,1,0], 5). combine_out(3, 0).

    // --- Nor body data ----------------------------------------------------
    .decl bg(c: Color)        bg(0).
    .decl out_fill(c: Color)  out_fill(4).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// --- Decompose variants ----------------------------------------------------

.decl dec_choice(dc: DecChoice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.divide_axis(A), c.divisor(N),                      // params
    divide_slab(P_grid, A, N, 0, P_tile, P_intile).

// --- Nor body: filled relation parameterized by decompose choice -----------

.decl filled(o: Position, dc: DecChoice)
filled(P_grid_out, Dc) :-
    in(P_grid_in, Col), !c.bg(Col),                 // non-bg input cell
    decompose(P_grid_in, _, P_grid_out, Dc).        // decomposes to output cell

// --- Output: cartesian over (DecChoice, body) ------------------------------

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col_out, $SetMatch(Dc)) :-
    dec_choice(Dc),
    c.frame(P_grid_out),
    c.combine_out(Eid, Col_out),
    N = count : { c.combine_member(Eid, _, _) },                  // members in entry
    N = count : { c.combine_member(Eid, P_tile, C),               // members matched
                  decompose(P_grid_in, P_tile, P_grid_out, Dc),
                  in(P_grid_in, C) }.

out(P_grid_out, Col, $Nor(Dc)) :-
    dec_choice(Dc), c.frame(P_grid_out),        // choice × cell
    !filled(P_grid_out, Dc),                    // NOR=1: no contribution
    c.out_fill(Col).
out(P_grid_out, Col, $Nor(Dc)) :-
    dec_choice(Dc), c.frame(P_grid_out),        // choice × cell
    filled(P_grid_out, Dc),                     // NOR=0: some contribution
    c.bg(Col).

.output out(IO=stdout)
