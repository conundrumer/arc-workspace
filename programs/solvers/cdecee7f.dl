// cdecee7f
// @draft
// @keywords: objects rank walk count
// @scene scattered-dots: on a 10×10 field of params.bg, a set of single
//  colored cells, no two touching, even at a corner, no two in the same line
//  across params.scan_dir, and no more of them than the cells of a
//  params.out_size grid
// @rule scan-order: the dots are ranked by their distance from the
//  params.scan_dir edge of the input
// @rule snake-fill: the output is a params.out_size grid whose cells, in a
//  snake path, take the dots' colors in rank order: the path starts at the
//  params.fill_corner corner, runs along params.fill_axis to the far edge,
//  steps one line across, and runs back, each line in the opposite direction
//  from the one before
// @rule empty-rest: the output cells past the last dot on the path are
//  params.bg

// what one dot is
.type DotUnit =
    // @claim scattered-dots
    Cell {}
    // @scene scattered-dots: each connected group of cells of one color is a
    //  dot, which takes its color and is ranked by its line nearest the
    //  params.scan_dir edge; undefined where two groups share that line
    // @witness touching-same-color-row: foreign concept
    //     @relaxed scattered-dots
  | Objects {adj: Adjacency}

// which cells of a group touch
.type Adjacency =
    // @claim scattered-dots
    Adj4 {}
    // @scene scattered-dots: cells that meet at a corner join one group
    // @witness touching-same-color-corner: foreign concept
    //     @relaxed scattered-dots
  | Diag8 {}

// which output cell each rank takes
.type FillPath =
    // @claim snake-fill
    Snake {size: OutSize}
    // @rule snake-fill: a stored table params.fill_order gives the output cell
    //  of each rank, and the output's frame is the frame of those cells
    // @witness raster-path: ordinary $StoredPath
    //     @reassigned fill_order
  | StoredPath {}

// the output's size
.type OutSize =
    // @claim snake-fill
    StoredSize {}
    // @rule snake-fill: the output is the least square with at least as many
    //  cells as there are dots
    // @witness four-dots: ordinary concept
    // @witness ten-dots: borderline $FitSquare
    //     @relaxed scattered-dots
  | FitSquare {}

.type Choice = [unit: DotUnit, path: FillPath]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed scattered-dots
    .decl bg(col: Color) bg(0).

    // The edge the dots are ranked from.
    .decl scan_dir(d: Dir) scan_dir(DIR_L).

    // --- $Snake ---
    // The output corner the snake path starts at.
    .decl fill_corner(c: DiagDir) fill_corner(DIAG_TL).

    // The axis of the path's lines.
    .decl fill_axis(a: Axis) fill_axis(AXIS_H).

    // --- $StoredSize ---
    .decl out_size(a: Axis, n: number) out_size(AXIS_V, 3). out_size(AXIS_H, 3).

    // --- $StoredPath ---
    // The rank of the dot each output cell takes.
    .decl fill_order(p: Position, r: number)
    GRID_3x3(fill_order,
        0, 1, 2,
        5, 4, 3,
        6, 7, 8)
}

.init params = Params

.decl dot_unit_choice(u: DotUnit)
dot_unit_choice($Cell()).
dot_unit_choice($Objects($Adj4())). dot_unit_choice($Objects($Diag8())).

// A dot, under the unit reading that finds it.
.type Part = [u: DotUnit, id: Ident]

// The output frame of one unit reading and size reading.
.type Canvas = [u: DotUnit, s: OutSize]

// A cell of the snake path, with the direction the path runs there.
.type Heading = [p: Position, d: Dir]

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl dot_cell(u: DotUnit, id: Ident, p: Position)

// @claim scan-order
.init dot_box = Bbox<Part>
dot_box.cell([U, Id], P) :- dot_cell(U, Id, P).

// A dot's distance from the scan edge.
.decl reach(u: DotUnit, id: Ident, k: number)
reach(U, Id, K) :- dot_box.box([U, Id], B), params.scan_dir(D), dist(B, D, K).

// Two dots at one distance from the scan edge.
.decl tied(u: DotUnit)
tied(U) :- reach(U, Id1, K), reach(U, Id2, K), Id1 != Id2.

// @claim scan-order
.init scan = Order<DotUnit, Ident>
scan.elem(U, Id) :- dot_cell(U, Id, _).
scan.before(U, A, B) :- reach(U, A, K1), reach(U, B, K2), K1 < K2.

.decl dot_rank(u: DotUnit, id: Ident, r: number)
dot_rank(U, Id, R) :- scan.rank(U, Id, R), !tied(U).

// @claim empty-rest
.init last = Extremes<DotUnit>
last.cand(U, R) :- dot_rank(U, _, R).

// The output cells of each unit reading and path reading, with each cell's
// place on the path.
.decl slot(u: DotUnit, f: FillPath, p: Position, r: number)

out(P, Col, [U, F]) :-
    slot(U, F, P, R),
    ( dot_rank(U, Id, R), dot_cell(U, Id, Q), in(Q, Col)   // the dot at this place
    ; last.high(U, R2), R > R2, params.bg(Col)         // past the last dot
    ).

// --- $Cell ---
// @claim scattered-dots
.init cell_id = IdentOf<Position>
cell_id.value(P) :- ink(P, _).

dot_cell($Cell(), Id, P) :- cell_id.id(P, Id).

// --- $Adj4 ---
// @claim scattered-dots
.init group4 = Components<Color>
group4.node(Col, P) :- ink(P, Col).

dot_cell($Objects($Adj4()), Id, P) :- group4.label(_, P, Id).

// --- $Diag8 ---
// @claim scattered-dots
.init group8 = Components8<Color>
group8.node(Col, P) :- ink(P, Col).

dot_cell($Objects($Diag8()), Id, P) :- group8.label(_, P, Id).

// --- $Snake ---
// The direction of the path's first line, and the step from line to line.
.decl course(d: Dir, d_step: Dir)
course(D, D_step) :-
    params.fill_corner(C), params.fill_axis(A), diag_dirs(C, A, E, E_step),
    opposite(E, D), opposite(E_step, D_step).

// The output frame of each unit reading and size reading.
.decl canvas(u: DotUnit, s: OutSize, p: Position)

// The path's place of each cell: its steps from the start corner.
// @claim snake-fill
.init walk = GraphDistance<Canvas, Heading>
walk.seed([U, S], [P, D]) :-
    canvas(U, S, P), params.fill_corner(C), corner_dist(P, C, 0), course(D, _).
walk.edge([U, S], [P, D], [Q, D2]) :-
    canvas(U, S, P), params.fill_axis(A), axis_of(D, A), course(_, D_step),
    ( !dist(P, D, 0), neighbor(P, D, Q), D2 = D                   // along the line
    ; dist(P, D, 0), !dist(P, D_step, 0), neighbor(P, D_step, Q), // onto the next line
      opposite(D, D2)
    ).

slot(U, $Snake(S), P, R) :- walk.distance([U, S], [P, _], R).

// --- $StoredSize ---
.init frame = Frame2D<Unit>
frame.extent($U(), A, N) :- params.out_size(A, N).

canvas(U, $StoredSize(), P) :- dot_unit_choice(U), frame.cell($U(), P).

// --- $FitSquare ---
// The side of each square no larger than the input.
.decl side(k: number)
side(K) :- in(P, _), axis_elem(A), ( sub_extent(P, A, K) ; axis_dim(P, A, K) ).

.init square = Frame2D<number>
square.extent(K, A, K) :- side(K), axis_elem(A).

// @claim snake-fill
.init square_size = Tally<number, Position>
square_size.item(K, P) :- square.cell(K, P).

// @claim snake-fill
.init dot_count = Tally<DotUnit, Ident>
dot_count.item(U, Id) :- dot_cell(U, Id, _).

// @claim snake-fill
// @ignore low: store — a stored side is $StoredSize at a square params.out_size, which subsumes it
// @ignore cand: store — only the least side is read, so a stored set stores least.low
.init least = Extremes<DotUnit>
least.cand(U, K) :- square_size.tally(K, N), dot_count.tally(U, M), M <= N.

canvas(U, $FitSquare(), P) :- least.low(U, K), square.cell(K, P).

// --- $StoredPath ---
slot(U, $StoredPath(), P, R) :- dot_unit_choice(U), params.fill_order(P, R).

.comp Determine {
    .init commonest = Mode<Example, Color, Position>
    commonest.item(E, Col, P) :- ex_in(E, P, Col).

    // A color that is not the commonest of some train input.
    .decl not_field(col: Color)
    not_field(Col) :- ex_in(_, _, Col), ex_out(E, _, _), !commonest.mode(E, Col).

    .decl bg(col: Color)
    bg(Col) :- ex_in(_, _, Col), !not_field(Col).

    .decl out_size(a: Axis, n: number)
    out_size(A, N) :- ex_out(_, P, _), axis_elem(A), axis_dim(P, A, N).
}
