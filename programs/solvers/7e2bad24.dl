// 7e2bad24
// @draft
// @keywords: markers walk
// input: A diagonal segment of ray color seeds a beam that extends from both
//  of its ends.
// output: The beam paints the cells it crosses: empty cells and transparent
//  walls. A reflective wall turns the beam without being entered. The beam
//  ends at the grid edge.

// how a reflective wall turns the beam
.type Choice =
    // inverts each component of the heading whose side is blocked by a
    // reflective cell
    Contact {}
    // reads the wall ahead as a line and reflects the heading across it
  | WallAxis {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color)
    bg(0).

    // The beam's color, which is the seed's.
    .decl ray(col: Color)
    ray(1).

    // Walls the beam passes through.
    .decl transparent(col: Color)
    transparent(3).

    // Walls the beam turns at.
    .decl reflective(col: Color)
    reflective(2).

    // The cells the beam may enter.
    .decl passable(col: Color)
    passable(Col) :- bg(Col).
    passable(Col) :- transparent(Col).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Contact()). impl_choice($WallAxis()).

// A reflective wall cell.
.decl wall(p: Position)
wall(P) :- in(P, Col), params.reflective(Col).

// A beam at a cell, with its heading.
.type Beam = [p: Position, d: DiagDir]

// The beam's walk: a beam heading d at p moves on to the next cell, or turns.
.init walk = Propagation<Choice, Beam>

// The seed continues from p toward d.
.decl seed_dir(p: Position, d: DiagDir)
seed_dir(P, D) :-
    in(P, Col), params.ray(Col), diag_dir_elem(D), neighbor(P, D, Q), in(Q, Col).

// The beam launches from each end of the seed, heading away from it.
walk.source(Ch, [P, D]) :-
    impl_choice(Ch), diag_opposite(D, D_back),
    seed_dir(P, D_back), !seed_dir(P, D).

// The beam leaving p heading d enters the next cell when it is passable.
.decl step(p: Position, d: DiagDir, q: Position)
step(P, D, Q) :-
    in(Q, Col), params.passable(Col),
    diag_opposite(D, D_back), neighbor(Q, D_back, P),   // the cell the beam steps from
    in(P, _).

// --- $Contact ---

// A beam at p is blocked toward d: a wall cell lies one step that way.
.decl side(p: Position, d: Dir)
side(P, D) :- in(P, _), dir_elem(D), neighbor(P, D, Q), wall(Q).

// One outgoing component of a heading at a cell beside a wall, inverted
// where its side blocks.
.decl leave_dir(p: Position, d: DiagDir, d_out: Dir)
leave_dir(P, D, D_out) :-
    side(P, _), diag_dirs(D, _, D_cmp, _),
    ( side(P, D_cmp), opposite(D_cmp, D_out)
    ; !side(P, D_cmp), D_out = D_cmp
    ).

// The heading the beam leaves p with, its two components recombined.
.decl bounce(p: Position, d: DiagDir, d_out: DiagDir)
bounce(P, D, D_out) :-
    leave_dir(P, D, D1), leave_dir(P, D, D2),
    diag_dirs(D_out, _, D1, D2).

walk.edge($Contact(), [P, D], [Q, D_out]) :- bounce(P, D, D_out), step(P, D_out, Q).
// Away from every wall, the beam keeps its heading.
walk.edge($Contact(), [P, D], [Q, D]) :- step(P, D, Q), !side(P, _).

// --- $WallAxis ---

// The wall runs along axis a at p: another wall cell lies beside p on that axis.
.decl wall_axis(p: Position, a: Axis)
wall_axis(P, A) :- wall(P), axis_of(D, A), neighbor(P, D, Q), wall(Q).

// A beam facing a wall turns in place: its heading reflects across the wall's
// line, and the turned beam faces its next cell from p again.
walk.edge($WallAxis(), [P, D], [P, D_out]) :-
    in(P, _), diag_dir_elem(D), neighbor(P, D, Q), wall_axis(Q, A),
    perp(A, A_flip), flip_of(A_flip, F), apply_diag_dir(F, D, D_out).

// Every heading leaves; the step into a wall finds no passable cell.
walk.edge($WallAxis(), [P, D], [Q, D]) :- step(P, D, Q).

// --- output ---

// The beam reaches p.
.decl enter(p: Position, ch: Choice)
enter(P, Ch) :- walk.reached(Ch, [P, _]).

out(P, Col, Ch) :- enter(P, Ch), params.ray(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !enter(P, Ch).
