// 7ec998c9
// @draft
// @keywords: markers cast parity
// input: A single mark sits on a plain field.
// output: The mark's line along the axis is drawn in the line color, and
//  where it meets each edge it turns and runs along that edge to the corner:
//  a Z or an S through the mark. Both turns take one sense, the mark's shade
//  on a checkerboard anchored at a corner.

.decl out(p: Position, col: Color)

.comp Params {
    // The Z's color.
    .decl line(col: Color) line(1).

    // The axis of the mark's own line, the stem of the Z.
    .decl axis(a: Axis) axis(AXIS_V).

    // The checkerboard's anchor corner, and the sense its shade turns by.
    // Every grid is square, so the pairs do not separate DIAG_TL from DIAG_BR.
    .decl corner(d: DiagDir) corner(DIAG_TL).
    .decl corner_sense(s: Sense) corner_sense(SENSE_CW).
}

.init params = Params

// The field is the commonest color; the mark is the cell that differs.
.init field = Mode<Unit, Color, Position>
field.item($U(), Col, P) :- in(P, Col).

.decl mark(p: Position)
mark(P) :- in(P, Col), !field.mode($U(), Col).

// The mark's distance in unit steps from the checkerboard's anchor corner.
.decl corner_steps(k: number)
corner_steps(K) :- mark(P), params.corner(Diag), corner_dist(P, Diag, K).

// The checkerboard: the anchor corner cell takes params.corner_sense, and
// each unit step swaps sense.
.init checker = CycleWalk<Unit, Sense>
checker.succ($U(), S, S2) :- sense_elem(S), sense_elem(S2), S != S2.   // the other sense
checker.step($U(), K) :- corner_steps(K).

// The mark's shade.
.decl shade(s: Sense)
shade(S) :- corner_steps(K), params.corner_sense(S0), checker.walk($U(), S0, K, S).

// The Z's stem: rays from the mark both ways along the axis, keyed by their
// cast direction.
.init stem = Ray<Dir>
stem.dir(D, D) :- params.axis(A), axis_of(D, A).
stem.cell(D, P) :- stem.dir(D, _), in(P, _), !mark(P).
stem.mark(D, P) :- stem.dir(D, _), mark(P).

// The Z's arms: each casts from the stem's end on the edge, in the direction
// the mark's shade turns to.
.init arm = Ray<Dir>
arm.dir(D, D) :- dir_elem(D).
arm.cell(D, P) :- dir_elem(D), in(P, _), !mark(P).
arm.mark(D2, P) :-
    mark(M), stem.cast(D, P, D, _, M), dist(P, D, 0),   // the stem's end on edge D
    shade(S), turn(S, D, D2).

.decl lit(p: Position)
lit(P) :- ( stem.ray(_, P, _, _, _) ; arm.ray(_, P, _, _, _) ).

out(P, Col) :-
    in(P, Col_in),
    ( lit(P), params.line(Col)     // the Z
    ; !lit(P), Col = Col_in        // untouched field
    ).
