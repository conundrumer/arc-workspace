// 7ec998c9
// @draft
// @keywords: markers cast parity
// input: A single mark sits on a plain field.
// output: The mark's line along the axis is drawn in the line color, and
//  where it meets each edge it turns and runs along that edge to the corner:
//  a Z or an S through the mark. Both turns take one sense, the mark's shade
//  on a checkerboard anchored at a corner.

.decl out(p: Position, col: Color)

.comp Params {
    // The Z's color.
    .decl line(col: Color) line(1).

    // The axis of the mark's own line, the stem of the Z.
    .decl axis(a: Axis) axis(AXIS_V).

    // The checkerboard's anchor corner, and the sense its shade turns by.
    // Every grid is square, so the pairs do not separate DIAG_TL from DIAG_BR.
    .decl corner(d: DiagDir) corner(DIAG_TL).
    .decl corner_sense(s: Sense) corner_sense(SENSE_CW).
}

.init params = Params

// The field is the commonest color; the mark is the cell that differs.
.init field = Mode<Unit, Color, Position>
field.item($U(), Col, P) :- in(P, Col).

.decl mark(p: Position)
mark(P) :- in(P, Col), !field.mode($U(), Col).

// The checkerboard: seeded at the anchor corner, each unit step swaps
// sense.
.decl shade(p: Position, s: Sense)
shade(P, S) :-
    in(P, _), params.corner(Diag), corner_dist(P, Diag, 0),   // the anchor corner cell
    params.corner_sense(S).
shade(Q, S2) :-
    shade(P, S), sense_elem(S2), S2 != S,   // the other sense
    dir_elem(D), neighbor(P, D, Q), in(Q, _).

// The Z's legs: rays keyed by their cast direction. The stem casts from
// the mark both ways along the axis; each arm casts from the stem's end
// on the edge, in the direction the mark's shade turns to.
.init leg = Ray<Dir>
leg.dir(D, D) :- dir_elem(D).
leg.cell(D, P) :- dir_elem(D), in(P, _), !mark(P).

leg.mark(D, P) :- params.axis(A), axis_of(D, A), mark(P).
leg.mark(D2, P) :-
    mark(M), leg.cast(D, P, D, _, M), dist(P, D, 0),   // the stem's end on edge D
    shade(M, S), turn(S, D, D2).

.decl lit(p: Position)
lit(P) :- leg.ray(_, P, _, _, _).

out(P, Col) :-
    in(P, Col_in),
    ( lit(P), params.line(Col)     // the Z
    ; !lit(P), Col = Col_in        // untouched field
    ).
