// 27a77e38
// draft
// concept: decompose count
// A field of colors fills one half of the grid; a gray line and blank cells
// fill the rest. The output copies the input and stamps a commonest color on
// the far edge, centered. Cases for the domain the count runs over —
// data-equivalent here, since no field cell carries a ground color:
//   $Half — the half of the grid the field lies in
//   $Ink  — every cell whose color is not a ground color

#include "../lib.dl"

.type Choice = Half {} | Ink {}

.comp Params {
    // --- shared ---
    // The half the field lies in.
    .decl field_dir(d: Dir) field_dir(DIR_T).

    // --- Ink ---
    // The ground: the blank cells' color and the line's.
    .decl ground(col: Color)
    ground(0). ground(5).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Half()). impl_choice($Ink()).

.init tally = Mode<Choice, Color, Position>

.decl target(p: Position)
target(P) :-
    in(P, _), params.field_dir(D),
    opposite(D, D_far), dist(P, D_far, 0),    // on the edge away from the field
    perp_dir(D, D2), dist_pair(P, D2, K, K).  // centered across the split

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- in(P, Col), !target(P), impl_choice(Ch).
out(P, Col, Ch) :- target(P), tally.mode(Ch, Col).

// --- Half ---
tally.item($Half(), Col, P) :-
    in(P, Col), params.field_dir(D),  // input cell, and the field's side
    dist_pair(P, D, K, K2), K < K2.   // strictly nearer it — the center line is in neither half

// --- Ink ---
tally.item($Ink(), Col, P) :- in(P, Col), !params.ground(Col).
