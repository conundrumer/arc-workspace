// 37ce87bb
// concept: lines count border
// Bars stand on the base edge: add-colored bars contribute their height,
// sub-colored bars cancel it. A result bar of the summed height is
// appended in its own line. Two models of that line:
//
//   $Next — the bar spacing continues one pitch past the bars.
//   $Edge — the line at params.margin from a fixed across edge.
//
// The models coincide here (every grid ends one pitch past the last bar);
// they diverge on a wider grid.

#include "../lib.dl"

.type Choice = Next {} | Edge {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(7).
    .decl base(d: Dir) base(DIR_B).       // edge the bars stand on
    .decl add(c: Color) add(8).           // bar color that adds its height
    .decl sub(c: Color) sub(2).           // bar color that cancels height
    .decl result(c: Color) result(5).     // the appended bar's color

    // --- $Next ---
    .decl pitch(k: number) pitch(2).      // line step between adjacent bars

    // --- $Edge ---
    .decl sense(s: Sense) sense(SENSE_CC). // base turned toward the result-line edge
    .decl margin(k: number) margin(1).       // result line's distance from that edge
}

.init params = Params

// A cell's line — bars run along the base axis; the across component
// identifies the line.
.decl line_of(p: Position, p_line: Position)
line_of(P, P_line) :- in(P, _), params.base(D), axis_of(D, A), split(P, A, _, P_line).

// Lines holding a bar.
.decl bar_line(p_line: Position)
bar_line(P_line) :- in(P, Col), !params.bg(Col), line_of(P, P_line).

// The summed height: add cells beyond sub cells.
.init height = Excess<Unit, Position>
height.plus($U(), P) :- in(P, Col), params.add(Col).
height.minus($U(), P) :- in(P, Col), params.sub(Col).

.decl result_line(p_line: Position, ch: Choice)

// --- $Next ---
// One pitch from a bar line, either way across, on a barless grid line.
// Off-grid candidates filter themselves out; inward candidates land on a
// neighbor bar.
result_line(P_line2, $Next()) :-
    bar_line(P_line),
    params.base(D), perp_dir(D, D2),  // either way across
    params.pitch(K), jump(P_line, D2, K, P_line2),
    line_of(_, P_line2), !bar_line(P_line2).

// --- $Edge ---
result_line(P_line, $Edge()) :-
    line_of(_, P_line),
    params.base(D), params.sense(S), turn(S, D, D2),   // the result-line edge
    params.margin(K), dist(P_line, D2, K).

// The result bar: height cells up the result line from the base edge.
.decl result_cell(p: Position, ch: Choice)
result_cell(P, Ch) :-
    line_of(P, P_line), result_line(P_line, Ch),                    // on the result line
    params.base(D), dist(P, D, K), height.excess($U(), N), K < N.   // within the summed height

.decl impl_choice(ch: Choice)
impl_choice($Next()). impl_choice($Edge()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- result_cell(P, Ch), params.result(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !result_cell(P, Ch).
