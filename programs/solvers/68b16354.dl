// 68b16354
// family: 67a3c6ac
// Apply a D4 transform to every cell.

#include "../lib.dl"

.comp Consts {
    .decl transform(d: D4)
    transform(D4_TB).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :- in(P_grid_in, Col), c.transform(D), apply(D, P_grid_in, P_grid_out).

.output out(IO=stdout)
