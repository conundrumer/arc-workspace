// f0df5ff0
// concept: markers stamp
// Noise grid; every params.ink cell paints its surrounding bg cells params.ink.
// Painting does not cascade from painted cells.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl ink(c: Color) ink(1).
}

.init params = Params

// Bg cell beside an ink cell.
.decl painted(p: Position)
painted(P) :-
    in(P, Col), params.bg(Col),          // bg cell
    dir8_elem(D), neighbor(P, D, P2),    // a surrounding cell
    in(P2, Ink), params.ink(Ink).        // ink there

.decl out(p: Position, col: Color)
out(P, Ink) :- painted(P), params.ink(Ink).
out(P, Col) :- in(P, Col), !painted(P).
