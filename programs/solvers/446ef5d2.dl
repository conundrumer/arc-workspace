// 446ef5d2
// @draft
// @keywords: objects markers pack
// output: A picture is drawn over a field color, cut into pieces, and the
//  pieces lie scattered on the background. A mark of its own color sits
//  diagonally off the corner of one piece.
//  The output rebuilds the picture: the pieces pack a rectangle, each used
//  once, with the marked piece where it lies and its marked corner at the
//  rectangle's corner. The rectangle shows only the field along its edge, and
//  where two pieces meet with the picture running off both of the facing sides,
//  the cells they face agree.
//  The packing derives by elimination: a placement that strands a rectangle
//  cell is out, a cell left with one placement forces it, and a placement that
//  clashes with a forced one is out.

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

// --- the colors ---

.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl bg(col: Color)
bg(Col) :- bg_mode.mode($U(), Col).

.init ink_size = Tally<Color, Position>
ink_size.item(Col, P) :- in(P, Col), !bg(Col).

// The picture sits on a field and is drawn in the rest: the field is the
// commonest ink, and the mark is the rarest.
.init by_size = ArgExtremes<Unit, Color>
by_size.cand($U(), Col, N) :- ink_size.tally(Col, N).

.decl mark(col: Color)
mark(Col) :- by_size.low($U(), Col, _).

.decl drawn(col: Color)
drawn(Col) :- ink_size.tally(Col, _), !by_size.high($U(), Col, _), !mark(Col).

// --- the pieces ---

.init pieces = Components<Unit>
pieces.node($U(), P) :- in(P, Col), !bg(Col), !mark(Col).

.decl piece_cell(id: Ident, p: Position, col: Color)
piece_cell(Id, P, Col) :- pieces.label($U(), P, Id), in(P, Col).

.init pbox = Bbox<Ident>
pbox.cell(Id, P) :- pieces.label($U(), P, Id).

.init rim = Rim<Ident>
rim.cell(Id, P) :- pieces.label($U(), P, Id).

// A piece seen from its own box: every cell, and every rim cell with a
// direction that leaves the piece.
.decl shape(id: Ident, p_inner: Position, col: Color)
shape(Id, P_inner, Col) :- piece_cell(Id, P, Col), pbox.box(Id, B), crop(P, B, P_inner).

.decl shape_rim(id: Ident, p_inner: Position, d: Dir, col: Color)
shape_rim(Id, P_inner, D, Col) :-
    shape(Id, P_inner, Col), pbox.box(Id, B), compose(B, P_inner, P),  // a cell of the piece, in the grid
    rim.rim_dir(Id, P, D), dir_elem(D).                                // with the outside one step away

// The picture runs off this side of the piece.
.decl inked_face(id: Ident, d: Dir)
inked_face(Id, D) :- shape_rim(Id, _, D, Col), drawn(Col).

// --- the marked corner ---

.decl anchor(id: Ident, diag: DiagDir, p: Position)
anchor(Id, Diag, P) :-
    piece_cell(Id, P, _), pbox.box(Id, B),        // a piece cell
    box_corner(P, B, Diag),                       // at a corner of its box
    neighbor(P, Diag, Q), in(Q, Col), mark(Col).  // the mark just outside it

// --- the rectangle ---

// A box the marked corner cell spans with a far cell, sitting at that corner
// of the bbox.
.init bbox = Bbox<Position>
bbox.cell(Q, Q) :- in(Q, _).
bbox.cell(Q, A) :- in(Q, _), anchor(_, _, A).

.decl span(b: Box)
span(B) :- anchor(_, Diag, A), bbox.cell(Q, A), bbox.box(Q, B), box_corner(A, B, Diag).

.decl span_cell(b: Box, p: Position)
span_cell(B, P) :- span(B), in(P, _), inside(P, B).

.init span_size = Tally<Box, Position>
span_size.item(B, P) :- span_cell(B, P).

.init piece_area = Tally<Unit, Position>
piece_area.item($U(), P) :- pieces.label($U(), P, _).

// The pieces fill the rectangle exactly, so its cell count is theirs.
.decl rect(b: Box)
rect(B) :- span_size.tally(B, N), piece_area.tally($U(), N).

.decl rect_cell(b: Box, p: Position)
rect_cell(B, P) :- rect(B), span_cell(B, P).

// --- the placements ---

.type Spot = [b: Box, id: Ident]
.type Cand = [id: Ident, b: Box]

.init occ = Occurrences<Spot, Unit>
occ.cell([B, Id], P, $U()) :- rect_cell(B, P), pieces.label($U(), _, Id).
occ.shape([B, Id], P_inner, $U()) :- rect(B), shape(Id, P_inner, _).

.decl place(b: Box, id: Ident, b_occ: Box, p: Position, col: Color)
place(B, Id, B_occ, P, Col) :-
    occ.occurrence([B, Id], B_occ), shape(Id, P_inner, Col), compose(B_occ, P_inner, P).

// A placement showing the picture on the rectangle's edge.
.decl spills(b: Box, id: Ident, b_occ: Box)
spills(B, Id, B_occ) :- place(B, Id, B_occ, P, Col), box_edge(P, B, _), drawn(Col).

// A placement the rectangle admits: it keeps the edge clean, and the marked
// piece holds the place it shows.
.decl fit(b: Box, id: Ident, b_occ: Box)
fit(B, Id, B_occ) :-
    place(B, Id, B_occ, _, _), !spills(B, Id, B_occ),
    ( !anchor(Id, _, _)          // a piece free to move
    ; pbox.box(Id, B_occ) ).     // the marked piece, where it lies

.decl covers(b: Box, cd: Cand, p: Position, col: Color)
covers(B, [Id, B_occ], P, Col) :- fit(B, Id, B_occ), place(B, Id, B_occ, P, Col).

// A placement's rim cell, the direction leaving it, and the rectangle cell
// one step that way.
.decl edge(b: Box, cd: Cand, p: Position, d: Dir, q: Position, col: Color)
edge(B, [Id, B_occ], P, D, Q, Col) :-
    fit(B, Id, B_occ), shape_rim(Id, P_inner, D, Col),  // a rim cell of the piece
    compose(B_occ, P_inner, P), neighbor(P, D, Q),      // placed, and stepped over
    rect_cell(B, Q).                                    // the cell beyond, still inside

// The cells a placement leaves to its neighbours.
.decl demand(b: Box, cd: Cand, q: Position)
demand(B, Cd, Q) :- edge(B, Cd, _, _, Q, _).

// A cell a placement turns the picture toward.
.decl face(b: Box, cd: Cand, p: Position, d: Dir, q: Position, col: Color)
face(B, Cd, P, D, Q, Col) :-
    edge(B, Cd, P, D, Q, Col), Cd = [Id, _], inked_face(Id, D).

// Two placements that cannot stand together: they overlap, they are one
// piece placed twice, or they face each other with different cells.
.decl clash(b: Box, cd: Cand, cd2: Cand)
clash(B, Cd, Cd2) :- covers(B, Cd, P, _), covers(B, Cd2, P, _), Cd != Cd2.
clash(B, [Id, B_occ], [Id, B_occ2]) :- fit(B, Id, B_occ), fit(B, Id, B_occ2), B_occ != B_occ2.
clash(B, Cd, Cd2) :-
    face(B, Cd, P, D, Q, Col), opposite(D, D2),   // one placement facing out
    face(B, Cd2, Q, D2, P, Col2), Col != Col2.    // the other facing back

// A demanded cell some placement can fill beside this one.
.decl mate(b: Box, cd: Cand, q: Position)
mate(B, Cd, Q) :- demand(B, Cd, Q), covers(B, Cd2, Q, _), !clash(B, Cd, Cd2).

// A placement that strands a demanded cell cannot stand.
.decl stranded(b: Box, cd: Cand)
stranded(B, Cd) :- demand(B, Cd, Q), !mate(B, Cd, Q).

.decl cand(b: Box, cd: Cand)
cand(B, [Id, B_occ]) :- fit(B, Id, B_occ), !stranded(B, [Id, B_occ]).

// --- the packing ---

.init forcing = CoverForcing<Box, Cand>
forcing.covers(B, Cd, P) :- cand(B, Cd), covers(B, Cd, P, _).
forcing.conflict(B, Cd, Cd2) :- clash(B, Cd, Cd2).

.decl painted(b: Box, p: Position, col: Color)
painted(B, P, Col) :-
    forcing.forced(B, Cd), !forcing.ruled_out(B, Cd), covers(B, Cd, P, Col).

// A rectangle the elimination leaves incomplete.
.decl unsettled(b: Box)
unsettled(B) :- rect_cell(B, P), !painted(B, P, _).

out(P, Col) :-
    rect(B), !unsettled(B), in(P, _),  // the rectangle the pieces pack
    ( painted(B, P, Col)               // inside it, the picture
    ; !rect_cell(B, P), bg(Col) ).     // outside it, background
