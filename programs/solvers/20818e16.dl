// 20818e16
// @draft
// @keywords: objects rank bbox color-class crop occlude
// input: Solid rectangles, one per color, overlap on a background field. A
//  color's bounding box recovers its whole rectangle, hidden part included.
// output: The output frame is the biggest rectangle, and every rectangle
//  stacks into it aligned at one corner, smallest on top.
// review principle: Cases — ranking the rectangles by perimeter and by extent
//  along a stored axis were dropped beside the shipped cell-count rank, so
//  re-judge each as a case under Fit, Fidelity, and Equivalence.

.decl out(p: Position, col: Color)

.comp Params {
    // The corner the rectangles align to.
    .decl corner(d: DiagDir) corner(DIAG_TL).
}

.init params = Params

// --- background ---

.init field = Mode<Unit, Color, Position>
field.item($U(), Col, P) :- in(P, Col).

// --- rectangles ---

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col), !field.mode($U(), Col).

// The rectangle read in its box's own frame.
.decl rect_cell(col: Color, p_inner: Position)
rect_cell(Col, P_inner) :- in(P_grid, _), bbox.box(Col, B), crop(P_grid, B, P_inner).

.init size = Mode<Unit, Color, Position>
size.item($U(), Col, P_inner) :- rect_cell(Col, P_inner).

// --- stack ---

.decl cover(col: Color, p: Position)
cover(Col, P) :-
    rect_cell(Col, P_inner),
    params.corner(D), corner_anchor(D, P_inner, P),  // aligned at the corner
    size.mode($U(), C_big), rect_cell(C_big, P).     // inside the biggest rectangle

.init top = ArgExtremes<Position, Color>
top.cand(P, Col, N) :- cover(Col, P), size.tally($U(), Col, N).

out(P, Col) :- top.low(P, Col, _).
