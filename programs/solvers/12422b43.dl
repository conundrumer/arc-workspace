// 12422b43
// concept: lines markers stamp
// A params.marker bar anchored at the edge opposite params.flow spans the unit lines;
// ink (non-bg, non-marker) fills the leading lines. The unit lines' ink
// repeats along params.flow over the bg remainder.
//
// Two models place the copies:
//   $Stamp — seat the unit one pattern-length past itself, then step it one
//            unit-length at a time while it stays on the grid.
//   $Tile  — the remainder divides into unit-sized tiles; each tile takes
//            the unit's ink.

#include "../lib.dl"

.type Choice = Stamp {} | Tile {}

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(5).
    .decl flow(d: Dir) flow(DIR_B).
}

.init params = Params

// Cell with its line index from the anchor edge.
.decl cell_line(p: Position, col: Color, r: number)
cell_line(P, Col, R) :- in(P, Col), params.flow(D), opposite(D, O), dist(P, O, R).

// Pattern ink.
.decl ink(p: Position, col: Color, r: number)
ink(P, Col, R) :- cell_line(P, Col, R), !params.bg(Col), !params.marker(Col).

.decl ink_line(r: number)
ink_line(R) :- ink(_, _, R).

.decl marker_line(r: number)
marker_line(R) :- cell_line(_, Col, R), params.marker(Col).

// The unit: ink of the marker-spanned lines.
.decl unit(p: Position, col: Color, r: number)
unit(P, Col, R) :- ink(P, Col, R), marker_line(R).

.init pat_len = Tally<Unit, number>
pat_len.item($U(), R) :- ink_line(R).

.init unit_len = Tally<Unit, number>
unit_len.item($U(), R) :- marker_line(R).

.decl copy(p: Position, col: Color, ch: Choice)

// --- $Stamp ---

copy(P2, Col, $Stamp()) :-
    ( unit(P1, Col, _), pat_len.tally($U(), N)          // seed: one pattern-length on
    ; copy(P1, Col, $Stamp()), unit_len.tally($U(), N)  // grow: one unit-length on
    ),
    params.flow(D), jump(P1, D, N, P2), in(P2, _).   // lands on the grid

// --- $Tile ---

// The remainder: cells of the non-ink lines.
.init region_box = Bbox<Unit>
region_box.cell($U(), P) :- cell_line(P, _, R), !ink_line(R).

copy(P, Col, $Tile()) :-
    region_box.cell($U(), P), region_box.box($U(), B), crop(P, B, P_inner),
    params.flow(D), axis_of(D, A), opposite(D, O),
    unit_len.tally($U(), K), divide_by_size(P_inner, A, K, 0, _, P_intile),  // unit-sized tiles
    dist(P_intile, O, R), unit(P_u, Col, R),   // unit line at the tile offset
    same_line(A, P, P_u).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Stamp()). impl_choice($Tile()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- copy(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !copy(P, _, Ch).
