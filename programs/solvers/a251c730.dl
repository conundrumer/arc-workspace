// a251c730
// @draft
// @keywords: crop objects markers stamp match
// @scene striped-field: the grid is covered by a pattern of one-cell-wide
//  stripes that repeats along one axis
// @scene two-boxes: two rectangles sit on that field, and they do not overlap.
//  Each rectangle is a one-cell-wide frame of one color around an interior
//  filled with one background color, its commonest color.
// @scene template-box: one box holds figures. Each figure is a group of
//  non-background cells joined through edge and corner neighbors, in which
//  exactly one cell, the anchor, has a color that occurs once in the figure.
//  Figures with the same anchor color have the same shape and colors.
//  Undefined when a figure has no such cell or more than one, or when two
//  figures of one anchor color differ.
// @scene anchor-box: the other box holds only lone cells, and each lone cell
//  has the anchor color of some figure in the template box.
// @rule crop-anchor-box: the output is the anchor box, frame included, with
//  its interior background kept.
// @rule stamp-at-anchor: at each lone cell of the anchor box, the output
//  stamps the figure whose anchor color is that cell's color, translated so
//  that the figure's anchor lands on the lone cell. The stamp writes the
//  figure's non-background cells onto the crop, the frame included, and drops
//  those outside it. Undefined where two writes to one cell disagree, a lone
//  cell counting as a write of its own color, and at a lone cell whose color
//  is no figure's anchor color.

// how a figure's anchor cell is found
.type AnchorCell =
    // @claim template-box
    OnceColor {}
    // @scene template-box: the anchor colors are the non-background colors
    //  found in both box interiors. A figure is a group with exactly one
    //  anchor-colored cell, its anchor, and at least one other cell; other
    //  groups are skipped. Undefined when no figure results.
    // @witness two-single-colors: variant $AnchorBySharedColor & $UnmatchedStays
    //     @relaxed template-box
    // @witness anchor-reused-as-decoration: variant concept
  | AnchorBySharedColor {}

// which cells of the anchor box a stamp writes
.type StampReach =
    // @claim stamp-at-anchor
    CropReach {}
    // @rule stamp-at-anchor: a stamp writes only onto interior cells that hold
    //  the background color, so the frame and the lone cells keep their
    //  colors. Undefined where two stamps write different colors to one cell.
    // @witness stamp-over-frame: borderline $FillOnly & $UnmatchedStays
  | FillOnly {}

// what a lone cell whose color is no figure's anchor color gets
.type UnmatchedLoneCell =
    // @claim stamp-at-anchor
    MatchRequired {}
    // @rule stamp-at-anchor: such a lone cell keeps its color and gets no stamp
    // @witness unmatched-lone-cell: borderline $UnmatchedStays
    //     @relaxed anchor-box
  | UnmatchedStays {}

// which cells of the anchor box take a stamp, under RoleBySize
.type StampSites =
    // @claim stamp-at-anchor
    LoneSites {}
    // @rule stamp-at-anchor: every anchor box cell of a figure's anchor color
    //  takes a stamp, in a group of more than one cell too
    // @witness figures-in-both: foreign any
    //     @relaxed anchor-box
  | EveryAnchorColored {}

// which box gives the figures and which box the output crops
.type BoxRole =
    // @claim template-box
    RoleByContent {}
    // @scene template-box: the box with the larger area holds the figures,
    //  and the other box is the anchor box, whose groups of more than one cell
    //  keep their colors. Undefined when the areas are equal.
    // @witness template-box-smaller: variant concept
  | RoleBySize {sites: StampSites}

// which neighbors join the cells of a group
.type Adjacency =
    // @claim template-box
    Conn8 {}
    // @scene template-box: only edge neighbors join the cells of a group
    // @witness corner-decoration: variant concept
  | Conn4 {}

.type Choice = [anchor: AnchorCell, reach: StampReach, unmatched: UnmatchedLoneCell,
                role: BoxRole, adj: Adjacency]

// One role reading and one adjacency: the parse's key.
.type Reading = [role: BoxRole, adj: Adjacency]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {}

.init params = Params

.decl anchor_cell_choice(a: AnchorCell)
anchor_cell_choice($OnceColor()). anchor_cell_choice($AnchorBySharedColor()).

.decl stamp_reach_choice(s: StampReach)
stamp_reach_choice($CropReach()). stamp_reach_choice($FillOnly()).

.decl stamp_sites_choice(si: StampSites)
stamp_sites_choice($LoneSites()). stamp_sites_choice($EveryAnchorColored()).

.decl box_role_choice(role: BoxRole)
box_role_choice($RoleByContent()). box_role_choice($RoleBySize(Si)) :- stamp_sites_choice(Si).

.decl adjacency_choice(j: Adjacency)
adjacency_choice($Conn8()). adjacency_choice($Conn4()).

// The concept case, and the cases that take UnmatchedStays. Another case with
// MatchRequired is subsumed: wherever it is defined, the case with
// UnmatchedStays in its place gives the same grid.
.decl impl_choice(ch: Choice)
impl_choice([$OnceColor(), $CropReach(), $MatchRequired(), $RoleByContent(), $Conn8()]).
impl_choice([A, S, $UnmatchedStays(), Role, J]) :-
    anchor_cell_choice(A), stamp_reach_choice(S), box_role_choice(Role), adjacency_choice(J).

// The cells that take a stamp of their color.
.decl site(a: AnchorCell, r: Reading, p: Position, k: Color)
site(A, R, P, K) :- anchor_cell_choice(A), lone(R, P, K).

// A cell of a figure placed with its anchor on a site of its anchor color.
.decl placed(a: AnchorCell, r: Reading, id: Ident, p: Position, col: Color)
placed(A, R, Id, P, Col) :-
    site(A, R, L, K), fig_key(A, R, Id, K), fig_rel(A, R, Id, V, Col),
    compose(L, V, P).

// The cells a stamp reading lets a stamp write.
.decl writable(s: StampReach, r: Reading, p: Position)

// A write of a placed figure that the stamp reading keeps.
.decl paint(a: AnchorCell, s: StampReach, r: Reading, id: Ident, p: Position, col: Color)
paint(A, S, R, Id, P, Col) :- placed(A, R, Id, P, Col), writable(S, R, P).

// A reading under which the output is undefined.
.decl defect(a: AnchorCell, r: Reading)

// A lone cell whose color is no figure's anchor color.
.decl unmatched(a: AnchorCell, r: Reading)
unmatched(A, R) :-
    anchor_cell_choice(A), lone(R, _, K), !fig_key(A, R, _, K).

// The readings that give an output.
.decl settled(a: AnchorCell, u: UnmatchedLoneCell, r: Reading)

// A cell of the output frame, with its input color.
.decl sheet(r: Reading, p: Position, p_inner: Position, col: Color)
sheet(R, P, P_inner, Col) :- target.value(R, B), in(P, Col), crop(P, B, P_inner).

// One group of the template box under one anchor reading.
.type Figure = [anchor: AnchorCell, r: Reading, id: Ident]

// The rectangle outlines of one color.
// @claim striped-field two-boxes
.init outline = Outlines<Color>
outline.node(Col, P) :- in(P, Col).

// An outline inside another.
.decl nested(b: Box)
nested(B) :- outline.box(_, B), outline.box(_, B2), B != B2, inside(B, B2).

// A box: an outline inside no other.
.decl box(b: Box)
box(B) :- outline.box(_, B), !nested(B).

// The interior's background: its commonest color.
// @claim two-boxes
.init interior_mode = Mode<Box, Color, Position>
interior_mode.item(B, Col, P) :- box(B), in(P, Col), interior(P, B).

// A non-background cell of a box's interior.
.decl ink(b: Box, p: Position, col: Color)
ink(B, P, Col) :- interior_mode.item(B, Col, P), !interior_mode.mode(B, Col).

// The groups of each box's non-background cells.
.decl part(j: Adjacency, b: Box, p: Position, id: Ident)

// A group of more than one cell.
.decl multi(j: Adjacency, b: Box, id: Ident)
multi(J, B, Id) :- part(J, B, P, Id), part(J, B, Q, Id), P != Q.

// The box that holds the figures.
// @claim template-box
.init template = Unanimous<Reading, Box>

// The box the output crops.
// @claim two-boxes
.init target = Unanimous<Reading, Box>
target.item(R, B) :- template.value(R, B_t), box(B), B != B_t.

.decl fig_cell(r: Reading, id: Ident, p: Position, col: Color)
fig_cell([Role, J], Id, P, Col) :-
    template.value([Role, J], B), part(J, B, P, Id), in(P, Col).

// A lone cell of the anchor box: a group of one cell.
.decl lone(r: Reading, p: Position, col: Color)
lone([Role, J], P, Col) :-
    target.value([Role, J], B), part(J, B, P, Id), !multi(J, B, Id),
    in(P, Col).

// The anchor of each figure.
// @claim template-box
.init anchor = Unanimous<Figure, Position>

// A figure's anchor color.
.decl fig_key(a: AnchorCell, r: Reading, id: Ident, k: Color)
fig_key(A, R, Id, K) :- anchor.value([A, R, Id], P), in(P, K).

// A figure's cells relative to its anchor.
.decl fig_rel(a: AnchorCell, r: Reading, id: Ident, v: Offset, col: Color)
fig_rel(A, R, Id, V, Col) :-
    anchor.value([A, R, Id], P_a), fig_cell(R, Id, P, Col), relative(P_a, P, V).

// Two figures of one anchor color differ.
.decl clash(a: AnchorCell, r: Reading)
clash(A, R) :-
    fig_key(A, R, Id, K), fig_key(A, R, Id2, K),
    fig_rel(A, R, Id, V, Col), !fig_rel(A, R, Id2, V, Col).

out(P_inner, Col, [A, S, U, Role, J]) :-
    impl_choice([A, S, U, Role, J]), settled(A, U, [Role, J]), !clash(A, [Role, J]),
    sheet([Role, J], P, P_inner, C),
    ( paint(A, S, [Role, J], _, P, Col)
    ; site(A, [Role, J], P, Col)                      // a site writes its own color
    ; !paint(A, S, [Role, J], _, P, _), Col = C
    ).

// --- $OnceColor ---
// A color that occurs more than once in a figure.
.decl repeated(r: Reading, id: Ident, col: Color)
repeated(R, Id, Col) :- fig_cell(R, Id, P, Col), fig_cell(R, Id, Q, Col), P != Q.

anchor.item([$OnceColor(), R, Id], P) :-
    fig_cell(R, Id, P, Col), !repeated(R, Id, Col).

// --- $AnchorBySharedColor ---
// A non-background color of the anchor box; on a figure cell, an anchor
// color.
.decl shared(r: Reading, col: Color)
shared(R, Col) :- target.value(R, B), ink(B, _, Col).

anchor.item([$AnchorBySharedColor(), R, Id], P) :-
    fig_cell(R, Id, P, Col), shared(R, Col),
    fig_cell(R, Id, _, Col2), !shared(R, Col2).    // and a cell of another color

// --- $RoleByContent ---
template.item([$RoleByContent(), J], B) :- multi(J, B, _).

// --- $RoleBySize ---
// @claim template-box
.init area = Tally<Box, Position>
area.item(B, P) :- box(B), in(P, _), inside(P, B).

// @claim template-box
.init larger = ArgExtremes<Unit, Box>
larger.cand($U(), B, N) :- area.tally(B, N).

template.item([$RoleBySize(Si), J], B) :-
    stamp_sites_choice(Si), adjacency_choice(J), larger.high($U(), B, _).

// --- $Conn8 ---
// @claim template-box
.init part8 = Components8<Box>
part8.node(B, P) :- ink(B, P, _).

part($Conn8(), B, P, Id) :- part8.label(B, P, Id).

// --- $Conn4 ---
// @claim template-box
.init part4 = Components<Box>
part4.node(B, P) :- ink(B, P, _).

part($Conn4(), B, P, Id) :- part4.label(B, P, Id).

// --- $OnceColor ---
// A figure with no anchor, or with more than one.
defect($OnceColor(), R) :-
    fig_cell(R, Id, _, _), !anchor.value([$OnceColor(), R, Id], _).

// --- $AnchorBySharedColor ---
// No figure results.
defect($AnchorBySharedColor(), R) :-
    template.value(R, _), !fig_key($AnchorBySharedColor(), R, _, _).

// --- $CropReach ---
writable($CropReach(), R, P) :- sheet(R, P, _, _).

// --- $FillOnly ---
writable($FillOnly(), R, P) :-
    target.value(R, B), interior(P, B), in(P, Bg),
    interior_mode.mode(B, Bg).

// --- $MatchRequired ---
settled(A, $MatchRequired(), R) :-
    template.value(R, _), anchor_cell_choice(A), !defect(A, R), !unmatched(A, R).

// --- $UnmatchedStays ---
settled(A, $UnmatchedStays(), R) :-
    template.value(R, _), anchor_cell_choice(A), !defect(A, R).

// --- $EveryAnchorColored ---
site(A, [$RoleBySize($EveryAnchorColored()), J], P, K) :-
    target.value([$RoleBySize($EveryAnchorColored()), J], B), ink(B, P, K),
    fig_key(A, [$RoleBySize($EveryAnchorColored()), J], _, K).
