// ea9794b1
// concept: overlay decompose lookup rank
// The grid divides into a 2×2 tile arrangement, each tile drawn in its own
// ink. The output overlays the tiles: the highest-precedence ink present
// fills each cell, bg where every tile is empty. Each tile keeps one ink
// in every pair, so tile and ink precedence are indistinguishable:
//
//   $Order() — per-tile ranks stored in c.prio.
//   $Ink()   — per-ink ranks stored in c.ink_rank.

#include "../lib.dl"

.type Choice = Order {} | Ink {}

.comp Consts {
    .decl bg(col: Color) bg(0).
    .decl tiles(n: number) tiles(2).

    // --- $Order ---
    .decl prio(p: Position, r: number)
    GRID_2x2(prio,
        3, 0,
        1, 2)

    // --- $Ink ---
    .decl ink_rank(c: Color, r: number)
    ink_rank(3, 0). ink_rank(9, 1). ink_rank(8, 2). ink_rank(4, 3).
}

.init c = Consts

.decl tile_cell(p_tile: Position, p_intile: Position, col: Color)
tile_cell(P_tile, P_intile, Col) :-
    in(P_grid, Col),
    c.tiles(N),
    divide_2d(P_grid, N, 0, P_tile, P_intile).

// Ink at an output cell, keyed by its tile.
.decl tile_ink(p_tile: Position, p: Position, col: Color)
tile_ink(P_tile, P_intile, Col) :- tile_cell(P_tile, P_intile, Col), !c.bg(Col).

.decl ink_at(p: Position, col: Color)
ink_at(P, Col) :- tile_ink(_, P, Col).

.decl out(p: Position, col: Color, ch: Choice)

.decl impl_choice(ch: Choice)
impl_choice($Order()). impl_choice($Ink()).

out(P, Col, Ch) :- impl_choice(Ch), tile_cell(_, P, _), !ink_at(P, _), c.bg(Col).

// --- $Order ---

.decl order_beaten(p_tile: Position, p: Position)
order_beaten(T, P) :-
    tile_ink(T, P, _), tile_ink(T2, P, _),
    c.prio(T2, R2), c.prio(T, R), R2 < R.

out(P, Col, $Order()) :- tile_ink(T, P, Col), !order_beaten(T, P).

// --- $Ink ---

.decl ink_beaten(p: Position, col: Color)
ink_beaten(P, Col) :-
    ink_at(P, Col), ink_at(P, C2),
    c.ink_rank(C2, R2), c.ink_rank(Col, R), R2 < R.

out(P, Col, $Ink()) :- ink_at(P, Col), !ink_beaten(P, Col).

// --- fit ---

.comp Fit {
    .decl tile_ink(e: Example, p_tile: Position, p: Position, col: Color)
    tile_ink(E, P_tile, P_intile, Col) :-
        ex_in(E, P_grid, Col), !c.bg(Col),
        c.tiles(N),
        divide_2d(P_grid, N, 0, P_tile, P_intile).

    // Closed transitively: a tile pair need not overlap directly.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        tile_ink(E, T, P, Col), tile_ink(E, T2, P, Col2), Col != Col2,
        ex_out(E, P, Col).
    beats(T, T3) :- beats(T, T2), beats(T2, T3).

    .decl prio(p: Position, r: number)
    prio(T, R) :- tile_ink(_, T, _, _), R = count : { beats(T2, T) }.

    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- tile_ink(_, T, _, Col), prio(T, R).
}
