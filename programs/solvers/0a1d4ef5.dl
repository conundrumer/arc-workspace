// 0a1d4ef5
// @keywords: objects rank noise
// output: Solid one-color rectangles sit on a field of noise, laid out in a
//  grid: on each axis the rectangles group into bands, and the output is
//  that layout — one cell per rectangle, holding its color, at its band's
//  rank on each axis.

// what makes a band
.type Choice =
    // groups spans into runs of adjacent occupied lines, so a gap of empty
    // lines separates bands
    Runs {}
    // groups spans that share a line, closed transitively
  | Overlap {}
.type RegionAxis = [id: Ident, a: Axis]
.type ChoiceAxis = [c: Choice, a: Axis]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl min_side(k: number) min_side(3).
}

.init params = Params

// --- rectangles ---

// The one-color regions, with the lines each spans and its side lengths.
.comp Parse<Key> {
    .type KeyColor = [k: Key, col: Color]
    .type KeyRegionAxis = [k: Key, id: Ident, a: Axis]

    .decl cell(k: Key, p: Position, col: Color)

    // Touching cells of one color.
    .init region = Components<KeyColor>
    region.node([K, Col], P) :- cell(K, P, Col).

    .decl region_cell(k: Key, id: Ident, p: Position)
    region_cell(K, Id, P) :- region.label([K, _], P, Id).

    // The lines a region spans, per axis.
    .decl region_line(k: Key, id: Ident, a: Axis, p_line: Position)
    region_line(K, Id, A, P_line) :- region_cell(K, Id, P), axis_elem(A), split(P, A, P_line, _).

    // The region does not fill the rectangle its lines span.
    .decl hole(k: Key, id: Ident)
    hole(K, Id) :-
        region_line(K, Id, A, P_line), region_line(K, Id, A2, P_line2), perp(A, A2),   // a crossing of its lines
        compose(P_line, P_line2, P), !region_cell(K, Id, P).                           // holding no cell of it

    // Side length on each axis: how many lines it spans.
    .init side = Tally<KeyRegionAxis, Position>
    side.item([K, Id, A], P_line) :- region_line(K, Id, A, P_line).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl region_line(id: Ident, a: Axis, p_line: Position)
region_line(Id, A, P_line) :- parse.region_line($U(), Id, A, P_line).

// Too short on one axis to tell it from noise.
.decl short(id: Ident)
short(Id) :- parse.side.tally([$U(), Id, _], N), params.min_side(K), N < K.

.decl block(id: Ident)
block(Id) :- parse.side.tally([$U(), Id, _], _), !parse.hole($U(), Id), !short(Id).

// The band a rectangle belongs to on each axis.
.decl block_band(c: Choice, a: Axis, id: Ident, b: Ident)

// --- $Runs ---

// A band is a run of adjacent occupied lines.
.init runs = Components<Axis>
runs.node(A, P_line) :- block(Id), region_line(Id, A, P_line).

block_band($Runs(), A, Id, B) :- block(Id), region_line(Id, A, P_line), runs.label(A, P_line, B).

// --- $Overlap ---

// Two rectangles align when their spans share a line; a band is a class
// of the alignment's transitive closure.
.decl overlap(a: Axis, id: Ident, id2: Ident)
overlap(A, Id, Id2) :-
    block(Id), block(Id2), region_line(Id, A, P_line), region_line(Id2, A, P_line).

// The classes a chain of alignments connects.
.init cls = Canon<RegionAxis>
cls.edge([Id, A], [Id2, A]) :- overlap(A, Id, Id2).

block_band($Overlap(), A, Id, B) :- cls.id([Id, A], B).

// --- arrangement ---

// One output line per band: the frame the bands induce on each axis. A
// band's line set is the union of its rectangles' spans; band line sets
// are disjoint intervals, as OrderFrame assumes.
.init layout = OrderFrame<ChoiceAxis, Ident>
layout.axis([C, A], A) :- block_band(C, A, _, _).
layout.member([C, A], B, P_line) :- block_band(C, A, Id, B), region_line(Id, A, P_line).

out(P, Col, C) :-
    parse.region.label([$U(), Col], _, Id),                            // the rectangle's color
    block_band(C, A, Id, B), block_band(C, A2, Id, B2), perp(A, A2),   // its band on each axis
    layout.pos([C, A], B, P_line), layout.pos([C, A2], B2, P_line2),   // the bands' output lines
    compose(P_line, P_line2, P).                                       // where the two lines cross

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // A rectangle the output shows: a region with no hole, of a color the
    // example's output holds.
    .decl rect(e: Example, id: Ident)
    rect(E, Id) :- parse.region.label([E, Col], _, Id), ex_out(E, _, Col), !parse.hole(E, Id).

    // The least side of a rectangle.
    .init sides = Extremes<Unit>
    sides.cand($U(), N) :- rect(E, Id), parse.side.tally([E, Id, _], N).

    .decl min_side(k: number)
    min_side(K) :- sides.low($U(), K).
}
