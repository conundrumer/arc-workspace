// 6cf79266
// Noise grid of one ink color on c.bg. Every all-bg square window of side
// c.dim repaints to c.fill. Candidate windows can overlap (train 2); the
// one earlier in reading order (c.corner, c.axis) wins.
//
// Two models resolve the overlap:
//   $First  — a candidate overlapped by any earlier candidate is dropped.
//   $Greedy — sequential repaint: a candidate is dropped only if an
//             earlier *selected* candidate overlaps it.

#include "../lib.dl"

.type Choice = First {} | Greedy {}

.comp Consts {
    .init helpers = ConstsHelpers

    .decl bg(c: Color)    bg(0).
    .decl fill(c: Color)  fill(1).

    // Window: side-c.dim square.
    .decl dim(k: number)  dim(3).
    .decl shape(p: Position)
    shape(P) :- dim(K), helpers.frame_pos([K, K], P).

    // Reading order.
    .decl corner(d: DiagDir)  corner(DIAG_TL).
    .decl axis(a: Axis)       axis(AXIS_V).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Candidate windows: placements where the shape lands all-bg.
.init occ = Occurrences<Unit>
occ.cell($U(), P)  :- in(P, Col), c.bg(Col).
occ.shape($U(), P) :- c.shape(P).

.decl candidate(m: Position)
candidate(M) :- occ.occurrence($U(), M).

// Grid cells of a candidate window.
.decl window(m: Position, p: Position)
window(M, P) :- candidate(M), c.shape(S), compose(M, S, P).

// Two candidates share a cell.
.decl overlap(m1: Position, m2: Position)
overlap(M1, M2) :- window(M1, P), window(M2, P), M1 != M2.

// Reading order over candidates: nearer along the primary dir; or tie and
// nearer along the secondary.
.decl before(q: Position, m: Position)
before(Q, M) :-
    candidate(Q), candidate(M),
    c.corner(Diag), c.axis(A), dir_of(Diag, A, D),   // primary dir
    dist(Q, D, K1), dist(M, D, K2), K1 < K2.         // q strictly nearer
before(Q, M) :-
    candidate(Q), candidate(M),
    c.corner(Diag), c.axis(A),
    diag_dirs(Diag, A, D, D2),                       // primary/secondary dirs
    same_dist(D, Q, M),                              // primary tie
    dist(Q, D2, K1), dist(M, D2, K2), K1 < K2.       // q strictly nearer

.decl painted(p: Position, ch: Choice)

// --- $First ---

.decl beaten(m: Position)
beaten(M) :- overlap(Q, M), before(Q, M).

painted(P, $First()) :- candidate(M), !beaten(M), window(M, P).

// --- $Greedy ---

.decl rank(m: Position, k: number)
rank(M, K) :- candidate(M), K = count : { before(Q, M) }.

.decl conflict(j: number, k: number)
conflict(J, K) :- overlap(M1, M2), rank(M1, J), rank(M2, K).

.init ranks = IndexCycle<Unit>
ranks.idx($U(), K) :- rank(_, K).

// Rank j does not block k: no shared cell, or j itself dropped.
.decl clear(j: number, k: number)
clear(J, K) :- rank(_, J), rank(_, K), J < K, !conflict(J, K).
clear(J, K) :- dropped(J), rank(_, K), J < K.

// An earlier selected candidate overlaps it.
.decl dropped(k: number)
dropped(K) :- selected(J), conflict(J, K), J < K.

// Ranks below j leave k unblocked — walked upward; selected at the full
// sweep.
.decl swept(k: number, j: number)
swept(K, 0) :- rank(_, K).
swept(K, J2) :- swept(K, J), J < K, clear(J, K), ranks.succ($U(), J, J2).

.decl selected(k: number)
selected(K) :- swept(K, K).

painted(P, $Greedy()) :- selected(K), rank(M, K), window(M, P).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($First()). impl_choice($Greedy()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- painted(P, Ch), c.fill(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !painted(P, Ch).

.output out(IO=stdout)
