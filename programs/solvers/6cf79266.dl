// 6cf79266
// @keywords: stamp
// input: a noise grid of one ink color on params.bg
// output: Every all-bg square window of side params.dim repaints to
//  params.fill.

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(1).

    // Window: side-params.dim square.
    .decl dim(k: number) dim(3).
    .decl shape(p: Position)
    shape(P) :- dim(K), helpers.frame_pos([K, K], P).
}

.init params = Params

// Windows: placements where the shape lands all-bg.
.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- in(P, Col), params.bg(Col).
occ.shape($U(), P, $U()) :- params.shape(P).

.decl painted(p: Position)
painted(P) :- occ.occurrence($U(), M), params.shape(S), compose(M, S, P).

out(P, Col) :- painted(P), params.fill(Col).
out(P, Col) :- in(P, Col), !painted(P).
