// 4612dd53
// draft
// concept: lines count objects
// The marks draw a lattice of dashed lines inside their bounding box: some
// rows and some columns of that box carry a line. The output repairs each
// line, painting its missing cells in the fill color; every other cell keeps
// what it holds.
//
// The cases differ in what makes a row or column a line:
//
//   $Threshold — its marks reach a stored count.
//   $Majority  — its marks outnumber its gaps.
//   $Segment   — two of its marks are adjacent along it.

#include "../lib.dl"

.type Choice = Threshold {} | Majority {} | Segment {}

.type LineKey = [a: Axis, l: Position]

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(0).
    .decl fill(col: Color) fill(2).

    // --- Threshold ---
    .decl min_marks(n: number) min_marks(4).
}

.init params = Params

.decl mark(p: Position)
mark(P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- mark(P).
bbox.grid($U(), P) :- in(P, _).

// A box cell on the line running along axis A at coordinate L.
.decl line_cell(a: Axis, l: Position, p: Position)
line_cell(A, L, P) :- bbox.inside($U(), P), axis_elem(A), split(P, A, _, L).

.decl line_mark(a: Axis, l: Position, p: Position)
line_mark(A, L, P) :- line_cell(A, L, P), mark(P).

.decl line_gap(a: Axis, l: Position, p: Position)
line_gap(A, L, P) :- line_cell(A, L, P), !mark(P).

.decl line(ch: Choice, a: Axis, l: Position)

// --- Threshold ---
.init marks = Tally<LineKey, Position>
marks.item([A, L], P) :- line_mark(A, L, P).

line($Threshold(), A, L) :- marks.tally([A, L], N), params.min_marks(K), N >= K.

// --- Majority ---
.init lead = Excess<LineKey, Position>
lead.plus([A, L], P) :- line_mark(A, L, P).
lead.minus([A, L], P) :- line_gap(A, L, P).

line($Majority(), A, L) :- lead.excess([A, L], _).

// --- Segment ---
line($Segment(), A, L) :-
    line_mark(A, L, P), line_mark(A, L, Q),   // two of the line's marks
    axis_of(D, A), neighbor(P, D, Q).         // one step apart along it

// --- output ---
.decl impl_choice(ch: Choice)
impl_choice($Threshold()). impl_choice($Majority()). impl_choice($Segment()).

.decl repaired(ch: Choice, p: Position)
repaired(Ch, P) :- line(Ch, A, L), line_gap(A, L, P).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- repaired(Ch, P), params.fill(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !repaired(Ch, P).
