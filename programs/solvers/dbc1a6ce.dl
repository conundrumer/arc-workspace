// dbc1a6ce
// concept: markers span
// Bg cells between two marks on their row or column fill with c.fill;
// marks stay.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)    bg(0).
    .decl fill(c: Color)  fill(8).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.init spans = Between<Unit>
spans.axis(A)       :- axis_elem(A).
spans.cell(P)       :- in(P, Bg), c.bg(Bg).
spans.mark($U(), Q) :- in(Q, Col), !c.bg(Col).

.decl out(p: Position, col: Color)
out(P, F)   :- spans.between($U(), P), c.fill(F).
out(P, Col) :- in(P, Col), !spans.between($U(), P).

.output out(IO=stdout)
