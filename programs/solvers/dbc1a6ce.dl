// dbc1a6ce
// @keywords: markers span
// output: Bg cells between two marks on their row or column fill with
//  params.fill; marks stay.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(8).
}

.init params = Params

.init spans = Between<Unit>
spans.axis($U(), A) :- axis_elem(A).
spans.cell($U(), P) :- in(P, Bg), params.bg(Bg).
spans.mark($U(), Q) :- in(Q, Col), !params.bg(Col).

out(P, F)   :- spans.between($U(), P), params.fill(F).
out(P, Col) :- in(P, Col), !spans.between($U(), P).
