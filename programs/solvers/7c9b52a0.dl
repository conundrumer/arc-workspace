// 7c9b52a0
// @draft
// @keywords: overlay objects
// input: panels of one size on a frame color, each a params.bg canvas holding
//  some ink. No canvas cell takes ink from two panels.
// output: the panels stack on one canvas: each cell takes the ink of the panel
//  that inks it, and stays params.bg where no panel inks it.
// review principle: Cases — the precedence peer, which stores an order over
//  the panels and inks a shared canvas cell from the foremost, was dropped
//  because no pair inks one cell from two panels, so re-judge it as a second
//  case beside the shipped union under Fit, Fidelity, and Equivalence.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

// The frame color: what covers the grid outside the panels.
.init frame = Mode<Unit, Color, Position>
frame.item($U(), Col, P) :- in(P, Col).

.init panels = Components<Unit>
panels.node($U(), P) :- in(P, Col), !frame.mode($U(), Col).

.init panel = Bbox<Ident>
panel.cell(Id, P) :- panels.label($U(), P, Id).

// The shared canvas: every panel's cells, in the panel's own frame.
.decl canvas(p_grid: Position, p_frame: Position)
canvas(P_grid, P_frame) :-
    panel.cell(Id, P_grid), panel.box(Id, B), crop(P_grid, B, P_frame).

.decl ink(p: Position, col: Color)
ink(P_frame, Col) :- canvas(P_grid, P_frame), in(P_grid, Col), !params.bg(Col).

out(P, Col) :-
    canvas(_, P),
    ( ink(P, Col)                    // inked
    ; !ink(P, _), params.bg(Col)     // blank
    ).
