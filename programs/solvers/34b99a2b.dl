// Layout: 1×2 horizontally-side-by-side 5×4 subgrids with 1-col gap.
// Output is the per-cell pair-fold.
//
// Cartesian over (decompose, body) impls; out's choice column tags each:
//
//   decompose:
//     $Tile() — pre-tabulated in Consts via tile_pos
//     $Div()  — derived in body via the divide primitive (c.divide_axis, c.divisor)
//
//   body:
//     $SetMatch(d) — combine table keyed on (outer pos, color); count-trick match
//     $Xor(d)      — XOR via count: exactly one non-BG input contribution

#include "../lib.dl"

.type DecChoice = Tile {} | Div {}
.type Choice = SetMatch { d: DecChoice } | Xor { d: DecChoice }

.comp Consts {
    .decl frame(p: Position)
    frame(P) :- frame_pos([5, 4], P).

    // --- Tile decompose data ----------------------------------------------
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :- tile_pos([1, 2], [5, 4], [0, 1], P_grid, P_tile, P_intile).

    // --- Div decompose data -----------------------------------------------
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(HORIZONTAL).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- SetMatch body data -----------------------------------------------
    .decl combine_member(eid: number, p_outer: Position, c: Color)
    .decl combine_out(eid: number, c_out: Color)

    combine_member(0, [0,0,0,1], 0). combine_member(0, [0,0,1,0], 0). combine_out(0, 0).
    combine_member(1, [0,0,0,1], 0). combine_member(1, [0,0,1,0], 5). combine_out(1, 2).
    combine_member(2, [0,0,0,1], 8). combine_member(2, [0,0,1,0], 0). combine_out(2, 2).
    combine_member(3, [0,0,0,1], 8). combine_member(3, [0,0,1,0], 5). combine_out(3, 0).

    // --- Xor body data ----------------------------------------------------
    .decl bg(c: Color)        bg(0).
    .decl out_fill(c: Color)  out_fill(2).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// --- Decompose variants ----------------------------------------------------

.decl dec_choice(dc: DecChoice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),     // params
    divide(P_grid, A, N, G, P_tile, P_inner_axis),       // 1D divide
    split(P_grid, A, _, Across),                         // perpendicular passes through
    compose(P_inner_axis, Across, P_intile).

// --- Xor body: filled_count parameterized by decompose choice -------------

.decl filled_count(o: Position, dc: DecChoice, n: number)
filled_count(P_grid_out, Dc, N) :-
    c.frame(P_grid_out), dec_choice(Dc),
    N = count : { in(P_grid_in, Col), !c.bg(Col), decompose(P_grid_in, _, P_grid_out, Dc) }.

// --- Output: cartesian over (DecChoice, body) ------------------------------

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col_out, $SetMatch(Dc)) :-
    dec_choice(Dc),
    c.frame(P_grid_out),
    c.combine_out(Eid, Col_out),
    N = count : { c.combine_member(Eid, _, _) },                  // members in entry
    N = count : { c.combine_member(Eid, P_tile, C),               // members matched
                  decompose(P_grid_in, P_tile, P_grid_out, Dc),
                  in(P_grid_in, C) }.

out(P_grid_out, Col, $Xor(Dc)) :-
    dec_choice(Dc), c.frame(P_grid_out),        // choice × cell
    filled_count(P_grid_out, Dc, 1),            // XOR=1: exactly one contribution
    c.out_fill(Col).
out(P_grid_out, Col, $Xor(Dc)) :-
    dec_choice(Dc), c.frame(P_grid_out),        // choice × cell
    filled_count(P_grid_out, Dc, N), N != 1,    // XOR=0: zero or two contributions
    c.bg(Col).

.output out(IO=stdout)
