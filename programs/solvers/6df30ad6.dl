// 6df30ad6
// @draft
// @keywords: markers select rank count rings
// input: a gray shape sits among single-cell dots of several colors
// output: The output keeps the shape alone, recolored with the color of the
//  dot nearest it. Nearness is read by growing the shape outward in rings
//  until a ring holds a dot; Choice = [grow, tie] crosses the hypotheses.
//  Train 1 contradicts [$Diamond, $Most], so impl_choice omits it.

// the ring shape
.type Grow =
    // grows under 8-adjacency
    Square {}
    // grows under 4-adjacency
  | Diamond {}

// settles a first ring that holds dots of several colors
.type Tie =
    // orders its dots by the other growth's rings, so a square ring's
    // corners lie farther than its sides and a diamond ring's diagonal
    // cells lie nearer than its axis tips
    Nearer {}
    // the color with the most dots in the ring
  | Most {}

.type Choice = [grow: Grow, tie: Tie]

// --- shared ---

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color)
    bg(0).

    .decl shape(c: Color)
    shape(5).
}

.init params = Params

.decl grow_choice(g: Grow)
grow_choice($Square()). grow_choice($Diamond()).

.decl impl_choice(ch: Choice)
impl_choice([$Square(), $Nearer()]). impl_choice([$Diamond(), $Nearer()]).
impl_choice([$Square(), $Most()]).

.decl shape(p: Position)
shape(P) :- in(P, Col), params.shape(Col).

.decl dot(p: Position, col: Color)
dot(P, Col) :- in(P, Col), !params.bg(Col), !params.shape(Col).

// The rings each growth adds around the shape: a cell's ring is its hop
// count from the shape under that growth's steps.
.init rings = GraphDistance<Grow, Position>
rings.seed(G, P) :- grow_choice(G), shape(P).
rings.edge(G, Q, P) :-
    in(Q, _), in(P, _),                   // two grid cells
    grow_step(G, D), neighbor(Q, D, P).   // one step apart

// The steps each growth takes.
.decl grow_step(g: Grow, d: Dir8)
grow_step($Square(), D) :- dir8_elem(D).
grow_step($Diamond(), D) :- dir_elem(D).

// The dots in the first ring that holds one.
.init first = ArgExtremes<Grow, Position>
first.cand(G, P, K) :- dot(P, _), rings.distance(G, P, K).

// The color the shape takes.
.decl fill(col: Color, c: Choice)

// --- $Nearer ---

// The nearest of the first ring's dots, by the other growth's rings.
.init nearest = ArgExtremes<Grow, Position>
nearest.cand(G, P, K) :-
    first.low(G, P, _),                   // a first-ring dot
    rings.distance(G2, P, K), G2 != G.       // its ring under the other growth

fill(Col, [G, $Nearer()]) :- nearest.low(G, P, _), dot(P, Col).

// --- $Most ---

// The color with the most dots in the first ring.
.init most = Mode<Grow, Color, Position>
most.item(G, Col, P) :- first.low(G, P, _), dot(P, Col).

fill(Col, [G, $Most()]) :- most.mode(G, Col).

out(P, Col, C) :- shape(P), fill(Col, C), impl_choice(C).
out(P, Col, C) :- in(P, _), !shape(P), params.bg(Col), impl_choice(C).
