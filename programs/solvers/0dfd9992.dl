// 0dfd9992
// concept: wallpaper symmetry repair
// A wallpaper pattern damaged by holes of one color; the output restores
// it. The task fixes the point group its patterns share (a parameter); each
// input's survivors identify the rest: first the translation lattice —
// per axis, the shortest witnessed shift no surviving pair contradicts —
// then the group as lattice-reduced representatives: isometries of the
// point group's kinds, composed with a fundamental-domain shift,
// witnessed by some surviving pair and contradicted by none. Each coset
// is admitted through its representative; the rest arrives by composition
// with the lattice in the closure. Colors propagate from survivors along
// the symmetries, so each cell takes its orbit's color.

#include "../lib.dl"

.comp Params {
    .decl hole(col: Color) hole(0).

    // The point group shared by the task's patterns.
    .decl point_group(s: Sym) point_group(SYM_D4).
}

.init params = Params

// --- wallpaper comp ---

// Proposal comp: the isometry peer of OffsetInvariance,
// quotiented by a translation lattice. Given a keyed valued cell set, its
// per-axis periods, and the isometry kinds in play, candidates are the
// isometries of the frame — a kind composed with a shift from the
// lattice's fundamental domain, one representative per coset. `sym` holds
// the candidates witnessed by some pair of cells (vacuous overlap is no
// evidence) and contradicted by none; `step` maps each grid position one
// step along an admitted isometry or a lattice shift.
.comp Wallpaper<Key, Val> {
    .decl kind(d: D4)                           // input
    .decl cell(key: Key, p: Position, v: Val)   // input
    .decl grid(key: Key, p: Position)           // input
    .decl period(key: Key, a: Axis, k: number)  // input

    // Internal canonical corner for fundamental-domain shifts; the choice
    // is unobservable — every corner yields the same cosets and maps.
    .decl canon(a: Axis, d: Dir)
    canon(AXIS_V, DIR_B). canon(AXIS_H, DIR_R).

    // Fundamental-domain shifts per axis: zero, and 0 < k < period toward
    // the canonical corner.
    .decl axis_rep(key: Key, a: Axis, delta: Offset)
    axis_rep(Key, A, ZERO) :- grid(Key, _), axis_elem(A).
    axis_rep(Key, A, Delta) :-
        grid(Key, P), sub_extent(P, A, K),
        period(Key, A, Kp), K < Kp,
        canon(A, D), jump_offset(D, K, Delta).

    .decl dom(key: Key, delta: Offset)
    dom(Key, Delta) :-
        axis_rep(Key, A, D1), axis_rep(Key, A2, D2), perp(A, A2),
        compose(D1, D2, Delta).

    // Lattice elements a candidate's square can reach: zero and one
    // period per axis, toward the canonical corner.
    .decl lat_ax(key: Key, a: Axis, delta: Offset)
    lat_ax(Key, A, ZERO) :- grid(Key, _), axis_elem(A).
    lat_ax(Key, A, Delta) :- period(Key, A, K), canon(A, D), jump_offset(D, K, Delta).

    .decl lat0(key: Key, delta: Offset)
    lat0(Key, Delta) :-
        lat_ax(Key, A, D1), lat_ax(Key, A2, D2), perp(A, A2),
        compose(D1, D2, Delta).

    // Candidates per kind: fundamental-domain shifts. A kind that is its
    // own inverse squares to the identity, so its candidate's square is a
    // translation, and that translation must land in the lattice.
    .decl cand(key: Key, d: D4, delta: Offset)
    cand(Key, D, Delta) :-
        kind(D), dom(Key, Delta),
        ( !d4_inverse(D, D)
        ; d4_inverse(D, D),
          apply(D, Delta, DD), compose(Delta, DD, S), lat0(Key, S)
        ).

    // Cell images under the kinds, materialized so the shift join starts
    // ground.
    .decl rot_cell(key: Key, d: D4, p: Position, v: Val, p1: Position)
    rot_cell(Key, D, P, V, P1) :- cell(Key, P, V), kind(D), apply(D, P, P1).

    // Valued cell pairs under each candidate isometry.
    .decl pair(key: Key, d: D4, delta: Offset, p: Position, q: Position,
               v1: Val, v2: Val)
    pair(Key, D, Delta, P, Q, V1, V2) :-
        rot_cell(Key, D, P, V1, P1), cand(Key, D, Delta),
        compose(P1, Delta, Q), cell(Key, Q, V2).

    .decl mismatch(key: Key, d: D4, delta: Offset)
    mismatch(Key, D, Delta) :- pair(Key, D, Delta, _, _, V1, V2), V1 != V2.

    .decl witnessed(key: Key, d: D4, delta: Offset)
    witnessed(Key, D, Delta) :- pair(Key, D, Delta, P, Q, _, _), P != Q.

    .decl sym(key: Key, d: D4, delta: Offset)
    sym(Key, D, Delta) :- witnessed(Key, D, Delta), !mismatch(Key, D, Delta).

    // Kinds the key's pattern uses: kinds with an admitted representative;
    // the identity kind is used by any pattern with a lattice.
    .decl kind_used(key: Key, d: D4)
    kind_used(Key, D) :- sym(Key, D, _).
    kind_used(Key, D4_ID) :- period(Key, _, _).

    .decl rot_grid(key: Key, d: D4, p: Position, p1: Position)
    rot_grid(Key, D, P, P1) :- grid(Key, P), kind(D), apply(D, P, P1).

    .decl step(key: Key, p: Position, q: Position)
    step(Key, P, Q) :-
        sym(Key, D, Delta), rot_grid(Key, D, P, P1),
        compose(P1, Delta, Q), grid(Key, Q).
    step(Key, P, Q) :-
        period(Key, A, K), axis_of(D, A),
        grid(Key, P), jump(P, D, K, Q), grid(Key, Q).
}

.comp Parse<Key> {
    .decl in_cell(key: Key, p: Position, col: Color)  // input
    .decl kind(d: D4)                                 // input

    .decl intact(key: Key, p: Position, col: Color)
    intact(Key, P, Col) :- in_cell(Key, P, Col), !params.hole(Col).

    .init si = OffsetInvariance<Key, Color>
    si.cell(Key, P, Col) :- intact(Key, P, Col).

    .init wp = Wallpaper<Key, Color>
    wp.kind(D) :- kind(D).
    wp.cell(Key, P, Col) :- intact(Key, P, Col).
    wp.grid(Key, P) :- in_cell(Key, P, _).
    wp.period(Key, A, K) :- si.min_period(Key, A, K).

    .decl step(key: Key, p: Position, q: Position)
    step(Key, P, Q) :- wp.step(Key, P, Q).

    .decl kind_used(key: Key, d: D4)
    kind_used(Key, D) :- wp.kind_used(Key, D).
}

.init parse = Parse<Unit>
parse.in_cell($U(), P, Col) :- in(P, Col).
parse.kind(D) :- params.point_group(S), sym_member(S, D).

.decl out(p: Position, col: Color)
out(P, Col) :- parse.intact($U(), P, Col).
out(Q, Col) :- out(P, Col), parse.step($U(), P, Q).

.comp Determine {
    // Detection per example, over every kind.
    .init parse = Parse<Example>
    parse.in_cell(E, P, Col) :- ex_in(E, P, Col).
    parse.kind(D) :- d4_elem(D).

    // A kind some example does not admit at any offset.
    .decl missing(d: D4)
    missing(D) :- ex_in(E, _, _), d4_elem(D), !parse.kind_used(E, D).

    // Name the shared kind set as a subgroup value.
    .init named = KeyedSetCompare<Unit, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member($U(), D) :- d4_elem(D), !missing(D).

    .decl point_group(s: Sym)
    point_group(S) :- named.equals($U(), S).
}
