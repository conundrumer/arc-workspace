// 3bd292e8
// @draft
// @keywords: objects border count rank
// input: Cells of params.wall cut the rest of the grid into regions. A wall
//  cell between two region cells on one axis puts their regions on opposite
//  sides, so the regions two-color.
// output: Wall cells pass through. The side that holds the region with the
//  fewest cells takes params.small_side, and the other side takes
//  params.other_side.

.decl out(p: Position, col: Color)

.comp Params {
    .decl wall(col: Color) wall(2).
    .decl small_side(col: Color) small_side(5).
    .decl other_side(col: Color) other_side(3).
}

.init params = Params

.init region = Components<Unit>
region.node($U(), P) :- in(P, Col), !params.wall(Col).

// A wall cell lies between a cell of region A and a cell of region B.
.decl across(a: Ident, b: Ident)
across(A, B) :-
    in(P, Col), params.wall(Col), opposite(D, D_opp),        // a wall cell, on one axis
    neighbor(P, D, Q), neighbor(P, D_opp, Q_opp),            // the cells it lies between
    region.label($U(), Q, A), region.label($U(), Q_opp, B),  // their regions
    A != B.

.init area = Tally<Ident, Position>
area.item(A, P) :- region.label($U(), P, A).

.init smallest = ArgExtremes<Unit, Ident>
smallest.cand($U(), A, N) :- area.tally(A, N).

// The regions on the smallest region's side: those a walk of crossing pairs
// reaches from it, since two crossings return to the side started from.
.init same_side = Propagation<Unit, Ident>
same_side.source($U(), B) :- smallest.low($U(), B, _).
same_side.edge($U(), A, C) :- across(A, X), across(X, C).

out(P, Col) :- in(P, Col), params.wall(Col).
out(P, Col) :-
    region.label($U(), P, A),                   // P's region
    ( same_side.reached($U(), A), params.small_side(Col)    // the side that holds the smallest region
    ; !same_side.reached($U(), A), params.other_side(Col)   // the other side
    ).
