// 271d71e2
// concept: objects markers move count
// A marker line abuts a framed block on one side, its handle, and another
// marker line lies ahead in that direction. The block slides toward that line
// and stops on it, or earlier when it runs out of empty gauge cells: the
// block's interior is a gauge of filled and empty cells, and one empty cell
// fills per step of travel. The filled cells sit at the leading edge, the
// handle side. The handle travels with the block, the line ahead stays, and
// the vacated ground becomes bg.
//
// The gauge fills in a sweep from the leading edge: nearest that edge first,
// then toward the side a quarter turn from the heading.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(6).
    .decl frame(col: Color) frame(0).
    .decl marker(col: Color) marker(9).
    .decl empty(col: Color) empty(5).
    .decl filled(col: Color) filled(7).

    // The turn from the heading to the side the sweep starts on.
    .decl sweep(s: Sense) sweep(SENSE_CC).
}

.init params = Params

// --- blocks ---

.init frames = Components<Unit>
frames.node($U(), P) :- in(P, Col), params.frame(Col).

.decl block(id: Ident)
block(Id) :- frames.label($U(), _, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- frames.label($U(), P, Id).

// --- handle and target ---

// The line abutting the block on side D. A cell off the grid still abuts.
.decl abut(id: Ident, d: Dir, p: Position)
abut(Id, D, P) :-
    frames.label($U(), Q, Id), bbox.box(Id, B), box_edge(Q, B, D),  // a block cell on the box's d-side
    neighbor(Q, D, P).

.decl abut_break(id: Ident, d: Dir)
abut_break(Id, D) :- abut(Id, D, P), params.marker(M), !in(P, M).

// The handle: the side whose abutting line is marker all the way across.
.decl handle_dir(id: Ident, d: Dir)
handle_dir(Id, D) :- abut(Id, D, _), !abut_break(Id, D).

// Cast from the handle: offset K is the distance the block travels to bring
// its handle onto the line K cells ahead.
.init probe = Ray<Ident>
probe.dir(Id, D) :- handle_dir(Id, D).
probe.cell(Id, P) :- block(Id), in(P, _).
probe.mark(Id, P) :- handle_dir(Id, D), abut(Id, D, P).

.decl ahead(id: Ident, p: Position, k: number)
ahead(Id, P, K) :- probe.ray(Id, P, _, K, _), K != 0.

.decl ahead_break(id: Ident, k: number)
ahead_break(Id, K) :- ahead(Id, P, K), params.marker(M), !in(P, M).

// --- gauge ---

.decl empty_cell(id: Ident, p: Position)
empty_cell(Id, P) :-
    bbox.box(Id, B), in(P, Col), inside(P, B),  // a cell of the block's box
    params.empty(Col).

.init empty_count = Tally<Ident, Position>
empty_count.item(Id, P) :- empty_cell(Id, P).
empty_count.domain(Id) :- block(Id).

// The block advances the least of: the distance to a marker line ahead, and
// the number of empty gauge cells.
.init advance = Extremes<Ident>
advance.cand(Id, K) :- ahead(Id, _, K), !ahead_break(Id, K).  // a marker line ahead
advance.cand(Id, N) :- empty_count.tally(Id, N).              // the gauge fills up

.init fill_order = LexOrder<Ident>
fill_order.corner(Id, Diag) :-
    handle_dir(Id, D),                    // the leading edge
    params.sweep(S), turn(S, D, D_side),  // the side the sweep starts on
    diag_dirs(Diag, _, D, D_side).        // the corner they meet at
fill_order.axis(Id, A) :- handle_dir(Id, D), axis_of(D, A).
fill_order.cell(Id, P) :- empty_cell(Id, P).

.decl fills(p: Position)
fills(P) :- fill_order.rank(Id, P, R), advance.low(Id, N), R < N.

// --- render ---

// What travels: the block's box and the handle line abutting it.
.decl assembly(id: Ident, p: Position)
assembly(Id, P) :-
    handle_dir(Id, D),
    ( bbox.box(Id, B), in(P, _), inside(P, B)  // the block's box
    ; abut(Id, D, P)                           // the handle line
    ).

// The assembly as it arrives: unchanged, but for the gauge cells that fill.
.decl paint(p: Position, col: Color)
paint(P_out, Col) :-
    assembly(Id, P), handle_dir(Id, D),        // an assembly cell, and its heading
    advance.low(Id, N), jump(P, D, N, P_out),  // carried by the block's travel
    ( in(P, Col), !fills(P)                    // keeps its color
    ; fills(P), params.filled(Col)             // fills
    ).

.decl out(p: Position, col: Color)
out(P, Col) :- paint(P, Col).
out(P, Col) :-
    !paint(P, _),
    ( assembly(_, P), params.bg(Col)   // left behind
    ; in(P, Col), !assembly(_, P)      // untouched
    ).

.comp Determine {
    .decl edge_color(col: Color)
    edge_color(Col) :- ex_in(_, P, Col), dir_elem(D), dist(P, D, 0).

    // A gauge cell sits inside a frame, so it never reaches the grid edge.
    .decl gauge(col: Color)
    gauge(Col) :- ex_in(_, _, Col), !edge_color(Col).

    // The frame is what borders the gauge.
    .decl frame(col: Color)
    frame(Col) :-
        ex_in(E, P, G), gauge(G),         // a gauge cell
        dir_elem(D), neighbor(P, D, Q),   // the cell beside it
        ex_in(E, Q, Col), !gauge(Col).    // outside the gauge

    .type EC = [e: Example, col: Color]

    .init in_count = Tally<EC, Position>
    in_count.item([E, Col], P) :- ex_in(E, P, Col).

    .init out_count = Tally<EC, Position>
    out_count.item([E, Col], P) :- ex_out(E, P, Col).

    // Travel fills empty cells, frees ground, and lands handles on the lines
    // ahead, so each color's count moves one way.
    .decl grew(col: Color)
    grew(Col) :- in_count.tally([E, Col], N1), out_count.tally([E, Col], N2), N1 < N2.

    .decl shrank(col: Color)
    shrank(Col) :- in_count.tally([E, Col], N1), out_count.tally([E, Col], N2), N2 < N1.

    .decl filled(col: Color)
    filled(Col) :- gauge(Col), grew(Col).

    .decl empty(col: Color)
    empty(Col) :- gauge(Col), shrank(Col).

    .decl bg(col: Color)
    bg(Col) :- grew(Col), !gauge(Col).

    .decl marker(col: Color)
    marker(Col) :- shrank(Col), !gauge(Col).
}
