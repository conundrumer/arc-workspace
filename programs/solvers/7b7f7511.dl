// 7b7f7511
// concept: decompose crop count
// The input is one pattern repeated along an axis; the output is the
// pattern once. The repeat axis varies per pair; it is found as the
// axis whose equal-size tiles all agree.
//
//   $Dup  — the repeat count is task data (params.copies).
//   $Tile — the repeat count is free.

#include "../lib.dl"

.type Choice = Dup {} | Tile {}
.type SlabCell = [a: Axis, p_inner: Position]
.type TileCell = [a: Axis, k: number, p_inner: Position]

.comp Params {
    // --- Dup ---
    .decl copies(n: number)
    copies(2).
}

.init params = Params

.decl out(p: Position, col: Color, c: Choice)

// --- Dup ---

// The grid as params.copies slabs along A: what each within-slab cell holds.
.init dup_cell = Unanimous<SlabCell, Color>
dup_cell.item([A, P_inner], Col) :-
    in(P, Col), axis_elem(A), params.copies(N),   // a cell, an axis
    divide_slab(P, A, N, 0, _, P_inner).          // its place within a slab

// Two copies disagree at a within-slab cell.
.decl dup_mismatch(a: Axis)
dup_mismatch(A) :- dup_cell.clash([A, _]).

out(P_inner, Col, $Dup()) :- dup_cell.value([A, P_inner], Col), !dup_mismatch(A).

// --- Tile ---

// The grid as K-sized slabs along A, for every proper K: what each
// within-slab cell holds.
.init tile_cell = Unanimous<TileCell, Color>
tile_cell.item([A, K, P_inner], Col) :-
    in(P, Col), axis_elem(A), sub_extent(P, A, K),   // a cell, an axis, a size
    divide_by_size_slab(P, A, K, 0, _, P_inner).     // its place within a slab

// Two tiles disagree at a within-slab cell.
.decl tile_mismatch(a: Axis, k: number)
tile_mismatch(A, K) :- tile_cell.clash([A, K, _]).

out(P_inner, Col, $Tile()) :- tile_cell.value([A, K, P_inner], Col), !tile_mismatch(A, K).
