// 2dee498d
// concept: decompose crop
// Layout: input is N identical tiles along the tile axis; output is one
// tile. Set semantics dedupes the redundant copies.

#include "../lib.dl"

.comp Consts {
    .decl tile_axis(a: Axis)
    tile_axis(AXIS_H).

    .decl tile_count(n: number)
    tile_count(3).
}

.init c = Consts

.decl out(p: Position, col: Color)
out(P_intile, Col) :-
    in(P_in, Col),                                    // input cell
    c.tile_axis(A), c.tile_count(N),                  // tile params
    divide_slab(P_in, A, N, 0, _, P_intile).          // discard outer; intile is output
