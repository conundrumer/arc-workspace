// 2dee498d
// @keywords: decompose crop
// input: input is N identical tiles along the tile axis
// output: output is one tile. Set semantics dedupes the redundant copies.

.decl out(p: Position, col: Color)

.comp Params {
    .decl tile_axis(a: Axis)
    tile_axis(AXIS_H).

    .decl tile_count(n: number)
    tile_count(3).
}

.init params = Params

out(P_intile, Col) :-
    in(P_in, Col),                                      // input cell
    params.tile_axis(A), params.tile_count(N),          // tile params
    divide_slab(P_in, A, N, 0, _, P_intile).            // discard outer; intile is output
