// 60a26a3e
// draft
// concept: markers span enclose
// A bg field carries hollow diamonds, each sealing one bg cell at its center.
// Two centers in one row or column are joined by a line of params.line, drawn
// over the bg cells between them. A center is not drawn over, so a center that
// two others flank keeps its own cell. The cases split on what makes a bg cell
// a center:
//
//   $Ringed   — a params.ring cell at each of its four cardinals.
//   $Enclosed — no bg path joins it to the grid edge.

#include "../lib.dl"

.type Choice = Ringed {} | Enclosed {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl line(c: Color) line(1).

    // --- Ringed ---
    .decl ring(c: Color) ring(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Ringed()). impl_choice($Enclosed()).

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), params.bg(Col).

.decl center(ch: Choice, p: Position)

// --- Ringed ---

.decl ring_cell(p: Position)
ring_cell(P) :- in(P, Col), params.ring(Col).

// A cardinal that holds no ring cell — one off the grid holds none.
.decl ring_gap(p: Position)
ring_gap(P) :- in(P, _), dir_elem(D), neighbor(P, D, Q), !ring_cell(Q).

center($Ringed(), P) :- bg_cell(P), !ring_gap(P).

// --- Enclosed ---

.init outside = Reach<Unit>
outside.node($U(), P) :- bg_cell(P).
outside.seed($U(), P) :- bg_cell(P), dir_elem(D), dist(P, D, 0).   // on an edge

center($Enclosed(), P) :- bg_cell(P), !outside.reach($U(), P).

// --- the lines ---

.init link = Between<Choice>
link.axis(Ch, A) :- impl_choice(Ch), axis_elem(A).
link.mark(Ch, P) :- center(Ch, P).
link.cell(Ch, P) :- impl_choice(Ch), bg_cell(P), !center(Ch, P).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- link.between(Ch, P), params.line(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !link.between(Ch, P).
