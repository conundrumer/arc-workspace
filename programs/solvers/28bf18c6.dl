// 28bf18c6
// @keywords: crop tile-arrangement
// input: One shape lies on bg.
// output: The output arranges params.copies copies of the shape's
//  bounding-box crop along params.axis.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl axis(a: Axis) axis(AXIS_H).
    .decl copies(n: number) copies(2).
}

.init params = Params

.init shape_box = Bbox<Unit>
shape_box.cell($U(), P) :- in(P, Col), !params.bg(Col).

.init strip = AxisFrame<Unit>
strip.extent($U(), A, N) :- params.axis(A), params.copies(N).

out(P_grid, Col) :-
    in(P, Col), shape_box.box($U(), B), crop(P, B, P_intile),  // a cell of the shape's box
    strip.cell($U(), A, P_copy),                               // copy index
    concat_slab(P_copy, P_intile, A, 0, P_grid).               // place within the copy
