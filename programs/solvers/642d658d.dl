// 642d658d
// concept: count rank
// Noise grid with plus shapes: four same-colored arms around a center
// cell. Detect × select models of the 1×1 output color, data-equivalent
// on this task — the winning arm color has exactly two pluses in every
// pair under every detect:
//   detect $Center — pluses sit on cells of a stored center color
//   detect $Halo   — any cell ringed by one non-bg color; bg is the
//                    pair's dominant color (bg varies across pairs)
//   detect $Footprint — arms at a stored mask's offsets around its
//                    anchor, on cells of the center color
//   select $Mode   — the arm color with the most pluses
//   select $Count  — the arm color with a stored plus count

#include "../lib.dl"

.type Detect = Center {} | Halo {} | Footprint {}
.type Select = Mode {} | Count {}
.type Choice = [detect: Detect, select: Select]

.comp Params {
    // --- $Center ---
    .decl center(c: Color) center(4).

    // --- $Count ---
    .decl target(n: number) target(2).

    // --- $Footprint ---
    .decl fp_cell(p: Position)
    GRID_MASK_3x3(fp_cell,
        0, 1, 0,
        1, 0, 1,
        0, 1, 0)

    .decl anchor(p: Position)
    anchor([1, 1, 1, 1]).
}

.init params = Params

.decl arm(p: Position, d: Dir, col: Color)
arm(P, D, Col) :- in(P, _), dir_elem(D), neighbor(P, D, P2), in(P2, Col).

// Some dir lacks a Col arm — a differing or missing neighbor.
.decl mismatch(p: Position, col: Color)
mismatch(P, Col) :- arm(P, _, Col), dir_elem(D), !arm(P, D, Col).

// P's four neighbors all exist and share color Col.
.decl ring(p: Position, col: Color)
ring(P, Col) :- arm(P, _, Col), !mismatch(P, Col).

// --- $Halo bg: the pair's dominant color ---
.init grid_bg = Mode<Unit, Color, Position>
grid_bg.item($U(), Col, P) :- in(P, Col).

.decl plus(dt: Detect, p: Position, col: Color)
plus($Center(), P, Col) :- ring(P, Col), in(P, Cc), params.center(Cc).
plus($Halo(),   P, Col) :- ring(P, Col), !grid_bg.mode($U(), Col).

// --- $Footprint ---
// The mask's cells as offsets from its anchor.
.decl fp_off(off: Shift)
fp_off(Off) :- params.fp_cell(S), params.anchor(A), displacement(A, S, Off).

.decl fp_arm(p: Position, off: Shift, col: Color)
fp_arm(P, Off, Col) :-
    in(P, Cc), params.center(Cc),                    // candidate anchor cell
    fp_off(Off), compose(P, Off, P2), in(P2, Col).   // the cell at one offset

.decl fp_mismatch(p: Position, col: Color)
fp_mismatch(P, Col) :- fp_arm(P, _, Col), fp_off(Off), !fp_arm(P, Off, Col).

plus($Footprint(), P, Col) :- fp_arm(P, _, Col), !fp_mismatch(P, Col).

.init plus_count = Mode<Detect, Color, Position>
plus_count.item(Dt, Col, P) :- plus(Dt, P, Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- $Mode ---
out(ORIGIN, Col, [Dt, $Mode()]) :- plus_count.mode(Dt, Col).

// --- $Count ---
out(ORIGIN, Col, [Dt, $Count()]) :- plus_count.tally(Dt, Col, N), params.target(N).

// --- determination ---

.comp Determine {
    .decl center_at(e: Example, p: Position)
    center_at(E, P) :- ex_in(E, P, Col), params.center(Col).

    // Every offset from a center cell to a cell of its own grid.
    .decl cand(off: Shift)
    cand(Off) :- center_at(E, P), ex_in(E, P2, _), displacement(P, P2, Off).

    // Lands off the grid at some center — no color to compare there.
    .decl off_grid(off: Shift)
    off_grid(Off) :- cand(Off), center_at(E, P), compose(P, Off, P2), !ex_in(E, P2, _).

    .decl on_grid(off: Shift)
    on_grid(Off) :- cand(Off), !off_grid(Off).

    .decl differ(off: Shift, off2: Shift)
    differ(Off, Off2) :-
        on_grid(Off), on_grid(Off2), center_at(E, P),   // two offsets at a center
        compose(P, Off, P1), ex_in(E, P1, Col),         // color at one
        compose(P, Off2, P2), ex_in(E, P2, Col2),       // color at the other
        Col != Col2.

    // A plus's arms hold one color, so the footprint is the largest set of
    // offsets that agree in color at every center.
    .init arm_off = Mode<Unit, Shift, Shift>
    arm_off.item($U(), Off, Off2) :- on_grid(Off), on_grid(Off2), !differ(Off, Off2).

    .init frame = BoxFrame<Unit>
    frame.cell($U(), Off)    :- arm_off.mode($U(), Off).
    frame.grid($U(), ORIGIN) :- arm_off.mode($U(), _).    // the anchor sits at zero offset

    .decl fp_cell(p: Position)
    fp_cell(P) :- arm_off.mode($U(), Off), frame.inner($U(), Off, P).

    .decl anchor(p: Position)
    anchor(P) :- frame.inner($U(), ORIGIN, P).

    .decl winner(e: Example, p: Position)
    winner(E, P) :-
        ex_out(E, _, Col), center_at(E, P),                      // pair's output color
        arm_off.mode($U(), Off), compose(P, Off, P2), ex_in(E, P2, Col).    // an arm holds it

    .init win_count = Tally<Example, Position>
    win_count.item(E, P) :- winner(E, P).

    .decl target(n: number)
    target(N) :- win_count.tally(_, N).
}
