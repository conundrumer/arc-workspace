// 642d658d
// @keywords: count rank noise
// input: A noise grid holds plus shapes: four same-colored arms around a
//  center cell.
// output: The output is one cell, painted the arm color that the select
//  model picks among the arm colors the detect model finds.

// which cells count as a plus
.type Detect =
    // pluses sit on cells of a stored center color
    Center {}
    // any cell ringed by one non-bg color; bg is the pair's dominant color,
    // which varies across pairs
  | Halo {}
    // arms at a stored set of offsets around the center, on cells of the
    // center color
  | Footprint {}

// which arm color wins
.type Select =
    // the arm color with the most pluses
    Mode {}
    // the arm color with a stored plus count
  | Count {}

// which cells count as a plus, crossed with which arm color wins
.type Choice = [detect: Detect, select: Select]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl out_dim(a: Axis, n: number)
    out_dim(AXIS_V, 1). out_dim(AXIS_H, 1).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(AXIS_V, V), out_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    // --- $Center ---
    .decl center(c: Color) center(4).

    // --- $Count ---
    .decl target(n: number) target(2).

    // --- $Footprint ---
    .decl fp_off(off: Offset)   // the arms, as offsets from the center
    GRID_STAMP_3x3(fp_off,
        _,  1, _,
        1, @_, 1,
        _,  1, _)
}

.init params = Params

.decl arm(p: Position, d: Dir, col: Color)
arm(P, D, Col) :- in(P, _), dir_elem(D), neighbor(P, D, P2), in(P2, Col).

// Some dir lacks a Col arm — a differing or missing neighbor.
.decl mismatch(p: Position, col: Color)
mismatch(P, Col) :- arm(P, _, Col), dir_elem(D), !arm(P, D, Col).

// P's four neighbors all exist and share color Col.
.decl ring(p: Position, col: Color)
ring(P, Col) :- arm(P, _, Col), !mismatch(P, Col).

// --- $Halo bg: the pair's dominant color ---
.init grid_bg = Mode<Unit, Color, Position>
grid_bg.item($U(), Col, P) :- in(P, Col).

.decl plus(dt: Detect, p: Position, col: Color)
plus($Center(), P, Col) :- ring(P, Col), in(P, Cc), params.center(Cc).
plus($Halo(),   P, Col) :- ring(P, Col), !grid_bg.mode($U(), Col).

// --- $Footprint ---
.decl fp_arm(p: Position, off: Offset, col: Color)
fp_arm(P, Off, Col) :-
    in(P, Cc), params.center(Cc),                           // candidate center cell
    params.fp_off(Off), compose(P, Off, P2), in(P2, Col).   // the cell at one offset

.decl fp_mismatch(p: Position, col: Color)
fp_mismatch(P, Col) :- fp_arm(P, _, Col), params.fp_off(Off), !fp_arm(P, Off, Col).

plus($Footprint(), P, Col) :- fp_arm(P, _, Col), !fp_mismatch(P, Col).

.init plus_count = Mode<Detect, Color, Position>
plus_count.item(Dt, Col, P) :- plus(Dt, P, Col).

// The two selects are data-equivalent on this task: under every detect, the
// winning arm color has exactly two pluses in every pair.

// --- $Mode ---
out(P, Col, [Dt, $Mode()]) :- plus_count.mode(Dt, Col), params.out_pos(P).

// --- $Count ---
out(P, Col, [Dt, $Count()]) :-
    plus_count.tally(Dt, Col, N), params.target(N), params.out_pos(P).

.comp Determine {
    .decl center_at(e: Example, p: Position)
    center_at(E, P) :- ex_in(E, P, Col), params.center(Col).

    // Every offset from a center cell to a cell of its own grid.
    .decl cand(off: Offset)
    cand(Off) :- center_at(E, P), ex_in(E, P2, _), relative(P, P2, Off).

    // Lands off the grid at some center — no color to compare there.
    .decl off_grid(off: Offset)
    off_grid(Off) :- cand(Off), center_at(E, P), compose(P, Off, P2), !ex_in(E, P2, _).

    .decl on_grid(off: Offset)
    on_grid(Off) :- cand(Off), !off_grid(Off).

    .decl differ(off: Offset, off2: Offset)
    differ(Off, Off2) :-
        on_grid(Off), on_grid(Off2), center_at(E, P),   // two offsets at a center
        compose(P, Off, P1), ex_in(E, P1, Col),         // color at one
        compose(P, Off2, P2), ex_in(E, P2, Col2),       // color at the other
        Col != Col2.

    // A plus's arms hold one color, so the footprint is the largest set of
    // offsets that agree in color at every center.
    .init arm_off = Mode<Unit, Offset, Offset>
    arm_off.item($U(), Off, Off2) :- on_grid(Off), on_grid(Off2), !differ(Off, Off2).

    .decl fp_off(off: Offset)
    fp_off(Off) :- arm_off.mode($U(), Off).

    .decl winner(e: Example, p: Position)
    winner(E, P) :-
        ex_out(E, _, Col), center_at(E, P),                      // pair's output color
        arm_off.mode($U(), Off), compose(P, Off, P2), ex_in(E, P2, Col).    // an arm holds it

    .init win_count = Tally<Example, Position>
    win_count.item(E, P) :- winner(E, P).

    .decl target(n: number)
    target(N) :- win_count.tally(_, N).

    .decl out_dim(a: Axis, n: number)
    out_dim(A, N) :- ex_out(_, P, _), axis_elem(A), axis_dim(P, A, N).
}
