// 195ba7dc
// @representative: 5d2a5c43

// how the input decomposes into tiles
.type DecChoice =
    // pre-tabulated in the parameters via tile_pos
    Table {}
    // derived in the program by tile count
  | Count {}
    // derived in the program by tile size
  | Size {}

// how the tiles combine into the output
.type Body =
    // combine table keyed on (outer pos, color); set-equality match
    Lookup {}
    // OR via existence: any non-bg input contribution
  | Or {}

.type Choice    = [d: DecChoice, b: Body]

.type CombineMember = [p: Position, col: Color]
.type CombineKey    = [p: Position, dc: DecChoice]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl frame_dim(a: Axis, n: number)
    frame_dim(AXIS_V, 5). frame_dim(AXIS_H, 6).

    // --- $Table: decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 1). arr_dim(AXIS_H, 2).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah),
        frame_dim(AXIS_V, Fv), frame_dim(AXIS_H, Fh), gap(G),
        helpers.tile_pos([Av, Ah], [Fv, Fh], [0, G], P_grid, P_tile, P_intile).

    // --- $Count, Size decompose data ---
    .decl divide_axis(a: Axis)
    divide_axis(AXIS_H).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- $Count: decompose data ---
    .decl divisor(n: number)
    divisor(2).

    // --- $Lookup: combine data ---
    .decl combine_member(id: Ident, p_outer: Position, c: Color)
    .decl combine_out(id: Ident, c_out: Color)

    combine_member(0, [0,0,0,1], 0). combine_member(0, [0,0,1,0], 0). combine_out(0, 0).
    combine_member(1, [0,0,0,1], 7). combine_member(1, [0,0,1,0], 0). combine_out(1, 1).
    combine_member(2, [0,0,0,1], 0). combine_member(2, [0,0,1,0], 7). combine_out(2, 1).
    combine_member(3, [0,0,0,1], 7). combine_member(3, [0,0,1,0], 7). combine_out(3, 1).

    // --- $Or: combine data ---
    .decl frame(p: Position)
    frame(P) :- frame_dim(AXIS_V, Fv), frame_dim(AXIS_H, Fh), helpers.frame_pos([Fv, Fh], P).
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(1).
}

.init params = Params

.init combine_match = KeyedSetCompare<CombineKey, Ident, CombineMember>
combine_match.pattern_member(Id, [P_outer, C]) :- params.combine_member(Id, P_outer, C).
combine_match.observed_member([P_grid_out, Dc], [P_tile, C]) :-
    decompose(P_grid_in, P_tile, P_grid_out, Dc), in(P_grid_in, C).

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Table()).
dec_choice($Count()).
dec_choice($Size()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Table()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Count()) :-
    in(P_grid, _), params.divide_axis(A), params.divide_gap(G),
    params.divisor(N),                                              // tile count
    divide_slab(P_grid, A, N, G, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Size()) :-
    in(P_grid, _), params.divide_axis(A), params.divide_gap(G),
    params.frame_dim(A, K),                                         // tile size = output frame extent
    divide_by_size_slab(P_grid, A, K, G, P_tile, P_intile).

// --- $Or ---

.decl filled(o: Position, dc: DecChoice)
filled(P_grid_out, Dc) :-
    in(P_grid_in, Col), !params.bg(Col),        // non-bg input cell
    decompose(P_grid_in, _, P_grid_out, Dc).

// --- Output ---

out(P_grid_out, Col_out, [Dc, $Lookup()]) :-
    params.combine_out(Id, Col_out),
    combine_match.equals([P_grid_out, Dc], Id).     // cell's tiles == entry's members

out(P_grid_out, Col, [Dc, $Or()]) :-
    dec_choice(Dc), params.frame(P_grid_out),       // choice × cell
    ( filled(P_grid_out, Dc), params.out_fill(Col)
    ; !filled(P_grid_out, Dc), params.bg(Col)
    ).
