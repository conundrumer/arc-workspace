// 1cf80156
// concept: crop
// Output is the grid cropped to the ink's bounding box.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), !params.bg(Col).

.decl out(p: Position, col: Color)
out(P_inner, Col) :- in(P_grid, Col), bbox.box($U(), B), crop(P_grid, B, P_inner).
