// 1cf80156
// Output is the grid cropped to the ink's bounding box.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl ink(p: Position)
ink(P) :- in(P, Col), !c.bg(Col).

.init box = Bbox<Unit>
box.cell($U(), P) :- ink(P).
box.grid($U(), P) :- in(P, _).

// Each box cell viewed from the box, keyed by the cell.
.init boxframe = Reframe<Position>
boxframe.outer(P, M) :- box.inside($U(), P), box.margin($U(), M).
boxframe.cell(P, P)  :- box.inside($U(), P).

.decl out(p: Position, col: Color)
out(P_out, Col) :- in(P, Col), boxframe.inner(P, P_out).

.output out(IO=stdout)
