// 1cf80156
// concept: crop
// Output is the grid cropped to the ink's bounding box.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl ink(p: Position)
ink(P) :- in(P, Col), !c.bg(Col).

.init boxframe = BoxFrame<Unit>
boxframe.cell($U(), P) :- ink(P).
boxframe.grid($U(), P) :- in(P, _).

.decl out(p: Position, col: Color)
out(P_out, Col) :- in(P, Col), boxframe.inner($U(), P, P_out).
