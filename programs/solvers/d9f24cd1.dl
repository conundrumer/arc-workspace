// d9f24cd1
// @keywords: markers walk
// output: Each mark walks away from the mark edge, painting the mark color; a
//  block-colored cell ahead deflects the walk one cell to the dodge side.

// which edge is the mark edge
.type Choice =
    // params.dir names it
    Dir {}
    // the edge each mark sits on
  | Edge {}

// The cases coincide here — every mark is on the bottom edge — and diverge
// when marks sit on another edge.

// A walker: the cell it stands on and its heading.
.type Walker = [p: Position, w: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(c: Color) mark(2).
    .decl block(c: Color) block(5).

    // Dodge side, as a turn from the walk direction.
    .decl dodge(s: Sense) dodge(SENSE_CW).

    // --- $Dir ---
    .decl dir(d: Dir) dir(DIR_B).   // mark edge; walks flow away from it
}

.init params = Params

// The walk: starts at each mark, headed away from the mark edge; steps
// ahead while clear; deflects one cell to the dodge side when blocked.
.init walk = Propagation<Choice, Walker>

// --- $Dir ---
walk.source($Dir(), [P, W]) :-
    in(P, Col), params.mark(Col),       // mark cell
    params.dir(D), opposite(D, W).      // away from the params.dir edge

// --- $Edge ---
walk.source($Edge(), [P, W]) :-
    in(P, Col), params.mark(Col),    // mark cell
    dir_elem(D), dist(P, D, 0),      // on some edge
    opposite(D, W).                  // away from it

// --- $Dir, $Edge ---
walk.edge(Ch, [P, W], [P2, W]) :-
    impl_choice(Ch), in(P, _), dir_elem(W),
    neighbor(P, W, Q),                         // cell ahead
    ( in(Q, Col), !params.block(Col), P2 = Q   // clear — step onto it
    ; in(Q, Col), params.block(Col),           // holds the block color
      params.dodge(Sn), turn(Sn, W, Dd),       // dodge direction
      neighbor(P, Dd, P2), in(P2, _)           // sidestep instead
    ).

// The cells a walk visits.
.decl walked(p: Position, ch: Choice)
walked(P, Ch) :- walk.reached(Ch, [P, _]).

.decl impl_choice(ch: Choice)
impl_choice($Dir()). impl_choice($Edge()).

out(P, Col, Ch) :- walked(P, Ch), params.mark(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !walked(P, Ch).
