// af22c60d
// concept: symmetry repair
// A grid whose pattern is mirror-symmetric on each axis, occluded by cells
// of a mask color; the output restores them. Each axis mirror reflects a
// band of the grid onto itself and carries the perpendicular coordinate
// through, so a cell outside one band still has an image under the other.
// A masked cell takes the color of a visible cell one of the mirrors
// reaches.

#include "../lib.dl"

.comp Params {
    .decl mask(col: Color) mask(0).

    // Per axis, the mirror band: flush with edge `flush`, inset k from the
    // opposite edge.
    .decl mirror_band(a: Axis, flush: Dir, k: number)
    mirror_band(AXIS_V, DIR_B, 2).
    mirror_band(AXIS_H, DIR_R, 2).
}

.init params = Params

.decl masked(p: Position)
masked(P) :- in(P, Col), params.mask(Col).

// The axis flip, shifted onto the band. A cell outside the band lands off
// the grid and gets no image.
.decl mirror(p: Position, q: Position)
mirror(P, Q) :-
    in(P, _), params.mirror_band(A, D, K),  // cell and an axis band
    flip_of(A, F), apply(F, P, P_flip),     // flip the axis
    jump(P_flip, D, K, Q),                  // shift onto the band
    in(Q, _).                               // image is a grid cell

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), !masked(P).
out(P, Col) :- masked(P), mirror(P, Q), !masked(Q), in(Q, Col).

// --- determination ---

.comp Determine {
    // Axis positions the examples' cells occupy, and visible cells split by
    // axis (materialized once — the mirror sweep joins on the components).
    .decl apos(a: Axis, along: Position)
    apos(A, Along) :- ex_in(_, P, _), axis_elem(A), split(P, A, Along, _).

    .decl cell_split(e: Example, a: Axis, along: Position, across: Position, col: Color)
    cell_split(E, A, Along, Across, Col) :-
        ex_in(E, P, Col), !params.mask(Col), axis_elem(A), split(P, A, Along, Across).

    // Candidate mirrors per axis: flush dir, inset k from the opposite edge.
    .decl cand(a: Axis, flush: Dir, k: number)
    cand(A, D, K) :-
        apos(A, Along), axis_of(D, A),
        ( K = 0 ; sub_extent(Along, A, K) ).

    // The candidate's map on axis positions: flip, shift onto the band.
    .decl band_map(a: Axis, flush: Dir, k: number, along: Position, along2: Position)
    band_map(A, D, K, L, L2) :-
        cand(A, D, K), apos(A, L),            // candidate and axis position
        flip_of(A, F), apply(F, L, L_flip),   // flip the axis
        jump(L_flip, D, K, L2), apos(A, L2).  // image is on the grid

    // The candidate maps two visible cells to different colors...
    .decl broken(a: Axis, flush: Dir, k: number)
    broken(A, D, K) :-
        band_map(A, D, K, L1, L2),
        cell_split(E, A, L1, X, C1),
        cell_split(E, A, L2, X, C2), C1 != C2.

    // ...or relates no two distinct visible cells.
    .decl witnessed(a: Axis, flush: Dir, k: number)
    witnessed(A, D, K) :-
        band_map(A, D, K, L1, L2), L1 != L2,
        cell_split(E, A, L1, X, _),
        cell_split(E, A, L2, X, _).

    .decl mirror_band(a: Axis, flush: Dir, k: number)
    mirror_band(A, D, K) :- witnessed(A, D, K), !broken(A, D, K).
}
