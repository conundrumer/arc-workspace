// a8d7556c
// @draft
// @keywords: objects noise rank
// @scene speckle-field: params.hole cells lie in no pattern among cells of
//  another color, and some of them form solid rectangles with each side at
//  least params.min_side
// @rule greedy-rect-fill: from the params.hole cells not yet claimed, take the
//  all-params.hole rectangle of largest area with each side at least
//  params.min_side, and paint its cells params.fill; repeat until no such
//  rectangle is left. Undefined where overlapping rectangles of equal area
//  claim differently under different claim orders.
// @rule keep-rest: every other cell keeps its input color

// which cells stay claimed when rectangles share cells
.type Overlap =
    // @claim greedy-rect-fill
    LargestFirst {}
    // @rule greedy-rect-fill: each rectangle that no other rectangle contains
    //  fills, unless such a rectangle of larger area overlaps it
    // @witness cross-remnant: ordinary concept
    // @witness equal-overlap: ordinary $DropDominated
  | DropDominated {}
    // @rule greedy-rect-fill: rectangles claim in order of their extent along
    //  params.first_axis, then of their area
    // @witness transposed-train2: ordinary concept
  | AxisFirst {}

// which rectangles count
.type Qualify =
    // @claim greedy-rect-fill
    AnyRect {}
    // @rule greedy-rect-fill: a rectangle counts only when its extent along
    //  one axis is params.min_side and no line of params.hole cells beside it
    //  extends it along that axis
    // @witness square3: variant concept
  | ThicknessTwo {}

.type Choice = [overlap: Overlap, qualify: Qualify]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive RarestColor: variant derived
    //     @relaxed speckle-field
    .decl hole(c: Color) hole(0).
    .decl fill(c: Color) fill(2).
    .decl min_side(k: number) min_side(2).

    // --- $AxisFirst ---
    .decl first_axis(a: Axis) first_axis(AXIS_V).
}

.init params = Params

.decl overlap_choice(o: Overlap)
overlap_choice($LargestFirst()). overlap_choice($DropDominated()). overlap_choice($AxisFirst()).

.decl qualify_choice(q: Qualify)
qualify_choice($AnyRect()). qualify_choice($ThicknessTwo()).

.decl excluded_choice(ch: Choice)
excluded_choice([$AxisFirst(), $ThicknessTwo()]).

.decl impl_choice(ch: Choice)
impl_choice([O, Q]) :- overlap_choice(O), qualify_choice(Q), !excluded_choice([O, Q]).

// The rectangles the hole cells span, and the claims made along a claim
// order under every scan.
.type Span = [p: Position, q: Position]
.type ScanKey = [c: DiagDir, a: Axis]
.type Run = [ch: Choice, c: DiagDir, a: Axis]

.decl hole_cell(p: Position)
hole_cell(P) :- in(P, Col), params.hole(Col).

// The box two hole cells span.
// @claim greedy-rect-fill
.init span = Bbox<Span>
span.cell([P, Q], P2) :- hole_cell(P), hole_cell(Q), ( P2 = P ; P2 = Q ).

.decl spoiled(b: Box)
spoiled(B) :- span.box([_, _], B), in(P, Col), !params.hole(Col), inside(P, B).

.decl short(b: Box)
short(B) :-
    span.box([_, _], B), in(P, _),                 // a cell gives the grid's frame
    box_extent(B, P, _, N), params.min_side(K), N < K.

.decl rect(b: Box)
rect(B) :- span.box([_, _], B), !spoiled(B), !short(B).

.decl rect_cell(b: Box, p: Position)
rect_cell(B, P) :- rect(B), hole_cell(P), inside(P, B).

.decl overlap(b: Box, b2: Box)
overlap(B, B2) :- rect_cell(B, P), rect_cell(B2, P).

// @claim greedy-rect-fill
.init area = Tally<Box, Position>
area.item(B, P) :- rect_cell(B, P).

.decl corner_cell(b: Box, d: DiagDir, p: Position)
corner_cell(B, D, P) :- rect_cell(B, P), box_corner(P, B, D).

// --- $ThicknessTwo ---

// Another rectangle holds b and is longer than b only along axis a.
.decl thicker(b: Box, a: Axis)
thicker(B, A) :-
    rect(B), rect(B2), B != B2, inside(B, B2),
    perp(A, A2), axis_of(D, A2), opposite(D, D2),
    same_dist(D, B, B2), same_dist(D2, B, B2).

// --- concept, $ThicknessTwo, $AxisFirst, $DropDominated, $DropDominated & $ThicknessTwo ---

.decl cand(q: Qualify, b: Box)
cand($AnyRect(), B) :- rect(B).
// A rectangle whose extent along some axis is params.min_side, and that no
// rectangle extends along that axis.
cand($ThicknessTwo(), B) :-
    rect_cell(B, P), box_extent(B, P, A, K), params.min_side(K),
    !thicker(B, A).

// --- concept, $ThicknessTwo, $AxisFirst ---

// The scans: from corner c along primary axis a.
.decl scan(c: DiagDir, a: Axis)
scan(C, A) :- diag_dir_elem(C), axis_elem(A).

// @claim greedy-rect-fill
.init lex = LexOrder<ScanKey>
lex.corner([C, A], C) :- scan(C, A).
lex.axis([C, A], A) :- scan(C, A).
lex.cell([C, A], P) :- scan(C, A), corner_cell(_, _, P).

// The rectangles in claim order, before the scan breaks a tie: the larger
// first, by the measures the overlap reading compares.
// @claim greedy-rect-fill
.init by_size = Order<Overlap, Box>

// The rectangles in scan order: by the cell at the scan's corner, then by the
// cell at the opposite corner.
// @claim greedy-rect-fill
.init scan_order = Order<ScanKey, Box>
scan_order.elem([C, A], B) :- scan(C, A), rect(B).
scan_order.score([C, A], B, R) :- scan(C, A), corner_cell(B, C, P), lex.rank([C, A], P, R).
scan_order.secondary_score([C, A], B, R) :-
    scan(C, A), diag_opposite(C, C2), corner_cell(B, C2, Q), lex.rank([C, A], Q, R).

// @claim greedy-rect-fill
.init claim_order = Order<Run, Box>

// A claim of b_last takes b out of the running.
.decl blocks(run: Run, b_last: Box, b: Box)

// The walk along the claim order: a rectangle no earlier claim took out
// claims, and takes out each rectangle it blocks; a rectangle taken out
// is passed over.
// @claim greedy-rect-fill
.init claim = Take<Run, Box, Box>
claim.start(Ru, B) :- claim_order.first(Ru, B).
claim.init_untaken(Ru, B) :- claim_order.elem(Ru, B).
claim.conflict(Ru, B, B2) :- blocks(Ru, B, B2).
claim.step(Ru, B, B2) :- claim_order.next(Ru, B, B2), claim.untaken(Ru, B, B).
claim.skip(Ru, B, B2) :- claim_order.next(Ru, B, B2), claim.excluded(Ru, B, B).
claim.take(Ru, B, B) :- claim_order.elem(Ru, B), claim.untaken(Ru, B, B).

.decl claimed_cell(ch: Choice, c: DiagDir, a: Axis, p: Position)
claimed_cell(Ch, C, A, P) :- claim.take([Ch, C, A], B, B), rect_cell(B, P).

// --- $LargestFirst ---

by_size.elem($LargestFirst(), B) :- rect(B).
by_size.score($LargestFirst(), B, N) :- area.tally(B, N).

// --- concept, $ThicknessTwo, $AxisFirst ---

// The cases whose claim takes out every rectangle it overlaps.
.decl greedy(ch: Choice)
greedy([$LargestFirst(), $AnyRect()]).
greedy([$LargestFirst(), $ThicknessTwo()]).
greedy([$AxisFirst(), $AnyRect()]).

// The size order claims first, and the scan decides between two of one size.
claim_order.elem([[Ov, Q], C, A], B) :- greedy([Ov, Q]), scan(C, A), cand(Q, B).
claim_order.score([[Ov, Q], C, A], B, R) :-
    greedy([Ov, Q]), claim_order.elem([[Ov, Q], C, A], B), by_size.rank_desc(Ov, B, R).
claim_order.secondary_score([Ch, C, A], B, R) :-
    greedy(Ch), claim_order.elem([Ch, C, A], B), scan_order.rank([C, A], B, R).

blocks([Ch, C, A], B, B2) :-
    greedy(Ch), claim_order.elem([Ch, C, A], B), overlap(B, B2).

// --- $AxisFirst ---

.decl axis_len(b: Box, n: number)
axis_len(B, N) :- params.first_axis(A), rect_cell(B, P), box_extent(B, P, A, N).

// The longer rectangle along the first axis comes first, and area decides
// between two of one length.
by_size.elem($AxisFirst(), B) :- rect(B).
by_size.score($AxisFirst(), B, N) :- axis_len(B, N).
by_size.secondary_score($AxisFirst(), B, N) :- area.tally(B, N).

// --- concept, $ThicknessTwo, $AxisFirst ---

// Every scan's claims fill, so a cell two scans claim differently takes two
// colors.
out(P, Col, Ch) :-
    in(P, C), greedy(Ch), scan(D, A),
    ( claimed_cell(Ch, D, A, P), params.fill(Col)
    ; !claimed_cell(Ch, D, A, P), Col = C
    ).

// --- $DropDominated, $DropDominated & $ThicknessTwo ---

.decl contained(q: Qualify, b: Box)
contained(Q, B) :- cand(Q, B), cand(Q, B2), B != B2, inside(B, B2).

.decl maximal(q: Qualify, b: Box)
maximal(Q, B) :- cand(Q, B), !contained(Q, B).

.decl dominated(q: Qualify, b: Box)
dominated(Q, B) :-
    maximal(Q, B), maximal(Q, B2), overlap(B, B2),
    area.tally(B, N), area.tally(B2, N2), N2 > N.

.decl kept_cell(q: Qualify, p: Position)
kept_cell(Q, P) :- maximal(Q, B), !dominated(Q, B), rect_cell(B, P).

out(P, Col, [$DropDominated(), Q]) :-
    in(P, C), qualify_choice(Q),
    ( kept_cell(Q, P), params.fill(Col)
    ; !kept_cell(Q, P), Col = C
    ).
