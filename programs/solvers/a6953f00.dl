// a6953f00
// concept: crop
// Output is the 2×2 crop at a top corner; either corner is a valid output.
// One $Crop candidate per corner in c.crop_corner.

#include "../lib.dl"

.type Choice = Crop {d: DiagDir}

.comp Consts {
    .init helpers = ConstsHelpers

    // The crop anchors at a corner on crop_side — the task pins neither.
    .decl crop_side(d: Dir) crop_side(DIR_T).
    .decl crop_corner(d: DiagDir)
    crop_corner(C) :- crop_side(D), dir_of(C, _, D).

    .decl frame_dim(k: number) frame_dim(2).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).
}

.init c = Consts

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, $Crop(D)) :-
    in(P_grid_in, Col),                          // input cell
    c.frame(P_grid_out),                         // output frame position
    c.crop_corner(D),                            // candidate corner
    corner_anchor(D, P_grid_out, P_grid_in).     // corner-anchored crop
