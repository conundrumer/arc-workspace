// a6953f00
// keywords: crop
// output: the 2×2 crop at a corner of params.crop_side. Either corner of that
//  side is a valid output, so out carries one grid per corner.

.type TiebreakResolution = Corner {d: DiagDir}

.decl out(p: Position, col: Color, res: TiebreakResolution)

.comp Params {
    .init helpers = ParamsHelpers

    // The grid edge whose corners the crop anchors at.
    .decl crop_side(d: Dir) crop_side(DIR_T).
    .decl crop_corner(d: DiagDir)
    crop_corner(C) :- crop_side(D), dir_of(C, _, D).

    .decl frame_dim(k: number) frame_dim(2).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).
}

.init params = Params

out(P_grid_out, Col, $Corner(D)) :-
    in(P_grid_in, Col), params.frame(P_grid_out),
    params.crop_corner(D), corner_anchor(D, P_grid_out, P_grid_in).
