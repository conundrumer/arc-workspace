// Output is a 2×2 corner crop. Both TL- and TR-anchored crops are valid;
// the alternatives are enumerated as separate candidates via a choice_id
// column on out. The runner accepts if any candidate matches the expected
// output (or the task's tiebreak alt).

#include "../lib.dl"

.comp Consts {
    // Each diag option carries its choice_id; out propagates the id so
    // candidates are separable downstream.
    .decl diag_option(d: DiagDir, choice_id: number)
    diag_option(TOP_LEFT,  0).
    diag_option(TOP_RIGHT, 1).

    .decl frame(p: Position)
    frame(P) :- frame_pos([2, 2], P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, choice_id: number)
out(P_grid_out, Col, Cid) :-
    in(P_grid_in, Col),                          // input cell
    c.frame(P_grid_out),                         // output position
    c.diag_option(D, Cid),                       // candidate diag + its id
    corner_anchor(D, P_grid_out, P_grid_in).     // corner-anchor match

.output out(IO=stdout)
