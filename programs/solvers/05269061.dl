// 05269061
// @keywords: wallpaper count
// output: Wallpaper of diagonal stripes: color is constant along
//  params.stripe_axis and repeats every `period` stripes. The input shows a
//  patch; the output is the full grid. Colors propagate from input cells
//  through the wallpaper's symmetries: unit steps along the stripe,
//  period-length jumps on the four cardinals.
//  Coincide while the visible period equals the color count.

// Two models of the period, tagged on out's Choice
.type Choice =
    // period is task data in the parameters
    Fixed {}
    // period = palette size: stripes cycle the colors, each once
  | Palette {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl stripe_axis(da: DiagAxis) stripe_axis(DAXIS_AD).

    // --- $Fixed ---
    .decl period(k: number) period(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Fixed()). impl_choice($Palette()).

// Unit step along the stripe: toward each corner of the stripe axis.
.decl stripe_step(delta: Position)
stripe_step(Delta) :-
    params.stripe_axis(Da), diag_axis_of(Diag, Da),          // the axis's two corners
    step_offset(Diag, Delta).

// --- period per choice ---

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- in(_, Col), !params.bg(Col).

.decl period(k: number, ch: Choice)
period(K, $Fixed())   :- params.period(K).
period(K, $Palette()) :- palette.tally($U(), K).

.decl period_jump(delta: Position, ch: Choice)
period_jump(Delta, Ch) :- period(K, Ch), dir_elem(D), jump_offset(D, K, Delta).

// --- closure under the wallpaper symmetries ---

.decl known(p: Position, col: Color, ch: Choice)
known(P, Col, Ch) :- in(P, Col), !params.bg(Col), impl_choice(Ch).
known(Q, Col, Ch) :-
    known(P, Col, Ch),
    ( stripe_step(D)        // one step along the stripe
    ; period_jump(D, Ch)    // one period on
    ),
    compose(P, D, Q), in(Q, _).

out(P, Col, Ch) :- known(P, Col, Ch).
