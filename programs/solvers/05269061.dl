// 05269061
// @keywords: wallpaper count
// output: Wallpaper of diagonal stripes: color is constant along
//  params.stripe_axis and repeats every `period` stripes. The input shows a
//  patch; the output is the full grid. Each cell takes the color of the
//  input cells whose stripe index agrees with its own within the period.
//  Coincide while the visible period equals the color count.

// Two models of the period, tagged on out's Choice
.type Choice =
    // period is task data in the parameters
    Fixed {}
    // period = palette size: stripes cycle the colors, each once
  | Palette {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl stripe_axis(da: DiagAxis) stripe_axis(DAXIS_AD).

    // --- $Fixed ---
    .decl period(k: number) period(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Fixed()). impl_choice($Palette()).

// --- period per choice ---

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- in(_, Col), !params.bg(Col).

.decl period(k: number, ch: Choice)
period(K, $Fixed())   :- params.period(K).
period(K, $Palette()) :- palette.tally($U(), K).

// --- stripe classes ---

// A cell's stripe class: its stripe's index, counted from a corner of the
// perpendicular diagonal, within the period.
.decl phase(diag: DiagDir, p: Position, r: number, ch: Choice)
phase(Diag, P, R, Ch) :-
    in(P, _), period(K, Ch),
    params.stripe_axis(Da), diag_perp(Da, Da2), diag_axis_of(Diag, Da2),   // a corner across the stripes
    corner_dist(P, Diag, T), stride(T, K, 0, _, R).                        // stripe index within the period

out(Q, Col, Ch) :-
    phase(Diag, P, R, Ch), in(P, Col), !params.bg(Col),   // a colored cell of the class
    phase(Diag, Q, R, Ch).
