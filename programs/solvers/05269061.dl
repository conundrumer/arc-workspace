// 05269061
// Wallpaper of diagonal stripes: color is constant along c.stripe_axis and
// repeats every `period` stripes. The input shows a patch; the output is the
// full grid. Colors propagate from input cells through the wallpaper's
// symmetries — unit steps along the stripe, period-length jumps on the four
// cardinals. Two models of the period, tagged on out's Choice:
//
//   $Fixed   — period is task data in Consts.
//   $Palette — period = palette size: stripes cycle the colors, each once.
//
// Coincide while the visible period equals the color count.

#include "../lib.dl"

.type Choice = Fixed {} | Palette {}

.comp Consts {
    .decl bg(c: Color)              bg(0).
    .decl stripe_axis(da: DiagAxis) stripe_axis(DAXIS_AD).

    // --- $Fixed ---
    .decl period(k: number)         period(3).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Fixed()). impl_choice($Palette()).

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Unit step along the stripe: toward each corner of the stripe axis.
.decl stripe_step(delta: Position)
stripe_step(Delta) :-
    c.stripe_axis(Da), diag_axis_of(Diag, Da),          // the axis's two corners
    diag_step_delta(Diag, Delta).

// --- period per choice ---

.decl palette(col: Color)
palette(Col) :- in(_, Col), !c.bg(Col).

.decl period(k: number, ch: Choice)
period(K, $Fixed())   :- c.period(K).
period(K, $Palette()) :- K = count : { palette(Col) }.

.decl period_jump(delta: Position, ch: Choice)
period_jump(Delta, Ch) :- period(K, Ch), dir_elem(D), jump_delta(D, K, Delta).

// --- closure under the wallpaper symmetries ---

.decl known(p: Position, col: Color, ch: Choice)
known(P, Col, Ch) :- in(P, Col), !c.bg(Col), impl_choice(Ch).
known(Q, Col, Ch) :- known(P, Col, Ch), stripe_step(D), compose(P, D, Q), in(Q, _).
known(Q, Col, Ch) :- known(P, Col, Ch), period_jump(D, Ch), compose(P, D, Q), in(Q, _).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- known(P, Col, Ch).

.output out(IO=stdout)
