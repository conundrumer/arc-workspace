// 5a719d11
// @draft
// @keywords: decompose move
// input: Uniform lines cut the grid into panels, which pair off across one
//  axis. A panel holds a mark drawn on a ground color.
// output: Each mark leaves its panel and lands at the same place inside the
//  panel it pairs with, drawn in the ground color of the panel it came from.

.decl out(p: Position, col: Color)

.comp Params {
    // The axis a panel pairs across.
    .decl pair_axis(a: Axis) pair_axis(AXIS_H).
}

.init params = Params

.type Line = [a: Axis, l: Position]

.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

.init frame = DividerTiles<Unit>
frame.cell($U(), P) :- in(P, _).
// A uniform line spans the grid, so it cuts panels apart rather than sitting in one.
frame.divider($U(), A, L) :- line_color.value([A, L], _).

// Each panel's box, so paired panels share a cell vocabulary.
.init panel = Bbox<Position>
panel.cell(T, P) :- frame.tile_of($U(), P, T).

// A panel's cells, in the panel's own frame.
.decl panel_cell(t: Position, p_grid: Position, p_intile: Position)
panel_cell(T, P_grid, P_intile) :-
    panel.cell(T, P_grid), panel.box(T, B), crop(P_grid, B, P_intile).

// The ground a panel is drawn on: its commonest color.
.init ground = Mode<Position, Color, Position>
ground.item(T, Col, P_grid) :- panel_cell(T, P_grid, _), in(P_grid, Col).

// A cell of the panel's mark: everything the ground does not cover.
.decl mark(t: Position, p_intile: Position)
mark(T, P_intile) :- panel_cell(T, P_grid, P_intile), in(P_grid, Col), !ground.mode(T, Col).

// --- program ---

out(P_grid, Col) :-
    panel_cell(T, P_grid, P_intile),
    params.pair_axis(A), flip_of(A, D), apply(D, T, T2),    // the panel it pairs with
    ( mark(T2, P_intile), ground.mode(T2, Col)              // its mark, in its own ground
    ; !mark(T2, P_intile), ground.mode(T, Col)              // elsewhere this panel's ground
    ).
out(P_grid, Col) :- in(P_grid, Col), !frame.tile_of($U(), P_grid, _).  // the cutting lines stand
