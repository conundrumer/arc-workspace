// be03b35f
// @keywords: decompose d4 repair
// input: Three quadrant-witnesses of a canonical 2×2, anchored at the input's
//  TL, TR, and BL corners. The marker quadrant (BR) is absent from the
//  template.
// output: Each witness's anchored cells map, by its quadrant's D4 in
//  params.template, onto the canonical orientation; the union of the three
//  images is the output. Overlap or missing cells would break the grid
//  bounds, so consistency across witnesses falls out without an explicit
//  check.

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl frame_dim(k: number) frame_dim(2).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    .decl template(diag: DiagDir, d4: D4)
    template(DIAG_TL, D4_CC).
    template(DIAG_TR, D4_HT).
    template(DIAG_BL, D4_CW).
}

.init params = Params

out(P_grid_out, Col) :-
    in(P_grid_in, Col),                          // input cell
    params.template(Diag, D),                    // (quadrant, canonicalizing D4)
    params.frame(P_anchor),                      // anchored 2×2 position
    corner_anchor(Diag, P_anchor, P_grid_in),    // P_anchor matches input at quadrant corner
    apply(D, P_anchor, P_grid_out).              // P_grid_out = D4 applied to P_anchor

.comp Determine {
    .type Quad = [e: Example, diag: DiagDir]

    // Each quadrant's anchored cells must map onto the whole output.
    .init d4m = D4Map<Quad, Color>
    d4m.src([E, Diag], P_anchor, Col) :-
        diag_dir_elem(Diag), ex_in(E, P_in, Col), ex_out(E, _, _),
        params.frame(P_anchor), corner_anchor(Diag, P_anchor, P_in).
    d4m.dst([E, Diag], P, Col) :- diag_dir_elem(Diag), ex_out(E, P, Col).

    .decl broken(diag: DiagDir, d4: D4)
    broken(Diag, D) :- d4m.mismatch([E, Diag], D), ex_out(E, _, _).

    .decl template(diag: DiagDir, d4: D4)
    template(Diag, D) :-
        diag_dir_elem(Diag), d4_elem(D),
        ex_out(_, _, _), !broken(Diag, D).
}
