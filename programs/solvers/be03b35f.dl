// be03b35f
// Three quadrant-witnesses (TL, TR, BL) collapse to one canonical 2×2.
// Each template entry pairs a quadrant DiagDir with the D4 that takes that
// quadrant's anchored cells to the canonical orientation. Set-dedup over
// the union collapses the three witnesses; consistency falls out naturally
// (overlap or missing cells would break the grid bounds).
//
// The marker quadrant (BR) is absent from the template.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl frame(p: Position)
    frame(P) :- helpers.frame_pos([2, 2], P).

    .decl template(diag: DiagDir, d4: D4)
    template(TOP_LEFT,    ROT_CCW).
    template(TOP_RIGHT,   ROT_180).
    template(BOTTOM_LEFT, ROT_CW).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_grid_in, Col),                          // input cell
    c.template(Diag, D),                         // (quadrant, canonicalizing D4)
    c.frame(P_anchor),                           // anchored 2×2 position
    corner_anchor(Diag, P_anchor, P_grid_in),    // P_anchor matches input at quadrant corner
    apply(D, P_anchor, P_grid_out).              // P_grid_out = D4 applied to P_anchor

.output out(IO=stdout)
