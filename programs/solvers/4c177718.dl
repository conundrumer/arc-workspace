// 4c177718
// @draft
// @keywords: decompose markers crop stamp lookup
// input: A line of one color cuts the grid into two panels. The scene panel
//  holds one shape, in the anchor color. The legend panel holds a copy of
//  that shape, an arrow, and a payload shape.
// output: The arrow names a direction, and the output is the scene panel
//  with the payload's box stamped against the shape's box on that side,
//  aligned across the arrow.

// what the payload attaches to
.type Target =
    // the scene cells in the anchor color
    Colored {}
    // where the legend's copy occurs in the scene
  | Template {}

// how the arrow names a direction
.type Aim =
    // it points away from the widest edge of its box, the bar
    Widest {}
    // its picture is a stored chart, in a pose that carries the chart's tip
    // direction
  | Glyph {}

.type Choice = [target: Target, aim: Aim]

.type Line = [a: Axis, l: Position]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl divider(col: Color) divider(5).
    .decl anchor(col: Color) anchor(1).
    .decl arrow(col: Color) arrow(2).

    // --- $Glyph ---

    RIGID(chart,
        .decl glyph(p: Position)
        GRID_MASK_3x3(glyph,
            _, 1, _,
            _, 1, _,
            1, 1, 1)
        .decl tip(d: Dir) tip(DIR_T).
    )
}

.init params = Params

// --- the panels the divider cuts ---

.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

// The divider is a line its color runs all the way across.
.init panels = DividerTiles<Unit>
panels.cell($U(), P) :- in(P, _).
panels.divider($U(), A, L) :- line_color.value([A, L], Col), params.divider(Col).

// The legend is the panel the arrow sits in.
.decl legend_panel(p_tile: Position)
legend_panel(P_tile) :- in(P, Col), params.arrow(Col), panels.tile_of($U(), P, P_tile).

.decl legend(p: Position)
legend(P) :- panels.tile_of($U(), P, P_tile), legend_panel(P_tile).

.decl scene(p: Position)
scene(P) :- panels.tile_of($U(), P, P_tile), !legend_panel(P_tile).

// --- the scene panel, in its own frame: the output ---

.init view = Bbox<Unit>
view.cell($U(), P) :- scene(P).

.decl cell(p_intile: Position, col: Color)
cell(P_intile, Col) :- scene(P), in(P, Col), view.box($U(), B), crop(P, B, P_intile).

// --- the direction the arrow names ---

.init arrow_box = Bbox<Unit>
arrow_box.cell($U(), P) :- in(P, Col), params.arrow(Col).

.decl heading(a: Aim, d: Dir)

// --- $Widest ---

.init bar = Mode<Unit, Dir, Position>
bar.item($U(), D, P) :- arrow_box.cell($U(), P), arrow_box.box($U(), B), box_edge(P, B, D).

heading($Widest(), D) :- bar.mode($U(), D_bar), opposite(D_bar, D).

// --- $Glyph ---

// The arrow's picture, read in its own box, against the chart in every pose.
.init pose = KeyedSetCompare<Unit, D4, Position>
pose.pattern_member(D, P) :- params.chart_glyph(D, P).
pose.observed_member($U(), P_inner) :-
    arrow_box.cell($U(), P), arrow_box.box($U(), B), crop(P, B, P_inner).

heading($Glyph(), D_tip) :- pose.equals($U(), D), params.chart_tip(D, D_tip).

// --- the payload the legend shows ---

.decl payload(p: Position, col: Color)
payload(P, Col) :-
    legend(P), in(P, Col), !params.bg(Col), !params.anchor(Col), !params.arrow(Col).

.init pay_box = Bbox<Unit>
pay_box.cell($U(), P) :- payload(P, _).

// --- what the payload attaches to ---

.decl target(p_intile: Position, t: Target)

// --- $Colored ---

target(P_intile, $Colored()) :- cell(P_intile, Col), params.anchor(Col).

// --- $Template ---

.decl template(p: Position, col: Color)
template(P, Col) :- legend(P), in(P, Col), params.anchor(Col).

.init occ = Occurrences<Unit, Color>
occ.shape($U(), P, Col) :- template(P, Col).
occ.cell($U(), P, Col) :- scene(P), in(P, Col).

target(P_intile, $Template()) :-
    occ.occurrence($U(), B_occ), template(S, _), compose(B_occ, S, P),  // the template placed
    scene(P), view.box($U(), B), crop(P, B, P_intile).

// --- the stamp ---

.init target_box = Bbox<Target>
target_box.cell(T, P_intile) :- target(P_intile, T).

// The two boxes meet at facing corners: the payload's corner takes the
// cell one step beyond the target's, on the arrow's side. Both alignments
// across the arrow run, and they agree where the boxes are equally wide.
.decl placement(v: Box, c: Choice)
placement(V, [T, A]) :-
    heading(A, D), diag_dirs(Diag, _, D, D_x),                             // the target's corner on that side
    opposite(D, D_back), diag_dirs(Diag_pay, _, D_back, D_x),              // the payload's corner facing it
    target_box.box(T, B_tgt), cell(C, _), corner_anchor(Diag, C, B_tgt),   // the target's corner cell
    neighbor(C, D, S),                                                     // the seat beyond it
    legend(P), pay_box.box($U(), B_pay), box_corner(P, B_pay, Diag_pay),   // the payload's corner cell
    crop(P, B_pay, P_inner),                                               // in the payload's box
    relative(P_inner, S, V).                                    // the frame change that seats the payload

.decl stamp(p_intile: Position, col: Color, c: Choice)
stamp(Q, Col, Ch) :-
    placement(V, Ch), payload(P, Col), pay_box.box($U(), B_pay), crop(P, B_pay, P_inner),
    compose(P_inner, V, Q), cell(Q, _).

.decl impl_choice(ch: Choice)
impl_choice([$Colored(), $Widest()]).  impl_choice([$Colored(), $Glyph()]).
impl_choice([$Template(), $Widest()]). impl_choice([$Template(), $Glyph()]).

out(P_intile, Col, Ch) :- stamp(P_intile, Col, Ch).
out(P_intile, Col, Ch) :-
    cell(P_intile, Col), impl_choice(Ch), !stamp(P_intile, _, Ch).

.comp Determine {
    // Each example's arrow is one copy of the chart, in its own pose.
    .init bbox = Bbox<Example>
    bbox.cell(E, P) :- ex_in(E, P, Col), params.arrow(Col).

    .decl chart_glyph(e: Example, p: Position)
    chart_glyph(E, P_inner) :- bbox.cell(E, P), bbox.box(E, B), crop(P, B, P_inner).
}
