// 135a2760
// @keywords: decompose wallpaper repair
// input: uniform lines cut the grid into framed panels, and each panel's
//  interior is a wallpaper damaged in a few cells.
// output: each axis takes the interior's shortest period; each interior cell
//  takes the modal color of its orbit under the lattice.

.type PanelAxis = [t: Position, a: Axis]
.type Line = [a: Axis, l: Position]

.decl out(p: Position, col: Color)

.comp Params {
}

.init params = Params

// --- panels ---

.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

// A uniform line spans the grid, so it divides panels rather than sit in one.
.init panels = DividerTiles<Unit>
panels.cell($U(), P) :- in(P, _).
panels.divider($U(), A, L) :- line_color.value([A, L], _).

.init frame = Rim<Position>
frame.cell(T, P) :- panels.tile_of($U(), P, T).

.decl inner_cell(t: Position, p: Position)
inner_cell(T, P) :- panels.tile_of($U(), P, T), !frame.rim(T, P).

// --- lattice ---

.init si = OffsetInvariance<Position, Color>
si.cell(T, P, Col) :- inner_cell(T, P), in(P, Col).

// The interior's period per axis: the shortest. On an axis with no true
// period the shortest is pair-less, so it generates nothing.
.init period = Extremes<PanelAxis>
period.cand([T, A], K) :- si.period(T, A, K).

// --- repair ---

// Orbits of the lattice: the cells a run of periods reaches.
.init orbit = Canon<Position>
orbit.equiv(P, P) :- inner_cell(_, P).
orbit.equiv(P, Q) :-
    orbit.equiv(P, R),                              // reached so far
    si.pair(T, A, K, R, Q), period.low([T, A], K).  // one period on

.init pattern = Mode<Ident, Color, Position>
pattern.item(Cls, Col, P) :- orbit.id(P, Cls), in(P, Col).

out(P, Col) :- orbit.id(P, Cls), pattern.mode(Cls, Col).
out(P, Col) :- in(P, Col), !inner_cell(_, P).
