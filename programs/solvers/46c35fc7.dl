// 46c35fc7
// @draft
// @keywords: objects permutation d4 walk lookup enclose
// input: Ink cells ring holes in the params.bg field, eight around one.
// output: Each ring's colors move around it; the rest of the grid passes
//  through.

// what the move around each ring is
.type Choice =
    // the corners turn a quarter in params.corner_sense, the edges a quarter in
    // params.edge_sense
    Rotate {}
    // the seats form a cycle running in params.cycle_sense; the corners advance
    // params.corner_step seats along it, the edges params.edge_step
  | Cycle {}
    // params.move states the move per direction
  | Table {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).

    // --- $Rotate ---
    .decl corner_sense(s: Sense) corner_sense(SENSE_CC).
    .decl edge_sense(s: Sense) edge_sense(SENSE_CW).

    // --- $Cycle ---
    .decl cycle_sense(s: Sense) cycle_sense(SENSE_CC).
    .decl corner_step(n: number) corner_step(2).
    .decl edge_step(n: number) edge_step(6).

    // --- $Table ---
    .decl move(d: Dir8, d_out: Dir8)
    move(DIAG_TL, DIAG_BL). move(DIAG_BL, DIAG_BR).
    move(DIAG_BR, DIAG_TR). move(DIAG_TR, DIAG_TL).
    move(DIR_T, DIR_R). move(DIR_R, DIR_B).
    move(DIR_B, DIR_L). move(DIR_L, DIR_T).
}

.init params = Params

.comp Parse<Key> {
    .decl grid(key: Key, p: Position, col: Color)

    .decl ink(key: Key, p: Position, col: Color)
    ink(Ky, P, Col) :- grid(Ky, P, Col), !params.bg(Col).

    // A cell with a neighbor that carries no ink — a field cell, or the
    // grid's outside — has no ring around it.
    .decl gap(key: Key, p: Position)
    gap(Ky, P) :- grid(Ky, P, _), dir8_elem(D), neighbor(P, D, Q), !ink(Ky, Q, _).

    .decl ring(key: Key, p_hole: Position, d: Dir8, p: Position, col: Color)
    ring(Ky, P_hole, D, P, Col) :-
        grid(Ky, P_hole, _), !ink(Ky, P_hole, _), !gap(Ky, P_hole),  // a hole in the ink
        dir8_elem(D), neighbor(P_hole, D, P), ink(Ky, P, Col).       // the ink around it
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

// --- program ---

.decl impl_choice(ch: Choice)
impl_choice($Rotate()). impl_choice($Cycle()). impl_choice($Table()).

// The direction a ring cell's color moves to.
.decl moved(d: Dir8, d_out: Dir8, ch: Choice)

out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !parse.ring($U(), _, _, P, _).
out(P_out, Col, Ch) :-
    parse.ring($U(), P_hole, D, _, Col),            // a ring cell, by direction
    moved(D, D_out, Ch),
    neighbor(P_hole, D_out, P_out).                 // the seat it moves onto

// --- $Rotate ---

moved(D, D_out, $Rotate()) :-
    ( diag_dir_elem(D), params.corner_sense(S)           // corners turn one way
    ; dir_elem(D), params.edge_sense(S)                  // edges the other
    ),
    rotation(S, R), apply_dir8(R, D, D_out).

// --- $Cycle ---

.init cycle = CycleWalk<Unit, Dir8>
cycle.succ($U(), D_from, D_to) :-
    params.cycle_sense(S), turn(S, D, D2),               // an edge and the next
    diag_dirs(D_diag, _, D, D2),                         // the corner between them
    ( D_from = D, D_to = D_diag                          // edge, then corner
    ; D_from = D_diag, D_to = D2                         // corner, then edge
    ).
cycle.step($U(), N) :- ( params.corner_step(N) ; params.edge_step(N) ).

moved(D, D_out, $Cycle()) :-
    ( diag_dir_elem(D), params.corner_step(N)            // corners advance one count
    ; dir_elem(D), params.edge_step(N)                   // edges another
    ),
    cycle.walk($U(), D, N, D_out).

// --- $Table ---

moved(D, D_out, $Table()) :- params.move(D, D_out).

.comp Determine {
    .init ex = Parse<Example>
    ex.grid(E, P, Col) :- ex_in(E, P, Col).

    // A ring cell's color stands, in its example's output, on the seat
    // toward D_out.
    .decl landed(d: Dir8, d_out: Dir8)
    landed(D, D_out) :-
        ex.ring(E, P_hole, D, _, Col),
        neighbor(P_hole, D_out, P_out), ex_out(E, P_out, Col).

    // The move carries a ring cell's color onto a seat some example's
    // output fills with another color.
    .decl move_defect(d: Dir8, d_out: Dir8)
    move_defect(D, D_out) :-
        ex.ring(E, P_hole, D, _, Col), dir8_elem(D_out),
        neighbor(P_hole, D_out, P_out), ex_out(E, P_out, Col2), Col2 != Col.

    .decl move(d: Dir8, d_out: Dir8)
    move(D, D_out) :- landed(D, D_out), !move_defect(D, D_out).

    // A quarter turn in sense S carries seat D onto seat D_out.
    .decl turned(s: Sense, d: Dir8, d_out: Dir8)
    turned(S, D, D_out) :- rotation(S, R), apply_dir8(R, D, D_out).

    // A turn some example contradicts: it carries a seat of the class onto
    // a seat that example's output fills with another color.
    .decl corner_sense_defect(s: Sense)
    corner_sense_defect(S) :- turned(S, D, D_out), diag_dir_elem(D), move_defect(D, D_out).

    // The turn a corner's move makes.
    .decl corner_sense(s: Sense)
    corner_sense(S) :-
        move(D, D_out), diag_dir_elem(D), turned(S, D, D_out), !corner_sense_defect(S).

    .decl edge_sense_defect(s: Sense)
    edge_sense_defect(S) :- turned(S, D, D_out), dir_elem(D), move_defect(D, D_out).

    // The turn an edge's move makes.
    .decl edge_sense(s: Sense)
    edge_sense(S) :- move(D, D_out), dir_elem(D), turned(S, D, D_out), !edge_sense_defect(S).
}
