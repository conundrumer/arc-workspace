// 045e512c
// concept: objects markers cast
// One template shape on params.bg, with fragments of it elsewhere. Each fragment
// lies inside a copy of the template one step away; the output marches copies
// along that step, in the fragment's color, until they leave the grid.
//
// The cases differ in what fixes the step's length:
//   $Reach  — the farthest copy the fragment still fits inside.
//   $Stride — a stored pitch.
//   $Abut   — the template's extent plus a stored gap.

#include "../lib.dl"

.type Choice = Reach {} | Stride {} | Abut {}

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(0).

    // --- Stride ---
    .decl stride(k: number) stride(4).

    // --- Abut ---
    .decl gap(g: number) gap(1).
}

.init params = Params

// --- objects ---

.init objs = Components8<Color>
objs.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl object(id: Ident, col: Color, p: Position)
object(Id, Col, P) :- objs.label(Col, P, Id).

// The template is the largest object.
.init biggest = Mode<Unit, Ident, Position>
biggest.item($U(), Id, P) :- object(Id, _, P).

.decl shape(p: Position)
shape(P) :- biggest.mode($U(), Id), object(Id, _, P).

// --- steps ---

// Step lengths the grid admits.
.decl span(k: number)
span(K) :- in(P, _), axis_elem(A), sub_extent(P, A, K).

.decl toward(d: Dir8, k: number, delta: Shift)
toward(D, K, Delta) :- span(K), dir8_elem(D), jump_offset(D, K, Delta).

// Where each object seats on the template: the translations that carry
// every cell of the object onto a template cell.
.init seating = Occurrences<Ident, Unit>
seating.shape(Id, P, $U()) :- object(Id, _, P).
seating.cell(Id, P, $U())  :- object(Id, _, _), shape(P).

// Steps whose copy holds the whole object: the seating's inverse, where it
// is a step. No step holds the template itself, so only the fragments march.
.decl fits(id: Ident, delta: Shift, k: number)
fits(Id, Delta, K) :-
    seating.occurrence(Id, M), relative(M, ZERO, Delta),  // the step undoes the seating
    toward(_, K, Delta).                                        // and is a straight jump

.decl step(id: Ident, delta: Shift, ch: Choice)

// --- Reach ---

.init reach = ArgExtremes<Ident, Shift>
reach.cand(Id, Delta, K) :- fits(Id, Delta, K).

step(Id, Delta, $Reach()) :- reach.high(Id, Delta, _).

// --- Stride ---

step(Id, Delta, $Stride()) :- fits(Id, Delta, K), params.stride(K).

// --- Abut ---

.init sbox = Bbox<Unit>
sbox.cell($U(), P) :- shape(P).

step(Id, Delta, $Abut()) :-
    fits(Id, Delta, _),
    sbox.extents($U(), _, N, N), toward(D, N, S1),  // clear the square template's extent
    params.gap(G), toward(D, G, S2),                // then the gap
    compose(S1, S2, Delta).

// --- output ---

// Copies march from the template until they leave the grid.
.decl copy(id: Ident, p: Position, ch: Choice)
copy(Id, P2, Ch) :-
    step(Id, Delta, Ch),
    ( shape(P)         // the first copy steps from the template
    ; copy(Id, P, Ch)  // each next copy from the last
    ),
    compose(P, Delta, P2), in(P2, _).

.decl impl_choice(ch: Choice)
impl_choice($Reach()). impl_choice($Stride()). impl_choice($Abut()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- copy(Id, P, Ch), object(Id, Col, _).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !copy(_, P, Ch).
