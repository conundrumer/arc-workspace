// 1190bc91
// concept: objects markers cast
// The input holds one color sequence — a line running from a free end (the
// anchor) to the grid edge — and short marker runs. Every sequence cell casts
// its four diagonals in its own color; a ray stops at the first cell a nearer
// sequence cell already lit, and where rays overlap the nearer cell wins.
// What the rays leave unlit takes a marker color:
//
//   $Sector — the anchor's own diagonals cut the grid into four sectors, and
//             a marker colors the sector it sits in.
//   $Flood  — a marker's color spreads through the unlit cells around it.

#include "../lib.dl"

.type Choice = Sector {} | Flood {}

.comp Consts {
    .decl bg(col: Color) bg(0).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Sector()). impl_choice($Flood()).

// --- the sequence and the markers ---

.init obj = Components<Unit>
obj.node($U(), P) :- in(P, Col), !c.bg(Col).

// The sequence is the object that runs from a free end to the grid edge:
// d heads along the run toward the edge, and the anchor is the free end.
.decl seq(id: Ident, d: Dir, anchor: Position)
seq(Id, D, P_a) :-
    obj.label($U(), P, Id), dir_elem(D),
    neighbor(P, D, P2), obj.label($U(), P2, Id),     // a run along D
    obj.label($U(), P_far, Id), dist(P_far, D, 0),   // far end on the edge
    obj.label($U(), P_a, Id), opposite(D, D_back),   // anchor: nothing behind
    neighbor(P_a, D_back, P_b), !obj.node($U(), P_b).

.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), obj.label($U(), P, Id), !seq(Id, _, _).

// Sequence cells indexed by their distance from the anchor.
.init walk = Ray<Unit>
walk.dir($U(), D) :- seq(_, D, _).
walk.cell($U(), P) :- obj.label($U(), P, Id), seq(Id, _, _).
walk.mark($U(), P) :- seq(_, _, P).

.decl seq_idx(p: Position, k: number)
seq_idx(P, K) :- walk.ray($U(), P, _, K, _).

// --- the rays ---

.init arm = Ray<number>
arm.dir(K, D) :- seq_idx(_, K), diag_dir_elem(D).
arm.cell(K, P) :- seq_idx(_, K), in(P, _).
arm.mark(K, P) :- seq_idx(P, K).

// A cell a nearer sequence cell already lit.
arm.blocked(K, P) :- seq_idx(_, K), arm.ray(J, P, _, _, _), J < K.

// Where the lit rays overlap, the nearest sequence cell wins. A ray reaches
// its blocking cell and stops there.
.init nearest = Extremes<Position>
nearest.cand(P, K) :- ( arm.clear(K, P, _, _, _) ; arm.stop(K, P, _, _, _) ).

.decl paint(p: Position, k: number)
paint(P, K) :- nearest.low(P, K).

// --- the marker areas ---

.init area = Components<Choice>

// --- Sector ---

// The anchor's own diagonals, which the sectors lie between.
.decl cross(p: Position)
cross(P) :- seq(_, _, A), seq_idx(A, K), arm.ray(K, P, _, _, _).

area.node($Sector(), P) :- in(P, _), !cross(P).

// --- Flood ---

area.node($Flood(), P) :- in(P, _), !paint(P, _).

// --- output ---

.decl fill(ch: Choice, id: Ident, col: Color)
fill(Ch, Id, Col) :- marker(P, Col), area.label(Ch, P, Id).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :-
    impl_choice(Ch), paint(P, K),        // a lit cell, in the color of
    seq_idx(P_seq, K), in(P_seq, Col).   // the sequence cell that lit it
out(P, Col, Ch) :-
    area.label(Ch, P, Id), !paint(P, _),  // a cell no ray reached
    ( fill(Ch, Id, Col)                   // the marker color of its area
    ; !fill(Ch, Id, _), c.bg(Col)         // no marker there
    ).
