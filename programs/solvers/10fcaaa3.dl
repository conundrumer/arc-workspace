// 10fcaaa3
// @keywords: tile-arrangement stamp lookup
// input: a few marks on a bg ground, tiled into a params.copies×params.copies
//  arrangement.
// output: a halo is stamped around every mark of the arrangement, filling bg
//  cells only.

// the halo's footprint
.type Choice =
    // one step toward each corner, painted params.paint
    Corners {}
    // a stored params.footprint stamp, anchored on the mark
  | Table {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl copies(n: number) copies(2).

    // --- $Corners ---
    .decl paint(col: Color) paint(8).

    // --- $Table ---
    // Halo cells as offsets from the mark.
    .decl footprint(delta: Offset, col: Color)
    GRID_STAMP_SPARSE_3x3(footprint,
        8,  _, 8,
        _, @_, _,
        8,  _, 8)
}

.init params = Params

// copies×copies arrangement of a grid, and the marks on its bg ground.
.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    .init arrangement = Frame2D<Unit>
    arrangement.extent($U(), A, N) :- axis_elem(A), params.copies(N).

    .decl tiled(key: Key, p: Position, col: Color)
    tiled(K, P_grid_out, Col) :-
        arrangement.cell($U(), P_tile), cell(K, P_intile, Col),
        concat_2d(P_tile, P_intile, 0, P_grid_out).  // one copy of the grid per tile

    .decl mark(key: Key, p: Position)
    mark(K, P) :- tiled(K, P, Col), !params.bg(Col).

    .decl ground(key: Key, p: Position)
    ground(K, P) :- tiled(K, P, Col), params.bg(Col).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// The halo as offsets from the mark.
.decl stamp(off: Offset, col: Color, ch: Choice)

// --- $Corners ---

stamp(Off, Col, $Corners()) :-
    diag_dir_elem(Diag), step_offset(Diag, Off), params.paint(Col).

// --- $Table ---

stamp(Off, Col, $Table()) :- params.footprint(Off, Col).

.decl impl_choice(ch: Choice)
impl_choice($Corners()). impl_choice($Table()).

.decl halo(p: Position, col: Color, ch: Choice)
halo(P, Col, Ch) :-
    parse.mark($U(), Q),                      // a mark of the arrangement
    stamp(Off, Col, Ch), compose(Q, Off, P),  // the stamp seated on it
    parse.ground($U(), P).                    // its target: an on-grid bg cell

out(P, Col, Ch) :- halo(P, Col, Ch).
out(P, Col, Ch) :- parse.tiled($U(), P, Col), impl_choice(Ch), !halo(P, _, Ch).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // Cells the stamp painted: output ink where the arrangement holds bg.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- ex_out(E, P, Col), !params.bg(Col), parse.ground(E, P).

    // A candidate footprint cell: a painted cell as an offset from some mark.
    .decl witness(off: Offset, e: Example, p: Position, col: Color)
    witness(Off, E, P, Col) :-
        painted(E, P, Col), parse.mark(E, M), relative(M, P, Off).

    // A candidate some seating of it contradicts.
    .decl mismatch(off: Offset, col: Color)
    mismatch(Off, Col) :-
        witness(Off, _, _, Col),
        parse.mark(E, M), compose(M, Off, P), parse.ground(E, P),  // seated on a mark, over bg
        ex_out(E, P, C2), C2 != Col.                               // the output holds something else

    // The painted cells each surviving candidate accounts for.
    .decl explains(off: Offset, e: Example, p: Position, col: Color)
    explains(Off, E, P, Col) :- witness(Off, E, P, Col), !mismatch(Off, Col).

    // Another candidate accounts for that cell too.
    .decl shared(off: Offset, e: Example, p: Position, col: Color)
    shared(Off, E, P, Col) :- explains(Off, E, P, Col), explains(Off2, E, P, Col), Off2 != Off.

    // The offsets a painted cell leaves no other candidate for.
    .decl footprint(delta: Offset, col: Color)
    footprint(Off, Col) :- explains(Off, E, P, Col), !shared(Off, E, P, Col).
}
