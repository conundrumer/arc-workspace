// a395ee82
// @draft
// @keywords: objects markers stamp bbox rank
// @scene background: one color fills most of the grid
// @scene objects: cells of one color that touch at an edge or a corner form
//  one object
// @scene shape: one object has more than one cell, in one color S; its
//  bounding box is h rows by w columns
// @scene dots: every other object is a single cell, a dot, and the dots sit
//  on a lattice with a step of params.dot_step on both axes; exactly one dot
//  has the color S, and that dot is the anchor; all the other dots are the
//  markers, in one color C, which is neither S nor the background
// @rule lattice: each dot takes the lattice offset (di, dj): its row and
//  column distances from the anchor, counted in steps of params.dot_step
// @rule stamp: for each dot, the output draws the shape's cells moved by
//  di · (h + params.stamp_gap) rows and dj · (w + params.stamp_gap) columns,
//  clipped at the grid edge; the anchor's stamp covers the shape's own place
// @rule stamp-color: the anchor's stamp is drawn in C, and each marker's
//  stamp in S
// @rule erase: every other cell of the output is the background

// which cells join into one object
.type Adjacency =
    // @claim objects
    CornerJoin {}
    // @scene objects: cells of one color that share an edge form one object
    // @witness corner-joined-shape: variant concept
    // @witness corner-tail: variant concept
  | EdgeAdjacency {}

// which cells are the markers
.type Markers =
    // @claim dots
    SingleDots {}
    // @scene dots: every cell of the one non-background color other than S
    //  is a marker, and that color is C; undefined when there is more than
    //  one such color
    // @witness touching-markers: borderline $LargestPiece & $AnchorNearest & $StepGcd
    //     @relaxed dots
  | MarkersByColor {}

// which object is the shape
.type Shape =
    // @claim shape
    OnePiece {}
    // @scene shape: the largest object is the shape, in its color S, and the
    //  other objects of more than one cell are erased; undefined when two
    //  objects tie for largest
    // @witness second-object: borderline $LargestPiece & $AnchorNearest
    //     @relaxed shape
  | LargestPiece {markers: Markers}

// which dot is the anchor
.type Anchor =
    // @claim dots
    ShapeColorDot {}
    // @scene dots: of the dots in S, the anchor is the one whose summed
    //  taxicab distance to the markers is least, and the other dots in S are
    //  erased; undefined at a tie
    // @witness stray-shape-cell: borderline $LargestPiece & $AnchorNearest
    //     @relaxed dots
  | AnchorNearest {}
    // @scene dots: the anchor is the dot whose color no other dot has, and
    //  the markers are the other dots, all in one color C; undefined when no
    //  color, or more than one, occurs on one dot alone
    // @witness anchor-third-color: foreign $LargestPiece & $AnchorMinority
    //     @relaxed dots
  | AnchorMinority {}

// how a dot's place gives the block of its stamp
.type Lattice =
    // @claim lattice
    StoredStep {}
    // @rule lattice: the step is the largest at which every marker lies on
    //  the anchor's lattice
    // @witness sparse-lattice: borderline concept
    // @witness step-three: variant $LargestPiece & $AnchorNearest & $StepGcd
    //     @relaxed dots
  | StepGcd {}
    // @rule lattice: on each axis, a dot's offset is its line's rank among
    //  the dots' distinct lines, less the anchor's
    // @witness skipped-row: borderline concept
    // @witness sparse-lattice: borderline concept
    // @witness step-three: variant $LargestPiece & $AnchorNearest & $StepGcd
  | LatticeRank {}

// what one stamp copies
.type Content =
    // @claim stamp
    ShapeCells {}
    // @rule stamp: each stamp copies the shape's bounding box; a cell in S
    //  takes the stamp's color, and a cell of any other color keeps its color
    // @witness dot-in-box: borderline concept
    //     @relaxed dots
  | BoxStamp {}

.type Choice = [shape: Shape, anchor: Anchor, lattice: Lattice, content: Content,
                objects: Adjacency]

// An object under one adjacency.
.type Piece = [j: Adjacency, id: Ident]

// The shape, anchor, and markers one case reads.
.type Read = [sh: Shape, an: Anchor, j: Adjacency]

// A candidate anchor under a read.
.type Cand = [r: Read, p: Position]

// A line on axis a that the path from a candidate anchor to marker m
// crosses.
.type Leg = [m: Position, a: Axis, l: Position]

// A dot of a read, counted toward d from the anchor.
.type Rung = [r: Read, q: Position, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @ignore: derive — no derivation gives the gap 0, so no stamp sits next
    //  to the shape, as the stamps of train 0 do
    .decl stamp_gap(k: number) stamp_gap(0).

    // --- $StoredStep ---
    // @ignore: derive — no derivation gives the step 2 alone; at another
    //  step, a marker of train 0 lies off the lattice or its stamp lands on a
    //  wrong block
    .decl dot_step(k: number) dot_step(2).
}

.init params = Params

// The background, the objects under each adjacency, each object's bounding
// box, and the one object of more than one cell.
.comp Parse<Key> {
    .type KeyColor = [ky: Key, col: Color]
    .type KeyAdjacency = [ky: Key, j: Adjacency]
    .type KeyPiece = [ky: Key, j: Adjacency, id: Ident]

    .decl cell(ky: Key, p: Position, col: Color)

    // @claim background
    .init palette = Mode<Key, Color, Position>
    palette.item(Ky, Col, P) :- cell(Ky, P, Col).

    .decl bg(ky: Key, col: Color)
    bg(Ky, Col) :- palette.mode(Ky, Col).

    .decl fg(ky: Key, col: Color)
    fg(Ky, Col) :- cell(Ky, _, Col), !bg(Ky, Col).

    .decl object(ky: Key, j: Adjacency, id: Ident, col: Color, p: Position)

    // --- $CornerJoin ---
    // @claim objects
    .init joined8 = Components8<KeyColor>
    joined8.node([Ky, Col], P) :- cell(Ky, P, Col), fg(Ky, Col).

    object(Ky, $CornerJoin(), Id, Col, P) :- joined8.label([Ky, Col], P, Id).

    // --- $EdgeAdjacency ---
    // @claim objects
    .init joined4 = Components<KeyColor>
    joined4.node([Ky, Col], P) :- cell(Ky, P, Col), fg(Ky, Col).

    object(Ky, $EdgeAdjacency(), Id, Col, P) :- joined4.label([Ky, Col], P, Id).

    // --- shared ---
    // An object of more than one cell.
    .decl multi(ky: Key, j: Adjacency, id: Ident)
    multi(Ky, J, Id) :- object(Ky, J, Id, _, P), object(Ky, J, Id, _, Q), P != Q.

    // @claim stamp
    .init box = Bbox<KeyPiece>
    box.cell([Ky, J, Id], P) :- object(Ky, J, Id, _, P).

    // --- $OnePiece ---
    // @claim shape
    .init sole = Unanimous<KeyAdjacency, Ident>
    sole.item([Ky, J], Id) :- multi(Ky, J, Id).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl adjacency_choice(j: Adjacency)
adjacency_choice($CornerJoin()). adjacency_choice($EdgeAdjacency()).

.decl markers_choice(m: Markers)
markers_choice($SingleDots()). markers_choice($MarkersByColor()).

.decl anchor_choice(an: Anchor)
anchor_choice($ShapeColorDot()). anchor_choice($AnchorNearest()). anchor_choice($AnchorMinority()).

.decl lattice_choice(la: Lattice)
lattice_choice($StoredStep()). lattice_choice($StepGcd()). lattice_choice($LatticeRank()).

.decl content_choice(co: Content)
content_choice($ShapeCells()). content_choice($BoxStamp()).

// The concept case, and the cases that read the largest object and a nearest
// or lone-colored anchor. Each case that reads the one object of more than
// one cell, or the one S dot, is subsumed by the same case with the largest
// object or the nearest anchor. Markers by color under the stored step are
// subsumed by single dots unless the anchor is lone-colored.
.decl impl_choice(ch: Choice)
impl_choice([$OnePiece(), $ShapeColorDot(), $StoredStep(), $ShapeCells(), $CornerJoin()]).
impl_choice([$LargestPiece($SingleDots()), An, La, Co, J]) :-
    anchor_choice(An), An != $ShapeColorDot(), lattice_choice(La), content_choice(Co),
    adjacency_choice(J).
impl_choice([$LargestPiece($MarkersByColor()), An, La, Co, J]) :-
    anchor_choice(An), An != $ShapeColorDot(), lattice_choice(La), La != $StoredStep(),
    content_choice(Co), adjacency_choice(J).
impl_choice([$LargestPiece($MarkersByColor()), $AnchorMinority(), $StoredStep(), Co, J]) :-
    content_choice(Co), adjacency_choice(J).

// A dot: an object of one cell.
.decl dot(j: Adjacency, p: Position, col: Color)
dot(J, P, Col) :- parse.object($U(), J, Id, Col, P), !parse.multi($U(), J, Id).

// The shape object and its color S under each shape reading.
.decl shape(sh: Shape, j: Adjacency, id: Ident, s: Color)

// The markers reading each shape reading takes.
// @ignore: head-repeat — $LargestPiece holds its markers reading as a field,
//  and the relation reads that field out, where $OnePiece takes $SingleDots
.decl markers_of(sh: Shape, m: Markers)

// --- $OnePiece ---
shape($OnePiece(), J, Id, S) :- parse.sole.value([$U(), J], Id), parse.object($U(), J, Id, S, _).

markers_of($OnePiece(), $SingleDots()).

// --- $LargestPiece ---
// @claim shape
.init size = Tally<Piece, Position>
size.item([J, Id], P) :- parse.object($U(), J, Id, _, P).

// @claim shape
.init largest = ArgExtremes<Adjacency, Ident>
largest.cand(J, Id, N) :- size.tally([J, Id], N).

// @claim shape
.init biggest = Unanimous<Adjacency, Ident>
biggest.item(J, Id) :- largest.high(J, Id, _).

shape($LargestPiece(M), J, Id, S) :-
    markers_choice(M), biggest.value(J, Id), parse.object($U(), J, Id, S, _).

markers_of($LargestPiece(M), M) :- markers_choice(M).

// --- shared ---
.decl read(r: Read)
read([Sh, An, J]) :- shape(Sh, J, _, _), anchor_choice(An).

// The colors the markers cannot take under each read.
.decl reserved(r: Read, col: Color)

// @claim dots
.init ink = Unanimous<Read, Color>

// @claim dots
.init anchor = Unanimous<Read, Position>

.decl marker(r: Read, p: Position)

// --- $ShapeColorDot, $AnchorNearest ---
reserved([Sh, An, J], S) :-
    read([Sh, An, J]), An != $AnchorMinority(), shape(Sh, J, _, S).

// --- $ShapeColorDot ---
anchor.item([Sh, $ShapeColorDot(), J], P) :- shape(Sh, J, _, S), dot(J, P, S).

// --- $AnchorNearest ---
// Each dot in S, scored by its summed taxicab distance to the markers: each
// marker counts the lines past the dot up to its own, on both axes.
// @claim dots
.init span = Tally<Cand, Leg>
span.item([R, P], [M, A, L]) :-
    R = [Sh, $AnchorNearest(), J], shape(Sh, J, _, S), dot(J, P, S), marker(R, M),
    line(A, L), axis_of(D, A),
    nearer(D, M, P), nearer(D, L, P), !nearer(D, L, M).   // past P toward M, up to M

// The lines of the grid on each axis, axis-only.
// @store: borderline $LargestPiece & $AnchorNearest
//     @relaxed dots
.decl line(a: Axis, l: Position)
line(A, L) :- in(P, _), axis_elem(A), split(P, A, L, _).

// @claim dots
.init nearest = ArgExtremes<Read, Position>
nearest.cand(R, P, N) :- span.tally([R, P], N).

anchor.item(R, P) :- nearest.low(R, P, _).

// --- $AnchorMinority ---
// A color that more than one dot has.
.decl repeated(j: Adjacency, col: Color)
repeated(J, Col) :- dot(J, P, Col), dot(J, Q, Col), P != Q.

// @claim dots
.init lone = Unanimous<Adjacency, Color>
lone.item(J, Col) :- dot(J, _, Col), !repeated(J, Col).

reserved([Sh, $AnchorMinority(), J], A) :- read([Sh, $AnchorMinority(), J]), lone.value(J, A).

anchor.item([Sh, $AnchorMinority(), J], P) :-
    read([Sh, $AnchorMinority(), J]), lone.value(J, A), dot(J, P, A).

// --- concept, $SingleDots ---
ink.item([Sh, An, J], C) :-
    read([Sh, An, J]), markers_of(Sh, $SingleDots()), dot(J, _, C), !reserved([Sh, An, J], C).

marker([Sh, An, J], M) :-
    markers_of(Sh, $SingleDots()), ink.value([Sh, An, J], C), dot(J, M, C).

// --- $MarkersByColor ---
reserved([Sh, An, J], S) :-
    read([Sh, An, J]), markers_of(Sh, $MarkersByColor()), shape(Sh, J, _, S).

ink.item([Sh, An, J], C) :-
    read([Sh, An, J]), markers_of(Sh, $MarkersByColor()), parse.fg($U(), C), !reserved([Sh, An, J], C).

marker([Sh, An, J], M) :-
    markers_of(Sh, $MarkersByColor()), ink.value([Sh, An, J], C), in(M, C).

// --- shared ---
// The dots a read stamps at, each with its stamp's color: the anchor's in C,
// each marker's in S.
.decl paint(r: Read, q: Position, col: Color)
paint(R, P, C) :- anchor.value(R, P), ink.value(R, C).
paint([Sh, An, J], M, S) :- marker([Sh, An, J], M), shape(Sh, J, _, S).

// The lattice place each read gives each dot it stamps at: the count of
// lattice steps from the anchor to the dot toward each side, as an offset in
// steps.
.decl place(r: Read, la: Lattice, q: Position, i: Offset)

// Some marker lies off the lattice.
.decl astray(r: Read, la: Lattice)
astray(R, La) :- marker(R, M), lattice_choice(La), !place(R, La, M, _).

// --- $StoredStep, $StepGcd ---
// The lattice steps each reading tries.
.decl pitch(r: Read, la: Lattice, k: number)

// Dot q lies a whole number of steps k from the anchor on each axis, and i
// counts those steps.
.decl on_step(r: Read, la: Lattice, k: number, q: Position, i: Offset)
on_step(R, La, K, Q, I) :-
    pitch(R, La, K), anchor.value(R, P), paint(R, Q, _), relative(P, Q, V),
    diag_dirs(_, _, D1, D2), opposite(D1, O1), opposite(D2, O2),
    dist(V, O1, T1), dist(V, O2, T2),                     // toward d1 and d2
    stride(T1, K, 0, N1, 0), stride(T2, K, 0, N2, 0),     // whole steps
    jump(ZERO, D1, N1, I1), jump(I1, D2, N2, I).

// --- $StoredStep ---
pitch(R, $StoredStep(), K) :- read(R), params.dot_step(K).

place(R, $StoredStep(), Q, I) :- on_step(R, $StoredStep(), _, Q, I).

// --- $StepGcd ---
pitch(R, $StepGcd(), K) :- anchor.value(R, P), axis_elem(A), sub_extent(P, A, K).

// Some marker lies off the lattice at step k.
.decl off_step(r: Read, k: number)
off_step(R, K) :- pitch(R, $StepGcd(), K), marker(R, M), !on_step(R, $StepGcd(), K, M, _).

// @claim lattice
// @ignore cand: store — the stored reading of the step is StoredStep
.init steps = Extremes<Read>
steps.cand(R, K) :- pitch(R, $StepGcd(), K), !off_step(R, K).

place(R, $StepGcd(), Q, I) :- steps.high(R, K), on_step(R, $StepGcd(), K, Q, I).

// --- $LatticeRank ---
// The dot lines past the anchor's line toward d, up to the dot's own.
// @claim lattice
.init rungs = Tally<Rung, Position>
rungs.domain([R, Q, D]) :-
    anchor.value(R, P), paint(R, Q, _), dir_elem(D), opposite(D, O), !nearer(O, Q, P).
rungs.item([R, Q, D], L) :-
    anchor.value(R, P), paint(R, Q, _), paint(R, Q2, _), axis_of(D, A),
    split(Q2, A, L, _), split(P, A, L_p, _), split(Q, A, L_q, _),
    nearer(D, L, L_p), !nearer(D, L, L_q).

place(R, $LatticeRank(), Q, I) :-
    diag_dirs(_, _, D1, D2), rungs.tally([R, Q, D1], N1), rungs.tally([R, Q, D2], N2),
    jump(ZERO, D1, N1, I1), jump(I1, D2, N2, I).

// --- shared ---
// The move from the shape's own block to the block i blocks away: each block
// spans the shape's extent, then the gap. A block counts where its corner
// nearest the shape lies in the grid.
.decl block(sh: Shape, j: Adjacency, i: Offset, v: Offset)
block(Sh, J, I, V) :-
    shape(Sh, J, Id, _), parse.box.box([$U(), J, Id], B), params.stamp_gap(G),
    diag_dirs(_, A, D1, D2), perp(A, A2), opposite(D1, O1), opposite(D2, O2),
    in(X, _), relative(B, X, X_rel), dist(X_rel, O1, T1), dist(X_rel, O2, T2),
    box_extent(B, X, A, N1), box_extent(B, X, A2, N2),
    stride(T1, N1, G, K1, 0), stride(T2, N2, G, K2, 0),   // x starts a block on each axis
    jump(ZERO, D1, K1, I1), jump(I1, D2, K2, I),
    jump(ZERO, D1, T1, V1), jump(V1, D2, T2, V).

// --- shared ---
// A cell the stamp copies, at the shape's own place, with its input color.
.decl source(sh: Shape, co: Content, j: Adjacency, p: Position, col: Color)

// --- $ShapeCells ---
source(Sh, $ShapeCells(), J, P, S) :- shape(Sh, J, Id, S), parse.object($U(), J, Id, S, P).

// --- $BoxStamp ---
source(Sh, $BoxStamp(), J, P, Col) :-
    shape(Sh, J, Id, _), parse.box.box([$U(), J, Id], B), in(P, Col), inside(P, B).

// --- shared ---
.decl stamped(ch: Choice, p: Position, col: Color)
stamped([Sh, An, La, Co, J], P2, Col) :-
    paint([Sh, An, J], Q, C_stamp), place([Sh, An, J], La, Q, I), block(Sh, J, I, V),
    source(Sh, Co, J, P, C_own), compose(P, V, P2), in(P2, _),   // clipped at the grid edge
    shape(Sh, J, _, S),
    ( C_own = S, Col = C_stamp
    ; C_own != S, Col = C_own
    ).

// The case's shape, anchor, and markers exist, and every marker lies on its
// lattice.
.decl ready(ch: Choice)
ready([Sh, An, La, Co, J]) :-
    impl_choice([Sh, An, La, Co, J]),
    anchor.value([Sh, An, J], _), marker([Sh, An, J], _),
    !astray([Sh, An, J], La).

out(P, Col, Ch) :-
    ready(Ch),
    ( stamped(Ch, P, Col)
    ; in(P, _), parse.bg($U(), Col), !stamped(Ch, P, _)
    ).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The shape's cells and its color S, as the concept reads them.
    .decl shape_cell(e: Example, p: Position, s: Color)
    shape_cell(E, P, S) :-
        parse.sole.value([E, $CornerJoin()], Id), parse.object(E, $CornerJoin(), Id, S, P).

    // A candidate gap: none, or a length the grid holds.
    .decl gap(e: Example, g: number)
    gap(E, G) :- shape_cell(E, _, _), ex_in(E, P, _), dir_elem(D), dist(P, D, G).

    // A cell of the grid that a copy of the shape's cell p covers, with blocks
    // at gap g: q sits at p's place within its block on each axis.
    .decl covered(e: Example, g: number, q: Position)
    covered(E, G, Q) :-
        gap(E, G), parse.sole.value([E, $CornerJoin()], Id),
        parse.box.box([E, $CornerJoin(), Id], B), shape_cell(E, P, _),
        diag_dirs(_, A, D1, D2), perp(A, A2), opposite(D1, O1), opposite(D2, O2),
        relative(B, P, P_rel), dist(P_rel, O1, K1), dist(P_rel, O2, K2),
        ex_in(E, Q, _), relative(B, Q, Q_rel), dist(Q_rel, O1, T1), dist(Q_rel, O2, T2),
        box_extent(B, Q, A, N1), box_extent(B, Q, A2, N2),
        stride(T1, N1, G, _, K1), stride(T2, N2, G, _, K2).

    // An output cell in S that no block at gap g covers.
    .decl gap_defect(g: number)
    gap_defect(G) :- ex_out(E, Q, S), shape_cell(E, _, S), gap(E, G), !covered(E, G, Q).

    .decl stamp_gap(k: number)
    stamp_gap(G) :- gap(E, G), ex_out(E, _, _), !gap_defect(G).
}
