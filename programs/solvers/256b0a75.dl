// 256b0a75
// @draft
// @keywords: markers cast border
// input: Four corner brackets mark a box: three drawn in params.frame,
//  the fourth in another color, which becomes the box's fill. Single
//  cells of other colors litter the grid.
// output: The box is redrawn solid, outline in params.frame and interior
//  in the fill, and each side sweeps outward to the grid edge, so the
//  four arms take the fill color too. A litter cell lying in an arm
//  colors that line from itself outward, so an arm cell shows the
//  nearest such litter cell between it and the box. Cells outside the
//  box and its arms pass through.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl frame(col: Color) frame(8).
}

.init params = Params

// --- the box ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.frame(Col).

// The cells the box covers.
.decl box_cell(p: Position)
box_cell(P) :- bbox.box($U(), B), in(P, _), inside(P, B).

// The odd bracket names the fill.
.decl fill(col: Color)
fill(Col) :-
    bbox.box($U(), B), in(P, Col), box_edge(P, B, _),  // a cell of the box's outline
    !params.bg(Col), !params.frame(Col).

// --- the arms ---

.init sweep = Ray<Unit>
sweep.dir($U(), D) :- dir_elem(D).
sweep.cell($U(), P) :- in(P, _).
sweep.mark($U(), P) :- bbox.box($U(), B), in(P, _), box_edge(P, B, _).

// The arm the box's d side sweeps out: beyond that side, in line with it.
.decl arm(p: Position, d: Dir)
arm(P, D) :-
    bbox.box($U(), B), in(Src, _), box_edge(Src, B, D),  // a cell of the box's d side
    sweep.ray($U(), P, D, K, Src), K != 0.

// A litter cell lying in the arm toward d.
.decl mark(p: Position, col: Color, d: Dir)
mark(P, Col, D) :- arm(P, D), in(P, Col), !params.bg(Col).

// --- painting ---

// Each mark colors its arm outward from itself, as far as the next mark.
.init cast = Ray<Dir>
cast.dir(D, D) :- dir_elem(D).
cast.cell(D, P) :- arm(P, D).
cast.mark(D, P) :- mark(P, _, D).
cast.blocked(D, P) :- mark(P, _, D).

.decl painted(p: Position, col: Color)
painted(P, Col) :- cast.clear(D, P, _, _, Src), mark(Src, Col, D).

// --- output ---

out(P, Col) :-
    bbox.box($U(), B), in(P, _),
    ( box_edge(P, B, _), params.frame(Col)  // the outline, redrawn whole
    ; interior(P, B), fill(Col)             // the interior, filled
    ).
out(P, Col) :-
    arm(P, _),
    ( painted(P, Col)                 // the nearest mark inward
    ; !painted(P, _), fill(Col)       // no mark inward
    ).
out(P, Col) :- in(P, Col), !box_cell(P), !arm(P, _).
