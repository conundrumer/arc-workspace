// 3618c87e
// @keywords: lines lookup move
// input: Slices run along axis_of(params.fall_to).
// output: Each cell of color params.marker falls to the params.fall_to edge
//  of its slice; the original marker position clears to params.bg.

// two models of the fall
.type Choice =
    // the fall composed: clear the marker; fill the fall edge of a marker
    // slice; else passthrough
    PerCell {}
    // the fall as data: a slice matching params.slice_in is replaced by
    // params.slice_out; unmatched slices pass through
  | SliceMap {}

.type SliceMember = [p: Position, col: Color]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl fall_to(d: Dir) fall_to(DIR_B).

    // --- $PerCell ---

    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(1).

    // --- $SliceMap ---

    .decl slice_in(p: Position, col: Color)
    GRID_5x1(slice_in,
        0,
        0,
        1,
        5,
        5)

    .decl slice_out(p: Position, col: Color)
    GRID_5x1(slice_out,
        0,
        0,
        0,
        5,
        1)
}

.init params = Params

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    // Each cell paired with its along/across split on the fall axis.
    .decl cell_split(k: Key, p: Position, col: Color, p_inner: Position, p_across: Position)
    cell_split(K, P, Col, P_inner, P_across) :-
        cell(K, P, Col), params.fall_to(D), axis_of(D, A), split(P, A, P_inner, P_across).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- $PerCell ---

.decl cleared(p: Position)
cleared(P) :- parse.cell_split($U(), P, Col, _, _), params.marker(Col).

// Each marker cell falls on its own to the fall edge of its slice.
.init fall = Gravity<Position, Unit>
fall.cell(P, $U(), P) :- cleared(P).
fall.dir(P, D) :- cleared(P), params.fall_to(D).

.decl landed(p: Position)
landed(Q) :- fall.travel(P, $U(), V), compose(P, V, Q).

out(P, Col, $PerCell()) :-
    parse.cell_split($U(), P, Col_in, _, _),
    ( cleared(P), params.bg(Col)              // the marker leaves
    ; landed(P), params.marker(Col)           // the marker arrives
    ; !cleared(P), !landed(P), Col = Col_in   // untouched
    ).

// --- $SliceMap ---

.init slice_match = KeyedSetCompare<Position, Unit, SliceMember>
slice_match.pattern_member($U(), [P, Col]) :- params.slice_in(P, Col).
slice_match.observed_member(P_across, [P_inner, Col]) :-
    parse.cell_split($U(), _, Col, P_inner, P_across).

out(P, Col, $SliceMap()) :-
    parse.cell_split($U(), P, Col_in, P_inner, P_across),
    ( slice_match.equals(P_across, _), params.slice_out(P_inner, Col)   // slice replaced
    ; !slice_match.equals(P_across, _), Col = Col_in                    // slice passes through
    ).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The output color at each input cell, in slice coordinates.
    .decl out_slice(e: Example, p_across: Position, p_inner: Position, col: Color)
    out_slice(E, P_across, P_inner, Col) :-
        parse.cell_split(E, P, _, P_inner, P_across), ex_out(E, P, Col).

    // A slice whose content the pair replaces; the test input is held out.
    .decl replaced(e: Example, p_across: Position)
    replaced(E, P_across) :-
        parse.cell_split(E, _, Col, P_inner, P_across), ex_out(E, _, _),
        !out_slice(E, P_across, P_inner, Col).

    // @ignore: determine prediction — the test runs no step of the program at
    //  the slice: it reads the input content of each slice the output changes
    .decl slice_in(p: Position, col: Color)
    slice_in(P_inner, Col) :-
        replaced(E, P_across), parse.cell_split(E, _, Col, P_inner, P_across).

    // @ignore: determine prediction — the test runs no step of the program at
    //  the slice: it reads the output content of each slice the output changes
    .decl slice_out(p: Position, col: Color)
    slice_out(P_inner, Col) :- replaced(E, P_across), out_slice(E, P_across, P_inner, Col).
}
