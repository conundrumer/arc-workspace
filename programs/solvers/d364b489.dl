// d364b489
// concept: markers lookup stamp
// Each marker cell paints a one-cell halo on its four sides; the rest of
// the grid passes through. Halos clip at the grid edge.
//
// Cases (data-equivalent on this task):
//   $Arms  — per-direction: the neighbor toward d paints c.arm(d).
//   $Stamp — a stored template, seated by its marker cell on each marker.

#include "../lib.dl"

.type Choice = Arms {} | Stamp {}

.comp Consts {
    // --- shared ---
    .decl marker(c: Color) marker(1).

    // --- Arms ---
    .decl arm(d: Dir, col: Color)
    arm(DIR_T, 2). arm(DIR_B, 8). arm(DIR_L, 7). arm(DIR_R, 6).

    // --- Stamp ---
    .decl template(p: Position, col: Color)
    GRID_SPARSE_3x3(template,
        0, 2, 0,
        7, 1, 6,
        0, 8, 0)
}

.init c = Consts

.decl marker_at(p: Position)
marker_at(P) :- in(P, Col), c.marker(Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- Arms ---
.decl arm_halo(p: Position, col: Color)
arm_halo(P, Col) :-
    marker_at(Q), c.arm(D, Col),                     // marker, arm color
    step_delta(D, S), compose(Q, S, P), in(P, _).    // neighbor toward d, on-grid

out(P, Col, $Arms()) :- arm_halo(P, Col).
out(P, Col, $Arms()) :- in(P, Col), !arm_halo(P, _).

// --- Stamp ---
// Template ink viewed from the template's marker cell.
.init tview = Reframe<Color>
tview.cell(Col, Pt)  :- c.template(Pt, Col).
tview.outer(Col, Pc) :- tview.cell(Col, _), c.template(Pc, M), c.marker(M).

.decl stamp_halo(p: Position, col: Color)
stamp_halo(P, Col) :-
    marker_at(Q), tview.inner(Col, Off),        // template offsets by color
    compose(Q, Off, P), in(P, _).               // seat on the marker, on-grid

out(P, Col, $Stamp()) :- stamp_halo(P, Col).
out(P, Col, $Stamp()) :- in(P, Col), !stamp_halo(P, _).

// --- fit ---

.type Cell = [e: Example, p: Position]

.comp Fit {
    .decl marker_at(e: Example, p: Position)
    marker_at(E, P) :- ex_in(E, P, Col), c.marker(Col).

    // What a stamp writes: the marker's own cell, and every repainted cell.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- marker_at(E, P), ex_out(E, P, Col).
    painted(E, P, Col) :- ex_in(E, P, Col_in), ex_out(E, P, Col), Col_in != Col.

    // A painted cell belongs to the marker in its 4-connected blob.
    .init blob = Components<Example>
    blob.node(E, P) :- painted(E, P, _).

    // Painted cells as offsets from their marker.
    .init seat = Reframe<Cell>
    seat.cell([E, P], P)  :- painted(E, P, _).
    seat.outer([E, P], M) :- blob.label(E, P, Id), blob.label(E, M, Id), marker_at(E, M).

    .decl offset(off: Shift, col: Color)
    offset(Off, Col) :- painted(E, P, Col), seat.inner([E, P], Off).

    .decl arm(d: Dir, col: Color)
    arm(D, Col) :- offset(Off, Col), dir_elem(D), step_delta(D, Off).

    .init frame = BoxFrame<Unit>
    frame.cell($U(), Off) :- offset(Off, _).

    .decl template(p: Position, col: Color)
    template(Pt, Col) :- offset(Off, Col), frame.inner($U(), Off, Pt).
}
