// a57f2f04
// @draft
// @keywords: objects wallpaper bbox
// @scene panels: several solid rectangles of params.blank stand apart on a
//  field of params.field
// @scene motif: each panel holds cells of one mark color, in one corner of
//  that panel; panels may differ in mark color
// @scene tile: the bounding box of a panel's mark cells is the motif tile;
//  the tile's height divides the panel's height, and its width divides the
//  panel's width
// @rule tile-panel: each panel is filled with copies of its motif tile,
//  repeated along both axes on the grid of the tile's own position, so the
//  copies cover the panel exactly; blank cells in the tile stay blank
// @rule field-kept: every field cell keeps its color

// where the field color comes from
.type FieldColor =
    // @claim panels
    StoredField {}
    // @scene panels: several solid rectangles of params.blank stand apart on
    //  a field whose color is the one color of the grid's border ring
    // @witness field-5: variant $DeriveField
    // @witness edge-panel: variant concept
  | DeriveField {}

// which non-field cells join into one panel
.type Connectivity =
    // @claim panels
    Orthogonal {}
    // @scene panels: several solid rectangles of params.blank stand apart on
    //  a field of params.field; cells that touch at a corner join one panel
    // @witness diagonal-touch: borderline concept
    //     @relaxed panels
    // @witness diag-blank: borderline concept
    //     @relaxed panels
    //     @relaxed motif
  | DiagPanel {}

// where a panel's blank color comes from
.type BlankColor =
    // @claim panels
    StoredBlank {}
    // @scene panels: several solid rectangles stand apart on a field of
    //  params.field; each panel's blank is its one most frequent color
    // @witness blank-6: variant $DeriveBlank
    // @witness solid-motif: borderline concept
    //     @relaxed tile
  | DeriveBlank {}

// which marks the tile bounds
.type MarkSet =
    // @claim tile
    AllMarks {}
    // @scene tile: the motif tile is the bounding box of a panel's cells of
    //  one mark color, the color of the first mark met in each scan order of
    //  params.scan; scan orders that give different boxes give no tile; the
    //  tile's height divides the panel's height, and its width divides the
    //  panel's width
    // @witness two-colors: variant concept
    //     @relaxed motif
    //     @reassigned scan
  | ColorBox {}

// how far the tile reaches
.type TileExtent =
    // @claim tile
    MarkBox {}
    // @scene tile: the motif tile runs from the panel corner nearest the
    //  marks' bounding box to that box's far edges; a marks' box equally far
    //  from two opposite sides of the panel gives no tile; the tile's height
    //  divides the panel's height, and its width divides the panel's width
    // @witness inset-marks: variant $CornerBox
    //     @relaxed motif
    //     @relaxed tile
    // @witness inset-even: variant $CornerBox
    //     @relaxed motif
  | CornerBox {}

// where the lattice of copies is laid from
.type Anchor =
    // @claim tile-panel
    TileLattice {}
    // @rule tile-panel: each panel is filled with copies of its motif tile,
    //  laid from the corner of the panel's bounding box at params.anchor and
    //  repeated along both axes; blank cells in the tile stay blank; the
    //  output holds each anchor's grid
    // @witness off-lattice: borderline concept
    //     @relaxed tile
    // @witness inset-even: variant $CornerBox
  | CornerAnchor {}

// which cells the copies fill
.type PanelExtent =
    // @claim tile-panel
    PanelCells {}
    // @rule tile-panel: the whole bounding box of each panel is filled with
    //  copies of its motif tile, field cells included, repeated along both
    //  axes on the grid of the tile's own position
    // @witness l-panel: foreign concept
    //     @relaxed panels
  | ComponentBbox {}

.type Choice = [field: FieldColor, conn: Connectivity, blank: BlankColor,
                marks: MarkSet, tile: TileExtent, anchor: Anchor,
                extent: PanelExtent]

// A panel under the cases that differ only in their panel extent.
.type Panel = [field: FieldColor, conn: Connectivity, blank: BlankColor,
               marks: MarkSet, tile: TileExtent, anchor: Anchor, x: Ident]

// A panel of one example.
.type ExPanel = [e: Example, x: Ident]

.type AnchorValue = [d: DiagDir]

.type OpenValue = [anchor: AnchorValue]

.decl out(p: Position, col: Color, ch: Choice, v: OpenValue)

.comp Params {
    // --- $StoredField ---
    // @derive DominantColor: variant derived
    .decl field(c: Color) field(8).

    // --- $StoredBlank ---
    .decl blank(c: Color) blank(0).

    // --- $ColorBox ---
    // The scan orders that find a panel's first mark: from corner d, along
    // axis a first. The pairs leave all eight open.
    .decl scan(d: DiagDir, a: Axis)
    scan(DIAG_TL, AXIS_V). scan(DIAG_TL, AXIS_H).
    scan(DIAG_TR, AXIS_V). scan(DIAG_TR, AXIS_H).
    scan(DIAG_BL, AXIS_V). scan(DIAG_BL, AXIS_H).
    scan(DIAG_BR, AXIS_V). scan(DIAG_BR, AXIS_H).

    // --- $CornerAnchor ---
    // The pairs leave all four corners open.
    // @open
    .decl anchor(d: DiagDir)
    anchor(DIAG_TL). anchor(DIAG_TR). anchor(DIAG_BL). anchor(DIAG_BR).
}

.init params = Params

// A panel's marks, its tile's corner placements, and the copies of its
// tile, for the program's panels and for the examples' panels.
.comp Parse<Key> {
    .type Scan = [k: Key, d: DiagDir, a: Axis]

    .decl panel(k: Key, p: Position)

    // The colors of the cells of the panel's box.
    .decl color(k: Key, p: Position, col: Color)

    .decl blank(k: Key, col: Color)

    // The tiles whose corner placements are wanted.
    .decl tile(k: Key, b: Box)

    // The scan orders to find the first mark in: from corner d, along axis a
    // first.
    .decl scan(k: Key, d: DiagDir, a: Axis)

    // The tiles to lay in place.
    .decl lay(k: Key, b: Box)

    // The tiles to lay moved: box b's cells moved onto box b_laid.
    .decl moved(k: Key, b: Box, b_laid: Box)

    // @claim tile-panel
    .init box = Bbox<Key>
    box.cell(K, P) :- panel(K, P).

    .decl mark(k: Key, p: Position)
    mark(K, P) :- panel(K, P), color(K, P, Col), !blank(K, Col).

    // @claim tile
    .init marks_box = Bbox<Key>
    marks_box.cell(K, P) :- mark(K, P).

    // @claim tile
    .init scan_order = LexOrder<Scan>
    scan_order.corner([K, D, A], D) :- scan(K, D, A).
    scan_order.axis([K, D, A], A) :- scan(K, D, A).
    scan_order.cell([K, D, A], P) :- scan(K, D, A), mark(K, P).

    // The box of the cells of the first mark's color, in each scan order.
    // @claim tile
    .init first_color = Bbox<Scan>
    first_color.cell([K, D, A], Q) :-
        scan_order.first([K, D, A], P), color(K, P, Col), mark(K, Q), color(K, Q, Col).

    // Tile b moved into the panel box's corner d.
    .decl corner_lay(k: Key, b: Box, d: DiagDir, b_laid: Box)
    corner_lay(K, B, D, B_laid) :-
        tile(K, B), box.box(K, B_p), relative(B_p, B, B_rel),   // the tile in the panel box's frame
        diag_dirs(D, _, D1, D2),
        dist(B_rel, D1, K1), jump_offset(D1, K1, V1),
        dist(B_rel, D2, K2), jump_offset(D2, K2, V2), compose(V1, V2, V),
        compose(B, V, B_laid).

    // The copies: the tile's cells moved onto the laid box, then repeated by the tile's
    // extent along both axes inside the panel's box. A cell q of the box
    // takes the tile cell at q's place within its copy on each axis.
    .decl copy(k: Key, b: Box, b_laid: Box, p: Position, col: Color)
    copy(K, B, B_laid, Q, Col) :-
        ( lay(K, B), B_laid = B ; moved(K, B, B_laid) ),
        relative(B, B_laid, V),                                   // the tile's move
        color(K, Q, _), relative(V, Q, Q_v),                      // q, moved back by it
        diag_dirs(_, A, D1, D2), perp(A, A2), opposite(D1, O1), opposite(D2, O2),
        relative(B, Q_v, Q_rel), dist(Q_rel, O1, T1), dist(Q_rel, O2, T2),
        box_extent(B, Q, A, N1), box_extent(B, Q, A2, N2),
        stride(T1, N1, 0, _, K1), stride(T2, N2, 0, _, K2),      // q's place in its copy
        jump(Q_v, O1, T1, P1), jump(P1, D1, K1, P2),              // back to the tile's edge,
        jump(P2, O2, T2, P3), jump(P3, D2, K2, P),                // then to that place
        color(K, P, Col), inside(P, B).
}

.decl field_color_choice(f: FieldColor)
field_color_choice($StoredField()). field_color_choice($DeriveField()).

.decl connectivity_choice(c: Connectivity)
connectivity_choice($Orthogonal()). connectivity_choice($DiagPanel()).

.decl blank_color_choice(b: BlankColor)
blank_color_choice($StoredBlank()). blank_color_choice($DeriveBlank()).

.decl mark_set_choice(m: MarkSet)
mark_set_choice($AllMarks()). mark_set_choice($ColorBox()).

.decl tile_extent_choice(t: TileExtent)
tile_extent_choice($MarkBox()). tile_extent_choice($CornerBox()).

.decl anchor_choice(a: Anchor)
anchor_choice($TileLattice()). anchor_choice($CornerAnchor()).

.decl panel_extent_choice(e: PanelExtent)
panel_extent_choice($PanelCells()). panel_extent_choice($ComponentBbox()).

.decl impl_choice(ch: Choice)
impl_choice([F, C, B, M, T, A, E]) :-
    field_color_choice(F), connectivity_choice(C), blank_color_choice(B),
    mark_set_choice(M), tile_extent_choice(T), anchor_choice(A),
    panel_extent_choice(E).

// The field color under F.
.decl field(f: FieldColor, col: Color)

.decl panel_cell(f: FieldColor, p: Position)
panel_cell(F, P) :- field(F, _), in(P, Col), !field(F, Col).

// @claim panels
.init orth = Components<FieldColor>
orth.node(F, P) :- panel_cell(F, P).

.decl panel(pn: Panel, p: Position)
panel([F, C, B, M, T, A, X], P) :-
    impl_choice([F, C, B, M, T, A, _]), C = $Orthogonal(), orth.label(F, P, X).

.init parse = Parse<Panel>
parse.panel(Pn, P) :- panel(Pn, P).
parse.color(Pn, P, Col) :- parse.box.box(Pn, B), in(P, Col), inside(P, B).

// The marks that bound the tile, and their box.
.decl marks_box(pn: Panel, b: Box)

// The cells the copies fill under panel extent e.
.decl fill(e: PanelExtent, pn: Panel, p: Position)

// The open values each case's output is derived at.
.decl open_value(ch: Choice, v: OpenValue)

// The panel's tile laid onto box b_laid at open value v.
.decl laid(pn: Panel, v: OpenValue, b_laid: Box)

.decl paint(ch: Choice, v: OpenValue, p: Position, col: Color)
paint([F, C, B, M, T, A, E], V, P, Col) :-
    laid([F, C, B, M, T, A, X], V, B_laid),
    parse.copy([F, C, B, M, T, A, X], _, B_laid, P, Col), fill(E, [F, C, B, M, T, A, X], P).

// The case is undefined on the input.
.decl broken(ch: Choice)

// The case is undefined on the input at open value v.
.decl broken_at(ch: Choice, v: OpenValue)
broken_at(Ch, V) :- paint(Ch, V, P, Col), paint(Ch, V, P, Col2), Col != Col2.

.decl live(ch: Choice, v: OpenValue)
live(Ch, V) :-
    open_value(Ch, V), Ch = [F, _, _, _, _, _, _], field(F, _), !broken(Ch), !broken_at(Ch, V).

out(P, Col, Ch, V) :- live(Ch, V), paint(Ch, V, P, Col).
out(P, Col, Ch, V) :- live(Ch, V), in(P, Col), !paint(Ch, V, P, _).

// --- $StoredField ---
field($StoredField(), Col) :- params.field(Col).

// --- $DeriveField ---
// @claim panels
.init border = Unanimous<Unit, Color>
border.item($U(), Col) :- in(P, Col), dir_elem(D), dist(P, D, 0).

field($DeriveField(), Col) :- border.value($U(), Col).

// --- $DiagPanel ---
// @claim panels
.init diag = Components8<FieldColor>
diag.node(F, P) :- panel_cell(F, P).

panel([F, C, B, M, T, A, X], P) :-
    impl_choice([F, C, B, M, T, A, _]), C = $DiagPanel(), diag.label(F, P, X).

// --- $StoredBlank ---
parse.blank(Pn, Col) :-
    parse.box.box(Pn, _), Pn = [_, _, $StoredBlank(), _, _, _, _], params.blank(Col).

// --- $DeriveBlank ---
// @claim panels
.init commonest = Mode<Panel, Color, Position>
commonest.item(Pn, Col, P) :-
    panel(Pn, P), Pn = [_, _, $DeriveBlank(), _, _, _, _], in(P, Col).

// @claim panels
.init top = Unanimous<Panel, Color>
top.item(Pn, Col) :- commonest.mode(Pn, Col).

parse.blank(Pn, Col) :- top.value(Pn, Col).
broken([F, C, B, M, T, A, E]) :- top.clash([F, C, B, M, T, A, _]), panel_extent_choice(E).

// --- $AllMarks ---
marks_box(Pn, B) :- parse.marks_box.box(Pn, B), Pn = [_, _, _, $AllMarks(), _, _, _].

// --- $ColorBox ---
parse.scan(Pn, D, A) :-
    parse.box.box(Pn, _), Pn = [_, _, _, $ColorBox(), _, _, _], params.scan(D, A).

// @claim tile
.init color_box = Unanimous<Panel, Box>
color_box.item(Pn, B) :- parse.first_color.box([Pn, _, _], B).

marks_box(Pn, B) :- color_box.value(Pn, B).
broken([F, C, B, M, T, A, E]) :- color_box.clash([F, C, B, M, T, A, _]), panel_extent_choice(E).

// --- $MarkBox ---
parse.tile(Pn, B) :- marks_box(Pn, B), Pn = [_, _, _, _, $MarkBox(), _, _].

// --- $CornerBox ---
// The marks' box's distance to the panel box's side d, and to the opposite.
.decl gap(pn: Panel, d: Dir, k: number, k2: number)
gap(Pn, D, K, K2) :-
    marks_box(Pn, B), Pn = [_, _, _, _, $CornerBox(), _, _],
    parse.box.box(Pn, B_p), relative(B_p, B, B_rel), dist_pair(B_rel, D, K, K2).

// The side of each axis that the marks' box lies nearer.
.decl near(pn: Panel, d: Dir, k: number)
near(Pn, D, K) :- gap(Pn, D, K, K2), K < K2.

parse.tile(Pn, B) :-
    marks_box(Pn, B_m),
    near(Pn, D1, K1), near(Pn, D2, K2), diag_dirs(_, _, D1, D2),  // a corner's two sides
    edge_outset(D1, K1, O1), compose(B_m, O1, B1),     // out to the near side on one axis
    edge_outset(D2, K2, O2), compose(B1, O2, B).       // and on the other
broken([F, C, B, M, T, A, E]) :- gap([F, C, B, M, T, A, _], _, K, K), panel_extent_choice(E).

// --- $TileLattice ---
open_value(Ch, [nil]) :- impl_choice(Ch), Ch = [_, _, _, _, _, $TileLattice(), _].

laid(Pn, [nil], B) :- parse.tile(Pn, B), Pn = [_, _, _, _, _, $TileLattice(), _].
parse.lay(Pn, B) :- parse.tile(Pn, B), Pn = [_, _, _, _, _, $TileLattice(), _].

// --- $CornerAnchor ---
open_value(Ch, [[D]]) :-
    impl_choice(Ch), Ch = [_, _, _, _, _, $CornerAnchor(), _], params.anchor(D).

laid(Pn, [[D]], B_laid) :-
    parse.corner_lay(Pn, _, D, B_laid), Pn = [_, _, _, _, _, $CornerAnchor(), _],
    params.anchor(D).
parse.moved(Pn, B, B_laid) :-
    parse.corner_lay(Pn, B, D, B_laid), Pn = [_, _, _, _, _, $CornerAnchor(), _],
    params.anchor(D).

// --- $PanelCells ---
fill($PanelCells(), Pn, P) :- panel(Pn, P).

// --- $ComponentBbox ---
fill($ComponentBbox(), Pn, P) :- parse.box.box(Pn, B), in(P, _), inside(P, B).

.comp Determine {
    // The concept's panels in each example.
    .init pieces = Components<Example>
    pieces.node(E, P) :- ex_in(E, P, Col), !params.field(Col).

    .init parse = Parse<ExPanel>
    parse.panel([E, X], P) :- pieces.label(E, P, X).
    parse.color([E, X], P, Col) :- parse.box.box([E, X], B), ex_in(E, P, Col), inside(P, B).
    parse.blank(Pn, Col) :- parse.box.box(Pn, _), params.blank(Col).
    parse.tile(Pn, B) :- parse.marks_box.box(Pn, B).
    parse.scan(Pn, D, A) :- parse.box.box(Pn, _), diag_dir_elem(D), axis_elem(A).

    // The panel cell at the panel box's corner, in a panel that has a tile.
    .decl corner_cell(pn: ExPanel, d: DiagDir, p: Position)
    corner_cell(Pn, D, P) :-
        parse.tile(Pn, _), parse.box.box(Pn, B_p), diag_dir_elem(D),
        box_corner(P, B_p, D), parse.panel(Pn, P).

    // The corners at which a train output shows the tile's own corner cell
    // at the panel box's corner.
    .decl corner_shown(pn: ExPanel, d: DiagDir)
    corner_shown([E, X], D) :-
        corner_cell([E, X], D, P),
        parse.tile([E, X], B), box_corner(Q, B, D), parse.color([E, X], Q, Col),   // the tile's corner cell
        ex_out(E, P, Col).

    // A corner some train panel's output does not show so.
    .decl anchor_missed(d: DiagDir)
    anchor_missed(D) :-
        corner_shown(_, D), corner_cell([E, X], D, _), ex_out(E, _, _),
        !corner_shown([E, X], D).

    .decl anchor(d: DiagDir)
    anchor(D) :- corner_shown(_, D), !anchor_missed(D).

    // The colors a train output paints over a panel box's input cells.
    .decl added(pn: ExPanel, col: Color)
    added([E, X], Col) :-
        parse.color([E, X], P, C_in), ex_out(E, P, Col), Col != C_in.

    // The orders whose first mark is of a color the output paints, per panel.
    .decl scan_shown(pn: ExPanel, d: DiagDir, a: Axis)
    scan_shown(Pn, D, A) :-
        parse.scan_order.first([Pn, D, A], P), parse.color(Pn, P, Col), added(Pn, Col).

    // An order some train panel's first mark does not find so.
    .decl scan_missed(d: DiagDir, a: Axis)
    scan_missed(D, A) :-
        scan_shown(_, D, A), parse.scan_order.first([[E, X], D, A], _), ex_out(E, _, _),
        !scan_shown([E, X], D, A).

    .decl scan(d: DiagDir, a: Axis)
    scan(D, A) :- scan_shown(_, D, A), !scan_missed(D, A).
}
