// b0f4d537
// @draft
// @keywords: decompose crop scale lines markers rank
// @scene two-panels: a full column of params.divider cells, running top to
//  bottom, splits the input into two panels.
// @scene key-panel: one panel holds the key at its top end, and
//  params.divider cells fill the rest of that panel.
// @scene key-grid: the key's rows and its columns each alternate between gaps
//  and lines params.key_band wide, with a gap at each end; each line row is a
//  line of one color across the key, each line column is a line of one color
//  down the key, each cell off both lines is 0, each crossing cell has the
//  color of one of its two lines, and no key cell is params.marker or
//  params.divider.
// @scene field: the other panel is the field, of 0 cells and params.marker
//  cells, with no line at its border and no two lines adjacent.
// @scene field-markers: the field has as many line rows and as many line
//  columns as the key; a params.marker cell sits at both ends of each line, on
//  the field border, and at each crossing of a line row with a line column,
//  and nowhere else.
// @rule find-panels: the field is the panel that holds params.marker cells;
//  the key is the cells of the other panel that are not params.divider.
// @rule field-lines: a line row of the field is a row whose two border cells
//  are params.marker; a line column is a column whose two border cells are
//  params.marker.
// @rule stretch-key: the output has the field's size. Counted from either
//  end, the k-th line row of the field takes the key's k-th line row, and each
//  other row takes the key row off the lines that has as many line rows before
//  it as that row has; columns map the same way. Each output cell is the key
//  cell at its mapped row and column. Undefined where the two ends give a cell
//  different colors, or where a row or column takes no key row or column from
//  one end.

// how the field's line rows and line columns are found
.type LineRead =
    // @claim field-lines
    LineByBothEnds {}
    // @rule field-lines: a line is a row or column with params.marker at
    //  either of its border cells.
    // @witness line-one-end: borderline $LineByEitherEnd
    //     @relaxed field-markers
  | LineByEitherEnd {}
    // @rule field-lines: a line row has params.marker at its border cell on
    //  the edge of the corner params.header, and a line column at its border
    //  cell on the corner's other edge. Undefined where two header values read
    //  different lines.
    // @witness line-one-end: borderline $LineByEitherEnd
  | LineByHeaderEdge {}
    // @rule field-lines: the lines are the rows and the columns of the
    //  params.marker cells off the field border.
    // @witness line-ends-only: variant concept
    //     @relaxed field-markers
  | LineByCrossing {}

// what fills the output
.type Drawing =
    // @claim stretch-key
    Stretch {}
    // @rule stretch-key: rows and columns map as in the concept; a cell on one
    //  line takes that line's color, the one color its key line holds off the
    //  crossings, a crossing takes the key's crossing cell, and every other
    //  cell is params.background. Undefined where a key line holds more than
    //  one color off the crossings.
    // @witness key-ground: borderline concept
    //     @relaxed key-grid
  | DrawLines {}

// which key gap row a field gap row takes
.type GapRead =
    // @claim stretch-key
    GapByCount {}
    // @rule stretch-key: each row off the field's lines takes the key's gap
    //  row at the edge the lines are counted from, and columns likewise.
    // @witness middle-gap: borderline concept
    //     @relaxed key-grid
  | GapToEnd {}

// how the marker color is found
.type MarkerRead =
    // @claim field-lines
    MarkerStored {}
    // @rule field-lines: the marker is the field's color other than its
    //  commonest color. Undefined where the field holds more or fewer than
    //  two colors.
    // @witness marker-recolored: variant $MarkerFromField
    //     @relaxed field
  | MarkerFromField {}

// which panel is the field and which is the key
.type Panel =
    // @claim find-panels
    FieldByMarker {}
    // @rule find-panels: the key is the cells, not params.divider, of the
    //  panel that params.divider cells partly fill, and the field is the other
    //  panel. Undefined where both panels or neither panel holds
    //  params.divider cells.
    // @witness key-line-marker-color: borderline $KeyByFill
    //     @relaxed key-grid
  | KeyByFill {m: MarkerRead}

// how the divider color is found
.type DividerRead =
    // @claim two-panels
    DividerStored {}
    // @scene two-panels: a full row or column of one color other than the
    //  input's commonest color, the divider, splits the input into two
    //  panels. Undefined where no such color, or more than one, exists.
    // @witness divider-recolored: variant $DividerFromFullLine
    //     @relaxed two-panels
  | DividerFromFullLine {}

// whether the panel layout is read from its stored orientation
.type Layout =
    // @claim two-panels find-panels
    LayoutFree {}
    // @scene two-panels: the divider is a full line of params.divider cells
    //  along the axis of params.key_end.
    // @rule find-panels: the key is the cells of the key panel nearer its
    //  params.key_end edge than every line across the panel that holds only
    //  params.divider cells.
    // @witness key-line-divider-color: borderline $LayoutStored
    //     @relaxed key-grid
  | LayoutStored {}

.type Choice = [l: LineRead, d: Drawing, g: GapRead, f: Panel, v: DividerRead, y: Layout]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The width of each line and each gap of the key.
    .decl key_band(k: number) key_band(1).

    // --- $DividerStored ---
    .decl divider(c: Color) divider(5).

    // --- $FieldByMarker, $MarkerStored ---
    .decl marker(c: Color) marker(4).

    // --- $LineByHeaderEdge ---
    // The corner whose edges hold the marker that reads a line.
    // @open
    .decl header(d: DiagDir)
    header(DIAG_TL). header(DIAG_TR). header(DIAG_BL). header(DIAG_BR).

    // --- $DrawLines ---
    // @derive DominantColor: variant derived
    //     @relaxed field
    //     @relaxed key-grid
    .decl background(c: Color) background(0).

    // --- $LayoutStored ---
    // The end of the key panel, along the divider, where the key sits.
    .decl key_end(d: Dir) key_end(DIR_T).
}

.init params = Params

// A reading of the divider and of the panel layout.
.type Cut = [v: DividerRead, y: Layout]

// A field and key split.
.type Sides = [f: Panel, v: DividerRead, y: Layout]

// An index of the field, counted from edge d.
.type FieldIdx = [d: Dir, x: Position, l: LineRead, f: Panel, v: DividerRead, y: Layout]

// A line index of the key.
.type KeyIdx = [x: Position, f: Panel, v: DividerRead, y: Layout]

.decl line_read_choice(l: LineRead)
line_read_choice($LineByBothEnds()). line_read_choice($LineByEitherEnd()).
line_read_choice($LineByHeaderEdge()). line_read_choice($LineByCrossing()).

.decl gap_read_choice(g: GapRead)
gap_read_choice($GapByCount()). gap_read_choice($GapToEnd()).

.decl panel_choice(f: Panel)
panel_choice($FieldByMarker()).
panel_choice($KeyByFill($MarkerStored())). panel_choice($KeyByFill($MarkerFromField())).

.decl divider_read_choice(v: DividerRead)
divider_read_choice($DividerStored()). divider_read_choice($DividerFromFullLine()).

.decl layout_choice(y: Layout)
layout_choice($LayoutFree()). layout_choice($LayoutStored()).

// $DrawLines reads no key gap's content, so it takes the concept's gap reading
// alone.
.decl impl_choice(ch: Choice)
impl_choice([L, $Stretch(), G, F, V, Y]) :-
    line_read_choice(L), gap_read_choice(G), panel_choice(F), divider_read_choice(V),
    layout_choice(Y).
impl_choice([L, $DrawLines(), $GapByCount(), F, V, Y]) :-
    line_read_choice(L), panel_choice(F), divider_read_choice(V), layout_choice(Y).

// The field's border cells at the ends of its lines.
.comp Parse<Key> {
    // The field, in its own frame.
    .decl field(k: Key, p: Position, col: Color)
    .decl marker(k: Key, c: Color)

    // The end of the line at index x on axis a, on the field border at edge d.
    .decl line_end(k: Key, a: Axis, x: Position, d: Dir, col: Color)
    line_end(K, A, X, D, C) :-
        field(K, P, C), axis_elem(A), split(P, A, X, _),
        perp(A, A2), axis_of(D, A2), dist(P, D, 0).

    .decl marked_end(k: Key, a: Axis, x: Position, d: Dir)
    marked_end(K, A, X, D) :- line_end(K, A, X, D, C), marker(K, C).

    // An end of the line at index x is not a marker.
    .decl unmarked_end(k: Key, a: Axis, x: Position)
    unmarked_end(K, A, X) :- line_end(K, A, X, _, C), !marker(K, C).

    // Both ends of the line at index x are markers.
    .decl both_marked(k: Key, a: Axis, x: Position)
    both_marked(K, A, X) :- marked_end(K, A, X, _), !unmarked_end(K, A, X).
}

.init parse = Parse<Sides>
parse.field([F, V, Y], P, C) :- field(P, C, F, V, Y).
parse.marker([F, V, Y], C) :- marker(C, F, V, Y).

.decl divider(c: Color, v: DividerRead)

// The line at index x on axis a holds a cell other than the divider.
.decl broken_line(a: Axis, x: Position, v: DividerRead)
broken_line(A, X, V) :-
    divider(_, V), in(P, C), !divider(C, V), axis_elem(A), split(P, A, X, _).

// The axis of the indices a divider line may lie at.
.decl cut_axis(a: Axis, y: Layout)

.decl divider_line(p: Position, v: DividerRead, y: Layout)
divider_line(P, V, Y) :-
    divider(C, V), in(P, C), cut_axis(A, Y), split(P, A, X, _), !broken_line(A, X, V).

// @claim two-panels
.init panel = Components<Cut>
panel.node([V, Y], P) :- in(P, _), divider(_, V), layout_choice(Y), !divider_line(P, V, Y).

.decl field_panel(id: Ident, f: Panel, v: DividerRead, y: Layout)
.decl key_panel(id: Ident, f: Panel, v: DividerRead, y: Layout)

.decl field_cell(p: Position, col: Color, f: Panel, v: DividerRead, y: Layout)
field_cell(P, C, F, V, Y) :- field_panel(Id, F, V, Y), panel.label([V, Y], P, Id), in(P, C).

.decl key_panel_cell(p: Position, col: Color, f: Panel, v: DividerRead, y: Layout)
key_panel_cell(P, C, F, V, Y) :- key_panel(Id, F, V, Y), panel.label([V, Y], P, Id), in(P, C).

.decl key_cell(p: Position, col: Color, f: Panel, v: DividerRead, y: Layout)

// @claim find-panels
.init field_box = Bbox<Sides>
field_box.cell([F, V, Y], P) :- field_cell(P, _, F, V, Y).

// @claim find-panels
.init key_box = Bbox<Sides>
key_box.cell([F, V, Y], P) :- key_cell(P, _, F, V, Y).

// The field, in its own frame.
.decl field(p: Position, col: Color, f: Panel, v: DividerRead, y: Layout)
field(P_inner, C, F, V, Y) :-
    field_cell(P, C, F, V, Y), field_box.box([F, V, Y], B), crop(P, B, P_inner).

// The key, in its own frame.
.decl key(p: Position, col: Color, f: Panel, v: DividerRead, y: Layout)
key(P_inner, C, F, V, Y) :-
    key_cell(P, C, F, V, Y), key_box.box([F, V, Y], B), crop(P, B, P_inner).

.decl marker(c: Color, f: Panel, v: DividerRead, y: Layout)

// An index of the field on axis a, where the field has a marker color.
.decl field_idx(a: Axis, x: Position, f: Panel, v: DividerRead, y: Layout)
field_idx(A, X, F, V, Y) :-
    field(P, _, F, V, Y), marker(_, F, V, Y), axis_elem(A), split(P, A, X, _).

.decl field_line(a: Axis, x: Position, l: LineRead, f: Panel, v: DividerRead, y: Layout)

// One header value reads a line at index x and another reads none.
.decl undecided(a: Axis, x: Position, l: LineRead, f: Panel, v: DividerRead, y: Layout)

.decl field_gap(a: Axis, x: Position, l: LineRead, f: Panel, v: DividerRead, y: Layout)
field_gap(A, X, L, F, V, Y) :-
    field_idx(A, X, F, V, Y), line_read_choice(L),
    !field_line(A, X, L, F, V, Y), !undecided(A, X, L, F, V, Y).

// The field lines between each field index and edge d.
// @claim stretch-key
.init before = Tally<FieldIdx, Position>
before.domain([D, X, L, F, V, Y]) :-
    field_idx(A, X, F, V, Y), axis_of(D, A), line_read_choice(L).
before.item([D, X, L, F, V, Y], X2) :-
    field_line(A, X2, L, F, V, Y), field_idx(A, X, F, V, Y), axis_of(D, A), nearer(D, X2, X).

.decl key_idx(a: Axis, x: Position, f: Panel, v: DividerRead, y: Layout)
key_idx(A, X, F, V, Y) :- key(Q, _, F, V, Y), axis_elem(A), split(Q, A, X, _).

// A gap of the key at index x, with n key lines between it and edge d.
.decl key_gap(d: Dir, x: Position, n: number, f: Panel, v: DividerRead, y: Layout)
key_gap(D, X, N, F, V, Y) :-
    key_idx(A, X, F, V, Y), axis_of(D, A), dist(X, D, T),
    params.key_band(W), stride(T, W, W, N, _).

// A line of the key at index x, with n key lines between it and edge d.
.decl key_line(d: Dir, x: Position, n: number, f: Panel, v: DividerRead, y: Layout)
key_line(D, X, N, F, V, Y) :-
    key_idx(A, X, F, V, Y), axis_of(D, A), !key_gap(D, X, _, F, V, Y),
    neighbor(X, D, X2), key_gap(D, X2, N, F, V, Y).

// The key gap that field gap x takes, counted from edge d.
.decl gap_takes(d: Dir, x: Position, x_key: Position, l: LineRead, g: GapRead, f: Panel, v: DividerRead, y: Layout)

// The key index that field index x takes, counted from edge d.
.decl takes(d: Dir, x: Position, x_key: Position, l: LineRead, g: GapRead, f: Panel, v: DividerRead, y: Layout)
takes(D, X, X_key, L, G, F, V, Y) :-
    gap_read_choice(G),
    ( field_line(_, X, L, F, V, Y), before.tally([D, X, L, F, V, Y], N),
      key_line(D, X_key, N, F, V, Y)
    ; gap_takes(D, X, X_key, L, G, F, V, Y)
    ).

// Counted from some edge, field index x takes no key index.
.decl untaken(x: Position, l: LineRead, g: GapRead, f: Panel, v: DividerRead, y: Layout)
untaken(X, L, G, F, V, Y) :-
    field_idx(A, X, F, V, Y), line_read_choice(L), gap_read_choice(G), axis_of(D, A),
    !takes(D, X, _, L, G, F, V, Y).

// Field cell p takes key cell q, its two indices counted from edges d1 and d2.
.decl takes_cell(p: Position, q: Position, d1: Dir, d2: Dir, l: LineRead, g: GapRead, f: Panel, v: DividerRead, y: Layout)
takes_cell(P, Q, D1, D2, L, G, F, V, Y) :-
    field(P, _, F, V, Y), axis_elem(A), split(P, A, X1, X2),
    !untaken(X1, L, G, F, V, Y), !untaken(X2, L, G, F, V, Y),
    takes(D1, X1, K1, L, G, F, V, Y), takes(D2, X2, K2, L, G, F, V, Y),
    key(Q, _, F, V, Y), split(Q, A, K1, K2).

// --- $DividerStored ---
divider(C, $DividerStored()) :- params.divider(C).

// --- $DividerFromFullLine ---
// The line at index x on axis a holds two colors.
.decl mixed_line(a: Axis, x: Position)
mixed_line(A, X) :-
    in(P, C), axis_elem(A), split(P, A, X, _),
    in(Q, C2), split(Q, A, X, _), C != C2.

// @claim two-panels
.init commonest = Mode<Unit, Color, Position>
commonest.item($U(), C, P) :- in(P, C).

// @claim two-panels
.init full_line_color = Unanimous<Unit, Color>
full_line_color.item($U(), C) :-
    in(P, C), axis_elem(A), split(P, A, X, _), !mixed_line(A, X),
    !commonest.mode($U(), C).

divider(C, $DividerFromFullLine()) :- full_line_color.value($U(), C).

// --- $LayoutFree ---
cut_axis(A, $LayoutFree()) :- axis_elem(A).

key_cell(P, C, F, V, $LayoutFree()) :- key_panel_cell(P, C, F, V, $LayoutFree()), !divider(C, V).

// --- $LayoutStored ---
cut_axis(A, $LayoutStored()) :- params.key_end(D), axis_of(D, A2), perp(A2, A).

// The line across the key panel at index x holds a cell other than the
// divider.
.decl unfilled(x: Position, f: Panel, v: DividerRead)
unfilled(X, F, V) :-
    key_panel_cell(P, C, F, V, $LayoutStored()), !divider(C, V),
    params.key_end(D), axis_of(D, A), split(P, A, X, _).

// A line across the key panel that holds only divider cells lies at index x.
.decl filled_line(x: Position, f: Panel, v: DividerRead)
filled_line(X, F, V) :-
    key_panel_cell(P, _, F, V, $LayoutStored()),
    params.key_end(D), axis_of(D, A), split(P, A, X, _), !unfilled(X, F, V).

// A filled line lies at the cell's index or nearer the key end.
.decl past_fill(p: Position, f: Panel, v: DividerRead)
past_fill(P, F, V) :-
    key_panel_cell(P, _, F, V, $LayoutStored()), filled_line(X, F, V),
    params.key_end(D), !nearer(D, P, X).

key_cell(P, C, F, V, $LayoutStored()) :-
    key_panel_cell(P, C, F, V, $LayoutStored()), !past_fill(P, F, V).

// --- $FieldByMarker ---
// @claim find-panels
.init marked = Unanimous<Cut, Ident>
marked.item(K, Id) :- panel.label(K, P, Id), in(P, C), params.marker(C).

field_panel(Id, $FieldByMarker(), V, Y) :- marked.value([V, Y], Id).
key_panel(Id, $FieldByMarker(), V, Y) :-
    marked.value([V, Y], Id0), panel.label([V, Y], _, Id), Id != Id0.

marker(C, $FieldByMarker(), V, Y) :- params.marker(C), divider_read_choice(V), layout_choice(Y).

// --- $KeyByFill ---
// @claim find-panels
.init filled = Unanimous<Cut, Ident>
filled.item([V, Y], Id) :- panel.label([V, Y], P, Id), in(P, C), divider(C, V).

key_panel(Id, F, V, Y) :- filled.value([V, Y], Id), panel_choice(F), F = $KeyByFill(_).
field_panel(Id, F, V, Y) :-
    filled.value([V, Y], Id0), panel.label([V, Y], _, Id), Id != Id0,
    panel_choice(F), F = $KeyByFill(_).

// --- $MarkerStored ---
marker(C, $KeyByFill($MarkerStored()), V, Y) :-
    params.marker(C), divider_read_choice(V), layout_choice(Y).

// --- $MarkerFromField ---
// @claim field-lines
.init field_ground = Mode<Cut, Color, Position>
field_ground.item([V, Y], C, P) :- field_cell(P, C, $KeyByFill($MarkerFromField()), V, Y).

// @claim field-lines
.init field_mark = Unanimous<Cut, Color>
field_mark.item([V, Y], C) :-
    field_cell(_, C, $KeyByFill($MarkerFromField()), V, Y), !field_ground.mode([V, Y], C).

marker(C, $KeyByFill($MarkerFromField()), V, Y) :- field_mark.value([V, Y], C).

// --- $LineByBothEnds ---
field_line(A, X, $LineByBothEnds(), F, V, Y) :- parse.both_marked([F, V, Y], A, X).

// --- $LineByEitherEnd ---
field_line(A, X, $LineByEitherEnd(), F, V, Y) :- parse.marked_end([F, V, Y], A, X, _).

// --- $LineByHeaderEdge ---
// Header value h reads a line at index x: its end on the header corner's edge
// is a marker.
.decl header_line(h: DiagDir, a: Axis, x: Position, f: Panel, v: DividerRead, y: Layout)
header_line(H, A, X, F, V, Y) :-
    params.header(H), parse.marked_end([F, V, Y], A, X, D), perp(A, A2), dir_of(H, A2, D).

// Some header value reads no line at index x.
.decl header_unread(a: Axis, x: Position, f: Panel, v: DividerRead, y: Layout)
header_unread(A, X, F, V, Y) :-
    field_idx(A, X, F, V, Y), params.header(H), !header_line(H, A, X, F, V, Y).

field_line(A, X, $LineByHeaderEdge(), F, V, Y) :-
    header_line(_, A, X, F, V, Y), !header_unread(A, X, F, V, Y).

undecided(A, X, $LineByHeaderEdge(), F, V, Y) :-
    header_line(_, A, X, F, V, Y), header_unread(A, X, F, V, Y).

// --- $LineByCrossing ---
field_line(A, X, $LineByCrossing(), F, V, Y) :-
    field(P, C, F, V, Y), marker(C, F, V, Y), interior(P, ZERO),
    axis_elem(A), split(P, A, X, _).

// --- $GapByCount ---
gap_takes(D, X, X_key, L, $GapByCount(), F, V, Y) :-
    field_gap(_, X, L, F, V, Y), before.tally([D, X, L, F, V, Y], N),
    key_gap(D, X_key, N, F, V, Y).

// --- $GapToEnd ---
gap_takes(D, X, X_key, L, $GapToEnd(), F, V, Y) :-
    field_gap(A, X, L, F, V, Y), axis_of(D, A), key_gap(D, X_key, 0, F, V, Y).

// --- $Stretch ---
out(P, Col, [L, $Stretch(), G, F, V, Y]) :-
    takes_cell(P, Q, _, _, L, G, F, V, Y), key(Q, Col, F, V, Y).

// --- $DrawLines ---
// The colors of a key line off its crossings.
// @claim stretch-key
.init line_color = Unanimous<KeyIdx, Color>
line_color.item([X, F, V, Y], C) :-
    key_line(_, X, _, F, V, Y), key(Q, C, F, V, Y), axis_elem(A), split(Q, A, X, X2),
    key_gap(_, X2, _, F, V, Y).

out(P, Col, [L, $DrawLines(), $GapByCount(), F, V, Y]) :-
    takes_cell(P, Q, D1, D2, L, $GapByCount(), F, V, Y), axis_of(D1, A), split(Q, A, K1, K2),
    ( key_line(D1, K1, _, F, V, Y), key_line(D2, K2, _, F, V, Y), key(Q, Col, F, V, Y)  // a crossing
    ; key_line(D1, K1, _, F, V, Y), key_gap(D2, K2, _, F, V, Y),
      line_color.value([K1, F, V, Y], Col)                                            // on one line
    ; key_gap(D1, K1, _, F, V, Y), key_gap(D2, K2, _, F, V, Y), params.background(Col) // off the lines
    ).

.comp Determine {
    // The field of each example: the box of its marker cells.
    .init marks = Bbox<Example>
    marks.cell(E, P) :- ex_in(E, P, C), params.marker(C).

    .init parse = Parse<Example>
    parse.field(E, P_inner, C) :- ex_in(E, P, C), marks.box(E, B), crop(P, B, P_inner).
    parse.marker(E, C) :- ex_in(E, _, _), params.marker(C).

    // Corner h reads a line at an index of an example whose two ends are not
    // both markers.
    .decl misread(h: DiagDir)
    misread(H) :-
        ex_out(E, _, _), parse.marked_end(E, A, X, D), !parse.both_marked(E, A, X),
        perp(A, A2), dir_of(H, A2, D).

    .decl header(d: DiagDir)
    header(H) :- diag_dir_elem(H), !misread(H).
}
