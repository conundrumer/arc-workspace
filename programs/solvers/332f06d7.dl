// 332f06d7
// @keywords: objects markers move walk
// input: A corridor of open cells winds across a background. A piece sits at
//  one end of it, and a marker block sits elsewhere.
// output: The piece slides along the corridor in straight runs, each run
//  going until one more step would not fit. The output shows the piece at
//  rest, with the corridor filling the place it left.

// where the piece comes to rest
.type Choice =
    // the piece travels to the corridor's other end: the stop it can leave only
    // the way it came
    Corridor {}
    // the piece heads for the marker and rests where it cuts the way to it: the
    // stop with no other stop between it and the marker
  | Goal {}

// A placement of the piece and a heading from it.
.type Leg = [delta: Offset, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(3).
    .decl piece(col: Color) piece(0).
    .decl corridor(col: Color) corridor(1).

    // --- $Goal ---
    .decl marker(col: Color) marker(2).
}

.init params = Params

// The piece: the cells that travel.
.decl piece_cell(p: Position)
piece_cell(P) :- in(P, Col), params.piece(Col).

// The corridor: every cell the piece may cover.
.decl open(p: Position)
open(P) :- in(P, Col), !params.bg(Col).

// The piece fits at a relative when its every cell lands in the corridor.
.init fits = Occurrences<Unit, Unit>
fits.cell($U(), P, $U())  :- open(P).
fits.shape($U(), P, $U()) :- piece_cell(P).

// From each fitting placement, the piece slides toward each edge until it
// meets the background.
.init slide = Gravity<Leg, Unit>
slide.dir([Delta, D], D) :- fits.occurrence($U(), Delta), dir_elem(D).
slide.cell([Delta, D], $U(), P2) :-
    slide.dir([Delta, D], D), piece_cell(P), compose(P, Delta, P2).
slide.blocked([Delta, D], P) :- slide.dir([Delta, D], D), in(P, Col), params.bg(Col).

// The leg's end: the placement the piece reaches toward d, when it moves.
.decl halt(delta: Offset, d: Dir, delta2: Offset)
halt(Delta, D, Delta2) :-
    slide.travel([Delta, D], $U(), V), V != ZERO, compose(Delta, V, Delta2).

// The stops of the journey: the piece starts where it stands and slides on.
.decl stop(delta: Offset)
stop(ZERO).
stop(Delta2) :- stop(Delta), halt(Delta, _, Delta2).

// The cells the piece covers at a stop.
.decl covered(delta: Offset, p: Position)
covered(Delta, P2) :- stop(Delta), piece_cell(P), compose(P, Delta, P2).

// Where the piece comes to rest.
.decl rest(delta: Offset, ch: Choice)

// --- $Corridor ---

// A stop with one way on has the corridor ending at it: that one way is the
// way the piece came.
.init onward = Unanimous<Offset, Dir>
onward.item(Delta, D) :- halt(Delta, D, _).

rest(Delta, $Corridor()) :- stop(Delta), Delta != ZERO, onward.value(Delta, _).

// --- $Goal ---

// What the marker still reaches with the piece standing at a stop.
.init ahead = Reach<Offset>
ahead.node(Delta, P) :- stop(Delta), open(P), !covered(Delta, P).
ahead.seed(Delta, P) :- stop(Delta), in(P, Col), params.marker(Col).

// A stop the piece would pass on its way to the marker: another stop lies
// between it and the marker.
.decl short_of(delta: Offset)
short_of(Delta) :- covered(Delta2, P), ahead.reach(Delta, P), Delta != Delta2.

rest(Delta, $Goal()) :- stop(Delta), !short_of(Delta).

// --- output ---

.decl landed(p: Position, ch: Choice)
landed(P, Ch) :- rest(Delta, Ch), covered(Delta, P).

out(P, Col, Ch) :- landed(P, Ch), params.piece(Col).
out(P, Col, Ch) :-
    rest(_, Ch), !landed(P, Ch),           // a cell the piece leaves free
    ( piece_cell(P), params.corridor(Col)  // where it stood, the corridor shows through
    ; in(P, Col), !piece_cell(P)           // elsewhere, the input
    ).
