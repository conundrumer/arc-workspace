// 6d1d5c90
// concept: markers walk count
// A band c.band_width wide at c.marker_edge holds one off-color cell. Drop it,
// then shift the rest toward c.shift_dir by that cell's distance from the
// opposite edge. The rows form a cycle (adjacency runs toward shift_dir, and
// the shift edge wraps to the far edge), so the shift rotates each row that
// many steps along the cycle.
//
// Two models for which cell is the marker, tagged on out's Choice:
//   $Marked()    — the cell of the designated c.marker_color.
//   $Singleton() — the band cell whose color appears c.marker_count times, the
//                  color itself unnamed.

#include "../lib.dl"

.type Choice = Marked {} | Singleton {}

.comp Consts {
    // --- shared ---
    .decl marker_edge(d: Dir) marker_edge(DIR_L).      // edge the band sits on
    .decl shift_dir(d: Dir) shift_dir(DIR_B).          // rows rotate toward this edge
    .decl band_width(k: number) band_width(1).         // the band is one column

    // --- Marked ---
    .decl marker_color(c: Color) marker_color(2).       // the marked cell's color

    // --- Singleton ---
    .decl marker_count(k: number) marker_count(1).      // occurrences of the marker color
}

.init c = Consts

// The marker cell in the band, under each model.
.decl marker(p: Position, ch: Choice)

// --- Marked ---
marker(P, $Marked()) :-
    in(P, Col), c.marker_edge(D), dist(P, D, 0), c.marker_color(Col).

// --- Singleton ---
.decl band_cell(p: Position, col: Color)
band_cell(P, Col) :- in(P, Col), c.marker_edge(D), dist(P, D, 0).

.init band_count = Tally<Color, Position>
band_count.item(Col, P) :- band_cell(P, Col).

marker(P, $Singleton()) :-
    band_cell(P, Col), c.marker_count(N), band_count.tally(Col, N).

.decl row_origin(d: Dir)
row_origin(FE) :- c.shift_dir(SD), opposite(SD, FE).

// Rotation amount: the marker's row index.
.decl shift_amt(m: number, ch: Choice)
shift_amt(M, Ch) :- marker(P, Ch), row_origin(FE), dist(P, FE, M).

// Each row, indexed from row_origin, is a node of the cycle. Ascending
// index runs toward shift_dir, so the wrap (max -> 0) is the shift edge
// wrapping back to the far edge.
.decl row_idx(k: number)
row_idx(K) :- in(P, _), row_origin(FE), dist(P, FE, K).

.init row_cycle = IndexCycle<Unit>
row_cycle.idx($U(), K) :- row_idx(K).

.init rot = CycleWalk<Unit, number>
rot.succ($U(), K, K2) :- row_cycle.succ($U(), K, K2).
rot.step($U(), M)     :- shift_amt(M, _).   // the shifts in use

// Rows placed back on the shift axis by index.
.init rows = DirFrame<Unit>
rows.dir(FE)     :- row_origin(FE).
rows.dist_set($U(), K) :- row_idx(K).

// Drop the band: the cells past it, seen in the frame it leaves.
.init kept = MarginFrame<Unit>
kept.cell($U(), P) :- in(P, _).
kept.width($U(), D, K) :- c.marker_edge(D), c.band_width(K).

.decl out(p: Position, col: Color, ch: Choice)
out(P_out, Col, Ch) :-
    in(P_in, Col), kept.inner($U(), P_in, P_kept),                  // a cell the drop keeps
    row_origin(FE), dist(P_in, FE, K_in),                           // input row index
    shift_amt(M, Ch), rot.walk($U(), K_in, M, K_out),               // rotated M steps along the cycle
    rows.pos($U(), K_out, P_v_out),                                 // placed back on the shift axis
    c.marker_edge(ME), axis_of(ME, A), split(P_kept, A, P_col, _),  // its column in the kept frame
    compose(P_v_out, P_col, P_out).                                 // row and column glued
