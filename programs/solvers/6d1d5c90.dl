// 6d1d5c90
// The c.marker_edge column is a band holding one off-color cell. Drop the band,
// then shift the rest toward c.shift_dir by that cell's distance from the
// opposite edge. The rows form a cycle — adjacency runs toward shift_dir, and
// the shift edge wraps to the far edge — so the shift is the marker rotating
// each row that many steps along the cycle.
//
// Two models for which cell is the marker, tagged on out's Choice:
//   $Marked()    — the cell of the designated c.marker_color.
//   $Singleton() — the band cell whose color appears c.marker_count times, the
//                  color itself unnamed.

#include "../lib.dl"

// A directed cycle (succ = edges, carrying no basepoint) with a gauge-free
// rotation: walk advances a start cell by n successor steps. Candidate lib
// component — see docs/wf-solver/7-proposals.md.
.comp Cycle<T> {
    .decl succ(p: T, p_next: T)
    .decl step(n: number)               // advance counts in use (bounds the walk)

    .decl walk(p0: T, n: number, p: T)  // p = p0 advanced n steps along succ
    walk(P0, 0, P0) :- succ(P0, _).
    walk(P0, N1, P2) :-
        walk(P0, N, P1), succ(P1, P2),
        step(N1), N1 = N + 1.           // N1 is the Z/n step count
}

// Unit displacement toward d: -1 at edge d, +1 at its opposite — the direction-
// keyed form of Reach/Components' hardcoded step deltas. Candidate lib primitive;
// sheltered in a comp here so its unit literals stay out of the body.
.comp UnitStep {
    .decl delta(d: Dir, p: Position) inline
    delta(D, Step) :-
        opposite(D, O), edge_delta(D, -1, Sd), edge_delta(O, 1, So), compose(Sd, So, Step).
}

// A set of positions strung along a direction, closed into a cycle: linear
// successor toward dir, with the dir-extreme wrapping back to the far extreme.
// walk advances a node n steps, bounded by the cycle's own length. The 1D-cycle
// peer of DirFrame. Candidate lib component; assumes the nodes form a dense line.
.comp DirCycle {
    .decl node(p: Position)
    .decl dir(d: Dir)                    // advance direction

    .init u = UnitStep
    .decl succ(p: Position, q: Position)
    succ(P, Q) :- node(P), dir(D), u.delta(D, S), compose(P, S, Q), node(Q).       // step toward dir
    succ(P, Q) :- node(P), dir(D), dist(P, D, 0),                                  // wrap:
                  node(Q), opposite(D, O), dist(Q, O, 0).                          //  dir extreme -> far extreme

    .init cyc = Cycle<Position>
    cyc.succ(P, Q) :- succ(P, Q).
    cyc.step(N)    :- L = count : { node(_) }, N = range(0, L).   // every advance the cycle allows

    .decl walk(p0: Position, n: number, p: Position)   // p0 advanced n steps
    walk(P0, N, P) :- cyc.walk(P0, N, P).
}

.type Choice = Marked {} | Singleton {}

.comp Consts {
    // --- shared ---
    .decl marker_edge(d: Dir)    marker_edge(LEFT).    // edge the band sits on
    .decl shift_dir(d: Dir)      shift_dir(BOTTOM).     // rows rotate toward this edge
    .decl band_width(k: number)  band_width(1).         // the band is one column

    // --- Marked ---
    .decl marker_color(c: Color) marker_color(2).       // the marked cell's color

    // --- Singleton ---
    .decl marker_count(k: number) marker_count(1).      // occurrences of the marker color
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// The marker cell in the band, under each model.
.decl marker(p: Position, ch: Choice)

// --- Marked ---
marker(P, $Marked()) :-
    in(P, Col), c.marker_edge(D), dist(P, D, 0), c.marker_color(Col).

// --- Singleton ---
.decl band_cell(p: Position, col: Color)
band_cell(P, Col) :- in(P, Col), c.marker_edge(D), dist(P, D, 0).
marker(P, $Singleton()) :-
    band_cell(P, Col), c.marker_count(N), N = count : { band_cell(_, Col) }.

// Rotation amount: marker distance from the edge opposite the shift.
.decl shift_amt(m: number, ch: Choice)
shift_amt(M, Ch) :- marker(P, Ch), c.shift_dir(SD), opposite(SD, FE), dist(P, FE, M).

// Each row, as a position on the shift axis, is a node of the cycle.
.init rows = DirCycle
rows.node(P_v) :- in(P, _), c.shift_dir(SD), axis_of(SD, A), split(P, A, P_v, _).
rows.dir(D)    :- c.shift_dir(D).

// Cells past the band — the ones that survive the drop.
.decl kept(p: Position, col: Color)
kept(P, Col) :-
    in(P, Col), c.marker_edge(ME), c.band_width(W), dist(P, ME, CL), CL >= W.

// Drop the band: a kept cell's far-edge distance is unchanged by the drop, so
// seating cells by that distance in the narrowed frame lets the band fall off.
.init cols = DirFrame
cols.dir(OE)     :- c.marker_edge(ME), opposite(ME, OE).
cols.dist_set(K) :- kept(P, _), c.marker_edge(ME), opposite(ME, OE), dist(P, OE, K).

.decl out(p: Position, col: Color, ch: Choice)
out(P_out, Col, Ch) :-
    kept(P_in, Col),
    c.shift_dir(SD), axis_of(SD, A), split(P_in, A, P_v_in, _),   // input row
    shift_amt(M, Ch), rows.walk(P_v_in, M, P_v_out),              // rotated M steps along the cycle
    c.marker_edge(ME), opposite(ME, OE), dist(P_in, OE, K),       // far-edge column
    cols.pos(K, P_col),                                           // placed in the narrowed frame
    compose(P_v_out, P_col, P_out).

.output out(IO=stdout)
