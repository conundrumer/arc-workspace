// 2013d3e2
// @keywords: decompose crop bbox
// input: A figure sits on background.
// output: Output is the corner region of its bounding box.

// how the corner region is bounded
.type Choice =
    // one quadrant of the box
    Half {}
    // the fixed-size window at the box corner
  | Window {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- $Half ---
    .decl divisor(n: number) divisor(2).
    .decl out_tile(p_tile: Position) out_tile([0, 1, 0, 1]).

    // --- $Window ---
    .decl win_dim(k: number) win_dim(3).
    .decl corner(d: DiagDir) corner(DIAG_TL).
}

.init params = Params

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), !params.bg(Col).

.decl box_cell(p_box: Position, col: Color)
box_cell(P_box, Col) :- in(P_grid, Col), bbox.box($U(), B), crop(P_grid, B, P_box).

// --- $Half ---
out(P_out, Col, $Half()) :-
    box_cell(P_box, Col),
    params.divisor(N), divide_2d(P_box, N, 0, P_tile, P_out),    // box divided NxN
    params.out_tile(P_tile).                                     // the output tile

// --- $Window ---
.init win = Frame2D<Unit>
win.extent($U(), A, K) :- params.win_dim(K), axis_elem(A).

out(P_out, Col, $Window()) :-
    box_cell(P_box, Col),
    win.cell($U(), P_out),
    params.corner(Diag), corner_anchor(Diag, P_box, P_out).   // same dists to the corner

.comp Determine {
    .init ex_box = Bbox<Example>
    ex_box.cell(E, P) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // Each trained example's output, seated among its box cells: the
    // placement is the box, in the box's frame, that the output fills.
    .init seat = Occurrences<Example, Color>
    seat.cell(E, P_box, Col) :- ex_in(E, P, Col), ex_box.box(E, B), crop(P, B, P_box).
    seat.shape(E, Q, Col) :- ex_out(E, Q, Col).

    // The box cut N by N has the seated output as its tile P_tile.
    .decl half_at(e: Example, n: number, p_tile: Position)
    half_at(E, N, P_tile) :-
        seat.occurrence(E, M), ex_out(E, Q, _), compose(M, Q, P_box),   // an output cell, seated
        axis_elem(A), sub_extent(P_box, A, N),
        divide_2d(P_box, N, 0, P_tile, Q).                              // the same cell of a tile

    // A trained example whose output is not that tile.
    .decl half_miss(n: number, p_tile: Position)
    half_miss(N, P_tile) :- half_at(_, N, P_tile), ex_out(E, _, _), !half_at(E, N, P_tile).

    .decl out_tile_at(n: number, p_tile: Position)
    out_tile_at(N, P_tile) :- half_at(_, N, P_tile), !half_miss(N, P_tile).

    .decl divisor(n: number)
    divisor(N) :- out_tile_at(N, _).

    .decl out_tile(p_tile: Position)
    out_tile(P_tile) :- out_tile_at(_, P_tile).

    // The seated output touches the box's corner Diag.
    .decl window_at(e: Example, d: DiagDir)
    window_at(E, Diag) :- seat.occurrence(E, M), diag_dir_elem(Diag), corner_dist(M, Diag, 0).

    // A trained example whose output is not at that corner.
    .decl corner_miss(d: DiagDir)
    corner_miss(Diag) :- window_at(_, Diag), ex_out(E, _, _), !window_at(E, Diag).

    .decl corner(d: DiagDir)
    corner(Diag) :- window_at(_, Diag), !corner_miss(Diag).
}
