// 834ec97d
// keywords: markers cast parity
// input: a single marker cell on bg
// output: The marker steps one cell toward params.dir; alternating columns
//  anchored at the marker's column fill with params.fill from the marker's
//  row to the opposite edge.

// how the alternating columns are picked; coincide at period 2
.type Choice =
    // the column jump is task data in the parameters
    Period {}
    // every-other-column alternation: two unit steps over a skipped column, no
    // parameter
  | Parity {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_B).   // marker steps toward this edge
    .decl fill(c: Color) fill(4).

    // --- $Period ---
    .decl period(k: number) period(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Period()). impl_choice($Parity()).

// The one non-bg cell.
.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !params.bg(Col).

.decl across(d: Dir)
across(D2) :- params.dir(D), perp_dir(D, D2).

// Cells of the marker's row whose columns the alternation hits, walked
// outward from the marker.
.decl beam(p: Position, ch: Choice)
beam(P, Ch) :- marker(P, _), impl_choice(Ch).

// --- $Period ---
beam(Q, $Period()) :-
    beam(P, $Period()),
    across(D2), params.period(K), jump(P, D2, K, Q), in(Q, _).

// --- $Parity ---
beam(Q, $Parity()) :-
    beam(P, $Parity()), across(D2),
    neighbor(P, D2, M), in(M, _),   // the skipped cell
    neighbor(M, D2, Q), in(Q, _).

// The filled region: each beam cell and its column toward the edge opposite
// the move.
.init rays = Ray<Choice>
rays.dir(Ch, O)  :- impl_choice(Ch), params.dir(D), opposite(D, O).
rays.cell(Ch, P) :- beam(_, Ch), in(P, _).
rays.mark(Ch, P) :- beam(P, Ch).

.decl moved(p: Position)
moved(Q) :- marker(P, _), params.dir(D), neighbor(P, D, Q).

out(P, Col, Ch) :- rays.ray(Ch, P, _, _, _), params.fill(Col).
out(P, Col, Ch) :- impl_choice(Ch), moved(P), marker(_, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !rays.ray(Ch, P, _, _, _), !moved(P), params.bg(Col).
