// 8f3a5a89
// draft
// keywords: markers objects enclose border
// input: A start marker seeds a region: the cells it reaches without
//  crossing a wall-colored cell.
// output: The region's outline is painted: its bg cells on the grid edge or
//  beside the outside.

// what the outside is
.type Choice =
    // the wall-colored components the grid edge reaches
    Walls {}
    // every cell off the region that the grid edge reaches
  | Beyond {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(8).
    .decl wall(c: Color) wall(1).
    .decl start(c: Color) start(6).
    .decl paint(c: Color) paint(7).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Walls()). impl_choice($Beyond()).

.init region = Reach<Unit>
region.node($U(), P) :- in(P, Col), !params.wall(Col).
region.seed($U(), P) :- in(P, Col), params.start(Col).

// The candidate outside cells. Those closed off from the grid edge are
// obstacles inside the region.
.init barrier = Closed<Choice>
barrier.cell($Walls(), P) :- in(P, Col), params.wall(Col).
barrier.cell($Beyond(), P) :- in(P, _), !region.reach($U(), P).

// The inside: the grid minus the outside.
.init within = Rim8<Choice>
within.cell(Ch, P) :-
    in(P, _), impl_choice(Ch),
    ( !barrier.cell(Ch, P)          // not a candidate
    ; barrier.region(Ch, P, _)      // an obstacle
    ).

.decl painted(p: Position, ch: Choice)
painted(P, Ch) :-
    within.rim(Ch, P),                                  // on the inside's outline
    region.reach($U(), P), in(P, Col), params.bg(Col).  // a bg cell of the region

out(P, Col, Ch) :- painted(P, Ch), params.paint(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !painted(P, Ch).
