// a699fb00
// Dashed lines: c.dot cells alternating with bg along c.axis. The gaps fill
// with c.fill. Two models of which bg cells are gaps, tagged on out's Choice:
//
//   $Flank — a bg cell with a dot on both along-axis neighbors.
//   $Span  — a bg cell with a dot on both along-axis sides in its line.

#include "../lib.dl"

.type Choice = Flank {} | Span {}

.comp Consts {
    .decl axis(a: Axis)    axis(HORIZONTAL).   // lines run along this axis
    .decl bg(c: Color)     bg(0).
    .decl dot(c: Color)    dot(1).             // dash color
    .decl fill(c: Color)   fill(2).            // gap color
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, ch: Choice)

// --- Flank ---

.decl flanked(p: Position)
flanked(P) :-
    in(P, Bg), c.bg(Bg), c.dot(Dot),                    // bg cell
    c.axis(A), axis_of(D, A), opposite(D, D2),          // the two along-axis dirs
    step_delta(D, S1), compose(P, S1, Q1), in(Q1, Dot),    // dot neighbor toward D
    step_delta(D2, S2), compose(P, S2, Q2), in(Q2, Dot).   // dot neighbor toward D2

out(P, F, $Flank())   :- flanked(P), c.fill(F).
out(P, Col, $Flank()) :- in(P, Col), !flanked(P).

// --- Span ---

// Bg cells between two dots on their line. Ray's inclusive reach is
// strict on the bg-only domain.
.init rays = Ray<Unit>
rays.dir(D)        :- c.axis(A), axis_of(D, A).
rays.cell(P)       :- in(P, Bg), c.bg(Bg).
rays.mark($U(), Q) :- in(Q, Dot), c.dot(Dot).

.decl spanned(p: Position)
spanned(P) :- rays.ray($U(), P, D), opposite(D, O), rays.ray($U(), P, O).

out(P, F, $Span())   :- spanned(P), c.fill(F).
out(P, Col, $Span()) :- in(P, Col), !spanned(P).

.output out(IO=stdout)
