// a699fb00
// @keywords: lines span
// output: Dashed lines: params.dot cells alternating with bg along params.axis.
//  The gaps fill with params.fill. The two cases model differently which bg
//  cells count as gaps.

// which bg cells count as gaps
.type Choice =
    // a bg cell with a dot on both along-axis neighbors
    Flank {}
    // a bg cell with a dot on both along-axis sides in its line
  | Span {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl axis(a: Axis) axis(AXIS_H).   // lines run along this axis
    .decl bg(c: Color) bg(0).
    .decl dot(c: Color) dot(1).              // dash color
    .decl fill(c: Color) fill(2).            // gap color
}

.init params = Params

// --- $Flank ---

.decl flanked(p: Position)
flanked(P) :-
    in(P, Bg), params.bg(Bg), params.dot(Dot),        // bg cell
    params.axis(A), axis_of(D, A), opposite(D, D2),   // the two along-axis dirs
    neighbor(P, D, Q1), in(Q1, Dot),                  // dot toward D
    neighbor(P, D2, Q2), in(Q2, Dot).                 // dot toward D2

out(P, F, $Flank())   :- flanked(P), params.fill(F).
out(P, Col, $Flank()) :- in(P, Col), !flanked(P).

// --- $Span ---

.init spans = Between<Unit>
spans.axis($U(), A) :- params.axis(A).
spans.cell($U(), P) :- in(P, Bg), params.bg(Bg).
spans.mark($U(), Q) :- in(Q, Dot), params.dot(Dot).

out(P, F, $Span())   :- spans.between($U(), P), params.fill(F).
out(P, Col, $Span()) :- in(P, Col), !spans.between($U(), P).
