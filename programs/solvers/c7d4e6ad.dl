// c7d4e6ad
// @keywords: lines mapping
// input: slices run along params.axis
// output: a cell whose color is in params.targets takes its slice's
//  replacement color, and every other cell is kept

// what supplies the slice's replacement color
.type Choice =
    // the color of the cell at edge params.anchor
    Anchor {}
    // the slice's one non-bg non-target color
  | Unique {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl targets(c: Color) targets(5).
    .decl axis(a: Axis) axis(AXIS_H).

    // --- Anchor ---
    .decl anchor(d: Dir) anchor(DIR_L).

    // --- Unique ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl cell_slice(p: Position, col: Color, p_across: Position)
cell_slice(P, Col, P_across) :- in(P, Col), params.axis(A), split(P, A, _, P_across).

.decl slice_repl(p_across: Position, col: Color, ch: Choice)

slice_repl(P_across, Col, $Anchor()) :-
    cell_slice(P, Col, P_across), params.anchor(D), dist(P, D, 0).

slice_repl(P_across, Col, $Unique()) :-
    cell_slice(P, Col, P_across), !params.targets(Col), !params.bg(Col).

.decl impl_choice(ch: Choice)
impl_choice($Anchor()).
impl_choice($Unique()).

out(P, Col_out, Ch) :-
    impl_choice(Ch), cell_slice(P, Col, P_across),
    ( params.targets(Col), slice_repl(P_across, Col_out, Ch)  // a target cell takes its slice's replacement
    ; !params.targets(Col), Col_out = Col                     // not a target — kept
    ).
