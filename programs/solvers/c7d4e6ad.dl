// c7d4e6ad
// concept: lines mapping
// Cells of color in params.targets are substituted with a per-slice replacement
// color. Slices run along params.axis. Two models of the replacement source:
//
//   $Anchor — the cell at edge params.anchor (positional)
//   $Unique — the slice's unique non-bg non-target color (content-defined)

#include "../lib.dl"

.type Choice = Anchor {} | Unique {}

.comp Params {
    // anchor
    .decl anchor(d: Dir) anchor(DIR_L).

    // unique
    .decl targets(c: Color) targets(5).
    .decl bg(c: Color) bg(0).
    .decl axis(a: Axis) axis(AXIS_H).
}

.init params = Params

// Per-slice replacement color, parameterized by impl choice.
.decl slice_repl(p_across: Position, col: Color, c: Choice)

slice_repl(P_across, Col, $Anchor()) :-
    in(P, Col),
    params.anchor(D), dist(P, D, 0),
    params.axis(A), split(P, A, _, P_across).

slice_repl(P_across, Col, $Unique()) :-
    in(P, Col), !params.targets(Col), !params.bg(Col),
    params.axis(A), split(P, A, _, P_across).

.decl impl_choice(ch: Choice)
impl_choice($Anchor()).
impl_choice($Unique()).

.decl out(p: Position, col: Color, c: Choice)
out(P, Col_out, Impl) :-
    impl_choice(Impl), in(P, Col),
    ( params.targets(Col),                             // a target cell
      params.axis(A), split(P, A, _, P_across),
      slice_repl(P_across, Col_out, Impl)         // its slice's replacement
    ; !params.targets(Col), Col_out = Col         // not a target — kept
    ).
