// 3d31c5b3
// @keywords: overlay decompose lookup rank
// output: The grid divides along params.axis into a stack of tiles, each drawn
//  in its own ink. The output overlays the tiles: the highest-precedence ink
//  present fills each cell, bg where every tile is empty. Each tile keeps one
//  ink in every pair, so tile and ink precedence are indistinguishable.

// find the tiles
.type DecChoice =
    // by tile count
    Count {}
    // by tile size
  | Size {}

// precedence
.type Prec =
    // per-tile ranks
    Order {}
    // per-ink ranks
  | Ink {}

.type Choice    = [d: DecChoice, c: Prec]

.type CellKey = [p: Position, d: DecChoice]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Count ---
    .decl tiles(n: number) tiles(4).

    // --- $Size ---
    .decl tile_size(k: number) tile_size(3).

    // --- $Order ---
    .decl prio(p: Position, r: number)
    GRID_4x1(prio,
        0,
        1,
        3,
        2)

    // --- $Ink ---
    .decl ink_rank(c: Color, r: number)
    ink_rank(5, 0). ink_rank(4, 1). ink_rank(8, 2). ink_rank(2, 3).
}

.init params = Params

// --- decompose cases: the tile a cell sits in ---

.decl tile_cell(p_tile: Position, p_intile: Position, col: Color, dc: DecChoice)
tile_cell(P_tile, P_intile, Col, $Count()) :-
    in(P_grid, Col),
    params.axis(A), params.tiles(N),                            // layout by count
    divide_slab(P_grid, A, N, 0, P_tile, P_intile).
tile_cell(P_tile, P_intile, Col, $Size()) :-
    in(P_grid, Col),
    params.axis(A), params.tile_size(K),                        // layout by size
    divide_by_size_slab(P_grid, A, K, 0, P_tile, P_intile).

// Ink at an output cell, keyed by its tile.
.decl tile_ink(p_tile: Position, p: Position, col: Color, dc: DecChoice)
tile_ink(P_tile, P_intile, Col, Dc) :-
    tile_cell(P_tile, P_intile, Col, Dc), !params.bg(Col).

.decl ink_at(p: Position, col: Color, dc: DecChoice)
ink_at(P, Col, Dc) :- tile_ink(_, P, Col, Dc).

.decl prec_choice(c: Prec)
prec_choice($Order()). prec_choice($Ink()).

out(P, Col, [Dc, C]) :-
    prec_choice(C), tile_cell(_, P, _, Dc), !ink_at(P, _, Dc), params.bg(Col).

// --- $Order ---

// The foremost tile inking each cell.
.init front_tile = ArgExtremes<CellKey, Position>
front_tile.cand([P, Dc], T, R) :- tile_ink(T, P, _, Dc), params.prio(T, R).

out(P, Col, [Dc, $Order()]) :- front_tile.low([P, Dc], T, _), tile_ink(T, P, Col, Dc).

// --- $Ink ---

// The foremost ink at each cell.
.init front_ink = ArgExtremes<CellKey, Color>
front_ink.cand([P, Dc], Col, R) :- ink_at(P, Col, Dc), params.ink_rank(Col, R).

out(P, Col, [Dc, $Ink()]) :- front_ink.low([P, Dc], Col, _).

.comp Determine {
    .decl tile_ink(e: Example, p_tile: Position, p: Position, col: Color)
    tile_ink(E, P_tile, P_intile, Col) :-
        ex_in(E, P_grid, Col), !params.bg(Col),
        params.axis(A), params.tiles(N),
        divide_slab(P_grid, A, N, 0, P_tile, P_intile).

    // At a cell both ink, the output keeps T's ink over T2's.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        tile_ink(E, T, P, Col), tile_ink(E, T2, P, Col2), Col != Col2,
        ex_out(E, P, Col).

    // The tiles each tile beats, directly or through others: a tile pair
    // need not overlap directly.
    .init beaten = Propagation<Position, Position>
    beaten.source(T, T2) :- beats(T, T2).
    beaten.edge(T, T2, T3) :- beats(T, _), beats(T2, T3).

    .init order = Order<Unit, Position>
    order.elem($U(), T) :- tile_ink(_, T, _, _).
    order.before($U(), T, T2) :- beaten.reached(T, T2).

    .decl prio(p: Position, r: number)
    prio(T, R) :- order.rank($U(), T, R).

    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- tile_ink(_, T, _, Col), prio(T, R).
}
