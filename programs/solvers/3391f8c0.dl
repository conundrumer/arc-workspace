// 3391f8c0
// draft
// concept: objects stamp
// Two colors each appear as copies of one shape, and the two shapes fill the
// same bbox. Every copy is replaced by the other color's shape, in that other
// color, drawn into the copy's own bbox.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- copies ---

.init objs = Components8<Color>
objs.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl copy(id: Ident, col: Color, p: Position)
copy(Id, Col, P) :- objs.label(Col, P, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- copy(Id, _, P).

// A color's shape, in the box frame its copies share.
.decl shape(col: Color, p_inner: Position)
shape(Col, P_inner) :- copy(Id, Col, P), bbox.box(Id, B), crop(P, B, P_inner).

// The two colors trade shapes.
.decl swap(col: Color, col2: Color)
swap(Col, Col2) :- copy(_, Col, _), copy(_, Col2, _), Col != Col2.

// --- output ---

.decl paint(p: Position, col: Color)
paint(P, Col2) :-
    copy(Id, Col, _), swap(Col, Col2),   // a copy, and the color it trades with
    shape(Col2, P_inner),                             // that color's shape
    in(P, _), bbox.box(Id, B), crop(P, B, P_inner).   // in this copy's bbox, blank cells included

.decl out(p: Position, col: Color)
out(P, Col) :- paint(P, Col).
out(P, Col) :- in(P, _), !paint(P, _), params.bg(Col).
