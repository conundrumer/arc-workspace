// 3490cc26
// concept: objects markers walk
// The grid holds equal-sized blocks, one of them colored c.seed. Two blocks
// reach each other when they lie on one line with no third block between
// them. From the seed, the chain steps to the nearest block it reaches and
// does not already hold, and it ends where every block it reaches is one it
// already holds. Each link fills the cells between its two blocks in c.path.

#include "../lib.dl"

.comp Consts {
    .decl bg(col: Color) bg(0).
    .decl seed(col: Color) seed(2).
    .decl path(col: Color) path(7).
}

.init c = Consts

// --- blocks ---

.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !c.bg(Col).

.init bb = Bbox<Ident>
bb.cell(Id, P) :- blocks.label($U(), P, Id).

// A block stands as its own bounding box. The blocks are all one size, so
// those boxes share one frame and a step between them is a step of a block.
.decl block(m: Position, col: Color)
block(M, Col) :- bb.margin(Id, M), blocks.label($U(), P, Id), in(P, Col).

// Blocks look along their lines, and each block stops the look behind it.
.init sight = Ray<Unit>
sight.dir($U(), D) :- dir_elem(D).
sight.mark($U(), M) :- block(M, _).
sight.blocked($U(), M) :- block(M, _).

// --- the chain ---

// A block reaches the first block on each of its lines, at the number of
// steps between the two boxes.
.decl reach(m: Position, d: Dir, m2: Position, k: number)
reach(M, D, M2, K) :- sight.stop($U(), M2, D, K, M), dir_elem(D).

.decl seed_block(m: Position)
seed_block(M) :- block(M, Col), c.seed(Col).

// The partition the chain carries: the blocks it holds (taken) and the rest
// (untaken).
.init state = Take<Unit, Position, Position>
state.start($U(), M) :- seed_block(M).
state.step($U(), M, M2) :- hop(M, M2).
state.take($U(), M, M2) :- hop(M, M2).
state.init_taken($U(), M) :- seed_block(M).
state.init_untaken($U(), M) :- block(M, _), !seed_block(M).

// The look along D finds no untaken block nearer than K: no block there,
// none nearer, or a taken one.
.decl clear_dir(m: Position, k: number, d: Dir)
clear_dir(M, K, D) :-
    reach(M, _, _, K), dir_elem(D),
    ( !reach(M, D, _, _)
    ; reach(M, D, _, K2), K <= K2
    ; reach(M, D, M2, _), state.taken($U(), M, M2)
    ).

// Both looks of an axis clear, then both axes: no untaken block nearer than
// K in any direction.
.decl clear_axis(m: Position, k: number, a: Axis)
clear_axis(M, K, A) :-
    clear_dir(M, K, D), clear_dir(M, K, D2), opposite(D, D2), axis_of(D, A).

.decl all_clear(m: Position, k: number)
all_clear(M, K) :- clear_axis(M, K, A), clear_axis(M, K, A2), perp(A, A2).

// The step taken: the nearest block the chain does not hold. A tie leaves
// both, and the walk forks.
.decl hop(m: Position, m2: Position)
hop(M, M2) :- state.untaken($U(), M, M2), reach(M, _, M2, K), all_clear(M, K).

// A link fills the box the two blocks span, less the blocks themselves.
.type Link = [m: Position, m2: Position]

.init span = Bbox<Link>
span.cell([M, M2], Q) :- hop(M, M2), ( Q = M ; Q = M2 ).
span.grid([M, M2], P) :- hop(M, M2), in(P, _).

.decl link_cell(p: Position)
link_cell(P) :- span.inside(_, P), !blocks.node($U(), P).

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), !link_cell(P).
out(P, Col) :- link_cell(P), c.path(Col).
