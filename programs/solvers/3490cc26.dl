// 3490cc26
// @keywords: objects markers walk
// input: The grid holds equal-sized blocks, one of them colored params.seed.
//  Two blocks reach each other when they lie on one line with no third block
//  between them.
// output: From the seed, the chain steps to the nearest block it reaches and
//  does not already hold. Each link fills the cells between its two blocks in
//  params.path.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl seed(col: Color) seed(2).
    .decl path(col: Color) path(7).
}

.init params = Params

// --- blocks ---

.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bb = Bbox<Ident>
bb.cell(Id, P) :- blocks.label($U(), P, Id).

// A block stands as its own bounding box. The blocks are all one size, so
// those boxes share one frame and a step between them is a step of a block.
.decl block(b: Box, col: Color)
block(B, Col) :- bb.box(Id, B), blocks.label($U(), P, Id), in(P, Col).

// Blocks look along their lines, and each block stops the look behind it.
.init sight = Ray<Unit>
sight.dir($U(), D) :- dir_elem(D).
sight.mark($U(), B) :- block(B, _).
sight.blocked($U(), B) :- block(B, _).

// --- the chain ---

.decl seed_block(b: Box)
seed_block(B) :- block(B, Col), params.seed(Col).

// The partition the chain carries: the blocks it holds (taken) and the rest
// (untaken).
.init state = Take<Unit, Box, Box>
state.start($U(), B) :- seed_block(B).
state.step($U(), B, B2) :- hop(B, B2).
state.take($U(), B, B2) :- hop(B, B2).
state.init_taken($U(), B) :- seed_block(B).
state.init_untaken($U(), B) :- block(B, _), !seed_block(B).

// The step taken: of the blocks the chain reaches and does not hold, the
// one at the fewest steps. A tie leaves both, and the walk forks.
.init nearest = ArgExtremes<Box, Box>
nearest.cand(B, B2, K) :- state.untaken($U(), B, B2), sight.stop($U(), B2, _, K, B).

.decl hop(b: Box, b2: Box)
hop(B, B2) :- nearest.low(B, B2, _).

// A link fills the box the two blocks span, less the blocks themselves.
.type Link = [b: Box, b2: Box]

.init span = Bbox<Link>
span.cell([B, B2], B3) :- hop(B, B2), ( B3 = B ; B3 = B2 ).

.decl link_cell(p: Position)
link_cell(P) :- span.box(_, B), in(P, _), inside(P, B), !blocks.node($U(), P).

out(P, Col) :- in(P, Col), !link_cell(P).
out(P, Col) :- link_cell(P), params.path(Col).
