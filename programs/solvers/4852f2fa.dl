// 4852f2fa
// @draft
// @keywords: markers crop tile-arrangement count select stamp bbox
// input: One shape sits on a blank grid beside scattered single-cell
//  markers.
// output: The output repeats the shape's bounding box along one axis, one
//  copy per marker.

// what a copy paints where the box's own content would appear — no
// marker falls inside the box, so the pairs do not show what the copies
// carry there
.type Choice =
    // each copy reproduces the box's content
    Copy {}
    // each copy paints the shape's footprint, the rest of the box
    // background
  | Stamp {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl ink(col: Color) ink(8).
    .decl axis(a: Axis) axis(AXIS_H).
}

.init params = Params

.decl ink_cell(p: Position)
ink_cell(P) :- in(P, Col), params.ink(Col).

.decl mark(p: Position)
mark(P) :- in(P, Col), !params.bg(Col), !params.ink(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink_cell(P).

.init mark_count = Tally<Unit, Position>
mark_count.item($U(), P) :- mark(P).

.init reps = AxisFrame<Unit>
reps.extent($U(), A, N) :- params.axis(A), mark_count.tally($U(), N).

.decl place(p_grid_out: Position, p_grid_in: Position)
place(P_grid_out, P_grid_in) :-
    reps.cell($U(), A, P_tile),                            // one tile per marker
    bbox.box($U(), B), in(P_grid_in, _),
    crop(P_grid_in, B, P_intile),                          // box cell in the tile frame
    concat_slab(P_tile, P_intile, A, 0, P_grid_out).

// --- $Copy ---
out(P_grid_out, Col, $Copy()) :- place(P_grid_out, P_grid_in), in(P_grid_in, Col).

// --- $Stamp ---
out(P_grid_out, Col, $Stamp()) :-
    place(P_grid_out, P_grid_in),
    ( ink_cell(P_grid_in), params.ink(Col)             // footprint painted
    ; !ink_cell(P_grid_in), params.bg(Col)             // rest of the box blank
    ).
