// 3ed85e70
// draft
// concept: markers objects stamp
// The grid splits into two panels: a legend panel holding decorated shapes,
// and a field panel holding clues. Each clue names one shape and where it
// goes; the shape stamps over the clue. A clue that names no shape stays.
//
// A one-color clue shows the box that its color fills in the shape.
// A many-color clue shows a piece of the shape verbatim.

#include "../lib.dl"

.comp Params {
    .decl legend_bg(col: Color) legend_bg(3).
    .decl field_bg(col: Color) field_bg(0).
}

.init params = Params

// --- panels ---

// The legend's background spans the grid, so it reaches an edge. The field
// carries blocks of that color too, and those sit clear of every edge.
.init ground = Reach<Unit>
ground.node($U(), P) :- in(P, Col), params.legend_bg(Col).
ground.seed($U(), P) :- in(P, _), dir_elem(D), dist(P, D, 0).

.init panel = Bbox<Unit>
panel.cell($U(), P) :- ground.reach($U(), P).
panel.grid($U(), P) :- in(P, _).

.decl legend_cell(p: Position, col: Color)
legend_cell(P, Col) :- in(P, Col), panel.inside($U(), P), !params.legend_bg(Col).

.decl field_cell(p: Position, col: Color)
field_cell(P, Col) :- in(P, Col), !panel.inside($U(), P), !params.field_bg(Col).

// --- shapes and clues ---

.init shapes = Components<Unit>
shapes.node($U(), P) :- legend_cell(P, _).

.decl shape_cell(s: Ident, p: Position, col: Color)
shape_cell(S, P, Col) :- shapes.label($U(), P, S), legend_cell(P, Col).

.init clues = Components<Unit>
clues.node($U(), P) :- field_cell(P, _).

.decl clue_cell(k: Ident, p: Position, col: Color)
clue_cell(K, P, Col) :- clues.label($U(), P, K), field_cell(P, Col).

.init clue_palette = Unanimous<Ident, Color>
clue_palette.item(K, Col) :- clue_cell(K, _, Col).

// --- placement ---

.init clue_box = Bbox<Ident>
clue_box.cell(K, P) :- clue_cell(K, P, _).

.type Layer = [s: Ident, col: Color]

.init layer_box = Bbox<Layer>
layer_box.cell([S, Col], P) :- shape_cell(S, P, Col).

// The shift carrying a shape cell onto the grid.
.decl place(s: Ident, v: Offset)

place(S, V) :-
    clue_palette.value(K, Col),                     // a one-color clue
    clue_box.extents(K, A, N1, N2),
    layer_box.extents([S, Col], A, N1, N2),         // the color fills a box of the clue's size
    clue_box.box(K, M_clue), layer_box.box([S, Col], M_layer),
    relative(M_layer, M_clue, V).               // that box onto the clue

// A many-color clue is tested as a piece of each shape.
.type Piece = [k: Ident, s: Ident]

.decl piece(k: Ident, s: Ident)
piece(K, S) :- clue_palette.clash(K), shape_cell(S, _, _).

.init occ = Occurrences<Piece, Color>
occ.cell([K, S], P, Col)  :- piece(K, S), shape_cell(S, P, Col).
occ.shape([K, S], P, Col) :- piece(K, S), clue_cell(K, P, Col).

place(S, V) :-
    occ.occurrence([K, S], M),   // the clue occurs in the shape
    relative(M, ZERO, V).  // read back: the shape onto the clue

// --- output ---

.decl stamp(p: Position, col: Color)
stamp(P, Col) :- place(S, V), shape_cell(S, P_shape, Col), compose(P_shape, V, P).

.decl out(p: Position, col: Color)
out(P, Col) :- stamp(P, Col).
out(P, Col) :- in(P, Col), !stamp(P, _).
