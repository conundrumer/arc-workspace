// 53b68214
// @keywords: grow wallpaper
// input: the input is periodic along params.growth: the period is the
//  shortest shift it agrees with itself under
// output: The output frame extends the input toward params.growth, and the
//  pattern continues period by period into the new cells. The models
//  coincide here (width and canvas are both 10 in every pair); they diverge
//  when the input width differs from the canvas.

// two models of the grown extent
.type Choice =
    // it matches the perpendicular extent
    Square {}
    // it is stored (params.out_dim); the perpendicular passes through
  | Canvas {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl growth(d: Dir) growth(DIR_B).

    // --- $Canvas ---
    .decl out_dim(k: number) out_dim(10).
}

.init params = Params

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- in(P, Col).

.decl width(w: number)
width(W) :- in(P, _), params.growth(D), axis_of(D, A), perp(A, A2), axis_dim(P, A2, W).

// Per-case output frame.
.init frame = Frame2D<Choice>

// --- $Square ---
frame.extent($Square(), A, W) :- width(W), axis_elem(A).

// --- $Canvas ---
frame.extent($Canvas(), A, K)  :- params.growth(D), axis_of(D, A), params.out_dim(K).
frame.extent($Canvas(), A2, W) :- width(W), params.growth(D), axis_of(D, A), perp(A, A2).

// The input seated against the edge the growth flows away from, and the
// pattern continuing from each input cell at every whole period on.
out(P_grid, Col, Ch) :-
    frame.cell(Ch, P_grid), in(P_in, Col),
    params.growth(D), axis_of(D, A), same_line(A, P_in, P_grid),   // one line along the growth
    opposite(D, O), dist(P_in, O, T), dist(P_grid, O, T2), T <= T2, // at or past the input cell
    si.min_period($U(), A, K),
    stride(T, K, 0, _, R), stride(T2, K, 0, _, R).                 // a whole number of periods on
