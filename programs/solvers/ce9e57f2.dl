// ce9e57f2
// concept: lines, rank
// Bars of bar color stand on the base edge, one per line. In each bar, the
// cells strictly nearer the base end than the far end recolor to mark.

#include "../lib.dl"

.comp Consts {
    .decl bar(col: Color) bar(2).
    .decl mark(col: Color) mark(8).
    .decl base(d: Dir) base(DIR_B).
}

.init c = Consts

// Bars keyed by their line's across position.
.init bars = BoxFrame<Position>
bars.cell(Ac, P) :-
    in(P, Col), c.bar(Col),                       // bar cell
    c.base(D), axis_of(D, A), split(P, A, _, Ac). // line = across position

// Bar cells strictly nearer the base end of their bar than the far end.
.decl marked(p: Position)
marked(P) :-
    bars.inner(_, P, I),
    c.base(D), dist_pair(I, D, K, K2), K < K2.

.decl out(p: Position, col: Color)
out(P, Col) :- marked(P), c.mark(Col).
out(P, Col) :- in(P, Col), !marked(P).
