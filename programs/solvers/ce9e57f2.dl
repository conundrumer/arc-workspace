// ce9e57f2
// @keywords: lines rank
// input: bars of bar color on the base edge, one per line
// output: In each bar, the cells strictly nearer the base end than the far
//  end recolor to mark.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bar(col: Color) bar(2).
    .decl mark(col: Color) mark(8).
    .decl base(d: Dir) base(DIR_B).
}

.init params = Params

// Bars keyed by their line's across position.
.init bars = Bbox<Position>
bars.cell(Ac, P) :-
    in(P, Col), params.bar(Col),                       // bar cell
    params.base(D), axis_of(D, A), split(P, A, _, Ac). // line = across position

// Bar cells strictly nearer the base end of their bar than the far end.
.decl marked(p: Position)
marked(P) :-
    bars.cell(Ac, P), bars.box(Ac, B), crop(P, B, P_inner),  // bar cell in its bar's frame
    params.base(D), dist_pair(P_inner, D, K, K2), K < K2.

out(P, Col) :- marked(P), params.mark(Col).
out(P, Col) :- in(P, Col), !marked(P).
