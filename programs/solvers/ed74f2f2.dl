// ed74f2f2
// concept: decompose crop lookup
// A 1×2 arrangement of 3×3 tiles, gap 1, behind a 1-cell bg border. The
// c.key_tile selects a color from a stored tile table; the output is the
// c.target_tile with its ink repainted that color, bg passed through.

#include "../lib.dl"

.type KeyCell = [p: Position, col: Color]

.comp Consts {
    .init helpers = ConstsHelpers

    .decl bg(c: Color) bg(0).
    .decl key_tile(p: Position) key_tile([0, 0, 0, 1]).
    .decl target_tile(p: Position) target_tile([0, 0, 1, 0]).

    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 1). arr_dim(AXIS_H, 2).
    .decl tile_dim(n: number) tile_dim(3).
    .decl gap(g: number) gap(1).
    .decl border(b: number) border(1).

    .decl decompose(p_grid: Position, p_tile: Position, p_intile: Position)
    decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah), tile_dim(K), gap(G),
        helpers.tile_pos([Av, Ah], [K, K], [0, G], P_frame, P_tile, P_intile),
        border(B), compose(P_frame, [B, B, B, B], P_grid).

    // Grid cells of the key and target tiles, with their intile positions.
    .decl key_cell(p_grid: Position, p_intile: Position)
    key_cell(P_grid, P_intile) :-
        decompose(P_grid, P_tile, P_intile), key_tile(P_tile).

    .decl target_cell(p_grid: Position, p_intile: Position)
    target_cell(P_grid, P_intile) :-
        decompose(P_grid, P_tile, P_intile), target_tile(P_tile).

    // Key table: key tile content → output color.
    .decl key_member(id: Ident, p_intile: Position, col: Color)
    .decl key_color(id: Ident, col: Color)

    GRID_3x3(key_member, 0,
        5, 5, 0,
        0, 5, 0,
        0, 5, 5)
    key_color(0, 2).

    GRID_3x3(key_member, 1,
        0, 5, 5,
        0, 5, 0,
        5, 5, 0)
    key_color(1, 3).

    GRID_3x3(key_member, 2,
        5, 5, 5,
        0, 5, 0,
        0, 5, 0)
    key_color(2, 1).
}

.init c = Consts

// Key tile content → color.
.init key_match = KeyedSetCompare<Unit, Ident, KeyCell>
key_match.pattern_member(Id, [P_intile, Col]) :- c.key_member(Id, P_intile, Col).
key_match.observed_member($U(), [P_intile, Col]) :-
    in(P_grid, Col), c.key_cell(P_grid, P_intile).

// The target tile's content.
.decl target(p_intile: Position, col: Color)
target(P_intile, Col) :- in(P_grid, Col), c.target_cell(P_grid, P_intile).

.decl out(p: Position, col: Color)
out(P, Col) :-
    target(P, C), !c.bg(C),                                // target ink cell
    key_match.equals($U(), Id), c.key_color(Id, Col).      // key's color
out(P, C) :- target(P, C), c.bg(C).                        // bg passes through

// --- fit ---

.comp Fit {
    // The key tile's content, per example.
    .decl fkey(e: Example, p_intile: Position, col: Color)
    fkey(E, P_intile, Col) :-
        ex_in(E, P_grid, Col), c.key_cell(P_grid, P_intile).

    // Examples whose key tiles agree share an entry.
    .init same = KeyedSetCompare<Example, Example, KeyCell>
    same.pattern_member(E, [P_intile, Col])  :- fkey(E, P_intile, Col).
    same.observed_member(E, [P_intile, Col]) :- fkey(E, P_intile, Col).

    .init entry = Canon<Example>
    entry.equiv(E, E2) :- same.equals(E, E2).

    .decl key_member(id: Ident, p_intile: Position, col: Color)
    key_member(Id, P_intile, Col) :- entry.id(E, Id), fkey(E, P_intile, Col).

    // The entry's color is the ink the example's output carries.
    .decl key_color(id: Ident, col: Color)
    key_color(Id, Col) :- entry.id(E, Id), ex_out(E, _, Col), !c.bg(Col).
}
