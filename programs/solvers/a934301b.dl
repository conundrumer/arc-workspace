// a934301b
// @draft
// @keywords: objects count select lookup
// @scene rectangles: the input is a params.background field holding solid
//  rectangles, each made of cells of 1 and params.mark cells, and no two
//  rectangles touch, so each rectangle is one connected component of
//  non-params.background cells
// @rule count-marks: an object is one rectangle, and its mark count is the
//  number of its params.mark cells
//     @approximated: an object is a 4-connected component of
//      non-params.background cells, and its mark count is the number of its
//      params.mark cells
//     @witness touching-rectangles: borderline other
//         @relaxed rectangles
// @rule erase-crowded: an object whose mark count exceeds params.max_marks
//  becomes params.background
// @rule keep-rest: every other cell of the output is the input cell

// which cells join one object
.type Adjacency =
    // @claim count-marks
    FourAdjacent {}
    // @rule count-marks: an object is an 8-connected component of
    //  non-params.background cells
    // @witness corner-contact: borderline concept
    //     @relaxed rectangles
  | EightAdjacent {}

// which cells of an object count as marks
.type MarkKind =
    // @claim count-marks
    MarkColor {}
    // @rule count-marks: a mark is any object cell not of params.body
    // @witness third-color: borderline $NonBody
    //     @relaxed rectangles
  | NonBody {}

// what the mark count counts
.type MarkUnit =
    // @claim count-marks
    MarkCells {}
    // @rule count-marks: the mark count is the number of 4-connected groups
    //  of mark cells in the object
    // @witness mark-domino: ordinary concept
  | MarkGroups {}

// which mark counts erase an object
.type Selection =
    // @claim erase-crowded
    Threshold {}
    // @rule erase-crowded: an object whose mark count is in params.drop_count
    //  becomes params.background, one whose count is in params.keep_count
    //  stays, and an object whose count is in neither leaves the output
    //  undefined
    // @witness five-marks: ordinary concept
    //     @reassigned keep_count
  | CountTable {}

.type Choice = [a: Adjacency, k: MarkKind, u: MarkUnit, s: Selection]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed rectangles
    .decl background(c: Color) background(0).

    // --- $MarkColor ---
    // @derive RarestColor: variant derived
    //     @relaxed rectangles
    .decl mark(c: Color) mark(8).

    // --- $NonBody ---
    .decl body(c: Color) body(1).

    // --- $Threshold ---
    // the largest mark count an object keeps
    .decl max_marks(n: number) max_marks(1).

    // --- $CountTable ---
    .decl keep_count(n: number)
    keep_count(0). keep_count(1).
    // @derive TileCount: ordinary concept
    .decl drop_count(n: number)
    drop_count(2). drop_count(3). drop_count(4).
}

.init params = Params

.decl adjacency_choice(a: Adjacency)
adjacency_choice($FourAdjacent()). adjacency_choice($EightAdjacent()).

.decl mark_kind_choice(kind: MarkKind)
mark_kind_choice($MarkColor()). mark_kind_choice($NonBody()).

.decl mark_unit_choice(u: MarkUnit)
mark_unit_choice($MarkCells()). mark_unit_choice($MarkGroups()).

.decl selection_choice(s: Selection)
selection_choice($Threshold()). selection_choice($CountTable()).

.decl impl_choice(ch: Choice)
impl_choice([A, Kind, U, S]) :-
    adjacency_choice(A), mark_kind_choice(Kind), mark_unit_choice(U), selection_choice(S).

// The objects of a grid, and their mark counts under each reading.
.comp Parse<Key> {
    // One object with one reading of its marks.
    .type Marked = [k: Key, a: Adjacency, id: Ident, kind: MarkKind]

    .type KeyKind = [k: Key, kind: MarkKind]

    .decl cell(k: Key, p: Position, col: Color)

    .decl ink(k: Key, p: Position, col: Color)
    ink(K, P, Col) :- cell(K, P, Col), !params.background(Col).

    .decl object(k: Key, a: Adjacency, id: Ident, p: Position)

    .decl mark(k: Key, kind: MarkKind, p: Position)

    .decl mark_count(m: Marked, u: MarkUnit, n: number)

    // --- $FourAdjacent ---
    // @claim count-marks
    .init objects4 = Components<Key>
    objects4.node(K, P) :- ink(K, P, _).
    object(K, $FourAdjacent(), Id, P) :- objects4.label(K, P, Id).

    // --- $EightAdjacent ---
    // @claim count-marks
    .init objects8 = Components8<Key>
    objects8.node(K, P) :- ink(K, P, _).
    object(K, $EightAdjacent(), Id, P) :- objects8.label(K, P, Id).

    // --- $MarkColor ---
    mark(K, $MarkColor(), P) :- cell(K, P, Col), params.mark(Col).

    // --- $NonBody ---
    mark(K, $NonBody(), P) :- ink(K, P, Col), !params.body(Col).

    // --- $MarkCells ---
    // @claim count-marks
    .init mark_cells = Tally<Marked, Position>
    mark_cells.domain([K, A, Id, Kind]) :- object(K, A, Id, _), mark_kind_choice(Kind).
    mark_cells.item([K, A, Id, Kind], P) :- object(K, A, Id, P), mark(K, Kind, P).
    mark_count(M, $MarkCells(), N) :- mark_cells.tally(M, N).

    // --- $MarkGroups ---
    // @claim count-marks
    .init groups = Components<KeyKind>
    groups.node([K, Kind], P) :- mark(K, Kind, P).

    // @claim count-marks
    .init group_count = Tally<Marked, Ident>
    group_count.domain([K, A, Id, Kind]) :- object(K, A, Id, _), mark_kind_choice(Kind).
    group_count.item([K, A, Id, Kind], G) :- object(K, A, Id, P), groups.label([K, Kind], P, G).
    mark_count(M, $MarkGroups(), N) :- group_count.tally(M, N).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// The objects a selection erases, and those it keeps.
.decl crowded(a: Adjacency, id: Ident, kind: MarkKind, u: MarkUnit, s: Selection)
.decl spared(a: Adjacency, id: Ident, kind: MarkKind, u: MarkUnit, s: Selection)

out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), params.background(Col).
out(P, Col, [A, Kind, U, S]) :-
    parse.object($U(), A, Id, P), crowded(A, Id, Kind, U, S), params.background(Col).
out(P, Col, [A, Kind, U, S]) :- parse.object($U(), A, Id, P), spared(A, Id, Kind, U, S), in(P, Col).

// --- $Threshold ---
crowded(A, Id, Kind, U, $Threshold()) :-
    parse.mark_count([$U(), A, Id, Kind], U, N), params.max_marks(Max), N > Max.
spared(A, Id, Kind, U, $Threshold()) :-
    parse.mark_count([$U(), A, Id, Kind], U, N), params.max_marks(Max), N <= Max.

// --- $CountTable ---
crowded(A, Id, Kind, U, $CountTable()) :-
    parse.mark_count([$U(), A, Id, Kind], U, N), params.drop_count(N).
spared(A, Id, Kind, U, $CountTable()) :-
    parse.mark_count([$U(), A, Id, Kind], U, N), params.keep_count(N).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The changed cells of each train object, including objects with none.
    .type ChangedObject = [e: Example, a: Adjacency, id: Ident]
    .init changes = Tally<ChangedObject, Position>
    changes.domain([E, A, Id]) :-
        parse.object(E, A, Id, _), ex_out(E, _, _).
    changes.item([E, A, Id], P) :-
        parse.object(E, A, Id, P), ex_in(E, P, Col), ex_out(E, P, Col2), Col != Col2.

    .decl keep_count(n: number)
    keep_count(N) :-
        parse.mark_count([E, A, Id, _], _, N),
        changes.tally([E, A, Id], 0).   // the output keeps the train object

    .decl drop_count(n: number)
    drop_count(N) :-
        parse.mark_count([E, A, Id, _], _, N),
        changes.tally([E, A, Id], C), C > 0.   // the output erases the train object
}
