// 87ab05b8
// @keywords: decompose markers lookup select
// input: noise cells sit on a bg ground; one cell carries params.marker
// output: the output erases everything and fills the 2×2 region holding
//  the marker

// locate the region
.type Locate =
    // grid divided into a params.divisor arrangement; the marker's tile
    Count {}
    // grid tiled by params.tile_dim blocks; the marker's block
  | Block {}
    // a params.block_dim block seated at the marker's nearest corner
  | Corner {}

// fill color
.type Fill =
    // the marker's own color propagates to the fill
    Marker {}
    // an independent params.fill
  | Fixed {}

// which region locates the marker, crossed with which color fills it — the
// 4×4 grids leave both underdetermined
.type Choice = [l: Locate, f: Fill]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl marker(c: Color) marker(2).
    .decl bg(c: Color) bg(6).

    // --- $Fixed ---
    .decl fill(c: Color) fill(2).

    // --- $Count ---
    .decl divisor(n: number) divisor(2).

    // --- $Block ---
    .decl tile_dim(k: number) tile_dim(2).

    // --- $Corner ---
    .decl block_dim(k: number) block_dim(2).
}

.init params = Params

// The marker cell.
.decl marker(p: Position)
marker(P) :- in(P, Col), params.marker(Col).

// --- Locate cases: the region to fill ---

.decl locate_choice(l: Locate)
locate_choice($Count()).
locate_choice($Block()).
locate_choice($Corner()).

.decl region(p: Position, l: Locate)

// $Count — the marker's tile in a params.divisor arrangement.
region(P, $Count()) :-
    marker(P_m), params.divisor(N), divide_2d(P_m, N, 0, P_tile, _),   // marker's tile
    in(P, _),                  divide_2d(P,   N, 0, P_tile, _).        // cell in the same tile

// $Block — the marker's block in a params.tile_dim tiling.
region(P, $Block()) :-
    marker(P_m), params.tile_dim(K), divide_by_size_2d(P_m, K, 0, P_tile, _),
    in(P, _),                   divide_by_size_2d(P,   K, 0, P_tile, _).

// $Corner — the params.block_dim block at the marker's nearest corner.
.init dp = DiagPlacement<Unit>
dp.cell($U(), P) :- marker(P).

region(P, $Corner()) :-
    in(P, _), dp.quadrant($U(), _, Diag),                 // marker's corner
    params.block_dim(N), diag_dist(P, Diag, _, K1, K2),   // within the block
    K1 < N, K2 < N.

// --- Fill cases: the region's color ---

.decl fill_choice(f: Fill)
fill_choice($Marker()).
fill_choice($Fixed()).

.decl fill_color(col: Color, f: Fill)
fill_color(Col, $Marker()) :- params.marker(Col).
fill_color(Col, $Fixed())  :- params.fill(Col).

// --- Output ---

out(P, Col, [L, F]) :- region(P, L), fill_color(Col, F).
out(P, Col, [L, F]) :-
    in(P, _), locate_choice(L), !region(P, L),    // cell outside the region
    fill_choice(F), params.bg(Col).
