// 4938f0c2
// draft
// keywords: markers objects d4 move
// input: a solid block of the marker color sits diagonally off a corner of an
//  ink shape
// output: the input, with the images of that shape under params.sym added,
//  taken about the block

// where an image lands; the pairs cannot separate the cases: in every pair the
// shape abuts the block, and each object fills the corner of its box that faces
// the block
.type Choice =
    // each ink cell's image about the block's center
    Mirror {}
    // each object replanted against the block corner its image faces,
    // anchored at the cell of its box facing the block
  | Seat {}
    // the same, anchored at the object's own cell at that corner
  | SeatCell {}

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl marker(col: Color) marker(3).
    .decl sym(s: Sym) sym(SYM_BOX).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Mirror()). impl_choice($Seat()). impl_choice($SeatCell()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col), !params.marker(Col).

.init block = Bbox<Unit>
block.cell($U(), P) :- in(P, Col), params.marker(Col).

.decl img(p: Position, col: Color, ch: Choice)

// --- Mirror ---

img(P_out, Col, $Mirror()) :-
    ink(P, Col), block.box($U(), B),                    // an ink cell and the block
    relative(B, P, V),                                  // its offset from the block
    params.sym(S), sym_member(S, D), apply(D, V, V2),   // the offset transformed
    compose(B, V2, P_out).

// --- Seat, SeatCell ---

.init obj = Components8<Unit>
obj.node($U(), P) :- ink(P, _).

.init obj_box = Bbox<Ident>
obj_box.cell(Id, P) :- obj.label($U(), P, Id).

// The block corner an object lies past.
.decl obj_quad(id: Ident, diag: DiagDir)
obj_quad(Id, Diag) :-
    diag_dirs(Diag, _, D1, D2), obj_box.box(Id, B_obj), block.box($U(), B_block),
    nearer(D1, B_obj, B_block), nearer(D2, B_obj, B_block).

// The cell an object's image is taken from.
.decl anchor(id: Ident, p: Position, ch: Choice)

img(P_out, Col, Ch) :-
    ink(P, Col), obj.label($U(), P, Id),                        // an object's cell
    anchor(Id, P0, Ch), relative(P0, P, V),                     // its offset from the anchor
    params.sym(S), sym_member(S, D), apply(D, V, V2),           // the offset transformed
    obj_quad(Id, Q), apply_diag_dir(D, Q, Q2),                  // the corner its image faces
    block.cell($U(), P_c), block.box($U(), B_block),
    box_corner(P_c, B_block, Q2), neighbor(P_c, Q2, P_seat),    // the seat one step out of it
    compose(P_seat, V2, P_out).

// --- Seat ---

anchor(Id, P0, $Seat()) :-
    obj_quad(Id, Q), diag_opposite(Q, Q_face),                          // the corner facing the block
    obj_box.box(Id, B_obj), in(P0, _), box_corner(P0, B_obj, Q_face).   // the box cell there

// --- SeatCell ---

anchor(Id, P0, $SeatCell()) :-
    obj_quad(Id, Q), diag_opposite(Q, Q_face),                    // the corner facing the block
    obj.label($U(), P0, Id), obj_box.box(Id, B_obj),              // a cell of that object
    box_corner(P0, B_obj, Q_face).                                // at that corner of its box

// --- output ---

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :-
    in(P, C0), impl_choice(Ch),
    ( img(P, Col, Ch)              // an image lands here
    ; !img(P, _, Ch), Col = C0     // nothing lands — the input cell
    ).

.comp Determine {
    .decl ink(e: Example, p: Position, col: Color)
    ink(E, P, Col) :- ex_in(E, P, Col), !params.bg(Col), !params.marker(Col).

    .decl out_ink(e: Example, p: Position, col: Color)
    out_ink(E, P, Col) :- ex_out(E, P, Col), !params.bg(Col), !params.marker(Col).

    .init block = Bbox<Example>
    block.cell(E, P) :- ex_in(E, P, Col), params.marker(Col).

    // Where a transform about the block carries an ink cell, inside the grid.
    .decl img(e: Example, d: D4, p: Position, col: Color)
    img(E, D, P_out, Col) :-
        ink(E, P, Col), block.box(E, B),   // an ink cell and its block
        relative(B, P, V),                 // its offset from the block
        d4_elem(D), apply(D, V, V2),
        compose(B, V2, P_out), ex_in(E, P_out, _).

    .type ExCell = [e: Example, p: Position, col: Color]
    .init orbit = KeyedSetCompare<Sym, number, ExCell>
    orbit.pattern_member(0, [E, P, Col]) :- out_ink(E, P, Col).
    orbit.observed_member(S, [E, P, Col]) :-
        sym_member(S, D), img(E, D, P, Col),   // the cells the group's transforms reach
        ex_out(E, _, _).                       // in the examples with outputs

    // The group whose orbit is exactly the output's ink.
    .decl sym(s: Sym)
    sym(S) :- orbit.equals(S, 0).
}
