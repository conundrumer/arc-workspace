// b60334d2
// concept: markers lookup stamp
// Marker cells on an empty grid; each grows a 3×3 ring — corner cells
// one color, side cells another — and erases to bg. Cases
// (data-equivalent on this task):
//
//   $Stamp — a stored template, seated on the marker by its seat cell.
//   $Halo  — per-role: side neighbors paint params.side_col; corner neighbors
//            paint params.corner_col ($Fixed) or the marker's own color ($Prop).

#include "../lib.dl"

.type Corner = Fixed {} | Prop {}
.type Choice = Stamp {} | Halo {corner: Corner}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(5).

    // --- Halo ---
    .decl side_col(c: Color) side_col(1).
    .decl corner_col(c: Color) corner_col(5).

    // --- Stamp ---
    .decl template(p: Position, col: Color)
    GRID_SPARSE_3x3(template,
        5, 1, 5,
        1, 0, 1,
        5, 1, 5)
    .decl seat(p: Position) seat([1, 1, 1, 1]).
}

.init params = Params

.decl marker_at(p: Position, col: Color)
marker_at(P, Col) :- in(P, Col), params.marker(Col).

.decl halo(p: Position, col: Color, ch: Choice)

// --- Halo ---
.decl impl_corner(cr: Corner)
impl_corner($Fixed()). impl_corner($Prop()).

// Side neighbors, shared by both corner cases.
halo(P, Col, $Halo(Cr)) :-
    impl_corner(Cr),
    marker_at(Q, _), params.side_col(Col),           // marker, side color
    dir_elem(D), neighbor(Q, D, P), in(P, _).        // a side neighbor, on-grid

halo(P, Col, $Halo($Fixed())) :-
    marker_at(Q, _), params.corner_col(Col),         // marker, corner color
    diag_dir_elem(Dg), neighbor(Q, Dg, P), in(P, _). // a corner neighbor, on-grid

halo(P, Col, $Halo($Prop())) :-
    marker_at(Q, Col),                               // marker supplies the color
    diag_dir_elem(Dg), neighbor(Q, Dg, P), in(P, _). // a corner neighbor, on-grid

// --- Stamp ---
halo(P, Col, $Stamp()) :-
    marker_at(Q, _), params.template(Pt, Col),       // a marker, a template cell
    params.seat(Ps), displacement(Ps, Pt, Off),      // the cell's offset from the seat
    compose(Q, Off, P), in(P, _).                    // seated on the marker, on-grid

.decl impl_choice(ch: Choice)
impl_choice($Stamp()).
impl_choice($Halo(Cr)) :- impl_corner(Cr).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- halo(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !halo(P, _, Ch), params.bg(Col).

// --- determination ---

.comp Determine {
    .decl marker_at(e: Example, p: Position)
    marker_at(E, P) :- ex_in(E, P, Col), params.marker(Col).

    // What the stamp writes: every output ink cell.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- ex_out(E, P, Col), !params.bg(Col).

    // A painted cell belongs to the marker in its blob; markers join as
    // nodes because the erased center leaves the ring markerless.
    .init blob = Components<Example>
    blob.node(E, P) :- painted(E, P, _).
    blob.node(E, P) :- marker_at(E, P).

    .decl template(p: Position, col: Color)
    template(Pt, Col) :-
        painted(E, P, Col),                                           // a painted cell
        blob.label(E, P, Id), blob.label(E, M, Id), marker_at(E, M),  // the marker of its blob
        displacement(M, P, Off),                                      // the cell's offset from it
        params.seat(Ps), compose(Ps, Off, Pt).                        // seated in the template frame
}
