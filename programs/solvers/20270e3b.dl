// 20270e3b
// keywords: objects markers move
// input: Two pieces sit on a bg field. Each is a wall of ordinary colors plus
//  a socket of marker cells, and the two socket footprints are congruent.
// output: The join seats one piece on the other with the footprints
//  registered one cardinal step apart; a seating counts only when every
//  socket falls under the mate's wall. The output is the joined walls
//  cropped to their bounding box, bg elsewhere.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(1).

    .decl socket_color(col: Color) socket_color(7).
}

.init params = Params

// --- the two pieces ---

.init pieces = Components8<Unit>
pieces.node($U(), P) :- in(P, Col), !params.bg(Col).

.decl piece(id: Ident, p: Position)
piece(Id, P) :- pieces.label($U(), P, Id).

.decl wall(id: Ident, p: Position, col: Color)
wall(Id, P, Col) :- piece(Id, P), in(P, Col), !params.socket_color(Col).

.decl socket(id: Ident, p: Position)
socket(Id, P) :- piece(Id, P), in(P, Col), params.socket_color(Col).

// --- seating one piece against the other ---

.init socket_box = Bbox<Ident>
socket_box.cell(Id, P) :- socket(Id, P).

// Piece m seated on piece h: m's cell p lands at p_seat. The join is
// symmetric: seating either piece on the other gives the same figure up to a
// translation, which the crop removes, so both seatings paint one output.
.decl seat(h: Ident, m: Ident, d: Dir, p: Position, p_seat: Position)
seat(H, M, D, P, P_seat) :-
    piece(M, P), socket_box.box(M, B_m), relative(B_m, P, P_rel),  // a cell of the seated piece, in its footprint's frame
    socket_box.box(H, B_h), H != M, compose(B_h, P_rel, P_reg),    // laid on the host's footprint
    dir_elem(D), neighbor(P_reg, D, P_seat).                       // and carried one step off it

// Both pieces' cells in the host's frame, under the seating (h, m, d).
.decl laid_wall(h: Ident, m: Ident, d: Dir, p: Position, col: Color)
laid_wall(H, M, D, P, Col) :- seat(H, M, D, _, _), wall(H, P, Col).
laid_wall(H, M, D, P_seat, Col) :- seat(H, M, D, P, P_seat), wall(M, P, Col).

.decl laid_socket(h: Ident, m: Ident, d: Dir, p: Position)
laid_socket(H, M, D, P) :- seat(H, M, D, _, _), socket(H, P).
laid_socket(H, M, D, P_seat) :- seat(H, M, D, P, P_seat), socket(M, P).

// A socket no wall fills — the defect that rules the seating out. A piece's
// own wall never reaches its sockets, so the filling wall is the mate's.
.decl open(h: Ident, m: Ident, d: Dir)
open(H, M, D) :- laid_socket(H, M, D, P), !laid_wall(H, M, D, P, _).

// --- the joined figure ---

// The walls of a seating that leaves no socket open.
.decl figure(h: Ident, m: Ident, p: Position, col: Color)
figure(H, M, P, Col) :- laid_wall(H, M, D, P, Col), !open(H, M, D).

.type Join = [h: Ident, m: Ident]
.init figure_box = Bbox<Join>
figure_box.cell([H, M], P) :- figure(H, M, P, _).

.decl painted(p: Position, col: Color)
painted(P_inner, Col) :-
    figure(H, M, P, Col), figure_box.box([H, M], B), crop(P, B, P_inner).

.init sheet = Frame2D<Unit>
sheet.extent($U(), A, N) :-
    figure_box.box(J, B), figure_box.cell(J, P),   // the figure's box, and a cell of the grid frame
    axis_elem(A), box_extent(B, P, A, N).          // the box's extent on each axis

out(P, Col) :-
    sheet.cell($U(), P),
    ( painted(P, Col)                 // a wall cell
    ; !painted(P, _), params.bg(Col)  // bg elsewhere
    ).
