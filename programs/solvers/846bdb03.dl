// 846bdb03
// @draft
// @keywords: crop markers d4
// input: Four corner marks and two bars between them frame an empty box; a
//  two-color shape floats elsewhere.
// output: The output is the box, with the shape filling its interior,
//  oriented so that each color of the shape touches the bar of that color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl corner(col: Color) corner(4).
    // The orientations the shape may take: the reflection group that swaps
    // the bars.
    .decl sym(s: Sym) sym(SYM_LR).
}

.init params = Params

.decl transform(t: D4)
transform(T) :- params.sym(S), sym_member(S, T).

// --- the box ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.corner(Col).

// A cell the box covers.
.decl boxed(p: Position)
boxed(P) :- in(P, _), bbox.box($U(), B), inside(P, B).

.decl cropped(p: Position, col: Color)
cropped(P_inner, Col) :- in(P, Col), bbox.box($U(), B), crop(P, B, P_inner).

// A colored line on the box's border.
.decl bar(d: Dir, col: Color)
bar(D, Col) :- cropped(P, Col), dir_elem(D), dist(P, D, 0), !params.bg(Col), !params.corner(Col).

// The box off its border, in its own frame.
.init core = Bbox<Unit>
core.cell($U(), P) :- cropped(P, _), interior(P, ZERO).

// --- the shape ---

.init shape = Bbox<Unit>
shape.cell($U(), P) :- in(P, Col), !params.bg(Col), !boxed(P).

// The shape under each transform, in the interior frame.
.decl placed(t: D4, p_inner: Position, col: Color)
placed(T, P_inner2, Col) :-
    in(P, Col), shape.box($U(), B), crop(P, B, P_inner),
    transform(T), apply(T, P_inner, P_inner2).

// Under T, some cell of the bar's color meets the bar.
.decl touches(t: D4, d: Dir, col: Color)
touches(T, D, Col) :- bar(D, Col), placed(T, P, Col), dist(P, D, 0).

// Under T, some bar meets no cell of its color.
.decl defect(t: D4)
defect(T) :- transform(T), bar(D, Col), !touches(T, D, Col).

// --- output ---

out(P, Col) :- cropped(P, Col), !core.cell($U(), P).
out(P, Col) :-
    core.cell($U(), P), core.box($U(), B), crop(P, B, P_inner),
    placed(T, P_inner, Col), !defect(T).    // under the orientation every bar accepts
