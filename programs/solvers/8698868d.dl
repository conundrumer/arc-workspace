// 8698868d
// @draft
// @keywords: objects count rank crop enclose
// input: One-color squares sit on a background, in two sizes. The large
//  squares tile a region and are the blocks; the small squares are the
//  pieces. Each square encloses background regions: a block's dots, a
//  piece's holes.
// output: The output is the region the blocks tile, each block's interior
//  replaced by its piece, with the holes filled in the block's color.

// which piece fills each block — data-equivalent on this task, since the
// blocks' and pieces' region counts are the same set
.type Choice =
    // the piece that encloses the same number of regions
    Count {}
    // the piece at the same region-count rank as its block, ranks read from
    // either end so the two agree
  | Rank {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Count()). impl_choice($Rank()).

// --- squares ---

.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl bg(col: Color)
bg(Col) :- bg_mode.mode($U(), Col).

// Touching cells of one non-bg color.
.init squares = Components<Color>
squares.node(Col, P) :- in(P, Col), !bg(Col).

.decl square(id: Ident, col: Color)
square(Id, Col) :- squares.label(Col, _, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- squares.label(_, P, Id).

// A grid cell a square's box covers.
.decl covered(id: Ident, p: Position)
covered(Id, P) :- bbox.box(Id, B), in(P, _), inside(P, B).

// Each square's side.
.decl side(id: Ident, n: number)
side(Id, N) :- bbox.box(Id, B), in(P, _), box_extent(B, P, _, N).

// The largest squares are the blocks; the rest are the pieces.
.init size = Extremes<Unit>
size.cand($U(), N) :- side(_, N).

.decl block(id: Ident)
block(Id) :- side(Id, N), size.high($U(), N).

.decl piece(id: Ident)
piece(Id) :- square(Id, _), !block(Id).

// --- pairing ---

// The background regions a square encloses: a block's dots, a piece's holes.
.init enclosed = Components<Ident>
enclosed.node(Id, P) :- covered(Id, P), in(P, Col), bg(Col).

.init region_count = Tally<Ident, Ident>
region_count.item(Id, R) :- enclosed.label(Id, _, R).
region_count.domain(Id) :- square(Id, _).

// The piece that goes into a block.
.decl pair(id_block: Ident, id_piece: Ident, ch: Choice)

// --- $Count ---
pair(Id_b, Id_p, $Count()) :-
    block(Id_b), piece(Id_p),
    region_count.tally(Id_b, N), region_count.tally(Id_p, N).

// --- $Rank ---
.decl fewer(id: Ident, id2: Ident)
fewer(Id, Id2) :- region_count.tally(Id, N), region_count.tally(Id2, N2), N < N2.

.init block_rank = Order<Unit, Ident>
block_rank.elem($U(), Id) :- block(Id).
block_rank.before($U(), Id, Id2) :- fewer(Id, Id2).

.init piece_rank = Order<Unit, Ident>
piece_rank.elem($U(), Id) :- piece(Id).
piece_rank.before($U(), Id, Id2) :- fewer(Id, Id2).

pair(Id_b, Id_p, $Rank()) :-
    ( block_rank.rank($U(), Id_b, R), piece_rank.rank($U(), Id_p, R)             // from the fewest
    ; block_rank.rank_desc($U(), Id_b, R), piece_rank.rank_desc($U(), Id_p, R)   // from the most
    ).

// --- render ---

// A block's interior, in its own frame: the piece's frame.
.init core = Bbox<Ident>
core.cell(Id, P) :- block(Id), bbox.box(Id, B), in(P, _), interior(P, B).

// The output frame is the region the blocks tile.
.init layout = Bbox<Unit>
layout.cell($U(), P) :- block(Id), covered(Id, P).

out(P_grid_out, Col, Ch) :-
    impl_choice(Ch),
    layout.cell($U(), P_grid_in), layout.box($U(), B_l),
    crop(P_grid_in, B_l, P_grid_out),                       // an output cell and its input cell
    block(Id_b), covered(Id_b, P_grid_in),                  // the block there
    ( !core.cell(Id_b, P_grid_in), square(Id_b, Col)        // on the block's ring: its color
    ; core.cell(Id_b, P_grid_in), core.box(Id_b, B_c),      // inside: the piece's cell there
      crop(P_grid_in, B_c, P_inner),
      pair(Id_b, Id_p, Ch), in(Q, C_q), bbox.box(Id_p, B_p), crop(Q, B_p, P_inner),
      ( !bg(C_q), Col = C_q                                 // the piece's ink
      ; bg(C_q), square(Id_b, Col)                          // a hole: the block's color
      )
    ).
