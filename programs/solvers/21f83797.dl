// 21f83797
// @draft
// @keywords: markers cast span
// input: Marks sit on a blank canvas.
// output: Each mark's row and column are drawn across the whole grid, and
//  the box the marks span is filled with params.fill inside those lines.

// what color the drawn lines take
.type Choice =
    // an independent params.line
    Ink {}
    // the casting mark's own color
  | Mark {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl fill(col: Color) fill(1).

    // --- Ink ---
    .decl line(col: Color) line(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Ink()). impl_choice($Mark()).

.decl mark(p: Position)
mark(P) :- in(P, Col), !params.bg(Col).

// P is on a line cast by the mark at M.
.decl on_line(p: Position, m: Position)
on_line(P, M) :- in(P, _), mark(M), axis_elem(A), same_line(A, P, M).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- mark(P).

// A grid cell the marks' box covers.
.decl spanned(p: Position)
spanned(P) :- in(P, _), bbox.box($U(), B), inside(P, B).

out(P, Col, Ch) :-
    impl_choice(Ch), in(P, _), !on_line(P, _),
    ( spanned(P), params.fill(Col)
    ; !spanned(P), params.bg(Col) ).

// --- Ink ---
out(P, Col, $Ink()) :- on_line(P, _), params.line(Col).

// --- Mark ---
out(P, Col, $Mark()) :- on_line(P, M), in(M, Col).
