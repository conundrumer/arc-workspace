// 2bee17df
// @draft
// @keywords: lines span rank enclose
// input: an open region of params.open, walled off by other colors
// output: Rows and columns of that region are painted params.fill when
//  they qualify.

// what makes a line qualify
.type Choice =
    // every cell of the line inside the region's bounding box is open
    Clear {}
    // the line carries the most open cells of its axis
  | Widest {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl open(col: Color) open(0).
    .decl fill(col: Color) fill(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Clear()). impl_choice($Widest()).

.decl open_cell(p: Position)
open_cell(P) :- in(P, Col), params.open(Col).

// p's line on axis a, labeled by p's component along a.
.decl line_of(p: Position, a: Axis, l: Position)
line_of(P, A, L) :- in(P, _), axis_elem(A), split(P, A, L, _).

.decl painted(p: Position, ch: Choice)

// --- Clear ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- open_cell(P).

// A cell the region's box covers, with one of its lines.
.decl boxed_line(p: Position, l: Position)
boxed_line(P, L) :- bbox.box($U(), B), inside(P, B), line_of(P, _, L).

// A line carrying a wall cell inside the box.
.decl blocked(l: Position)
blocked(L) :- boxed_line(P, L), !open_cell(P).

painted(P, $Clear()) :- boxed_line(P, L), !blocked(L).

// --- Widest ---

.init widest = Mode<Axis, Position, Position>
widest.item(A, L, P) :- open_cell(P), line_of(P, A, L).

painted(P, $Widest()) :- open_cell(P), line_of(P, A, L), widest.mode(A, L).

out(P, Col_out, Ch) :-
    in(P, Col), impl_choice(Ch),               // grid cell, per case
    ( painted(P, Ch), params.fill(Col_out)     // on a qualifying line
    ; !painted(P, Ch), Col_out = Col           // elsewhere — passes
    ).
