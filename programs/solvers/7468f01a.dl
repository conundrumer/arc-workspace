// 7468f01a
// keywords: crop d4
// input: A rectangle on bg, carrying a second color.
// output: The output is the rectangle cut out, with params.transform
//  applied.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl transform(d: D4) transform(D4_LR).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P, _).

out(P_out, Col) :-
    ink(P, Col), bbox.box($U(), B), crop(P, B, P_inner),    // cell in the box frame
    params.transform(D), apply(D, P_inner, P_out).
