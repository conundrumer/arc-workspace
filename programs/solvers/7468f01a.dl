// 7468f01a
// concept: crop d4
// A rectangle on bg, carrying a second color. Output is the rectangle
// cut out, with c.transform applied.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl transform(d: D4) transform(D4_LR).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.init box = Bbox<Unit>
box.cell($U(), P) :- ink(P, _).

// Each ink cell viewed from the ink's box, keyed by the cell.
.init boxframe = Reframe<Position>
boxframe.outer(P, M) :- ink(P, _), box.margin($U(), M).
boxframe.cell(P, P)  :- ink(P, _).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    ink(P, Col), boxframe.inner(P, I),        // cell in the box frame
    c.transform(D), apply(D, I, P_out).

.output out(IO=stdout)
