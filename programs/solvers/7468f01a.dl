// 7468f01a
// concept: crop d4
// A rectangle on bg, carrying a second color. Output is the rectangle
// cut out, with params.transform applied.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl transform(d: D4) transform(D4_LR).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init boxframe = BoxFrame<Unit>
boxframe.cell($U(), P) :- ink(P, _).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    ink(P, Col), boxframe.inner($U(), P, I),    // cell in the box frame
    params.transform(D), apply(D, I, P_out).
