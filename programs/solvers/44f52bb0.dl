// 44f52bb0
// concept: symmetry lookup classify
// Classify input by D4-symmetry; emit a fixed output per class.
//
// Two impls; out's choice column tags each:
//
//   $Direct     — emit c.sym_out if input is invariant under every D in c.syms;
//                 c.asym_out otherwise.
//   $GroupMatch — c.mapping_sym lists candidate sym groups; pick the largest
//                 group that leaves the input invariant; emit that entry's
//                 c.mapping_out.

#include "../lib.dl"

.type Choice = Direct {} | GroupMatch {}

.comp Consts {
    // --- $Direct ---
    // The non-identity members of the symmetry class's group; each alone
    // splits the classes, and the group closes over any two.
    .decl syms(d: D4)
    syms(D4_LR).
    syms(D4_TB).
    syms(D4_HT).

    .decl sym_out(p: Position, col: Color)
    GRID_1x1(sym_out, 1)

    .decl asym_out(p: Position, col: Color)
    GRID_1x1(asym_out, 7)

    // --- $GroupMatch ---
    // Each entry holds a sym group and an output grid. Entries are matched
    // against the input's invariance set; the largest matched group is chosen.
    // Every entry lists D4_ID; the {D4_ID}-only entry is the
    // always-matches fallback (size 1 → lowest priority).
    .decl mapping_sym(id: Ident, d: D4)
    mapping_sym(0, D4_ID).
    mapping_sym(0, D4_LR).
    mapping_sym(0, D4_TB).
    mapping_sym(0, D4_HT).
    mapping_sym(1, D4_ID).

    .decl mapping_out(id: Ident, p: Position, col: Color)
    mapping_out(0, ORIGIN, 1).
    mapping_out(1, ORIGIN, 7).
}

.init c = Consts

.init d4 = D4Invariance<Unit, Color>
d4.cell($U(), P, Col) :- in(P, Col).

.init group_match = KeyedSetCompare<Unit, Ident, D4>
group_match.pattern_member(Id, D) :- c.mapping_sym(Id, D).
group_match.observed_member($U(), D) :- d4.inv($U(), D).

// --- $Direct ---

.decl syms_non_invariant(d: D4)
syms_non_invariant(D) :- d4.broken($U(), D), c.syms(D).

// --- $GroupMatch ---

// Pick the largest group the input covers (strictest invariance). The input
// may be invariant under more than a group requires, so this is containment,
// not equality. Assumes group sizes are unique; a tie would emit conflicting cells.
.decl best_id(id: Ident)
best_id(Id) :-
    group_match.covers($U(), Id),                                  // group ⊆ invariance set
    group_match.pattern_size(Id, N),                               // group size
    N = max N2 : { group_match.covers($U(), I2), group_match.pattern_size(I2, N2) }.

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)

// $Direct
out(P, Col, $Direct()) :- c.sym_out(P, Col),  !syms_non_invariant(_).
out(P, Col, $Direct()) :- c.asym_out(P, Col),  syms_non_invariant(_).

// $GroupMatch
out(P, Col, $GroupMatch()) :- best_id(Id), c.mapping_out(Id, P, Col).

// --- fit ---

.comp Fit {
    .init d4 = D4Invariance<Example, Color>
    d4.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl paired(e: Example)
    paired(E) :- ex_out(E, _, _).

    // Two train pairs whose outputs disagree. An output is total over its
    // frame and a Position carries its frame, so one direction settles it.
    .decl differs(e1: Example, e2: Example)
    differs(E1, E2) :- ex_out(E1, P, Col), ex_out(E2, _, _), !ex_out(E2, P, Col).

    // A transform that puts two disagreeing pairs on the same side of its
    // invariance test, so that test does not carry the classification.
    .decl split_broken(d: D4)
    split_broken(D) :- d4.inv(E1, D), d4.inv(E2, D), differs(E1, E2).
    split_broken(D) :- d4.broken(E1, D), d4.broken(E2, D), differs(E1, E2).

    .decl syms(d: D4)
    syms(D) :- d4_elem(D), !split_broken(D).

    .decl sym_broken(e: Example)
    sym_broken(E) :- syms(D), d4.broken(E, D).

    .decl sym_out(p: Position, col: Color)
    sym_out(P, Col) :- ex_out(E, P, Col), !sym_broken(E).

    .decl asym_out(p: Position, col: Color)
    asym_out(P, Col) :- ex_out(E, P, Col), sym_broken(E).

    // Train pairs that answer alike.
    .decl same_out(e1: Example, e2: Example)
    same_out(E1, E2) :- paired(E1), paired(E2), !differs(E1, E2).

    // One table entry per class of alike pairs, labelled by its lowest
    // member; the label carries identity only.
    .decl class(e: Example, id: Ident)
    class(E, as(Min, Ident)) :- paired(E), Min = min E2 : { same_out(E, E2) }.

    // A transform some member of the class breaks.
    .decl group_broken(id: Ident, d: D4)
    group_broken(Id, D) :- class(E, Id), d4.broken(E, D).

    // The class's group: the transforms every member of it is invariant under.
    .decl mapping_sym(id: Ident, d: D4)
    mapping_sym(Id, D) :- class(_, Id), d4_elem(D), !group_broken(Id, D).

    .decl mapping_out(id: Ident, p: Position, col: Color)
    mapping_out(Id, P, Col) :- class(E, Id), ex_out(E, P, Col).
}
