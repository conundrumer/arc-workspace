// 44f52bb0
// Classify input by D4-symmetry; emit a fixed output per class.
//
// Two impls; out's choice column tags each:
//
//   $Direct     — emit c.sym_out if input is invariant under every D in c.syms;
//                 c.asym_out otherwise.
//   $GroupMatch — c.mapping_sym lists candidate sym groups; pick the largest
//                 group that leaves the input invariant; emit that entry's
//                 c.mapping_out.

#include "../lib.dl"

.type Choice = Direct {} | GroupMatch {}

.comp Consts {
    // --- $Direct ---
    .decl syms(d: D4)
    syms(FLIP_LR).
    syms(FLIP_TB).

    .decl sym_out(p: Position, col: Color)
    GRID_1x1(sym_out, 1)

    .decl asym_out(p: Position, col: Color)
    GRID_1x1(asym_out, 7)

    // --- $GroupMatch ---
    // Each entry holds a sym group and an output grid. Entries are matched
    // against the input's invariance set; the largest matched group wins.
    // Every entry lists IDENTITY; the {IDENTITY}-only entry is the
    // always-matches fallback (size 1 → lowest priority).
    .decl mapping_id(id: number)
    mapping_id(0).
    mapping_id(1).

    .decl mapping_sym(id: number, d: D4)
    mapping_sym(0, IDENTITY).
    mapping_sym(0, FLIP_LR).
    mapping_sym(0, FLIP_TB).
    mapping_sym(0, ROT_180).
    mapping_sym(1, IDENTITY).

    .decl mapping_out(id: number, p: Position, col: Color)
    mapping_out(0, ORIGIN, 1).
    mapping_out(1, ORIGIN, 7).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// D maps some input cell to a position whose color differs.
.decl non_invariant(d: D4)
non_invariant(D) :-
    d4_elem(D),
    in(P, Col), apply(D, P, P_image),
    !in(P_image, Col).

// --- $Direct ---

.decl syms_non_invariant(d: D4)
syms_non_invariant(D) :- non_invariant(D), c.syms(D).

// --- $GroupMatch ---

// D under which the input is invariant.
.decl input_inv(d: D4)
input_inv(D) :- d4_elem(D), !non_invariant(D).

// Matched entries paired with their group size — set-keyed count trick:
// present iff every member of the entry's group is in input's invariance set.
.decl matched_size(id: number, n: number)
matched_size(Id, N) :-
    c.mapping_id(Id),
    N = count : { c.mapping_sym(Id, _) },                       // group size
    N = count : { c.mapping_sym(Id, D), input_inv(D) }.         // matched members

// Pick the matched entry with the largest group (strictest invariance).
// Assumes entry sizes are unique; a tie would emit conflicting cells.
.decl best_id(id: number)
best_id(Id) :-
    matched_size(Id, N),
    N = max N2 : { matched_size(_, N2) }.

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)

// $Direct
out(P, Col, $Direct()) :- c.sym_out(P, Col),  !syms_non_invariant(_).
out(P, Col, $Direct()) :- c.asym_out(P, Col),  syms_non_invariant(_).

// $GroupMatch
out(P, Col, $GroupMatch()) :- best_id(Id), c.mapping_out(Id, P, Col).

.output out(IO=stdout)
