// 44f52bb0
// concept: symmetry lookup classify
// Classify input by D4-symmetry; emit a fixed output per class.
//
// Two impls; out's choice column tags each:
//
//   $Direct     — emit params.sym_out if input is invariant under params.sym_group;
//                 params.asym_out otherwise.
//   $GroupMatch — params.mapping_sym lists candidate sym groups; pick the largest
//                 group that leaves the input invariant; emit that entry's
//                 params.mapping_out.

#include "../lib.dl"

.type Choice = Direct {} | GroupMatch {}

.comp Params {
    // --- $Direct ---
    // The group whose invariance defines the symmetric class.
    .decl sym_group(s: Sym) sym_group(SYM_BOX).

    .decl sym_out(p: Position, col: Color)
    GRID_1x1(sym_out, 1)

    .decl asym_out(p: Position, col: Color)
    GRID_1x1(asym_out, 7)

    // --- $GroupMatch ---
    // Each entry holds a sym group and an output grid. Entries are matched
    // against the input's invariance set; the largest matched group is
    // chosen. The trivial-group entry is the always-matches fallback
    // (size 1 → lowest priority).
    .decl mapping_sym(id: Ident, s: Sym)
    mapping_sym(0, SYM_BOX).
    mapping_sym(1, SYM_1).

    .decl mapping_out(id: Ident, p: Position, col: Color)
    mapping_out(0, ORIGIN, 1).
    mapping_out(1, ORIGIN, 7).
}

.init params = Params

.init d4 = D4Map<Unit, Color>
d4.src($U(), P, Col) :- in(P, Col).
d4.dst($U(), P, Col) :- in(P, Col).

// --- $Direct ---

.decl syms_non_invariant(d: D4)
syms_non_invariant(D) :- d4.mismatch($U(), D), params.sym_group(S), sym_member(S, D).

// --- $GroupMatch ---

// Pick the largest group the input is invariant under: invariance beyond what
// a group requires still matches it, so the test is covers, not equals.
// Assumes group sizes are unique; a tie would emit conflicting cells.
.init group = KeyedSetCompare<Unit, Ident, D4>
group.pattern_member(Id, D) :- params.mapping_sym(Id, S), sym_member(S, D).
group.observed_member($U(), D) :- d4_elem(D), !d4.mismatch($U(), D).

.init best_id = ArgExtremes<Unit, Ident>
best_id.cand($U(), Id, N) :- group.covers($U(), Id), group.pattern_size(Id, N).

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)

// $Direct
out(P, Col, $Direct()) :- params.sym_out(P, Col),  !syms_non_invariant(_).
out(P, Col, $Direct()) :- params.asym_out(P, Col),  syms_non_invariant(_).

// $GroupMatch
out(P, Col, $GroupMatch()) :- best_id.high($U(), Id, _), params.mapping_out(Id, P, Col).

.comp Determine {
    .init d4 = D4Map<Example, Color>
    d4.src(E, P, Col) :- ex_in(E, P, Col).
    d4.dst(E, P, Col) :- ex_in(E, P, Col).

    .decl paired(e: Example)
    paired(E) :- ex_out(E, _, _).

    // Train pairs that answer alike.
    .type PV = [p: Position, col: Color]
    .init out_cmp = KeyedSetCompare<Example, Example, PV>
    out_cmp.pattern_member(E, [P, Col]) :- ex_out(E, P, Col).
    out_cmp.observed_member(E, M) :- out_cmp.pattern_member(E, M).

    // Two train pairs whose outputs disagree.
    .decl differs(e1: Example, e2: Example)
    differs(E1, E2) :- paired(E1), paired(E2), !out_cmp.equals(E1, E2).

    // A transform that puts two disagreeing pairs on the same side of its
    // invariance test, so that test does not carry the classification.
    .decl split_broken(d: D4)
    split_broken(D) :- d4.map(E1, D), d4.map(E2, D), differs(E1, E2).
    split_broken(D) :- d4.mismatch(E1, D), d4.mismatch(E2, D), differs(E1, E2).

    // An example broken under a transform whose invariance test carries
    // the classification.
    .decl sym_broken(e: Example)
    sym_broken(E) :- d4_elem(D), !split_broken(D), d4.mismatch(E, D).

    .decl sym_out(p: Position, col: Color)
    sym_out(P, Col) :- ex_out(E, P, Col), !sym_broken(E).

    .decl asym_out(p: Position, col: Color)
    asym_out(P, Col) :- ex_out(E, P, Col), sym_broken(E).

    // The symmetric class's invariance set, named as a subgroup.
    .decl inv_broken(d: D4)
    inv_broken(D) :- paired(E), !sym_broken(E), d4.mismatch(E, D).

    .init named = KeyedSetCompare<Unit, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member($U(), D) :- d4_elem(D), !inv_broken(D).

    .decl sym_group(s: Sym)
    sym_group(S) :- named.equals($U(), S).

    // One table entry per class of alike pairs; the label carries identity
    // only.
    .init class = Canon<Example>
    class.equiv(E, E2) :- out_cmp.equals(E, E2).

    // A transform some member of the class breaks.
    .decl group_broken(id: Ident, d: D4)
    group_broken(Id, D) :- class.id(E, Id), d4.mismatch(E, D).

    // The class's group: the transforms every member of it is invariant
    // under, named as a subgroup.
    .init named_class = KeyedSetCompare<Ident, Sym, D4>
    named_class.pattern_member(S, D) :- sym_member(S, D).
    named_class.observed_member(Id, D) :- class.id(_, Id), d4_elem(D), !group_broken(Id, D).

    .decl mapping_sym(id: Ident, s: Sym)
    mapping_sym(Id, S) :- named_class.equals(Id, S).

    .decl mapping_out(id: Ident, p: Position, col: Color)
    mapping_out(Id, P, Col) :- class.id(E, Id), ex_out(E, P, Col).
}
