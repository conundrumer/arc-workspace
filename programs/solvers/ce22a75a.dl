// ce22a75a
// keywords: scale decompose markers stamp
// input: marks on a 9×9 grid
// output: Each mark fills its 3×3 region; the rest is bg.

// the grid is 9×9, so its arrangement reads two ways
.type DecChoice =
    // params.tile_count tiles per axis
    Count {}
    // tiles of params.tile_dim, as many as the grid holds
  | Size {}

// every mark sits at the center of its arrangement tile, so three locate
// priors coincide on the data
.type Choice =
    // the arrangement tile containing a mark fills
    Tile {d: DecChoice}
    // a tile fills iff a mark sits at its center: the input read as a
    // stride-3 subsample, upscaled
  | Center {d: DecChoice}
    // each mark grows one step in all eight directions
  | Grow {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(1).

    // --- Tile(Count), Center(Count) ---
    .decl tile_count(n: number) tile_count(3).

    // --- Tile(Size), Center(Size) ---
    .decl tile_dim(k: number) tile_dim(3).
}

.init params = Params

.decl mark(p: Position)
mark(P) :- in(P, Col), !params.bg(Col).

// --- Tile, Center ---

.decl decomp(dc: DecChoice, p: Position, p_tile: Position, p_intile: Position)
decomp($Count(), P_grid, P_tile, P_intile) :-
    in(P_grid, _), params.tile_count(N),            // input position, tile count
    divide_2d(P_grid, N, 0, P_tile, P_intile).      // square arrangement
decomp($Size(), P_grid, P_tile, P_intile) :-
    in(P_grid, _), params.tile_dim(K),              // input position, tile size
    divide_by_size_2d(P_grid, K, 0, P_tile, P_intile).

// --- Tile ---

.decl mark_tile(dc: DecChoice, p_tile: Position)
mark_tile(Dc, P_tile) :- mark(P_grid), decomp(Dc, P_grid, P_tile, _).

out(P, Col, $Tile(Dc)) :-
    decomp(Dc, P, P_tile, _),                            // grid cell, its tile
    ( mark_tile(Dc, P_tile), params.out_fill(Col)        // the mark's tile — filled
    ; !mark_tile(Dc, P_tile), params.bg(Col)             // any other tile — bg
    ).

// --- Center ---

.decl center_tile(dc: DecChoice, p_tile: Position)
center_tile(Dc, P_tile) :-
    mark(P_grid), decomp(Dc, P_grid, P_tile, P_intile),  // mark's tile
    centered(P_intile).                                  // the mark at the tile's center

out(P, Col, $Center(Dc)) :-
    decomp(Dc, P, P_tile, _),                            // grid cell, its tile
    ( center_tile(Dc, P_tile), params.out_fill(Col)      // the centered mark's tile — filled
    ; !center_tile(Dc, P_tile), params.bg(Col)           // any other tile — bg
    ).

// --- Grow ---

.decl grown(p: Position)
grown(P) :- mark(P).
grown(P) :- mark(M), dir8_elem(D), neighbor(M, D, P), in(P, _).

out(P, Col, $Grow()) :- grown(P), params.out_fill(Col).
out(P, Col, $Grow()) :- in(P, _), !grown(P), params.bg(Col).
