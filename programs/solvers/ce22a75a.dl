// ce22a75a
// concept: scale decompose markers stamp
// Marks on a 9×9 grid; each mark fills its 3×3 region, the rest is bg.
// Every mark sits at the center of its arrangement tile, so three locate
// priors coincide on the data; one case each, tagged on out's Choice:
//
//   $Tile()   — the arrangement tile containing a mark fills.
//   $Center() — a tile fills iff a mark sits at its center: the input read
//               as a stride-3 subsample, upscaled.
//   $Grow()   — each mark grows one step in all eight directions.

#include "../lib.dl"

.type Choice = Tile {} | Center {} | Grow {}

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(1).

    // --- $Tile / $Center ---
    .decl tile_count(n: number) tile_count(3).
}

.init params = Params

.decl mark(p: Position)
mark(P) :- in(P, Col), !params.bg(Col).

// --- $Tile / $Center: shared 3×3 arrangement ---

.decl decomp(p: Position, p_tile: Position, p_intile: Position)
decomp(P_grid, P_tile, P_intile) :-
    in(P_grid, _), params.tile_count(N),            // input position, tile params
    divide_2d(P_grid, N, 0, P_tile, P_intile).      // square arrangement

.decl out(p: Position, col: Color, ch: Choice)

// --- $Tile ---

.decl mark_tile(p_tile: Position)
mark_tile(P_tile) :- mark(P_grid), decomp(P_grid, P_tile, _).

out(P, Col, $Tile()) :-
    decomp(P, P_tile, _),                               // grid cell, its tile
    ( mark_tile(P_tile), params.out_fill(Col)           // the mark's tile — filled
    ; !mark_tile(P_tile), params.bg(Col)                // any other tile — bg
    ).

// --- $Center ---

.decl center_tile(p_tile: Position)
center_tile(P_tile) :-
    mark(P_grid), decomp(P_grid, P_tile, P_intile),  // mark's tile
    centered(P_intile).                              // the mark at the tile's center

out(P, Col, $Center()) :-
    decomp(P, P_tile, _),                               // grid cell, its tile
    ( center_tile(P_tile), params.out_fill(Col)         // the centered mark's tile — filled
    ; !center_tile(P_tile), params.bg(Col)              // any other tile — bg
    ).

// --- $Grow ---

.decl grown(p: Position)
grown(P) :- mark(P).
grown(P) :- mark(M), dir8_elem(D), neighbor(M, D, P), in(P, _).

out(P, Col, $Grow()) :- grown(P), params.out_fill(Col).
out(P, Col, $Grow()) :- in(P, _), !grown(P), params.bg(Col).
