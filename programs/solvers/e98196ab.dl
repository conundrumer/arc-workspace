// e98196ab
// Layout: 2×1 vertically-stacked 5×11 subgrids with 1-row gap.
// Output is the per-cell overlay: each panel's ink passes through.
//
// out's choice column (decompose):
//   $Tile() — pre-tabulated in Consts via tile_pos
//   $Div()  — derived in body via the divide primitive

#include "../lib.dl"

.type Choice = Tile {} | Div {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- Tile decompose data ----------------------------------------------
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        helpers.tile_pos([2, 1], [5, 11], [1, 0], P_grid, P_tile, P_intile).

    // --- Div decompose data -----------------------------------------------
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(AXIS_V).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Overlay data ------------------------------------------------------
    .decl bg(c: Color)  bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// --- Decompose cases -------------------------------------------------------

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: Choice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- Overlay body ------------------------------------------------------------

.decl filled(o: Position, dc: Choice)
filled(P_grid_out, Dc) :-
    in(P_grid_in, Col), !c.bg(Col),                 // non-bg input cell
    decompose(P_grid_in, _, P_grid_out, Dc).        // decomposes to output cell

// --- Output ----------------------------------------------------------------

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Dc) :-
    in(P_grid_in, Col), !c.bg(Col),                 // ink passes through
    decompose(P_grid_in, _, P_grid_out, Dc).
out(P_grid_out, Col, Dc) :-
    decompose(_, _, P_grid_out, Dc),                // output cell
    !filled(P_grid_out, Dc),                        // no contribution
    c.bg(Col).

.output out(IO=stdout)
