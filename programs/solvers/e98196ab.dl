// e98196ab
// @keywords: overlay decompose lookup
// output: Layout: 2×1 vertically-stacked 5×11 subgrids with 1-row gap. Output
//  is the per-cell overlay: each panel's ink passes through.

// out's choice column (decompose)
.type Choice =
    // pre-tabulated in the parameters via tile_pos
    Table {}
    // derived in the program, by tile count
  | Count {}
    // derived in the program, by tile size
  | Size {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).

    // --- $Table, Size decompose data ---
    .decl tile_dim(a: Axis, n: number)
    tile_dim(AXIS_V, 5). tile_dim(AXIS_H, 11).

    // --- $Table: decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 2). arr_dim(AXIS_H, 1).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah),
        tile_dim(AXIS_V, Tv), tile_dim(AXIS_H, Th), gap(G),
        helpers.tile_pos([Av, Ah], [Tv, Th], [G, 0], P_grid, P_tile, P_intile).

    // --- $Count: decompose data ---
    .decl divisor(n: number)
    divisor(2).

    // --- $Count, Size decompose data ---
    .decl divide_axis(a: Axis)
    divide_axis(AXIS_V).

    .decl divide_gap(g: number)
    divide_gap(1).
}

.init params = Params

// --- Decompose cases ---

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: Choice)
decompose(P_grid, P_tile, P_intile, $Table()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Count()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Size()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.tile_dim(A, K), params.divide_gap(G), // params
    divide_by_size_slab(P_grid, A, K, G, P_tile, P_intile).

// --- Overlay ---

.decl ink(p: Position, col: Color, dc: Choice)
ink(P_frame, Col, Dc) :-
    in(P_grid, Col), !params.bg(Col),               // ink cell
    decompose(P_grid, _, P_frame, Dc).              // the frame cell it stacks onto

// --- Output ---

out(P, Col, Dc) :- ink(P, Col, Dc).
out(P, Col, Dc) :-
    decompose(_, _, P, Dc), !ink(P, _, Dc),         // frame cell with no ink
    params.bg(Col).
