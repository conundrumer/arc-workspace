// e98196ab
// concept: overlay decompose lookup
// Layout: 2×1 vertically-stacked 5×11 subgrids with 1-row gap.
// Output is the per-cell overlay: each panel's ink passes through.
//
// out's choice column (decompose):
//   $Tile() — pre-tabulated in the parameters via tile_pos
//   $Div()  — derived in the program via the divide primitive

#include "../lib.dl"

.type Choice = Tile {} | Div {}

.comp Params {
    .init helpers = ParamsHelpers

    // --- Tile decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 2). arr_dim(AXIS_H, 1).
    .decl tile_dim(a: Axis, n: number)
    tile_dim(AXIS_V, 5). tile_dim(AXIS_H, 11).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah),
        tile_dim(AXIS_V, Tv), tile_dim(AXIS_H, Th), gap(G),
        helpers.tile_pos([Av, Ah], [Tv, Th], [G, 0], P_grid, P_tile, P_intile).

    // --- Div decompose data ---
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(AXIS_V).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Overlay data ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// --- Decompose cases ---

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: Choice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- Overlay program ---

.decl filled(o: Position, dc: Choice)
filled(P_grid_out, Dc) :-
    in(P_grid_in, Col), !params.bg(Col),            // non-bg input cell
    decompose(P_grid_in, _, P_grid_out, Dc).        // decomposes to output cell

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Dc) :-
    in(P_grid_in, Col), !params.bg(Col),                 // ink passes through
    decompose(P_grid_in, _, P_grid_out, Dc).
out(P_grid_out, Col, Dc) :-
    decompose(_, _, P_grid_out, Dc),                // output cell
    !filled(P_grid_out, Dc),                        // no contribution
    params.bg(Col).
