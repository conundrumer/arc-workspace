// aedd82e4
// concept: objects classify
// Isolated ink cells — no 4-neighbor ink — recolor to params.mark. The rest of
// the grid is underdetermined (ink color equals params.ink in every pair); two
// models:
//
//   $Passthrough — non-isolated cells keep their input color.
//   $Repaint     — every cell paints by class: isolated params.mark, grouped
//                  params.ink, bg params.bg.

#include "../lib.dl"

.type Choice = Passthrough {} | Repaint {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(1).

    // --- $Repaint ---
    .decl ink(c: Color) ink(2).
}

.init params = Params

.decl ink_at(p: Position)
ink_at(P) :- in(P, Col), !params.bg(Col).

.decl grouped(p: Position)
grouped(P) :- ink_at(P), dir_elem(D), neighbor(P, D, P2), ink_at(P2).

.decl isolated(p: Position)
isolated(P) :- ink_at(P), !grouped(P).

.decl out(p: Position, col: Color, c: Choice)

// --- $Passthrough ---
out(P, Col, $Passthrough()) :- isolated(P), params.mark(Col).
out(P, Col, $Passthrough()) :- in(P, Col), !isolated(P).

// --- $Repaint ---
out(P, Col, $Repaint()) :- isolated(P), params.mark(Col).
out(P, Col, $Repaint()) :- grouped(P), params.ink(Col).
out(P, Col, $Repaint()) :- in(P, _), !ink_at(P), params.bg(Col).
