// 0d3d703e
// @keywords: mapping
// output: Color swap. Each swap pair is stored once, and the mapping takes
//  each pair in both directions.

.decl out(p: Position, col: Color)

.comp Params {
    // the color pairs that trade places, each pair one class
    .decl swap(col: Color, k: Ident)
    swap(1, 0). swap(5, 0).
    swap(2, 1). swap(6, 1).
    swap(3, 2). swap(4, 2).
    swap(8, 3). swap(9, 3).

    .decl mapping(c_from: Color, c_to: Color)
    mapping(A, B) :- swap(A, K), swap(B, K), A != B.
}

.init params = Params

out(P, Col_out) :- in(P, Col_in), params.mapping(Col_in, Col_out).
out(P, Col)     :- in(P, Col), !params.mapping(Col, _).

.comp Determine {
    // The color pairs the examples trade, each pair one class.
    .init pair = Canon<Color>
    pair.edge(Col_in, Col_out) :- ex_in(E, P, Col_in), ex_out(E, P, Col_out), Col_in != Col_out.

    .decl swap(col: Color, k: Ident)
    swap(Col, K) :- pair.id(Col, K).
}
