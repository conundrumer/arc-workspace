// 0d3d703e
// concept: mapping
// Color swap via a symmetric mapping relation. The mapping is declared
// one-direction per pair and closed under symmetry by a rule.

#include "../lib.dl"

.comp Consts {
    .decl mapping(c_from: Color, c_to: Color)
    mapping(B, A) :- mapping(A, B).   // symmetric closure
    mapping(1, 5).
    mapping(2, 6).
    mapping(3, 4).
    mapping(8, 9).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P, Col_out) :- in(P, Col_in), c.mapping(Col_in, Col_out).
out(P, Col)     :- in(P, Col), !c.mapping(Col, _).

.output out(IO=stdout)
