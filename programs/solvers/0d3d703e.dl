// 0d3d703e
// keywords: mapping
// output: Color swap via a symmetric mapping relation. The mapping is declared
//  one-direction per pair and closed under symmetry by a rule.

.decl out(p: Position, col: Color)

.comp Params {
    .decl mapping(c_from: Color, c_to: Color)
    mapping(B, A) :- mapping(A, B).   // symmetric closure
    mapping(1, 5).
    mapping(2, 6).
    mapping(3, 4).
    mapping(8, 9).
}

.init params = Params

out(P, Col_out) :- in(P, Col_in), params.mapping(Col_in, Col_out).
out(P, Col)     :- in(P, Col), !params.mapping(Col, _).
