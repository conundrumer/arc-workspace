// fc754716
// keywords: border
// output: A single non-bg dot. The output paints the grid border with the dot's
//  color; every other cell is bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl ink(col: Color)
ink(Col) :- in(_, Col), !params.bg(Col).

.decl is_border(p: Position)
is_border(P) :- in(P, _), dir_elem(D), dist(P, D, 0).   // on any edge

out(P, Col) :- is_border(P), ink(Col).
out(P, Col) :- in(P, _), interior(P, ZERO), params.bg(Col).
