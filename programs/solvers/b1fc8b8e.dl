// b1fc8b8e
// keywords: classify lookup count pack
// output: Classify the ink: made of whole copies of the unit or not. Emit a
//  fixed 5x5 pattern per class — four copies of the class's 2x2 tile behind a
//  bg cross.

// how the ink is classified
.type Detect =
    // every ink cell lies inside some placement of params.unit fully on ink;
    // outcome picks params.covered_class / params.broken_class
    Shape {}
    // the ink splits into disjoint copies of params.unit, same outcome
    // parameters. Stricter than $Shape: a 2x3 block of ink is covered by
    // overlapping placements but splits into none.
  | Partition {}
    // ink count, mapped per-count via params.class_count
  | Count {}

// how a class renders
.type Render =
    // stored grid per class
    Grid {}
    // stored tile per class, laid out by params.arrange; gap cells get
    // params.bg
  | Arrange {}
    // stored tile anchored at each corner of params.canvas; uncovered cells get
    // params.bg
  | Corner {}

// how the ink is classified, crossed with how the class renders
.type Choice = [detect: Detect, render: Render]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl ink(c: Color) ink(8).

    // --- $Shape, $Partition ---
    .decl unit(p: Position)
    GRID_MASK_2x2(unit,
        1, 1,
        1, 1)

    .decl covered_class(id: Ident) covered_class(1).
    .decl broken_class(id: Ident) broken_class(0).

    // --- $Count ---
    .decl class_count(id: Ident, n: number)
    class_count(0, 12). class_count(1, 16).

    // --- $Grid ---
    .decl class_grid(id: Ident, p: Position, col: Color)
    GRID_5x5(class_grid, 0,
        0, 8, 0, 0, 8,
        8, 8, 0, 8, 8,
        0, 0, 0, 0, 0,
        0, 8, 0, 0, 8,
        8, 8, 0, 8, 8)
    GRID_5x5(class_grid, 1,
        8, 8, 0, 8, 8,
        8, 8, 0, 8, 8,
        0, 0, 0, 0, 0,
        8, 8, 0, 8, 8,
        8, 8, 0, 8, 8)

    // --- $Arrange, $Corner ---
    .decl class_tile(id: Ident, p_intile: Position, col: Color)
    GRID_2x2(class_tile, 0,
        0, 8,
        8, 8)
    GRID_2x2(class_tile, 1,
        8, 8,
        8, 8)

    .decl canvas_dim(n: number) canvas_dim(5).
    .decl canvas(p: Position)
    canvas(P) :- canvas_dim(N), helpers.frame_pos([N, N], P).

    .decl bg(c: Color) bg(0).

    // --- $Arrange ---
    .decl arr_dim(n: number) arr_dim(2).
    .decl tile_dim(n: number) tile_dim(2).
    .decl gap(n: number) gap(1).

    .decl arrange(p_grid: Position, p_intile: Position)
    arrange(P_grid, P_intile) :-
        arr_dim(A), tile_dim(K), gap(G),
        helpers.tile_pos([A, A], [K, K], [G, G], P_grid, _, P_intile).

    // Each class's tile under the arrangement.
    .decl arrange_grid(id: Ident, p_grid: Position, col: Color)
    arrange_grid(Id, P_grid, Col) :-
        arrange(P_grid, P_intile), class_tile(Id, P_intile, Col).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    .decl ink_at(k: Key, p: Position)
    ink_at(K, P) :- cell(K, P, Col), params.ink(Col).

    .init ink_tally = Tally<Key, Position>
    ink_tally.item(K, P) :- ink_at(K, P).

    .decl ink_count(k: Key, n: number)
    ink_count(K, N) :- ink_tally.tally(K, N).

    // Placements where the unit lands fully on ink, named by their margins,
    // with the cells each one covers.
    .init occ = Occurrences<Key, Unit>
    occ.cell(K, P, $U())  :- ink_at(K, P).
    occ.shape(K, S, $U()) :- ink_at(K, _), params.unit(S).

    .decl covers(k: Key, b: Position, p: Position)
    covers(K, B, P) :- occ.occurrence(K, B), params.unit(S), compose(B, S, P).

    .decl uncovered(k: Key)
    uncovered(K) :- ink_at(K, P), !covers(K, _, P).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- program ---

.decl class(id: Ident, d: Detect)

// --- $Shape ---
class(Id, $Shape()) :- parse.uncovered($U()), params.broken_class(Id).
class(Id, $Shape()) :- parse.ink_at($U(), _), !parse.uncovered($U()), params.covered_class(Id).

// --- $Partition ---

// The placements are the rival pieces of an exact cover of the ink. With one
// footprint the forced pieces are the reading-order peel, and the peel reaches
// a partition whenever the ink has one.
.init forcing = CoverForcing<Unit, Position>
forcing.covers($U(), B, P) :- parse.covers($U(), B, P).

// A cell of a surviving piece. Forced pieces that are not ruled out are
// pairwise disjoint, so they are a partition of what they cover.
.decl packed(p: Position)
packed(P) :-
    forcing.forced($U(), B), !forcing.ruled_out($U(), B),  // a surviving piece
    parse.covers($U(), B, P).                        // and its cells

// The ink cells the packing leaves over — the defect the universal negates.
.decl unpacked(p: Position)
unpacked(P) :- parse.ink_at($U(), P), !packed(P).

class(Id, $Partition()) :- unpacked(_), params.broken_class(Id).
class(Id, $Partition()) :- parse.ink_at($U(), _), !unpacked(_), params.covered_class(Id).

// --- $Count ---
class(Id, $Count()) :- parse.ink_count($U(), N), params.class_count(Id, N).

// --- $Grid ---
out(P, Col, [D, $Grid()]) :- class(Id, D), params.class_grid(Id, P, Col).

// --- $Arrange ---
out(P_grid, Col, [D, $Arrange()]) :- class(Id, D), params.arrange_grid(Id, P_grid, Col).
out(P_grid, Col, [D, $Arrange()]) :-
    class(_, D), params.canvas(P_grid), !params.arrange(P_grid, _), params.bg(Col).

// --- $Corner ---

// Each canvas corner's copy of the tile frame, same orientation at every corner.
.decl corner_map(p_intile: Position, p_grid: Position)
corner_map(P_intile, P_grid) :-
    params.class_tile(_, P_intile, _), params.canvas(P_grid),
    diag_dir_elem(Diag), corner_anchor(Diag, P_intile, P_grid).

out(P_grid, Col, [D, $Corner()]) :-
    class(Id, D), corner_map(P_intile, P_grid), params.class_tile(Id, P_intile, Col).
out(P_grid, Col, [D, $Corner()]) :-
    class(_, D), params.canvas(P_grid), !corner_map(_, P_grid), params.bg(Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // Train pairs that answer alike.
    .type PV = [p: Position, col: Color]
    .init out_cmp = KeyedSetCompare<Example, Example, PV>
    out_cmp.pattern_member(E, [P, Col]) :- ex_out(E, P, Col).
    out_cmp.observed_member(E, M) :- out_cmp.pattern_member(E, M).

    // One class per set of alike pairs; the label carries identity only.
    .init class = Canon<Example>
    class.equiv(E, E2) :- out_cmp.equals(E, E2).

    .decl class_grid(id: Ident, p: Position, col: Color)
    class_grid(Id, P, Col) :- class.id(E, Id), ex_out(E, P, Col).

    .decl class_tile(id: Ident, p_intile: Position, col: Color)
    class_tile(Id, P_intile, Col) :-
        class.id(E, Id), ex_out(E, P_grid, Col), params.arrange(P_grid, P_intile).

    .decl class_count(id: Ident, n: number)
    class_count(Id, N) :- class.id(E, Id), parse.ink_count(E, N).

    .decl covered_class(id: Ident)
    covered_class(Id) :- class.id(E, Id), parse.ink_at(E, _), !parse.uncovered(E).

    .decl broken_class(id: Ident)
    broken_class(Id) :- class.id(E, Id), parse.uncovered(E).

    // Each tile displays a copy of the unit: intact for the covered class,
    // damaged — cells removed — for the broken class. The displays jointly
    // exhibit the unit. Reading it off params.covered_class's tile instead would
    // be circular: that parameter's determination runs through placements of params.unit.
    .decl unit(p: Position)
    unit(P) :- class_tile(_, P, Col), params.ink(Col).
}
