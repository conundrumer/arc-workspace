// 14b8e18c
// @keywords: objects stamp bbox
// output: Square objects get corner marks: at each marked corner of an
//  object's bounding box, the two cells one step outside the box along its
//  edges take the mark color. The rest of the grid passes through. A lone
//  cell does not qualify.

// what makes an object square, and which corners get marks
.type Choice =
    // its bounding box is square; every box corner is marked
    Square {}
    // as $Square, but only the box corners the object occupies
  | Corners {}
    // the object also covers the whole box border
  | Box {}
    // the object is exactly the box border, with nothing inside
  | Ring {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).
    .decl mark_color(col: Color) mark_color(2).
}

.init params = Params

// --- objects ---

.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl cell_of(id: Ident, p: Position)
cell_of(Id, P) :- comps.label(_, P, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- cell_of(Id, P).

.decl square(id: Ident)
square(Id) :-
    bbox.box(Id, B), cell_of(Id, P),                               // the box, in the grid frame
    box_extent(B, P, A, N), perp(A, A2), box_extent(B, P, A2, N).  // one extent on both axes

.decl multi_cell(id: Ident)
multi_cell(Id) :- cell_of(Id, P), cell_of(Id, Q), P != Q.

// Some cell of the box's border is not the object's.
.decl border_gap(id: Ident)
border_gap(Id) :-
    bbox.box(Id, B), in(P, _), box_edge(P, B, _),  // a grid cell on the box's border
    !cell_of(Id, P).

.decl has_interior(id: Ident)
has_interior(Id) :- bbox.box(Id, B), cell_of(Id, P), interior(P, B).

// --- marks ---

// $Square and $Corners share the squareness hypothesis; they split at `anchor`.
.decl square_case(ch: Choice)
square_case($Square()). square_case($Corners()).

.decl qualify(id: Ident, ch: Choice)
qualify(Id, Ch)      :- square(Id), multi_cell(Id), square_case(Ch).
qualify(Id, $Box())  :- square(Id), multi_cell(Id), !border_gap(Id).
qualify(Id, $Ring()) :- square(Id), multi_cell(Id), !border_gap(Id), !has_interior(Id).

.decl corner_cell(id: Ident, diag: DiagDir, p: Position)
corner_cell(Id, Dg, P) :-
    bbox.box(Id, B), in(P, _),  // the box, and a grid cell
    box_corner(P, B, Dg).       // at corner Dg of it

// The corner cells whose out-neighbors take the mark: the box's corners,
// except $Corners keeps only those the object occupies.
.decl anchor(diag: DiagDir, p: Position, ch: Choice)
anchor(Dg, P, Ch) :- qualify(Id, Ch), Ch != $Corners(), corner_cell(Id, Dg, P).
anchor(Dg, P, $Corners()) :- qualify(Id, $Corners()), corner_cell(Id, Dg, P), cell_of(Id, P).

.decl mark(p: Position, ch: Choice)
mark(P_mark, Ch) :-
    anchor(Dg, P, Ch),                               // a marked corner cell
    dir_of(Dg, _, D), neighbor(P, D, P_mark),        // one step out along each corner edge
    in(P_mark, _).                                   // when it lands on the grid

// --- output ---

.decl impl_choice(ch: Choice)
impl_choice($Square()). impl_choice($Corners()). impl_choice($Box()). impl_choice($Ring()).

out(P, Col, Ch) :- mark(P, Ch), params.mark_color(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !mark(P, Ch).
