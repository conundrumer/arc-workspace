// 444801d8
// @draft
// @keywords: objects markers border
// output: A box of params.wall cells holds a seed cell of another color, and
//  one side of its wall is broken. The seed's color paints the box's non-wall
//  cells and the line one step beyond the broken side.

// which side is open; every box here breaks on the top, so the two models
// agree
.type Choice =
    // params.open_dir names it
    Dir {}
    // the side whose wall line is broken
  | Gap {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl wall(col: Color) wall(1).

    // --- $Dir ---
    .decl open_dir(d: Dir) open_dir(DIR_T).
}

.init params = Params

// A box is a connected run of wall cells.
.init walls = Components<Unit>
walls.node($U(), P) :- in(P, Col), params.wall(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- walls.label($U(), P, Id).

// The cell in a box that is neither wall nor bg gives the box its color.
.decl seed(id: Ident, col: Color)
seed(Id, Col) :-
    bbox.box(Id, B), in(P, Col), inside(P, B),  // a cell of the box
    !params.wall(Col), !params.bg(Col).

// The side the fill escapes from.
.decl open_side(id: Ident, d: Dir, ch: Choice)

// --- $Dir ---
open_side(Id, D, $Dir()) :- bbox.box(Id, _), params.open_dir(D).

// --- $Gap ---
open_side(Id, D, $Gap()) :-
    bbox.box(Id, B), in(P, Col), box_edge(P, B, D),  // a cell of the box's d side
    !params.wall(Col).                               // not wall, so the side is broken

// --- shared ---

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :-
    open_side(Id, D, Ch), seed(Id, Col), bbox.box(Id, B),  // the box, its side, its fill
    ( in(P, _), inside(P, B)                               // inside the box
    ; in(Q, _), box_edge(Q, B, D), neighbor(Q, D, P) ),    // the line one step beyond
    in(P, C), !params.wall(C).                             // the wall keeps its color

.decl impl_choice(ch: Choice)
impl_choice($Dir()). impl_choice($Gap()).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !paint(P, _, Ch).
