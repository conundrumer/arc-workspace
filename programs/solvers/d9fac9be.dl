// d9fac9be
// @keywords: select noise
// output: Two ink colors on a bg of noise; one ink draws a box around a single
//  cell of the other. Output is 1×1: the boxed cell's color.

// how the boxed cell is identified (data-equivalent on this task)
.type Choice =
    // a params.dim square outline of one ink around a centered hole
    Box {}
    // a cell whose surrounding cells all carry the other ink
  | Ring {}
    // a cell whose surrounding cells are all ink
  | Full {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color)
    bg(0).

    .decl out_dim(a: Axis, n: number)
    out_dim(AXIS_V, 1). out_dim(AXIS_H, 1).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(AXIS_V, V), out_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    // --- $Box ---
    .decl dim(k: number)
    dim(3).
}

.init params = Params

// The input's ink colors.
.decl ink(c: Color)
ink(Col) :- in(_, Col), !params.bg(Col).

// --- $Box ---
.init box = Frame2D<Unit>
box.extent($U(), A, K) :- axis_elem(A), params.dim(K).

.init outline = Rim<Unit>
outline.cell($U(), P) :- box.cell($U(), P).

.init occ = Occurrences<Color, Unit>
occ.cell(Col, P, $U())  :- in(P, Col), ink(Col).
occ.shape(Col, S, $U()) :- ink(Col), outline.rim($U(), S).

out(P_grid_out, Col_hole, $Box()) :-
    occ.occurrence(Col, M),                    // one ink's box
    box.cell($U(), P_ctr), centered(P_ctr),    // the frame's center cell
    compose(M, P_ctr, P_grid_in),              // its hole on the grid
    in(P_grid_in, Col_hole), Col_hole != Col,  // the boxed cell's color
    params.out_pos(P_grid_out).

// --- $Ring ---
// Some surrounding cell of p does not carry ink a.
.decl defect(p: Position, a: Color)
defect(P, A) :-
    in(P, _), ink(A),                    // candidate cell × ink
    dir8_elem(D), neighbor(P, D, P2),    // a surrounding cell
    !in(P2, A).                          // not that ink there

out(P_grid_out, Col, $Ring()) :-
    in(P_grid_in, Col),                      // candidate cell
    ink(A), A != Col,                        // an ink not its own
    !defect(P_grid_in, A),                   // surround solid in it
    params.out_pos(P_grid_out).

// --- $Full ---
.decl inked(p: Position)
inked(P) :- in(P, Col), !params.bg(Col).

// Some surrounding cell of p is bg or off-grid.
.decl gap(p: Position)
gap(P) :-
    in(P, _),                            // candidate cell
    dir8_elem(D), neighbor(P, D, P2),    // a surrounding cell
    !inked(P2).                          // no ink there

out(P_grid_out, Col, $Full()) :-
    in(P_grid_in, Col), !gap(P_grid_in),     // cell with surround all ink
    params.out_pos(P_grid_out).
