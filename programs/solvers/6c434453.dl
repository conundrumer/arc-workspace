// 6c434453
// draft
// keywords: stamp enclose
// output: Ink shapes on bg. Every hollow 3×3 ring (eight ink cells around one
//  bg cell) is replaced in place: its hole and the four cells beside it become
//  a plus of params.fill, and its corners clear to bg. Other shapes pass
//  through.

// how the ring and its replacement are found
.type Choice =
    // the ring and the plus are stored grids; Occurrences finds the ring's
    // placements and the plus stamps over each
    Stamp {}
    // a bg cell with ink on all four sides is a hole; it and its cardinal
    // neighbors take params.fill, its diagonal neighbors bg
  | Flank {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    // --- $Stamp ---
    .decl src(p: Position, col: Color)
    GRID_3x3(src,
        1, 1, 1,
        1, 0, 1,
        1, 1, 1)
    .decl dst(p: Position, col: Color)
    GRID_3x3(dst,
        0, 2, 0,
        2, 2, 2,
        0, 2, 0)

    // --- $Flank ---
    .decl bg(c: Color) bg(0).
    .decl ink(c: Color) ink(1).
    .decl fill(c: Color) fill(2).
}

.init params = Params

// --- $Stamp ---
.init occ = Occurrences<Unit, Color>
occ.cell($U(), P, Col)  :- in(P, Col).
occ.shape($U(), P, Col) :- params.src(P, Col).

.decl stamped(p: Position, col: Color)
stamped(P, Col) :- occ.occurrence($U(), M), params.dst(S, Col), compose(M, S, P).

// --- $Flank ---
.decl bg_at(p: Position)
bg_at(P) :- in(P, Col), params.bg(Col).

.decl ink_at(p: Position)
ink_at(P) :- in(P, Col), params.ink(Col).

// A bg cell with some side not ink: off the frame, or bg.
.decl open(p: Position)
open(P) :- bg_at(P), dir_elem(D), neighbor(P, D, Q), !ink_at(Q).

.decl hole(p: Position)
hole(P) :- bg_at(P), !open(P).

.decl replaced(p: Position, col: Color)
replaced(Q, Col) :-
    hole(P),
    ( Q = P, params.fill(Col)                              // the hole
    ; dir_elem(D), neighbor(P, D, Q), params.fill(Col)     // its sides
    ; diag_dir_elem(D), neighbor(P, D, Q), params.bg(Col)  // its corners
    ).

out(P, Col, $Stamp()) :- stamped(P, Col).
out(P, Col, $Stamp()) :- in(P, Col), !stamped(P, _).

out(P, Col, $Flank()) :- replaced(P, Col).
out(P, Col, $Flank()) :- in(P, Col), !replaced(P, _).

.comp Determine {
    // Every cell of a replaced ring changes, so each ring is one changed
    // component, and its box is the stamp frame.
    .decl changed(e: Example, p: Position)
    changed(E, P) :- ex_in(E, P, C1), ex_out(E, P, C2), C1 != C2.

    .type EI = [e: Example, id: Ident]

    .init comps = Components<Example>
    comps.node(E, P) :- changed(E, P).

    .init frame = Bbox<EI>
    frame.cell([E, Id], P) :- comps.label(E, P, Id).

    // A changed cell in its ring's frame.
    .decl ring_cell(e: Example, p: Position, p_inner: Position)
    ring_cell(E, P, P_inner) :-
        frame.cell([E, Id], P), frame.box([E, Id], B), crop(P, B, P_inner).

    // Every ring reads the same source and the same replacement.
    .init src_read = Unanimous<Position, Color>
    src_read.item(P_inner, Col) :- ring_cell(E, P, P_inner), ex_in(E, P, Col).

    .init dst_read = Unanimous<Position, Color>
    dst_read.item(P_inner, Col) :- ring_cell(E, P, P_inner), ex_out(E, P, Col).

    .decl src(p: Position, col: Color)
    src(P_inner, Col) :- src_read.value(P_inner, Col).

    .decl dst(p: Position, col: Color)
    dst(P_inner, Col) :- dst_read.value(P_inner, Col).
}
