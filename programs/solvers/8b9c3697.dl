// 8b9c3697
// @draft
// @keywords: objects move span enclose select
// input: The grid is a background, the commonest color, with movers of
//  params.mover and anchors of a third color on it. An anchor is a
//  component; its cavity is the cells with anchor cells of it on both sides
//  along a row or a column.
// output: Each mover slides toward each cardinal direction until its next
//  step would leave the frame or cover a cell that is neither background nor
//  its own. When that step would cover an anchor cell and the rest lies
//  wholly in that anchor's cavity, the mover stays at rest, and the cells it
//  passed over, its start included, take params.trail. Every other mover is
//  erased.
// review principle: Cases — the dropped reading of what stops a mover,
//  refused beside the shipped cavity seating for claiming the same move
//  concept, now stands unless Fit, Fidelity, or Equivalence removes it, so
//  re-judge it as a second case.

.decl out(p: Position, col: Color)

.comp Params {
    .decl mover(col: Color) mover(2).
    .decl trail(col: Color) trail(0).
}

.init params = Params

// The background: the commonest color.
.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl bg(col: Color)
bg(Col) :- bg_mode.mode($U(), Col).

// --- objects ---

.init movers = Components<Unit>
movers.node($U(), P) :- in(P, Col), params.mover(Col).

.decl mover(id: Ident, p: Position)
mover(Id, P) :- movers.label($U(), P, Id).

// An anchor: a component of what is neither background nor mover.
.init anchors = Components<Unit>
anchors.node($U(), P) :- in(P, Col), !bg(Col), !params.mover(Col).

.decl anchor(id: Ident, p: Position)
anchor(Id, P) :- anchors.label($U(), P, Id).

// Each anchor's cavity.
.init cavity = Between<Ident>
cavity.axis(Id, A) :- anchor(Id, _), axis_elem(A).
cavity.mark(Id, P) :- anchor(Id, P).
cavity.cell(Id, P) :- anchor(Id, _), in(P, _).

// --- the slide ---

.type Heading = [id: Ident, d: Dir]

// Each mover slides toward each direction until it meets the frame edge or
// a cell that is neither background nor its own.
.init slide = Gravity<Heading, Unit>
slide.cell([Id, D], $U(), P) :- mover(Id, P), dir_elem(D).
slide.dir([Id, D], D) :- mover(Id, _), dir_elem(D).
slide.blocked([Id, D], P) :-
    mover(Id, _), dir_elem(D), in(P, Col), !bg(Col), !mover(Id, P).

// The mover's cells at rest toward D.
.decl rest(id: Ident, d: Dir, p: Position)
rest(Id, D, P2) :- slide.travel([Id, D], _, Delta), mover(Id, P), compose(P, Delta, P2).

// A mover at rest toward D, with the anchor its next step would hit.
.decl docked(id: Ident, d: Dir, a: Ident)
docked(Id, D, A) :- rest(Id, D, P), neighbor(P, D, P2), anchor(A, P2).

// A docked mover with a rest cell outside that anchor's cavity.
.decl outside(id: Ident, d: Dir, a: Ident)
outside(Id, D, A) :- docked(Id, D, A), rest(Id, D, P), !cavity.between(A, P).

// A mover seated in a cavity.
.decl seated(id: Ident, d: Dir)
seated(Id, D) :- docked(Id, D, A), !outside(Id, D, A).

// --- output ---

.decl landed(p: Position)
landed(P) :- seated(Id, D), rest(Id, D, P).

// The cells a seated mover passed over short of its rest, its start
// included.
.decl trail(p: Position)
trail(P) :-
    seated(Id, D), slide.travel([Id, D], _, Delta),
    mover(Id, P0), compose(P0, Delta, P1),        // a mover cell and its rest cell
    in(P, _), axis_of(D, A), same_line(A, P0, P), // a cell on their line
    ( P = P0 ; nearer(D, P, P0) ),                // the start, or a cell ahead of it
    nearer(D, P1, P),                             // short of the rest
    !landed(P).

// The grid with the movers lifted off.
.decl cleared(p: Position, col: Color)
cleared(P, Col) :- in(P, Col), !mover(_, P).
cleared(P, Col) :- mover(_, P), bg(Col).

out(P, Col) :- landed(P), params.mover(Col).
out(P, Col) :- trail(P), params.trail(Col).
out(P, Col) :- cleared(P, Col), !landed(P), !trail(P).
