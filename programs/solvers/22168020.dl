// 22168020
// Per line along c.fill_axis, each color's span — between its extreme marks —
// fills with that color.

#include "../lib.dl"

.comp Consts {
    .decl fill_axis(a: Axis)   fill_axis(AXIS_H).   // spans run along this axis
    .decl bg(c: Color)         bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Each color's span: cells between two marks of that color on their line.
.init rays = Ray<Color>
rays.dir(D)       :- c.fill_axis(A), axis_of(D, A).
rays.cell(P)      :- in(P, _).
rays.mark(Col, Q) :- in(Q, Col), !c.bg(Col).

.decl span(col: Color, p: Position)
span(Col, P) :- rays.ray(Col, P, D), opposite(D, O), rays.ray(Col, P, O).

.decl filled(p: Position)
filled(P) :- span(_, P).

.decl out(p: Position, col: Color)
out(P, Col) :- span(Col, P).
out(P, Col) :- in(P, Col), !filled(P).

.output out(IO=stdout)
