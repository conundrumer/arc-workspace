// 22168020
// Per line along c.fill_axis, each color's span — between its extreme marks —
// fills with that color.

#include "../lib.dl"

.comp Consts {
    .decl fill_axis(a: Axis)   fill_axis(HORIZONTAL).   // spans run along this axis
    .decl bg(c: Color)         bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// A Col mark at or beyond P toward edge D, in P's line along the fill axis.
.decl mark_side(p: Position, col: Color, d: Dir)
mark_side(P, Col, D) :-
    in(P, _), in(Q, Col), c.bg(Bg), Col != Bg,                // grid cell P, mark Q
    c.fill_axis(A), split(P, A, _, Ac), split(Q, A, _, Ac),   // same line
    axis_of(D, A), dist(P, D, Kp), dist(Q, D, Kq), Kq <= Kp.  // Q at or nearer edge D

// P lies between two Col marks on its line — the span fills with Col.
.decl fill(p: Position, col: Color)
fill(P, Col) :- mark_side(P, Col, D), opposite(D, O), mark_side(P, Col, O).

.decl filled(p: Position)
filled(P) :- fill(P, _).

.decl out(p: Position, col: Color)
out(P, Col) :- fill(P, Col).
out(P, Col) :- in(P, Col), !filled(P).

.output out(IO=stdout)
