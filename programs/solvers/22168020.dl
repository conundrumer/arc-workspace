// 22168020
// concept: lines span
// Per line along c.fill_axis, each color's span (between its extreme marks)
// fills with that color.

#include "../lib.dl"

.comp Consts {
    .decl fill_axis(a: Axis)   fill_axis(AXIS_H).   // spans run along this axis
    .decl bg(c: Color)         bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.init spans = Between<Color>
spans.axis(A)      :- c.fill_axis(A).
spans.cell(P)      :- in(P, _).
spans.mark(Col, Q) :- in(Q, Col), !c.bg(Col).

.decl filled(p: Position)
filled(P) :- spans.between(_, P).

.decl out(p: Position, col: Color)
out(P, Col) :- spans.between(Col, P).
out(P, Col) :- in(P, Col), !filled(P).

.output out(IO=stdout)
