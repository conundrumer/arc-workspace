// 22168020
// @keywords: lines span
// output: Per line along params.fill_axis, each color's span (between its
//  extreme marks) fills with that color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl fill_axis(a: Axis) fill_axis(AXIS_H).   // spans run along this axis
    .decl bg(c: Color) bg(0).
}

.init params = Params

.init spans = Between<Color>
spans.axis(Col, A) :- spans.mark(Col, _), params.fill_axis(A).
spans.cell(Col, P) :- spans.mark(Col, _), in(P, _).
spans.mark(Col, Q) :- in(Q, Col), !params.bg(Col).

out(P, Col) :- spans.between(Col, P).
out(P, Col) :- in(P, Col), !spans.between(_, P).
