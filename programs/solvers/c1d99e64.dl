// c1d99e64
// concept: lines
// One ink color over bg. Rows and columns free of ink repaint c.line;
// the rest passes through.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl line(c: Color) line(2).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Line along axis a holding ink.
.decl has_ink(a: Axis, p_across: Position)
has_ink(A, P_across) :- in(P, Col), !c.bg(Col), axis_elem(A), split(P, A, _, P_across).

// Cell on an ink-free line.
.decl on_bg_line(p: Position)
on_bg_line(P) :- in(P, _), axis_elem(A), split(P, A, _, P_across), !has_ink(A, P_across).

.decl out(p: Position, col: Color)
out(P, C)   :- on_bg_line(P), c.line(C).
out(P, Col) :- in(P, Col), !on_bg_line(P).

.output out(IO=stdout)
