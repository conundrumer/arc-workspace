// 5c2c9af4
// @draft
// @keywords: markers border rings
// output: Three dots of one color sit equally spaced along a diagonal. The
//  output draws concentric square outlines around the middle dot, spaced by the
//  gap between neighboring dots, as far out as the grid shows any part of one.
//  Every dot lies on an outline.

// what a cell off the outlines does
.type Choice =
    // a cell off the outlines keeps its input color
    Passthrough {}
    // a cell off the outlines gets params.bg
  | Repaint {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

// The marks' bounding box is the innermost outline: the outer dots sit at
// two of its corners, and the middle dot at its center.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- mark(P, _).

.decl center(p: Position)
center(P) :-
    bbox.cell($U(), P), bbox.box($U(), B), crop(P, B, P_inner),
    centered(P_inner).    // the middle dot

// The spacing: how far the center lies inside the innermost outline.
.decl spacing(k: number)
spacing(K) :-
    center(P), bbox.box($U(), B), crop(P, B, P_inner),
    dir_elem(D), dist(P_inner, D, K).

// --- program ---

// The cells the outlines draw: a cell lies on the outline as far out from the
// center as its farther offset along either axis, and the outlines stand at
// every multiple of the spacing, the center cell being the innermost.
.decl drawn(p: Position)
drawn(P) :-
    in(P, _), center(C), relative(C, P, V),
    dir_elem(D), dist(V, D, K),                                 // an offset from the center
    spacing(G), stride(K, G, 0, _, 0),                          // a multiple of the spacing
    uniform_outset(K, B_out), compose(C, B_out, B), box_edge(P, B, _).   // on that outline

// --- $Passthrough ---
out(P, Col, $Passthrough()) :- drawn(P), mark(_, Col).
out(P, Col, $Passthrough()) :- in(P, Col), !drawn(P).

// --- $Repaint ---
out(P, Col, $Repaint()) :- drawn(P), mark(_, Col).
out(P, Col, $Repaint()) :- in(P, _), !drawn(P), params.bg(Col).
