// 5c2c9af4
// @draft
// @keywords: markers walk border
// output: Three dots of one color sit equally spaced along a diagonal. The
//  output draws concentric square outlines around the middle dot, spaced by the
//  gap between neighboring dots, as far out as the grid shows any part of one.
//  Every dot lies on an outline.

// what a cell off the outlines does
.type Choice =
    // a cell off the outlines keeps its input color
    Passthrough {}
    // a cell off the outlines gets params.bg
  | Repaint {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

// The marks' bounding box is the innermost outline: the outer dots sit at
// two of its corners, and the middle dot at its center.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- mark(P, _).

.decl center(p: Position)
center(P) :-
    bbox.cell($U(), P), bbox.box($U(), B), crop(P, B, P_inner),
    centered(P_inner).    // the middle dot

// The spacing, as the frame change carrying the center out to the innermost outline.
.decl spread(b: Box)
spread(B_spread) :- center(P), bbox.box($U(), B), relative(P, B, B_spread).

// --- program ---

.decl outline(b: Box)

// The cells an outline draws on the grid.
.decl drawn(b: Box, p: Position)
drawn(B, P) :- outline(B), in(P, _), box_edge(P, B, _).

// Each outline is the one inside it grown by the spacing, the center cell
// being the innermost. An outline that draws nothing lies wholly off the
// grid, and so does every outline beyond it.
outline(B) :- center(B).
outline(B2) :- drawn(B, _), spread(B_spread), compose(B, B_spread, B2).

// --- $Passthrough ---
out(P, Col, $Passthrough()) :- drawn(_, P), mark(_, Col).
out(P, Col, $Passthrough()) :- in(P, Col), !drawn(_, P).

// --- $Repaint ---
out(P, Col, $Repaint()) :- drawn(_, P), mark(_, Col).
out(P, Col, $Repaint()) :- in(P, _), !drawn(_, P), params.bg(Col).
