// e729b7be
// concept: symmetry markers repair d4
//
// A full-height line, interrupted by a marker where the marker row
// crosses it; markers also end that row at both edges. The shape beside
// the line reappears half-turned on the far side. $Sym completes the
// grid's half-turn symmetry about the frame center; $Marker completes
// it about the marked crossing.

#include "../lib.dl"

.type Choice = Sym {} | Marker {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(7).

    // --- Sym ---
    // Stabilizer of the completed grid.
    .decl sym(d: D4)
    sym(D4_ID). sym(D4_HT).

    // --- Marker ---
    .decl line(c: Color) line(4).
    .decl marker(c: Color) marker(8).
    // The transform completing the grid about the crossing.
    .decl transform(d: D4) transform(D4_HT).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Sym()). impl_choice($Marker()).

// Each cell's counterpart value, per case; painted onto bg cells.
.decl image(p: Position, col: Color, ch: Choice)

// --- Sym ---
image(P, Col, $Sym()) :-
    in(P2, Col), !params.bg(Col),         // ink cell
    params.sym(D), apply(D, P2, P).       // its symmetric counterpart

// --- Marker ---
// The crossing: the marker colinear with a line cell — the line is
// interrupted only there, so edge markers align with no line cell.
.decl center(p: Position)
center(C) :-
    in(C, Colm), params.marker(Colm),      // a marker
    in(Q, Coll), params.line(Coll),        // a line cell
    axis_elem(A), same_line(A, C, Q).

image(P2, Col, $Marker()) :-
    in(P, Col), center(C), relative(C, P, V),   // a cell's offset from the crossing
    params.transform(D), apply(D, V, V2),
    compose(C, V2, P2).                         // seated back at the crossing

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col_out, Ch) :-
    impl_choice(Ch), in(P, Col),
    ( !params.bg(Col), Col_out = Col                     // non-bg — kept
    ; params.bg(Col), image(P, Col_out, Ch)              // bg — the image paints it
    ; params.bg(Col), !image(P, _, Ch), Col_out = Col    // bg, untouched — stays bg
    ).

.comp Determine {
    .init d4m = D4Map<Example, Color>
    d4m.src(E, P, Col) :- ex_out(E, P, Col).
    d4m.dst(E, P, Col) :- ex_out(E, P, Col).

    // The stabilizer: what every train output is invariant under.
    .decl sym(d: D4)
    sym(D) :- d4_elem(D), !d4m.mismatch(_, D).
}
