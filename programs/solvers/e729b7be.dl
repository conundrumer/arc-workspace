// e729b7be
// @keywords: symmetry markers repair d4
// input: a full-height line of params.line; a params.marker sits on it, and
//  another at each end of that marker's row; a shape sits beside the line
// output: each background cell takes the color of its half-turn counterpart,
//  so the shape reappears on the far side of the line

// which center the half turn is about
.type Choice =
    // the frame center
    Sym {}
    // the marked crossing
  | Marker {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(7).

    // --- Sym ---
    // Stabilizer of the completed grid.
    .decl sym(d: D4)
    sym(D4_ID). sym(D4_HT).

    // --- Marker ---
    .decl line(c: Color) line(4).
    .decl marker(c: Color) marker(8).
    // The transform taken about the crossing.
    .decl transform(d: D4) transform(D4_HT).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Sym()). impl_choice($Marker()).

// The color of each cell's counterpart, per case.
.decl image(p: Position, col: Color, ch: Choice)

// --- Sym ---
image(P2, Col, $Sym()) :-
    in(P, Col), !params.bg(Col),         // ink cell
    params.sym(D), apply(D, P, P2).      // its symmetric counterpart

// --- Marker ---
// The crossing: the marker with line cells on both sides of it.
.init crossing = Between<Unit>
crossing.axis($U(), A) :- axis_elem(A).
crossing.cell($U(), P) :- in(P, Col), params.marker(Col).
crossing.mark($U(), P) :- in(P, Col), params.line(Col).

image(P2, Col, $Marker()) :-
    in(P, Col), crossing.between($U(), C), relative(C, P, V),  // a cell's offset from the crossing
    params.transform(D), apply(D, V, V2),
    compose(C, V2, P2).                                        // seated back at the crossing

out(P, Col_out, Ch) :-
    impl_choice(Ch), in(P, Col),
    ( !params.bg(Col), Col_out = Col                     // non-bg — kept
    ; params.bg(Col), image(P, Col_out, Ch)              // bg — the image paints it
    ; params.bg(Col), !image(P, _, Ch), Col_out = Col    // bg, untouched — stays bg
    ).

.comp Determine {
    .init d4m = D4Map<Example, Color>
    d4m.src(E, P, Col) :- ex_out(E, P, Col).
    d4m.dst(E, P, Col) :- ex_out(E, P, Col).

    // What every train output is invariant under.
    .decl sym(d: D4)
    sym(D) :- d4_elem(D), !d4m.mismatch(_, D).
}
