// 9d9215db
// @draft
// @keywords: markers border decompose rank span rings
// @scene sites: the ink sits on sites, every other cell on both axes, held
//  one blank cell in from the grid's border
// @scene rings: the sites peel into square rings, one per distance from
//  the nearest edge of the sites, and each inked cell sits on one of them
// @scene nesting: the inked rings run consecutively from the outermost
// @scene corner-ink: every inked ring holds ink at one of its four corners
// @scene patch: a ring's ink away from its corners sits one step along the
//  ring from a corner
// @rule draw: the output draws one ring per ring that holds ink
// @rule seat: each drawn ring sits on the ring it came from
// @rule corners: a drawn ring's four corner cells take the color of the ink
//  at a corner of the ring it came from
// @rule sides: the rest of a drawn ring takes the color of the ink away from
//  the corners of the ring it came from
// @rule blank: every other cell takes the background

// which ring a drawn ring sits on
.type Seat =
    // @claim seat
    Own {}
    // @rule seat: the drawn rings take the outermost rings, in the order of
    //  the rings they came from
    // @witness skipped-ring: variant concept
    //     @relaxed nesting
  | Nest {}

// what makes a ring one the output draws
.type Source =
    // @claim draw
    AnyInk {}
    // @rule draw: the output draws one ring per ring that holds ink at one
    //  of its corners
    // @witness cornerless-ring: variant concept
    //     @relaxed corner-ink
  | CornerInk {}

// how far the side ink reaches along the ring it draws
.type Spread =
    // @claim sides
    Full {}
    // @rule sides: a drawn ring's cells no nearer a corner than the side ink
    //  is to a corner of the ring it came from take that ink's color
    // @witness gapped-side: foreign concept
    //     @relaxed patch
  | Span {}

// a drawn ring's seat, what makes a ring drawn, and the side ink's reach
.type Choice = [seat: Seat, src: Source, sp: Spread]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    .decl bg(col: Color) bg(0).

    // The blank border the sites sit inside.
    .decl margin(k: number) margin(1).

    // A site is one grid cell, with one blank cell to the next.
    .decl site_size(k: number) site_size(1).
    .decl site_gap(g: number) site_gap(1).
}

.init params = Params

.decl seat_choice(s: Seat)
seat_choice($Own()). seat_choice($Nest()).

.decl source_choice(s: Source)
source_choice($AnyInk()). source_choice($CornerInk()).

.decl spread_choice(s: Spread)
spread_choice($Full()). spread_choice($Span()).

.decl impl_choice(ch: Choice)
impl_choice([S, Src, Sp]) :- seat_choice(S), source_choice(Src), spread_choice(Sp).

// The site a grid cell holds.
.decl site(p_grid: Position, p_site: Position)
site(P_grid, P_site) :-
    in(P_grid, _),
    params.margin(M), uniform_inset(M, B), crop(P_grid, B, P_rel),  // inside the border
    params.site_size(K), params.site_gap(G),
    divide_by_size_2d(P_rel, K, G, P_site, _).                      // every other cell

.decl ink(p_site: Position, col: Color)
ink(P_site, Col) :- site(P_grid, P_site), in(P_grid, Col), !params.bg(Col).

// @claim rings
.init peel = Rim<Unit>
peel.cell($U(), P_site) :- site(_, P_site).

// A site at a corner of its own ring.
.decl corner(p_site: Position)
corner(P_site) :-
    peel.depth($U(), P_site, K), uniform_inset(K, B), diag_dir_elem(Diag), box_corner(P_site, B, Diag).

// Distances from a site to the four corners of its own ring; the
// lowest of them runs along that ring.
// @claim sides
.init reach = Extremes<Position>
reach.cand(P_site, J) :-
    peel.depth($U(), P_site, K), uniform_inset(K, B), relative(B, P_site, P_rel),
    diag_dir_elem(Diag), corner_dist(P_rel, Diag, J).

// The ring a site sits on, and how far along that ring it sits from
// the ring's nearest corner.
.decl place(p_site: Position, k: number, j: number)
place(P_site, K, J) :- peel.depth($U(), P_site, K), reach.low(P_site, J).

// The places a ring has away from its corners, each a distance from the
// ring's nearest corner.
.decl side_place(j: number)
side_place(J) :- place(P_site, _, J), !corner(P_site).

// The rings whose ink the output draws.
.decl source(src: Source, k: number)
source($AnyInk(), K) :- ink(P_site, _), place(P_site, K, _).
source($CornerInk(), K) :- ink(P_site, _), corner(P_site), place(P_site, K, _).

// The side place of a drawn ring that takes the ink at a side place of the
// ring it came from.
// @ignore: store — the correspondence follows the ring's places, which
// follow the extent of the sites; this task fixes the grid size, so the value
// is constant here alone
.decl copy(sp: Spread, j_out: number, j_src: number)

// A site of the drawing, and the ink it copies.
.decl draw(ch: Choice, p_site: Position, col: Color)

.decl drawn(ch: Choice, p_grid: Position)
drawn(Ch, P_grid) :- site(P_grid, P_site), draw(Ch, P_site, _).

out(P_grid, Col, Ch) :- site(P_grid, P_site), draw(Ch, P_site, Col).
out(P_grid, Col, Ch) :-
    in(P_grid, _), impl_choice(Ch), !drawn(Ch, P_grid), params.bg(Col).

// --- $Own ---
draw([$Own(), Src, Sp], P_site, Col) :-
    source(Src, K), place(P_site, K, J_out),            // a place on the ink's own ring
    ink(Q_site, Col), place(Q_site, K, J_src),          // ink on that ring
    ( corner(P_site), corner(Q_site), spread_choice(Sp) // the corners pair off
    ; copy(Sp, J_out, J_src)
    ).

// --- $Nest ---

// @claim seat
.init order = Ordinal<Source>
order.idx_set(Src, K) :- source(Src, K).

draw([$Nest(), Src, Sp], P_site, Col) :-
    order.rank(Src, K, K_out), place(P_site, K_out, J_out), // a place on the seated ring
    ink(Q_site, Col), place(Q_site, K, J_src),              // ink on the ring it draws
    ( corner(P_site), corner(Q_site), spread_choice(Sp)     // the corners pair off
    ; copy(Sp, J_out, J_src)
    ).

// --- $Full ---

// The side ink reaches every place of the ring but its corners.
copy($Full(), J_out, J_src) :- side_place(J_out), side_place(J_src).

// --- $Span ---

// The side ink reaches the places no nearer a corner than the ink itself.
copy($Span(), J_out, J_src) :- side_place(J_out), side_place(J_src), J_out >= J_src.
