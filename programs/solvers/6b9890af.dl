// 6b9890af
// @draft
// @keywords: crop scale border
// input: a rectangle outline in the frame color, and a small object of
//  another color, sitting apart on bg
// output: The output is the outline's box, cropped: its edge lines keep the
//  frame color, and its hole holds the object blown up to fill it, each
//  object cell a block, bg elsewhere.

// how the frame color is found
.type Choice =
    // the frame color is stored
    Stored {}
    // the frame color is the one whose cells draw a rectangle outline
  | Drawn {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color)  bg(0).

    // --- Stored ---
    .decl frame(col: Color)  frame(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Stored()). impl_choice($Drawn()).

// --- the frame color ---

.decl frame_col(col: Color, ch: Choice)

// --- Stored ---
frame_col(Col, $Stored()) :- params.frame(Col).

// --- Drawn ---
.init drect = Outlines<Color>
drect.node(Col, P) :- in(P, Col), !params.bg(Col).

frame_col(Col, $Drawn()) :- drect.box(Col, _).

// --- the frame, viewed in its own box ---

.init frame_box = Bbox<Choice>
frame_box.cell(Ch, P) :- frame_col(Col, Ch), in(P, Col).

// The cells the frame's edge lines enclose.
.init hole = Bbox<Choice>
hole.cell(Ch, P) :- frame_box.box(Ch, B), in(P, _), interior(P, B).

// --- the object, viewed in its own box ---

.decl object_cell(ch: Choice, p: Position, col: Color)
object_cell(Ch, P, Col) :- impl_choice(Ch), in(P, Col), !params.bg(Col), !frame_col(Col, Ch).

.init object_box = Bbox<Choice>
object_box.cell(Ch, P) :- object_cell(Ch, P, _).

// The object as a block arrangement: each cell at its box position.
.decl tile_col(ch: Choice, p_tile: Position, col: Color)
tile_col(Ch, P_tile, Col) :-
    object_cell(Ch, P_grid, Col), object_box.box(Ch, B), crop(P_grid, B, P_tile).

// The hole divided into the object's block arrangement.
.init blocks = Divide2D<Choice>
blocks.cell(P_hole) :- hole.cell(Ch, P), hole.box(Ch, B), crop(P, B, P_hole).
blocks.dim(Ch, A, N) :- object_box.cell(Ch, P), object_box.box(Ch, B), box_extent(B, P, A, N).
blocks.gap(0).

out(P_inner, Col, Ch) :-
    frame_box.box(Ch, B), in(P_grid, _), crop(P_grid, B, P_inner),  // box cell, in the box's frame
    ( box_edge(P_grid, B, _), frame_col(Col, Ch)                    // edge line
    ; hole.box(Ch, B_hole), crop(P_grid, B_hole, P_hole),           // hole cell, in the hole's frame
      blocks.tile(Ch, P_hole, P_tile, _),                           // its block
      ( tile_col(Ch, P_tile, Col)                                   // block the object fills
      ; !tile_col(Ch, P_tile, _), params.bg(Col)                    // blank block
      )
    ).
