// 62c24649
// @representative: 67e8384a

// how each tile of the 2x2 arrangement is filled from the input
.type Choice =
    // each tile holds the input transformed by a stored per-tile D4 element
    Lookup {}
    // each tile holds the input reflected across the axes it crosses from the anchor tile
  | Mirror {}
    // the anchor tile holds the input, and each further tile reflects its neighbor across their shared edge
  | Unfold {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Mirror, $Unfold ---
    .decl arr_dim(k: number) arr_dim(2).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(K), helpers.frame_pos([K, K], P).

    .decl anchor(d: DiagDir)
    anchor(DIAG_TL).

    // --- $Unfold ---
    // The tiles in one period of the reflection lattice: a tile and its mirror.
    .decl lattice_period(k: number) lattice_period(2).

    // --- $Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_2x2(tile_d4,
        D4_ID, D4_LR,
        D4_TB, D4_HT)
}

.init params = Params

// --- $Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                            // input cell
    params.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).                   // recompose

// --- $Mirror ---
// Per-axis within-tile image.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P_img) :-
    in(P, _),
    params.arr_pos(T), params.anchor(Diag), dir_of(Diag, A, D),
    ( dist(T, D, 0), P_img = P                        // anchor side — passes through
    ; !dist(T, D, 0),                                 // far side — flips
      flip_of(A, F), apply(F, P, P_img)
    ).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- $Unfold ---
// Per-axis within-tile image: the reflections across shared tile edges
// alternate, so a tile a whole number of lattice periods from the anchor side
// passes through, and the tile between flips.
.decl unfold(a: Axis, p_tile: Position, p: Position, p_img: Position)
unfold(A, T, P, P_img) :-
    in(P, _),
    params.arr_pos(T), params.anchor(Diag), dir_of(Diag, A, D),
    dist(T, D, K), params.lattice_period(N), stride(K, N, 0, _, R),   // phase in the lattice
    ( R = 0, P_img = P                                     // in phase — passes through
    ; R != 0, flip_of(A, F), apply(F, P, P_img)            // out of phase — flips
    ).

out(P_grid, Col, $Unfold()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    unfold(A1, T, P_in, P1), unfold(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose
