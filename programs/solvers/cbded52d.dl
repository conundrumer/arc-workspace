// cbded52d
// @keywords: decompose markers span cast
// input: separator lines cut the grid into a tile arrangement over a
//  base color
// output: Two same-color marks (non-base cells) at one intile position,
//  aligned along a tile row or column, act on their line.

// the grid is 8×8, so its tile arrangement reads two ways
.type DecChoice =
    // params.arr tiles per axis
    Count {}
    // tiles of params.tile_dim, as many as the grid holds
  | Size {}

// how a marked line fills
.type Fill =
    // fills the tiles between the two marks
    Span {}
    // fills the whole line
  | Line {}

.type Choice    = [d: DecChoice, f: Fill]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl gap(g: number) gap(1).
    .decl base(col: Color) base(1).

    // --- $Count ---
    .decl arr(n: number) arr(3).

    // --- $Size ---
    .decl tile_dim(k: number) tile_dim(2).
}

.init params = Params

.decl dec_choice(dc: DecChoice)
dec_choice($Count()). dec_choice($Size()).

.decl fill_choice(f: Fill)
fill_choice($Span()). fill_choice($Line()).

// Grid cell within the tile arrangement.
.decl tile(dc: DecChoice, p_grid: Position, p_tile: Position, p_intile: Position)
tile($Count(), P_grid, P_tile, P_intile) :-
    in(P_grid, _), params.arr(N), params.gap(G),                 // tile count
    divide_2d(P_grid, N, G, P_tile, P_intile).
tile($Size(), P_grid, P_tile, P_intile) :-
    in(P_grid, _), params.tile_dim(K), params.gap(G),            // tile size
    divide_by_size_2d(P_grid, K, G, P_tile, P_intile).

.type Mark = [d: DecChoice, col: Color, p_intile: Position]

.decl mark(m: Mark, p_tile: Position)
mark([Dc, Col, P_intile], P_tile) :-
    in(P_grid, Col), !params.base(Col),
    tile(Dc, P_grid, P_tile, P_intile).

.init btw = Between<Mark>
btw.axis(M, A) :- mark(M, _), axis_elem(A).
btw.cell([Dc, Col, P_intile], P_tile) :- mark([Dc, Col, P_intile], _), tile(Dc, _, P_tile, _).
btw.mark(M, P_tile) :- mark(M, P_tile).

.decl fill(ch: Choice, p_tile: Position, col: Color, p_intile: Position)

// --- $Span ---
fill([Dc, $Span()], P_tile, Col, P_intile) :- btw.between([Dc, Col, P_intile], P_tile).

// --- $Line ---
fill([Dc, $Line()], P_tile, Col, P_intile) :-
    tile(Dc, _, P_tile, _),
    mark([Dc, Col, P_intile], Q1), mark([Dc, Col, P_intile], Q2), Q1 != Q2,  // two distinct marks
    axis_elem(A), same_line(A, Q1, Q2), same_line(A, Q1, P_tile).            // P_tile on the marks' line

.decl impl_choice(ch: Choice)
impl_choice([Dc, F]) :- dec_choice(Dc), fill_choice(F).

.decl filled(ch: Choice, p_grid: Position, col: Color)
filled([Dc, F], P_grid, Col) :-
    fill([Dc, F], P_tile, Col, P_intile),
    tile(Dc, P_grid, P_tile, P_intile).

out(P, Col, Ch) :- filled(Ch, P, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !filled(Ch, P, _).
