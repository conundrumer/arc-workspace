// 22eb0ac0
// concept: lines markers span
// Marker cells sit on the two c.axis edges; a line whose two edge cells hold
// the same color fills with it, the rest passes through. Two claims of where
// markers may sit and what fills, tagged on out's Choice:
//
//   $Flood — matching markers on a line's two edge cells flood the whole line.
//   $Span  — any same-colored marker pair in a line paints the cells between,
//            marks included.

#include "../lib.dl"

.type Choice = Flood {} | Span {}

.comp Consts {
    .decl axis(a: Axis) axis(AXIS_H).   // lines run along this axis
    .decl bg(c: Color)  bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, ch: Choice)

// --- Flood ---

// Line (keyed by across component) whose two edge cells hold the same marker color.
.decl edge_match(ac: Position, col: Color)
edge_match(Ac, Col) :-
    c.axis(A), axis_of(D, A), opposite(D, D2),            // the line's two edges
    in(P1, Col), dist(P1, D, 0), split(P1, A, _, Ac),     // marker on edge d
    in(P2, Col), dist(P2, D2, 0), split(P2, A, _, Ac),    // same color opposite, same line
    !c.bg(Col).                                           // markers are non-bg

.decl matched(ac: Position)
matched(Ac) :- edge_match(Ac, _).

out(P, Col, $Flood()) :- in(P, _), c.axis(A), split(P, A, _, Ac), edge_match(Ac, Col).
out(P, Col, $Flood()) :- in(P, Col), c.axis(A), split(P, A, _, Ac), !matched(Ac).

// --- Span ---

// Per-color rays from the markers, cast both ways along the axis.
.init rays = Ray<Color>
rays.dir(D)       :- c.axis(A), axis_of(D, A).
rays.cell(P)      :- in(P, _).
rays.mark(Col, Q) :- in(Q, Col), !c.bg(Col).

// Between two same-colored markers of its line — inclusive reach, so a
// marker repaints its own color.
.decl span(p: Position, col: Color)
span(P, Col) :- rays.ray(Col, P, D), opposite(D, D2), rays.ray(Col, P, D2).

.decl spanned(p: Position)
spanned(P) :- span(P, _).

out(P, Col, $Span()) :- span(P, Col).
out(P, Col, $Span()) :- in(P, Col), !spanned(P).

.output out(IO=stdout)
