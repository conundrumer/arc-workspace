// 22eb0ac0
// @keywords: lines markers span
// output: A line along params.axis that holds two cells of one color takes
//  that color; every other cell passes through.

// which pair of cells counts, and how far its color reaches
.type Choice =
    // the line's two edge cells, when they agree: the whole line
    Flood {}
    // any two cells of one non-bg color: the cells between them, the pair
    // included
  | Span {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl axis(a: Axis) axis(AXIS_H).   // lines run along this axis

    // --- Span ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// --- Flood ---

// Line, keyed by its across component, whose two edge cells hold one color.
.decl edge_match(ac: Position, col: Color)
edge_match(Ac, Col) :-
    params.axis(A), axis_of(D, A), opposite(D, D2),    // the line's two edges
    in(P1, Col), dist(P1, D, 0), split(P1, A, _, Ac),  // cell on edge d, its line
    in(P2, Col), dist(P2, D2, 0), same_line(A, P1, P2).

out(P, Col_out, $Flood()) :-
    in(P, Col), params.axis(A), split(P, A, _, Ac),  // grid cell, its line
    ( edge_match(Ac, Col_out)                        // the edges agree — flood
    ; !edge_match(Ac, _), Col_out = Col              // no match — as-is
    ).

// --- Span ---

.init spans = Between<Color>
spans.axis(Col, A) :- spans.mark(Col, _), params.axis(A).
spans.cell(Col, P) :- spans.mark(Col, _), in(P, _).
spans.mark(Col, Q) :- in(Q, Col), !params.bg(Col).

out(P, Col, $Span()) :- spans.between(Col, P).
out(P, Col, $Span()) :- in(P, Col), !spans.between(_, P).
