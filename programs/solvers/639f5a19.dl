// 639f5a19
// @draft
// @keywords: objects border lookup bbox crop enclose
// input: Solid ink rectangles sit on the background.
// output: Each one is repainted: a band runs inside its edges, and each band
//  cell takes the color of the quadrant of the object's bounding box it sits
//  in. What the band encloses takes one color.

// how deep a cell lies
.type Choice =
    // distance to the nearest edge of the bounding box
    Inset {}
    // erosion from the object's own outline
  | Erode {}

// --- shared ---

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // How deep the band runs from the rectangle's edge.
    .decl band_depth(k: number) band_depth(2).

    .decl corner_color(diag: DiagDir, col: Color)
    corner_color(DIAG_TL, 6). corner_color(DIAG_TR, 1).
    corner_color(DIAG_BL, 2). corner_color(DIAG_BR, 3).

    .decl core_color(col: Color) core_color(4).
}

.init params = Params

.init objs = Components<Unit>
objs.node($U(), P) :- in(P, Col), !params.bg(Col).

// Each object's bounding box.
.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- objs.label($U(), P, Id).

// Each object cell in its bounding box's frame.
.decl box_cell(id: Ident, p: Position, p_inner: Position)
box_cell(Id, P, P_inner) :- bbox.cell(Id, P), bbox.box(Id, B), crop(P, B, P_inner).

// Which quadrant of its box an object cell sits in.
.init quad = DiagPlacement<Ident>
quad.cell(Id, P_inner) :- box_cell(Id, _, P_inner).

.decl impl_choice(ch: Choice)
impl_choice($Inset()). impl_choice($Erode()).

// Every object here is a solid rectangle, where the two depths agree; a
// ragged object splits them.
.decl band_cell(p: Position, ch: Choice)

// --- $Inset ---

// Nearer some edge of its bounding box than the band is deep.
band_cell(P, $Inset()) :-
    box_cell(_, P, P_inner),
    dir_elem(D), dist(P_inner, D, K), params.band_depth(N), K < N.

// --- $Erode ---

.init rim = Rim<Ident>
rim.cell(Id, P) :- objs.label($U(), P, Id).

// Fewer steps inward from the object's outline than the band is deep.
band_cell(P, $Erode()) :- rim.depth(_, P, K), params.band_depth(N), K < N.

// --- $Inset, $Erode ---

out(P, Col, Ch) :- in(P, Col), params.bg(Col), impl_choice(Ch).

out(P, Col, Ch) :-
    band_cell(P, Ch), box_cell(Id, P, P_inner),
    quad.quadrant(Id, P_inner, G), params.corner_color(G, Col).

out(P, Col, Ch) :-
    objs.label($U(), P, _), impl_choice(Ch), !band_cell(P, Ch),   // what the band encloses
    params.core_color(Col).

.comp Determine {
    .type ObjKey = [e: Example, id: Ident]
    .type EP = [e: Example, p: Position]

    .init bg_count = Mode<Unit, Color, EP>
    bg_count.item($U(), Col, [E, P]) :- ex_in(E, P, Col).

    .decl bg(col: Color)
    bg(Col) :- bg_count.mode($U(), Col).

    // Each object is repainted in place, so each output's objects are its
    // input's.
    .init objs = Components<Example>
    objs.node(E, P) :- ex_out(E, P, Col), !params.bg(Col).

    .init bbox = Bbox<ObjKey>
    bbox.cell([E, Id], P) :- objs.label(E, P, Id).

    .decl corner_color(diag: DiagDir, col: Color)
    corner_color(G, Col) :-
        bbox.cell([E, Id], P), bbox.box([E, Id], B), box_corner(P, B, G),
        ex_out(E, P, Col).

    // The one color the band does not carry.
    .decl core_color(col: Color)
    core_color(Col) :- objs.label(E, P, _), ex_out(E, P, Col), !corner_color(_, Col).

    // The core, seen in its object's frame: its margin from that frame's
    // edges is how deep the band runs.
    .init core_box = Bbox<ObjKey>
    core_box.cell([E, Id], P_inner) :-
        bbox.cell([E, Id], P), bbox.box([E, Id], B), crop(P, B, P_inner),
        ex_out(E, P, Col), core_color(Col).

    .decl band_depth(k: number)
    band_depth(K) :- core_box.box(_, B), dir_elem(D), dist(B, D, K).
}
