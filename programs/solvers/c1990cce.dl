// c1990cce
// @keywords: grow markers cast wallpaper
// input: a 1×W row, bg except one ink cell
// output: the output grows the row into a W×W square: the ink casts two
//  diagonal rays toward the far edge (a V), and echo diagonals of
//  params.echo on params.echo_axis fill the open cone between them

// V color
.type VSrc =
    // the ink's own color propagates to the V
    VSeed {}
    // an independent params.v_color
  | VFixed {}

// echo placement
.type Echo =
    // every params.spacing-th cell along the mirror arm's line casts an echo
    // ray
    Emit {}
    // echoes at every params.period-th diagonal offset from the echo-axis arm
  | Stripe {}

// V color crossed with echo placement
.type Choice = [v: VSrc, e: Echo]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl grow(d: Dir) grow(DIR_B).
    .decl echo_axis(da: DiagAxis) echo_axis(DAXIS_DG).
    .decl echo(col: Color) echo(1).

    // --- $VFixed ---
    .decl v_color(col: Color) v_color(2).

    // --- $Emit ---
    .decl spacing(k: number) spacing(2).

    // --- $Stripe ---
    .decl period(k: number) period(4).
}

.init params = Params

// Output frame: square on the input's long extent.
.decl side(n: number)
side(N) :- in(P, _), axis_dims(P, _, N, K), N > K.

.init frame = Frame2D<Unit>
frame.extent($U(), A, N) :- axis_elem(A), side(N).

// The ink cell, seated in the output frame on the edge opposite params.grow.
.decl seed(p: Position, col: Color)
seed(P_out, Col) :-
    in(P_in, Col), !params.bg(Col),                   // ink cell
    frame.cell($U(), P_out),
    params.grow(D), opposite(D, D0),                  // seat edge
    slab_anchor(D0, P_in, P_out).

// The two cone corners on the params.grow side; the one on the echo axis, and
// the mirror arm's.
.decl corner(diag: DiagDir)
corner(Diag) :- params.grow(D), dir_of(Diag, _, D).

.decl cast_corner(diag: DiagDir)
cast_corner(Diag) :- corner(Diag), diag_axis_of(Diag, DA), params.echo_axis(DA).

.decl mirror_corner(diag: DiagDir)
mirror_corner(Diag) :- corner(Diag), !cast_corner(Diag).

// The V: the seed's line toward each cone corner.
.decl arm(p: Position)
arm(P) :-
    frame.cell($U(), P), seed(S, _),
    corner(Diag), diag_axis_of(Diag, DA),  // the corner's diagonal
    same_line(DA, P, S).

// Strictly inside the V's cone.
.decl within(p: Position)
within(P) :-
    frame.cell($U(), P), seed(S, _),
    cast_corner(CD),   nearer(CD, P, S),
    mirror_corner(MD), nearer(MD, P, S).

// --- Echo cases: the echoed cells ---

.decl echo_choice(e: Echo)
echo_choice($Emit()).
echo_choice($Stripe()).

.decl echo(p: Position, e: Echo)

// $Emit — emitters march along the mirror arm's line, every params.spacing-th
// cell from the seed, continuing past the grid edge while rows remain;
// each casts an echo ray.
.decl march_jump(delta: Position)
march_jump(J) :- mirror_corner(MD), params.spacing(S), jump_offset(MD, S, J).

.decl emitter(p: Position)
emitter(P) :- seed(P, _).
emitter(P2) :-
    emitter(P1), march_jump(J), compose(P1, J, P2),
    params.grow(D), dist(P2, D, K), K >= 0.           // rows remain

.init rays = Ray<Unit>
rays.dir($U(), Diag) :- cast_corner(Diag).
rays.cell($U(), P)   :- frame.cell($U(), P).
rays.mark($U(), P)   :- emitter(P).

echo(P, $Emit()) :- rays.ray($U(), P, _, _, _), !arm(P).

// $Stripe — diagonal offset from the echo-axis arm is a multiple of
// params.period: the same corner_dist class from the mirror corner as the seed.
echo(P, $Stripe()) :-
    within(P), seed(S, _),
    mirror_corner(MD), corner_dist(P, MD, Kp), corner_dist(S, MD, Ks),
    params.period(Per), stride(Kp, Per, 0, _, R), stride(Ks, Per, 0, _, R).

// --- V color cases ---

.decl v_choice(v: VSrc)
v_choice($VSeed()).
v_choice($VFixed()).

.decl v_color(col: Color, v: VSrc)
v_color(Col, $VSeed())  :- seed(_, Col).
v_color(Col, $VFixed()) :- params.v_color(Col).

// --- Output ---

out(P, Col, [V, E]) :- arm(P), v_color(Col, V), echo_choice(E).
out(P, Col, [V, E]) :- echo(P, E), params.echo(Col), v_choice(V).
out(P, Col, [V, E]) :-
    frame.cell($U(), P), !arm(P), !echo(P, E),   // cell outside V and echoes
    echo_choice(E), v_choice(V), params.bg(Col).

.comp Determine {
    // The ink cell, seated in the output frame.
    .decl seed(e: Example, p: Position)
    seed(E, P_out) :-
        ex_in(E, P_in, Col), !params.bg(Col),             // ink cell
        ex_out(E, P_out, _),
        params.grow(D), opposite(D, D0),                  // seat edge
        slab_anchor(D0, P_in, P_out).

    // The echoed cells an output shows.
    .decl echoed(e: Example, p: Position)
    echoed(E, P) :- ex_out(E, P, Col), params.echo(Col).

    // Strictly inside the V's cone.
    .decl within(e: Example, p: Position)
    within(E, P) :-
        ex_out(E, P, _), seed(E, S),
        cast_corner(CD),   nearer(CD, P, S),
        mirror_corner(MD), nearer(MD, P, S).

    .decl cand(k: number)
    cand(K) :-
        ex_out(_, P, _),
        mirror_corner(MD), corner_dist(P, MD, K), K != 0.

    // The cells a candidate period echoes.
    .decl striped(e: Example, p: Position, k: number)
    striped(E, P, Per) :-
        cand(Per), within(E, P), seed(E, S),
        mirror_corner(MD), corner_dist(P, MD, Kp), corner_dist(S, MD, Ks),
        stride(Kp, Per, 0, _, R), stride(Ks, Per, 0, _, R).

    // A candidate that echoes a cell the pair does not, or misses one it does.
    .decl mismatch(k: number)
    mismatch(Per) :- striped(E, P, Per), !echoed(E, P).
    mismatch(Per) :- cand(Per), echoed(E, P), !striped(E, P, Per).

    .decl period(k: number)
    period(Per) :- cand(Per), !mismatch(Per).
}
