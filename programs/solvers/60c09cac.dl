// 60c09cac
// Layout: 2× scale. Each input cell expands to a 2×2 block of the same
// color in the output frame.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl intile(p: Position)
    intile(P) :- helpers.frame_pos([2, 2], P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_tile, Col),                                  // input cell as tile pos
    c.intile(P_intile),                               // intile pos (2×2 frame)
    concat_2d(P_tile, P_intile, 0, P_grid_out).       // 2D recompose

.output out(IO=stdout)
