// 60c09cac
// @keywords: scale
// output: Layout: 2× scale. Each input cell expands to a 2×2 block of the same
//  color in the output frame.

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl scale(k: number) scale(2).
    .decl intile(p: Position)
    intile(P) :- scale(K), helpers.frame_pos([K, K], P).
}

.init params = Params

out(P_grid_out, Col) :-
    in(P_tile, Col),                                  // input cell as tile pos
    params.intile(P_intile),                          // intile pos (2×2 frame)
    concat_2d(P_tile, P_intile, 0, P_grid_out).       // 2D recompose
