// f3e14006
// @draft
// @keywords: lines markers span wallpaper parity cross
// @scene two-crossing-lines: on a field of params.background, one straight
//  line runs along the bar axis (the bar line) and one runs across it (the
//  cross line), and the two meet at one cell.
// @scene line-colors: each line has a base color and exactly two cells of a
//  mark color of its own; the four colors are distinct, and the crossing cell
//  holds one line's base color.
// @scene cross-marks-one-side: both marks of the cross line lie on one side of
//  the bar line.
// @rule rectangle: the output keeps only a rectangle on a field of
//  params.background; its extent along the bar axis is the span between the
//  bar line's two marks, and its extent across is the span from the bar line
//  to the farther mark of the cross line.
// @rule lattice: the bar axis is the axis of params.along_start; the hole
//  lines along the bar axis are those a whole number of params.period lines
//  from the bar line, and the hole lines across it are those a whole number
//  of params.period lines from the rectangle's params.along_start edge; a
//  cell on hole lines of both axes is a hole, a line along the bar axis that
//  is no hole line is a bar thread, and a line across it that is no hole line
//  is a cross thread.
// @rule thread-colors: a bar thread takes the bar line's base color and a
//  cross thread the cross line's base color; where two threads cross, the
//  cell takes the base color the input's crossing cell shows.
// @rule hole-colors: a hole on a line along the bar axis that meets the cross
//  line within the span of the cross line's two marks takes the cross line's
//  mark color, and every other hole takes the bar line's mark color.

// which end of the rectangle, across the bar axis, starts with a hole line
.type AnchorAcross =
    // @claim lattice
    AnchorAcrossBarLine {}
    // @rule lattice: the hole lines along the bar axis start at the
    //  rectangle's edge a quarter turn params.across_sense from the
    //  params.along_start edge in place of the bar line.
    // @witness anchor-across-bar-line: ordinary concept
  | AnchorAcrossSide {}

// which end of the rectangle, along the bar axis, starts with a hole line
.type AnchorAlong =
    // @claim lattice
    AnchorAlongSide {}
    // @rule lattice: the hole lines across the bar axis start at the bar mark
    //  nearer the cross line in place of the params.along_start edge, and at
    //  both bar marks where the two are equally near; the bar axis is
    //  params.bar_axis, and where the hole lines along it start at a stored
    //  edge, it is the axis across the params.across_start edge.
    // @witness anchor-along-near-cross: ordinary concept
  | AnchorAlongNearCross {}

.type Choice = [across: AnchorAcross, along: AnchorAlong]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed two-crossing-lines
    .decl background(c: Color) background(0).
    // the lattice repeats every period lines on each axis
    .decl period(k: number) period(2).

    // --- $AnchorAlongSide ---
    // the rectangle's edge, along the bar axis, that hole lines start from
    .decl along_start(d: Dir) along_start(DIR_L).

    // --- $AnchorAcrossSide & $AnchorAlongSide ---
    // the quarter turn from the along_start edge to the rectangle's edge,
    // across the bar axis, that hole lines start from
    .decl across_sense(s: Sense) across_sense(SENSE_CW).

    // --- $AnchorAcrossSide & $AnchorAlongNearCross ---
    // the rectangle's edge, across the bar axis, that hole lines start from
    .decl across_start(d: Dir) across_start(DIR_T).

    // --- $AnchorAcrossBarLine & $AnchorAlongNearCross ---
    // the axis the bar line runs along
    .decl bar_axis(a: Axis) bar_axis(AXIS_H).
}

.init params = Params

// The cells of the two lines.
.decl ink(p: Position)
ink(P) :- in(P, Col), !params.background(Col).

// A cell of the line that runs along axis a: it shares that line with another
// line cell.
.decl line_cell(a: Axis, p: Position)
line_cell(A, P) :- ink(P), ink(Q), P != Q, axis_elem(A), same_line(A, P, Q).

// The cell where the two lines meet.
.decl crossing(p: Position, col: Color)
crossing(P, Col) :- line_cell(A, P), perp(A, A2), line_cell(A2, P), in(P, Col).

// A line's base color is the commonest color of its cells off the crossing.
// @claim line-colors
.init line_color = Mode<Axis, Color, Position>
line_color.item(A, Col, P) :- line_cell(A, P), !crossing(P, _), in(P, Col).

// A mark of the line along axis a: a cell off the crossing that is not of the
// line's base color.
.decl mark(a: Axis, p: Position, col: Color)
mark(A, P, Col) :- line_color.item(A, Col, P), !line_color.mode(A, Col).

// With the bar line along axis a, the rectangle bounds the bar marks and the
// cells where a bar mark's line across a meets a cross mark's line along it.
// @claim rectangle
.init rect = Bbox<Axis>
rect.cell(A, M) :- mark(A, M, _).
rect.cell(A, Q) :-
    perp(A, A2), mark(A, M, _), mark(A2, N, _),
    in(Q, _), same_line(A, Q, N), same_line(A2, Q, M).

// A cell of the rectangle with the bar line along axis a, in the rectangle's
// own frame.
.decl rect_cell(a: Axis, p: Position, p_inner: Position)
rect_cell(A, P, P_inner) :- in(P, _), rect.box(A, B), crop(P, B, P_inner).

// --- $AnchorAcrossBarLine ---
// With the bar line along axis a, the rectangle's edge the bar line lies on.
.decl bar_line_edge(a: Axis, d: Dir)
bar_line_edge(A, D) :-
    perp(A, A2), axis_of(D, A2), mark(A, M, _), rect.box(A, B), box_edge(M, B, D).

// --- $AnchorAlongNearCross ---
// With the bar line along axis a, the rectangle's edge whose bar mark the
// crossing is no farther from than from the other.
.decl near_cross_edge(a: Axis, d: Dir)
near_cross_edge(A, D) :-
    axis_of(D, A), crossing(X, _), rect.box(A, B),
    relative(B, X, X_rel), dist_pair(X_rel, D, K, K2), K <= K2.

// The axis the bar line runs along, the rectangle's edge, across that axis,
// that hole lines start from, and the rectangle's edge, along it, that hole
// lines start from.
.decl lattice(a: Axis, d_across: Dir, d_along: Dir, fa: AnchorAcross, fl: AnchorAlong)

// --- concept ---
lattice(A, D_across, D_along, $AnchorAcrossBarLine(), $AnchorAlongSide()) :-
    params.along_start(D_along), axis_of(D_along, A), bar_line_edge(A, D_across).

// --- $AnchorAcrossSide & $AnchorAlongSide ---
lattice(A, D_across, D_along, $AnchorAcrossSide(), $AnchorAlongSide()) :-
    params.along_start(D_along), axis_of(D_along, A),
    params.across_sense(S), turn(S, D_along, D_across).

// --- $AnchorAcrossSide & $AnchorAlongNearCross ---
lattice(A, D_across, D_along, $AnchorAcrossSide(), $AnchorAlongNearCross()) :-
    params.across_start(D_across), axis_of(D_across, A_across), perp(A_across, A),
    near_cross_edge(A, D_along).

// --- $AnchorAcrossBarLine & $AnchorAlongNearCross ---
lattice(A, D_across, D_along, $AnchorAcrossBarLine(), $AnchorAlongNearCross()) :-
    params.bar_axis(A), bar_line_edge(A, D_across), near_cross_edge(A, D_along).

// --- $AnchorAcrossBarLine, $AnchorAcrossSide ---
// With the bar line along axis a, a rectangle cell a whole number of periods
// from edge d.
.decl even(a: Axis, p: Position, d: Dir)
even(A, P, D) :-
    rect_cell(A, P, P_inner), dir_elem(D), dist(P_inner, D, K),
    params.period(W), stride(K, W, 0, _, 0).

// With the bar line along axis a, the span of the cross line's marks.
// @claim hole-colors
.init cross_span = Bbox<Axis>
cross_span.cell(A, N) :- perp(A, A2), mark(A2, N, _).

// With the bar line along axis a, a rectangle cell whose line along a meets
// the cross line within the span of its marks.
.decl in_cross_span(a: Axis, p: Position)
in_cross_span(A, P) :-
    rect_cell(A, P, _), perp(A, A2), line_cell(A2, Q),
    same_line(A, P, Q), cross_span.box(A, B), inside(Q, B).

.decl woven(p: Position, col: Color, ch: Choice)
woven(P, Col, [Fa, Fl]) :-
    lattice(A, Da, Dl, Fa, Fl), rect_cell(A, P, _), perp(A, A2),
    ( even(A, P, Da), even(A, P, Dl), in_cross_span(A, P), mark(A2, _, Col)    // hole in the cross marks' span
    ; even(A, P, Da), even(A, P, Dl), !in_cross_span(A, P), mark(A, _, Col)    // other hole
    ; !even(A, P, Da), even(A, P, Dl), line_color.mode(A, Col)                 // bar thread
    ; even(A, P, Da), !even(A, P, Dl), line_color.mode(A2, Col)                // cross thread
    ; !even(A, P, Da), !even(A, P, Dl), crossing(_, Col)                       // threads crossing
    ).

out(P, Col, Ch) :- woven(P, Col, Ch).
out(P, Col, [Fa, Fl]) :-
    lattice(A, _, _, Fa, Fl), rect.box(A, _), in(P, _), !rect_cell(A, P, _),
    params.background(Col).

.comp Determine {
    // The commonest color of each train input.
    .init common = Mode<Example, Color, Position>
    common.item(E, Col, P) :- ex_in(E, P, Col), ex_out(E, _, _).

    // A color that some train input's commonest color is not.
    .decl background_defect(c: Color)
    background_defect(Col) :- common.mode(_, Col), common.item(E, _, _), !common.mode(E, Col).

    .decl background(c: Color)
    background(Col) :- common.mode(_, Col), !background_defect(Col).

    // The rectangle of each train output.
    .init out_ink = Bbox<Example>
    out_ink.cell(E, P) :- ex_out(E, P, Col), !background(Col).

    // A line cell of a train input at a corner of its output's rectangle: a
    // bar mark.
    .decl corner_ink(e: Example, p: Position)
    corner_ink(E, P) :-
        ex_in(E, P, Col), !background(Col), out_ink.box(E, B), box_corner(P, B, _).

    .decl bar_axis(a: Axis)
    bar_axis(A) :- corner_ink(E, P), corner_ink(E, Q), P != Q, axis_elem(A), same_line(A, P, Q).
}
