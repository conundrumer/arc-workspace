// 0becf7df
// concept: markers mapping lookup
// A key block sits at a corner; its cells pair up and paired colors swap.
// Cells outside the key recolor by the swap; the key and unmapped colors
// pass through. $Line pairs the two cells on each key line along a
// stored axis; $Map pairs cells by a stored position correspondence.

#include "../lib.dl"

.type Choice = Line {} | Map {}

.comp Consts {
    // --- shared ---
    // Corner the key block sits at.
    .decl corner(d: DiagDir)
    corner(DIAG_TL).

    // Key block extent per axis.
    .decl key_dim(a: Axis, n: number)
    key_dim(AXIS_V, 2).
    key_dim(AXIS_H, 2).

    // --- Line ---
    // Axis along which a pair's two members lie.
    .decl axis(a: Axis)
    axis(AXIS_H).

    // --- Map ---
    // Pairing as an id join over the key frame: src labels the key cells,
    // dst gives each cell the id of its partner.
    .decl src(p: Position, id: Ident)
    GRID_2x2(src,
        0, 1,
        2, 3)

    .decl dst(p: Position, id: Ident)
    GRID_2x2(dst,
        1, 0,
        3, 2)

    .decl pair(p1: Position, p2: Position)
    pair(P1, P2) :- src(P1, Id), dst(P2, Id).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Line()). impl_choice($Map()).

// Cells of the key block.
.decl key_cell(p: Position)
key_cell(P) :-
    in(P, _),                                        // grid cell
    c.corner(Diag), diag_dist(P, Diag, A, K1, K2),   // dists to corner edges
    c.key_dim(A, N1), K1 < N1,                       // within extent on A
    perp(A, A2), c.key_dim(A2, N2), K2 < N2.         // and across

.decl mapping(c1: Color, c2: Color, ch: Choice)

// --- Line ---
// Two key cells on one line along the pair axis pair up, in both orders.
mapping(C1, C2, $Line()) :-
    key_cell(P1), in(P1, C1),                             // one key cell
    key_cell(P2), in(P2, C2), P1 != P2,                   // a distinct one
    c.axis(A), split(P1, A, _, Ac), split(P2, A, _, Ac).  // same line

// --- Map ---
// The stored pairing, anchored at the key's corner.
mapping(C1, C2, $Map()) :-
    c.corner(Diag), c.pair(I1, I2),
    corner_anchor(Diag, P1, I1), in(P1, C1),
    corner_anchor(Diag, P2, I2), in(P2, C2).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col_out, Ch) :-
    impl_choice(Ch), in(P, Col),
    ( key_cell(P), Col_out = Col                          // key cell — kept
    ; !key_cell(P), mapping(Col, Col_out, Ch)             // mapped
    ; !key_cell(P), !mapping(Col, _, Ch), Col_out = Col   // unmapped — kept
    ).

// --- fit ---

.comp Fit {
    .decl mapping(e: Example, c1: Color, c2: Color)
    mapping(E, C1, C2) :- ex_in(E, P, C1), ex_out(E, P, C2), C1 != C2.

    // A key cell keeps a color the rest of the grid recolors.
    .decl key_cell(e: Example, p: Position)
    key_cell(E, P) :- ex_in(E, P, Col), ex_out(E, P, Col), mapping(E, Col, _).

    .decl corner(d: DiagDir)
    corner(Diag) :- key_cell(_, P), diag_dist(P, Diag, _, 0, 0).

    // Distances from the corner's edges that key cells take, per axis.
    .decl key_dist(a: Axis, k: number)
    key_dist(A, K) :- key_cell(_, P), corner(Diag), diag_dist(P, Diag, A, K, _).

    .decl key_dim(a: Axis, n: number)
    key_dim(A, N) :- key_dist(A, _), N = count : { key_dist(A, K) }.

    .decl grid_partner(p1: Position, p2: Position)
    grid_partner(P1, P2) :-
        key_cell(E, P1), ex_in(E, P1, C1),    // one key cell
        key_cell(E, P2), ex_in(E, P2, C2),    // another
        mapping(E, C1, C2).                   // their colors swap

    .decl axis(a: Axis)
    axis(A) :-
        grid_partner(P1, P2),
        axis_elem(A), split(P1, A, _, Ac), split(P2, A, _, Ac).    // one line along a

    .init frame = Frame2D<Unit>
    frame.extent($U(), A, N) :- key_dim(A, N).

    .decl key_pos(p_grid: Position, p_key: Position)
    key_pos(P_grid, P_key) :-
        key_cell(_, P_grid), corner(Diag), frame.cell($U(), P_key),    // key cell, key frame cell
        corner_anchor(Diag, P_grid, P_key).                            // same dists to the corner's edges

    .decl partner(p1: Position, p2: Position)
    partner(P1, P2) :-
        grid_partner(P_grid1, P_grid2),
        key_pos(P_grid1, P1), key_pos(P_grid2, P2).

    .decl src(p: Position, id: Ident)
    src(P1, as(ord(P1), Ident)) :- partner(P1, _).

    .decl dst(p: Position, id: Ident)
    dst(P2, as(ord(P1), Ident)) :- partner(P1, P2).
}
