// 05f2a901
// concept: objects move
// Two objects lie along one axis: the params.mover one and the params.anchor one. The
// mover slides toward the anchor and stops on contact; the anchor stays.
//
// The cases differ in what counts as contact:
//   $Block  — head-on: the next step would put a mover cell on an anchor cell.
//   $Touch  — any side: a mover cell comes to rest beside an anchor cell.
//   $Extent — head-on between the two bounding boxes.

#include "../lib.dl"

.type Choice = Block {} | Touch {} | Extent {}

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mover(col: Color) mover(2).
    .decl anchor(col: Color) anchor(8).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Block()). impl_choice($Touch()). impl_choice($Extent()).

// --- objects ---

.decl mover_cell(p: Position)
mover_cell(P) :- in(P, Col), params.mover(Col).

.decl anchor_cell(p: Position)
anchor_cell(P) :- in(P, Col), params.anchor(Col).

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- mover_cell(P), params.mover(Col).
bbox.cell(Col, P) :- anchor_cell(P), params.anchor(Col).
bbox.grid(Col, P) :- bbox.cell(Col, _), in(P, _).

// --- direction of travel ---

// The anchor lies toward one edge from the mover, on a shared line.
.init cast = Ray<Unit>
cast.dir($U(), D)  :- dir_elem(D).
cast.cell($U(), P) :- anchor_cell(P).
cast.mark($U(), P) :- mover_cell(P).

.decl move_dir(d: Dir)
move_dir(D) :- dir_elem(D), cast.ray($U(), _, D, _, _).

// --- footprint and blocked cells ---

// The footprint that travels.
.decl shape(ch: Choice, p: Position)

// The cells the footprint may not enter: the slide ends one step short of
// covering one.
.decl blocked(ch: Choice, p: Position)

// --- Block ---

shape($Block(), P) :- mover_cell(P).

blocked($Block(), P) :- anchor_cell(P).

// --- Touch ---

shape($Touch(), P) :- mover_cell(P).

// One step along the travel past a cell beside the anchor.
blocked($Touch(), P2) :-
    anchor_cell(P), dir_elem(D), neighbor(P, D, P1),  // beside the anchor
    move_dir(D_move), neighbor(P1, D_move, P2).       // one step on

// --- Extent ---

shape($Extent(), P) :- params.mover(Col), bbox.inside(Col, P).

blocked($Extent(), P) :- params.anchor(Col), bbox.inside(Col, P).

// --- the slide ---

// Displacements toward the anchor the frame admits.
.decl shift(delta: Offset)
shift(Delta) :-
    in(P, _), move_dir(D),
    axis_of(D, A), sub_extent(P, A, K), jump_offset(D, K, Delta).

// The displacements at which the footprint would lie over a blocked cell.
.decl covering(ch: Choice, delta: Offset)
covering(Ch, Delta) :- shift(Delta), shape(Ch, P), compose(P, Delta, P2), blocked(Ch, P2).

// The mover stands where it is, and travels through the displacements that
// keep it clear of the blocked cells.
.init slide = Slide<Choice>
slide.dir(Ch, D) :- impl_choice(Ch), move_dir(D).
slide.node(Ch, ZERO) :- impl_choice(Ch).
slide.node(Ch, Delta) :- impl_choice(Ch), shift(Delta), !covering(Ch, Delta).

// --- output ---

.decl landed(ch: Choice, p: Position)
landed(Ch, P2) :- slide.rest(Ch, ZERO, _, Delta), mover_cell(P), compose(P, Delta, P2).

// The grid with the mover lifted off.
.decl cleared(p: Position, col: Color)
cleared(P, Col) :- in(P, Col), !mover_cell(P).
cleared(P, Col) :- mover_cell(P), params.bg(Col).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- landed(Ch, P), params.mover(Col).
out(P, Col, Ch) :- slide.rest(Ch, ZERO, _, _), cleared(P, Col), !landed(Ch, P).
