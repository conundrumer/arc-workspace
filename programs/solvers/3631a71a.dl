// 3631a71a
// @draft
// @representative: af22c60d

.decl out(p: Position, col: Color)

.comp Params {
    .decl mask(col: Color) mask(9).

    // Per axis, the mirror band: flush with edge `flush`, inset k from the
    // opposite edge.
    .decl mirror_band(a: Axis, flush: Dir, k: number)
    mirror_band(AXIS_V, DIR_B, 2).
    mirror_band(AXIS_H, DIR_R, 2).
}

.init params = Params

.decl masked(p: Position)
masked(P) :- in(P, Col), params.mask(Col).

// The axis flip, shifted onto the band. A cell outside the band lands off
// the grid and gets no image.
.decl mirror(p: Position, q: Position)
mirror(P, Q) :-
    in(P, _), params.mirror_band(A, D, K),  // cell and an axis band
    flip_of(A, F), apply(F, P, P_flip),     // flip the axis
    jump(P_flip, D, K, Q),                  // shift onto the band
    in(Q, _).                               // image is a grid cell

out(P, Col) :- in(P, Col), !masked(P).
out(P, Col) :- masked(P), mirror(P, Q), !masked(Q), in(Q, Col).

.comp Determine {
    // The axis flips, each followed by a shift, that fix each input's
    // visible cells.
    .init wp = Wallpaper<Example, Color>
    wp.transform(F) :- flip_of(_, F).
    wp.cell(E, P, Col) :- ex_in(E, P, Col), !params.mask(Col).
    wp.grid(E, P) :- ex_in(E, P, _).

    // A symmetry of some example that another example lacks.
    .decl unshared(d: D4, v: Offset)
    unshared(D, V) :- wp.symmetry(_, D, V), wp.grid(E, _), !wp.symmetry(E, D, V).

    // The band of an axis whose flip, shifted k toward the flush edge, every
    // example admits.
    .decl mirror_band(a: Axis, flush: Dir, k: number)
    mirror_band(A, D, K) :-
        flip_of(A, F), wp.symmetry(_, F, V), !unshared(F, V),
        axis_of(D, A), opposite(D, D_far), dist(V, D_far, K), K >= 0.
}
