// 575b1a71
// concept: markers rank
// c.mark cells recolor by their column's rank: columns holding a mark,
// ranked by dist from the c.rank_dir edge, map through c.rank_color.
// Other cells pass through.

#include "../lib.dl"

.comp Consts {
    .decl mark(c: Color) mark(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_L).

    .decl rank_color(r: number, c: Color)
    rank_color(0, 1).
    rank_color(1, 2).
    rank_color(2, 3).
    rank_color(3, 4).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl mark_dist(p: Position, k: number)
mark_dist(P, K) :- in(P, M), c.mark(M), c.rank_dir(D), dist(P, D, K).

.init o = Ordinal<Unit>
o.idx_set($U(), K) :- mark_dist(_, K).

.decl out(p: Position, col: Color)
out(P, Col) :- mark_dist(P, K), o.rank($U(), K, R), c.rank_color(R, Col).
out(P, Col) :- in(P, Col), !mark_dist(P, _).

.output out(IO=stdout)
