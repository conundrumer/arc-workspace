// 575b1a71
// concept: rank
// c.mark cells recolor by their column's rank: columns holding a mark,
// ranked by dist from the c.rank_dir edge, map through c.rank_color.
// Other cells pass through.

#include "../lib.dl"

.comp Consts {
    .decl mark(c: Color) mark(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_L).

    .decl rank_color(r: number, c: Color)
    rank_color(0, 1).
    rank_color(1, 2).
    rank_color(2, 3).
    rank_color(3, 4).
}

.init c = Consts

// --- parse ---

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)

    .decl mark_dist(key: Key, p: Position, k: number)
    mark_dist(Ky, P, K) :- cell(Ky, P, M), c.mark(M), c.rank_dir(D), dist(P, D, K).

    .init o = Ordinal<Key>
    o.idx_set(Ky, K) :- mark_dist(Ky, _, K).

    .decl rank(key: Key, p: Position, r: number)
    rank(Ky, P, R) :- mark_dist(Ky, P, K), o.rank(Ky, K, R).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl out(p: Position, col: Color)
out(P, Col) :- parse.rank($U(), P, R), c.rank_color(R, Col).
out(P, Col) :- in(P, Col), !parse.mark_dist($U(), P, _).

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl rank_color(r: number, c: Color)
    rank_color(R, Col) :- parse.rank(E, P, R), ex_out(E, P, Col).
}
