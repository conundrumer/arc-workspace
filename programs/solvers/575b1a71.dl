// 575b1a71
// concept: rank
// Cells of the params.mark color recolor by rank: the lines holding a mark are
// ranked from the params.rank_dir edge, and params.rank_color gives each rank its
// color. Other cells pass through.

#include "../lib.dl"

.comp Params {
    .decl mark(c: Color) mark(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_L).

    .decl rank_color(r: number, c: Color)
    rank_color(0, 1).
    rank_color(1, 2).
    rank_color(2, 3).
    rank_color(3, 4).
}

.init params = Params

// --- parse ---

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    // A mark cell beside its line of the rank axis.
    .decl mark_line(key: Key, p: Position, l: Position)
    mark_line(Ky, P, L) :-
        cell(Ky, P, M), params.mark(M),
        params.rank_dir(D), axis_of(D, A), split(P, A, L, _).

    // The lines holding a mark, ordered along that axis.
    .init order = OrderFrame<Key, Position>
    order.axis(Ky, A) :- mark_line(Ky, _, _), params.rank_dir(D), axis_of(D, A).
    order.member(Ky, L, L) :- mark_line(Ky, _, L).

    .decl rank(key: Key, p: Position, r: number)
    rank(Ky, P, R) :-
        mark_line(Ky, P, L), order.pos(Ky, L, P_pos),
        params.rank_dir(D), dist(P_pos, D, R).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl out(p: Position, col: Color)
out(P, Col) :- parse.rank($U(), P, R), params.rank_color(R, Col).
out(P, Col) :- in(P, Col), !params.mark(Col).

// --- determination ---

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl rank_color(r: number, c: Color)
    rank_color(R, Col) :- parse.rank(E, P, R), ex_out(E, P, Col).
}
