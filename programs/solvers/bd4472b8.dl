// bd4472b8
// concept: tile-arrangement decompose d4
// A header row (W colors) and a separator row sit above an empty body of height
// N·W. Each of the N blocks restacks the header as stripes — header color k
// becomes the block's k-th row. Header and separator pass through.
//
// Model: transpose the header into the blank with one D4 transform, tiled N
// times. The transform swaps the header's strip coordinate onto the block's
// stacking coordinate — a pure coordinate permutation, so it carries no order,
// index, or origin, and the match is Position equality. The header's location
// washes into the discarded perpendicular component: only "which cells are
// blank" depends on where the header sits, not the layout. The header is one
// cell thick and the fill broadcasts, so reflection and rotation coincide —
// the diagonal axis is the only learned bit.

#include "../lib.dl"

.comp Consts {
    .decl header_dir(d: Dir) header_dir(DIR_T).
    .decl body_start(n: number) body_start(2).
    .decl copies(n: number) copies(2).
    .decl diag(da: DiagAxis) diag(DAXIS_DG).
}

.init c = Consts

// The header transposed into a block-tall column: the stacking-axis component
// of each header cell after the transform. The transform sends the header's
// width (W) onto the stacking axis, matching the block height (W).
.decl stripe(p_stack: Position, col: Color)
stripe(P_stack, Col) :-
    in(P_h, Col),                                // header cell
    c.header_dir(D), dist(P_h, D, 0),            // on the header edge
    c.diag(Da), diag_flip_of(Da, T), apply(T, P_h, P_ht),   // transpose it
    axis_of(D, A), split(P_ht, A, P_stack, _).   // keep the stacking component

// The blank: the grid past the header and separator, in its own frame.
.init body = MarginFrame<Unit>
body.cell($U(), P) :- in(P, _).
body.width($U(), D, K) :- c.header_dir(D), c.body_start(K).

// Body fill. Split the blank into N blocks, and match each block cell to a
// transposed-header stripe by Position equality.
.decl fill(p: Position, col: Color)
fill(P_b, Col) :-
    body.inner($U(), P_b, P_body),                     // a blank cell in the blank's frame
    c.header_dir(D), axis_of(D, A), c.copies(N),
    divide(P_body, A, N, 0, _, P_inner),               // split blank into N blocks
    stripe(P_inner, Col).                              // match the transposed header

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), !fill(P, _).          // header + separator pass through
out(P, Col) :- fill(P, Col).                     // body filled
