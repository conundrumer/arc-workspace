// Header rows (along c.header_dir, depth body_start) pass through. Body
// rows are filled per-row uniformly: row at distance T from header edge
// gets header[(T - body_start) mod W], where W = grid extent perpendicular
// to header_dir and header colors come from the row at distance 0, indexed
// by distance from c.across_dir.
//
// The mod W cycling is expressed via recursion: the placement offset is
// shifted by W repeatedly, terminating when no input cell sits at the
// shifted distance along header_dir.

#include "../lib.dl"

.comp Consts {
    .decl header_dir(d: Dir)
    header_dir(TOP).

    .decl across_dir(d: Dir)
    across_dir(LEFT).

    .decl body_start(n: number)
    body_start(2).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Width perpendicular to header_dir: count cells at the header edge.
.decl header_cell(p: Position)
header_cell(P) :- in(P, _), c.header_dir(D), dist(P, D, 0).

.decl width(w: number)
width(W) :- W = count : { header_cell(_) }.

// Header cells indexed by their across-dir distance.
.decl header_color(idx: number, col: Color)
header_color(IDX, COL) :-
    in(P, COL),                                  // input cell
    c.header_dir(D), dist(P, D, 0),              // on the header edge
    c.across_dir(A_DIR), dist(P, A_DIR, IDX).    // index = across distance

// Tile placement offsets along header_dir. Base = body_start. Each step
// shifts by W. Terminates when no input cell sits at the shifted distance.
.decl tile_offset(off: Position)
tile_offset(BASE) :-
    c.header_dir(D), c.body_start(BS),           // header axis, base offset
    edge_delta(D, BS, BASE).                     // delta carrying BS at edge D
tile_offset(NEXT) :-
    tile_offset(PREV),                           // previous offset
    width(W), c.header_dir(D),                   // shift amount and axis
    edge_delta(D, W, SHIFT),                     // shift = W along D
    compose(PREV, SHIFT, NEXT),                  // PREV + SHIFT
    in(P, _), same_dist(D, NEXT, P).             // termination: input at NEXT's dist

// Filled body cells: input cell at dist (OFF + T) along header_dir gets
// header_color(T, COL). Same color for the whole row (column unconstrained).
.decl fill(p: Position, col: Color)
fill(P_INPUT, COL) :-
    in(P_INPUT, _),                              // input cell
    c.header_dir(D),                             // header axis
    tile_offset(OFF), header_color(T, COL),      // (offset, header rank, color)
    edge_delta(D, T, T_DELTA),                   // delta carrying T at edge D
    compose(OFF, T_DELTA, FULL_OFF),             // OFF + T = full distance
    same_dist(D, FULL_OFF, P_INPUT).             // input matches full distance

// Output: cells not in fill (header) pass through; cells in fill take the
// filled color.
.decl out(p: Position, col: Color)
out(P, COL) :- in(P, COL), !fill(P, _).
out(P, COL) :- fill(P, COL).

.output out(IO=stdout)
