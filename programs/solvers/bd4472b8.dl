// bd4472b8
// @keywords: tile-arrangement decompose d4
// input: A header row (W colors) and a separator row sit above an empty body
//  of height N·W.
// output: Each of the N blocks restacks the header as stripes — header color
//  k becomes the block's k-th row — by transposing the header into the blank
//  with one D4 transform along params.diag, tiled N times. Header and
//  separator pass through.

.decl out(p: Position, col: Color)

.comp Params {
    .decl header_dir(d: Dir) header_dir(DIR_T).
    .decl body_start(n: number) body_start(2).
    .decl copies(n: number) copies(2).
    .decl diag(da: DiagAxis) diag(DAXIS_DG).
}

.init params = Params

// The header transposed into a block-tall column: the stacking-axis component
// of each header cell after the transform. The transform sends the header's
// width (W) onto the stacking axis, matching the block height (W).
.decl stripe(p_stack: Position, col: Color)
stripe(P_stack, Col) :-
    in(P_h, Col),                                     // header cell
    params.header_dir(D), dist(P_h, D, 0),            // on the header edge
    params.diag(Da), diag_flip_of(Da, T), apply(T, P_h, P_ht),   // transpose it
    axis_of(D, A), split(P_ht, A, P_stack, _).   // keep the stacking component

// Body fill. The blank is the grid past the header and separator. Split it into
// N blocks, and match each block cell to a transposed-header stripe by Position
// equality.
.decl fill(p: Position, col: Color)
fill(P_b, Col) :-
    in(P_b, _), params.header_dir(D), params.body_start(K),
    edge_inset(D, K, B), crop(P_b, B, P_body),         // a blank cell in the blank's frame
    axis_of(D, A), params.copies(N),
    divide(P_body, A, N, 0, _, P_inner),               // split blank into N blocks
    stripe(P_inner, Col).                              // match the transposed header

out(P, Col) :- in(P, Col), !fill(P, _).          // header + separator pass through
out(P, Col) :- fill(P, Col).                     // body filled
