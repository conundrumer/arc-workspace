// 3906de3d
// @keywords: lines move
// output: Gravity toward params.grav: each line's params.mover cells pack
//  against the structure (non-bg, non-mover cells; the edge when the line has
//  none), order kept. Structure passes through; vacated cells bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl grav(d: Dir) grav(DIR_T).
    .decl bg(c: Color) bg(0).
    .decl mover(c: Color) mover(2).
}

.init params = Params

.decl mover(p: Position)
mover(P) :- in(P, Col), params.mover(Col).

// Each mover cell travels toward the gravity edge and stops against the
// structure or against the movers already packed ahead of it.
.init pack = Gravity<Unit, Position>
pack.dir($U(), D) :- params.grav(D).
pack.cell($U(), P, P) :- mover(P).
pack.blocked($U(), P) :- in(P, Col), !params.bg(Col), !params.mover(Col).

.decl landed(p: Position)
landed(Q) :- pack.travel($U(), P, V), compose(P, V, Q).

out(P, Col) :- landed(P), params.mover(Col).
out(P, Col) :- in(P, Col), !mover(P), !landed(P).
out(P, Bg)  :- mover(P), !landed(P), params.bg(Bg).
