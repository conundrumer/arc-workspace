// 94be5b80
// @draft
// @keywords: markers rank stamp
// input: A legend — a run of cells that changes color from neighbor to
//  neighbor along one axis — and copies of one shape, each in a single color,
//  stacked edge to edge along the perpendicular axis.
// output: One copy of the shape per legend color, on a blank grid. The copies
//  the input holds keep their places, and the stack runs on from them both
//  ways: the next legend color's copy sits one shape-extent further along.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).

    // The stack of copies runs along this axis.
    .decl stack_axis(a: Axis) stack_axis(AXIS_V).

    // A quarter turn in this sense takes a stack direction to the legend
    // direction that steps along with it.
    .decl legend_sense(s: Sense) legend_sense(SENSE_CC).
}

.init params = Params

// Stepping toward D_legend in the legend steps toward D_stack in the stack.
.decl carry(d_legend: Dir, d_stack: Dir)
carry(D_legend, D_stack) :-
    params.stack_axis(A), axis_of(D_stack, A),              // either way along the stack
    params.legend_sense(S), turn(S, D_stack, D_legend).     // its legend direction

// A legend cell meets another color one step along the legend.
.decl legend(p: Position, col: Color)
legend(P, Col) :-
    in(P, Col), !params.bg(Col),
    carry(D, _), neighbor(P, D, Q),                     // either way along the legend
    in(Q, Col2), !params.bg(Col2), Col2 != Col.         // onto another color

// A copy of the shape: the ink of one color outside the legend.
.decl copy(col: Color, p: Position)
copy(Col, P) :- in(P, Col), !params.bg(Col), !legend(P, _).

.init copy_box = Bbox<Color>
copy_box.cell(Col, P) :- copy(Col, P).

// Each copy keeps the place it holds. The slots of the stack run on from it
// toward D_stack, each one copy's extent along the stack, and the copy in the
// slot N on takes the legend color N steps on toward D_legend.
.decl ink(p: Position, col: Color)
ink(Q, Col2) :-
    carry(D_legend, D_stack), axis_of(D_stack, A), opposite(D_stack, O),
    copy(Col, P), copy_box.box(Col, B), box_extent(B, P, A, W),   // the copy's extent along the stack
    relative(B, P, P_rel), dist(P_rel, O, K),                      // the copy cell's place in its slot
    in(Q, _), same_line(A, P, Q),                                  // a grid cell in line with it
    relative(B, Q, Q_rel), dist(Q_rel, O, T),
    stride(T, W, 0, N, K),                                         // N slots on, at the same place
    legend(L, Col), jump(L, D_legend, N, L2), legend(L2, Col2).    // N legend steps on

out(P, Col) :- ink(P, Col).
out(P, Col) :- in(P, _), !ink(P, _), params.bg(Col).
