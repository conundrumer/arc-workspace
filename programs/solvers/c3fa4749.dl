// c3fa4749
// @draft
// @keywords: objects noise enclose flood
// @scene blocks: several solid one-color blocks lie against the grid border in
//  a field of random colors; a block is made of one-color 4-connected regions
//  of at least params.min_block_cells cells each, and a channel that crosses a
//  block cuts it into more than one such region
// @scene channels: each block holds one or more pockets, each a 4-connected
//  set of cells that lie in no block region
// @rule dead-end-fills: a pocket whose every neighbor lies in one block region,
//  and that meets the grid border at exactly one cell, takes that cell's
//  color in every cell, the block-colored cells it walls in included
// @rule rest-kept: every other cell keeps its input color

// where a dead end's mouth lies
.type MouthPlace =
    // @claim dead-end-fills
    GridBorder {}
    // @rule dead-end-fills: the pockets of a block region are the 4-connected
    //  sets of cells inside the region's bounding box that lie outside the
    //  region, and a pocket with exactly one cell on that box's edge takes
    //  that cell's color in every cell; undefined where two such pockets
    //  share a cell and give it different colors
    // @witness interior-block: variant $MouthOnBlockSide
    //     @relaxed blocks
  | MouthOnBlockSide {}

// the adjacency of block regions, pockets and their walls
.type Adjacency =
    // @claim blocks channels dead-end-fills
    Orthogonal {}
    // @scene blocks: block regions are 8-connected
    // @scene channels: pockets are 8-connected
    // @rule dead-end-fills: a pocket's diagonal neighbors are neighbors too
    // @witness diagonal-step: borderline $Adjacency8
  | Adjacency8 {}

// how many border cells a dead end meets
.type MouthCount =
    // @claim dead-end-fills
    OneMouth {}
    // @rule dead-end-fills: a walled pocket that meets the grid border at one
    //  or more cells, all of one color, takes that color, and a pocket whose
    //  border cells differ keeps its colors
    // @witness two-cell-mouth: borderline $WalledAnyMouth
  | WalledAnyMouth {}

.type Choice = [place: MouthPlace, adj: Adjacency, mouths: MouthCount]

// A connected set of cells under one adjacency: a region or a pocket.
.type Piece = [a: Adjacency, id: Ident]

// A pocket under one reading of the mouth's place and of adjacency, with the
// block region that walls it.
.type Pocket = [place: MouthPlace, a: Adjacency, region: Ident, id: Ident]

// One color of one input.
.type Shade = [e: Example, col: Color]

// One one-color region of one input.
.type Patch = [s: Shade, id: Ident]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The fewest cells a one-color region has to be a block region.
    // @derive ConstInDim: ordinary concept
    .decl min_block_cells(n: number) min_block_cells(7).
}

.init params = Params

.decl mouth_place_choice(pl: MouthPlace)
mouth_place_choice($GridBorder()). mouth_place_choice($MouthOnBlockSide()).

.decl adjacency_choice(a: Adjacency)
adjacency_choice($Orthogonal()). adjacency_choice($Adjacency8()).

.decl mouth_count_choice(c: MouthCount)
mouth_count_choice($OneMouth()). mouth_count_choice($WalledAnyMouth()).

.decl impl_choice(ch: Choice)
impl_choice([Pl, A, C]) :- mouth_place_choice(Pl), adjacency_choice(A), mouth_count_choice(C).

// The cells of each one-color region.
.decl region(x: Piece, p: Position)

// @claim blocks
.init region_size = Tally<Piece, Position>
region_size.item(X, P) :- region(X, P).

// The cells of each block region.
.decl block(a: Adjacency, r: Ident, p: Position)
block(A, R, P) :-
    region([A, R], P), region_size.tally([A, R], N), params.min_block_cells(K), N >= K.

// The cells of each pocket under the grid-border reading: the connected sets
// of cells in no block region.
.decl grid_pocket(x: Piece, p: Position)

// The directions in which a cell meets its neighbors.
.decl step_dir(a: Adjacency, d: Dir8)

// The cells of each pocket, and the cells where it opens.
.decl pocket(x: Pocket, p: Position)
.decl mouth(x: Pocket, p: Position)

// The cells the dead ends fill, with their fill colors.
.decl fill(ch: Choice, p: Position, col: Color)

out(P, Col, Ch) :- fill(Ch, P, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !fill(Ch, P, _).

// --- $Orthogonal ---
// @claim blocks
.init regions = Components<Color>
regions.node(Col, P) :- in(P, Col).

region([$Orthogonal(), Id], P) :- regions.label(_, P, Id).

// --- $Orthogonal & $GridBorder ---
step_dir($Orthogonal(), D) :- dir_elem(D).

// @claim channels
.init pockets = Components<Unit>
pockets.node($U(), P) :- in(P, _), !block($Orthogonal(), _, P).

grid_pocket([$Orthogonal(), Id], P) :- pockets.label(_, P, Id).

// --- $Orthogonal & $MouthOnBlockSide ---
// @claim dead-end-fills
.init box_pockets = Components<Ident>
box_pockets.node(R, P) :-
    block_box.box([$Orthogonal(), R], B), in(P, _), inside(P, B),
    !region([$Orthogonal(), R], P).

pocket([$MouthOnBlockSide(), $Orthogonal(), R, Id], P) :- box_pockets.label(R, P, Id).

// --- $Adjacency8 ---
// @claim blocks
.init regions8 = Components8<Color>
regions8.node(Col, P) :- in(P, Col).

region([$Adjacency8(), Id], P) :- regions8.label(_, P, Id).

// --- $Adjacency8 & $GridBorder ---
step_dir($Adjacency8(), D) :- dir8_elem(D).

// @claim channels
.init pockets8 = Components8<Unit>
pockets8.node($U(), P) :- in(P, _), !block($Adjacency8(), _, P).

grid_pocket([$Adjacency8(), Id], P) :- pockets8.label(_, P, Id).

// --- $Adjacency8 & $MouthOnBlockSide ---
// @claim dead-end-fills
.init box_pockets8 = Components8<Ident>
box_pockets8.node(R, P) :-
    block_box.box([$Adjacency8(), R], B), in(P, _), inside(P, B),
    !region([$Adjacency8(), R], P).

pocket([$MouthOnBlockSide(), $Adjacency8(), R, Id], P) :- box_pockets8.label(R, P, Id).

// --- $GridBorder ---
// The block regions that each pocket's neighbors lie in.
// @claim dead-end-fills
.init wall = Unanimous<Piece, Ident>
wall.item([A, Id], R) :-
    grid_pocket([A, Id], P), step_dir(A, D), neighbor(P, D, Q), block(A, R, Q).

pocket([$GridBorder(), A, R, Id], P) :- wall.value([A, Id], R), grid_pocket([A, Id], P).

mouth([$GridBorder(), A, R, Id], P) :-
    pocket([$GridBorder(), A, R, Id], P), dir_elem(D), dist(P, D, 0).   // on the grid border

// --- $MouthOnBlockSide ---
// @claim dead-end-fills
.init block_box = Bbox<Piece>
block_box.cell([A, R], P) :- block(A, R, P).

mouth([$MouthOnBlockSide(), A, R, Id], P) :-
    pocket([$MouthOnBlockSide(), A, R, Id], P), block_box.box([A, R], B), box_edge(P, B, _).

// --- $OneMouth ---
// The cells where each pocket opens, as one cell.
// @claim dead-end-fills
.init one_mouth = Unanimous<Pocket, Position>
one_mouth.item(X, P) :- mouth(X, P).

fill([Pl, A, $OneMouth()], P, Col) :-
    one_mouth.value([Pl, A, R, Id], Q), in(Q, Col), pocket([Pl, A, R, Id], P).

// --- $WalledAnyMouth ---
// The colors of the cells where each pocket opens, as one color.
// @claim dead-end-fills
.init mouth_color = Unanimous<Pocket, Color>
mouth_color.item(X, Col) :- mouth(X, P), in(P, Col).

fill([Pl, A, $WalledAnyMouth()], P, Col) :-
    mouth_color.value([Pl, A, R, Id], Col), pocket([Pl, A, R, Id], P).

.comp Determine {
    .init patches = Components<Shade>
    patches.node([E, Col], P) :- ex_in(E, P, Col).

    .init patch_size = Tally<Patch, Position>
    patch_size.item([S, Id], P) :- patches.label(S, P, Id).

    // A count of cells that no one-color region of any input has.
    .init unused = Extremes<Unit>
    unused.cand($U(), K) :-
        ex_in(_, P, _), axis_elem(A), sub_extent(P, A, K), !patch_size.tally(_, K).

    // The field's clumps stop short of the least unused count, and the blocks
    // lie past it.
    .decl min_block_cells(n: number)
    min_block_cells(K) :- unused.low($U(), K).
}
