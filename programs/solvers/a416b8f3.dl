// a416b8f3
// concept: tile-arrangement
// Layout: 1×2 horizontal duplication. Output is two copies of input placed
// side by side along the tile axis.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl tile_axis(a: Axis) tile_axis(AXIS_H).
    .decl copies(n: number) copies(2).

    .decl tile(p: Position)
    tile(P) :- copies(N), tile_axis(AXIS_V), helpers.frame_pos([N, 1], P).  // @structural: a single row of copies
    tile(P) :- copies(N), tile_axis(AXIS_H), helpers.frame_pos([1, N], P).  // @structural
}

.init c = Consts

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_in, Col),                                  // input cell
    c.tile(P_tile),                                 // tile-frame pos (axis-only)
    c.tile_axis(A),                                 // tile axis
    concat_slab(P_tile, P_in, A, 0, P_grid_out).    // recompose with passthrough
