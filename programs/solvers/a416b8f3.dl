// a416b8f3
// keywords: tile-arrangement
// output: The output places params.copies copies of the input side by side
//  along params.tile_axis.

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl tile_axis(a: Axis) tile_axis(AXIS_H).
    .decl copies(n: number) copies(2).

    .decl tile(p: Position)
    tile(P) :- copies(N), tile_axis(AXIS_V), helpers.frame_pos([N, 1], P).  // @unit: a single row of copies
    tile(P) :- copies(N), tile_axis(AXIS_H), helpers.frame_pos([1, N], P).  // @unit
}

.init params = Params

out(P_grid_out, Col) :-
    in(P_in, Col),                                  // input cell
    params.tile(P_tile),                            // tile-frame pos (axis-only)
    params.tile_axis(A),                            // tile axis
    concat_slab(P_tile, P_in, A, 0, P_grid_out).    // recompose with passthrough
