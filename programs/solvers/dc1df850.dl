// dc1df850
// concept: markers lookup stamp
// Each marker cell paints a one-cell halo on its eight neighbors; the rest
// of the grid passes through. Halos clip at the grid edge and overwrite
// what they cover; the data never shows a halo covering other ink.
//
// The cases differ in the footprint, and agree on this task's data:
//
//   $Grow()  — markers grow one step in all eight directions.
//   $Stamp() — a stored template, seated by its marker cell on each marker.

#include "../lib.dl"

.type Choice = Grow {} | Stamp {}

.comp Consts {
    // --- shared ---
    .decl marker(c: Color) marker(2).

    // --- $Grow ---
    .decl halo(c: Color) halo(1).

    // --- $Stamp ---
    .decl template(p: Position, col: Color)
    GRID_3x3(template,
        1, 1, 1,
        1, 2, 1,
        1, 1, 1)

    // The template's own marker cell — the one that lands on a marker.
    .decl seat(p: Position)
    seat(Ps) :- template(Ps, M), marker(M).
}

.init c = Consts

.decl marker_at(p: Position)
marker_at(P) :- in(P, Col), c.marker(Col).

.decl halo(p: Position, col: Color, ch: Choice)

// --- $Grow ---
halo(P, Col, $Grow()) :-
    marker_at(M), c.halo(Col),
    dir8_elem(D), neighbor(M, D, P), in(P, _).

// --- $Stamp ---
halo(P, Col, $Stamp()) :-
    marker_at(Q), c.template(Pt, Col),       // a marker, a template cell
    c.seat(Ps), displacement(Ps, Pt, Off),   // the cell's offset from the seat
    compose(Q, Off, P), in(P, _).            // seated on the marker, on-grid

.decl impl_choice(ch: Choice)
impl_choice($Grow()). impl_choice($Stamp()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- halo(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !halo(P, _, Ch).

// --- fit ---

.comp Fit {
    // A second marker in the pair leaves a repainted cell no unique source.
    .init pair_marker = Unanimous<Example, Position>
    pair_marker.item(E, P) :- ex_in(E, P, Col), c.marker(Col).

    .decl footprint(m: Position, p: Position, col: Color)
    footprint(M, P, Col) :-
        pair_marker.value(E, M),                     // the pair's lone marker
        ex_out(E, P, Col),                           // an output cell
        ( P = M                                      // the marker's own cell
        ; ex_in(E, P, Col_in), Col_in != Col         // repainted
        ).

    // Footprint cells as offsets from their marker.
    .decl offset(off: Shift, col: Color)
    offset(Off, Col) :- footprint(M, P, Col), displacement(M, P, Off).

    .init frame = BoxFrame<Unit>
    frame.cell($U(), Off) :- offset(Off, _).

    .decl template(p: Position, col: Color)
    template(Pt, Col) :- offset(Off, Col), frame.inner($U(), Off, Pt).
}
