// a5f85a15
// @draft
// @keywords: lines parity
// @scene diagonal-lines: on a background of params.bg, cells of one color form
//  straight lines along params.line_dir; each line runs from one grid edge to
//  another, and no two lines touch
// @rule alternate-from-start: along each line, cells are counted toward
//  params.line_dir from 0 at the line's first cell; a cell whose count falls
//  at params.mark_phase in each params.period takes params.mark
// @rule rest-kept: every other cell keeps its color

// what one counted unit is
.type Segment =
    // @claim alternate-from-start
    Run {}
    // @rule alternate-from-start: all ink cells on one grid diagonal along the
    //  line direction form one unit, and the count skips the gaps between them
    // @witness gap: variant concept
    //     @relaxed diagonal-lines
  | DiagonalClass {}

// whether a unit ends where the color changes
.type ColorSplit =
    // @claim alternate-from-start
    ColorBlind {}
    // @rule alternate-from-start: a unit also ends where the color changes
    // @witness two-colors: borderline $ColorRuns
    //     @relaxed diagonal-lines
  | ColorRuns {}

// which cell a count starts from
.type Origin =
    // @claim alternate-from-start
    LineStart {segment: Segment, split: ColorSplit}
    // @rule alternate-from-start: an ink cell's count starts at the grid-edge
    //  cell of its grid diagonal, background cells included
    // @witness inner-segment: variant concept
    //     @relaxed diagonal-lines
  | GridDiagonal {}
    // @rule alternate-from-start: an ink cell's count is its distance from
    //  params.parity_edge
    // @witness odd-column-start: variant concept
    // @witness touching-lines: borderline concept
    //     @relaxed diagonal-lines
  | ColumnParity {}

// where the line direction comes from
.type Heading =
    // @claim diagonal-lines
    StoredStep {}
    // @scene diagonal-lines: on a background of params.bg, cells of one color
    //  form straight lines along the one diagonal axis on which two ink cells
    //  touch; each line runs from one grid edge to another, and no two lines
    //  touch
    // @rule alternate-from-start: a line's count starts at its end nearer
    //  params.start_edge
    // @witness anti-diagonal-odd: variant $DerivedAxis
    //     @relaxed diagonal-lines
    // @witness anti-diagonal-even: variant $DerivedAxis
    //     @relaxed diagonal-lines
    //     @reassigned start_edge
    // @witness anti-diagonal-wide: variant $DerivedAxis
    //     @relaxed diagonal-lines
  | DerivedAxis {}

.type Choice = [origin: Origin, heading: Heading]

// A unit kind under a line direction.
.type Lane = [split: ColorSplit, d: DiagDir]

// An ink cell counted under a lane.
.type LaneCell = [lane: Lane, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed diagonal-lines
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(4).

    // The counts repeat every period cells, and the count at mark_phase in
    // each repeat takes the mark.
    .decl period(n: number) period(2).
    .decl mark_phase(k: number) mark_phase(1).

    // --- $StoredStep ---
    // The step from a line's first cell to its next.
    .decl line_dir(d: DiagDir) line_dir(DIAG_BR).

    // --- $DerivedAxis ---
    // A line's count starts at its end nearer this edge. The pairs leave the
    // top and the left edge open.
    .decl start_edge(d: Dir) start_edge(DIR_T). start_edge(DIR_L).

    // --- $ColumnParity ---
    .decl parity_edge(d: Dir) parity_edge(DIR_L).
}

.init params = Params

.decl segment_choice(g: Segment)
segment_choice($Run()). segment_choice($DiagonalClass()).

.decl color_split_choice(s: ColorSplit)
color_split_choice($ColorBlind()). color_split_choice($ColorRuns()).

.decl origin_choice(o: Origin)
origin_choice($LineStart(G, S)) :- segment_choice(G), color_split_choice(S).
origin_choice($GridDiagonal()). origin_choice($ColumnParity()).

.decl impl_choice(ch: Choice)
impl_choice([O, $StoredStep()]) :- origin_choice(O).
impl_choice([O, $DerivedAxis()]) :- origin_choice(O), O != $ColumnParity().

.comp Parse<Key> {
    .decl grid(key: Key, p: Position, col: Color)

    .decl ink(key: Key, p: Position)
    ink(Ky, P) :- grid(Ky, P, Col), !params.bg(Col).

    // The diagonal axes on which two ink cells touch.
    // @ignore: store — the stored axis with params.start_edge gives the
    //  StoredStep reading, which the concept case holds
    // @claim diagonal-lines
    .init touch = Unanimous<Key, DiagAxis>
    touch.item(Ky, Da) :- ink(Ky, P), neighbor(P, D, Q), ink(Ky, Q), diag_axis_of(D, Da).
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

// The line direction under heading H.
.decl heading(h: Heading, d: DiagDir)

.decl lane(l: Lane)
lane([S, D]) :- color_split_choice(S), heading(_, D).

// The count of ink cell P in its unit under origin O along D.
.decl pos(o: Origin, d: DiagDir, p: Position, k: number)

.decl marked(o: Origin, d: DiagDir, p: Position)
marked(O, D, P) :-
    pos(O, D, P, K), params.period(W), stride(K, W, 0, _, R), params.mark_phase(R).

out(P, Col, [O, H]) :-
    impl_choice([O, H]), heading(H, D),
    ( marked(O, D, P), params.mark(Col)
    ; in(P, Col), !marked(O, D, P) ).

// --- $StoredStep ---
heading($StoredStep(), D) :- params.line_dir(D).

// --- $DerivedAxis ---
heading($DerivedAxis(), D) :-
    parse.touch.value($U(), Da), diag_axis_of(D, Da),
    params.start_edge(E), opposite(E, E_far), dir_of(D, _, E_far).  // leads away from the start edge

// --- $ColorBlind ---
// Q may share a unit with P under split S.
.decl kin(s: ColorSplit, p: Position, q: Position)
kin($ColorBlind(), P, Q) :- parse.ink($U(), P), parse.ink($U(), Q).

// --- $ColorRuns ---
kin($ColorRuns(), P, Q) :- parse.ink($U(), P), in(P, Col), in(Q, Col).

// --- $Run ---
// The first cell of a unit: the cell behind it is not its kin.
.decl start(l: Lane, p: Position)
start([S, D], P) :-
    lane([S, D]), parse.ink($U(), P), diag_opposite(D, O), neighbor(P, O, Q), !kin(S, P, Q).

// Each unit cast from its first cell; it stops at the background and at the
// first cell of the next unit.
// @claim alternate-from-start
.init run = Ray<Lane>
run.dir([S, D], D) :- lane([S, D]).
run.cell(L, P) :- lane(L), parse.ink($U(), P).
run.mark(L, P) :- start(L, P).
run.blocked(L, P) :- lane(L), in(P, _), ( !parse.ink($U(), P) ; start(L, P) ).

pos($LineStart($Run(), S), D, P, K) :- run.clear([S, D], P, D, K, _).

// --- $DiagonalClass, $GridDiagonal ---
// Each grid diagonal along D, cast from its cell on the grid edge.
// @store ray: variant other
//     @relaxed diagonal-lines
// @claim alternate-from-start
.init diagonal = Ray<DiagDir>
diagonal.dir(D, D) :- heading(_, D).
diagonal.cell(D, P) :- heading(_, D), in(P, _).
diagonal.mark(D, P) :- in(P, _), diag_opposite(D, O), dir_of(O, _, E), dist(P, E, 0).

// --- $DiagonalClass ---
// The kin cells before each ink cell on its grid diagonal.
// @claim alternate-from-start
.init behind = Tally<LaneCell, Position>
behind.domain([L, P]) :- lane(L), parse.ink($U(), P).
behind.item([[S, D], P], Q) :-
    diagonal.ray(D, P, D, K, E), diagonal.ray(D, Q, D, K2, E), K2 < K, kin(S, P, Q).

pos($LineStart($DiagonalClass(), S), D, P, K) :- behind.tally([[S, D], P], K).

// --- $GridDiagonal ---
pos($GridDiagonal(), D, P, K) :- diagonal.ray(D, P, D, K, _), parse.ink($U(), P).

// --- $ColumnParity ---
pos($ColumnParity(), D, P, K) :-
    heading(_, D), parse.ink($U(), P), params.parity_edge(E), dist(P, E, K).

.comp Determine {
    .init parse = Parse<Example>
    parse.grid(E, P, Col) :- ex_in(E, P, Col).

    // One example's lines, read from a candidate start edge.
    .type EdgeKey = [e: Example, edge: Dir]

    .init run = Ray<EdgeKey>
    run.dir([E, Edge], D) :-
        parse.touch.value(E, Da), diag_axis_of(D, Da),
        opposite(Edge, E_far), dir_of(D, _, E_far).
    run.cell([E, Edge], P) :- run.dir([E, Edge], _), parse.ink(E, P).
    run.mark([E, Edge], P) :-
        run.dir([E, Edge], D), parse.ink(E, P), diag_opposite(D, O), neighbor(P, O, Q), !parse.ink(E, Q).
    run.blocked([E, Edge], P) :- run.dir([E, Edge], _), ex_in(E, P, _), !parse.ink(E, P).

    // A train cell whose output disagrees with the count from start edge Edge.
    .decl contradicted(edge: Dir)
    contradicted(Edge) :-
        run.clear([E, Edge], P, _, K, _), ex_out(E, P, Col),
        params.period(W), stride(K, W, 0, _, R),
        ( params.mark_phase(R), !params.mark(Col)
        ; !params.mark_phase(R), params.mark(Col) ).

    .decl start_edge(d: Dir)
    start_edge(Edge) :- dir_elem(Edge), !contradicted(Edge).
}
