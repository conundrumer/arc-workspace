// 508bd3b6
// @draft
// @keywords: markers walk
// input: a diagonal run of marks, which aims a beam along it
// output: The beam runs along that diagonal in both directions and paints
//  the empty cells it crosses. It ends at the grid edge or on a colored
//  cell. A wall turns the beam: when a wall sits beside it toward one
//  component of its heading, that component inverts.

// which walls turn the beam
.type Choice =
    // any wall cell
    Surface {}
    // only a wall covering a whole side of the grid
  | Side {}

.decl out(p: Position, col: Color, ch: Choice)

// The beam at a cell, with its heading.
.type Beam = [p: Position, d: DiagDir]

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(8).
    .decl wall(col: Color) wall(2).
    .decl paint(col: Color) paint(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Surface()). impl_choice($Side()).

.decl mark_cell(p: Position)
mark_cell(P) :- in(P, Col), params.mark(Col).

// The beam's diagonal: two marks adjoin along it.
.decl aim(d: DiagDir)
aim(D) :- mark_cell(P), diag_dir_elem(D), neighbor(P, D, Q), mark_cell(Q).

// The wall beside p toward d.
.decl side_wall(p: Position, d: Dir)
side_wall(P, D) :-
    in(P, _), dir_elem(D), neighbor(P, D, Q), in(Q, Col), params.wall(Col).

// The beam's component toward d turns back at p.
.decl deflect(p: Position, d: Dir, ch: Choice)

// --- $Surface ---

deflect(P, D, $Surface()) :- side_wall(P, D).

// --- $Side ---

// An edge with a cell the wall leaves open.
.decl open_edge(d: Dir)
open_edge(D) :- dir_elem(D), in(P, Col), dist(P, D, 0), !params.wall(Col).

// The wall covers the whole side toward d.
deflect(P, D, $Side()) :- side_wall(P, D), !open_edge(D).

// --- beam ---

// The beam reaches p heading d: from a mark along the aim, it leaves each
// cell with the heading the walls there turn it to, into the open cell ahead.
.init beam = Propagation<Choice, Beam>
beam.source(Ch, [P0, D0]) :- mark_cell(P0), aim(D0), impl_choice(Ch).
beam.edge(Ch, [P, D], [Q, D_out]) :-
    in(P, _), impl_choice(Ch), diag_dirs(D, _, D1, D2),     // d's two components
    ( deflect(P, D1, Ch), opposite(D1, E1)                  // the first turned back
    ; !deflect(P, D1, Ch), E1 = D1                          // the first free
    ),
    ( deflect(P, D2, Ch), opposite(D2, E2)                  // the second turned back
    ; !deflect(P, D2, Ch), E2 = D2                          // the second free
    ),
    diag_dirs(D_out, _, E1, E2),                            // the heading it leaves p with
    neighbor(P, D_out, Q), in(Q, Bg), params.bg(Bg).        // the open cell ahead

.decl painted(p: Position, ch: Choice)
painted(P, Ch) :-
    beam.reached(Ch, [P, _]), in(P, Bg), params.bg(Bg).

out(P, Col, Ch) :- painted(P, Ch), params.paint(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !painted(P, Ch).
