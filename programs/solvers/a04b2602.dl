// a04b2602
// @draft
// @keywords: objects bbox stamp noise
// @scene field: the grid is a field of params.background
// @scene blocks: solid rectangles of params.block_color stand on the field;
//  every cell of a rectangle is params.block_color or params.mark_color, and
//  each of its four sides holds a params.block_color cell
// @rule inside-mark: a rectangle is the smallest box that holds the bounding
//  boxes of one or two 4-connected components of params.block_color and holds
//  only params.block_color and params.mark_color cells; a params.mark_color
//  cell is an inside mark when it lies inside a rectangle; a
//  params.mark_color cell outside every rectangle is a stray mark and
//  triggers nothing
// @rule halo: each inside mark paints params.halo_color on the eight cells
//  around it, clipped to the grid; the halo covers block, field, and stray
//  mark cells alike
// @rule marks-kept: inside marks keep params.mark_color, also where the halo
//  of a neighboring inside mark covers them
// @rule rest-kept: every other cell keeps its input color

// the region that counts as a rectangle
.type BoxRegion =
    // @claim inside-mark
    Spanned {}
    // @rule inside-mark: a params.mark_color cell is an inside mark when it
    //  lies in the bounding box of a 4-connected component of
    //  params.block_color
    // @witness split-narrow: borderline concept
  | FourConnected {}
    // @rule inside-mark: a params.mark_color cell is an inside mark when it
    //  lies in the bounding box of an 8-connected component of
    //  params.block_color
    // @witness corner-touch: borderline concept
  | EightConnected {}
    // @rule inside-mark: a params.mark_color cell is an inside mark when the
    //  smallest box that holds it and the bounding box of a 4-connected
    //  component of params.block_color holds no params.background cell
    //  outside that component's box
    // @witness flush-strays: borderline concept
  | NonzeroBox {}

// which mark cells get a halo
.type Trigger =
    // @claim inside-mark
    InBox {r: BoxRegion}
    // @rule inside-mark: a params.mark_color cell is an inside mark when at
    //  least two of its four neighbours are params.block_color
    // @witness gap-row-stray: ordinary concept
  | ThreeNeighbours {}

// where the block and mark colors come from
.type Roles =
    // @claim blocks
    StoredRoles {}
    // @scene blocks: the grid holds two colors besides params.background;
    //  the more frequent is the block color and the other the mark color; a
    //  grid with another count of such colors, or with two equally frequent,
    //  has no reading
    // @witness yellow-blocks: variant $DerivedRoles
    //     @relaxed blocks
  | DerivedRoles {}

.type Choice = [trigger: Trigger, roles: Roles]

// A block under one reading of the colors.
.type Block = [r: Roles, id: Ident]

// Two blocks, or one block twice, under one reading of the colors.
.type Span = [r: Roles, a: Ident, b: Ident]

// A block's box together with a mark cell.
.type Hull = [r: Roles, id: Ident, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl halo_color(c: Color) halo_color(1).

    // --- $NonzeroBox, $DerivedRoles ---
    .decl background(c: Color) background(0).

    // --- $StoredRoles ---
    .decl block_color(c: Color) block_color(3).
    // @derive RarestColor: variant derived
    //     @relaxed blocks
    .decl mark_color(c: Color) mark_color(2).
}

.init params = Params

.decl roles(r: Roles, c_block: Color, c_mark: Color)

.decl block(r: Roles, p: Position)
block(R, P) :- in(P, Col), roles(R, Col, _).

.decl mark(r: Roles, p: Position)
mark(R, P) :- in(P, Col), roles(R, _, Col).

.decl inside_mark(p: Position, ch: Choice)

.decl trigger_choice(t: Trigger)
trigger_choice($InBox($Spanned())).
trigger_choice($InBox($FourConnected())).
trigger_choice($InBox($EightConnected())).
trigger_choice($InBox($NonzeroBox())).
trigger_choice($ThreeNeighbours()).

// The eight cells around an inside mark, less the inside marks.
.decl halo(p: Position, ch: Choice)
halo(Q, Ch) :- inside_mark(P, Ch), neighbor(P, _, Q), in(Q, _), !inside_mark(Q, Ch).

out(P, Col, Ch) :- halo(P, Ch), params.halo_color(Col).
out(P, Col, [T, R]) :- in(P, Col), trigger_choice(T), roles(R, _, _), !halo(P, [T, R]).

// --- $StoredRoles ---
roles($StoredRoles(), C1, C2) :- params.block_color(C1), params.mark_color(C2).

// --- $DerivedRoles ---
.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.background(Col).

// @claim blocks
.init ink_mode = Mode<Unit, Color, Position>
ink_mode.item($U(), Col, P) :- ink(P, Col).

// @claim blocks
.init block_ink = Unanimous<Unit, Color>
block_ink.item($U(), Col) :- ink_mode.mode($U(), Col).

// @ignore item: store — a stored item set gives mark_ink.value its one
//  color, or no color where the set holds two, as a stored value of that
//  color or of no color does: mark_ink.item=stored is subsumed by
//  mark_ink.value=stored
// @store value: variant concept
//     @relaxed field
// @claim blocks
.init mark_ink = Unanimous<Unit, Color>
mark_ink.item($U(), Col) :- ink(_, Col), !block_ink.value($U(), Col).

roles($DerivedRoles(), C1, C2) :- block_ink.value($U(), C1), mark_ink.value($U(), C2).

// --- $Spanned, $FourConnected, $NonzeroBox ---
// @claim inside-mark
.init block4 = Components<Roles>
block4.node(R, P) :- block(R, P).

// @claim inside-mark
.init box4 = Bbox<Block>
box4.cell([R, Id], P) :- block4.label(R, P, Id).

// --- $Spanned ---
// The smallest box that holds the boxes of a span's blocks.
// @claim inside-mark
.init span = Bbox<Span>
span.cell([R, A, B], B_part) :-
    box4.box([R, A], B_a), box4.box([R, B], B_b), (B_part = B_a ; B_part = B_b).

// The box holds a cell of neither role.
.decl span_field(s: Span)
span_field([R, A, B]) :-
    span.box([R, A, B], B_s), in(Q, _), inside(Q, B_s), !block(R, Q), !mark(R, Q).

inside_mark(P, [$InBox($Spanned()), R]) :-
    mark(R, P), span.box([R, A, B], B_s), !span_field([R, A, B]), inside(P, B_s).

// --- $FourConnected ---
inside_mark(P, [$InBox($FourConnected()), R]) :- mark(R, P), box4.box([R, _], B), inside(P, B).

// --- $EightConnected ---
// @claim inside-mark
.init block8 = Components8<Roles>
block8.node(R, P) :- block(R, P).

// @claim inside-mark
.init box8 = Bbox<Block>
box8.cell([R, Id], P) :- block8.label(R, P, Id).

inside_mark(P, [$InBox($EightConnected()), R]) :- mark(R, P), box8.box([R, _], B), inside(P, B).

// --- $NonzeroBox ---
// The smallest box that holds a block's box and a mark.
// @claim inside-mark
.init hull = Bbox<Hull>
hull.cell([R, Id, P], B_part) :- box4.box([R, Id], B), mark(R, P), (B_part = B ; B_part = P).

// The hull holds a field cell outside the block's box.
.decl hull_field(h: Hull)
hull_field([R, Id, P]) :-
    hull.box([R, Id, P], B_h), box4.box([R, Id], B),
    in(Q, Col), params.background(Col), inside(Q, B_h), !inside(Q, B).

inside_mark(P, [$InBox($NonzeroBox()), R]) :- hull.box([R, Id, P], _), !hull_field([R, Id, P]).

// --- $ThreeNeighbours ---
inside_mark(P, [$ThreeNeighbours(), R]) :-
    mark(R, P),
    dir_elem(D1), neighbor(P, D1, Q1), block(R, Q1),
    dir_elem(D2), neighbor(P, D2, Q2), block(R, Q2), D1 != D2.
