// 48131b3c
// keywords: tile-arrangement mapping
// output: Output arranges 2×2 copies of the input with its two colors swapped.

.decl out(p: Position, col: Color)

.comp Params {
    .decl copies(n: number) copies(2).
}

.init params = Params

.decl palette(col: Color)
palette(Col) :- in(_, Col).

// Each cell takes the other color.
.decl swapped(p: Position, col: Color)
swapped(P, C2) :- in(P, C1), palette(C2), C2 != C1.

// copies×copies arrangement of the swapped grid.
.init arrangement = Frame2D<Unit>
arrangement.extent($U(), A, N) :- axis_elem(A), params.copies(N).

out(P_grid_out, Col) :-
    arrangement.cell($U(), P_tile),                 // tile pos in the arrangement
    swapped(P_intile, Col),                         // intile pos
    concat_2d(P_tile, P_intile, 0, P_grid_out).     // 2D recompose
