// 32597951
// concept: markers mapping
// Inside the bounding box of the marker cells, qualifying cells take c.to;
// everything else passes through. Two claims of which cells qualify:
//
//   $From — cells of the stored color c.from.
//   $Ink  — every cell that is neither c.bg nor c.marker.

#include "../lib.dl"

.type Choice = From {} | Ink {}

.comp Consts {
    // --- shared ---
    .decl marker(c: Color) marker(8).
    .decl to(c: Color) to(3).

    // --- From ---
    .decl from(c: Color) from(1).

    // --- Ink ---
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.init box = Bbox<Unit>
box.cell($U(), P) :- in(P, Col), c.marker(Col).
box.grid($U(), P) :- in(P, _).

.decl impl_choice(ch: Choice)
impl_choice($From()). impl_choice($Ink()).

.decl recolor(p: Position, ch: Choice)

// --- From ---
recolor(P, $From()) :- box.inside($U(), P), in(P, Col), c.from(Col).

// --- Ink ---
recolor(P, $Ink()) :- box.inside($U(), P), in(P, Col), !c.bg(Col), !c.marker(Col).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- recolor(P, Ch), c.to(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !recolor(P, Ch).

.output out(IO=stdout)
