// 32597951
// concept: markers mapping
// Inside the bounding box of the marker cells, qualifying cells take params.to;
// everything else passes through. Two hypotheses of which cells qualify:
//
//   $From — cells of the stored color params.from.
//   $Ink  — every non-marker cell.

#include "../lib.dl"

.type Choice = From {} | Ink {}

.comp Params {
    // --- shared ---
    .decl marker(c: Color) marker(8).
    .decl to(c: Color) to(3).

    // --- From ---
    .decl from(c: Color) from(1).
}

.init params = Params

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.marker(Col).

.decl impl_choice(ch: Choice)
impl_choice($From()). impl_choice($Ink()).

.decl recolor(p: Position, ch: Choice)

// --- From ---
recolor(P, $From()) :-
    in(P, Col), params.from(Col), bbox.box($U(), B), inside(P, B).

// --- Ink ---
recolor(P, $Ink()) :-
    in(P, Col), !params.marker(Col), bbox.box($U(), B), inside(P, B).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- recolor(P, Ch), params.to(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !recolor(P, Ch).
