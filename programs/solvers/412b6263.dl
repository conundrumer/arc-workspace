// 412b6263
// @keywords: tile-arrangement d4 border count
// output: The output is a lattice: copies of the input under params.xform fill
//  the tiles, and lines of params.line_width run between the copies and around
//  them. The separators and the ring are the same lines, so one width serves
//  both. A frame cell off the copies takes params.line_col on a copy's row or
//  column, and params.bg where two lines cross.

// Two hypotheses about the copy count
.type Choice =
    // the tile arrangement is stored per axis in params.tiles
    Layout {}
    // the copies stack along params.stack_axis, one per input object
  | Count {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).
    .decl line_col(col: Color) line_col(1).
    .decl xform(d: D4) xform(D4_CC).
    .decl line_width(k: number) line_width(1).

    // The outer lines.
    .decl ring(p: Box)
    ring(P) :- line_width(K), uniform_inset(K, P).

    // --- Layout ---
    .decl tiles(a: Axis, n: number)
    tiles(AXIS_V, 2). tiles(AXIS_H, 1).

    // --- Count ---
    .decl stack_axis(a: Axis) stack_axis(AXIS_V).
}

.init params = Params

// The copy each tile holds.
.decl content(p_intile: Position, col: Color)
content(P_intile, Col) :- in(P_grid_in, Col), params.xform(D), apply(D, P_grid_in, P_intile).

// A copy's cell, in the output frame less the ring.
.decl placed(ch: Choice, p_inner: Position, p_intile: Position)

// --- Layout ---
.init layout = Frame2D<Unit>
layout.extent($U(), A, N) :- params.tiles(A, N).

placed($Layout(), P_inner, P_intile) :-
    layout.cell($U(), P_tile), content(P_intile, _),                // tile, and the cell in it
    params.line_width(W), concat_2d(P_tile, P_intile, W, P_inner).  // laid out, gapped by the line

// --- Count ---
.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !params.bg(Col).

.init block_n = Tally<Unit, Ident>
block_n.item($U(), Id) :- blocks.label($U(), _, Id).

.init stack = AxisFrame<Unit>
stack.extent($U(), A, N) :- params.stack_axis(A), block_n.tally($U(), N).

placed($Count(), P_inner, P_intile) :-
    stack.cell($U(), A, P_tile), content(P_intile, _),                   // tile, and the cell in it
    params.line_width(W), concat_slab(P_tile, P_intile, A, W, P_inner).  // stacked, gapped by the line

// --- shared ---
// The copies in the output frame.
.decl copy_cell(ch: Choice, p_grid: Position, p_intile: Position)
copy_cell(Ch, P_grid, P_intile) :-
    placed(Ch, P_inner, P_intile), params.ring(R), compose(P_inner, R, P_grid).

// The output frame — the copies' frame, which the ring has grown.
.init frame = Frame2D<Choice>
frame.extent(Ch, A, N) :- copy_cell(Ch, P_grid, _), axis_elem(A), axis_dim(P_grid, A, N).

// A frame cell sharing a row or a column with a copy.
.decl copy_line(ch: Choice, p_grid: Position)
copy_line(Ch, P_grid) :-
    frame.cell(Ch, P_grid), axis_elem(A),
    copy_cell(Ch, Q, _), same_line(A, P_grid, Q).

out(P_grid, Col, Ch) :- copy_cell(Ch, P_grid, P_intile), content(P_intile, Col).
out(P_grid, Col, Ch) :-
    frame.cell(Ch, P_grid), !copy_cell(Ch, P_grid, _),   // a frame cell off the copies
    ( copy_line(Ch, P_grid), params.line_col(Col)        // on a copy's line
    ; !copy_line(Ch, P_grid), params.bg(Col) ).          // where two lines cross

.type ExAxis = [e: Example, a: Axis]

.comp Determine {
    // Where the copies seat on the output. A copy is the input under
    // params.xform.
    .init seat = Occurrences<Example, Color>
    seat.shape(E, P_intile, Col) :-
        ex_in(E, P_grid_in, Col), params.xform(D), apply(D, P_grid_in, P_intile).
    seat.cell(E, P_grid, Col) :- ex_out(E, P_grid, Col).

    // The tile count on each axis: how many distinct offsets the seats take
    // along it.
    .init tile_n = Tally<ExAxis, Position>
    tile_n.item([E, A], P_along) :-
        seat.occurrence(E, V), axis_elem(A), split(V, A, P_along, _).

    .init tile_dim = Unanimous<Axis, number>
    tile_dim.item(A, N) :- tile_n.tally([_, A], N).

    .decl tiles(a: Axis, n: number)
    tiles(A, N) :- tile_dim.value(A, N).
}
