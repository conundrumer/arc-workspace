// 0bb8deee
// concept: decompose crop move lookup
// A cross of one full row and one full column, each a single non-bg color,
// cuts the grid into four unequal quadrants, one shape per quadrant. The
// output crops each shape to its bounding box and reassembles the crops.
//
// $Concat — the crops abut in the quadrants' own arrangement; the output
// frame follows their sizes.
// $Place — a stored table seats each quadrant's crop in the output canvas.

#include "../lib.dl"

.type Choice = Concat {} | Place {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color) bg(0).

    // --- Place ---
    // Box each quadrant's crop occupies in the output canvas, as margins.
    .decl tile_box(p_tile: Position, p_box: Position)
    tile_box([0, 1, 0, 1], [0, 3, 0, 3]).
    tile_box([0, 1, 1, 0], [0, 3, 3, 0]).
    tile_box([1, 0, 0, 1], [3, 0, 0, 3]).
    tile_box([1, 0, 1, 0], [3, 0, 3, 0]).
}

.init c = Consts

// The nonuniform tile arrangement a divider set induces — the divider peer
// of OrderFrame: a cell's tile position holds, toward each edge, the count
// of dividers between the cell and that edge. Divider cells get no tile.
.comp DividerFrame<Key> {
    .decl cell(key: Key, p: Position)              // input
    .decl divider(key: Key, a: Axis, l: Position)  // input

    // Divider distances, materialized for the counts below.
    .decl div_dist(key: Key, a: Axis, d: Dir, k: number)
    div_dist(K, A, D, K1) :- divider(K, A, L), axis_of(D, A), dist(L, D, K1).

    // p's line on axis a holds a divider.
    .decl on_divider(key: Key, p: Position, a: Axis)
    on_divider(K, P, A) :- cell(K, P), div_dist(K, A, D, K1), dist(P, D, K1).

    // p's tile index from edge d — the dividers between p and edge d.
    .decl part_idx(key: Key, p: Position, d: Dir, n: number)
    part_idx(K, P, D, N) :-
        cell(K, P), axis_of(D, A), !on_divider(K, P, A), dist(P, D, K1),
        N = count : { div_dist(K, A, D, K2), K2 < K1 }.

    // The part of axis a that p sits in, as an axis-only position: p's
    // tile index from each edge of the axis.
    .decl part_of(key: Key, p: Position, a: Axis, p_part: Position)
    part_of(K, P, A, P_part) :-
        axis_of(D, A), opposite(D, D2),                 // the axis's two dirs
        part_idx(K, P, D, N1), part_idx(K, P, D2, N2),  // index from each
        edge_delta(D, N1, Q1), edge_delta(D2, N2, Q2), compose(Q1, Q2, P_part).

    // P's tile, parts on both axes glued.
    .decl tile_of(key: Key, p: Position, p_tile: Position)
    tile_of(K, P, P_tile) :-
        part_of(K, P, A, P1), perp(A, A2), part_of(K, P, A2, P2),  // part on each axis
        compose(P1, P2, P_tile).                                   // glued
}

// --- parse ---

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    // Color present on the line at l along axis a.
    .decl line_color(key: Key, a: Axis, l: Position, col: Color)
    line_color(K, A, L, Col) :- cell(K, P, Col), axis_elem(A), split(P, A, L, _).

    .decl line_mixed(key: Key, a: Axis, l: Position)
    line_mixed(K, A, L) :- line_color(K, A, L, Col), line_color(K, A, L, Col2), Col != Col2.

    .init frame = DividerFrame<Key>
    frame.cell(K, P) :- cell(K, P, _).

    // Divider: a line of one non-bg color.
    frame.divider(K, A, L) :- line_color(K, A, L, Col), !c.bg(Col), !line_mixed(K, A, L).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- crops ---

// Each quadrant viewed from the bounding box of the shape it holds.
.init box = BoxFrame<Position>
box.cell(P_tile, P) :- parse.frame.tile_of($U(), P, P_tile), in(P, Col), !c.bg(Col).
box.grid(P_tile, P) :- parse.frame.tile_of($U(), P, P_tile).

.decl out(p: Position, col: Color, c: Choice)

// --- Concat ---
out(P_grid_out, Col, $Concat()) :-
    box.inner(P_tile, P, P_intile), in(P, Col),   // cropped cell
    concat_2d(P_tile, P_intile, 0, P_grid_out).   // crops abut

// --- Place ---
out(P_grid_out, Col, $Place()) :-
    box.inner(P_tile, P, P_intile), in(P, Col),  // cropped cell
    c.tile_box(P_tile, P_box),                   // the quadrant's stored box
    compose(P_box, P_intile, P_grid_out).        // seated in it

// --- fit ---

.comp Fit {
    .type ET = [e: Example, p_tile: Position]

    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col).

    // The color of the shape in each quadrant.
    .decl shape_color(e: Example, p_tile: Position, col: Color)
    shape_color(E, P_tile, Col) :-
        ex.frame.tile_of(E, P, P_tile), ex.cell(E, P, Col), !c.bg(Col).

    // A crop keeps its shape's color, so its box in the output canvas is
    // that color's bbox in the example output.
    .init obox = Bbox<ET>
    obox.cell([E, P_tile], P) :- ex_out(E, P, Col), shape_color(E, P_tile, Col).

    .decl tile_box(p_tile: Position, p_box: Position)
    tile_box(P_tile, P_box) :- obox.margin([_, P_tile], P_box).
}
