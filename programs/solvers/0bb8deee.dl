// 0bb8deee
// @keywords: decompose crop move lookup
// output: A cross of one full row and one full column, each a single non-bg
//  color, cuts the grid into four unequal quadrants, one shape per quadrant.
//  The output crops each shape to its bounding box and reassembles the crops.

// how the crops are reassembled
.type Choice =
    // the crops abut in the quadrants' own arrangement; the output frame
    // follows their sizes
    Concat {}
    // a stored table seats each quadrant's crop in the output canvas
  | Place {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- Place ---
    // Box each quadrant's crop occupies in the output canvas.
    .decl tile_box(p_tile: Position, b: Box)
    tile_box([0, 1, 0, 1], [0, 3, 0, 3]).
    tile_box([0, 1, 1, 0], [0, 3, 3, 0]).
    tile_box([1, 0, 0, 1], [3, 0, 0, 3]).
    tile_box([1, 0, 1, 0], [3, 0, 3, 0]).
}

.init params = Params

.comp Parse<Key> {
    .type Line = [key: Key, a: Axis, l: Position]

    .decl cell(key: Key, p: Position, col: Color)  // input

    .init line_color = Unanimous<Line, Color>
    line_color.item([K, A, L], Col) :- cell(K, P, Col), axis_elem(A), split(P, A, L, _).

    .init frame = DividerTiles<Key>
    frame.cell(K, P) :- cell(K, P, _).

    // Divider: a line of one non-bg color.
    frame.divider(K, A, L) :- line_color.value([K, A, L], Col), !params.bg(Col).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- crops ---

// Each quadrant viewed from the bounding box of the shape it holds.
.init hull = Bbox<Position>
hull.cell(P_tile, P) :- parse.frame.tile_of($U(), P, P_tile), in(P, Col), !params.bg(Col).

.decl crop_cell(p_tile: Position, p_intile: Position, col: Color)
crop_cell(P_tile, P_intile, Col) :-
    parse.frame.tile_of($U(), P, P_tile), in(P, Col),   // quadrant cell
    hull.box(P_tile, B), crop(P, B, P_intile).          // in the shape's box

// --- Concat ---
out(P_grid_out, Col, $Concat()) :-
    crop_cell(P_tile, P_intile, Col),
    concat_2d(P_tile, P_intile, 0, P_grid_out).   // crops abut

// --- Place ---
out(P_grid_out, Col, $Place()) :-
    crop_cell(P_tile, P_intile, Col),
    params.tile_box(P_tile, B),              // the quadrant's stored box
    compose(B, P_intile, P_grid_out).        // seated in it

.comp Determine {
    .type ET = [e: Example, p_tile: Position]

    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col).

    // The color of the shape in each quadrant.
    .decl shape_color(e: Example, p_tile: Position, col: Color)
    shape_color(E, P_tile, Col) :-
        ex.frame.tile_of(E, P, P_tile), ex.cell(E, P, Col), !params.bg(Col).

    // A crop keeps its shape's color, so its box in the output canvas is
    // that color's bounding box in the example output.
    .init obox = Bbox<ET>
    obox.cell([E, P_tile], P) :- ex_out(E, P, Col), shape_color(E, P_tile, Col).

    .decl tile_box(p_tile: Position, b: Box)
    tile_box(P_tile, B) :- obox.box([_, P_tile], B).
}
