// 7d7772cc
// draft
// keywords: border markers move
// input: A thin fence of one color runs across the grid and, with two arms
//  along the grid edges, pens in one side. On the free side, marks sit in one
//  line parallel to the fence; inside the pen, a gate cell faces each mark
//  across the fence. No task data: the fence, the open side, and the free bg
//  are read from the grid.
// output: Each mark moves along its own line: to the cell beside the fence
//  when the gate has its color, else to the far grid edge. Its old cell takes
//  the free side's bg.

.type Line = [a: Axis, p_line: Position]

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

// A color is thin when every cell of it borders another color or the edge.
.init thin = Rim<Color>
thin.cell(Col, P) :- in(P, Col).

.decl thick(col: Color)
thick(Col) :- in(P, Col), !thin.rim(Col, P).

// A line of one color, keyed by its normal axis.
.init line_color = Unanimous<Line, Color>
line_color.item([A, P_line], Col) :- in(P, Col), axis_elem(A), split(P, A, P_line, _).

// The fence is the cells of a thin color that fills a whole line. The pen
// is its bounding box: it touches the grid edge everywhere but toward the
// open side.
.decl fence(p: Position)
fence(P) :- in(P, Col), line_color.value(_, Col), !thick(Col).

.init pen = Bbox<Unit>
pen.cell($U(), P) :- fence(P).

.decl open_dir(d: Dir)
open_dir(D) :- pen.box($U(), B), dir_elem(D), !dist(B, D, 0).

.decl penned(p: Position)
penned(P) :- in(P, _), pen.box($U(), B), inside(P, B).

.decl free_cell(p: Position)
free_cell(P) :- in(P, _), !penned(P).

.init free_bg = Mode<Unit, Color, Position>
free_bg.item($U(), Col, P) :- free_cell(P), in(P, Col).

.decl mark(p: Position, col: Color)
mark(P, Col) :- free_cell(P), in(P, Col), !free_bg.mode($U(), Col).

// Where each mark comes to rest.
.decl rest(p: Position, col: Color)
rest(Q, Col) :-
    mark(P, Col), open_dir(D), axis_of(D, A),                    // a mark and its line across the fence
    fence(S), pen.box($U(), B), box_edge(S, B, D),               // the fence cell toward D
    same_line(A, P, S),                                          // on the mark's line
    opposite(D, D_in), neighbor(S, D_in, G),                     // the gate behind it
    ( in(G, Col), neighbor(S, D, Q)                              // gate matches: beside the fence
    ; !in(G, Col), same_line(A, P, Q), in(Q, _), dist(Q, D, 0)   // gate differs: the far edge
    ).

out(P, Col) :-
    in(P, Col_in),
    ( rest(P, Col)                                       // a mark lands here
    ; !rest(P, _), mark(P, _), free_bg.mode($U(), Col)   // vacated
    ; !rest(P, _), !mark(P, _), Col = Col_in             // untouched
    ).
