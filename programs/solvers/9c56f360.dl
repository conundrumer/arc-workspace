// 9c56f360
// @keywords: lines move
// output: The mover-colored cells in each line pack toward the dir edge against
//  the nearest barrier, order kept; vacated cells become background.

// what blocks the pack
.type Choice =
    // only the wall color blocks; other ink is passed over
    Wall {}
    // any other ink blocks
  | Solid {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl mover(c: Color) mover(3).
    .decl dir(d: Dir) dir(DIR_L).

    // --- $Wall ---
    .decl wall(c: Color) wall(8).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Wall()). impl_choice($Solid()).

.decl mover(p: Position)
mover(P) :- in(P, Col), params.mover(Col).

// Each mover cell travels toward the dir edge and stops against what blocks
// the pack or against the movers already packed ahead of it.
.init pack = Gravity<Choice, Position>
pack.dir(Ch, D) :- impl_choice(Ch), params.dir(D).
pack.cell(Ch, P, P) :- impl_choice(Ch), mover(P).
// --- $Wall ---
pack.blocked($Wall(), P) :- in(P, Col), params.wall(Col).
// --- $Solid ---
pack.blocked($Solid(), P) :- in(P, Col), !params.bg(Col), !params.mover(Col).

// --- $Wall, $Solid ---

.decl moved(ch: Choice, p: Position)
moved(Ch, P2) :- pack.travel(Ch, P, V), compose(P, V, P2).

out(P, Col, Ch) :- params.mover(Col), moved(Ch, P).
out(P, Col, Ch) :- params.bg(Col), impl_choice(Ch), mover(P), !moved(Ch, P).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !mover(P), !moved(Ch, P).
