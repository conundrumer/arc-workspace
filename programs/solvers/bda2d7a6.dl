// bda2d7a6
// @draft
// @keywords: rings rank permutation mapping count
// @scene nested-rings: the grid is square, and every cell's color depends
//  only on its ring, the cells at one distance from the nearest frame edge;
//  each ring is 1 cell wide
// @scene color-cycle: read from the outermost ring inward, the first 3 rings
//  show 3 distinct colors, one new color each, and every ring after them
//  repeats a color already seen
// @rule cycle-colors: list the distinct colors in the order they first
//  appear from the outermost ring inward; every cell of a color takes the
//  color just before it in that list, and the first color takes the last

// the order that lists the colors
.type ListOrder =
    // @claim cycle-colors
    FirstSeen {}
    // @rule cycle-colors: the colors are listed by their cell count, the
    //  highest first; undefined where two colors have the same count
    // @witness non-periodic-rings: variant concept
  | CountOrder {}

// which color each color takes
.type Predecessor =
    // @claim cycle-colors
    ListCycle {order: ListOrder}
    // @rule cycle-colors: each color takes the color of the ring just
    //  outside its outermost ring, and the outermost ring's color takes the
    //  last color to appear; undefined where that ring holds two colors
    // @witness repeat-before-new-color: variant concept
    //     @relaxed color-cycle
  | EnclosingColor {}

// what the output takes from the input
.type Choice =
    // @claim cycle-colors
    Recolor {pred: Predecessor}
    // @rule cycle-colors: each ring takes the color of the ring just outside
    //  it, and the outermost ring takes the color of the ring with as many
    //  rings outside it as the input has colors other than the outermost
    //  ring's
    // @witness non-periodic-rings: variant concept
  | RingShift {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {}

.init params = Params

// The grid peels into rings, one per depth.
// @claim nested-rings
.init peel = Rim<Unit>
peel.cell($U(), P) :- in(P, _).

.decl ring_color(i: number, col: Color)
ring_color(I, Col) :- peel.depth($U(), P, I), in(P, Col).

// The depth of each color's outermost ring: where it first appears.
// @claim cycle-colors
.init appear = Extremes<Color>
appear.cand(Col, I) :- ring_color(I, Col).

// --- $ListCycle ---

// @claim cycle-colors
.init order = Order<ListOrder, Color>

// A color takes the color just before it, and the first color the last.
out(P, Col, $Recolor($ListCycle(O))) :-
    in(P, C),
    ( order.next(O, Col, C)
    ; order.first(O, C), order.last(O, Col) ).

// --- $FirstSeen ---

order.elem($FirstSeen(), Col) :- in(_, Col).
order.score($FirstSeen(), Col, I) :- appear.low(Col, I).

// --- $CountOrder ---

// @claim cycle-colors
.init size = Tally<Color, Position>
size.item(Col, P) :- in(P, Col).

// The place of each cell count among the counts, from the highest.
// @claim cycle-colors
.init size_rank = Ordinal<Unit>
size_rank.idx_set($U(), N) :- size.tally(_, N).

order.elem($CountOrder(), Col) :- in(_, Col).
order.score($CountOrder(), Col, R) :- size.tally(Col, N), size_rank.rank_desc($U(), N, R).

// --- $EnclosingColor, $RingShift ---

// Ring i2 lies just outside ring i.
.decl outer_ring(i: number, i2: number)
outer_ring(I, I2) :-
    peel.depth($U(), P, I), neighbor(P, _, Q), peel.depth($U(), Q, I2), I2 < I.

// --- $EnclosingColor ---

// The depth at which the last color first appears.
// @claim cycle-colors
.init newest = Extremes<Unit>
newest.cand($U(), I) :- appear.low(_, I).

out(P, Col, $Recolor($EnclosingColor())) :-
    in(P, C), appear.low(C, I),
    ( outer_ring(I, I2), ring_color(I2, Col)                    // the ring just outside
    ; I = 0, newest.high($U(), I2), appear.low(Col, I2) ).      // the last color to appear

// --- $RingShift ---

// The colors other than the outermost ring's.
// @store tally: variant concept
//     @relaxed color-cycle
// @claim cycle-colors
.init others = Tally<Unit, Color>
others.item($U(), Col) :- in(_, Col), !ring_color(0, Col).
others.domain($U()).

out(P, Col, $RingShift()) :-
    peel.depth($U(), P, I),
    ( outer_ring(I, I2), ring_color(I2, Col)                        // the ring just outside
    ; I = 0, others.tally($U(), I2), ring_color(I2, Col) ).         // as deep as the other colors are many
