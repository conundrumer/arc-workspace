// 0934a4d8
// concept: symmetry decompose crop repair
// A mosaic occluded by a solid block of a mask color; the output is the
// block's content. The mosaic overhangs the grid and decomposes into an
// arrangement of square tiles; each tile carries the subgroup of
// whole-mosaic transforms that holds on its cells. A hidden cell restores
// from a visible cell that a transform of its tile's subgroup reaches.

#include "../lib.dl"

// Staged: `Sym` (proposals.md) — D4 subgroups as a value type.
.type Sym <: number

.comp SymTable {
    #define SYM_1   70
    #define SYM_LR  71
    #define SYM_TB  72
    #define SYM_HT  73
    #define SYM_DG  74
    #define SYM_AD  75
    #define SYM_BOX 76
    #define SYM_X   77
    #define SYM_C4  78
    #define SYM_D4  79

    .decl sym_elem(s: Sym)
    sym_elem(SYM_1). sym_elem(SYM_LR). sym_elem(SYM_TB). sym_elem(SYM_HT).
    sym_elem(SYM_DG). sym_elem(SYM_AD). sym_elem(SYM_BOX). sym_elem(SYM_X).
    sym_elem(SYM_C4). sym_elem(SYM_D4).

    .decl sym_member(s: Sym, d: D4)
    sym_member(SYM_1, D4_ID).
    sym_member(SYM_LR, D4_ID). sym_member(SYM_LR, D4_LR).
    sym_member(SYM_TB, D4_ID). sym_member(SYM_TB, D4_TB).
    sym_member(SYM_HT, D4_ID). sym_member(SYM_HT, D4_HT).
    sym_member(SYM_DG, D4_ID). sym_member(SYM_DG, D4_DG).
    sym_member(SYM_AD, D4_ID). sym_member(SYM_AD, D4_AD).
    sym_member(SYM_BOX, D4_ID). sym_member(SYM_BOX, D4_LR).
    sym_member(SYM_BOX, D4_TB). sym_member(SYM_BOX, D4_HT).
    sym_member(SYM_X, D4_ID). sym_member(SYM_X, D4_HT).
    sym_member(SYM_X, D4_DG). sym_member(SYM_X, D4_AD).
    sym_member(SYM_C4, D4_ID). sym_member(SYM_C4, D4_CW).
    sym_member(SYM_C4, D4_HT). sym_member(SYM_C4, D4_CC).
    sym_member(SYM_D4, D) :- d4_elem(D).
}

.init symtbl = SymTable

.comp Consts {
    .decl mask(col: Color) mask(8).

    // The grid's margins within the mosaic frame.
    .decl mosaic_margin(p: Inset) mosaic_margin([0, 2, 0, 2]).

    .decl tile_dim(k: number) tile_dim(8).

    // Per tile, the subgroup of mosaic transforms holding on its cells.
    .decl tile_sym(p_tile: Position, s: Sym)
    GRID_4x4(tile_sym,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX)
}

.init c = Consts

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !c.mask(Col).

// Mosaic position of each grid cell — materialized to read backward.
.decl mosaic(p_grid: Position, p_mosaic: Position)
mosaic(P_grid, P_mosaic) :- in(P_grid, _), c.mosaic_margin(M), compose(P_grid, M, P_mosaic).

// The hole: the masked cells.
.init box = BoxFrame<Unit>
box.cell($U(), P) :- in(P, Col), c.mask(Col).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    box.inner($U(), P, P_out),                        // hole cell, in the crop frame
    mosaic(P, Pm),
    c.tile_dim(K), divide_by_size_2d(Pm, K, 0, T, _), // its tile
    c.tile_sym(T, S), symtbl.sym_member(S, D),        // a transform holding there
    apply(D, Pm, P2m),                                // image in the mosaic
    mosaic(P2, P2m), clean(P2, Col).                  // visible grid cell there

// --- fit ---

.comp Fit {
    .decl cell(e: Example, p: Position, col: Color)
    cell(E, P, Col) :- ex_in(E, P, Col), !c.mask(Col).

    // Axis positions the examples' cells occupy, and cells split by axis
    // (materialized once — the mirror sweep joins on the components).
    .decl apos(a: Axis, along: Position)
    apos(A, Along) :- ex_in(_, P, _), axis_elem(A), split(P, A, Along, _).

    .decl cell_split(e: Example, a: Axis, along: Position, across: Position, col: Color)
    cell_split(E, A, Along, Across, Col) :-
        cell(E, P, Col), axis_elem(A), split(P, A, Along, Across).

    // One-sided frame-extension candidates per axis: k cells past edge d.
    .decl ext_cand(a: Axis, m: Inset)
    ext_cand(A, M) :- apos(A, Along), sub_extent(Along, A, K), axis_of(D, A), edge_delta(D, K, M).

    // The candidate's mirror, as a map on axis positions.
    .decl ext_map(a: Axis, m: Inset, along: Position, along2: Position)
    ext_map(A, M, L, L2) :-
        ext_cand(A, M), apos(A, L), flip_of(A, F),
        compose(L, M, Lm),                          // extended-frame position
        apply(F, Lm, L_img),                        // mirror image
        apos(A, L2), compose(L2, M, L_img).         // back in-grid

    // The extension's mirror maps a clean pair to different colors...
    .decl ext_broken(a: Axis, m: Inset)
    ext_broken(A, M) :-
        ext_map(A, M, L1, L2),
        cell_split(E, A, L1, X, C1),
        cell_split(E, A, L2, X, C2), C2 != C1.

    // ...or relates some pair of distinct cells.
    .decl ext_pair(a: Axis, m: Inset)
    ext_pair(A, M) :-
        ext_map(A, M, L1, L2), L1 != L2,
        cell_split(E, A, L1, X, _),
        cell_split(E, A, L2, X, _).

    // Per axis, the witnessed unbroken extension; the margin composes the
    // two axes.
    .decl axis_ext(a: Axis, m: Inset)
    axis_ext(A, M) :- ext_pair(A, M), !ext_broken(A, M).

    .decl mosaic_margin(p: Inset)
    mosaic_margin(M) :- axis_ext(A1, M1), perp(A1, A2), axis_ext(A2, M2), compose(M1, M2, M).

    // Clean cells in mosaic coordinates.
    .decl mcell(e: Example, p: Position, col: Color)
    mcell(E, Pm, Col) :- cell(E, P, Col), mosaic_margin(M), compose(P, M, Pm).

    // A mosaic transform mapping some clean cell here to a differing clean
    // cell — the violation locus the tile labels partition.
    .decl viol(p: Position, d: D4)
    viol(Pm, D) :-
        d4_elem(D),
        mcell(E, Pm, C1), apply(D, Pm, P2m),
        mcell(E, P2m, C2), C2 != C1.

    // Mosaic cell to tile, at every candidate tile extent.
    .decl kcand(k: number)
    kcand(K) :- mcell(_, P, _), axis_elem(A), sub_extent(P, A, K).

    .decl tposk(k: number, p: Position, p_tile: Position)
    tposk(K, Pm, T) :- mcell(_, Pm, _), kcand(K), divide_by_size_2d(Pm, K, 0, T, _).

    .decl brokenk(k: number, p_tile: Position, d: D4)
    brokenk(K, T, D) :- tposk(K, Pm, T), viol(Pm, D).

    .decl symk(k: number, p_tile: Position, d: D4)
    symk(K, T, D) :- tposk(K, _, T), d4_elem(D), !brokenk(K, T, D).

    // Tile extent: the coarsest decomposition whose tile labels differ.
    .init nonuniform = Extremes<Unit>
    nonuniform.cand($U(), K) :- symk(K, T1, D), tposk(K, _, T2), !symk(K, T2, D).

    .decl tile_dim(k: number)
    tile_dim(K) :- nonuniform.high($U(), K).

    // Each tile's group is the named subgroup matching its unbroken set.
    .decl symt(p_tile: Position, d: D4)
    symt(T, D) :- tile_dim(K), symk(K, T, D).

    .init symid = KeyedSetCompare<Position, Sym, D4>
    symid.pattern_member(S, D) :- symtbl.sym_member(S, D).
    symid.observed_member(T, D) :- symt(T, D).

    .decl tile_sym(p_tile: Position, s: Sym)
    tile_sym(T, S) :- symid.equals(T, S).
}
