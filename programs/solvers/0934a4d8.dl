// 0934a4d8
// @keywords: symmetry decompose crop repair latent-canvas
// input: a mosaic that overhangs the grid and decomposes into an arrangement
//  of square tiles, occluded by a solid block of params.mask
// output: The output is the block's content. Each tile carries the subgroup of
//  whole-mosaic transforms that holds on its cells, and a hidden cell restores
//  from a visible cell that a transform of its tile's subgroup reaches.

.decl out(p: Position, col: Color)

.comp Params {
    .decl mask(col: Color) mask(8).

    // The grid's margins within the mosaic frame.
    .decl mosaic_margin(b: Box) mosaic_margin([0, 2, 0, 2]).

    // Per tile, the subgroup of mosaic transforms holding on its cells.
    .decl tile_sym(p_tile: Position, s: Sym)
    GRID_4x4(tile_sym,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX)

    // The tiles along each axis — the arrangement tile_sym is laid over.
    .decl tile_count(n: number)
    tile_count(N) :- tile_sym(T, _), axis_elem(A), axis_dim(T, A, N).
}

.init params = Params

// Mosaic position of each grid cell.
.decl mosaic(p_grid: Position, p_mosaic: Position)
mosaic(P_grid, P_mosaic) :- in(P_grid, _), params.mosaic_margin(B), compose(P_grid, B, P_mosaic).

// The hole: the masked cells.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.mask(Col).

out(P_inner, Col) :-
    bbox.cell($U(), P), bbox.box($U(), B),
    crop(P, B, P_inner),                               // hole cell, in the crop frame
    mosaic(P, Pm),
    params.tile_count(N), divide_2d(Pm, N, 0, T, _),   // its tile
    params.tile_sym(T, S), sym_member(S, D),           // a transform holding there
    apply(D, Pm, P2m),                                 // image in the mosaic
    mosaic(P2, P2m), in(P2, Col), !params.mask(Col).   // visible grid cell there

.comp Determine {
    .decl cell(e: Example, p: Position, col: Color)
    cell(E, P, Col) :- ex_in(E, P, Col), !params.mask(Col).

    // The axis positions the inputs occupy.
    .decl apos(a: Axis, along: Position)
    apos(A, Along) :- ex_in(_, P, _), axis_elem(A), split(P, A, Along, _).

    .decl cell_split(e: Example, a: Axis, along: Position, across: Position, col: Color)
    cell_split(E, A, Along, Across, Col) :-
        cell(E, P, Col), axis_elem(A), split(P, A, Along, Across).

    // One-sided frame-extension candidates per axis: k cells past edge d.
    .decl ext_cand(a: Axis, b: Box)
    ext_cand(A, B) :- apos(A, Along), sub_extent(Along, A, K), axis_of(D, A), edge_inset(D, K, B).

    // The candidate's mirror, as a map on axis positions.
    .decl ext_map(a: Axis, b: Box, along: Position, along2: Position)
    ext_map(A, B, L, L2) :-
        ext_cand(A, B), apos(A, L), flip_of(A, F),
        compose(L, B, Lm),                          // extended-frame position
        apply(F, Lm, L_img),                        // mirror image
        apos(A, L2), compose(L2, B, L_img).         // back in-grid

    // The extension's mirror maps a clean pair to different colors.
    .decl ext_mismatch(a: Axis, b: Box)
    ext_mismatch(A, B) :-
        ext_map(A, B, L1, L2),
        cell_split(E, A, L1, X, C1),
        cell_split(E, A, L2, X, C2), C2 != C1.

    // The extension's mirror relates two distinct cells — the witness that
    // the examples exercise it.
    .decl ext_pair(a: Axis, b: Box)
    ext_pair(A, B) :-
        ext_map(A, B, L1, L2), L1 != L2,
        cell_split(E, A, L1, X, _),
        cell_split(E, A, L2, X, _).

    // Per axis, the witnessed unbroken extension; the margin composes the
    // two axes.
    .decl axis_ext(a: Axis, b: Box)
    axis_ext(A, B) :- ext_pair(A, B), !ext_mismatch(A, B).

    .decl mosaic_margin(b: Box)
    mosaic_margin(B) :- axis_ext(A1, B1), perp(A1, A2), axis_ext(A2, B2), compose(B1, B2, B).

    // Clean cells in mosaic coordinates.
    .decl mcell(e: Example, p: Position, col: Color)
    mcell(E, Pm, Col) :- cell(E, P, Col), mosaic_margin(B), compose(P, B, Pm).

    // The mosaic's own symmetries, per example.
    .init inv = D4Map<Example, Color>
    inv.src(E, P, Col) :- mcell(E, P, Col).
    inv.dst(E, P, Col) :- mcell(E, P, Col).

    // --- proposal: D4Map.broken ---
    // The cell where a transform breaks: its image holds a differing clean
    // cell. `conflict` with the cell kept.
    .decl broken(e: Example, p: Position, d: D4)
    broken(E, P, D) :-
        inv.src(E, P, V), d4_elem(D), apply(D, P, P2),
        inv.dst(E, P2, V2), V2 != V.

    // Mosaic cell to tile, at every candidate tile count.
    .decl cand_count(n: number)
    cand_count(N) :- mcell(_, P, _), axis_elem(A), sub_extent(P, A, N).

    .decl cand_tile(n: number, p: Position, p_tile: Position)
    cand_tile(N, Pm, T) :- mcell(_, Pm, _), cand_count(N), divide_2d(Pm, N, 0, T, _).

    // The transforms a candidate's tile breaks, and the ones it holds.
    .decl cand_broken(n: number, p_tile: Position, d: D4)
    cand_broken(N, T, D) :- cand_tile(N, Pm, T), broken(_, Pm, D).

    .decl cand_sym(n: number, p_tile: Position, d: D4)
    cand_sym(N, T, D) :- cand_tile(N, _, T), d4_elem(D), !cand_broken(N, T, D).

    // Tile count: the coarsest decomposition whose tile labels differ.
    .init nonuniform = Extremes<Unit>
    nonuniform.cand($U(), N) :- cand_sym(N, T1, D), cand_tile(N, _, T2), !cand_sym(N, T2, D).

    .decl tile_count(n: number)
    tile_count(N) :- nonuniform.low($U(), N).

    // Each tile's group is the named subgroup matching its unbroken set.
    .init symid = KeyedSetCompare<Position, Sym, D4>
    symid.pattern_member(S, D) :- sym_member(S, D).
    symid.observed_member(T, D) :- tile_count(N), cand_sym(N, T, D).

    .decl tile_sym(p_tile: Position, s: Sym)
    tile_sym(T, S) :- symid.equals(T, S).
}
