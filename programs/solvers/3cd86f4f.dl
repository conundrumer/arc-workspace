// 3cd86f4f
// concept: lines grow move
// Shear: the grid's params.slide-lines slide against each other, one cell per
// line — the across-lines rotate by params.sense onto a diagonal, widening the
// frame by (lines - 1). Vacated cells are bg. Either cross dir spells the
// same map; the rule derives it from both.

#include "../lib.dl"

.comp Params {
    .decl slide(a: Axis) slide(AXIS_H).     // axis the lines slide along
    .decl sense(s: Sense) sense(SENSE_CW).  // rotation of the across-lines
    .decl bg(c: Color) bg(0).
}

.init params = Params

// An inset, not a translation: the two magnitudes place the line and widen
// the frame together.
.decl shear(p_in: Position, p_out: Position)
shear(P_in, P_out) :-
    in(P_in, _),
    params.slide(A), perp(A, A2), axis_of(D_m, A2),           // either cross dir
    params.sense(S), turn(S, D_m, D_push),                    // going toward d_m, cells push toward its turn
    dist_pair(P_in, D_m, K_m, K_o),                           // shift magnitudes, from d_m and from across
    axis_delta(D_push, K_m, K_o, Delta), compose(P_in, Delta, P_out).

.decl image(p: Position)
image(P_out) :- shear(_, P_out).

// The sheared frame: image slide-parts crossed with image across-parts.
.decl frame(p: Position)
frame(P) :-
    image(P1), image(P2),
    params.slide(A), split(P1, A, Along, _), split(P2, A, _, Across),
    compose(Along, Across, P).

.decl out(p: Position, col: Color)
out(P_out, Col) :- in(P_in, Col), shear(P_in, P_out).
out(P, Col) :- frame(P), !image(P), params.bg(Col).
