// 3cd86f4f
// concept: lines grow move
// Shear: the grid's c.slide-lines slide against each other, one cell per
// line — the across-lines rotate by c.sense onto a diagonal, widening the
// frame by (lines - 1). Vacated cells are bg. Either cross dir spells the
// same map; the rule derives it from both.

#include "../lib.dl"

.comp Consts {
    .decl slide(a: Axis)   slide(AXIS_H).    // axis the lines slide along
    .decl sense(s: Sense)  sense(SENSE_CW).  // rotation of the across-lines
    .decl bg(c: Color)     bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// The push grows one slot of the slide axis; the complementary growth on
// the other slot keeps the widened frame consistent.
.decl shear(p_in: Position, p_out: Position)
shear(P_in, P_out) :-
    in(P_in, _),
    c.slide(A), perp(A, A2), axis_of(D_m, A2),           // either cross dir
    c.sense(S), turn(S, D_m, D_push),                    // going toward d_m, cells push toward its turn
    opposite(D_m, M), dist_pair(P_in, M, Kn, Kf),        // near/far shift magnitudes
    opposite(D_push, D_away),
    edge_delta(D_away, Kn, Delta_n), edge_delta(D_push, Kf, Delta_f),
    compose(P_in, Delta_n, P_mid), compose(P_mid, Delta_f, P_out).

.decl image(p: Position)
image(P_out) :- shear(_, P_out).

// The sheared frame: image slide-parts crossed with image across-parts.
.decl frame(p: Position)
frame(P) :-
    image(P1), image(P2),
    c.slide(A), split(P1, A, Along, _), split(P2, A, _, Across),
    compose(Along, Across, P).

.decl out(p: Position, col: Color)
out(P_out, Col) :- in(P_in, Col), shear(P_in, P_out).
out(P, Col) :- frame(P), !image(P), c.bg(Col).

.output out(IO=stdout)
