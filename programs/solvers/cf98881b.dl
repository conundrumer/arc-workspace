// cf98881b
// concept: overlay decompose lookup rank
// Layout: 1×3 horizontally-side-by-side 4×4 ink panes with 1-col dividers.
// Output is the per-cell overlay: the highest-priority inked pane wins;
// no ink is bg. The divider color is never read.
//
// out's choice column = [d, b]:
//
//   d (decompose):
//     $Tile() — pre-tabulated in Consts via tile_pos
//     $Div()  — derived in body via the divide primitive
//
//   b (body, the priority claim):
//     $Spatial() — pane order: the pane nearest c.stack_dir wins
//     $Palette() — color order: the c.ink_rank priority ranks
//     $Stack()   — pane order: the c.pane_rank priority ranks

#include "../lib.dl"

.type DecChoice = Tile {} | Div {}
.type Body      = Spatial {} | Palette {} | Stack {}
.type Choice    = [d: DecChoice, b: Body]

.comp Consts {
    .init helpers = ConstsHelpers

    .decl frame(p: Position)
    frame(P) :- helpers.frame_pos([4, 4], P).

    .decl bg(c: Color) bg(0).

    // --- Tile decompose data ---
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        helpers.tile_pos([1, 3], [4, 4], [0, 1], P_grid, P_tile, P_intile).

    // --- Div decompose data ---
    .decl divisor(n: number)
    divisor(3).

    .decl divide_axis(a: Axis)
    divide_axis(AXIS_H).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Spatial body data ---
    .decl stack_dir(d: Dir)
    stack_dir(DIR_L).

    // --- Palette body data ---
    // Ink priority ranks, highest first.
    .decl ink_rank(c: Color, r: number)
    ink_rank(4, 0). ink_rank(9, 1). ink_rank(1, 2).

    // --- Stack body data ---
    // Pane priority ranks, highest first.
    .decl pane_rank(p_tile: Position, r: number)
    GRID_1x3(pane_rank,
        0, 1, 2)
}

.init c = Consts

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- Overlay ---

// Inked pane cells competing at each output cell.
.decl cand(o: Position, p_tile: Position, col: Color, dc: DecChoice)
cand(P_grid_out, P_tile, Col, Dc) :-
    in(P_grid_in, Col), !c.bg(Col),
    decompose(P_grid_in, P_tile, P_grid_out, Dc).

.decl body_choice(b: Body)
body_choice($Spatial()).
body_choice($Palette()).
body_choice($Stack()).

.decl outranked(o: Position, p_tile: Position, dc: DecChoice, b: Body)

// --- Spatial: a candidate pane nearer the stack edge wins ---
outranked(O, T, Dc, $Spatial()) :-
    cand(O, T, _, Dc), cand(O, T2, _, Dc),
    c.stack_dir(D), dist(T2, D, K2), dist(T, D, K), K2 < K.

// --- Palette: a candidate of higher-ranked color wins ---
outranked(O, T, Dc, $Palette()) :-
    cand(O, T, Lo, Dc), cand(O, _, Hi, Dc),
    c.ink_rank(Hi, R_hi), c.ink_rank(Lo, R_lo), R_hi < R_lo.

// --- Stack: a candidate from a higher-ranked pane wins ---
outranked(O, T, Dc, $Stack()) :-
    cand(O, T, _, Dc), cand(O, T2, _, Dc),
    c.pane_rank(T2, R2), c.pane_rank(T, R), R2 < R.

// --- Output ---

.decl out(p: Position, col: Color, ch: Choice)
out(O, Col, [Dc, B]) :-
    cand(O, T, Col, Dc), body_choice(B),
    !outranked(O, T, Dc, B).
out(O, Bg, [Dc, B]) :-
    dec_choice(Dc), body_choice(B), c.frame(O),   // choice × cell
    c.bg(Bg), !cand(O, _, _, Dc).

// --- fit ---

.comp Fit {
    .decl cand(e: Example, o: Position, p_tile: Position, col: Color)
    cand(E, P_grid_out, P_tile, Col) :-
        ex_in(E, P_grid_in, Col), !c.bg(Col),                // inked input cell
        c.divide_axis(A), c.divisor(N), c.divide_gap(G),     // params
        divide_slab(P_grid_in, A, N, G, P_tile, P_grid_out).

    // Every pane pair overlaps somewhere, so direct wins order the panes.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        cand(E, O, T, Col), cand(E, O, T2, Col2), Col != Col2,
        ex_out(E, O, Col).

    .decl pane_rank(p_tile: Position, r: number)
    pane_rank(T, R) :- cand(_, _, T, _), R = count : { beats(T2, T) }.

    // Each pane keeps one ink, so a pane's rank is its ink's rank.
    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- cand(_, _, T, Col), pane_rank(T, R).
}
