// cf98881b
// @keywords: overlay decompose lookup rank
// input: 1×3 horizontally-side-by-side 4×4 ink panes with 1-col dividers
// output: The per-cell overlay: the highest-priority inked pane wins; no
//  ink is bg. The divider color is never read.

// decompose
.type DecChoice =
    // pre-tabulated in the parameters via tile_pos
    Table {}
    // derived in the program by pane count
  | Count {}
    // derived in the program by pane size
  | Size {}

// priority
.type Body =
    // pane order: the pane nearest params.stack_dir wins
    Spatial {}
    // color order: the params.ink_rank priority ranks
  | Palette {}
    // pane order: the params.pane_rank priority ranks
  | Stack {}

.type Choice    = [d: DecChoice, b: Body]

// The overlay runs per output cell, and each decompose case has its own.
.type Cell      = [o: Position, dc: DecChoice]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl frame_dim(k: number) frame_dim(4).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    .decl bg(c: Color) bg(0).

    // --- $Table: decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 1). arr_dim(AXIS_H, 3).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah), frame_dim(K), gap(G),
        helpers.tile_pos([Av, Ah], [K, K], [0, G], P_grid, P_tile, P_intile).

    // --- $Count, $Size: decompose data ---
    .decl divide_axis(a: Axis)
    divide_axis(AXIS_H).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- $Count: decompose data ---
    .decl divisor(n: number)
    divisor(3).

    // --- $Spatial: priority data ---
    .decl stack_dir(d: Dir)
    stack_dir(DIR_L).

    // --- $Palette: priority data ---
    // Ink priority ranks, highest first.
    .decl ink_rank(c: Color, r: number)
    ink_rank(4, 0). ink_rank(9, 1). ink_rank(1, 2).

    // --- $Stack: priority data ---
    // Pane priority ranks, highest first.
    .decl pane_rank(p_tile: Position, r: number)
    GRID_1x3(pane_rank,
        0, 1, 2)
}

.init params = Params

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Table()).
dec_choice($Count()).
dec_choice($Size()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Table()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Count()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Size()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.frame_dim(K), params.divide_gap(G),   // params: tile size = output frame extent
    divide_by_size_slab(P_grid, A, K, G, P_tile, P_intile).

// --- Overlay ---

// Inked pane cells competing at each output cell.
.decl cand(o: Position, p_tile: Position, col: Color, dc: DecChoice)
cand(P_grid_out, P_tile, Col, Dc) :-
    in(P_grid_in, Col), !params.bg(Col),
    decompose(P_grid_in, P_tile, P_grid_out, Dc).

.decl body_choice(b: Body)
body_choice($Spatial()).
body_choice($Palette()).
body_choice($Stack()).

out(O, Bg, [Dc, B]) :-
    dec_choice(Dc), body_choice(B), params.frame(O),   // choice × cell
    params.bg(Bg), !cand(O, _, _, Dc).

// --- $Spatial ---

// The competing pane nearest the stack edge.
.init nearest_pane = ArgExtremes<Cell, Position>
nearest_pane.cand([O, Dc], T, K) :- cand(O, T, _, Dc), params.stack_dir(D), dist(T, D, K).

out(O, Col, [Dc, $Spatial()]) :- nearest_pane.low([O, Dc], T, _), cand(O, T, Col, Dc).

// --- $Palette ---

// The top-priority color competing at the cell.
.init front_ink = ArgExtremes<Cell, Color>
front_ink.cand([O, Dc], Col, R) :- cand(O, _, Col, Dc), params.ink_rank(Col, R).

out(O, Col, [Dc, $Palette()]) :- front_ink.low([O, Dc], Col, _).

// --- $Stack ---

// The top-priority pane competing at the cell.
.init front_pane = ArgExtremes<Cell, Position>
front_pane.cand([O, Dc], T, R) :- cand(O, T, _, Dc), params.pane_rank(T, R).

out(O, Col, [Dc, $Stack()]) :- front_pane.low([O, Dc], T, _), cand(O, T, Col, Dc).

.comp Determine {
    .decl cand(e: Example, o: Position, p_tile: Position, col: Color)
    cand(E, P_grid_out, P_tile, Col) :-
        ex_in(E, P_grid_in, Col), !params.bg(Col),                          // inked input cell
        params.divide_axis(A), params.divisor(N), params.divide_gap(G),     // params
        divide_slab(P_grid_in, A, N, G, P_tile, P_grid_out).

    // Every pane pair overlaps somewhere, so direct wins order the panes.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        cand(E, O, T, Col), cand(E, O, T2, Col2), Col != Col2,
        ex_out(E, O, Col).

    .init order = Order<Unit, Position>
    order.elem($U(), T) :- cand(_, _, T, _).
    order.before($U(), T, T2) :- beats(T, T2).

    .decl pane_rank(p_tile: Position, r: number)
    pane_rank(T, R) :- order.rank($U(), T, R).

    // Each pane keeps one ink, so a pane's rank is its ink's rank.
    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- cand(_, _, T, Col), pane_rank(T, R).
}
