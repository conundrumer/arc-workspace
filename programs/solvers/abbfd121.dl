// abbfd121
// @draft
// @keywords: wallpaper occlude repair crop rank color-class objects symmetry
// @scene wallpaper: a pattern that repeats along both axes covers the whole
//  grid; its period differs between inputs
// @scene occluders: two or more solid axis-aligned rectangles cover parts of
//  the wallpaper, each in its own color that the wallpaper does not use; they
//  do not touch or overlap; an occluder is a color whose cells fill their
//  bounding box
// @scene unique-largest: exactly one occluder has the largest area
// @rule select: the selected occluder is the one with the largest area
// @rule frame: the output has the height and width of the selected occluder
// @rule recover: each output cell is the wallpaper as drawn at the matching
//  input cell under the selected occluder, before the occluders were placed
//     @approximated: each output cell takes the color of the visible cells of
//      its phase under the per-axis shortest periods that no two visible cells
//      contradict; undefined where the phase has no visible cell
//     @witness asym-hidden: borderline other

// how the occluders are found
.type Occluder =
    // @claim occluders
    ColorFill {}
    // @scene occluders: an occluder is a color whose cells fill their
    //  bounding box and number at least two
    // @witness lone-cell: variant concept
    // @witness single-copy: borderline $MinTwoCells
  | MinTwoCells {}
    // @scene occluders: an occluder is a 4-connected one-color component
    //  that fills its bounding box, with both sides at least
    //  params.min_side
    // @witness shared-color: variant $ComponentRect
    //     @relaxed occluders
    // @witness wallpaper-block: variant concept
    // @witness lone-cell: variant concept
  | ComponentRect {}

// which maps carry colors to hidden cells beside the axis periods
.type Recovery =
    // @claim recover
    AxisPeriods {}
    // @rule recover: a hidden cell also takes the colors that translations
    //  carry to it; a translation counts when it carries some visible cell
    //  onto a visible cell of its color, and no visible cell onto a visible
    //  cell of another color; undefined where a cell takes two colors
    // @witness oblique-hidden: borderline $ObliquePeriod
    // @witness oblique-wide: borderline $ObliquePeriod
    // @witness oblique-no-axis: borderline $ObliquePeriod
    //     @relaxed wallpaper
  | ObliquePeriod {}
    // @rule recover: where both axes have a period, a hidden cell also
    //  takes the colors that maps and axis periods carry to it, where a map
    //  applies a D4 isometry and then a translation; a map counts when it
    //  carries some cell's axis-period color onto another cell of that color
    //  and no cell's axis-period color onto a cell with another color;
    //  undefined where a cell takes two colors
    // @witness mirror-hidden: borderline $IsometryOrbit
    // @witness mirror-wide: borderline $IsometryOrbit
    // @witness oblique-hidden: borderline $ObliquePeriod
    // @witness oblique-wide: borderline $ObliquePeriod
  | IsometryOrbit {}

// what a hidden cell gets when no visible cell reaches it
.type HiddenOrbit =
    // @claim recover
    NoSource {}
    // @rule fill: a hidden cell that no visible cell reaches takes
    //  params.fill
    // @witness oblique-fill: borderline $ObliquePeriod
    //     @reassigned fill
    // @witness asym-fill: borderline other
    //     @reassigned fill
  | HiddenFill {}

// which occluder gives the output
.type Selection =
    // @claim select
    Area {}
    // @rule select: the selected occluder has the largest height plus width
    // @witness tall-thin: ordinary concept
    // @witness wide-thin: ordinary concept
  | Perimeter {}
    // @rule select: the selected occluder has the longest side, then the
    //  longest short side
    // @witness tall-thin: ordinary concept
    // @witness wide-thin: ordinary concept
    // @witness tall-beside-square: ordinary concept
    // @witness wide-beside-square: ordinary concept
  | LongestThenShortest {}

.type Choice = [occluder: Occluder, recovery: Recovery, orbit: HiddenOrbit,
                selection: Selection]

// A row or a column, by its axis.
.type Line = [a: Axis, l: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $ComponentRect ---
    // The least side of an occluder.
    .decl min_side(k: number) min_side(2).

    // --- $HiddenFill ---
    // The pairs hold no hidden cell without a source, so every color stays
    // open.
    // @derive DominantColor: borderline $ObliquePeriod
    // @derive RarestColor: borderline $ObliquePeriod
    // @ignore: derive SharedColor — fails Subsumption: on one input it gives every color of that input, so it is undefined wherever a cell takes the fill, and elsewhere it gives the output of the stored fill
    // @ignore: derive VanishedColor — fails Subsumption: on one input it gives every color of that input, so it is undefined wherever a cell takes the fill, and elsewhere it gives the output of the stored fill
    .decl fill(col: Color)
    fill(0). fill(1). fill(2). fill(3). fill(4). fill(5). fill(6). fill(7). fill(8). fill(9).
}

.init params = Params

.decl occluder_choice(o: Occluder)
occluder_choice($ColorFill()). occluder_choice($MinTwoCells()). occluder_choice($ComponentRect()).

.decl recovery_choice(r: Recovery)
recovery_choice($AxisPeriods()). recovery_choice($ObliquePeriod()). recovery_choice($IsometryOrbit()).

.decl hidden_orbit_choice(f: HiddenOrbit)
hidden_orbit_choice($NoSource()). hidden_orbit_choice($HiddenFill()).

.decl selection_choice(s: Selection)
selection_choice($Area()). selection_choice($Perimeter()). selection_choice($LongestThenShortest()).

// Beside the concept case, every case fills sourceless cells: a case without
// the fill gives the output of the case with it wherever it gives one.
.decl impl_choice(ch: Choice)
impl_choice([$ColorFill(), $AxisPeriods(), $NoSource(), $Area()]).
impl_choice([O, R, $HiddenFill(), Sel]) :-
    occluder_choice(O), recovery_choice(R), selection_choice(Sel).

// The occluders, each recovery's colors, and each selection's top occluders.
.comp Parse<Key> {
    .type Hue = [ky: Key, col: Color]
    .type Block = [ky: Key, b: Box]
    // A selection's order over the key's occluders.
    .type Rank = [ky: Key, sel: Selection]

    .decl cell(ky: Key, p: Position, col: Color)

    // The occluders, by their boxes.
    .decl occluder(ky: Key, b: Box)

    // Each color's bounding box.
    // @claim occluders
    .init color_box = Bbox<Hue>
    color_box.cell([Ky, Col], P) :- cell(Ky, P, Col).

    // A cell of another color lies inside the color's box.
    .decl color_gap(ky: Key, col: Color)
    color_gap(Ky, Col) :- color_box.box([Ky, Col], B), cell(Ky, P, C), inside(P, B), C != Col.

    // A color whose cells fill their bounding box.
    .decl color_fill(ky: Key, col: Color, b: Box)
    color_fill(Ky, Col, B) :- color_box.box([Ky, Col], B), !color_gap(Ky, Col).

    .decl block_cell(ky: Key, b: Box, p: Position)
    block_cell(Ky, B, P) :- occluder(Ky, B), cell(Ky, P, _), inside(P, B).

    .decl hidden(ky: Key, p: Position)
    hidden(Ky, P) :- block_cell(Ky, _, P).

    .decl visible(ky: Key, p: Position, col: Color)
    visible(Ky, P, Col) :- cell(Ky, P, Col), !hidden(Ky, P).

    // --- recovery ---

    // The per-axis shortest periods of the visible cells.
    // @claim wallpaper recover
    .init period = OffsetInvariance<Key, Color>
    period.cell(Ky, P, Col) :- visible(Ky, P, Col).

    // The phase of p from edge d: its distance from d within the period of
    // d's axis, or its whole distance where that axis has no period.
    .decl phase(ky: Key, p: Position, d: Dir, k: number)
    phase(Ky, P, D, K) :-
        cell(Ky, P, _), dir_elem(D), dist(P, D, T), axis_of(D, A),
        ( period.min_period(Ky, A, N), stride(T, N, 0, _, K)
        ; !period.min_period(Ky, A, _), K = T
        ).

    // The colors the axis periods give a cell: its own where visible, and
    // those of the visible cells of its phase where hidden.
    .decl axis_color(ky: Key, p: Position, col: Color)
    axis_color(Ky, P, Col) :- visible(Ky, P, Col).
    axis_color(Ky, Q, Col) :-
        hidden(Ky, Q), diag_dirs(_, _, D1, D2),                     // an edge on each axis
        phase(Ky, Q, D1, K1), phase(Ky, Q, D2, K2),
        phase(Ky, P, D1, K1), phase(Ky, P, D2, K2), visible(Ky, P, Col).

    // Some axis has no period, so no map is read.
    .decl aperiodic(ky: Key)
    aperiodic(Ky) :- visible(Ky, _, _), axis_elem(A), !period.min_period(Ky, A, _).

    // The translations that carry some visible cell onto another visible
    // cell of its color.
    .decl carried(ky: Key, x: Offset)
    carried(Ky, X) :- visible(Ky, P, Col), visible(Ky, Q, Col), P != Q, relative(P, Q, X).

    // Hidden q is the image of p under a map of recovery r.
    .decl map_link(ky: Key, r: Recovery, p: Position, q: Position)

    // The colors each recovery gives a cell: those of the axis periods, and
    // those its maps carry into hidden cells.
    .decl color(ky: Key, r: Recovery, p: Position, col: Color)
    color(Ky, R, P, Col) :- recovery_choice(R), axis_color(Ky, P, Col).
    color(Ky, R, Q, Col) :- map_link(Ky, R, P, Q), axis_color(Ky, P, Col).

    // --- selection ---

    // B ranks above A under selection sel.
    .decl above(ky: Key, sel: Selection, a: Box, b: Box)

    .decl beaten(k: Rank, a: Box)
    beaten([Ky, Sel], A) :- above(Ky, Sel, A, B).

    // The occluders nothing ranks above.
    .decl top(k: Rank, b: Box)
    top([Ky, Sel], B) :- occluder(Ky, B), selection_choice(Sel), !beaten([Ky, Sel], B).

    // The selected occluder: the one occluder nothing ranks above.
    // @claim unique-largest
    .init sole = Unanimous<Rank, Box>
    sole.item(K, B) :- top(K, B).

    // --- $Area ---
    // @claim select
    .init area = Tally<Block, Position>
    area.item([Ky, B], P) :- block_cell(Ky, B, P).

    above(Ky, $Area(), A, B) :- area.tally([Ky, A], N1), area.tally([Ky, B], N2), N1 < N2.

    // --- $Perimeter ---
    // The rows and columns a box spans.
    // @claim select
    .init span = Tally<Block, Line>
    span.item([Ky, B], [A, L]) :- block_cell(Ky, B, P), axis_elem(A), split(P, A, L, _).

    above(Ky, $Perimeter(), A, B) :- span.tally([Ky, A], N1), span.tally([Ky, B], N2), N1 < N2.

    // --- $LongestThenShortest ---
    // @claim select
    .init sides = Extremes<Block>
    sides.cand([Ky, B], N) :- block_cell(Ky, B, P), box_extent(B, P, _, N).

    above(Ky, $LongestThenShortest(), A, B) :-
        sides.high([Ky, A], N1), sides.high([Ky, B], N2),
        sides.low([Ky, A], M1), sides.low([Ky, B], M2),
        ( N1 < N2 ; N1 = N2, M1 < M2 ).
}

.init parse = Parse<Occluder>
parse.cell(S, P, Col) :- occluder_choice(S), in(P, Col).

// The colors each hidden-orbit reading gives a cell.
.decl shade(s: Occluder, r: Recovery, f: HiddenOrbit, p: Position, col: Color)
shade(S, R, F, P, Col) :- hidden_orbit_choice(F), parse.color(S, R, P, Col).

// A cell of the selected occluder's box is uncolored.
.decl broken(ch: Choice)
broken([O, R, F, Sel]) :-
    impl_choice([O, R, F, Sel]), parse.sole.value([O, Sel], B),
    parse.block_cell(O, B, P), !shade(O, R, F, P, _).

out(P_inner, Col, [O, R, F, Sel]) :-
    impl_choice([O, R, F, Sel]), parse.sole.value([O, Sel], B), !broken([O, R, F, Sel]),
    shade(O, R, F, P, Col), crop(P, B, P_inner).

// --- $ColorFill ---
parse.occluder(S, B) :- S = $ColorFill(), parse.color_fill(S, _, B).

// --- $MinTwoCells ---
parse.occluder(S, B) :-
    S = $MinTwoCells(), parse.color_fill(S, Col, B), in(P, Col), in(Q, Col), P != Q.

// --- $ComponentRect ---
// @claim occluders
.init part = Components<Color>
part.node(Col, P) :- in(P, Col).

// @claim occluders
.init part_box = Bbox<Ident>
part_box.cell(Id, P) :- part.label(_, P, Id).

// A cell outside the component lies inside its box.
.decl part_gap(id: Ident)
part_gap(Id) :- part_box.box(Id, B), in(P, _), inside(P, B), !part.label(_, P, Id).

// A side of the component's box is shorter than k.
.decl narrow(id: Ident, k: number)
narrow(Id, K) :-
    part_box.box(Id, B), part.label(_, P, Id), params.min_side(K),
    box_extent(B, P, A, N), N < K.

parse.occluder($ComponentRect(), B) :-
    part_box.box(Id, B), !part_gap(Id), params.min_side(K), !narrow(Id, K).

// --- $ObliquePeriod ---
// The translation carries a visible cell onto a visible cell of another color.
// @ignore: comp-idiom — OffsetInvariance tests the axis-aligned translations alone, and these include oblique ones
.decl clash(s: Occluder, x: Offset)
clash(S, X) :-
    parse.carried(S, X), parse.visible(S, P, C1),
    compose(P, X, Q), parse.visible(S, Q, C2), C1 != C2.

parse.map_link(S, $ObliquePeriod(), P, Q) :-
    parse.carried(S, X), !clash(S, X), parse.cell(S, P, _), compose(P, X, Q), parse.hidden(S, Q).

// --- $IsometryOrbit ---
// The isometries of the axis-period colors, over the whole frame.
// @claim recover
.init wp = Wallpaper<Occluder, Color>
wp.transform(D) :- d4_elem(D).
wp.cell(S, P, Col) :- parse.axis_color(S, P, Col).
wp.grid(S, P) :- parse.cell(S, P, _).
wp.period(S, A, K) :- parse.period.min_period(S, A, K).

parse.map_link(S, $IsometryOrbit(), P, Q) :-
    wp.action(S, P, Q), parse.hidden(S, Q), !parse.aperiodic(S).

// --- $HiddenFill ---
shade(S, R, $HiddenFill(), P, Col) :-
    parse.cell(S, P, _), recovery_choice(R), !parse.color(S, R, P, _), params.fill(Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).
    parse.occluder(E, B) :- parse.color_fill(E, _, B).

    // The colors the examples hold.
    .decl palette(col: Color)
    palette(Col) :- ex_in(_, _, Col).
    palette(Col) :- ex_out(_, _, Col).

    // A cell of the largest block that no visible cell reaches holds another
    // color in the output.
    .decl fill_contradicted(col: Color)
    fill_contradicted(Col) :-
        parse.sole.value([E, $Area()], B), parse.block_cell(E, B, P),
        !parse.axis_color(E, P, _),
        crop(P, B, P_inner), ex_out(E, P_inner, C), palette(Col), Col != C.

    .decl fill(col: Color)
    fill(Col) :- palette(Col), !fill_contradicted(Col).
}
