// 662c240a
// concept: decompose symmetry select
// Input stacks c.tile_count square tiles along c.tile_axis; output the one
// tile that lacks the symmetry the others share.
//
// Cases (data-equivalent on this task):
//   $Shared — the shared symmetry is task data: output the tile not fixed
//             by c.sym.
//   $Asym   — symmetric-vs-asymmetric is the concept: output the tile
//             fixed by no nontrivial D4 element.

#include "../lib.dl"

.type Choice = Shared {} | Asym {}

.comp Consts {
    .decl tile_axis(a: Axis) tile_axis(AXIS_V).
    .decl tile_count(n: number) tile_count(3).

    // --- $Shared ---
    .decl sym(d: D4) sym(D4_DG).
}

.init c = Consts

.decl tile_val(p_tile: Position, p_intile: Position, col: Color)
tile_val(T, P, Col) :-
    in(P_grid, Col),
    c.tile_axis(A), c.tile_count(N),
    divide_slab(P_grid, A, N, 0, T, P).

.init inv = D4Map<Position, Color>
inv.src(T, P, Col) :- tile_val(T, P, Col).
inv.dst(T, P, Col) :- tile_val(T, P, Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- $Shared ---
out(P, Col, $Shared()) :- tile_val(T, P, Col), c.sym(F), inv.broken(T, F).

// --- $Asym ---
out(P, Col, $Asym()) :- tile_val(T, P, Col), !inv.has_sym(T).
