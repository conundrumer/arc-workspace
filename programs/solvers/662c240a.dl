// 662c240a
// @keywords: decompose symmetry select
// input: square tiles stacked along params.tile_axis
// output: The output is the one tile that lacks the symmetry the others
//  share.

// find the tiles
.type DecChoice =
    // by tile count
    Count {}
    // by tile size
  | Size {}

// which tile is the odd one
.type SymChoice =
    // the shared symmetry is task data: output the tile not fixed by params.sym
    Shared {}
    // symmetric-vs-asymmetric is the concept: output the tile fixed by no
    // nontrivial D4 element
  | Asym {}

// two independent choices, data-equivalent on this task
.type Choice    = [d: DecChoice, s: SymChoice]

.type TileKey = [t: Position, d: DecChoice]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl tile_axis(a: Axis) tile_axis(AXIS_V).

    // --- Count ---
    .decl tile_count(n: number) tile_count(3).

    // --- Size ---
    .decl tile_size(k: number) tile_size(3).

    // --- Shared ---
    .decl sym(d: D4) sym(D4_DG).
}

.init params = Params

.decl tile_val(p_tile: Position, p_intile: Position, col: Color, dc: DecChoice)
tile_val(T, P, Col, $Count()) :-
    in(P_grid, Col),
    params.tile_axis(A), params.tile_count(N),          // stack by tile count
    divide_slab(P_grid, A, N, 0, T, P).
tile_val(T, P, Col, $Size()) :-
    in(P_grid, Col),
    params.tile_axis(A), params.tile_size(K),           // stack by tile size
    divide_by_size_slab(P_grid, A, K, 0, T, P).

.init inv = D4Map<TileKey, Color>
inv.src([T, Dc], P, Col) :- tile_val(T, P, Col, Dc).
inv.dst([T, Dc], P, Col) :- tile_val(T, P, Col, Dc).

// --- Shared ---
out(P, Col, [Dc, $Shared()]) :-
    tile_val(T, P, Col, Dc), params.sym(F), inv.mismatch([T, Dc], F).

// --- Asym ---
out(P, Col, [Dc, $Asym()]) :- tile_val(T, P, Col, Dc), !inv.has_sym([T, Dc]).
