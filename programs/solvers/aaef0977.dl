// aaef0977
// @draft
// @keywords: markers rings walk lookup
// @scene field: a field of the background color params.bg.
// @scene seed: exactly one cell is not background; its color is on the cycle.
// @rule diamond-rings: each cell's ring is its Manhattan distance to the seed cell.
// @rule cycle-color: a cell at ring k takes the color k steps after the seed's
//  color along params.cycle_succ.
// @rule total: every cell is painted this way, and the output has the input's size.

// how many seeds the input holds
.type Choice =
    // @claim seed
    OneSeed {}
    // @scene seed: one or more non-background cells, each a seed.
    // @rule diamond-rings: each cell's ring is its Manhattan distance to the
    //  nearest seed, and the ring's colors start from that seed's color;
    //  undefined where two nearest seeds give different colors.
    // @witness two-seeds: variant $NearestSeed
    //     @relaxed seed
  | NearestSeed {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: borderline derived
    //     @relaxed field
    .decl bg(c: Color) bg(7).

    // The colors as a cycle: each color and the next.
    .decl cycle_succ(c: Color, c_next: Color)
    cycle_succ(3, 4).
    cycle_succ(4, 0).
    cycle_succ(0, 5).
    cycle_succ(5, 2).
    cycle_succ(2, 8).
    cycle_succ(8, 9).
    cycle_succ(9, 6).
    cycle_succ(6, 1).
    cycle_succ(1, 3).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // @input

    .decl seed(key: Key, p: Position, col: Color)
    seed(Ky, P, Col) :- cell(Ky, P, Col), !params.bg(Col).

    // The Manhattan distance from each cell to each seed.
    .decl taxicab(key: Key, p: Position, s: Position, k: number)
    taxicab(Ky, P, S, K) :-
        cell(Ky, P, _), seed(Ky, S, _), relative(S, P, V),
        diag_dist(V, Diag, _, K1, K2), K1 >= 0, K2 >= 0,   // the corner facing away from P
        corner_dist(V, Diag, K).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// @claim cycle-color
.init cycle = CycleWalk<Unit, Color>
cycle.succ($U(), C, C2) :- params.cycle_succ(C, C2).
cycle.step($U(), K) :- parse.taxicab($U(), _, _, K).

// The color seed S gives cell P: the seed's color advanced by P's ring.
.decl hue(p: Position, s: Position, col: Color)
hue(P, S, Col) :-
    parse.taxicab($U(), P, S, K), parse.seed($U(), S, C0), cycle.walk($U(), C0, K, Col).

// --- $OneSeed ---
out(P, Col, $OneSeed()) :- hue(P, _, Col).

// --- $NearestSeed ---

// @claim diamond-rings
.init nearest = ArgExtremes<Position, Position>
nearest.cand(P, S, K) :- parse.taxicab($U(), P, S, K).

out(P, Col, $NearestSeed()) :- nearest.low(P, S, _), hue(P, S, Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The field: the input color of a cell the output repaints. The seed
    // keeps its color, at ring 0, so every repainted cell is a field cell.
    .decl bg(c: Color)
    bg(C) :- ex_in(E, P, C), ex_out(E, P, C2), C != C2.

    // The colors of two neighboring cells, the second one ring farther out.
    .decl cycle_succ(c: Color, c_next: Color)
    cycle_succ(C, C2) :-
        parse.taxicab(E, P, S, K), dir_elem(D), neighbor(P, D, Q),
        parse.taxicab(E, Q, S, K2), K2 > K,
        ex_out(E, P, C), ex_out(E, Q, C2).
}
