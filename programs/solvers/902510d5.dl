// 902510d5
// @draft
// @keywords: objects markers count rank
// input: ink on a plain field: one large group of touching cells, a marker
//  cell at a grid corner, and loose cells elsewhere
// output: the large group stays and the loose cells go. A right isosceles
//  triangle fills the marked corner, in the commonest loose color, with legs
//  as long as the count of loose cells.

// What bounds a group of ink.
.type Choice =
    // an 8-connected run of ink, whatever its colors
    Object {}
    // an 8-connected run of ink of one color
  | Piece {}
    // an 8-connected run of the commonest ink color
  | Dominant {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Object()). impl_choice($Piece()). impl_choice($Dominant()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl marker(p: Position, d: DiagDir)
marker(P, D) :- ink(P, _), corner_dist(P, D, 0).

.decl grouped(p: Position, ch: Choice, id: Ident)

// --- Object ---
.init objects = Components8<Unit>
objects.node($U(), P) :- ink(P, _).
grouped(P, $Object(), Id) :- objects.label($U(), P, Id).

// --- Piece, Dominant ---
.init pieces = Components8<Color>
pieces.node(Col, P) :- ink(P, Col).
grouped(P, $Piece(), Id) :- pieces.label(_, P, Id).

.init dominant = Mode<Unit, Color, Position>
dominant.item($U(), Col, P) :- ink(P, Col).
grouped(P, $Dominant(), Id) :- pieces.label(Col, P, Id), dominant.mode($U(), Col).

// --- shared ---

// The shape: the largest group — the id that most cells carry.
.init biggest = Mode<Choice, Ident, Position>
biggest.item(Ch, Id, P) :- grouped(P, Ch, Id).

.decl shape(p: Position, ch: Choice)
shape(P, Ch) :- biggest.mode(Ch, Id), grouped(P, Ch, Id).

.decl loose(p: Position, col: Color, ch: Choice)
loose(P, Col, Ch) :- ink(P, Col), impl_choice(Ch), !shape(P, Ch), !marker(P, _).

.init loose_count = Tally<Choice, Position>
loose_count.item(Ch, P) :- loose(P, _, Ch).

.init fill = Mode<Choice, Color, Position>
fill.item(Ch, Col, P) :- loose(P, Col, Ch).

// The triangle: the cells the marked corner reaches within the loose count.
.decl triangle(p: Position, ch: Choice)
triangle(P, Ch) :-
    in(P, _), marker(_, D), corner_dist(P, D, K),
    loose_count.tally(Ch, N), K < N.

out(P, Col, Ch) :-
    in(P, Col_in), impl_choice(Ch),
    ( shape(P, Ch), Col = Col_in
    ; triangle(P, Ch), fill.mode(Ch, Col)
    ; !shape(P, Ch), !triangle(P, Ch), params.bg(Col)
    ).
