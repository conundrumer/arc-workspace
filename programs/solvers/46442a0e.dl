// 46442a0e
// keywords: tile-arrangement lookup d4
// output: A 2×2 arrangement of input copies: the anchor-corner tile holds
//  the input, and the other tiles hold its quarter-turn images.

// The rotation peer of the 3af2c5a8 family. Flip-based cases are ruled out:
// train 2 and the test both show the off-anchor tiles as rotations of an
// asymmetric input.

// data-equivalent on this task
.type Choice =
    // per-tile D4 table
    Lookup {}
    // rotational closure: each C4 element applied jointly to the anchor tile's
    // position and content
  | Rot {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- Rot ---
    .decl arr_dim(k: number) arr_dim(2).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(K), helpers.frame_pos([K, K], P).

    .decl anchor(d: DiagDir)
    anchor(DIAG_TL).

    // --- Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_2x2(tile_d4,
        D4_ID, D4_CW,
        D4_CC, D4_HT)
}

.init params = Params

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                            // input cell
    params.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).                   // recompose

// --- Rot ---
.decl anchor_tile(p: Position)
anchor_tile(T) :- params.arr_pos(T), params.anchor(Diag), corner_anchor(Diag, T, ZERO).

out(P_grid, Col, $Rot()) :-
    anchor_tile(T), in(P, Col),                          // input fills the anchor tile
    c4_elem(R), apply(R, T, T2), apply(R, P, P2),        // joint quarter-turn image
    concat_2d(T2, P2, 0, P_grid).                        // recompose
