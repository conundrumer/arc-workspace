// dce56571
// @keywords: count
// output: Ink of one color on bg. The output is bg except a line of the ink
//  color whose length is the ink-cell count, centered on both axes, running
//  along params.axis. Where no such line lies at equal distances from both
//  grid edges on each axis, there is no output.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(8).
    .decl axis(a: Axis) axis(AXIS_H).   // the line runs along this axis
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init ink_count = Tally<Unit, Position>
ink_count.item($U(), P) :- ink(P, _).

// Cells of the across-centered line, with the distance to the nearer
// axis edge — the cell's centrality along the line.
.decl center_line(p: Position, k: number)
center_line(P, K) :-
    in(P, _), params.axis(A),
    perp(A, A2), axis_of(D2, A2), dist_pair(P, D2, Kc, Kc),   // centered across
    axis_of(D, A), dist_pair(P, D, K, K2), K <= K2.           // nearer axis edge

// Order over the line's cells by distance to the nearer axis edge. A cell's
// rank_desc counts the cells farther from the edges: the cells more central
// than it.
.init centrality = Order<Unit, Position>
centrality.elem($U(), P) :- center_line(P, _).
centrality.score($U(), P, K) :- center_line(P, K).

// The cells fewer than the ink count of cells are more central than. They
// number other than the ink count where no centered band has that extent.
.decl band_cell(p: Position)
band_cell(P) :- ink_count.tally($U(), N), centrality.rank_desc($U(), P, M), M < N.

.init band_size = Tally<Unit, Position>
band_size.item($U(), P) :- band_cell(P).

// The band is the line where it holds exactly the ink count.
.decl line_cell(p: Position)
line_cell(P) :- band_cell(P), band_size.tally($U(), N), ink_count.tally($U(), N).

out(P, Col) :- line_cell(P), ink(_, Col).
out(P, Col) :- in(P, _), line_cell(_), !line_cell(P), params.bg(Col).
