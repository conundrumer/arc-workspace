// 20981f0e
// concept: decompose move lookup
// A lattice of dots marks the lines that cut the grid into tiles, one piece to
// a tile. Each piece translates within its own tile, keeping its shape and
// color; the dots stand.
//
// $Center — the piece's box lands centered in its tile.
// $Slot   — the piece's box lands at a stored margin within its tile.
// $Clear  — a piece against a wall of its tile steps once off it.

#include "../lib.dl"

.type Choice = Center {} | Slot {} | Clear {}

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(0).

    .decl dot(col: Color) dot(2).

    // --- Slot ---

    // Where a piece's box lands in its tile — margin from each edge.
    .decl slot(p: Position) slot([1, 1, 1, 1]).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Center()). impl_choice($Slot()). impl_choice($Clear()).

// --- lattice ---

.init lattice = DividerFrame<Unit>
lattice.cell($U(), P) :- in(P, _).
lattice.divider($U(), A, L) :-
    in(P, Col), params.dot(Col),      // a dot
    axis_elem(A), split(P, A, L, _).  // marks its line on each axis

// The content of a tile — the piece that moves. A cell on a cutting line sits
// in no tile, so a dot is never a piece.
.decl piece(p_tile: Position, p: Position, col: Color)
piece(P_tile, P, Col) :- lattice.tile_of($U(), P, P_tile), in(P, Col), !params.bg(Col).

// --- placement ---

// The tile seen as its own frame.
.init tile_frame = BoxFrame<Position>
tile_frame.cell(P_tile, P) :- lattice.tile_of($U(), P, P_tile).

// The piece's box, in the frame of its tile.
.init piece_box = Bbox<Position>
piece_box.cell(P_tile, P_intile) :- piece(P_tile, P, _), tile_frame.inner(P_tile, P, P_intile).

// A placement the piece's tile admits, with the margin it lands the box at.
.decl landing(p_tile: Position, delta: Shift, m: Position)
landing(P_tile, Delta, M) :-
    piece(P_tile, P, _), tile_frame.cell(P_tile, Q),
    displacement(P, Q, Delta),                                  // a piece cell onto a cell of its tile
    piece_box.margin(P_tile, M_box), compose(M_box, Delta, M),  // where it lands the box
    geq(M, ORIGIN).                                             // the whole box inside the tile

// The displacement each case picks.
.decl place(p_tile: Position, delta: Shift, ch: Choice)

// --- Center ---

place(P_tile, Delta, $Center()) :- landing(P_tile, Delta, M), centered(M).

// --- Slot ---

place(P_tile, Delta, $Slot()) :- landing(P_tile, Delta, M), params.slot(M).

// --- Clear ---

// The step off the walls on one axis: a box against a wall steps once away
// from it, a box touching neither wall stands.
.decl clear_step(p_tile: Position, a: Axis, delta: Shift)
clear_step(P_tile, A, Delta) :-
    piece_box.margin(P_tile, M_box), axis_of(D, A), opposite(D, D2),
    ( dist(M_box, D, 0), step_delta(D2, Delta)                       // against the wall at d
    ; dist_pair(M_box, D, K, K2), K != 0, K2 != 0, Delta = ORIGIN    // clear of both walls
    ).

place(P_tile, Delta, $Clear()) :-
    clear_step(P_tile, A, Delta1), perp(A, A2), clear_step(P_tile, A2, Delta2),
    compose(Delta1, Delta2, Delta).

// --- output ---

.decl moved(p: Position, col: Color, ch: Choice)
moved(Q, Col, Ch) :- piece(P_tile, P, Col), place(P_tile, Delta, Ch), compose(P, Delta, Q).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- moved(P, Col, Ch).
out(P, Col, Ch) :-
    in(P, Col_in), impl_choice(Ch), !moved(P, _, Ch),
    ( params.dot(Col_in), Col = Col_in     // a dot stands
    ; !params.dot(Col_in), params.bg(Col)  // every other cell empties
    ).
