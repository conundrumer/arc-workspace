// 20981f0e
// @keywords: decompose move lookup
// input: A lattice of dots marks the lines that cut the grid into tiles, one
//  piece to a tile.
// output: Each piece translates within its own tile, keeping its shape and
//  color; the dots stand.

// where within its tile the piece lands
.type Choice =
    // the piece's box lands centered in its tile
    Center {}
    // the piece's box lands at a stored margin within its tile
  | Slot {}
    // a piece against a wall of its tile steps once off it
  | Clear {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl dot(col: Color) dot(2).

    // --- $Slot ---

    // Where a piece's box lands in its tile — margin from each edge.
    .decl slot(b: Box) slot([1, 1, 1, 1]).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Center()). impl_choice($Slot()). impl_choice($Clear()).

// --- lattice ---

.init lattice = DividerTiles<Unit>
lattice.cell($U(), P) :- in(P, _).
lattice.divider($U(), A, L) :-
    in(P, Col), params.dot(Col),      // a dot
    axis_elem(A), split(P, A, L, _).  // marks its line on each axis

// The content of a tile — the piece that moves. A cell on a cutting line sits
// in no tile, so a dot is never a piece.
.decl piece(p_tile: Position, p: Position, col: Color)
piece(P_tile, P, Col) :- lattice.tile_of($U(), P, P_tile), in(P, Col), !params.bg(Col).

// --- placement ---

// The box of each tile.
.init tile_box = Bbox<Position>
tile_box.cell(P_tile, P) :- lattice.tile_of($U(), P, P_tile).

// The piece's box, in the frame of its tile.
.init piece_box = Bbox<Position>
piece_box.cell(P_tile, P_intile) :-
    piece(P_tile, P, _), tile_box.box(P_tile, B), crop(P, B, P_intile).

// A placement the piece's tile admits, with the box it lands the piece in.
.decl landing(p_tile: Position, delta: Offset, b: Box)
landing(P_tile, Delta, B) :-
    piece(P_tile, P, _), tile_box.cell(P_tile, Q),
    relative(P, Q, Delta),                             // a piece cell onto a cell of its tile
    piece_box.box(P_tile, B0), compose(B0, Delta, B),  // where it lands the box
    inside(B, ZERO).                                   // the whole box inside the tile

// The offset each case picks.
.decl place(p_tile: Position, delta: Offset, ch: Choice)

// --- $Center ---

place(P_tile, Delta, $Center()) :- landing(P_tile, Delta, B), centered(B).

// --- $Slot ---

place(P_tile, Delta, $Slot()) :- landing(P_tile, Delta, B), params.slot(B).

// --- $Clear ---

// The step off the walls on one axis: a box against a wall steps once away
// from it, a box touching neither wall stands.
.decl clear_step(p_tile: Position, a: Axis, delta: Offset)
clear_step(P_tile, A, Delta) :-
    piece_box.box(P_tile, B), axis_of(D, A), opposite(D, D2),
    ( dist(B, D, 0), step_offset(D2, Delta)                      // against the wall at d
    ; dist_pair(B, D, K, K2), K != 0, K2 != 0, Delta = ZERO      // clear of both walls
    ).

place(P_tile, Delta, $Clear()) :-
    clear_step(P_tile, A, Delta1), perp(A, A2), clear_step(P_tile, A2, Delta2),
    compose(Delta1, Delta2, Delta).

// --- output ---

.decl moved(p: Position, col: Color, ch: Choice)
moved(Q, Col, Ch) :- piece(P_tile, P, Col), place(P_tile, Delta, Ch), compose(P, Delta, Q).

out(P, Col, Ch) :- moved(P, Col, Ch).
out(P, Col, Ch) :-
    in(P, Col_in), impl_choice(Ch), !moved(P, _, Ch),
    ( params.dot(Col_in), Col = Col_in     // a dot stands
    ; !params.dot(Col_in), params.bg(Col)  // every other cell empties
    ).
