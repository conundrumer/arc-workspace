// 4ff4c9da
// draft
// concept: objects stamp
// Mark-colored cells cover whole blobs of one other color, so no mark cell
// touches that covered color. Every blob of that covered color whose
// footprint equals a mark blob's footprint takes the mark color.

#include "../lib.dl"

.comp Params {
    .decl mark(col: Color) mark(8).
}

.init params = Params

// --- blobs ---

.decl touched(col: Color)
touched(Col) :-
    in(P, Col_mark), params.mark(Col_mark),       // a mark cell
    dir8_elem(D), neighbor(P, D, Q), in(Q, Col).  // a neighbor's color

.decl covered(col: Color)
covered(Col) :- in(_, Col), !params.mark(Col), !touched(Col).

.init blobs = Components8<Color>
blobs.node(Col, P) :- in(P, Col), ( params.mark(Col) ; covered(Col) ).

.init box = BoxFrame<Ident>
box.cell(Id, P) :- blobs.label(_, P, Id).

// --- footprints ---

.init footprint = KeyedSetCompare<Ident, Ident, Position>
footprint.pattern_member(Id, P_inner) :-
    blobs.label(Col, P, Id), params.mark(Col), box.inner(Id, P, P_inner).
footprint.observed_member(Id, P_inner) :-
    blobs.label(Col, P, Id), covered(Col), box.inner(Id, P, P_inner).

// The cells of a covered blob shaped like a mark blob.
.decl copy_cell(p: Position)
copy_cell(P) :- footprint.equals(Id, _), blobs.label(_, P, Id).

.decl out(p: Position, col: Color)
out(P, Col) :- copy_cell(P), params.mark(Col).
out(P, Col) :- in(P, Col), !copy_cell(P).
