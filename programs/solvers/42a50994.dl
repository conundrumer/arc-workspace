// 42a50994
// @keywords: objects select enclose noise
// output: Noise dots; a dot with a companion among its eight surrounding cells
//  stays; a lone dot becomes bg.

// each pair's dots share one color, which hides what counts as a companion
.type Choice =
    // any non-bg cell
    Ink {}
    // a cell of the dot's own color
  | Self {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color)
    bg(0).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl grouped(p: Position, ch: Choice)

// --- $Ink ---
grouped(P, $Ink()) :- ink(P, _), dir8_elem(D), neighbor(P, D, P2), ink(P2, _).

// --- $Self ---
grouped(P, $Self()) :- ink(P, Col), dir8_elem(D), neighbor(P, D, P2), ink(P2, Col).

.decl impl_choice(ch: Choice)
impl_choice($Ink()). impl_choice($Self()).

out(P, Col, Ch) :- grouped(P, Ch), in(P, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !grouped(P, Ch), params.bg(Col).
