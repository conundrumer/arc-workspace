// 2c0b0aff
// @draft
// @keywords: objects crop select rank
// input: rectangular panels on params.bg, each stippled with params.mark in
//  single cells, pairs, and crosses
// output: The output is the panel holding the most crosses.

// what identifies a cross
.type Choice =
    // structure: a mark whose four cardinal neighbors are marks
    Plus {}
    // data: an occurrence of the params.shape footprint
  | Shape {}
    // data: a mark object of params.piece_size cells
  | Size {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(3).

    // --- Shape ---
    .decl shape(p: Position)
    GRID_MASK_3x3(shape,
        _, 1, _,
        1, 1, 1,
        _, 1, _)

    // --- Size ---
    .decl piece_size(n: number) piece_size(5).
}

.init params = Params

.decl mark_cell(p: Position)
mark_cell(P) :- in(P, Col), params.mark(Col).

// --- panels ---

.init panels = Components<Unit>
panels.node($U(), P) :- in(P, Col), !params.bg(Col).

.decl panel(id: Ident, p: Position)
panel(Id, P) :- panels.label($U(), P, Id).

// --- crosses ---

// One row per cross of a panel. inst is the Position that tells instances
// apart: the center cell under $Plus, the footprint's placement under $Shape.
.decl cross(id: Ident, inst: Position, ch: Choice)

.type PC = [id: Ident, ch: Choice]

.init cross_count = Tally<PC, Position>
cross_count.item([Id, Ch], Inst) :- cross(Id, Inst, Ch).

// The panel holding the most crosses, scored per case.
.init most = ArgExtremes<Choice, Ident>
most.cand(Ch, Id, N) :- cross_count.tally([Id, Ch], N).

// --- Plus ---

.init mark_rim = Rim<Unit>
mark_rim.cell($U(), P) :- mark_cell(P).

cross(Id, P, $Plus()) :- mark_cell(P), !mark_rim.rim($U(), P), panel(Id, P).

// --- Shape ---

.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U()) :- mark_cell(P).
occ.shape($U(), S, $U()) :- params.shape(S).

cross(Id, M, $Shape()) :-
    occ.occurrence($U(), M),               // a footprint occurrence
    params.shape(S), compose(M, S, P),     // a cell it covers
    panel(Id, P).                          // the panel holding it

// --- Size ---

.init marks = Components<Unit>
marks.node($U(), P) :- mark_cell(P).

.init mark_size = Tally<Ident, Position>
mark_size.item(Obj, P) :- marks.label($U(), P, Obj).

// An instance here is a mark object, not a position, so the count runs over
// objects and joins the shared pipeline at the score.
.init piece_count = Tally<Ident, Ident>
piece_count.item(Id, Obj) :-
    mark_size.tally(Obj, N), params.piece_size(N),     // an object of the stored size
    marks.label($U(), P, Obj), panel(Id, P).           // the panel holding it

most.cand($Size(), Id, N) :- piece_count.tally(Id, N).

// --- output ---

.init view = Bbox<Choice>
view.cell(Ch, P) :- most.high(Ch, Id, _), panel(Id, P).

out(P_inner, Col, Ch) :- view.cell(Ch, P), view.box(Ch, B), crop(P, B, P_inner), in(P, Col).

.comp Determine {
    .init objs = Components<Example>
    objs.node(E, P) :- ex_in(E, P, Col), params.mark(Col).

    .type EI = [e: Example, id: Ident]

    // A cross is the biggest thing the marks make.
    .init biggest = Mode<Unit, EI, Position>
    biggest.item($U(), [E, Id], P) :- objs.label(E, P, Id).

    .init bbox = Bbox<EI>
    bbox.cell([E, Id], P) :- biggest.mode($U(), [E, Id]), objs.label(E, P, Id).

    .decl shape(p: Position)
    shape(P_inner) :- bbox.cell(K, P), bbox.box(K, B), crop(P, B, P_inner).
}
