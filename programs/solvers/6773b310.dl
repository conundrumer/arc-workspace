// 6773b310
// @keywords: decompose markers count
// output: Separator lines cut the grid into an arrangement of equal tiles.
//  Output is one cell per tile: params.mark where the tile holds a marker pair,
//  params.bg elsewhere.

// what marks a tile
.type Mark =
    // two distinct marker cells exist in the tile
    Pair {}
    // the marker count equals params.pair_count
  | Count {}

// what fixes the tiling
.type DecChoice =
    // a params.divisor × params.divisor arrangement
    TileCount {}
    // tiles of params.tile_size on both axes
  | Size {}

.type Choice    = [m: Mark, d: DecChoice]

.type TileKey = [d: DecChoice, p_tile: Position]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl marker(c: Color) marker(6).
    .decl mark(c: Color) mark(1).
    .decl bg(c: Color) bg(0).

    .decl divide_gap(g: number) divide_gap(1).

    // --- $TileCount ---
    .decl divisor(n: number) divisor(3).

    // --- $Size ---
    .decl tile_size(k: number) tile_size(3).

    // --- $Count ---
    .decl pair_count(n: number) pair_count(2).
}

.init params = Params

.decl tile_cell(p_tile: Position, p_intile: Position, col: Color, dc: DecChoice)

// --- $TileCount ---
tile_cell(P_tile, P_intile, Col, $TileCount()) :-
    in(P_grid, Col),
    params.divisor(N), params.divide_gap(G),
    divide_2d(P_grid, N, G, P_tile, P_intile).

// --- $Size ---
tile_cell(P_tile, P_intile, Col, $Size()) :-
    in(P_grid, Col),
    params.tile_size(K), params.divide_gap(G),
    divide_by_size_2d(P_grid, K, G, P_tile, P_intile).

.decl tile(p_tile: Position, dc: DecChoice)
tile(P_tile, Dc) :- tile_cell(P_tile, _, _, Dc).

.decl tile_marker(p_tile: Position, p_intile: Position, dc: DecChoice)
tile_marker(P_tile, P_intile, Dc) :- tile_cell(P_tile, P_intile, Col, Dc), params.marker(Col).

// --- $Pair ---
.decl paired(p_tile: Position, dc: DecChoice)
paired(P_tile, Dc) :- tile_marker(P_tile, P1, Dc), tile_marker(P_tile, P2, Dc), P1 != P2.

out(P_tile, Col, [$Pair(), Dc]) :- paired(P_tile, Dc), params.mark(Col).
out(P_tile, Col, [$Pair(), Dc]) :- tile(P_tile, Dc), !paired(P_tile, Dc), params.bg(Col).

// --- $Count ---
// A count→value table is defeated: the test exhibits a zero-marker tile,
// absent from train.
.init markers = Tally<TileKey, Position>
markers.item([Dc, P_tile], P_intile) :- tile_marker(P_tile, P_intile, Dc).
markers.domain([Dc, P_tile]) :- tile(P_tile, Dc).

out(P_tile, Col, [$Count(), Dc]) :-
    markers.tally([Dc, P_tile], N),                 // the tile's marker count
    ( params.pair_count(N), params.mark(Col)        // count hits the pair count — marked
    ; !params.pair_count(N), params.bg(Col)         // off it — bg
    ).
