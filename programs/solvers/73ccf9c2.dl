// 73ccf9c2
// draft
// keywords: objects symmetry select crop
// input: Several objects sit on params.bg.
// output: All but one are fixed by the symmetry params.sym; the output
//  crops the box of the one that is not.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl sym(d: D4) sym(D4_LR).
}

.init params = Params

// --- objects ---

.init objs = Components8<Unit>
objs.node($U(), P) :- in(P, Col), !params.bg(Col).

.decl object(id: Ident, p: Position)
object(Id, P) :- objs.label($U(), P, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- object(Id, P).

// Each object's cells in its own box frame.
.decl figure(id: Ident, p_inner: Position, col: Color)
figure(Id, P_inner, Col) :-
    object(Id, P), bbox.box(Id, B), crop(P, B, P_inner), in(P, Col).

.init inv = D4Map<Ident, Color>
inv.src(Id, P, Col) :- figure(Id, P, Col).
inv.dst(Id, P, Col) :- figure(Id, P, Col).

// --- select and crop ---

out(P_inner, Col) :-
    params.sym(F), inv.mismatch(Id, F),                  // the object sym does not fix
    bbox.box(Id, B), in(P, Col), crop(P, B, P_inner).    // its box, cropped
