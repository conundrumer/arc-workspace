// c663677b
// @draft
// @keywords: wallpaper repair symmetry count rank
// @scene periodic-pattern: apart from the blanked cells, the grid is periodic
//  on each axis: each cell has the color of every cell that lies a whole
//  number of periods away from it on the row axis and on the column axis. The
//  period on an axis is the shortest shift under which the unblanked cells
//  agree, and it is shorter than the grid on that axis.
// @scene blanked-patches: some cells are blanked, each with
//  params.hole_color. The blanked cells form one or more patches.
//  params.hole_color occurs nowhere in the pattern.
// @scene each-class-seen: for each blanked cell, some cell a whole number of
//  periods away from it on each axis is not blanked.
// @rule restore-pattern: the output is the input with each blanked cell given
//  the color that the unblanked cells of its class under the periods hold.

// how a blanked cell is known
.type Damage =
    // @claim blanked-patches
    StoredHole {}
    // @scene blanked-patches: the blanked cells have the one color whose
    //  cells, read as blank, leave the tile of least area under the period
    //  derivation of periodic-pattern; undefined where two colors tie, or where
    //  no color leaves a period on both axes
    // @witness other-hole-color: variant $HoleFromPeriod
    //     @relaxed blanked-patches
  | HoleFromPeriod {}
    // @scene blanked-patches: no cell is known to be blank
    // @scene periodic-pattern: the period on an axis is the shift, among
    //  those shorter than the grid on that axis, under which the cells agree
    //  apart from damage: the shift that states the grid in the fewest things,
    //  a color for each class of cells that share a line on the other axis and
    //  lie a whole number of shifts apart, and each cell that lacks some
    //  commonest color of its class; undefined where two shifts on an axis tie
    // @rule restore-pattern: each cell takes the color that holds more than
    //  half the cells of its class
    // @witness sparse-dots: variant concept
    // @witness blank-majority: variant concept
  | ClassMode {}

// which shifts relate cells
.type Periods =
    // @claim periodic-pattern
    AxisShifts {}
    // @scene periodic-pattern: the shifts that relate cells also include
    //  each shift shorter than the axis periods, in any direction, under
    //  which the unblanked cells agree and at least one pair of unblanked
    //  cells meets
    // @witness oblique-stripes: borderline $ObliquePeriod
    //     @relaxed each-class-seen
  | ObliquePeriod {}

// which further cells join a class
.type Isometry =
    // @claim restore-pattern
    Translations {}
    // @rule restore-pattern: classes also merge under each reflection or
    //  rotation of the tile, with a shift, that some two unblanked cells it
    //  pairs witness and no two contradict
    // @witness mirror-class-blank: borderline $WitnessedMirror
    //     @relaxed each-class-seen
  | WitnessedMirror {}
    // @scene tile-mirror: the grid is symmetric under params.mirror, the
    //  reflection across its main diagonal
    // @rule restore-pattern: classes also merge under params.mirror; undefined
    //  where a merged class holds two colors, where params.mirror does not take
    //  the grid onto itself, or where the periods differ between the axes
    // @witness asymmetric-tile: variant concept
    // @witness contradicted-mirror: borderline $StoredMirror
    //     @relaxed each-class-seen
  | StoredMirror {}

.type Choice = [d: Damage, p: Periods, i: Isometry]

// A cell of one case.
.type CaseCell = [ch: Choice, p: Position]
// A class of one case.
.type Orbit = [ch: Choice, id: Ident]
.type OrbitColor = [o: Orbit, col: Color]
// A color that a case reads as blank.
.type DamageColor = [d: Damage, col: Color]
// A line of axis a, among the lines k apart on that axis.
.type PeriodLine = [a: Axis, k: number, l: Position]
// A class of cells under shift k on axis a: the class id of their lines on
// that axis, and their line l on the other axis.
.type ShiftClass = [a: Axis, k: number, id: Ident, l: Position]
// A shift k on axis a.
.type PeriodShift = [a: Axis, k: number]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $StoredHole ---
    .decl hole_color(c: Color) hole_color(0).

    // --- $StoredMirror ---
    .decl mirror(d: D4) mirror(D4_DG).
}

.init params = Params

.decl damage_choice(d: Damage)
damage_choice($StoredHole()). damage_choice($HoleFromPeriod()). damage_choice($ClassMode()).

.decl periods_choice(p: Periods)
periods_choice($AxisShifts()). periods_choice($ObliquePeriod()).

.decl isometry_choice(i: Isometry)
isometry_choice($Translations()). isometry_choice($WitnessedMirror()). isometry_choice($StoredMirror()).

.decl impl_choice(ch: Choice)
impl_choice([D, Pd, I]) :- damage_choice(D), periods_choice(Pd), isometry_choice(I).

// The cells each case reads as unblanked.
.decl intact(d: Damage, p: Position, col: Color)

// The pattern's period on each axis.
// @store: variant concept
.decl period(d: Damage, a: Axis, k: number)

// An axis with no period.
.decl aperiodic(d: Damage)
aperiodic(D) :- damage_choice(D), axis_elem(A), !period(D, A, _).

// The period classes.
// @claim periodic-pattern
.init periodic = Wallpaper<Damage, Color>
periodic.grid(D, P) :- damage_choice(D), in(P, _).
periodic.period(D, A, K) :- period(D, A, K).

// The classes of each case: the period classes, joined by the case's further
// shifts and isometries.
.init orbit = Canon<CaseCell>
orbit.edge([Ch, P], [Ch, P]) :- impl_choice(Ch), in(P, _).
orbit.edge([Ch, P], [Ch, Q]) :- impl_choice(Ch), Ch = [D, _, _], periodic.action(D, P, Q).

// A case undefined on the input.
.decl broken(ch: Choice)
broken(Ch) :- impl_choice(Ch), Ch = [D, _, _], aperiodic(D).

// --- $StoredHole, $HoleFromPeriod ---

// The color each case reads as blank.
.decl hole(d: Damage, c: Color)

intact(D, P, Col) :- hole(D, C), in(P, Col), Col != C.

// A color that each case may read as blank.
.decl blank_cand(d: Damage, c: Color)

// The shifts under which the cells left unblanked agree, with each color
// read as blank.
// @claim periodic-pattern
// @ignore min_period: store — stored, it gives $StoredHole the periods that
//  period=stored gives, and it gives $HoleFromPeriod one tile for every color,
//  so the hole color ties and that model is undefined on every input
.init shifts = OffsetInvariance<DamageColor, Color>
shifts.cell([D, C], P, Col) :- blank_cand(D, C), in(P, Col), Col != C.

period(D, A, K) :- hole(D, C), shifts.min_period([D, C], A, K).

// An unblanked cell keeps its color, and a blanked cell takes the colors the
// unblanked cells of its class hold.
out(P, Col, Ch) :-
    impl_choice(Ch), Ch = [D, _, _], hole(D, C), !broken(Ch),
    ( intact(D, P, Col)
    ; in(P, C), orbit.id([Ch, P], Id), orbit.id([Ch, Q], Id), intact(D, Q, Col)
    ).

// --- $StoredHole ---

hole($StoredHole(), C) :- params.hole_color(C).
blank_cand($StoredHole(), C) :- params.hole_color(C).

// --- $HoleFromPeriod ---

blank_cand($HoleFromPeriod(), C) :- in(_, C).

// The tile each color leaves when its cells are read as blank.
.init hole_tile = Frame2D<Color>
hole_tile.extent(C, A, K) :- shifts.min_period([$HoleFromPeriod(), C], A, K).

// @claim blanked-patches
.init hole_area = Tally<Color, Position>
hole_area.item(C, P) :- hole_tile.cell(C, P).

// @claim blanked-patches
.init least_hole = ArgExtremes<Unit, Color>
least_hole.cand($U(), C, N) :- hole_area.tally(C, N).

// @claim blanked-patches
.init one_hole = Unanimous<Unit, Color>
one_hole.item($U(), C) :- least_hole.low($U(), C, _).

hole($HoleFromPeriod(), C) :- one_hole.value($U(), C).

// --- $ClassMode ---

intact($ClassMode(), P, Col) :- in(P, Col).

// A line of axis a.
.decl line(a: Axis, l: Position)
line(A, L) :- in(P, _), axis_elem(A), split(P, A, L, _).

// The lines a whole number of k apart on axis a, as one class, for each k
// shorter than the grid on that axis.
.init line_class = Canon<PeriodLine>
line_class.edge([A, K, L], [A, K, L]) :- line(A, L), sub_extent(L, A, K).
line_class.edge([A, K, L], [A, K, L2]) :-
    line(A, L), sub_extent(L, A, K), axis_of(D, A), jump(L, D, K, L2), line(A, L2).

// Each cell in its class under shift k on axis a: the class of its line on
// that axis, and its line on the other axis.
// @claim periodic-pattern
.init shift_mode = Mode<ShiftClass, Color, Position>
shift_mode.item([A, K, Id, L2], Col, P) :-
    in(P, Col), split(P, A, L1, L2), line_class.id([A, K, L1], Id).

// A cell p of class k whose color differs from a commonest color of k.
.decl shift_miss(k: ShiftClass, p: Position)
shift_miss(K, P) :- shift_mode.mode(K, Col), shift_mode.item(K, Col2, P), Col2 != Col.

// The cells of a frame of extent k on axis a, and of the grid's extent on the
// other axis, one for each class under the shift.
.init shift_frame = Frame2D<PeriodShift>
shift_frame.extent([A, K], A2, N) :-
    in(P, _), axis_elem(A), sub_extent(P, A, K),
    ( A2 = A, N = K
    ; perp(A, A2), axis_dim(P, A2, N)
    ).

// The things that state the grid under each shift: a color for each class,
// and each cell that lacks some commonest color of its class. A cell of the
// shift's frame is shorter than the grid on axis a, so no cell of the grid is
// one.
// @claim periodic-pattern
.init shift_things = Tally<PeriodShift, Position>
shift_things.item(S, P_frame) :- shift_frame.cell(S, P_frame).
shift_things.item([A, K], P_grid) :- shift_miss([A, K, _, _], P_grid).

// @claim periodic-pattern
.init least_shift = ArgExtremes<Axis, number>
least_shift.cand(A, K, N) :- shift_things.tally([A, K], N).

// The shift on each axis that states the grid in the fewest things.
// @claim periodic-pattern
.init one_shift = Unanimous<Axis, number>
one_shift.item(A, K) :- least_shift.low(A, K, _).

period($ClassMode(), A, K) :- one_shift.value(A, K).

// @claim restore-pattern
.init orbit_mode = Mode<Orbit, Color, Position>
orbit_mode.item([Ch, Id], Col, P) :-
    Ch = [$ClassMode(), _, _], orbit.id([Ch, P], Id), in(P, Col).

// A cell p of color col2 in orbit o, whose commonest color is col.
.decl orbit_vote(o: Orbit, col: Color, p: Position, col2: Color)
orbit_vote(O, Col, P, Col2) :-
    orbit_mode.mode(O, Col), O = [Ch, Id], orbit.id([Ch, P], Id), in(P, Col2).

// @claim restore-pattern
.init orbit_major = Excess<OrbitColor, Position>
orbit_major.plus([O, Col], P) :- orbit_vote(O, Col, P, Col).
orbit_major.minus([O, Col], P) :- orbit_vote(O, Col, P, Col2), Col2 != Col.

// Each cell takes the color that holds more than half of its class.
out(P, Col, Ch) :-
    Ch = [$ClassMode(), _, _], orbit.id([Ch, P], Id), !broken(Ch),
    orbit_major.excess([[Ch, Id], Col], _).

// --- $ObliquePeriod ---

// A shift's component on axis a, shorter than the period there.
.decl short_step(d: Damage, a: Axis, v: Offset)
short_step(D, A, V) :-
    period(D, A, K), in(P, _), axis_of(Dr, A), dist(P, Dr, K2), K2 < K,
    jump_offset(Dr, K2, V).

// A shift shorter than the periods on both axes.
.decl oblique_cand(d: Damage, v: Offset)
oblique_cand(D, V) :-
    short_step(D, A, V1), perp(A, A2), short_step(D, A2, V2),
    compose(V1, V2, V), V != ZERO.

// The shift takes an unblanked cell of color col onto one of color col2.
.decl oblique_pair(d: Damage, v: Offset, col: Color, col2: Color)
oblique_pair(D, V, Col, Col2) :-
    oblique_cand(D, V), intact(D, P, Col), compose(P, V, Q), intact(D, Q, Col2).

.decl oblique_clash(d: Damage, v: Offset)
oblique_clash(D, V) :- oblique_pair(D, V, Col, Col2), Col != Col2.

// Each shift under which the unblanked cells agree, and some pair meets.
orbit.edge([Ch, P], [Ch, Q]) :-
    impl_choice(Ch), Ch = [D, $ObliquePeriod(), _],
    oblique_pair(D, V, _, _), !oblique_clash(D, V),
    in(P, _), compose(P, V, Q), in(Q, _).

// --- $WitnessedMirror ---

// The period classes joined under the tile's witnessed isometries.
// @claim restore-pattern
.init mirror = Wallpaper<Damage, Color>
mirror.transform(T) :- d4_compose(T, U, V), U != V.    // each transform but the identity
mirror.cell(D, P, Col) :- intact(D, P, Col).
mirror.grid(D, P) :- damage_choice(D), in(P, _).
mirror.period(D, A, K) :- period(D, A, K).

orbit.edge([Ch, P], [Ch, Q]) :-
    impl_choice(Ch), Ch = [D, _, $WitnessedMirror()], mirror.action(D, P, Q).

// --- $StoredMirror ---

orbit.edge([Ch, P], [Ch, Q]) :-
    impl_choice(Ch), Ch = [_, _, $StoredMirror()],
    params.mirror(T), in(P, _), apply(T, P, Q), in(Q, _).

// The mirror takes a cell off the grid, or the periods differ between the
// axes.
broken(Ch) :-
    impl_choice(Ch), Ch = [D, _, $StoredMirror()],
    ( params.mirror(T), in(P, _), apply(T, P, Q), !in(Q, _)
    ; period(D, A, K), perp(A, A2), period(D, A2, K2), K != K2
    ).

.comp Determine {
    // The color whose cells the outputs change.
    .decl hole_color(c: Color)
    hole_color(C) :- ex_in(E, P, C), ex_out(E, P, C2), C != C2.

    // A reflection across a diagonal under which train output e is not
    // symmetric.
    .decl asymmetric(e: Example, d: D4)
    asymmetric(E, T) :-
        diag_flip_of(_, T), ex_out(E, P, C), apply(T, P, Q), !ex_out(E, Q, C).

    // The reflection across a diagonal under which the most train outputs
    // are symmetric.
    .init symmetric = Mode<Unit, D4, Example>
    symmetric.item($U(), T, E) :- ex_out(E, _, _), diag_flip_of(_, T), !asymmetric(E, T).

    .decl mirror(d: D4)
    mirror(T) :- symmetric.mode($U(), T).
}
