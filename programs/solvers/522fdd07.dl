// 522fdd07
// @draft
// @keywords: objects border lookup
// input: solid one-color squares sit apart on params.bg
// output: Each is redrawn concentric with itself and one ring smaller; a
//  square with no ring to spare comes back at params.bloom, the largest
//  size. The sizes therefore run as a cycle.

// Three models redraw a square
.type Choice =
    // the cells strictly inside its bounding box
    Box {}
    // its cells that keep every cardinal neighbor
  | Erode {}
    // a concentric square of the extent params.next_extent gives, which holds
    // the wrap as one more entry
  | Lookup {}

// A target square: the case that asks for it, and the square it comes from.
.type Target = [ch: Choice, id: Ident]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).

    // --- $Box, $Erode ---

    // The extent a square that loses its last ring comes back at.
    .decl bloom(n: number) bloom(9).

    // --- $Lookup ---

    // A square's extent, and the extent it is redrawn at.
    .decl next_extent(n: number, n2: number)
        next_extent(1, 9). next_extent(3, 1). next_extent(5, 3).
        next_extent(7, 5). next_extent(9, 7).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Box()). impl_choice($Erode()). impl_choice($Lookup()).

// --- shared ---

// One square per connected body of a single color.
.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl obj(id: Ident, col: Color)
obj(Id, Col) :- comps.label(Col, _, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- comps.label(_, P, Id).

.decl center(id: Ident, p: Position)
center(Id, P) :- bbox.cell(Id, P), bbox.box(Id, B), crop(P, B, P_inner), centered(P_inner).

// The cells a ring-taking case redraws a square as.
.decl shrunk(ch: Choice, id: Ident, p: Position)

// The extent a case draws a fresh square at.
.decl target_extent(ch: Choice, id: Ident, n: number)

// --- $Box, $Erode ---

// The cases that redraw a square by taking a ring off it.
.decl shrink_choice(ch: Choice)
shrink_choice($Box()). shrink_choice($Erode()).

target_extent(Ch, Id, N) :-
    shrink_choice(Ch), obj(Id, _), !shrunk(Ch, Id, _),  // nothing left of the square
    params.bloom(N).

// --- $Box ---

shrunk($Box(), Id, P) :- bbox.box(Id, B), in(P, _), interior(P, B).

// --- $Erode ---

.init exposed = Rim<Color>
exposed.cell(Col, P) :- comps.node(Col, P).

shrunk($Erode(), Id, P) :- comps.label(Col, P, Id), !exposed.rim(Col, P).

// --- $Lookup ---

target_extent($Lookup(), Id, N2) :-
    bbox.cell(Id, P), bbox.box(Id, B), perp(A, A2),
    box_extent(B, P, A, N), box_extent(B, P, A2, N),  // a square box
    params.next_extent(N, N2).

// --- output ---

.init target = Frame2D<Target>
target.extent([Ch, Id], A, N) :- target_extent(Ch, Id, N), axis_elem(A).

// The target square, seated with its center on the square it comes from.
.decl placed(ch: Choice, id: Ident, p: Position)
placed(Ch, Id, P) :-
    target.cell([Ch, Id], T_c), centered(T_c),      // the target's center
    target.cell([Ch, Id], T), relative(T_c, T, V),  // each of its cells as an offset
    center(Id, C), compose(C, V, P), in(P, _).      // laid off from that center

.decl paint(ch: Choice, p: Position, col: Color)
paint(Ch, P, Col) :- shrunk(Ch, Id, P), obj(Id, Col).
paint(Ch, P, Col) :- placed(Ch, Id, P), obj(Id, Col).

out(P, Col, Ch) :- paint(Ch, P, Col).
out(P, Col, Ch) :- in(P, _), impl_choice(Ch), !paint(Ch, P, _), params.bg(Col).

.comp Determine {
    // A color's square, per example.
    .type Square = [e: Example, col: Color]

    .init in_box = Bbox<Square>
    in_box.cell([E, Col], P) :- ex_in(E, P, Col), !params.bg(Col).

    .init out_box = Bbox<Square>
    out_box.cell([E, Col], P) :- ex_out(E, P, Col), !params.bg(Col).

    .decl next_extent(n: number, n2: number)
    next_extent(N, N2) :-
        in_box.cell(Sq, P), in_box.box(Sq, B), perp(A, A2),
        box_extent(B, P, A, N), box_extent(B, P, A2, N),        // a square
        out_box.cell(Sq, P2), out_box.box(Sq, B2),
        box_extent(B2, P2, A, N2), box_extent(B2, P2, A2, N2).  // the square it comes back as
}
