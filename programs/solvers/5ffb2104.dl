// 5ffb2104
// draft
// concept: objects move
// A 4-connected block of one color is an object. Every object slides toward
// params.grav and comes to rest where it first meets the grid edge or an
// object at rest ahead of it. The cells an object leaves go to background.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).

    .decl grav(d: Dir) grav(DIR_R).
}

.init params = Params

// Rigid bodies settling against one another under one heading: each body
// travels until one of its cells meets the frame edge, a blocked cell, or a
// cell of a body resting ahead of it. A body rests at the least room its
// cells leave it, and that room reads the rest of the body ahead, so the
// minimum sits inside the recursion. A subsumption clause settles it.
.comp Settle<Key, Body> {
    // The cells of each body, per key.
    .decl cell(key: Key, b: Body, p: Position)  // input

    // The heading every body travels, per key.
    .decl dir(key: Key, d: Dir)  // input

    // Cells no body may enter, per key: the static floor.
    .decl blocked(key: Key, p: Position)  // input

    // What one cell of a body leaves it room for.
    .decl room(key: Key, b: Body, delta: Shift)
    room(Ky, B, Delta) :-
        cell(Ky, B, P), dir(Ky, D),
        ( dist(P, D, K), jump_offset(D, K, Delta)                            // travel to the frame edge
        ; axis_of(D, A), same_line(A, P, Q), nearer(D, Q, P),               // a cell ahead in the line
          ( blocked(Ky, Q), Q2 = Q                                          // a static cell, in place
          ; cell(Ky, B2, Q), B != B2,                                       // another body's cell
            rest(Ky, B2, Delta2), compose(Q, Delta2, Q2)                    // where that cell rests
          ),
          opposite(D, D2), neighbor(Q2, D2, P2), displacement(P, P2, Delta) // travel to just behind it
        ).

    // Where a body rests: the least room its cells leave it.
    .decl rest(key: Key, b: Body, delta: Shift)
    rest(Ky, B, Delta) :- room(Ky, B, Delta).
    rest(Ky, B, Delta) <= rest(Ky, B, Delta2) :- dir(Ky, D), nearer(D, Delta, Delta2).
}

.init obj = Components<Color>
obj.node(Col, P) :- in(P, Col), !params.bg(Col).

.init settle = Settle<Unit, Ident>
settle.cell($U(), Id, P) :- obj.label(_, P, Id).
settle.dir($U(), D) :- params.grav(D).

.decl fallen(p: Position, col: Color)
fallen(Q, Col) :-
    obj.label(Col, P, Id), settle.rest($U(), Id, Delta), compose(P, Delta, Q).

.decl out(p: Position, col: Color)
out(P, Col) :- fallen(P, Col).
out(P, Col) :- in(P, _), !fallen(P, _), params.bg(Col).
