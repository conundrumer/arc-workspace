// 5ffb2104
// @draft
// @keywords: objects move
// input: each 4-connected block of one color is an object.
// output: every object slides toward params.grav and comes to rest where it
//  first meets the grid edge or an object at rest ahead of it. The cells an
//  object leaves go to background.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).

    .decl grav(d: Dir) grav(DIR_R).
}

.init params = Params

.init obj = Components<Color>
obj.node(Col, P) :- in(P, Col), !params.bg(Col).

.init settle = Gravity<Unit, Ident>
settle.cell($U(), Id, P) :- obj.label(_, P, Id).
settle.dir($U(), D) :- params.grav(D).

.decl fallen(p: Position, col: Color)
fallen(Q, Col) :-
    obj.label(Col, P, Id), settle.travel($U(), Id, Delta), compose(P, Delta, Q).

out(P, Col) :- fallen(P, Col).
out(P, Col) :- in(P, _), !fallen(P, _), params.bg(Col).
