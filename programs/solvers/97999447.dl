// 97999447
// @keywords: markers lookup walk cast
// output: each non-bg dot emits a ray toward params.ray_dir, to the grid edge;
//  cells off every ray pass through.

// how the ray is colored
.type Choice =
    // the ray walks the dot's two-color cycle: dot color and params.alt_color
    // alternate, the dot itself on-color
    Toggle {}
    // the ray tiles a periodic mask: params.slot is the slot domain,
    // params.mask its fixed-color overrides, unmarked slots echo the dot. The
    // dot sits at slot 0.
  | Mask {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl ray_dir(d: Dir) ray_dir(DIR_R).

    // --- $Toggle ---
    .decl alt_color(c: Color) alt_color(5).

    // --- $Mask ---
    // Coincides with Toggle when the mask holds one override on period 2.
    .decl slot(k: number)
    slot(0). slot(1).
    .decl mask(k: number, col: Color) mask(1, 5).
}

.init params = Params

// --- shared ---

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.init rays = Ray<Unit>
rays.dir($U(), D)  :- params.ray_dir(D).
rays.mark($U(), P) :- mark(P, _).

// A ray cell, with its dot's color and its step count along the ray.
.decl on_ray(p: Position, m: Color, k: number)
on_ray(P, M, K) :- rays.cast($U(), P, _, K, Src), mark(Src, M).

.decl impl_choice(ch: Choice)
impl_choice($Toggle()). impl_choice($Mask()).

out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !on_ray(P, _, _).   // off every ray

// --- $Toggle ---

// Each dot color's two-color cycle, one advance per ray step.
.init colors = CycleWalk<Color, Color>
colors.succ(M, M, Alt) :- mark(_, M), params.alt_color(Alt).
colors.succ(M, A, B)   :- colors.succ(M, B, A).
colors.step(M, K)      :- on_ray(_, M, K).

out(P, Col, $Toggle()) :- on_ray(P, M, K), colors.walk(M, M, K, Col).   // K steps on from the dot color

// --- $Mask ---

.init slots = IndexCycle<Unit>
slots.idx($U(), K) :- params.slot(K).

// A step along the ray advances the slot cycle.
.init slot_walk = CycleWalk<Unit, number>
slot_walk.succ($U(), K, K2) :- slots.succ($U(), K, K2).
slot_walk.step($U(), K)     :- on_ray(_, _, K).

// The slot a ray cell falls in.
.decl ray_slot(p: Position, m: Color, k: number)
ray_slot(P, M, Slot) :- on_ray(P, M, K), slot_walk.walk($U(), 0, K, Slot).

out(P, Col, $Mask()) :- ray_slot(P, _, K), params.mask(K, Col).    // overridden slot
out(P, M,   $Mask()) :- ray_slot(P, M, K), !params.mask(K, _).     // unmarked slot echoes the dot

.comp Determine {
    .type RayPhase = [e: Example, m: Position, w: number, k: number]

    // Dots of the train inputs; the ex_out atom excludes the test input.
    .decl dot(e: Example, p: Position, col: Color)
    dot(E, P, Col) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // The color the pair paints i steps along a dot's ray.
    .decl ray_col(e: Example, m: Position, i: number, col: Color)
    ray_col(E, M, I, Col) :-
        dot(E, M, _), params.ray_dir(D),
        ex_in(E, P, _), dist(P, D, I),      // a step count the grid spans
        jump(M, D, I, Q), ex_out(E, Q, Col).

    // Candidate periods: the step counts the rays reach.
    .decl cand(w: number)
    cand(W) :- ray_col(_, _, W, _), W != 0.

    // The colors one ray carries at each slot of a candidate period.
    .init slot_color = Unanimous<RayPhase, Color>
    slot_color.item([E, M, W, K], Col) :-
        cand(W), ray_col(E, M, I, Col),   // candidate period, a step's color
        stride(I, W, 0, _, K).            // the step reduced into the period

    // A period that folds two differing steps of one ray onto one slot.
    .decl mismatch(w: number)
    mismatch(W) :- slot_color.clash([_, _, W, _]).

    // The shortest period no ray breaks.
    .init unbroken = Extremes<Unit>
    unbroken.cand($U(), W) :- cand(W), !mismatch(W).

    .decl period(n: number)
    period(N) :- unbroken.low($U(), N).

    .decl slot(k: number)
    slot(K) :- ray_col(_, _, K, _), period(N), K < N.

    // A step that does not echo its dot, folded into its slot.
    .decl mask(k: number, col: Color)
    mask(K, Col) :-
        ray_col(E, M, I, Col), dot(E, M, Mc), Col != Mc,
        period(N), stride(I, N, 0, _, K).
}
