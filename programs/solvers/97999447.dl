// 97999447
// concept: markers lookup walk cast
// Each non-bg dot emits a ray toward params.ray_dir, to the grid edge; cells off
// every ray pass through. Two models of the ray's coloring, tagged on out's
// Choice:
//
//   $Toggle — the ray walks the dot's two-color cycle: dot color and
//             params.alt_color alternate, the dot itself on-color.
//   $Mask   — the ray tiles a periodic mask: params.slot is the slot domain,
//             params.mask its fixed-color overrides, unmarked slots echo the
//             dot. The dot sits at slot 0.
//
// Coincide while the mask is a single override on period 2.

#include "../lib.dl"

.type Choice = Toggle {} | Mask {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl ray_dir(d: Dir) ray_dir(DIR_R).

    // --- Toggle ---
    .decl alt_color(c: Color) alt_color(5).

    // --- Mask ---
    .decl slot(k: number)
    slot(0). slot(1).
    .decl mask(k: number, col: Color) mask(1, 5).
}

.init params = Params

// --- shared ---

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- Toggle ---

// The two-color cycle of a ray with mark color M.
.decl toggle(m: Color, c1: Color, c2: Color)
toggle(M, M, Alt) :- mark(_, M), params.alt_color(Alt).
toggle(M, A, B)   :- toggle(M, B, A).

// From each mark, step toward ray_dir advancing the color cycle.
.decl ray_toggle(m: Color, p: Position, col: Color)
ray_toggle(Col, P, Col) :- mark(P, Col).
ray_toggle(M, Q, C2) :-
    ray_toggle(M, P, C1), toggle(M, C1, C2),   // next color in the cycle
    params.ray_dir(D), neighbor(P, D, Q),      // next cell toward the edge
    in(Q, _).                                  // still on the grid

out(P, Col, $Toggle()) :- ray_toggle(_, P, Col).
out(P, Col, $Toggle()) :- in(P, Col), !ray_toggle(_, P, _).

// --- Mask ---

.init slots = IndexCycle<Unit>
slots.idx($U(), K) :- params.slot(K).

// From each mark, step toward ray_dir advancing the mask slot.
.decl ray_mask(m: Color, p: Position, k: number)
ray_mask(Col, P, 0) :- mark(P, Col).
ray_mask(M, Q, K2) :-
    ray_mask(M, P, K), slots.succ($U(), K, K2),   // next slot in the period
    params.ray_dir(D), neighbor(P, D, Q),         // next cell toward the edge
    in(Q, _).                                     // still on the grid

out(P, Col, $Mask()) :- ray_mask(_, P, K), params.mask(K, Col).    // overridden slot
out(P, M,   $Mask()) :- ray_mask(M, P, K), !params.mask(K, _).     // unmarked slot echoes the dot
out(P, Col, $Mask()) :- in(P, Col), !ray_mask(_, P, _).

// --- determination ---

.comp Determine {
    // Dots of the train inputs; the ex_out atom holds the test input out.
    .decl fmark(e: Example, p: Position, col: Color)
    fmark(E, P, Col) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // The color the pair paints i steps along a dot's ray.
    .decl ray_col(e: Example, m: Position, i: number, col: Color)
    ray_col(E, M, I, Col) :-
        fmark(E, M, _), ex_in(E, Q, _),
        displacement(M, Q, Delta),                               // a cell relative to its dot
        params.ray_dir(D), opposite(D, O), dist(Delta, O, I),    // steps toward ray_dir
        I >= 0, jump_delta(D, I, Delta),                         // straight along the ray
        compose(M, Delta, P), ex_out(E, P, Col).                 // the painted cell

    // Two steps of one ray that carry different colors — never one slot.
    .decl differ(i: number, i2: number)
    differ(I, I2) :- ray_col(E, M, I, Col), ray_col(E, M, I2, Col2), Col != Col2.

    // Candidate periods: the step counts the rays reach.
    .decl cand(w: number)
    cand(W) :- ray_col(_, _, W, _), W != 0.

    // A period that folds two differing steps onto one slot.
    .decl mismatch(w: number)
    mismatch(W) :- cand(W), differ(I, I2), stride(I, W, 0, _, K), stride(I2, W, 0, _, K).

    // The shortest period no ray breaks.
    .init unbroken = Extremes<Unit>
    unbroken.cand($U(), W) :- cand(W), !mismatch(W).

    .decl period(n: number)
    period(N) :- unbroken.low($U(), N).

    .decl slot(k: number)
    slot(K) :- ray_col(_, _, K, _), period(N), K < N.

    // A step that does not echo its dot, folded into its slot.
    .decl mask(k: number, col: Color)
    mask(K, Col) :-
        ray_col(E, M, I, Col), fmark(E, M, Mc), Col != Mc,
        period(N), stride(I, N, 0, _, K).
}
