// 99b1bc43
// family: 3428a4f5
// Layout: 2×1 vertically-stacked 4×4 subgrids with 1-row separator.

#include "../lib.dl"

.type DecChoice = Tile {} | Div {}
.type Body      = Lookup {} | Xor {}
.type Choice    = [d: DecChoice, b: Body]

.type CombineMember = [p: Position, col: Color]
.type CombineKey    = [p: Position, dc: DecChoice]

.comp Consts {
    .init helpers = ConstsHelpers

    .decl frame_dim(k: number) frame_dim(4).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    // --- Tile decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 2). arr_dim(AXIS_H, 1).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah), frame_dim(K), gap(G),
        helpers.tile_pos([Av, Ah], [K, K], [G, 0], P_grid, P_tile, P_intile).

    // --- Div decompose data ---
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(AXIS_V).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Lookup body data ---
    .decl combine_member(id: Ident, p_outer: Position, c: Color)
    .decl combine_out(id: Ident, c_out: Color)

    combine_member(0, [0,1,0,0], 0). combine_member(0, [1,0,0,0], 0). combine_out(0, 0).
    combine_member(1, [0,1,0,0], 1). combine_member(1, [1,0,0,0], 0). combine_out(1, 3).
    combine_member(2, [0,1,0,0], 0). combine_member(2, [1,0,0,0], 2). combine_out(2, 3).
    combine_member(3, [0,1,0,0], 1). combine_member(3, [1,0,0,0], 2). combine_out(3, 0).

    // --- Xor body data ---
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(3).
    .decl fill_at(n: number) fill_at(1).
}

.init c = Consts

.init combine_match = KeyedSetCompare<CombineKey, Ident, CombineMember>
combine_match.pattern_member(Id, [P_outer, C]) :- c.combine_member(Id, P_outer, C).
combine_match.observed_member([P_grid_out, Dc], [P_tile, C]) :-
    decompose(P_grid_in, P_tile, P_grid_out, Dc), in(P_grid_in, C).

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- Xor body: filled_count parameterized by decompose choice ---

.init filled = Tally<CombineKey, Position>
filled.item([P_grid_out, Dc], P_grid_in) :-
    in(P_grid_in, Col), !c.bg(Col), decompose(P_grid_in, _, P_grid_out, Dc).
filled.domain([P_grid_out, Dc]) :- c.frame(P_grid_out), dec_choice(Dc).

.decl filled_count(o: Position, dc: DecChoice, n: number)
filled_count(P_grid_out, Dc, N) :- filled.tally([P_grid_out, Dc], N).

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col_out, [Dc, $Lookup()]) :-
    c.combine_out(Id, Col_out),                                  // entry's output color
    combine_match.equals([P_grid_out, Dc], Id).                  // cell's tiles == entry's members

out(P_grid_out, Col, [Dc, $Xor()]) :-
    dec_choice(Dc), c.frame(P_grid_out),      // choice × cell
    filled_count(P_grid_out, Dc, N),          // the cell's fill count
    ( c.fill_at(N), c.out_fill(Col)           // count hits the fill threshold
    ; !c.fill_at(N), c.bg(Col)                // count off the threshold
    ).
