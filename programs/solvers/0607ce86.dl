// 0607ce86
// @keywords: objects repair select
// output: The grid holds an arrangement of identical solid rectangles under
//  noise: single cells painted over the bg, and cells inside the rectangles
//  repainted. The output stamps one undamaged copy at every rectangle and
//  clears the rest of the grid.

// The cases differ in how the undamaged copy is recovered
.type Choice =
    // each cell of the copy frame takes the color most copies carry
    Vote {}
    // the copy the others confirm most is undamaged; it stamps whole
  | Copy {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).
    .decl block_dim(k: number) block_dim(3).

    .decl block_shape(p: Position)
    block_shape(P) :- block_dim(N), helpers.frame_pos([N, N], P).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Vote()). impl_choice($Copy()).

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

// A copy is what a solid params.block_dim block covers; noise sits too thin to
// carry one.
.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- ink(P).
occ.shape($U(), P, $U()) :- params.block_shape(P).

.decl solid(p: Position)
solid(P) :- occ.occurrence($U(), M), params.block_shape(S), compose(M, S, P).

.init comps = Components<Unit>
comps.node($U(), P) :- solid(P).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- comps.label($U(), P, Id).

// Each copy's cells, in the shared copy frame.
.decl copy_view(id: Ident, p: Position, p_intile: Position)
copy_view(Id, P, P_intile) :- bbox.cell(Id, P), bbox.box(Id, B), crop(P, B, P_intile).

// Each copy's color at each cell of that frame.
.decl copy_color(id: Ident, p_intile: Position, col: Color)
copy_color(Id, P_intile, Col) :- copy_view(Id, P, P_intile), in(P, Col).

out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !solid(P), params.bg(Col).

// --- Vote ---

.init template = Mode<Position, Color, Ident>
template.item(P_intile, Col, Id) :- copy_color(Id, P_intile, Col).

out(P, Col, $Vote()) :- copy_view(_, P, P_intile), template.mode(P_intile, Col).

// --- Copy ---

.type Agreement = [id2: Ident, p_intile: Position]

.init intact = Mode<Unit, Ident, Agreement>
intact.item($U(), Id, [Id2, P_intile]) :-
    copy_color(Id, P_intile, Col),
    copy_color(Id2, P_intile, Col),
    Id != Id2.

out(P, Col, $Copy()) :-
    copy_view(_, P, P_intile),                              // any copy's cell
    intact.mode($U(), Id), copy_color(Id, P_intile, Col).   // the intact copy's color there
