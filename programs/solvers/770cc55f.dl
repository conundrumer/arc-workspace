// 770cc55f
// draft
// keywords: lines markers cast rank
// input: A params.sep line crosses the grid, and a bar of ink sits on each
//  edge of params.axis.
// output: The longer bar's cells that face a cell of the other bar cast
//  params.fill through bg toward the separator, which stops the cast.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl sep(c: Color) sep(2).
    .decl fill(c: Color) fill(4).
    .decl axis(a: Axis) axis(AXIS_V).   // the bars face each other along it
}

.init params = Params

// Ink cell on the bar edge D.
.decl bar(d: Dir, p: Position)
bar(D, P) :-
    in(P, Col), !params.bg(Col),                     // ink cell
    params.axis(A), axis_of(D, A), dist(P, D, 0).    // on an edge of the axis

.init bar_size = Tally<Dir, Position>
bar_size.item(D, P) :- bar(D, P).

.init longer = ArgExtremes<Unit, Dir>
longer.cand($U(), D, N) :- bar_size.tally(D, N).

.init flow = Ray<Unit>
flow.dir($U(), O) :- longer.high($U(), D, _), opposite(D, O).
flow.cell($U(), P) :- in(P, Col), params.bg(Col).
flow.mark($U(), P) :-
    longer.high($U(), D, _), bar(D, P),              // longer bar's cell
    opposite(D, D2), bar(D2, Q),                     // other bar's cell
    params.axis(A), same_line(A, P, Q).              // on one line along the axis
flow.blocked($U(), P) :- in(P, Col), params.sep(Col).

.decl filled(p: Position)
filled(P) :- flow.clear($U(), P, _, _, _).

out(P, Col) :- filled(P), params.fill(Col).
out(P, Col) :- in(P, Col), !filled(P).
