// 72207abc
// @keywords: markers walk
// input: a row of seed marks
// output: From the first seed, the sequence walks toward the grow edge with
//  gaps growing by one per step, cycling the seed colors in order, until it
//  leaves the grid.

// A mark and the jump it arrived by.
.type Mark = [p: Position, delta: Offset]

.decl out(p: Position, col: Color)

.comp Params {
    .decl grow(d: Dir) grow(DIR_R).
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// The seeds run in order of nearness to the grow edge.
.init order = Order<Unit, Position>
order.elem($U(), P) :- ink(P, _).
order.before($U(), P1, P2) :-
    ink(P1, _), ink(P2, _), params.grow(D), nearer(D, P2, P1).

// Cyclic next seed: the one just beyond; the first again after the last.
.decl seed_next(p1: Position, p2: Position)
seed_next(P1, P2) :- order.next($U(), P1, P2).
seed_next(P1, P2) :- order.last($U(), P1), order.first($U(), P2).

// The jumps a walk can take: none, or some cells toward the grow edge.
.decl jump_size(delta: Offset)
jump_size(V) :- in(P, _), params.grow(D), dist(P, D, K), jump_offset(D, K, V).

// The first seed arrives with no jump; each step lengthens the jump by one
// cell, and the walk stops where it leaves the grid.
.init grown = GraphDistance<Unit, Mark>
grown.seed($U(), [P, ZERO]) :- order.first($U(), P).
grown.edge($U(), [P1, V1], [P2, V2]) :-
    in(P1, _), jump_size(V1),
    params.grow(D), neighbor(V1, D, V2),    // jump grows one cell
    compose(P1, V2, P2), in(P2, _).         // next mark, on grid

// Each step advances the color cursor one seed.
.init cursor = CycleWalk<Unit, Position>
cursor.succ($U(), P1, P2) :- seed_next(P1, P2).
cursor.step($U(), N) :- grown.distance($U(), _, N).

.decl marked(p: Position, col: Color)
marked(P, Col) :- ink(P, Col).
marked(P, Col) :-
    grown.distance($U(), [P, _], N),
    order.first($U(), P0), cursor.walk($U(), P0, N, Q), ink(Q, Col).

out(P, Col) :- marked(P, Col).
out(P, Col) :- in(P, _), params.bg(Col), !marked(P, _).
