// 72207abc
// keywords: markers walk
// input: a row of seed marks
// output: From the first seed, the sequence walks toward the grow edge with
//  gaps growing by one per step, cycling the seed colors in order, until it
//  leaves the grid.

.decl out(p: Position, col: Color)

.comp Params {
    .decl grow(d: Dir) grow(DIR_R).
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// The seeds run in order of nearness to the grow edge.
.init order = Order<Unit, Position>
order.elem($U(), P) :- ink(P, _).
order.before($U(), P1, P2) :-
    ink(P1, _), ink(P2, _), params.grow(D), nearer(D, P2, P1).

// Cyclic next seed: the one just beyond; the first again after the last.
.decl seed_next(p1: Position, p2: Position)
seed_next(P1, P2) :- order.next($U(), P1, P2).
seed_next(P1, P2) :- order.last($U(), P1), order.first($U(), P2).

// A mark: its arriving jump and the seed whose color it carries. The
// first seed arrives with no jump; each step lengthens the jump by one
// cell and advances the color cursor.
.decl grown(p: Position, delta: Offset, q: Position)
grown(P, ZERO, P) :- order.first($U(), P).
grown(P2, Delta2, Q2) :-
    grown(P1, Delta1, Q1), seed_next(Q1, Q2),       // color cursor advances
    params.grow(D), neighbor(Delta1, D, Delta2),    // jump grows one cell
    compose(P1, Delta2, P2), in(P2, _).             // next mark, on grid

.decl marked(p: Position, col: Color)
marked(P, Col) :- ink(P, Col).
marked(P, Col) :- grown(P, _, Q), ink(Q, Col).

out(P, Col) :- marked(P, Col).
out(P, Col) :- in(P, _), params.bg(Col), !marked(P, _).
