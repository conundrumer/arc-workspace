// 9b4c17c4
// @draft
// @keywords: objects lines move enclose
// @scene field: the grid is two rectangular fields, each one connected
//  region of one background color
// @scene shape: the ink shapes are rectangles, each surrounded by one field
// @scene lane: no two shapes on one field share a line along that field's
//  slide direction
// @rule direction: each field color picks the direction its shapes slide
// @rule flush: each shape slides in its field's direction until it touches
//  the field's edge
// @rule ground: every other cell takes its field's color

// what slides: the shape as one body, or each line's ink on its own
.type Choice =
    // @claim flush
    Flush {}
    // @rule flush: in each line along a field's slide direction, the ink
    //  packs against the field's edge
    // @witness shared-line: borderline $Pack
    //     @relaxed lane
  | Pack {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The shapes' color.
    .decl ink(c: Color) ink(2).
    // The direction the shapes on a field of color c slide.
    .decl slide(c: Color, d: Dir)
    slide(1, DIR_R).
    slide(8, DIR_L).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Flush()). impl_choice($Pack()).

// @claim field
.init field = Components<Color>
field.node(Col, P) :- in(P, Col), !params.ink(Col).

.decl field_color(f: Ident, col: Color)
field_color(F, Col) :- field.label(Col, _, F).

// @claim direction
.decl field_dir(f: Ident, d: Dir)
field_dir(F, D) :- field_color(F, Col), params.slide(Col, D).

// @claim shape
.init shape = Components<Unit>
shape.node($U(), P) :- in(P, Col), params.ink(Col).

// The field a shape sits on: the one its cells touch.
.decl on_field(x: Ident, f: Ident)
on_field(X, F) :- shape.label($U(), P, X), neighbor(P, _, Q), field.label(_, Q, F).

// The field with the shapes on it.
.decl region(f: Ident, p: Position)
region(F, P) :- field.label(_, P, F).
region(F, P) :- shape.label($U(), P, X), on_field(X, F).

// The cells outside a field, which its ink does not enter.
.decl outside(f: Ident, p: Position)
outside(F, P) :- field_color(F, _), in(P, _), !region(F, P).

.decl moved(p: Position, ch: Choice)

// --- $Flush ---

// Each shape slides as one body toward its field's slide edge.
// @claim flush
.init slide = Gravity<Ident, Unit>
slide.cell(X, $U(), P) :- shape.label($U(), P, X).
slide.dir(X, D) :- on_field(X, F), field_dir(F, D).
slide.blocked(X, P) :- on_field(X, F), outside(F, P).

moved(Q, $Flush()) :- slide.cell(X, $U(), P), slide.travel(X, $U(), V), compose(P, V, Q).

// --- $Pack ---

// Each ink cell falls toward its field's slide edge and stacks on the ink
// ahead of it.
// @claim flush
.init pack = Gravity<Ident, Position>
pack.cell(F, P, P) :- shape.label($U(), P, X), on_field(X, F).
pack.dir(F, D) :- field_dir(F, D).
pack.blocked(F, P) :- outside(F, P).

moved(Q, $Pack()) :- pack.travel(_, P, V), compose(P, V, Q).

// --- $Flush, $Pack ---

out(P, Col, Ch) :- moved(P, Ch), params.ink(Col).
out(P, Col, Ch) :- impl_choice(Ch), region(F, P), !moved(P, Ch), field_color(F, Col).

.comp Determine {
    // An ink cell the output returns to its field's color.
    .decl vacated(e: Example, p: Position, col: Color)
    vacated(E, P, Col) :-
        ex_in(E, P, Col_ink), params.ink(Col_ink), ex_out(E, P, Col), !params.ink(Col).

    // A field cell the output inks.
    .decl inked(e: Example, p: Position, col: Color)
    inked(E, P, Col) :-
        ex_in(E, P, Col), !params.ink(Col), ex_out(E, P, Col_ink), params.ink(Col_ink).

    // The ink left the vacated cell toward d: a cell of its field is inked
    // ahead of it on its line.
    .decl led(e: Example, p: Position, d: Dir)
    led(E, P, D) :-
        vacated(E, P, Col), inked(E, Q, Col),
        axis_of(D, A), same_line(A, P, Q), nearer(D, Q, P).

    // Some vacated cell on a field of color c left toward d.
    .decl cand(c: Color, d: Dir)
    cand(Col, D) :- vacated(E, P, Col), led(E, P, D).

    // Some shape on a field of color c did not leave toward d.
    .decl stranded(c: Color, d: Dir)
    stranded(Col, D) :- cand(Col, D), vacated(E, P, Col), !led(E, P, D).

    .decl slide(c: Color, d: Dir)
    slide(Col, D) :- cand(Col, D), !stranded(Col, D).
}
