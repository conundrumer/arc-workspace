// 017c7c7b
// concept: wallpaper grow lines
// The input continues periodically: the output is the grid extended to
// c.extent along c.dir with the ink recolored, each new cell repeating
// the color one period back. The period is the shortest shift along
// c.dir the input agrees with itself under.
//
//   $Line — one period per across-line.
//   $Grid — one period for the whole grid.

#include "../lib.dl"

.type Choice = Line {} | Grid {}

.comp Consts {
    .decl dir(d: Dir) dir(DIR_B).        // growth direction
    .decl extent(n: number) extent(9).   // output extent along it

    .decl bg(col: Color) bg(0).
    .decl ink(col: Color) ink(2).        // output ink
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Line()). impl_choice($Grid()).

// Input cell with the across-line it sits on.
.decl cell_line(p: Position, line: Position, col: Color)
cell_line(P, Line, Col) :-
    in(P, Col), c.dir(D), axis_of(D, A), split(P, A, _, Line).

// Output frame: c.extent cells along c.dir's axis, the input's lines
// across.
.init frame = AxisFrame<Unit>
frame.extent($U(), A, N) :- c.dir(D), axis_of(D, A), c.extent(N).

.decl out_cell(p: Position)
out_cell(P_grid_out) :-
    c.dir(D), axis_of(D, A), frame.cell($U(), A, P_along),   // step along the axis
    cell_line(_, Line, _), compose(P_along, Line, P_grid_out).

// Input embedded at the edge the growth moves away from, each cell
// keeping its line.
.decl base(line: Position, p: Position, col: Color)
base(Line, P_grid_out, Col) :-
    out_cell(P_grid_out), cell_line(P_grid_in, Line, Col),
    c.dir(D), opposite(D, O),
    slab_anchor(O, P_grid_in, P_grid_out).

// The period the continuation repeats by, per case and line.
.decl period_at(ch: Choice, line: Position, k: number)

// Colors over the output frame: the input, then each cell repeating the
// one a period back. A jump along c.dir keeps the line.
.decl fill(ch: Choice, line: Position, p: Position, col: Color)
fill(Ch, Line, P, Col) :- impl_choice(Ch), base(Line, P, Col).
fill(Ch, Line, P_grid_out, Col) :-
    fill(Ch, Line, P, Col),
    c.dir(D), period_at(Ch, Line, K), jump(P, D, K, P_grid_out),
    out_cell(P_grid_out).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :-
    fill(Ch, _, P, C),
    ( !c.bg(C), c.ink(Col)  // ink recolored
    ; c.bg(C), Col = C      // bg passes
    ).

// --- $Line ---

.init parse_line = ShiftInvariance<Position, Color>
parse_line.cell(Line, P, Col) :- cell_line(P, Line, Col).

period_at($Line(), Line, K) :-
    c.dir(D), axis_of(D, A), parse_line.min_period(Line, A, K).

// --- $Grid ---

.init parse_grid = ShiftInvariance<Unit, Color>
parse_grid.cell($U(), P, Col) :- in(P, Col).

// The grid's period, so every line takes it.
period_at($Grid(), Line, K) :-
    cell_line(_, Line, _),
    c.dir(D), axis_of(D, A), parse_grid.min_period($U(), A, K).
