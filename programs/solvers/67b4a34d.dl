// 67b4a34d
// concept: crop symmetry repair
// A grid symmetric about its center, occluded by a solid mask-color patch;
// the output is the occluded content, restored from symmetric counterparts.
//
//   $Full   — every element applies: the grid is fully symmetric.
//   $Detect — the group is detected: elements unbroken on clean cells.

#include "../lib.dl"

.type Choice = Full {} | Detect {}

.comp Consts {
    // --- shared ---
    .decl mask(col: Color)
    mask(3).
}

.init c = Consts

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !c.mask(Col).

.decl masked(p: Position)
masked(P) :- in(P, Col), c.mask(Col).

.init boxframe = BoxFrame<Unit>
boxframe.cell($U(), P) :- masked(P).

.decl out(p: Position, col: Color, c: Choice)

// --- $Full ---

out(P_out, Col, $Full()) :-
    boxframe.inner($U(), P, P_out),    // masked cell in the box frame
    d4_elem(D), apply(D, P, P2),       // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// D maps some clean cell to a clean cell of a different color.
.decl broken(d: D4)
broken(D) :-
    d4_elem(D),
    clean(P, Col), apply(D, P, P2),
    clean(P2, C2), Col != C2.

out(P_out, Col, $Detect()) :-
    boxframe.inner($U(), P, P_out),             // masked cell in the box frame
    d4_elem(D), !broken(D), apply(D, P, P2),    // unbroken-symmetry image
    clean(P2, Col).
