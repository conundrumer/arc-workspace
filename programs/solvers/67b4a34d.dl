// 67b4a34d
// keywords: crop symmetry repair latent-canvas
// output: A grid symmetric about its center, occluded by a solid mask-color
//  patch; the output is the occluded content, restored from symmetric
//  counterparts.

// which D4 elements the grid is symmetric under
.type Choice =
    // every element applies: the grid is fully symmetric
    Full {}
    // the group is detected: elements unbroken on clean cells
  | Detect {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl mask(col: Color) mask(3).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.mask(Col).

// The hole: the masked cells.
.init hole = Bbox<Unit>
hole.cell($U(), P) :- in(P, Col), params.mask(Col).

// Each masked cell in the hole's own frame, which the output is read in.
.decl hole_cell(p: Position, p_inner: Position)
hole_cell(P, P_inner) :- hole.cell($U(), P), hole.box($U(), B), crop(P, B, P_inner).

// --- $Full ---

out(P_inner, Col, $Full()) :-
    hole_cell(P, P_inner),
    d4_elem(D), apply(D, P, P2),   // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// Self-symmetry of the clean cells.
.init sym = D4Map<Unit, Color>
sym.src($U(), P, Col) :- clean(P, Col).
sym.dst($U(), P, Col) :- clean(P, Col).

out(P_inner, Col, $Detect()) :-
    hole_cell(P, P_inner),
    sym.compatible($U(), D), apply(D, P, P2),   // unbroken-symmetry image
    clean(P2, Col).
