// 2a5f8217
// draft
// concept: objects classify
// Single-color shapes lie on params.bg. Every shape of params.blank has a twin — a shape
// of some other color with the same footprint — and takes its twin's color.

#include "../lib.dl"

.type Shape = [col: Color, id: Ident]

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl blank(col: Color) blank(1).
}

.init params = Params

.init shapes = Components<Color>
shapes.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl shape(s: Shape, p: Position)
shape([Col, Id], P) :- shapes.label(Col, P, Id).

.init bbox = Bbox<Shape>
bbox.cell(S, P) :- shape(S, P).

// A shape's footprint: its cells in its own box.
.decl footprint(s: Shape, p_inner: Position)
footprint(S, P_inner) :- shape(S, P), bbox.box(S, B), crop(P, B, P_inner).

// Same footprint: the two shapes fill their boxes alike.
.init same = KeyedSetCompare<Shape, Shape, Position>
same.pattern_member([Col, Id], P_inner) :- footprint([Col, Id], P_inner), !params.blank(Col).
same.observed_member([Col, Id], P_inner) :- footprint([Col, Id], P_inner), params.blank(Col).

.decl paint(p: Position, col: Color)
paint(P, Col) :- shape(S, P), same.equals(S, [Col, _]).

.decl out(p: Position, col: Color)
out(P, Col) :- paint(P, Col).
out(P, Col) :- in(P, Col), !paint(P, _).
