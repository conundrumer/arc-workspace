// 2037f2c7
// draft
// keywords: objects crop count
// input: Two copies of one shape sit apart on the background, and one copy
//  has cells erased to the background. Each copy is read in its own bounding
//  box, so the two footprints share a frame.
// output: The output is that frame cropped to the cells the copies disagree
//  on, those cells in one color.

// what counts as a disagreement
.type Choice =
    // a cell disagrees when exactly one copy fills it
    Xor {}
    // the copy filling more cells is the intact one, and a cell disagrees when
    // only the intact copy fills it
  | Damage {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(8).
}

.init params = Params

// --- copies ---

.init shapes = Components<Unit>
shapes.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- shapes.label($U(), P, Id).

// A copy's footprint in its own box frame. Equal boxes are one frame, so the
// two footprints compare cell for cell.
.decl filled(id: Ident, p: Position)
filled(Id, P_inner) :- shapes.label($U(), P, Id), bbox.box(Id, B), crop(P, B, P_inner).

// A cell copy Id fills and the other copy does not.
.decl only_in(id: Ident, p: Position)
only_in(Id, P) :-
    filled(Id, P), shapes.label($U(), _, Id2), Id2 != Id,   // the other copy
    !filled(Id2, P).                                        // which leaves this cell empty

// The disagreeing cells, in the shared frame.
.decl differs(p: Position, ch: Choice)

// --- crop ---

.init view = Bbox<Choice>
view.cell(Ch, P) :- differs(P, Ch).

out(P_inner, Col, Ch) :-
    in(P_grid, _), bbox.box(_, B_copy), crop(P_grid, B_copy, P_shared),   // a cell of the shared frame
    view.box(Ch, B), crop(P_shared, B, P_inner),                           // cropped to the disagreeing cells
    ( differs(P_shared, Ch), params.mark(Col)      // disagreeing cell
    ; !differs(P_shared, Ch), params.bg(Col)       // the rest of the crop
    ).

// --- Xor ---

differs(P, $Xor()) :- only_in(_, P).

// --- Damage ---

.init fullest = Mode<Unit, Ident, Position>
fullest.item($U(), Id, P) :- filled(Id, P).

differs(P, $Damage()) :- fullest.mode($U(), Id), only_in(Id, P).
