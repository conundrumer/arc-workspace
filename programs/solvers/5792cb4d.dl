// 5792cb4d
// draft
// concept: objects permutation rank
// The non-bg cells form one chain, and its ends are the two cells that have
// a single neighbor. The output reverses the chain's colors: each cell takes
// the color of the cell that stands as far from one end as it stands from
// the other.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(8).
}

.init params = Params

.decl node(p: Position)
node(P) :- in(P, Col), !params.bg(Col).

.decl link(p: Position, q: Position)
link(P, Q) :- node(P), dir_elem(D), neighbor(P, D, Q), node(Q).

// A chain end is a cell whose links agree on one neighbor.
.init lone = Unanimous<Position, Position>
lone.item(P, Q) :- link(P, Q).

// The walk from each end: every step but the first leads away from the cell
// the walk came from.
.decl step(e: Position, p: Position, q: Position)
step(E, E, Q) :- lone.value(E, Q).
step(E, P, Q) :- step(E, Prev, P), link(P, Q), Q != Prev.

// Each end orders the chain, and the two orders are reverses, so the
// reversal below reads the same from either.
.init chain = Order<Position, Position>
chain.elem(E, P) :- lone.value(E, _), node(P).
chain.before(E, P, Q) :- step(E, P, Q).
chain.before(E, P, R) :- chain.before(E, P, Q), chain.before(E, Q, R).

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), params.bg(Col).
out(P, Col) :-
    chain.rank(E, P, R),       // cells behind P
    chain.rank_desc(E, Q, R),  // the cell as far ahead as P is behind
    in(Q, Col).
