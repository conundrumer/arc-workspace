// 5792cb4d
// @draft
// @keywords: objects permutation rank chain
// input: the non-bg cells, forming one chain whose ends are the two cells
//  that have a single neighbor
// output: The output reverses the chain's colors: each cell takes the
//  color of the cell that stands as far from one end as it stands from
//  the other.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(8).
}

.init params = Params

.decl node(p: Position)
node(P) :- in(P, Col), !params.bg(Col).

.decl link(p: Position, q: Position)
link(P, Q) :- node(P), dir_elem(D), neighbor(P, D, Q), node(Q).

// A chain end is a cell whose links agree on one neighbor.
.init lone = Unanimous<Position, Position>
lone.item(P, Q) :- link(P, Q).

// Each cell's distance along the chain from each end.
.init along = GraphDistance<Position, Position>
along.seed(E, E) :- lone.value(E, _).
along.edge(E, P, Q) :- lone.value(E, _), link(P, Q).

out(P, Col) :- in(P, Col), params.bg(Col).
out(P, Col) :-
    along.distance(E, P, R),               // P's distance from one end
    along.distance(E2, Q, R), E2 != E,     // the cell as far from the other end
    in(Q, Col).
