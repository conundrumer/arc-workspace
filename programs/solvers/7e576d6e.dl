// 7e576d6e
// draft
// concept: lines markers span
// Parallel divider lines, each broken by a gap, cut the grid. Two marker
// cells sit off the dividers, one before the first divider and one past the
// last. A path in the marker color runs from the first marker to the second
// and threads each gap at its middle cell: it runs along the progress axis
// until the line before the next divider, turns along that line until it
// faces the gap, and runs on through it. Past the last gap it runs to the
// second marker's line and turns to the marker.

#include "../lib.dl"

.comp Params {
    // The corner the path heads toward: its progress direction on the axis
    // the dividers cut.
    .decl heading(d: DiagDir) heading(DIAG_BR).
}

.init params = Params

// The background: what most cells carry.
.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl bg(col: Color)
bg(Col) :- bg_mode.mode($U(), Col).

// A divider is a whole line with no background cell, named by the along
// component its cells share on the axis it cuts.
.decl broken(a: Axis, l: Position)
broken(A, L) :- in(P, Col), bg(Col), axis_elem(A), split(P, A, L, _).

.init cut = DividerFrame<Unit>
cut.cell($U(), P) :- in(P, _).
cut.divider($U(), A, L) :- in(P, _), axis_elem(A), split(P, A, L, _), !broken(A, L).

// The path progresses along the axis the dividers cut, toward the heading
// corner.
.decl progress(a: Axis, d: Dir)
progress(A, D) :- cut.divider($U(), A, _), params.heading(Diag), dir_of(Diag, A, D).

// The dividers' color is what most of their cells carry; the rest of a
// divider is its gap.
.init line_mode = Mode<Unit, Color, Position>
line_mode.item($U(), Col, P) :- cut.on_divider($U(), P, _), in(P, Col).

.decl gap(p: Position, l: Position)
gap(P, L) :-
    in(P, Col), cut.divider($U(), A, L), split(P, A, L, _),  // on the divider at L
    !line_mode.mode($U(), Col).                             // off the divider color

// The middle cell of each gap.
.init gap_box = BoxFrame<Position>
gap_box.cell(L, P) :- gap(P, L).

.decl gap_mid(p: Position)
gap_mid(P) :- gap_box.inner(_, P, P_inner), centered(P_inner).

// The markers: the cells off the dividers that are not background.
.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !bg(Col), !cut.on_divider($U(), P, _).

// --- path ---

// The stops the path visits, in progress order: the markers and the gap
// middles.
.init seq = Order<Unit, Position>
seq.elem($U(), P) :- marker(P, _).
seq.elem($U(), P) :- gap_mid(P).
seq.before($U(), P, Q) :-
    seq.elem($U(), P), seq.elem($U(), Q),
    progress(_, D), opposite(D, D_back), nearer(D_back, P, Q).

// Where the path enters a stop's progress line: a marker itself, or the
// cell one step before a gap.
.decl entry(s: Position, p: Position)
entry(S, S) :- marker(S, _).
entry(S, P) :- gap_mid(S), progress(_, D), opposite(D, D_back), neighbor(S, D_back, P).

// The elbow between consecutive stops: where the current stop's progress
// line meets the next stop's entry line.
.decl elbow(s: Position, s2: Position, p: Position)
elbow(S, S2, E) :-
    seq.next($U(), S, S2), entry(S2, Q), progress(A, _), perp(A, A_x),
    in(E, _), same_line(A, E, S), same_line(A_x, E, Q).

// The straight runs of the path: entry to elbow along the progress axis,
// elbow to the next entry across it.
.decl segment(p: Position, q: Position)
segment(P, E) :- elbow(S, _, E), entry(S, P).
segment(E, Q) :- elbow(_, S2, E), entry(S2, Q).

.type Segment = [p: Position, q: Position]

// The path: the cells each run spans.
.init span = Between<Segment>
span.axis([P, Q], A) :- segment(P, Q), axis_elem(A), same_line(A, P, Q).
span.cell([P, Q], C) :- segment(P, Q), in(C, _).
span.mark([P, Q], P) :- segment(P, Q).
span.mark([P, Q], Q) :- segment(P, Q).

.decl out(p: Position, col: Color)
out(P, Col) :- span.between(_, P), marker(_, Col).
out(P, Col) :- in(P, Col), !span.between(_, P).
