// 496994bd
// @keywords: d4 move
// input: an ink block sits against one edge, bg elsewhere.
// output: the output adds the block's reflected copy at the opposite edge.

// where the reflected copy comes from; the block is flush at its edge in
// every pair, so the pairs cannot separate the cases
.type Choice =
    // ink unioned with its whole-grid reflection
    Mirror {}
    // block reflection seated flush at the opposite edge
  | Seat {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- Mirror ---
    .decl axis(a: Axis) axis(AXIS_V).   // the axis the reflection inverts

    // --- Seat ---
    .decl dir(d: Dir) dir(DIR_T).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Mirror()).
impl_choice($Seat()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl img(p: Position, col: Color, ch: Choice)

// --- Mirror ---
img(P2, Col, $Mirror()) :- ink(P, Col), params.axis(A), flip_of(A, F), apply(F, P, P2).

// --- Seat ---
.init block = Bbox<Unit>
block.cell($U(), P) :- ink(P, _).

img(P2, Col, $Seat()) :-
    ink(P, Col),
    params.dir(D), axis_of(D, A), flip_of(A, F), apply(F, P, P_img),  // reflected cell
    opposite(D, O), block.box($U(), B), dist(B, D, M),                // block margin at d
    jump(P_img, O, M, P2).                                            // flush at the opposite edge

// --- Output ---

out(P, Col, Ch) :- impl_choice(Ch), ink(P, Col).
out(P, Col, Ch) :- img(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !ink(P, _), !img(P, _, Ch), params.bg(Col).
