// 496994bd
// concept: d4 move
// An ink block against one edge, bg elsewhere. The output adds the block's
// reflected copy at the opposite edge.
//
// Cases (data-equivalent — the block is flush at its edge in every pair):
//   $Mirror() — ink unioned with its whole-grid reflection
//   $Seat()   — block reflection seated flush at the opposite edge

#include "../lib.dl"

.type Choice = Mirror {} | Seat {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color) bg(0).

    // --- Mirror ---
    .decl axis(a: Axis) axis(AXIS_V).   // the axis the reflection inverts

    // --- Seat ---
    .decl dir(d: Dir) dir(DIR_T).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Mirror()).
impl_choice($Seat()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.decl img(p: Position, col: Color, ch: Choice)

// --- Mirror ---
img(P2, Col, $Mirror()) :- ink(P, Col), c.axis(A), flip_of(A, F), apply(F, P, P2).

// --- Seat ---
.init block = Bbox<Unit>
block.cell($U(), P) :- ink(P, _).

img(P2, Col, $Seat()) :-
    ink(P, Col),
    c.dir(D), axis_of(D, A), flip_of(A, F), apply(F, P, P_img),    // reflected cell
    opposite(D, O), block.edge_min($U(), D, M),                    // block margin at d
    jump_delta(O, M, Delta), compose(P_img, Delta, P2).            // flush at the opposite edge

// --- Output ---

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- impl_choice(Ch), ink(P, Col).
out(P, Col, Ch) :- img(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !ink(P, _), !img(P, _, Ch), c.bg(Col).
