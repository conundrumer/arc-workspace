// 42f14c03
// @draft
// @keywords: objects crop pack count
// output: The grid holds several objects. One of them has holes in its box, and
//  the other objects are the pieces that go in those holes. That object is the
//  one whose every hole takes a piece. The output is its box: the object's own
//  cells keep its color, and each hole takes the color of its piece.

// A piece goes in a hole when
.type Choice =
    // their cell sets are congruent
    Shape {}
    // their boxes share their extents
  | Dims {}
    // they hold as many cells
  | Size {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Shape()). impl_choice($Dims()). impl_choice($Size()).

// --- the objects ---

.init bg = Mode<Unit, Color, Position>
bg.item($U(), Col, P) :- in(P, Col).

.init obj = Components<Color>
obj.node(Col, P) :- in(P, Col), !bg.mode($U(), Col).

.decl obj_cell(o: Ident, col: Color, p: Position)
obj_cell(O, Col, P) :- obj.label(Col, P, O).

// --- the holes ---

.init bbox = Bbox<Ident>
bbox.cell(O, P) :- obj_cell(O, _, P).

.decl hole(o: Ident, p: Position)
hole(O, P) :- bbox.box(O, B), in(P, _), inside(P, B), !obj_cell(O, _, P).

.init holes = Components<Ident>
holes.node(O, P) :- hole(O, P).

// One hole of one object.
.type Hole = [o: Ident, id: Ident]

.decl hole_cell(h: Hole, p: Position)
hole_cell([O, Id], P) :- holes.label(O, P, Id).

.init hole_box = Bbox<Hole>
hole_box.cell(H, P) :- hole_cell(H, P).

// --- the frame ---

// The piece that goes in a hole.
.decl fits(h: Hole, o: Ident, ch: Choice)

.decl unfillable(o: Ident, ch: Choice)
unfillable(O, Ch) :- hole_cell([O, Id], _), impl_choice(Ch), !fits([O, Id], _, Ch).

.decl frame(o: Ident, ch: Choice)
frame(O, Ch) :- hole(O, _), impl_choice(Ch), !unfillable(O, Ch).

out(P_inner, Col, Ch) :-
    frame(F, Ch), bbox.box(F, B),
    ( obj_cell(F, Col, P)                            // the frame's own cell, in its color
    ; hole_cell([F, Id], P),                         // a hole of the frame
      fits([F, Id], O, Ch), obj_cell(O, Col, _)      // in the color of its piece
    ),
    crop(P, B, P_inner).

// --- Shape ---

.init shape = KeyedSetCompare<Hole, Ident, Position>
shape.pattern_member(O, P_inner) :- obj_cell(O, _, P), bbox.box(O, B), crop(P, B, P_inner).
shape.observed_member(H, P_inner) :- hole_cell(H, P), hole_box.box(H, B), crop(P, B, P_inner).

fits(H, O, $Shape()) :- shape.equals(H, O).

// --- Dims ---

fits(H, O, $Dims()) :-
    in(P, _), hole_box.box(H, B_h), bbox.box(O, B_o),      // the two boxes, in the grid frame
    box_extent(B_h, P, A, N1), box_extent(B_o, P, A, N1),  // one extent along an axis
    perp(A, A2),
    box_extent(B_h, P, A2, N2), box_extent(B_o, P, A2, N2).

// --- Size ---

.init hole_size = Tally<Hole, Position>
hole_size.item(H, P) :- hole_cell(H, P).

.init obj_size = Tally<Ident, Position>
obj_size.item(O, P) :- obj_cell(O, _, P).

fits(H, O, $Size()) :- hole_size.tally(H, N), obj_size.tally(O, N).
