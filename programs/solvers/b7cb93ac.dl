// b7cb93ac
// @keywords: objects pack
// output: Scattered colored pieces assemble into a rectangle. A piece is a
//  connected same-colored region; it turns but never reflects, and the largest
//  piece — the anchor — keeps the pose the input shows. A placement stands
//  while every piece still finds room beside it. Each cell takes the color of
//  the piece placed over it.
//  Congruent pieces of distinct colors are interchangeable: each valid
//  assignment of pieces to spots is a resolution, and out carries one grid per
//  resolution.

.decl out(p: Position, col: Color, res: TiebreakResolution)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The rectangle the pieces fill.
    .decl rect_dim(a: Axis, n: number)
    rect_dim(AXIS_V, 3). rect_dim(AXIS_H, 4).
}

.init params = Params

// --- the pieces ---

// A piece is one connected same-colored region of the input.
.init region = Components<Color>
region.node(Col, P) :- in(P, Col), !params.bg(Col).

.type Piece = [col: Color, id: Ident]

.decl piece_cell(pc: Piece, p: Position)
piece_cell([Col, Id], P) :- region.label(Col, P, Id).

.init bbox = Bbox<Piece>
bbox.cell(Pc, P) :- piece_cell(Pc, P).

// The piece's footprint, read from its own bbox.
.decl shape(pc: Piece, p: Position)
shape(Pc, P_inner) :- piece_cell(Pc, P), bbox.box(Pc, B), crop(P, B, P_inner).

// --- the candidate placements ---

.init largest = Mode<Unit, Piece, Position>
largest.item($U(), Pc, P) :- piece_cell(Pc, P).

.decl anchor(pc: Piece)
anchor(Pc) :- largest.mode($U(), Pc).

// The anchor's symmetries — the turns that fix its footprint.
.init turned = D4Map<Piece, Unit>
turned.src(Pc, S, $U()) :- anchor(Pc), shape(Pc, S).
turned.dst(Pc, S, $U()) :- anchor(Pc), shape(Pc, S).

// A piece's footprints. A turn that fixes the anchor's footprint reproduces
// it, so the anchor's branch keeps the pose the input shows.
.type Turn = [pc: Piece, d: D4]

.decl foot(t: Turn, p: Position)
foot([Pc, D], S2) :-
    c4_elem(D), shape(Pc, S), apply(D, S, S2),
    ( !anchor(Pc)          // a turning piece — every rotation
    ; turned.map(Pc, D)    // the anchor — only the turns that fix its pose
    ).

.init rect = Frame2D<Unit>
rect.extent($U(), A, N) :- params.rect_dim(A, N).

.init occ = Occurrences<Turn, Unit>
occ.shape(T, S, $U()) :- foot(T, S).
occ.cell(T, P, $U()) :- foot(T, _), rect.cell($U(), P).

// A candidate: a footprint laid inside the rectangle, named by the margins
// its box sits at.
.type Cand = [t: Turn, b: Position]

.decl covers(cd: Cand, p: Position)
covers([T, B], P) :- occ.occurrence(T, B), foot(T, S), compose(B, S, P).

// --- the pruning ---

.init pruning = PlacementPruning<Unit, Cand, Piece>
pruning.cand($U(), [[Pc, D], B], Pc) :- occ.occurrence([Pc, D], B).
pruning.conflict($U(), Cd, Cd2) :- covers(Cd, P), covers(Cd2, P).

// --- the resolutions ---

.type TiebreakResolution =
    End {} | Sit {b: Position, pc: Piece, rest: TiebreakResolution}

.init ties = TiebreakResolutions<Unit, Position, Piece>
ties.cand($U(), B, Pc) :- pruning.alive($U(), [_, B], Pc).

out(P, Col, R) :-
    ties.assign($U(), R, B, [Col, Id]),                         // this resolution's seat
    pruning.alive($U(), [T, B], [Col, Id]), covers([T, B], P).  // the seated piece's cells
