// 6d75e8bb
// keywords: objects
// input: a shape over bg
// output: bg cells inside its bounding box recolor params.fill.

// what owns a box
.type Choice =
    // one box over all ink
    Whole {}
    // per 8-connected component: each component's own bbox
  | Each {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(2).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl filled(p: Position, ch: Choice)

// --- $Whole ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P).

filled(P, $Whole()) :- in(P, Col), params.bg(Col), bbox.box($U(), B), inside(P, B).

// --- $Each ---

.init comps = Components8<Unit>
comps.node($U(), P) :- ink(P).

.init comp_box = Bbox<Ident>
comp_box.cell(Id, P) :- comps.label($U(), P, Id).

filled(P, $Each()) :- in(P, Col), params.bg(Col), comp_box.box(_, B), inside(P, B).

.decl impl_choice(ch: Choice)
impl_choice($Whole()). impl_choice($Each()).

out(P, F, Ch)   :- filled(P, Ch), params.fill(F).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !filled(P, Ch).
