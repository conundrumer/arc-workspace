// 8731374e
// draft
// keywords: crop markers cast select count
// input: a solid block of one color sits in colored noise, with a few flaw
//  cells of another color inside it; the block is the largest rectangle
//  outlined in one color
// output: the output crops the block; each flaw casts its color along its
//  row and its column across the crop, and the rest keeps the block's color

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

// --- block ---

.init drect = Outlines<Color>
drect.node(Col, P) :- in(P, Col).

// The cells a rectangle covers.
.decl covered(b: Box, p: Position)
covered(B, P) :- drect.box(_, B), in(P, _), inside(P, B).

// The block: the rectangle covering the most cells.
.init biggest = Mode<Unit, Box, Position>
biggest.item($U(), B, P) :- covered(B, P).

.decl block(col: Color, b: Box)
block(Col, B) :- biggest.mode($U(), B), drect.box(Col, B).

// The block cropped: each cell it covers, in its own frame.
.decl view(p: Position, p_inner: Position)
view(P, P_inner) :- block(_, B), in(P, _), crop(P, B, P_inner).

// --- flaws ---

// A block cell not of the block's color, in the crop frame.
.decl flaw(p: Position, col: Color)
flaw(P_inner, Col) :- view(P, P_inner), in(P, Col), !block(Col, _).

// Crop cells on a flaw's row or column take the flaw's color.
.decl flaw_line(p: Position, col: Color)
flaw_line(P, Col) :- view(_, P), flaw(Q, Col), axis_elem(A), same_line(A, P, Q).

out(P, Col) :-
    view(_, P),
    ( flaw_line(P, Col)
    ; !flaw_line(P, _), block(Col, _)
    ).
