// 5582e5ca
// concept: count rank
// The input frame filled with one uniform color. Models of the fill
// color, data-equivalent on this task — the winning color appears
// exactly 3 times in every pair:
//   $Mode  — the most frequent color
//   $Count — the color with a stored occurrence count

#include "../lib.dl"

.type Choice = Mode {} | Count {}

.comp Params {
    // --- Count ---
    .decl target(n: number) target(3).
}

.init params = Params

.init tally = Mode<Unit, Color, Position>
tally.item($U(), Col, P) :- in(P, Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- Mode ---
out(P, Col, $Mode()) :- in(P, _), tally.mode($U(), Col).

// --- Count ---
out(P, Col, $Count()) :- in(P, _), tally.tally($U(), Col, N), params.target(N).
