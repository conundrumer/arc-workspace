// 5582e5ca
// @keywords: count rank
// output: The input frame filled with one uniform color.

// the fill color: two models, data-equivalent on this task since the
//  winning color appears exactly 3 times in every pair
.type Choice =
    // the most frequent color
    Mode {}
    // the color with a stored occurrence count
  | Count {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- Count ---
    .decl target(n: number) target(3).
}

.init params = Params

.init tally = Mode<Unit, Color, Position>
tally.item($U(), Col, P) :- in(P, Col).

// --- Mode ---
out(P, Col, $Mode()) :- in(P, _), tally.mode($U(), Col).

// --- Count ---
out(P, Col, $Count()) :- in(P, _), tally.tally($U(), Col, N), params.target(N).
