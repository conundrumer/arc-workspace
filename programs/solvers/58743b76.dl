// 58743b76
// draft
// concept: scale

// A canvas of marks on a plain ground fills a rectangle of the grid, and a key
// block of colored cells sits apart from it; filler covers the rest. The key is
// the canvas shrunk: the canvas splits into one part per key cell, and each mark
// takes the color of the key cell at its part's place. Every other cell passes
// through.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color)  bg(0).

    // The color of the cells that are neither canvas nor key.
    .decl filler(col: Color)  filler(8).
}

.init params = Params

// --- the canvas, viewed in its own box ---

.init canvas = Bbox<Unit>
canvas.cell($U(), P_grid) :- in(P_grid, Col), params.bg(Col).

// A grid cell the canvas covers, in the canvas's own frame.
.decl on_canvas(p_grid: Position, p_inner: Position)
on_canvas(P_grid, P_inner) :- in(P_grid, _), canvas.box($U(), B), crop(P_grid, B, P_inner).

.decl mark(p: Position)
mark(P_grid) :- on_canvas(P_grid, _), in(P_grid, Col), !params.bg(Col).

// --- the key ---

.init key = Bbox<Unit>
key.cell($U(), P_grid) :-
    in(P_grid, Col), !params.filler(Col),  // a colored cell
    !on_canvas(P_grid, _).                 // outside the canvas

// --- the canvas split into one part per key cell ---

.init part = Divide2D<Unit>
part.cell(P_inner) :- on_canvas(_, P_inner).
part.dim($U(), A, N) :- key.cell($U(), P), key.box($U(), B), box_extent(B, P, A, N).
part.gap(0).

.decl out(p: Position, col: Color)
out(P_grid, Col) :-
    mark(P_grid), on_canvas(P_grid, P_inner),  // a mark, placed in the canvas
    part.tile($U(), P_inner, P_tile, _),       // the part of the canvas it falls in
    key.cell($U(), P_key), key.box($U(), B),
    crop(P_key, B, P_tile), in(P_key, Col).    // the color of the key cell at that place
out(P_grid, Col) :- in(P_grid, Col), !mark(P_grid).
