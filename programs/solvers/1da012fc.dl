// 1da012fc
// @keywords: objects markers rank
// @scene legend: the cells of the legend color bound a box, and the bodies of
//  other ink inside it are the markers
// @scene shapes: each body of ink outside the box is a shape
// @scene bands: the objects of one constellation lie in bands along the
//  reading axis — two of them either lie wholly apart along that axis, or
//  cover the same extent of it and lie wholly apart across it
// @scene read: an object precedes another in the reading order when it lies
//  wholly ahead along the reading axis, or they meet there and it lies wholly
//  ahead across
// @rule place: each shape takes the color of the marker whose place in the
//  marker constellation matches the shape's place in the shape constellation;
//  an object's place is the midpoint of its box
//     @approximated: a shape and a marker have the same place when
//      they have the same rank in the reading order
//     @witness spanning-shape: variant other
//         @relaxed bands
// @rule keep: every cell outside the shapes keeps its color

// a shape's place in the reading order — a marker is one cell, but a shape
// spreads over many, so two models of it.
.type Choice =
    // @claim read
    Separated {}
    // @scene read: an object stands at its bounding box's reading corner, and
    //  the objects run in the reading order of those corners
    // @witness side-by-side: variant concept
    //     @relaxed bands
  | Anchor {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The legend box's fill.
    .decl legend(col: Color) legend(5).

    // Reading order: the corner it starts from, and the axis it runs along
    // before stepping across. The bands fix the axis. The pairs leave the
    // corner free: under each corner the two constellations pair the same way.
    .decl corner(d: DiagDir) corner(DIAG_TL).
    .decl axis(a: Axis) axis(AXIS_V).
}

.init params = Params

// Every relation here holds per key, an input.
.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)

    // @claim legend
    .init bbox = Bbox<Key>
    bbox.cell(Ky, P) :- cell(Ky, P, Col), params.legend(Col).

    // A grid cell the legend box covers.
    .decl box_cell(key: Key, p: Position)
    box_cell(Ky, P) :- cell(Ky, P, _), bbox.box(Ky, B), inside(P, B).

    // @claim legend shapes
    .init comps = Components8<Key>
    comps.node(Ky, P) :-
        cell(Ky, P, Col), !params.bg(Col),
        ( box_cell(Ky, P), !params.legend(Col)   // a marker cell inside the box
        ; !box_cell(Ky, P)                       // an inked cell outside it
        ).

    .decl obj(key: Key, id: Ident)
    obj(Ky, Id) :- comps.label(Ky, _, Id).

    // The two constellations: markers inside the box, shapes outside it.
    .decl marker(key: Key, id: Ident)
    marker(Ky, Id) :- comps.label(Ky, P, Id), box_cell(Ky, P).

    .decl shape(key: Key, id: Ident)
    shape(Ky, Id) :- obj(Ky, Id), !marker(Ky, Id).

    // Two objects of one constellation — an object's place counts only these.
    .decl peers(key: Key, a: Ident, b: Ident)
    peers(Ky, A, B) :- marker(Ky, A), marker(Ky, B).
    peers(Ky, A, B) :- shape(Ky, A), shape(Ky, B).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Separated()). impl_choice($Anchor()).

// @claim read place
.init reading = Order<Choice, Ident>
reading.elem(Ch, Id) :- parse.obj($U(), Id), impl_choice(Ch).

.decl shape_cell(p: Position)
shape_cell(P) :- parse.comps.label($U(), P, Id), parse.shape($U(), Id).

out(P, Col, Ch) :-
    shape_cell(P), parse.comps.label($U(), P, Id),
    reading.rank(Ch, Id, R),                                // the shape's place
    reading.rank(Ch, Id2, R), parse.marker($U(), Id2),      // the marker at that place
    parse.comps.label($U(), P_marker, Id2), in(P_marker, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !shape_cell(P).

// --- $Separated ---

// The two dirs of the reading order — D1 along the reading axis, D2 across.
.decl read_dirs(d1: Dir, d2: Dir)
read_dirs(D1, D2) :- params.corner(C), params.axis(A), diag_dirs(C, A, D1, D2).

// Some cell of a lies at or behind some cell of b toward d.
.decl behind(d: Dir, a: Ident, b: Ident)
behind(D, A, B) :-
    dir_elem(D),
    parse.comps.label($U(), P, A), dist(P, D, K1),
    parse.comps.label($U(), Q, B), dist(Q, D, K2), K1 >= K2.

// Every cell of a lies strictly nearer edge d than every cell of b.
.decl ahead(d: Dir, a: Ident, b: Ident)
ahead(D, A, B) :- parse.obj($U(), A), parse.obj($U(), B), A != B, dir_elem(D), !behind(D, A, B).

reading.before($Separated(), A, B) :-
    parse.peers($U(), A, B), read_dirs(D1, D2),
    ( ahead(D1, A, B)                                       // wholly ahead along
    ; !ahead(D1, A, B), !ahead(D1, B, A),                   // or they meet along
      ahead(D2, A, B)                                       // and wholly ahead across
    ).

// --- $Anchor ---

// @claim read
.init obox = Bbox<Ident>
obox.cell(Id, P) :- parse.comps.label($U(), P, Id).

// A box carries its distance to every edge, so from the reading corner it
// reads as that corner's cell.
// @claim read
.init lex = LexOrder<Unit>
lex.corner($U(), D) :- params.corner(D).
lex.axis($U(), A) :- params.axis(A).
lex.cell($U(), B) :- obox.box(_, B).

reading.before($Anchor(), Id1, Id2) :-
    parse.peers($U(), Id1, Id2),
    obox.box(Id1, B1), obox.box(Id2, B2), lex.before($U(), B1, B2).

.comp Determine {
    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col).

    // The lines of axis a that an object lies on.
    .decl on_line(e: Example, a: Axis, id: Ident, l: Position)
    on_line(E, A, Id, L) :- ex.comps.label(E, P, Id), axis_elem(A), split(P, A, L, _).

    // Two objects of one constellation that meet along axis a and cover
    // different extents of it.
    .decl off_band(a: Axis)
    off_band(A) :-
        ex.peers(E, I, J), on_line(E, A, I, L), on_line(E, A, J, L),
        on_line(E, A, I, L2), !on_line(E, A, J, L2).

    .decl axis(a: Axis)
    axis(A) :- axis_elem(A), !off_band(A).
}
