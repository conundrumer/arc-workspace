// c8f0f002
// @representative: 0d3d703e

.decl out(p: Position, col: Color)

.comp Params {
    .decl mapping(c_from: Color, c_to: Color)
    mapping(7, 5).
}

.init params = Params

out(P, Col_out) :- in(P, Col_in), params.mapping(Col_in, Col_out).
out(P, Col)     :- in(P, Col), !params.mapping(Col, _).
