// f76d97a5
// concept: markers mapping
// Recolor a binary input: marker positions take the input's main color
// (the unique non-marker color in the grid); the main color elsewhere
// becomes background.

#include "../lib.dl"

.comp Consts {
    .decl marker(c: Color) marker(5).
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl main(col: Color)
main(Col) :- in(_, Col), !c.marker(Col).

.decl out(p: Position, col: Color)
out(P, Main) :- in(P, Col), c.marker(Col), main(Main).
out(P, Bg)   :- in(P, Col), !c.marker(Col), c.bg(Bg).
