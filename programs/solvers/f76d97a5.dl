// f76d97a5
// @keywords: mapping
// output: Recolor a binary input: marker positions take the input's main color
//  (the unique non-marker color in the grid); the main color elsewhere becomes
//  background.

.decl out(p: Position, col: Color)

.comp Params {
    .decl marker(c: Color) marker(5).
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl main(col: Color)
main(Col) :- in(_, Col), !params.marker(Col).

out(P, Main) :- in(P, Col), params.marker(Col), main(Main).
out(P, Bg)   :- in(P, Col), !params.marker(Col), params.bg(Bg).
