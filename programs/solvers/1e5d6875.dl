// 1e5d6875
// @draft
// @keywords: objects move d4 lookup bbox
// input: the grid holds L-trominoes of two colors, each filling three corners
//  of a 2x2 bbox.
// output: every piece emits a copy of itself one diagonal step away, painted
//  in a color the piece's color selects; the step direction follows from the
//  piece's color and the box corner the piece leaves open. A copy reaching
//  past the frame drops, and where two copies land on one cell, stored
//  precedence picks the color.

// a copy landing on a piece cell
.type Choice =
    // the piece keeps its cell
    Keep {}
    // the copy paints over it
  | Cover {}

// A piece: its color and its component id.
.type Obj = [col: Color, id: Ident]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).

    // The color each piece color's copy paints.
    .decl mark(src: Color, col: Color)
    mark(5, 4).
    mark(2, 3).

    // Precedence where copies overlap, lowest rank first.
    .decl mark_rank(col: Color, r: number)
    mark_rank(3, 0).
    mark_rank(4, 1).

    // Each piece color's step, one chart per color: a corner a piece leaves
    // open and the diagonal a piece with that corner steps along. Each
    // orientation of the piece is a pose of the chart.
    RIGID(piece,
        .decl step(id: Ident, src: Color, open: DiagDir, dir: DiagDir)
        step(0, 5, DIAG_TR, DIAG_TR).
        step(1, 2, DIAG_TR, DIAG_BL).
    )
}

.init params = Params

.comp Parse<Key> {
    // A piece's cells.
    .decl cell(key: Key, p: Position)  // input

    .init bbox = Bbox<Key>
    bbox.cell(K, P) :- cell(K, P).

    // A piece cell at a corner of its box.
    .decl corner_cell(key: Key, p: Position, diag: DiagDir)
    corner_cell(K, P, Diag) :- cell(K, P), bbox.box(K, B), box_corner(P, B, Diag).

    // The corner of the piece's box that the piece leaves empty.
    .decl open_diag(key: Key, diag: DiagDir)
    open_diag(K, Diag) :- cell(K, _), diag_dir_elem(Diag), !corner_cell(K, _, Diag).
}

.init parts = Components<Color>
parts.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl piece_cell(o: Obj, p: Position)
piece_cell([Col, Id], P) :- parts.label(Col, P, Id).

.init parse = Parse<Obj>
parse.cell(O, P) :- piece_cell(O, P).

// The piece's copy, one step along the step its color's chart places at its
// open corner.
.decl mark_cell(p: Position, col: Color)
mark_cell(Q, M) :-
    piece_cell([Col, Id], P), parse.open_diag([Col, Id], Diag),  // a piece cell, its open corner
    params.piece_step(_, _, Col, Diag, D),                       // the step from that corner
    params.mark(Col, M),                                         // the copy's color
    neighbor(P, D, Q), in(Q, _).                                 // one step, inside the frame

.init win = ArgExtremes<Position, Color>
win.cand(P, M, R) :- mark_cell(P, M), params.mark_rank(M, R).

// --- $Keep ---
out(P, Col, $Keep()) :- in(P, Col), !params.bg(Col).
out(P, Col, $Keep()) :-
    in(P, Bg), params.bg(Bg),           // background cell
    ( win.low(P, Col, _)                // the winning copy lands on it
    ; !mark_cell(P, _), Col = Bg        // no copy reaches it
    ).

// --- $Cover ---
out(P, Col, $Cover()) :-
    in(P, Col_in),                      // input cell
    ( win.low(P, Col, _)                // the winning copy lands on it
    ; !mark_cell(P, _), Col = Col_in    // no copy reaches it
    ).

.type ExColor = [e: Example, col: Color]
.type ExObj = [e: Example, col: Color, id: Ident]

.comp Determine {
    .init parts = Components<ExColor>
    parts.node([E, Col], P) :- ex_in(E, P, Col), !params.bg(Col).

    .decl piece_cell(o: ExObj, p: Position)
    piece_cell([E, Col, Id], P) :- parts.label([E, Col], P, Id).

    .init parse = Parse<ExObj>
    parse.cell(O, P) :- piece_cell(O, P).

    // Cells the output repaints.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- ex_out(E, P, Col), ex_in(E, P, Col2), Col != Col2.

    // Where a copy toward D would land, inside the frame.
    .decl copy_land(o: ExObj, dir: DiagDir, p: Position)
    copy_land([E, Col, Id], D, Q) :-
        piece_cell([E, Col, Id], P), diag_dir_elem(D),  // a piece cell, each direction
        neighbor(P, D, Q), ex_in(E, Q, _).              // one step, inside the frame

    // The piece's shape among the repainted cells: its copy. A copy cell past
    // the frame drops, so each cell just past the frame counts as a copy cell.
    .init copy = Occurrences<ExObj, Unit>
    copy.shape(O, P, $U()) :- piece_cell(O, P).
    copy.cell([E, Col, Id], Q, $U()) :-
        piece_cell([E, Col, Id], P),
        ( painted(E, Q, _)                                      // a repainted cell
        ; diag_dir_elem(D), neighbor(P, D, Q), !ex_in(E, Q, _)  // past the frame
        ).

    // The step a piece color takes from an open corner.
    .decl shown_step(src: Color, open: DiagDir, dir: DiagDir)
    shown_step(Col, Diag, D) :-
        parse.open_diag([E, Col, Id], Diag),       // a piece's open corner
        copy.occurrence([E, Col, Id], V),          // where its copy lies
        diag_dir_elem(D), step_offset(D, V).       // one diagonal step away

    .init color_id = IdentOf<Color>
    color_id.value(Col) :- shown_step(Col, _, _).

    // One copy of the chart per piece the pairs show, which the piece's
    // example and its component id tell apart.
    .decl piece_step(e: Example, o: Ident, id: Ident, src: Color, open: DiagDir, dir: DiagDir)
    piece_step(E, O, Id, Col, Diag, D) :-
        parse.open_diag([E, Col, O], Diag),        // a piece's open corner
        copy.occurrence([E, Col, O], V),           // where its copy lies
        diag_dir_elem(D), step_offset(D, V),       // one diagonal step away
        color_id.id(Col, Id).

    // The piece's copy, under the determined step.
    .decl copy_cell(o: ExObj, p: Position)
    copy_cell([E, Col, Id], Q) :-
        copy_land([E, Col, Id], D, Q),
        parse.open_diag([E, Col, Id], Diag), shown_step(Col, Diag, D).

    // The colors a piece's copy shows. A copy overrun by a higher-precedence
    // one shows that color too, so a color's own mark is the one every piece
    // of that color shows.
    .decl copy_color(o: ExObj, col: Color)
    copy_color([E, Col, Id], M) :- copy_cell([E, Col, Id], Q), painted(E, Q, M).

    .decl mark_missing(src: Color, col: Color)
    mark_missing(Col, M) :-
        copy_color([_, Col, _], M), copy_color([E2, Col, Id2], _),
        !copy_color([E2, Col, Id2], M).

    .decl mark(src: Color, col: Color)
    mark(Col, M) :- copy_color([_, Col, _], M), !mark_missing(Col, M).

    // Where copies of two colors land together, the output shows the winner.
    .decl copy_at(e: Example, p: Position, col: Color)
    copy_at(E, Q, M) :- copy_cell([E, Col, _], Q), mark(Col, M).

    .init prec = Order<Unit, Color>
    prec.elem($U(), M) :- mark(_, M).
    prec.before($U(), M, M2) :- copy_at(E, P, M), copy_at(E, P, M2), M != M2, ex_out(E, P, M).

    .decl mark_rank(col: Color, r: number)
    mark_rank(M, R) :- prec.rank($U(), M, R).
}
