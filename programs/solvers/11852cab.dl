// 11852cab
// keywords: symmetry d4 repair
// input: a partial symmetric figure on a bg field, in its bounding box.
// output: the figure gains each of its cells' images under the transforms the
//  case admits.

// the transforms the case admits
.type Choice =
    // params.sym names the group
    Stored {}
    // the transforms the figure itself never contradicts
  | Derived {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- $Stored ---
    .decl sym(s: Sym) sym(SYM_D4).
}

.init params = Params

// The figure — the non-bg cells, in their bounding-box frame — and its
// self-maps under D4.
.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    .init bbox = Bbox<Key>
    bbox.cell(K, P) :- cell(K, P, Col), !params.bg(Col).

    .decl inner(key: Key, p: Position, p_inner: Position)
    inner(K, P, P_inner) :- cell(K, P, _), bbox.box(K, B), crop(P, B, P_inner).

    .decl figure(key: Key, p_inner: Position, col: Color)
    figure(K, P_inner, Col) :- cell(K, P, Col), !params.bg(Col), inner(K, P, P_inner).

    .init self = D4Map<Key, Color>
    self.src(K, P, Col) :- figure(K, P, Col).
    self.dst(K, P, Col) :- figure(K, P, Col).
}

// --- shared ---

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// The transforms each case applies to the figure.
.decl transform(d: D4, ch: Choice)

.decl paint(p_grid: Position, col: Color, ch: Choice)
paint(P_grid, Col, Ch) :-
    parse.figure($U(), P_inner, Col), transform(D, Ch),
    apply(D, P_inner, P_inner2),          // image in the box frame
    parse.inner($U(), P_grid, P_inner2).  // back in the grid

.decl impl_choice(ch: Choice)
impl_choice($Stored()). impl_choice($Derived()).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !paint(P, _, Ch).

// --- $Stored ---

transform(D, $Stored()) :- params.sym(S), sym_member(S, D).

// --- $Derived ---

transform(D, $Derived()) :- parse.self.compatible($U(), D).

.comp Determine {
    // The completed figure of each train output.
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_out(E, P, Col).

    // A transform some output figure lacks.
    .decl missing(d: D4)
    missing(D) :- ex_out(E, _, _), d4_elem(D), !parse.self.map(E, D).

    // Name the shared set as a subgroup value.
    .init named = KeyedSetCompare<Unit, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member($U(), D) :- d4_elem(D), !missing(D).

    .decl sym(s: Sym)
    sym(S) :- named.equals($U(), S).
}
