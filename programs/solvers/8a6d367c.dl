// 8a6d367c
// draft
// concept: crop border markers objects scale select
// Small shapes sit beside a rectangular frame. Inside the frame, a partial
// fill covers whole blocks of a coarse grid. The output is the frame, cropped,
// with its inside painted as the one shape whose pattern the fill fits: each
// block is a pattern cell, filled where the pattern has a cell.
//
// $Color — a shape is the cells of one color.
// $Piece — a shape is an 8-connected piece of one color.
// $Object — a shape is an 8-connected object, whatever its colors.

#include "../lib.dl"

.type Choice = Color {} | Piece {} | Object {}
.type Shape = [ch: Choice, id: Ident]

.comp Params {
    .decl bg(col: Color) bg(8).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Color()). impl_choice($Piece()). impl_choice($Object()).

.decl ink(col: Color)
ink(Col) :- in(_, Col), !params.bg(Col).

// The rectangles each color draws.
.init drect = Outlines<Color>
drect.node(Col, P) :- ink(Col), in(P, Col).

// The ink each rectangle holds.
.decl held(b: Box, p: Position, col: Color)
held(B, P, Col) :- drect.box(_, B), in(P, Col), interior(P, B), ink(Col).

// The frame: the rectangle that holds ink of another color.
.decl frame(b: Box, col: Color)
frame(B, Col) :- drect.box(Col, B), held(B, _, C), C != Col.

// The fill: the ink the frame holds.
.decl fill(p: Position, col: Color)
fill(P, Col) :- frame(B, _), held(B, P, Col).

// The frame's inside, in its own frame.
.init hole = Bbox<Unit>
hole.cell($U(), P) :- frame(B, _), in(P, _), interior(P, B).

.decl hole_view(p: Position, p_inner: Position)
hole_view(P, P_inner) :- hole.cell($U(), P), hole.box($U(), B), crop(P, B, P_inner).

// A grid cell the frame's box covers.
.decl covered(p: Position)
covered(P) :- frame(B, _), in(P, _), inside(P, B).

// The shapes' cells: the ink outside the frame.
.decl outside(p: Position, col: Color)
outside(P, Col) :- in(P, Col), ink(Col), !covered(P).

.decl shape_cell(s: Shape, p: Position)

// Each shape's pattern: its cells in its own box.
.init pattern = Bbox<Shape>
pattern.cell(S, P) :- shape_cell(S, P).

.decl pattern_cell(s: Shape, p_tile: Position)
pattern_cell(S, P_tile) :- shape_cell(S, P), pattern.box(S, B), crop(P, B, P_tile).

// The frame's inside divided into a shape's pattern of blocks.
.init blocks = Divide2D<Shape>
blocks.cell(P_inner) :- hole_view(_, P_inner).
blocks.dim(S, A, N) :- shape_cell(S, P), pattern.box(S, B), box_extent(B, P, A, N).
blocks.gap(0).

// The fill contradicts a shape: a fill cell sits in a block the shape's
// pattern leaves empty.
.decl contradicted(s: Shape)
contradicted(S) :-
    fill(P_grid, _), hole_view(P_grid, P_inner),
    blocks.tile(S, P_inner, P_tile, _), !pattern_cell(S, P_tile).

.decl out(p: Position, col: Color, ch: Choice)
out(P_grid_out, Col, Ch) :-
    frame(B, Col), in(P_grid_in, _), box_edge(P_grid_in, B, _),
    crop(P_grid_in, B, P_grid_out), impl_choice(Ch).
out(P_grid_out, Col, Ch) :-
    hole_view(P_grid_in, P_inner), frame(B, _), crop(P_grid_in, B, P_grid_out),
    blocks.tile(S, P_inner, P_tile, _), !contradicted(S), S = [Ch, _],  // the shape the fill hints at
    ( pattern_cell(S, P_tile), fill(_, Col)      // a pattern cell: filled
    ; !pattern_cell(S, P_tile), params.bg(Col)   // else bg
    ).

// --- Color ---

.init color_class = Canon<Position>
color_class.equiv(P, Q) :- outside(P, Col), outside(Q, Col).

shape_cell([$Color(), Id], P) :- color_class.id(P, Id).

// --- Piece ---

.init pieces = Components8<Color>
pieces.node(Col, P) :- outside(P, Col).

shape_cell([$Piece(), Id], P) :- pieces.label(_, P, Id).

// --- Object ---

.init parts = Components8<Unit>
parts.node($U(), P) :- outside(P, _).

shape_cell([$Object(), Id], P) :- parts.label($U(), P, Id).
