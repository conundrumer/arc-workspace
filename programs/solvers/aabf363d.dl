// aabf363d
// concept: markers count rank
// One non-bg color (the marker) repaints every other non-bg color: target
// cells take the marker color, marker cells become bg.
//
// Three models of marker identification:
//
//   $Anchor   — the color at corner params.marker_corner (positional)
//   $ByCount  — the color appearing in exactly params.marker_count cells
//   $Minority — the rarest color

#include "../lib.dl"

.type Choice = Anchor {} | ByCount {} | Minority {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).

    // --- $Anchor ---
    .decl marker_corner(d: DiagDir) marker_corner(DIAG_BL).

    // --- $ByCount ---
    .decl marker_count(n: number) marker_count(1).
}

.init params = Params

// Cells carrying the marker color, per case.
.decl marker(p: Position, col: Color, c: Choice)

// --- $Anchor ---
marker(P, Col, $Anchor()) :-
    in(P, Col),                                                  // input cell
    params.marker_corner(Diag), corner_anchor(Diag, P, ZERO).  // at marker corner

// --- $ByCount, $Minority shared helper ---
.init color_count = Tally<Color, Position>
color_count.item(Col, P) :- in(P, Col).

// --- $ByCount ---
marker(P, Col, $ByCount()) :-
    in(P, Col),                                                  // input cell
    params.marker_count(K), color_count.tally(Col, K).           // color with count K

// --- $Minority ---
.init rarest = ArgExtremes<Unit, Color>
rarest.cand($U(), Col, N) :- color_count.tally(Col, N).

marker(P, Col, $Minority()) :- in(P, Col), rarest.low($U(), Col, _).

// --- Output ---
.decl out(p: Position, col: Color, c: Choice)
out(P, BG, Impl) :- marker(P, _, Impl), params.bg(BG).
out(P, BG, Impl) :- marker(_, _, Impl), in(P, BG), params.bg(BG).
out(P, MarkerCol, Impl) :-
    in(P, Col), !params.bg(Col), !marker(P, _, Impl),            // non-bg, non-marker cell
    marker(_, MarkerCol, Impl).                                  // marker color
