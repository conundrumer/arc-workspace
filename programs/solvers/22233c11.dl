// 22233c11
// @draft
// @keywords: decompose move
// output: Two green squares touch corner to corner, so they fill one diagonal
//  of the 2x2 quadrant split of the box they share. Each of the other two
//  quadrants moves one quadrant-length outward along its own corner diagonal
//  and lands in cyan. Whatever leaves the grid is lost.

.decl out(p: Position, col: Color)

.comp Params {
    .decl block(col: Color) block(3).
    .decl echo(col: Color) echo(8).
}

.init params = Params

.decl block_cell(p: Position)
block_cell(P) :- in(P, Col), params.block(Col).

// The box the two squares share.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- block_cell(P).

// A cell the box covers, in both frames.
.decl box_cell(p: Position, p_inner: Position)
box_cell(P, P_inner) :- in(P, _), bbox.box($U(), B), crop(P, B, P_inner).

// Its quadrants.
.init place = DiagPlacement<Unit>
place.cell($U(), P_inner) :- box_cell(_, P_inner).

.decl quad_cell(diag: DiagDir, p: Position)
quad_cell(Diag, P) :- box_cell(P, P_inner), place.quadrant($U(), P_inner, Diag).

.init quad = Bbox<DiagDir>
quad.cell(Diag, P) :- quad_cell(Diag, P).

.decl filled(diag: DiagDir)
filled(Diag) :- quad_cell(Diag, P), block_cell(P).

.decl echo_cell(p: Position)
echo_cell(Q) :-
    quad_cell(Diag, P), !filled(Diag),  // cell of a square-free quadrant
    quad.box(Diag, B),
    box_extent(B, P, A, N), perp(A, A2), box_extent(B, P, A2, N),  // its side, both axes
    jump(P, Diag, N, Q).                                           // one quadrant outward

out(P, Col) :-
    in(P, Col_in),
    ( echo_cell(P), params.echo(Col)   // where a quadrant landed
    ; !echo_cell(P), Col = Col_in      // untouched
    ).
