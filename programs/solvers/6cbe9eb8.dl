// 6cbe9eb8
// @draft
// @keywords: rank move border
// input: A striped background holds rectangles, one color each: a block,
//  whose box it covers, or else an outline, whose cells all lie on its box's
//  edge lines.
// output: The output is the largest rectangle's box, with the rectangles
//  nested by size: each sits at params.corner of the previous one's
//  interior, the inside of an outline's rim or the whole of a block. A
//  smaller rectangle paints over a larger one; the rest of the frame is
//  params.bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl corner(d: DiagDir) corner(DIAG_BL).
}

.init params = Params

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col).

// Some cell of the color's box is another color.
.decl gap(col: Color)
gap(Col) :- bbox.box(Col, B), in(P, _), inside(P, B), !in(P, Col).

.decl block(col: Color)
block(Col) :- in(_, Col), !gap(Col).

// A cell of the color on its box's edge line.
.decl on_edge(col: Color, p: Position)
on_edge(Col, P) :- in(P, Col), bbox.box(Col, B), box_edge(P, B, _).

// Some cell of the color lies off its box's edge.
.decl inward(col: Color)
inward(Col) :- in(P, Col), !on_edge(Col, P).

.decl outline(col: Color)
outline(Col) :- in(_, Col), !block(Col), !inward(Col).

.decl shape(col: Color)
shape(Col) :- ( outline(Col) ; block(Col) ).

// The extent of a color's box on each axis.
.decl box_size(col: Color, a: Axis, n: number)
box_size(Col, A, N) :- bbox.cell(Col, P), bbox.box(Col, B), box_extent(B, P, A, N).

// Col2's box is longer than Col's on some axis.
.decl overflows(col: Color, col2: Color)
overflows(Col, Col2) :- box_size(Col, A, N), box_size(Col2, A, N2), N < N2.

// Shapes from the largest inward: Col2 fits in Col.
.init nest = Order<Unit, Color>
nest.elem($U(), Col) :- shape(Col).
nest.before($U(), Col, Col2) :- shape(Col), shape(Col2), Col != Col2, !overflows(Col, Col2).

.init frame = Frame2D<Unit>
frame.extent($U(), A, N) :- nest.first($U(), Col), box_size(Col, A, N).

// Each shape's box in the output frame: the next shape's corner cell lands
// on the anchor of the shape before it.
.decl obox(col: Color, b: Box)
obox(Col, ZERO) :- nest.first($U(), Col).
obox(Col2, B) :-
    nest.next($U(), Col, Col2), anchor(Col, Q),
    params.corner(Diag), in(P, _), bbox.box(Col2, B2),
    box_corner(P, B2, Diag), crop(P, B2, P_inner),  // Col2's corner cell, in its own frame
    relative(P_inner, Q, B).

// The corner cell of a shape's interior.
.decl anchor(col: Color, p: Position)
anchor(Col, Q) :-
    obox(Col, B), params.corner(Diag),
    frame.cell($U(), P_corner), box_corner(P_corner, B, Diag),
    ( block(Col), Q = P_corner
    ; outline(Col), diag_opposite(Diag, Opp), neighbor(P_corner, Opp, Q)  // one step in from the rim
    ).

.decl paint(col: Color, p: Position)
paint(Col, P) :-
    obox(Col, B), frame.cell($U(), P),
    ( box_edge(P, B, _) ; block(Col), interior(P, B) ).

// A smaller shape paints the cell too.
.decl covered(col: Color, p: Position)
covered(Col, P) :- nest.before($U(), Col, Col2), paint(Col2, P).

out(P, Col) :- paint(Col, P), !covered(Col, P).
out(P, Col) :- frame.cell($U(), P), !paint(_, P), params.bg(Col).
