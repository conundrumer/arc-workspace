// 1e97544e
// @draft
// @keywords: wallpaper repair walk
// input: the background is a striped pattern: one-cell-wide stripes run down
//  the grid, and every stripe jogs one cell sideways where it crosses the
//  main diagonal, so a diagonal step always moves one place along the color
//  order. Holes damage the pattern.
// output: the output restores the holes and keeps the rest.

// how the pattern's law is read
.type Choice =
    // reads the geometry: a stripe is one line, and it carries one color
    Stripe {}
    // reads the advance: the intact cells give a color cycle, and each
    // diagonal step walks one place along it
  | Cycle {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl hole(col: Color) hole(0).

    // --- $Stripe ---
    // The fault diagonal runs from this corner.
    .decl corner(d: DiagDir) corner(DIAG_TL).

    // Stripes run along this axis.
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Cycle ---
    // The cycle advances along this diagonal.
    .decl diag_axis(da: DiagAxis) diag_axis(DAXIS_DG).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Stripe()). impl_choice($Cycle()).

// The pattern the damage spared.
.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.decl damaged(p: Position)
damaged(P) :- in(P, Col), params.hole(Col).

out(P, Col, Ch) :- intact(P, Col), impl_choice(Ch).

// --- $Stripe ---

// The stripe a cell lies on, keyed by the line it starts on at the corner's
// edge on params.axis: a cell past the fault — farther from that edge than
// from the corner's other edge — has jogged one cell toward the other edge,
// so its stripe starts one line back.
.decl stripe(p: Position, s: Position)
stripe(P, S) :-
    in(P, _), params.corner(C), params.axis(A), split(P, A, _, Across),
    diag_dirs(C, A, _, D_jog), diag_dist(P, C, A, K_start, K_jog),
    ( K_start <= K_jog, S = Across                            // before the fault
    ; K_start > K_jog, opposite(D_jog, D_back), neighbor(Across, D_back, S)   // past it
    ).

// One color per stripe, from wherever the stripe survives.
.decl stripe_color(p: Position, col: Color)
stripe_color(P, Col) :- stripe(P, S), stripe(Q, S), intact(Q, Col).

out(P, Col, $Stripe()) :- damaged(P), stripe_color(P, Col).

// --- $Cycle ---

// The color cycle, read off the intact diagonal neighbor pairs — one reading
// per direction, each the other's reverse.
.decl cycle_succ(d: DiagDir, col: Color, col2: Color)
cycle_succ(D, Col, Col2) :-
    params.diag_axis(DA), diag_axis_of(D, DA),  // either way along the diagonal
    intact(P, Col), neighbor(P, D, Q), intact(Q, Col2).

// The diagonal lines through the intact cells, each cell with its step count
// from the intact cell.
.init line = Ray<Unit>
line.dir($U(), D) :- params.diag_axis(DA), diag_axis_of(D, DA).   // either way along the diagonal
line.cell($U(), P) :- in(P, _).
line.mark($U(), P) :- intact(P, _).

// The color a count of steps along the cycle reaches.
.init advance = CycleWalk<DiagDir, Color>
advance.succ(D, Col, Col2) :- cycle_succ(D, Col, Col2).
advance.step(D, K) :- line.ray($U(), _, D, K, _), diag_dir_elem(D).

// The pattern's law: a cell K diagonal steps from an intact cell lies K
// places along the cycle from it.
.decl flow(p: Position, col: Color)
flow(Q, Col2) :-
    intact(P, Col), line.ray($U(), Q, D, K, P), diag_dir_elem(D), advance.walk(D, Col, K, Col2).

out(P, Col, $Cycle()) :- damaged(P), flow(P, Col).
