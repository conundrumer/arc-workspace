// 332202d5
// draft
// keywords: lines cast
// input: The input draws a divider line in `divider_color`, and several
//  marked lines across it, each in its own color. Every crossing shows
//  `cross_color`, and the rest of the grid is `bg`.
// output: Each marked line's color moves off the line into the field: a
//  field cell takes the color of the nearest marked line along the stacking
//  axis. Where the nearest marked lines disagree, the cell takes `cross_color`.
//  Every line is redrawn in `cross_color`, and every crossing in
//  `divider_color`.

.decl out(p: Position, col: Color)

.comp Params {
    // The axis the marked lines stack along; the divider runs along it.
    .decl axis(a: Axis)
    axis(AXIS_V).

    // The field the marked lines sit in.
    .decl bg(col: Color)
    bg(7).

    // The divider's color in the input; the crossings take it in the output.
    .decl divider_color(col: Color)
    divider_color(8).

    // The crossings' color in the input; every line takes it in the output.
    .decl cross_color(col: Color)
    cross_color(1).
}

.init params = Params

// --- picture ---

// An input cell with the line it sits on in the stack, and the line it crosses.
.decl cell_split(p: Position, col: Color, p_along: Position, p_across: Position)
cell_split(P, Col, P_along, P_across) :-
    in(P, Col), params.axis(A),
    split(P, A, P_along, P_across).

// The line the divider runs on.
.decl divider(p_across: Position)
divider(P_across) :- cell_split(_, Col, _, P_across), params.divider_color(Col).

// A marked line and its color.
.decl mark(p_along: Position, col: Color)
mark(P_along, Col) :-
    cell_split(_, Col, P_along, P_across),  // a cell of the line
    !params.bg(Col), !divider(P_across).    // colored, and off the divider

// --- cast ---

// Each marked line casts its color both ways along the stacking axis.
.init casts = Ray<Unit>
casts.dir($U(), D) :- params.axis(A), axis_of(D, A).
casts.cell($U(), P_along) :- cell_split(_, _, P_along, _).
casts.mark($U(), P_along) :- mark(P_along, _).

// The colors carried by the nearest marked lines.
.init nearest = ArgExtremes<Position, Color>
nearest.cand(P_along, Col, K) :- casts.ray($U(), P_along, _, K, Src), mark(Src, Col).

.init agree = Unanimous<Position, Color>
agree.item(P_along, Col) :- nearest.low(P_along, Col, _).

// The color the nearest marked lines give a line, `cross_color` where they
// disagree.
.decl field(p_along: Position, col: Color)
field(P_along, Col) :- agree.value(P_along, Col).
field(P_along, Col) :- agree.clash(P_along), params.cross_color(Col).

// --- output ---

out(P, Col) :-
    cell_split(P, _, P_along, P_across),
    ( mark(P_along, _), divider(P_across), params.divider_color(Col)  // crossing
    ; mark(P_along, _), !divider(P_across), params.cross_color(Col)   // marked line
    ; !mark(P_along, _), divider(P_across), params.cross_color(Col)   // divider
    ; !mark(P_along, _), !divider(P_across), field(P_along, Col)      // field
    ).
