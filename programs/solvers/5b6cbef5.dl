// 5b6cbef5
// Fractal self-tensor: output = input ⊗ input. The grid is an N×N arrangement of
// N×N tiles (N = input extent); the input plays both roles — P_tile gates each
// tile (present where the input cell is non-bg), P_intile fills it with a copy of
// the input.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)
    bg(0).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_tile, C_gate), !c.bg(C_gate),                // gate: tile's input cell non-bg
    in(P_intile, Col), !c.bg(Col),                    // tile content: a non-bg input cell
    concat_2d(P_tile, P_intile, [0, 0], P_grid_out).  // tile ⊗ cell → grid

.output out(IO=stdout)
