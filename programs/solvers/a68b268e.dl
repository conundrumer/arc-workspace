// a68b268e
// @keywords: overlay decompose lookup rank
// input: A divider cross splits the grid into a tile arrangement, each tile
//  drawn in its own ink.
// output: The output overlays the tiles: the highest-precedence ink present
//  fills each cell, bg where every tile is empty. Each tile keeps one ink in
//  every pair, so spatial and chromatic precedence are indistinguishable.

// how the grid divides into tiles, indistinguishable here since every grid
// is 9×9
.type DecChoice =
    // params.tiles arrangement of equal tiles
    Count {}
    // tiles of params.tile_dim, as many as the grid holds
  | Size {}

// whether the overlay ranks by tile (spatial) precedence, as a rule or a
// stored table, or by ink (chromatic) precedence, a stored table
.type Choice =
    // tiles rank in reading order from params.lex_corner along params.lex_axis
    Scan {d: DecChoice}
    // per-tile ranks stored in params.prio
  | Order {}
    // per-ink ranks stored in params.ink_rank
  | Ink {d: DecChoice}

.type CellKey = [d: DecChoice, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl gap(g: number) gap(1).

    // --- $Count ---
    .decl tiles(n: number) tiles(2).

    // --- $Size ---
    .decl tile_dim(k: number) tile_dim(4).

    // --- $Scan ---
    .decl lex_corner(d: DiagDir) lex_corner(DIAG_TL).
    .decl lex_axis(a: Axis) lex_axis(AXIS_V).

    // --- $Order ---
    .decl prio(p: Position, r: number)
    GRID_2x2(prio,
        0, 1,
        2, 3)

    // --- $Ink ---
    .decl ink_rank(c: Color, r: number)
    ink_rank(7, 0). ink_rank(4, 1). ink_rank(8, 2). ink_rank(6, 3).
}

.init params = Params

.decl dec_choice(dc: DecChoice)
dec_choice($Count()). dec_choice($Size()).

// The division each case reads. Order takes no DecChoice field: params.prio
// keys the 2×2 arrangement, so a Size pairing would be total only where the
// grid holds two tiles per axis.
// @ignore: head-repeat — $Scan and $Ink hold their division as a field, and
//  the relation reads that field out, where $Order takes $Count
.decl tiling(ch: Choice, dc: DecChoice)
tiling($Scan(Dc), Dc) :- dec_choice(Dc).
tiling($Order(), $Count()).
tiling($Ink(Dc), Dc) :- dec_choice(Dc).

// Tile decomposition; the divider falls in the gap.
.decl tile_cell(dc: DecChoice, p_tile: Position, p_intile: Position, col: Color)
tile_cell($Count(), P_tile, P_intile, Col) :-
    in(P_grid, Col),
    params.tiles(N), params.gap(G),                                  // tile count
    divide_2d(P_grid, N, G, P_tile, P_intile).
tile_cell($Size(), P_tile, P_intile, Col) :-
    in(P_grid, Col),
    params.tile_dim(K), params.gap(G),                               // tile size
    divide_by_size_2d(P_grid, K, G, P_tile, P_intile).

// Ink at an output cell, keyed by its tile.
.decl tile_ink(dc: DecChoice, p_tile: Position, p: Position, col: Color)
tile_ink(Dc, P_tile, P_intile, Col) :- tile_cell(Dc, P_tile, P_intile, Col), !params.bg(Col).

.decl ink_at(dc: DecChoice, p: Position, col: Color)
ink_at(Dc, P, Col) :- tile_ink(Dc, _, P, Col).

out(P, Col, Ch) :- tiling(Ch, Dc), tile_cell(Dc, _, P, _), !ink_at(Dc, P, _), params.bg(Col).

// --- $Scan ---

.init lex = LexOrder<DecChoice>
lex.corner(Dc, C) :- dec_choice(Dc), params.lex_corner(C).
lex.axis(Dc, A) :- dec_choice(Dc), params.lex_axis(A).
lex.cell(Dc, T) :- tile_ink(Dc, T, _, _).

// The earliest tile in the scan inking each cell.
.init front_scan = ArgExtremes<CellKey, Position>
front_scan.cand([Dc, P], T, R) :- tile_ink(Dc, T, P, _), lex.rank(Dc, T, R).

out(P, Col, $Scan(Dc)) :- front_scan.low([Dc, P], T, _), tile_ink(Dc, T, P, Col).

// --- $Order ---

// The foremost tile inking each cell.
.init front_tile = ArgExtremes<Position, Position>
front_tile.cand(P, T, R) :- tile_ink($Count(), T, P, _), params.prio(T, R).

out(P, Col, $Order()) :- front_tile.low(P, T, _), tile_ink($Count(), T, P, Col).

// --- $Ink ---

// The foremost ink at each cell.
.init front_ink = ArgExtremes<CellKey, Color>
front_ink.cand([Dc, P], Col, R) :- ink_at(Dc, P, Col), params.ink_rank(Col, R).

out(P, Col, $Ink(Dc)) :- front_ink.low([Dc, P], Col, _).

.comp Determine {
    .decl tile_ink(e: Example, p_tile: Position, p: Position, col: Color)
    tile_ink(E, P_tile, P_intile, Col) :-
        ex_in(E, P_grid, Col), !params.bg(Col),
        params.tiles(N), params.gap(G),
        divide_2d(P_grid, N, G, P_tile, P_intile).

    // At a cell both ink, the output keeps T's ink over T2's.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        tile_ink(E, T, P, Col), tile_ink(E, T2, P, Col2), Col != Col2,
        ex_out(E, P, Col).

    // The tiles each tile beats, directly or through others: a tile pair
    // need not overlap directly.
    .init beaten = Propagation<Position, Position>
    beaten.source(T, T2) :- beats(T, T2).
    beaten.edge(T, T2, T3) :- beats(T, _), beats(T2, T3).

    .init order = Order<Unit, Position>
    order.elem($U(), T) :- tile_ink(_, T, _, _).
    order.before($U(), T, T2) :- beaten.reached(T, T2).

    // The scan starts at the corner the unbeaten tile occupies.
    .decl lex_corner(d: DiagDir)
    lex_corner(Diag) :- order.first($U(), T), corner_dist(T, Diag, 0).

    .decl prio(p: Position, r: number)
    prio(T, R) :- order.rank($U(), T, R).

    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- tile_ink(_, T, _, Col), prio(T, R).

    // The tile is the output frame.
    .decl tile_dim(k: number)
    tile_dim(K) :- ex_out(_, P, _), axis_elem(A), axis_dim(P, A, K).
}
