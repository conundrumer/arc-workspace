// 0b17323b
// @keywords: markers cast
// output: Marks of params.mark_color sit on one diagonal, evenly spaced. The
//  output keeps the input and continues the sequence in params.new_color,
//  on every cell a whole number of mark spacings along the diagonal.

// which ends of the diagonal the sequence continues from
.type Choice =
    // the sequence runs toward params.dir, and continues past that end
    Ray {}
    // the diagonal has no privileged end; the sequence continues past both
  | Line {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark_color(col: Color) mark_color(1).
    .decl new_color(col: Color) new_color(2).

    // --- $Ray ---
    .decl dir(d: DiagDir) dir(DIAG_BR).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Ray()). impl_choice($Line()).

.decl mark(p: Position)
mark(P) :- in(P, Col), params.mark_color(Col).

// Two marks a K-cell step toward corner D apart.
.decl sep(d: DiagDir, k: number)
sep(D, K) :-
    mark(P), mark(P2),                                     // two marks
    diag_dir_elem(D), axis_elem(A), sub_extent(P, A, K),   // a corner, and a step the frame admits
    jump(P, D, K, P2).

// The marks are evenly spaced, so the closest pair gives the spacing.
.init spacing = Extremes<Unit>
spacing.cand($U(), K) :- sep(_, K).

// The corners each case continues toward.
.decl walk_dir(ch: Choice, d: DiagDir)

// The sequence: the cells a whole number of steps ahead of a mark.
.decl walk(ch: Choice, p: Position)
walk(Ch, Q) :-
    mark(P), walk_dir(Ch, D), spacing.low($U(), K),            // a mark, a heading, the step
    in(Q, _), relative(P, Q, V),                               // a grid cell, from the mark
    dir_of(D, _, D_c), opposite(D_c, O), dist(V, O, T),        // how far toward the corner
    jump_offset(D, T, V),                                      // on the mark's diagonal, that far
    stride(T, K, 0, _, 0).                                     // a whole number of steps

.decl added(ch: Choice, p: Position)
added(Ch, P) :- walk(Ch, P), !mark(P).

out(P, Col, Ch) :- added(Ch, P), params.new_color(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !added(Ch, P).

// --- $Ray ---

walk_dir($Ray(), D) :- params.dir(D).

// --- $Line ---

// A mark pair gives both directions of its diagonal.
walk_dir($Line(), D) :- sep(D, _).
