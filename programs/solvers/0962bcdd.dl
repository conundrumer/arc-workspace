// 0962bcdd
// keywords: markers lookup stamp
// output: Plus-shaped marks — a center cell whose four cardinal neighbors
//  share one arm color — grow: cardinal rays extend in the arm color,
//  diagonal rays in the center color, the rest passes through.

// how the marker's growth is drawn
.type Choice =
    // casts the rays to a stored radius
    Ray {}
    // stamps stored role masks anchored on the marker
  | Lookup {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- Ray ---
    .decl radius(k: number) radius(2).

    // --- Lookup ---
    // Role masks as offsets from the marker, `@` on the marker cell.
    .decl template_arm(delta: Offset)
    GRID_STAMP_5x5(template_arm,
        _, _, 1, _, _,
        _, _, 1, _, _,
        1, 1, @_, 1, 1,
        _, _, 1, _, _,
        _, _, 1, _, _)

    .decl template_center(delta: Offset)
    GRID_STAMP_5x5(template_center,
        1, _, _, _, 1,
        _, 1, _, 1, _,
        _, _, @1, _, _,
        _, 1, _, 1, _,
        1, _, _, _, 1)
}

.init params = Params

.comp Parse<Key> {
    .decl grid(key: Key, p: Position, col: Color)

    // The neighbor toward D holds candidate arm color Col.
    .decl arm(key: Key, p: Position, d: Dir, col: Color)
    arm(Ky, P, D, Col) :-
        grid(Ky, P, _), dir_elem(D),                             // candidate center
        neighbor(P, D, Q), grid(Ky, Q, Col), !params.bg(Col).    // holds a non-bg color

    // Some direction lacks the same arm color.
    .decl mismatch(key: Key, p: Position, col: Color)
    mismatch(Ky, P, Col) :- arm(Ky, P, _, Col), dir_elem(D), !arm(Ky, P, D, Col).

    // Plus center with its center and arm colors.
    .decl marker(key: Key, p: Position, c_center: Color, c_arm: Color)
    marker(Ky, P, Cc, Ca) :- grid(Ky, P, Cc), arm(Ky, P, _, Ca), !mismatch(Ky, P, Ca).
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

// --- program ---

.decl impl_choice(ch: Choice)
impl_choice($Ray()). impl_choice($Lookup()).

.decl paint(p: Position, col: Color, ch: Choice)

// --- Ray ---
// One cast per kind, keyed by the marker cell.
.init arm = Ray<Position>
arm.dir(Pm, D) :- parse.marker($U(), Pm, _, _), dir_elem(D).
arm.cell(Pm, P) :- parse.marker($U(), Pm, _, _), in(P, _).
arm.mark(Pm, Pm) :- parse.marker($U(), Pm, _, _).

.init diag = Ray<Position>
diag.dir(Pm, D) :- parse.marker($U(), Pm, _, _), diag_dir_elem(D).
diag.cell(Pm, P) :- parse.marker($U(), Pm, _, _), in(P, _).
diag.mark(Pm, Pm) :- parse.marker($U(), Pm, _, _).

paint(P2, Col, $Ray()) :-
    params.radius(R),
    ( arm.ray(Pm, P2, _, K, _), parse.marker($U(), Pm, _, Col)     // cardinal ray — arm color
    ; diag.ray(Pm, P2, _, K, _), parse.marker($U(), Pm, Col, _)    // diagonal ray — center color
    ),
    K != 0, K <= R.                                                // within reach, not the marker

// --- Lookup ---

paint(P_grid, Col, $Lookup()) :-
    parse.marker($U(), C, Cc, Ca),
    ( params.template_arm(V), Col = Ca                // arm-role cell
    ; params.template_center(V), Col = Cc ),          // center-role cell
    compose(C, V, P_grid),                            // offset from the marker
    in(P_grid, _).                                    // clip to the grid

// --- out ---

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !paint(P, _, Ch).

.comp Determine {
    .init ex = Parse<Example>
    ex.grid(E, P, Col) :- ex_in(E, P, Col).

    // Grown stars: the non-bg output cells.
    .decl star(e: Example, p: Position, col: Color)
    star(E, P, Col) :- ex_out(E, P, Col), !params.bg(Col).

    .init comps = Components8<Example>
    comps.node(E, P) :- star(E, P, _).

    // The marker inside each star.
    .decl star_marker(e: Example, id: Ident, p: Position, c_center: Color, c_arm: Color)
    star_marker(E, Id, Pm, Cc, Ca) :-
        ex.marker(E, Pm, Cc, Ca),                // input mark
        comps.label(E, Pm, Id).                  // its star

    // A star's cell as its offset from the star's marker, with its color.
    .decl star_cell(e: Example, id: Ident, delta: Offset, col: Color)
    star_cell(E, Id, V, Col) :-
        comps.label(E, P, Id), star(E, P, Col),
        star_marker(E, Id, Pm, _, _), relative(Pm, P, V).

    .decl template_arm(delta: Offset)
    template_arm(V) :-
        star_marker(E, Id, _, _, Ca), star_cell(E, Id, V, Ca).

    .decl template_center(delta: Offset)
    template_center(V) :-
        star_marker(E, Id, _, Cc, _), star_cell(E, Id, V, Cc).
}
