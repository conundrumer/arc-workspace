// 409aa875
// concept: markers cast count lookup

// Every mark is a three-cell arrowhead: an apex, and an arm one eighth-turn
// to each side of one direction. The arrowhead aims the opposite way, shoots
// a fixed distance along that aim, and marks the cell it reaches. A cell more
// than one shot reaches takes the clash color instead. A shot that reaches an
// arrowhead marks that arrowhead whole.
// The cases differ on how an arrowhead is read: $Local takes the apex and its
// two arms off the grid; $Glyph matches a stored footprint and reads the apex
// and the aim from Consts, closed over D4.

#include "../lib.dl"

.type Choice = Local {} | Glyph {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color) bg(7).

    // The color a shot leaves, and the color where more than one lands.
    .decl mark(col: Color) mark(9).
    .decl clash(col: Color) clash(1).

    // How far a shot travels.
    .decl reach(k: number) reach(5).

    // --- Glyph ---
    // The arrowhead catalog: each footprint, the cell its shot leaves from,
    // and where that shot heads.
    RIGID(glyph,
        .decl shape(id: Ident, p: Position)
        GRID_MASK_2x2(shape, 0,
            1, 1,
            1, 0)
        GRID_MASK_2x3(shape, 1,
            0, 1, 0,
            1, 0, 1)
        .decl apex(id: Ident, p: Position)
        apex(0, [0, 1, 0, 1]). apex(1, [0, 1, 1, 1]).
        .decl aim(id: Ident, d: Dir8)
        aim(0, DIAG_TL). aim(1, DIR_T).
    )
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Local()). impl_choice($Glyph()).

// The marks' cells.
.decl ink(p: Position)
ink(P) :- in(P, Col), !c.bg(Col).

// An arrowhead, named by its apex, with the direction it shoots.
.decl arrow(p_apex: Position, aim: Dir8, ch: Choice)

// A cell of that arrowhead.
.decl arrow_cell(p_apex: Position, p: Position, ch: Choice)

// --- Local ---

// The two Dir8 straddling d: a corner's cardinals, or the corners holding a
// cardinal.
.decl dir8_flank(d: Dir8, e: Dir8)
dir8_flank(D, E) :- dir_of(D, _, E).
dir8_flank(D, E) :- dir_of(E, _, D).

// A flank of g with no arm — the defect the apex test negates.
.decl no_arm(p: Position, g: Dir8)
no_arm(P, G) :- ink(P), dir8_flank(G, E), neighbor(P, E, Q), !ink(Q).

// An ink cell with an arm on each flank of g.
.decl apex(p: Position, g: Dir8)
apex(P, G) :- ink(P), dir8_elem(G), !no_arm(P, G).

arrow(P, Aim, $Local()) :- apex(P, G), dir8_opposite(G, Aim).

arrow_cell(A, P, $Local()) :-
    apex(A, G),
    ( P = A                                    // the apex
    ; dir8_flank(G, E), neighbor(A, E, P) ).   // its two arms

// --- Glyph ---

// A footprint in one of its orientations.
.type Pose = [id: Ident, d: D4]

.init occ = Occurrences<Pose, Unit>
occ.shape([Id, D], S, $U()) :- c.glyph_shape(D, Id, S).
occ.cell([Id, D], P, $U()) :- c.glyph_shape(D, Id, _), ink(P).

// A placed footprint, with its stored apex placed alongside.
.decl placed(id: Ident, d: D4, b: Position, p_apex: Position)
placed(Id, D, B, A) :-
    occ.occurrence([Id, D], B),
    c.glyph_apex(D, Id, P_a), compose(B, P_a, A).

arrow(A, Aim, $Glyph()) :- placed(Id, D, _, A), c.glyph_aim(D, Id, Aim).

arrow_cell(A, P, $Glyph()) :-
    placed(Id, D, B, A),
    c.glyph_shape(D, Id, S), compose(B, S, P).

// --- shots ---

// The cell an arrowhead's shot reaches.
.decl shot(p: Position, p_apex: Position, ch: Choice)
shot(P, A, Ch) :- arrow(A, Aim, Ch), c.reach(K), jump(A, Aim, K, P), in(P, _).

// The arrowhead that reached a cell, absent where more than one did.
.type PC = [p: Position, ch: Choice]
.init lander = Unanimous<PC, Position>
lander.item([P, Ch], A) :- shot(P, A, Ch).

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :- lander.value([P, Ch], _), c.mark(Col).
paint(P, Col, Ch) :- lander.clash([P, Ch]), c.clash(Col).
paint(P, Col, Ch) :-
    shot(P_hit, _, Ch), arrow_cell(A, P_hit, Ch),  // an arrowhead a shot reaches
    arrow_cell(A, P, Ch), c.mark(Col).             // marked whole

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !paint(P, _, Ch).

// --- fit ---

// The chart is read off the marks whose shot repainted a background cell:
// tracing the shot back gives the apex and the aim, and the mark's own cells
// give the footprint. Marks whose footprints are D4 images of each other
// share an id, and one of each serves as the chart, in its own pose.
.comp Fit {
    .decl ink_in(e: Example, p: Position)
    ink_in(E, P) :- ex_in(E, P, Col), !c.bg(Col).

    // A repainted background cell — where a shot landed.
    .decl landed(e: Example, p: Position)
    landed(E, P) :- ex_out(E, P, Col), !c.bg(Col), ex_in(E, P, Bg), c.bg(Bg).

    // The mark a landing traces back to, and the direction its shot ran.
    .decl launch(e: Example, a: Position, d: Dir8)
    launch(E, A, D) :-
        landed(E, P), dir8_opposite(D, D_back),
        c.reach(K), jump(P, D_back, K, A), ink_in(E, A).

    .init comps = Components8<Example>
    comps.node(E, P) :- ink_in(E, P).

    // The launching mark, viewed from its own box.
    .type EA = [e: Example, a: Position]
    .init box = BoxFrame<EA>
    box.cell([E, A], P) :-
        launch(E, A, _), comps.label(E, A, Id), comps.label(E, P, Id).

    // Each pair of marks, both footprints in their own box frames.
    .type Pair = [k: EA, k2: EA]
    .init same = D4Map<Pair, Unit>
    same.src([K, K2], S, $U()) :- box.inner(K, _, S), box.inner(K2, _, _).
    same.dst([K, K2], S, $U()) :- box.inner(K, _, _), box.inner(K2, _, S).

    .init pick = Canon<EA>
    pick.equiv(K, K2) :- same.map([K, K2], _).

    // The mark standing for its id.
    .decl chart(id: Ident, k: EA)
    chart(Id, K) :- pick.rep(K, K), pick.id(K, Id).

    .decl glyph_shape(id: Ident, p: Position)
    glyph_shape(Id, S) :- chart(Id, K), box.inner(K, _, S).

    .decl glyph_apex(id: Ident, p: Position)
    glyph_apex(Id, S) :- chart(Id, [E, A]), box.inner([E, A], A, S).

    .decl glyph_aim(id: Ident, d: Dir8)
    glyph_aim(Id, D) :- chart(Id, [E, A]), launch(E, A, D).
}
