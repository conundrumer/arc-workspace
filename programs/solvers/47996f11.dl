// 47996f11
// @draft
// @keywords: symmetry repair
// input: A pattern symmetric about a center offset from the grid center,
//  corrupted by patches of one color.
// output: Each corrupted cell restores from a symmetric counterpart.

// which transforms restore a corrupted cell — coincide here: the clean
// cells contradict no element of D4, so both cases apply the full group
.type Choice =
    // params.sym names the symmetry group
    Stored {}
    // the transforms the clean cells never contradict
  | Derived {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl noise(col: Color) noise(6).

    // The symmetry center, as its offset from the grid center.
    .decl center(v: Offset) center([1, -1, 1, -1]).

    // --- $Stored ---
    .decl sym(s: Sym) sym(SYM_D4).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

// The transforms each case applies.
.decl transform(d: D4, ch: Choice)

// Symmetric counterpart: a cell's image under one of the case's transforms.
.decl counterpart(p: Position, q: Position, ch: Choice)
counterpart(P, Q, Ch) :-
    params.center(V), in(P, _), relative(V, P, P_inner),          // a cell seen from the center
    transform(D, Ch), apply(D, P_inner, Q_inner),                 // its image under a case transform
    compose(V, Q_inner, Q), in(Q, _).                             // that image, back in the grid

.decl impl_choice(ch: Choice)
impl_choice($Stored()). impl_choice($Derived()).

out(P, Col, Ch) :- clean(P, Col), impl_choice(Ch).
out(P, Col, Ch) :-
    in(P, N), params.noise(N),                     // corrupted cell
    counterpart(P, Q, Ch), clean(Q, Col).

// --- $Stored ---

transform(D, $Stored()) :- params.sym(S), sym_member(S, D).

// --- $Derived ---

// Self-symmetry of the clean cells, read in the center frame.
.init inv = D4Map<Unit, Color>
inv.src($U(), P_inner, Col) :- params.center(V), clean(P, Col), relative(V, P, P_inner).
inv.dst($U(), P_inner, Col) :- inv.src($U(), P_inner, Col).

transform(D, $Derived()) :- inv.compatible($U(), D).

.comp Determine {
    // Candidate mirror lines on one axis, as offsets from the grid center.
    .decl cand(a: Axis, v: Offset)
    cand(A, V) :-
        ex_out(_, P, _),
        axis_of(D, A), sub_extent(P, A, K),   // each axis, each distance
        jump_offset(D, K, V).
    cand(A, ZERO) :- axis_elem(A).      // the grid center line itself

    // Where a candidate's mirror carries each cell: the grid-center flip of
    // the axis, then twice the candidate's offset.
    .decl mirrored(e: Example, a: Axis, v: Offset, p: Position, q: Position)
    mirrored(E, A, V, P, Q) :-
        ex_out(E, P, _), cand(A, V),
        flip_of(A, D), apply(D, P, P1),
        compose(V, V, V_twice), compose(P1, V_twice, Q).

    // A candidate whose mirror carries some cell onto a different color.
    .decl mirror_mismatch(a: Axis, v: Offset)
    mirror_mismatch(A, V) :-
        mirrored(E, A, V, P, Q),
        ex_out(E, P, Col), ex_out(E, Q, C2), C2 != Col.

    // The axis's mirror line: unbroken, and mirroring some cell onto another
    // — an offset past the frame pairs nothing and would pass unbroken.
    .decl axis_center(a: Axis, v: Offset)
    axis_center(A, V) :-
        mirrored(E, A, V, _, Q), ex_out(E, Q, _),
        !mirror_mismatch(A, V).

    // The symmetry center: the mirror line of each axis, crossed.
    .decl center(v: Offset)
    center(V) :-
        perp(A1, A2),
        axis_center(A1, V1), axis_center(A2, V2), compose(V1, V2, V).

    // Self-symmetry of each restored grid, read in the center frame.
    .init inv = D4Map<Example, Color>
    inv.src(E, P_inner, Col) :- center(V), ex_out(E, P, Col), relative(V, P, P_inner).
    inv.dst(E, P_inner, Col) :- inv.src(E, P_inner, Col).

    // The transforms no example contradicts, named as a subgroup.
    .init named = KeyedSetCompare<Unit, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member($U(), D) :- d4_elem(D), !inv.conflict(_, D).

    .decl sym(s: Sym)
    sym(S) :- named.equals($U(), S).
}
