// 4c4377d9
// @keywords: tile-arrangement lookup d4
// output: 2×1 tile arrangement of input copies: the input at the anchor-end
//  tile, its reflection at the other.

// data-equivalent on this task
.type Choice =
    // per-tile D4 table
    Lookup {}
    // reflection tiling: each tile reflects its neighbor across the shared
    // boundary, seeded at the anchor tile
  | Unfold {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_2x1(tile_d4,
        D4_TB,
        D4_ID)

    // --- $Unfold ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 2). arr_dim(AXIS_H, 1).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(AXIS_V, V), arr_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    .decl anchor(d: Dir)
    anchor(DIR_B).
}

.init params = Params

// --- $Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                            // input cell
    params.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).                   // recompose

// --- $Unfold ---
// The input reflected across the shared boundary, once per tile step away
// from the anchor-end tile.
.init reflect = CycleWalk<Unit, Position>
reflect.succ($U(), P, P_img) :-
    in(P, _), params.anchor(D), axis_of(D, A), flip_of(A, F), apply(F, P, P_img).
reflect.step($U(), K) :- params.arr_pos(T), params.anchor(D), dist(T, D, K).

out(P_grid, Col, $Unfold()) :-
    params.arr_pos(T), params.anchor(D), dist(T, D, K),    // K tile steps from the anchor end
    reflect.walk($U(), P, K, P_intile), in(P, Col),        // reflected K times
    concat_2d(T, P_intile, 0, P_grid).
