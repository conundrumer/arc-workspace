// 673ef223
// @draft
// @keywords: lines markers cast
// output: Two bars of params.bar color lie along params.axis. A mark beside a
//  bar flags the bar cell on its line, as that cell's place in the bar, and the
//  flag carries to the cell at that place in every bar. Each flagged bar cell
//  casts the mark color across params.axis through bg until ink or the grid
//  edge stops it, and each mark becomes params.cap.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl bar(c: Color) bar(2).
    .decl mark(c: Color) mark(8).
    .decl cap(c: Color) cap(4).           // a mark once its ray is drawn
    .decl axis(a: Axis) axis(AXIS_V).     // the bars' axis
}

.init params = Params

// A cell's line across the bars: its component along params.axis.
.decl line(p: Position, p_along: Position)
line(P, P_along) :- in(P, _), params.axis(A), split(P, A, P_along, _).

.init bars = Components<Unit>
bars.node($U(), P) :- in(P, Col), params.bar(Col).

.decl bar_cell(id: Ident, p: Position, p_along: Position)
bar_cell(Id, P, P_along) :- bars.label($U(), P, Id), line(P, P_along).

// Each bar's box over its lines, the frame a place in the bar is read in.
.init bar_box = Bbox<Ident>
bar_box.cell(Id, P_along) :- bar_cell(Id, _, P_along).

// Each line of a bar, as a place in that bar.
.decl bar_place(id: Ident, p_along: Position, p_inner: Position)
bar_place(Id, P_along, P_inner) :-
    bar_box.cell(Id, P_along), bar_box.box(Id, B), crop(P_along, B, P_inner).

// A place in the bars flagged by a mark beside a bar.
.decl flagged(p_inner: Position)
flagged(P_inner) :-
    in(P, Col), params.mark(Col), line(P, P_along),  // a mark's line
    bar_place(_, P_along, P_inner).                  // the place it flags in that bar

// Flagged bar cells cast across params.axis through bg; ink stops the cast.
.init cast = Ray<Unit>
cast.dir($U(), D) :- params.axis(A), perp(A, A2), axis_of(D, A2).
cast.cell($U(), P) :- in(P, Col), params.bg(Col).
cast.blocked($U(), P) :- in(P, Col), !params.bg(Col).
cast.mark($U(), P) :-
    bar_cell(Id, P, P_along), bar_place(Id, P_along, P_inner), flagged(P_inner).

out(P, Col) :- cast.clear($U(), P, _, _, _), params.mark(Col).
out(P, Col) :-
    in(P, C_in), !cast.clear($U(), P, _, _, _),
    ( params.mark(C_in), params.cap(Col)     // a mark, capped
    ; !params.mark(C_in), Col = C_in ).      // passthrough
