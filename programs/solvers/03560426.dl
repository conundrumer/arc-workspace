// 03560426
// concept: objects walk
// The input holds separate solid rectangles. In the output they chain from
// the grid corner opposite params.corner, ordered by distance from params.order: each
// block's near corner lands where the previous block's far corner landed,
// and the later block takes that cell.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl order(d: Dir) order(DIR_L).
    .decl corner(d: DiagDir) corner(DIAG_BR).
}

.init params = Params

.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bb = Bbox<Ident>
bb.cell(Id, P) :- blocks.label($U(), P, Id).

// The two corners the chain runs through.
.decl near(id: Ident, p: Position)
near(Id, P) :- params.corner(Diag), diag_opposite(Diag, Start), bb.corner(Id, P, Start).

.decl far(id: Ident, p: Position)
far(Id, P) :- params.corner(Diag), bb.corner(Id, P, Diag).

// Id2 stands further along the order than Id1.
.decl beyond(id1: Ident, id2: Ident)
beyond(Id1, Id2) :-
    params.order(D), bb.margin(Id1, M1), bb.margin(Id2, M2), nearer(D, M1, M2).

.init chain = Order<Unit, Ident>
chain.elem($U(), Id) :- blocks.label($U(), _, Id).
chain.before($U(), Id1, Id2) :- beyond(Id1, Id2).

// Each block cell as a shift from the block's near corner.
.init off = Reframe<Ident>
off.outer(Id, N) :- near(Id, N).
off.cell(Id, P) :- blocks.label($U(), P, Id).

// Where each block's near corner lands.
.decl anchor(id: Ident, p: Position)
anchor(Id, P) :-
    chain.first($U(), Id),
    params.corner(Diag), diag_opposite(Diag, Start),
    in(P, _), corner_dist(P, Start, 0).                // grid corner the chain starts at
anchor(Id2, P2) :- chain.next($U(), Id1, Id2), far(Id1, P), place(Id1, P, P2).

// Where each block cell lands.
.decl place(id: Ident, p_in: Position, p_out: Position)
place(Id, P, P_out) :- anchor(Id, A), off.view(Id, P, Sh), compose(A, Sh, P_out).

// A block further along the chain takes the cell.
.decl taken(id: Ident, p: Position)
taken(Id, P) :- place(Id, _, P), beyond(Id, Id2), place(Id2, _, P).

.decl out(p: Position, col: Color)
out(P, Col) :- place(Id, P_in, P), !taken(Id, P), in(P_in, Col).
out(P, Col) :- in(P, _), !place(_, _, P), params.bg(Col).
