// 03560426
// @keywords: objects walk chain
// input: separate solid rectangles
// output: The output chains them from the grid corner opposite
//  params.corner, ordered by distance from params.order: each block's near
//  corner lands where the previous block's far corner landed, and the
//  later block takes that cell.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl order(d: Dir) order(DIR_L).
    .decl corner(d: DiagDir) corner(DIAG_BR).
}

.init params = Params

.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bb = Bbox<Ident>
bb.cell(Id, P) :- blocks.label($U(), P, Id).

// The block cell at each corner of its box.
.decl block_corner(id: Ident, p: Position, d: DiagDir)
block_corner(Id, P, D) :- blocks.label($U(), P, Id), bb.box(Id, B), box_corner(P, B, D).

// The corner the chain enters each block by; it leaves by the block's
// params.corner.
.decl near(id: Ident, p: Position)
near(Id, P) :- params.corner(Diag), diag_opposite(Diag, Start), block_corner(Id, P, Start).

.init chain = Order<Unit, Ident>
chain.elem($U(), Id) :- blocks.label($U(), _, Id).
chain.score($U(), Id, K) :-
    params.order(D), bb.box(Id, B), dist(B, D, K).      // distance from the edge params.order

// Id2 stands further along the order than Id1.
.decl beyond(id1: Ident, id2: Ident)
beyond(Id1, Id2) :- chain.rank($U(), Id1, R1), chain.rank($U(), Id2, R2), R1 < R2.

// A block, with a cell its near corner may land on.
.type Landing = [id: Ident, p: Position]

// The chain's walk: the first block's near corner lands on the start corner,
// and each next block's near corner lands where the previous block's far
// corner lands.
.init walk = Propagation<Unit, Landing>
walk.source($U(), [Id, P]) :-
    chain.first($U(), Id),
    params.corner(Diag), diag_opposite(Diag, Start),
    in(P, _), corner_dist(P, Start, 0).                // grid corner the chain starts at
walk.edge($U(), [Id1, A], [Id2, A2]) :-
    chain.next($U(), Id1, Id2), in(A, _),
    near(Id1, N), params.corner(Diag), block_corner(Id1, F, Diag),
    relative(N, F, V),                                 // the far corner as an offset from the near
    compose(A, V, A2).

// Where each block cell lands.
.decl place(id: Ident, p_in: Position, p_out: Position)
place(Id, P, P_out) :-
    walk.reached($U(), [Id, A]), blocks.label($U(), P, Id),   // where the near corner lands
    near(Id, N), relative(N, P, V),        // the cell as an offset from the near corner
    compose(A, V, P_out).

// A block further along the chain takes the cell.
.decl taken(id: Ident, p: Position)
taken(Id, P) :- place(Id, _, P), beyond(Id, Id2), place(Id2, _, P).

out(P, Col) :- place(Id, P_in, P), !taken(Id, P), in(P_in, Col).
out(P, Col) :- in(P, _), !place(_, _, P), params.bg(Col).
