// 03560426
// concept: objects walk
// The input holds separate solid rectangles. In the output they chain from
// the grid corner opposite c.corner, ordered by distance from c.order: each
// block's near corner lands where the previous block's far corner landed,
// and the later block takes that cell.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl order(d: Dir) order(DIR_L).
    .decl corner(d: DiagDir) corner(DIAG_BR).
}

.init c = Consts

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.init blocks = Components<Unit>
blocks.node($U(), P) :- ink(P, _).

.decl block(id: Ident, p: Position)
block(Id, P) :- blocks.label($U(), P, Id).

.init bb = Bbox<Ident>
bb.cell(Id, P) :- block(Id, P).

// The two corners the chain runs through.
.decl near(id: Ident, p: Position)
near(Id, P) :- c.corner(Diag), diag_opposite(Diag, N), bb.corner(Id, P, N).

.decl far(id: Ident, p: Position)
far(Id, P) :- c.corner(Diag), bb.corner(Id, P, Diag).

// Id2 stands further along the order than Id1.
.decl beyond(id1: Ident, id2: Ident)
beyond(Id1, Id2) :-
    c.order(D), bb.edge_min(Id1, D, K1), bb.edge_min(Id2, D, K2), K1 < K2.

.decl straddled(id1: Ident, id2: Ident)
straddled(Id1, Id2) :- beyond(Id1, Id), beyond(Id, Id2).

.decl next(id1: Ident, id2: Ident)
next(Id1, Id2) :- beyond(Id1, Id2), !straddled(Id1, Id2).

.decl first(id: Ident)
first(Id) :- block(Id, _), !beyond(_, Id).

.type BlockCell = [id: Ident, p: Position]

// Each block cell as a shift from the block's near corner.
.init off = Reframe<BlockCell>
off.outer([Id, P], N) :- block(Id, P), near(Id, N).
off.cell([Id, P], P)  :- block(Id, P).

// Where each block's near corner lands.
.decl anchor(id: Ident, p: Position)
anchor(Id, P) :-
    first(Id),
    c.corner(Diag), diag_opposite(Diag, Start),
    in(P, _), diag_dist(P, Start, _, 0, 0).            // grid corner the chain starts at
anchor(Id2, P2) :- next(Id1, Id2), far(Id1, P), place(Id1, P, P2).

// Where each block cell lands.
.decl place(id: Ident, p_in: Position, p_out: Position)
place(Id, P, P_out) :- anchor(Id, A), off.inner([Id, P], Sh), compose(A, Sh, P_out).

// A block further along the chain takes the cell.
.decl taken(id: Ident, p: Position)
taken(Id, P) :- place(Id, _, P), beyond(Id, Id2), place(Id2, _, P).

.decl out(p: Position, col: Color)
out(P, Col) :- place(Id, P_in, P), !taken(Id, P), in(P_in, Col).
out(P, Col) :- in(P, _), !place(_, _, P), c.bg(Col).
