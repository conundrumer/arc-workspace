// 8ba14f53
// @draft
// @keywords: objects enclose count rank
// input: Hollow shapes lie on params.bg.
// output: Each shape fills as many cells of a params.out_dim frame as it
//  encloses. The cells run in reading order from params.corner with
//  params.axis primary, each shape starts on a new line, and the shapes come
//  in order of their nearest cell to params.order_dir. Unfilled cells are
//  params.bg.
// review principle: Cases — Shape, Hue, and Region ship as three groupings of
//  the same cells, so re-judge whether all three stand now that Fit,
//  Fidelity, and Equivalence are the only grounds for removing a case.

// what a shape is
.type Choice =
    // one connected run of a single color
    Shape {}
    // every cell of one color
  | Hue {}
    // one color's cells in a connected run of non-bg cells
  | Region {}

// A shape under a parse: its color and an id.
.type Key = [ch: Choice, col: Color, id: Ident]

// A line of a shape's block.
.type BlockLine = [k: Key, l: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(col: Color) bg(0).

    .decl out_dim(a: Axis, n: number)
    out_dim(AXIS_V, 3). out_dim(AXIS_H, 3).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(AXIS_V, V), out_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    // The reading order the filled cells follow: from corner, axis primary.
    .decl corner(d: DiagDir) corner(DIAG_TL).
    .decl axis(a: Axis) axis(AXIS_V).

    // Blocks stack away from the corner along the primary axis.
    .decl stack_dir(d: Dir)
    stack_dir(D) :- corner(C), axis(A), dir_of(C, A, D_corner), opposite(D_corner, D).

    // Shapes fill in order of their nearest cell to this edge.
    .decl order_dir(d: Dir) order_dir(DIR_L).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Shape()). impl_choice($Hue()). impl_choice($Region()).

.decl obj(k: Key, p: Position)

// --- $Shape ---

.init shapes = Components<Color>
shapes.node(Col, P) :- in(P, Col), !params.bg(Col).

obj([$Shape(), Col, Id], P) :- shapes.label(Col, P, Id).

// --- $Hue ---

.init hues = Canon<Position>
hues.equiv(P, Q) :- in(P, Col), in(Q, Col), !params.bg(Col).

obj([$Hue(), Col, Id], P) :- in(P, Col), hues.id(P, Id).

// --- $Region ---

.init regions = Components<Unit>
regions.node($U(), P) :- in(P, Col), !params.bg(Col).

obj([$Region(), Col, Id], P) :- regions.label($U(), P, Id), in(P, Col).

// --- shared ---

// The cells a shape closes off from the grid edge.
.init closed = Closed<Key>
closed.cell(K, P) :- in(P, _), obj(K, _), !obj(K, P).

.init enclosed = Tally<Key, Position>
enclosed.item(K, P) :- closed.region(K, P, _).

// Reading order over the output frame.
.init reading = LexOrder<Unit>
reading.corner($U(), C) :- params.corner(C).
reading.axis($U(), A)   :- params.axis(A).
reading.cell($U(), P)   :- params.out_pos(P).

// A shape's block: its count of cells in reading order, before stacking.
.decl block(k: Key, p: Position)
block(K, P) :- enclosed.tally(K, N), reading.rank($U(), P, R), R < N.

// The lines a block spans along the primary axis.
.decl block_line(k: Key, l: Position)
block_line(K, L) :- block(K, P), params.axis(A), split(P, A, L, _).

// Shape order: by the nearest cell to order_dir.
.init bbox = Bbox<Key>
bbox.cell(K, P) :- obj(K, P).

// The lines the earlier shapes' blocks take: how far this block stacks.
.init offset = Tally<Key, BlockLine>
offset.item([Ch, C, I], [[Ch, C2, I2], L]) :-
    params.order_dir(D),
    bbox.box([Ch, C2, I2], B2), bbox.box([Ch, C, I], B), nearer(D, B2, B),   // an earlier shape
    block_line([Ch, C2, I2], L).
offset.domain(K) :- obj(K, _).

.decl filled(p: Position, col: Color, ch: Choice)
filled(P, Col, Ch) :-
    block(K, P0), K = [Ch, Col, _],
    offset.tally(K, S), params.stack_dir(D), jump(P0, D, S, P).

out(P, Col, Ch) :- filled(P, Col, Ch).
out(P, Col, Ch) :- params.out_pos(P), impl_choice(Ch), !filled(P, _, Ch), params.bg(Col).
