// 6fa7a44f
// Layout: 2×1 vertical — top tile is the input, bottom tile is the input
// FLIP_TB'd.

#include "../lib.dl"

.comp Consts {
    .decl tile(p: Position, d: D4)
    GRID_2x1(tile,
        IDENTITY,
        FLIP_TB)

    .decl tile_axis(a: Axis)
    tile_axis(VERTICAL).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_in, Col),                                      // input cell
    c.tile(P_tile, D),                                  // d4 at tile position
    apply(D, P_in, P_intile),                           // d4 image of input pos
    c.tile_axis(A),                                     // tile axis
    concat_slab(P_tile, P_intile, A, 0, P_grid_out).    // recompose with passthrough

.output out(IO=stdout)
