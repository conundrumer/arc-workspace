// 71e489b6
// @draft
// @keywords: objects stamp noise enclose
// input: solid figure and ground regions, with stray cells on each
// output: A figure cell that the figure does not continue through is noise,
//  and joins the ground. An input ground cell in no 2x2 block of ground is a
//  hole, unless its thin cluster is a passage that joins the solid ground at
//  two places. A hole keeps its color, and its eight neighbors take
//  params.halo.

.decl out(p: Position, col: Color)

.comp Params {
    .decl ground(c: Color) ground(0).
    .decl halo(c: Color) halo(7).

    // The 2x2 square a solid cell lies in.
    .decl square(p: Position)
    GRID_MASK_2x2(square,
        1, 1,
        1, 1)
}

.init params = Params

.decl figure(p: Position)
figure(P) :- in(P, C), !params.ground(C).

.init rim = Rim<Unit>
rim.cell($U(), P) :- figure(P).

// A figure cell with a figure neighbor toward D.
.decl figure_nbr(p: Position, d: Dir)
figure_nbr(P, D) :- figure(P), dir_elem(D), !rim.rim_dir($U(), P, D).

// A cell the figure continues through: figure neighbors on two sides.
.decl continued(p: Position)
continued(P) :- figure_nbr(P, D1), figure_nbr(P, D2), D1 != D2.

// The ground once the noise is erased.
.decl ground(p: Position)
ground(P) :- in(P, _), !continued(P).

// The 2x2 blocks of ground.
.init block = Occurrences<Unit, Unit>
block.cell($U(), P, $U()) :- ground(P).
block.shape($U(), S, $U()) :- params.square(S).

// Ground in a 2x2 block of ground.
.decl solid(p: Position)
solid(P) :- block.occurrence($U(), M), params.square(S), compose(M, S, P).

// The clusters of thin ground.
.init cluster = Components<Unit>
cluster.node($U(), P) :- ground(P), !solid(P).

// A solid cell a thin cluster touches.
.decl anchor(id: Ident, q: Position)
anchor(Id, Q) :- cluster.label($U(), P, Id), dir_elem(D), neighbor(P, D, Q), solid(Q).

// A thin cluster that joins the solid ground at two places.
.decl passage(id: Ident)
passage(Id) :- anchor(Id, Q1), anchor(Id, Q2), Q1 != Q2.

// An input ground cell in a thin cluster that is no passage.
.decl hole(p: Position)
hole(P) :- in(P, C), params.ground(C), cluster.label($U(), P, Id), !passage(Id).

.decl halo(p: Position)
halo(P) :- hole(Q), dir8_elem(D), neighbor(Q, D, P), in(P, _), !hole(P).

out(P, C) :-
    in(P, C_in),
    ( halo(P), params.halo(C)
    ; !halo(P), ground(P), params.ground(C)   // hole, noise, or input ground
    ; !halo(P), !ground(P), C = C_in          // figure
    ).
