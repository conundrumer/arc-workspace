// 142ca369
// concept: markers, walk, lookup

// Markers launch diagonal rays that paint the empty cells they cross. Every
// other colored cell is a wall: where one lies beside the ray's cell on an
// axis the ray advances along, that component of the direction inverts and
// the ray carries the wall's color from that cell on. A ray ends at the grid
// edge or on an occupied cell. The cases differ on what a marker is: $Gap
// reads an L-triomino locally, aiming away from the empty corner its arms
// straddle; $Glyph matches a stored shape and reads its launch cell and aim
// from Consts, closed over D4.

#include "../lib.dl"

.type Choice = Gap {} | Glyph {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color)
    bg(0).

    // --- Glyph ---
    // The marker shape, one orientation; the body closes over D4.
    .decl glyph(p: Position)
    GRID_MASK_2x2(glyph,
        1, 1,
        1, 0)
    // The cell a ray leaves from, and where it heads.
    .decl launch(p: Position) launch([0, 1, 0, 1]).
    .decl aim(d: DiagDir) aim(DIAG_TL).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Gap()). impl_choice($Glyph()).

// A marker's footprint cells.
.decl mark(p: Position, ch: Choice)

// The ray reaches p heading d with color col, before reflecting there.
.decl enter(p: Position, d: DiagDir, col: Color, ch: Choice)

// --- Gap ---

// Same-color neighbor toward d — a candidate arm.
.decl arm(p: Position, col: Color, d: Dir, p_arm: Position)
arm(P, Col, D, P_arm) :-
    in(P, Col), !c.bg(Col),
    dir_elem(D), step_delta(D, S), compose(P, S, P_arm), in(P_arm, Col).

// A dir of corner g with no arm — the defect the elbow test negates.
.decl no_arm(p: Position, col: Color, g: DiagDir)
no_arm(P, Col, G) :-
    in(P, Col), !c.bg(Col),
    dir_of(G, _, D), !arm(P, Col, D, _).

// The elbow of an L-triomino, with the corner its arms straddle.
.decl elbow(p: Position, col: Color, gap: DiagDir)
elbow(P, Col, G) :-
    in(P, Col), !c.bg(Col),
    diag_dir_elem(G), !no_arm(P, Col, G),           // arms on both dirs of G
    step_delta(G, S), compose(P, S, P_gap),         // the corner between them
    in(P_gap, Bg), c.bg(Bg).                        // is empty

mark(P_cell, $Gap()) :-
    elbow(P, Col, G),
    ( P_cell = P                                  // the elbow
    ; dir_of(G, _, D), arm(P, Col, D, P_cell)     // its arms
    ).

enter(P, D, Col, $Gap()) :- elbow(P, Col, G), diag_opposite(G, D).

// --- Glyph ---

// One key per orientation and color: occurrences are monochrome.
.type OC = [d: D4, col: Color]

.init occ = Occurrences<OC, Unit>
occ.cell([D, Col], P, $U()) :- d4_elem(D), in(P, Col), !c.bg(Col).
occ.shape([D, Col], P2, $U()) :-
    in(_, Col), !c.bg(Col),                       // the color domain
    d4_elem(D), c.glyph(P_m), apply(D, P_m, P2).  // the transformed shape

mark(P_grid, $Glyph()) :-
    occ.occurrence([D, Col], A),                  // a placed glyph
    occ.shape([D, Col], P_m2, $U()), compose(A, P_m2, P_grid).

enter(P, D_aim, Col, $Glyph()) :-
    occ.occurrence([D, Col], A),                  // a placed glyph
    c.launch(P_l), apply(D, P_l, P_l2), compose(A, P_l2, P),   // its launch cell
    c.aim(Dg), apply_diag_dir(D, Dg, D_aim).                   // its aim, rotated with it

// --- rays ---

// Colored cells outside the markers are walls.
.decl wall(p: Position, col: Color, ch: Choice)
wall(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !c.bg(Col), !mark(P, Ch).

// The wall beside p toward d.
.decl side_wall(p: Position, d: Dir, col: Color, ch: Choice)
side_wall(P, D, Col, Ch) :-
    in(P, _), dir_elem(D), step_delta(D, S), compose(P, S, P_side), wall(P_side, Col, Ch).

// A ray heading d meets a wall at p, beside it on an axis it advances along.
.decl hit(p: Position, d: DiagDir, col: Color, ch: Choice)
hit(P, D, Col, Ch) :- diag_dirs(D, _, D_cmp, _), side_wall(P, D_cmp, Col, Ch).

// One outgoing component of a ray heading d at p, inverted where it reflects.
.decl leave_dir(p: Position, d: DiagDir, d_out: Dir, ch: Choice)
leave_dir(P, D, D_out, Ch) :-
    in(P, _), impl_choice(Ch), diag_dirs(D, _, D_cmp, _),      // a component of d
    ( side_wall(P, D_cmp, _, Ch), opposite(D_cmp, D_out)       // reflected
    ; !side_wall(P, D_cmp, _, Ch), D_out = D_cmp               // free
    ).

// The direction the ray leaves p with, its two components recombined.
.decl bounce(p: Position, d: DiagDir, d_out: DiagDir, ch: Choice)
bounce(P, D, D_out, Ch) :-
    leave_dir(P, D, D1, Ch), leave_dir(P, D, D2, Ch),          // the two components
    diag_dirs(D_out, _, D1, D2).                               // one on each axis

// The ray leaves p, with the direction and color that cell gives it.
.decl ray(p: Position, d: DiagDir, col: Color, ch: Choice)
ray(P, D_out, Col_out, Ch) :-
    enter(P, D, Col, Ch), bounce(P, D, D_out, Ch),
    ( hit(P, D, Col_out, Ch)                      // reflected: its color
    ; !hit(P, D, _, Ch), Col_out = Col            // free: carried on
    ).

enter(P_next, D, Col, Ch) :-
    ray(P, D, Col, Ch), step_delta(D, S), compose(P, S, P_next),
    in(P_next, Bg), c.bg(Bg).                     // stops on occupied cells

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :- ray(P, _, Col, Ch), in(P, Bg), c.bg(Bg).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !paint(P, _, Ch).

// --- fit ---

.comp Fit {
    // Ray ink: painted onto bg.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :-
        ex_out(E, P, Col), !c.bg(Col),
        ex_in(E, P, Bg), c.bg(Bg).

    // Painted beside same-colored ink — a bounce cell sits against its wall.
    .decl beside_ink(e: Example, q: Position, col: Color)
    beside_ink(E, Q, Col) :-
        painted(E, Q, Col),
        dir_elem(D), step_delta(D, S), compose(Q, S, W), ex_in(E, W, Col).

    // A ray's first cell names its marker: the ink cell one step behind.
    .decl launch_cell(e: Example, p_l: Position, d: DiagDir, col: Color)
    launch_cell(E, P_l, D, Col) :-
        painted(E, Q, Col), !beside_ink(E, Q, Col),                        // first cell, not a bounce
        diag_opposite(D, D_back), step_delta(D_back, S), compose(Q, S, P_l),
        ex_in(E, P_l, Col).                                                // the ink behind it

    // The launching marker: the launch cell's same-color component, boxed.
    .type EP = [e: Example, p: Position]
    .init flood = Reach<EP>
    flood.node([E, P_l], P) :- launch_cell(E, P_l, _, Col), ex_in(E, P, Col).
    flood.seed([E, P_l], P_l) :- launch_cell(E, P_l, _, _).

    .init box = BoxFrame<EP>
    box.cell(K, P) :- flood.reach(K, P).

    // The D4 element placing the stored orientation onto this marker: it
    // carries the stored aim to the observed one, and the stored launch to
    // the launch cell's place in the box.
    .decl orient(e: Example, p_l: Position, d4: D4)
    orient(E, P_l, D4) :-
        launch_cell(E, P_l, D_obs, _), d4_elem(D4),
        c.aim(Dg), apply_diag_dir(D4, Dg, D_obs),
        c.launch(P_ls), apply(D4, P_ls, P_ll), box.inner([E, P_l], P_l, P_ll).

    // The marker's cells, carried back to the stored orientation.
    .decl glyph(p: Position)
    glyph(P_g) :-
        orient(E, P_l, D4), d4_inverse(D4, D4i),
        box.inner([E, P_l], _, P_inner),              // a marker cell, boxed
        apply(D4i, P_inner, P_g).                     // carried back
}
