// e7dd8335
// concept: objects
// A shape of one color over bg; the half of it toward c.dir recolors
// c.fill. Two claims of what owns a half, tagged on out's Choice:
//
//   $Whole — one box over all ink; its near half recolors.
//   $Each  — per 8-connected component: each component's own near half.

#include "../lib.dl"

.type Choice = Whole {} | Each {}

.comp Consts {
    .decl bg(c: Color)   bg(0).
    .decl fill(c: Color) fill(2).
    .decl dir(d: Dir)    dir(DIR_B).   // the recolored half's edge
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl ink(p: Position)
ink(P) :- in(P, Col), !c.bg(Col).

// Each ink cell viewed from its owning box, keyed by cell and claim.
.type FrameKey = [p: Position, ch: Choice]
.init boxframe = Reframe<FrameKey>
boxframe.cell([P, Ch], P) :- boxframe.outer([P, Ch], _).

// --- $Whole ---

.init box = Bbox<Unit>
box.cell($U(), P) :- ink(P).

boxframe.outer([P, $Whole()], M) :- ink(P), box.margin($U(), M).

// --- $Each ---

.init comps = Components8<Unit>
comps.node($U(), P) :- ink(P).

.init comp_box = Bbox<CompId>
comp_box.cell(Id, P) :- comps.label($U(), P, Id).

boxframe.outer([P, $Each()], M) :- comps.label($U(), P, Id), comp_box.margin(Id, M).

// Ink strictly in the box half toward c.dir.
.decl half(p: Position, ch: Choice)
half(P, Ch) :- boxframe.inner([P, Ch], I), c.dir(D), dist_pair(I, D, K, K2), K < K2.

.decl choice_elem(ch: Choice)
choice_elem($Whole()). choice_elem($Each()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, F, Ch)   :- half(P, Ch), c.fill(F).
out(P, Col, Ch) :- in(P, Col), choice_elem(Ch), !half(P, Ch).

.output out(IO=stdout)
