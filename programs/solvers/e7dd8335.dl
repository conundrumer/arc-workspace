// e7dd8335
// concept: objects
// A shape of one color over bg; the half of it toward params.dir recolors
// params.fill. Two hypotheses of what owns a half, tagged on out's Choice:
//
//   $Whole — one box over all ink; its near half recolors.
//   $Each  — per 8-connected component: each component's own near half.

#include "../lib.dl"

.type Choice = Whole {} | Each {}

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(2).
    .decl dir(d: Dir) dir(DIR_B).   // the recolored half's edge
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

// Each ink cell in the frame of its owning box.
.decl framed(p: Position, ch: Choice, p_inner: Position)

// --- $Whole ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P).

framed(P, $Whole(), P_inner) :- ink(P), bbox.box($U(), B), crop(P, B, P_inner).

// --- $Each ---

.init comps = Components8<Unit>
comps.node($U(), P) :- ink(P).

.init comp_box = Bbox<Ident>
comp_box.cell(Id, P) :- comps.label($U(), P, Id).

framed(P, $Each(), P_inner) :-
    comps.label($U(), P, Id), comp_box.box(Id, B), crop(P, B, P_inner).

// Ink strictly in the box half toward params.dir.
.decl half(p: Position, ch: Choice)
half(P, Ch) :-
    framed(P, Ch, P_inner), params.dir(D), dist_pair(P_inner, D, K, K2), K < K2.

.decl impl_choice(ch: Choice)
impl_choice($Whole()). impl_choice($Each()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, F, Ch)   :- half(P, Ch), params.fill(F).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !half(P, Ch).
