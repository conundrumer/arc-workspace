// 7837ac64
// draft
// keywords: decompose markers crop scale span
// input: Lines of one color cut the grid into a lattice of tiles. Some
//  crossings of those lines carry a mark in another color.
// output: the tile arrangement in miniature, one cell per tile: a tile whose
//  four corner crossings carry marks of one color takes that color, and every
//  other tile is bg.

// which lines frame the tiles
.type Lines =
    // every cutting line
    Lattice {}
    // the cutting lines that carry a mark, so an unmarked line between marked
    // ones frames no tile of its own
  | Marked {}

// what the miniature is cropped to
.type Span =
    // the tiles the marks' bounding box reaches
    Marks {}
    // the bounding box of the colored tiles
  | Blocks {}

.type Choice = [l: Lines, s: Span]

// A tile of one frame.
.type FrameTile = [l: Lines, p_tile: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- lattice ---

// A line carrying a bg cell. A line with none is a cutting line.
.decl gapped_line(l: Position)
gapped_line(L) :- in(P, Col), params.bg(Col), axis_elem(A), split(P, A, L, _).

// A cell on a cutting line.
.decl on_line(p: Position, a: Axis)
on_line(P, A) :- in(P, _), axis_elem(A), split(P, A, L, _), !gapped_line(L).

// A crossing of two cutting lines.
.decl node(p: Position)
node(P) :- on_line(P, A), perp(A, A2), on_line(P, A2).

.decl line_color(col: Color)
line_color(Col) :- in(P, Col), on_line(P, _), !node(P).

.decl mark(p: Position, col: Color)
mark(P, Col) :- node(P), in(P, Col), !line_color(Col).

// --- Lines cases: the lines that frame the tiles ---

.decl lines_choice(l: Lines)
lines_choice($Lattice()).
lines_choice($Marked()).

.init tiles = DividerTiles<Lines>
tiles.cell(L, P) :- in(P, _), lines_choice(L).

// $Lattice — every cutting line.
tiles.divider($Lattice(), A, Ln) :- on_line(P, A), split(P, A, Ln, _).

// $Marked — the cutting lines a mark sits on.
tiles.divider($Marked(), A, Ln) :- mark(P, _), axis_elem(A), split(P, A, Ln, _).

// --- blocks ---

// The mark at corner d of a tile.
.decl corner_mark(l: Lines, p_tile: Position, d: DiagDir, col: Color)
corner_mark(L, P_tile, D, Col) :-
    mark(P, Col), diag_opposite(D, D2), neighbor(P, D2, Q), tiles.tile_of(L, Q, P_tile).

// The one color of a tile's corner marks.
.init corner_color = Unanimous<FrameTile, Color>
corner_color.item([L, P_tile], Col) :- corner_mark(L, P_tile, _, Col).

// Some corner of the tile carries no mark.
.decl bare_corner(l: Lines, p_tile: Position)
bare_corner(L, P_tile) :-
    corner_mark(L, P_tile, _, _), diag_dir_elem(D), !corner_mark(L, P_tile, D, _).

.decl block(l: Lines, p_tile: Position, col: Color)
block(L, P_tile, Col) :- corner_color.value([L, P_tile], Col), !bare_corner(L, P_tile).

// --- Span cases: what the miniature is cropped to ---

// The box the miniature is cropped to.
.init span_box = Bbox<Choice>

// $Marks — the tiles the marks' bounding box reaches.
.init marks_box = Bbox<Unit>
marks_box.cell($U(), P) :- mark(P, _).

span_box.cell([L, $Marks()], P_tile) :-
    marks_box.box($U(), B), tiles.tile_of(L, P, P_tile), inside(P, B).

// $Blocks — the bounding box of the colored tiles.
span_box.cell([L, $Blocks()], P_tile) :- block(L, P_tile, _).

// --- output ---

out(P_grid_out, Col, [L, S]) :-
    span_box.box([L, S], B), tiles.tile_of(L, _, P_tile), crop(P_tile, B, P_grid_out),
    ( block(L, P_tile, Col)                       // four corners, one mark color
    ; !block(L, P_tile, _), params.bg(Col)        // any other tile
    ).
