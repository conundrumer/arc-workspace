// 62b74c02
// keywords: lines span stamp select
// output: An ink block sits anchored at one edge of the grid, the rest bg.
//  The output stamps a copy of the block flush at the empty edge, and fills
//  the span between the block and the copy: each line in the span takes the
//  color of the block's boundary cell on that line.

// the empty edge
.type DirCh =
    // the edge params.dir names
    Dir {}
    // the edge no ink touches
  | Edge {}

// which boundary of the block is copied
.type FillCh =
    // the boundary at the anchor edge
    Outer {}
    // the boundary facing the gap
  | Inner {}

// the empty edge, crossed with which boundary of the block is copied
.type Choice = [dir: DirCh, fill: FillCh]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- $Dir ---
    .decl dir(d: Dir) dir(DIR_R).   // the empty edge
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P, _).

.decl empty_dir(d: Dir, dc: DirCh)

// --- $Dir ---
empty_dir(D, $Dir()) :- params.dir(D).

// --- $Edge ---
empty_dir(D, $Edge()) :- bbox.box($U(), B), dir_elem(D), !dist(B, D, 0).

// Copy of the block flush at the empty edge.
.decl copy(p: Position, col: Color, dc: DirCh)
copy(P2, Col, Dc) :-
    ink(P, Col),                                  // block cell
    empty_dir(D, Dc), bbox.box($U(), B), dist(B, D, M),   // empty edge, block margin
    jump(P, D, M, P2).                            // jumped flush to it

// The block boundary the fill copies from.
.decl fill_edge(e: Dir, dc: DirCh, fc: FillCh)

// --- $Outer ---
fill_edge(E, Dc, $Outer()) :- empty_dir(D, Dc), opposite(D, E).

// --- $Inner ---
fill_edge(D, Dc, $Inner()) :- empty_dir(D, Dc).

// Between block and copy, each line takes its fill-boundary cell's color.
.decl fill(p: Position, col: Color, dc: DirCh, fc: FillCh)
fill(P, Col, Dc, Fc) :-
    in(P, Bg), params.bg(Bg), !copy(P, _, Dc), // empty cell, not under the copy
    fill_edge(E, Dc, Fc),                      // the block boundary copied
    ink(Q, Col), bbox.box($U(), B), box_edge(Q, B, E),   // its cell and color
    axis_of(E, A), same_line(A, P, Q).

.decl fill_choice(fc: FillCh)
fill_choice($Outer()). fill_choice($Inner()).

out(P, Col, [Dc, Fc]) :- ink(P, Col), empty_dir(_, Dc), fill_choice(Fc).
out(P, Col, [Dc, Fc]) :- copy(P, Col, Dc), fill_choice(Fc).
out(P, Col, [Dc, Fc]) :- fill(P, Col, Dc, Fc).
