// 27a28665
// @keywords: lookup count classify
// input: the non-background cells of a 3x3 grid form a shape, the silhouette.
// output: one cell, in the color the silhouette gives.

// what of the silhouette gives the color
.type Choice =
    // the whole shape, looked up in a table of shapes
    Lookup {}
    // whether the center is on, and the corner count
  | Classify {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).

    .decl out_dim(a: Axis, n: number)
    out_dim(AXIS_V, 1). out_dim(AXIS_H, 1).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(AXIS_V, V), out_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    // --- $Lookup ---
    .decl pattern_member(id: Ident, p: Position)
    .decl pattern_out(id: Ident, c: Color)

    GRID_MASK_3x3(pattern_member, 0,
        1, 1, _,
        1, _, 1,
        _, 1, _)
    pattern_out(0, 1).

    GRID_MASK_3x3(pattern_member, 1,
        1, _, 1,
        _, 1, _,
        1, _, 1)
    pattern_out(1, 2).

    GRID_MASK_3x3(pattern_member, 2,
        _, 1, 1,
        _, 1, 1,
        1, _, _)
    pattern_out(2, 3).

    GRID_MASK_3x3(pattern_member, 3,
        _, 1, _,
        1, 1, 1,
        _, 1, _)
    pattern_out(3, 6).

    // --- $Classify ---
    .decl center_pos(p: Position)
    center_pos([1, 1, 1, 1]).

    .decl in_dim(n: number) in_dim(3).
    .decl corner_pos(p: Position)
    corner_pos(P) :-
        diag_dir_elem(D),                           // each corner
        in_dim(N), helpers.frame_pos([N, N], P),    // P in the input frame
        corner_anchor(D, P, ZERO).                  // P at corner D

    .decl center_off_out(c: Color) center_off_out(1).

    // Corner count → output color.
    .decl center_on_out(n: number, c: Color)
    center_on_out(0, 6).
    center_on_out(2, 3).
    center_on_out(4, 2).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    .decl silhouette(k: Key, p: Position)
    silhouette(K, P) :- cell(K, P, Col), !params.bg(Col).

    .decl center_on(k: Key)
    center_on(K) :- params.center_pos(P), silhouette(K, P).

    .init corners = Tally<Key, Position>
    corners.item(K, P) :- params.corner_pos(P), silhouette(K, P).
    corners.domain(K) :- cell(K, _, _).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.init lookup_match = KeyedSetCompare<Unit, Ident, Position>
lookup_match.pattern_member(Id, P) :- params.pattern_member(Id, P).
lookup_match.observed_member($U(), P) :- parse.silhouette($U(), P).

// --- $Lookup ---
out(P, Col_out, $Lookup()) :-
    params.pattern_out(Id, Col_out),        // entry's output color
    lookup_match.equals($U(), Id),          // silhouette == entry's shape
    params.out_pos(P).

// --- $Classify ---
out(P, Col, $Classify()) :-
    !parse.center_on($U()),                 // center off
    params.center_off_out(Col), params.out_pos(P).

out(P, Col, $Classify()) :-
    parse.center_on($U()), parse.corners.tally($U(), N),    // center on, its corner count
    params.center_on_out(N, Col), params.out_pos(P).

.comp Determine {
    // Train pairs only: the ex_out atom holds the test inputs out.
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    // Examples with the same silhouette share an entry.
    .init same = KeyedSetCompare<Example, Example, Position>
    same.pattern_member(E, P)  :- parse.silhouette(E, P).
    same.observed_member(E, P) :- parse.silhouette(E, P).

    .init entry = Canon<Example>
    entry.equiv(E, E2) :- same.equals(E, E2).

    .decl pattern_member(id: Ident, p: Position)
    pattern_member(Id, P) :- entry.id(E, Id), parse.silhouette(E, P).

    .decl pattern_out(id: Ident, c: Color)
    pattern_out(Id, Col) :- entry.id(E, Id), ex_out(E, _, Col).

    .decl center_pos(p: Position)
    center_pos(P) :- parse.cell(_, P, _), centered(P).

    .decl center_off_out(c: Color)
    center_off_out(Col) :- ex_out(E, _, Col), !parse.center_on(E).

    .decl center_on_out(n: number, c: Color)
    center_on_out(N, Col) :-
        ex_out(E, _, Col),
        parse.center_on(E), parse.corners.tally(E, N).

    .decl out_dim(a: Axis, n: number)
    out_dim(A, N) :- ex_out(_, P, _), axis_elem(A), axis_dim(P, A, N).
}
