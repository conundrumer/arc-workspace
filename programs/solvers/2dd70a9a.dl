// 2dd70a9a
// @keywords: markers walk cast route
// input: wall cells are scattered over the grid, and two two-cell stubs sit
//  among them: a source stub and a target stub
// output: the output draws a path in the source color. The walker leaves
//  along the source stub's own line, runs straight until the way ahead
//  closes, turns a quarter turn there, and runs again; it arrives where the
//  target lies one step on.

// which path the task draws
.type Choice =
    // the walker turns toward the target's side at each halt, and the walk that
    // arrives is drawn
    Toward {}
    // the path runs out along the source stub's line, links across once, and
    // comes in along the target stub's line
  | Jog {}

// A leg: a cell the path runs from and the direction it runs.
.type Leg = [p: Position, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl source(col: Color) source(3).
    .decl target(col: Color) target(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Toward()). impl_choice($Jog()).

// --- shared: runs, turns, and the painted path ---

// A stub's two cells lie on one line, and the path meets the stub along it.
.decl stub_dir(col: Color, p: Position, d: Dir)
stub_dir(Col, P, D) :-
    ( params.source(Col) ; params.target(Col) ),
    in(P, Col), in(P2, Col), P != P2,     // the stub's two cells
    axis_of(D, A), same_line(A, P, P2).   // the line they share

// The path leaves the source stub along the stub's own line.
.decl leg_start(p: Position, d: Dir)
leg_start(P, D) :- params.source(Col), stub_dir(Col, P, D).

// A walker crosses the grid and halts before any occupied cell: a wall, a
// stub, or the target.
.init leg = Ray<Unit>
leg.dir($U(), D) :- dir_elem(D).
leg.cell($U(), P) :- in(P, _).
leg.mark($U(), P) :- in(P, _).
leg.blocked($U(), P) :- in(P, Col), !params.bg(Col).

// The open cells the walker crosses. A rim direction is one the way ahead
// closes in: an occupied cell, or the grid edge.
.init open = Rim<Unit>
open.cell($U(), P) :- in(P, Col), params.bg(Col).

// The walker has arrived: the target lies one step on.
.decl at_target(p: Position, d: Dir)
at_target(P, D) :-
    in(P, _), dir_elem(D), neighbor(P, D, Q),  // one step on toward d
    in(Q, Col), params.target(Col).            // a target cell

// The cells one run covers, from its start to its halt.
.decl run(a: Position, d: Dir, p: Position)
run(A, D, P) :- leg.clear($U(), P, D, _, A), dir_elem(D).

// A run halts short of the target: the way ahead closes, and the path turns
// there onto the next leg, a quarter turn either way. A walker that cannot
// take its first step does not turn.
.decl halt(a: Position, d: Dir, e: Position)
halt(A, D, E) :-
    run(A, D, E), E != A,                        // ran
    open.rim_dir($U(), E, D), !at_target(E, D).  // halted, and not arrived

// A run that halts with the target one step on is a last leg.
.decl leg_goal(p: Position, d: Dir)
leg_goal(A, D) :- run(A, D, E), at_target(E, D).

// The legs the drawn path is made of.
.decl on_path(p: Position, d: Dir, ch: Choice)

.decl path_cell(p: Position, ch: Choice)
path_cell(P, Ch) :- on_path(A, D, Ch), run(A, D, P).

out(P, Col, Ch) :- path_cell(P, Ch), params.source(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !path_cell(P, Ch).

// --- $Toward ---

// The target lies to the open cell p's d side.
.decl target_side(p: Position, d: Dir)
target_side(P, D) :-
    open.cell($U(), P), dir_elem(D),
    params.target(Col), in(T, Col), nearer(D, T, P).

// The turn the walker takes: toward the target's side.
.decl toward(a: Position, d: Dir, a2: Position, d2: Dir)
toward(A, D, A2, D2) :-
    halt(A, D, A2), perp_dir(D, D2),  // the quarter turn
    target_side(A2, D2).              // the target lies that side

// The legs the walker reaches from the source.
.init reach = Propagation<Unit, Leg>
reach.source($U(), [A, D]) :- leg_start(A, D).
reach.edge($U(), [A, D], [A2, D2]) :- toward(A, D, A2, D2).

// The legs whose walk goes on to a last leg.
.init arrive = Propagation<Unit, Leg>
arrive.source($U(), [A, D]) :- leg_goal(A, D).
arrive.edge($U(), [A2, D2], [A, D]) :- toward(A, D, A2, D2).

// A leg the walker reaches from the source, whose walk goes on to arrive.
on_path(A, D, $Toward()) :- reach.reached($U(), [A, D]), arrive.reached($U(), [A, D]).

// --- $Jog ---

on_path(A, D, $Jog()) :-
    leg_start(A1, D1),                                        // out
    halt(A1, D1, A2), perp_dir(D1, D2),                       // link
    halt(A2, D2, A3), perp_dir(D2, D3),                       // in
    leg_goal(A3, D3),                                         // halts at the target
    params.target(Col), stub_dir(Col, _, D3),                 // along the target's line
    ( A = A1, D = D1 ; A = A2, D = D2 ; A = A3, D = D3 ).
