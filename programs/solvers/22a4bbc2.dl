// 22a4bbc2
// @keywords: lines objects rank
// output: A stack of one-color bars fills the grid; every third bar down the
//  stack, the first included, recolors to the mark color.

// what a bar is
.type Choice =
    // a maximal band of same-color rows
    Run {}
    // a connected component of one color
  | Object {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(2).

    // Counting edge: ranks run from this edge; its axis stacks the bars.
    .decl dir(d: Dir) dir(DIR_T).

    // The mark pattern along the bar sequence: mark_len marked bars,
    // then mark_gap unmarked, repeating.
    .decl mark_len(n: number) mark_len(1).
    .decl mark_gap(n: number) mark_gap(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Run()). impl_choice($Object()).

// --- $Run segmentation ---

// A cell's row — the axis-only position along the stacking axis.
.decl cell_row(p: Position, r: Position)
cell_row(P, R) :- in(P, _), params.dir(D), axis_of(D, A), split(P, A, R, _).

// Every row of the stack.
.decl row(r: Position)
row(R) :- cell_row(_, R).

// Ink cells by their row.
.decl row_cell(r: Position, p: Position)
row_cell(R, P) :- cell_row(P, R), in(P, Col), !params.bg(Col).

.decl row_color(r: Position, col: Color)
row_color(R, Col) :- row_cell(R, P), in(P, Col).

// A run's top row: no same-colored row toward the counting edge.
.decl boundary(r: Position)
boundary(R) :-
    row_color(R, Col),
    params.dir(D), neighbor(R, D, R2),                    // row toward the edge
    !row_color(R2, Col).

// Rows of the run each boundary starts: it carries on away from the counting
// edge until the next boundary or a row with no ink.
.init run_of = Ray<Unit>
run_of.dir($U(), O) :- params.dir(D), opposite(D, O).
run_of.cell($U(), R) :- row(R).
run_of.mark($U(), R) :- boundary(R).
run_of.blocked($U(), R) :- row(R), ( boundary(R) ; !row_cell(R, _) ).

// --- $Object segmentation ---

.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col), !params.bg(Col).

.init obj_box = Bbox<Ident>
obj_box.cell(Id, P) :- comps.label(_, P, Id).

// The object's margin from the counting edge.
.decl obj_margin(id: Ident, k: number)
obj_margin(Id, K) :- params.dir(D), obj_box.box(Id, B), dist(B, D, K).

// --- shared: rank the bars, select marked ranks ---

.init seq = Ordinal<Choice>
seq.idx_set($Run(), K)    :- boundary(R), params.dir(D), dist(R, D, K).
seq.idx_set($Object(), K) :- obj_margin(_, K).

.decl mark_margin(ch: Choice, k: number)
mark_margin(Ch, K) :-
    seq.rank(Ch, K, R),
    params.mark_len(N), params.mark_gap(G), stride(R, N, G, _, _).  // in a marked block

.decl mark_cell(ch: Choice, p: Position)
mark_cell($Run(), P) :-
    mark_margin($Run(), K), params.dir(D), boundary(R_top), dist(R_top, D, K),  // marked run
    run_of.clear($U(), R, _, _, R_top), row_cell(R, P).
mark_cell($Object(), P) :-
    mark_margin($Object(), K), obj_margin(Id, K), comps.label(_, P, Id).

out(P, Col, Ch) :- mark_cell(Ch, P), params.mark(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !mark_cell(Ch, P).
