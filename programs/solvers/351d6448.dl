// 351d6448
// @draft
// @keywords: decompose induce move
// @scene panels: full lines of params.divider_color, params.divider_width
//  wide, cut the grid along the axis of params.time_dir into
//  params.panel_count panels of one size, and no line inside a panel is full
//  of that color; the panels are the frames of an animation, in time order
//  toward params.time_dir
// @scene steady-step: the frames show one motion of a kind the steps between
//  them demonstrate, toward the side and by the count of cells that every
//  step advances the front of its recolorings: the frame's content
//  translating, with the one color of the frame's back edge entering behind
//  it; each run of a recoloring's new color growing from its end over the
//  color the recoloring replaces; or the front of each recoloring's new color
//  advancing over the color it replaces; the frames show at least two steps
// @rule next-frame: the output is the last frame with the motion made once
//  more; undefined where the steps advance no front by one count, or where no
//  motion matches every step

// what the frames show
.type Reading =
    // @claim steady-step
    ObjectMotion {}
    // @scene steady-step: each frame is the one before it with one change
    //  applied: the change from the first frame to the second, moved a fixed
    //  count of cells across the time axis, toward one end, once per frame;
    //  moved, the change recolors a cell only where the cell holds the color it
    //  recolors from
    // @rule next-frame: the output is the last frame with the change moved one
    //  step further and applied once more; undefined where no frame changes, or
    //  where two steps that every frame follows disagree on it
    // @witness front-start: ordinary concept
  | FirstChange {}

// which steps the step is checked against
.type StepCheck =
    // @claim steady-step
    EveryStep {}
    // @scene steady-step: the motion and its count are the ones the first two
    //  steps demonstrate, and the later frames are not checked
    // @witness uneven-steps: foreign $StepFromFirstTwo
    //     @relaxed steady-step
  | StepFromFirstTwo {}

// what the step is read over
.type StepScope =
    // @claim steady-step
    WholePanel {}
    // @scene steady-step: each line across the time axis has its own motion
    //  and its own count; a line that no step recolors stays as it is
    // @witness two-speeds: variant $StepPerLine
    //     @relaxed steady-step
  | StepPerLine {}

// where the divider width comes from
.type DividerWidth =
    // @claim panels
    StoredWidth {}
    // @scene panels: the dividers are as wide as the runs of full lines of
    //  the divider color; undefined where the runs differ in width
    // @witness divider-2-wide: variant $DividerWidthFromLines
    //     @relaxed panels
  | DividerWidthFromLines {}

// where the panel count comes from
.type PanelCount =
    // @claim panels
    StoredCount {}
    // @scene panels: the full lines of the divider color cut the grid into
    //  any count of panels of one size
    // @witness five-panels: variant $AnyPanelCount
    //     @relaxed panels
  | AnyPanelCount {}

.type Choice = [reading: Reading, check: StepCheck, scope: StepScope,
                width: DividerWidth, panels: PanelCount]

.decl out(p: Position, col: Color, ch: Choice, c: DemonstratedRule)

.decl reading_choice(r: Reading)
reading_choice($ObjectMotion()). reading_choice($FirstChange()).

.decl step_check_choice(ck: StepCheck)
step_check_choice($EveryStep()). step_check_choice($StepFromFirstTwo()).

.decl step_scope_choice(sc: StepScope)
step_scope_choice($WholePanel()). step_scope_choice($StepPerLine()).

.decl divider_width_choice(wb: DividerWidth)
divider_width_choice($StoredWidth()). divider_width_choice($DividerWidthFromLines()).

.decl panel_count_choice(nb: PanelCount)
panel_count_choice($StoredCount()). panel_count_choice($AnyPanelCount()).

// $ObjectMotion read per line fails Fit at test0, where the front of row 1
// stops at a 0 cell and shows no steady advance.
.decl impl_choice(ch: Choice)
impl_choice([R, Ck, Sc, Wb, Nb]) :-
    reading_choice(R), step_check_choice(Ck), step_scope_choice(Sc),
    divider_width_choice(Wb), panel_count_choice(Nb),
    ( R = $FirstChange() ; Sc = $WholePanel() ).

.comp Params {
    // @derive SharedColor: variant derived
    //     @relaxed panels
    // @ignore: derive VanishedColor — on one input it gives every color of the
    //  input, as SharedColor does, so its cases are equivalent to theirs
    .decl divider_color(c: Color) divider_color(5).

    // Time runs toward this edge, so the last frame sits on it.
    .decl time_dir(d: Dir) time_dir(DIR_B).

    // --- $StoredWidth ---
    // @ignore: derive SepThickness — subsumed by $DividerWidthFromLines: where
    //  the width it gives cuts the grid, it is the width of the full lines of
    //  the divider color, which $DividerWidthFromLines finds among every count
    // @ignore: derive TileDim — subsumed by $DividerWidthFromLines, for the
    //  same reason
    .decl divider_width(g: number) divider_width(1).

    // --- $StoredCount ---
    // @ignore: derive SepTileCount — subsumed by $AnyPanelCount: where the
    //  count it gives cuts the grid, it is the count the full lines of the
    //  divider color cut, which $AnyPanelCount finds among every count
    // @ignore: derive TileCount — subsumed by $AnyPanelCount, for the same
    //  reason
    .decl panel_count(n: number) panel_count(4).
}

.init params = Params

// The frames under one cut: time runs toward t, and lines of color c, g wide,
// cut the grid into n panels.
.type Frames = [t: Dir, c: Color, g: number, n: number]

// A step's motion read over one scope of the frames.
.type MotionKey = [k: Frames, ck: StepCheck, sc: StepScope, s: Position]

// The motions a step between frames may show.
.type DemonstratedChoice = Translate {} | Extend {} | Advance {}

// The inner task and the rule each fact of `out` is derived at.
.type DemonstratedRule = [task: MotionKey, rule: DemonstratedChoice]

// @ignore: store — the stored counts are those admitted takes on the
//  pairs' frame: a count past a grid's extent cuts nothing, and a count a
//  larger grid needs is missing only where the case is undefined, so the case
//  that derives them subsumes it
.decl width_read(wb: DividerWidth, g: number)

// @ignore: store — the stored counts are those admitted takes on the
//  pairs' frame: a count past a grid's extent cuts nothing, and a count a
//  larger grid needs is missing only where the case is undefined, so the case
//  that derives them subsumes it
.decl count_read(nb: PanelCount, n: number)

// The frames each reading of the cut takes.
.decl frames_of(wb: DividerWidth, nb: PanelCount, k: Frames)
frames_of(Wb, Nb, [T, C, G, N]) :-
    params.time_dir(T), axis_of(T, A),
    params.divider_color(C), width_read(Wb, G), count_read(Nb, N),
    valid_cut(A, C, G, N).

// The side each step moves toward.
// @store: variant stored
//     @relaxed steady-step
.decl step_dir(r: Reading, ck: StepCheck, sc: StepScope, d: Dir)

// Each reading's next frame.
// @ignore: head-repeat — the rule column holds the inner task the motion is
//  read in, which holds nil where a reading reads no motion
.decl result(r: Reading, ck: StepCheck, sc: StepScope, k: Frames, c: DemonstratedRule,
              p_intile: Position, col: Color)

// The cuts a grid admits, the frames each cut gives, the motion the steps
// between them show, and the first change moved by each step the frames
// follow.

// A count of cells the grid admits.
.decl admitted(n: number)
admitted(N) :- in(P, _), dir_elem(D), dist(P, D, N), N > 0.

.type Line = [a: Axis, l: Position]

// The color of a line all of one color.
// @claim panels
.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

// A line inside a panel when dividers g wide cut the grid along axis a
// into n panels.
.decl panel_line(a: Axis, g: number, n: number, l: Position)
panel_line(A, G, N, L) :-
    line_color.item([A, L], _), admitted(G), admitted(N),
    divide_slab(L, A, N, G, _, _).

// A cut whose dividers are not the full lines of color c.
.decl cut_defect(a: Axis, c: Color, g: number, n: number)
cut_defect(A, C, G, N) :-
    panel_line(A, G, N, _), in(_, C), line_color.item([A, L], _),
    ( !panel_line(A, G, N, L), !line_color.value([A, L], C)  // a divider line not full of c
    ; panel_line(A, G, N, L), line_color.value([A, L], C)    // a full line inside a panel
    ).

// @store: variant stored
//     @relaxed panels
// @ignore: store $DividerWidthFromLines — the stored cut fixes the width,
//  so these cases are equivalent to those that take $StoredWidth
// @ignore: store $AnyPanelCount — the stored cut fixes the count, so these
//  cases are equivalent to those that take $StoredCount
// @ignore: store divider_color=SharedColor — the stored cut fixes the
//  color, so these cases are equivalent to those that store it
.decl valid_cut(a: Axis, c: Color, g: number, n: number)
valid_cut(A, C, G, N) :-
    panel_line(A, G, N, _),
    line_color.item([A, L], _), !panel_line(A, G, N, L),     // the cut has a divider
    in(_, C), !cut_defect(A, C, G, N).

.decl panel(k: Frames, p_tile: Position, p_intile: Position, col: Color)
panel([T, C, G, N], P_tile, P_intile, Col) :-
    frames_of(_, _, [T, C, G, N]), axis_of(T, A),
    in(P_grid, Col), divide_slab(P_grid, A, N, G, P_tile, P_intile).

.decl succ_panel(k: Frames, p_tile: Position, p_tile2: Position)
succ_panel([T, C, G, N], P_tile, P_tile2) :-
    panel([T, C, G, N], P_tile, _, _), neighbor(P_tile, T, P_tile2),
    panel([T, C, G, N], P_tile2, _, _).

.decl first_step(k: Frames, p_tile: Position)
first_step(K, P_tile) :- succ_panel(K, P_tile, _), !succ_panel(K, _, P_tile).

.decl last_frame(k: Frames, p_tile: Position)
last_frame(K, P_tile) :- succ_panel(K, _, P_tile), !succ_panel(K, P_tile, _).

// A cell the next frame recolors.
.decl change(k: Frames, p_tile: Position, p_intile: Position, from: Color, to: Color)
change(K, P_tile, P_intile, Col, Col2) :-
    succ_panel(K, P_tile, P_tile2),
    panel(K, P_tile, P_intile, Col), panel(K, P_tile2, P_intile, Col2), Col != Col2.

// The steps whose changes a check compares.
// @ignore: store — stored tiles of the pairs' four panels: on four panels
//  they are the derived ones, and on another count they name tiles the
//  grid lacks, so the base subsumes the case
.decl checked(k: Frames, ck: StepCheck, p_tile: Position)

// The scope s a cell's step is read over.
// @ignore: store — the stored cells are those of the pairs' panels: on
//  panels of that frame they are the derived ones, and on others they name
//  cells the panels lack, so the base subsumes the case
// @ignore: head-zero — under $WholePanel the scope is the whole panel,
//  and its key splits the cell along no axis: ZERO is the absence of the
//  line $StepPerLine keys on, and the readers join on it as a key alone
.decl scope(k: Frames, sc: StepScope, p_intile: Position, s: Position)

// --- $EveryStep ---
checked(K, $EveryStep(), P_tile) :- succ_panel(K, P_tile, _).

// --- $StepFromFirstTwo ---
checked(K, $StepFromFirstTwo(), P_tile) :- first_step(K, P_tile).
checked(K, $StepFromFirstTwo(), P_tile2) :-
    first_step(K, P_tile), succ_panel(K, P_tile, P_tile2), succ_panel(K, P_tile2, _).

// --- $WholePanel ---
scope(K, $WholePanel(), P_intile, ZERO) :- panel(K, _, P_intile, _).

// --- $StepPerLine ---
scope([T, C, G, N], $StepPerLine(), P_intile, S) :-
    panel([T, C, G, N], _, P_intile, _), axis_of(T, A), split(P_intile, A, S, _).

// --- $ObjectMotion ---

// A recoloring's runs in one frame of a motion.
.type RunKey = [mo: MotionKey, p_tile: Position, from: Color, to: Color]

// A cell of a step's recolorings with another cell of them in its scope
// nearer edge d.
.decl change_behind(k: Frames, sc: StepScope, p_tile: Position, d: Dir,
                    p_intile: Position)
change_behind(K, Sc, P_tile, D, P) :-
    change(K, P_tile, P, _, _), scope(K, Sc, P, S),
    change(K, P_tile, Q, _, _), scope(K, Sc, Q, S),
    dir_elem(D), nearer(D, Q, P).

// The front of a step's recolorings toward d: its cells nearest edge d.
.decl change_front(k: Frames, sc: StepScope, p_tile: Position, d: Dir,
                   p_intile: Position)
change_front(K, Sc, P_tile, D, P) :-
    change(K, P_tile, P, _, _), scope(K, Sc, P, _), dir_elem(D),
    !change_behind(K, Sc, P_tile, D, P).

// The front of the recolorings in scope s advances j cells toward d from
// this step to the next.
// @ignore: store — the stored side is the motion's, which step_dir=stored
//  stores, and the stored tiles are the pairs' four panels, so the case is
//  equivalent to that one or subsumed by its base
.decl front_shift(k: Frames, sc: StepScope, s: Position, p_tile: Position, d: Dir,
                  j: number)
front_shift(K, Sc, S, P_tile, D, J) :-
    succ_panel(K, P_tile, P_tile2),
    change_front(K, Sc, P_tile, D, P), scope(K, Sc, P, S),
    change_front(K, Sc, P_tile2, D, P2), scope(K, Sc, P2, S),
    panel(K, _, Q, _), dist(Q, D, J), J > 0,                  // a count the frame admits
    jump(P, D, J, P_far), same_dist(D, P_far, P2).

// A checked step whose next step does not advance the front by j toward d.
.decl shift_defect(k: Frames, ck: StepCheck, sc: StepScope, s: Position, d: Dir,
                   j: number)
shift_defect(K, Ck, Sc, S, D, J) :-
    front_shift(K, Sc, S, _, D, J),
    checked(K, Ck, P_tile), succ_panel(K, P_tile, P_tile2), checked(K, Ck, P_tile2),
    !front_shift(K, Sc, S, P_tile, D, J).

// Every checked step advances the front of the recolorings in scope s by j
// cells toward d.
// @ignore: store — the stored side is the motion's, which step_dir=stored
//  stores, so the case is equivalent to that one
.decl front_step(k: Frames, ck: StepCheck, sc: StepScope, s: Position, d: Dir,
                 j: number)
front_step(K, Ck, Sc, S, D, J) :-
    front_shift(K, Sc, S, _, D, J), checked(K, Ck, _),
    !shift_defect(K, Ck, Sc, S, D, J).

// The motion's side and count.
// @ignore: store — the stored side is the motion's, which step_dir=stored
//  stores, so the case is equivalent to that one
.decl shift(m: MotionKey, d: Dir, j: number)
shift([K, Ck, Sc, S], D, J) :- front_step(K, Ck, Sc, S, D, J), step_dir($ObjectMotion(), Ck, Sc, D).

// A cell of the motion's scope in a frame.
.decl motion_cell(m: MotionKey, p_tile: Position, p_intile: Position, col: Color)
motion_cell([K, Ck, Sc, S], P_tile, P_intile, Col) :-
    shift([K, Ck, Sc, S], _, _), panel(K, P_tile, P_intile, Col),
    scope(K, Sc, P_intile, S).

// A recoloring some step of the scope shows.
.decl recoloring(m: MotionKey, from: Color, to: Color)
recoloring([K, Ck, Sc, S], Col, Col2) :-
    shift([K, Ck, Sc, S], _, _), change(K, _, P_intile, Col, Col2),
    scope(K, Sc, P_intile, S).

// @claim steady-step next-frame
// @ignore consistent: store — the stored pairs are the pairs' four panels in
//  time order: on four panels they are the derived ones, and on another
//  count they name tiles the grid lacks, so the base subsumes the case
// @ignore demonstration: store — the stored pairs are the pairs' four panels
//  in time order: on four panels they are the derived ones, and on another
//  count they name tiles the grid lacks, so the base subsumes the case
.init catalog = DemonstrationConsistency<MotionKey, DemonstratedChoice, Position, Position, Color>
catalog.value(M, P_tile, P_intile, Col) :- motion_cell(M, P_tile, P_intile, Col).
catalog.demonstration([K, Ck, Sc, S], P_tile, P_tile2) :-
    shift([K, Ck, Sc, S], _, _), checked(K, Ck, P_tile), succ_panel(K, P_tile, P_tile2).

// A frame whose back edge, the edge the motion leaves, holds more than one
// color.
.decl back_mixed(m: MotionKey, p_tile: Position)
back_mixed(M, P_tile) :-
    shift(M, D, _), opposite(D, D_back),
    motion_cell(M, P_tile, P, Col), dist(P, D_back, 0),
    motion_cell(M, P_tile, Q, Col2), dist(Q, D_back, 0), Col != Col2.

// The ground: the one color of a frame's back edge.
// @ignore: store — the stored tiles are the pairs' four panels: on four
//  panels they are the derived ones, and on another count they name tiles
//  the grid lacks, so the base subsumes the case
.decl back_ground(m: MotionKey, p_tile: Position, col: Color)
back_ground(M, P_tile, Col) :-
    shift(M, D, _), opposite(D, D_back),
    motion_cell(M, P_tile, P, Col), dist(P, D_back, 0), !back_mixed(M, P_tile).

// The frame's content moves j cells toward d, and the ground enters behind
// it.
catalog.prediction(M, $Translate(), P_tile, Q, Col) :-
    shift(M, D, J), motion_cell(M, P_tile, Q, _),
    opposite(D, D_back), jump(Q, D_back, J, P),                       // the cell that moves onto q
    ( motion_cell(M, P_tile, P, Col)                              // a frame cell moves onto q
    ; !motion_cell(M, P_tile, P, _), back_ground(M, P_tile, Col)  // ground enters onto q
    ).

// The cells of a recoloring's new color cast toward d over the color it
// replaces.
// @claim next-frame
// @ignore cell: store — the stored cells are those of the pairs' panels, so
//  the base subsumes the case, as for scope
// @ignore dir: store — the stored side is the motion's, which step_dir=stored
//  stores, so the case is equivalent to that one
// @ignore clear: store — the stored side is the motion's, which
//  step_dir=stored stores, so the case is equivalent to that one
.init run = Ray<RunKey>
run.dir([M, P_tile, Col, Col2], D) :-
    shift(M, D, _), recoloring(M, Col, Col2), motion_cell(M, P_tile, _, _).
run.cell([M, P_tile, Col, Col2], P) :-
    recoloring(M, Col, Col2), motion_cell(M, P_tile, P, _).
run.mark([M, P_tile, Col, Col2], P) :-
    recoloring(M, Col, Col2), motion_cell(M, P_tile, P, Col2).
run.blocked([M, P_tile, Col, Col2], P) :-
    recoloring(M, Col, Col2), motion_cell(M, P_tile, P, Col3), Col3 != Col.

// A cell that a run of a recoloring's new color reaches within j cells
// toward d.
.decl run_reach(m: MotionKey, p_tile: Position, p_intile: Position, col: Color)
run_reach(M, P_tile, Q, Col2) :-
    shift(M, D, J), run.clear([M, P_tile, _, Col2], Q, D, J2, _), J2 > 0, J2 <= J.

// Each run of a recoloring's new color grows j cells from its end toward
// d, over the color the recoloring replaces.
catalog.prediction(M, $Extend(), P_tile, Q, Col) :-
    motion_cell(M, P_tile, Q, Col0),
    ( run_reach(M, P_tile, Q, Col)                                // a run grows over q
    ; Col = Col0, !run_reach(M, P_tile, Q, _)                     // no run reaches q
    ).

// q lies level with or behind some cell of a recoloring's new color, seen
// from side d.
.decl behind_front(m: MotionKey, p_tile: Position, col: Color, p_intile: Position)
behind_front(M, P_tile, Col2, Q) :-
    shift(M, D, _), recoloring(M, _, Col2),
    motion_cell(M, P_tile, P, Col2), motion_cell(M, P_tile, Q, _), !nearer(D, Q, P).

// A cell of a recoloring's replaced color past the front of its new color
// toward d, within j lines of it: the front advances over it.
.decl advance(m: MotionKey, p_tile: Position, p_intile: Position, col: Color)
advance(M, P_tile, Q, Col2) :-
    shift(M, D, J), recoloring(M, Col, Col2),
    motion_cell(M, P_tile, P, Col2), jump(P, D, J, P_far),
    motion_cell(M, P_tile, Q, Col), !nearer(D, Q, P_far),         // within j lines of a cell of col2
    !behind_front(M, P_tile, Col2, Q).                            // past every cell of col2

// The front of each recoloring's new color advances j lines toward d over
// the color the recoloring replaces.
catalog.prediction(M, $Advance(), P_tile, Q, Col) :-
    motion_cell(M, P_tile, Q, Col0),
    ( advance(M, P_tile, Q, Col)                                  // a front reaches q
    ; Col = Col0, !advance(M, P_tile, Q, _)                       // no front reaches q
    ).

// The last frame with each motion that every demonstrated step shows
// made once more.
.decl motion_next(m: MotionKey, c: DemonstratedChoice, p_intile: Position, col: Color)
motion_next([K, Ck, Sc, S], C, P_intile, Col) :-
    catalog.confirmed([K, Ck, Sc, S], C),
    catalog.prediction([K, Ck, Sc, S], C, P_tile, P_intile, Col), last_frame(K, P_tile).

// --- $FirstChange ---

// A step of j cells toward d, across the time axis, that the first change
// may move by; the frames show at least two steps.
.decl motion(k: Frames, d: Dir, j: number)
motion([T, C, G, N], D, J) :-
    first_step([T, C, G, N], P_tile), change([T, C, G, N], P_tile, _, _, _),
    succ_panel([T, C, G, N], P_tile, P_tile2), succ_panel([T, C, G, N], P_tile2, _),
    perp_dir(T, D), panel([T, C, G, N], _, Q, _), dist(Q, D, J), J > 0.

// A frame, i frames after the first step's.
.decl frame_index(k: Frames, p_tile: Position, i: number)
frame_index([T, C, G, N], P_tile, I) :-
    first_step([T, C, G, N], P_tile0), panel([T, C, G, N], P_tile, _, _),
    relative(P_tile0, P_tile, R), opposite(T, O), dist(R, O, I), I >= 0.

// The first change, moved j cells toward d once per frame.
.decl placed(k: Frames, d: Dir, j: number, p_tile: Position, p_intile: Position,
             from: Color, to: Color)
placed(K, D, J, P_tile, Q, Col, Col2) :-
    motion(K, D, J), first_step(K, P_tile0), change(K, P_tile0, P, Col, Col2),
    frame_index(K, P_tile, I), panel(K, P_tile, Q, _),
    relative(P, Q, R), perp_dir(D, D_across), dist(R, D_across, 0),  // on the change's line
    opposite(D, O), dist(R, O, Tq), stride(Tq, J, 0, I, 0).           // i steps of j toward d

// The moved change recolors a cell that holds the color it recolors from.
.decl paint(k: Frames, d: Dir, j: number, p_tile: Position, p_intile: Position,
            col: Color)
paint(K, D, J, P_tile, P_intile, Col2) :-
    placed(K, D, J, P_tile, P_intile, Col, Col2), panel(K, P_tile, P_intile, Col).

// A cell where a step's change is not the moved first change.
.decl defect(k: Frames, d: Dir, j: number, p_tile: Position, p_intile: Position)
defect(K, D, J, P_tile, P_intile) :-
    paint(K, D, J, P_tile, P_intile, Col), !change(K, P_tile, P_intile, _, Col).
defect(K, D, J, P_tile, P_intile) :-
    change(K, P_tile, P_intile, _, Col), motion(K, D, J), frame_index(K, P_tile, _),
    !paint(K, D, J, P_tile, P_intile, Col).

.decl refuted(k: Frames, ck: StepCheck, sc: StepScope, s: Position, d: Dir, j: number)
refuted(K, Ck, Sc, S, D, J) :-
    defect(K, D, J, P_tile, P_intile), checked(K, Ck, P_tile),
    scope(K, Sc, P_intile, S).

// The last frame with the change moved by a step every checked frame of
// the scope follows, the step's side kept.
.decl next_frame(k: Frames, ck: StepCheck, sc: StepScope, d: Dir, p_intile: Position,
                 col: Color)
next_frame(K, Ck, Sc, D, P_intile, Col) :-
    last_frame(K, P_tile), panel(K, P_tile, P_intile, Col0),
    scope(K, Sc, P_intile, S), checked(K, Ck, _),
    motion(K, D, J), !refuted(K, Ck, Sc, S, D, J),
    ( paint(K, D, J, P_tile, P_intile, Col)                // the moved change recolors it
    ; Col = Col0, !paint(K, D, J, P_tile, P_intile, _)     // the moved change passes it by
    ).

out(P_intile, Col, [R, Ck, Sc, Wb, Nb], C) :-
    frames_of(Wb, Nb, K), result(R, Ck, Sc, K, C, P_intile, Col).

// --- $StoredWidth ---
width_read($StoredWidth(), G) :- params.divider_width(G).

// --- $DividerWidthFromLines ---
width_read($DividerWidthFromLines(), G) :- admitted(G).

// --- $StoredCount ---
count_read($StoredCount(), N) :- params.panel_count(N).

// --- $AnyPanelCount ---
count_read($AnyPanelCount(), N) :- admitted(N).

// --- $ObjectMotion ---
step_dir($ObjectMotion(), Ck, Sc, D) :- front_step(_, Ck, Sc, _, D, _).

result($ObjectMotion(), Ck, Sc, K, [[K, Ck, Sc, S], C], P_intile, Col) :-
    motion_next([K, Ck, Sc, S], C, P_intile, Col).

// --- $FirstChange ---
step_dir($FirstChange(), Ck, Sc, D) :- next_frame(_, Ck, Sc, D, _, _).

result($FirstChange(), Ck, Sc, K, nil, P_intile, Col) :-
    next_frame(K, Ck, Sc, D, P_intile, Col), step_dir($FirstChange(), Ck, Sc, D).

.comp Determine {
    // A count of cells an example's input admits.
    .decl admitted(e: Example, n: number)
    admitted(E, N) :- ex_in(E, P, _), dir_elem(D), dist(P, D, N), N > 0.

    .type ExampleLine = [e: Example, a: Axis, l: Position]

    // The color of an input line all of one color.
    .init line_color = Unanimous<ExampleLine, Color>
    line_color.item([E, A, L], Col) :- ex_in(E, P, Col), axis_elem(A), split(P, A, L, _).

    // A line inside a panel when dividers g wide cut an example's input
    // along the time axis into n panels.
    .decl panel_line(e: Example, a: Axis, g: number, n: number, l: Position)
    panel_line(E, A, G, N, L) :-
        params.time_dir(T), axis_of(T, A),
        line_color.item([E, A, L], _), admitted(E, G), admitted(E, N),
        divide_slab(L, A, N, G, _, _).

    // A cut whose dividers are not the full lines of color c.
    .decl cut_defect(e: Example, c: Color, g: number, n: number)
    cut_defect(E, C, G, N) :-
        panel_line(E, A, G, N, _), ex_in(E, _, C), line_color.item([E, A, L], _),
        ( !panel_line(E, A, G, N, L), !line_color.value([E, A, L], C)  // a divider line not full of c
        ; panel_line(E, A, G, N, L), line_color.value([E, A, L], C)    // a full line inside a panel
        ).

    // The full lines of color c cut the example's input into panels.
    .decl cut(e: Example, c: Color)
    cut(E, C) :-
        panel_line(E, A, G, N, _),
        line_color.item([E, A, L], _), !panel_line(E, A, G, N, L),   // the cut has a divider
        ex_in(E, _, C), !cut_defect(E, C, G, N).

    // A train input whose full lines of color c cut it into no panels.
    .decl uncut(c: Color)
    uncut(C) :- cut(_, C), ex_out(E, _, _), !cut(E, C).

    // The color whose full lines cut every train input into panels.
    .decl divider_color(c: Color)
    divider_color(C) :- cut(E, C), ex_out(E, _, _), !uncut(C).
}
