// 760b3cac
// @draft
// @keywords: decompose markers d4
// input: The grid divides into square tiles: one holds a pattern, and the
//  marker tile sits beside it.
// output: The pattern reflects across a tile edge into the neighbor tile on
//  the side the marker points to.

// how the marker's pointing direction is read
.type Choice =
    // the marker cell at a corner of its tile points to that corner's side
    Corner {}
    // the marker cell on the edge facing the pattern leans to a side of the
    // marker cell on the far edge
  | Lean {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl pattern(col: Color) pattern(8).
    .decl marker(col: Color) marker(4).
    .decl tile_dim(k: number) tile_dim(3).

    // --- $Corner ---
    // The axis the marker's corner points along.
    .decl axis(a: Axis) axis(AXIS_H).

    // --- $Lean ---
    // The direction from the marker tile toward the pattern tile.
    .decl facing(d: Dir) facing(DIR_T).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Corner()). impl_choice($Lean()).

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // @input

    .decl tile(key: Key, p_grid: Position, p_tile: Position, p_intile: Position)
    tile(Ky, P_grid, P_tile, P_intile) :-
        cell(Ky, P_grid, _), params.tile_dim(K), divide_by_size_2d(P_grid, K, 0, P_tile, P_intile).

    .decl pattern_tile(key: Key, p_tile: Position)
    pattern_tile(Ky, P_tile) :-
        cell(Ky, P_grid, Col), params.pattern(Col), tile(Ky, P_grid, P_tile, _).

    // A marker cell, with its tile and its place in that tile.
    .decl marker_cell(key: Key, p_tile: Position, p_intile: Position)
    marker_cell(Ky, P_tile, P_intile) :-
        cell(Ky, P_grid, Col), params.marker(Col), tile(Ky, P_grid, P_tile, P_intile).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl dir(ch: Choice, d: Dir)

// --- $Corner ---
dir($Corner(), D) :-
    parse.marker_cell($U(), _, P_intile), corner_dist(P_intile, Diag, 0),  // marker cell at a tile corner
    params.axis(A), dir_of(Diag, A, D).                                    // that corner's side on the axis

// --- $Lean ---
dir($Lean(), D) :-
    params.facing(D_near), dist(P_near, D_near, 0), parse.marker_cell($U(), _, P_near),  // on the facing edge
    opposite(D_near, D_far), dist(P_far, D_far, 0), parse.marker_cell($U(), _, P_far),   // on the far edge
    perp_dir(D_near, D), nearer(D, P_near, P_far).                                       // leans to side d

// --- output ---
// A cell of the neighbor tile on side d and its reflection in the pattern tile.
.decl mirror(ch: Choice, p_grid: Position, q_grid: Position)
mirror(Ch, P_grid, Q_grid) :-
    dir(Ch, D), parse.pattern_tile($U(), T_pat), neighbor(T_pat, D, T_out),
    parse.tile($U(), P_grid, T_out, P_intile),
    axis_of(D, A), flip_of(A, F), apply(F, P_intile, Q_intile),  // flip across the crossed edge
    concat_2d(T_pat, Q_intile, 0, Q_grid).

out(P_grid, Col, Ch) :-
    impl_choice(Ch),
    ( !mirror(Ch, P_grid, _), in(P_grid, Col)      // outside the reflection
    ; mirror(Ch, P_grid, Q_grid), in(Q_grid, Col)  // reflected pattern cell
    ).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl facing(d: Dir)
    facing(D) :-
        parse.marker_cell(E, T_mark, _), parse.pattern_tile(E, T_pat),
        dir_elem(D), neighbor(T_mark, D, T_pat).    // the pattern tile lies toward d
}
