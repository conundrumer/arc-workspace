// 689c358e
// @draft
// @keywords: objects markers cast perimeter
// input: A border ring encloses a bg canvas holding crosses, one per color.
//  Each cross has a long bar and a short bar, and the short bar crosses the
//  long one off its middle.
// output: On the long bar's line, the grid edge cell on one side takes the
//  cross's color, and the one on the other side takes the far color.
// review principle: Cases — a third reading of the side the cross's color
//  goes to was dropped for claiming the same cast concept as Nearer and
//  Pointer, so re-judge it as a case under Fit, Fidelity, and Equivalence.

// the side that takes the cross's color
.type Choice =
    // the grid edge the cross's box is nearer, along the long axis
    Nearer {}
    // the side of its own box the cross's center is displaced toward
  | Pointer {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(7).
    // The color the far edge cell takes.
    .decl far(c: Color) far(0).
}

.init params = Params

.decl cross_cell(c: Color, p: Position)
cross_cell(C, P) :- in(P, C), !params.bg(C), interior(P, ZERO).

.init bbox = Bbox<Color>
bbox.cell(C, P) :- cross_cell(C, P).

.init rim = Rim<Color>
rim.cell(C, P) :- cross_cell(C, P).

// The cell where the bars cross.
.decl center(c: Color, p: Position)
center(C, P) :- cross_cell(C, P), !rim.rim(C, P).

// The side the cross's color goes to.
.decl points(c: Color, d: Dir, ch: Choice)

// --- $Nearer ---
points(C, D, $Nearer()) :-
    bbox.cell(C, P), bbox.box(C, B),
    box_extent(B, P, A, N1), perp(A, A2), box_extent(B, P, A2, N2), N1 > N2,  // long axis
    axis_of(D, A), dist_pair(B, D, K1, K2), K1 < K2.       // the grid edge the box is nearer

// --- $Pointer ---
points(C, D, $Pointer()) :-
    center(C, P), bbox.box(C, B), crop(P, B, P_inner),
    dir_elem(D), dist_pair(P_inner, D, K1, K2), K1 < K2.

// --- output ---

.decl impl_choice(ch: Choice)
impl_choice($Nearer()).
impl_choice($Pointer()).

.decl mark(p: Position, col: Color, ch: Choice)
mark(P_edge, Col, Ch) :-
    points(C, D, Ch), center(C, P),                         // a cross and the side its color goes to
    axis_of(D, A), same_line(A, P, P_edge), in(P_edge, _),  // a cell of the long bar's line
    ( dist(P_edge, D, 0), Col = C                              // colored side
    ; opposite(D, Opp), dist(P_edge, Opp, 0), params.far(Col)  // far side
    ).

out(P, Col, Ch) :- mark(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !mark(P, _, Ch).
