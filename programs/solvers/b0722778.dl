// b0722778
// @draft
// @keywords: decompose crop induce d4 mapping rank
// @scene bands: rows of params.bg split the grid into bands; each band holds 3
//  square tiles of side 2, apart by columns of params.bg, and the tiles of all
//  bands stand in the same columns
// @scene change-kind: in each band, the second tile is the first tile moved
//  with its colors kept, or the first tile recolored cell by cell with its
//  pattern kept
// @scene recolor-domain: where a band's change is a recoloring, the third tile
//  uses only colors of the first tile
// @rule change: a band's changes are each rule that carries the first tile
//  onto the second: a move that the first tile's shape admits, a flip where
//  the first tile is a dot, one cell of a color the other three cells lack,
//  and a turn where it is two lines, two cells of each color with each color
//  on one row or one column, a first tile of another shape admitting no move;
//  or the recoloring that carries the first tile onto the second, cell by cell
// @rule output: the output is the columns of the tile nearest the edge
//  opposite params.read_from, with each band's tile changed by that band's
//  changes, one output per choice of one change in each band, and the params.bg
//  rows kept

// what a recoloring does with a third-tile color the first tile lacks
.type Choice =
    // @claim change recolor-domain
    UnmappedUndefined {}
    // @scene recolor-domain: dropped
    // @rule change: under a recoloring, a third-tile color that the first tile
    //  lacks keeps its color
    // @witness unmapped-color: borderline $KeepUnmapped
    //     @relaxed recolor-domain
  | KeepUnmapped {}

// The rules a band may demonstrate.
.type DemonstratedChoice = Move {d: D4} | Recolor {}

// A band, read under one case.
.type BandKey = [kind: Choice, bd: Position]

// A first-tile color under one recoloring rule of a band.
.type RuleColor = [k: BandKey, c: DemonstratedChoice, col: Color]

// The inner task and the rule each fact of `out` is derived at.
.type DemonstratedRule = [task: BandKey, rule: DemonstratedChoice]

// @ignore: head-repeat — the inner task is the band read under the case, as
//  the catalog's key gives it
.decl out(p: Position, col: Color, ch: Choice, r: DemonstratedRule)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed bands
    .decl bg(c: Color) bg(0).

    // The edge the first tile of a band is nearest.
    .decl read_from(d: Dir) read_from(DIR_L).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($UnmappedUndefined()). impl_choice($KeepUnmapped()).

// A line on axis a with a cell off the background.
.decl broken(a: Axis, l: Position)
broken(A, L) :- in(P, Col), !params.bg(Col), axis_elem(A), split(P, A, L, _).

// The rows and columns of the background cut the grid into tiles.
// @claim bands
.init panels = DividerTiles<Unit>
panels.cell($U(), P) :- in(P, _).
panels.divider($U(), A, L) :- in(P, _), axis_elem(A), split(P, A, L, _), !broken(A, L).

// The axis the tiles of a band run along.
.decl tile_axis(a: Axis)
tile_axis(A) :- params.read_from(D), axis_of(D, A).

// The line k cells from params.read_from lies in the tile column pc.
// @store: variant concept
.decl tile_column(k: number, pc: Position)
tile_column(K, Pc) :-
    panels.part_of($U(), P, A, Pc), tile_axis(A), params.read_from(D), dist(P, D, K).

// Cell p lies in the tile column pc.
.decl in_column(p: Position, pc: Position)
in_column(P, Pc) :- in(P, _), params.read_from(D), dist(P, D, K), tile_column(K, Pc).

// Cell p of the band bd lies in the tile column pc.
.decl placed(p: Position, bd: Position, pc: Position)
placed(P, Bd, Pc) :-
    in_column(P, Pc), tile_axis(A), perp(A, A2), panels.part_of($U(), P, A2, Bd).

// The tile columns, in order away from params.read_from.
// @claim bands
.init order = Order<Unit, Position>
order.elem($U(), Pc) :- tile_column(_, Pc).
order.before($U(), Pc1, Pc2) :-
    order.elem($U(), Pc1), order.elem($U(), Pc2), params.read_from(D), nearer(D, Pc1, Pc2).

// Each tile, keyed by its band and its column glued.
// @claim bands
.init tile_box = Bbox<Position>
tile_box.cell(T, P) :- placed(P, Bd, Pc), compose(Pc, Bd, T).

// Cell p of the tile in band bd and column pc, at q in the tile's frame.
.decl tile_cell(p: Position, bd: Position, pc: Position, q: Position, col: Color)
tile_cell(P, Bd, Pc, Q, Col) :-
    placed(P, Bd, Pc), compose(Pc, Bd, T), tile_box.box(T, B), crop(P, B, Q), in(P, Col).

// The columns of the third tile, which the output takes.
// @claim output
.init out_box = Bbox<Unit>
out_box.cell($U(), P) :- in_column(P, Pc), order.last($U(), Pc).

// The flips: across the midlines and across the diagonals.
.decl flip_move(d: D4)
flip_move(D) :- ( flip_of(_, D) ; diag_flip_of(_, D) ).

// Cell q of the first tile of band bd holds col.
.decl first_cell(bd: Position, q: Position, col: Color)
first_cell(Bd, Q, Col) :- order.first($U(), Pc), tile_cell(_, Bd, Pc, Q, Col).

// Cells q and q2 of the first tile of band bd share a color.
.decl twin(bd: Position, q: Position, q2: Position)
twin(Bd, Q, Q2) :- first_cell(Bd, Q, Col), first_cell(Bd, Q2, Col), Q != Q2.

// Twin cells q and q2 share a row or a column.
.decl aligned(bd: Position, q: Position, q2: Position)
aligned(Bd, Q, Q2) :- twin(Bd, Q, Q2), axis_elem(A), same_line(A, Q, Q2).

// The first tile of band bd is a dot: one of its cells holds a color the
// others lack.
.decl dot(bd: Position)
dot(Bd) :- first_cell(Bd, Q, _), !twin(Bd, Q, _).

// The first tile of band bd is not two lines: a cell with no twin, a twin
// off its row and column, or a cell with two twins.
.decl not_lines(bd: Position)
not_lines(Bd) :- dot(Bd).
not_lines(Bd) :- twin(Bd, Q, Q2), !aligned(Bd, Q, Q2).
not_lines(Bd) :- twin(Bd, Q, Q2), twin(Bd, Q, Q3), Q2 != Q3.

// Each band is an inner task: the first tile and the second are a
// demonstrated pair, and the third tile is left to complete.
// @claim change
// @ignore consistent: store — the stored rows carry the bands of the input
//  they are read from, which the other inputs lack, so its cases fail Fit
// @ignore demonstration: store — the stored rows carry the bands of the input
//  they are read from, which the other inputs lack, so its cases fail Fit
.init catalog = DemonstrationConsistency<BandKey, DemonstratedChoice, Position, Position, Color>
catalog.value([K, Bd], Pc, Q, Col) :-
    impl_choice(K), tile_cell(_, Bd, Pc, Q, Col).
catalog.demonstration([K, Bd], Pc1, Pc2) :-
    impl_choice(K), tile_cell(_, Bd, Pc1, _, _),
    order.first($U(), Pc1), order.next($U(), Pc1, Pc2).

// Each band's third tile under each rule the band confirms.
out(P_out, Col, K, [[K, Bd], C]) :-
    out_box.box($U(), B), crop(P, B, P_out),
    catalog.confirmed([K, Bd], C), order.last($U(), Pc),
    tile_cell(P, Bd, Pc, Q, _), catalog.prediction([K, Bd], C, Pc, Q, Col).

// The background rows.
out(P_out, Col, K, nil) :-
    out_box.box($U(), B), crop(P, B, P_out),
    impl_choice(K), tile_axis(A), perp(A, A2), panels.on_divider($U(), P, A2), params.bg(Col).

// The color each recoloring rule takes a first-tile color to; a color taken
// to two colors clashes.
// @claim change
.init recolor = Unanimous<RuleColor, Color>

// The tile moved by d, a move the shape of the band's first tile admits: a dot
// is flipped, and two lines are turned.
catalog.prediction([U, Bd], $Move(D), Pc, Q2, Col) :-
    catalog.value([U, Bd], Pc, Q, Col), apply(D, Q, Q2),
    ( dot(Bd), flip_move(D)
    ; !not_lines(Bd), first_cell(Bd, _, _),
      c4_elem(D), dir_elem(X), apply_dir(D, X, X2), X2 != X   // a turn
    ).

recolor.item([[U, Bd], $Recolor(), Col], Col2) :-
    catalog.demonstration([U, Bd], Pc1, Pc2),
    catalog.value([U, Bd], Pc1, Q, Col),
    catalog.value([U, Bd], Pc2, Q, Col2).

// The tile recolored cell by cell.
catalog.prediction([U, Bd], $Recolor(), Pc, Q, Col2) :-
    catalog.value([U, Bd], Pc, Q, Col),
    recolor.value([[U, Bd], $Recolor(), Col], Col2).

// --- $KeepUnmapped ---
catalog.prediction([$KeepUnmapped(), Bd], $Recolor(), Pc, Q, Col) :-
    catalog.value([$KeepUnmapped(), Bd], Pc, Q, Col),
    !recolor.item([[$KeepUnmapped(), Bd], $Recolor(), Col], _).
