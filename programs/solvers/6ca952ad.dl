// 6ca952ad
// @draft
// @keywords: objects move count
// output: Gravity on the heavy objects: an object of at least params.heavy
//  cells slides toward the params.grav edge and comes to rest where it first
//  meets the edge, a lighter object, or a heavy object at rest ahead of it; a
//  lighter object stays. Elsewhere background.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(7).
    .decl grav(d: Dir) grav(DIR_B).
    // Least cell count of an object that falls.
    .decl heavy(n: number) heavy(4).
}

.init params = Params

// --- objects ---

.init obj = Components<Unit>
obj.node($U(), P) :- in(P, Col), !params.bg(Col).

.init size = Tally<Ident, Position>
size.item(Id, P) :- obj.label($U(), P, Id).

.decl falls(id: Ident)
falls(Id) :- size.tally(Id, N), params.heavy(K), N >= K.

// --- the fall ---

.init fall = Gravity<Unit, Ident>
fall.cell($U(), Id, P) :- obj.label($U(), P, Id), falls(Id).
fall.dir($U(), D) :- params.grav(D).
fall.blocked($U(), P) :- obj.label($U(), P, Id), !falls(Id).  // a light object stays in place

.decl fallen(p: Position, col: Color)
fallen(Q, Col) :-
    in(P, Col), obj.label($U(), P, Id),
    ( fall.travel($U(), Id, Delta), compose(P, Delta, Q)  // heavy: at rest
    ; !falls(Id), Q = P                                    // light: stays
    ).

out(P, Col) :- fallen(P, Col).
out(P, Col) :- in(P, _), !fallen(P, _), params.bg(Col).
