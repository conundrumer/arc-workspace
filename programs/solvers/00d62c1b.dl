// 00d62c1b
// concept: objects enclose
// A bg cell that cannot reach the grid edge through bg cells is repainted
// c.fill; every other cell passes through.

#include "../lib.dl"

// Seeded connectivity: the 4-adjacency closure of the node set from the seeds.
// Staged lib component (proposals.md).
.comp Reach<Key> {
    .decl node(key: Key, p: Position)
    .decl seed(key: Key, p: Position)

    .decl reach(key: Key, p: Position)
    reach(Ky, P)  :- seed(Ky, P).
    reach(Ky, P2) :-
        reach(Ky, P), dir_elem(D), step_delta(D, S), compose(P, S, P2),
        node(Ky, P2).
}

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(4).
}

.init c = Consts

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), c.bg(Col).

.init outside = Reach<Unit>
outside.node($U(), P) :- bg_cell(P).
outside.seed($U(), P) :- bg_cell(P), dir_elem(D), dist(P, D, 0).   // on an edge

.decl enclosed(p: Position)
enclosed(P) :- bg_cell(P), !outside.reach($U(), P).

.decl out(p: Position, col: Color)
out(P, Col) :- enclosed(P), c.fill(Col).
out(P, Col) :- in(P, Col), !enclosed(P).
