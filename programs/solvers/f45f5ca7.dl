// f45f5ca7
// concept: markers move border
// Edge-column marks relocate along their lines: each color lands a fixed
// distance from the edge (8→1, 2→2, 4→3, 3→4); the rest is bg.
//
// out's choice column = [e, m]:
//
//   e (edge):
//     $Dir()  — c.dir names the edge
//     $Edge() — the edge every mark sits on
//
//   m (move):
//     $Jump() — displace the mark k cells away from the edge
//     $Seat() — seat the mark's line cell at dist k from the edge
//
// Pairs coincide here — every mark sits on the edge at dist 0.

#include "../lib.dl"

.type EdgeSrc = Dir {} | Edge {}
.type Move    = Jump {} | Seat {}
.type Choice  = [e: EdgeSrc, m: Move]

.comp Consts {
    .decl bg(c: Color) bg(0).

    // Landing distance from the edge, per mark color.
    .decl color_dist(c: Color, k: number)
    color_dist(8, 1). color_dist(2, 2). color_dist(4, 3). color_dist(3, 4).

    // --- $Dir ---
    .decl dir(d: Dir) dir(DIR_L).   // the mark edge
}

.init c = Consts

// --- parse ---

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)

    .decl ink(key: Key, p: Position, col: Color)
    ink(Ky, P, Col) :- cell(Ky, P, Col), !c.bg(Col).

    .decl off_edge(key: Key, d: Dir)
    off_edge(Ky, D) :- ink(Ky, P, _), dir_elem(D), dist(P, D, K), K != 0.

    .decl mark_edge(key: Key, d: Dir)
    mark_edge(Ky, D) :- ink(Ky, _, _), dir_elem(D), !off_edge(Ky, D).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- Edge cases ---

.decl edge(d: Dir, e: EdgeSrc)

// --- $Dir ---
edge(D, $Dir()) :- c.dir(D).

// --- $Edge ---
edge(D, $Edge()) :- parse.mark_edge($U(), D).

// --- Move cases ---

.decl moved(p: Position, col: Color, ch: Choice)

// --- $Jump ---
moved(P2, Col, [E, $Jump()]) :-
    parse.ink($U(), P, Col), edge(D, E),   // mark, the edge
    c.color_dist(Col, K),                  // its landing distance
    opposite(D, O), jump(P, O, K, P2).     // k cells away from the edge

// --- $Seat ---
moved(Q, Col, [E, $Seat()]) :-
    parse.ink($U(), P, Col), edge(D, E),   // mark, the edge
    c.color_dist(Col, K),                  // its landing distance
    in(Q, _), dist(Q, D, K),               // grid cell at dist k from the edge
    axis_of(D, A), same_line(A, P, Q).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice([$Dir(),  $Jump()]). impl_choice([$Dir(),  $Seat()]).
impl_choice([$Edge(), $Jump()]). impl_choice([$Edge(), $Seat()]).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- moved(P, Col, Ch).
out(P, Col, Ch) :-
    impl_choice(Ch), in(P, _),      // choice × cell
    !moved(P, _, Ch),               // no mark lands here
    c.bg(Col).

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl dir(d: Dir)
    dir(D) :- parse.mark_edge(_, D).

    .decl color_dist(c: Color, k: number)
    color_dist(Col, K) :-
        parse.ink(E, P, Col), dir(D),      // mark, the edge
        ex_out(E, Q, Col), dist(Q, D, K),  // its landing cell
        axis_of(D, A), same_line(A, P, Q).
}
