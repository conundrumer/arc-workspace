// 20a9e565
// @draft
// @keywords: objects markers crop induce wallpaper
// @scene growing-sequence: on a field of params.background, figures stand
//  one after another along one direction, each separated from the next by
//  params.background; each term grows from the one before it by the same
//  step, and the term colors repeat a cycle.
// @scene corner-marks: two 3-cell L marks of params.marker_color, one at each
//  of the top-left and bottom-right corners of a rectangle, the window; each
//  mark's corner cell is the window's corner cell, and the marks touch no
//  figure.
// @scene window-ahead: the window lies past the last shown term, across the
//  place where a later term of the continued sequence stands.
// @rule continue-sequence: the sequence goes on by whatever progression its
//  maker drew, as a person reads it from the shown terms.
//     @approximated: the sequence goes on past its last shown term; each new
//      term takes the growth, the spacing and the alignment that the shown
//      terms follow from one term to the next, and the next color of the
//      cycle. The growth is one of a catalog of five, the one every pair of
//      consecutive shown terms confirms.
//     @witness ring-sequence: ordinary other
// @rule crop-window: the output is the window, marks included in its extent;
//  each cell takes the color the continued sequence draws there, and
//  params.background where it draws nothing.

// which terms the output draws
.type Drawn =
    // @claim crop-window
    EveryTerm {}
    // @rule crop-window: only the terms past the last shown one are drawn
    // @witness new-terms-only: borderline concept
    //     @relaxed window-ahead
  | NewTermsOnly {}

// how far the window reaches
.type Extent =
    // @claim crop-window
    MarkBox {}
    // @rule crop-window: the window is the box of the marks' corner cells, the
    //  cells with a mark neighbor on both axes
    // @witness elbow-box: borderline $ElbowBox
    //     @relaxed corner-marks
  | ElbowBox {}

.type Choice = [drawn: Drawn, extent: Extent]

.decl out(p: Position, col: Color, ch: Choice, r: DemonstratedRule)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed growing-sequence
    .decl background(c: Color) background(0).

    // The color of the corner marks that frame the window.
    // @derive RarestColor: variant derived
    //     @relaxed corner-marks
    .decl marker_color(c: Color) marker_color(5).
}

.init params = Params

.decl drawn_choice(dr: Drawn)
drawn_choice($EveryTerm()). drawn_choice($NewTermsOnly()).

// The growths a term may show from one term to the next.
.type DemonstratedChoice =
    // The term stretches by a line at its front edge and at its side edge,
    // each new line a copy of the edge line.
    Stretch {side: Dir}
    // The term, periodic across the sequence, gains a period at its side end.
  | PeriodEnd {side: Dir}
    // The term, periodic across the sequence, reaches out at both ends to the
    // next line about which its periodic pattern is mirror symmetric.
  | MirrorEnds {}
    // At each end across the sequence, the term gains its end piece flipped
    // along the sequence and moved out past itself.
  | FlippedEnds {}
    // The term splits at its center line, each half moving one step deep and
    // out, under a new copy of its hook, the part that holds its back edge.
  | SplitStep {}

.type TermPair = [t: Ident, t2: Ident]
.type TermEdge = [t: Ident, e: Dir]
.type TermSide = [d: Dir, t: Ident, e: Dir]
.type TermRule = [d: Dir, c: DemonstratedChoice, t: Ident]
// The inner task, a direction of the sequence, and the rule each fact of
// `out` is derived at.
.type DemonstratedRule = [task: Dir, rule: DemonstratedChoice]
.type Grown = [d: Dir, c: DemonstratedChoice, i0: Position, i: Position]
.type Seat = [i: Position, p: Position]

// --- terms ---

// A cell of a figure: neither the field nor a mark.
.decl figure(p: Position, col: Color)
figure(P, Col) :- in(P, Col), !params.background(Col), !params.marker_color(Col).

// The terms: the figures, each a connected group of figure cells.
// @claim growing-sequence
.init term = Components8<Unit>
term.node($U(), P) :- figure(P, _).

.decl term_cell(t: Ident, p: Position, col: Color)
term_cell(T, P, Col) :- term.label($U(), P, T), figure(P, Col).

// @claim growing-sequence
.init term_box = Bbox<Ident>
term_box.cell(T, P) :- term_cell(T, P, _).

// A cell on the e edge of term t's box.
.decl edge_cell(t: Ident, e: Dir, p: Position)
edge_cell(T, E, P) :- term_box.box(T, B), term_cell(T, P, _), dir_elem(E), box_edge(P, B, E).

// The line of term t's e edge.
.decl term_edge(t: Ident, e: Dir, l: Position)
term_edge(T, E, L) :- edge_cell(T, E, P), axis_of(E, A), split(P, A, L, _).

// A line across axis a that holds a cell of term t.
.decl term_line(a: Axis, t: Ident, l: Position)
term_line(A, T, L) :- term_cell(T, P, _), axis_elem(A), split(P, A, L, _).

// Two terms share a line across axis a.
.decl overlap(a: Axis)
overlap(A) :- term_line(A, T, L), term_line(A, T2, L), T != T2.

// The terms in order along an axis on which no two of them share a line.
// @claim growing-sequence
.init order = OrderFrame<Axis, Ident>
order.axis(A, A) :- axis_elem(A), !overlap(A).
order.member(A, T, L) :- term_line(A, T, L), !overlap(A).

// Term t stands at index i of the sequence read toward d.
.decl term_at(d: Dir, i: Position, t: Ident)
term_at(D, I, T) :- order.pos(A, T, I), axis_of(D, A).

// A cell of the term at index i.
.decl cell_at(d: Dir, i: Position, p: Position, col: Color)
cell_at(D, I, P, Col) :- term_at(D, I, T), term_cell(T, P, Col).

// The term at index i2 follows the term at index i.
.decl consecutive(d: Dir, i: Position, i2: Position)
consecutive(D, I, I2) :- term_at(D, I, _), neighbor(I, D, I2), term_at(D, I2, _).

.decl last(d: Dir, i: Position)
last(D, I) :- term_at(D, I, _), dist(I, D, 0).

// The indices past the last shown term, one per line of the grid toward d.
.decl new_index(d: Dir, i: Position)
new_index(D, I) :- last(D, I0), in(P, _), dist(P, D, M), M > 0, jump(I0, D, M, I).

// A line of the grid across axis a.
.decl grid_line(a: Axis, l: Position)
grid_line(A, L) :- in(P, _), axis_elem(A), split(P, A, L, _).

// The lines between two consecutive terms.
// @claim continue-sequence
.init gap = Tally<TermPair, Position>
gap.domain([T, T2]) :- consecutive(D, I, I2), term_at(D, I, T), term_at(D, I2, T2).
gap.item([T, T2], L) :-
    gap.domain([T, T2]), term_box.box(T, B), term_box.box(T2, B2), dir_elem(D), opposite(D, Db),
    axis_of(D, A), grid_line(A, L), nearer(D, L, B), nearer(Db, L, B2).                         // past t and short of t2

// @claim continue-sequence
.init gap_size = Unanimous<Unit, number>
gap_size.item($U(), N) :- gap.tally(_, N).

// The count of lines between consecutive terms.
// @store: ordinary concept
// @ignore: single-consumer — the @store branch stores this relation
.decl term_gap(g: number)
term_gap(G) :- gap_size.value($U(), G).

// --- growth ---

// An index the term at i0 grows to: the next shown term's for every shown
// term, and every new index for the last term of a sequence of two or more.
.decl target(d: Dir, i0: Position, i: Position)
target(D, I0, I) :- consecutive(D, I0, I).
target(D, I0, I) :- consecutive(D, _, I0), last(D, I0), new_index(D, I).

// The step from index i1 to index i2 on the way from i0.
.decl step(d: Dir, i0: Position, i1: Position, i2: Position)
step(D, I0, I1, I2) :-
    ( target(D, I0, I1) ; I1 = I0 ),
    neighbor(I1, D, I2), target(D, I0, I2).

// The count of steps from index i0 to index i.
.decl steps(d: Dir, i0: Position, i: Position, m: number)
steps(D, I0, I, M) :- target(D, I0, I), moves(D, I0, I, M).

// The count of steps from index i1, a term's or a new term's, to the
// index i a term grows to.
.decl moves(d: Dir, i1: Position, i: Position, n: number)
moves(D, I1, I, N) :-
    target(D, I0, I), ( I1 = I0 ; target(D, I0, I1) ),
    relative(I1, I, V), opposite(D, Db), dist(V, Db, N), N >= 0.

// A count of lines the grid holds toward one of its edges.
.decl span(k: number)
span(K) :- in(P, _), dir_elem(D), dist(P, D, K), K > 0.

// The cells of the term at i0 that rule c grows by index i, one color each:
// paint keeps a cell's own color, and fill gives it the color of the term at
// index i_c.
.decl paint(d: Dir, c: DemonstratedChoice, i0: Position, i: Position, p: Position, col: Color)
// @ignore: head-repeat — a cell a rule grows in the grown term's own color
//  names that term as both the term grown and the term whose color it takes
.decl fill(d: Dir, c: DemonstratedChoice, i0: Position, i: Position, p: Position, i_c: Position)

// A rule that draws each term in one color.
.decl monochrome(d: Dir, c: DemonstratedChoice)
monochrome(D, $Stretch(E)) :- perp_dir(D, E).
monochrome(D, $PeriodEnd(E)) :- perp_dir(D, E).
monochrome(D, $MirrorEnds()) :- dir_elem(D).

// @claim continue-sequence
.init term_period = OffsetInvariance<Ident, Color>
term_period.cell(T, P, Col) :-
    term_box.box(T, B), in(P, _), inside(P, B),
    ( term_cell(T, P, Col) ; !term_cell(T, P, _), params.background(Col) ).

// The period of the term at i0 across the sequence.
.decl cross_period(d: Dir, i0: Position, k: number)
cross_period(D, I0, K) :-
    term_at(D, I0, T), axis_of(D, A), perp(A, C), term_period.min_period(T, C, K).

// The part of term t in one color that holds its e edge.
// @claim continue-sequence
.init edge_part = Reach<TermEdge>
edge_part.seed([T, E], P) :- edge_cell(T, E, P).
edge_part.node([T, E], P) :- edge_part.seed([T, E], Q), term_cell(T, Q, Col), term_cell(T, P, Col).

// @claim continue-sequence
.init part_box = Bbox<TermEdge>
part_box.cell([T, E], P) :- edge_part.reach([T, E], P).

// The band of the term at i0 along axis a: its box with the other axis's
// margins dropped.
.decl term_band(d: Dir, i0: Position, a: Axis, b: Box)
term_band(D, I0, A, B_a) :-
    term_at(D, I0, T), term_box.box(T, B), axis_elem(A), split(B, A, B_a, _).

// --- Stretch ---

// How far a cell of the term at i0 stretches toward e by index i: as far as
// the count of steps on the term's e edge, and not at all elsewhere.
// @ignore: head-zero — a cell off the term's e edge does not stretch
.decl stretch(d: Dir, e: Dir, i0: Position, i: Position, p: Position, k: number)
stretch(D, E, I0, I, P, 0) :- target(D, I0, I), cell_at(D, I0, P, _), ( E = D ; perp_dir(D, E) ).
stretch(D, E, I0, I, P, K) :-
    steps(D, I0, I, M), term_at(D, I0, T), ( E = D ; perp_dir(D, E) ), edge_cell(T, E, P),
    span(K), K <= M.

fill(D, $Stretch(E), I0, I, Q, I) :-
    stretch(D, D, I0, I, P, K), perp_dir(D, E), stretch(D, E, I0, I, P, K2),
    jump(P, D, K, Q1), jump(Q1, E, K2, Q).

// --- PeriodEnd ---

// The cells of the term at i0 within a period of its e end, each moved on by
// one period per step up to the count of steps to index i.
.decl period_block(d: Dir, e: Dir, i0: Position, i: Position, p: Position)
period_block(D, E, I0, I, Q) :-
    steps(D, I0, I, M), cross_period(D, I0, K), perp_dir(D, E),
    term_at(D, I0, T), term_box.box(T, B), term_cell(T, P, _),
    relative(B, P, X), dist(X, E, J), J < K,                    // within a period of the e edge
    span(S), stride(S, K, 0, N, 0), N <= M,                     // n periods
    jump(P, E, S, Q).

fill(D, $PeriodEnd(E), I0, I, P, I) :-
    target(D, I0, I), cross_period(D, I0, _), perp_dir(D, E), cell_at(D, I0, P, _).
fill(D, $PeriodEnd(E), I0, I, P, I) :- period_block(D, E, I0, I, P).

// --- MirrorEnds ---

.type EndKey = [d: Dir, i0: Position, e: Dir]

// The term at i0 repeated by its period across the sequence, out to a
// period past the grid.
.decl repeat(d: Dir, i0: Position, p: Position)
repeat(D, I0, P) :- cross_period(D, I0, _), cell_at(D, I0, P, _).
repeat(D, I0, Q) :-
    cross_period(D, I0, K), cell_at(D, I0, P, _), perp_dir(D, E),
    span(S), stride(S, K, 0, _, 0), jump(P, E, S, Q),           // a whole number of periods
    uniform_outset(K, B), inside(Q, B).

// A mirror axis across the sequence that may end the repeat at line l on
// side e: on l itself, or between l and its neighbor l2 toward e.
.decl axis_cand(d: Dir, i0: Position, e: Dir, l: Position, l2: Position)
axis_cand(D, I0, E, L, L2) :-
    repeat(D, I0, P), perp_dir(D, E), axis_of(E, C), split(P, C, L, _),
    ( L2 = L ; neighbor(L, E, L2) ).

// A cell of the repeat whose image across the axis on l and l2 lies within
// a period past the grid and is not in the repeat.
.decl mirror_defect(d: Dir, i0: Position, e: Dir, l: Position, l2: Position)
mirror_defect(D, I0, E, L, L2) :-
    axis_cand(D, I0, E, L, L2), axis_of(E, C), repeat(D, I0, P), split(P, C, L3, P_across),
    relative(L3, L, V), compose(L2, V, L4), compose(L4, P_across, Q),   // the image of p
    cross_period(D, I0, K), uniform_outset(K, B), inside(Q, B), !repeat(D, I0, Q).

// The line of the term's own e edge, from which it first reaches out.
.decl first_end(d: Dir, i0: Position, e: Dir, l: Position)
first_end(D, I0, E, L) :- repeat(D, I0, _), term_at(D, I0, T), perp_dir(D, E), term_edge(T, E, L).

// The lines on side e from which the repeat reaches out, in order from the
// term's own edge: that edge, and each line past it at which a mirror axis
// of the repeat ends it.
// @claim continue-sequence
.init ends = Order<EndKey, Position>
ends.elem([D, I0, E], L) :- first_end(D, I0, E, L).
ends.elem([D, I0, E], L) :-
    axis_cand(D, I0, E, L, L2), !mirror_defect(D, I0, E, L, L2),
    first_end(D, I0, E, L0), nearer(E, L, L0).
ends.before([D, I0, E], L, L2) :-
    ends.elem([D, I0, E], L), ends.elem([D, I0, E], L2), nearer(E, L2, L).

// The line on side e at which the term grown by index i ends: the end as
// many places on as the count of steps.
.decl mirror_reach(d: Dir, i0: Position, e: Dir, i: Position, l: Position)
mirror_reach(D, I0, E, I, L) :- steps(D, I0, I, M), ends.rank([D, I0, E], L, M).

fill(D, $MirrorEnds(), I0, I, P, I) :-
    mirror_reach(D, I0, E, I, L), opposite(E, E2), mirror_reach(D, I0, E2, I, L2),
    repeat(D, I0, P), axis_of(E, C), split(P, C, L3, _),
    !nearer(E, L3, L), !nearer(E2, L3, L2).                     // between the two ends

// --- FlippedEnds ---

// The move that takes the end piece of the term at i0 on side e from its
// inner edge to its outer edge.
.decl piece_shift(d: Dir, i0: Position, e: Dir, v: Offset)
piece_shift(D, I0, E, V) :-
    term_at(D, I0, T), perp_dir(D, E), opposite(E, E2), axis_of(E, C), part_box.box([T, E], B),
    edge_part.reach([T, E], P), box_edge(P, B, E2), split(P, C, L, _),
    edge_part.reach([T, E], Q), box_edge(Q, B, E), split(Q, C, L2, _),
    relative(L, L2, V).

// The piece the term at i0 gains on side e at each index: its end piece
// there, flipped along the sequence within the term's band and moved out
// past itself, once per step.
// @claim continue-sequence
.init end_piece = Propagation<EndKey, Seat>
end_piece.source([D, I0, E], [I0, P]) :-
    term_at(D, I0, T), perp_dir(D, E), edge_part.reach([T, E], P).
end_piece.edge([D, I0, E], [I1, P], [I2, Q]) :-
    step(D, I0, I1, I2), piece_shift(D, I0, E, V),
    axis_of(D, A), term_band(D, I0, A, B_al), in(P, _), inside(P, B_al), flip_of(A, F),
    relative(B_al, P, P_rel), apply(F, P_rel, P_rel2), compose(B_al, P_rel2, P2),
    compose(P2, V, Q).

paint(D, $FlippedEnds(), I0, I, P, Col) :- target(D, I0, I), cell_at(D, I0, P, Col).
fill(D, $FlippedEnds(), I0, I, P, I_c) :-
    end_piece.reached([D, I0, _], [I_c, P]), target(D, I0, I_c), moves(D, I_c, I, _).

// --- SplitStep ---

// The hook of the term at i0: the part that holds its back edge.
.decl hook(d: Dir, i0: Position, t: Ident, p: Position)
hook(D, I0, T, P) :- term_at(D, I0, T), opposite(D, Db), edge_part.reach([T, Db], P).

// The step's depth: the hook's extent along the sequence.
.decl hook_depth(d: Dir, i0: Position, k: number)
hook_depth(D, I0, K) :-
    term_at(D, I0, T), opposite(D, Db), part_box.box([T, Db], B), axis_of(D, A),
    in(P, _), box_extent(B, P, A, K).

// Cell p, in the frame of the term at i0, lies on side e of the term's
// center line, the line included.
.decl on_half(d: Dir, i0: Position, e: Dir, p: Position)
on_half(D, I0, E, P) :-
    term_at(D, I0, _), axis_of(D, A), perp(A, C), term_band(D, I0, C, Bc),
    perp_dir(D, E), opposite(E, E2), in(P, _),
    relative(Bc, P, X), dist(X, E, K1), dist(X, E2, K2), K1 <= K2.

// @claim continue-sequence
.init half_box = Bbox<TermSide>
half_box.cell([D, T, E], P) :- hook(D, I0, T, P), on_half(D, I0, E, P).

// How far the half of the term on side e moves out at each step: from the
// hook half's inner edge to its outer edge.
// @ignore: common-subexpr — the shared atoms set the orientation, and the
//  two relations read the boxes of different parts
.decl half_out(d: Dir, i0: Position, e: Dir, w: number)
half_out(D, I0, E, W) :-
    term_at(D, I0, T), perp_dir(D, E), opposite(E, E2), half_box.box([D, T, E], B),
    half_box.cell([D, T, E], P), box_edge(P, B, E2),
    half_box.cell([D, T, E], Q), box_edge(Q, B, E), relative(P, Q, V), dist(V, E2, W).

// The cells the term at i0 holds when index i_o is reached, each with the
// cell it comes from: the term's own cells at i0, and at each later index
// the hook it adds, with its legs drawn a step deeper.
// @ignore: head-repeat — the term's own cells come from themselves, at i0
.decl tent_seed(d: Dir, i0: Position, i_o: Position, p: Position, p_o: Position)
tent_seed(D, I0, I0, P, P) :- cell_at(D, I0, P, _), hook(D, I0, _, _).
tent_seed(D, I0, I, Q, P) :-
    target(D, I0, I), hook(D, I0, T, P),
    ( Q = P                                                         // the hook
    ; opposite(D, Db), part_box.box([T, Db], B), box_edge(P, B, D), // its legs
      hook_depth(D, I0, K), jump(P, D, K, Q)
    ).

// The cells of the term at i0 by index i, each with the index and cell it
// comes from: at each step the cells split at the term's center line, and
// each half moves one step deep and out.
.decl tent(d: Dir, i0: Position, i: Position, p: Position, i_o: Position, p_o: Position)
tent(D, I0, I, Q, I_o, P_o) :-
    tent_seed(D, I0, I_o, P, P_o), moves(D, I_o, I, N), target(D, I0, I),
    ( N = 0, Q = P
    ; N > 0, on_half(D, I0, E, P), half_out(D, I0, E, W), hook_depth(D, I0, K),
      span(S2), stride(S2, K, 0, N, 0),                             // n steps deep
      ( W = 0, jump(P, D, S2, Q)
      ; span(S1), stride(S1, W, 0, N, 0), jump(P, E, S1, Q1), jump(Q1, D, S2, Q) )
    ).

paint(D, $SplitStep(), I0, I, P, Col) :- tent(D, I0, I, P, I0, P_o), cell_at(D, I0, P_o, Col).
fill(D, $SplitStep(), I0, I, P, I_c) :- tent(D, I0, I, P, I_c, _), I_c != I0.

// --- term colors ---

// The cells whose one color is a term's color under rule c: every cell for
// a rule that draws a term in one color, the cells of both ends across the
// sequence for FlippedEnds, and the back edge for SplitStep.
.decl color_cell(d: Dir, c: DemonstratedChoice, t: Ident, p: Position)
color_cell(D, C, T, P) :- monochrome(D, C), term_cell(T, P, _).
color_cell(D, $FlippedEnds(), T, P) :- perp_dir(D, E), edge_cell(T, E, P).
color_cell(D, $SplitStep(), T, P) :- opposite(D, Db), edge_cell(T, Db, P).

// @claim continue-sequence
.init term_color = Unanimous<TermRule, Color>
term_color.item([D, C, T], Col) :- color_cell(D, C, T, P), term_cell(T, P, Col).

.decl shown_color(d: Dir, c: DemonstratedChoice, i: Position, col: Color)
shown_color(D, C, I, Col) :- term_at(D, I, T), term_color.value([D, C, T], Col).

// A shown term with no one color under rule c.
.decl uncolored(d: Dir, c: DemonstratedChoice)
uncolored(D, C) :- term_color.item([D, C, T], _), !term_color.value([D, C, T], _).

// A count of terms the color cycle may repeat after: one up to the count of
// shown terms.
.decl period_cand(d: Dir, k: number)
period_cand(D, K) :-
    term_at(D, I0, _), opposite(D, Db), dist(I0, Db, 0),
    ( term_at(D, I, _) ; last(D, I1), neighbor(I1, D, I) ),
    relative(I0, I, V), dist(V, Db, K), K > 0.

// A shown term whose color differs from the color of the shown term k on.
.decl period_defect(d: Dir, c: DemonstratedChoice, k: number)
period_defect(D, C, K) :-
    period_cand(D, K), shown_color(D, C, I, Col), jump(I, D, K, I2), shown_color(D, C, I2, Col2),
    Col != Col2.

// @claim continue-sequence
.init least_period = Extremes<DemonstratedRule>
least_period.cand([D, C], K) :-
    period_cand(D, K), shown_color(D, C, _, _), !uncolored(D, C), !period_defect(D, C, K).

// The color of the new term at index i2: the color of the shown terms at its
// place in the cycle.
.decl term_color_at(d: Dir, c: DemonstratedChoice, i2: Position, col: Color)
term_color_at(D, C, I2, Col) :-
    new_index(D, I2), least_period.low([D, C], K), shown_color(D, C, I, Col), opposite(D, Db),
    dist(I, Db, X), stride(X, K, 0, _, R),
    dist(I2, Db, X2), stride(X2, K, 0, _, R).                   // one place in the cycle

// --- the rule each input demonstrates ---

// @claim continue-sequence
.init grown_box = Bbox<Grown>
grown_box.cell([D, C, I0, I], P) :- paint(D, C, I0, I, P, _).
grown_box.cell([D, C, I0, I], P) :- fill(D, C, I0, I, P, _).

// Each term is read with its lines along the sequence measured from its own
// box and its lines across the sequence from the grid, so that a growth
// carries the alignment across the sequence and the gap does not enter.
// @claim continue-sequence
.init catalog = DemonstrationConsistency<Dir, DemonstratedChoice, Position, Position, Color>
catalog.value(D, I, P_h, Col) :-
    cell_at(D, I, P, Col), axis_of(D, A), term_band(D, I, A, B_al), relative(B_al, P, P_h).
catalog.demonstration(D, I, I2) :- consecutive(D, I, I2).
catalog.prediction(D, C, I, P_h, Col) :-
    consecutive(D, I, I2), grown_box.box([D, C, I, I2], B), axis_of(D, A), split(B, A, B_al, _),
    ( paint(D, C, I, I2, P, Col) ; fill(D, C, I, I2, P, I_c), shown_color(D, C, I_c, Col) ),
    relative(B_al, P, P_h).

// --- continuation ---

// The line of the e edge of the term grown from the last by index i.
.decl grown_edge(d: Dir, c: DemonstratedChoice, i: Position, e: Dir, l: Position)
grown_edge(D, C, I, E, L) :-
    last(D, I0), grown_box.box([D, C, I0, I], B), grown_box.cell([D, C, I0, I], P),
    axis_of(D, A), axis_of(E, A), box_edge(P, B, E), split(P, A, L, _).

// The move that puts the new term at i2 a gap past the term at i1, when the
// term at i1 has its front edge on line l1.
.decl advance(d: Dir, c: DemonstratedChoice, i1: Position, l1: Position, i2: Position, v: Offset)
advance(D, C, I1, L1, I2, V) :-
    ( last(D, I1) ; new_index(D, I1) ), neighbor(I1, D, I2),
    axis_of(D, A), grid_line(A, L1),
    term_gap(G), jump(L1, D, G, L2), neighbor(L2, D, L3),       // the line past the gap
    opposite(D, Db), grown_edge(D, C, I2, Db, L4), relative(L4, L3, V).

// The line of each term's front edge where it stands, from the last shown
// term on.
// @claim continue-sequence
.init front = Propagation<DemonstratedRule, Seat>
front.source([D, C], [I, L]) :-
    catalog.confirmed(D, C), last(D, I), term_at(D, I, T), term_edge(T, D, L).
front.edge([D, C], [I1, L1], [I2, L]) :-
    advance(D, C, I1, L1, I2, V), grown_edge(D, C, I2, D, L0), compose(L0, V, L).

// The cells the continued sequence draws.
.decl drawn(dr: Drawn, r: DemonstratedRule, p: Position, col: Color)
drawn(Dr, [D, C], Q, Col) :-
    front.reached([D, C], [I1, L1]), advance(D, C, I1, L1, I, V), drawn_choice(Dr),
    ( paint(D, C, _, I, P, Col) ; fill(D, C, _, I, P, I_c), term_color_at(D, C, I_c, Col) ),
    compose(P, V, Q).

// --- window ---

.decl mark(p: Position)
mark(P) :- in(P, Col), params.marker_color(Col).

// The window each reading of its extent gives.
.decl window(ex: Extent, b: Box)

// --- output ---

// The rules the output is drawn under: confirmed, with a least period.
.decl output_rule(r: DemonstratedRule)
output_rule([D, C]) :- catalog.confirmed(D, C), least_period.low([D, C], _).

out(P_out, Col, [Dr, Ex], R) :-
    drawn_choice(Dr), window(Ex, B), in(P, _), crop(P, B, P_out),
    ( drawn(Dr, R, P, Col), ( R = nil, output_rule(_) ; output_rule(R) )   // a drawn cell
    ; output_rule(R), !drawn(Dr, R, P, _), !drawn(Dr, nil, P, _),           // the field
      params.background(Col) ).

// --- $EveryTerm ---
drawn($EveryTerm(), nil, P, Col) :- term_cell(_, P, Col).

// --- $MarkBox ---
// @claim corner-marks crop-window
.init mark_box = Bbox<Unit>
mark_box.cell($U(), P) :- mark(P).

window($MarkBox(), B) :- mark_box.box($U(), B).

// --- $ElbowBox ---
// A mark cell with mark neighbors on both axes: an L mark's corner cell.
.decl elbow(p: Position)
elbow(P) :- mark(P), neighbor(P, D, Q), mark(Q), perp_dir(D, D2), neighbor(P, D2, Q2), mark(Q2).

// @claim corner-marks crop-window
.init elbow_box = Bbox<Unit>
elbow_box.cell($U(), P) :- elbow(P).

window($ElbowBox(), B) :- elbow_box.box($U(), B).
