// 11dc524f
// concept: objects move d4
// A shape of params.shape_color faces a block of params.mirror_color. The block's
// facing edge is a mirror: the shape slides up against that edge, and its
// reflection appears on the far side in params.mirror_color. The grid is
// otherwise params.bg.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(7).
    .decl shape_color(col: Color) shape_color(2).
    .decl mirror_color(col: Color) mirror_color(5).
}

.init params = Params

// Each object viewed from its own bounding box.
.init box = BoxFrame<Color>
box.cell(Col, P) :- in(P, Col), !params.bg(Col).
box.grid(Col, P) :- box.cell(Col, _), in(P, _).

// Line of sight: the direction from the shape to the block.
.init sight = Ray<Unit>
sight.dir($U(), D) :- dir_elem(D).
sight.mark($U(), P) :- in(P, Col), params.shape_color(Col).
sight.cell($U(), P) :- in(P, Col), params.mirror_color(Col).

.decl move_dir(d: Dir)
move_dir(D) :- dir_elem(D), sight.ray($U(), _, D, _, _).

// Displacements toward the block the frame admits.
.decl shift(delta: Offset)
shift(Delta) :-
    in(P, _), move_dir(D),
    axis_of(D, A), sub_extent(P, A, K), jump_offset(D, K, Delta).

// The displacements at which the shape's box would lie over the block's box.
.decl covering(delta: Offset)
covering(Delta) :-
    shift(Delta), params.shape_color(Col), box.inside(Col, P),  // a shape-box cell
    compose(P, Delta, P2),                                       // carried there
    params.mirror_color(Col2), box.inside(Col2, P2).             // on a block-box cell

// The shape stands where it is, and travels through the displacements that
// keep its box clear of the block's.
.init slide = Slide<Unit>
slide.dir($U(), D) :- move_dir(D).
slide.node($U(), ZERO).
slide.node($U(), Delta) :- shift(Delta), !covering(Delta).

// The shape's box, docked: flush against the block's box.
.decl home(p: Position)
home(P_home) :-
    params.shape_color(Col), box.margin(Col, P_box),  // the shape's box
    slide.rest($U(), ZERO, _, Delta),               // at rest
    compose(P_box, Delta, P_home).

// The reflection's box: one shape-length on from home, so the two boxes
// meet at the mirror.
.decl mirror(p: Position)
mirror(P_mirror) :-
    move_dir(D), axis_of(D, A),
    params.shape_color(Col), box.extent(Col, A, N),  // the shape's length along the slide
    home(P_home), jump(P_home, D, N, P_mirror).

.decl paint(p: Position, col: Color)
paint(P_grid_out, Col_out) :-
    params.shape_color(Col),
    box.cell(Col, P_cell), box.inner(Col, P_cell, P_intile),           // a shape cell in its box
    ( home(P_home), compose(P_home, P_intile, P_grid_out),
      Col_out = Col                                                    // the shape, docked
    ; move_dir(D), axis_of(D, A), flip_of(A, F), apply(F, P_intile, P_flip),
      mirror(P_mirror), compose(P_mirror, P_flip, P_grid_out),
      params.mirror_color(Col_out)                                          // its reflection
    ).

.decl out(p: Position, col: Color)
out(P, Col) :- paint(P, Col).
out(P, Col) :- in(P, _), !paint(P, _), params.bg(Col).
