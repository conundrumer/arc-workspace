// 11dc524f
// @keywords: objects move d4
// input: a shape of params.shape_color faces a block of params.mirror_color.
// output: the block's facing edge is a mirror: the shape slides up against
//  that edge, and its reflection appears on the far side in
//  params.mirror_color. the grid is otherwise params.bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(7).
    .decl shape_color(col: Color) shape_color(2).
    .decl mirror_color(col: Color) mirror_color(5).
}

.init params = Params

// Each object's own bounding box.
.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col), !params.bg(Col).

// Line of sight: the direction from the shape to the block.
.init sight = Ray<Unit>
sight.dir($U(), D) :- dir_elem(D).
sight.mark($U(), P) :- in(P, Col), params.shape_color(Col).
sight.cell($U(), P) :- in(P, Col), params.mirror_color(Col).

.decl move_dir(d: Dir)
move_dir(D) :- dir_elem(D), sight.ray($U(), _, D, _, _).

// Displacements toward the block the frame admits.
.decl shift(delta: Offset)
shift(Delta) :-
    in(P, _), move_dir(D),
    axis_of(D, A), sub_extent(P, A, K), jump_offset(D, K, Delta).

// The displacements at which the shape's box would lie over the block's box.
.decl covering(delta: Offset)
covering(Delta) :-
    shift(Delta), in(P, _),
    params.shape_color(Col), bbox.box(Col, B), inside(P, B),        // a shape-box cell
    compose(P, Delta, P2), in(P2, _),                               // carried there
    params.mirror_color(Col2), bbox.box(Col2, B2), inside(P2, B2).  // on a block-box cell

// The shape stands where it is, and travels through the displacements that
// keep its box clear of the block's.
.init slide = Slide<Unit>
slide.dir($U(), D) :- move_dir(D).
slide.node($U(), ZERO).
slide.node($U(), Delta) :- shift(Delta), !covering(Delta).

// The shape's box, docked: flush against the block's box.
.decl home(b: Box)
home(B_home) :-
    params.shape_color(Col), bbox.box(Col, B),      // the shape's box
    slide.rest($U(), ZERO, _, Delta),               // at rest
    compose(B, Delta, B_home).

// The reflection's box: one shape-length on from home, so the two boxes
// meet at the mirror.
.decl mirror(b: Box)
mirror(B_mirror) :-
    move_dir(D), axis_of(D, A),
    params.shape_color(Col), bbox.box(Col, B),
    in(P, _), box_extent(B, P, A, N),                 // the shape's length along the slide
    home(B_home), jump(B_home, D, N, B_mirror).

.decl paint(p: Position, col: Color)
paint(P_grid_out, Col_out) :-
    params.shape_color(Col),
    bbox.cell(Col, P_cell), bbox.box(Col, B),
    crop(P_cell, B, P_inner),                                       // a shape cell in its box
    ( home(B_home), compose(B_home, P_inner, P_grid_out),
      Col_out = Col                                                 // the shape, docked
    ; move_dir(D), axis_of(D, A), flip_of(A, F), apply(F, P_inner, P_flip),
      mirror(B_mirror), compose(B_mirror, P_flip, P_grid_out),
      params.mirror_color(Col_out)                                  // its reflection
    ).

out(P, Col) :- paint(P, Col).
out(P, Col) :- in(P, _), !paint(P, _), params.bg(Col).
