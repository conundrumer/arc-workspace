// 3de23699
// keywords: markers crop span
// output: Marks of one color sit at the corners of a rectangle, and a pattern
//  in another color lies strictly inside it. The output is the rectangle's open
//  interior, with the pattern redrawn in the mark color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- ink(P, Col).

// The interior of each color's bbox, over the whole grid.
.decl hole(col: Color, p: Position)
hole(Col, P) :- bbox.box(Col, B), in(P, _), interior(P, B).

// Some cell of Col2 lies outside the interior of Col's bbox.
.decl escapes(col: Color, col2: Color)
escapes(Col, Col2) :- ink(_, Col), ink(P, Col2), !hole(Col, P).

// The mark color frames the other color.
.decl mark(col: Color)
mark(Col) :- ink(_, Col), ink(_, Col2), Col != Col2, !escapes(Col, Col2).

// The box the output crops to.
.init hole_bbox = Bbox<Unit>
hole_bbox.cell($U(), P) :- mark(Col), hole(Col, P).

out(P_inner, Col_out) :-
    mark(Col), hole(Col, P),                       // an interior cell
    hole_bbox.box($U(), B), crop(P, B, P_inner),   // seen from the rectangle itself
    ( ink(P, _), Col_out = Col                     // pattern cell takes the mark color
    ; !ink(P, _), params.bg(Col_out) ).            // bare cell stays background
