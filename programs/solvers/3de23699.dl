// 3de23699
// concept: markers crop span
// Marks of one color sit at the corners of a rectangle, and a pattern in
// another color lies strictly inside it. The output is the rectangle's open
// interior, with the pattern redrawn in the mark color.

#include "../lib.dl"

.comp Consts {
    .decl bg(col: Color) bg(0).
}

.init c = Consts

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.init box = Bbox<Color>
box.cell(Col, P) :- ink(P, Col).

.decl interior(col: Color, p: Position)
interior(Col, P) :- in(P, _), box.margin(Col, M), gt(P, M).

// Some cell of Col2 lies outside the interior of Col's box.
.decl escapes(col: Color, col2: Color)
escapes(Col, Col2) :- ink(_, Col), ink(P, Col2), !interior(Col, P).

// The mark color frames the other color.
.decl mark(col: Color)
mark(Col) :- ink(_, Col), ink(_, Col2), Col != Col2, !escapes(Col, Col2).

.init view = BoxFrame<Unit>
view.cell($U(), P) :- mark(Col), interior(Col, P).

.decl out(p: Position, col: Color)
out(P_inner, Col_out) :-
    mark(Col), view.inner($U(), P, P_inner),  // the rectangle seen from itself
    ( ink(P, _), Col_out = Col                // pattern cell takes the mark color
    ; !ink(P, _), c.bg(Col_out) ).            // bare cell stays background
