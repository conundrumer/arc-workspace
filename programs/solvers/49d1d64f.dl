// 49d1d64f
// concept: grow border
// Grow the grid by one ring: the input seats one cell in from every output
// edge, each input edge cell replicates one step past its edge, and the
// ring's corners get c.bg.

#include "../lib.dl"

.comp Consts {
    .decl seat_delta(p: Inset) seat_delta([1, 1, 1, 1]).
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl seated(p_in: Position, p_out: Position)
seated(P_in, P_out) :- in(P_in, _), c.seat_delta(Delta), compose(P_in, Delta, P_out).

.decl out(p: Position, col: Color)
out(P_out, Col) :- in(P_in, Col), seated(P_in, P_out).
out(P_ring, Col) :-
    in(P_in, Col_in),                                         // input cell
    ( dir_elem(D), dist(P_in, D, 0),                          // on edge d
      step_delta(D, S), Col = Col_in                          // steps out carrying its color
    ; diag_dir_elem(Diag), diag_dist(P_in, Diag, _, 0, 0),    // at corner diag
      step_delta(Diag, S), c.bg(Col)                          // steps out as bg
    ),
    seated(P_in, P_out), compose(P_out, S, P_ring).           // the cell past its seat

// --- fit ---

.comp Fit {
    // Seat each train input among its output's cells, color for color.
    .init occ = Occurrences<Example, Color>
    occ.shape(E, P_in, Col)  :- ex_in(E, P_in, Col).
    occ.cell(E, P_out, Col)  :- ex_out(E, P_out, Col).

    // A delta some train pair does not seat.
    .decl broken(p: Inset)
    broken(Delta) :-
        occ.occurrence(_, Delta),     // seats one pair
        ex_out(E, _, _),              // and a train pair
        !occ.occurrence(E, Delta).    // it misses

    .decl seat_delta(p: Inset)
    seat_delta(Delta) :- occ.occurrence(_, Delta), !broken(Delta).
}
