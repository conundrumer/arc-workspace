// 49d1d64f
// @keywords: grow border
// output: Grow the grid by one ring: the input seats one cell in from every
//  output edge, each input edge cell replicates one step past its edge, and the
//  ring's corners get params.bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl ring_width(k: number) ring_width(1).

    // The input's seat in the output.
    .decl seat_delta(p: Box)
    seat_delta(P) :- ring_width(K), uniform_inset(K, P).

    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl seated(p_in: Position, p_out: Position)
seated(P_in, P_out) :- in(P_in, _), params.seat_delta(Delta), compose(P_in, Delta, P_out).

out(P_out, Col) :-
    in(P_in, Col_in), seated(P_in, P_seat),                   // input cell at its seat
    ( P_out = P_seat, Col = Col_in                            // the seat itself
    ; dir_elem(D), dist(P_in, D, 0),                          // on edge d
      neighbor(P_seat, D, P_out), Col = Col_in                // steps out carrying its color
    ; diag_dir_elem(Diag), corner_dist(P_in, Diag, 0),        // at corner diag
      neighbor(P_seat, Diag, P_out), params.bg(Col)           // steps out as bg
    ).

.comp Determine {
    // Seat each train input among its output's cells, color for color.
    .init occ = Occurrences<Example, Color>
    occ.shape(E, P_in, Col)  :- ex_in(E, P_in, Col).
    occ.cell(E, P_out, Col)  :- ex_out(E, P_out, Col).

    // A delta some train pair does not seat.
    .decl broken(p: Box)
    broken(Delta) :-
        occ.occurrence(_, Delta),     // seats one pair
        ex_out(E, _, _),              // and a train pair
        !occ.occurrence(E, Delta).    // it misses

    .decl ring_width(k: number)
    ring_width(K) :-
        occ.occurrence(_, Delta), !broken(Delta),   // the seat every pair takes
        dir_elem(D), dist(Delta, D, K).             // its width at an edge
}
