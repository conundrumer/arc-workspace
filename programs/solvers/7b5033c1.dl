// 7b5033c1
// @draft
// @keywords: walk rank
// input: a simple 4-connected path of non-bg cells, in colored segments
// output: The path straightens into a line along params.line_axis: the k-th
//  path cell from the end nearer an edge lands k from that edge. Either end
//  may lead the walk, so both run, keyed by edge.

.decl out(p: Position, col: Color)

.comp Params {
    .decl line_axis(a: Axis) line_axis(AXIS_V).
}

.init params = Params

// Bg is the commonest color.
.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl ink(p: Position)
ink(P) :- in(P, Col), !bg_mode.mode($U(), Col).

// Path adjacency.
.decl link(p: Position, q: Position)
link(P, Q) :- ink(P), dir_elem(D), neighbor(P, D, Q), ink(Q).

// A cell with a second path neighbor.
.decl fork(p: Position)
fork(P) :- link(P, Q), link(P, Q2), Q != Q2.

// An end of the path: one path neighbor.
.decl end(p: Position)
end(P) :- link(P, _), !fork(P).

// The end nearer edge D, for each edge on the line's axis.
.decl head(d: Dir, p: Position)
head(D, P) :- params.line_axis(A), axis_of(D, A), end(P), end(Q), nearer(D, P, Q).

// Each path cell's place along the walk from the head: its hop count.
.init path = GraphDistance<Dir, Position>
path.edge(D, P, Q) :- head(D, _), link(P, Q).
path.seed(D, P) :- head(D, P).

// The output line: one cell per path cell.
.init total = Tally<Unit, Position>
total.item($U(), P) :- ink(P).

.init line = AxisFrame<Unit>
line.extent($U(), A, N) :- params.line_axis(A), total.tally($U(), N).

out(P_out, Col) :-
    path.distance(D, P, K), in(P, Col),       // k-th path cell from the head at edge D
    line.cell($U(), _, P_out), dist(P_out, D, K).  // k from edge D of the line
