// 33b52de3
// draft
// concept: decompose scale
// The grid holds a field of tiles in a uniform arrangement, and a block of
// colored cells. That block is the arrangement in miniature: one cell per
// tile, in the same frame. Each tile takes the color of the miniature cell at
// its place; the rest of the grid passes through.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl tile_col(col: Color) tile_col(5).

    // Tile extent, both axes, and the gap between tiles.
    .decl tile_dim(k: number) tile_dim(3).
    .decl gap(g: number) gap(1).
}

.init params = Params

// The miniature. Its own frame is the tile arrangement, so each of its cells
// sits at a tile place.
.init mini = BoxFrame<Unit>
mini.cell($U(), P) :- in(P, Col), !params.bg(Col), !params.tile_col(Col).

.init field = BoxFrame<Unit>
field.cell($U(), P) :- in(P, Col), params.tile_col(Col).

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), !params.tile_col(Col).
out(P, Col) :-
    field.inner($U(), P, P_inner),                       // a tile cell, in the field's frame
    params.tile_dim(K), params.gap(G),                   // the arrangement's step
    divide_by_size_2d(P_inner, K, G, P_tile, _),         // the tile it falls in
    in(P_mini, Col), mini.inner($U(), P_mini, P_tile).   // the miniature's cell there
