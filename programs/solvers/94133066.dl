// 94133066
// draft
// keywords: markers crop d4 match
// input: a rectangular panel of the field color on a wider grid. A mark is a
//  panel cell whose color repeats outside the panel.
// output: the panel, cropped from the grid and turned by the D4 element that
//  carries its marks onto the outside cells of their colors.

// how much of the turned marks' arrangement the outside cells keep
.type Choice =
    // all of it: every pair of marks keeps its offset
    Congruent {}
    // the order alone: every pair keeps which of the two lies toward each
    // direction
  | Ordered {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // the panel's color
    .decl field(c: Color) field(1).
}

.init params = Params

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- in(P, Col), params.field(Col).

// the panel's cells, in its own frame
.decl panel(p_inner: Position, col: Color)
panel(P_inner, Col) :- in(P, Col), bbox.box($U(), B), crop(P, B, P_inner).

.decl outside(p: Position, col: Color)
outside(P, Col) :- in(P, Col), bbox.box($U(), B), !inside(P, B).

// a mark in the place the turn D gives it, beside the outside cell of its color
.decl placed(d: D4, p_grid_out: Position, p_grid_in: Position)
placed(D, P_grid_out, P_grid_in) :-
    d4_elem(D), panel(P_inner, Col), outside(P_grid_in, Col),    // a color held on both sides
    apply(D, P_inner, P_grid_out).

.decl impl_choice(ch: Choice)
impl_choice($Congruent()). impl_choice($Ordered()).

// a pair of marks the turn does not carry onto its outside pair
.decl broken(d: D4, ch: Choice)

.decl pose(d: D4, ch: Choice)
pose(D, Ch) :- d4_elem(D), impl_choice(Ch), !broken(D, Ch).

out(P_grid_out, Col, Ch) :- panel(P_inner, Col), pose(D, Ch), apply(D, P_inner, P_grid_out).

// --- Congruent ---
broken(D, $Congruent()) :-
    placed(D, P1, Q1), placed(D, P2, Q2),
    relative(P1, P2, V), relative(Q1, Q2, V2), V != V2.    // turned offset, outside offset

// --- Ordered ---
broken(D, $Ordered()) :-
    placed(D, P1, Q1), placed(D, P2, Q2), dir_elem(Dir),
    ( nearer(Dir, P1, P2), !nearer(Dir, Q1, Q2)            // turned only
    ; nearer(Dir, Q1, Q2), !nearer(Dir, P1, P2) ).         // outside only
