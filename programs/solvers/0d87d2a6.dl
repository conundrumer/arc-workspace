// 0d87d2a6
// keywords: markers objects cast span
// output: Objects of params.body sit in the grid, and params.mark cells sit on
//  its edges. A marker sends a line across the grid along its edge's axis; the
//  line and the objects it catches turn params.paint. The rest of the input
//  stays as it is.

// how a line is drawn
.type Draw =
    // a marker at one end draws the whole line
    Cast {}
    // a line needs a marker at each end
  | Span {}

// which objects a line catches
.type Spread =
    // an object that touches the line
    Graze {}
    // an object the line runs through
  | Pierce {}

// how a line is drawn, crossed with which objects it catches
.type Choice = [d: Draw, s: Spread]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(col: Color) mark(1).
    .decl body(col: Color) body(2).
    .decl paint(col: Color) paint(1).
}

.init params = Params

.decl draw_choice(d: Draw)
draw_choice($Cast()).
draw_choice($Span()).

.decl spread_choice(s: Spread)
spread_choice($Graze()).
spread_choice($Pierce()).

.decl impl_choice(ch: Choice)
impl_choice([D, S]) :- draw_choice(D), spread_choice(S).

// Keyed by the axis of the edge the marker sits on.
.init mark_cast = Between<Axis>
mark_cast.axis(A, A) :- axis_elem(A).
mark_cast.cell(A, P) :- axis_elem(A), in(P, _).
mark_cast.mark(A, M) :- in(M, Col), params.mark(Col), dist(M, D, 0), axis_of(D, A).

.decl line(p: Position, d: Draw)

// --- $Cast ---
line(P, $Cast()) :- mark_cast.ray(_, P, _, _, _).

// --- $Span ---
line(P, $Span()) :- mark_cast.between(_, P).

// The objects a line catches: the components that the line's cells select.
// $Pierce is the seed rule alone — a line cell that lands on an object selects
// it, and one that lands elsewhere selects nothing.
.init reach = Reach<Choice>
reach.node(Ch, P) :- impl_choice(Ch), in(P, Col), params.body(Col).   // an object cell
reach.seed([D, S], P) :- line(P, D), spread_choice(S).

// --- $Graze ---
// The line is part of the region, so an object that touches it is caught too.
reach.node([D, $Graze()], P) :- line(P, D).

.decl painted(p: Position, ch: Choice)
painted(P, [D, S]) :- line(P, D), spread_choice(S).   // the line itself
painted(P, Ch) :- reach.reach(Ch, P).                 // the objects it catches

out(P, Col, Ch) :- painted(P, Ch), params.paint(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !painted(P, Ch).
