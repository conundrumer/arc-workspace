// c8cbb738
// @draft
// @keywords: overlay color-class bbox rank count
// @scene plain-background: one color fills every cell that is not a mark
// @scene one-figure-per-color: each mark color other than the background
//  marks exactly 4 cells, and those cells form one figure
// @scene odd-extents: each figure's bounding box has an odd height and an odd
//  width, so each figure has a center cell
// @scene largest-figure-is-square: one figure's bounding box is a square whose
//  side is at least the height and the width of each other figure's bounding
//  box
// @rule output-is-largest-box: the output is a square whose side is the side
//  of the largest figure's bounding box, filled with the background color
// @rule figures-share-center: each figure is copied into the output,
//  translated so that the center of its bounding box is at the center of the
//  output, with each mark keeping its color

// the output's frame
.type OutputFrame =
    // @claim output-is-largest-box
    LargestSquare {}
    // @rule output-is-largest-box: the output's height is the largest figure
    //  height and its width the largest figure width, so the output is the
    //  bounding box of the centered figures
    // @witness no-square-figure: variant $UnionFrame
    //     @relaxed largest-figure-is-square
  | UnionFrame {}
    // @rule output-is-largest-box: the output is the bounding box of the
    //  largest figure whose bounding box is a square, and marks that fall
    //  outside it are dropped; undefined where no figure's bounding box is a
    //  square
    // @witness rectangle-outgrows-square: borderline $UnionFrame
    //     @relaxed largest-figure-is-square
  | SquareFigureFrame {}

// which color classes are figures
.type Figures =
    // @claim one-figure-per-color
    EveryColorClass {}
    // @rule counted-classes: only the color classes of params.marks_per_figure
    //  cells are figures; the cells of every other class take the background
    //  color
    // @witness stray-dot: borderline concept
    //     @relaxed one-figure-per-color
  | CountedClasses {}

.type Choice = [frame: OutputFrame, figures: Figures]

// The figure of one color under a figure reading.
.type Fig = [s: Figures, col: Color]

// An axis of the figures under a figure reading.
.type Span = [s: Figures, a: Axis]

// An output frame under a figure reading.
.type View = [f: OutputFrame, s: Figures]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $CountedClasses ---
    // @derive TileCount: borderline concept
    //     @relaxed one-figure-per-color
    // @derive TileDim: borderline concept
    //     @relaxed one-figure-per-color
    .decl marks_per_figure(n: number) marks_per_figure(4).
}

.init params = Params

// The color classes on a background, and the size of each.
.comp Parse<Key> {
    .type Class = [ky: Key, col: Color]

    .decl cell(ky: Key, p: Position, col: Color)
    .decl bg(ky: Key, col: Color)

    // @claim plain-background
    .init palette = Mode<Key, Color, Position>
    palette.item(Ky, Col, P) :- cell(Ky, P, Col).

    // The cells of each color class: the cells not of the background color.
    .decl class_cell(ky: Key, col: Color, p: Position)
    class_cell(Ky, Col, P) :- cell(Ky, P, Col), !bg(Ky, Col).

    // @claim counted-classes
    .init class_size = Tally<Class, Position>
    class_size.item([Ky, Col], P) :- class_cell(Ky, Col, P).
}

.init parse = Parse<Unit>

parse.cell($U(), P, Col) :- in(P, Col).
parse.bg($U(), Col) :- parse.palette.mode($U(), Col).

// The marks of each figure.
.decl mark(f: Fig, p: Position)

// @claim one-figure-per-color
.init fig_box = Bbox<Fig>
fig_box.cell(F, P) :- mark(F, P).

.decl extent(f: Fig, a: Axis, n: number)
extent(F, A, N) :- fig_box.box(F, B), mark(F, P), axis_elem(A), box_extent(B, P, A, N).

// The cell at the center of each figure's bounding box.
.decl center(f: Fig, p: Position)
center(F, P) :- fig_box.box(F, B), in(P, _), crop(P, B, P_inner), centered(P_inner).

// Some figure has no center cell.
.decl uncentered(s: Figures)
uncentered(S) :- mark([S, Col], _), !center([S, Col], _).

.init frame = Frame2D<View>

// The cells each figure's marks land on in the output.
.decl landing(v: View, q: Position, col: Color)
landing([F, S], Q, Col) :-
    frame.cell([F, S], Z), centered(Z),              // the output's center
    center([S, Col], C), mark([S, Col], P),
    relative(C, P, V),                               // a mark's offset from its figure's center
    compose(Z, V, Q).                                // laid off from the output's center

out(Q, Col, [F, S]) :-
    frame.cell([F, S], Q), !uncentered(S),
    ( landing([F, S], Q, Col)
    ; !landing([F, S], Q, _), parse.bg($U(), Col) ).

// --- $LargestSquare ---
// The largest extent of any figure on either axis.
// @claim output-is-largest-box
.init side = Extremes<Figures>
side.cand(S, N) :- extent([S, _], _, N).

frame.extent([$LargestSquare(), S], A, N) :- side.high(S, N), axis_elem(A).

// --- $UnionFrame ---
// @claim output-is-largest-box
.init span = Extremes<Span>
span.cand([S, A], N) :- extent([S, _], A, N).

frame.extent([$UnionFrame(), S], A, N) :- span.high([S, A], N).

// --- $SquareFigureFrame ---
// The largest side of a figure whose bounding box is a square.
// @claim output-is-largest-box
.init square_side = Extremes<Figures>
square_side.cand(S, N) :- extent([S, Col], A1, N), perp(A1, A2), extent([S, Col], A2, N).

frame.extent([$SquareFigureFrame(), S], A, N) :- square_side.high(S, N), axis_elem(A).

// --- $EveryColorClass ---
mark([$EveryColorClass(), Col], P) :- parse.class_cell($U(), Col, P).

// --- $CountedClasses ---
mark([$CountedClasses(), Col], P) :-
    parse.class_size.item([$U(), Col], P), parse.class_size.tally([$U(), Col], N),
    params.marks_per_figure(N).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).
    parse.bg(E, Col) :- parse.palette.mode(E, Col).

    // The commonest class size in each input.
    .init size_mode = Mode<Example, number, Color>
    size_mode.item(E, N, Col) :- parse.class_size.tally([E, Col], N).

    // A commonest size that some other input does not share.
    .decl unshared(n: number)
    unshared(N) :- size_mode.mode(_, N), size_mode.mode(_, N2), N != N2.

    .decl marks_per_figure(n: number)
    marks_per_figure(N) :- size_mode.mode(_, N), !unshared(N).
}
