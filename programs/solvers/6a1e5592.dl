// 6a1e5592
// draft
// concept: objects move pack
// A wall along one grid edge has notches cut into it, and sprites lie on
// the bg beyond it. The sprites translate to cover the notch cells exactly,
// each sprite used once and landing nowhere on the wall. A sprite's landed
// cells take the fill color and its old cells clear.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl wall(col: Color) wall(2).
    .decl sprite(col: Color) sprite(5).
    .decl fill(col: Color) fill(1).
}

.init params = Params

// The notches: the bg cells inside the wall's box.
.init wall = Bbox<Unit>
wall.cell($U(), P) :- in(P, Col), params.wall(Col).

.decl notch(p: Position)
notch(P) :- wall.box($U(), B), in(P, Col), inside(P, B), params.bg(Col).

.init sprites = Components<Unit>
sprites.node($U(), P) :- in(P, Col), params.sprite(Col).

// A placement of a sprite: a translation landing every cell off the wall.
.init occ = Occurrences<Ident, Unit>
occ.shape(Id, S, $U()) :- sprites.label($U(), S, Id).
occ.cell(Id, P, $U()) :- sprites.label($U(), _, Id), in(P, Col), !params.wall(Col).

// A piece: one sprite at one placement.
.type Piece = [id: Ident, v: Offset]

.decl covers(piece: Piece, p: Position)
covers([Id, V], P) :- occ.occurrence(Id, V), occ.shape(Id, S, $U()), compose(V, S, P).

// --- the forced packing ---

.init forcing = CoverForcing<Unit, Piece>
forcing.covers($U(), Pc, P) :- covers(Pc, P), notch(P).

// A sprite is placed once, and placements do not overlap.
forcing.conflict($U(), [Id, V], [Id, V2]) :-
    occ.occurrence(Id, V), occ.occurrence(Id, V2), V != V2.
forcing.conflict($U(), Pc, Pc2) :- covers(Pc, P), covers(Pc2, P), Pc != Pc2.

// A cell a forced piece lands on.
.decl plugged(p: Position)
plugged(P) :- forcing.forced($U(), Pc), covers(Pc, P).

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), params.wall(Col).
out(P, Col) :- plugged(P), params.fill(Col).
out(P, Col) :-
    in(P, C_in), !params.wall(C_in), !notch(P),  // off the wall and its notches
    !plugged(P), params.bg(Col).                 // no sprite lands here
