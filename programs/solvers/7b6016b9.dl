// 7b6016b9
// draft
// concept: objects enclose
// Bg cells are repainted by whether they reach the grid edge through bg
// cells: outside cells take params.outside_fill, enclosed cells take
// params.fill. Every other cell passes through.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl outside_fill(c: Color) outside_fill(3).
    .decl fill(c: Color) fill(2).
}

.init params = Params

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), params.bg(Col).

.init outside = Reach<Unit>
outside.node($U(), P) :- bg_cell(P).
outside.seed($U(), P) :- bg_cell(P), dir_elem(D), dist(P, D, 0).   // on an edge

.decl out(p: Position, col: Color)
out(P, Col) :-
    bg_cell(P),
    ( outside.reach($U(), P), params.outside_fill(Col)    // reaches the edge
    ; !outside.reach($U(), P), params.fill(Col)           // enclosed
    ).
out(P, Col) :- in(P, Col), !bg_cell(P).
