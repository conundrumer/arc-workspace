// d23f8c26
// @keywords: decompose select
// output: One column is kept. Every other cell becomes bg.

// data-equivalent on this task — odd widths, single middle gap
.type Choice =
    // the grid's center line on the task axis: cells equidistant from that
    // axis's two edges
    Center {}
    // the separator of a uniform 2-split: cells the divide leaves undecomposed
  | Gap {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color)
    bg(0).

    .decl axis(a: Axis)
    axis(AXIS_H).

    // --- Gap ---
    .decl divisor(n: number)
    divisor(2).

    .decl divide_gap(g: number)
    divide_gap(1).
}

.init params = Params

// --- Center ---
.decl on_center(p: Position)
on_center(P) :-
    in(P, _),                                                // grid cell
    params.axis(A), axis_of(D, A),                           // the axis's edges
    dist_pair(P, D, K, K).                                   // equidistant

out(P, Col, $Center()) :- in(P, Col), on_center(P).
out(P, Col, $Center()) :- in(P, _), !on_center(P), params.bg(Col).

// --- Gap ---
.decl tile_cell(p: Position)
tile_cell(P) :-
    in(P, _),                                                          // grid cell
    params.axis(A), params.divisor(N), params.divide_gap(G),           // params
    divide(P, A, N, G, _, _).                                          // lands in a tile

out(P, Col, $Gap()) :- in(P, Col), !tile_cell(P).
out(P, Col, $Gap()) :- tile_cell(P), params.bg(Col).
