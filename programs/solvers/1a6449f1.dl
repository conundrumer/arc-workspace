// 1a6449f1
// @keywords: crop objects border enclose select noise rank
// input: Colored noise fills the grid, and rings of one color sit in it.
// output: The input cropped to the box of the ring inside that holds the most
//  cells.

// what a ring is, and what counts as its inside
.type Choice =
    // a ring is a rectangle drawn by four same-color runs, and its inside is
    // what that rectangle holds strictly within its edges
    Rect {}
    // a ring is any wall of one color, and its inside is the region that wall
    // cuts off from the grid edge
  | Enclose {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// Rings are drawn in ink; the field they sit in is bg.
.decl ink(col: Color)
ink(Col) :- in(_, Col), !params.bg(Col).

// What the winning ring holds.
.decl window(p: Position, ch: Choice)

.init window_bbox = Bbox<Choice>
window_bbox.cell(Ch, P) :- window(P, Ch).

out(P_inner, Col, Ch) :- window_bbox.box(Ch, B), in(P, Col), crop(P, B, P_inner).

// --- Rect ---

.init drect = Outlines<Color>
drect.node(Col, P) :- ink(Col), in(P, Col).

// The inside of each rectangle.
.decl hole(b: Box, p: Position)
hole(B, P) :- drect.box(_, B), in(P, _), interior(P, B).

.init biggest_hole = Mode<Unit, Box, Position>
biggest_hole.item($U(), B, P) :- hole(B, P).

window(P, $Rect()) :- biggest_hole.mode($U(), B), hole(B, P).

// --- Enclose ---

// Each ink color walls the rest of the grid off; a region it closes is a ring's
// inside.
.init closed = Closed<Color>
closed.cell(Col, P) :- ink(Col), in(P, C), C != Col.

.type Region = [col: Color, id: Ident]

.init biggest_region = Mode<Unit, Region, Position>
biggest_region.item($U(), [Col, Id], P) :- closed.region(Col, P, Id).

window(P, $Enclose()) :- biggest_region.mode($U(), [Col, Id]), closed.region(Col, P, Id).
