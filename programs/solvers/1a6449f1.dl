// 1a6449f1
// concept: crop objects border enclose select count
// Colored noise fills the grid, and rings of one color sit in it. The output
// crops the ring whose inside holds the most cells.
//
// $Rect — a ring is a rectangle drawn by four same-color runs, and its inside
//   is what that rectangle holds strictly within its edges.
// $Enclose — a ring is any wall of one color, and its inside is the region
//   that wall cuts off from the grid edge, cropped to the region's own box.

#include "../lib.dl"

.type Choice = Rect {} | Enclose {}

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// Rings are drawn in ink; the field they sit in is bg.
.decl ink(col: Color)
ink(Col) :- in(_, Col), !params.bg(Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- Rect ---

.init drect = Outlines<Color>
drect.node(Col, P) :- ink(Col), in(P, Col).

// The inside of each rectangle.
.decl hole(b: Box, p: Position)
hole(B, P) :- drect.box(_, B), in(P, _), interior(P, B).

.init biggest_hole = Mode<Unit, Box, Position>
biggest_hole.item($U(), B, P) :- hole(B, P).

.init hole_bbox = Bbox<Box>
hole_bbox.cell(B, P) :- biggest_hole.mode($U(), B), hole(B, P).

out(P_inner, Col, $Rect()) :- hole_bbox.box(_, B), in(P, Col), crop(P, B, P_inner).

// --- Enclose ---

// Each ink color walls the rest of the grid off; a region it closes is a ring's
// inside.
.init closed = Closed<Color>
closed.cell(Col, P) :- ink(Col), in(P, C), C != Col.

.type Region = [col: Color, id: Ident]

.decl region(k: Region, p: Position)
region([Col, Id], P) :- closed.region(Col, P, Id).

.init biggest_region = Mode<Unit, Region, Position>
biggest_region.item($U(), K, P) :- region(K, P).

.init region_bbox = Bbox<Region>
region_bbox.cell(K, P) :- biggest_region.mode($U(), K), region(K, P).

out(P_inner, Col, $Enclose()) :- region_bbox.box(_, B), in(P, Col), crop(P, B, P_inner).
