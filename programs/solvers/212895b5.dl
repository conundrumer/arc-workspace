// 212895b5
// keywords: markers cast walk
// input: A solid block of one color sits on a field of scattered lone cells.
// output: The block emits eight arms, one per compass direction. A corner arm
//  casts straight out along its diagonal. A side arm is a turtle: it starts
//  at the middle of its side heading out, steps along its heading, and after
//  each step turns by the rotation the gait gives the phase, so the four
//  side arms are rotated copies of one path. Every arm halts before the
//  first scattered cell it meets, or at the grid edge; the rest of the input
//  is kept.

.decl out(p: Position, col: Color)

.comp Params {
    .decl block(col: Color) block(8).

    // Cells no arm can enter.
    .decl stop(col: Color) stop(5).

    .decl diag_paint(col: Color) diag_paint(2).  // the corner arms
    .decl arm_paint(col: Color) arm_paint(4).  // the side arms

    // The gait: the rotation the heading takes after the step at each phase.
    // The phases are its cycle.
    .decl gait(phase: number, t: C4)
    gait(0, D4_ID). gait(1, D4_CW). gait(2, D4_ID). gait(3, D4_CC).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    .decl block_cell(key: Key, p: Position)
    block_cell(Ky, P) :- cell(Ky, P, Col), params.block(Col).

    // The block's box, so its sides, middles, and corners can be named.
    .init bbox = Bbox<Key>
    bbox.cell(Ky, P) :- block_cell(Ky, P).

    .decl corner(key: Key, p: Position, diag: DiagDir)
    corner(Ky, P, Diag) :- block_cell(Ky, P), bbox.box(Ky, B), box_corner(P, B, Diag).

    // The middle cell of each side of the block, aiming out along that side.
    .decl seed(key: Key, p: Position, d: Dir)
    seed(Ky, P, D) :-
        block_cell(Ky, P), bbox.box(Ky, B), box_edge(P, B, D),    // on side D
        relative(B, P, P_rel),
        perp_dir(D, D2), dist_pair(P_rel, D2, K, K).              // centered across
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- corner arms ---

.init cast = Ray<Unit>
cast.dir($U(), D) :- diag_dir_elem(D).
cast.cell($U(), P) :- in(P, _).
cast.mark($U(), P) :- parse.corner($U(), P, _).
cast.blocked($U(), P) :- in(P, Col), params.stop(Col).

// Each corner's cast out along its own diagonal, the corner itself excluded.
.decl diag_arm(p: Position)
diag_arm(P) :- cast.clear($U(), P, D, K, Src), parse.corner($U(), Src, D), K != 0.

// --- side arms ---

.init cycle = IndexCycle<Unit>
cycle.idx($U(), K) :- params.gait(K, _).

// The turtle: its cell, heading, and phase. Each step moves along the
// heading onto a cell it may enter, then turns by the phase's rotation.
.decl turtle(p: Position, h: Dir, phase: number)
turtle(P, D, 0) :- parse.seed($U(), P, D).
turtle(Q, H2, K2) :-
    turtle(P, H, K), neighbor(P, H, Q), in(Q, Col), !params.stop(Col),  // one step along the heading
    params.gait(K, T), apply_dir(T, H, H2),                             // the phase's rotation
    cycle.succ($U(), K, K2).

// --- output ---

.decl paint(p: Position, col: Color)
paint(P, Col) :- diag_arm(P), params.diag_paint(Col).
paint(P, Col) :- turtle(P, _, _), !parse.block_cell($U(), P), params.arm_paint(Col).

out(P, Col) :- in(P, Col_in), ( paint(P, Col) ; !paint(P, _), Col = Col_in ).

.type ArmKey = [e: Example, d: Dir]
.type ArmPhase = [e: Example, d: Dir, n: number, k: number]

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // A cell of side D's own arm: out from the block, and no further
    // across than out, which is the wedge the corner diagonals bound.
    .decl place(e: Example, d: Dir, p: Position, o: number, s: number)
    place(E, D, P, O, S) :-
        ex_out(E, P, Col), params.arm_paint(Col),                  // a painted cell
        parse.seed(E, P0, D), relative(P0, P, P_rel),              // seen from side D's middle
        opposite(D, D_back), diag_dirs(Diag, A, D_back, _),        // a corner behind the heading
        diag_dist(P_rel, Diag, A, O, S), O > 0, 0 <= S, S <= O.    // steps out, steps across

    // The arm's path order: every step goes out or across, never back.
    .init step_order = Order<ArmKey, Position>
    step_order.elem([E, D], P) :- place(E, D, P, _, _).
    step_order.before([E, D], Q, P) :-
        place(E, D, Q, O1, S1), place(E, D, P, O2, S2),
        O1 <= O2, S1 <= S2, Q != P.

    // The heading that entered each arm cell.
    .decl entered(e: Example, d: Dir, p: Position, r: number, h: Dir)
    entered(E, D, P, R, H) :-
        step_order.rank([E, D], P, R),                     // an arm cell at its rank
        opposite(H, H_back), neighbor(P, H_back, Q),       // where that step came from
        ( step_order.rank([E, D], Q, R2), R2 < R           // the cell one rank back
        ; parse.seed(E, Q, D)                              // the arm's start
        ).

    // A bend: the heading into a cell and the heading out of it, as the
    // rotation between them.
    .decl bend(e: Example, d: Dir, r: number, t: C4)
    bend(E, D, R, T) :-
        entered(E, D, P, R, H), entered(E, D, Q, _, H2), neighbor(P, H2, Q),
        c4_elem(T), apply_dir(T, H, H2).

    // Candidate cycle lengths: the ranks the bends reach.
    .decl cand(n: number)
    cand(N) :- bend(_, _, N, _), N != 0.

    // The rotation an arm's bends show at one phase of a candidate cycle.
    .init phase_turn = Unanimous<ArmPhase, C4>
    phase_turn.item([E, D, N, K], T) :- cand(N), bend(E, D, R, T), stride(R, N, 0, _, K).

    // A cycle length two same-phase bends of one arm contradict.
    .decl broken_cycle(n: number)
    broken_cycle(N) :- phase_turn.clash([_, _, N, _]).

    // The gait is the shortest cycle the arms bear out.
    .init cycle = Extremes<Unit>
    cycle.cand($U(), N) :- cand(N), !broken_cycle(N).

    .decl gait(phase: number, t: C4)
    gait(K, T) :- cycle.low($U(), N), phase_turn.value([_, _, N, K], T).
}
