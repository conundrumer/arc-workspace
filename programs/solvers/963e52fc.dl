// 963e52fc
// The input continues periodically: the output is the grid extended to
// c.scale times its extent along c.dir, each new cell repeating the
// color one period back. A period is a shift along c.dir under which
// the input agrees with itself; the smallest one is used.
//
//   $Line — one period per across-line.
//   $Grid — one period for the whole grid.

#include "../lib.dl"

.type Choice = Line {} | Grid {}

.comp Consts {
    .decl dir(d: Dir)      dir(DIR_R).    // growth direction
    .decl scale(n: number) scale(2).      // output extent multiplier
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Output frame: c.scale copies of the input frame along c.dir.
.init copies = AxisFrame<Unit>
copies.extent($U(), A, N) :- c.dir(D), axis_of(D, A), c.scale(N).

.decl out_cell(p: Position)
out_cell(P_grid_out) :-
    copies.cell($U(), A, P_outer), in(P_grid_in, _),
    concat_slab(P_outer, P_grid_in, A, 0, P_grid_out).

// Input embedded: same distance to the anchor edge, same across-line.
.decl base(p: Position, col: Color)
base(P_grid_out, Col) :-
    out_cell(P_grid_out), in(P_grid_in, Col),
    c.dir(D), opposite(D, O),
    slab_anchor(O, P_grid_in, P_grid_out).

// Candidate periods: proper sub-extents along c.dir.
.decl period_cand(k: number)
period_cand(K) :- in(P, _), c.dir(D), axis_of(D, A), sub_extent(P, A, K).

// An input cell pair K apart along c.dir disagrees, on this across-line.
.decl disagree(line: Position, k: number)
disagree(Line, K) :-
    period_cand(K),
    c.dir(D), jump_delta(D, K, Delta),               // K-shift along dir
    in(P1, C1), compose(P1, Delta, P2), in(P2, C2),  // shifted pair
    C1 != C2,
    axis_of(D, A), split(P1, A, _, Line).            // pair's line

.decl out(p: Position, col: Color, ch: Choice)

// --- Line ---

.decl line(p: Position)
line(Line) :- in(P, _), c.dir(D), axis_of(D, A), split(P, A, _, Line).

.decl line_ok(line: Position, k: number)
line_ok(Line, K) :- line(Line), period_cand(K), !disagree(Line, K).

.decl line_period(line: Position, k: number)
line_period(Line, K) :- line_ok(Line, K), K = min K2 : { line_ok(Line, K2) }.

.decl line_color(p: Position, col: Color)
line_color(P, Col) :- base(P, Col).
line_color(P_grid_out, Col) :-
    line_color(P1, Col),                              // one period back
    c.dir(D), axis_of(D, A), split(P1, A, _, Line),
    line_period(Line, K),
    jump_delta(D, K, Delta), compose(P1, Delta, P_grid_out),
    out_cell(P_grid_out).

out(P, Col, $Line()) :- line_color(P, Col).

// --- Grid ---

.decl grid_ok(k: number)
grid_ok(K) :- period_cand(K), !disagree(_, K).

.decl grid_period(k: number)
grid_period(K) :- grid_ok(K), K = min K2 : { grid_ok(K2) }.

.decl grid_color(p: Position, col: Color)
grid_color(P, Col) :- base(P, Col).
grid_color(P_grid_out, Col) :-
    grid_color(P1, Col), grid_period(K),              // one period back
    c.dir(D), jump_delta(D, K, Delta), compose(P1, Delta, P_grid_out),
    out_cell(P_grid_out).

out(P, Col, $Grid()) :- grid_color(P, Col).

.output out(IO=stdout)
