// 963e52fc
// concept: wallpaper grow
// The input continues periodically: the output is the grid extended to
// params.scale times its extent along params.dir, each new cell repeating the
// color one period back. The period is the shortest shift along params.dir
// under which the input agrees with itself.
//
//   $Line — one period per across-line.
//   $Grid — one period for the whole grid.

#include "../lib.dl"

.type Choice = Line {} | Grid {}

.comp Params {
    .decl dir(d: Dir) dir(DIR_R).         // growth direction
    .decl scale(n: number) scale(2).      // output extent multiplier
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Line()). impl_choice($Grid()).

// Input cell with the across-line it sits on.
.decl cell_line(p: Position, line: Position, col: Color)
cell_line(P, Line, Col) :-
    in(P, Col), params.dir(D), axis_of(D, A), split(P, A, _, Line).

// Output frame: params.scale copies of the input frame along params.dir.
.init copies = AxisFrame<Unit>
copies.extent($U(), A, N) :- params.dir(D), axis_of(D, A), params.scale(N).

.decl out_cell(p: Position)
out_cell(P_grid_out) :-
    copies.cell($U(), A, P_outer), in(P_grid_in, _),
    concat_slab(P_outer, P_grid_in, A, 0, P_grid_out).

// Input embedded at the edge the growth moves away from.
.decl base(p: Position, col: Color)
base(P_grid_out, Col) :-
    out_cell(P_grid_out), in(P_grid_in, Col),
    params.dir(D), opposite(D, O),
    slab_anchor(O, P_grid_in, P_grid_out).

// The period the continuation repeats by, per case and line.
.decl period_at(ch: Choice, line: Position, k: number)

// The input, then each cell repeating the one a period back.
.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- impl_choice(Ch), base(P, Col).
out(P_grid_out, Col, Ch) :-
    out(P, Col, Ch),
    params.dir(D), axis_of(D, A), split(P, A, _, Line),      // the cell's line
    period_at(Ch, Line, K), jump(P, D, K, P_grid_out),
    out_cell(P_grid_out).

// --- $Line ---

.init si_line = ShiftInvariance<Position, Color>
si_line.cell(Line, P, Col) :- cell_line(P, Line, Col).

period_at($Line(), Line, K) :-
    params.dir(D), axis_of(D, A), si_line.min_period(Line, A, K).

// --- $Grid ---

.init si_grid = ShiftInvariance<Unit, Color>
si_grid.cell($U(), P, Col) :- in(P, Col).

// The grid's period, so every line takes it.
period_at($Grid(), Line, K) :-
    cell_line(_, Line, _),
    params.dir(D), axis_of(D, A), si_grid.min_period($U(), A, K).
