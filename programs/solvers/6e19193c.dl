// 6e19193c
// @draft
// @keywords: objects cast bbox
// input: objects on bg, each missing one corner of its bounding box: the tip
// output: From the tip, the object casts a diagonal ray in its own color,
//  away from the box, to the grid edge. The tip cell itself stays blank.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.init objs = Components<Unit>
objs.node($U(), P) :- ink(P).

.decl paint(id: Ident, col: Color)
paint(Id, Col) :- objs.label($U(), P, Id), in(P, Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- objs.label($U(), P, Id).

// The empty corner of an object's box, and the corner it sits at.
.decl tip(id: Ident, p: Position, d: DiagDir)
tip(Id, P, D) :- bbox.box(Id, B), in(P, _), box_corner(P, B, D), !ink(P).

.init ray = Ray<Ident>
ray.dir(Id, D)  :- tip(Id, _, D).
ray.mark(Id, P) :- tip(Id, P, _).
ray.cell(Id, P) :- paint(Id, _), in(P, _).

// Ray cells past the tip, in the caster's color.
.decl trail(p: Position, col: Color)
trail(P, Col) :- ray.ray(Id, P, _, K, _), K != 0, paint(Id, Col).

out(P, Col) :-
    in(P, Col_in),
    ( trail(P, Col)                    // on a trail
    ; !trail(P, _), Col = Col_in       // kept
    ).
