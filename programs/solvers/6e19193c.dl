// 6e19193c
// draft
// concept: objects cast
//
// Arrowheads sit on a blank grid: each object leaves one corner of its
// bounding box empty. That empty corner is the tip. From the tip, the
// object casts a diagonal ray in its own color, away from the box, to the
// grid edge. The tip cell itself stays blank.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.init objs = Components<Unit>
objs.node($U(), P) :- ink(P).

.decl paint(id: Ident, col: Color)
paint(Id, Col) :- objs.label($U(), P, Id), in(P, Col).

.init bbox = BoxFrame<Ident>
bbox.cell(Id, P) :- objs.label($U(), P, Id).
bbox.grid(Id, P) :- paint(Id, _), in(P, _).

// The empty corner of an object's box, and the corner it sits at.
.decl tip(id: Ident, p: Position, d: DiagDir)
tip(Id, P, D) :-
    bbox.inner(Id, P, P_inner), !ink(P),    // a blank cell of the box
    corner_dist(P_inner, D, 0).            // at corner D of the bbox

.init ray = Ray<Ident>
ray.dir(Id, D)  :- tip(Id, _, D).
ray.mark(Id, P) :- tip(Id, P, _).
ray.cell(Id, P) :- paint(Id, _), in(P, _).

// Ray cells past the tip, in the caster's color.
.decl trail(p: Position, col: Color)
trail(P, Col) :- ray.ray(Id, P, _, K, _), K != 0, paint(Id, Col).

.decl out(p: Position, col: Color)
out(P, Col) :-
    in(P, Col_in),
    ( trail(P, Col)                    // on a trail
    ; !trail(P, _), Col = Col_in       // kept
    ).
