// 342dd610
// concept: move
// Each ink color carries a fixed displacement; every ink cell translates
// by its color's jump. The rest of the grid is bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(8).

    .decl move(c: Color, d: Dir, k: number)
    move(7, DIR_T, 2).
    move(9, DIR_B, 2).
    move(2, DIR_L, 2).
    move(1, DIR_R, 1).
}

.init c = Consts

.decl moved(p: Position, col: Color)
moved(P_out, Col) :- in(P_in, Col), c.move(Col, D, K), jump(P_in, D, K, P_out).

.decl out(p: Position, col: Color)
out(P, Col) :- moved(P, Col).
out(P, Col) :- in(P, _), !moved(P, _), c.bg(Col).

// --- fit ---

.comp Fit {
    // The cells that carry a displacement.
    .decl ink(e: Example, p: Position, c: Color)
    ink(E, P, Col) :- ex_in(E, P, Col), !c.bg(Col).

    // One pair's ink of one color.
    .type InkKey = [e: Example, c: Color]

    // Seat each color's ink among its output's cells, color for color.
    .init occ = Occurrences<InkKey, Color>
    occ.shape([E, Col], P_in, Col)    :- ink(E, P_in, Col).
    occ.cell([E, Col], P_out, Col2)   :- ink(E, _, Col), ex_out(E, P_out, Col2).

    // A displacement some train pair carrying that color does not seat.
    .decl broken(c: Color, delta: Shift)
    broken(Col, Delta) :-
        occ.occurrence([_, Col], Delta),    // seats one pair's ink
        ink(E, _, Col), ex_out(E, _, _),    // and a train pair with that color
        !occ.occurrence([E, Col], Delta).   // it misses

    .decl move(c: Color, d: Dir, k: number)
    move(Col, D, K) :-
        occ.occurrence([_, Col], Delta), !broken(Col, Delta),
        dir_elem(D), dist_pair(Delta, D, K1, K), K1 < K,   // the delta leans toward edge d
        jump_delta(D, K, Delta).                           // by k cells
}
