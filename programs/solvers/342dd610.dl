// 342dd610
// concept: move
// Each ink color carries a fixed displacement; every ink cell translates
// by its color's jump. The rest of the grid is bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(8).

    .decl move(c: Color, d: Dir, k: number)
    move(7, DIR_T, 2).
    move(9, DIR_B, 2).
    move(2, DIR_L, 2).
    move(1, DIR_R, 1).
}

.init c = Consts

.decl moved(p: Position, col: Color)
moved(P_out, Col) :-
    in(P_in, Col), c.move(Col, D, K),
    jump_delta(D, K, Delta), compose(P_in, Delta, P_out).

.decl out(p: Position, col: Color)
out(P, Col) :- moved(P, Col).
out(P, Col) :- in(P, _), !moved(P, _), c.bg(Col).

// --- fit ---

.type CellKey = [e: Example, p: Position]

.comp Fit {
    // The cells that carry a displacement.
    .decl ink(e: Example, p: Position, c: Color)
    ink(E, P, Col) :- ex_in(E, P, Col), !c.bg(Col).

    // Candidate displacements: every alignment of an ink cell onto an
    // output cell of its color.
    .init align = Reframe<CellKey>
    align.outer([E, P_in], P_in) :- ink(E, P_in, _).
    align.cell([E, P_in], P_out) :- ink(E, P_in, Col), ex_out(E, P_out, Col).

    .decl cand(c: Color, delta: Shift)
    cand(Col, Delta) :- ink(E, P_in, Col), align.inner([E, P_in], Delta).

    .decl broken(c: Color, delta: Shift)
    broken(Col, Delta) :-
        cand(Col, Delta), ex_out(E, _, _), ink(E, P_in, Col),   // ink cell of a train pair
        compose(P_in, Delta, P_out), !ex_out(E, P_out, Col).

    .decl move(c: Color, d: Dir, k: number)
    move(Col, D, K) :-
        cand(Col, Delta), !broken(Col, Delta),
        dir_elem(D), dist_pair(Delta, D, K1, K), K1 < K,   // the delta leans toward edge d
        jump_delta(D, K, Delta).                           // by k cells
}
