// 28e73c20
// @draft
// @keywords: walk
// output: A spiral is drawn on the grid. The walk starts at a corner cell and
//  travels until its distance to the edge ahead reaches the turn box's margin
//  there, then turns in the spiral's sense. The box starts on the frame edge
//  and insets by the pitch once per cycle. The walk halts where the box has
//  closed past it.
// review principle: Cases — the nested-rings reading of the figure, dropped
//  for claiming the same stopping rule as the shipped spiral walk, now stands
//  unless Fit, Fidelity, or Equivalence removes it, so re-judge it as a case.

// how an off-spiral cell is filled — every input is blank, so this is
// underdetermined
.type Choice =
    // an off-spiral cell keeps its input color
    Passthrough {}
    // an off-spiral cell gets params.bg; the input only carries the frame size
  | Repaint {}

.decl out(p: Position, col: Color, ch: Choice)

.decl impl_choice(ch: Choice)
impl_choice($Passthrough()). impl_choice($Repaint()).

.comp Params {
    .decl ink(col: Color) ink(3).

    // The corner the spiral starts from.
    .decl corner(d: DiagDir) corner(DIAG_TL).

    // The sense the spiral winds in.
    .decl sense(s: Sense) sense(SENSE_CW).

    // Spacing between successive arms.
    .decl pitch(k: number) pitch(2).

    .decl inset(b: Box)
    inset(B) :- pitch(K), uniform_inset(K, B).

    // --- $Repaint ---
    .decl bg(col: Color) bg(0).
}

.init params = Params

// The arm that closes a cycle: the walk turns off it onto the corner's other
// direction.
.decl cycle_end(d: Dir)
cycle_end(D) :- params.corner(C), diag_dirs(C, _, D, D2), params.sense(S), turn(S, D, D2).

// A step of the walk: at p, traveling toward d, turning on the margins of
// box b.
.type Step = [p: Position, d: Dir, b: Box]

// The turn boxes: the frame, and each box inset from it on every side.
.decl turn_box(b: Box)
turn_box(ZERO).
turn_box(B) :- in(P, _), axis_elem(A), sub_extent(P, A, K), uniform_inset(K, B).

.init spiral = GraphDistance<Unit, Step>
spiral.seed($U(), [P, D, ZERO]) :-
    in(P, _), params.corner(C), corner_dist(P, C, 0),   // the corner cell
    cycle_end(D_end), opposite(D_end, D).               // the first arm runs against the closing one
spiral.edge($U(), [P, D, B], [P2, D2, B2]) :-
    in(P, _), dir_elem(D), turn_box(B),
    ( nearer(D, B, P), D2 = D, B2 = B, neighbor(P, D, P2)            // short of the margin: one step on
    ; same_dist(D, B, P), P2 = P, params.sense(S), turn(S, D, D2),   // on it: turn in the spiral's sense
      ( cycle_end(D), params.inset(B_inset), compose(B, B_inset, B2)
      ; !cycle_end(D), B2 = B )
    ).

// The cells the walk reaches.
.decl walk(p: Position)
walk(P) :- spiral.distance($U(), [P, _, _], _).

out(P, Col, Ch) :- walk(P), params.ink(Col), impl_choice(Ch).

// --- $Passthrough ---
out(P, Col, $Passthrough()) :- in(P, Col), !walk(P).

// --- $Repaint ---
out(P, Col, $Repaint()) :- in(P, _), !walk(P), params.bg(Col).
