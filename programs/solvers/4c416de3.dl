// 4c416de3
// draft
// concept: objects markers d4 induce stamp
// Outlines drawn in params.frame bound boxes. A box corner may seat a stamp: a
// one-color shape drawn around that corner. At least one corner carries its
// stamp whole; the others carry a single cell of it, or nothing. The output
// completes every started stamp: that shape carried onto the corner, in the
// color of the cell already drawn there.

#include "../lib.dl"

.comp Params {
    // The color the outlines are drawn in.
    .decl frame(col: Color) frame(0).
}

.init params = Params

.init bg = Mode<Unit, Color, Position>
bg.item($U(), Col, P) :- in(P, Col).

// --- the outlines ---

.decl drawn(p: Position)
drawn(P) :- in(P, Col), params.frame(Col).

// A cell the outline runs through: drawn, or a one-cell break in a drawn line.
.decl outline(p: Position)
outline(P) :- drawn(P).
outline(P) :-
    in(P, _), opposite(D, D2),               // a line through P
    neighbor(P, D, Q), drawn(Q),             // drawn on one side
    neighbor(P, D2, Q2), drawn(Q2).          // and on the other

.init frames = Components<Unit>
frames.node($U(), P) :- outline(P).

.init boxes = BoxFrame<Ident>
boxes.cell(Id, P) :- frames.label($U(), P, Id).
boxes.grid(Id, P) :- boxes.cell(Id, _), in(P, _).

// A corner of an outline's box, whether or not the outline occupies it.
.decl site(p: Position, d: DiagDir)
site(P, D) :- boxes.inner(_, P, P_box), corner_dist(P_box, D, 0).

// --- the stamps ---

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.frame(Col), !bg.mode($U(), Col).

.init marks = Components8<Color>
marks.node(Col, P) :- ink(P, Col).

.init mark_boxes = Bbox<Ident>
mark_boxes.cell(Id, P) :- marks.label(_, P, Id).
mark_boxes.grid(Id, P) :- mark_boxes.cell(Id, _), in(P, _).

// A stamp drawn whole surrounds its site; the shape is the offsets of its
// cells from that site.
.decl shape(d: DiagDir, v: Shift)
shape(D, V) :-
    site(P_site, D), mark_boxes.inside(Id, P_site),     // a site a shape surrounds
    marks.label(_, P, Id), displacement(P_site, P, V).  // and a cell of that shape

// The stamp at a site: the whole shape carried onto this corner.
.decl stamp(p_site: Position, p: Position)
stamp(P_site, P) :-
    site(P_site, D), shape(D_whole, V),         // the shape, at its own corner
    apply_diag_dir(G, D_whole, D),              // carried onto this corner
    apply(G, V, V_here), compose(P_site, V_here, P).

.decl painted(p: Position, col: Color)
painted(P, Col) :-
    stamp(P_site, P),               // a cell of the stamp at a site
    stamp(P_site, Q), ink(Q, Col).  // in the color of the part already drawn

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, _), painted(P, Col).
out(P, Col) :- in(P, Col), !painted(P, _).
