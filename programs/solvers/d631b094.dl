// d631b094
// keywords: count
// output: Cells of one color on bg. Output is a 1-cell-wide bar of that color
//  along params.bar_axis, extent = the cell count.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl bar_axis(a: Axis) bar_axis(AXIS_H).
}

.init params = Params

.decl on(p: Position, col: Color)
on(P, Col) :- in(P, Col), !params.bg(Col).

.init total = Tally<Unit, Position>
total.item($U(), P) :- on(P, _).

.init bar = AxisFrame<Unit>
bar.extent($U(), A, N) :- params.bar_axis(A), total.tally($U(), N).

out(P, Col) :- bar.cell($U(), _, P), on(_, Col).
