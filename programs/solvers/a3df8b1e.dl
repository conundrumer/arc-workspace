// a3df8b1e
// @keywords: markers walk
// input: A lone marker sits in a corner.
// output: A diagonal ray leaves it, reflecting off the side walls, and stops
//  at the far edge. The output draws the ray's trace on the background.

// how the ray's advance direction and heading are set
.type DirCase =
    // reads the advance dir from the parameters
    Stored {}
    // derives both from the corner the marker sits in
  | Seat {}

// what color the ray draws
.type InkCase =
    // draws in the marker's color
    Prop {}
    // draws in a stored color
  | Fixed {}

.type Choice = [dir: DirCase, ink: InkCase]

// A state of the bouncing walk: a cell with a heading across the advance axis.
.type Beam = [p: Position, h: Dir]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- $Stored ---
    .decl dir(d: Dir) dir(DIR_T).

    // --- $Seat ---
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Fixed ---
    .decl ink(col: Color) ink(1).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice([$Stored(), $Prop()]). impl_choice([$Stored(), $Fixed()]).
impl_choice([$Seat(), $Prop()]).   impl_choice([$Seat(), $Fixed()]).

// The marker: the lone non-bg cell.
.decl seed(p: Position, col: Color)
seed(P, Col) :- in(P, Col), !params.bg(Col).

// Advance dir and initial heading per direction case.
.decl launch(dc: DirCase, u: Dir, h: Dir)
// The marker sits against both side walls, so a heading into a wall flips at
// the first step and the two headings draw one trace. The heading is not
// observable, and the program takes both.
launch($Stored(), U, H) :- params.dir(U), perp_dir(U, H).
launch($Seat(), U, H) :-
    seed(P, _), corner_dist(P, Diag, 0),        // the corner the marker sits in
    diag_opposite(Diag, Opp),                   // ray leaves toward the opposite corner
    params.axis(A), diag_dirs(Opp, A, U, H).    // advance along the axis, heading across it

.init trace = Propagation<DirCase, Beam>
trace.source(DC, [P, H]) :- launch(DC, _, H), seed(P, _).
trace.edge(DC, [P, H], [P2, H2]) :-
    launch(DC, U, _), perp_dir(U, H), in(P, _),
    ( dist(P, H, 0), opposite(H, H2), P2 = P      // reflect off the side wall
    ; !dist(P, H, 0), !dist(P, U, 0),             // room toward the heading and the advance edge
      diag_dirs(Diag, _, U, H),                   // the diagonal U and H span
      neighbor(P, Diag, P2), H2 = H
    ).

.decl traced(dc: DirCase, p: Position)
traced(DC, P) :- trace.reached(DC, [P, _]).

out(P, Col, [DC, $Prop()])  :- traced(DC, P), seed(_, Col).
out(P, Col, [DC, $Fixed()]) :- traced(DC, P), params.ink(Col).
out(P, Col, [DC, IC]) :- impl_choice([DC, IC]), in(P, _), !traced(DC, P), params.bg(Col).
