// d13f3404
// @keywords: grow cast
// output: A 3×3 pattern sits on a larger square canvas. The pattern seats
//  flush at the corner opposite params.sweep. Every seated ink cell casts a
//  diagonal ray toward params.sweep, sliding the pattern one diagonal step
//  per copy and trailing its ink. Cells on no ray are bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl sweep(d: DiagDir) sweep(DIAG_BR).
    .decl side(n: number) side(6).
}

.init params = Params

.init frame = Frame2D<Unit>
frame.extent($U(), A, N) :- axis_elem(A), params.side(N).

// Ink seated in the output frame, flush at the corner opposite params.sweep.
.decl seated(p: Position, col: Color)
seated(P_out, Col) :-
    in(P_in, Col), !params.bg(Col),                     // ink cell
    frame.cell($U(), P_out),
    params.sweep(Diag), diag_opposite(Diag, Anchor),    // seat corner
    corner_anchor(Anchor, P_in, P_out).

.init rays = Ray<Unit>
rays.dir($U(), D)  :- params.sweep(D).
rays.cell($U(), P) :- frame.cell($U(), P).
rays.mark($U(), P) :- seated(P, _).

out(P, Col) :- rays.ray($U(), P, _, _, Q), seated(Q, Col).
out(P, Col) :- frame.cell($U(), P), !rays.ray($U(), P, _, _, _), params.bg(Col).
