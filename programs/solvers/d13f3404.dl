// d13f3404
// concept: grow cast
// A 3×3 pattern on a larger square canvas: the pattern seats flush at the
// corner opposite c.sweep, and every seated ink cell casts a diagonal ray
// toward c.sweep — the pattern sliding one diagonal step per copy, trailing
// its ink. Cells on no ray are bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(col: Color) bg(0).
    .decl sweep(d: DiagDir) sweep(DIAG_BR).
    .decl side(n: number) side(6).
}

.init c = Consts

.init frame = Frame2D<Unit>
frame.extent($U(), A, N) :- axis_elem(A), c.side(N).

// Ink seated in the output frame, flush at the corner opposite c.sweep.
.decl seated(p: Position, col: Color)
seated(P_out, Col) :-
    in(P_in, Col), !c.bg(Col),                     // ink cell
    frame.cell($U(), P_out),
    c.sweep(Diag), diag_opposite(Diag, Anchor),    // seat corner
    corner_anchor(Anchor, P_in, P_out).

.init rays = Ray<Unit>
rays.dir(D)        :- c.sweep(D).
rays.cell($U(), P) :- frame.cell($U(), P).
rays.mark($U(), P) :- seated(P, _).

.decl out(p: Position, col: Color)
out(P, Col) :- rays.ray($U(), P, _, _, Q), seated(Q, Col).
out(P, Col) :- frame.cell($U(), P), !rays.ray($U(), P, _, _, _), c.bg(Col).
