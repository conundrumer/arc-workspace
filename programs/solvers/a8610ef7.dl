// a8610ef7
// concept: symmetry lookup classify
// Recolor each non-bg cell by its image under c.mirror. Two models:
//
//   $Direct — binary classification: bg passes through; non-bg → c.matched
//             or c.unmatched by whether the mirror image is non-bg
//   $Lookup — table on (self_color, mirror_color) → out_color

#include "../lib.dl"

.type Choice = Direct {} | Lookup {}

.comp Consts {
    // --- shared ---
    .decl mirror(d: D4) mirror(D4_TB).

    // --- Direct ---
    .decl bg(c: Color) bg(0).
    .decl matched(c: Color) matched(2).
    .decl unmatched(c: Color) unmatched(5).

    // --- Lookup ---
    .decl recolor(c_self: Color, c_mirror: Color, c_out: Color)
    recolor(0, 0, 0).
    recolor(0, 8, 0).
    recolor(8, 0, 5).
    recolor(8, 8, 2).
}

.init c = Consts

.decl out(p: Position, col: Color, c: Choice)

// --- Direct ---

.decl non_bg(p: Position)
non_bg(P) :- in(P, Col), !c.bg(Col).

out(P, Col, $Direct()) :- in(P, Col), c.bg(Col).
out(P, Col_out, $Direct()) :-
    non_bg(P), c.mirror(D), apply(D, P, P_m),   // non-bg cell, its mirror image
    ( non_bg(P_m), c.matched(Col_out)           // image is also non-bg
    ; !non_bg(P_m), c.unmatched(Col_out)        // image is bg
    ).

// --- Lookup ---

out(P, Col_out, $Lookup()) :-
    in(P, C_self),                                       // input cell color
    c.mirror(D), apply(D, P, P_m), in(P_m, C_mirror),    // mirror cell color
    c.recolor(C_self, C_mirror, Col_out).

// --- fit ---

.comp Fit {
    // A cell's color, its image's color under a transform, and the color the output paints it.
    .decl pair_color(d: D4, c_self: Color, c_mirror: Color, col: Color)
    pair_color(D, C, C_m, Col) :-
        d4_elem(D),
        ex_in(E, P, C), apply(D, P, P_m), ex_in(E, P_m, C_m),   // cell and its image
        ex_out(E, P, Col).

    // A transform that paints one color pair two ways.
    .decl mismatch(d: D4)
    mismatch(D) :- pair_color(D, C, C_m, Col), pair_color(D, C, C_m, Col2), Col != Col2.

    .decl mirror(d: D4)
    mirror(D) :- d4_elem(D), !mismatch(D).

    .decl recolor(c_self: Color, c_mirror: Color, c_out: Color)
    recolor(C, C_m, Col) :- c.mirror(D), pair_color(D, C, C_m, Col).

    .decl matched(c: Color)
    matched(Col) :- c.mirror(D), pair_color(D, C, C_m, Col), !c.bg(C), !c.bg(C_m).

    .decl unmatched(c: Color)
    unmatched(Col) :- c.mirror(D), pair_color(D, C, C_m, Col), !c.bg(C), c.bg(C_m).
}
