// a8610ef7
// keywords: symmetry lookup classify
// output: Recolor each cell by its own color and the color of its image under
//  params.mirror.

// which model recolors a cell from its own color and its image's color
.type Choice =
    // bg passes through; a non-bg cell takes params.matched or params.unmatched
    // by whether its image is non-bg
    Direct {}
    // a stored table takes the two colors to the output color
  | Lookup {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl mirror(d: D4) mirror(D4_TB).

    // --- Direct ---
    .decl bg(c: Color) bg(0).
    .decl matched(c: Color) matched(2).
    .decl unmatched(c: Color) unmatched(5).

    // --- Lookup ---
    .decl recolor(c_self: Color, c_mirror: Color, c_out: Color)
    recolor(0, 0, 0).
    recolor(0, 8, 0).
    recolor(8, 0, 5).
    recolor(8, 8, 2).
}

.init params = Params

// --- Direct ---

.decl non_bg(p: Position)
non_bg(P) :- in(P, Col), !params.bg(Col).

out(P, Col, $Direct()) :- in(P, Col), params.bg(Col).
out(P, Col_out, $Direct()) :-
    non_bg(P), params.mirror(D), apply(D, P, P_m),   // non-bg cell, its mirror image
    ( non_bg(P_m), params.matched(Col_out)           // image is also non-bg
    ; !non_bg(P_m), params.unmatched(Col_out)        // image is bg
    ).

// --- Lookup ---

out(P, Col_out, $Lookup()) :-
    in(P, C_self),                                            // input cell color
    params.mirror(D), apply(D, P, P_m), in(P_m, C_mirror),    // mirror cell color
    params.recolor(C_self, C_mirror, Col_out).

.type ColorPair = [d: D4, c_self: Color, c_mirror: Color]

.comp Determine {
    // The color the output paints a cell. The key is the cell's own color and
    // the color of its image under a transform.
    .init pair_color = Unanimous<ColorPair, Color>
    pair_color.item([D, C, C_m], Col) :-
        d4_elem(D),
        ex_in(E, P, C), apply(D, P, P_m), ex_in(E, P_m, C_m),   // cell and its image
        ex_out(E, P, Col).

    // A transform that paints one color pair two ways.
    .decl mismatch(d: D4)
    mismatch(D) :- pair_color.clash([D, _, _]).

    .decl mirror(d: D4)
    mirror(D) :- d4_elem(D), !mismatch(D).

    .decl recolor(c_self: Color, c_mirror: Color, c_out: Color)
    recolor(C, C_m, Col) :- params.mirror(D), pair_color.value([D, C, C_m], Col).

    // The table's non-bg entries, split by whether the image is non-bg.
    .decl matched(c: Color)
    matched(Col) :- recolor(C, C_m, Col), !params.bg(C), !params.bg(C_m).

    .decl unmatched(c: Color)
    unmatched(Col) :- recolor(C, C_m, Col), !params.bg(C), params.bg(C_m).
}
