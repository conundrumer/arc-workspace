// 99fa7670
// @keywords: markers cast occlude
// output: Each ink dot fills its line from itself to the params.dir edge; there
//  the fill bends with params.sense and runs along the edge through bg,
//  occluded by the next dot's fill.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_R).           // fill direction
    .decl sense(s: Sense) sense(SENSE_CW).  // bend at the edge
}

.init params = Params

// Line fill: each dot casts its color toward params.dir through bg; the next
// dot occludes.
.init legs = Ray<Unit>
legs.dir($U(), D) :- params.dir(D).
legs.cell($U(), P) :- in(P, _).
legs.mark($U(), P) :- in(P, Col), !params.bg(Col).
legs.blocked($U(), P) :- in(P, Col), !params.bg(Col).

.decl leg(p: Position, col: Color)
leg(P, Col) :- legs.clear($U(), P, _, _, Src), in(Src, Col).

// At the params.dir edge the fill bends and runs along the edge; legs occlude.
.init bends = Ray<Unit>
bends.dir($U(), D2) :- params.dir(D), params.sense(S), turn(S, D, D2).  // bent direction
bends.cell($U(), P) :- in(P, _).
bends.mark($U(), P) :- leg(P, _), params.dir(D), dist(P, D, 0).        // filled edge cell
bends.blocked($U(), P) :- leg(P, _).

.decl bend(p: Position, col: Color)
bend(P, Col) :- bends.clear($U(), P, _, _, Src), leg(Src, Col).

out(P, Col) :- leg(P, Col).
out(P, Col) :- bend(P, Col).
out(P, Col) :- in(P, Col), !leg(P, _), !bend(P, _).
