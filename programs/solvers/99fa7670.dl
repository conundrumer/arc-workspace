// 99fa7670
// Each ink dot fills its line from itself to the c.dir edge; there the fill
// bends with c.sense and runs along the edge through bg, occluded by the
// next dot's fill.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)      bg(0).
    .decl dir(d: Dir)       dir(DIR_R).       // fill direction
    .decl sense(s: Sense)   sense(SENSE_CW).  // bend at the edge
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Line fill: color flows stepwise through bg toward c.dir; a dot occludes.
.decl leg(p: Position, col: Color)
leg(P, Col) :- in(P, Col), !c.bg(Col).
leg(P2, Col) :-
    leg(P, Col),                                    // colored cell
    c.dir(D), step_delta(D, S), compose(P, S, P2),  // neighbor toward c.dir
    in(P2, Bg), c.bg(Bg).                           // still bg — a dot occludes

// At the c.dir edge the fill bends and runs through bg; legs occlude.
.decl bend(p: Position, col: Color)
bend(P, Col) :- leg(P, Col), c.dir(D), dist(P, D, 0).
bend(P2, Col) :-
    bend(P, Col),                                   // filled edge cell
    c.dir(D), c.sense(S), turn(S, D, D2),           // bent direction
    step_delta(D2, Step), compose(P, Step, P2),     // neighbor along the edge
    in(P2, _), !leg(P2, _).                         // unfilled — a leg occludes

.decl out(p: Position, col: Color)
out(P, Col) :- leg(P, Col).
out(P, Col) :- bend(P, Col).
out(P, Col) :- in(P, Col), !leg(P, _), !bend(P, _).

.output out(IO=stdout)
