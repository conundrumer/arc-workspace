// 99fa7670
// keywords: markers cast
// output: Each ink dot fills its line from itself to the params.dir edge; there
//  the fill bends with params.sense and runs along the edge through bg,
//  occluded by the next dot's fill.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_R).           // fill direction
    .decl sense(s: Sense) sense(SENSE_CW).  // bend at the edge
}

.init params = Params

// Line fill: color flows stepwise through bg toward params.dir; a dot occludes.
.decl leg(p: Position, col: Color)
leg(P, Col) :- in(P, Col), !params.bg(Col).
leg(P2, Col) :-
    leg(P, Col),                            // colored cell
    params.dir(D), neighbor(P, D, P2),
    in(P2, Bg), params.bg(Bg).                   // still bg — a dot occludes

// At the params.dir edge the fill bends and runs through bg; legs occlude.
.decl bend(p: Position, col: Color)
bend(P, Col) :- leg(P, Col), params.dir(D), dist(P, D, 0).
bend(P2, Col) :-
    bend(P, Col),                                     // filled edge cell
    params.dir(D), params.sense(S), turn(S, D, D2),   // bent direction
    neighbor(P, D2, P2),
    in(P2, _), !leg(P2, _).                 // unfilled — a leg occludes

out(P, Col) :- leg(P, Col).
out(P, Col) :- bend(P, Col).
out(P, Col) :- in(P, Col), !leg(P, _), !bend(P, _).
