// 1e81d6f9
// @keywords: objects markers select
// input: a marker cell sits at params.target_offset from params.target_corner.
// output: the marker's color is erased to params.bg outside what is kept.

// what is kept
.type Choice =
    // the marker cell alone
    Marker {}
    // the bounding box of the mask region at the corner
  | Bbox {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl target_corner(d: DiagDir) target_corner(DIAG_TL).
    .decl target_offset(off: number) target_offset(1).
    .decl bg(c: Color) bg(0).

    // --- $Bbox ---
    .decl mask_color(c: Color) mask_color(5).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Marker()). impl_choice($Bbox()).

.decl target_pos(p: Position)
target_pos(P) :-
    in(P, _), params.target_corner(Diag), params.target_offset(K),
    diag_dist(P, Diag, _, K, K).    // that far from both edges of the corner

.decl target_color(c: Color)
target_color(Col) :- in(P, Col), target_pos(P).

// The cells each case keeps; the target color survives nowhere else.
.decl kept(p: Position, ch: Choice)

out(P, Col_out, Ch) :-
    in(P, Col), impl_choice(Ch),                            // grid cell, per case
    ( !target_color(Col), Col_out = Col                     // non-target — passes
    ; kept(P, Ch), Col_out = Col                            // kept — stays
    ; target_color(Col), !kept(P, Ch), params.bg(Col_out)   // target elsewhere — erased
    ).

// --- $Marker ---

kept(P, $Marker()) :- target_pos(P).

// --- $Bbox ---

.decl mask(p: Position)
mask(P) :- in(P, MaskCol), params.mask_color(MaskCol).

// The mask region at the corner: the component touching the corner's two edges,
// so a stray mask cell elsewhere stays out.
.init region = Reach<Unit>
region.node($U(), P) :- mask(P).
region.seed($U(), P) :- mask(P), params.target_corner(Diag), dir_of(Diag, _, D), dist(P, D, 0).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- region.reach($U(), P).

kept(P, $Bbox()) :- in(P, _), bbox.box($U(), B), inside(P, B).
