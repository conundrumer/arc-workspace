// 1e81d6f9
// A marker cell at c.target_offset inside a corner-anchored L of c.mask_color
// identifies a target color; that color is erased to c.bg everywhere else. Two
// models of what survives the erase:
//
//   $Marker — only the marker cell is kept.
//   $Bbox   — the whole region is kept: the connected component of mask cells at
//             the corner (so a stray mask cell elsewhere can't inflate it),
//             bounded to its bounding box.

#include "../lib.dl"

// Connected component: closure of 4-adjacency over a node set, from seeds.
// Candidate lib component.
.comp Reach {
    .decl node(p: Position)
    .decl seed(p: Position)

    .decl step(delta: Position)
    step([-1,  1,  0,  0]).   // toward DIR_T
    step([ 1, -1,  0,  0]).   // toward DIR_B
    step([ 0,  0, -1,  1]).   // toward DIR_L
    step([ 0,  0,  1, -1]).   // toward DIR_R

    .decl reach(p: Position)
    reach(P)  :- seed(P).
    reach(P2) :- reach(P1), step(D), compose(P1, D, P2), node(P2).
}

.type Choice = Marker {} | Bbox {}

.comp Consts {
    .decl target_corner(d: DiagDir)       target_corner(DIAG_TL).
    .decl target_offset(off: Dim)         target_offset([1, 1]).
    .decl bg(c: Color)                    bg(0).
    .decl mask_color(c: Color)            mask_color(5).

    // Anchor Position: target_offset on each cardinal Dir of target_corner.
    .decl target_anchor(p: Position)
    target_anchor(P) :-
        target_corner(Diag),
        target_offset([V, H]),
        dir_of(Diag, AXIS_V, D_v), edge_delta(D_v, V, P_v),
        dir_of(Diag, AXIS_H, D_h), edge_delta(D_h, H, P_h),
        compose(P_v, P_h, P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// --- shared: the marker identifies the target color ---

.decl target_pos(p: Position)
target_pos(P) :-
    in(P, _),                                              // input cell
    c.target_corner(Diag), c.target_anchor(P_anchor),      // marker anchor
    corner_anchor(Diag, P_anchor, P).                      // match at corner

.decl target_color(c: Color)
target_color(Col) :- in(P, Col), target_pos(P).

// --- Bbox: the connected corner region of mask cells, bounded ---

.decl mask(p: Position)
mask(P) :- in(P, MaskCol), c.mask_color(MaskCol).

// The frame's connected component, seeded from a mask cell on a corner edge —
// a stray mask cell elsewhere doesn't touch those edges, so it stays out.
.init region = Reach
region.node(P) :- mask(P).
region.seed(P) :- mask(P), c.target_corner(Diag), dir_of(Diag, _, D), dist(P, D, 0).

// The region's bounding box over the input grid.
.init box = Bbox<Unit>
box.cell($U(), P) :- region.reach(P).
box.grid($U(), P) :- in(P, _).

.decl out(p: Position, col: Color, c: Choice)

// --- Marker --- only the marker cell survives the erase.
out(P, Col, $Marker()) :- in(P, Col), !target_color(Col).                          // non-target passes
out(P, Col, $Marker()) :- in(P, Col), target_pos(P).                               // marker kept
out(P, Bg, $Marker()) :- in(P, Col), target_color(Col), !target_pos(P), c.bg(Bg).  // target elsewhere erased

// --- Bbox --- the whole corner region survives the erase.
out(P, Col, $Bbox()) :- in(P, Col), !target_color(Col).                            // non-target passes
out(P, Col, $Bbox()) :- in(P, Col), box.inside($U(), P).                              // region kept
out(P, Bg, $Bbox()) :- in(P, Col), target_color(Col), !box.inside($U(), P), c.bg(Bg). // target outside region erased

.output out(IO=stdout)
