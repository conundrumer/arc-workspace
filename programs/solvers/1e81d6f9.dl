// Marker cell at c.target_offset from c.target_corner identifies a target
// color; cells of that color elsewhere in the grid are erased to c.bg. The
// marker cell itself is kept.

#include "../lib.dl"

.comp Consts {
    .decl target_corner(d: DiagDir)       target_corner(TOP_LEFT).
    .decl target_offset(off: Dim)         target_offset([1, 1]).
    .decl bg(c: Color)                    bg(0).

    // Anchor Position: target_offset on each cardinal Dir of target_corner.
    .decl target_anchor(p: Position)
    target_anchor(P) :-
        target_corner(Diag),
        target_offset([V, H]),
        dir_of(Diag, VERTICAL, D_v), edge_delta(D_v, V, P_v),
        dir_of(Diag, HORIZONTAL, D_h), edge_delta(D_h, H, P_h),
        compose(P_v, P_h, P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Input cell at the marker position.
.decl target_pos(p: Position)
target_pos(P) :-
    in(P, _),                                              // input cell
    c.target_corner(Diag), c.target_anchor(P_anchor),      // marker anchor
    corner_anchor(Diag, P_anchor, P).                      // match at corner

.decl target_color(c: Color)
target_color(Col) :- in(P, Col), target_pos(P).

// Three cases: non-target color passes through; marker cell passes through;
// target color elsewhere erases to bg.
.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), !target_color(Col).
out(P, Col) :- in(P, Col), target_pos(P).
out(P, Bg) :- in(P, Col), target_color(Col), !target_pos(P), c.bg(Bg).

.output out(IO=stdout)

// TODO ($Bbox alt): add a model that keeps an entire corner-anchored
// region intact (not just the marker cell), with the region derived from
// mask_color cells in the input. Naive bbox of all mask cells fails on
// train[2] — a stray 5 at (9, 6) inflates the bbox past the L. Needs
// connected-component closure from a corner-edge mask cell to isolate the
// L before taking bbox.
