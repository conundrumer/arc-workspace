// 1e81d6f9
// concept: objects markers select
// A marker cell at c.target_offset inside a corner-anchored L of c.mask_color
// identifies a target color; that color is erased to c.bg everywhere else. Two
// models of what is kept:
//
//   $Marker — only the marker cell is kept.
//   $Bbox   — the whole region is kept: the connected component of mask cells at
//             the corner (so a stray mask cell elsewhere cannot extend it),
//             bounded to its bounding box.

#include "../lib.dl"

.type Choice = Marker {} | Bbox {}

.comp Consts {
    .decl target_corner(d: DiagDir) target_corner(DIAG_TL).
    .decl target_offset(off: number) target_offset(1).
    .decl bg(c: Color) bg(0).
    .decl mask_color(c: Color) mask_color(5).

    // Anchor Position: target_offset on each cardinal Dir of target_corner.
    .decl target_anchor(p: Position)
    target_anchor(P) :-
        target_corner(Diag), target_offset(K),
        diag_dirs(Diag, _, D1, D2),
        edge_delta(D1, K, P1), edge_delta(D2, K, P2),
        compose(P1, P2, P).
}

.init c = Consts

// --- shared: the marker identifies the target color ---

.decl target_pos(p: Position)
target_pos(P) :-
    in(P, _),                                              // input cell
    c.target_corner(Diag), c.target_anchor(P_anchor),      // marker anchor
    corner_anchor(Diag, P_anchor, P).                      // match at corner

.decl target_color(c: Color)
target_color(Col) :- in(P, Col), target_pos(P).

// --- Bbox: the connected corner region of mask cells, bounded ---

.decl mask(p: Position)
mask(P) :- in(P, MaskCol), c.mask_color(MaskCol).

// The frame's connected component, seeded from a mask cell on a corner edge;
// a stray mask cell elsewhere does not touch those edges, so it stays out.
.init region = Reach<Unit>
region.node($U(), P) :- mask(P).
region.seed($U(), P) :- mask(P), c.target_corner(Diag), dir_of(Diag, _, D), dist(P, D, 0).

// The region's bounding box over the input grid.
.init box = Bbox<Unit>
box.cell($U(), P) :- region.reach($U(), P).
box.grid($U(), P) :- in(P, _).

.decl out(p: Position, col: Color, c: Choice)

// --- Marker --- only the marker cell is kept.
out(P, Col_out, $Marker()) :-
    in(P, Col),                                              // grid cell
    ( !target_color(Col), Col_out = Col                      // non-target — passes
    ; target_pos(P), Col_out = Col                           // the marker — kept
    ; target_color(Col), !target_pos(P), c.bg(Col_out)       // target elsewhere — erased
    ).

// --- Bbox --- the whole corner region is kept.
out(P, Col_out, $Bbox()) :-
    in(P, Col),                                                    // grid cell
    ( !target_color(Col), Col_out = Col                            // non-target — passes
    ; box.inside($U(), P), Col_out = Col                           // in the region — kept
    ; target_color(Col), !box.inside($U(), P), c.bg(Col_out)       // target outside — erased
    ).
