// Layout: 5×5 input X-pattern collapsed to dense 3×3. Three D4 orbits:
// outer corners, inner X cells, center.
//
// Cartesian over body impls; out's choice column tags each:
//
//   $LabeledGrids() — paired by shared non-zero label across in/out grids
//   $Orbit()        — pair input/output canonicals by orbit; same D4 rotation on both

#include "../lib.dl"

.type Choice = LabeledGrids {} | Orbit {}

.comp Consts {
    // --- LabeledGrids data ----------------------------------------------
    .decl in_label(p: Position, lbl: number)
    GRID_5x5(in_label,
        1, 0, 0, 0, 3,
        0, 2, 0, 4, 0,
        0, 0, 9, 0, 0,
        0, 8, 0, 6, 0,
        7, 0, 0, 0, 5)

    .decl out_label(p: Position, lbl: number)
    GRID_3x3(out_label,
        1, 2, 3,
        8, 9, 4,
        7, 6, 5)

    // --- Orbit canonicals + rotation subgroup ---------------------------
    // Orbits indexed by id; canonical input and output paired by orbit id.
    // TODO: remove
    .decl orbit_in(p: Position, orbit: number)
    orbit_in([0, 4, 0, 4], 0).        // outer corner canonical
    orbit_in([1, 3, 1, 3], 1).        // inner X canonical
    orbit_in([2, 2, 2, 2], 2).        // center

    .decl orbit_out(p: Position, orbit: number)
    orbit_out([0, 2, 0, 2], 0).       // outer corner canonical
    orbit_out([0, 2, 1, 1], 1).       // outer ring edge canonical
    orbit_out([1, 1, 1, 1], 2).       // center

    .decl rotation(d: D4)
    rotation(IDENTITY).
    rotation(ROT_CW).
    rotation(ROT_180).
    rotation(ROT_CCW).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl impl_choice(c: Choice)
impl_choice($LabeledGrids()).
impl_choice($Orbit()).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :-
    c.in_label(P_grid_in, Lbl), c.out_label(P_grid_out, Lbl),  // shared label
    Lbl != 0.                                                  // non-pairing sentinel
perm(P_grid_in, P_grid_out, $Orbit()) :-
    c.rotation(D),                                                          // rotation
    c.orbit_in(P_grid_in_c, O),   apply(D, P_grid_in_c, P_grid_in),         // input side
    c.orbit_out(P_grid_out_c, O), apply(D, P_grid_out_c, P_grid_out).       // output side

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Impl) :- impl_choice(Impl), in(P_grid_in, Col), perm(P_grid_in, P_grid_out, Impl).

.output out(IO=stdout)
