// 758abdf0
// @draft
// @keywords: lines markers count move
// input: A solid line of the wall color runs along one grid edge, and marks
//  stand in short runs along the axis that leads away from it.
// output: A run shorter than full grows one cell away from the wall. A
//  full run leaves: its cells clear to bg, and a run of the same length
//  lands against the far edge in the wall's color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(7).
    .decl wall(col: Color) wall(0).
    .decl mark(col: Color) mark(8).
    // The run length at which a run leaves.
    .decl full(n: number) full(2).
}

.init params = Params

// The color an edge line holds throughout.
.init edge = Unanimous<Dir, Color>
edge.item(D, Col) :- dir_elem(D), in(P, Col), dist(P, D, 0).   // a cell on edge D

// The direction that leads away from the wall.
.decl away(d: Dir)
away(A) :- edge.value(D, Col), params.wall(Col), opposite(D, A).

// Runs of marks along the away axis. Components within one line: the
// perpendicular steps connect nothing.
.init runs = Components<Position>
runs.node(L, P) :-
    in(P, Col), params.mark(Col),                  // a mark
    away(A), axis_of(A, Ax), split(P, Ax, _, L).   // its line along the away axis

.decl run(id: Ident, p: Position)
run(Id, P) :- runs.label(_, P, Id).

.init len = Tally<Ident, Position>
len.item(Id, P) :- run(Id, P).

// A full run slides away from the wall until it lands against the far edge.
.init landing = Gravity<Ident, Unit>
landing.cell(Id, $U(), P) :- run(Id, P), len.tally(Id, N), params.full(N).
landing.dir(Id, A) :- landing.cell(Id, _, _), away(A).

// What the move paints: a short run grows one cell away from the wall, and a
// full run lands against the far edge.
.decl placed(p: Position, col: Color)
placed(Q, Col) :-
    len.tally(Id, N), params.full(F), N < F,         // a short run
    run(Id, P), away(A), neighbor(P, A, Q),          // the cell beyond it
    params.mark(Col).
placed(Q, Col) :-
    landing.cell(Id, _, P), landing.travel(Id, _, V), compose(P, V, Q),  // where the full run lands
    params.wall(Col).

// The cells a full run leaves.
.decl vacated(p: Position)
vacated(P) :- landing.cell(_, _, P).

out(P, Col) :-
    in(P, Col_in),
    ( placed(P, Col)                                   // landed or grown
    ; !placed(P, _), vacated(P), params.bg(Col)        // left behind
    ; !placed(P, _), !vacated(P), Col = Col_in         // untouched
    ).
