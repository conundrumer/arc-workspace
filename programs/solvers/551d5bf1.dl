// 551d5bf1
// draft
// keywords: objects border cast
// input: Rectangle outlines are drawn on a blank grid, some with border cells
//  missing.
// output: The output paints the inside of every rectangle, and each missing
//  border cell lets the paint leak out along its line, away from the
//  rectangle, to the grid edge.

.decl out(p: Position, col: Color)

.comp Params {
    .decl outline(col: Color) outline(1).
    .decl ink(col: Color) ink(8).
}

.init params = Params

.init rects = Components<Unit>
rects.node($U(), P) :- in(P, Col), params.outline(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- rects.label($U(), P, Id).

// A gap — a border cell the rectangle does not draw — casts away from the
// rectangle. The key is the side the gap breaks.
.init leak = Ray<Dir>
leak.dir(D, D) :- dir_elem(D).
leak.cell(D, P) :- dir_elem(D), in(P, _).
leak.mark(D, P) :- bbox.box(Id, B), in(P, _), box_edge(P, B, D), !bbox.cell(Id, P).

.decl paint(p: Position)
paint(P) :- bbox.box(_, B), in(P, _), interior(P, B).  // inside a rectangle
paint(P) :- leak.ray(D, P, D, _, _).                   // out through a gap

out(P, Col) :-
    in(P, Col0),
    ( paint(P), params.ink(Col)   // painted cell
    ; !paint(P), Col = Col0 ).    // everything else stands
