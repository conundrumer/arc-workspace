// ba26e723
// concept: lines mapping
// Cells whose color is a c.mapping key are recolored to the mapped color,
// but only at positions where (dist from c.anchor) mod c.period equals
// c.phase. Other cells pass through.

#include "../lib.dl"

.comp Consts {
    .decl anchor(d: Dir) anchor(DIR_L).
    .decl period(n: number) period(3).
    .decl phase(k: number) phase(0).

    .decl mapping(c_from: Color, c_to: Color)
    mapping(4, 6).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl on_stride(p: Position)
on_stride(P) :-
    in(P, _),
    c.anchor(D), c.period(W), c.phase(K),
    dist(P, D, T), stride(T, W, 0, _, K).

.decl recolored(p: Position)
recolored(P) :- in(P, Col), c.mapping(Col, _), on_stride(P).

.decl out(p: Position, col: Color)
out(P, Col_out) :- in(P, Col_in), c.mapping(Col_in, Col_out), on_stride(P).
out(P, Col)     :- in(P, Col), !recolored(P).

.output out(IO=stdout)
