// 1c0d0a4b
// @keywords: decompose wallpaper lines mapping
// output: 3×3 tiles on a 1-wide bg separator lattice, borders included. Tile
//  content complements: non-bg → bg, bg → params.paint. Separator cells stay
//  bg.

// which cells belong to the separator lattice; data-equivalent on this task
.type Choice =
    // the lattice: sep_w-wide lines every sep_w + tile_w
    Period {}
    // all-bg grid lines
  | Blank {}

// Separator stays bg; ink erases; tile bg complements to paint.
.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl paint(c: Color) paint(2).

    // --- $Period ---
    .decl sep_w(k: number) sep_w(1).
    .decl tile_w(k: number) tile_w(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Period()). impl_choice($Blank()).

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl sep(p: Position, ch: Choice)

// --- $Period ---
// On a lattice line: the seps divide as sep_w-wide tiles with tile_w gaps.
sep(P, $Period()) :-
    in(P, _), axis_elem(A),                     // each axis
    params.sep_w(K), params.tile_w(G),          // lattice dims
    divide_by_size(P, A, K, G, _, _).           // in a sep band of axis A

// --- $Blank ---
// Line along axis a at across-position p_across carries ink.
.decl ink_line(a: Axis, p_across: Position)
ink_line(A, Ac) :- ink(P), axis_elem(A), split(P, A, _, Ac).

sep(P, $Blank()) :-
    in(P, _), axis_elem(A),                    // each axis
    split(P, A, _, Ac), !ink_line(A, Ac).      // its line has no ink

out(P, Bg, Ch)    :- sep(P, Ch), params.bg(Bg).
out(P, Bg, Ch)    :- ink(P), impl_choice(Ch), params.bg(Bg).
out(P, Paint, Ch) :- in(P, Col), params.bg(Col), impl_choice(Ch), !sep(P, Ch), params.paint(Paint).
