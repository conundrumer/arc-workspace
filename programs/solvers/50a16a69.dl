// 50a16a69
// draft
// concept: wallpaper move
// A periodic pattern covers part of the grid, and a filler color covers
// the rest, in whole grid lines. The output is that pattern moved one step,
// then continued over the whole grid. The pattern's translation lattice is
// its shortest unbroken shift on each axis, and every cell takes the color
// its lattice class holds after the move.

#include "../lib.dl"

.comp Params {
    .decl move_dir(d: Dir) move_dir(DIR_L).
}

.init params = Params

// The filler color is the one that fills whole grid lines.
.init line = Unanimous<Position, Color>
line.item(L, Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

.decl pattern(p: Position, col: Color)
pattern(P, Col) :- in(P, Col), !line.value(_, Col).

.init si = ShiftInvariance<Unit, Color>
si.cell($U(), P, Col) :- pattern(P, Col).

// One lattice step, either way along its axis.
.decl period_step(p: Position, q: Position)
period_step(P, Q) :-
    in(P, _), si.min_period($U(), A, K), si.cand($U(), A, K, Delta),
    compose(P, Delta, Q), in(Q, _).

// The cells the lattice identifies.
.decl orbit(p: Position, q: Position)
orbit(P, P) :- in(P, _).
orbit(P, Q) :- orbit(P, R), period_step(R, Q).

.decl out(p: Position, col: Color)
out(P, Col) :-
    orbit(P, Q),                                    // a cell of P's class
    pattern(R, Col), params.move_dir(D), neighbor(R, D, Q).  // what the move puts there
