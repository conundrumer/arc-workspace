// 50a16a69
// @draft
// @keywords: wallpaper move
// input: a periodic pattern covering part of the grid, with a filler color
//  over whole grid lines, and its period translations — the shortest
//  unbroken shift on each axis
// output: The output moves the pattern one step and continues it over the
//  whole grid: every cell takes the color that its period class holds
//  after the move.

.decl out(p: Position, col: Color)

.comp Params {
    .decl move_dir(d: Dir) move_dir(DIR_L).
}

.init params = Params

// The filler color is the one that fills whole grid lines.
.init line = Unanimous<Position, Color>
line.item(L, Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

.decl pattern(p: Position, col: Color)
pattern(P, Col) :- in(P, Col), !line.value(_, Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- pattern(P, Col).

// A cell's period class along the axis of edge D: its distance to D,
// read within the axis's period where the axis has one.
.decl phase(p: Position, d: Dir, j: number)
phase(P, D, J) :-
    in(P, _), dir_elem(D), dist(P, D, T), axis_of(D, A),
    ( si.min_period($U(), A, K), stride(T, K, 0, _, J)  // periodic: the place in the period
    ; !si.min_period($U(), A, _), J = T                  // aperiodic: the line itself
    ).

out(P, Col) :-
    axis_of(D1, A), perp(A, A2), axis_of(D2, A2),
    phase(P, D1, J1), phase(P, D2, J2),
    phase(Q, D1, J1), phase(Q, D2, J2),                      // a cell of P's class
    pattern(R, Col), params.move_dir(D), neighbor(R, D, Q).  // what the move puts there
