// 903d1b4a
// family: b8825c91
// A grid symmetric about its center, corrupted by a noise color; each
// noise cell is restored from a symmetric counterpart.

#include "../lib.dl"

.type Choice = Full {} | Detect {}

.comp Consts {
    // --- shared ---
    .decl noise(col: Color)
    noise(3).
}

.init c = Consts

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !c.noise(Col).

.decl out(p: Position, col: Color, c: Choice)

// --- $Full ---

out(P, Col, $Full()) :- clean(P, Col).
out(P, Col, $Full()) :-
    in(P, N), c.noise(N),           // corrupted cell
    d4_elem(D), apply(D, P, P2),    // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// D maps some clean cell to a clean cell of a different color.
.decl mismatch(d: D4)
mismatch(D) :-
    d4_elem(D),
    clean(P, Col), apply(D, P, P2),
    clean(P2, C2), Col != C2.

out(P, Col, $Detect()) :- clean(P, Col).
out(P, Col, $Detect()) :-
    in(P, N), c.noise(N),                       // corrupted cell
    d4_elem(D), !mismatch(D), apply(D, P, P2),    // unbroken-symmetry image
    clean(P2, Col).
