// 903d1b4a
// @representative: b8825c91

// which D4 elements can repair a corrupted cell
.type Choice =
    // any D4 image that lands on a clean cell repairs it
    Full {}
    // only a D4 element the clean cells hold as their own symmetry repairs it
  | Detect {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(3).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

// --- $Full ---

out(P, Col, $Full()) :- clean(P, Col).
out(P, Col, $Full()) :-
    in(P, N), params.noise(N),      // corrupted cell
    d4_elem(D), apply(D, P, P2),    // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// Self-symmetry of the clean cells.
.init sym = D4Map<Unit, Color>
sym.src($U(), P, Col) :- clean(P, Col).
sym.dst($U(), P, Col) :- clean(P, Col).

out(P, Col, $Detect()) :- clean(P, Col).
out(P, Col, $Detect()) :-
    in(P, N), params.noise(N),                    // corrupted cell
    sym.compatible($U(), D), apply(D, P, P2),     // unbroken-symmetry image
    clean(P2, Col).
