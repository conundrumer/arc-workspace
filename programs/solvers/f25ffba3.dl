// f25ffba3
// @keywords: tile-arrangement d4
// input: a data slab anchored at one edge, the rest empty
// output: the data slab plus its images under a D4 set, filling the grid

// how the slab's images are placed
.type Choice =
    // stamp every cell within params.slab_depth of the data edge under
    // every D4 in params.stamps
    Stamp {}
    // stamp every non-bg input cell under every D4 in params.stamps, and
    // bg-fill what no stamp covers
  | Augment {}
    // divide the input into params.n_tiles along the data edge's axis; each
    // output tile applies its params.tile_d4 to the data tile
  | TileCount {}
    // the same arrangement, over tiles as deep as the data slab,
    // params.slab_depth
  | TileSize {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    // --- $Stamp, $TileCount, $TileSize ---
    .decl data_dir(d: Dir) data_dir(DIR_B).

    // --- $Stamp, $Augment ---
    .decl stamps(d: D4)
    stamps(D4_ID).
    stamps(D4_TB).

    // --- $Stamp, $TileSize ---
    // The data slab's depth from the data edge.
    .decl slab_depth(n: number) slab_depth(5).

    // --- $Augment ---
    .decl bg(c: Color) bg(0).

    // --- $TileCount, $TileSize ---
    // The tiles run along the data edge's axis.
    .decl tile_axis(a: Axis)
    tile_axis(A) :- data_dir(D), axis_of(D, A).

    .decl tile_d4(p_tile: Position, d: D4)
    GRID_2x1(tile_d4,
        D4_TB,
        D4_ID)

    // --- $TileCount ---
    .decl n_tiles(n: number) n_tiles(2).
}

.init params = Params

// --- $Stamp ---
out(P_grid_out, Col, $Stamp()) :-
    in(P_grid_in, Col),                                        // input cell
    params.data_dir(D_data), dist(P_grid_in, D_data, K),       // distance from data edge
    params.slab_depth(Depth), K < Depth,                       // within the data slab
    params.stamps(D), apply(D, P_grid_in, P_grid_out).         // stamp under D4

// --- $Augment ---
.decl augment_ink(p: Position, col: Color)
augment_ink(P_out, Col) :-
    in(P_in, Col), !params.bg(Col),                            // non-bg input cell
    params.stamps(D), apply(D, P_in, P_out).                   // stamp under D4

out(P, Col, $Augment()) :- augment_ink(P, Col).
out(P, Bg, $Augment()) :-
    in(P, _), params.bg(Bg), !augment_ink(P, _).               // bg-fill unstamped positions

// --- $TileCount, $TileSize ---
// The data tile's cells: the tile at the data edge, under each split.
.decl data_cell(p_intile: Position, col: Color, c: Choice)
data_cell(P_intile, Col, $TileCount()) :-
    in(P_grid_in, Col),                                                 // input cell
    params.tile_axis(A_tile), params.n_tiles(N),                        // tile axis, tile count
    divide_slab(P_grid_in, A_tile, N, 0, P_in_outer, P_intile),         // divide input
    params.data_dir(D_data), dist(P_in_outer, D_data, 0).               // data tile at the data edge
data_cell(P_intile, Col, $TileSize()) :-
    in(P_grid_in, Col),                                                 // input cell
    params.tile_axis(A_tile), params.slab_depth(K),                     // tile axis, tile size
    divide_by_size_slab(P_grid_in, A_tile, K, 0, P_in_outer, P_intile), // divide input
    params.data_dir(D_data), dist(P_in_outer, D_data, 0).               // data tile at the data edge

out(P_grid_out, Col, C) :-
    data_cell(P_intile, Col, C),                                   // the data tile's cell
    params.tile_d4(P_out_outer, D),                                // per-output-tile D4
    apply(D, P_intile, P_out_intile),                              // inner under that D4
    params.tile_axis(A_tile), concat_slab(P_out_outer, P_out_intile, A_tile, 0, P_grid_out).  // recompose

.comp Determine {
    // Input cells of the train pairs; a test input has no output to read.
    .decl pair_cell(e: Example, p: Position, col: Color)
    pair_cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    .decl ink(e: Example, p: Position, col: Color)
    ink(E, P, Col) :- pair_cell(E, P, Col), !params.bg(Col).

    .init slab = Bbox<Example>
    slab.cell(E, P) :- ink(E, P, _).

    // The data slab hugs one edge and stops short of the opposite one.
    .decl data_dir(d: Dir)
    data_dir(D) :- slab.box(_, B), dir_elem(D), dist_pair(B, D, K, K2), K < K2.

    .decl slab_depth(n: number)
    slab_depth(N) :-
        data_dir(D), axis_of(D, A),
        slab.cell(E, P), slab.box(E, B), box_extent(B, P, A, N).

    // The cut every tile parse takes: the data edge's axis, and the slab's
    // depth as the tile size.
    .decl slab_cut(a: Axis, k: number)
    slab_cut(A, K) :- data_dir(D), axis_of(D, A), slab_depth(K).

    // Tiles of the slab's depth fill the grid.
    .decl n_tiles(n: number)
    n_tiles(N) :-
        pair_cell(_, P_grid, _), slab_cut(A, K),
        divide_by_size(P_grid, A, K, 0, P_outer, _),
        axis_dim(P_outer, A, N).            // tile count: the arrangement's extent

    // Each example's ink must stamp onto its output.
    .init stamp = D4Map<Example, Color>
    stamp.src(E, P, Col) :- ink(E, P, Col).
    stamp.dst(E, P, Col) :- ex_out(E, P, Col).

    .decl stamps(d: D4)
    stamps(D) :- d4_elem(D), !stamp.mismatch(_, D).

    // The data tile: the input tile at the data edge.
    .decl data_cell(e: Example, p_intile: Position, col: Color)
    data_cell(E, P_intile, Col) :-
        pair_cell(E, P_grid, Col), slab_cut(A, K),
        divide_by_size_slab(P_grid, A, K, 0, P_tile, P_intile),
        data_dir(D), dist(P_tile, D, 0).

    .decl out_cell(e: Example, p_tile: Position, p_intile: Position, col: Color)
    out_cell(E, P_tile, P_intile, Col) :-
        ex_out(E, P_grid, Col), slab_cut(A, K),
        divide_by_size_slab(P_grid, A, K, 0, P_tile, P_intile).

    .type TileK = [e: Example, p_tile: Position]

    // The data tile must map onto each output tile's content.
    .init tile = D4Map<TileK, Color>
    tile.src([E, P_tile], P_intile, Col) :-
        data_cell(E, P_intile, Col), out_cell(E, P_tile, _, _).
    tile.dst([E, P_tile], P_intile, Col) :- out_cell(E, P_tile, P_intile, Col).

    .decl tile_mismatch(p_tile: Position, d: D4)
    tile_mismatch(P_tile, D) :- tile.mismatch([_, P_tile], D).

    .decl tile_d4(p_tile: Position, d: D4)
    tile_d4(P_tile, D) :- out_cell(_, P_tile, _, _), d4_elem(D), !tile_mismatch(P_tile, D).
}
