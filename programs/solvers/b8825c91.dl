// b8825c91
// keywords: symmetry repair
// output: A grid symmetric about its center, corrupted by a noise color; each
//  noise cell is restored from a symmetric counterpart.

// which D4 elements the repair draws on
.type Choice =
    // every element applies: the grid is fully symmetric
    Full {}
    // the group is detected: elements unbroken on clean cells
  | Detect {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(4).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

// --- $Full ---

out(P, Col, $Full()) :- clean(P, Col).
out(P, Col, $Full()) :-
    in(P, N), params.noise(N),      // corrupted cell
    d4_elem(D), apply(D, P, P2),    // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// Self-symmetry of the clean cells.
.init sym = D4Map<Unit, Color>
sym.src($U(), P, Col) :- clean(P, Col).
sym.dst($U(), P, Col) :- clean(P, Col).

out(P, Col, $Detect()) :- clean(P, Col).
out(P, Col, $Detect()) :-
    in(P, N), params.noise(N),                    // corrupted cell
    sym.compatible($U(), D), apply(D, P, P2),     // unbroken-symmetry image
    clean(P2, Col).
