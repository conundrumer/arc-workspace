// b8825c91
// concept: symmetry repair
// A grid symmetric about its center, corrupted by a noise color; each
// noise cell is restored from a symmetric counterpart.
//
//   $Stored — the symmetry group is task data (c.sym).
//   $Detect — the group is detected: elements unbroken on clean cells.

#include "../lib.dl"

.type Choice = Stored {} | Detect {}

.comp Consts {
    // --- shared ---
    .decl noise(col: Color)
    noise(4).

    // --- $Stored ---
    .decl sym(d: D4)
    sym(D4_ID). sym(D4_CW). sym(D4_HT). sym(D4_CC).
    sym(D4_LR). sym(D4_TB). sym(D4_DG). sym(D4_AD).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !c.noise(Col).

.decl out(p: Position, col: Color, c: Choice)

// --- $Stored ---

out(P, Col, $Stored()) :- clean(P, Col).
out(P, Col, $Stored()) :-
    in(P, N), c.noise(N),          // corrupted cell
    c.sym(D), apply(D, P, P2),     // symmetric counterpart
    clean(P2, Col).

// --- $Detect ---

// D maps some clean cell to a clean cell of a different color.
.decl broken(d: D4)
broken(D) :-
    d4_elem(D),
    clean(P, Col), apply(D, P, P2),
    clean(P2, C2), Col != C2.

out(P, Col, $Detect()) :- clean(P, Col).
out(P, Col, $Detect()) :-
    in(P, N), c.noise(N),                       // corrupted cell
    d4_elem(D), !broken(D), apply(D, P, P2),    // unbroken-symmetry image
    clean(P2, Col).

.output out(IO=stdout)
