// 7df24a62
// draft
// concept: markers stamp d4
// One box holds a motif of marks; marks of the same color are scattered over
// the grid. Wherever the motif recurs, in any D4 pose, the box is drawn
// around it in that pose. Marks stay, and a drawn box may run off the grid.

#include "../lib.dl"

.comp Params {
    .decl box(col: Color) box(1).
    .decl mark(col: Color) mark(4).
}

.init params = Params

// --- the template ---

// The drawn box, bounding the motif it holds.
.init tpl = Bbox<Unit>
tpl.cell($U(), P) :- in(P, Col), params.box(Col).

// The template in each D4 pose.
.decl pose(d: D4, p_inner: Position, col: Color)
pose(D, P_turned, Col) :-
    tpl.box($U(), B), in(P, Col), crop(P, B, P_inner),   // a template cell, in the box's frame
    d4_elem(D), apply(D, P_inner, P_turned).

// --- the occurrences ---

// The posed motif seated on the grid's marks.
.init occ = Occurrences<D4, Unit>
occ.shape(D, P_inner, $U()) :- pose(D, P_inner, Col), params.mark(Col).
occ.cell(D, P, $U()) :- d4_elem(D), in(P, Col), params.mark(Col).

// A non-mark cell some seated box covers: the box's fill.
.decl filled(p: Position)
filled(P) :-
    occ.occurrence(D, M), pose(D, P_inner, _), compose(M, P_inner, P),  // a cell of a seated box
    in(P, Col), !params.mark(Col).                           // not a mark

.decl out(p: Position, col: Color)
out(P, Col) :- filled(P), params.box(Col).
out(P, Col) :- in(P, Col), !filled(P).
