// 137eaa0f
// concept: overlay objects markers move
// Fragments scattered over bg, each holding one params.key cell. Fragments
// overlay, aligned on their key cells. Two hypotheses of what collects and of
// the output frame:
//
//   $Frame  — cells within the params.frame stamp placed with its params.anchor on
//             a key collect; output is the stamp.
//   $Object — each key's 8-connected object collects; output is the
//             overlay's bbox.

#include "../lib.dl"

.type Choice = Frame {} | Object {}

.comp Params {
    .init helpers = ParamsHelpers

    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl key(c: Color) key(5).

    // --- $Frame ---
    .decl frame_dim(k: number) frame_dim(3).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    .decl anchor(p: Position)
    anchor([1, 1, 1, 1]).
}

.init params = Params

.decl mark(p: Position)
mark(A) :- in(A, Col), params.key(Col).

// Every cell measured from every mark.
.init offset = Reframe<Position>
offset.outer(A, A) :- mark(A).
offset.cell(A, P) :- mark(A), in(P, _).

.decl out(p: Position, col: Color, ch: Choice)

// --- $Frame ---

.decl paint(p: Position, col: Color)
paint(P_out, Col) :-
    offset.view(A, P, P_rel), in(P, Col), !params.bg(Col),  // offset of an ink cell
    params.anchor(Anc), compose(Anc, P_rel, P_out),         // anchor-relative render
    params.frame(P_out).                                    // within the stamp

out(P, Col, $Frame()) :- paint(P, Col).
out(P, Bg, $Frame())  :- params.frame(P), !paint(P, _), params.bg(Bg).

// --- $Object ---

.init comp8 = Components8<Unit>
comp8.node($U(), P) :- in(P, Col), !params.bg(Col).

// Offsets of cells sharing their mark's component.
.decl obj_off(p_rel: Position, col: Color)
obj_off(P_rel, Col) :-
    mark(A), comp8.label($U(), A, Id),
    in(P, Col), comp8.label($U(), P, Id),    // cell in the mark's object
    offset.view(A, P, P_rel).

// All mark-cell offsets as the dense grid.
.init oframe = BoxFrame<Unit>
oframe.cell($U(), P_rel) :- obj_off(P_rel, _).
oframe.grid($U(), P_rel) :- offset.inner(_, P_rel).

out(P_out, Col, $Object()) :- obj_off(P_rel, Col), oframe.inner($U(), P_rel, P_out).
out(P_out, Bg, $Object())  :- oframe.inner($U(), P_rel, P_out), !obj_off(P_rel, _), params.bg(Bg).
