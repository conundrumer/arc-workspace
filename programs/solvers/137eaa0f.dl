// 137eaa0f
// @keywords: overlay objects markers move
// input: Fragments scattered over bg, each holding one params.key cell.
// output: Fragments overlay, aligned on their key cells.

// what collects into a fragment, and the output frame
.type Choice =
    // cells within the params.frame stamp placed with its params.anchor on a
    // key collect; output is the stamp
    Frame {}
    // each key's 8-connected object collects; output is the overlay's bbox
  | Object {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).
    .decl key(c: Color) key(5).

    // --- $Frame ---
    .decl frame_dim(k: number) frame_dim(3).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    .decl anchor(p: Position)
    anchor([1, 1, 1, 1]).
}

.init params = Params

.decl mark(p: Position)
mark(A) :- in(A, Col), params.key(Col).

// --- $Frame ---

.decl paint(p: Position, col: Color)
paint(P_out, Col) :-
    in(P, Col), !params.bg(Col),                            // an ink cell
    mark(A), relative(A, P, P_rel),                         // its offset from a mark
    params.anchor(Anc), compose(Anc, P_rel, P_out),         // anchor-relative render
    params.frame(P_out).                                    // within the stamp

out(P, Col, $Frame()) :- paint(P, Col).
out(P, Bg, $Frame())  :- params.frame(P), !paint(P, _), params.bg(Bg).

// --- $Object ---

.init comp8 = Components8<Unit>
comp8.node($U(), P) :- in(P, Col), !params.bg(Col).

// Offsets of cells sharing their mark's component.
.decl obj_off(p_rel: Position, col: Color)
obj_off(P_rel, Col) :-
    mark(A), comp8.label($U(), A, Id),
    in(P, Col), comp8.label($U(), P, Id),    // cell in the mark's object
    relative(A, P, P_rel).

.init obox = Bbox<Unit>
obox.cell($U(), P_rel) :- obj_off(P_rel, _).

// Each offset a mark sees, read in the overlay box's frame.
.decl view(p_rel: Position, p_inner: Position)
view(P_rel, P_inner) :-
    mark(A), in(P, _), relative(A, P, P_rel),    // a grid cell, as an offset from a mark
    obox.box($U(), B), crop(P_rel, B, P_inner).  // that offset inside the overlay's box

out(P_inner, Col, $Object()) :- obj_off(P_rel, Col), view(P_rel, P_inner).
out(P_inner, Bg, $Object())  :- view(P_rel, P_inner), !obj_off(P_rel, _), params.bg(Bg).

.comp Determine {
    .type EC = [e: Example, c: Color]

    // An ink color the overlay draws fewer times than the input holds it:
    // the key cells of every fragment land on one output cell.
    .init surplus = Excess<EC, Position>
    surplus.plus([E, Col], P) :- ex_out(E, _, _), ex_in(E, P, Col), !params.bg(Col).
    surplus.minus([E, Col], P) :- ex_out(E, P, Col).

    .decl key(c: Color)
    key(Col) :- surplus.excess([_, Col], _).

    // The output cell the key cells land on.
    .decl anchor(p: Position)
    anchor(P) :- ex_out(_, P, Col), params.key(Col).
}
