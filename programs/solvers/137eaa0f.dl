// 137eaa0f
// concept: overlay objects markers move
// Fragments scattered over bg, each holding one c.key cell. Fragments
// overlay, aligned on their key cells. Two claims of what collects and of
// the output frame:
//
//   $Frame  — cells within the c.frame stamp placed with its c.anchor on
//             a key collect; output is the stamp.
//   $Object — each key's 8-connected object collects; output is the
//             overlay's bbox.

#include "../lib.dl"

.type Choice = Frame {} | Object {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl key(c: Color) key(5).

    // --- $Frame ---
    .decl frame_dim(k: number) frame_dim(3).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    .decl anchor(p: Position)
    anchor([1, 1, 1, 1]).
}

.init c = Consts

.decl mark(p: Position)
mark(A) :- in(A, Col), c.key(Col).

// Every cell measured from every mark.
.decl offset(a: Position, p: Position, d: Shift)
offset(A, P, D) :- mark(A), in(P, _), displacement(A, P, D).

.decl out(p: Position, col: Color, ch: Choice)

// --- $Frame ---

.decl paint(p: Position, col: Color)
paint(P_out, Col) :-
    offset(A, P, D), in(P, Col), !c.bg(Col),         // offset of an ink cell
    c.anchor(Anc), compose(Anc, D, P_out),           // anchor-relative render
    c.frame(P_out).                                  // within the stamp

out(P, Col, $Frame()) :- paint(P, Col).
out(P, Bg, $Frame())  :- c.frame(P), !paint(P, _), c.bg(Bg).

// --- $Object ---

.init comp8 = Components8<Unit>
comp8.node($U(), P) :- in(P, Col), !c.bg(Col).

// Offsets of cells sharing their mark's component.
.decl obj_off(d: Position, col: Color)
obj_off(D, Col) :-
    mark(A), comp8.label($U(), A, Id),
    in(P, Col), comp8.label($U(), P, Id),    // cell in the mark's object
    offset(A, P, D).

// All mark-cell offsets as the dense grid.
.init oframe = BoxFrame<Unit>
oframe.cell($U(), D) :- obj_off(D, _).
oframe.grid($U(), D) :- offset(_, _, D).

out(P_out, Col, $Object()) :- obj_off(D, Col), oframe.inner($U(), D, P_out).
out(P_out, Bg, $Object())  :- oframe.inner($U(), D, P_out), !obj_off(D, _), c.bg(Bg).
