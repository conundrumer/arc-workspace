// 73182012
// @representative: 2013d3e2

// how the corner region is bounded
.type Choice =
    // one quadrant of the box
    Half {}
    // the fixed-size window at the box corner
  | Window {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- $Half ---
    .decl divisor(n: number) divisor(2).
    .decl out_tile(p_tile: Position) out_tile([0, 1, 0, 1]).

    // --- $Window ---
    .decl win_dim(k: number) win_dim(4).
    .decl corner(d: DiagDir) corner(DIAG_TL).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P).

.decl box_cell(p_box: Position, col: Color)
box_cell(P_box, Col) :- bbox.box($U(), B), in(P, Col), crop(P, B, P_box).

// --- $Half ---
out(P_out, Col, $Half()) :-
    box_cell(P_box, Col),
    params.divisor(N), divide_2d(P_box, N, 0, P_tile, P_out),    // box divided NxN
    params.out_tile(P_tile).                                     // the output tile

// --- $Window ---
.init win = Frame2D<Unit>
win.extent($U(), A, K) :- params.win_dim(K), axis_elem(A).

out(P_out, Col, $Window()) :-
    box_cell(P_box, Col),
    win.cell($U(), P_out),
    params.corner(Diag), corner_anchor(Diag, P_box, P_out).   // same dists to the corner

.comp Determine {
    .init ex_box = Bbox<Example>
    ex_box.cell(E, P) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // Each trained example's box cells, in the box's frame.
    .decl ex_box_cell(e: Example, p_box: Position, col: Color)
    ex_box_cell(E, P_box, Col) :- ex_in(E, P, Col), ex_box.box(E, B), crop(P, B, P_box).

    // Where each output occurs in its box, as a window of the box's frame.
    .init seat = Occurrences<Example, Color>
    seat.cell(E, P_box, Col) :- ex_box_cell(E, P_box, Col).
    seat.shape(E, Q, Col) :- ex_out(E, Q, Col), ex_box.box(E, _).

    // The tile count, on each axis, that cuts the box into tiles of the output's extents.
    .decl divisor(n: number)
    divisor(N) :-
        ex_box_cell(E, P_box, _), axis_elem(A), sub_extent(P_box, A, N),
        divide_2d(P_box, N, 0, _, P_inner),
        ex_out(E, Q, _), axis_dims(P_inner, A, K1, K2), axis_dims(Q, A, K1, K2).

    // The tile the output's window is.
    .decl out_tile(p_tile: Position)
    out_tile(P_tile) :-
        seat.occurrence(E, M), ex_box_cell(E, P_box, _), crop(P_box, M, P_rel),
        divisor(N), divide_2d(P_box, N, 0, P_tile, P_rel).

    // The box corner the output's window touches.
    .decl corner(d: DiagDir)
    corner(Diag) :- seat.occurrence(_, M), corner_dist(M, Diag, 0).
}
