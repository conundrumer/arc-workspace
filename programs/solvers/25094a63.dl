// 25094a63
// @draft
// @keywords: stamp noise
// input: solid monochrome rectangles in a noise field.
// output: Wherever a square footprint of side params.side lands on cells
//  that all share one color, those cells turn params.paint; the rest passes
//  through. Overlapping seats cover a bigger rectangle whole, so a rectangle
//  recolors exactly when it reaches the footprint's size on both axes.

.type SeatKey = [e: Example, col: Color, k: number]
.type PieceKey = [e: Example, id: Ident]

.decl out(p: Position, col: Color)

.comp Params {
    .decl paint(col: Color) paint(4).
    .decl side(k: number) side(4).
}

.init params = Params

// The footprint.
.init square = Frame2D<Unit>
square.extent($U(), A, K) :- params.side(K), axis_elem(A).

// One key per color: a seated footprint is monochrome.
.init occ = Occurrences<Color, Unit>
occ.cell(Col, P, $U())  :- in(P, Col).
occ.shape(Col, S, $U()) :- square.cell($U(), S), in(_, Col).

// A seated footprint recolors every cell it covers.
.decl covered(p: Position)
covered(P) :- occ.occurrence(_, M), square.cell($U(), S), compose(M, S, P).

out(P, Col) :- covered(P), params.paint(Col).
out(P, Col) :- in(P, Col), !covered(P).

.comp Determine {
    // A cell a train output recolors.
    .decl painted(e: Example, p: Position)
    painted(E, P) :- ex_out(E, P, _), ex_in(E, P, Col), !ex_out(E, P, Col).

    .init pieces = Components<Example>
    pieces.node(E, P) :- painted(E, P).

    .init piece_box = Bbox<PieceKey>
    piece_box.cell([E, Id], P) :- pieces.label(E, P, Id).

    // The least extent of a recolored piece, which no footprint exceeds.
    .init narrowest = Extremes<Unit>
    narrowest.cand($U(), N) :-
        pieces.label(E, P, Id), piece_box.box([E, Id], B), axis_elem(A), box_extent(B, P, A, N).

    .decl cand(k: number)
    cand(K) :- narrowest.low($U(), N), painted(_, P), axis_elem(A), sub_extent(P, A, K), K <= N.

    // A color of a train input.
    .decl shade(e: Example, col: Color)
    shade(E, Col) :- ex_out(E, _, _), ex_in(E, _, Col).

    .init square = Frame2D<number>
    square.extent(K, A, K) :- cand(K), axis_elem(A).

    // Each square of one color in an input.
    .init seats = Occurrences<SeatKey, Unit>
    seats.cell([E, Col, K], P, $U()) :- shade(E, Col), ex_in(E, P, Col), cand(K).
    seats.shape([E, Col, K], S, $U()) :- shade(E, Col), square.cell(K, S).

    // A square that a train output leaves a cell of as it is.
    .decl left_alone(k: number)
    left_alone(K) :-
        seats.occurrence([E, Col, K], M), square.cell(K, S), compose(M, S, P),
        ex_out(E, P, Col).

    .init least = Extremes<Unit>
    least.cand($U(), K) :- cand(K), !left_alone(K).

    // The least side at which no train output leaves a square alone.
    .decl side(k: number)
    side(K) :- least.low($U(), K).
}
