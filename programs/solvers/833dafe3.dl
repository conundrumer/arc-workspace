// 833dafe3
// family: 67e8384a
// 2×2 tile arrangement of input copies.

#include "../lib.dl"

.type Choice = Lookup {} | Mirror {} | Unfold {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- Mirror / Unfold ---
    .decl arr_pos(p: Position)
    arr_pos(P) :- helpers.frame_pos([2, 2], P).

    .decl anchor(d: DiagDir)
    anchor(DIAG_BR).

    // --- Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_2x2(tile_d4,
        D4_HT, D4_TB,
        D4_LR, D4_ID)
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, c: Choice)

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                       // input cell
    c.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).              // recompose

// --- Mirror ---
// Tile on the anchor side / far side of an axis.
.decl anchor_side(p_tile: Position, a: Axis)
anchor_side(T, A) :-
    c.arr_pos(T), c.anchor(Diag), dir_of(Diag, A, D), dist(T, D, 0).

.decl far_side(p_tile: Position, a: Axis)
far_side(T, A) :-
    c.arr_pos(T), c.anchor(Diag), dir_of(Diag, A, D), dist(T, D, K), K != 0.

// Per-axis within-tile image: anchor side passes through, far side flips.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P)     :- in(P, _), anchor_side(T, A).
mirror(A, T, P, P_img) :- in(P, _), far_side(T, A), flip_of(A, F), apply(F, P, P_img).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- Unfold ---
.decl anchor_tile(p: Position)
anchor_tile(T) :- c.arr_pos(T), c.anchor(Diag), corner_anchor(Diag, T, ORIGIN).

// Tile contents: the input seeds the anchor tile; each neighbor reflects
// across the shared boundary.
.decl unfold_val(p_tile: Position, p_intile: Position, col: Color)
unfold_val(T, P, Col) :- in(P, Col), anchor_tile(T).
unfold_val(T2, P_img, Col) :-
    unfold_val(T, P, Col),                                             // known tile
    axis_of(D, A), step_delta(D, S), compose(T, S, T2), c.arr_pos(T2), // neighbor toward d
    flip_of(A, F), apply(F, P, P_img).                                 // reflect across the shared edge

out(P_grid, Col, $Unfold()) :-
    unfold_val(T, P_intile, Col),
    concat_2d(T, P_intile, 0, P_grid).

.output out(IO=stdout)
