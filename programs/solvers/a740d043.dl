// a740d043
// concept: crop mapping
// Output is the grid cropped to the ink's bounding box; bg cells inside
// repaint to c.hole.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(1).
    .decl hole(c: Color) hole(0).
}

.init c = Consts

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.init boxframe = BoxFrame<Unit>
boxframe.cell($U(), P) :- ink(P, _).
boxframe.grid($U(), P) :- in(P, _).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    ( ink(P, Col)                              // ink — carried in
    ; in(P, C), c.bg(C), c.hole(Col)           // bg — the hole color
    ),
    boxframe.inner($U(), P, P_out).            // viewed from the ink's box
