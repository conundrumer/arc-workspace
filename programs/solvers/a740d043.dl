// a740d043
// @keywords: crop mapping
// output: Output is the grid cropped to the ink's bounding box; bg cells inside
//  repaint to params.hole.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(1).
    .decl hole(c: Color) hole(0).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P, _).

out(P_inner, Col) :-
    ( ink(P, Col)                                 // ink — carried in
    ; in(P, C), params.bg(C), params.hole(Col)    // bg — the hole color
    ),
    bbox.box($U(), B), crop(P, B, P_inner).       // viewed from the ink's box
