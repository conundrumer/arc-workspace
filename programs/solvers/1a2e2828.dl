// 1a2e2828
// concept: lines select
// Full-length stripes cross; at each crossing one stripe shows through.
// The top stripe is covered by none, so its lines stay uniform. Output
// 1×1: the top stripe's color.

#include "../lib.dl"

.comp Consts {
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Colors on the line along axis a at p_across.
.decl line_color(a: Axis, p_across: Position, col: Color)
line_color(A, P_across, Col) :- in(P, Col), axis_elem(A), split(P, A, _, P_across).

// The line shows more than one color.
.decl broken(a: Axis, p_across: Position)
broken(A, P_across) :- line_color(A, P_across, C1), line_color(A, P_across, C2), C1 != C2.

.decl out(p: Position, col: Color)
out(ORIGIN, Col) :- line_color(A, P_across, Col), !broken(A, P_across).

.output out(IO=stdout)
