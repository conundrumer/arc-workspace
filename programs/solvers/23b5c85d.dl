// 23b5c85d
// draft
// keywords: objects crop select count
// input: Solid colored rectangles overlap on a bg field, so some are
//  partly hidden. No two share a color, so color individuates them.
// output: The bounding box of the object with the fewest cells.

// the object's cells
.type Size =
    // the whole rectangle, the hidden part included
    Box {}
    // only the cells whose color still shows
  | Visible {}

// fill the box
.type Render =
    // the object's cells keep their color, the rest of the box is bg
    Keep {}
    // the box carries the input through, occluders included
  | Crop {}

// what an object covers, crossed with what its box carries
.type Choice = [s: Size, r: Render]

.type Obj = [s: Size, col: Color]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.init boxes = Bbox<Color>
boxes.cell(Col, P) :- in(P, Col), !params.bg(Col).

// --- Size cases ---

.decl obj_cell(s: Size, col: Color, p: Position)
obj_cell($Box(), Col, P) :- in(P, _), boxes.box(Col, B), inside(P, B).
obj_cell($Visible(), Col, P) :- boxes.cell(Col, P).

.init size = Tally<Obj, Position>
size.item([S, Col], P) :- obj_cell(S, Col, P).

.init sel = ArgExtremes<Size, Color>
sel.cand(S, Col, N) :- size.tally([S, Col], N).

// --- Render cases ---

out(P_inner, Col, [S, $Keep()]) :-
    sel.low(S, Col_win, _),                                          // the smallest object
    in(P_grid, _), boxes.box(Col_win, B), crop(P_grid, B, P_inner),  // its box, viewed from itself
    ( obj_cell(S, Col_win, P_grid), Col = Col_win                    // an object cell keeps its color
    ; !obj_cell(S, Col_win, P_grid), params.bg(Col)                  // the rest of the box is blank
    ).

out(P_inner, Col, [S, $Crop()]) :-
    sel.low(S, Col_win, _),                                            // the smallest object
    in(P_grid, Col), boxes.box(Col_win, B), crop(P_grid, B, P_inner).  // its box carries the input
