// 239be575
// @draft
// @keywords: objects classify lookup
// input: Two blocks of params.mark sit among scattered params.link cells;
//  the mark and link cells form one graph.
// output: The 1×1 output reports whether every mark cell lies in a single
//  connected component of that graph. Nothing reads the 2×2 block shape.
// review principle: Cases — Orth and Diag ship as two joins of the one graph
//  of mark and link cells, so re-judge whether both stand now that Fit,
//  Fidelity, and Equivalence are the only grounds for removing a case.

// what an edge is
.type Adj =
    // cardinal adjacency
    Orth {}
    // cardinal or diagonal adjacency
  | Diag {}

// how the verdict renders
.type Render =
    // joined shows the link color, apart shows bg
    Wire {}
    // a stored color per verdict
  | Table {}

// what counts as an edge, crossed with how the verdict renders
.type Choice = [a: Adj, r: Render]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(c: Color) mark(2).
    .decl link(c: Color) link(8).

    // --- $Wire ---
    .decl bg(c: Color) bg(0).

    // --- $Table ---
    .decl join_paint(c: Color) join_paint(8).
    .decl apart_paint(c: Color) apart_paint(0).
}

.init params = Params

.decl mark_cell(p: Position)
mark_cell(P) :- in(P, Col), params.mark(Col).

// The graph's nodes: the marks, and the links that may join them.
.decl node(p: Position)
node(P) :- in(P, Col), (params.mark(Col) ; params.link(Col)).

.decl adj_choice(a: Adj)
adj_choice($Orth()).
adj_choice($Diag()).

// Some pair of mark cells with no path between them.
.decl apart(a: Adj)

.decl joined(a: Adj)
joined(A) :- adj_choice(A), !apart(A).

// --- $Orth ---

.init orth = Components<Unit>
orth.node($U(), P) :- node(P).

apart($Orth()) :- mark_cell(P), mark_cell(Q), !orth.conn($U(), P, Q).

// --- $Diag ---

.init diag = Components8<Unit>
diag.node($U(), P) :- node(P).

apart($Diag()) :- mark_cell(P), mark_cell(Q), !diag.conn($U(), P, Q).

// --- $Wire ---
out(ZERO, Col, [A, $Wire()]) :- joined(A), params.link(Col).
out(ZERO, Col, [A, $Wire()]) :- apart(A),  params.bg(Col).

// --- $Table ---
out(ZERO, Col, [A, $Table()]) :- joined(A), params.join_paint(Col).
out(ZERO, Col, [A, $Table()]) :- apart(A),  params.apart_paint(Col).
