// 8e2edd66
// @keywords: tile-arrangement stamp
// output: Fractal of the input's complement. The output is an input-shaped
//  arrangement of input-sized tiles: at each bg cell of the input the tile is
//  the input's complement, drawn in the input's ink color; at each ink cell the
//  tile is blank.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color)
    bg(0).
}

.init params = Params

// The input's non-bg color.
.decl ink(col: Color)
ink(C) :- in(_, C), !params.bg(C).

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, C), params.bg(C).

// Output cells: every (tile, intile) pair of input positions.
.decl out_cell(p: Position)
out_cell(P_grid) :-
    in(P_tile, _), in(P_intile, _),
    concat_2d(P_tile, P_intile, 0, P_grid).

// Ink cells: tile and intile coordinates both bg.
.decl ink_at(p: Position)
ink_at(P_grid) :-
    bg_cell(P_tile), bg_cell(P_intile),
    concat_2d(P_tile, P_intile, 0, P_grid).

out(P, C) :- ink_at(P), ink(C).
out(P, C) :- out_cell(P), !ink_at(P), params.bg(C).
