// 292dd178
// @draft
// @keywords: objects border walk cast bbox enclose
// input: Rectangular outlines in params.wall each miss one cell of their
//  perimeter.
// output: The cells strictly inside an outline's bounding box take
//  params.fill, which also runs out through the missing perimeter cell, away
//  from that box.

// how the fill reaches outside the box through the break
.type Choice =
    // the fill is a substance. It pushes outward from the interior and
    // params.wall stops it, so it escapes only where the perimeter is broken.
    Flow {}
    // the broken perimeter cell is a marker. It emits a ray outward along the
    // side it sits on, across the whole frame.
  | Cast {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl wall(col: Color) wall(1).
    .decl fill(col: Color) fill(2).
}

.init params = Params

// --- boxes ---

.decl wall_cell(p: Position)
wall_cell(P) :- in(P, Col), params.wall(Col).

.init comp = Components<Unit>
comp.node($U(), P) :- wall_cell(P).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- comp.label($U(), P, Id).

// The cells strictly inside a box, whatever color they carry.
.decl hole(p: Position)
hole(P) :- bbox.box(_, B), in(P, _), interior(P, B).

// The cells the fill covers.
.decl painted(p: Position, ch: Choice)

// --- $Flow ---

.init flow = Ray<Unit>
flow.dir($U(), D) :- dir_elem(D).
flow.cell($U(), P) :- in(P, _).
flow.mark($U(), P) :- hole(P).
flow.blocked($U(), P) :- wall_cell(P).

painted(P, $Flow()) :- flow.clear($U(), P, _, _, _).

// --- $Cast ---

.init cast = Ray<Dir>
cast.dir(D, D) :- dir_elem(D).
cast.cell(D, P) :- dir_elem(D), in(P, _).
cast.mark(D, P) :-
    bbox.box(_, B), in(P, _), box_edge(P, B, D),  // a cell of a box's d side
    !wall_cell(P).                                // where the perimeter is broken

painted(P, $Cast()) :- hole(P).
painted(P, $Cast()) :- cast.ray(_, P, _, _, _).

// --- output ---

.decl impl_choice(ch: Choice)
impl_choice($Flow()). impl_choice($Cast()).

out(P, Col, Ch) :- painted(P, Ch), params.fill(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !painted(P, Ch).
