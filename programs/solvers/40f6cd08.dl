// 40f6cd08
// draft
// concept: objects scale border
// Solid rectangles sit on the background. One holds a stack of nested color
// layers; the rest hold a single color. Every rectangle comes out carrying
// the stack, resized to its own bbox.
//
// A layer is one color's bounding box inside the pattern rectangle, held as
// four margins. A cell takes the innermost layer whose margins its own box
// position clears.
//
// The outermost layer's margins are all zero, and every plain rectangle
// already carries its color, so no pair separates these two cases:
//
//   $Repaint — the whole stack paints, outermost layer included.
//   $Overlay — only the inner layers paint, over the rectangle's own color.

#include "../lib.dl"

.type Choice = Repaint {} | Overlay {}

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- the rectangles ---

.init rects = Components<Unit>
rects.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- rects.label($U(), P, Id).

// Each rectangle's cells, in its own box frame.
.decl rect_view(id: Ident, p: Position, p_inner: Position)
rect_view(Id, P, P_inner) :- bbox.cell(Id, P), bbox.box(Id, B), crop(P, B, P_inner).

.init rect_color = Unanimous<Ident, Color>
rect_color.item(Id, Col) :- bbox.cell(Id, P), in(P, Col).

// --- the layers ---

.init layer = Bbox<Color>
layer.cell(Col, P_inner) :-
    rect_color.clash(Id),                 // the pattern rectangle
    rect_view(Id, P, P_inner), in(P, Col).

.decl nested(col_in: Color, col_out: Color)
nested(Col_in, Col_out) :-
    layer.box(Col_in, B_in), layer.box(Col_out, B_out),
    inside(B_in, B_out), B_in != B_out.

// --- the paint ---

// The layers are read over every rectangle's inner frame.
.decl covers(p: Position, col: Color)
covers(P, Col) :- rect_view(_, P, P_inner), layer.box(Col, B), inside(P_inner, B).

.decl shadowed(p: Position, col: Color)
shadowed(P, Col) :- covers(P, Col_in), nested(Col_in, Col).

// The innermost layer covering the cell.
.decl paint(p: Position, col: Color)
paint(P, Col) :- covers(P, Col), !shadowed(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Repaint()). impl_choice($Overlay()).

// The stack paints; elsewhere the input passes through.
.decl stamp(p: Position, col: Color, ch: Choice)

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- stamp(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !stamp(P, _, Ch).

// --- Repaint ---
stamp(P, Col, $Repaint()) :- paint(P, Col).

// --- Overlay ---
stamp(P, Col, $Overlay()) :- paint(P, Col), nested(Col, _).
