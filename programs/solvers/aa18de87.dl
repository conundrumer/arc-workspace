// aa18de87
// keywords: lines span
// output: Diagonal rays, one color per input. Bg cells between two ray cells on
//  their line fill with params.fill. The two cases model differently which
//  lines fill.

// which lines fill
.type Choice =
    // lines along params.axis only
    Axis {}
    // lines along both axes; no orientation parameter
  | Iso {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(2).

    // --- Axis ---
    .decl axis(a: Axis) axis(AXIS_H).   // fill lines run along this axis
}

.init params = Params

// --- Axis ---

.init axis_spans = Between<Unit>
axis_spans.axis($U(), A) :- params.axis(A).
axis_spans.cell($U(), P) :- in(P, Bg), params.bg(Bg).
axis_spans.mark($U(), Q) :- in(Q, Col), !params.bg(Col).

out(P, F, $Axis())   :- axis_spans.between($U(), P), params.fill(F).
out(P, Col, $Axis()) :- in(P, Col), !axis_spans.between($U(), P).

// --- Iso ---

.init iso_spans = Between<Unit>
iso_spans.axis($U(), A) :- axis_elem(A).
iso_spans.cell($U(), P) :- in(P, Bg), params.bg(Bg).
iso_spans.mark($U(), Q) :- in(Q, Col), !params.bg(Col).

out(P, F, $Iso())   :- iso_spans.between($U(), P), params.fill(F).
out(P, Col, $Iso()) :- in(P, Col), !iso_spans.between($U(), P).
