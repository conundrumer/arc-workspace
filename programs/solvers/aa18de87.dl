// aa18de87
// concept: lines span
// Diagonal rays, one color per input. Bg cells between two ray cells on
// their line fill with c.fill. Two models of which lines fill, tagged on
// out's Choice:
//
//   $Axis — lines along c.axis only.
//   $Iso  — lines along both axes; no orientation datum.

#include "../lib.dl"

.type Choice = Axis {} | Iso {}

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(2).

    // --- Axis ---
    .decl axis(a: Axis) axis(AXIS_H).   // fill lines run along this axis
}

.init c = Consts

.decl out(p: Position, col: Color, ch: Choice)

// --- Axis ---

.init axis_spans = Between<Unit>
axis_spans.axis($U(), A) :- c.axis(A).
axis_spans.cell($U(), P) :- in(P, Bg), c.bg(Bg).
axis_spans.mark($U(), Q) :- in(Q, Col), !c.bg(Col).

out(P, F, $Axis())   :- axis_spans.between($U(), P), c.fill(F).
out(P, Col, $Axis()) :- in(P, Col), !axis_spans.between($U(), P).

// --- Iso ---

.init iso_spans = Between<Unit>
iso_spans.axis($U(), A) :- axis_elem(A).
iso_spans.cell($U(), P) :- in(P, Bg), c.bg(Bg).
iso_spans.mark($U(), Q) :- in(Q, Col), !c.bg(Col).

out(P, F, $Iso())   :- iso_spans.between($U(), P), c.fill(F).
out(P, Col, $Iso()) :- in(P, Col), !iso_spans.between($U(), P).
