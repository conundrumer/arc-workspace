// 6f8cd79b
// keywords: border
// output: Draw a border: cells on any edge become params.border. The all-bg
//  input leaves the interior underdetermined.

// how the interior is filled
.type Choice =
    // interior keeps its input color; the border overwrites
    Passthrough {}
    // border cells get params.border, interior gets params.bg; the input only
    // carries the frame size
  | Repaint {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl border(c: Color) border(8).

    // --- $Repaint ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl is_border(p: Position)
is_border(P) :- in(P, _), dir_elem(D), dist(P, D, 0).   // on any edge

// --- $Passthrough ---
out(P, Col, $Passthrough()) :- is_border(P), params.border(Col).
out(P, Col, $Passthrough()) :- in(P, Col), interior(P, ZERO).

// --- $Repaint ---
out(P, Col, $Repaint()) :- is_border(P), params.border(Col).
out(P, Col, $Repaint()) :- in(P, _), interior(P, ZERO), params.bg(Col).
