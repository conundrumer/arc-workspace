// a59b95c0
// keywords: tile-arrangement count
// output: The output arranges N×N copies of the input, where N is the count
//  of distinct colors in the input. The family is fully structural, with no
//  task data to store.

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- in(_, Col).

.init arr = Frame2D<Unit>
arr.extent($U(), A, N) :- axis_elem(A), palette.tally($U(), N).

out(P_grid, Col) :-
    in(P_intile, Col),                              // input cell as intile pos
    arr.cell($U(), P_tile),                         // tile pos (N×N arrangement)
    concat_2d(P_tile, P_intile, 0, P_grid).         // 2D recompose
