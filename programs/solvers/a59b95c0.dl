// a59b95c0
// concept: tile-arrangement count
// Layout: N×N tiling of input copies, N = the distinct color count. No
// task data — the family is fully structural.

#include "../lib.dl"

.comp Consts {}

.init c = Consts

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- in(_, Col).

.init arr = Frame2D<Unit>
arr.extent($U(), A, N) :- axis_elem(A), palette.tally($U(), N).

.decl out(p: Position, col: Color)
out(P_grid, Col) :-
    in(P_intile, Col),                              // input cell as intile pos
    arr.cell($U(), P_tile),                         // tile pos (N×N arrangement)
    concat_2d(P_tile, P_intile, 0, P_grid).         // 2D recompose
