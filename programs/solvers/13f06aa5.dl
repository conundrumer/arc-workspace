// 13f06aa5
// concept: markers objects cast parity border
// Each shape is drawn in one ink color and carries a single odd-colored
// marker cell on one of its sides. The marker fires in the direction that
// side faces: a trail of dots runs from it across the grid at a fixed
// spacing, and the far edge takes its color whole. Where two fired edges
// meet, the corner takes c.corner_color. Every other cell passes through.
//
// Cases claim how a marker's direction is read:
//   $Open — the side of the marker that faces background.
//   $Side — the side of its shape's bounding box the marker lies on.

#include "../lib.dl"

.type Choice = Open {} | Side {}

.comp Consts {
    // Distance between trail dots.
    .decl spacing(w: number) spacing(2).

    // Where two fired edges meet.
    .decl corner_color(col: Color) corner_color(0).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Open()). impl_choice($Side()).

// --- shared ---

.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !bg_mode.mode($U(), Col).

// The shapes' own color — the commonest ink.
.init ink_mode = Mode<Unit, Color, Position>
ink_mode.item($U(), Col, P) :- ink(P, Col).

.decl mark(p: Position, col: Color)
mark(P, Col) :- ink(P, Col), !ink_mode.mode($U(), Col).

.decl mark_dir(p: Position, d: Dir, ch: Choice)

// --- Open ---

mark_dir(P, D, $Open()) :-
    mark(P, _),                            // the marker
    dir_elem(D), neighbor(P, D, Q),
    in(Q, Col), bg_mode.mode($U(), Col).   // background there

// --- Side ---

.init comps = Components<Unit>
comps.node($U(), P) :- ink(P, _).

.init box = Bbox<Ident>
box.cell(Id, P) :- comps.label($U(), P, Id).

mark_dir(P, D, $Side()) :-
    mark(P, _), comps.label($U(), P, Id),   // the marker's shape
    box.edge_cell(Id, P, D).                // the box side it lies on

// --- output ---

.decl fired(d: Dir, col: Color, ch: Choice)
fired(D, Col, Ch) :- mark(P, Col), mark_dir(P, D, Ch).

.init ray = Ray<Position>
ray.dir(M, D) :- mark_dir(M, D, _).
ray.cell(M, P) :- mark(M, _), in(P, _).
ray.mark(M, M) :- mark(M, _).

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :- fired(D, Col, Ch), in(P, _), dist(P, D, 0).   // the fired edge
paint(P, Col, Ch) :-
    mark(M, Col), mark_dir(M, D, Ch),      // marker and its direction
    ray.ray(M, P, D, K, _),                // a cell of its ray
    c.spacing(W), stride(K, W, 0, _, 0).   // one dot per spacing

.decl corner(p: Position, ch: Choice)
corner(P, Ch) :-
    diag_dirs(Dg, _, D1, D2),             // a corner and its two sides
    fired(D1, _, Ch), fired(D2, _, Ch),
    in(P, _), corner_dist(P, Dg, 0).      // the corner cell

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :-
    in(P, Col_in), impl_choice(Ch),
    ( corner(P, Ch), c.corner_color(Col)               // corner of two fired edges
    ; !corner(P, Ch), paint(P, Col, Ch)                // fired edge or trail dot
    ; !paint(P, _, Ch), Col = Col_in                   // untouched
    ).
