// a680ac02
// @draft
// @keywords: objects select enclose crop rank tile-arrangement lookup
// @scene squares: the input holds 4×4 squares on a field of params.bg, each
//  of one color, with no two squares of the same color and no two squares
//  touching
// @scene two-kinds: each square is either hollow (a one-cell wall around a
//  2×2 hole of params.bg) or solid; every input holds two or more hollow
//  squares and one or more solid squares
// @scene one-separating-axis: on exactly one axis, the extents of the hollow
//  squares are pairwise disjoint; on the other axis, the extents of at least
//  one pair of hollow squares overlap
// @rule select-hollow: the output keeps the hollow squares and drops the
//  solid squares
// @rule axis: the output lines the kept squares up along the axis on which
//  no two kept squares share a line
// @rule order: along that axis, the kept squares keep the order they have in
//  the input
// @rule concatenate: the output is the kept squares, each copied unchanged,
//  placed end to end along that axis with no gap; its size across that axis
//  is one square

// how the kept squares are found
.type Squares =
    // @claim select-hollow
    ColorObjects {conn: Connectivity, keep: KeepTest}
    // @rule select-hollow: a window of params.square_side is a kept square
    //  when its rim is one color other than params.bg and the rest of it is
    //  params.bg; undefined when no window matches
    // @witness one-cell-hole: foreign concept
    //     @relaxed two-kinds
    // @witness small-rings: variant concept
    //     @relaxed squares
  | StoredTemplate {}

// which cells join one object
.type Connectivity =
    // @claim select-hollow
    FourConnected {}
    // @rule select-hollow: the objects are the 8-connected single-color
    //  components
    // @witness corner-touch: foreign concept
    //     @relaxed squares
    // @witness corner-fewest: foreign concept
    //     @relaxed squares
  | EightConnected {}

// which objects are kept
.type KeepTest =
    // @claim select-hollow
    EnclosesHole {}
    // @rule select-hollow: an object is kept when it does not fill its
    //  bounding box
    // @witness open-ring: foreign $SelectNotFull
    //     @relaxed two-kinds
  | SelectNotFull {}
    // @rule select-hollow: the objects with the fewest cells are kept
    // @witness small-solid: borderline concept
    //     @relaxed squares
  | SelectFewestCells {}

// the axis the output lines the squares along
.type AxisRule =
    // @claim axis
    SeparatingAxis {}
    // @rule axis: the longer axis of the kept squares' joint bounding box;
    //  undefined when the box is square
    // @witness spread-rows: ordinary concept
    // @witness diagonal: borderline $AxisBbox
    //     @relaxed one-separating-axis
    // @witness spread-tie: ordinary concept
    // @witness wide-rings: borderline concept
    //     @relaxed squares
  | AxisBbox {}

// the order of the squares along the axis
.type OrderRule =
    // @claim order
    AlongAxis {}
    // @rule order: the squares go in the lexicographic order of their corners
    //  at an end of params.lex_diagonal, params.lex_axis first, from that
    //  corner's edge of the layout axis; both ends give one order
    // @witness left-below: ordinary concept
  | OrderColumnMajor {}

.type Choice = [squares: Squares, axis: AxisRule, order: OrderRule]

// A component under one connectivity.
.type Obj = [conn: Connectivity, id: Ident]

// The kept squares, read from one corner.
.type Corner = [sq: Squares, corner: DiagDir]

// A line of a kept square along the layout axis.
.type SqLine = [b: Box, l: Position]

// A case, with the edge its sequence runs from.
.type Run = [ch: Choice, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed squares
    .decl bg(c: Color) bg(0).

    // --- $StoredTemplate ---
    .init helpers = ParamsHelpers

    .decl square_side(k: number) square_side(4).

    // The rim of the window, and the rest of it.
    .decl template_wall(p: Position)
    template_wall(P) :- square_side(K), helpers.frame_pos([K, K], P), !interior(P, ZERO).
    .decl template_hole(p: Position)
    template_hole(P) :- square_side(K), helpers.frame_pos([K, K], P), interior(P, ZERO).

    // --- $OrderColumnMajor ---
    .decl lex_diagonal(da: DiagAxis) lex_diagonal(DAXIS_DG).
    .decl lex_axis(a: Axis) lex_axis(AXIS_H).
}

.init params = Params

// The single-color objects of a grid, under each connectivity.
.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.decl obj_cell(o: Obj, p: Position)

// --- $FourConnected ---
// @claim select-hollow
.init comp4 = Components<Color>
comp4.node(Col, P) :- ink(P, Col).

obj_cell([$FourConnected(), Id], P) :- comp4.label(_, P, Id).

// --- $EightConnected ---
// @claim select-hollow
.init comp8 = Components8<Color>
comp8.node(Col, P) :- ink(P, Col).

obj_cell([$EightConnected(), Id], P) :- comp8.label(_, P, Id).

// --- $ColorObjects ---
// @claim select-hollow concatenate
.init obj_box = Bbox<Obj>
obj_box.cell(O, P) :- obj_cell(O, P).

.decl connectivity_choice(c: Connectivity)
connectivity_choice($FourConnected()). connectivity_choice($EightConnected()).

.decl keep_test_choice(k: KeepTest)
keep_test_choice($EnclosesHole()). keep_test_choice($SelectNotFull()).
keep_test_choice($SelectFewestCells()).

// --- $ColorObjects, $StoredTemplate ---
.decl axis_rule_choice(r: AxisRule)
axis_rule_choice($SeparatingAxis()). axis_rule_choice($AxisBbox()).

.decl order_rule_choice(o: OrderRule)
order_rule_choice($AlongAxis()). order_rule_choice($OrderColumnMajor()).

// StoredTemplate & AxisBbox is not a case.
.decl impl_choice(ch: Choice)
impl_choice([$ColorObjects(C, K), R, O]) :-
    connectivity_choice(C), keep_test_choice(K), axis_rule_choice(R), order_rule_choice(O).
impl_choice([$StoredTemplate(), R, O]) :-
    axis_rule_choice(R), R != $AxisBbox(), order_rule_choice(O).

// The box of each kept square.
.decl kept(sq: Squares, b: Box)

// A cell of a kept square, in the square's frame.
.decl sq_cell(sq: Squares, b: Box, p: Position, p_inner: Position)
sq_cell(Sq, B, P, P_inner) :- kept(Sq, B), in(P, _), crop(P, B, P_inner).

// The lines of axis a that a kept square covers.
.decl sq_line(sq: Squares, b: Box, a: Axis, l: Position)
sq_line(Sq, B, A, L) :- sq_cell(Sq, B, P, _), axis_elem(A), split(P, A, L, _).

// The axis the kept squares line up along.
.decl layout_axis(sq: Squares, r: AxisRule, a: Axis)

// A case's sequence runs from each edge of its layout axis.
.decl run(ch: Choice, d: Dir, a: Axis)
run([Sq, R, O], D, A) :- impl_choice([Sq, R, O]), layout_axis(Sq, R, A), axis_of(D, A).

// A kept square's place in the sequence from edge d.
.decl sq_score(rn: Run, b: Box, s: number)

// @claim order concatenate
.init sequence = Order<Run, SqLine>
sequence.elem([Ch, D], [B, L]) :- run(Ch, D, A), Ch = [Sq, _, _], sq_line(Sq, B, A, L).
sequence.score(Rn, [B, L], S) :- sq_score(Rn, B, S), sequence.elem(Rn, [B, L]).
sequence.secondary_score([Ch, D], [B, L], K) :-          // within one square
    sequence.elem([Ch, D], [B, L]), dist(L, D, K).

// The output cells of a case laid along axis a.
.decl laid(ch: Choice, a: Axis, p: Position, col: Color)
laid(Ch, A, P_grid, Col) :-
    run(Ch, D, A), Ch = [Sq, _, _],
    sequence.rank([Ch, D], [B, L], R), sequence.rank_desc([Ch, D], [B, L], R2),
    axis_inset(D, R, R2, P_along),                         // the line's place in the output
    sq_cell(Sq, B, P, P_inner), split(P, A, L, _), in(P, Col),
    split(P_inner, A, _, P_across),                        // the cell's place across the square
    compose(P_along, P_across, P_grid).

// --- $EnclosesHole ---
// The cells each object closes off from the grid edge.
// @claim select-hollow
.init hole = Closed<Obj>
hole.cell(O, P) :- obj_box.box(O, _), in(P, _), !obj_cell(O, P).

// The box of each object that closes off a params.bg cell.
.decl encloses(conn: Connectivity, b: Box)
encloses(C, B) :- obj_box.box([C, Id], B), hole.region([C, Id], P, _), in(P, Col), params.bg(Col).

kept($ColorObjects(C, $EnclosesHole()), B) :- encloses(C, B).

// --- $SelectNotFull ---
kept($ColorObjects(C, $SelectNotFull()), B) :-
    obj_box.box([C, Id], B), in(P, _), inside(P, B), !obj_cell([C, Id], P).

// --- $SelectFewestCells ---
// @claim select-hollow
.init obj_size = Tally<Obj, Position>
obj_size.item([C, Id], P) :- obj_cell([C, Id], P).
obj_size.domain([C, Id]) :- obj_cell([C, Id], _).

// @claim select-hollow
.init fewest = ArgExtremes<Connectivity, Ident>
fewest.cand(C, Id, N) :- obj_size.tally([C, Id], N).

kept($ColorObjects(C, $SelectFewestCells()), B) :-
    fewest.low(C, Id, _), obj_box.box([C, Id], B).

// --- $StoredTemplate ---
// The windows that match the template, one key per wall color.
// @claim select-hollow
.init window = Occurrences<Color, Color>
window.cell(Col, P, V) :- ink(_, Col), in(P, V).
window.shape(Col, S, Col) :- ink(_, Col), params.template_wall(S).
window.shape(Col, S, Bg) :- ink(_, Col), params.template_hole(S), params.bg(Bg).

kept($StoredTemplate(), B) :- window.occurrence(_, B).

// --- $SeparatingAxis ---
// Two kept squares share a line of axis a.
.decl overlap(sq: Squares, a: Axis)
overlap(Sq, A) :- sq_line(Sq, B1, A, L), sq_line(Sq, B2, A, L), B1 != B2.

layout_axis(Sq, $SeparatingAxis(), A) :-
    overlap(Sq, A2), perp(A, A2), !overlap(Sq, A).

out(P, Col, [Sq, $SeparatingAxis(), O]) :- laid([Sq, $SeparatingAxis(), O], _, P, Col).

// --- $AxisBbox ---
// The joint box of the kept squares.
// @claim axis
.init joint = Bbox<Squares>
joint.cell(Sq, B) :- kept(Sq, B).

layout_axis(Sq, $AxisBbox(), A) :-
    joint.box(Sq, B), in(P, _),
    perp(A, A2), box_extent(B, P, A, N), box_extent(B, P, A2, N2), N > N2.

out(P, Col, [Sq, $AxisBbox(), O]) :- laid([Sq, $AxisBbox(), O], _, P, Col).

// --- $AlongAxis ---
// The squares go by their distance to edge d.
sq_score([[Sq, R, $AlongAxis()], D], B, K) :-
    run([Sq, R, $AlongAxis()], D, _), kept(Sq, B), dist(B, D, K).

// --- $OrderColumnMajor ---
// Each kept square's corner at an end of params.lex_diagonal.
.decl lex_cell(sq: Squares, corner: DiagDir, b: Box, p: Position)
lex_cell(Sq, Dg, B, P) :-
    sq_cell(Sq, B, P, _), params.lex_diagonal(Da), diag_axis_of(Dg, Da), box_corner(P, B, Dg).

// @claim order
.init lex = LexOrder<Corner>
lex.corner([Sq, Dg], Dg) :- lex_cell(Sq, Dg, _, _).
lex.axis([Sq, Dg], A) :- lex_cell(Sq, Dg, _, _), params.lex_axis(A).
lex.cell([Sq, Dg], P) :- lex_cell(Sq, Dg, _, P).

sq_score([[Sq, R, $OrderColumnMajor()], D], B, Rk) :-
    run([Sq, R, $OrderColumnMajor()], D, A),
    lex_cell(Sq, Dg, B, P), dir_of(Dg, A, D),              // ordered from the corner at d
    lex.rank([Sq, Dg], P, Rk).

.comp Determine {
    // The shorter extent of an output.
    .decl square_side(k: number)
    square_side(K) :- ex_out(_, P, _), axis_dims(P, A, N, K), K < N.
}
