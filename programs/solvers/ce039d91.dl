// ce039d91
// concept: symmetry
// Symmetric-cell highlight: a params.mark cell whose whole-grid image under params.sym
// is also marked recolors to params.fill; every other cell passes through.

#include "../lib.dl"

.comp Params {
    .decl mark(c: Color) mark(5).
    .decl fill(c: Color) fill(1).
    .decl sym(d: D4) sym(D4_LR).
}

.init params = Params

.decl symmetric(p: Position)
symmetric(P) :-
    in(P, M), params.mark(M),                   // marked cell
    params.sym(D), apply(D, P, Q), in(Q, M).    // image also marked

.decl out(p: Position, col: Color)
out(P, F)   :- symmetric(P), params.fill(F).
out(P, Col) :- in(P, Col), !symmetric(P).
