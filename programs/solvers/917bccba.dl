// 917bccba
// @draft
// @keywords: lines border move occlude
// input: a rectangle outline in one ink, and a cross in another. The cross
//  is two full lines of the grid, and they meet inside the rectangle. The
//  rectangle covers the cross where the two overlap.
// output: the same scene, with the cross moved. The rectangle stays where it
//  is, and it still covers the cross.

// Which ink draws the rectangle.
.type Rect =
    // The ink whose cells draw a rectangle outline.
    Outline {}
    // The ink with no cell on the grid's border. The cross's lines run off
    // all four edges, so the other ink reaches that border.
  | Contained {}

// Where the cross's lines come to meet.
.type Landing =
    // At the rectangle's params.corner.
    Corner {}
    // The cross steps toward params.corner as a heading, until the
    // rectangle's border stops it. On every pair the cross starts on that
    // corner's diagonal, so the steps end at the corner.
  | Slide {}

.type Choice = [rect: Rect, landing: Landing]

.decl rect_choice(r: Rect)
rect_choice($Outline()). rect_choice($Contained()).

.decl landing_choice(l: Landing)
landing_choice($Corner()). landing_choice($Slide()).

.decl impl_choice(ch: Choice)
impl_choice([R, L]) :- rect_choice(R), landing_choice(L).

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // The rectangle corner the cross moves to.
    .decl corner(d: DiagDir) corner(DIAG_TR).
}

.init params = Params

// A cell in one of the scene's two inks.
.decl ink_cell(col: Color, p: Position)
ink_cell(Col, P) :- in(P, Col), !params.bg(Col).

// --- $Outline ---

.init outline = Outlines<Color>
outline.node(Col, P) :- ink_cell(Col, P).

// --- $Contained ---

.decl on_border(col: Color)
on_border(Col) :- ink_cell(Col, P), !interior(P, ZERO).

.init contained = Bbox<Color>
contained.cell(Col, P) :- ink_cell(Col, P), !on_border(Col).

// --- $Outline, $Contained ---

// The rectangle: its ink, and the box it draws.
.decl rect(r: Rect, col: Color, b: Box)
rect($Outline(), Col, B) :- outline.box(Col, B).
rect($Contained(), Col, B) :- contained.box(Col, B).

// The cross is drawn in the other ink.
.decl cross_col(r: Rect, col: Color)
cross_col(R, Col) :- ink_cell(Col, _), rect(R, _, _), !rect(R, Col, _).

// --- $Slide ---

.init cross_rim = Rim<Color>
cross_rim.cell(Col, P) :- ink_cell(Col, P).

// The cell the cross's two lines meet at.
.decl center(r: Rect, p: Position)
center(R, P) :-
    cross_col(R, Col), ink_cell(Col, P),  // a cross cell
    !cross_rim.rim(Col, P).               // with the cross on all four sides

.decl box_border(r: Rect, p: Position)
box_border(R, P) :- in(P, _), rect(R, _, B), box_edge(P, B, _).

.type Cast = [r: Rect, d: DiagDir]

.init slide = Ray<Cast>
slide.dir([R, D], D)     :- rect(R, _, _), params.corner(D).
slide.mark([R, D], P)    :- slide.dir([R, D], _), center(R, P).
slide.blocked([R, D], P) :- slide.dir([R, D], _), box_border(R, P).

// --- $Corner, $Slide ---

// Where the cross's lines meet after the move.
.decl landing(ch: Choice, p: Position)
landing([R, $Corner()], P) :-
    in(P, _), rect(R, _, B), params.corner(D), box_corner(P, B, D).
landing([R, $Slide()], P) :- params.corner(D), slide.stop([R, D], P, _, _, _).

.decl rect_cell(p: Position, r: Rect)
rect_cell(P, R) :- in(P, Col), rect(R, Col, _).

// The cross where it comes to rest: the two lines through where it lands.
.decl cross(p: Position, ch: Choice)
cross(P, Ch) :- landing(Ch, P_c), in(P, _), axis_elem(A), same_line(A, P, P_c).

out(P, Col, [R, L]) :-
    in(P, C), impl_choice([R, L]),
    ( rect_cell(P, R), Col = C                                  // the rectangle stays
    ; !rect_cell(P, R), cross(P, [R, L]), cross_col(R, Col)     // the moved cross under it
    ; !rect_cell(P, R), !cross(P, [R, L]), params.bg(Col)       // the rest is blank
    ).
