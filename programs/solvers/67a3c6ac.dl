// 67a3c6ac
// concept: d4
// Apply a D4 transform to every cell.

#include "../lib.dl"

.comp Consts {
    .decl transform(d: D4)
    transform(D4_LR).
}

.init c = Consts

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :- in(P_grid_in, Col), c.transform(D), apply(D, P_grid_in, P_grid_out).

// --- fit ---

.comp Fit {
    .decl broken(d: D4)
    broken(D) :- d4_elem(D), train_in(E, P, Col), apply(D, P, P2), !train_out(E, P2, Col).

    .decl transform(d: D4)
    transform(D) :- d4_elem(D), !broken(D).
}
