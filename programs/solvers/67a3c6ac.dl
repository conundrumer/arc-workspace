// 67a3c6ac
// keywords: d4
// output: Apply a D4 transform to every cell.

.decl out(p: Position, col: Color)

.comp Params {
    .decl transform(d: D4)
    transform(D4_LR).
}

.init params = Params

out(P_grid_out, Col) :- in(P_grid_in, Col), params.transform(D), apply(D, P_grid_in, P_grid_out).
