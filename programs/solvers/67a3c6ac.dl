// 67a3c6ac
// concept: d4
// Apply a D4 transform to every cell.

#include "../lib.dl"

.comp Params {
    .decl transform(d: D4)
    transform(D4_LR).
}

.init params = Params

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :- in(P_grid_in, Col), params.transform(D), apply(D, P_grid_in, P_grid_out).
