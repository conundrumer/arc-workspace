// 973e499e
// concept: tile-arrangement stamp
// Self-tile. Output decomposes into tiles laid out like the input; the
// tile at P_tile is a copy of the input keeping cells of color
// in(P_tile), others bg.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_tile, Col), in(P_intile, Col),                 // matched: tile & intile share Col
    concat_2d(P_tile, P_intile, 0, P_grid_out).         // 2D recompose

out(P_grid_out, BG) :-
    in(P_tile, Col_m), in(P_intile, Col_i),             // mismatched: tile & intile distinct
    Col_m != Col_i, params.bg(BG),
    concat_2d(P_tile, P_intile, 0, P_grid_out).         // 2D recompose
