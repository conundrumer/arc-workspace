// 25d8a9c8
// concept: lines lookup count classify
// Each slice's cells are recolored uniformly: c.uniform_color if the
// slice has a single color, else c.non_uniform_color. Slices run along
// c.axis. Whole-slice replacement — input colors are discarded.
//
// Cartesian over (detect, stage); out's choice column is a record:
//
//   detect:
//     $PairExist() — same-slice pair with distinct colors (relational)
//     $Count()     — distinct-color count, mapped per-count via c.count_color
//
//   stage:
//     $PerCell()  — slice classification → single replacement color
//     $SliceMap() — slice classification → row template

#include "../lib.dl"

.type Detect = PairExist {} | Count {}
.type Stage  = PerCell {} | SliceMap {}
.type Choice = [detect: Detect, stage: Stage]

.comp Consts {
    .decl axis(a: Axis) axis(AXIS_H).

    // PerCell single-color replacements.
    .decl uniform_color(c: Color) uniform_color(5).
    .decl non_uniform_color(c: Color) non_uniform_color(0).

    // Per-count → output color.
    .decl count_color(n: number, col: Color)
    count_color(1, 5).
    count_color(2, 0).

    // SliceMap row templates — whole-row replacement as data.
    .decl uniform_template(p: Position, col: Color)
    GRID_1x3(uniform_template, 5, 5, 5)

    .decl non_uniform_template(p: Position, col: Color)
    GRID_1x3(non_uniform_template, 0, 0, 0)

    // Per-count row template — same rows as the PairExist templates here.
    .decl count_template(n: number, p_inner: Position, col: Color)
    GRID_1x3(count_template, 1, 5, 5, 5)
    GRID_1x3(count_template, 2, 0, 0, 0)
}

.init c = Consts

// --- parse ---

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    // Each cell paired with its along/across split on c.axis.
    .decl cell_split(k: Key, p: Position, col: Color, p_inner: Position, p_across: Position)
    cell_split(K, P, Col, P_inner, P_across) :-
        cell(K, P, Col), c.axis(A), split(P, A, P_inner, P_across).

    // $PairExist: same-slice pair with distinct colors.
    .decl differing_pair(k: Key, p_across: Position)
    differing_pair(K, P_across) :-
        cell_split(K, _, Col1, _, P_across), cell_split(K, _, Col2, _, P_across),
        Col1 != Col2.

    // $Count: distinct-color count per slice.
    .type KA = [k: Key, across: Position]

    .init slice_palette = Tally<KA, Color>
    slice_palette.item([K, P_across], Col) :- cell_split(K, _, Col, _, P_across).

    .decl ncolors(k: Key, p_across: Position, n: number)
    ncolors(K, P_across, N) :- slice_palette.tally([K, P_across], N).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)

// $PairExist + $PerCell
out(P, Col, [$PairExist(), $PerCell()]) :-
    parse.cell_split($U(), P, _, _, P_across),                      // cell, its slice
    ( !parse.differing_pair($U(), P_across), c.uniform_color(Col)   // slice agrees
    ; parse.differing_pair($U(), P_across), c.non_uniform_color(Col)   // slice differs
    ).

// $PairExist + $SliceMap
out(P, Col, [$PairExist(), $SliceMap()]) :-
    parse.cell_split($U(), P, _, P_inner, P_across),                            // cell, its slice
    ( !parse.differing_pair($U(), P_across), c.uniform_template(P_inner, Col)   // slice agrees
    ; parse.differing_pair($U(), P_across), c.non_uniform_template(P_inner, Col)   // slice differs
    ).

// $Count + $PerCell
out(P, Col, [$Count(), $PerCell()]) :-
    parse.cell_split($U(), P, _, _, P_across),
    parse.ncolors($U(), P_across, N), c.count_color(N, Col).

// $Count + $SliceMap
out(P, Col, [$Count(), $SliceMap()]) :-
    parse.cell_split($U(), P, _, P_inner, P_across),
    parse.ncolors($U(), P_across, N), c.count_template(N, P_inner, Col).

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The output color at each input cell, in slice coordinates.
    .decl slice_out(e: Example, p_across: Position, p_inner: Position, col: Color)
    slice_out(E, P_across, P_inner, Col) :-
        parse.cell_split(E, P, _, P_inner, P_across),    // input cell's slice
        ex_out(E, P, Col).                               // its output color

    .decl count_color(n: number, col: Color)
    count_color(N, Col) :- parse.ncolors(E, P_across, N), slice_out(E, P_across, _, Col).

    .decl count_template(n: number, p_inner: Position, col: Color)
    count_template(N, P_inner, Col) :-
        parse.ncolors(E, P_across, N), slice_out(E, P_across, P_inner, Col).

    .decl uniform_template(p: Position, col: Color)
    uniform_template(P_inner, Col) :-
        slice_out(E, P_across, P_inner, Col), !parse.differing_pair(E, P_across).

    .decl non_uniform_template(p: Position, col: Color)
    non_uniform_template(P_inner, Col) :-
        slice_out(E, P_across, P_inner, Col), parse.differing_pair(E, P_across).
}
