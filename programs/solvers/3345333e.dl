// 3345333e
// draft
// keywords: symmetry repair
// input: A figure mirror-symmetric across a line of params.axis, occluded by
//  a solid rectangle of a second color.
// output: The output erases the rectangle and restores what it hid. The
//  mirror line varies per pair, so each case derives it, as the frame its
//  flip acts in.

// which frame the mirror repair acts in
.type Choice =
    // the line centers the figure's extent in the lines the rectangle misses;
    // every figure cell gains its mirror image
    Complete {}
    // the same line; only the occluded cells fill
  | Patch {}
    // the line no visible figure cell contradicts: each cell's image is a
    // figure cell or an occluded one. Both scopes agree under it, so it carries
    // one case
  | Fitted {}

// Two figure cells a candidate mirror swaps.
.type Pair = [p: Position, q: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The axis the mirror inverts.
    .decl axis(a: Axis) axis(AXIS_H).
}

.init params = Params

// --- shared ---

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// The occluder is the color whose cells fill their bounding box; the figure
// is the other one.
.init color_box = Bbox<Color>
color_box.cell(Col, P) :- ink(P, Col).

.decl gap(col: Color)
gap(Col) :- color_box.box(Col, B), in(P, _), inside(P, B), !in(P, Col).

.decl occluder(p: Position)
occluder(P) :- ink(P, Col), !gap(Col).

.decl figure(p: Position, col: Color)
figure(P, Col) :- ink(P, Col), gap(Col).

// The mirror acts within each line of params.axis, so an occluder cell cuts the
// figure on its own line.
.decl damaged(p: Position)
damaged(P) :- figure(P, _), occluder(Q), params.axis(A), same_line(A, P, Q).

// The figure where it is whole.
.init whole = Bbox<Unit>
whole.cell($U(), P) :- figure(P, _), !damaged(P).

// A candidate mirror swaps two figure cells of one line.
.decl pair(p: Position, q: Position)
pair(P, Q) :- figure(P, _), figure(Q, _), params.axis(A), same_line(A, P, Q).

.init pair_box = Bbox<Pair>
pair_box.cell([P, Q], P) :- pair(P, Q).
pair_box.cell([P, Q], Q) :- pair(P, Q).

.decl cand(b: Box)
cand(B) :- pair_box.box(_, B).

// The frames a mirror may act in.
.decl mirror_frame(b: Box)
mirror_frame(B) :- whole.box($U(), B).
mirror_frame(B) :- cand(B).

// Cells whose views in frame B are flip-related.
.decl mirror(b: Box, p: Position, q: Position)
mirror(B, P, Q) :-
    mirror_frame(B), in(P, _), relative(B, P, P_inner),        // the cell as frame B sees it
    params.axis(A), flip_of(A, D), apply(D, P_inner, Q_inner), // the flip
    compose(B, Q_inner, Q), in(Q, _).                          // its image, back on the grid

// The frame each case mirrors in.
.decl frame(b: Box, ch: Choice)

// The cells each case's repair may touch.
.decl target(p: Position, ch: Choice)

.decl paint(p: Position, col: Color, ch: Choice)
paint(Q, Col, Ch) :-
    figure(P, Col), frame(B, Ch), mirror(B, P, Q),   // a figure cell's mirror image
    target(Q, Ch).                                   // where the case repairs

.decl impl_choice(ch: Choice)
impl_choice($Complete()). impl_choice($Patch()). impl_choice($Fitted()).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :-
    in(P, Col_in), impl_choice(Ch), !paint(P, _, Ch),
    ( !occluder(P), Col = Col_in     // the figure and its field pass through
    ; occluder(P), params.bg(Col)    // the rectangle is erased
    ).

// --- $Complete ---

frame(B, $Complete()) :- whole.box($U(), B).
target(P, $Complete()) :- in(P, _).

// --- $Patch ---

frame(B, $Patch()) :- whole.box($U(), B).
target(P, $Patch()) :- occluder(P).

// --- $Fitted ---

// The candidate carries the figure cell onto a figure cell or an occluded
// one — the two places the whole figure reaches.
.decl upheld(b: Box, p: Position)
upheld(B, P) :- mirror(B, P, Q), ( figure(Q, _) ; occluder(Q) ).

.decl contradicted(b: Box)
contradicted(B) :- cand(B), figure(P, _), !upheld(B, P).

frame(B, $Fitted()) :- cand(B), !contradicted(B).
target(P, $Fitted()) :- in(P, _).
