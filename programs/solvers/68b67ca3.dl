// Extract every other cell (TL-anchored, stride 2) from a 6×6 grid into a
// dense 3×3. The stride pattern lives in the labeled input grid: kept cells
// carry distinct labels, skipped cells are 0. Output labels are dense.

#include "../lib.dl"

.comp Consts {
    .decl in_label(p: Position, lbl: number)
    GRID_6x6(in_label,
        1, 0, 2, 0, 3, 0,
        0, 0, 0, 0, 0, 0,
        4, 0, 5, 0, 6, 0,
        0, 0, 0, 0, 0, 0,
        7, 0, 8, 0, 9, 0,
        0, 0, 0, 0, 0, 0)

    .decl out_label(p: Position, lbl: number)
    GRID_3x3(out_label,
        1, 2, 3,
        4, 5, 6,
        7, 8, 9)

    .decl perm(p_in: Position, p_out: Position)
    perm(P_IN, P_OUT) :- in_label(P_IN, LBL), out_label(P_OUT, LBL), LBL != 0.
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_OUT, COL) :- in(P_IN, COL), c.perm(P_IN, P_OUT).

.output out(IO=stdout)
