// Layout: 6×6 input collapsed to 3×3 by per-axis division; the anchor cell
// of each inner subgrid is kept, others drop.
//
// Cartesian over body impls; out's choice column tags each:
//
//   $LabeledGrids() — paired by shared non-zero label across in/out grids
//   $Stride()       — divide each axis, corner_anchor inner subgrid against ORIGIN

#include "../lib.dl"

.type Choice = LabeledGrids {} | Stride {}

.comp Consts {
    // --- LabeledGrids data ----------------------------------------------
    .decl in_label(p: Position, lbl: number)
    GRID_6x6(in_label,
        1, 0, 2, 0, 3, 0,
        0, 0, 0, 0, 0, 0,
        4, 0, 5, 0, 6, 0,
        0, 0, 0, 0, 0, 0,
        7, 0, 8, 0, 9, 0,
        0, 0, 0, 0, 0, 0)

    .decl out_label(p: Position, lbl: number)
    GRID_3x3(out_label,
        1, 2, 3,
        4, 5, 6,
        7, 8, 9)

    // --- Stride params --------------------------------------------------
    .decl anchor(d: DiagDir)        anchor(TOP_LEFT).
    .decl divisor(n: Dim)           divisor([3, 3]).
    .decl divide_gap(g: Dim)        divide_gap([0, 0]).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl impl_choice(c: Choice)
impl_choice($LabeledGrids()).
impl_choice($Stride()).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :-
    c.in_label(P_grid_in, Lbl), c.out_label(P_grid_out, Lbl),       // shared label
    Lbl != 0.                                                       // non-pairing sentinel

perm(P_grid_in, P_grid_out, $Stride()) :-
    in(P_grid_in, _),                                               // input cell
    c.anchor(D), c.divisor(N), c.divide_gap(G),                     // params
    divide_2d(P_grid_in, N, G, P_grid_out, P_intile),               // 2D divide
    corner_anchor(D, P_intile, ORIGIN).                             // inner at corner D

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Impl) :- impl_choice(Impl), in(P_grid_in, Col), perm(P_grid_in, P_grid_out, Impl).

.output out(IO=stdout)
