// 68b67ca3
// concept: decompose lookup select
// 6×6 input collapsed to 3×3 by per-axis division; the anchor-corner cell
// of each subgrid is kept, others drop. Two models:
//
//   $LabeledGrids — the collapse as data: in/out label grids paired by
//                   shared non-zero label
//   $Divide       — the collapse composed: 2D divide; keep the intile cell
//                   at corner c.anchor

#include "../lib.dl"

.type Choice = LabeledGrids {} | Divide {}

.comp Consts {
    // --- LabeledGrids data ---
    .decl in_label(p: Position, id: Ident)
    GRID_6x6(in_label,
        1, 0, 2, 0, 3, 0,
        0, 0, 0, 0, 0, 0,
        4, 0, 5, 0, 6, 0,
        0, 0, 0, 0, 0, 0,
        7, 0, 8, 0, 9, 0,
        0, 0, 0, 0, 0, 0)

    .decl out_label(p: Position, id: Ident)
    GRID_3x3(out_label,
        1, 2, 3,
        4, 5, 6,
        7, 8, 9)

    // --- Divide params ---
    .decl anchor(d: DiagDir) anchor(DIAG_TL).
    .decl divisor(n: number) divisor(3).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($LabeledGrids()).
impl_choice($Divide()).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :-
    c.in_label(P_grid_in, Id), c.out_label(P_grid_out, Id),        // shared label
    Id != 0.                                                       // non-pairing sentinel

perm(P_grid_in, P_grid_out, $Divide()) :-
    in(P_grid_in, _),                                               // input cell
    c.anchor(D), c.divisor(N),                                      // params
    divide_2d(P_grid_in, N, 0, P_grid_out, P_intile),               // 2D divide
    corner_anchor(D, P_intile, ORIGIN).                             // inner at corner D

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Impl) :- impl_choice(Impl), in(P_grid_in, Col), perm(P_grid_in, P_grid_out, Impl).
