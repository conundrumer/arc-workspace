// 68b67ca3
// @keywords: decompose lookup select
// output: 6×6 input collapsed to 3×3 by per-axis division; the cell at corner
//  params.anchor of each subgrid is kept, and the others drop.

// out's choice column (decompose)
.type Choice =
    // tabulated as in/out label grids paired by shared label
    LabeledGrids {}
    // by tile count
  | Count {}
    // by tile size
  | Size {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    // --- LabeledGrids ---
    .decl in_label(p: Position, id: Ident)
    GRID_SPARSE_6x6(in_label,
        1, _, 2, _, 3, _,
        _, _, _, _, _, _,
        4, _, 5, _, 6, _,
        _, _, _, _, _, _,
        7, _, 8, _, 9, _,
        _, _, _, _, _, _)

    .decl out_label(p: Position, id: Ident)
    GRID_3x3(out_label,
        1, 2, 3,
        4, 5, 6,
        7, 8, 9)

    .decl map(p_in: Position, p_out: Position)
    map(P_in, P_out) :- in_label(P_in, Id), out_label(P_out, Id).

    // --- Count, Size ---
    .decl anchor(d: DiagDir) anchor(DIAG_TL).

    // --- Count ---
    .decl divisor(n: number) divisor(3).

    // --- Size ---
    .decl tile_size(k: number) tile_size(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($LabeledGrids()).
impl_choice($Count()).
impl_choice($Size()).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :- params.map(P_grid_in, P_grid_out).

perm(P_grid_in, P_grid_out, $Count()) :-
    in(P_grid_in, _),                                       // input cell
    params.anchor(D), params.divisor(N),
    divide_2d(P_grid_in, N, 0, P_grid_out, P_intile),
    corner_anchor(D, P_intile, ZERO).                     // the tile's corner-D cell

perm(P_grid_in, P_grid_out, $Size()) :-
    in(P_grid_in, _),                                       // input cell
    params.anchor(D), params.tile_size(K),
    divide_by_size_2d(P_grid_in, K, 0, P_grid_out, P_intile),
    corner_anchor(D, P_intile, ZERO).                     // the tile's corner-D cell

out(P_grid_out, Col, Impl) :-
    impl_choice(Impl), in(P_grid_in, Col),   // choice × input cell
    perm(P_grid_in, P_grid_out, Impl).       // the cell's image

.comp Determine {
    // Correspondence candidates: same color at both cells.
    .decl cand(e: Example, p_in: Position, p_out: Position)
    cand(E, P_in, P_out) :- ex_in(E, P_in, C), ex_out(E, P_out, C).

    // A within-example color coincidence breaks in some other example.
    .decl broken(p_in: Position, p_out: Position)
    broken(P_in, P_out) :-
        cand(_, P_in, P_out), ex_out(E, _, _), !cand(E, P_in, P_out).

    .decl pair(p_in: Position, p_out: Position)
    pair(P_in, P_out) :- cand(_, P_in, P_out), !broken(P_in, P_out).

    .decl in_label(p: Position, id: Ident)
    in_label(P_in, as(ord(P_in), Ident)) :- pair(P_in, _).

    .decl out_label(p: Position, id: Ident)
    out_label(P_out, as(ord(P_in), Ident)) :- pair(P_in, P_out).
}
