// 8ee62060
// concept: decompose d4
// Layout: d4 on the K×K block-grid. Each block stays as-is internally; the
// d4 transform applies to the block-grid coordinates.
//
// Alts (d4 choice; data-equivalent on this task):
//   $FlipTB() — D4_TB
//   $FlipLR() — D4_LR
//   $RotCW()  — D4_CW
//   $RotCCW() — D4_CC

#include "../lib.dl"

.type Choice = FlipTB {} | FlipLR {} | RotCW {} | RotCCW {}

.comp Consts {
    .decl block_d4(d: D4, c: Choice)
    block_d4(D4_TB, $FlipTB()).
    block_d4(D4_LR, $FlipLR()).
    block_d4(D4_CW, $RotCW()).
    block_d4(D4_CC, $RotCCW()).

    .decl block_size(k: number)
    block_size(2).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, c: Choice)
out(P_out, Col, Ch) :-
    in(P_in, Col),                                                // input cell
    c.block_d4(D, Ch), c.block_size(K),                           // params
    divide_by_size_2d(P_in, K, 0, P_block_in, P_local),           // forward decompose
    apply(D, P_block_in, P_block_out),                            // d4 on block-grid
    concat_2d(P_block_out, P_local, 0, P_out).                    // recompose

.output out(IO=stdout)
