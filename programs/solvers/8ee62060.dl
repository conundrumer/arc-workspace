// 8ee62060
// @keywords: decompose d4
// @scene diagonal: the grid divides into blocks of params.block_size, and the
//  blocks that hold content sit on one diagonal of the block-grid.
// @rule swap: each block keeps its contents, and moves in the block-grid by
//  each D4 element that moves some block of the input onto a block of other
//  content; the model is undefined where two such elements put different
//  colors on one cell.

.comp Params {
    .decl block_size(k: number)
    block_size(2).
}

.init params = Params

// At each within-block offset, the input's block-grid, matched against
// itself.
// @claim diagonal swap
.init block = D4Map<Position, Color>
block.src(P_local, P_block, Col) :-
    in(P, Col), params.block_size(K),
    divide_by_size_2d(P, K, 0, P_block, P_local).    // its block, and its cell in that block
block.dst(Ky, P_block, Col) :- block.src(Ky, P_block, Col).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    block.src(P_local, P_block_in, Col),                     // input cell, by its block and its cell in that block
    block.mismatch(_, D), apply(D, P_block_in, P_block_out), // the block moves
    concat_2d(P_block_out, P_local, 0, P_out).               // back to grid coordinates
