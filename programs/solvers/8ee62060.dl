// 8ee62060
// concept: decompose d4
// Layout: d4 on the K×K block-grid. Each block stays as-is internally; the
// d4 transform applies to the block-grid coordinates.
//
// The blocks sit on a diagonal of the block-grid, so every d4 element that
// moves that diagonal produces the same output; the task pins none. One
// $Blocks candidate per element in c.block_d4.

#include "../lib.dl"

.type Choice = Blocks {d: D4}

.comp Consts {
    .decl block_d4(d: D4)
    block_d4(D4_TB).
    block_d4(D4_LR).
    block_d4(D4_CW).
    block_d4(D4_CC).

    .decl block_size(k: number)
    block_size(2).
}

.init c = Consts

.decl out(p: Position, col: Color, c: Choice)
out(P_out, Col, $Blocks(D)) :-
    in(P_in, Col),                                                // input cell
    c.block_d4(D), c.block_size(K),                               // params
    divide_by_size_2d(P_in, K, 0, P_block_in, P_local),           // forward decompose
    apply(D, P_block_in, P_block_out),                            // d4 on block-grid
    concat_2d(P_block_out, P_local, 0, P_out).                    // recompose

// --- fit ---

.comp Fit {
    // A transform that lands some input cell off the output's color.
    .decl mismatch(d: D4)
    mismatch(D) :-
        ex_in(E, P_in, Col), ex_out(E, _, _),                       // cell of a train input
        c.block_size(K),
        divide_by_size_2d(P_in, K, 0, P_block_in, P_local),         // forward decompose
        d4_elem(D), apply(D, P_block_in, P_block_out),              // d4 on block-grid
        concat_2d(P_block_out, P_local, 0, P_out),                  // recompose
        !ex_out(E, P_out, Col).

    .decl block_d4(d: D4)
    block_d4(D) :- d4_elem(D), !mismatch(D).
}
