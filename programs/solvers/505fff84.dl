// 505fff84
// keywords: lines markers span rank move
// input: Noise rows; the two marker colors bracket one segment per marked
//  row.
// output: The output stacks the strictly-between segments: contributing
//  rows take their order positions; each segment shifts flush to the edge.

// data-equivalent on this task — every marked row has 1 west of 8
.type Choice =
    // the marker pair brackets a segment regardless of side
    Set {}
    // each marker has a fixed end: params.side's color sits at its dir
  | Sided {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl axis(a: Axis)
    axis(AXIS_H).            // marked lines run along this axis

    .decl marker(c: Color)
    marker(1). marker(8).

    // --- Sided ---
    .decl side(d: Dir, c: Color)
    side(DIR_L, 1). side(DIR_R, 8).
}

.init params = Params

.decl seg(p: Position, ch: Choice)

// --- Set ---
.init set_spans = Between<Unit>
set_spans.axis($U(), A) :- params.axis(A).
set_spans.cell($U(), P) :- in(P, Col), !params.marker(Col).
set_spans.mark($U(), P) :- in(P, Col), params.marker(Col).

seg(P, $Set()) :- set_spans.between($U(), P).

// --- Sided ---
.init sided_rays = Ray<Color>
sided_rays.dir(Cm, D)   :- params.marker(Cm), params.axis(A), axis_of(D, A).
sided_rays.cell(Cm, P)  :- params.marker(Cm), in(P, Col), !params.marker(Col).
sided_rays.mark(Col, P) :- in(P, Col), params.marker(Col).

// The marks on their own ends. A ray toward d means its mark lies away
// from d, so each end's color casts toward the opposite end.
seg(P, $Sided()) :-
    params.side(D, C1), opposite(D, O), params.side(O, C2),         // the ends' colors
    sided_rays.ray(C1, P, O, _, _), sided_rays.ray(C2, P, D, _, _).   // each mark at its end

// Segment cells split into their row and their position along it.
.decl seg_split(p_along: Position, row: Position, col: Color, ch: Choice)
seg_split(P_along, Row, Col, Ch) :-
    seg(P, Ch), in(P, Col), params.axis(A), split(P, A, P_along, Row).

// Out placement: contributing rows take their order positions.
.init rows = OrderFrame<Choice, Position>
rows.axis(Ch, A2)         :- seg_split(_, _, _, Ch), params.axis(A), perp(A, A2).
rows.member(Ch, Row, Row) :- seg_split(_, Row, _, Ch).

// Each segment shifts flush: its cells re-expressed from its own bounding
// box.
.type SegKey = [ch: Choice, row: Position]

.init shift = Bbox<SegKey>
shift.cell([Ch, Row], P_along) :- seg_split(P_along, Row, _, Ch).

out(P_out, Col, Ch) :-
    rows.pos(Ch, Row, P_outer_v),                          // the row's out position
    seg_split(P_along, Row, Col, Ch),                      // a segment cell with its color
    shift.box([Ch, Row], B), crop(P_along, B, P_inner_h),  // its out column
    compose(P_outer_v, P_inner_h, P_out).

.comp Determine {
    .decl mark(e: Example, row: Position, p: Position, col: Color)
    mark(E, Row, P, Col) :-
        ex_in(E, P, Col), params.marker(Col),
        params.axis(A), split(P, A, _, Row).

    // Of a row's marker pair, each end's color is the one nearer it.
    .decl side(d: Dir, c: Color)
    side(D, C) :-
        mark(E, Row, P, C), mark(E, Row, Q, C2), C != C2,
        params.axis(A), axis_of(D, A), nearer(D, P, Q).
}
