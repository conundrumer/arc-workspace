// 505fff84
// concept: lines markers span rank move
// Noise rows; the two marker colors bracket one segment per marked row.
// The output stacks the strictly-between segments: contributing rows take
// their order positions; each segment shifts flush to the edge.
//
// Cases (data-equivalent on this task — every marked row has 1 west of 8):
//   $Set()   — the marker pair brackets a segment regardless of side
//   $Sided() — each marker has a fixed end: c.side's color sits at its dir

#include "../lib.dl"

.type Choice = Set {} | Sided {}

.comp Consts {
    // --- shared ---
    .decl axis(a: Axis)
    axis(AXIS_H).            // marked lines run along this axis

    .decl marker(c: Color)
    marker(1). marker(8).

    // --- Sided ---
    .decl side(d: Dir, c: Color)
    side(DIR_L, 1). side(DIR_R, 8).
}

.init c = Consts

.decl seg(p: Position, ch: Choice)

// --- Set ---
.init set_spans = Between<Unit>
set_spans.axis(A)       :- c.axis(A).
set_spans.cell(P)       :- in(P, Col), !c.marker(Col).
set_spans.mark($U(), P) :- in(P, Col), c.marker(Col).

seg(P, $Set()) :- set_spans.between($U(), P).

// --- Sided ---
.init sided_rays = Ray<Color>
sided_rays.dir(D)       :- c.axis(A), axis_of(D, A).
sided_rays.cell(P)      :- in(P, Col), !c.marker(Col).
sided_rays.mark(Col, P) :- in(P, Col), c.marker(Col).

// The marks on their own ends. A ray toward d means its mark lies away
// from d, so each end's color casts toward the opposite end.
seg(P, $Sided()) :-
    c.side(D, C1), opposite(D, O), c.side(O, C2),         // the ends' colors
    sided_rays.ray(C1, P, O), sided_rays.ray(C2, P, D).   // each mark at its end

// The order-canonical peer of AxisFrame: the dense frame that a sparse set
// of axis-only positions induces, with each member's position in it.
// Members order by coordinate; no end is privileged.
.comp OrderFrame<Key> {
    .decl axis(a: Axis)
    .decl cell(key: Key, p: Position)

    // Member p strictly nearer edge d than member q.
    .decl nearer(key: Key, d: Dir, p: Position, q: Position)
    nearer(Ky, D, P, Q) :-
        cell(Ky, P), cell(Ky, Q),
        axis(A), axis_of(D, A),
        dist(P, D, K1), dist(Q, D, K2), K1 < K2.

    // Position in the induced frame: distance toward each edge = count
    // of nearer members.
    .decl pos(key: Key, p: Position, p_pos: Position)
    pos(Ky, P, P_pos) :-
        cell(Ky, P), axis(A), axis_of(D, A), opposite(D, O),
        R1 = count : { nearer(Ky, D, Q1, P) }, edge_delta(D, R1, P1),
        R2 = count : { nearer(Ky, O, Q2, P) }, edge_delta(O, R2, P2),
        compose(P1, P2, P_pos).
}

// Segment cells split into their row and their position along it.
.decl seg_split(p_along: Position, row: Position, col: Color, ch: Choice)
seg_split(P_along, Row, Col, Ch) :-
    seg(P, Ch), in(P, Col), c.axis(A), split(P, A, P_along, Row).

// Out placement: contributing rows take their order positions.
.init rows = OrderFrame<Choice>
rows.axis(A2)      :- c.axis(A), perp(A, A2).
rows.cell(Ch, Row) :- seg_split(_, Row, _, Ch).

// Each segment shifts flush: its cells re-expressed from its own bounding
// frame.
.type SegKey = [ch: Choice, row: Position]

.init shift = BoxFrame<SegKey>
shift.cell([Ch, Row], P_along) :- seg_split(P_along, Row, _, Ch).

.decl out(p: Position, col: Color, c: Choice)
out(P_out, Col, Ch) :-
    rows.pos(Ch, Row, P_v),                   // the row's out position
    shift.inner([Ch, Row], P_along, P_h),     // an out column
    seg_split(P_along, Row, Col, Ch),         // its color
    compose(P_v, P_h, P_out).

// --- fit ---

.comp Fit {
    .decl mark(e: Example, row: Position, p: Position, col: Color)
    mark(E, Row, P, Col) :-
        ex_in(E, P, Col), c.marker(Col),
        c.axis(A), split(P, A, _, Row).

    // Of a row's marker pair, each end's color is the one nearer it.
    .decl side(d: Dir, c: Color)
    side(D, C) :-
        mark(E, Row, P, C), mark(E, Row, Q, C2), C != C2,
        c.axis(A), axis_of(D, A),
        dist(P, D, K1), dist(Q, D, K2), K1 < K2.
}
