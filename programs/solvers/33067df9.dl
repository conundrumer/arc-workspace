// 33067df9
// keywords: decompose scale merge
// input: The input is a lattice: single-cell tiles ruled off by single-cell
//  lines, with a line on every side.
// output: The output redraws that lattice on a fixed square canvas, with
//  two-cell lines and tiles as large as the canvas admits. Like-colored tiles
//  join. Along the run axis, neighbors join into a run; across it, a run
//  joins the run one step over when the two cover the same tiles. A joined
//  group paints the box its output tiles span, so the lines inside the group
//  are painted over.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // Lattice widths.
    .decl in_line(k: number) in_line(1).
    .decl in_tile(k: number) in_tile(1).
    .decl out_line(k: number) out_line(2).

    .decl canvas_side(n: number) canvas_side(26).

    .decl run_axis(a: Axis) run_axis(AXIS_H).
}

.init params = Params

// --- the input lattice ---

// The color each lattice tile holds.
.decl tile_col(p_tile: Position, col: Color)
tile_col(P_tile, Col) :-
    in(P_grid_in, Col), params.in_line(G),
    uniform_inset(G, B), crop(P_grid_in, B, P_field),               // a cell off the lines
    params.in_tile(K),
    divide_by_size_2d(P_field, K, G, P_tile, _).                    // the tile it fills

.decl ink(p_tile: Position, col: Color)
ink(P_tile, Col) :- tile_col(P_tile, Col), !params.bg(Col).

// --- runs ---

// Like tiles neighboring along the run axis make a run.
.init run = Slide<Color>
run.node(Col, P_tile) :- ink(P_tile, Col).
run.dir(Col, D) :- ink(_, Col), params.run_axis(A), axis_of(D, A).

// How far the run reaches toward d, as its end tile's distance to edge d.
.decl run_reach(p_tile: Position, d: Dir, k: number)
run_reach(P_tile, D, K) :-
    ink(P_tile, Col), run.rest(Col, P_tile, D, E_tile),  // where the tile's run ends
    dist(E_tile, D, K).

// The tiles the run covers: its reach at both ends, packed onto the run axis.
// Edge distances, so one line's run compares against another's.
.init span = DirPack<Position>
span.edge(P_tile, D, K) :- run_reach(P_tile, D, K).

// --- groups ---

.decl join(p_tile: Position, q_tile: Position)
join(P_tile, Q_tile) :-
    ink(P_tile, Col), ink(Q_tile, Col), params.run_axis(A),   // like tiles
    ( axis_of(D, A), neighbor(P_tile, D, Q_tile)              // one step along the run axis
    ; perp(A, A2), axis_of(D_across, A2),                     // or one step across it,
      neighbor(P_tile, D_across, Q_tile),
      span.axis_pos(P_tile, A, P_span),
      span.axis_pos(Q_tile, A, P_span)                   // over the same tiles
    ).

// A group is what the joins connect.
.init group = Canon<Position>
group.equiv(P_tile, P_tile) :- ink(P_tile, _).
group.equiv(P_tile, R_tile) :- group.equiv(P_tile, Q_tile), join(Q_tile, R_tile).

// --- the output lattice ---

.init canvas = Frame2D<Unit>
canvas.extent($U(), A, N) :- axis_elem(A), params.canvas_side(N).

// A canvas cell off the lines, in the field's frame.
.decl out_field(p_grid_out: Position, p_field: Position)
out_field(P_grid_out, P_field) :-
    canvas.cell($U(), P_grid_out),
    params.out_line(K), uniform_inset(K, B), crop(P_grid_out, B, P_field).

// The canvas holds as many tiles as the input does, so its field fixes how
// large they come out.
.init out_cells = Divide2D<Unit>
out_cells.cell(P_field) :- out_field(_, P_field).
out_cells.dim($U(), A, N) :- tile_col(P_tile, _), axis_elem(A), axis_dim(P_tile, A, N).
out_cells.gap(G) :- params.out_line(G).

// --- render ---

.init group_box = Bbox<Ident>
group_box.cell(Id, P_grid_out) :-
    group.id(P_tile, Id),                                    // a group's tile
    out_field(P_grid_out, P_field),
    out_cells.tile($U(), P_field, P_tile, _).                // the canvas cells it holds

.decl paint(p_grid_out: Position, col: Color)
paint(P_grid_out, Col) :-
    group_box.box(Id, B),
    canvas.cell($U(), P_grid_out), inside(P_grid_out, B),  // a canvas cell the box covers
    group.id(P_tile, Id), ink(P_tile, Col).                // painted in the group's color

out(P_grid_out, Col) :-
    canvas.cell($U(), P_grid_out),
    ( paint(P_grid_out, Col)                   // a group's box
    ; !paint(P_grid_out, _), params.bg(Col)    // bare canvas
    ).
