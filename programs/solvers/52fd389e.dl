// 52fd389e
// draft
// concept: objects markers count border
// Rectangles of params.body sit on the grid, each holding marker cells of one
// other color. A band of that marker color surrounds its rectangle, as many
// cells thick as the rectangle holds markers.

#include "../lib.dl"

.comp Params {
    .decl body(col: Color) body(4).
}

.init params = Params

.init rects = Components<Unit>
rects.node($U(), P) :- in(P, Col), params.body(Col).

.init rect_box = Bbox<Ident>
rect_box.cell(Id, P) :- rects.label($U(), P, Id).
rect_box.grid(Id, P) :- rect_box.cell(Id, _), in(P, _).

.decl marker(id: Ident, p: Position, col: Color)
marker(Id, P, Col) :- rect_box.inside(Id, P), in(P, Col), !params.body(Col).

.init marker_count = Tally<Ident, Position>
marker_count.item(Id, P) :- marker(Id, P, _).

.decl ring_box(id: Ident, b: Position)
ring_box(Id, B) :-
    marker_count.tally(Id, K), uniform_inset(K, W),  // one cell of width per marker
    rect_box.margin(Id, M), relative(W, M, B).   // the rectangle's box, let out by it

.decl ring(id: Ident, p: Position)
ring(Id, P) :- in(P, _), ring_box(Id, B), inside(P, B), !rect_box.inside(Id, P).

.decl out(p: Position, col: Color)
out(P, Col) :- ring(Id, P), marker(Id, _, Col).
out(P, Col) :- in(P, Col), !ring(_, P).
