// 52fd389e
// @draft
// @keywords: objects markers count border
// input: rectangles of params.body sit on the grid, each holding marker
//  cells of one other color
// output: A band of that marker color surrounds its rectangle, as many
//  cells thick as the rectangle holds markers.

.decl out(p: Position, col: Color)

.comp Params {
    .decl body(col: Color) body(4).
}

.init params = Params

.init rects = Components<Unit>
rects.node($U(), P) :- in(P, Col), params.body(Col).

.init rect_box = Bbox<Ident>
rect_box.cell(Id, P) :- rects.label($U(), P, Id).

// A grid cell the rectangle's box covers.
.decl within(id: Ident, p: Position)
within(Id, P) :- in(P, _), rect_box.box(Id, B), inside(P, B).

.decl marker(id: Ident, p: Position, col: Color)
marker(Id, P, Col) :- within(Id, P), in(P, Col), !params.body(Col).

.init marker_count = Tally<Ident, Position>
marker_count.item(Id, P) :- marker(Id, P, _).

.decl ring_box(id: Ident, b: Box)
ring_box(Id, B) :-
    marker_count.tally(Id, K), uniform_outset(K, B_frame),  // the frame let out, one cell per marker
    rect_box.box(Id, B_rect), compose(B_frame, B_rect, B).  // the rectangle's box seated in it

.decl ring(id: Ident, p: Position)
ring(Id, P) :- in(P, _), ring_box(Id, B), inside(P, B), !within(Id, P).

out(P, Col) :- ring(Id, P), marker(Id, _, Col).
out(P, Col) :- in(P, Col), !ring(_, P).
