// 5521c0d9
// @draft
// @keywords: objects move
// input: Blocks — the connected components of the non-bg cells — sit on a
//  params.bg grid.
// output: Each block translates toward params.move_dir by its own extent
//  along that direction's axis, so it comes to sit directly beyond where it
//  stood. A cell carried off the frame is lost.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl move_dir(d: Dir) move_dir(DIR_T).
}

.init params = Params

.init objs = Components<Unit>
objs.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- objs.label($U(), P, Id).

// Each block cell carried the block's own length along the move.
.decl moved(p: Position, col: Color)
moved(P_out, Col) :-
    in(P, Col), objs.label($U(), P, Id),                 // a block cell
    params.move_dir(D), axis_of(D, A),
    bbox.box(Id, B), box_extent(B, P, A, N),             // its block's length along the move
    jump(P, D, N, P_out).

out(P, Col) :-
    in(P, _),
    ( moved(P, Col)                   // a block cell lands here
    ; !moved(P, _), params.bg(Col)    // nothing lands here
    ).

.comp Determine {
    .type EP = [e: Example, p: Position]

    // The color that covers most of the grid.
    .init common = Mode<Unit, Color, EP>
    common.item($U(), Col, [E, P]) :- ex_in(E, P, Col).

    .decl bg(c: Color)
    bg(Col) :- common.mode($U(), Col).
}
