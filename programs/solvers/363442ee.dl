// 363442ee
// draft
// keywords: markers decompose stamp
// input: A params.divider line cuts the grid into the key panel, on
//  params.key_side, and the canvas beyond it. The panel's non-bg cells are
//  the key.
// output: Every params.mark cell on the canvas prints a copy of the key,
//  which covers the mark; the rest of the input stands.
// review principle: Stored or derived — a peer that stores the tile extent
//  instead of reading it from the key box is a second parameterization, and
//  its return of the input at a key of another extent is a valid divergence,
//  so re-judge it as a third case beside Center and Tile.

// where a copy of the key lands over a mark
.type Choice =
    // the key's center cell covers the mark
    Center {}
    // the canvas divides into key-sized tiles, and the key fills the tile the
    // mark sits in
  | Tile {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(1).
    .decl divider(col: Color) divider(5).
    .decl key_side(d: Dir) key_side(DIR_L).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Center()). impl_choice($Tile()).

// The panels the divider cuts.
.init panels = DividerTiles<Unit>
panels.cell($U(), P) :- in(P, _).
panels.divider($U(), A, L) :-
    in(P, Col), params.divider(Col),                       // divider cell
    params.key_side(D), axis_of(D, A), split(P, A, L, _).  // its line on that axis

.decl key_ink(p: Position, col: Color)
key_ink(P, Col) :-
    params.key_side(D), panels.part_idx($U(), P, D, 0),  // in the key panel
    in(P, Col), !params.bg(Col).                         // its ink

// The canvas is the panel across the divider.
.decl canvas(p: Position)
canvas(P) :- params.key_side(D), opposite(D, S), panels.part_idx($U(), P, S, 0).

.init key = Bbox<Unit>
key.cell($U(), P) :- key_ink(P, _).

// The key's cells in the key's own frame.
.decl key_cell(p_intile: Position, col: Color)
key_cell(P_intile, Col) :- key.box($U(), B), key_ink(P, Col), crop(P, B, P_intile).

.decl mark(p: Position)
mark(P) :- canvas(P), in(P, Col), params.mark(Col).

.decl paint(p: Position, col: Color, ch: Choice)

// --- $Center ---

paint(P_grid, Col, $Center()) :-
    mark(M), key_cell(Ctr, _), centered(Ctr),  // the mark, and the key's center
    key_cell(P_intile, Col),                   // a key cell
    relative(Ctr, P_intile, V),                // its offset from that center
    compose(M, V, P_grid).                     // laid off from the mark

// --- $Tile ---

.init canvas_box = Bbox<Unit>
canvas_box.cell($U(), P) :- canvas(P).

// A canvas cell in the canvas's own frame.
.decl canvas_cell(p_grid: Position, p_canvas: Position)
canvas_cell(P_grid, P_canvas) :-
    canvas_box.box($U(), B), canvas(P_grid), crop(P_grid, B, P_canvas).

// The canvas cut into tiles the size of the key's box.
.init tiles = Tile2D<Unit>
tiles.cell(P_canvas) :- canvas_cell(_, P_canvas).
tiles.dim($U(), A, N) :- key.box($U(), B), key.cell($U(), P), box_extent(B, P, A, N).
tiles.gap(0).

.decl tile_of(p_grid: Position, p_tile: Position, p_intile: Position)
tile_of(P_grid, P_tile, P_intile) :-
    canvas_cell(P_grid, P_canvas), tiles.tile($U(), P_canvas, P_tile, P_intile).

paint(P_grid, Col, $Tile()) :-
    mark(M), tile_of(M, P_tile, _),        // the mark's tile
    key_cell(P_intile, Col),               // a key cell
    tile_of(P_grid, P_tile, P_intile).     // at its place in that tile

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !paint(P, _, Ch).
