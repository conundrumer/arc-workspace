// d47aa2ff
// @keywords: decompose select
// output: Side-by-side panels split by a separator. Output is one panel
//  frame. Ink that every panel carries is kept, in the color the panels
//  agree on. Ink that one panel alone carries becomes that panel's mark
//  color. A cell the panels ink in different colors falls to bg.

// how the split is found, data-equivalent on this task
.type Choice =
    // by tile count
    Count {}
    // by tile size
  | Size {}

// A cell of the output frame under one case.
.type CellK = [p: Position, ch: Choice]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    .decl panel_axis(a: Axis) panel_axis(AXIS_H).
    .decl panel_gap(g: number) panel_gap(1).

    // Mark color for ink present only in the panel at p_panel.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill([0, 0, 0, 1], 2).
    only_fill([0, 0, 1, 0], 1).

    // --- Count ---
    .decl panel_count(n: number) panel_count(2).

    // --- Size ---
    .decl panel_size(k: number) panel_size(10).
}

.init params = Params

.comp Parse<Key> {
    .decl grid(k: Key, p: Position, col: Color)

    // Grid cells decomposed into panel and in-panel position.
    .decl cell(k: Key, p_panel: Position, p: Position, col: Color, ch: Choice)
    cell(K, P_panel, P_inpanel, Col, $Count()) :-
        grid(K, P_grid, Col),
        params.panel_axis(A), params.panel_count(N), params.panel_gap(G),      // layout params
        divide_slab(P_grid, A, N, G, P_panel, P_inpanel).
    cell(K, P_panel, P_inpanel, Col, $Size()) :-
        grid(K, P_grid, Col),
        params.panel_axis(A), params.panel_size(W), params.panel_gap(G),       // layout params
        divide_by_size_slab(P_grid, A, W, G, P_panel, P_inpanel).

    .decl ink(k: Key, p_panel: Position, p: Position, col: Color, ch: Choice)
    ink(K, P_panel, P, Col, Ch) :- cell(K, P_panel, P, Col, Ch), !params.bg(Col).

    // Some panel leaves the cell blank.
    .decl missing(k: Key, p: Position, ch: Choice)
    missing(K, P, Ch) :- cell(K, _, P, Col, Ch), params.bg(Col).

    // Every panel inks the cell.
    .decl full(k: Key, p: Position, ch: Choice)
    full(K, P, Ch) :- cell(K, _, P, _, Ch), !missing(K, P, Ch).
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

// The ink colors the panels put on a cell.
.init agree = Unanimous<CellK, Color>
agree.item([P, Ch], Col) :- parse.ink($U(), _, P, Col, Ch).

// One-sided ink is marked with its panel's color.
out(P, Col, Ch) :-
    parse.ink($U(), P_panel, P, _, Ch), parse.missing($U(), P, Ch),   // ink, and a panel blank
    params.only_fill(P_panel, Col).

out(P, Col, Ch) :-
    parse.cell($U(), _, P, _, Ch), !parse.ink($U(), _, P, _, Ch),   // ink in no panel
    params.bg(Col).

out(P, Col, Ch) :-
    parse.full($U(), P, Ch),
    ( agree.value([P, Ch], Col)               // the panels agree
    ; agree.clash([P, Ch]), params.bg(Col)    // they disagree
    ).

.comp Determine {
    .init parse = Parse<Example>
    parse.grid(E, P, Col) :- ex_in(E, P, Col).

    // One-sided ink reads its mark color off the output.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill(Pp, Col) :-
        parse.ink(E, Pp, P, _, Ch), parse.missing(E, P, Ch),
        ex_out(E, P, Col).
}
