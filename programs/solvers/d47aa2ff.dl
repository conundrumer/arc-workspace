// d47aa2ff
// concept: decompose select fold
// Layout: 1×2 horizontally-side-by-side 10×10 panels with 1-col separator.
// Output is one panel frame: ink present in both panels is kept; ink present
// in one panel only becomes the mark color of its panel.
//
// Both-ink cells agree in color throughout the data, leaving the
// disagreeing both-ink cell underdetermined; two models, tagged on out's
// Choice:
//
//   $Match() — kept ink is the color the panels agree on; a disagreeing
//              cell matches neither way and falls to bg.
//   $Base()  — the base panel passes through wherever the other panel has
//              ink; a disagreeing cell keeps the base color.

#include "../lib.dl"

.type Choice = Match {} | Base {}

.comp Consts {
    .decl bg(c: Color) bg(0).

    .decl panel_axis(a: Axis) panel_axis(AXIS_H).
    .decl panel_count(n: number) panel_count(2).
    .decl panel_gap(g: number) panel_gap(1).

    // Mark color for ink present only in the panel at p_panel.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill([0, 0, 0, 1], 2).
    only_fill([0, 0, 1, 0], 1).

    // --- $Base ---
    .decl base_panel(p_panel: Position)
    base_panel([0, 0, 0, 1]). base_panel([0, 0, 1, 0]).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Match()).
impl_choice($Base()).

// --- parse ---

.comp Parse<Key> {
    .decl grid(k: Key, p: Position, col: Color)

    // Grid cells decomposed into panel and in-panel position.
    .decl cell(k: Key, p_panel: Position, p: Position, col: Color)
    cell(K, P_panel, P_inpanel, Col) :-
        grid(K, P_grid, Col),
        c.panel_axis(A), c.panel_count(N), c.panel_gap(G),      // layout params
        divide_slab(P_grid, A, N, G, P_panel, P_inpanel).       // split into panels

    .decl ink(k: Key, p_panel: Position, p: Position, col: Color)
    ink(K, P_panel, P, Col) :- cell(K, P_panel, P, Col), !c.bg(Col).
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

.decl panel(p_panel: Position)
panel(P_panel) :- parse.cell($U(), P_panel, _, _).

.decl out(p: Position, col: Color, ch: Choice)

// --- shared: one-sided ink is marked with its panel's color; blank is bg ---

out(P, Col, Ch) :-
    impl_choice(Ch),
    parse.ink($U(), P_panel, P, _),                         // ink in one panel
    panel(P_panel2), P_panel2 != P_panel,                   // the other panel
    !parse.ink($U(), P_panel2, P, _),                       // blank there
    c.only_fill(P_panel, Col).

out(P, Col, Ch) :-
    impl_choice(Ch),
    parse.cell($U(), _, P, _), !parse.ink($U(), _, P, _),   // ink in neither panel
    c.bg(Col).

// --- $Match ---

out(P, Col, $Match()) :-
    parse.ink($U(), P_panel, P, Col),                       // panels agree
    parse.ink($U(), P_panel2, P, Col),
    P_panel != P_panel2.

out(P, Col, $Match()) :-
    parse.ink($U(), _, P, C1), parse.ink($U(), _, P, C2),   // both-ink, no agreement
    C1 != C2, c.bg(Col).

// --- $Base ---

out(P, Col, $Base()) :-
    c.base_panel(P_base), parse.ink($U(), P_base, P, Col),  // base panel ink
    parse.ink($U(), P_panel2, P, _), P_panel2 != P_base.    // backed by the other panel

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.grid(E, P, Col) :- ex_in(E, P, Col).

    // One-sided ink reads its mark color off the output.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill(Pp, Col) :-
        parse.ink(E, Pp, P, _),
        parse.cell(E, Pp2, P, _), Pp2 != Pp, !parse.ink(E, Pp2, P, _),
        ex_out(E, P, Col).

    // A base panel: no both-ink cell's output contradicts its ink.
    .decl broken(p_panel: Position)
    broken(Pb) :-
        parse.ink(E, Pb, P, Col), parse.ink(E, Pp2, P, _), Pp2 != Pb,
        ex_out(E, P, Col2), Col2 != Col.

    .decl base_panel(p_panel: Position)
    base_panel(Pb) :- parse.cell(E, Pb, _, _), ex_out(E, _, _), !broken(Pb).
}
