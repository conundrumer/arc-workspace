// d47aa2ff
// concept: pair-fold select or
// Layout: 1×2 horizontally-side-by-side 10×10 panels with 1-col separator.
// Output is one panel frame: ink present in both panels is kept; ink present
// in one panel only becomes the mark color of its panel.
//
// Both-ink cells agree in color throughout the data, leaving the
// disagreeing both-ink cell underdetermined; two models, tagged on out's
// Choice:
//
//   $Match() — kept ink is the color the panels agree on; a disagreeing
//              cell matches neither way and falls to bg.
//   $Base()  — the base panel passes through wherever the other panel has
//              ink; a disagreeing cell keeps the base color.

#include "../lib.dl"

.type Choice = Match {} | Base {}

.comp Consts {
    .decl bg(c: Color)  bg(0).

    .decl panel_axis(a: Axis)     panel_axis(AXIS_H).
    .decl panel_count(n: number)  panel_count(2).
    .decl panel_gap(g: number)    panel_gap(1).

    // Mark color for ink present only in the panel at p_panel.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill([0, 0, 0, 1], 2).
    only_fill([0, 0, 1, 0], 1).

    // --- $Base ---
    .decl base_panel(p_panel: Position)  base_panel([0, 0, 0, 1]).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl choice(ch: Choice)
choice($Match()).
choice($Base()).

// Input cells decomposed into panel and in-panel position.
.decl cell(p_panel: Position, p: Position, col: Color)
cell(P_panel, P_inpanel, Col) :-
    in(P_grid, Col),                                        // input cell
    c.panel_axis(A), c.panel_count(N), c.panel_gap(G),      // layout params
    divide_slab(P_grid, A, N, G, P_panel, P_inpanel).       // split into panels

.decl panel(p_panel: Position)
panel(P_panel) :- cell(P_panel, _, _).

.decl ink(p_panel: Position, p: Position, col: Color)
ink(P_panel, P, Col) :- cell(P_panel, P, Col), !c.bg(Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- shared: one-sided ink is marked with its panel's color; blank is bg ---

out(P, Col, Ch) :-
    choice(Ch),
    ink(P_panel, P, _),                                     // ink in one panel
    panel(P_panel2), P_panel2 != P_panel,                   // the other panel
    !ink(P_panel2, P, _),                                   // blank there
    c.only_fill(P_panel, Col).

out(P, Col, Ch) :-
    choice(Ch),
    cell(_, P, _), !ink(_, P, _),                           // ink in neither panel
    c.bg(Col).

// --- $Match ---

out(P, Col, $Match()) :-
    ink(P_panel, P, Col), ink(P_panel2, P, Col),            // panels agree
    P_panel != P_panel2.

out(P, Col, $Match()) :-
    ink(_, P, C1), ink(_, P, C2), C1 != C2,                 // both-ink, no agreement
    c.bg(Col).

// --- $Base ---

out(P, Col, $Base()) :-
    c.base_panel(P_base), ink(P_base, P, Col),              // base panel ink
    ink(P_panel2, P, _), P_panel2 != P_base.                // backed by the other panel

.output out(IO=stdout)
