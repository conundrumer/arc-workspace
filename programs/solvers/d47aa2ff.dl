// d47aa2ff
// concept: decompose select fold
// Side-by-side panels, split by a separator. Output is one panel frame: ink
// every panel carries is kept, in the color the panels agree on; ink one
// panel alone carries becomes that panel's mark color. A cell the panels
// ink in different colors falls to bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).

    .decl panel_axis(a: Axis) panel_axis(AXIS_H).
    .decl panel_count(n: number) panel_count(2).
    .decl panel_gap(g: number) panel_gap(1).

    // Mark color for ink present only in the panel at p_panel.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill([0, 0, 0, 1], 2).
    only_fill([0, 0, 1, 0], 1).
}

.init c = Consts

// --- parse ---

.comp Parse<Key> {
    .decl grid(k: Key, p: Position, col: Color)

    // Grid cells decomposed into panel and in-panel position.
    .decl cell(k: Key, p_panel: Position, p: Position, col: Color)
    cell(K, P_panel, P_inpanel, Col) :-
        grid(K, P_grid, Col),
        c.panel_axis(A), c.panel_count(N), c.panel_gap(G),      // layout params
        divide_slab(P_grid, A, N, G, P_panel, P_inpanel).       // split into panels

    .decl ink(k: Key, p_panel: Position, p: Position, col: Color)
    ink(K, P_panel, P, Col) :- cell(K, P_panel, P, Col), !c.bg(Col).

    // Some panel leaves the cell blank.
    .decl missing(k: Key, p: Position)
    missing(K, P) :- cell(K, _, P, Col), c.bg(Col).

    // Every panel inks the cell.
    .decl full(k: Key, p: Position)
    full(K, P) :- cell(K, _, P, _), !missing(K, P).
}

.init parse = Parse<Unit>
parse.grid($U(), P, Col) :- in(P, Col).

// The ink colors the panels put on a cell.
.init agree = Unanimous<Position, Color>
agree.item(P, Col) :- parse.ink($U(), _, P, Col).

.decl out(p: Position, col: Color)

// One-sided ink is marked with its panel's color.
out(P, Col) :-
    parse.ink($U(), P_panel, P, _), parse.missing($U(), P),   // ink, and a panel blank
    c.only_fill(P_panel, Col).

out(P, Col) :-
    parse.cell($U(), _, P, _), !parse.ink($U(), _, P, _),   // ink in no panel
    c.bg(Col).

out(P, Col) :-
    parse.full($U(), P),
    ( agree.value(P, Col)          // the panels agree
    ; agree.clash(P), c.bg(Col)    // they disagree
    ).

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.grid(E, P, Col) :- ex_in(E, P, Col).

    // One-sided ink reads its mark color off the output.
    .decl only_fill(p_panel: Position, col: Color)
    only_fill(Pp, Col) :-
        parse.ink(E, Pp, P, _), parse.missing(E, P),
        ex_out(E, P, Col).
}
