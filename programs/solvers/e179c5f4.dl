// e179c5f4
// @keywords: markers walk
// output: A lone mark in a corner launches a ball diagonally away from the
//  corner; it reflects off the walls beside the travel axis and exits at the
//  far edge. Path cells take the ball color, all others params.fill.
//  Coincide here: every grid is longest along V, and the mark color equals
//  params.ink.

// travel axis — the walls beside it reflect
.type Travel =
    // params.axis names it
    Axis {}
    // the grid's long axis
  | Long {}

// ball color
.type Paint =
    // the mark's own color
    Mark {}
    // an independent params.ink
  | Ink {}

.type Choice = [t: Travel, f: Paint]

// A state of the ball: its cell and the side component of its heading.
.type Ball = [p: Position, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(8).    // off-path output color

    // --- $Axis ---
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Ink ---
    .decl ink(c: Color) ink(1).
}

.init params = Params

// The mark — the ball's start.
.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

// --- Travel cases: the travel axis ---

.decl travel_choice(t: Travel)
travel_choice($Axis()). travel_choice($Long()).

.decl travel_axis(t: Travel, a: Axis)
travel_axis($Axis(), A) :- params.axis(A).
travel_axis($Long(), A) :- mark(P, _), axis_dims(P, A, N1, N2), N1 > N2.

// --- The ball's walk ---

// Launch: away from the two edges the mark's corner touches.
.decl launch(t: Travel, p: Position, d_travel: Dir, d_bounce: Dir)
launch(T, P, Dt, Db) :-
    mark(P, _),
    travel_axis(T, A), axis_of(Et, A), dist(P, Et, 0), opposite(Et, Dt),    // travel: away along the travel axis
    perp(A, A2), axis_of(Eb, A2), dist(P, Eb, 0), opposite(Eb, Db).         // bounce: away from the touched side wall

// One travel step per cell, side component toward d; the wall reflects it.
.init walk = Propagation<Travel, Ball>
walk.source(T, [P, D]) :- launch(T, P, _, D).
walk.edge(T, [P, D], [P2, D_out]) :-
    launch(T, _, Dt, _), in(P, _), perp_dir(Dt, D),
    ( !dist(P, D, 0), D_out = D                       // clear of the wall toward d
    ; dist(P, D, 0), opposite(D, D_out)               // at the wall — reflect
    ),
    neighbor(P, Dt, M),                               // one step along the travel
    neighbor(M, D_out, P2), in(P2, _).                // and one to the side

// The ball's path.
.decl path(t: Travel, p: Position)
path(T, P) :- walk.reached(T, [P, _]).

// --- Paint cases: the ball color ---

.decl paint_choice(f: Paint)
paint_choice($Mark()). paint_choice($Ink()).

.decl paint(col: Color, f: Paint)
paint(Col, $Mark()) :- mark(_, Col).
paint(Col, $Ink())  :- params.ink(Col).

// --- Output ---

out(P, Col, [T, F]) :- path(T, P), paint(Col, F).
out(P, Col, [T, F]) :-
    in(P, _), travel_choice(T), !path(T, P),       // off the path
    paint_choice(F), params.fill(Col).
