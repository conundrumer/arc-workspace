// 0a938d79
// @keywords: markers lines walk
// output: Two marks sit on edges of one axis, and each casts a line across
//  the grid. The lines then repeat by the step from one mark to the other,
//  colors alternating, so each mark's line recurs every two steps; the
//  strip before the leading line stays bg.

// which mark leads
.type Choice =
    // the mark nearer the params.origin side
    Corner {}
    // the mark whose side holds the narrower empty strip, so the pattern
    // fills the wider one
  | Margin {}

// The cases coincide here — the marks huddle at the params.origin side in
// every pair — and diverge when the marks huddle at the opposite side.

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- $Corner ---
    .decl origin(d: DiagDir) origin(DIAG_TL).   // the corner the walk starts from
}

.init params = Params

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.decl on_axis_edge(p: Position, a: Axis)
on_axis_edge(P, A) :- mark(P, _), dir_elem(D), axis_of(D, A), dist(P, D, 0).

.decl off_axis_edge(a: Axis)
off_axis_edge(A) :- axis_elem(A), mark(P, _), !on_axis_edge(P, A).

// The lines repeat along this axis. Every mark sits on an edge of the
// perpendicular axis, and its line spans that one.
.decl step_axis(a: Axis)
step_axis(A2) :- axis_elem(A), !off_axis_edge(A), perp(A, A2).

// Each cell with the line it lies on — the line's position on the step axis.
.decl cell_line(p: Position, p_line: Position)
cell_line(P, P_line) :- in(P, _), step_axis(A2), split(P, A2, P_line, _).

// Line q lies k lines ahead of line p toward d.
.decl ahead(p: Position, d: Dir, q: Position, k: number)
ahead(P, D, Q, K) :-
    cell_line(_, P), cell_line(_, Q), step_axis(A2), axis_of(D, A2),
    relative(P, Q, V), opposite(D, O), dist(V, O, K), K >= 0.

.decl mark_line(p: Position, col: Color)
mark_line(P_line, Col) :- mark(P, Col), cell_line(P, P_line).

// The line the walk starts from.
.decl lead(p: Position, ch: Choice)

// --- $Corner ---
lead(P_line, $Corner()) :-
    mark_line(P_line, _), mark_line(Q, _),                    // the two mark lines
    params.origin(Dg), step_axis(A2), dir_of(Dg, A2, D),      // the origin side
    nearer(D, P_line, Q).

// --- $Margin ---
lead(P_line, $Margin()) :-
    mark_line(P_line, _), mark_line(Q, _),               // the two mark lines
    step_axis(A2), dir_elem(D), axis_of(D, A2),          // a side
    dist(P_line, D, K), dist_pair(Q, D, K2, K2_opp),     // distances from it
    K < K2, K < K2_opp.                                  // the empty strip at that side is the narrower

// The walk's heading, from the lead line toward the other, and its step: the
// gap between the two mark lines.
.decl step(ch: Choice, d: Dir, k: number)
step(Ch, D, K) :-
    lead(P, Ch), mark_line(Q, _), Q != P,                 // the lead line and the other
    ahead(P, D, Q, K), K > 0.                             // heading toward the other, the gap

.decl impl_choice(ch: Choice)
impl_choice($Corner()). impl_choice($Margin()).

// Each mark line repeats every two steps ahead of itself, so the colors
// alternate.
.decl line(p: Position, col: Color, ch: Choice)
line(P_line, Col, Ch) :-
    mark_line(M, Col), step(Ch, D, K), ahead(M, D, P_line, T),    // a line ahead of a mark line
    stride(T, K, K, _, 0).                                        // a whole number of two-step periods

out(P, Col, Ch) :- cell_line(P, P_line), line(P_line, Col, Ch).
out(P, Col, Ch) :-
    impl_choice(Ch), cell_line(P, P_line), !line(P_line, _, Ch), params.bg(Col).
