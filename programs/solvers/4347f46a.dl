// 4347f46a
// @keywords: objects border
// output: Solid one-color rectangles on params.bg; each keeps its outline and
//  its interior repaints to params.bg.

// which cells are the interior
.type Choice =
    // cells strictly inside a component's bounding box
    Box {}
    // ink cells whose four neighbors are all ink; off-grid is non-ink
  | Erode {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl inner_cell(p: Position, ch: Choice)

// --- $Box ---

.init comps = Components<Unit>
comps.node($U(), P) :- ink(P).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- comps.label($U(), P, Id).

inner_cell(P, $Box()) :- bbox.box(_, B), in(P, _), interior(P, B).

// --- $Erode ---

.init exposed = Rim<Unit>
exposed.cell($U(), P) :- ink(P).

inner_cell(P, $Erode()) :- ink(P), !exposed.rim($U(), P).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Box()). impl_choice($Erode()).

out(P, Col, Ch) :- inner_cell(P, Ch), params.bg(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !inner_cell(P, Ch).
