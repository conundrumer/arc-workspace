// a9f96cdd
// concept: markers lookup stamp
// One marker cell on an empty grid; its four diagonal neighbors take
// per-corner colors, clipped at the grid edge; the rest of the output is
// bg, marker included. Cases (data-equivalent on this task):
//
//   $Arms  — per-corner: the neighbor toward diag paints c.arm(diag).
//   $Stamp — a stored template, seated on the marker by its seat cell.

#include "../lib.dl"

.type Choice = Arms {} | Stamp {}

.comp Consts {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(2).

    // --- Arms ---
    .decl arm(d: DiagDir, col: Color)
    arm(DIAG_TL, 3). arm(DIAG_TR, 6). arm(DIAG_BL, 8). arm(DIAG_BR, 7).

    // --- Stamp ---
    .decl template(p: Position, col: Color)
    GRID_SPARSE_3x3(template,
        3, 0, 6,
        0, 0, 0,
        8, 0, 7)
    .decl seat(p: Position) seat([1, 1, 1, 1]).
}

.init c = Consts

.decl marker_at(p: Position)
marker_at(P) :- in(P, Col), c.marker(Col).

.decl halo(p: Position, col: Color, ch: Choice)

// --- Arms ---
halo(P, Col, $Arms()) :-
    marker_at(Q), c.arm(Diag, Col),                        // marker, arm color
    step_delta(Diag, S), compose(Q, S, P), in(P, _).       // neighbor toward diag, on-grid

// --- Stamp ---
// Template ink viewed from the seat cell.
.init tview = Reframe<Color>
tview.cell(Col, Pt)  :- c.template(Pt, Col).
tview.outer(Col, Ps) :- tview.cell(Col, _), c.seat(Ps).

halo(P, Col, $Stamp()) :-
    marker_at(Q), tview.inner(Col, Off),        // template offsets by color
    compose(Q, Off, P), in(P, _).               // seat on the marker, on-grid

.decl impl_choice(ch: Choice)
impl_choice($Arms()). impl_choice($Stamp()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- halo(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !halo(P, _, Ch), c.bg(Col).

// --- fit ---

.type Cell = [e: Example, p: Position]

.comp Fit {
    .decl marker_at(e: Example, p: Position)
    marker_at(E, P) :- ex_in(E, P, Col), c.marker(Col).

    // What the stamp writes: every output ink cell.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- ex_out(E, P, Col), !c.bg(Col).

    // Painted cells as offsets from their example's marker.
    .init off = Reframe<Cell>
    off.cell([E, P], P)  :- painted(E, P, _).
    off.outer([E, P], M) :- painted(E, P, _), marker_at(E, M).

    .decl offset(off: Shift, col: Color)
    offset(Off, Col) :- painted(E, P, Col), off.inner([E, P], Off).

    .decl arm(d: DiagDir, col: Color)
    arm(Diag, Col) :- offset(Off, Col), diag_dir_elem(Diag), step_delta(Diag, Off).

    .decl template(p: Position, col: Color)
    template(Pt, Col) :- offset(Off, Col), c.seat(Ps), compose(Ps, Off, Pt).
}
