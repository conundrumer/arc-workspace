// a9f96cdd
// concept: markers lookup stamp
// One marker cell on an empty grid; its four diagonal neighbors take
// per-corner colors, clipped at the grid edge; the rest of the output is
// bg, marker included. Cases (data-equivalent on this task):
//
//   $Arms  — per-corner: the neighbor toward diag paints params.arm(diag).
//   $Stamp — a stored template of offsets, seated on the marker.

#include "../lib.dl"

.type Choice = Arms {} | Stamp {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(2).

    // --- Arms ---
    .decl arm(d: DiagDir, col: Color)
    arm(DIAG_TL, 3). arm(DIAG_TR, 6). arm(DIAG_BL, 8). arm(DIAG_BR, 7).

    // --- Stamp ---
    .decl template(off: Shift, col: Color)
    GRID_STAMP_SPARSE_3x3(template,
        3,  _, 6,
        _, @_, _,
        8,  _, 7)
}

.init params = Params

.decl marker_at(p: Position)
marker_at(P) :- in(P, Col), params.marker(Col).

.decl halo(p: Position, col: Color, ch: Choice)

// --- Arms ---
halo(P, Col, $Arms()) :-
    marker_at(Q), params.arm(Diag, Col),      // marker, arm color
    neighbor(Q, Diag, P), in(P, _).           // on-grid

// --- Stamp ---
halo(P, Col, $Stamp()) :-
    marker_at(Q), params.template(Off, Col),   // a marker, a template offset
    compose(Q, Off, P), in(P, _).              // seated on the marker, on-grid

.decl impl_choice(ch: Choice)
impl_choice($Arms()). impl_choice($Stamp()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- halo(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !halo(P, _, Ch), params.bg(Col).

.comp Determine {
    // What the stamp writes — every output ink cell — as an offset from its
    // example's marker.
    .decl template(off: Shift, col: Color)
    template(Off, Col) :-
        ex_out(E, P, Col), !params.bg(Col),
        ex_in(E, M, Cm), params.marker(Cm), relative(M, P, Off).

    .decl arm(d: DiagDir, col: Color)
    arm(Diag, Col) :- template(Off, Col), diag_dir_elem(Diag), step_offset(Diag, Off).
}
