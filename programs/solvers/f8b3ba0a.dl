// f8b3ba0a
// concept: decompose objects count rank
// Color blocks on bg, one color dominant. Output is a 1D layout along
// axis_of(c.rank_dir): the minority colors, anchored at c.rank_dir, in
// descending count order; the dominant (max-count) color is dropped.
// Extent = number of minority colors. Models of what is counted, tagged on
// out's Choice:
//
//   $Cells   — cells of each color.
//   $Blocks  — connected components of each color.
//   $Lattice — tiles of the separator lattice (inset past the border, then
//              divide_by_size_2d) of each color.
//
// $Cells/$Blocks coincide while every block has one size; $Blocks/$Lattice
// coincide while every block is a lattice tile.
//
// Flagged: minority colors sharing a count share a rank — colliding `out`
// facts at one Position; a max-count tie drops every tied color.

#include "../lib.dl"

.type Choice = Cells {} | Blocks {} | Lattice {}

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_T).

    // --- $Lattice ---
    .decl tile_dim(a: Axis, k: number)
    tile_dim(AXIS_V, 1). tile_dim(AXIS_H, 2).

    .decl tile_gap(g: number) tile_gap(1).
    .decl inset_delta(p: Inset) inset_delta([-1, -1, -1, -1]).
}

.init c = Consts

// --- parse ---

// Ranked colors: the max-count color is dominant and drops out; the rest
// take dense ranks over their counts, fewest first.
.comp Parse<Key> {
    .decl count_of(key: Key, col: Color, n: number)

    .init dominant = ArgExtremes<Key, Color>
    dominant.cand(Ky, Col, N) :- count_of(Ky, Col, N).

    .decl minority_count(key: Key, col: Color, n: number)
    minority_count(Ky, Col, N) :- count_of(Ky, Col, N), !dominant.high(Ky, Col, _).

    .init o = Ordinal<Key>
    o.idx_set(Ky, N) :- minority_count(Ky, _, N).

    .decl minority_rank(key: Key, col: Color, r: number)
    minority_rank(Ky, Col, R) :- minority_count(Ky, Col, N), o.rank(Ky, N, R).
}

// --- $Blocks: component detection ---

.init comps = Components<Unit>
comps.node($U(), P) :- in(P, Col), !c.bg(Col).

.init block_count = Tally<Color, Ident>
block_count.item(Col, Id) :- comps.label($U(), P, Id), in(P, Col).

// --- $Lattice: tile detection ---

// Non-bg cells never sit on the separator border, so the inset stays in frame.
.init lattice = Tile2D<Unit>
lattice.cell(P_int) :- in(P, Col), !c.bg(Col), c.inset_delta(D), compose(P, D, P_int).
lattice.dim($U(), A, K) :- c.tile_dim(A, K).
lattice.gap(G) :- c.tile_gap(G).

.decl tile_color(p_tile: Position, col: Color)
tile_color(P_tile, Col) :-
    in(P, Col),                                          // input cell
    c.inset_delta(Delta), compose(P, Delta, P_int),      // interior frame
    lattice.tile($U(), P_int, P_tile, _).                // its lattice tile

// --- counts per choice ---

.init cell_count = Tally<Color, Position>
cell_count.item(Col, P) :- in(P, Col), !c.bg(Col).

.init tile_count = Tally<Color, Position>
tile_count.item(Col, P_tile) :- tile_color(P_tile, Col).

.init parse = Parse<Choice>
parse.count_of($Cells(), Col, N)   :- cell_count.tally(Col, N).
parse.count_of($Blocks(), Col, N)  :- block_count.tally(Col, N).
parse.count_of($Lattice(), Col, N) :- tile_count.tally(Col, N).

// --- place ---

// Output frame: 1D axis anchored at c.rank_dir, per choice. Placing ascending
// rank from the opposite edge puts the largest count at the rank_dir edge.
.init col = DirFrame<Choice>
col.dir(D_opp) :- c.rank_dir(D), opposite(D, D_opp).
col.dist_set(Ch, R) :- parse.minority_rank(Ch, _, R).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- parse.minority_rank(Ch, Col, Rk), col.pos(Ch, Rk, P).

// --- fit ---

.type Block = [e: Example, id: Ident]

.comp Fit {
    // Non-bg cells of a train input — a test input has no output to read.
    .decl ink(e: Example, p: Position, col: Color)
    ink(E, P, Col) :- ex_in(E, P, Col), !c.bg(Col), ex_out(E, _, _).

    // The frame the non-bg cells span: the grid inside the separator border.
    .init span = Bbox<Example>
    span.cell(E, P) :- ink(E, P, _).

    .decl inset_delta(p: Inset)
    inset_delta(Delta) :- span.margin(_, M), displacement(M, ORIGIN, Delta).

    // Ink cells in the interior frame the lattice divides.
    .decl interior(e: Example, p: Position)
    interior(E, P_int) :- ink(E, P, _), inset_delta(Delta), compose(P, Delta, P_int).

    .init blocks = Components<Example>
    blocks.node(E, P) :- ink(E, P, _).

    .init box = Bbox<Block>
    box.cell([E, Id], P) :- blocks.label(E, P, Id).

    // Each block's cells viewed from its own box, so the block's extents
    // are the tile's.
    .init local = Reframe<Block>
    local.outer([E, Id], M) :- box.margin([E, Id], M).
    local.cell([E, Id], P)  :- blocks.label(E, P, Id).

    .decl tile_dim(a: Axis, k: number)
    tile_dim(A, K) :- local.inner(_, P), axis_elem(A), axis_dim(P, A, K).

    .type ED = [e: Example, d: Dir]

    // Blocks along an axis: the distinct offsets their boxes sit at.
    .init tile_count = Tally<ED, number>
    tile_count.item([E, D], K) :- box.edge_min([E, Id], D, K).

    .decl tile_gap(g: number)
    tile_gap(G) :-
        interior(E, P_int),
        tile_count.tally([E, D], N), axis_of(D, A), tile_dim(A, K),
        divide_gap(P_int, A, N, K, G).

    .type EC = [e: Example, col: Color]

    .init ink_count = Tally<EC, Position>
    ink_count.item([E, Col], P) :- ink(E, P, Col).

    .init parse = Parse<Example>
    parse.count_of(E, Col, N) :- ink_count.tally([E, Col], N).

    // A dir whose opposite edge does not measure out the ranks: some output
    // cell sits at a distance other than its color's rank.
    .decl rank_mismatch(d: Dir)
    rank_mismatch(D) :-
        dir_elem(D), opposite(D, O),
        ex_out(E, P, Col), parse.minority_rank(E, Col, R),
        dist(P, O, K), K != R.

    .decl rank_dir(d: Dir)
    rank_dir(D) :- dir_elem(D), !rank_mismatch(D).
}
