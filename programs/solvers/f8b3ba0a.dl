// f8b3ba0a
// concept: decompose objects count rank
// Color blocks on bg, one color dominant. Output is a 1D layout along
// axis_of(c.rank_dir): the minority colors, anchored at c.rank_dir, in
// descending count order; the dominant (max-count) color is dropped.
// Extent = number of minority colors. Two models of what is counted,
// tagged on out's Choice:
//
//   $Cells   — cells of each color.
//   $Blocks  — connected components of each color.
//   $Lattice — tiles of the separator lattice (inset past the border, then
//              divide_by_size_2d) of each color.
//
// $Cells/$Blocks coincide while every block has one size; $Blocks/$Lattice
// coincide while every block is a lattice tile.
//
// Flagged: minority colors sharing a count share a rank — colliding `out`
// facts at one Position; a max-count tie drops every tied color.

#include "../lib.dl"

// 2D tiling from per-axis tile dims: per-axis divide_by_size, perp-glued —
// the divide peer of Frame2D. Candidate lib comp — see
// docs/wf-solver/proposals.md. `gap` is the instance's parameter.
.comp Tile2D<Key> {
    .decl cell(p: Position)
    .decl dim(key: Key, a: Axis, k: number)
    .decl gap(g: number)

    .decl tile(key: Key, p: Position, p_outer: Position, p_inner: Position)
    tile(Ky, P, P_outer, P_inner) :-
        cell(P), gap(G),
        perp(A1, A2),
        dim(Ky, A1, K1), divide_by_size(P, A1, K1, G, Po1, Pi1),
        dim(Ky, A2, K2), divide_by_size(P, A2, K2, G, Po2, Pi2),
        compose(Po1, Po2, P_outer), compose(Pi1, Pi2, P_inner).
}

.type Choice = Cells {} | Blocks {} | Lattice {}

.comp Consts {
    .decl bg(c: Color)        bg(0).
    .decl rank_dir(d: Dir)    rank_dir(DIR_T).

    // --- $Lattice ---
    .decl tile_dim(a: Axis, k: number)
    tile_dim(AXIS_V, 1). tile_dim(AXIS_H, 2).

    .decl tile_gap(g: number)       tile_gap(1).
    .decl inset_delta(p: Position)  inset_delta([-1, -1, -1, -1]).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// --- $Blocks: component detection ---

.init comps = Components<Unit>
comps.node($U(), P) :- in(P, Col), !c.bg(Col).

.decl block_color(id: CompId, col: Color)
block_color(Id, Col) :- comps.label($U(), P, Id), in(P, Col).

// --- $Lattice: tile detection ---

// Non-bg cells never sit on the separator border, so the inset stays in frame.
.init lattice = Tile2D<Unit>
lattice.cell(P_int) :- in(P, Col), !c.bg(Col), c.inset_delta(D), compose(P, D, P_int).
lattice.dim($U(), A, K) :- c.tile_dim(A, K).
lattice.gap(G) :- c.tile_gap(G).

.decl tile_color(p_tile: Position, col: Color)
tile_color(P_tile, Col) :-
    in(P, Col), !c.bg(Col),                              // block cell
    c.inset_delta(Delta), compose(P, Delta, P_int),      // interior frame
    lattice.tile($U(), P_int, P_tile, _).                // its lattice tile

// --- counts per choice ---

.decl count_of(col: Color, n: number, ch: Choice)
count_of(Col, N, $Cells()) :-
    in(_, Col), !c.bg(Col),
    N = count : { in(_, Col) }.
count_of(Col, N, $Blocks()) :-
    block_color(_, Col),
    N = count : { block_color(Id, Col) }.
count_of(Col, N, $Lattice()) :-
    tile_color(_, Col),
    N = count : { tile_color(P_tile, Col) }.

// --- drop dominant, rank, place ---

.decl dominant(col: Color, ch: Choice)
dominant(Col, Ch) :-
    count_of(Col, N, Ch),
    N = max N2 : { count_of(_, N2, Ch) }.

.decl minority_count(col: Color, n: number, ch: Choice)
minority_count(Col, N, Ch) :- count_of(Col, N, Ch), !dominant(Col, Ch).

// Dense rank over the minority counts, ascending (fewest first), per choice.
.init o = Ordinal<Choice>
o.idx_set(Ch, N) :- minority_count(_, N, Ch).

.decl minority_rank(col: Color, r: number, ch: Choice)
minority_rank(Col, R, Ch) :- minority_count(Col, N, Ch), o.rank(Ch, N, R).

// Output frame: 1D axis anchored at c.rank_dir, per choice. Placing ascending
// rank from the opposite edge puts the largest count at the rank_dir edge.
.init col = DirFrame<Choice>
col.dir(D_opp) :- c.rank_dir(D), opposite(D, D_opp).
col.dist_set(Ch, R) :- minority_rank(_, R, Ch).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- minority_rank(Col, Rk, Ch), col.pos(Ch, Rk, P).

.output out(IO=stdout)
