// f8b3ba0a
// @keywords: decompose objects count rank select
// input: Color blocks on bg, one color dominant.
// output: Output is a 1D layout along axis_of(params.rank_dir): the minority
//  colors, anchored at params.rank_dir, in descending count order; the
//  dominant (max-count) color is dropped. Extent = number of minority colors.
//  Minority colors that share a count share a rank, colliding at one output
//  position; a max-count tie drops every tied color.

// $Cells/$Blocks coincide while every block has one size; $Blocks/$Tiling
// coincide while every block is a tile of the tiling.

// what is counted for each color
.type Choice =
    // cells of each color
    Cells {}
    // connected components of each color
  | Blocks {}
    // tiles of the separator tiling (the frame inside the border, divided by
    // tile size) of each color
  | Tiling {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_T).

    // --- $Tiling ---
    .decl tile_dim(a: Axis, k: number)
    tile_dim(AXIS_V, 1). tile_dim(AXIS_H, 2).

    .decl tile_gap(g: number) tile_gap(1).

    // The separator border around the tiling.
    .decl border_width(k: number) border_width(1).
}

.init params = Params

// --- $Blocks: component detection ---

.init comps = Components<Unit>
comps.node($U(), P) :- in(P, Col), !params.bg(Col).

.init block_count = Tally<Color, Ident>
block_count.item(Col, Id) :- comps.label($U(), P, Id), in(P, Col).

// --- $Tiling: tile detection ---

// A cell seen in the frame the border encloses. Non-bg cells never sit on that
// border, so the frame holds every one of them.
.decl core_cell(p: Position, p_inner: Position)
core_cell(P, P_inner) :-
    in(P, _), params.border_width(K), uniform_inset(K, B), crop(P, B, P_inner).

.init tiling = Tile2D<Unit>
tiling.cell(P_inner) :- in(P, Col), !params.bg(Col), core_cell(P, P_inner).
tiling.dim($U(), A, K) :- params.tile_dim(A, K).
tiling.gap(G) :- params.tile_gap(G).

.decl tile_color(p_tile: Position, col: Color)
tile_color(P_tile, Col) :-
    in(P, Col),                              // input cell
    core_cell(P, P_inner),                   // seen in the interior frame
    tiling.tile($U(), P_inner, P_tile, _).   // its tile

// --- counts per choice ---

.init cell_count = Tally<Color, Position>
cell_count.item(Col, P) :- in(P, Col), !params.bg(Col).

.init tile_count = Tally<Color, Position>
tile_count.item(Col, P_tile) :- tile_color(P_tile, Col).

.decl count_of(ch: Choice, col: Color, n: number)
count_of($Cells(), Col, N)   :- cell_count.tally(Col, N).
count_of($Blocks(), Col, N)  :- block_count.tally(Col, N).
count_of($Tiling(), Col, N) :- tile_count.tally(Col, N).

// --- rank ---

// Ranked colors: the max-count color is dominant and drops out; the rest
// take dense ranks over their counts, fewest first.
.init dominant = ArgExtremes<Choice, Color>
dominant.cand(Ch, Col, N) :- count_of(Ch, Col, N).

.decl minority_count(ch: Choice, col: Color, n: number)
minority_count(Ch, Col, N) :- count_of(Ch, Col, N), !dominant.high(Ch, Col, _).

.init o = Ordinal<Choice>
o.idx_set(Ch, N) :- minority_count(Ch, _, N).

.decl minority_rank(ch: Choice, col: Color, r: number)
minority_rank(Ch, Col, R) :- minority_count(Ch, Col, N), o.rank(Ch, N, R).

// --- place ---

// Output frame: 1D axis anchored at params.rank_dir, per choice. Placing ascending
// rank from the opposite edge puts the largest count at the rank_dir edge.
.init col = DirFrame<Choice>
col.dir(D_opp) :- params.rank_dir(D), opposite(D, D_opp).
col.dist_set(Ch, R) :- minority_rank(Ch, _, R).

out(P, Col, Ch) :- minority_rank(Ch, Col, Rk), col.pos(Ch, Rk, P).

.comp Determine {
    // Non-bg cells of a train input — a test input has no output to read.
    .decl ink(e: Example, p: Position, col: Color)
    ink(E, P, Col) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // The frame the non-bg cells span: the grid inside the separator border,
    // with each ink cell's place in it.
    .init span = Bbox<Example>
    span.cell(E, P) :- ink(E, P, _).

    // The ink spans that frame, so its distance to a grid edge is the
    // border's width there.
    .decl border_width(k: number)
    border_width(K) :- span.box(_, B), dir_elem(D), dist(B, D, K).

    .init blocks = Components<Example>
    blocks.node(E, P) :- ink(E, P, _).

    .type Block = [e: Example, id: Ident]

    .init bbox = Bbox<Block>
    bbox.cell([E, Id], P) :- blocks.label(E, P, Id).

    .decl tile_dim(a: Axis, k: number)
    tile_dim(A, K) :- bbox.cell(Blk, P), bbox.box(Blk, B), box_extent(B, P, A, K).

    .type ED = [e: Example, d: Dir]

    // Blocks along an axis: the distinct offsets their boxes sit at.
    .init tile_count = Tally<ED, number>
    tile_count.item([E, D], K) :- bbox.box([E, Id], B), dir_elem(D), dist(B, D, K).

    .decl tile_gap(g: number)
    tile_gap(G) :-
        span.cell(E, P), span.box(E, B), crop(P, B, P_inner),  // the frame the tiling divides
        tile_count.tally([E, D], N), axis_of(D, A), tile_dim(A, K),
        divide_gap(P_inner, A, N, K, G).
}
