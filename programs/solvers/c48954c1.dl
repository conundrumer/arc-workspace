// c48954c1
// @keywords: tile-arrangement lookup d4
// output: a 3×3 tile arrangement of copies of the input: the center tile is
//  the input; each off-center tile is the input flipped along every axis on
//  which it sits off-center

// how each tile's content is derived
.type Choice =
    // a stored D4 per tile place
    Lookup {}
    // each tile flips the input on each axis it sits off-center on
  | Mirror {}
    // each tile reflects its neighbor across the shared boundary
  | Unfold {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_3x3(tile_d4,
        D4_HT, D4_TB, D4_HT,
        D4_LR, D4_ID, D4_LR,
        D4_HT, D4_TB, D4_HT)

    // --- $Mirror, $Unfold ---
    .decl arr_dim(k: number) arr_dim(3).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(K), helpers.frame_pos([K, K], P).
}

.init params = Params

// --- $Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                            // input cell
    params.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).                   // recompose

// --- $Mirror ---
.decl axis_centered(p_tile: Position, a: Axis)
axis_centered(T, A) :- params.arr_pos(T), axis_of(D, A), dist_pair(T, D, K, K).

// Per-axis within-tile image.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P_img) :-
    in(P, _), params.arr_pos(T), axis_elem(A),
    ( axis_centered(T, A), P_img = P                          // centered: passes through
    ; !axis_centered(T, A), flip_of(A, F), apply(F, P, P_img) // off-center: flips
    ).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- $Unfold ---
// A tile's count of tile steps from the center tile along each axis.
.decl tile_off(p_tile: Position, a: Axis, k: number)
tile_off(T, A, K) :-
    params.arr_pos(T), params.arr_pos(C), centered(C), relative(C, T, V),   // the tile, from the center
    axis_of(D, A), dist(V, D, K), K >= 0.                                   // its steps along the axis

// The input reflected across a shared boundary on each axis, once per tile
// step away from the center tile along that axis.
.init reflect = CycleWalk<Axis, Position>
reflect.succ(A, P, P_img) :- in(P, _), axis_elem(A), flip_of(A, F), apply(F, P, P_img).
reflect.step(A, K) :- tile_off(_, A, K).

out(P_grid, Col, $Unfold()) :-
    in(P_in, Col), perp(A1, A2),                                          // input cell
    tile_off(T, A1, K1), tile_off(T, A2, K2),                             // a tile's steps on each axis
    reflect.walk(A1, P_in, K1, P1), reflect.walk(A2, P1, K2, P_intile),   // reflected K1, then K2 times
    concat_2d(T, P_intile, 0, P_grid).                                    // recompose
