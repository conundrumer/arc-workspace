// c48954c1
// concept: tile-arrangement lookup d4 unfold
// Layout: 3×3 tile arrangement of input copies. The center tile is the
// input; each off-center tile is the input flipped along every axis on
// which it sits off-center.
//
// Cases (data-equivalent on this task):
//   $Lookup() — per-tile D4 table
//   $Mirror() — off-center tiles mirror the center tile away from it
//   $Unfold() — reflection tiling: each tile reflects its neighbor across
//               the shared boundary

#include "../lib.dl"

.type Choice = Lookup {} | Mirror {} | Unfold {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- shared ---
    .decl arr_dim(k: number) arr_dim(3).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(K), helpers.frame_pos([K, K], P).

    // --- Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_3x3(tile_d4,
        D4_HT, D4_TB, D4_HT,
        D4_LR, D4_ID, D4_LR,
        D4_HT, D4_TB, D4_HT)
}

.init c = Consts

// Tile centered / off-center along an axis.
.decl axis_centered(p_tile: Position, a: Axis)
axis_centered(T, A) :- c.arr_pos(T), axis_of(D, A), dist_pair(T, D, K, K).

.decl axis_off(p_tile: Position, a: Axis)
axis_off(T, A) :- c.arr_pos(T), axis_of(D, A), dist_pair(T, D, K1, K2), K1 != K2.

.decl out(p: Position, col: Color, c: Choice)

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                       // input cell
    c.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).              // recompose

// --- Mirror ---
// Per-axis within-tile image: centered passes through, off-center flips.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P)     :- in(P, _), axis_centered(T, A).
mirror(A, T, P, P_img) :- in(P, _), axis_off(T, A), flip_of(A, F), apply(F, P, P_img).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- Unfold ---
.decl off_center(p: Position)
off_center(T) :- axis_off(T, _).

.decl tile_center(p: Position)
tile_center(T) :- c.arr_pos(T), !off_center(T).

// Tile contents: the input seeds the center; each neighbor reflects across
// the shared boundary.
.decl unfold_val(p_tile: Position, p_intile: Position, col: Color)
unfold_val(T, P, Col) :- in(P, Col), tile_center(T).
unfold_val(T2, P_img, Col) :-
    unfold_val(T, P, Col),                                             // known tile
    axis_of(D, A), step_delta(D, S), compose(T, S, T2), c.arr_pos(T2), // neighbor toward d
    flip_of(A, F), apply(F, P, P_img).                                 // reflect across the shared edge

out(P_grid, Col, $Unfold()) :-
    unfold_val(T, P_intile, Col),
    concat_2d(T, P_intile, 0, P_grid).
