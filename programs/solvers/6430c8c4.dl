// 6430c8c4
// @representative: f2829549

// how the input decomposes into tiles
.type DecChoice =
    // a stored tile arrangement fixes the tiles directly
    Table {}
    // a stored count splits the input along one axis
  | Count {}
    // the input splits along one axis into tiles of the output frame's extent
  | Size {}

// how a tile's color is found
.type Body =
    // a stored table of tile-color combinations gives the output color
    Lookup {}
    // the output takes out_fill where no tile carries non-bg ink, and bg
    // where some tile does
  | Nor {}

.type Choice    = [d: DecChoice, b: Body]

.type CombineMember = [p: Position, col: Color]
.type CombineKey    = [p: Position, dc: DecChoice]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // the tile's extent on both axes, which is the output frame's extent
    .decl frame_dim(k: number) frame_dim(4).

    // --- $Table ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 2). arr_dim(AXIS_H, 1).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah), frame_dim(K), gap(G),
        helpers.tile_pos([Av, Ah], [K, K], [G, 0], P_grid, P_tile, P_intile).

    // --- $Count, $Size ---
    .decl divide_axis(a: Axis)
    divide_axis(AXIS_V).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- $Count ---
    .decl divisor(n: number)
    divisor(2).

    // --- $Lookup ---
    .decl combine_member(id: Ident, p_outer: Position, c: Color)
    .decl combine_out(id: Ident, c_out: Color)

    combine_member(0, [0,1,0,0], 0). combine_member(0, [1,0,0,0], 0). combine_out(0, 3).
    combine_member(1, [0,1,0,0], 7). combine_member(1, [1,0,0,0], 0). combine_out(1, 0).
    combine_member(2, [0,1,0,0], 0). combine_member(2, [1,0,0,0], 2). combine_out(2, 0).
    combine_member(3, [0,1,0,0], 7). combine_member(3, [1,0,0,0], 2). combine_out(3, 0).

    // --- $Nor ---
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(3).
}

.init params = Params

.init combine_match = KeyedSetCompare<CombineKey, Ident, CombineMember>
combine_match.pattern_member(Id, [P_outer, C]) :- params.combine_member(Id, P_outer, C).
combine_match.observed_member([P_grid_out, Dc], [P_tile, C]) :-
    decompose(P_grid_in, P_tile, P_grid_out, Dc), in(P_grid_in, C).

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Table()).
dec_choice($Count()).
dec_choice($Size()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Table()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Count()) :-
    in(P_grid, _),
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),
    divide_slab(P_grid, A, N, G, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Size()) :-
    in(P_grid, _),
    params.divide_axis(A), params.frame_dim(K), params.divide_gap(G),
    divide_by_size_slab(P_grid, A, K, G, P_tile, P_intile).

// --- $Nor ---

.decl filled(o: Position, dc: DecChoice)
filled(P_grid_out, Dc) :-
    in(P_grid_in, Col), !params.bg(Col),
    decompose(P_grid_in, _, P_grid_out, Dc).

// --- Output ---

out(P_grid_out, Col_out, [Dc, $Lookup()]) :-
    params.combine_out(Id, Col_out),
    combine_match.equals([P_grid_out, Dc], Id).      // the cell's tiles == the entry's members

out(P_grid_out, Col, [Dc, $Nor()]) :-
    dec_choice(Dc), params.frame(P_grid_out),
    ( !filled(P_grid_out, Dc), params.out_fill(Col)
    ; filled(P_grid_out, Dc), params.bg(Col)
    ).
