// e57337a4
// @keywords: decompose markers
// output: Downscale fold: the input decomposes into a 3×3 arrangement of 5×5
//  tiles; each tile maps to one output cell — the mark color if the tile holds
//  a mark cell, else the canvas color (most-frequent in the input).

// Decomposition hypothesis (data-equivalent on 15×15)
.type Choice =
    // tile count params.divisor
    Count {}
    // tile size params.tile
  | Size {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(c: Color) mark(0).

    // --- Count ---
    .decl divisor(n: number) divisor(3).

    // --- Size ---
    .decl tile(k: number) tile(5).
}

.init params = Params

.init canvas = Mode<Unit, Color, Position>
canvas.item($U(), C, P) :- in(P, C).

.decl tile_of(p_grid: Position, p_tile: Position, ch: Choice)

// --- Count ---
tile_of(P, T, $Count())  :- in(P, _), params.divisor(N), divide_2d(P, N, 0, T, _).

// --- Size ---
tile_of(P, T, $Size()) :- in(P, _), params.tile(K), divide_by_size_2d(P, K, 0, T, _).

// Tile holds a mark cell.
.decl marked(p_tile: Position, ch: Choice)
marked(T, Ch) :- in(P, Col), params.mark(Col), tile_of(P, T, Ch).

out(T, Col, Ch) :- marked(T, Ch), params.mark(Col).
out(T, Col, Ch) :- tile_of(_, T, Ch), !marked(T, Ch), canvas.mode($U(), Col).
