// e57337a4
// concept: decompose markers
// Downscale fold: the input decomposes into a 3×3 arrangement of 5×5
// tiles; each tile maps to one output cell — the mark color if the tile
// holds a mark cell, else the canvas color (most-frequent in the input).
// Decomposition claim (data-equivalent on 15×15):
//   $Div()  — tile count c.divisor
//   $Size() — tile size c.tile

#include "../lib.dl"

.type Choice = Div {} | Size {}

.comp Consts {
    .decl mark(c: Color) mark(0).

    // --- Div ---
    .decl divisor(n: number) divisor(3).

    // --- Size ---
    .decl tile(k: number) tile(5).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Canvas color: most-frequent color in the input.
.decl color_count(c: Color, n: number)
color_count(C, N) :- in(_, C), N = count : { in(_, C) }.

.decl canvas(c: Color)
canvas(C) :- color_count(C, N), N = max N2 : { color_count(_, N2) }.

.decl tile_of(p_grid: Position, p_tile: Position, ch: Choice)

// --- Div ---
tile_of(P, T, $Div())  :- in(P, _), c.divisor(N), divide_2d(P, N, 0, T, _).

// --- Size ---
tile_of(P, T, $Size()) :- in(P, _), c.tile(K), divide_by_size_2d(P, K, 0, T, _).

// Tile holds a mark cell.
.decl marked(p_tile: Position, ch: Choice)
marked(T, Ch) :- in(P, Col), c.mark(Col), tile_of(P, T, Ch).

.decl out(p: Position, col: Color, ch: Choice)
out(T, Col, Ch) :- marked(T, Ch), c.mark(Col).
out(T, Col, Ch) :- tile_of(_, T, Ch), !marked(T, Ch), canvas(Col).

.output out(IO=stdout)
