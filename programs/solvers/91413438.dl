// 91413438
// concept: tile-arrangement count rank
// The input's bg-cell count sets the side of a square tile arrangement;
// its ink-cell count sets how many tiles carry a copy of the input,
// filled in reading order. The remaining tiles are bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(col: Color) bg(0).
    .decl lex_corner(d: DiagDir) lex_corner(DIAG_TL).
    .decl lex_axis(a: Axis) lex_axis(AXIS_V).
}

.init c = Consts

.init copy_count = Tally<Unit, Position>
copy_count.item($U(), P) :- in(P, Col), !c.bg(Col).

.init side = Tally<Unit, Position>
side.item($U(), P) :- in(P, Col), c.bg(Col).

.init tiles = Frame2D<Unit>
tiles.extent($U(), A, S) :- axis_elem(A), side.tally($U(), S).

.init lex = LexOrder<Unit>
lex.corner(D)     :- c.lex_corner(D).
lex.axis(A)       :- c.lex_axis(A).
lex.cell($U(), P) :- tiles.cell($U(), P).

.decl copy(p_tile: Position)
copy(T) :- lex.rank($U(), T, R), copy_count.tally($U(), N), R < N.

.decl out(p: Position, col: Color)
out(P_grid, Col) :-
    tiles.cell($U(), P_tile), in(P_intile, Col_in),   // tile slot, tile content
    ( copy(P_tile), Col = Col_in                      // a copy — the input
    ; !copy(P_tile), c.bg(Col)                        // past the count — bg
    ),
    concat_2d(P_tile, P_intile, 0, P_grid).           // tile ⊗ cell → grid
