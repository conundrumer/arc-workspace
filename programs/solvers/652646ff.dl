// 652646ff
// @draft
// @keywords: lookup occlude rank noise
// input: figures of one shape, each in its own color, drawn over one
//  another on a plain ground, with stray cells of further colors littering
//  the grid
// output: one tile per figure, each figure redrawn whole, stacked from the
//  front of the pile.
//  A figure that lies behind another shows with its covered cells missing,
//  so a color's figure is the placement of params.shape that its cells occur
//  in, and a color whose cells fit no placement is litter. The cells two
//  figures share say which of them is in front, and that order, closed
//  transitively, ranks the tiles.

// what the shared cells say about which figure is in front
.type Choice =
    // A covered cell never shows, so one shared cell showing a color puts that
    // color in front. Shared cells showing both colors are no pile.
    Existence {}
    // The color that shows on more of the shared cells is in front. Shared
    // cells showing both colors still rank the two colors.
  | Majority {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The figure a color draws, in a frame of its own.
    .decl shape(p: Position)
    GRID_MASK_6x6(shape,
        _, _, 1, 1, _, _,
        _, 1, _, _, 1, _,
        1, _, _, _, _, 1,
        1, _, _, _, _, 1,
        _, 1, _, _, 1, _,
        _, _, 1, 1, _, _)

    // The edge the stack runs from, the frontmost figure first.
    .decl stack_dir(d: Dir) stack_dir(DIR_T).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Existence()). impl_choice($Majority()).

.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl bg(col: Color)
bg(Col) :- bg_mode.mode($U(), Col).

// --- placements ---

// Every color but the ground draws a figure or litters the grid.
.decl ink(col: Color)
ink(Col) :- in(_, Col), !bg(Col).

// A color's cells occur in the figure: those cells take the shape role and
// the whole figure the cell role, so a placement carries the grid into the
// figure's frame.
.init occ = Occurrences<Color, Unit>
occ.cell(Col, P_intile, $U()) :- ink(Col), params.shape(P_intile).  // the whole figure
occ.shape(Col, P_grid, $U()) :- ink(Col), in(P_grid, Col).          // what shows of it

// The whole figure a color draws, covered cells included.
.decl drawn(col: Color, p: Position)
drawn(Col, P_grid) :-
    occ.occurrence(Col, P_place), params.shape(P_intile),
    relative(P_place, P_intile, P_grid).   // the figure cell back in the grid

// --- pile ---

// A cell two figures both cover, so one of them hides the other there.
.decl shared(col: Color, col2: Color, p: Position)
shared(Col, Col2, P_grid) :- drawn(Col, P_grid), drawn(Col2, P_grid), Col != Col2.

.decl front(col: Color, col2: Color, ch: Choice)
front(Col, Col2, Ch) :- front(Col, Mid, Ch), front(Mid, Col2, Ch).   // the pile is an order

.init stack = Order<Choice, Color>
stack.elem(Ch, Col) :- drawn(Col, _), impl_choice(Ch).
stack.before(Ch, Col, Col2) :- front(Col, Col2, Ch).

// The figure's tile, at its rank from the edge the stack runs from.
.decl tile(col: Color, p_tile: Position, ch: Choice)
tile(Col, P_tile, Ch) :-
    stack.rank(Ch, Col, R), stack.rank_desc(Ch, Col, R2),
    params.stack_dir(D), axis_inset(D, R, R2, P_tile).

// The tile's own frame, read off the shape's.
.init tile_frame = Frame2D<Unit>
tile_frame.extent($U(), A, N) :-
    axis_elem(A), params.shape(P_intile), axis_dim(P_intile, A, N).

out(P_grid, Col, Ch) :-
    tile(Col_fig, P_tile, Ch), tile_frame.cell($U(), P_intile),
    params.stack_dir(D), axis_of(D, A), concat_slab(P_tile, P_intile, A, 0, P_grid),
    ( params.shape(P_intile), Col = Col_fig   // the figure, redrawn whole
    ; !params.shape(P_intile), bg(Col)        // its ground
    ).

// --- $Existence ---

front(Col, Col2, $Existence()) :- shared(Col, Col2, P_grid), in(P_grid, Col).  // Col shows there

// --- $Majority ---

// The two figures of a shared cell, as the key of the count.
.type Pair = [col: Color, col2: Color]

// How far the first color outshows the second on the cells they share.
.init lead = Excess<Pair, Position>
lead.plus([Col, Col2], P_grid) :- shared(Col, Col2, P_grid), in(P_grid, Col).
lead.minus([Col, Col2], P_grid) :- shared(Col, Col2, P_grid), in(P_grid, Col2).

front(Col, Col2, $Majority()) :- lead.excess([Col, Col2], _).

.comp Determine {
    // One figure of one example, keyed by the color that draws it.
    .type Fig = [e: Example, col: Color]

    .init ground = Mode<Example, Color, Position>
    ground.item(E, Col, P) :- ex_out(E, P, Col).

    // The output redraws every figure whole, so a figure fills its own box.
    .init frame = Bbox<Fig>
    frame.cell([E, Col], P) :- ex_out(E, P, Col), !ground.mode(E, Col).

    .decl shape(p: Position)
    shape(P_intile) :- frame.cell(F, P), frame.box(F, B), crop(P, B, P_intile).
}
