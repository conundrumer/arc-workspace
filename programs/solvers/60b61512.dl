// 60b61512
// @draft
// @keywords: objects mapping stamp
// input: ink shapes lie on params.bg, each spanning three cells on both
//  axes.
// output: each shape's region is painted params.fill, over its background
//  cells only.

// what the region covers
.type Choice =
    // every cell of the shape's bounding box
    Box {}
    // a stored footprint, read in that box's own frame
  | Stamp {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl fill(col: Color) fill(7).

    // --- $Stamp ---
    .decl footprint(p: Position)
    GRID_MASK_3x3(footprint,
        1, 1, 1,
        1, 1, 1,
        1, 1, 1)
}

.init params = Params

// --- shapes ---

.init objs = Components8<Unit>
objs.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bx = Bbox<Ident>
bx.cell(Id, P) :- objs.label($U(), P, Id).

.decl impl_choice(ch: Choice)
impl_choice($Box()). impl_choice($Stamp()).

.decl region(p: Position, ch: Choice)

// --- $Box ---

region(P, $Box()) :- in(P, _), bx.box(_, B), inside(P, B).

// --- $Stamp ---

region(P, $Stamp()) :-
    in(P, _), bx.box(_, B), crop(P, B, P_inner), params.footprint(P_inner).

// --- output ---

.decl painted(p: Position, ch: Choice)
painted(P, Ch) :- region(P, Ch), in(P, Col), params.bg(Col).

out(P, Col, Ch) :- painted(P, Ch), params.fill(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !painted(P, Ch).

.comp Determine {
    .type EI = [e: Example, id: Ident]

    .init objs = Components8<Example>
    objs.node(E, P) :- ex_in(E, P, Col), !params.bg(Col).

    .init bx = Bbox<EI>
    bx.cell([E, Id], P) :- objs.label(E, P, Id).

    // Box cells an output leaves non-background, in the box's own frame.
    .decl footprint(p: Position)
    footprint(P_inner) :-
        bx.box([E, _], B), crop(P, B, P_inner),
        ex_out(E, P, Col), !params.bg(Col).
}
