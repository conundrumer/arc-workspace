// d93c6891
// @draft
// @keywords: objects count
// @scene field: one rectangle of `floor` color (4), with the bars and blocks on
//  it, on a `background` (0) that fills the rest of the grid
// @scene blocks: rectangles of `block` color (7), each with one side on one side
//  of the field's border, and that side of the field faces the background
// @scene bars: straight runs of `bar` color (5) on the field's border, and each
//  bar touches exactly one block
// @scene whole-layers: for each block, the count of bar cells that touch it is a
//  whole multiple of the block's extent along its border side, and is at most
//  the block's area
// @rule bar-count: each block takes the total count of cells in the bars that
//  touch it
// @rule fill-from-border: in each block, the layers parallel to its border side,
//  starting at the border, turn `bar` color, as many layers as the count divided
//  by the block's extent along the border; the other layers of the block keep
//  `block` color
// @rule bars-erase: every bar cell turns `floor` color
// @rule rest-unchanged: every other cell keeps its input color

// which bar cells a block takes
.type Contact =
    // @claim bar-count
    Contact4 {}
    // @rule bar-count: each block takes every cell of each bar that touches it
    //  at a side or a corner
    // @witness diagonal-bar: borderline concept
    //     @relaxed bars
  | Contact8 {}
    // @rule bar-count: each block takes the bar cells that a walk along the
    //  field's border ring reaches from the block's own ring cells, stepping
    //  through bar cells
    // @witness bar-under-block: borderline concept
  | RingPath {}

// the side the layers start from
.type Side =
    // @claim fill-from-border
    FromBorder {}
    // @rule fill-from-border: the layers run parallel to the line of the bars
    //  the block takes, and start at the block side nearest that line; a
    //  one-cell bar takes the border side; the count is divided by the block's
    //  extent along that side; undefined where the bars give two sides
    // @witness bottom-bar-right-block: ordinary concept
  | FromBarLine {}

// a bar count that is not a whole multiple of the block's extent along the side
// the layers start from
.type Remainder =
    // @claim whole-layers
    WholeOnly {}
    // @scene whole-layers: the count need not be a whole multiple
    // @rule fill-from-border: the whole layers the count gives fill, and the
    //  cells left over are dropped
    // @witness partial-layer: foreign $PartialFromBar
    //     @relaxed whole-layers
  | FloorLayers {}
    // @scene whole-layers: the count need not be a whole multiple
    // @rule fill-from-border: the whole layers fill, and the cells left over
    //  fill the next layer from the block end that the bars touch; undefined
    //  where cells are left over and the bars touch both ends or neither
    // @witness partial-layer: foreign $PartialFromBar
  | PartialFromBar {}

// a bar count of more than the block's area
.type Overflow =
    // @claim whole-layers
    WithinBlock {}
    // @scene whole-layers: the count may be more than the block's area
    // @rule fill-from-border: there the whole block fills, and the extra bar
    //  cells are erased with the rest
    // @witness overfull: foreign $CapAtBlock
    //     @relaxed whole-layers
  | CapAtBlock {}

// a bar that no block takes
.type Loose =
    // @claim bars-erase
    EraseAll {}
    // @rule bars-erase: only the bar cells a block takes turn `floor` color,
    //  and the others keep `bar` color
    // @witness loose-bar: borderline concept
    //     @relaxed bars
  | KeepLoose {}

// the cells that make up the field, which give each block's border side
.type Field =
    // @claim field
    NonBackground {}
    // @scene field: the field is the cells of `floor`, `bar` or `block` color,
    //  and a block's border side is a side that faces no field cell; reads no
    //  `background`
    // @witness stray-color-row: borderline concept
    //     @relaxed field
    // @witness grid-edge-block: borderline $FieldByColors
    //     @relaxed blocks
  | FieldByColors {}

.type Choice = [c: Contact, s: Side, r: Remainder, o: Overflow, l: Loose, f: Field]

.type RingKey = [f: Field, b: Ident]
.type TakeKey = [c: Contact, f: Field, b: Ident]
.type ColorKey = [e: Example, c: Color]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bar(c: Color) bar(5).
    .decl block(c: Color) block(7).
    .decl floor(c: Color) floor(4).

    // --- $NonBackground ---
    .decl background(c: Color) background(0).
}

.init params = Params

.decl contact_choice(c: Contact)
contact_choice($Contact4()). contact_choice($Contact8()). contact_choice($RingPath()).

.decl side_choice(s: Side)
side_choice($FromBorder()). side_choice($FromBarLine()).

.decl remainder_choice(r: Remainder)
remainder_choice($WholeOnly()). remainder_choice($FloorLayers()). remainder_choice($PartialFromBar()).

.decl overflow_choice(o: Overflow)
overflow_choice($WithinBlock()). overflow_choice($CapAtBlock()).

.decl loose_choice(l: Loose)
loose_choice($EraseAll()). loose_choice($KeepLoose()).

.decl field_choice(f: Field)
field_choice($NonBackground()). field_choice($FieldByColors()).

.decl impl_choice(ch: Choice)
impl_choice([C, S, R, O, L, F]) :-
    contact_choice(C), side_choice(S), remainder_choice(R),
    overflow_choice(O), loose_choice(L), field_choice(F).

.decl block_cell(p: Position)
block_cell(P) :- in(P, Col), params.block(Col).

.decl bar_cell(p: Position)
bar_cell(P) :- in(P, Col), params.bar(Col).

// @claim blocks
.init blocks = Components<Unit>
blocks.node($U(), P) :- block_cell(P).

// @claim blocks
.init block_box = Bbox<Ident>
block_box.cell(B, P) :- blocks.label($U(), P, B).

// @claim bars
.init bars = Components<Unit>
bars.node($U(), P) :- bar_cell(P).

// Block cell p's distance to block b's side d.
.decl depth(b: Ident, p: Position, d: Dir, k: number)
depth(B, P, D, K) :-
    blocks.label($U(), P, B), block_box.box(B, Bx), crop(P, Bx, P_rel),
    dir_elem(D), dist(P_rel, D, K).

// Cell p's neighbor toward d lies outside the field.
.decl faces(f: Field, p: Position, d: Dir)

// --- $NonBackground ---
faces($NonBackground(), P, D) :-
    in(P, _), dir_elem(D), neighbor(P, D, Q), in(Q, Col), params.background(Col).

// --- $FieldByColors ---
.decl field_cell(p: Position)
field_cell(P) :- in(P, Col), ( params.floor(Col) ; params.bar(Col) ; params.block(Col) ).

faces($FieldByColors(), P, D) :- in(P, _), dir_elem(D), neighbor(P, D, Q), !field_cell(Q).

// --- every case ---

// The side of block b on the field's border.
.decl border_side(f: Field, b: Ident, d: Dir)
border_side(F, B, D) :- blocks.label($U(), P, B), faces(F, P, D).

// Block b takes bar cell q.
.decl taken(c: Contact, f: Field, b: Ident, q: Position)

// --- $Contact4 ---
taken($Contact4(), F, B, Q) :-
    field_choice(F),
    blocks.label($U(), P, B), dir_elem(D), neighbor(P, D, Q2),   // a bar cell beside the block
    bars.label($U(), Q2, Id), bars.label($U(), Q, Id).

// --- $Contact8 ---
taken($Contact8(), F, B, Q) :-
    field_choice(F),
    blocks.label($U(), P, B), dir8_elem(D), neighbor(P, D, Q2),  // a bar cell beside the block or at its corner
    bars.label($U(), Q2, Id), bars.label($U(), Q, Id).

// --- $RingPath ---
// A walk along the field's border ring, from block b's ring cells through bar
// cells.
// @claim bar-count
.init ring_walk = Reach<RingKey>
ring_walk.node([F, B], P) :- faces(F, P, _), bar_cell(P), block_box.box(B, _).
ring_walk.node([F, B], P) :- faces(F, P, _), blocks.label($U(), P, B).
ring_walk.seed([F, B], P) :- faces(F, P, _), blocks.label($U(), P, B).

taken($RingPath(), F, B, Q) :- ring_walk.reach([F, B], Q), bar_cell(Q).

// --- every case ---

// @claim bar-count
.init take_count = Tally<TakeKey, Position>
take_count.item([C, F, B], Q) :- taken(C, F, B, Q).

// @claim whole-layers
.init area = Tally<Ident, Position>
area.item(B, P) :- blocks.label($U(), P, B).

.decl fill_side(c: Contact, s: Side, f: Field, b: Ident, d: Dir)

// --- $FromBorder ---
fill_side(C, $FromBorder(), F, B, D) :- contact_choice(C), border_side(F, B, D).

// --- $FromBarLine ---
// The bars block b takes.
.decl taken_bar(c: Contact, f: Field, b: Ident, id: Ident)
taken_bar(C, F, B, Id) :- taken(C, F, B, Q), bars.label($U(), Q, Id).

// The axis a bar of two or more cells runs along.
.decl bar_axis(id: Ident, a: Axis)
bar_axis(Id, A) :-
    bars.label($U(), Q, Id), dir_elem(D), neighbor(Q, D, Q2), bars.label($U(), Q2, Id),
    axis_of(D, A).

fill_side(C, $FromBarLine(), F, B, D) :-
    taken_bar(C, F, B, Id), bar_axis(Id, A), perp(A, A_fill), axis_of(D, A_fill),  // layers parallel to the bar
    bars.label($U(), Q, Id), block_box.box(B, Bx), relative(Bx, Q, Q_rel),
    dist_pair(Q_rel, D, K, K2), K < K2.                                             // the side nearer the bar's line
fill_side(C, $FromBarLine(), F, B, D) :-
    taken_bar(C, F, B, Id), !bar_axis(Id, _), border_side(F, B, D).                 // a one-cell bar takes the border side

// --- every case ---

// Block b has more than one side to fill from.
.decl sides_clash(c: Contact, s: Side, f: Field, b: Ident)
sides_clash(C, S, F, B) :- fill_side(C, S, F, B, D), fill_side(C, S, F, B, D2), D != D2.

// Block b fills from side d: the count gives `layers` whole layers, and `rest`
// cells over.
.decl pour(c: Contact, s: Side, f: Field, b: Ident, d: Dir, layers: number, rest: number)
pour(C, S, F, B, D, Layers, Rest) :-
    fill_side(C, S, F, B, D), !sides_clash(C, S, F, B), take_count.tally([C, F, B], N),
    block_box.box(B, Bx), blocks.label($U(), P, B),
    axis_of(D, A), perp(A, A2), box_extent(Bx, P, A2, E),   // the block's extent along side d
    stride(N, E, 0, Layers, Rest).

// Cells are left over, and the next layer is there to take them.
.decl next_layer(c: Contact, s: Side, f: Field, b: Ident)
next_layer(C, S, F, B) :- pour(C, S, F, B, D, Layers, Rest), Rest > 0, depth(B, _, D, Layers).

.decl overfull(c: Contact, f: Field, b: Ident)
overfull(C, F, B) :- take_count.tally([C, F, B], N), area.tally(B, A), N > A.

// The blocks a case leaves undefined.
.decl undefined(ch: Choice, b: Ident)
undefined([C, S, R, O, L, F], B) :-
    impl_choice([C, S, R, O, L, F]), taken(C, F, B, _), !pour(C, S, F, B, _, _, _).

// Block cell p turns `bar` color.
.decl poured_cell(ch: Choice, p: Position)
poured_cell([C, S, R, O, L, F], P) :-
    impl_choice([C, S, R, O, L, F]), pour(C, S, F, B, D, Layers, _),
    depth(B, P, D, K), K < Layers.

// --- $WholeOnly ---
undefined([C, S, $WholeOnly(), O, L, F], B) :-
    impl_choice([C, S, $WholeOnly(), O, L, F]), pour(C, S, F, B, _, _, Rest), Rest > 0.

// --- $PartialFromBar ---
// A taken bar cell lies beyond the block's end e, a side across the fill side.
.decl touched_end(c: Contact, s: Side, f: Field, b: Ident, e: Dir)
touched_end(C, S, F, B, E) :-
    pour(C, S, F, B, D, _, _), perp_dir(D, E), taken(C, F, B, Q),
    blocks.label($U(), P, B), block_box.box(B, Bx), box_edge(P, Bx, E), nearer(E, Q, P).

// The bars touch end e alone.
.decl one_end(c: Contact, s: Side, f: Field, b: Ident, e: Dir)
one_end(C, S, F, B, E) :-
    touched_end(C, S, F, B, E), opposite(E, E2), !touched_end(C, S, F, B, E2).

undefined([C, S, $PartialFromBar(), O, L, F], B) :-
    impl_choice([C, S, $PartialFromBar(), O, L, F]), next_layer(C, S, F, B),
    !one_end(C, S, F, B, _).

poured_cell([C, S, $PartialFromBar(), O, L, F], P) :-
    impl_choice([C, S, $PartialFromBar(), O, L, F]),
    pour(C, S, F, B, D, Layers, Rest), one_end(C, S, F, B, E),
    depth(B, P, D, Layers),                       // in the next layer
    depth(B, P, E, K), K < Rest.                  // among the first cells from the touched end

// --- $WithinBlock ---
undefined([C, S, R, $WithinBlock(), L, F], B) :-
    impl_choice([C, S, R, $WithinBlock(), L, F]), overfull(C, F, B).

// --- every case ---
out(P, Col, Ch) :-
    blocks.label($U(), P, B), impl_choice(Ch), !undefined(Ch, B),
    ( poured_cell(Ch, P), params.bar(Col)
    ; !poured_cell(Ch, P), params.block(Col)
    ).

.decl erased(ch: Choice, q: Position)

// --- $EraseAll ---
erased([C, S, R, O, $EraseAll(), F], Q) :-
    impl_choice([C, S, R, O, $EraseAll(), F]), bar_cell(Q).

// --- $KeepLoose ---
erased([C, S, R, O, $KeepLoose(), F], Q) :-
    impl_choice([C, S, R, O, $KeepLoose(), F]), taken(C, F, _, Q).

// --- every case ---
out(Q, Col, Ch) :- erased(Ch, Q), params.floor(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !block_cell(P), !erased(Ch, P).

.comp Determine {
    // The colors a train output repaints, from and to.
    .decl repaint(c_in: Color, c_out: Color)
    repaint(C_in, C_out) :- ex_in(E, P, C_in), ex_out(E, P, C_out), C_in != C_out.

    // Block cells turn bar color, and bar cells turn floor color.
    .decl chain(c_block: Color, c_bar: Color, c_floor: Color)
    chain(C_block, C_bar, C_floor) :- repaint(C_block, C_bar), repaint(C_bar, C_floor).

    .decl bar(c: Color)
    bar(Col) :- chain(_, Col, _).

    .decl block(c: Color)
    block(Col) :- chain(Col, _, _).

    .decl floor(c: Color)
    floor(Col) :- chain(_, _, Col).

    // The box of each train input's cells in colors other than col.
    .init rest_box = Bbox<ColorKey>
    rest_box.cell([E, Col], P) :-
        ex_out(E, _, _), ex_in(E, _, Col), ex_in(E, P, Col2), Col2 != Col.

    // A cell of col lies inside that box.
    .decl inside_rest(e: Example, c: Color)
    inside_rest(E, Col) :- rest_box.box([E, Col], B), ex_in(E, P, Col), inside(P, B).

    // The color that lies only outside the rectangle the other colors fill,
    // in every train input.
    .decl background(c: Color)
    background(Col) :- ex_out(E, _, _), ex_in(E, _, Col), !inside_rest(_, Col).
}
