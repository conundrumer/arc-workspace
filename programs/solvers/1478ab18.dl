// 1478ab18
// concept: markers span rank
// Marks sit on a plain field, two of them spanning a diagonal. The output draws
// the right isosceles triangle on that diagonal in params.ink: the diagonal is the
// hypotenuse and the legs meet at one corner of the box it spans. Marks keep
// their color where the triangle crosses them. The other marks say which
// diagonal and which corner; Choice = [l, v] crosses the hypotheses:
//
//   l (which mark pair spans the hypotenuse):
//     $Longest()  — the diagonal mark pair with the greatest separation.
//     $Cornered() — the diagonal mark pair with a mark at a box corner.
//   v (which box corner carries the right angle):
//     $Free()     — the corner that is not a mark.
//     $Pointed()  — the corner with a mark diagonally adjacent.
//     $Inside()   — the corner whose closed triangle holds a non-vertex mark.

#include "../lib.dl"

.type Locate = Longest {} | Cornered {}
.type Vertex = Free {} | Pointed {} | Inside {}
.type Choice = [l: Locate, v: Vertex]

.comp Params {
    .decl mark(col: Color) mark(5).
    .decl ink(col: Color) ink(8).
}

.init params = Params

.decl mark(p: Position)
mark(P) :- in(P, Col), params.mark(Col).

// Marks cast along the diagonals, seeing only marks.
.init diag = Ray<Unit>
diag.dir($U(), D) :- diag_dir_elem(D).
diag.cell($U(), P) :- mark(P).
diag.mark($U(), P) :- mark(P).

// Two marks on a common diagonal, k steps apart.
.decl aligned(p: Position, q: Position, k: number)
aligned(P, Q, K) :- diag.ray($U(), Q, _, K, P), K != 0.

// The two corners of the box a diagonal pair spans, besides p and q.
.decl corner_cell(p: Position, q: Position, cor: Position)
corner_cell(P, Q, Cor) :-
    aligned(P, Q, _), axis_elem(A),
    split(P, A, P_along, _), split(Q, A, _, Q_across),
    compose(P_along, Q_across, Cor).

// --- Locate cases: the hypotenuse endpoints ---

.decl locate_choice(l: Locate)
locate_choice($Longest()).
locate_choice($Cornered()).

.decl hyp(p: Position, l: Locate)

// $Longest — the widest separation any diagonal mark pair reaches.
.init far = ArgExtremes<Unit, Position>
far.cand($U(), P, K) :- aligned(P, _, K).

hyp(P, $Longest()) :- far.high($U(), P, _).

// $Cornered — a mark sits at one of the pair's two box corners.
hyp(P, $Cornered()) :- aligned(P, Q, _), corner_cell(P, Q, Cor), mark(Cor).

// --- Vertex cases: which box corner carries the right angle ---

.decl vertex_choice(v: Vertex)
vertex_choice($Free()).
vertex_choice($Pointed()).
vertex_choice($Inside()).

// The right angle sits at one of the hypotenuse box's other two corners.
.decl corner_cand(cor: Position, l: Locate)
corner_cand(Cor, L) :- hyp(P, L), hyp(Q, L), corner_cell(P, Q, Cor).

.decl right_angle(p: Position, l: Locate, v: Vertex)

// $Free — the corner the marks left open.
right_angle(Cor, L, $Free()) :- corner_cand(Cor, L), !mark(Cor).

// $Pointed — the corner a mark stands diagonally next to.
right_angle(Cor, L, $Pointed()) :-
    corner_cand(Cor, L),
    diag_dir_elem(D), neighbor(Cor, D, P_near), mark(P_near).

// $Inside — the corner whose closed triangle holds a non-vertex mark. Viewed
// from the hypotenuse pair's box, the hypotenuse is the diagonal from a
// corner next to Cor's, and the triangle is the cells on Cor's side of it:
// no farther from the edge the two corners share than from the other edge
// of that next corner.
.init tri = Bbox<Locate>
tri.cell(L, P) :- hyp(P, L).

right_angle(Cor, L, $Inside()) :-
    corner_cand(Cor, L), tri.box(L, B),
    box_corner(Cor, B, Dc),                                      // Cor's box corner
    diag_dirs(Dc, A, D1, _), diag_dirs(Dh, A, D1, _), Dh != Dc,  // the next corner along edge D1
    mark(M), !hyp(M, L), M != Cor, crop(M, B, P_inner),          // non-vertex mark in the box
    diag_dist(P_inner, Dh, A, K1, K2), K1 <= K2.                 // on Cor's side of Dh's diagonal

// --- The triangle ---

.decl impl_choice(ch: Choice)
impl_choice([L, V]) :- locate_choice(L), vertex_choice(V).

.decl vertex(p: Position, ch: Choice)
vertex(P, [L, V]) :- hyp(P, L), vertex_choice(V).
vertex(P, [L, V]) :- right_angle(P, L, V).

// The three vertices cast at each other: a cell with vertices on both sides of
// one of its lines lies on the side joining them.
.init span = Between<Choice>
span.axis(Ch, A) :- axis4_elem(A), impl_choice(Ch).
span.cell(Ch, P) :- in(P, _), impl_choice(Ch).
span.mark(Ch, P) :- vertex(P, Ch).

.decl paint(p: Position, ch: Choice)
paint(P, Ch) :- span.between(Ch, P), !mark(P).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- paint(P, Ch), params.ink(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !paint(P, Ch).
