// 009d5c81
// concept: markers lookup
// The input holds a shape and a key of marker cells. The key's pattern
// selects a color from a stored table; the output paints the shape in that
// color and clears the key.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(1).
    .decl ink(c: Color) ink(8).

    .decl key_member(id: Ident, p: Position)
    .decl key_out(id: Ident, c: Color)

    GRID_MASK_3x3(key_member, 0,
        0, 1, 0,
        1, 1, 1,
        0, 1, 0)
    key_out(0, 2).

    GRID_MASK_3x3(key_member, 1,
        1, 0, 1,
        0, 1, 0,
        1, 1, 1)
    key_out(1, 3).

    GRID_MASK_3x3(key_member, 2,
        1, 1, 1,
        1, 0, 1,
        0, 1, 0)
    key_out(2, 7).
}

.init params = Params

// --- parse ---

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    .init frame = BoxFrame<Key>
    frame.cell(K, P) :- cell(K, P, Col), params.marker(Col).

    .decl key_shape(k: Key, p_inkey: Position)
    key_shape(K, P_inkey) :- frame.inner(K, _, P_inkey).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.init key_match = KeyedSetCompare<Unit, Ident, Position>
key_match.pattern_member(Id, P_inkey) :- params.key_member(Id, P_inkey).
key_match.observed_member($U(), P_inkey) :- parse.key_shape($U(), P_inkey).

.decl ink_cell(p: Position)
ink_cell(P) :- in(P, Col), params.ink(Col).

.decl out(p: Position, col: Color)
out(P, Col) :- ink_cell(P), key_match.equals($U(), Id), params.key_out(Id, Col).
out(P, Col) :- in(P, _), !ink_cell(P), params.bg(Col).

// --- determination ---

.comp Determine {
    // Train pairs only — the ex_out atom holds the test inputs out.
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    // Examples whose keys share a pattern share an entry.
    .init same = KeyedSetCompare<Example, Example, Position>
    same.pattern_member(E, P_inkey) :- parse.key_shape(E, P_inkey).
    same.observed_member(E, P_inkey) :- parse.key_shape(E, P_inkey).

    .init entry = Canon<Example>
    entry.equiv(E, E2) :- same.equals(E, E2).

    .decl key_member(id: Ident, p: Position)
    key_member(Id, P_inkey) :- entry.id(E, Id), parse.key_shape(E, P_inkey).

    // The entry's color is the one color the output paints.
    .decl key_out(id: Ident, c: Color)
    key_out(Id, Col) :- entry.id(E, Id), ex_out(E, _, Col), !params.bg(Col).
}
