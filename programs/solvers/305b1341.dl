// 305b1341
// draft
// concept: overlay select parity rank
// A legend sits at the params.legend_corner corner: one line per entry, a dot
// color beside the fill color it takes. Away from the legend, each dot
// color's cells form a rectangular panel. Every panel is drawn as its
// bounding box grown by one ring, the fill color around the dots. Where
// two panels overlap, the output shows the one on top.
// Choice = [dots, stack] crosses the hypotheses:
//
//   dots (what a panel holds):
//     $Shown()   — the dots the input shows.
//     $Lattice() — a dot lattice of period params.dot_size + params.dot_gap over the
//                  whole box, so a panel carries dots the input hides.
//   stack (which of two overlapping panels wins):
//     $Legend()    — the legend's order, its first entry on top.
//     $Occlusion() — read off the scene: a panel covering a lattice point
//                    another panel does not show lies over that panel.

#include "../lib.dl"

.type Dots = Shown {} | Lattice {}
.type Stack = Legend {} | Occlusion {}
.type Choice = [dots: Dots, stack: Stack]

.comp Params {
    .decl bg(col: Color) bg(0).

    // The legend's corner, and the axis its entries run along.
    .decl legend_corner(d: DiagDir) legend_corner(DIAG_TL).
    .decl legend_axis(a: Axis) legend_axis(AXIS_V).

    // --- $Lattice ---

    .decl dot_size(k: number) dot_size(1).
    .decl dot_gap(g: number) dot_gap(1).
}

.init params = Params

// $Occlusion reads the dots the input hides, which only $Lattice holds.
.decl impl_choice(ch: Choice)
impl_choice([$Shown(), $Legend()]).
impl_choice([$Lattice(), $Legend()]).
impl_choice([$Lattice(), $Occlusion()]).

// --- the legend ---

// The legend's edges: its entries run from d_run, their dots lie on d_side.
.decl legend_dirs(d_run: Dir, d_side: Dir)
legend_dirs(D_run, D_side) :-
    params.legend_corner(D), params.legend_axis(A), diag_dirs(D, A, D_run, D_side).

// An entry: a dot color on the legend's edge, beside the fill color it takes.
.decl legend(dot: Color, fill: Color, p_dot: Position, p_fill: Position)
legend(Dot, Fill, P, Q) :-
    legend_dirs(_, D_side), in(P, Dot), dist(P, D_side, 0), !params.bg(Dot),  // dot on the legend's edge
    neighbor(Q, D_side, P), in(Q, Fill), !params.bg(Fill).                    // the fill color beside it

// --- the panels ---

// A dot color's cells away from the legend.
.decl panel_cell(dot: Color, p: Position)
panel_cell(Dot, P) :-
    legend(Dot, _, _, _), in(P, Dot),          // a cell of an entry's dot color
    !legend(_, _, P, _), !legend(_, _, _, P).  // away from the legend

.init box = BoxFrame<Color>
box.cell(Dot, P) :- panel_cell(Dot, P).
box.grid(Dot, P) :- legend(Dot, _, _, _), in(P, _).

// The panel: the box grown by one ring.
.decl panel(dot: Color, p: Position)
panel(Dot, Q) :-
    box.inside(Dot, P),
    ( Q = P                                     // the box
    ; dir8_elem(D), neighbor(P, D, Q), in(Q, _) // and the ring around it
    ).

// The dot lattice over the box, anchored on it.
.decl lattice(dot: Color, p: Position)
lattice(Dot, P) :-
    box.inner(Dot, P, P_inner),              // the cell in the box's frame
    params.dot_size(K), params.dot_gap(G),   // the lattice's period
    divide_by_size_2d(P_inner, K, G, _, _).  // a lattice point

// --- the stack ---

// Dot's panel draws over Dot2's.
.decl above(dot: Color, dot2: Color, st: Stack)
above(Dot, Dot2, $Legend()) :-
    legend_dirs(D_run, _),                                      // the legend runs from D_run
    legend(Dot, _, P, _), legend(Dot2, _, P2, _),               // two entries
    nearer(D_run, P, P2).                                       // the nearer draws over the farther

above(Dot, Dot2, $Occlusion()) :-
    lattice(Dot2, P), !panel_cell(Dot2, P),                     // a lattice point Dot2 does not show
    panel(Dot, P), Dot != Dot2.                                 // lies under Dot's panel

// --- output ---

// The dots the panel holds.
.decl dotted(dot: Color, p: Position, ds: Dots)
dotted(Dot, P, $Shown()) :- panel_cell(Dot, P).
dotted(Dot, P, $Lattice()) :- lattice(Dot, P).

.decl paint(dot: Color, p: Position, ink: Color, ds: Dots)
paint(Dot, P, Ink, Ds) :-
    impl_choice([Ds, _]), panel(Dot, P), legend(Dot, Fill, _, _),
    ( dotted(Dot, P, Ds), Ink = Dot                             // a dot of the panel
    ; !dotted(Dot, P, Ds), Ink = Fill                           // the fill around it
    ).

// Another panel draws over Dot's here.
.decl covered(p: Position, dot: Color, ch: Choice)
covered(P, Dot, [Ds, St]) :-
    impl_choice([Ds, St]), paint(Dot, P, _, Ds),  // Dot paints here
    paint(Dot2, P, _, Ds), above(Dot2, Dot, St).  // and a panel over it does too

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, [Ds, St]) :-
    impl_choice([Ds, St]), in(P, _),
    ( paint(Dot, P, Col, Ds), !covered(P, Dot, [Ds, St])  // the top panel here
    ; !paint(_, P, _, Ds), params.bg(Col)                 // no panel: bg
    ).
