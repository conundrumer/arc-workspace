// 305b1341
// @draft
// @keywords: overlay select parity rank
// input: a legend sits on the params.legend_side edge: each entry is a dot
//  color beside the fill color it takes. Away from the legend, each dot
//  color's cells make a panel of evenly spaced dots.
// output: every panel grows by one ring and is drawn with the fill color
//  around its dots. Where two panels overlap, the output shows the one on top.

// what a panel holds
.type Dots =
    // the dots the input shows
    Shown {}
    // a periodic dot pattern of period params.dot_size + params.dot_gap over
    // the whole box, so a panel carries dots the input hides
  | Periodic {}

// what the panel's ring grows around
.type Panel =
    // the bounding box of the dots, so the panel is a rectangle
    Box {}
    // the dots themselves, so the panel reaches one ring from a dot and no
    // farther
  | Cells {}

// which of two overlapping panels wins
.type Stack =
    // the legend's order, its first entry on top
    Legend {}
    // read off the scene: a panel covering a dot of the periodic pattern that
    // another panel does not show lies over that panel
  | Occlusion {}

.type Choice = [dots: Dots, panel: Panel, stack: Stack]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The edge the legend's dot colors sit on.
    .decl legend_side(d: Dir) legend_side(DIR_L).

    // --- $Periodic ---

    .decl dot_size(k: number) dot_size(1).
    .decl dot_gap(g: number) dot_gap(1).

    // --- $Legend ---

    // The quarter turn from legend_side to the edge the first entry lies on.
    .decl legend_sense(s: Sense) legend_sense(SENSE_CW).
}

.init params = Params

// $Occlusion reads the dots the input hides, which only $Periodic holds.
.decl impl_choice(ch: Choice)
impl_choice([$Shown(), $Box(), $Legend()]).
impl_choice([$Shown(), $Cells(), $Legend()]).
impl_choice([$Periodic(), $Box(), $Legend()]).
impl_choice([$Periodic(), $Cells(), $Legend()]).
impl_choice([$Periodic(), $Box(), $Occlusion()]).
impl_choice([$Periodic(), $Cells(), $Occlusion()]).

.decl dots_choice(ds: Dots)
dots_choice(Ds) :- impl_choice([Ds, _, _]).

// --- the legend ---

// An entry: a dot color on the legend's edge, beside the fill color it takes.
.decl legend(dot: Color, fill: Color, p_dot: Position, p_fill: Position)
legend(Dot, Fill, P, Q) :-
    params.legend_side(D_side), in(P, Dot), dist(P, D_side, 0), !params.bg(Dot),  // dot on the legend's edge
    neighbor(Q, D_side, P), in(Q, Fill), !params.bg(Fill).                        // the fill color beside it

// --- the panels ---

// A dot color's cells away from the legend.
.decl panel_cell(dot: Color, p: Position)
panel_cell(Dot, P) :-
    legend(Dot, _, _, _), in(P, Dot),          // a cell of an entry's dot color
    !legend(_, _, P, _), !legend(_, _, _, P).  // away from the legend

.init bbox = Bbox<Color>
bbox.cell(Dot, P) :- panel_cell(Dot, P).

// The periodic dot pattern over the box.
.decl periodic_dot(dot: Color, p: Position)
periodic_dot(Dot, P) :-
    in(P, _), bbox.box(Dot, B), crop(P, B, P_inner),  // the cell in the box's frame
    params.dot_size(K), params.dot_gap(G),            // the pattern's period
    divide_by_size_2d(P_inner, K, G, _, _).           // a dot of the pattern

// The dots the panel holds.
.decl dotted(dot: Color, p: Position, ds: Dots)
dotted(Dot, P, $Shown()) :- panel_cell(Dot, P).
dotted(Dot, P, $Periodic()) :- periodic_dot(Dot, P).

// The bounding box of the dots grown by one ring: the box of the cells one
// diagonal step out from its corners, which every Dots case shares.
.init grown = Bbox<Color>
grown.cell(Dot, Q) :- bbox.box(Dot, B), in(P, _), box_corner(P, B, Dc), neighbor(P, Dc, Q).

.decl box_panel(dot: Color, p: Position)
box_panel(Dot, Q) :- in(Q, _), grown.box(Dot, B), inside(Q, B).

// The panel: what the panel's ring grows around, grown by one ring.
.decl panel(dot: Color, p: Position, ds: Dots, pn: Panel)
panel(Dot, Q, Ds, $Box()) :- dots_choice(Ds), box_panel(Dot, Q).
panel(Dot, Q, Ds, $Cells()) :-
    dotted(Dot, P, Ds),
    ( Q = P                                     // the dots
    ; dir8_elem(D), neighbor(P, D, Q), in(Q, _) // and the ring around them
    ).

// --- the stack ---

// Dot's panel draws over Dot2's.
.decl above(dot: Color, dot2: Color, ch: Choice)
above(Dot, Dot2, [Ds, Pn, $Legend()]) :-
    impl_choice([Ds, Pn, $Legend()]),
    params.legend_side(D), params.legend_sense(S), turn(S, D, D_run),  // the legend runs from D_run
    legend(Dot, _, P, _), legend(Dot2, _, P2, _),                      // two entries
    nearer(D_run, P, P2).                                              // the nearer draws over the farther

above(Dot, Dot2, [Ds, Pn, $Occlusion()]) :-
    impl_choice([Ds, Pn, $Occlusion()]),
    periodic_dot(Dot2, P), !panel_cell(Dot2, P),                // a dot of the pattern Dot2 does not show
    panel(Dot, P, Ds, Pn), Dot != Dot2.                         // lies under Dot's panel

// --- output ---

.decl paint(dot: Color, p: Position, ink: Color, ds: Dots, pn: Panel)
paint(Dot, P, Ink, Ds, Pn) :-
    panel(Dot, P, Ds, Pn), legend(Dot, Fill, _, _),
    ( dotted(Dot, P, Ds), Ink = Dot                             // a dot of the panel
    ; !dotted(Dot, P, Ds), Ink = Fill                           // the fill around it
    ).

// Another panel draws over Dot's here.
.decl covered(p: Position, dot: Color, ch: Choice)
covered(P, Dot, [Ds, Pn, St]) :-
    impl_choice([Ds, Pn, St]),
    paint(Dot, P, _, Ds, Pn), paint(Dot2, P, _, Ds, Pn),
    above(Dot2, Dot, [Ds, Pn, St]).

out(P, Col, [Ds, Pn, St]) :-
    impl_choice([Ds, Pn, St]), in(P, _),
    ( paint(Dot, P, Col, Ds, Pn), !covered(P, Dot, [Ds, Pn, St])  // the top panel here
    ; !paint(_, P, _, Ds, Pn), params.bg(Col)                     // no panel: bg
    ).
