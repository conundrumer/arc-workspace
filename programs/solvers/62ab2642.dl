// 62ab2642
// @draft
// @keywords: objects count rank
// input: Ink lines cut the grid into blank regions.
// output: The region holding the most cells and the region holding the
//  fewest each take their own color, and the rest of the grid passes
//  through.
// review principle: Cases — Orth and Diag ship as two joins of the blank
//  cells, so re-judge whether both stand now that Fit, Fidelity, and
//  Equivalence are the only grounds for removing a case.

// what joins two blank cells into one region
.type Choice =
    // cardinal adjacency
    Orth {}
    // cardinal or diagonal adjacency
  | Diag {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl big_paint(col: Color) big_paint(8).
    .decl small_paint(col: Color) small_paint(7).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Orth()). impl_choice($Diag()).

// The blank regions under each join, and the extreme ones by cell count.
.comp Parse<Key> {
    .decl blank(key: Key, p: Position)  // input

    .decl region(key: Key, ch: Choice, p: Position, id: Ident)

    .type KeyedRegion = [key: Key, ch: Choice, id: Ident]
    .type KeyedChoice = [key: Key, ch: Choice]

    .init size = Tally<KeyedRegion, Position>
    size.item([Ky, Ch, Id], P) :- region(Ky, Ch, P, Id).

    .init extreme = ArgExtremes<KeyedChoice, Ident>
    extreme.cand([Ky, Ch], Id, N) :- size.tally([Ky, Ch, Id], N).

    .decl biggest(key: Key, ch: Choice, p: Position)
    biggest(Ky, Ch, P) :- extreme.high([Ky, Ch], Id, _), region(Ky, Ch, P, Id).

    .decl smallest(key: Key, ch: Choice, p: Position)
    smallest(Ky, Ch, P) :- extreme.low([Ky, Ch], Id, _), region(Ky, Ch, P, Id).

    // --- $Orth ---

    .init orth = Components<Key>
    orth.node(Ky, P) :- blank(Ky, P).
    region(Ky, $Orth(), P, Id) :- orth.label(Ky, P, Id).

    // --- $Diag ---

    .init diag = Components8<Key>
    diag.node(Ky, P) :- blank(Ky, P).
    region(Ky, $Diag(), P, Id) :- diag.label(Ky, P, Id).
}

.init parse = Parse<Unit>
parse.blank($U(), P) :- in(P, Col), params.bg(Col).

// --- output ---

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :- parse.biggest($U(), Ch, P), params.big_paint(Col).
paint(P, Col, Ch) :- parse.smallest($U(), Ch, P), params.small_paint(Col).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !paint(P, _, Ch).

.comp Determine {
    .decl bg(col: Color)
    bg(Col) :- ex_in(E, P, Col), ex_out(E, P, Col2), Col2 != Col.

    .init parse = Parse<Example>
    parse.blank(E, P) :- ex_in(E, P, Col), bg(Col).

    .decl big_paint(col: Color)
    big_paint(Col) :- parse.biggest(E, $Orth(), P), ex_out(E, P, Col).

    .decl small_paint(col: Color)
    small_paint(Col) :- parse.smallest(E, $Orth(), P), ex_out(E, P, Col).
}
