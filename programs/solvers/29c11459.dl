// 29c11459
// keywords: lines markers cast
// input: A mark sits at each end of a row.
// output: The row fills with the marks' colors, half each, and the middle
//  cell gets the clash color.

// which fill prior colors the row; every mark sits on its edge, so the
// three coincide on this data
.type Choice =
    // fronts advance in lockstep from the two marks toward each other; cells
    // behind a mark stay bg. Fronts landing on one cell clash there.
    Meet {}
    // the whole row splits by nearest mark; cells behind a mark are its
    // territory too. Equidistant cells clash.
  | Near {}
    // each mark fills the grid half it sits in; the centered cell clashes
  | Half {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl clash(c: Color) clash(5).

    .decl axis(a: Axis) axis(AXIS_H).
}

.init params = Params

.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

// Marks paired per row: m1 the mark nearer edge d, m2 its opponent.
.decl pair(d: Dir, m1: Position, c1: Color, m2: Position, c2: Color)
pair(D, M1, C1, M2, C2) :-
    mark(M1, C1), mark(M2, C2), params.axis(A), same_line(A, M1, M2),  // two marks on one row
    axis_of(D, A), nearer(D, M1, M2).                                  // m1 nearer d

// --- $Meet / $Near: lockstep fronts ---

// Both fronts advance one step toward each other while they stay ordered;
// landing on one cell is the clash.
.decl walk(d: Dir, p1: Position, c1: Color, p2: Position, c2: Color)
walk(D, M1, C1, M2, C2) :- pair(D, M1, C1, M2, C2).
walk(D, Q1, C1, Q2, C2) :-
    walk(D, P1, C1, P2, C2), P1 != P2,                          // fronts still apart
    opposite(D, O), neighbor(P1, O, Q1), neighbor(P2, D, Q2),   // advance both
    dist(Q1, D, Kq1), dist(Q2, D, Kq2), Kq1 <= Kq2.             // still ordered

.decl front(p: Position, col: Color)
front(P1, C1) :- walk(_, P1, C1, P2, _), P1 != P2.

.decl clash_cell(p: Position)
clash_cell(P) :- walk(_, P, _, P, _).

// --- $Meet ---

out(P, Col, $Meet()) :- front(P, Col).
out(P, Col, $Meet()) :- clash_cell(P), params.clash(Col).
out(P, Col, $Meet()) :- in(P, _), !front(P, _), !clash_cell(P), params.bg(Col).

// --- $Near ---

.init rays = Ray<Color>
rays.dir(Col, D)    :- pair(D, _, Col, _, _).
rays.cell(Col, P)   :- mark(_, Col), in(P, _).
rays.mark(Col, P)   :- mark(P, Col).

// Front cells, plus the cells behind the near mark.
.decl territory(p: Position, col: Color)
territory(P, Col) :- front(P, Col).
territory(P, Col) :- rays.ray(Col, P, _, _, _).

out(P, Col, $Near()) :- territory(P, Col).
out(P, Col, $Near()) :- clash_cell(P), params.clash(Col).
out(P, Col, $Near()) :- in(P, _), !territory(P, _), !clash_cell(P), params.bg(Col).

// --- $Half ---

// The half a row's mark sits in, per row.
.decl owner(across: Position, d: Dir, col: Color)
owner(Ac, D, Col) :-
    mark(M, Col), params.axis(A), split(M, A, _, Ac),    // mark's row
    axis_of(D, A), dist_pair(M, D, K1, K2), K1 < K2.     // its half

out(P, Col, $Half()) :-
    in(P, _), params.axis(A), split(P, A, _, Ac),                                // grid cell, its row
    ( owner(Ac, D, Col), dist_pair(P, D, K1, K2), K1 < K2                        // cell in an owner's half
    ; owner(Ac, _, _), axis_of(D, A), dist_pair(P, D, K, K), params.clash(Col)   // centered between owners
    ; !owner(Ac, _, _), params.bg(Col)                                           // markless row
    ).
