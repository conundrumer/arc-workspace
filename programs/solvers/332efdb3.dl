// 332efdb3
// @keywords: wallpaper lookup border
// output: the input's frame, filled with the wallpaper: a bg ground with a dot
//  every other cell on both axes, one cell in from the border

// which model reconstructs the wallpaper
.type Choice =
    // each axis splits into tiles with a gap between them; a cell on a tile
    // line of either axis is bg, and a cell on neither is the dot color
    Stripes {}
    // the stored motif seats at every corner and repeats by the lattice period
  | Motif {}
    // a border rings the dot field, and that field splits into tiles on both
    // axes at once; an interior tile cell is the dot color, the border and the
    // gaps are bg
  | Inset {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $Stripes, $Inset ---
    .decl bg(c: Color) bg(1).
    .decl dot(c: Color) dot(0).
    .decl tile_size(k: number) tile_size(1).
    .decl tile_gap(g: number) tile_gap(1).

    // --- $Motif ---
    .decl period(a: Axis, k: number)
    period(AXIS_V, 2). period(AXIS_H, 2).

    .decl motif(p: Position, c: Color)
    GRID_3x3(motif,
        1, 1, 1,
        1, 0, 1,
        1, 1, 1)

    // --- $Inset ---
    // The bg ring around the dot field.
    .decl border_width(k: number) border_width(1).
}

.init params = Params

// --- $Stripes ---
.decl on_tile(p: Position)
on_tile(P) :-
    in(P, _), axis_elem(A),
    params.tile_size(K), params.tile_gap(G),
    divide_by_size(P, A, K, G, _, _).                   // a tile cell of that axis, not a gap

out(P, Col, $Stripes()) :-
    in(P, _),
    ( on_tile(P), params.bg(Col)
    ; !on_tile(P), params.dot(Col)
    ).

// --- $Motif ---
// A cell's place in the lattice, seen from a corner: its distances to the
// corner's edges, each within its axis's period. The motif's own cells have
// one too.
.decl lattice_phase(dg: DiagDir, a: Axis, p: Position, r: number, r2: number)
lattice_phase(Dg, A, P, R, R2) :-
    ( in(P, _) ; params.motif(P, _) ),                       // a grid or motif cell
    diag_dist(P, Dg, A, T, T2), perp(A, A2),                 // its distances to a corner's edges
    params.period(A, K), stride(T, K, 0, _, R),              // within the periods
    params.period(A2, K2), stride(T2, K2, 0, _, R2).

// The motif seats at every corner, and each cell takes the motif cell at
// its place in the lattice.
out(Q, Col, $Motif()) :-
    params.motif(Pm, Col), lattice_phase(Dg, A, Pm, R, R2),
    in(Q, _), lattice_phase(Dg, A, Q, R, R2).

// --- $Inset ---
.decl interior_tile(p: Position)
interior_tile(P) :-
    in(P, _),
    params.border_width(K1), uniform_inset(K1, B), crop(P, B, P_inner),  // a cell of the interior frame
    params.tile_size(K), params.tile_gap(G),
    divide_by_size_2d(P_inner, K, G, _, _).                              // on a tile, not a gap

out(P, Col, $Inset()) :-
    in(P, _),
    ( interior_tile(P), params.dot(Col)
    ; !interior_tile(P), params.bg(Col)
    ).


.type Window = [e: Example, diag: DiagDir]

.comp Determine {
    .init si = OffsetInvariance<Example, Color>
    si.cell(E, P, Col) :- ex_out(E, P, Col).

    .init unbroken = Extremes<Axis>
    unbroken.cand(A, K) :- si.cand(_, A, K, _), !si.mismatch(_, A, K).

    // The lattice period on each axis: the smallest repeating shift.
    .decl period(a: Axis, k: number)
    period(A, K) :- unbroken.low(A, K).

    // The closed unit cell: cells within one period of a corner, boundary
    // included.
    .decl window(w: Window, q: Position)
    window([E, Dg], Q) :-
        ex_out(E, Q, _), diag_dir_elem(Dg),
        diag_dist(Q, Dg, A, K1, K2),
        period(A, S1), K1 <= S1,
        perp(A, A2), period(A2, S2), K2 <= S2.

    // Each window's cells in the motif's own frame.
    .init wframe = Bbox<Window>
    wframe.cell(W, Q) :- window(W, Q).

    .decl motif(p: Position, c: Color)
    motif(Pm, Col) :-
        window([E, Dg], Q), wframe.box([E, Dg], B), crop(Q, B, Pm),
        ex_out(E, Q, Col).

    // The dots span the interior frame, so their distance to a grid edge is
    // the border's width there.
    .init bbox = Bbox<Example>
    bbox.cell(E, P) :- ex_out(E, P, Col), params.dot(Col).

    .decl border_width(k: number)
    border_width(K) :- bbox.box(_, B), dir_elem(D), dist(B, D, K).
}
