// 332efdb3
// concept: wallpaper lookup border
// Wallpaper: bg ground with a regular grid of interior dots. Three
// divide-based models:
//
//   $Stripes() — divide_by_size on each axis with K=1, G=1. Cells on a
//                tile row or col → bg; cells on neither → dot.
//   $Motif()   — the stored 3×3 motif seats at each grid corner and
//                extends by the lattice generators params.period; overlapping
//                stamps agree on their shared rows/cols.
//   $Inset()   — the frame inside the border; divide_by_size_2d with K=1,
//                G=1 on that interior places tile cells at the dot
//                positions. Interior tile → dot, border and gap → bg.

#include "../lib.dl"

.type Choice = Stripes {} | Motif {} | Inset {}

.comp Params {
    .decl bg(c: Color) bg(1).
    .decl dot(c: Color) dot(0).

    // --- $Stripes / $Inset shared params ---
    .decl tile_size(k: number) tile_size(1).
    .decl tile_gap(g: number) tile_gap(1).

    // --- $Motif data ---
    // The wallpaper lattice's generators, every direction.
    .decl period(delta: Offset)
    period([2, -2, 0, 0]). period([-2, 2, 0, 0]).
    period([0, 0, 2, -2]). period([0, 0, -2, 2]).

    .decl motif(p: Position, c: Color)
    GRID_3x3(motif,
        1, 1, 1,
        1, 0, 1,
        1, 1, 1)

    // --- $Inset ---
    // The ring of bg around the dot field.
    .decl border_width(k: number) border_width(1).
}

.init params = Params

.decl out(p: Position, col: Color, c: Choice)

// --- $Stripes ---
.decl on_tile(p: Position)
on_tile(P) :-
    in(P, _),
    axis_elem(A),                                       // enumerate axes
    params.tile_size(K), params.tile_gap(G),
    divide_by_size(P, A, K, G, _, _).                   // axis tile cell

out(P, Col, $Stripes()) :-
    in(P, _),                                  // grid cell
    ( on_tile(P), params.bg(Col)               // on a stripe — bg
    ; !on_tile(P), params.dot(Col)             // off every stripe — the dot color
    ).

// --- $Motif ---
out(Q, Col, $Motif()) :-
    in(Q, _), params.motif(Pm, Col),
    diag_dir_elem(Dg), corner_anchor(Dg, Pm, Q).        // seated at each corner
out(Q2, Col, $Motif()) :-
    out(Q, Col, $Motif()),
    params.period(J), compose(Q, J, Q2), in(Q2, _).          // extended by the lattice

// --- $Inset ---
.init core = MarginFrame<Unit>
core.cell($U(), P) :- in(P, _).
core.width($U(), D, K) :- dir_elem(D), params.border_width(K).

.decl interior_tile(p: Position)
interior_tile(P) :-
    core.inner($U(), P, P_int),                     // a cell in the interior frame
    params.tile_size(K), params.tile_gap(G),
    divide_by_size_2d(P_int, K, G, _, _).               // tile cell in interior

out(P, Col, $Inset()) :-
    in(P, _),                                  // grid cell
    ( interior_tile(P), params.dot(Col)        // on an interior tile — the dot color
    ; !interior_tile(P), params.bg(Col)        // the border, or an interior gap — bg
    ).

.type Window = [e: Example, diag: DiagDir]

.comp Determine {
    .init si = OffsetInvariance<Example, Color>
    si.cell(E, P, Col) :- ex_out(E, P, Col).

    .init unbroken = Extremes<Axis>
    unbroken.cand(A, K) :- si.cand(_, A, K, _), !si.mismatch(_, A, K).

    // The lattice generators: the smallest repeating shift on each axis,
    // in each direction.
    .decl period(delta: Offset)
    period(Delta) :- si.cand(_, A, K, Delta), unbroken.low(A, K).

    .decl span(a: Axis, k: number)
    span(A, K) :- period(Delta), si.cand(_, A, K, Delta).

    // The closed unit cell: cells within one generator of a corner,
    // boundary included.
    .decl window(w: Window, q: Position)
    window([E, Dg], Q) :-
        ex_out(E, Q, _), diag_dir_elem(Dg),
        diag_dist(Q, Dg, A, K1, K2),
        span(A, S1), K1 <= S1,
        perp(A, A2), span(A2, S2), K2 <= S2.

    // Each window's cells in the motif's own frame.
    .init wframe = BoxFrame<Window>
    wframe.cell(W, Q) :- window(W, Q).

    .decl motif(p: Position, c: Color)
    motif(Pm, Col) :- wframe.inner([E, Dg], Q, Pm), ex_out(E, Q, Col).

    // The dots span the interior frame, so their distance to a grid edge is
    // the border's width there.
    .init box = Bbox<Example>
    box.cell(E, P) :- ex_out(E, P, Col), params.dot(Col).

    .decl border_width(k: number)
    border_width(K) :- box.edge_min(_, _, K).
}
