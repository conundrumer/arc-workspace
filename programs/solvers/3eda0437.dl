// 3eda0437
// @draft
// @keywords: count rank noise
// input: ink scattered on background, with hole boxes: rectangles of pure
//  background
// output: The hole box with the highest score is painted params.paint, and
//  every other cell is kept.

// the score that ranks hole boxes
.type Choice =
    // the cells the box holds, over the boxes that are regions. A box one
    // cell thick is a line, and a line is not a region
    Area {}
    // the squares of side params.block the box holds. A line holds none, so
    // this score needs no region test.
  | Block {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl paint(col: Color) paint(6).

    // --- $Block ---
    // The block's side.
    .decl block(k: number) block(2).
}

.init params = Params

.decl hole(p: Position)
hole(P) :- in(P, Col), params.bg(Col).

// Every box two holes span.
.type Corners = [p: Position, q: Position]

.init span = Bbox<Corners>
span.cell([P, Q], P) :- hole(P), hole(Q).
span.cell([P, Q], Q) :- hole(P), hole(Q).

.decl box(b: Box)
box(B) :- span.box(_, B).

.decl box_ink(b: Box)
box_ink(B) :- box(B), in(P, _), !hole(P), inside(P, B).

// A box of pure background, and the cells it holds.
.decl hole_box(b: Box)
hole_box(B) :- box(B), !box_ink(B).

.decl hole_cell(b: Box, p: Position)
hole_cell(B, P) :- hole_box(B), hole(P), inside(P, B).

// --- The box the score picks ---

.decl score(b: Box, n: number, ch: Choice)

.init best = ArgExtremes<Choice, Box>
best.cand(Ch, B, N) :- score(B, N, Ch).

.decl filled(p: Position, ch: Choice)
filled(P, Ch) :- best.high(Ch, B, _), hole_cell(B, P).

.decl impl_choice(ch: Choice)
impl_choice($Area()). impl_choice($Block()).

// --- $Area ---

// A box holding two cells a diagonal step apart is a region, not a line.
.decl region(b: Box)
region(B) :-
    hole_cell(B, P),                         // a cell of the box
    diag_dir_elem(D), neighbor(P, D, Q),     // and the cell across a corner
    hole_cell(B, Q).

.init size = Tally<Box, Position>
size.item(B, P) :- region(B), hole_cell(B, P).

score(B, N, $Area()) :- size.tally(B, N).

// --- $Block ---

// A hole box of side params.block.
.decl square(b: Box)
square(B) :-
    params.block(K), hole_box(B), span.box([P, _], B),
    perp(A, A2), box_extent(B, P, A, K), box_extent(B, P, A2, K).   // side K on both axes

// How many such squares a box holds.
.init seat = Tally<Box, Box>
seat.item(B, B_sq) :- hole_box(B), square(B_sq), inside(B_sq, B).

score(B, N, $Block()) :- seat.tally(B, N).

// --- Output ---

out(P, Col, Ch) :- filled(P, Ch), params.paint(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !filled(P, Ch).

