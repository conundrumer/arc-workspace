// 28a6681f
// @keywords: flood count rank
// @scene vessel: Walls of every other color hold a body of water.
// @rule settle: The water settles under gravity as the first open cells of
//  one fill order, as many as there are water cells. The water falls and
//  slides to the cup it reaches, a cup fills by level from its bottom, and
//  water that rises over a rim pours into the next cup, in the pour sense
//  first.

// One grid per open pour sense.
.type PourSense = [s: Sense]
.type OpenValue = [pour_sense: PourSense]

.decl out(p: Position, col: Color, v: OpenValue)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl water(col: Color) water(1).

    .decl gravity(d: Dir) gravity(DIR_B).

    // The sense the water pours in. The pairs fix neither, so both stay open.
    // @open
    .decl pour_sense(s: Sense)
    pour_sense(SENSE_CW).
    pour_sense(SENSE_CC).
}

.init params = Params

.decl lateral(d: Dir)
lateral(L) :- params.gravity(D), perp_dir(D, L).

.decl up(d: Dir)
up(U) :- params.gravity(D), opposite(D, U).

// The settled water of each grid, under each pour sense.
.comp Parse<Key> {
    // A cell under one pour sense.
    .type SenseCell = [k: Key, s: Sense, p: Position]
    .type KSense = [k: Key, s: Sense]
    .type KRow = [k: Key, y: Position]

    // A cup, the open cells at or below row y joined to one another, with
    // the cell r its water lands on.
    .type Entry = [y: Position, c: Ident, r: Position]

    .decl cell(k: Key, p: Position, col: Color)  // input

    // The pour senses to settle under.
    .decl sense(s: Sense)  // input

    // The direction the water pours in first, per sense.
    .decl pour(s: Sense, d: Dir)
    pour(S, L) :- sense(S), params.gravity(D), turn(S, D, L).

    .decl wall(k: Key, p: Position)
    wall(K, P) :- cell(K, P, Col), !params.bg(Col), !params.water(Col).

    .decl open(k: Key, p: Position)
    open(K, P) :- cell(K, P, _), !wall(K, P).

    .decl parcel(k: Key, p: Position)
    parcel(K, P) :- cell(K, P, Col), params.water(Col).

    // The row of each cell, axis-only.
    .decl row(k: Key, p: Position, y: Position)
    row(K, P, Y) :- cell(K, P, _), params.gravity(D), axis_of(D, A), split(P, A, Y, _).

    // The cell under p is open, so the water falls.
    .decl hangs(k: Key, p: Position)
    hangs(K, P) :- open(K, P), params.gravity(D), neighbor(P, D, Q), open(K, Q).

    // @claim settle
    .init run = Slide<Key>
    run.node(K, P) :- open(K, P).
    run.dir(K, L) :- open(K, _), lateral(L).

    // Along the open run from p toward d, some cell hangs.
    .decl drains(k: Key, p: Position, d: Dir)
    drains(K, P, L) :- lateral(L), run.run(K, P, L, Q), hangs(K, Q).

    // One step of falling water: down where it hangs, else along its line
    // toward a drain, the pour direction first.
    .decl step(k: Key, s: Sense, p: Position, q: Position)
    step(K, S, P, Q) :-
        sense(S), open(K, P),
        ( hangs(K, P), params.gravity(D), neighbor(P, D, Q)
        ; !hangs(K, P), pour(S, L), drains(K, P, L), neighbor(P, L, Q)
        ; !hangs(K, P), pour(S, L), !drains(K, P, L),
          opposite(L, L2), drains(K, P, L2), neighbor(P, L2, Q)
        ).

    // Footing below and no drain either way.
    .decl rest(k: Key, p: Position)
    rest(K, P) :- open(K, P), !hangs(K, P), !drains(K, P, _).

    // The cells whose water comes to rest at r, by the steps back from r.
    // @claim settle
    .init sink = GraphDistance<SenseCell, Position>
    sink.seed([K, S, R], R) :- sense(S), rest(K, R).
    sink.edge([K, S, R], Q, P) :- rest(K, R), step(K, S, P, Q).

    .decl lands(k: Key, s: Sense, p: Position, r: Position)
    lands(K, S, P, R) :- sink.distance([K, S, R], P, _).

    // The cell the water reaches first: the first place it rests, from
    // gravity's far edge, in the pour direction.
    // @claim settle
    .init lex = LexOrder<KSense>
    lex.axis([K, S], A) :- cell(K, _, _), sense(S), params.gravity(D), axis_of(D, A).
    lex.corner([K, S], Diag) :-
        cell(K, _, _), pour(S, L), params.gravity(D), diag_dirs(Diag, _, D, L).
    lex.cell([K, S], R) :- parcel(K, P), lands(K, S, P, R).

    // The cups of each row: the components of the open cells at or below it.
    // @claim settle
    .init cup = Components<KRow>
    cup.node([K, Y], P) :- row(K, _, Y), open(K, P), params.gravity(D), !nearer(D, Y, P).

    // Cup c at row yc lies in cup cp, one row up.
    .decl inner(k: Key, yc: Position, c: Ident, yp: Position, cp: Ident)
    inner(K, Yc, C, Yp, Cp) :-
        cup.label([K, Yc], P, C), up(U), neighbor(Yc, U, Yp),
        cup.label([K, Yp], P, Cp).

    // A cell of cup c's top row with open space above, where water pours in.
    .decl mouth(k: Key, y: Position, c: Ident, m: Position)
    mouth(K, Y, C, M) :-
        cup.label([K, Y], M, C), row(K, M, Y),
        up(U), neighbor(M, U, M2), open(K, M2).

    // Mouth m has another mouth of its cup nearer d.
    .decl shadowed(k: Key, y: Position, c: Ident, d: Dir, m: Position)
    shadowed(K, Y, C, L, M) :- mouth(K, Y, C, M), mouth(K, Y, C, M2), lateral(L), nearer(L, M2, M).

    // Cup c in cup cp, whose water lands at r outside c, lies toward d from r.
    // @ignore: common-subexpr — shadowed compares two mouths, and this a mouth with the landing
    .decl away(k: Key, yp: Position, cp: Ident, r: Position, yc: Position, c: Ident, d: Dir)
    away(K, Yp, Cp, R, Yc, C, L) :-
        inner(K, Yc, C, Yp, Cp), rest(K, R), cup.label([K, Yp], R, Cp), !cup.label([K, Yc], R, C),
        mouth(K, Yc, C, M), lateral(L), nearer(L, M, R).

    // Each cup the water fills, with the cell its water lands on: the inner
    // cup that holds the landing keeps it, and another inner cup takes the
    // water that pours in over its first mouth on the side of the landing.
    // @claim settle
    .init descent = GraphDistance<KSense, Entry>
    descent.seed([K, S], [Y, C, R]) :-
        lex.first([K, S], R), cup.label([K, Y], R, C), up(U), dist(Y, U, 0).
    descent.edge([K, S], [Yp, Cp, R], [Yc, C, R]) :-
        sense(S), rest(K, R), inner(K, Yc, C, Yp, Cp), cup.label([K, Yc], R, C).
    descent.edge([K, S], [Yp, Cp, R], [Yc, C, R2]) :-
        away(K, Yp, Cp, R, Yc, C, L), opposite(L, L2),
        mouth(K, Yc, C, M), !shadowed(K, Yc, C, L2, M), lands(K, S, M, R2).

    .decl entry(k: Key, s: Sense, y: Position, c: Ident, r: Position)
    entry(K, S, Y, C, R) :- descent.distance([K, S], [Y, C, R], _).

    // Of two inner cups of one cup, c1 fills first: it holds the landing, or
    // it lies in the pour direction from the landing and the other does not,
    // or both lie one way and c1 is nearer the landing.
    .decl first_cup(k: Key, s: Sense, y: Position, c1: Ident, c2: Ident)
    first_cup(K, S, Yc, C1, C2) :-
        entry(K, S, Yp, Cp, R), inner(K, Yc, C1, Yp, Cp), cup.label([K, Yc], R, C1),
        inner(K, Yc, C2, Yp, Cp), C1 != C2.
    first_cup(K, S, Yc, C1, C2) :-
        entry(K, S, Yp, Cp, R), away(K, Yp, Cp, R, Yc, C1, L1), away(K, Yp, Cp, R, Yc, C2, L2),
        ( pour(S, L1), !pour(S, L2)
        ; L1 = L2, C1 != C2, mouth(K, Yc, C1, M1), mouth(K, Yc, C2, M2), nearer(L1, M2, M1)
        ).

    // Cell q fills no later than cell p: q lies in p's cup at p's row, or in
    // a cup that fills before p's.
    .decl upto(k: Key, s: Sense, p: Position, q: Position)
    upto(K, S, P, Q) :-
        entry(K, S, Y, C, _), row(K, P, Y), cup.label([K, Y], P, C), cup.label([K, Y], Q, C).
    upto(K, S, P, Q) :-
        first_cup(K, S, Y, C1, C2), cup.label([K, Y], Q, C1), cup.label([K, Y], P, C2).

    // @claim settle
    .init filled = Tally<SenseCell, Position>
    filled.item([K, S, P], Q) :- upto(K, S, P, Q).

    // @claim settle
    .init amount = Tally<Key, Position>
    amount.item(K, P) :- parcel(K, P).
    amount.domain(K) :- cell(K, _, _).

    // The settled grid under each pour sense.
    .decl settled(k: Key, s: Sense, p: Position, col: Color)
    settled(K, S, P, Col) :-
        cell(K, P, C), sense(S),
        ( wall(K, P), Col = C                                              // a wall keeps its color
        ; filled.tally([K, S, P], N1), amount.tally(K, N), N1 <= N,        // within the water's amount
          params.water(Col)
        ; upto(K, S, P, Q), !upto(K, S, Q, P), filled.tally([K, S, Q], N1), // a cell before it fills the amount
          amount.tally(K, N), N1 >= N, params.bg(Col)
        ; open(K, P), !upto(K, S, P, P), params.bg(Col)                    // out of the water's reach
        ).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).
parse.sense(S) :- params.pour_sense(S).

out(P, Col, [[S]]) :- parse.settled($U(), S, P, Col).

.comp Determine {
    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).
    ex.sense(S) :- sense_elem(S).

    // A train output differs from the grid the sense settles.
    .decl contradicted(s: Sense)
    contradicted(S) :- ex_out(E, P, Col), ex.settled(E, S, P, Col2), Col != Col2.

    .decl pour_sense(s: Sense)
    pour_sense(S) :- sense_elem(S), !contradicted(S).
}
