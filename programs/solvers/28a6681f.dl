// 28a6681f
// @keywords: flood count rank
// @scene vessel: Walls of every other color hold a body of water.
// @rule settle: The water settles under gravity as the first open cells of
//  one fill order, as many as there are water cells. The water falls and
//  slides to the cup it reaches, a cup fills by level from its bottom, and
//  water that rises over a rim pours into the next cup. Undefined where the
//  sense the water pours in first changes the output.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl water(col: Color) water(1).

    .decl gravity(d: Dir) gravity(DIR_B).
}

.init params = Params

.decl lateral(d: Dir)
lateral(L) :- params.gravity(D), perp_dir(D, L).

.decl up(d: Dir)
up(U) :- params.gravity(D), opposite(D, U).

// The settled water under each sense the water could pour in first.

// A cell under one pour sense.
.type SenseCell = [s: Sense, p: Position]

// A cup, the open cells at or below row y joined to one another, with
// the cell r its water lands on.
.type Entry = [y: Position, c: Ident, r: Position]

// A level, cup c at row y, under one pour sense.
.type SenseLevel = [s: Sense, y: Position, c: Ident]

// The direction the water pours in first, per sense.
.decl pour(s: Sense, d: Dir)
pour(S, L) :- sense_elem(S), params.gravity(D), turn(S, D, L).

.decl wall(p: Position)
wall(P) :- in(P, Col), !params.bg(Col), !params.water(Col).

.decl open(p: Position)
open(P) :- in(P, _), !wall(P).

.decl parcel(p: Position)
parcel(P) :- in(P, Col), params.water(Col).

// The row of each cell, axis-only.
.decl row(p: Position, y: Position)
row(P, Y) :- in(P, _), params.gravity(D), axis_of(D, A), split(P, A, Y, _).

// The cell under p is open, so the water falls.
.decl hangs(p: Position)
hangs(P) :- open(P), params.gravity(D), neighbor(P, D, Q), open(Q).

// @claim settle
.init run = Slide<Unit>
run.node($U(), P) :- open(P).
run.dir($U(), L) :- open(_), lateral(L).

// Along the open run from p toward d, some cell hangs.
.decl drains(p: Position, d: Dir)
drains(P, L) :- lateral(L), run.run($U(), P, L, Q), hangs(Q).

// One step of falling water: down where it hangs, else along its line
// toward a drain, the pour direction first.
.decl step(s: Sense, p: Position, q: Position)
step(S, P, Q) :-
    sense_elem(S), open(P),
    ( hangs(P), params.gravity(D), neighbor(P, D, Q)
    ; !hangs(P), pour(S, L), drains(P, L), neighbor(P, L, Q)
    ; !hangs(P), pour(S, L), !drains(P, L),
      opposite(L, L2), drains(P, L2), neighbor(P, L2, Q)
    ).

// Footing below and no drain either way.
.decl rest(p: Position)
rest(P) :- open(P), !hangs(P), !drains(P, _).

// The cells whose water comes to rest at r, by the steps back from r.
// @claim settle
.init sink = GraphDistance<SenseCell, Position>
sink.seed([S, R], R) :- sense_elem(S), rest(R).
sink.edge([S, R], Q, P) :- rest(R), step(S, P, Q).

.decl lands(s: Sense, p: Position, r: Position)
lands(S, P, R) :- sink.distance([S, R], P, _).

// The cell the water reaches first: the first place it rests, from
// gravity's far edge, in the pour direction.
// @claim settle
.init lex = LexOrder<Sense>
lex.axis(S, A) :- in(_, _), sense_elem(S), params.gravity(D), axis_of(D, A).
lex.corner(S, Diag) :-
    in(_, _), pour(S, L), params.gravity(D), diag_dirs(Diag, _, D, L).
lex.cell(S, R) :- parcel(P), lands(S, P, R).

// The cups of each row: the components of the open cells at or below it.
// @claim settle
.init cup = Components<Position>
cup.node(Y, P) :- row(_, Y), open(P), params.gravity(D), !nearer(D, Y, P).

// Cup c at row yc lies in cup cp, one row up.
.decl inner(yc: Position, c: Ident, yp: Position, cp: Ident)
inner(Yc, C, Yp, Cp) :-
    cup.label(Yc, P, C), up(U), neighbor(Yc, U, Yp),
    cup.label(Yp, P, Cp).

// A cell of cup c's top row with open space above, where water pours in.
.decl mouth(y: Position, c: Ident, m: Position)
mouth(Y, C, M) :-
    cup.label(Y, M, C), row(M, Y),
    up(U), neighbor(M, U, M2), open(M2).

// Mouth m has another mouth of its cup nearer d.
.decl shadowed(y: Position, c: Ident, d: Dir, m: Position)
shadowed(Y, C, L, M) :- mouth(Y, C, M), mouth(Y, C, M2), lateral(L), nearer(L, M2, M).

// Cup c in cup cp, whose water lands at r outside c, lies toward d from r.
// @ignore: common-subexpr — shadowed compares two mouths, and this a mouth with the landing
.decl away(yp: Position, cp: Ident, r: Position, yc: Position, c: Ident, d: Dir)
away(Yp, Cp, R, Yc, C, L) :-
    inner(Yc, C, Yp, Cp), rest(R), cup.label(Yp, R, Cp), !cup.label(Yc, R, C),
    mouth(Yc, C, M), lateral(L), nearer(L, M, R).

// Each cup the water fills, with the cell its water lands on: the inner
// cup that holds the landing keeps it, and another inner cup takes the
// water that pours in over its first mouth on the side of the landing.
// @claim settle
.init descent = GraphDistance<Sense, Entry>
descent.seed(S, [Y, C, R]) :-
    lex.first(S, R), cup.label(Y, R, C), up(U), dist(Y, U, 0).
descent.edge(S, [Yp, Cp, R], [Yc, C, R]) :-
    sense_elem(S), rest(R), inner(Yc, C, Yp, Cp), cup.label(Yc, R, C).
descent.edge(S, [Yp, Cp, R], [Yc, C, R2]) :-
    away(Yp, Cp, R, Yc, C, L), opposite(L, L2),
    mouth(Yc, C, M), !shadowed(Yc, C, L2, M), lands(S, M, R2).

.decl entry(s: Sense, y: Position, c: Ident, r: Position)
entry(S, Y, C, R) :- descent.distance(S, [Y, C, R], _).

// Of two inner cups of one cup, c1 fills first: it holds the landing, or
// it lies in the pour direction from the landing and the other does not,
// or both lie one way and c1 is nearer the landing.
.decl first_cup(s: Sense, y: Position, c1: Ident, c2: Ident)
first_cup(S, Yc, C1, C2) :-
    entry(S, Yp, Cp, R), inner(Yc, C1, Yp, Cp), cup.label(Yc, R, C1),
    inner(Yc, C2, Yp, Cp), C1 != C2.
first_cup(S, Yc, C1, C2) :-
    entry(S, Yp, Cp, R), away(Yp, Cp, R, Yc, C1, L1), away(Yp, Cp, R, Yc, C2, L2),
    ( pour(S, L1), !pour(S, L2)
    ; L1 = L2, C1 != C2, mouth(Yc, C1, M1), mouth(Yc, C2, M2), nearer(L1, M2, M1)
    ).

// The cup of open cell p at p's own row; the cells of one level fill
// together.
.decl level(p: Position, y: Position, c: Ident)
level(P, Y, C) :- row(P, Y), cup.label(Y, P, C).

// Cell q fills no later than the cells of level c at row y: q lies in
// that cup, or in a cup that fills before a cup holding it.
.decl upto(s: Sense, y: Position, c: Ident, q: Position)
upto(S, Y, C, Q) :- entry(S, Y, C, _), level(_, Y, C), cup.label(Y, Q, C).
upto(S, Y, C, Q) :-
    first_cup(S, Yc, C1, C2), cup.label(Yc, Q, C1),
    cup.label(Yc, P, C2), level(P, Y, C).

// @claim settle
.init filled = Tally<SenseLevel, Position>
filled.item([S, Y, C], Q) :- upto(S, Y, C, Q).

// @claim settle
.init amount = Tally<Unit, Position>
amount.item($U(), P) :- parcel(P).
amount.domain($U()) :- in(_, _).

// The settled grid under each pour sense.
.decl settled(s: Sense, p: Position, col: Color)
settled(S, P, Col) :-
    in(P, C0), sense_elem(S),
    ( wall(P), Col = C0                                             // a wall keeps its color
    ; level(P, Y, C), filled.tally([S, Y, C], N1), amount.tally($U(), N), N1 <= N,
      params.water(Col)                                             // within the water's amount
    ; level(P, Y, C), upto(S, Y, C, Q), level(Q, Yq, Cq), !upto(S, Yq, Cq, P),
      filled.tally([S, Yq, Cq], N1), amount.tally($U(), N), N1 >= N,
      params.bg(Col)                                                // a cell before it fills the amount
    ; level(P, Y, C), !upto(S, Y, C, P), params.bg(Col)             // out of the water's reach
    ).

// Some cell the two senses settle differently.
.decl disputed()
disputed() :- settled(S1, P, Col1), settled(S2, P, Col2), S1 != S2, Col1 != Col2.

out(P, Col) :- settled(_, P, Col), !disputed().
