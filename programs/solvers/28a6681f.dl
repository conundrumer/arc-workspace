// 28a6681f
// concept: walk
// Walls of every other color hold a body of water, and the water settles
// under gravity, one cell at a time.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl water(col: Color) water(1).

    .decl gravity(d: Dir) gravity(DIR_B).
}

.init params = Params

.decl wall(p: Position)
wall(P) :- in(P, Col), !params.bg(Col), !params.water(Col).

.decl parcel(p: Position)
parcel(P) :- in(P, Col), params.water(Col).

.decl lateral(d: Dir)
lateral(L) :- params.gravity(D), perp_dir(D, L).

// The grid's adjacency — materialized, since the settling recursion reads a
// step per cell per turn.
.decl adj(p: Position, d: Dir, q: Position)
adj(P, D, Q) :- in(P, _), dir_elem(D), neighbor(P, D, Q), in(Q, _).

// Whose turn it is: lexicographic order from gravity's far edge, so a parcel
// never takes a source still to come — it rests on its own source cell or
// below it. Along a line either end may pour first, and the two orders can
// settle differently; the task privileges neither, so both run, keyed by
// sense.
.init lex = LexOrder<Sense>
lex.axis(S, A) :- sense_elem(S), params.gravity(D), axis_of(D, A).
lex.corner(S, Diag) :-
    params.gravity(D), turn(S, D, L), diag_dirs(Diag, _, D, L).
lex.cell(S, P) :- sense_elem(S), parcel(P).

// The state a turn opens on: the cells its parcel may still enter (untaken)
// and the cells that stop it (taken).
.init state = Take<Sense, Position, Position>
state.start(S, T) :- lex.first(S, T).
state.step(S, T, T2) :- lex.next(S, T, T2).
state.take(S, T, P) :- rest(S, T, P).
state.init_taken(S, P) :- sense_elem(S), wall(P).
state.init_untaken(S, P) :- sense_elem(S), in(P, _), !wall(P).

// What an untaken cell has under it: open space to fall through, or footing.
.decl hangs(s: Sense, t: Position, p: Position)
hangs(S, T, P) :-
    state.untaken(S, T, P), params.gravity(D), adj(P, D, Q), state.untaken(S, T, Q).

.decl stands(s: Sense, t: Position, p: Position)
stands(S, T, P) :-
    state.untaken(S, T, P), params.gravity(D),
    ( adj(P, D, Q), state.taken(S, T, Q)   // footing on a taken cell
    ; dist(P, D, 0)                        // footing on the grid's edge
    ).

// Beyond p toward d, along the untaken run: some cell hangs.
.decl drain(s: Sense, t: Position, p: Position, d: Dir)
drain(S, T, P, L) :-
    state.untaken(S, T, P), lateral(L), adj(P, L, Q),
    ( hangs(S, T, Q)
    ; drain(S, T, Q, L)
    ).

// Beyond p toward d: the run ends, or every cell of it stands. The
// complement of drain, derived forward.
.decl held(s: Sense, t: Position, p: Position, d: Dir)
held(S, T, P, L) :-
    state.untaken(S, T, P), lateral(L),
    ( adj(P, L, Q), state.taken(S, T, Q)               // the run ends at a taken cell
    ; dist(P, L, 0)                                    // the run ends at the grid's edge
    ; adj(P, L, Q), stands(S, T, Q), held(S, T, Q, L)  // the run holds on
    ).

// The turn's parcel, cell by cell along its path.
.decl path(s: Sense, t: Position, p: Position)
path(S, T, T) :- sense_elem(S), parcel(T).
path(S, T, Q) :-
    path(S, T, P), adj(P, D, Q),
    ( hangs(S, T, P), params.gravity(D)   // falls into the open cell below
    ; stands(S, T, P), drain(S, T, P, D)  // or steps along its line toward one
    ).

// Where it comes to rest: standing, and confined both ways.
.decl rest(s: Sense, t: Position, p: Position)
rest(S, T, P) :-
    path(S, T, P), stands(S, T, P),
    held(S, T, P, L1), opposite(L1, L2), held(S, T, P, L2).

// One grid per pour order; a cell the orders settle differently gets both.
.decl out(p: Position, col: Color)
out(P, Col) :-
    in(P, C), sense_elem(S),
    ( wall(P), Col = C                            // a wall keeps its color
    ; rest(S, _, P), params.water(Col)            // settled water
    ; !wall(P), !rest(S, _, P), params.bg(Col)    // everywhere else
    ).
