// f9d67f8b
// @draft
// @keywords: symmetry repair occlude latent-canvas
// @scene mirror-picture: the grid is cut from a square canvas whose picture is mirror symmetric left to right and top to bottom; the grid's margins within the canvas are `canvas_margin` ([0, 2, 0, 2]: the canvas extends two lines past the bottom and the right edge), and every cell whose canvas mirror image lies in the grid holds that image's color, where neither cell is covered
// @scene tiled-picture: the canvas cuts into `tile_count` × `tile_count` tiles, and `tile_sym` gives each tile the group of canvas mirrors and turns that holds on its cells: the mirrors across the canvas's center lines in every tile, and also its two diagonals in each tile with one coordinate in the band of rows and columns 8–23 and the other outside it
// @scene covering-blocks: some solid rectangles of `mask_color` lie over the picture, and the picture itself holds no `mask_color`
// @scene mask-recoverable: each covered cell has an image, under a member of its tile's group, that is in the grid and not covered
// @rule uncovered-kept: each cell not of `mask_color` keeps its color
// @rule restore: each covered cell takes the color of its images, under the members of its tile's group, that are in the grid and not covered

// Which images restore a covered cell.
.type Restore =
    // @claim tiled-picture
    TileGroups {}
    // @scene tiled-picture: no tiles; the picture holds the mirrors across the canvas's center lines everywhere, and its diagonals and quarter turns where they serve
    // @rule restore: a covered cell takes the color that its row-mirror, column-mirror and half-turn images share, of those that are in the grid and not covered; where it has none, the color that its images under the other transforms share, of those visible
    // @witness full-orbit-cover: borderline other
    //     @relaxed mask-recoverable
  | DiagonalFallback {}

// Where the canvas, and so the mirror center, comes from.
.type Center =
    // @claim mirror-picture
    StoredCenter {}
    // @scene mirror-picture: the canvas margin on each axis is the one margin at which the uncovered cells are mirror symmetric; undefined where no margin or more than one qualifies
    // @witness shifted-center: variant $DerivedCenter
    //     @relaxed mirror-picture
  | DerivedCenter {}

.type Choice = [r: Restore, ce: Center]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mask_color(c: Color) mask_color(9).

    // --- $TileGroups ---
    // Per tile of the canvas, the subgroup of canvas transforms holding on its cells.
    .decl tile_sym(p_tile: Position, s: Sym)
    GRID_4x4(tile_sym,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_D4,  SYM_BOX, SYM_BOX, SYM_D4,
        SYM_BOX, SYM_D4,  SYM_D4,  SYM_BOX)

    // The tiles along each axis.
    .decl tile_count(n: number)
    tile_count(N) :- tile_sym(T, _), axis_elem(A), axis_dim(T, A, N).

    // --- $StoredCenter ---
    // The grid's margins within the canvas.
    .decl canvas_margin(b: Box) canvas_margin([0, 2, 0, 2]).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice([R, Ce]) :- restore_choice(R), center_choice(Ce).

.decl restore_choice(r: Restore)
restore_choice($TileGroups()). restore_choice($DiagonalFallback()).

.decl center_choice(ce: Center)
center_choice($StoredCenter()). center_choice($DerivedCenter()).

.decl visible(p: Position, col: Color)
visible(P, Col) :- in(P, Col), !params.mask_color(Col).

// The canvas margins on each axis at which the visible cells are mirror
// symmetric.
.comp Parse<Key> {
    .decl grid(key: Key, p: Position)  // @input
    .decl visible(key: Key, p: Position, col: Color)  // @input

    // The axis positions of the grid.
    .decl apos(key: Key, a: Axis, along: Position)
    apos(Ky, A, Along) :- grid(Ky, P), axis_elem(A), split(P, A, Along, _).

    .decl cell_split(key: Key, a: Axis, along: Position, across: Position, col: Color)
    cell_split(Ky, A, Along, Across, Col) :-
        visible(Ky, P, Col), axis_elem(A), split(P, A, Along, Across).

    // Candidate canvas margins on each axis: k lines past one edge, k short
    // of the axis extent.
    .decl ext_cand(key: Key, a: Axis, b: Box)
    ext_cand(Ky, A, B) :- apos(Ky, A, Along), axis_of(D, A), dist(Along, D, K), edge_inset(D, K, B).

    // The candidate's mirror, as a map on axis positions.
    .decl ext_map(key: Key, a: Axis, b: Box, along: Position, along2: Position)
    ext_map(Ky, A, B, L, L2) :-
        ext_cand(Ky, A, B), apos(Ky, A, L), flip_of(A, F),
        compose(L, B, Lc), apply(F, Lc, L_img),        // mirror image in the canvas
        apos(Ky, A, L2), compose(L2, B, L_img).        // back in the grid

    // The candidate's mirror maps two visible cells to different colors.
    .decl mismatch(key: Key, a: Axis, b: Box)
    mismatch(Ky, A, B) :-
        ext_map(Ky, A, B, L1, L2),
        cell_split(Ky, A, L1, X, C1), cell_split(Ky, A, L2, X, C2), C2 != C1.

    // The candidate's mirror relates two distinct visible cells.
    .decl paired(key: Key, a: Axis, b: Box)
    paired(Ky, A, B) :-
        ext_map(Ky, A, B, L1, L2), L1 != L2,
        cell_split(Ky, A, L1, X, _), cell_split(Ky, A, L2, X, _).

    .decl symmetric(key: Key, a: Axis, b: Box)
    symmetric(Ky, A, B) :- paired(Ky, A, B), !mismatch(Ky, A, B).
}

.init parse = Parse<Unit>
parse.grid($U(), P) :- in(P, _).
parse.visible($U(), P, Col) :- visible(P, Col).

// The grid's margins within the canvas, per case.
.decl margin(ce: Center, b: Box)

// Each grid cell's position in the canvas.
.decl canvas(ce: Center, p_grid: Position, p_canvas: Position)
canvas(Ce, P_grid, P_canvas) :- in(P_grid, _), margin(Ce, B), compose(P_grid, B, P_canvas).

// A covered cell's visible image under the canvas transform d.
.decl image(ce: Center, p: Position, d: D4, col: Color)
image(Ce, P, D, Col) :-
    in(P, M), params.mask_color(M),                        // covered cell
    canvas(Ce, P, Pc), d4_elem(D), apply(D, Pc, Qc),
    canvas(Ce, Q, Qc), visible(Q, Col).

out(P, Col, Ch) :- impl_choice(Ch), visible(P, Col).

// --- $TileGroups ---
out(P, Col, [$TileGroups(), Ce]) :-
    image(Ce, P, D, Col), canvas(Ce, P, Pc),
    params.tile_count(N), divide_2d(Pc, N, 0, T, _),       // its tile
    params.tile_sym(T, S), sym_member(S, D).               // a transform holding there

// --- $DiagonalFallback ---
// The group the two axis flips generate: the flips, the half turn, the identity.
.decl mirror(d: D4)
mirror(D) :- flip_of(_, D).
mirror(D) :- flip_of(_, F1), flip_of(_, F2), d4_compose(F1, F2, D).

// The covered cell has a visible mirror image.
.decl has_mirror(ce: Center, p: Position)
has_mirror(Ce, P) :- image(Ce, P, D, _), mirror(D).

out(P, Col, [$DiagonalFallback(), Ce]) :- image(Ce, P, D, Col), mirror(D).
out(P, Col, [$DiagonalFallback(), Ce]) :- image(Ce, P, _, Col), !has_mirror(Ce, P).      // the other coset

// --- $StoredCenter ---
margin($StoredCenter(), B) :- params.canvas_margin(B).

// --- $DerivedCenter ---
// @claim mirror-picture
.init axis_margin = Unanimous<Axis, Box>
axis_margin.item(A, B) :- parse.symmetric($U(), A, B).

margin($DerivedCenter(), B) :-
    axis_margin.value(A1, B1), perp(A1, A2), axis_margin.value(A2, B2), compose(B1, B2, B).

.comp Determine {
    // The color the outputs change.
    .decl mask_color(c: Color)
    mask_color(Col) :- ex_in(E, P, Col), ex_out(E, P, Col2), Col2 != Col.

    // The train outputs, whose pictures are whole.
    .init parse = Parse<Example>
    parse.grid(E, P) :- ex_out(E, P, _).
    parse.visible(E, P, Col) :- ex_out(E, P, Col).

    // A margin some output breaks, or one an output's grid does not offer.
    .decl broken(a: Axis, b: Box)
    broken(A, B) :- parse.mismatch(_, A, B).
    broken(A, B) :- parse.ext_cand(_, A, B), ex_out(E, _, _), !parse.ext_cand(E, A, B).

    .decl axis_margin(a: Axis, b: Box)
    axis_margin(A, B) :- parse.paired(_, A, B), !broken(A, B).

    .decl canvas_margin(b: Box)
    canvas_margin(B) :-
        axis_margin(A1, B1), perp(A1, A2), axis_margin(A2, B2), compose(B1, B2, B).

    // The cells of the train outputs, in the canvas.
    .decl canvas_cell(e: Example, p: Position, col: Color)
    canvas_cell(E, Pc, Col) :- ex_out(E, P, Col), canvas_margin(B), compose(P, B, Pc).

    // A transform takes the canvas cell onto a cell of another color.
    // @ignore: comp-idiom — a tile's group needs the cell a transform breaks at, which D4Map.conflict leaves out
    .decl broken_at(p: Position, d: D4)
    broken_at(P, D) :-
        canvas_cell(E, P, Col), d4_elem(D), apply(D, P, Q),
        canvas_cell(E, Q, Col2), Col2 != Col.

    // Canvas cell to tile, at every candidate tile count.
    .decl cand_count(n: number)
    cand_count(N) :- canvas_cell(_, P, _), axis_elem(A), sub_extent(P, A, N).

    .decl cand_tile(n: number, p: Position, p_tile: Position)
    cand_tile(N, P, T) :- canvas_cell(_, P, _), cand_count(N), divide_2d(P, N, 0, T, _).

    // The transforms a candidate's tile breaks, and the ones it holds.
    .decl cand_broken(n: number, p_tile: Position, d: D4)
    cand_broken(N, T, D) :- cand_tile(N, P, T), broken_at(P, D).

    .decl cand_sym(n: number, p_tile: Position, d: D4)
    cand_sym(N, T, D) :- cand_tile(N, _, T), d4_elem(D), !cand_broken(N, T, D).

    // The tile count is the coarsest decomposition whose tiles hold different groups.
    .init nonuniform = Extremes<Unit>
    nonuniform.cand($U(), N) :- cand_sym(N, T1, D), cand_tile(N, _, T2), !cand_sym(N, T2, D).

    // Each tile's group is the named subgroup that equals its unbroken set.
    .init symid = KeyedSetCompare<Position, Sym, D4>
    symid.pattern_member(S, D) :- sym_member(S, D).
    symid.observed_member(T, D) :- nonuniform.low($U(), N), cand_sym(N, T, D).

    .decl tile_sym(p_tile: Position, s: Sym)
    tile_sym(T, S) :- symid.equals(T, S).
}
