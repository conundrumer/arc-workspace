// 2ba387bc
// draft
// keywords: objects classify rank
// input: equal squares, each a hollow ring or a solid block, scattered
//  over the grid
// output: the squares arrange in two columns: hollow squares at
//  params.hole_side, solid ones opposite, each column stacked in reading order
//  from params.corner and padded with background to the taller column's height.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The column hollow squares stack in; solid squares take the other one.
    .decl hole_side(d: Dir) hole_side(DIR_L).

    // The corner reading order runs from.
    .decl corner(d: DiagDir) corner(DIAG_TL).

    // The side of one square, and so of one output tile.
    .decl tile_dim(n: number) tile_dim(4).
}

.init params = Params

// --- squares ---

.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl square(id: Ident, p: Position, col: Color)
square(Id, P, Col) :- comps.label(Col, P, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- square(Id, P, _).

// The box covers a cell the square does not.
.decl hollow(id: Ident)
hollow(Id) :- in(P, _), bbox.box(Id, B), inside(P, B), !square(Id, P, _).

// --- columns ---

// The two columns sit on the axis their edges name; squares stack across it.
.decl class_axis(a: Axis)
class_axis(A) :- params.hole_side(D), axis_of(D, A).

.decl order_axis(a: Axis)
order_axis(A2) :- class_axis(A), perp(A, A2).

// The class column a square stacks in, named by the edge that column touches.
.decl stack(id: Ident, d: Dir)
stack(Id, D) :-
    square(Id, _, _), params.hole_side(D0),
    ( hollow(Id), D = D0
    ; !hollow(Id), opposite(D0, D)
    ).

// Each square compares as its box.
.init order = LexOrder<Dir>
order.corner(D_stack, Diag) :- order.cell(D_stack, _), params.corner(Diag).
order.axis(D_stack, A) :- order.cell(D_stack, _), order_axis(A).
order.cell(D, B) :- stack(Id, D), bbox.box(Id, B).

.init height = Tally<Dir, Ident>
height.item(D, Id) :- stack(Id, D).

.init tallest = Extremes<Unit>
tallest.cand($U(), N) :- height.tally(_, N).

// --- output ---

// One column per class, the classes being the two edges of the class axis.
.init class_count = Tally<Axis, Dir>
class_count.item(A, D) :- axis_of(D, A).

.init tiles = Frame2D<Unit>
tiles.extent($U(), A, N) :- order_axis(A), tallest.high($U(), N).
tiles.extent($U(), A, N) :- class_axis(A), class_count.tally(A, N).

.init cells = Frame2D<Unit>
cells.extent($U(), A, N) :- axis_elem(A), params.tile_dim(N).

.decl square_tile(id: Ident, p_tile: Position)
square_tile(Id, P_tile) :-
    stack(Id, D), bbox.box(Id, B),
    order.rank(D, B, R),                             // its place in that column
    tiles.cell($U(), P_tile), dist(P_tile, D, 0),    // the column's tiles
    params.corner(Cn), order_axis(A),
    dir_of(Cn, A, D_ord), dist(P_tile, D_ord, R).    // rank counts from the corner

.decl tile_cell(p_tile: Position, p_intile: Position, col: Color)
tile_cell(P_tile, P_intile, Col) :-
    square_tile(Id, P_tile), square(Id, P, Col),
    bbox.box(Id, B), crop(P, B, P_intile).

out(P_grid, Col) :-
    tiles.cell($U(), P_tile), cells.cell($U(), P_intile),
    concat_2d(P_tile, P_intile, 0, P_grid),
    ( tile_cell(P_tile, P_intile, Col)                    // square cell
    ; !tile_cell(P_tile, P_intile, _), params.bg(Col)     // ring hole or empty tile
    ).
