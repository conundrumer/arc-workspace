// c59eb873
// family: 60c09cac
// Layout: 2× scale.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl intile(p: Position)
    intile(P) :- helpers.frame_pos([2, 2], P).
}

.init c = Consts

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_tile, Col),                                  // input cell as tile pos
    c.intile(P_intile),                               // intile pos (2×2 frame)
    concat_2d(P_tile, P_intile, 0, P_grid_out).       // 2D recompose
