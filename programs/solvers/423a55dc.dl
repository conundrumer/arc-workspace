// 423a55dc
// keywords: move
// input: One shape sits on params.bg.
// output: The shape is sheared: each ink cell slides by its distance from
//  the shape box's params.anchor edge, toward params.anchor turned
//  params.sense. Cells sliding off the grid clip away.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl anchor(d: Dir) anchor(DIR_B).     // edge whose row stays seated
    .decl sense(s: Sense) sense(SENSE_CW).  // turn from anchor to the slide dir
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- ink(P, _).

.decl sheared(p: Position, p2: Position)
sheared(P, P2) :-
    ink(P, _), bbox.box($U(), B), crop(P, B, P_inner),   // cell in the box frame
    params.anchor(D_anc), dist(P_inner, D_anc, K),       // distance from the anchor edge
    params.sense(S), turn(S, D_anc, D_sh),               // slide dir: anchor turned by sense
    jump(P, D_sh, K, P2), in(P2, _).                     // slide; clip off-grid

out(P2, Col) :- sheared(P, P2), ink(P, Col).
out(P, Bg)   :- in(P, _), params.bg(Bg), !sheared(_, P).
