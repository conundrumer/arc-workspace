// 2a28add5
// @keywords: lines markers move select
// input: Each line holds a marker cell.
// output: The line packs its ink against the marker: the marker stays put,
//  each side's ink slides inward, order kept, and packed cells draw in
//  params.fill. Everything else clears to bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(7).
    .decl marker(c: Color) marker(6).
    .decl fill(c: Color) fill(8).
    .decl axis(a: Axis) axis(AXIS_H).
}

.init params = Params

// Line-keyed marker and ink cells; across names the line.
.decl marker_at(p_across: Position, m: Position)
marker_at(Across, M) :-
    in(M, Col), params.marker(Col),
    params.axis(A), split(M, A, _, Across).

.decl ink_at(p_across: Position, p: Position)
ink_at(Across, P) :-
    in(P, Col), !params.bg(Col),
    params.axis(A), split(P, A, _, Across).

// Each ink cell travels toward its line's marker and stops against the marker
// or against the ink already packed ahead of it. A cell meets no cell of
// another line, so the cells of every line that head one way fall together.
.init pack = Gravity<Dir, Position>
pack.dir(D, D) :- params.axis(A), axis_of(D, A).
pack.cell(D, P, P) :- ink_at(Across, P), marker_at(Across, M), nearer(D, M, P).
pack.blocked(D, M) :- marker_at(_, M), params.axis(A), axis_of(D, A).

// The marker stays put; the ink packs against it.
.decl packed(p: Position)
packed(M) :- marker_at(_, M).
packed(Q) :- pack.travel(_, P, V), compose(P, V, Q).

out(P, Col) :- packed(P), params.fill(Col).
out(P, Col) :- in(P, _), !packed(P), params.bg(Col).
