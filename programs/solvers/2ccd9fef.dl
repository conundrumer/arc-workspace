// 2ccd9fef
// @draft
// @keywords: decompose crop objects bbox move mapping induce
// @scene panel-strip: the input is a row or a column of equal panels laid end
//  to end with no divider, and every panel shows one frame drawing.
// @scene blank-panel: one panel shows the frame alone. It is the panel of
//  fewest colors, in the split into equal panels under which that panel
//  leaves the fewest cells of the other panels unexplained, and it lies at
//  one end of the strip.
// @scene stages: every other panel holds a stage: figures, each a 4-connected
//  group of the cells that differ from the frame.
// @rule stage-order: the stages run along the strip toward the blank panel,
//  which holds the stage after the last one.
// @rule track: a figure continues the figure of the next stage that shares a
//  cell with it, and its step is the change of its box's margins from one
//  stage to the next, the same at every stage, and none across the growth
//  axis, the axis across the strip.
// @rule next-stage: each stage with the stage after it is a demonstration.
//  The rules of the catalog that every demonstration confirms each draw the
//  stage after the last one in the blank panel, over the frame.

// The stage after the last one, as each confirmed rule draws it.
.decl out(p: Position, col: Color, r: DemonstratedChoice)

.comp Params {}

.init params = Params

// A candidate split: n equal panels along axis a.
.decl cand_tile(a: Axis, n: number, p: Position, pan: Position, p_intile: Position)
cand_tile(A, N, P, Pan, P_intile) :-
    in(P, _), axis_elem(A), sub_extent(P, A, N), divide_slab(P, A, N, 0, Pan, P_intile).

.type Split = [a: Axis, n: number]
.type Panel = [a: Axis, n: number, pan: Position]

// The colors a candidate's panel holds.
// @claim blank-panel
.init palette = Tally<Panel, Color>
palette.item([A, N, Pan], Col) :- cand_tile(A, N, P, Pan, _), in(P, Col).

// The candidate's frame: its plainest panel.
// @claim blank-panel
.init plainest = ArgExtremes<Split, Position>
plainest.cand([A, N], Pan, S) :- palette.tally([A, N, Pan], S).

.decl cand_tpl_pan(a: Axis, n: number, pan: Position)
cand_tpl_pan(A, N, Pan) :- plainest.low([A, N], Pan, _).

.decl cand_tpl(a: Axis, n: number, p_intile: Position, col: Color)
cand_tpl(A, N, P_intile, Col) :-
    cand_tile(A, N, P, Pan, P_intile), in(P, Col), cand_tpl_pan(A, N, Pan).

// @claim blank-panel
.init miss = Tally<Split, Position>
// A cell the candidate's frame does not explain.
miss.item([A, N], P) :-
    cand_tile(A, N, P, _, P_intile), in(P, Col),
    cand_tpl(A, N, P_intile, Col2), Col != Col2.
// A split worth weighing leaves room for a panel other than the frame.
miss.domain([A, N]) :-
    cand_tile(A, N, _, P_tile, _), cand_tpl_pan(A, N, Pan), P_tile != Pan.

// The split its frame explains best.
// @claim blank-panel
.init fewest = ArgExtremes<Unit, Split>
fewest.cand($U(), [A, N], S) :- miss.tally([A, N], S).

.decl tpl_layout(a: Axis, n: number)
tpl_layout(A, N) :- fewest.low($U(), [A, N], _).

.decl tile(p: Position, p_tile: Position, p_intile: Position)
tile(P, P_tile, P_intile) :- tpl_layout(A, N), cand_tile(A, N, P, P_tile, P_intile).

// The blank panel and its frame.
.decl tpl_pan(pan: Position)
tpl_pan(Pan) :- tpl_layout(A, N), cand_tpl_pan(A, N, Pan).

.decl tpl(p_intile: Position, col: Color)
tpl(P_intile, Col) :- tpl_layout(A, N), cand_tpl(A, N, P_intile, Col).

// Time runs toward the blank panel, at the end of the strip.
.decl time_dir(d: Dir)
time_dir(D) :- tpl_layout(A, _), axis_of(D, A), tpl_pan(Pan), dist(Pan, D, 0).

.decl growth_axis(g: Axis)
growth_axis(G) :- tpl_layout(A, _), perp(A, G).

.decl stage_panel(pan: Position)
stage_panel(Pan) :- tile(_, Pan, _), !tpl_pan(Pan).

.decl stage_cell(pan: Position, p_intile: Position, col: Color)
stage_cell(Pan, P_intile, Col) :- stage_panel(Pan), tile(P, Pan, P_intile), in(P, Col).

// A stage cell that differs from the frame.
.decl content(pan: Position, p: Position, col: Color)
content(Pan, P_intile, Col) :- stage_cell(Pan, P_intile, Col), tpl(P_intile, Col2), Col != Col2.

.decl succ_stage(pan: Position, pan2: Position)
succ_stage(Pan, Pan2) :-
    stage_panel(Pan), time_dir(D), neighbor(Pan, D, Pan2), stage_panel(Pan2).

// @claim stages
.init figure = Components<Position>
figure.node(Pan, P) :- content(Pan, P, _).

.type StageFig = [pan: Position, f: Ident]

.decl fig_cell(pan: Position, f: Ident, p: Position, col: Color)
fig_cell(Pan, F, P, Col) :- figure.label(Pan, P, F), content(Pan, P, Col).

// @claim track
.init fbox = Bbox<StageFig>
fbox.cell([Pan, F], P) :- figure.label(Pan, P, F).

// Figures of consecutive stages that share a cell.
.decl succ_fig(pan: Position, f: Ident, pan2: Position, f2: Ident)
succ_fig(Pan, F, Pan2, F2) :-
    succ_stage(Pan, Pan2), figure.label(Pan, P, F), figure.label(Pan2, P, F2).

// Each figure of the first stage followed from stage to stage.
.init lineage = Propagation<StageFig, StageFig>
lineage.source([Pan, F], [Pan, F]) :-
    figure.label(Pan, _, F), !succ_stage(_, Pan).
lineage.edge(Root, [Pan, F], [Pan2, F2]) :-
    lineage.source(Root, _), succ_fig(Pan, F, Pan2, F2).

// The figure's step over the stages.
// @claim track
.init step = Unanimous<StageFig, Box>
step.item(Root, V) :-
    lineage.reached(Root, [Pan, F]), succ_fig(Pan, F, Pan2, F2),
    fbox.box([Pan, F], B), fbox.box([Pan2, F2], B2), relative(B, B2, V).

// A stage's figure with its box and the box its step gives it in the next
// stage.
.decl fig_box(pan: Position, f: Ident, b: Box, b2: Box, v: Box)
fig_box(Pan, F, B, B2, V) :-
    lineage.reached(Root, [Pan, F]), step.value(Root, V),
    growth_axis(G), split(V, G, _, ZERO),                   // nothing moves across the growth axis
    fbox.box([Pan, F], B), compose(B, V, B2).

// The figure's end at side d moves outward.
.decl outward(pan: Position, f: Ident, d: Dir)
outward(Pan, F, D) :-
    fig_box(Pan, F, _, _, V), growth_axis(G), axis_of(D, G), dist(V, D, M), M < 0.

// The translation that takes the figure's end at side d to its place in the
// next stage.
.decl end_shift(pan: Position, f: Ident, d: Dir, t: Offset)
end_shift(Pan, F, D, T) :-
    fig_box(Pan, F, B, B2, _), growth_axis(G), dir_of(Dg, G, D),
    tpl(P, _), box_corner(P, B, Dg), tpl(Q, _), box_corner(Q, B2, Dg), relative(P, Q, T).

// A cell of the figure's next box outside its box.
.decl gained(pan: Position, f: Ident, q: Position)
gained(Pan, F, Q) :- fig_box(Pan, F, B, B2, _), tpl(Q, _), inside(Q, B2), !inside(Q, B).

// The figure travels with its end at side d, and the cells it gains past its
// other end repeat the line at that other end.
.decl travel(pan: Position, f: Ident, d: Dir, q: Position, col: Color)
travel(Pan, F, D, Q, Col) :-
    end_shift(Pan, F, D, T),
    ( fig_cell(Pan, F, P, Col), compose(P, T, Q)            // a cell carried
    ; fig_box(Pan, F, B, B2, _), compose(B, T, B_t),        // a cell gained past the other end
      tpl(Q, _), inside(Q, B2), !inside(Q, B_t),
      opposite(D, D2), growth_axis(G),
      tpl(E, _), box_edge(E, B_t, D2), same_line(G, Q, E),        // the other end's cell in line
      relative(T, E, P), fig_cell(Pan, F, P, Col)
    ).

// The rules the stages may demonstrate.
.type DemonstratedChoice =
    // Each figure travels with one end while its other end runs out ahead,
    // and the lines it gains repeat the line at the leading end.
    Stretch {}
    // Each figure travels with the end that runs out, and the lines it gains
    // behind repeat the line at the trailing end.
  | Push {}
    // Each figure keeps its place while its colors turn. A cell it gains takes
    // the color the other stages show there, turned to the stage, and a cell
    // no other stage shows repeats the cell one step of its end back.
  | Stay {}

// The cells a rule draws over the frame in the stage after a stage.
.decl rule_paint(r: DemonstratedChoice, pan: Position, p: Position, col: Color)

rule_paint($Stretch(), Pan, Q, Col) :-
    travel(Pan, F, D, Q, Col), opposite(D, D2), outward(Pan, F, D2).

rule_paint($Push(), Pan, Q, Col) :-
    travel(Pan, F, D, Q, Col), outward(Pan, F, D), opposite(D, D2), !outward(Pan, F, D2).

// What a color turns into over a step, read where consecutive stages both
// hold a figure. A color the steps disagree about keeps itself.
// @claim next-stage
.init stage_turn = Unanimous<Color, Color>
stage_turn.item(Col, Col2) :-
    succ_stage(Pan, Pan2), content(Pan, P, Col), content(Pan2, P, Col2).

// @ignore: head-repeat — recolor is the stage turn made total over the figure
//  colors: a color the turn does not move keeps itself
.decl recolor(col: Color, col2: Color)
recolor(Col, Col2) :- stage_turn.value(Col, Col2).
recolor(Col, Col) :- content(_, _, Col), !stage_turn.value(Col, _).

.type Hued = [pan: Position, col: Color]
.type PanelCell = [pan: Position, p: Position]

// A color of one stage, as another stage shows it: turned once per step
// between them.
.init phase = Propagation<Hued, Hued>
phase.source([J, C], [J, C]) :- content(J, _, C).
phase.edge([J, C], [K1, C1], [K, C2]) :-
    content(J, _, C),
    ( succ_stage(K1, K), recolor(C1, C2)      // a step on
    ; succ_stage(K, K1), recolor(C2, C1) ).   // a step back

// The color the stages other than the one after pan show at a cell, turned
// to the stage after pan.
// @claim next-stage
.init recall = Unanimous<PanelCell, Color>
recall.item([Pan, Q], Col2) :-
    content(J, Q, C), stage_panel(Pan), !succ_stage(Pan, J),
    phase.reached([J, C], [Pan, C1]), recolor(C1, Col2).

rule_paint($Stay(), Pan, Q, Col) :-
    fig_box(Pan, F, B, _, _),
    ( fig_cell(Pan, F, Q, Col0), recolor(Col0, Col)              // a cell it holds, turned
    ; gained(Pan, F, Q), recall.value([Pan, Q], Col)             // a gained cell another stage shows
    ; gained(Pan, F, Q), !recall.value([Pan, Q], _),             // else the cell one step of its
      outward(Pan, F, D), end_shift(Pan, F, D, T),               //  end back
      relative(T, Q, P), inside(P, B), fig_cell(Pan, F, P, Col0), recolor(Col0, Col)
    ).

// A stage and the stage after it.
// @claim next-stage
.init catalog = DemonstrationConsistency<Unit, DemonstratedChoice, Position, Position, Color>
catalog.value($U(), Pan, P_intile, Col) :- stage_cell(Pan, P_intile, Col).
catalog.demonstration($U(), Pan, Pan2) :- succ_stage(Pan, Pan2).
catalog.prediction($U(), R, Pan, P_intile, Col) :-
    rule_paint(R, Pan, _, _),
    ( rule_paint(R, Pan, P_intile, Col)                         // drawn by the rule
    ; tpl(P_intile, Col), !rule_paint(R, Pan, P_intile, _) ).   // else the frame

out(P_intile, Col, R) :-
    succ_stage(_, Pan), !succ_stage(Pan, _),                    // the last stage
    catalog.confirmed($U(), R),
    catalog.prediction($U(), R, Pan, P_intile, Col).
