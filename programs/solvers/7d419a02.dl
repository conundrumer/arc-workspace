// 7d419a02
// draft
// keywords: decompose markers walk
// input: Bg lines cut the grid into equal bands stacked along one axis. A
//  params.mark block sits in one band.
// output: The other bands lose their ink to params.fill, except inside a cone
//  that opens from the block: in the bands beside the block's band the cone
//  covers the block's own lines, and each band further out widens it by one
//  step on each side. The block's own band is untouched.
//  Coincide here: the step, the block's extent, and the band width are all 2,
//  and the only other color is the ink.

// the step, one band out
.type Step =
    // params.step
    Fixed {}
    // the block's extent across the bands
  | Marker {}
    // the band width
  | Band {}

// the ink
.type Ink =
    // params.ink
    Stored {}
    // every color that is neither bg nor the mark
  | Derived {}

// the cone's step size, crossed with which colors count as ink
.type Choice = [s: Step, i: Ink]
.type Line = [a: Axis, l: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(6).

    // What ink outside the cone turns into.
    .decl fill(c: Color) fill(4).

    // --- Fixed ---
    .decl step(k: number) step(2).

    // --- Stored ---
    .decl ink(c: Color) ink(8).
}

.init params = Params

.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

// Bg lines cut the bands.
.init frame = DividerTiles<Unit>
frame.cell($U(), P) :- in(P, _).
frame.divider($U(), A, L) :- line_color.value([A, L], Col), params.bg(Col).

// The bands stack along the axis of a divider off both edges.
.decl band_axis(a: Axis)
band_axis(A) :-
    frame.divider($U(), A, L), axis_of(D, A),       // a divider on the axis
    dist_pair(L, D, K1, K2), K1 != 0, K2 != 0.      // between two bands

.decl across_axis(a: Axis)
across_axis(A2) :- band_axis(A), perp(A, A2).

// A cell's band, and its line across the bands.
.decl band_of(p: Position, t: Position)
band_of(P, T) :- band_axis(A), frame.part_of($U(), P, A, T).

.decl line(p: Position, x: Position)
line(P, X) :- in(P, _), across_axis(A), split(P, A, X, _).

// The block.
.decl mark_cell(p: Position)
mark_cell(P) :- in(P, Col), params.mark(Col).

.decl mark_band(t: Position)
mark_band(T) :- mark_cell(P), band_of(P, T).

// --- the ink ---

.decl ink_choice(i: Ink)
ink_choice($Stored()). ink_choice($Derived()).

.decl ink(col: Color, i: Ink)

// --- Stored ---
ink(Col, $Stored()) :- params.ink(Col).

// --- Derived ---
ink(Col, $Derived()) :- in(_, Col), !params.bg(Col), !params.mark(Col).

// --- the step ---

.decl step_choice(s: Step)
step_choice($Fixed()). step_choice($Marker()). step_choice($Band()).

.decl step(k: number, s: Step)

// --- Fixed ---
step(W, $Fixed()) :- params.step(W).

// --- Marker, Band ---
// The step as an extent: the block's across the bands, or its band's
// along them.
.init unit = Bbox<Step>
unit.cell($Marker(), P) :- mark_cell(P).
unit.cell($Band(), P) :- mark_band(T), band_of(P, T).

step(W, $Marker()) :-
    across_axis(A),
    unit.cell($Marker(), P), unit.box($Marker(), B), box_extent(B, P, A, W).
step(W, $Band()) :-
    band_axis(A),
    unit.cell($Band(), P), unit.box($Band(), B), box_extent(B, P, A, W).

// --- the cone ---

// The distance between two lines.
.init near = Ray<Unit>
near.dir($U(), D) :- across_axis(A), axis_of(D, A).
near.cell($U(), X) :- line(_, X).
near.mark($U(), X) :- line(_, X).

// The lines the cone covers in the band beyond t on the block's side d:
// beside the block's band, the block's lines; each band on, one step wider.
.decl shade(s: Step, d: Dir, t: Position, x: Position)
shade(S, D, T2, X) :-
    neighbor(T, D, T2), band_of(_, T2),                   // the band beyond T
    ( mark_band(T), step_choice(S),                       // the block's band: its lines
      band_axis(A), axis_of(D, A), mark_cell(M), line(M, X)
    ; shade(S, D, T, X0),                                 // a shaded band: one step wider
      near.ray($U(), X, _, K, X0), step(W, S), K <= W
    ).

// Ink outside the cone, off the block's band.
.decl faded(p: Position, ch: Choice)
faded(P, [S, I]) :-
    in(P, Col), ink(Col, I),                              // ink
    band_of(P, T), !mark_band(T),                         // off the block's band
    line(P, X), step_choice(S), !shade(S, _, T, X).       // outside the cone

out(P, Col, Ch) :- faded(P, Ch), params.fill(Col).
out(P, Col, [S, I]) :- step_choice(S), ink_choice(I), in(P, Col), !faded(P, [S, I]).
