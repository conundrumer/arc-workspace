// 52df9849
// @draft
// @keywords: lines occlude continue
// input: shapes overlap on a plain ground; each shape is a segment swept
//  along one of the four axes: a bar, a block, a diagonal line. The input
//  draws shapes over one another, so a covered shape shows with a piece
//  missing.
// output: The output brings the covered shapes to the front: each one
//  continues through its occluder, and that occluder keeps what is left.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(7).
}

.init params = Params

.decl obj(p: Position, col: Color)
obj(P, Col) :- in(P, Col), !params.bg(Col).

// Another cell of the color lies strictly nearer side d than q.
.decl passed(col: Color, d: Dir8, q: Position)
passed(Col, D, Q) :- obj(Q, Col), obj(Q2, Col), dir8_elem(D), nearer(D, Q2, Q).

// The color's extreme cells toward d: no cell of it lies nearer that side.
.decl extreme(col: Color, d: Dir8, q: Position)
extreme(Col, D, Q) :- obj(Q, Col), dir8_elem(D), !passed(Col, D, Q).

// The color's segment swept along axis a.
.decl sweep(col: Color, a: Axis4, p: Position)
sweep(Col, A, P) :-
    in(P, _), obj(Q, Col), same_line(A, P, Q),  // on a line of family a it meets
    axis4_of(D, A), dir8_opposite(D, D2),
    extreme(Col, D, E1), !nearer(D, P, E1),     // across the color's extent along a
    extreme(Col, D2, E2), !nearer(D2, P, E2).

// A sweep that covers ground claims an occluder that is not there.
.decl unsupported(col: Color, a: Axis4)
unsupported(Col, A) :- sweep(Col, A, P), in(P, Bg), params.bg(Bg).

// The color a cell hides: a supported sweep covers the cell, and that
// color does not show there.
.decl hidden(p: Position, col: Color)
hidden(P, Col) :- sweep(Col, A, P), !unsupported(Col, A), !in(P, Col).

out(P, Col) :- hidden(P, Col).
out(P, Col) :- in(P, Col), !hidden(P, _).
