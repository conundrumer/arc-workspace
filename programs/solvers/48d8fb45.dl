// 48d8fb45
// @draft
// @keywords: objects markers crop select
// input: several one-color shapes sit on a bg grid, and a mark cell sits just
//  above one of them.
// output: the output is a 3x3 crop holding the marked shape.

// where the crop's box comes from, and what it keeps inside it
.type Choice =
    // the marked shape, drawn in its own bbox
    Object {}
    // the marked shape's box, with everything it contains
  | Interior {}
    // a window stored at the mark, with everything it contains
  | Window {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(5).

    // --- $Window ---
    // The window's box, as margins from the mark's cell.
    .decl win_box(b: Box) win_box([1, -3, -1, -1]).
}

.init params = Params

.decl mark(p: Position)
mark(P) :- in(P, Col), params.mark(Col).

// The shapes; the mark is a cell of the one it touches.
.init blob = Components8<Unit>
blob.node($U(), P) :- in(P, Col), !params.bg(Col).

// The shape the mark sits on.
.decl marked(p: Position, col: Color)
marked(P, Col) :-
    mark(M), blob.conn($U(), M, P),   // in the mark's blob
    !mark(P), in(P, Col).             // a shape cell, not the mark

// The marked shape's box, and the grid seen from it.
.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- marked(P, _).

// --- $Object ---
out(P_inner, Col, $Object()) :-
    bbox.box($U(), B), in(P, _), crop(P, B, P_inner),
    ( marked(P, Col)                     // the shape
    ; !marked(P, _), params.bg(Col) ).   // the rest of the box

// --- $Interior ---
out(P_inner, Col, $Interior()) :- bbox.box($U(), B), in(P, Col), crop(P, B, P_inner).

// --- $Window ---

.decl window(b: Box)
window(B) :- mark(M), params.win_box(B_mark), compose(M, B_mark, B).

out(P_inner, Col, $Window()) :-
    window(B), in(P, Col), crop(P, B, P_inner).   // a grid cell the window covers, seen from it
