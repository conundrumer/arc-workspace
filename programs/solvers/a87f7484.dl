// a87f7484
// keywords: decompose count select
// output: Input stacks square tiles along one axis; the axis varies per pair.
//  Each tile is one color's ink mask on bg. Output one tile. The two cases
//  are data-equivalent on this task.

// which tile the output selects
.type Choice =
    // the tile with the most ink cells
    Count {}
    // the tile whose ink mask no other tile has
  | Shape {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl tile_dim(k: number) tile_dim(3).
}

.init params = Params

.decl tile_val(p_tile: Position, p_intile: Position, col: Color)
tile_val(T, P, Col) :-
    in(P_grid, Col),
    params.tile_dim(K),
    divide_by_size_2d(P_grid, K, 0, T, P).

.decl ink(p_tile: Position, p_intile: Position)
ink(T, P) :- tile_val(T, P, Col), !params.bg(Col).

// --- $Count ---
.init densest = Mode<Unit, Position, Position>
densest.item($U(), T, P) :- ink(T, P).

out(P, Col, $Count()) :- tile_val(T, P, Col), densest.mode($U(), T).

// --- $Shape ---
.init shape_cmp = KeyedSetCompare<Position, Position, Position>
shape_cmp.pattern_member(T, P)  :- ink(T, P).
shape_cmp.observed_member(T, P) :- ink(T, P).

// T's mask equals some other tile's.
.decl shared(p_tile: Position)
shared(T) :- ink(T2, _), T != T2, shape_cmp.equals(T, T2).

out(P, Col, $Shape()) :- tile_val(T, P, Col), ink(T, _), !shared(T).
