// 0a2355a6
// concept: objects enclose count lookup
// Each ink object is repainted with the color its hole count selects.
//
// Two claims on what a hole is:
//   $Joint — a background region the grid edge cannot reach. Two objects can
//            close one together, and it then counts for both.
//   $Own   — a region the grid edge cannot reach with only that object solid.
//            Every other object is transparent, so holes are intrinsic to an
//            object.
// The count tables are per-case: a task where an object plugs another's
// cavity fits both claims at different counts, so the fills can differ.

#include "../lib.dl"

.type Choice = Joint {} | Own {}

.comp Consts {
    .decl bg(c: Color) bg(0).

    // --- $Joint ---

    .decl joint_count_color(n: number, col: Color)
    joint_count_color(1, 1). joint_count_color(2, 3). joint_count_color(3, 2). joint_count_color(4, 4).

    // --- $Own ---

    .decl own_count_color(n: number, col: Color)
    own_count_color(1, 1). own_count_color(2, 3). own_count_color(3, 2). own_count_color(4, 4).
}

.init c = Consts

// The regions of a keyed cell set that the grid edge cannot reach.
.comp Closed<Key> {
    .decl cell(key: Key, p: Position)  // input

    // The edge-connected part of the set.
    .init flood = Reach<Key>
    flood.node(Ky, P) :- cell(Ky, P).
    flood.seed(Ky, P) :- cell(Ky, P), dir_elem(D), dist(P, D, 0).  // on a grid edge

    // Individuate only the closed cells.
    .init regions = Components<Key>
    regions.node(Ky, P) :- cell(Ky, P), !flood.reach(Ky, P).

    .decl region(key: Key, p: Position, id: Ident)
    region(Ky, P, Id) :- regions.label(Ky, P, Id).
}

// --- parse ---

.comp Parse<Key> {
    .type KObj = [k: Key, o: Ident]

    .decl cell(key: Key, p: Position, col: Color)  // input

    .init objs = Components<Key>
    objs.node(K, P) :- cell(K, P, Col), !c.bg(Col).

    // The cells left when all ink is solid — the background.
    .init off_ink = Closed<Key>
    off_ink.cell(K, P) :- cell(K, P, Col), c.bg(Col).

    // Each object's hole regions when all ink closes jointly.
    .init joint_holes = Tally<KObj, Ident>
    joint_holes.item([K, O], Id) :-
        off_ink.region(K, P, Id),                           // cell of a closed region
        dir_elem(D), step_delta(D, S), compose(P, S, Q),    // its neighbor
        objs.label(K, Q, O).                                // in an object

    // The cells left when only O is solid — other objects among them.
    .init off_obj = Closed<KObj>
    off_obj.cell([K, O], P) :- cell(K, P, _), objs.label(K, _, O), !objs.label(K, P, O).

    // Each object's hole regions when it closes alone.
    .init own_holes = Tally<KObj, Ident>
    own_holes.item(KO, Id) :- off_obj.region(KO, _, Id).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Joint()). impl_choice($Own()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- in(P, Col), c.bg(Col), impl_choice(Ch).

// --- $Joint ---

out(P, Col, $Joint()) :-
    parse.objs.label($U(), P, O),                // object cell
    parse.joint_holes.tally([$U(), O], N),       // its hole count
    c.joint_count_color(N, Col).

// --- $Own ---

out(P, Col, $Own()) :-
    parse.objs.label($U(), P, O),                // object cell
    parse.own_holes.tally([$U(), O], N),         // its hole count
    c.own_count_color(N, Col).

// --- fit ---

.comp Fit {
    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col).

    .decl joint_count_color(n: number, col: Color)
    joint_count_color(N, Col) :-
        ex.objs.label(E, P, O), ex.joint_holes.tally([E, O], N),    // object with its hole count
        ex_out(E, P, Col).                                          // the color it is painted

    .decl own_count_color(n: number, col: Color)
    own_count_color(N, Col) :-
        ex.objs.label(E, P, O), ex.own_holes.tally([E, O], N),      // object with its hole count
        ex_out(E, P, Col).                                          // the color it is painted
}
