// 56ff96f3
// @draft
// @keywords: markers span
// input: each non-bg color's marked cells
// output: The box bounding a color's marks fills with that color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col), !params.bg(Col).    // a color's marks

// the box a color spans
.decl spanned(p: Position, col: Color)
spanned(P, Col) :- bbox.box(Col, B), in(P, _), inside(P, B).

out(P, Col) :- spanned(P, Col).
out(P, Col) :- in(P, Col), !spanned(P, _).       // elsewhere, the input
