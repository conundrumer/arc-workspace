// 6ad5bdfd
// @draft
// @keywords: objects markers move
// input: a wall of params.wall filling one full edge line of the grid;
//  the other non-bg cells forming objects, the 4-connected blocks of one
//  color
// output: Every object slides toward the wall's edge and comes to rest
//  where it first meets the wall or an object at rest ahead of it. The
//  cells an object leaves go to bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).

    .decl wall(c: Color) wall(2).
}

.init params = Params

// --- setup ---

.decl wall(p: Position)
wall(P) :- in(P, W), params.wall(W).

// An edge some wall cell is off. The wall's edge is the one edge that is not.
.decl off_wall_edge(d: Dir)
off_wall_edge(D) :- dir_elem(D), wall(P), !dist(P, D, 0).

.init obj = Components<Color>
obj.node(Col, P) :- in(P, Col), !params.bg(Col), !params.wall(Col).

.init settle = Gravity<Unit, Ident>
settle.cell($U(), Id, P) :- obj.label(_, P, Id).
settle.dir($U(), D) :- dir_elem(D), !off_wall_edge(D).
settle.blocked($U(), P) :- wall(P).

.decl fallen(p: Position, col: Color)
fallen(Q, Col) :-
    obj.label(Col, P, Id), settle.travel($U(), Id, Delta), compose(P, Delta, Q).

out(P, Col) :- fallen(P, Col).
out(P, Col) :- wall(P), in(P, Col).
out(P, Col) :- in(P, _), !fallen(P, _), !wall(P), params.bg(Col).  // vacated or empty
