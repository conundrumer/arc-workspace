// 1e0a9b12
// @keywords: lines move
// output: Gravity: each line's ink packs against the params.grav edge, order
//  kept; elsewhere background.

.decl out(p: Position, col: Color)

.comp Params {
    .decl grav(d: Dir) grav(DIR_B).
    .decl bg(c: Color) bg(0).
}

.init params = Params

// Each ink cell travels toward the gravity edge and stops against the ink
// already packed ahead of it.
.init pack = Gravity<Unit, Position>
pack.dir($U(), D) :- params.grav(D).
pack.cell($U(), P, P) :- in(P, Col), !params.bg(Col).

.decl fallen(p: Position, col: Color)
fallen(Q, Col) :- in(P, Col), pack.travel($U(), P, V), compose(P, V, Q).

out(P, Col) :- fallen(P, Col).
out(P, Col) :- in(P, _), params.bg(Col), !fallen(P, _).
