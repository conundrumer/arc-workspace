// 310f3251
// Output tiles the input scale×scale. Each ink cell casts a mark one
// diagonal step toward c.mark_diag, wrapping at the frame edges (torus);
// ink occludes marks.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)          bg(0).
    .decl mark_color(c: Color)  mark_color(2).
    .decl mark_diag(d: DiagDir) mark_diag(DIAG_TL).
    .decl scale(n: number)      scale(3).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

// Row and column index cycles — the torus wrap.
.init cyc = IndexCycle<Axis>
cyc.idx(A, K) :- in(P, _), dir_elem(D), axis_of(D, A), dist(P, D, K).

// Mark target: one diagonal step toward mark_diag, wrapped. A step toward
// an edge increments the distance from its opposite; succ wraps it.
.decl mark_at(p: Position)
mark_at(Q) :-
    ink(P, _), c.mark_diag(Diag),                               // ink cell, the corner
    diag_dirs(Diag, A1, D1, D2), perp(A1, A2),
    opposite(D1, O1), dist(P, O1, K1), cyc.succ(A1, K1, K1b),   // step along
    opposite(D2, O2), dist(P, O2, K2), cyc.succ(A2, K2, K2b),   // step across
    in(Q, _), dist(Q, O1, K1b), dist(Q, O2, K2b).               // the wrapped cell

// Tile content: ink passes through; marks fill bg; the rest stays bg.
.decl tile_content(p: Position, col: Color)
tile_content(P, Col) :- ink(P, Col).
tile_content(P, Col) :- mark_at(P), !ink(P, _), c.mark_color(Col).
tile_content(P, Col) :- in(P, _), !ink(P, _), !mark_at(P), c.bg(Col).

// scale×scale tile arrangement.
.init arr = Frame2D<Unit>
arr.extent($U(), A, N) :- axis_elem(A), c.scale(N).

.decl out(p: Position, col: Color)
out(P_grid, Col) :-
    tile_content(P_intile, Col),
    arr.cell($U(), P_tile),
    concat_2d(P_tile, P_intile, 0, P_grid).

.output out(IO=stdout)
