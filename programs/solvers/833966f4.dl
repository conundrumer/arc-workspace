// 833966f4
// keywords: permutation lookup d4
// output: 5×1 cell permutation: two pairs of adjacent rows swap around a
//  fixed center row.

// how the permutation is derived
.type Choice =
    // the permutation as data: paired labeled grids
    LabeledGrids {}
    // the permutation composed: parts by tile count around the center gap row,
    // each part flipped
  | Count {}
    // the same composition, over parts by tile size
  | Size {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    // --- LabeledGrids ---
    .decl in_label(p: Position, id: Ident)
    GRID_SPARSE_5x1(in_label,
        1,
        2,
        3,
        4,
        5)

    .decl out_label(p: Position, id: Ident)
    GRID_SPARSE_5x1(out_label,
        2,
        1,
        3,
        5,
        4)

    .decl map(p_in: Position, p_out: Position)
    map(P_in, P_out) :- in_label(P_in, Id), out_label(P_out, Id).

    // --- Count, Size ---
    .decl divide_axis(a: Axis) divide_axis(AXIS_V).
    .decl divide_gap(g: number) divide_gap(1).

    // --- Count ---
    .decl divisor(n: number) divisor(2).

    // --- Size ---
    .decl tile_size(k: number) tile_size(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($LabeledGrids()).
impl_choice($Count()).
impl_choice($Size()).

// The cases that compose the permutation out of a divide.
.decl by_divide(ch: Choice)
by_divide($Count()). by_divide($Size()).

// The part a cell sits in; the gap row falls in no part.
.decl part(p_grid: Position, p_outer: Position, p_inner: Position, c: Choice)
part(P_grid, P_outer, P_inner, $Count()) :-
    in(P_grid, _),                                                            // input cell
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),           // parts by count
    divide(P_grid, A, N, G, P_outer, P_inner).
part(P_grid, P_outer, P_inner, $Size()) :-
    in(P_grid, _),                                                            // input cell
    params.divide_axis(A), params.tile_size(K), params.divide_gap(G),         // parts by size
    divide_by_size(P_grid, A, K, G, P_outer, P_inner).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :- params.map(P_grid_in, P_grid_out).

perm(P_grid_in, P_grid_out, C) :-
    part(P_grid_in, P_outer, P_inner, C),                                     // the cell's part
    params.divide_axis(A), flip_of(A, F), apply(F, P_inner, P_inner_out),     // swap the pair
    params.divide_gap(G), concat(P_outer, P_inner_out, A, G, P_grid_out).     // recompose

perm(P_grid_in, P_grid_in, C) :-
    by_divide(C), in(P_grid_in, _), !part(P_grid_in, _, _, C).   // gap row passthrough

out(P_grid_out, Col, Impl) :-
    impl_choice(Impl), in(P_grid_in, Col),   // choice × input cell
    perm(P_grid_in, P_grid_out, Impl).       // the cell's image

.comp Determine {
    .decl pair(p_in: Position, p_out: Position)
    pair(P_in, P_out) :- ex_in(E, P_in, Col), ex_out(E, P_out, Col).

    .decl in_label(p: Position, id: Ident)
    in_label(P_in, as(ord(P_in), Ident)) :- pair(P_in, _).

    .decl out_label(p: Position, id: Ident)
    out_label(P_out, as(ord(P_in), Ident)) :- pair(P_in, P_out).
}
