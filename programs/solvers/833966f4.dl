// 833966f4
// concept: permutation lookup d4
// 5×1 cell permutation: two pairs of adjacent rows swap around a fixed
// center row. Two models:
//
//   $LabeledGrids — the permutation as data: in/out label grids paired by
//                   shared non-zero label
//   $Divide       — the permutation composed: divide V by 2 around the
//                   center gap row; flip each pair

#include "../lib.dl"

.type Choice = LabeledGrids {} | Divide {}

.comp Consts {
    // --- LabeledGrids data ---
    .decl in_label(p: Position, id: Ident)
    GRID_5x1(in_label,
        1,
        2,
        3,
        4,
        5)

    .decl out_label(p: Position, id: Ident)
    GRID_5x1(out_label,
        2,
        1,
        3,
        5,
        4)

    // --- Divide params ---
    .decl divide_axis(a: Axis) divide_axis(AXIS_V).
    .decl divisor(n: number) divisor(2).
    .decl divide_gap(g: number) divide_gap(1).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($LabeledGrids()).
impl_choice($Divide()).

.decl decomposable(p: Position)
decomposable(P_grid) :-
    in(P_grid, _),
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),
    divide(P_grid, A, N, G, _, _).

.decl perm(p_in: Position, p_out: Position, c: Choice)
perm(P_grid_in, P_grid_out, $LabeledGrids()) :-
    c.in_label(P_grid_in, Id), c.out_label(P_grid_out, Id),   // shared label
    Id != 0.                                                  // non-pairing sentinel

perm(P_grid_in, P_grid_out, $Divide()) :-
    in(P_grid_in, _),                                          // input cell
    c.divide_axis(A), c.divisor(N), c.divide_gap(G),           // params
    divide(P_grid_in, A, N, G, P_outer, P_inner),              // 1D divide
    flip_of(A, F), apply(F, P_inner, P_inner_out),             // swap the pair
    concat(P_outer, P_inner_out, A, G, P_grid_out).            // recompose
perm(P_grid_in, P_grid_in, $Divide()) :-
    in(P_grid_in, _), !decomposable(P_grid_in).                // gap row passthrough

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col, Impl) :- impl_choice(Impl), in(P_grid_in, Col), perm(P_grid_in, P_grid_out, Impl).
