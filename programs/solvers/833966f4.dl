// Apply a fixed position permutation. Input is a 5×1 grid; cells move per
// the perm relation, derived by joining two label grids.

#include "../lib.dl"

.comp Consts {
    // Each cell's label, in two parallel 5×1 grids. Matching labels identify
    // a (p_in, p_out) pair.
    .decl in_label(p: Position, lbl: number)
    GRID_5x1(in_label,
        1,
        2,
        3,
        4,
        5)

    .decl out_label(p: Position, lbl: number)
    GRID_5x1(out_label,
        2,
        1,
        3,
        5,
        4)

    .decl perm(p_in: Position, p_out: Position)
    perm(P_IN, P_OUT) :- in_label(P_IN, LBL), out_label(P_OUT, LBL), LBL != 0.
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_OUT, COL) :- in(P_IN, COL), c.perm(P_IN, P_OUT).

.output out(IO=stdout)
