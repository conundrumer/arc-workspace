// 5adee1b2
// @draft
// @keywords: objects markers enclose border mapping
// input: A legend at one edge lists, per shape color, the border color that
//  goes with it.
// output: Each shape of a listed color takes a border: its bounding box,
//  grown one cell on each side, painted in the shape's border color at every
//  empty cell the shape does not close off from the grid edge.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // The edge the legend stands on.
    .decl legend_dir(d: Dir) legend_dir(DIR_L).
}

.init params = Params

// --- the legend ---

// An entry stands at the legend edge: a shape color, and the border color
// that goes with it one step inward.
.decl legend_entry(p: Position, col: Color, p_border: Position, col_border: Color)
legend_entry(P, Col, Q, Col2) :-
    in(P, Col), !params.bg(Col),
    params.legend_dir(D), dist(P, D, 0),               // on the legend edge
    opposite(D, D2), neighbor(P, D2, Q), in(Q, Col2).  // its border color

.decl border_color(col: Color, col_border: Color)
border_color(Col, Col2) :- legend_entry(_, Col, _, Col2).

// --- the shapes ---

.init shapes = Components<Color>
shapes.node(Col, P) :-
    in(P, Col), border_color(Col, _),                      // a cell of a listed color
    !legend_entry(P, _, _, _), !legend_entry(_, _, P, _).  // outside the legend

.decl shape_cell(s: Ident, p: Position)
shape_cell(S, P) :- shapes.label(_, P, S).

// --- the border ---

.init bbox = Bbox<Ident>
bbox.cell(S, P) :- shape_cell(S, P).

// The bounding box grown one cell on each side.
.decl grown_box(s: Ident, p: Position)
grown_box(S, Q) :-
    bbox.box(S, B), in(P, _), inside(P, B),
    ( Q = P                                      // the box
    ; dir8_elem(D), neighbor(P, D, Q), in(Q, _)  // and the ring around it
    ).

// What the shape leaves open to the grid edge.
.init outside = Reach<Ident>
outside.node(S, P) :- shape_cell(S, _), in(P, _), !shape_cell(S, P).
outside.seed(S, P) :- outside.node(S, P), dir_elem(D), dist(P, D, 0).

.decl painted(p: Position, col: Color)
painted(P, Col) :-
    grown_box(S, P), in(P, Col_in), params.bg(Col_in),  // an empty cell of the box
    outside.reach(S, P),                                // the shape does not enclose it
    shapes.label(Col_s, _, S), border_color(Col_s, Col).  // the shape color's border color

out(P, Col) :- painted(P, Col).
out(P, Col) :- in(P, Col), !painted(P, _).
