// dc433765
// keywords: markers move
// output: The mover cell steps one cell toward the target cell: per axis, one
//  cell toward the edge the target is strictly nearer. The target stays.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl mover(c: Color) mover(3).
    .decl target(c: Color) target(4).
}

.init params = Params

.decl mover_at(p: Position)
mover_at(P) :- in(P, Col), params.mover(Col).

.decl target_at(p: Position)
target_at(P) :- in(P, Col), params.target(Col).

.decl axis_step(a: Axis, s: Position)
axis_step(A, S) :-
    mover_at(Pm), target_at(Pt), axis_of(D, A),
    ( nearer(D, Pt, Pm), step_offset(D, S)          // the target lies toward D — step that way
    ; same_dist(D, Pm, Pt), S = ZERO             // aligned on the axis — no step
    ).

.decl moved(p: Position)
moved(P) :-
    mover_at(Pm),
    perp(A1, A2), axis_step(A1, S1), axis_step(A2, S2),
    compose(Pm, S1, P1), compose(P1, S2, P).

out(P, Col) :- target_at(P), params.target(Col).
out(P, Col) :- moved(P), params.mover(Col).
out(P, Col) :- in(P, _), !target_at(P), !moved(P), params.bg(Col).
