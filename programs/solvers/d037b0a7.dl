// d037b0a7
// concept: markers cast
// Each mark casts its color through bg toward the c.dir edge in its
// line; a mark in the way stops the cast.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_B).   // fill direction
}

.init c = Consts

.decl flow(p: Position, col: Color)
flow(P, Col) :- in(P, Col), !c.bg(Col).
flow(P2, Col) :-
    flow(P, Col),                     // colored cell
    c.dir(D), neighbor(P, D, P2),     // the next cell toward c.dir
    in(P2, Bg), c.bg(Bg).             // still bg — a mark occludes

.decl out(p: Position, col: Color)
out(P, Col) :- flow(P, Col).
out(P, Col) :- in(P, Col), !flow(P, _).
