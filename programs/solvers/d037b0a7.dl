// d037b0a7
// concept: markers cast
// Each mark casts its color through bg toward the c.dir edge in its
// line; a mark in the way stops the cast.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_B).   // fill direction
}

.init c = Consts

.init flow = Ray<Unit>
flow.dir($U(), D) :- c.dir(D).
flow.cell($U(), P) :- in(P, _).
flow.mark($U(), P) :- in(P, Col), !c.bg(Col).
flow.blocked($U(), P) :- in(P, Col), !c.bg(Col).

.decl out(p: Position, col: Color)
out(P, Col) :- flow.clear($U(), P, _, _, P_mark), in(P_mark, Col).  // the mark's color
out(P, Col) :- in(P, Col), !flow.clear($U(), P, _, _, _).           // no cast reached it
