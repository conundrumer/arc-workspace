// d037b0a7
// @keywords: markers cast
// output: Each mark casts its color through bg toward the params.dir edge in
//  its line; a mark in the way stops the cast.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_B).   // fill direction
}

.init params = Params

.init flow = Ray<Unit>
flow.dir($U(), D) :- params.dir(D).
flow.cell($U(), P) :- in(P, _).
flow.mark($U(), P) :- in(P, Col), !params.bg(Col).
flow.blocked($U(), P) :- in(P, Col), !params.bg(Col).

out(P, Col) :- flow.clear($U(), P, _, _, P_mark), in(P_mark, Col).  // the mark's color
out(P, Col) :- in(P, Col), !flow.clear($U(), P, _, _, _).           // no cast reached it
