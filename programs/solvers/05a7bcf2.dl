// 05a7bcf2
// @keywords: lines cast move
// input: two full lines cross the grid: a bare wall line of params.wall, and
//  a line of params.push carrying a ragged profile on its wall-facing side.
//  Shapes of params.shape sit on the wall's other side.
// output: every line running across the walls that holds a shape cell is
//  rebuilt: the shape's cells take params.mark, params.shape casts from
//  there to the wall, and params.wall fills on to the far edge, with the
//  push structure resting against that edge.

// Two models of how it gets there
.type Choice =
    // it moves as one body
    Slide {}
    // each line's push cells fall and stack
  | Pack {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl wall(col: Color) wall(8).
    .decl push(col: Color) push(2).
    .decl shape(col: Color) shape(4).
    .decl mark(col: Color) mark(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Slide()). impl_choice($Pack()).

// --- shared ---

.decl wall_cell(p: Position)
wall_cell(P) :- in(P, Col), params.wall(Col).

.decl push_cell(p: Position)
push_cell(P) :- in(P, Col), params.push(Col).

.decl shape_cell(p: Position)
shape_cell(P) :- in(P, Col), params.shape(Col).

// From the wall toward the push structure, and on to the far edge.
.init wall_cast = Ray<Unit>
wall_cast.dir($U(), D)  :- dir_elem(D).
wall_cast.cell($U(), P) :- push_cell(P).
wall_cast.mark($U(), P) :- wall_cell(P).

.decl dir(d: Dir)
dir(D) :- dir_elem(D), wall_cast.ray($U(), _, D, _, _).

// The shape casts toward the wall; the wall's fill reaches on past it.
.init cast = Ray<Unit>
cast.dir($U(), D)  :- dir(D).
cast.cell($U(), P) :- in(P, _).
cast.mark($U(), P) :- shape_cell(P).

.init reach = Ray<Unit>
reach.dir($U(), D)  :- dir(D).
reach.cell($U(), P) :- in(P, _).
reach.mark($U(), P) :- wall_cell(P).

// Short of the shape, or in a line no shape claims — content stands.
.decl short(p: Position)
short(P) :- in(P, _), dir(D), !cast.ray($U(), P, D, _, _).

// Between the shape and the wall.
.decl gap(p: Position)
gap(P) :- cast.ray($U(), P, D, _, _), !reach.ray($U(), P, D, _, _), !shape_cell(P).

// At or past the wall, in a line a shape claims.
.decl through(p: Position)
through(P) :- reach.ray($U(), P, D, _, _), cast.ray($U(), P, D, _, _).

// --- $Slide: the push structure moves as one body ---

// It travels until it rests against the far edge.
.init slide = Gravity<Unit, Unit>
slide.cell($U(), $U(), P) :- push_cell(P).
slide.dir($U(), D) :- dir(D).

.decl placed(p: Position, c: Choice)
placed(P2, $Slide()) :- slide.travel($U(), $U(), V), push_cell(P), compose(P, V, P2).

// --- $Pack: each line's push cells fall and stack ---

// Each push cell falls toward the far edge and stacks on those ahead of it.
.init fall = Gravity<Unit, Position>
fall.cell($U(), P, P) :- push_cell(P).
fall.dir($U(), D) :- dir(D).

placed(P2, $Pack()) :- fall.travel($U(), P, V), compose(P, V, P2).

out(P, Col, Ch) :- in(P, Col), short(P), impl_choice(Ch).
out(P, Col, Ch) :- shape_cell(P), params.mark(Col), impl_choice(Ch).
out(P, Col, Ch) :- gap(P), params.shape(Col), impl_choice(Ch).
out(P, Col, Ch) :-
    impl_choice(Ch), through(P),           // a cell the shape sweeps
    ( placed(P, Ch), params.push(Col)      // the shape lands here
    ; !placed(P, Ch), params.wall(Col)     // vacated — the wall shows
    ).
