// 85c4e7cd
// concept: permutation
// Concentric square rings, one color per ring. Output reverses the ring
// colors: each ring takes the color of the ring as deep from the center
// as it is from the border.

#include "../lib.dl"

.comp Consts {
    // No task data — siblings vary only the input.
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Ring index: distance to the nearest edge.
.decl cell_dist(p: Position, d: Dir, k: number)
cell_dist(P, D, K) :- in(P, _), dir_elem(D), dist(P, D, K).

.decl ring(p: Position, k: number)
ring(P, K) :- in(P, _), K = min Kd : { cell_dist(P, _, Kd) }.

.decl ring_idx(k: number)
ring_idx(K) :- ring(_, K).

.decl ring_color(k: number, col: Color)
ring_color(K, Col) :- ring(P, K), in(P, Col).

// Opposite-end pairing: as many rings outside K as inside K2.
.decl rev(k: number, k2: number)
rev(K, K2) :-
    ring_idx(K),  R = count : { ring_idx(Ka), Ka < K },
    ring_idx(K2), R = count : { ring_idx(Kb), K2 < Kb }.

.decl out(p: Position, col: Color)
out(P, Col) :- ring(P, K), rev(K, K2), ring_color(K2, Col).

.output out(IO=stdout)
