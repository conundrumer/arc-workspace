// 85c4e7cd
// concept: permutation
// Concentric square rings, one color per ring. Output reverses the ring
// colors: each ring takes the color of the ring as deep from the center
// as it is from the border.

#include "../lib.dl"

.comp Params {
    // No task data — siblings vary only the input.
}

.init params = Params

// Ring index: distance to the nearest edge.
.init edge_dist = Extremes<Position>
edge_dist.cand(P, K) :- in(P, _), dir_elem(D), dist(P, D, K).

.decl ring(p: Position, k: number)
ring(P, K) :- edge_dist.low(P, K).

.init rings = Ordinal<Unit>
rings.idx_set($U(), K) :- ring(_, K).

.decl ring_color(k: number, col: Color)
ring_color(K, Col) :- ring(P, K), in(P, Col).

// Opposite-end pairing: as many rings outside K as inside K2.
.decl out(p: Position, col: Color)
out(P, Col) :-
    ring(P, K), rings.rank($U(), K, R),   // rings outside this one
    rings.rank_desc($U(), K2, R),         // the ring as deep from the centre
    ring_color(K2, Col).
