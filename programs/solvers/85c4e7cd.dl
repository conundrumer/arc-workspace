// 85c4e7cd
// @keywords: permutation
// input: the grid decomposes into concentric square rings, one color per ring
// output: each ring takes the color of the ring as deep from the center as it
//  is from the border

.decl out(p: Position, col: Color)

.comp Params {
    // No task data — siblings vary only the input.
}

.init params = Params

// The grid peels into concentric rings, one per depth.
.init peel = Rim<Unit>
peel.cell($U(), P) :- in(P, _).

.init rings = Ordinal<Unit>
rings.idx_set($U(), K) :- peel.depth($U(), _, K).

.decl ring_color(k: number, col: Color)
ring_color(K, Col) :- peel.depth($U(), P, K), in(P, Col).

out(P, Col) :-
    peel.depth($U(), P, K), rings.rank($U(), K, R),   // rings outside this one
    rings.rank_desc($U(), K2, R),                     // the ring as deep from the center
    ring_color(K2, Col).
