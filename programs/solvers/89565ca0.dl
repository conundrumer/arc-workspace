// 89565ca0
// @keywords: objects cast enclose count rank noise occlude
// input: Frames of distinct colors lie stacked on the background, and
//  specks of one further color litter the grid.
// output: A frame's lines run on under whatever hides them — a speck, or a
//  frame lying over it: a line runs straight on past two cells of the frame
//  in a row, and only background stops it, even past the line's end.
//  Each frame closes off some number of compartments from the grid edge.
//  The output is a bar chart, one row per frame from params.rank_dir in
//  ascending compartment count, each row that many cells of the frame's
//  color from the params.bar_sense side and specks for the rest. Frames of
//  equal compartment count can take either row; each assignment of frames
//  to rows is a resolution.

.type TiebreakResolution =
    End {} | Sit {row: number, f: Color, rest: TiebreakResolution}

.decl out(p: Position, col: Color, res: TiebreakResolution)

// A frame's lines run on toward one direction.
.type Run = [f: Color, d: Dir]

.comp Params {
    .decl bg(col: Color) bg(0).

    // The chart's layout: rows counted from rank_dir, bars growing from the
    // edge a quarter turn away.
    .decl rank_dir(d: Dir) rank_dir(DIR_T).
    .decl bar_sense(s: Sense) bar_sense(SENSE_CC).
}

.init params = Params

// --- the specks and the frames ---

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

.init piece = Components<Color>
piece.node(Col, P) :- ink(P, Col).

// The specks are the color that lies in the most pieces.
.init scattered = Mode<Unit, Color, Ident>
scattered.item($U(), Col, Id) :- piece.label(Col, _, Id).

.decl speck(col: Color)
speck(Col) :- scattered.mode($U(), Col).

.decl frame(col: Color)
frame(Col) :- ink(_, Col), !speck(Col).

// --- each frame's lines, read through what hides them ---

// A line of frame f runs on toward d from a cell of f with another cell of f
// behind it, over hidden cells, until background stops it.
.init run_on = Ray<Run>
run_on.dir([F, D], D) :- frame(F), dir_elem(D).
run_on.cell([F, D], P) :- frame(F), dir_elem(D), in(P, _).
run_on.mark([F, D], P) :-
    ink(P, F), frame(F), dir_elem(D),
    opposite(D, O), neighbor(P, O, Q), ink(Q, F).   // the cell behind it on the line
run_on.blocked([F, D], P) :- frame(F), dir_elem(D), in(P, Col), params.bg(Col).

.decl line(f: Color, p: Position)
line(F, P) :- frame(F), ink(P, F).
line(F, P) :- run_on.clear([F, _], P, _, _, _).

// --- the compartments a frame closes off ---

// The space a frame's lines leave.
.init closed = Closed<Color>
closed.cell(F, P) :- frame(F), in(P, _), !line(F, P).

.init size = Tally<Color, Ident>
size.item(F, Id) :- closed.region(F, _, Id).
size.domain(F) :- frame(F).

// --- the chart ---

.decl bar_dir(d: Dir)
bar_dir(D2) :- params.rank_dir(D), params.bar_sense(S), turn(S, D, D2).

.init frames = Tally<Unit, Color>
frames.item($U(), F) :- frame(F).

.init widest = Extremes<Unit>
widest.cand($U(), N) :- size.tally(_, N).

.init chart = Frame2D<Unit>
chart.extent($U(), A, N) :- params.rank_dir(D), axis_of(D, A), frames.tally($U(), N).
chart.extent($U(), A, N) :- bar_dir(D), axis_of(D, A), widest.high($U(), N).

// A row of the chart, by its distance from the rank edge.
.decl row(k: number)
row(K) :- chart.cell($U(), P), params.rank_dir(D), dist(P, D, K).

// --- which row a frame may take ---

.init fewer = Order<Unit, Color>
fewer.elem($U(), F) :- frame(F).
fewer.score($U(), F, N) :- size.tally(F, N).

// Every frame of fewer compartments lies between this one and the rank edge,
// so a frame sits no nearer that edge than their number; seating them all
// leaves each the rows of its own tie.
.decl seat(f: Color, k: number)
seat(F, K) :- row(K), fewer.rank($U(), F, R), R <= K.

.init ties = TiebreakResolutions<Unit, number, Color>
ties.cand($U(), K, F) :- seat(F, K).

out(P, Col, Res) :-
    chart.cell($U(), P), params.rank_dir(D), dist(P, D, K),
    ties.assign($U(), Res, K, F), size.tally(F, N),   // the frame seated in this row
    bar_dir(Db), dist(P, Db, K2),
    ( K2 < N, Col = F        // the bar
    ; K2 >= N, speck(Col)    // past its end
    ).
