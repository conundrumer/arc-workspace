// d4b1c2b1
// @keywords: scale count
// output: Layout: N× scale. Each input cell expands to an N×N block of its
//  color. N is the count of distinct colors in the input. The model takes
//  no task data, so the family is fully structural.

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- in(_, Col).

.init block = Frame2D<Unit>
block.extent($U(), A, N) :- axis_elem(A), palette.tally($U(), N).

out(P_grid_out, Col) :-
    in(P_tile, Col),                                // input cell as tile pos
    block.cell($U(), P_intile),                     // intile pos (N×N block)
    concat_2d(P_tile, P_intile, 0, P_grid_out).     // 2D recompose
