// 6a11f6da
// concept: overlay decompose rank
// Layout: vertically-stacked 5×5 ink slabs. Output is the per-cell
// overlay: the highest-priority candidate wins; no ink is bg.
//
// out's choice column = [d, c]:
//
//   d (find the slabs):
//     $Count() — by tile count
//     $Size()  — by tile size
//   c (priority):
//     $Palette() — color order
//     $Stack()   — slab order

#include "../lib.dl"

.type DecChoice = Count {} | Size {}
.type Prio      = Palette {} | Stack {}
.type Choice    = [d: DecChoice, c: Prio]

.type CellKey = [o: Position, d: DecChoice]

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl tile_axis(a: Axis) tile_axis(AXIS_V).

    // --- Count ---
    .decl tile_count(n: number) tile_count(3).

    // --- Size ---
    .decl tile_size(k: number) tile_size(5).

    // --- Palette ---
    // Ink priority ranks, highest first.
    .decl ink_rank(c: Color, r: number)
    ink_rank(6, 0). ink_rank(1, 1). ink_rank(8, 2).

    // --- Stack ---
    // Slab priority ranks, highest first.
    .decl slab_rank(p_tile: Position, r: number)
    GRID_3x1(slab_rank,
        1,
        2,
        0)
}

.init params = Params

.decl prio_choice(c: Prio)
prio_choice($Palette()).
prio_choice($Stack()).

// --- decompose cases: the slab a cell sits in ---

.decl decompose(p_grid: Position, p_tile: Position, p_out: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_out, $Count()) :-
    in(P_grid, _),                                             // input position
    params.tile_axis(A), params.tile_count(N),                 // slabs by count
    divide_slab(P_grid, A, N, 0, P_tile, P_out).
decompose(P_grid, P_tile, P_out, $Size()) :-
    in(P_grid, _),                                             // input position
    params.tile_axis(A), params.tile_size(K),                  // slabs by size
    divide_by_size_slab(P_grid, A, K, 0, P_tile, P_out).

// Inked slab cells competing at each output cell.
.decl cand(o: Position, p_tile: Position, col: Color, dc: DecChoice)
cand(P_out, P_tile, Col, Dc) :-
    in(P_grid, Col), !params.bg(Col),                     // inked input cell
    decompose(P_grid, P_tile, P_out, Dc).

.decl out(p: Position, col: Color, ch: Choice)
out(O, Bg, [Dc, C]) :-
    prio_choice(C), decompose(_, _, O, Dc), params.bg(Bg), !cand(O, _, _, Dc).

// --- Palette ---

// The top-priority color competing at each output cell.
.init front_ink = ArgExtremes<CellKey, Color>
front_ink.cand([O, Dc], Col, R) :- cand(O, _, Col, Dc), params.ink_rank(Col, R).

out(O, Col, [Dc, $Palette()]) :- front_ink.low([O, Dc], Col, _).

// --- Stack ---

// The top-priority slab competing at each output cell.
.init front_slab = ArgExtremes<CellKey, Position>
front_slab.cand([O, Dc], T, R) :- cand(O, T, _, Dc), params.slab_rank(T, R).

out(O, Col, [Dc, $Stack()]) :- front_slab.low([O, Dc], T, _), cand(O, T, Col, Dc).

.comp Determine {
    .decl cand(e: Example, o: Position, p_tile: Position, col: Color)
    cand(E, P_out, P_tile, Col) :-
        ex_in(E, P_grid, Col), !params.bg(Col),                  // inked input cell
        params.tile_axis(A), params.tile_count(N),               // slab params
        divide_slab(P_grid, A, N, 0, P_tile, P_out).

    // Closed transitively: a slab pair need not overlap directly.
    .decl beats(p_tile: Position, p_tile2: Position)
    beats(T, T2) :-
        cand(E, O, T, Col), cand(E, O, T2, Col2), Col != Col2,
        ex_out(E, O, Col).
    beats(T, T3) :- beats(T, T2), beats(T2, T3).

    .init order = Order<Unit, Position>
    order.elem($U(), T) :- cand(_, _, T, _).
    order.before($U(), T, T2) :- beats(T, T2).

    .decl slab_rank(p_tile: Position, r: number)
    slab_rank(T, R) :- order.rank($U(), T, R).

    // Each slab keeps one ink, so a slab's rank is its ink's rank.
    .decl ink_rank(c: Color, r: number)
    ink_rank(Col, R) :- cand(_, _, T, Col), slab_rank(T, R).
}
