// e633a9e5
// concept: scale lookup border
// Nonuniform scale-up: each input cell becomes a tile, and the tiles keep
// the input's arrangement. Three models, tagged on out's Choice:
//
//   $Edge()  — a cell is params.fat wide along an axis where it touches a grid
//              edge of that axis, and unit wide elsewhere.
//   $Table() — per-line extents stored in params.ext, keyed by the line's position.
//   $Map()   — pure data: params.map stores the cell correspondence from input
//              positions to output positions.

#include "../lib.dl"

.type Choice = Edge {} | Table {} | Map {}

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Edge ---
    .decl fat(n: number) fat(2).

    // Axis-only intile positions of the fat tile.
    .decl fat_pos(a: Axis, p_in_ax: Position)
    fat_pos(A, Pi) :- fat(N), ext_pos(A, N, Pi).

    // --- $Table ---
    .decl ext(a: Axis, p: Position, n: number)
    ext(AXIS_V, [0, 2, 0, 0], 2). ext(AXIS_V, [1, 1, 0, 0], 1). ext(AXIS_V, [2, 0, 0, 0], 2).
    ext(AXIS_H, [0, 0, 0, 2], 2). ext(AXIS_H, [0, 0, 1, 1], 1). ext(AXIS_H, [0, 0, 2, 0], 2).

    // Axis-only intile positions of each line's tile.
    .decl line_pos(a: Axis, p_along: Position, p_in_ax: Position)
    line_pos(A, P_along, Pi) :- ext(A, P_along, N), ext_pos(A, N, Pi).

    // --- $Edge, $Table ---
    // Axis-only intile positions of an extent-n tile, for the extents in use.
    .decl ext_in_use(n: number)
    ext_in_use(N) :- fat(N).
    ext_in_use(N) :- ext(_, _, N).

    .decl ext_pos(a: Axis, n: number, p: Position)
    ext_pos(AXIS_V, N, P) :- ext_in_use(N), helpers.frame_pos([N, 1], P).  // @unit: a strip is one cell wide
    ext_pos(AXIS_H, N, P) :- ext_in_use(N), helpers.frame_pos([1, N], P).  // @unit

    // --- $Map ---
    // Cell correspondence as an id join: src labels the input cells, dst
    // gives each output cell the id of its source.
    .decl src(p: Position, id: Ident)
    GRID_3x3(src,
        0, 1, 2,
        3, 4, 5,
        6, 7, 8)

    .decl dst(p: Position, id: Ident)
    GRID_5x5(dst,
        0, 0, 1, 2, 2,
        0, 0, 1, 2, 2,
        3, 3, 4, 5, 5,
        6, 6, 7, 8, 8,
        6, 6, 7, 8, 8)

    .decl map(p_in: Position, p_out: Position)
    map(P_in, P_out) :- src(P_in, Id), dst(P_out, Id).
}

.init params = Params

.decl out(p: Position, col: Color, ch: Choice)

// Per-case axis-only intile positions of a cell's tile.
.decl ax_pos(ch: Choice, p_tile: Position, a: Axis, p_in_ax: Position)

// --- $Edge ---
ax_pos($Edge(), P, A, Pi) :-
    in(P, _), axis_of(D, A),
    ( dist(P, D, 0), params.fat_pos(A, Pi)                    // touches an edge of axis a
    ; dist_pair(P, D, K, K2), K != 0, K2 != 0, Pi = ZERO    // off both edges of axis a
    ).

// --- $Table ---
ax_pos($Table(), P, A, Pi) :-
    in(P, _),
    split(P, A, P_along, _),                // the cell's line
    params.line_pos(A, P_along, Pi).        // that line's tile

// --- $Edge, $Table ---
.decl tile(ch: Choice, p_tile: Position, p_intile: Position, col: Color)
tile(Ch, P_tile, P_intile, Col) :-
    in(P_tile, Col),
    perp(A1, A2),
    ax_pos(Ch, P_tile, A1, P1), ax_pos(Ch, P_tile, A2, P2),
    compose(P1, P2, P_intile).

// Offset at edge D: the tile touching edge D sits at zero, and each step
// inward moves by the extent of the tile stepped over.
.decl edge_off(ch: Choice, d: Dir, p_tile: Position, p_off: Shift)
edge_off(Ch, D, P_tile, ZERO) :-
    tile(Ch, P_tile, _, _), dir_elem(D), dist(P_tile, D, 0).
edge_off(Ch, D, P_next, P_off2) :-
    edge_off(Ch, D, P_tile, P_off),                                          // the offset so far
    axis_of(D, A), tile(Ch, P_tile, P_intile, _), axis_dim(P_intile, A, K),  // the tile's extent
    edge_delta(D, K, Delta), compose(P_off, Delta, P_off2),                  // the next offset
    opposite(D, D2), neighbor(P_tile, D2, P_next).                           // the next tile inward

// The offset at both edges of one axis.
.decl axis_off(ch: Choice, a: Axis, p_tile: Position, p_off: Shift)
axis_off(Ch, A, P_tile, P_off) :-
    axis_of(D, A), opposite(D, D2),
    edge_off(Ch, D, P_tile, P1), edge_off(Ch, D2, P_tile, P2),
    compose(P1, P2, P_off).

// The offset at all four edges — the per-axis offsets, perp-glued.
.decl tile_offset(ch: Choice, p_tile: Position, p_off: Shift)
tile_offset(Ch, P_tile, P_off) :-
    perp(A1, A2),
    axis_off(Ch, A1, P_tile, P1), axis_off(Ch, A2, P_tile, P2),
    compose(P1, P2, P_off).

out(P_grid, Col, Ch) :-
    tile(Ch, P_tile, P_intile, Col),
    tile_offset(Ch, P_tile, P_off),
    compose(P_off, P_intile, P_grid).

// --- $Map ---
out(P_grid, Col, $Map()) :- in(P_in, Col), params.map(P_in, P_grid).

.comp Determine {
    // Correspondence candidates: same color at both cells.
    .decl cand(e: Example, p_in: Position, p_out: Position)
    cand(E, P_in, P_out) :- ex_in(E, P_in, C), ex_out(E, P_out, C).

    // A within-example color coincidence breaks in some other example.
    .decl broken(p_in: Position, p_out: Position)
    broken(P_in, P_out) :-
        cand(_, P_in, P_out), ex_out(E, _, _), !cand(E, P_in, P_out).

    .decl pair(p_in: Position, p_out: Position)
    pair(P_in, P_out) :- cand(_, P_in, P_out), !broken(P_in, P_out).

    .decl src(p: Position, id: Ident)
    src(P_in, as(ord(P_in), Ident)) :- pair(P_in, _).

    .decl dst(p: Position, id: Ident)
    dst(P_out, as(ord(P_in), Ident)) :- pair(P_in, P_out).

    // The output lines a cell's tile occupies, per axis.
    .decl tile_line(p_in: Position, a: Axis, p_along: Position)
    tile_line(P_in, A, P_along) :-
        pair(P_in, P_out), axis_elem(A), split(P_out, A, P_along, _).

    .type CellAxis = [p_in: Position, a: Axis]

    .init tile_dim = Tally<CellAxis, Position>
    tile_dim.item([P_in, A], P_along) :- tile_line(P_in, A, P_along).

    .decl ext(a: Axis, p: Position, n: number)
    ext(A, P_along, N) :- tile_dim.tally([P_in, A], N), split(P_in, A, P_along, _).
}
