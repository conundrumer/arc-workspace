// 50cb2852
// concept: objects border
// Solid one-color rectangles on params.bg; each keeps its outline and repaints
// its interior to params.fill.
//
// Two models pick the interior:
//   $Box   — cells strictly inside a component's bounding box.
//   $Erode — ink cells whose four neighbors are all ink; off-grid is
//            non-ink.

#include "../lib.dl"

.type Choice = Box {} | Erode {}

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl fill(c: Color) fill(8).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl inner_cell(p: Position, ch: Choice)

// --- $Box ---

.init comps = Components<Unit>
comps.node($U(), P) :- ink(P).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- comps.label($U(), P, Id).

inner_cell(P, $Box()) :- bbox.box(_, B), in(P, _), interior(P, B).

// --- $Erode ---

.init exposed = Rim<Unit>
exposed.cell($U(), P) :- ink(P).

inner_cell(P, $Erode()) :- ink(P), !exposed.rim($U(), P).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Box()). impl_choice($Erode()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- inner_cell(P, Ch), params.fill(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !inner_cell(P, Ch).
