// 17cae0c1
// concept: decompose lookup
// The input is a strip of panels, each carrying a glyph in its non-bg cells.
// The output paints each panel with the color its glyph names in a stored
// glyph → color table.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl tile_axis(a: Axis) tile_axis(AXIS_H).

    // The panel is the glyph's own frame, so the glyph's extent along the
    // tiling axis is the panel's width.
    .decl tile_size(k: number)
    tile_size(K) :- tile_axis(A), glyph_member(_, P), axis_dim(P, A, K).

    .decl glyph_member(id: Ident, p: Position)
    .decl glyph_color(id: Ident, col: Color)

    GRID_MASK_3x3(glyph_member, 0,
        1, 1, 1,
        1, _, 1,
        1, 1, 1)
    glyph_color(0, 3).

    GRID_MASK_3x3(glyph_member, 1,
        _, _, _,
        _, 1, _,
        _, _, _)
    glyph_color(1, 4).

    GRID_MASK_3x3(glyph_member, 2,
        _, _, 1,
        _, 1, _,
        1, _, _)
    glyph_color(2, 9).

    GRID_MASK_3x3(glyph_member, 3,
        1, 1, 1,
        _, _, _,
        _, _, _)
    glyph_color(3, 6).

    GRID_MASK_3x3(glyph_member, 4,
        _, _, _,
        _, _, _,
        1, 1, 1)
    glyph_color(4, 1).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)

    // The panel a cell sits in, with the cell's place inside it.
    .decl panel(key: Key, p_grid: Position, p_tile: Position, p_intile: Position)
    panel(K, P_grid, P_tile, P_intile) :-
        cell(K, P_grid, _),                                      // input cell
        params.tile_axis(A), params.tile_size(Sz),               // the strip's axis and panel width
        divide_by_size_slab(P_grid, A, Sz, 0, P_tile, P_intile).

    // A panel's glyph, as the set of its marked cells.
    .decl mark(key: Key, p_tile: Position, p_intile: Position)
    mark(K, P_tile, P_intile) :-
        cell(K, P_grid, Col), !params.bg(Col),                   // marked cell
        panel(K, P_grid, P_tile, P_intile).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl out(p: Position, col: Color)

.init glyph = KeyedSetCompare<Position, Ident, Position>
glyph.pattern_member(Id, P)      :- params.glyph_member(Id, P).
glyph.observed_member(P_tile, P) :- parse.mark($U(), P_tile, P).

out(P_grid, Col) :-
    parse.panel($U(), P_grid, P_tile, _),    // panel of the cell
    glyph.equals(P_tile, Id),                // its glyph is entry Id
    params.glyph_color(Id, Col).             // entry's color

.comp Determine {
    .type EP = [e: Example, tile: Position]

    // Train pairs only — the ex_out atom drops the test inputs.
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    .decl panel_mark(ep: EP, p: Position)
    panel_mark([E, P_tile], P) :- parse.mark(E, P_tile, P).

    // Panels carrying the same glyph share a catalog entry.
    .init same = KeyedSetCompare<EP, EP, Position>
    same.pattern_member(Ep, P)  :- panel_mark(Ep, P).
    same.observed_member(Ep, P) :- panel_mark(Ep, P).

    .init entry = Canon<EP>
    entry.equiv(Ep, Ep2) :- same.equals(Ep, Ep2).

    .decl glyph_member(id: Ident, p: Position)
    glyph_member(Id, P) :- entry.id(Ep, Id), panel_mark(Ep, P).

    .decl glyph_color(id: Ident, col: Color)
    glyph_color(Id, Col) :-
        entry.id([E, P_tile], Id),               // the panel's entry
        ex_out(E, P_grid, Col),                  // output cell
        parse.panel(E, P_grid, P_tile, _).       // its panel
}
