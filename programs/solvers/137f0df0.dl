// 137f0df0
// @keywords: lines span
// input: The input holds a field of blocks, cut by lines that carry no block.
// output: A block-free line that crosses the field's bounding box is painted
//  along its whole length: params.inside_paint where it crosses the box,
//  params.outside_paint on the stretches beyond. A block-free line clear of
//  the box is left alone.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // A block-free line where it crosses the field's box...
    .decl inside_paint(col: Color) inside_paint(2).

    // ...and where it runs beyond.
    .decl outside_paint(col: Color) outside_paint(1).
}

.init params = Params

.decl block(p: Position)
block(P) :- in(P, Col), !params.bg(Col).

.init bx = Bbox<Unit>
bx.cell($U(), P) :- block(P).

// A grid cell the field's box covers.
.decl covered(p: Position)
covered(P) :- bx.box($U(), B), in(P, _), inside(P, B).

// A cell whose line along axis a carries a block.
.decl block_line(a: Axis, p: Position)
block_line(A, P) :- in(P, _), axis_elem(A), block(Q), same_line(A, P, Q).

// A cell of a block-free line that crosses the field.
.decl gap_cell(p: Position)
gap_cell(P) :-
    in(P, _), axis_elem(A), !block_line(A, P),
    covered(Q), same_line(A, P, Q).   // the line meets the field's box

out(P, Col) :-
    gap_cell(P),
    ( covered(P), params.inside_paint(Col)     // inside the field's box
    ; !covered(P), params.outside_paint(Col)   // beyond it
    ).
out(P, Col) :- in(P, Col), !gap_cell(P).
