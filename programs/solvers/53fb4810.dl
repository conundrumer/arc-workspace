// 53fb4810
// draft
// keywords: objects markers wallpaper cast
// input: each band of cells that are neither background nor anchor color
//  rests against an anchor
// output: The band's pattern continues away from that anchor to the frame
//  edge, one period at a step, and covers whatever it lands on. Coincide on
//  every pair: each continuing band's shortest period is its extent, and
//  each band that shows a shorter one reaches the frame edge on its growth
//  side, so it continues under neither case.

// two models of the period
.type Choice =
    // the band as a whole is the repeating tile
    Extent {}
    // the tile is the shortest period the band's own pattern shows, read
    // through damage
  | Period {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(8).
    .decl anchor_color(c: Color) anchor_color(1).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Extent()). impl_choice($Period()).

.init bands = Components<Unit>
bands.node($U(), P) :- in(P, Col), !params.bg(Col), !params.anchor_color(Col).

// A band grows away from the anchor it rests against.
.decl grow_dir(id: Ident, d: Dir)
grow_dir(Id, D) :-
    bands.label($U(), P, Id),
    opposite(D, O), neighbor(P, O, Q),     // one step back
    in(Q, Col), params.anchor_color(Col).  // an anchor cell

.decl grow_axis(id: Ident, a: Axis)
grow_axis(Id, A) :- grow_dir(Id, D), axis_of(D, A).

.decl period(id: Ident, k: number, ch: Choice)

// The band's pattern carried onward, a period at a step.
.decl pattern(id: Ident, p: Position, col: Color, ch: Choice)
pattern(Id, P, Col, Ch) :- bands.label($U(), P, Id), in(P, Col), impl_choice(Ch).
pattern(Id, Q, Col, Ch) :-
    pattern(Id, P, Col, Ch), grow_dir(Id, D), period(Id, K, Ch),
    jump(P, D, K, Q), in(Q, _).

// What the continuation covers, past the band itself.
.decl beyond(p: Position, col: Color, ch: Choice)
beyond(P, Col, Ch) :- pattern(Id, P, Col, Ch), !bands.label($U(), P, Id).

out(P, Col, Ch) :-
    in(P, C), impl_choice(Ch),
    ( beyond(P, Col, Ch)                 // under a continuation
    ; !beyond(P, _, Ch), Col = C         // the input shows through
    ).

// --- $Extent ---

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- bands.label($U(), P, Id).

period(Id, K, $Extent()) :-
    bands.label($U(), P, Id), bbox.box(Id, B),   // the band's box, in the grid frame
    grow_axis(Id, A), box_extent(B, P, A, K).

// --- $Period ---

.init shift = OffsetInvariance<Ident, Color>
shift.cell(Id, P, Col) :- bands.label($U(), P, Id), in(P, Col).

.init shortest = Extremes<Ident>
shortest.cand(Id, K) :- grow_axis(Id, A), shift.period(Id, A, K).

period(Id, K, $Period()) :- shortest.low(Id, K).
