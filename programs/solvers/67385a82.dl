// 67385a82
// keywords: objects
// output: params.ink cells with an ink 4-neighbor become params.mark; lone ink
//  and bg pass through.

.decl out(p: Position, col: Color)

.comp Params {
    .decl ink(c: Color) ink(3).
    .decl mark(c: Color) mark(8).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), params.ink(Col).

// Ink cell with an ink 4-neighbor.
.decl grouped(p: Position)
grouped(P) :- ink(P), dir_elem(D), neighbor(P, D, P2), ink(P2).

out(P, Col) :- grouped(P), params.mark(Col).
out(P, Col) :- in(P, Col), !grouped(P).
