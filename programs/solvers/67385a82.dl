// 67385a82
// concept: objects
// c.ink cells with an ink 4-neighbor become c.mark; lone ink and bg pass
// through.

#include "../lib.dl"

.comp Consts {
    .decl ink(c: Color) ink(3).
    .decl mark(c: Color) mark(8).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl ink(p: Position)
ink(P) :- in(P, Col), c.ink(Col).

// Ink cell with an ink 4-neighbor.
.decl grouped(p: Position)
grouped(P) :- ink(P), dir_elem(D), step_delta(D, S), compose(P, S, P2), ink(P2).

.decl out(p: Position, col: Color)
out(P, Col) :- grouped(P), c.mark(Col).
out(P, Col) :- in(P, Col), !grouped(P).

.output out(IO=stdout)
