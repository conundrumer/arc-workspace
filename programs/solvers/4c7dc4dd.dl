// 4c7dc4dd
// @draft
// @keywords: objects induce parity span d4 repair
// input: Four square frames sit in a noisy field, each holding a panel of
//  drawn cells over unfilled ones. One panel is empty: it is the slot the
//  answer fills.
// output: Of the other three, two stand as a demonstration — one completion
//  rule carries the first onto the second exactly — and the answer is the
//  third panel read under that rule. The rules the input may demonstrate:
//  extend  — the marks lie on a canvas whose color is constant along both
//  diagonal families; the panel shows one half of it, and the completion
//  shows the other half.
//  span    — a mark on each side of an unfilled cell in its row or column
//  fills it, in the panel's own color.
//  reflect — the marks span a window of a pattern symmetric under D4; the
//  completion repeats that window at every image of it, and lays the
//  panel's own color over what no image reaches.

// The panel the demonstration leaves, read under the rule it demonstrates.
.decl out(p: Position, col: Color)

.comp Params {
    // The color of a panel's unfilled cells.
    .decl hole(col: Color) hole(0).
}

.init params = Params

// --- frames ---

// The rectangles each drawn color draws.
.init drect = Outlines<Color>
drect.node(Col, P) :- in(P, Col), !params.hole(Col).

// What a rectangle encloses.
.init bbox = Bbox<Box>
bbox.cell(Pan, P) :- drect.box(_, Pan), in(P, _), interior(P, Pan).

// A candidate panel: what a square rectangle encloses, read in the
// enclosed frame.
.decl cand(pan: Box, p_inner: Position, col: Color)
cand(Pan, P_inner, Col) :-
    bbox.cell(Pan, P_grid), in(P_grid, Col),
    bbox.box(Pan, B), crop(P_grid, B, P_inner),
    box_extent(B, P_grid, A, N), perp(A, A2),
    box_extent(B, P_grid, A2, N).                        // a square box

// A framed panel: a candidate holding an unfilled cell, with its side.
.decl cand_side(pan: Box, n: number)
cand_side(Pan, N) :-
    cand(Pan, _, Col), params.hole(Col),
    bbox.box(Pan, B), bbox.cell(Pan, P), box_extent(B, P, _, N).

// The panels are the largest of them; smaller frames sit inside their marks.
.init widest = ArgExtremes<Unit, Box>
widest.cand($U(), Pan, N) :- cand_side(Pan, N).

.decl panel(pan: Box)
panel(Pan) :- widest.high($U(), Pan, _).

// A panel's cells, the unfilled ones included.
.decl pval(pan: Box, p_inner: Position, col: Color)
pval(Pan, P_inner, Col) :- panel(Pan), cand(Pan, P_inner, Col).

// A drawn cell.
.decl mark(pan: Box, p_inner: Position, col: Color)
mark(Pan, P_inner, Col) :- pval(Pan, P_inner, Col), !params.hole(Col).

// A panel holding a drawing.
.decl content(pan: Box)
content(Pan) :- mark(Pan, _, _).

// The color a panel holds that another content panel does without.
.decl own(pan: Box, col: Color)
own(Pan, Col) :- mark(Pan, _, Col), content(Pan2), Pan != Pan2, !mark(Pan2, _, Col).

.type PanelCell = [pan: Box, p: Position]

// --- induce ---

// A catalog of parses, one per key: the parse that carries one object
// exactly onto a second stands demonstrated.
.comp Induce<Key, Obj, Val> {
    // Each object's cells, total over its frame.
    .decl cell(o: Obj, p: Position, v: Val)  // input

    // The rule's parse of an object, per key.
    .decl render(key: Key, o: Obj, p: Position, v: Val)  // input

    // The rule does not carry o onto o2.
    .decl defect(key: Key, o: Obj, o2: Obj)
    defect(Ky, O, O2) :-
        render(Ky, O, P, V),                          // a cell the rule reads
        cell(O2, P, V2), V != V2.                     // against the second object
    defect(Ky, O, O2) :-
        render(Ky, O, _, _),
        cell(O2, P, _), !render(Ky, O, P, _).         // a cell the rule leaves unread

    // The pair the input demonstrates the rule on.
    .decl demo(key: Key, o: Obj, o2: Obj)
    demo(Ky, O, O2) :-
        render(Ky, O, _, _), cell(O, _, _), cell(O2, _, _), O != O2,
        !defect(Ky, O, O2).
}

// The catalog's rules, keying Induce — the comp's own override of the type
// rule (see proposals/DemonstrationConsistency.md).
.type Rule = Extend {} | Span {} | Reflect {}

.init catalog = Induce<Rule, Box, Color>
catalog.cell(Pan, P_inner, Col) :- content(Pan), pval(Pan, P_inner, Col).

// --- extend ---

// The canvas the marks lie on: one color along a diagonal, chained across
// the two diagonal families.
.decl spread(pan: Box, p_inner: Position, col: Color)
spread(Pan, P_inner, Col) :- mark(Pan, P_inner, Col).
spread(Pan, Q, Col) :-
    spread(Pan, P, Col), diag_axis_elem(Da), same_line(Da, P, Q), pval(Pan, Q, _).

.init canvas = Unanimous<PanelCell, Color>
canvas.item([Pan, P_inner], Col) :- spread(Pan, P_inner, Col).

catalog.render($Extend(), Pan, P_inner, Col) :-
    pval(Pan, P_inner, V), params.hole(H),
    ( V = H, canvas.value([Pan, P_inner], Col)                   // unfilled: the canvas
    ; V != H, Col = H ).                                          // a mark: unfilled

// --- span ---

.init flank = Between<Box>
flank.cell(Pan, P_inner) :- pval(Pan, P_inner, _).
flank.mark(Pan, P_inner) :- mark(Pan, P_inner, _).
flank.axis(Pan, A) :- panel(Pan), axis_elem(A).

catalog.render($Span(), Pan, P_inner, Col) :- mark(Pan, P_inner, Col).
catalog.render($Span(), Pan, P_inner, Col) :-
    pval(Pan, P_inner, H), params.hole(H),
    ( flank.between(Pan, P_inner), own(Pan, Col)                 // flanked: the panel's own color
    ; !flank.between(Pan, P_inner), Col = H ).                   // else it stays unfilled

// --- reflect ---

// The window a panel shows: the box its marks span.
.init window = Bbox<Box>
window.cell(Pan, P_inner) :- mark(Pan, P_inner, _).

// What every D4 image of the window holds.
.decl repeat(pan: Box, p_inner: Position, col: Color)
repeat(Pan, Q, Col) :-
    pval(Pan, P_inner, Col), window.box(Pan, B), inside(P_inner, B),
    d4_elem(D), apply(D, P_inner, Q).

.init image = Unanimous<PanelCell, Color>
image.item([Pan, P_inner], Col) :- repeat(Pan, P_inner, Col).

catalog.render($Reflect(), Pan, P_inner, Col) :-
    pval(Pan, P_inner, _),
    ( image.value([Pan, P_inner], Col)                           // an image of the window
    ; !repeat(Pan, P_inner, _), own(Pan, Col) ).                 // out of every image's reach

// --- output ---

out(P_inner, Col) :-
    content(Pan), Pan != Pan1, Pan != Pan2,
    catalog.demo(R, Pan1, Pan2), catalog.render(R, Pan, P_inner, Col).
