// ae4f1146
// keywords: objects crop count rank select
// output: Solid blocks sit on bg. The block with the most mark-colored cells is
//  kept, cropped to its bounding box. The two models coincide when no blocks
//  touch, and diverge when blocks touch.

// what structure counts as a block
.type Choice =
    // a 4-adjacency component
    Object {}
    // an all-ink square window of side params.dim
  | Window {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(1).

    // --- $Window ---
    .init helpers = ParamsHelpers

    .decl dim(k: number) dim(3).
    .decl shape(p: Position)
    shape(P) :- dim(K), helpers.frame_pos([K, K], P).
}

.init params = Params

// --- $Object ---

.init comps = Components<Unit>
comps.node($U(), P) :- in(P, Col), !params.bg(Col).

.init comp_winner = Mode<Unit, Ident, Position>
comp_winner.item($U(), Id, P) :- comps.label($U(), P, Id), in(P, Col), params.mark(Col).

// Crop to the winner's bounding box.
.init view = Bbox<Unit>
view.cell($U(), P) :- comp_winner.mode($U(), Id), comps.label($U(), P, Id).

out(P_inner, Col, $Object()) :- in(P, Col), view.box($U(), B), crop(P, B, P_inner).

// --- $Window ---

// Placements where the square lands all-ink.
.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- in(P, Col), !params.bg(Col).
occ.shape($U(), P, $U()) :- params.shape(P).

// Cells of each window, at their in-window positions.
.decl window_cell(anchor: Position, p_inner: Position, p_grid: Position)
window_cell(A, S, P) :- occ.occurrence($U(), A), params.shape(S), compose(A, S, P).

.init window_winner = Mode<Unit, Position, Position>
window_winner.item($U(), A, P) :- window_cell(A, _, P), in(P, Col), params.mark(Col).

out(P_inner, Col, $Window()) :- window_winner.mode($U(), A), window_cell(A, P_inner, P), in(P, Col).
