// 72ca375d
// draft
// keywords: objects crop symmetry select
// input: pieces on params.bg, each 8-connected
// output: the crop of the one piece whose box content is symmetric

// where the symmetry test comes from — data-equivalent on this task, since the
// crop that params.sym fixes is the one crop with a symmetry
.type Choice =
    // the symmetry is task data: the crop fixed by params.sym
    Stored {}
    // symmetric-vs-asymmetric is the concept: the crop fixed by some nontrivial
    // D4 element
  | Any {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    // --- $Stored ---
    .decl sym(d: D4) sym(D4_LR).
}

.init params = Params

.init pieces = Components8<Unit>
pieces.node($U(), P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- pieces.label($U(), P, Id).

// The piece's crop: the content of its box, free of placement.
.decl cropped(id: Ident, p_inner: Position, col: Color)
cropped(Id, P_inner, Col) :- bbox.box(Id, B), in(P_grid, Col), crop(P_grid, B, P_inner).

// The crop's own symmetries.
.init inv = D4Map<Ident, Color>
inv.src(Id, P, Col) :- cropped(Id, P, Col).
inv.dst(Id, P, Col) :- cropped(Id, P, Col).

// The selected piece.
.decl chosen(id: Ident, ch: Choice)

// --- $Stored ---
chosen(Id, $Stored()) :- params.sym(D), inv.map(Id, D).

// --- $Any ---
chosen(Id, $Any()) :- inv.has_sym(Id).

out(P_inner, Col, Ch) :- chosen(Id, Ch), cropped(Id, P_inner, Col).
