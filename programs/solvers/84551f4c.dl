// 84551f4c
// @draft
// @keywords: objects walk d4 move chain
// input: Bars stand on the ground edge: runs of ink rising from it.
// output: A bar of the pusher color topples: it turns a quarter turn about
//  its base cell and lies along the ground. A standing bar that a toppled
//  bar's cell touches in the fall direction topples too, and the chain
//  continues. A toppled bar's cells clear, and its turned cells paint where
//  they land; every other cell keeps its input color.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).

    // The edge the bars stand on.
    .decl ground(d: Dir) ground(DIR_B).

    // The color whose bars topple on their own.
    .decl pusher(c: Color) pusher(1).

    // The sense a bar turns in when it topples.
    .decl topple(s: Sense) topple(SENSE_CW).

    // The way a standing bar points, and the way a toppled one lies.
    .decl up(d: Dir)
    up(D) :- ground(G), opposite(G, D).
    .decl fall(d: Dir)
    fall(D) :- up(U), topple(S), turn(S, U, D).
}

.init params = Params

// --- bars ---

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

// A bar's base: an inked cell on the ground edge.
.decl base(p: Position)
base(P) :- ink(P), params.ground(G), dist(P, G, 0).

// The run of ink rising from each base.
.init rise = Slide<Unit>
rise.node($U(), P) :- ink(P).
rise.dir($U(), D) :- params.up(D).

// Each bar's cells, keyed by its base.
.decl bar_cell(p_base: Position, p: Position)
bar_cell(P_base, P) :- base(P_base), ( P = P_base ; rise.run($U(), P_base, _, P) ).

// --- the topple chain ---

// Where each cell of a bar lands if the bar topples: turned about its base.
.decl fallen(p_base: Position, p: Position, col: Color)
fallen(P_base, P_out, Col) :-
    bar_cell(P_base, P), in(P, Col),
    params.topple(S), rotation(S, R4),
    relative(P_base, P, V), apply(R4, V, V2), compose(P_base, V2, P_out).

// The bars that topple: the pusher's bars, then each standing bar that a
// toppled bar's landed cell touches in the fall direction.
.init chain = GraphDistance<Unit, Position>
chain.seed($U(), P_base) :- base(P_base), in(P_base, Col), params.pusher(Col).
chain.edge($U(), P_base, P_base2) :-
    fallen(P_base, P, _), params.fall(D), neighbor(P, D, Q),   // a landed cell touches, in the fall direction,
    bar_cell(P_base2, Q).                                      // a cell of a standing bar

.decl toppled(p_base: Position)
toppled(P_base) :- chain.distance($U(), P_base, _).

.decl landed(p: Position, col: Color)
landed(P, Col) :- toppled(P_base), fallen(P_base, P, Col).

.decl cleared(p: Position)
cleared(P) :- toppled(P_base), bar_cell(P_base, P).

out(P, Col) :-
    in(P, Col_in),
    ( landed(P, Col)                                     // a turned cell lands here
    ; !landed(P, _), cleared(P), params.bg(Col)          // a toppled bar stood here
    ; !landed(P, _), !cleared(P), Col = Col_in           // untouched
    ).
