// 8618d23e
// concept: decompose grow lookup move
// The input's two halves along the stack axis pull apart diagonally:
// each half reseats in a grown frame, and the vacated band fills with
// params.filler. Choice cases, all data-equivalent here:
//   $Derive(g, s) — relative derived from a corner seat and growth:
//     g $Iso()     — one width: separator and lateral shift are the same
//                    parameter (params.sep)
//     g $Aniso()   — per-axis widths (params.sep_dim rows)
//     s $Derived() — each half seats at the params.diag corner on its own
//                    side of the stack
//     s $Table()   — explicit side → corner map (params.seat_of)
//   $Disp() — table: params.arr slabs along the stack axis, per-slab
//             relative vector (params.disp)

#include "../lib.dl"

.type Growth = Iso {} | Aniso {}
.type Seats  = Derived {} | Table {}
.type Choice = Derive { g: Growth, s: Seats } | Disp {}

.comp Params {
    .decl axis(a: Axis) axis(AXIS_V).      // stack axis
    .decl filler(c: Color) filler(9).

    // --- Derive / Iso ---
    .decl sep(g: number) sep(1).

    // --- Derive / Aniso ---
    .decl sep_dim(a: Axis, n: number)
    sep_dim(AXIS_V, 1). sep_dim(AXIS_H, 1).

    // --- Derive / Derived ---
    .decl diag(da: DiagAxis) diag(DAXIS_DG).      // seating diagonal

    // --- Derive / Table ---
    .decl seat_of(d: Dir, diag: DiagDir)
    seat_of(DIR_T, DIAG_TL). seat_of(DIR_B, DIAG_BR).

    // --- Disp ---
    .decl arr(n: number) arr(2).              // slabs along the stack axis
    .decl disp(p_tile: Position, delta: Position)
    disp([0, 1, 0, 0], [0, 1, 0, 1]).
    disp([1, 0, 0, 0], [1, 0, 1, 0]).
}

.init params = Params

.init dp = DiagPlacement<Unit>
dp.cell($U(), P) :- in(P, _).

// The half a cell belongs to, named by its side of the stack axis.
.decl side(p: Position, d: Dir)
side(P, D) :- params.axis(A), axis_of(D, A), dp.nearer($U(), P, D).

.decl seat(p: Position, diag: DiagDir, s: Seats)

// --- Derive / Derived ---
seat(P, Diag, $Derived()) :-
    side(P, D),                                       // cell's side of the stack
    params.diag(DA), diag_axis_of(Diag, DA),          // corner on the seating diag
    dir_of(Diag, _, D).                               // matching that side

// --- Derive / Table ---
seat(P, Diag, $Table()) :- side(P, D), params.seat_of(D, Diag).

// Growth extents, the wide axis-tagged pair: n1 along a, n2 across.
.decl growth(a: Axis, n1: number, n2: number, gr: Growth)

// --- Derive / Iso ---
growth(A, G, G, $Iso()) :- axis_elem(A), params.sep(G).

// --- Derive / Aniso ---
growth(A, N1, N2, $Aniso()) :- params.sep_dim(A, N1), perp(A, A2), params.sep_dim(A2, N2).

// Grow delta toward a corner: the growth extents at its two edges.
.decl grow_delta(diag: DiagDir, gr: Growth, e: Shift)
grow_delta(Diag, Gr, E) :-
    diag_dirs(Diag, A, D1, D2), growth(A, K1, K2, Gr),      // the corner's edges and their extents
    edge_inset(D1, K1, E1), edge_inset(D2, K2, E2),         // one edge delta each
    compose(E1, E2, E).

.decl seated(p_out: Position, col: Color, ch: Choice)

// --- Derive ---
// Displaced by the growth extents at both edges of the opposite corner —
// the frame grows away from the seat.
seated(P_out, Col, $Derive(Gr, S)) :-
    in(P, Col), seat(P, Diag, S),    // half cell and its corner
    diag_opposite(Diag, Diag2),      // opposite corner
    grow_delta(Diag2, Gr, E),        // grow delta toward it
    compose(P, E, P_out).            // displace

// --- Disp ---
seated(P_out, Col, $Disp()) :-
    in(P, Col),                                                         // slab cell
    params.axis(A), params.arr(N), divide_slab(P, A, N, 0, P_tile, _),  // its slab in the stack
    params.disp(P_tile, Delta), compose(P, Delta, P_out).               // displace by its vector

// Output frame extents, read off the seated images.
.init frame = Frame2D<Choice>
frame.extent(Ch, A, N) :- seated(P, _, Ch), axis_elem(A), axis_dim(P, A, N).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- seated(P, Col, Ch).
out(P, Col, Ch) :- frame.cell(Ch, P), !seated(P, _, Ch), params.filler(Col).

.comp Determine {
    // Train input cells in the slabs of each candidate stack axis.
    .decl slab_cell(e: Example, a: Axis, p_tile: Position, p: Position, col: Color)
    slab_cell(E, A, P_tile, P, Col) :-
        ex_in(E, P, Col), ex_out(E, _, _),
        axis_elem(A), params.arr(N), divide_slab(P, A, N, 0, P_tile, _).

    // One train pair's slab, on one candidate stack axis.
    .type SlabKey = [e: Example, a: Axis, p_tile: Position]

    // Seat each slab among its output's cells, color for color.
    .init occ = Occurrences<SlabKey, Color>
    occ.shape([E, A, P_tile], P, Col) :- slab_cell(E, A, P_tile, P, Col).
    occ.cell([E, A, P_tile], P_out, Col) :-
        slab_cell(E, A, P_tile, _, _), ex_out(E, P_out, Col).

    // A relative some train pair's slab does not seat.
    .decl broken(a: Axis, p_tile: Position, delta: Inset)
    broken(A, P_tile, Delta) :-
        occ.occurrence([_, A, P_tile], Delta),    // seats one pair's slab
        slab_cell(E, A, P_tile, _, _),            // and a train pair's slab
        !occ.occurrence([E, A, P_tile], Delta).   // it misses

    .decl slab_disp(a: Axis, p_tile: Position, delta: Inset)
    slab_disp(A, P_tile, Delta) :-
        occ.occurrence([_, A, P_tile], Delta), !broken(A, P_tile, Delta).

    // A candidate axis with a slab that no relative places.
    .decl axis_broken(a: Axis)
    axis_broken(A) :- slab_cell(_, A, P_tile, _, _), !slab_disp(A, P_tile, _).

    .decl axis(a: Axis)
    axis(A) :- axis_elem(A), !axis_broken(A).

    .decl disp(p_tile: Position, delta: Position)
    disp(P_tile, Delta) :- axis(A), slab_disp(A, P_tile, Delta).

    // The frame grows at the edges a relative moves away from.
    .decl sep_dim(a: Axis, n: number)
    sep_dim(A, N) :- disp(_, Delta), axis_of(D, A), dist(Delta, D, N), N != 0.

    // A slab seats at the corner whose two edges its relative leaves alone.
    .decl seat(p_tile: Position, diag: DiagDir)
    seat(P_tile, Diag) :- disp(P_tile, Delta), diag_dist(Delta, Diag, _, 0, 0).

    .decl seat_of(d: Dir, diag: DiagDir)
    seat_of(D, Diag) :-
        seat(P_tile, Diag),
        axis(A), axis_of(D, A), dist(P_tile, D, 0).   // the slab's side of the stack

    .decl diag(da: DiagAxis)
    diag(DA) :- seat(_, Diag), diag_axis_of(Diag, DA).
}
