// 8618d23e
// concept: decompose grow lookup move
// The input's two halves along the stack axis pull apart diagonally:
// each half reseats in a grown frame, and the vacated band fills with
// c.filler. Choice cases, all data-equivalent here:
//   $Derive(g, s) — displacement derived from a corner seat and growth:
//     g $Iso()     — one width: separator and lateral shift are the same
//                    parameter (c.sep)
//     g $Aniso()   — per-axis widths (c.sep_dim rows)
//     s $Derived() — each half seats at the c.diag corner on its own
//                    side of the stack
//     s $Table()   — explicit side → corner map (c.seat_of)
//   $Disp() — data-leaning: c.arr slabs along the stack axis, per-slab
//             displacement vector (c.disp)

#include "../lib.dl"

.type Growth = Iso {} | Aniso {}
.type Seats  = Derived {} | Table {}
.type Choice = Derive { g: Growth, s: Seats } | Disp {}

.comp Consts {
    .decl axis(a: Axis) axis(AXIS_V).      // stack axis
    .decl filler(c: Color) filler(9).

    // --- Derive / Iso ---
    .decl sep(g: number) sep(1).

    // --- Derive / Aniso ---
    .decl sep_dim(a: Axis, n: number)
    sep_dim(AXIS_V, 1). sep_dim(AXIS_H, 1).

    // --- Derive / Derived ---
    .decl diag(da: DiagAxis) diag(DAXIS_DG).      // seating diagonal

    // --- Derive / Table ---
    .decl seat_of(d: Dir, diag: DiagDir)
    seat_of(DIR_T, DIAG_TL). seat_of(DIR_B, DIAG_BR).

    // --- Disp ---
    .decl arr(n: number) arr(2).              // slabs along the stack axis
    .decl disp(p_tile: Position, delta: Position)
    disp([0, 1, 0, 0], [0, 1, 0, 1]).
    disp([1, 0, 0, 0], [1, 0, 1, 0]).
}

.init c = Consts

.init dp = DiagPlacement<Unit>
dp.cell($U(), P) :- in(P, _).

// The half a cell belongs to, named by its side of the stack axis.
.decl side(p: Position, d: Dir)
side(P, D) :- c.axis(A), axis_of(D, A), dp.nearer($U(), P, D).

.decl seat(p: Position, diag: DiagDir, s: Seats)

// --- Derive / Derived ---
seat(P, Diag, $Derived()) :-
    side(P, D),                                  // cell's side of the stack
    c.diag(DA), diag_axis_of(Diag, DA),          // corner on the seating diag
    dir_of(Diag, _, D).                          // matching that side

// --- Derive / Table ---
seat(P, Diag, $Table()) :- side(P, D), c.seat_of(D, Diag).

// Growth extents, the wide axis-tagged pair: n1 along a, n2 across.
.decl growth(a: Axis, n1: number, n2: number, gr: Growth)

// --- Derive / Iso ---
growth(A, G, G, $Iso()) :- axis_elem(A), c.sep(G).

// --- Derive / Aniso ---
growth(A, N1, N2, $Aniso()) :- c.sep_dim(A, N1), perp(A, A2), c.sep_dim(A2, N2).

// Corner edge delta: a Position holding extents at the two edges of
// corner diag, axis-tagged — edge_delta's DiagDir peer. Lib candidate.
.comp DiagEdgeDelta<Key> {
    .decl arg(key: Key, diag: DiagDir, a: Axis, k1: number, k2: number)

    .decl delta(key: Key, diag: DiagDir, a: Axis, k1: number, k2: number, p: Position)
    delta(Ky, Diag, A, K1, K2, P) :-
        arg(Ky, Diag, A, K1, K2),
        diag_dirs(Diag, A, D1, D2),
        edge_delta(D1, K1, P1), edge_delta(D2, K2, P2),
        compose(P1, P2, P).
}

.init ded = DiagEdgeDelta<Growth>
ded.arg(Gr, Diag, A, K1, K2) :- diag_dir_elem(Diag), growth(A, K1, K2, Gr).

.decl seated(p_out: Position, col: Color, ch: Choice)

// --- Derive ---
// Displaced by the growth extents at both edges of the opposite corner —
// the frame grows away from the seat.
seated(P_out, Col, $Derive(Gr, S)) :-
    in(P, Col), seat(P, Diag, S),                                // half cell and its corner
    diag_opposite(Diag, Diag2),                                  // opposite corner
    growth(A, K1, K2, Gr), ded.delta(Gr, Diag2, A, K1, K2, E),   // grow delta toward it
    compose(P, E, P_out).                                        // displace

// --- Disp ---
seated(P_out, Col, $Disp()) :-
    in(P, Col),                                               // slab cell
    c.axis(A), c.arr(N), divide_slab(P, A, N, 0, P_tile, _),  // its slab in the stack
    c.disp(P_tile, Delta), compose(P, Delta, P_out).          // displace by its vector

// Output frame extents, read off the seated images.
.init frame = Frame2D<Choice>
frame.extent(Ch, A, N) :- seated(P, _, Ch), axis_elem(A), axis_dim(P, A, N).

.decl covered(p: Position, ch: Choice)
covered(P, Ch) :- seated(P, _, Ch).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- seated(P, Col, Ch).
out(P, Col, Ch) :- frame.cell(Ch, P), !covered(P, Ch), c.filler(Col).
