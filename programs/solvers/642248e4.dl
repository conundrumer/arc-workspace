// 642248e4
// @draft
// @keywords: lines markers rank
// input: Two opposite edges of the grid each carry a solid line in its own
//  color, and marks are scattered over the interior.
// output: Each mark grows one cell toward the nearer of the two lines, in
//  that line's color.

.decl out(p: Position, col: Color)

.comp Params {
    // The scattered cells that grow toward a line.
    .decl mark(col: Color) mark(1).
}

.init params = Params

// An edge of two colors is no line.
.init line = Unanimous<Dir, Color>
line.item(D, Col) :- dir_elem(D), in(P, Col), dist(P, D, 0).   // a cell on edge D

// The cell a mark grows, in the color of the line it grew toward.
.decl tail(p: Position, col: Color)
tail(Q, Col) :-
    in(P, Col_mark), params.mark(Col_mark),               // a mark
    line.value(D, Col), dist_pair(P, D, K, K2), K < K2,   // its nearer line
    neighbor(P, D, Q).                                    // the cell on that side

out(P, Col) :-
    in(P, Col_in),
    ( tail(P, Col)                 // a grown cell
    ; !tail(P, _), Col = Col_in    // untouched
    ).
