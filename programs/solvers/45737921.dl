// 45737921
// draft
// keywords: objects mapping
// input: Objects of two colors sit on the background.
// output: Each object cell takes its object's other color; the background
//  stands.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl figure(p: Position, col: Color)
figure(P, Col) :- in(P, Col), !params.bg(Col).

.init obj = Components<Unit>
obj.node($U(), P) :- figure(P, _).

.decl obj_color(id: Ident, col: Color)
obj_color(Id, Col) :- obj.label($U(), P, Id), figure(P, Col).

.decl swap(id: Ident, col: Color, col2: Color)
swap(Id, C, C2) :- obj_color(Id, C), obj_color(Id, C2), C != C2.

out(P, C2) :- obj.label($U(), P, Id), figure(P, C), swap(Id, C, C2).
out(P, C) :- in(P, C), params.bg(C).
