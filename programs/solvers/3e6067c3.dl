// 3e6067c3
// @draft
// @keywords: objects markers walk route chain
// input: boxes holding a colored label, and single cells spelling a color
//  sequence
// output: Consecutive entries of the sequence name boxes that a clear
//  straight corridor joins, and each crossed corridor fills with the color of
//  the box the walk leaves.

// whether the walk must complete the whole sequence to count, or paints as
// far as it gets
.type Choice =
    // the sequence is a complete route, so a slot stands only on boxes the rest
    // of the sequence can still be walked from
    Route {}
    // the sequence is walked from its start for as far as corridors carry it,
    // so a branch that dies still paints what it crossed
  | Walk {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The edge the sequence reads from.
    .decl seq_dir(d: Dir) seq_dir(DIR_L).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Route()). impl_choice($Walk()).

// The background is the commonest color; what is drawn on it is ink.
.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl ink(p: Position)
ink(P) :- in(P, Col), !bg_mode.mode($U(), Col).

// Most of the ink goes into the boxes.
.init box_mode = Mode<Unit, Color, Position>
box_mode.item($U(), Col, P) :- ink(P), in(P, Col).

.decl box(col: Color)
box(Col) :- box_mode.mode($U(), Col).

// --- boxes and labels ---

.init comps = Components<Unit>
comps.node($U(), P) :- ink(P).

// A component built from the box color is a box; the rest spell the sequence.
.decl is_box(id: Ident)
is_box(Id) :- comps.label($U(), P, Id), in(P, Col), box(Col).

.decl box_cell(id: Ident, p: Position)
box_cell(Id, P) :- is_box(Id), comps.label($U(), P, Id).

.decl label_cell(id: Ident, p: Position)
label_cell(Id, P) :- box_cell(Id, P), in(P, Col), !box(Col).

.decl label_color(id: Ident, col: Color)
label_color(Id, Col) :- label_cell(Id, P), in(P, Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- box_cell(Id, P).

// --- corridors ---

// The lines of each axis that a box's label occupies, axis-only across the
// axis.
.decl label_line(id: Ident, a: Axis, l: Position)
label_line(Id, A, L) :- label_cell(Id, Q), axis_elem(A), split(Q, A, _, L).

// The cells past a box's side toward a direction, on a line of that
// direction's axis that the box's label occupies.
.decl facing(id: Ident, d: Dir, p: Position)
facing(Id, D, P) :-
    in(P, _), dir_elem(D), axis_of(D, A), split(P, A, _, L),  // a cell, its line
    label_line(Id, A, L),                                     // a label's line
    bbox.box(Id, B), nearer(D, P, B).                         // past the box's side

// The cells strictly between two boxes, on the lines both labels occupy.
.decl corridor(id: Ident, id2: Ident, p: Position)
corridor(Id, Id2, P) :- facing(Id, D, P), opposite(D, D_opp), facing(Id2, D_opp, P).

.decl obstructed(id: Ident, id2: Ident)
obstructed(Id, Id2) :- corridor(Id, Id2, P), ink(P).

// Boxes a clear corridor joins.
.decl joined(id: Ident, id2: Ident)
joined(Id, Id2) :- corridor(Id, Id2, _), !obstructed(Id, Id2).

// --- the sequence ---

.decl seq_cell(p: Position)
seq_cell(P) :- comps.label($U(), P, Id), !is_box(Id).

.init seq = Order<Unit, Position>
seq.elem($U(), P) :- seq_cell(P).
seq.before($U(), P, Q) :-
    seq_cell(P), seq_cell(Q), params.seq_dir(D), nearer(D, P, Q).

// The boxes a slot names.
.decl names(l: Position, id: Ident)
names(L, Id) :- seq_cell(L), in(L, Col), label_color(Id, Col).

// --- the walk ---

// A slot of the sequence and a box it names.
.type Stop = [l: Position, id: Ident]

// A box a slot may stand on.
.decl cand(l: Position, id: Ident, ch: Choice)

// The boxes the walk stands on, having come from the sequence's start: each
// hop crosses a corridor to a box the next slot may stand on.
.init walk = Propagation<Choice, Stop>
walk.source(Ch, [L0, Id0]) :- cand(L0, Id0, Ch), seq.first($U(), L0).
walk.edge(Ch, [L2, Id2], [L, Id]) :-
    cand(L2, Id2, Ch), seq.next($U(), L2, L), cand(L, Id, Ch), joined(Id2, Id).

// --- output ---

.decl fill(p: Position, col: Color, ch: Choice)
fill(P, Col, Ch) :-
    walk.reached(Ch, [L, Id]), seq.next($U(), L, L2), walk.reached(Ch, [L2, Id2]),   // consecutive stops
    joined(Id, Id2), corridor(Id, Id2, P),                   // the clear corridor between them
    label_color(Id, Col).                                    // painted by the box it leaves

out(P, Col, Ch) :- fill(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !fill(P, _, Ch).

// --- $Route ---

// The rest of the sequence is still walkable from the box: traced back from
// a box the last slot names, each hop crosses a corridor to a box the
// previous slot names.
.init route = Propagation<Unit, Stop>
route.source($U(), [L, Id]) :- seq.last($U(), L), names(L, Id).
route.edge($U(), [L2, Id2], [L, Id]) :-
    names(L, Id), seq.next($U(), L, L2), names(L2, Id2), joined(Id, Id2).

cand(L, Id, $Route()) :- route.reached($U(), [L, Id]).

// --- $Walk ---

// Any box the slot names.
cand(L, Id, $Walk()) :- names(L, Id).
