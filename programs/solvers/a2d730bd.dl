// a2d730bd
// @draft
// @keywords: objects markers span stamp rank
// @scene background: the most frequent color fills the grid, and its value
//  differs between inputs
// @scene blocks: each non-background color forms one solid rectangle, at least
//  two cells in each dimension
// @scene dots: every other non-background cell is a single cell (no 8-neighbor
//  of a non-background color), and its color is the color of one block
// @scene aligned: each dot's row lies in its block's row span, or its column
//  lies in its block's column span; the dot lies outside the block, at least
//  two cells from it
// @rule connect: for each dot, let d be the cardinal direction from its
//  same-color block to the dot, along the axis where the dot is outside the
//  block's span
// @rule foot: the cell just outside the block's side facing the dot, on the
//  dot's line, and its two neighbors across d take the dot's color
// @rule line: every cell on the dot's line strictly between the block and the
//  dot takes the dot's color
// @rule head: the dot's two neighbors across d and its neighbor one step
//  further along d take the dot's color
// @rule clear: the dot's own cell becomes background
// @rule keep: every other cell keeps its input color

// what a dot outside both spans of its block gives
.type Unaligned =
    // @claim aligned connect
    NeedAligned {}
    // @rule connect: d is the direction of the block's side with the smallest
    //  gap to the dot, and the foot and the line stand on the dot's row or
    //  column even when it misses the block. Undefined when two sides tie.
    // @witness unaligned-dot: borderline $SkipUnaligned
    //     @relaxed aligned
  | NearestFace {}
    // @rule unaligned: a dot outside both spans of its block keeps its input
    //  color
    // @witness unaligned-dot: borderline $SkipUnaligned
  | SkipUnaligned {}

// what a dot with no block of its color gives
.type Orphan =
    // @claim dots
    NeedBlock {}
    // @rule orphan: a dot with no block of its color keeps its input color
    // @witness orphan-dot: borderline $SkipOrphan
    //     @relaxed dots
  | SkipOrphan {}

// which block a dot connects to when its color has more than one
.type Several =
    // @claim blocks connect
    SoleBlock {}
    // @rule connect: the dot connects to the nearest block of its color that
    //  it is aligned with. Undefined when two tie on the gap. When none is
    //  aligned, NearestFace connects it to the block with the smallest gap, and
    //  SkipUnaligned keeps the dot.
    // @witness two-blocks: borderline $AlignedBlock
    //     @relaxed blocks
  | AlignedBlock {}

// which solid rectangles are blocks
.type Thin =
    // @claim blocks
    ThickBlock {}
    // @scene blocks: a solid rectangle of two or more cells is a block at any
    //  width
    // @witness thin-block: variant $ThinBlock
    //     @relaxed blocks
  | ThinBlock {}

// what a drawing does to a cell that is not background in the input
.type Content =
    // @claim foot line head
    PaintOver {}
    // @rule foot: only the foot cells that are background in the input take
    //  the dot's color
    // @rule line: only the line cells that are background in the input take
    //  the dot's color
    // @rule head: only the head cells that are background in the input take
    //  the dot's color
    // @witness line-over-block: variant concept
  | PaintBgOnly {}

.type Choice = [unaligned: Unaligned, orphan: Orphan, several: Several, thin: Thin,
                content: Content]

// A dot under one case.
.type Sighting = [ch: Choice, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The drawing, in the frame where the dot lies toward `aim` from its block:
    // the foot around the first cell outside the block, and the head around
    // the dot.
    RIGID(draw,
        .decl aim(d: Dir) aim(DIR_B).
        .decl foot_offsets(v: Offset)
        GRID_STAMP_1x3(foot_offsets,
            1, @1, 1)
        .decl head_offsets(v: Offset)
        GRID_STAMP_2x3(head_offsets,
            1, @_, 1,
            _, 1, _)
    )

    // The foot and head offsets for a dot toward D from its block.
    .decl foot(d: Dir, v: Offset)
    foot(D, V) :- draw_aim(G, D), draw_foot_offsets(G, V).
    .decl head(d: Dir, v: Offset)
    head(D, V) :- draw_aim(G, D), draw_head_offsets(G, V).
}

.init params = Params

.decl unaligned_choice(u: Unaligned)
unaligned_choice($NeedAligned()). unaligned_choice($NearestFace()). unaligned_choice($SkipUnaligned()).

.decl several_choice(s: Several)
several_choice($SoleBlock()). several_choice($AlignedBlock()).

.decl content_choice(co: Content)
content_choice($PaintOver()). content_choice($PaintBgOnly()).

// The concept case, and the cases that take SkipOrphan and ThinBlock
// with a non-concept branch at Unaligned and at Several. Every
// other case is subsumed: wherever it is defined, the case with those
// branches in place of its concept branches gives the same grid.
.decl impl_choice(ch: Choice)
impl_choice([$NeedAligned(), $NeedBlock(), $SoleBlock(), $ThickBlock(), $PaintOver()]).
impl_choice([U, $SkipOrphan(), S, $ThinBlock(), Co]) :-
    unaligned_choice(U), U != $NeedAligned(), several_choice(S), S != $SoleBlock(),
    content_choice(Co).

// The pieces, the blocks and the dots, and the drawing a dot makes from a
// block.
.comp Parse<Key> {
    .type Tint = [ky: Key, col: Color]
    .type Piece = [ky: Key, id: Ident]

    .decl cell(ky: Key, p: Position, col: Color)

    // The offsets a drawing toward D stamps around the foot's center and
    // around the dot.
    .decl foot_at(d: Dir, v: Offset)
    .decl head_at(d: Dir, v: Offset)

    // The background: the commonest color.
    // @claim background
    .init ground = Mode<Key, Color, Position>
    ground.item(Ky, Col, P) :- cell(Ky, P, Col).

    // The pieces: the edge-joined parts of each non-background color.
    // @claim blocks dots
    .init pieces = Components<Tint>
    pieces.node([Ky, Col], P) :- cell(Ky, P, Col), !ground.mode(Ky, Col).

    // The cells of each piece.
    .decl part(ky: Key, id: Ident, p: Position, col: Color)
    part(Ky, Id, P, Col) :- pieces.label([Ky, Col], P, Id).

    // @claim blocks connect
    .init box = Bbox<Piece>
    box.cell([Ky, Id], P) :- part(Ky, Id, P, _).

    // Cell P of piece Id has a cell of the piece next to it toward D.
    .decl joined(ky: Key, id: Ident, p: Position, d: Dir)
    joined(Ky, Id, P, D) :-
        part(Ky, Id, P, _), dir_elem(D), neighbor(P, D, Q), part(Ky, Id, Q, _).

    // A cell of the piece's box lies outside the piece.
    .decl hole(ky: Key, id: Ident)
    hole(Ky, Id) :-
        box.box([Ky, Id], B), cell(Ky, P, _), inside(P, B), !part(Ky, Id, P, _).

    // A piece of one cell.
    .decl single(ky: Key, p: Position, col: Color)
    single(Ky, P, Col) :- part(Ky, Id, P, Col), !joined(Ky, Id, P, _).

    // The blocks under each reading of blocks.
    .decl block(ky: Key, t: Thin, id: Ident, col: Color)

    // Dot P lies past block Id's side toward D, at margin K from that side.
    .decl beyond(ky: Key, p: Position, id: Ident, d: Dir, k: number)
    beyond(Ky, P, Id, D, K) :-
        single(Ky, P, Col), block(Ky, _, Id, Col), box.box([Ky, Id], B), relative(B, P, P_rel),
        dir_elem(D), dist(P_rel, D, K), K < 0.

    // The dot lies past a side of the block on axis A.
    .decl off_span(ky: Key, p: Position, id: Ident, a: Axis)
    off_span(Ky, P, Id, A) :- beyond(Ky, P, Id, D, _), axis_of(D, A).

    // The dot lies in the block's span across D, so D runs from the block to
    // the dot.
    .decl aligned(ky: Key, p: Position, id: Ident, d: Dir)
    aligned(Ky, P, Id, D) :-
        beyond(Ky, P, Id, D, _), axis_of(D, A), perp(A, A2), !off_span(Ky, P, Id, A2).

    // Another side of the block lies as near the dot as the side toward D, or
    // nearer.
    .decl rival(ky: Key, p: Position, id: Ident, d: Dir)
    rival(Ky, P, Id, D) :- beyond(Ky, P, Id, D, K), beyond(Ky, P, Id, D2, K2), D2 != D, K2 >= K.

    // The block's side nearest the dot, when no other side ties it.
    .decl face(ky: Key, p: Position, id: Ident, d: Dir)
    face(Ky, P, Id, D) :- beyond(Ky, P, Id, D, _), !rival(Ky, P, Id, D).

    // The dot's gap to the block: the margin from the block's nearest side.
    .decl gap(ky: Key, p: Position, id: Ident, k: number)
    gap(Ky, P, Id, K) :- beyond(Ky, P, Id, D, K), ( face(Ky, P, Id, D) ; !face(Ky, P, Id, _) ).

    // The cells from the block's side to the dot, on the dot's line: past the
    // side, and short of the dot.
    .decl stretch(ky: Key, p: Position, id: Ident, d: Dir, x: Position)
    stretch(Ky, P, Id, D, X) :-
        beyond(Ky, P, Id, D, _), box.box([Ky, Id], B), axis_of(D, A), cell(Ky, X, _),
        same_line(A, P, X), relative(B, X, X_rel), dist(X_rel, D, K), K < 0, nearer(D, P, X).

    // The foot's center: the stretch cell next to the block's side.
    .decl foot(ky: Key, p: Position, id: Ident, d: Dir, f: Position)
    foot(Ky, P, Id, D, F) :-
        stretch(Ky, P, Id, D, F), opposite(D, D_back), neighbor(F, D_back, G),
        !stretch(Ky, P, Id, D, G).

    // Dot P drawing from block Id toward D gives cell X color Col: the foot,
    // the line and the head in the dot's color, and the background at its own
    // cell.
    .decl stroke(ky: Key, p: Position, id: Ident, d: Dir, x: Position, col: Color)
    stroke(Ky, P, Id, D, X, Col) :-
        beyond(Ky, P, Id, D, _), single(Ky, P, Col_dot),
        ( foot(Ky, P, Id, D, F), foot_at(D, V), compose(F, V, X), cell(Ky, X, _), Col = Col_dot
        ; stretch(Ky, P, Id, D, X), Col = Col_dot
        ; head_at(D, V), compose(P, V, X), cell(Ky, X, _), Col = Col_dot
        ; X = P, ground.mode(Ky, Col)
        ).

    // --- $ThickBlock, $AlignedBlock ---
    // Cell P of piece Id has a cell of the piece next to it on axis A.
    .decl joined_on(ky: Key, id: Ident, p: Position, a: Axis)
    joined_on(Ky, Id, P, A) :- joined(Ky, Id, P, D), axis_of(D, A).

    // A piece one cell wide on some axis.
    .decl slim(ky: Key, id: Ident)
    slim(Ky, Id) :- part(Ky, Id, P, _), axis_elem(A), !joined_on(Ky, Id, P, A).

    block(Ky, $ThickBlock(), Id, Col) :-
        part(Ky, Id, _, Col), !hole(Ky, Id), !slim(Ky, Id).

    // --- $ThinBlock ---
    block(Ky, $ThinBlock(), Id, Col) :-
        part(Ky, Id, P, Col), joined(Ky, Id, P, _), !hole(Ky, Id).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).
parse.foot_at(D, V) :- params.foot(D, V).
parse.head_at(D, V) :- params.head(D, V).

// The dots under each case.
.decl dot(ch: Choice, p: Position, col: Color)
dot(Ch, P, Col) :- impl_choice(Ch), parse.single($U(), P, Col).

// Dot P and a block of its color.
.decl own(ch: Choice, p: Position, id: Ident)
own([U, O, S, T, Co], P, Id) :-
    dot([U, O, S, T, Co], P, Col), parse.block($U(), T, Id, Col).

// The dot's color has more than one block.
.decl several(ch: Choice, p: Position)
several(Ch, P) :- own(Ch, P, Id), own(Ch, P, Id2), Id != Id2.

// The block dot P connects to under case Ch.
.decl pick(ch: Choice, p: Position, id: Ident)
pick(Ch, P, Id) :- own(Ch, P, Id), !several(Ch, P).

// Dot P keeps its color under case Ch.
.decl skip(ch: Choice, p: Position)

// Dot P draws from block Id toward D under case Ch.
.decl link(ch: Choice, p: Position, id: Ident, d: Dir)
link(Ch, P, Id, D) :- pick(Ch, P, Id), parse.aligned($U(), P, Id, D).

// The cells a case's dot paints, with their colors.
.decl draw(ch: Choice, p: Position, x: Position, col: Color)

// A cell the case does not read, which leaves it no grid: a dot that neither
// draws nor keeps its color, or a cell of a piece that is neither a block nor
// a single cell.
.decl blank(ch: Choice, x: Position)
blank(Ch, X) :- impl_choice(Ch), dot(Ch, X, _), !link(Ch, X, _, _), !skip(Ch, X).
blank([U, O, S, T, Co], X) :-
    impl_choice([U, O, S, T, Co]), parse.part($U(), Id, X, _),
    !dot([U, O, S, T, Co], X, _), !parse.block($U(), T, Id, _).

// Each cell under each case: painted, or else its input color.
out(X, Col, Ch) :-
    impl_choice(Ch),
    ( draw(Ch, _, X, Col)
    ; in(X, Col), !draw(Ch, _, X, _)
    ), !blank(Ch, X).

// --- $NearestFace ---
link([$NearestFace(), O, S, T, Co], P, Id, D) :-
    pick([$NearestFace(), O, S, T, Co], P, Id), parse.face($U(), P, Id, D).

// --- $SkipUnaligned ---
skip([$SkipUnaligned(), O, S, T, Co], P) :-
    pick([$SkipUnaligned(), O, S, T, Co], P, Id), !parse.aligned($U(), P, Id, _).

// --- $SkipOrphan ---
skip([U, $SkipOrphan(), S, T, Co], P) :-
    dot([U, $SkipOrphan(), S, T, Co], P, _), !own([U, $SkipOrphan(), S, T, Co], P, _).

// --- $AlignedBlock ---
// The nearest blocks of the dot's color that it is aligned with.
// @claim connect
.init near_aligned = ArgExtremes<Sighting, Ident>
near_aligned.cand([Ch, P], Id, K) :-
    several(Ch, P), own(Ch, P, Id), parse.aligned($U(), P, Id, _), parse.gap($U(), P, Id, K).

// Two aligned blocks tie on the gap.
.decl aligned_tie(ch: Choice, p: Position)
aligned_tie(Ch, P) :-
    near_aligned.high([Ch, P], Id, _), near_aligned.high([Ch, P], Id2, _), Id != Id2.

pick([U, O, $AlignedBlock(), T, Co], P, Id) :-
    near_aligned.high([[U, O, $AlignedBlock(), T, Co], P], Id, _),
    !aligned_tie([U, O, $AlignedBlock(), T, Co], P).

// --- $NearestFace & $AlignedBlock ---
// The nearest blocks of the dot's color, when none is aligned with it.
// @claim connect
.init near_any = ArgExtremes<Sighting, Ident>
near_any.cand([Ch, P], Id, K) :-
    several(Ch, P), !near_aligned.cand([Ch, P], _, _), own(Ch, P, Id), parse.gap($U(), P, Id, K).

.decl any_tie(ch: Choice, p: Position)
any_tie(Ch, P) :- near_any.high([Ch, P], Id, _), near_any.high([Ch, P], Id2, _), Id != Id2.

pick([$NearestFace(), O, $AlignedBlock(), T, Co], P, Id) :-
    near_any.high([[$NearestFace(), O, $AlignedBlock(), T, Co], P], Id, _),
    !any_tie([$NearestFace(), O, $AlignedBlock(), T, Co], P).

// --- $SkipUnaligned & $AlignedBlock ---
skip([$SkipUnaligned(), O, $AlignedBlock(), T, Co], P) :-
    several([$SkipUnaligned(), O, $AlignedBlock(), T, Co], P),
    !near_aligned.cand([[$SkipUnaligned(), O, $AlignedBlock(), T, Co], P], _, _).

// --- $PaintOver ---
draw([U, O, S, T, $PaintOver()], P, X, Col) :-
    link([U, O, S, T, $PaintOver()], P, Id, D), parse.stroke($U(), P, Id, D, X, Col).

// --- $PaintBgOnly ---
draw([U, O, S, T, $PaintBgOnly()], P, X, Col) :-
    link([U, O, S, T, $PaintBgOnly()], P, Id, D), parse.stroke($U(), P, Id, D, X, Col),
    ( in(X, Bg), parse.ground.mode($U(), Bg)     // a background cell
    ; X = P                                      // the dot's own cell
    ).

.comp Determine {
    // A dot of one example.
    .type Sighting = [e: Example, p: Position]
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).
    parse.foot_at(D, V) :-
        draw_aim(E, P, D0), apply_dir(G, D0, D), draw_foot_offsets(E, P, V0), apply(G, V0, V).
    parse.head_at(D, V) :-
        draw_aim(E, P, D0), apply_dir(G, D0, D), draw_head_offsets(E, P, V0), apply(G, V0, V).

    // A color with more than one block under reading T.
    .decl twin(e: Example, t: Thin, col: Color)
    twin(E, T, Col) :- parse.block(E, T, Id, Col), parse.block(E, T, Id2, Col), Id != Id2.

    // A dot as the concept reads it: one cell, whose color has one block,
    // aligned with it toward D.
    .decl plain(e: Example, p: Position, id: Ident, d: Dir)
    plain(E, P, Id, D) :-
        ex_out(E, _, _), parse.single(E, P, Col),  // a train pair's dot
        parse.block(E, $ThickBlock(), Id, Col),
        !twin(E, $ThickBlock(), Col), parse.aligned(E, P, Id, D).

    // A cell the output gives a non-background color, background in the
    // input.
    .decl inked(e: Example, p: Position, col: Color)
    inked(E, P, Col) :- ex_in(E, P, Bg), parse.ground.mode(E, Bg), ex_out(E, P, Col), Col != Bg.

    // Each plain dot is one copy of the chart, in its own pose.
    .decl chosen(e: Example, p: Position, id: Ident, d: Dir, f: Position, col: Color)
    chosen(E, P, Id, D, F, Col) :-
        plain(E, P, Id, D), parse.foot(E, P, Id, D, F), parse.single(E, P, Col).

    .decl draw_aim(e: Example, p: Position, d: Dir)
    draw_aim(E, P, D) :- chosen(E, P, _, D, _, _).

    // The foot: the inked cells of the dot's color on the foot center's line
    // across D, joined to the center.
    .init across = Slide<Sighting>
    across.node([E, P], X) :- chosen(E, P, _, D, F, Col), inked(E, X, Col), same_dist(D, X, F).
    across.dir([E, P], D2) :- chosen(E, P, _, D, _, _), perp_dir(D, D2).

    .decl draw_foot_offsets(e: Example, p: Position, v: Offset)
    draw_foot_offsets(E, P, V) :-
        chosen(E, P, _, _, F, _), ( X = F ; across.run([E, P], F, _, X) ), relative(F, X, V).

    // The head: the inked cells of the dot's color no nearer the block than
    // the dot, joined to the dot.
    .init head = Reach<Sighting>
    head.node([E, P], P) :- chosen(E, P, _, _, _, _).
    head.node([E, P], X) :- chosen(E, P, _, D, _, Col), inked(E, X, Col), !nearer(D, P, X).
    head.seed([E, P], P) :- chosen(E, P, _, _, _, _).

    .decl draw_head_offsets(e: Example, p: Position, v: Offset)
    draw_head_offsets(E, P, V) :- head.reach([E, P], X), X != P, relative(P, X, V).
}
