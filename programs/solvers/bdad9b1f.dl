// bdad9b1f
// keywords: lines lookup border
// input: Two 2-cell segments on bg, each seated on a grid edge.
// output: Each segment extends into a full line; the cell where the lines
//  cross gets params.cross.

// how each segment's extension axis is found. In this task each segment points
// along its color's role axis and seats on an edge along it, so the three agree.
.type Choice =
    // the segment's own axis: its cells share an across position
    Shape {}
    // each ink cell on an edge casts its line away from it
  | Edge {}
    // params.role names each color's axis
  | Role {}

.type CellChoice = [p: Position, ch: Choice]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl cross(c: Color) cross(4).

    // --- $Shape, $Edge ---
    .decl bg(c: Color) bg(0).

    // --- $Role ---
    .decl role(col: Color, a: Axis)
    role(8, AXIS_V). role(2, AXIS_H).
}

.init params = Params

// The line color Col paints: extension axis, across position.
.decl line(col: Color, a: Axis, p_across: Position, ch: Choice)

// --- $Shape, $Edge ---

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

line(Col, A, Ac, $Shape()) :-
    ink(P1, Col), ink(P2, Col), P1 != P2,   // two segment cells
    axis_elem(A), split(P1, A, _, Ac), same_line(A, P1, P2).

line(Col, A, Ac, $Edge()) :-
    ink(P, Col), dir_elem(D), dist(P, D, 0),    // ink cell on an edge
    axis_of(D, A), split(P, A, _, Ac).          // its line inward

// --- $Role ---

line(Col, A, Ac, $Role()) :-
    in(P, Col), params.role(Col, A), split(P, A, _, Ac).

// A cell covered by two line colors is a crossing, and carries neither.
.init on_line = Unanimous<CellChoice, Color>
on_line.item([P, Ch], Col) :- in(P, _), line(Col, A, Ac, Ch), split(P, A, _, Ac).

.decl impl_choice(ch: Choice)
impl_choice($Shape()). impl_choice($Edge()). impl_choice($Role()).

out(P, Cx, Ch)  :- on_line.clash([P, Ch]), params.cross(Cx).
out(P, Col, Ch) :- on_line.value([P, Ch], Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !on_line.item([P, Ch], _).

.comp Determine {
    // A color's two segment cells lie on one line of its own axis.
    .decl role(col: Color, a: Axis)
    role(Col, A) :-
        ex_in(E, P1, Col), !params.bg(Col),
        ex_in(E, P2, Col), P1 != P2,
        axis_elem(A), same_line(A, P1, P2).
}
