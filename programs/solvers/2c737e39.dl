// 2c737e39
// draft
// keywords: objects markers stamp
// input: A drawing sits on bg with one of its cells in params.mark — its
//  anchor — and one more params.mark cell elsewhere is the target.
// output: The input stands, and a copy of the drawing stamps with its
//  anchor on the target; the anchor prints bg, so the target is consumed.

// what the copy carries
.type Choice =
    // the drawing's cells, leaving the rest of the landing alone
    Transparent {}
    // its bounding box, bg included
  | Opaque {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(5).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Transparent()). impl_choice($Opaque()).

// --- shared ---

.init obj = Components8<Unit>
obj.node($U(), P) :- in(P, Col), !params.bg(Col).

// The drawing holds more than one cell.
.decl drawing(id: Ident)
drawing(Id) :- obj.label($U(), P, Id), obj.label($U(), Q, Id), P != Q.

.decl drawn(p: Position, col: Color)
drawn(P, Col) :- obj.label($U(), P, Id), drawing(Id), in(P, Col).

.decl shift(v: Offset)
shift(V) :-
    drawn(P, Col), params.mark(Col),         // the drawing's anchor
    in(Q, Col), !drawn(Q, _),                // the target, marked outside the drawing
    relative(P, Q, V).

.decl footprint(p: Position, ch: Choice)

.decl stamp(p: Position, col: Color, ch: Choice)
stamp(P_out, Col, Ch) :-
    footprint(P, Ch), in(P, C),                 // a cell the stamp carries
    shift(V), compose(P, V, P_out),             // moved onto the target
    in(P_out, _),                               // landing in the frame
    ( !params.mark(C), Col = C                  // its color prints
    ; params.mark(C), params.bg(Col) ).         // the anchor prints bg

// --- $Transparent ---

footprint(P, $Transparent()) :- drawn(P, _).

// --- $Opaque ---

.init bbox = Bbox<Unit>
bbox.cell($U(), P) :- drawn(P, _).

footprint(P, $Opaque()) :- bbox.box($U(), B), in(P, _), inside(P, B).

out(P, Col, Ch) :- stamp(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !stamp(P, _, Ch).
