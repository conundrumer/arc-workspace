// 08573cc6
// @keywords: markers walk
// output: A lone dot and a two-cell legend at a corner. The output
//  is a rectangular spiral walked outward from the dot: arms turn with a fixed
//  sense, each arm one cell longer than the last, and the walk ends with the
//  first arm the grid edge cuts short. The legend's two colors paint the arms
//  by axis.

// The cases differ on how the corner marker's axis is picked
.type Choice =
    // the corner marker colors the axis of the walk's first arm; the
    // alternation is read off the walk itself
    Start {}
    // the corner marker colors a stored axis
  | Stored {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl dot(col: Color) dot(1).
    .decl len0(n: number) len0(2).

    // The legend and the walk it starts, as one assembly. The legend's cell
    // at a grid corner and the step to its second cell fix the pose.
    RIGID(legend,
        .decl corner(d: DiagDir) corner(DIAG_TL).
        .decl along(d: Dir) along(DIR_R).
        .decl first_arm(d: Dir) first_arm(DIR_L).
        .decl next_arm(d: Dir) next_arm(DIR_B).
    )

    // --- $Stored ---
    .decl color_axis(a: Axis) color_axis(AXIS_H).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Start()). impl_choice($Stored()).

// --- shared: seed, legend, spiral ---

.decl seed(p: Position)
seed(P) :- in(P, Col), params.dot(Col).

.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !params.bg(Col), !params.dot(Col).

// The legend at its pose: the cell at the corner, and the second cell one step
// from it.
.decl legend(d: D4, p: Position, q: Position)
legend(Pose, P, Q) :-
    marker(P, _), params.legend_corner(Pose, Diag), corner_dist(P, Diag, 0),
    params.legend_along(Pose, R), neighbor(P, R, Q), marker(Q, _).

// An arm, by where it ends and its move: p_end may sit off the grid, and
// only an arm ending on the grid continues the walk.
.type Arm = [p_end: Position, d: Dir, delta: Offset]

// The arms the walk reaches: from an arm that ends on the grid, the next arm
// turns and is one cell longer.
// The first arm leaves the dot.
.init spiral = Propagation<Unit, Arm>
spiral.source($U(), [P_end, D, Delta]) :-
    seed(P), legend(Pose, _, _), params.legend_first_arm(Pose, D), params.len0(N),
    jump(P, D, N, P_end), jump_offset(D, N, Delta).
spiral.edge($U(), [P, D, Delta], [P_end2, D2, Delta2]) :-
    in(P, _), dir_elem(D), axis_of(D, A), sub_extent(P, A, N), jump_offset(D, N, Delta),
    legend(Pose, _, _), params.legend_first_arm(Pose, D0), params.legend_next_arm(Pose, D1),
    turn(S, D0, D1), turn(S, D, D2), rotation(S, M),        // the sense of the walk's first turn
    apply(M, Delta, DeltaR), neighbor(DeltaR, D2, Delta2),  // the arm turned, one cell longer
    compose(P, Delta2, P_end2).

// An arm runs from p_start (exclusive) to p_end.
.decl arm(p_start: Position, d: Dir, delta: Offset, p_end: Position)
arm(P, D, Delta, P_end) :- spiral.reached($U(), [P_end, D, Delta]), relative(Delta, P_end, P).

// An arm read back from its end, keyed by where it starts. An arm the grid
// edge cuts short ends off the grid, so a forward cast from the start has no
// end to stop at. A cast from off the frame still walks in, so the backward
// run reaches that arm's on-grid cells.
.init run = Ray<Position>
run.dir(P, O) :- arm(P, D, _, _), opposite(D, O).
run.cell(P, C) :- arm(P, _, _, _), in(C, _).
run.mark(P, P_end) :- arm(P, _, _, P_end).

// Grid cells an arm covers.
.decl arm_cell(p: Position, d: Dir)
arm_cell(C, D) :-
    arm(P, D, _, P_end), opposite(D, O),
    run.ray(P, C, O, K, P_end),     // a cell on the run back
    run.ray(P, P, O, N, P_end),     // the start, at the arm's length
    K < N.                          // short of the start

// The axis whose arms take the corner marker's color.
.decl corner_axis(a: Axis, ch: Choice)

// --- $Start ---
corner_axis(A, $Start()) :-
    legend(Pose, _, _), params.legend_first_arm(Pose, D), axis_of(D, A).

// --- $Stored ---
corner_axis(A, $Stored()) :- params.color_axis(A).

out(P, Col, Ch) :-
    arm_cell(P, D), axis_of(D, A), legend(_, Q, Q2),    // arm cell, its axis, the legend
    ( corner_axis(A, Ch), in(Q, Col)                    // on the corner's axis
    ; corner_axis(A2, Ch), perp(A, A2), in(Q2, Col)     // across it
    ).
out(P, Col_out, Ch) :-
    impl_choice(Ch), in(P, Col),                                 // grid cell
    ( seed(P), Col_out = Col                                     // the seed — kept
    ; !arm_cell(P, _), !seed(P), params.bg(Col_out)              // off the walk — bg
    ).

.comp Determine {
    .decl legend_cell(e: Example, p: Position)
    legend_cell(E, P) :- ex_in(E, P, Col), !params.bg(Col), !params.dot(Col).

    .decl legend_corner(e: Example, d: DiagDir)
    legend_corner(E, Diag) :- legend_cell(E, P), corner_dist(P, Diag, 0).

    .decl legend_along(e: Example, d: Dir)
    legend_along(E, D) :-
        legend_corner(E, Diag), legend_cell(E, P), corner_dist(P, Diag, 0),  // the corner cell
        dir_elem(D), neighbor(P, D, Q), legend_cell(E, Q).                   // the step to the other
}
