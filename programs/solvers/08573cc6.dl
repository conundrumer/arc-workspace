// 08573cc6
// concept: markers walk
// A lone dot and a two-cell legend at the top-left corner. The output is a
// rectangular spiral walked outward from the dot: arms turn with a fixed
// sense, each arm one cell longer than the last, and the walk ends with the
// first arm the grid edge cuts short. The legend's two colors paint the arms
// by axis; the cases differ on how the corner marker's axis is picked:
//
//   $Start  — the corner marker colors the axis of the walk's first arm; the
//             alternation is read off the walk itself.
//   $Stored — the corner marker colors a stored axis.

#include "../lib.dl"

.type Choice = Start {} | Stored {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color) bg(0).
    .decl dot(col: Color) dot(1).
    .decl marker_corner(d: DiagDir) marker_corner(DIAG_TL).
    .decl start_dir(d: Dir) start_dir(DIR_L).
    .decl sense(s: Sense) sense(SENSE_CC).
    .decl len0(n: number) len0(2).

    // --- $Stored ---
    .decl color_axis(a: Axis) color_axis(AXIS_H).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Start()). impl_choice($Stored()).

// --- shared: seed, legend, spiral ---

.decl seed(p: Position)
seed(P) :- in(P, Col), c.dot(Col).

.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !c.bg(Col), !c.dot(Col).

.decl corner_color(col: Color)
corner_color(Col) :- marker(P, Col), c.marker_corner(Diag), diag_dist(P, Diag, _, 0, 0).

.decl other_color(col: Color)
other_color(Col) :-
    marker(P, Col),
    c.marker_corner(Diag), dir_of(Diag, _, D),
    dist(P, D, K), K != 0.                       // off the corner

// An arm runs from p_start (exclusive) to p_end; p_end may sit off the
// grid, and only an arm ending on the grid continues the walk.
.decl arm(p_start: Position, d: Dir, delta: Shift, p_end: Position)
arm(P, D, Delta, P_end) :-
    seed(P), c.start_dir(D), c.len0(N),
    jump_delta(D, N, Delta), compose(P, Delta, P_end).
arm(P, D2, Delta2, P_end2) :-
    arm(_, D, Delta, P), in(P, _),          // previous arm ended on-grid
    c.sense(S), turn(S, D, D2),
    step_delta(D, S1), step_delta(D2, S2),
    d4_elem(M), apply(M, S1, S2),           // M realizes the turn
    apply(M, Delta, DeltaR),                // displacement, turned
    compose(DeltaR, S2, Delta2),            // grown one step
    compose(P, Delta2, P_end2).

// Grid cells an arm covers — an arm the edge cuts short keeps its on-grid
// cells.
.decl arm_cell(p: Position, d: Dir)
arm_cell(C, D) :-
    arm(P, D, _, P_end), in(C, _),
    axis_of(D, A), same_line(A, C, P),        // arm's line
    dist(C, D, Kc), dist(P, D, Kp), Kc < Kp,  // past start
    dist(P_end, D, Ke), Kc >= Ke.             // not past end

// The axis whose arms take the corner marker's color.
.decl corner_axis(a: Axis, ch: Choice)

// --- $Start ---
corner_axis(A, $Start()) :- c.start_dir(D), axis_of(D, A).

// --- $Stored ---
corner_axis(A, $Stored()) :- c.color_axis(A).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :-
    arm_cell(P, D), axis_of(D, A),                          // arm cell, its axis
    ( corner_axis(A, Ch), corner_color(Col)                 // on the corner's axis
    ; corner_axis(A2, Ch), perp(A, A2), other_color(Col)    // across it
    ).
out(P, Col_out, Ch) :-
    impl_choice(Ch), in(P, Col),                            // grid cell
    ( seed(P), Col_out = Col                                // the seed — kept
    ; !arm_cell(P, _), !seed(P), c.bg(Col_out)              // off the walk — bg
    ).

// --- fit ---

.comp Fit {
    .decl marker_corner(d: DiagDir)
    marker_corner(Diag) :-
        ex_in(E, P, Col), !c.bg(Col), !c.dot(Col),   // a marker
        diag_dist(P, Diag, _, 0, 0).                 // at a corner
}
