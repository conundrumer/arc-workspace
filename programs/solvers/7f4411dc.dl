// 7f4411dc
// keywords: stamp select
// output: Denoise: solid ink rectangles survive; scattered single cells clear
//  to bg. Ink color varies per pair.

// what survives
.type Choice =
    // a cell under an occurrence of the solid square of side params.square_dim
    // on the ink
    Square {}
    // a cell with ink neighbors in two distinct directions
  | Support {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- $Square ---
    .decl square_dim(k: number) square_dim(2).
}

.init params = Params

.decl ink_at(p: Position)
ink_at(P) :- in(P, Col), !params.bg(Col).

// --- $Square ---
.init sq = Frame2D<Unit>
sq.extent($U(), A, K) :- axis_elem(A), params.square_dim(K).

.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- ink_at(P).
occ.shape($U(), P, $U()) :- sq.cell($U(), P).

.decl square_kept(p: Position)
square_kept(P) :- occ.occurrence($U(), M), sq.cell($U(), S), compose(M, S, P).

// --- $Support ---
.init rim = Rim<Unit>
rim.cell($U(), P) :- ink_at(P).

// The ink continues from P toward D.
.decl support(p: Position, d: Dir)
support(P, D) :- ink_at(P), dir_elem(D), !rim.rim_dir($U(), P, D).

.decl support_kept(p: Position)
support_kept(P) :- support(P, D1), support(P, D2), D1 != D2.

out(P, Col, $Square()) :- square_kept(P), in(P, Col).
out(P, Col, $Square()) :- in(P, _), !square_kept(P), params.bg(Col).

out(P, Col, $Support()) :- support_kept(P), in(P, Col).
out(P, Col, $Support()) :- in(P, _), !support_kept(P), params.bg(Col).
