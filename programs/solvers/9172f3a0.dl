// Layout: 3× scale. Each input cell expands to a 3×3 block of the same
// color in the output frame.

#include "../lib.dl"

.comp Consts {
    .decl intile(p: Position)
    intile(P) :- frame_pos([3, 3], P).

    .decl tile_gap(g: Dim)
    tile_gap([0, 0]).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_tile, Col),                                  // input cell as tile pos
    c.intile(P_intile),                               // intile pos (3×3 frame)
    c.tile_gap(G),                                    // tile gap
    concat_2d(P_tile, P_intile, G, P_grid_out).       // 2D recompose

.output out(IO=stdout)
