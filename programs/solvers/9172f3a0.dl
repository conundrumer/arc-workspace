// 9172f3a0
// representative: 60c09cac

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl scale(k: number) scale(3).
    .decl intile(p: Position)
    intile(P) :- scale(K), helpers.frame_pos([K, K], P).
}

.init params = Params

out(P_grid_out, Col) :-
    in(P_tile, Col),                                  // input cell as tile pos
    params.intile(P_intile),                          // intile pos (3×3 frame)
    concat_2d(P_tile, P_intile, 0, P_grid_out).       // 2D recompose
