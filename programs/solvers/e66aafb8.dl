// e66aafb8
// @draft
// @keywords: symmetry repair crop occlude
// @scene symmetric-pattern: the input is a square pattern that every symmetry in `symmetry` maps onto itself, apart from the masked cells.
// @scene one-mask: one solid rectangle of color `mask_color` covers part of the pattern, and no other cell has that color.
// @scene mask-image-visible: some symmetry in `symmetry` maps the masked rectangle onto cells that the mask does not cover.
// @rule restore-by-symmetry: each masked cell takes the color that its unmasked images under the symmetries in `symmetry` share.
// @rule crop-to-mask: the output is the masked rectangle, cropped from the restored pattern.

.decl out(p: Position, col: Color)

.comp Params {
    .decl mask_color(c: Color) mask_color(0).
    // the subgroup of D4, about the grid's center, that every input keeps off the mask
    .decl symmetry(s: Sym) symmetry(SYM_D4).
}

.init params = Params

// The colors of each masked cell's unmasked images about the grid's center.
// @claim restore-by-symmetry
.init shared = Unanimous<Position, Color>
shared.item(P, Col) :-
    in(P, C), params.mask_color(C),                  // masked cell
    params.symmetry(S), sym_member(S, D), apply(D, P, Q),
    in(Q, Col), !params.mask_color(Col).              // unmasked image

// The masked rectangle.
// @claim crop-to-mask
.init mask_box = Bbox<Unit>
mask_box.cell($U(), P) :- in(P, C), params.mask_color(C).

out(P_inner, Col) :- shared.value(P, Col), mask_box.box($U(), B), crop(P, B, P_inner).

.comp Determine {
    // The color that every input holds and that no output holds.
    .decl lacks(e: Example, c: Color)
    lacks(E, C) :- ex_in(E, _, _), ex_in(_, _, C), !ex_in(E, _, C).

    .decl mask_color(c: Color)
    mask_color(C) :- ex_in(_, _, C), !ex_out(_, _, C), !lacks(_, C).

    // The elements that keep each input's unmasked cells.
    .init inv = D4Map<Example, Color>
    inv.src(E, P, Col) :- ex_in(E, P, Col), !mask_color(Col).
    inv.dst(E, P, Col) :- ex_in(E, P, Col), !mask_color(Col).

    // The named subgroup of the unbroken elements.
    .init kept = KeyedSetCompare<Unit, Sym, D4>
    kept.pattern_member(S, D) :- sym_member(S, D).
    kept.observed_member($U(), D) :- d4_elem(D), !inv.conflict(_, D).

    .decl symmetry(s: Sym)
    symmetry(S) :- kept.equals($U(), S).
}
