// 458e3a53
// @draft
// @keywords: decompose select rank
// input: Uniform lines cut the grid into tiles. Most tiles hold a pattern; a
//  few hold one color each.
// output: One cell per one-color tile, holding its color, at its rank on each
//  axis.

.type Line = [a: Axis, l: Position]

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

// A uniform line spans the grid, so it divides tiles rather than sit in one.
.init line_color = Unanimous<Line, Color>
line_color.item([A, L], Col) :- in(P, Col), axis_elem(A), split(P, A, L, _).

.init tiles = DividerTiles<Unit>
tiles.cell($U(), P) :- in(P, _).
tiles.divider($U(), A, L) :- line_color.value([A, L], _).

.init tile_color = Unanimous<Position, Color>
tile_color.item(P_tile, Col) :- tiles.tile_of($U(), P, P_tile), in(P, Col).

// One output line per tile line that holds a one-color tile.
.init layout = OrderFrame<Axis, Position>
layout.axis(A, A) :- axis_elem(A).
layout.member(A, L, L) :- tile_color.value(P_tile, _), axis_elem(A), split(P_tile, A, L, _).

out(P_grid_out, Col) :-
    tile_color.value(P_tile, Col),                        // a one-color tile
    axis_elem(A), perp(A, A2), split(P_tile, A, L, L2),   // its two tile lines
    layout.pos(A, L, P_pos), layout.pos(A2, L2, P_pos2),  // those lines' output lines
    compose(P_pos, P_pos2, P_grid_out).                   // where they cross
