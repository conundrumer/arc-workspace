// 3a301edc
// @draft
// @keywords: objects border
// input: a rectangle of one color holds a solid block of another color
// output: a ring is added around the rectangle, in the block's color, as
//  thick as the block is long on each axis

// What the ring goes around.
.type Wrap =
    // The box the figure spans.
    Box {}
    // The figure's own cells, so a notch in the figure joins the ring.
  | Cells {}

// What the output shows.
.type Render =
    // The input passes through, and the ring is painted around it.
    Outset {}
    // A nest of three boxes, redrawn from scratch: the block, the rectangle
    // holding it, and the ring.
  | Nest {}

// what the ring wraps, and how the output is drawn
.type Choice = [wrap: Wrap, render: Render]

.decl out(p: Position, col: Color, ch: Choice)

// $Nest redraws the figure's box, so it leaves no notch for a ring to enter,
// and the two wraps stand as one model under it.
.decl impl_choice(ch: Choice)
impl_choice([$Box(), $Outset()]).
impl_choice([$Cells(), $Outset()]).
impl_choice([$Box(), $Nest()]).

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl fig(p: Position)
fig(P) :- in(P, Col), !params.bg(Col).

.init fig_box = Bbox<Unit>
fig_box.cell($U(), P) :- fig(P).

// The grid cells the figure's box covers.
.decl fig_cover(p: Position)
fig_cover(P) :- fig_box.box($U(), B), in(P, _), inside(P, B).

// The rectangle rims the figure; the block is what it holds.
.decl rect_color(col: Color)
rect_color(Col) :- fig(P), fig_box.box($U(), B), box_edge(P, B, _), in(P, Col).

.decl blk_color(col: Color)
blk_color(Col) :- fig(P), in(P, Col), !rect_color(Col).

.init blk_box = Bbox<Unit>
blk_box.cell($U(), P) :- in(P, Col), blk_color(Col).

// The grid cells the block's box covers.
.decl blk_cover(p: Position)
blk_cover(P) :- blk_box.box($U(), B), in(P, _), inside(P, B).

// The ring's thickness at an edge.
.init thick = DirPack<Unit>
thick.edge($U(), D, N) :-
    blk_box.box($U(), B), blk_box.cell($U(), P),    // the block's box, in the grid frame
    box_extent(B, P, A, N), axis_of(D, A).

// The figure's box, let out by the ring's thickness at each edge.
.decl ring_box(b: Box)
ring_box(B) :- fig_box.box($U(), B_fig), thick.box($U(), B_thick), relative(B_thick, B_fig, B).

// The grid cells that let-out box covers.
.decl ring_cover(p: Position)
ring_cover(P) :- in(P, _), ring_box(B), inside(P, B).

// The ring: the let-out box, less what the ring goes around.
.decl ring(p: Position, w: Wrap)

// --- $Box, $Cells ---

ring(P, $Box())   :- ring_cover(P), !fig_cover(P).
ring(P, $Cells()) :- ring_cover(P), !fig(P).

// --- $Outset ---

out(P, Col, [W, $Outset()]) :- ring(P, W), blk_color(Col).
out(P, Col, [W, $Outset()]) :- impl_choice([W, $Outset()]), in(P, Col), !ring(P, W).

// --- $Nest ---

out(P, Col, [$Box(), $Nest()]) :-
    fig_cover(P),
    ( blk_cover(P), blk_color(Col)             // the block
    ; !blk_cover(P), rect_color(Col)           // the rectangle
    ).

out(P, Col, [$Box(), $Nest()]) :-
    in(P, _), !fig_cover(P),
    ( ring(P, $Box()), blk_color(Col)          // the ring
    ; !ring(P, $Box()), params.bg(Col)         // the background
    ).
