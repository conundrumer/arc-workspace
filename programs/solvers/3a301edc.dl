// 3a301edc
// draft
// concept: objects border
// A rectangle of one color holds a solid block of another color. The output
// adds a ring around that rectangle, in the block's color, as thick as the
// block is long on each axis.
//
// $Outset — the input passes through, and the ring is painted around it.
// $Nest — the output is a nest of three boxes, redrawn from scratch: the
//   block, the rectangle holding it, and the ring.
// review principle: Prior or setup — a cell-set case to add: the peer covers the figure's own cells, so a notch in the figure joins the ring.

#include "../lib.dl"

.type Choice = Outset {} | Nest {}

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl fig(p: Position)
fig(P) :- in(P, Col), !params.bg(Col).

.init fig_box = Bbox<Unit>
fig_box.cell($U(), P) :- fig(P).

// The grid cells the figure's box covers.
.decl fig_cover(p: Position)
fig_cover(P) :- fig_box.box($U(), B), in(P, _), inside(P, B).

// The rectangle rims the figure; the block is what it holds.
.decl rect_color(col: Color)
rect_color(Col) :- fig(P), fig_box.box($U(), B), box_edge(P, B, _), in(P, Col).

.decl blk_color(col: Color)
blk_color(Col) :- fig(P), in(P, Col), !rect_color(Col).

.init blk_box = Bbox<Unit>
blk_box.cell($U(), P) :- in(P, Col), blk_color(Col).

// The grid cells the block's box covers.
.decl blk_cover(p: Position)
blk_cover(P) :- blk_box.box($U(), B), in(P, _), inside(P, B).

// The ring's thickness at an edge.
.init thick = DirPack<Unit>
thick.edge($U(), D, N) :-
    blk_box.box($U(), B), blk_box.cell($U(), P),    // the block's box, in the grid frame
    box_extent(B, P, A, N), axis_of(D, A).

// The figure's box, let out by the ring's thickness at each edge.
.decl ring_box(b: Box)
ring_box(B) :- fig_box.box($U(), B_fig), thick.box($U(), B_thick), relative(B_thick, B_fig, B).

.decl ring(p: Position)
ring(P) :- in(P, _), ring_box(B), inside(P, B), !fig_cover(P).

.decl out(p: Position, col: Color, ch: Choice)

// --- Outset ---

out(P, Col, $Outset()) :- ring(P), blk_color(Col).
out(P, Col, $Outset()) :- in(P, Col), !ring(P).

// --- Nest ---

out(P, Col, $Nest()) :-
    fig_cover(P),
    ( blk_cover(P), blk_color(Col)             // the block
    ; !blk_cover(P), rect_color(Col)           // the rectangle
    ).

out(P, Col, $Nest()) :-
    in(P, _), !fig_cover(P),
    ( ring(P), blk_color(Col)                  // the ring
    ; !ring(P), params.bg(Col)                 // the background
    ).
