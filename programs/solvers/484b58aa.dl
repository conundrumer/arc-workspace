// 484b58aa
// @keywords: wallpaper repair lines
// input: A periodic pattern covers the grid, damaged by holes of one
//  color.
// output: Each damaged cell takes the color of an intact cell in its
//  orbit under the pattern's periods. The period varies per pair, so no
//  case stores one.

// the scope the period is measured over
.type Choice =
    // the grid is one wallpaper: its period on each axis is the shortest
    // witnessed unbroken shift of the intact cells
    Periodic {}
    // the grid is a stack of independent lines along a stored axis, each line
    // with its own such shift
  | Lines {}

// A cell of the grid under one case.
.type CaseCell = [ch: Choice, p: Position]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl hole(col: Color) hole(0).

    // --- $Lines ---
    .decl axis(a: Axis) axis(AXIS_V).   // lines run along V
}

.init params = Params

.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.decl impl_choice(ch: Choice)
impl_choice($Periodic()). impl_choice($Lines()).

// The period a cell's pattern repeats under, per case.
.decl period_at(ch: Choice, p: Position, a: Axis, k: number)

// A cell's orbit under the periods: toward each edge d, its index within the
// period on d's axis, or its distance from d's edge where the axis has no
// period.
.init orbit = DirPack<CaseCell>
orbit.edge([Ch, P], D, R) :-
    impl_choice(Ch), in(P, _), axis_of(D, A), dist(P, D, T),
    ( period_at(Ch, P, A, K), stride(T, K, 0, _, R)                 // within the period
    ; !period_at(Ch, P, A, _), R = T                                // or the line
    ).

// The color the intact cells of an orbit hold; b is the orbit's box, its
// places toward the four edges.
// @ignore: single-consumer — one row per orbit, where a join in `out` holds one per pair of cells in an orbit
.decl orbit_color(ch: Choice, b: Box, col: Color)
orbit_color(Ch, B, Col) :- orbit.box([Ch, Q], B), intact(Q, Col).

// Intact cells pass through under every case.
out(P, Col, Ch) :- impl_choice(Ch), intact(P, Col).

out(P, Col, Ch) :-
    in(P, Hole), params.hole(Hole),                                 // damaged cell
    orbit.box([Ch, P], B), orbit_color(Ch, B, Col).

// --- $Periodic ---

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- intact(P, Col).

period_at($Periodic(), P, A, K) :- in(P, _), si.min_period($U(), A, K).

// --- $Lines ---

.init si_line = OffsetInvariance<Position, Color>
si_line.cell(L, P, Col) :- intact(P, Col), params.axis(A), split(P, A, _, L).

period_at($Lines(), P, A, K) :-
    in(P, _), params.axis(A), split(P, A, _, L),          // the cell's line
    si_line.min_period(L, A, K).                          // that line's period
