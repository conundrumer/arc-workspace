// 484b58aa
// @keywords: wallpaper repair lines
// input: A periodic pattern covers the grid, damaged by holes of one
//  color.
// output: Each damaged cell takes the color of an intact cell in its
//  orbit under the pattern's periods. The period varies per pair, so no
//  case stores one.

// the scope the period is measured over
.type Choice =
    // the grid is one wallpaper: its period on each axis is the shortest
    // witnessed unbroken shift of the intact cells
    Lattice {}
    // the grid is a stack of independent lines along a stored axis, each line
    // with its own such shift
  | Lines {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl hole(col: Color) hole(0).

    // --- $Lines ---
    .decl axis(a: Axis) axis(AXIS_V).   // lines run along V
}

.init params = Params

.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.decl damaged(p: Position)
damaged(P) :- in(P, Col), params.hole(Col).

.decl impl_choice(ch: Choice)
impl_choice($Lattice()). impl_choice($Lines()).

// The period a damaged cell's pattern repeats under, per case.
.decl period_at(ch: Choice, p: Position, a: Axis, k: number)

// Cell q agrees with damaged cell p on axis a: within the period there, or
// on the same line where the axis has no period.
.decl axis_agree(ch: Choice, p: Position, a: Axis, q: Position)
axis_agree(Ch, P, A, Q) :-
    impl_choice(Ch), damaged(P), in(Q, _), axis_of(D, A),
    ( period_at(Ch, P, A, K),                                       // within the period
      dist(P, D, T), stride(T, K, 0, _, R),
      dist(Q, D, T2), stride(T2, K, 0, _, R)
    ; !period_at(Ch, P, A, _), same_dist(D, P, Q)                   // or on the same line
    ).

// The cells in a damaged cell's orbit under the periods.
.decl orbit(ch: Choice, p: Position, q: Position)
orbit(Ch, P, Q) :- axis_agree(Ch, P, A, Q), perp(A, A2), axis_agree(Ch, P, A2, Q).

// Intact cells pass through under every case.
out(P, Col, Ch) :- impl_choice(Ch), intact(P, Col).

out(P, Col, Ch) :- orbit(Ch, P, Q), intact(Q, Col).

// --- $Lattice ---

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- intact(P, Col).

period_at($Lattice(), P, A, K) :- damaged(P), si.min_period($U(), A, K).

// --- $Lines ---

.init si_line = OffsetInvariance<Position, Color>
si_line.cell(L, P, Col) :- intact(P, Col), params.axis(A), split(P, A, _, L).

period_at($Lines(), P, A, K) :-
    damaged(P), params.axis(A), split(P, A, _, L),        // the cell's line
    si_line.min_period(L, A, K).                          // that line's period
