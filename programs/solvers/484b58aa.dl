// 484b58aa
// concept: wallpaper repair lines
// A periodic pattern covers the grid, damaged by holes of one color. Each
// damaged cell takes the color of an intact cell in its orbit under the
// pattern's periods. The period varies per pair, so no case stores one.
//
//   $Lattice — the grid is one wallpaper: its period on each axis is the
//              shortest witnessed unbroken shift of the intact cells.
//   $Lines   — the grid is a stack of independent lines along a stored
//              axis, each line with its own such shift.

#include "../lib.dl"

.type Choice = Lattice {} | Lines {}

.comp Params {
    // --- shared ---
    .decl hole(col: Color) hole(0).

    // --- $Lines ---
    .decl axis(a: Axis) axis(AXIS_V).   // lines run along V
}

.init params = Params

.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.decl damaged(p: Position)
damaged(P) :- in(P, Col), params.hole(Col).

.decl impl_choice(ch: Choice)
impl_choice($Lattice()). impl_choice($Lines()).

// The period a damaged cell's pattern repeats under, per case.
.decl period_at(ch: Choice, p: Position, a: Axis, k: number)

// That period as a shift, either way along its axis.
.decl step(ch: Choice, p: Position, delta: Shift)
step(Ch, P, Delta) :- period_at(Ch, P, A, K), axis_of(D, A), jump_delta(D, K, Delta).

// The cells a run of those shifts reaches from a damaged cell.
.decl orbit(ch: Choice, p: Position, q: Position)
orbit(Ch, P, P) :- impl_choice(Ch), damaged(P).
orbit(Ch, P, Q2) :-
    orbit(Ch, P, Q),                                 // reached so far
    step(Ch, P, Delta), compose(Q, Delta, Q2),       // one period on
    in(Q2, _).                                       // inside the frame

.decl out(p: Position, col: Color, c: Choice)

// Intact cells pass through under every case.
out(P, Col, Ch) :- impl_choice(Ch), intact(P, Col).

out(P, Col, Ch) :- orbit(Ch, P, Q), intact(Q, Col).

// --- $Lattice ---

.init si = ShiftInvariance<Unit, Color>
si.cell($U(), P, Col) :- intact(P, Col).

period_at($Lattice(), P, A, K) :- damaged(P), si.min_period($U(), A, K).

// --- $Lines ---

.init si_line = ShiftInvariance<Position, Color>
si_line.cell(L, P, Col) :- intact(P, Col), params.axis(A), split(P, A, _, L).

period_at($Lines(), P, A, K) :-
    damaged(P), params.axis(A), split(P, A, _, L),        // the cell's line
    si_line.min_period(L, A, K).                          // that line's period
