// 3aa6fb7a
// @draft
// @keywords: objects bbox
// input: Ink lies on params.bg in L-triominoes: three cells of a 2x2 square,
//  the fourth empty.
// output: That empty cell takes params.fill; the rest passes through.

// what marks a cell
.type Choice =
    // ink on both dirs of one corner and across it
    Corner {}
    // a bg cell inside an object's bounding bbox
  | Box {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(0).
    .decl fill(col: Color) fill(1).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Corner()). impl_choice($Box()).

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl empty(p: Position)
empty(P) :- in(P, Col), params.bg(Col).

// The cell a case marks.
.decl mark(p: Position, ch: Choice)

out(P, Col, Ch) :- mark(P, Ch), params.fill(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !mark(P, Ch).

// --- $Corner ---

mark(P, $Corner()) :-
    empty(P), diag_dirs(G, _, D1, D2),  // an empty cell and a corner of it
    neighbor(P, D1, Q1), ink(Q1),       // with ink on both of the corner's dirs
    neighbor(P, D2, Q2), ink(Q2),
    neighbor(P, G, Q3), ink(Q3).        // and across it

// --- $Box ---

.init parts = Components<Unit>
parts.node($U(), P) :- ink(P).

.init part_box = Bbox<Ident>
part_box.cell(Id, P) :- parts.label($U(), P, Id).

mark(P, $Box()) :- empty(P), part_box.box(_, B), inside(P, B).
