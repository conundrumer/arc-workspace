// 3aa6fb7a
// draft
// concept: objects stamp lookup
// Ink lies on params.bg in L-triominoes: three cells of a 2x2 square, the fourth
// empty. That empty cell takes params.fill; the rest passes through. The hypotheses of
// what marks a cell:
//
//   $Corner — ink on both dirs of one corner and across it.
//   $Glyph  — the gap of a stored L, matched in any pose.
//   $Box    — a bg cell inside an object's bounding box.

#include "../lib.dl"

.type Choice = Corner {} | Glyph {} | Box {}

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(0).
    .decl fill(col: Color) fill(1).

    // --- $Glyph ---
    // The L and the cell completing it, in one frame.
    RIGID(piece,
        .decl glyph(p: Position)
        GRID_MASK_2x2(glyph,
            1, 1,
            1, _)
        .decl gap(p: Position) gap([1, 0, 1, 0]).
    )
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Corner()). impl_choice($Glyph()). impl_choice($Box()).

.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col).

.decl empty(p: Position)
empty(P) :- in(P, Col), params.bg(Col).

// The cell a case marks.
.decl mark(p: Position, ch: Choice)

// --- $Corner ---

mark(P, $Corner()) :-
    empty(P), diag_dirs(G, _, D1, D2),  // an empty cell and a corner of it
    neighbor(P, D1, Q1), ink(Q1),       // with ink on both of the corner's dirs
    neighbor(P, D2, Q2), ink(Q2),
    neighbor(P, G, Q3), ink(Q3).        // and across it

// --- $Glyph ---

// One key per pose: an L placed by D4.
.init occ = Occurrences<D4, Unit>
occ.cell(D, P, $U())  :- d4_elem(D), ink(P).
occ.shape(D, S, $U()) :- params.piece_glyph(D, S).

mark(P_grid, $Glyph()) :-
    occ.occurrence(D, A),                           // a placed L
    params.piece_gap(D, S), compose(A, S, P_grid),  // the cell completing it
    empty(P_grid).                                  // still empty

// --- $Box ---

.init parts = Components<Unit>
parts.node($U(), P) :- ink(P).

.init part_box = Bbox<Ident>
part_box.cell(Id, P) :- parts.label($U(), P, Id).
part_box.grid(Id, P) :- parts.label($U(), _, Id), in(P, _).

mark(P, $Box()) :- empty(P), part_box.inside(_, P).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- mark(P, Ch), params.fill(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !mark(P, Ch).

.comp Determine {
    // A mark: empty in the input, colored in the output.
    .decl marked(e: Example, p: Position)
    marked(E, P) :-
        ex_in(E, P, Bg), params.bg(Bg),      // empty in
        ex_out(E, P, Col), !params.bg(Col).  // marked out

    .type EP = [e: Example, p: Position]

    // The ink the mark completes: the component it touches.
    .init piece = Reach<EP>
    piece.node([E, P], Q) :- marked(E, P), ex_in(E, Q, Col), !params.bg(Col).
    piece.seed([E, P], Q) :- marked(E, P), dir_elem(D), neighbor(P, D, Q).

    // One witness piece serves as the chart, in its own pose.
    .init pick = Canon<EP>
    pick.equiv([E, P], [E2, P2]) :- marked(E, P), marked(E2, P2).

    .init box = BoxFrame<EP>
    box.cell(K, Q) :- pick.rep(K, K), piece.reach(K, Q).

    .decl piece_glyph(p: Position)
    piece_glyph(S) :- box.inner(_, _, S).
}
