// 5207a7b5
// @draft
// @keywords: markers walk
// input: a bar of one color hangs from an edge of the grid
// output: A filled region grows out of the bar one column at a time. The
//  bar's own column is filled as deep as the bar reaches. Each next column
//  toward the slant's side reaches `rise` cells deeper, and each column the
//  other way `rise` cells shallower, until the region runs out of the grid.
//  The bar's column keeps the bar's color, and every other filled cell
//  takes the color of its side of the bar.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl bar(col: Color) bar(5).

    // The fill color on each side of the bar.
    .decl paint(d: Dir, col: Color)
    paint(DIR_L, 8). paint(DIR_R, 6).

    // The corner the slant runs toward, and how far it goes along the bar
    // per cell across it.
    .decl slant_dir(d: DiagDir) slant_dir(DIAG_BL).
    .decl rise_axis(a: Axis) rise_axis(AXIS_V).
    .decl rise(k: number) rise(2).

    // The edge the bar hangs from: back along the slant's own axis.
    .decl base(d: Dir)
    base(B) :- slant_dir(Dg), rise_axis(A), diag_dirs(Dg, A, D, _), opposite(D, B).
}

.init params = Params

.decl bar_cell(p: Position)
bar_cell(P) :- in(P, Col), params.bar(Col).

// P lies on the slant through a bar cell: J columns across toward one side,
// and rise times J cells along toward that side's end of the slant.
.decl on_slant(p: Position)
on_slant(P) :-
    bar_cell(Q), in(P, _), relative(Q, P, R),
    params.slant_dir(Dg), params.rise_axis(A), diag_dirs(Dg, A, D, D_side),
    ( D1 = D, D2 = D_side                                // toward the slant's corner
    ; opposite(D, D1), opposite(D_side, D2) ),           // or away from it
    opposite(D1, O1), dist(R, O1, T),                    // T cells along toward D1
    opposite(D2, O2), dist(R, O2, J),                    // J columns across toward D2
    params.rise(K), stride(T, K, 0, J, 0).               // T is rise times J

// A cell of the slant, and every cell back toward the base edge from it.
.decl region(p: Position)
region(P) :-
    on_slant(Q), in(P, _),
    ( P = Q
    ; params.rise_axis(A), same_line(A, P, Q), params.base(B), nearer(B, P, Q) ).

out(P, Col) :-
    region(P), bar_cell(Q),
    ( params.rise_axis(A), same_line(A, P, Q), params.bar(Col)  // the bar's own column
    ; nearer(D, P, Q), params.paint(D, Col) ).                  // one side of it
out(P, Col) :- in(P, _), !region(P), params.bg(Col).

.comp Determine {
    // Every filled cell, under the side of the bar it lies on.
    .decl paint(d: Dir, col: Color)
    paint(D, Col) :-
        ex_out(E, P, Col), !params.bg(Col),                // a filled cell
        params.rise_axis(A), perp(A, A2), axis_of(D, A2),  // a side of the bar
        ex_in(E, Q, Col_bar), params.bar(Col_bar),         // a cell of the bar
        nearer(D, P, Q).
}
