// 2e65ae53
// draft
// concept: objects decompose induce
// Frames drawn in one ink color are cut by their own lines into the same tile
// arrangement. The filled tiles of all the frames together show one color per
// tile position. The output fills every tile of every frame with its
// position's color.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// The frames are drawn in the commonest non-bg color.
.init ink = Mode<Unit, Color, Position>
ink.item($U(), Col, P) :- in(P, Col), !params.bg(Col).

// Each frame is one ink component.
.init frames = Components<Unit>
frames.node($U(), P) :- in(P, Col), ink.mode($U(), Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- frames.label($U(), P, Id).

// The grid cells each frame's box covers.
.decl box_cell(id: Ident, p: Position)
box_cell(Id, P) :- bbox.box(Id, B), in(P, _), inside(P, B).

// A frame's border is one of the cutting lines, and counting it offsets every
// tile index alike, so tile positions still match across frames.
.decl broken(id: Ident, l: Position)
broken(Id, L) :-
    box_cell(Id, P), in(P, Col), !ink.mode($U(), Col),  // a non-ink cell of the box
    axis_elem(A), split(P, A, L, _).                    // on line L

.init cut = DividerTiles<Ident>
cut.cell(Id, P) :- box_cell(Id, P).
cut.divider(Id, A, L) :-
    box_cell(Id, P), axis_elem(A), split(P, A, L, _),  // a line of the frame's box
    !broken(Id, L).                                    // ink the whole way across

// One color per tile position, shown by whichever frames fill that tile.
.decl tile_color(p_tile: Position, col: Color)
tile_color(P_tile, Col) :- cut.tile_of(_, P, P_tile), in(P, Col), !params.bg(Col).

.decl painted(p: Position, col: Color)
painted(P, Col) :- cut.tile_of(_, P, P_tile), tile_color(P_tile, Col).

.decl out(p: Position, col: Color)
out(P, Col) :- painted(P, Col).
out(P, Col) :- in(P, Col), !painted(P, _).
