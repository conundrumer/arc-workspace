// 7e4d4f7c
// concept: lines mapping
// Output has extent c.out_h along c.header_dir, perpendicular extent =
// input. Cells at depth 0..out_h-2 from header_dir map into the output's
// out_h frame with along-depth and across-axis position preserved. The
// row at depth out_h-1 is derived from input depth 0 via tail_color:
// bg passes through; non-bg becomes c.marker.
//
// out_cell grounds the output positions (out_h along-frame × input
// across); both rules join to it. Keep matches each non-tail cell to its
// input slab via slab_anchor (depth-from-header + across). Tail joins by
// column to input depth 0, recolored via tail_color (à la b1948b0a's idiom).
// Layout-family cluster (header/body, à la bd4472b8).

#include "../lib.dl"

.comp Consts {
    .decl header_dir(d: Dir) header_dir(DIR_T).
    .decl out_h(n: number) out_h(3).
    .decl marker(col: Color) marker(6).
}

.init c = Consts

// Along-axis frame for the output: out_h cells on header_dir's axis.
.init out_along = AxisFrame<Unit>
out_along.extent($U(), A, N) :- c.header_dir(D), axis_of(D, A), c.out_h(N).

.init bg = Mode<Unit, Color, Position>
bg.item($U(), C, P) :- in(P, C).

// Tail recolor: bg passes through; non-bg becomes c.marker.
.decl tail_color(c_in: Color, c_out: Color)
tail_color(C, C) :- bg.mode($U(), C).
tail_color(C, M) :- in(_, C), !bg.mode($U(), C), c.marker(M).

// Output cells: the out_h along-frame crossed with the input's across
// positions. Grounds the output grid so both rules can join to it.
.decl out_cell(p: Position)
out_cell(P) :-
    c.header_dir(H_dir), axis_of(H_dir, A),               // the along axis
    out_along.cell($U(), A, P_along),                     // along-axis frame cell
    in(P_in, _), split(P_in, A, _, P_across),             // an input cell's across part
    compose(P_along, P_across, P).                        // glue to a 2D out cell

.decl out(p: Position, col: Color)

// Each output cell takes an input cell's color. A non-tail cell takes it
// from its own slab, matched on depth-from-header and across. The tail row
// (opp-edge distance 0) takes it from the input's depth-0 cells, matched on
// across alone — the tail row and input row 0 do not share
// depth-from-header — and recolored via tail_color.
out(P_out, Col_out) :-
    out_cell(P_out),                                      // grounded output cell
    c.header_dir(H_dir), opposite(H_dir, H_opp),          // along-axis dirs
    ( dist(P_out, H_opp, K_opp), K_opp != 0,              // not the tail row
      in(P_in, Col_out),                                  // input cell
      slab_anchor(H_dir, P_in, P_out)                     // same slab as P_out
    ; dist(P_out, H_opp, 0), axis_of(H_dir, A),           // tail row, along axis
      in(P_in, Col_in), dist(P_in, H_dir, 0),             // input depth 0
      split(P_in, A, _, Ac), split(P_out, A, _, Ac),      // same column
      tail_color(Col_in, Col_out)                         // recolor
    ).
