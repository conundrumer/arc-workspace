// 3bd67248
// @keywords: objects cast border
// output: A wall column sits against one side edge. The floor row
//  (params.floor_dir edge) paints params.floor_color; the corner diagonal
//  rising from the wall's foot paints params.diag_color. Painting spares non-bg
//  cells. All grids are square.

// where the diagonal anchors
.type Choice =
    // the diagonal's corner is task data (params.corner)
    Anchored {}
    // the corner is derived: where the wall meets the floor
  | Foot {}
    // wall side and floor end both derived; only a turn sense (params.sense) is
    // data — the floor sits at the wall's end reached by turning its inward
    // normal by the sense
  | WallEnd {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl floor_color(c: Color) floor_color(4).
    .decl diag_color(c: Color) diag_color(2).

    // --- $Anchored, $Foot ---
    .decl floor_dir(d: Dir) floor_dir(DIR_B).

    // --- $Anchored ---
    .decl corner(d: DiagDir) corner(DIAG_BL).

    // --- $WallEnd ---
    .decl sense(s: Sense) sense(SENSE_CW).
}

.init params = Params

// --- shared ---

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), params.bg(Col).

.decl wall_cell(p: Position)
wall_cell(P) :- in(P, Col), !params.bg(Col).

.decl impl_choice(ch: Choice)
impl_choice($Anchored()). impl_choice($Foot()). impl_choice($WallEnd()).

// Corner diagonal per case, over bg cells; each case fixes its corner.
.init diag = Diagonal<Choice>
diag.cell(Ch, P) :- impl_choice(Ch), bg_cell(P).

// --- $Anchored, $Foot ---

.decl floor_paint(p: Position)
floor_paint(P) :- bg_cell(P), params.floor_dir(D), dist(P, D, 0).

// --- $Anchored ---

diag.corner($Anchored(), Diag) :- params.corner(Diag).

.decl paint_anch(p: Position, col: Color)
paint_anch(P, Col) :- floor_paint(P), params.floor_color(Col).
paint_anch(P, Col) :-
    diag.diagonal($Anchored(), P, _), params.diag_color(Col),    // diagonal cell
    params.floor_dir(D), !dist(P, D, 0).                         // floor wins the floor row

out(P, Col, $Anchored()) :- paint_anch(P, Col).
out(P, Col, $Anchored()) :- in(P, Col), !paint_anch(P, _).

// --- $Foot ---

// The wall cell on the floor row.
.decl foot(p: Position)
foot(P) :- wall_cell(P), params.floor_dir(D), dist(P, D, 0).

// The side edge the foot touches.
.decl wall_dir(d: Dir)
wall_dir(D) :- foot(P), dist(P, D, 0), params.floor_dir(Df), perp_dir(Df, D).

.decl foot_corner(diag: DiagDir)
foot_corner(Diag) :- params.floor_dir(Df), wall_dir(Dw), diag_dirs(Diag, _, Df, Dw).

diag.corner($Foot(), Diag) :- foot_corner(Diag).

.decl paint_foot(p: Position, col: Color)
paint_foot(P, Col) :- floor_paint(P), params.floor_color(Col).
paint_foot(P, Col) :- diag.diagonal($Foot(), P, _), params.diag_color(Col).

out(P, Col, $Foot()) :- paint_foot(P, Col).
out(P, Col, $Foot()) :- in(P, Col), !paint_foot(P, _).

// --- $WallEnd ---

// The edge the wall sits against: the one no wall cell stands off.
.decl off_edge(d: Dir)
off_edge(D) :- wall_cell(P), dir_elem(D), !dist(P, D, 0).

.decl wall_side(d: Dir)
wall_side(D) :- dir_elem(D), !off_edge(D).

// The wall's end reached by turning its inward normal by params.sense.
.decl floor_end(d: Dir)
floor_end(D2) :- wall_side(Dw), opposite(Dw, Dn), params.sense(S), turn(S, Dn, D2).

.decl we_corner(diag: DiagDir)
we_corner(Diag) :- floor_end(Df), wall_side(Dw), diag_dirs(Diag, _, Df, Dw).

diag.corner($WallEnd(), Diag) :- we_corner(Diag).

.decl paint_we(p: Position, col: Color)
paint_we(P, Col) :- bg_cell(P), floor_end(D), dist(P, D, 0), params.floor_color(Col).
paint_we(P, Col) :- diag.diagonal($WallEnd(), P, _), params.diag_color(Col).

out(P, Col, $WallEnd()) :- paint_we(P, Col).
out(P, Col, $WallEnd()) :- in(P, Col), !paint_we(P, _).

.comp Determine {
    .decl wall_cell(e: Example, p: Position)
    wall_cell(E, P) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // The cells the painting puts down, with their colors.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :- ex_out(E, P, Col), ex_in(E, P, C0), C0 != Col.

    // Two cells of one paint on one row or column: the floor.
    .decl floor_pair(e: Example, p: Position, q: Position, col: Color)
    floor_pair(E, P, Q, Col) :-
        painted(E, P, Col), painted(E, Q, Col), P != Q,
        axis_elem(A), same_line(A, P, Q).

    .decl floor_color(c: Color)
    floor_color(Col) :- floor_pair(_, _, _, Col).

    // The edge both cells of a floor pair lie on.
    .decl floor_dir(d: Dir)
    floor_dir(D) :- floor_pair(_, P, Q, _), dist_pair(P, D, 0, _), dist_pair(Q, D, 0, _).

    // The paint off the floor: the diagonal's.
    .decl diag_color(c: Color)
    diag_color(Col) :- painted(_, _, Col), !floor_color(Col).

    // A corner whose diagonal holds two cells of the diagonal's paint.
    .decl diag_line(diag: DiagDir)
    diag_line(Diag) :-
        painted(E, P, Col), painted(E, Q, Col), diag_color(Col), P != Q,
        diag_dir_elem(Diag), diag_dist(P, Diag, _, K, K), diag_dist(Q, Diag, _, K2, K2).

    // The painted diagonal's corner on the floor edge.
    .decl corner(d: DiagDir)
    corner(Diag) :- diag_line(Diag), floor_dir(D), dir_of(Diag, _, D).

    // The edge the wall sits against: the one no wall cell stands off.
    .decl off_edge(d: Dir)
    off_edge(D) :- wall_cell(_, P), dir_elem(D), !dist(P, D, 0).

    .decl wall_side(d: Dir)
    wall_side(D) :- dir_elem(D), !off_edge(D).

    // The turn carrying the wall's inward normal to the floor.
    .decl sense(s: Sense)
    sense(S) :- wall_side(Dw), opposite(Dw, Dn), floor_dir(Df), turn(S, Dn, Df).
}
