// a48eeaf7
// @draft
// @keywords: move bbox rank walk
// @scene block: one solid 2×2 block of params.block_color on a
//  params.background field
// @scene markers: single cells of params.marker_color, each apart from the
//  block. Each marker lies in the block's rows, in its columns, or on a
//  diagonal line through a corner of the block.
// @rule slide: each marker moves straight toward the block, in the one of
//  the eight directions that points at the block from the marker, and stops
//  at the first cell that touches the block by side or by corner. Undefined
//  when that line never reaches such a cell.
// @rule keep-block: the block stays in place, and the marker's original cell
//  becomes params.background

// how a marker reaches its final cell
.type Approach =
    // @claim slide
    Walk {path: PathShape, collide: Collide}
    // @rule slide: each marker moves to the nearest cell of the ring around
    //  the block: each coordinate is clamped to the block's bounding box
    //  grown by one cell
    // @witness off-line: variant $Clamp
    //     @relaxed markers
  | Clamp {}

// the line the marker walks
.type PathShape =
    // @claim slide
    Line {stop: Stop}
    // @rule slide: the marker steps diagonally toward the block until it is
    //  level with the block's rows or columns, then goes straight. It stops at
    //  the first cell that touches the block, and is defined on every input.
    // @witness off-line: variant $Clamp
  | KingPath {}

// where the line stops
.type Stop =
    // @claim slide
    Touch {}
    // @rule slide: the marker stops only when its next step would enter the
    //  block or leave the grid, so a marker off the block's lines passes the
    //  block. Defined on every input.
    // @witness off-line: variant $Clamp
  | PassBy {}

// what two markers that reach one cell do
.type Collide =
    // @claim slide
    Merge {}
    // @rule slide: the markers that reach one cell settle in order of path
    //  length. Each stops as many cells back along its own path as there are
    //  markers there with shorter paths.
    // @witness same-line: variant $Stack
  | Stack {}

// which cells are the block
.type BlockParse =
    // @claim block
    ColorCells {}
    // @scene block: the block is the last 2×2 square of params.block_color in
    //  each scan order of params.scan_order, from its corner along its axis.
    //  Undefined when there is no such square, or when the open scan orders
    //  pick different squares.
    // @witness big-block: variant concept
    //     @relaxed block
    // @witness l-block: variant concept
    //     @relaxed block
  | Last2x2 {}

// how the block color and the markers are found
.type Roles =
    // @claim markers
    StoredRoles {}
    // @scene block: the block color is the one color whose cells have a
    //  same-colored neighbor by side. Undefined when there is not exactly
    //  one such color.
    // @scene markers: every other cell that is not params.background is a
    //  marker, and keeps its own color
    // @witness third-color: borderline concept
  | DeriveRoles {}

.type Choice = [approach: Approach, block: BlockParse, roles: Roles]

// The block and the markers under one block parse and one role reading.
.type Scene = [block: BlockParse, roles: Roles]

// A cell under one scene and one path shape.
.type Track = [s: Scene, ps: PathShape, p: Position]

// The lines of one scene under one stop rule.
.type Cast = [s: Scene, stop: Stop]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed block
    .decl background(c: Color) background(0).

    // --- $StoredRoles ---
    .decl block_color(c: Color) block_color(2).
    .decl marker_color(c: Color) marker_color(5).

    // --- $Last2x2 ---
    .decl scan_order(c: DiagDir, a: Axis)
    scan_order(DIAG_TL, AXIS_V). scan_order(DIAG_TL, AXIS_H).
    scan_order(DIAG_TR, AXIS_V). scan_order(DIAG_TR, AXIS_H).
    scan_order(DIAG_BL, AXIS_V). scan_order(DIAG_BL, AXIS_H).
    scan_order(DIAG_BR, AXIS_V). scan_order(DIAG_BR, AXIS_H).
}

.init params = Params

.decl stop_choice(s: Stop)
stop_choice($Touch()). stop_choice($PassBy()).

.decl path_shape_choice(ps: PathShape)
path_shape_choice($Line(St)) :- stop_choice(St).
path_shape_choice($KingPath()).

.decl collide_choice(c: Collide)
collide_choice($Merge()). collide_choice($Stack()).

.decl approach_choice(a: Approach)
approach_choice($Walk(Ps, C)) :- path_shape_choice(Ps), collide_choice(C).
approach_choice($Clamp()).

.decl roles_choice(r: Roles)
roles_choice($StoredRoles()). roles_choice($DeriveRoles()).

.decl block_parse_choice(b: BlockParse)
block_parse_choice($ColorCells()). block_parse_choice($Last2x2()).

.decl impl_choice(ch: Choice)
impl_choice([A, Bp, R]) :- approach_choice(A), block_parse_choice(Bp), roles_choice(R).

.comp Parse<Key> {
    // The cells of the block color.
    .decl cell(key: Key, p: Position)

    // The scan orders: the corner each runs from, and its primary axis.
    .decl order(c: DiagDir, a: Axis)

    .type Scan = [k: Key, c: DiagDir, a: Axis]

    // The 2×2 square that has P as its corner-C cell holds Q.
    .decl square_cell(key: Key, c: DiagDir, p: Position, q: Position)
    square_cell(Ky, C, P, Q) :-
        cell(Ky, P), order(C, _), diag_opposite(C, D), diag_dirs(D, _, E1, E2),
        ( Q = P ; neighbor(P, E1, Q) ; neighbor(P, E2, Q) ; neighbor(P, D, Q) ).

    // Some cell of that square is not of the block color.
    .decl patchy(key: Key, c: DiagDir, p: Position)
    patchy(Ky, C, P) :- square_cell(Ky, C, P, Q), !cell(Ky, Q).

    // @claim block
    .init scan = LexOrder<Scan>
    scan.cell([Ky, C, A], P) :- cell(Ky, P), order(C, A), !patchy(Ky, C, P).
    scan.corner([Ky, C, A], C) :- scan.cell([Ky, C, A], _).
    scan.axis([Ky, C, A], A) :- scan.cell([Ky, C, A], _).

    // The box of the last square in each scan order.
    // @claim block
    .init last_square = Bbox<Scan>
    last_square.cell([Ky, C, A], Q) :- scan.last([Ky, C, A], P), square_cell(Ky, C, P, Q).
}

.init parse = Parse<Roles>

// --- the scene ---

.decl block_color(r: Roles, col: Color)

.decl marker(r: Roles, p: Position, col: Color)

.decl block(s: Scene, p: Position)

// @claim slide
.init bbox = Bbox<Scene>
bbox.cell(S, P) :- block(S, P).

// P lies nearer edge D than the block does.
.decl beyond(s: Scene, p: Position, d: Dir)
beyond(S, P, D) :-
    bbox.box(S, B), in(P, _), dir_elem(D), dist(P, D, K), dist(B, D, K_box), K < K_box.

.decl beyond_axis(s: Scene, p: Position, a: Axis)
beyond_axis(S, P, A) :- beyond(S, P, D), axis_of(D, A).

// The one of the eight directions that points at the block from P.
.decl toward(s: Scene, p: Position, d: Dir8)
toward(S, P, D_to) :-
    beyond(S, P, D), opposite(D, E), axis_of(D, A), perp(A, A2),
    ( !beyond_axis(S, P, A2), D_to = E                  // level with the block on the other axis
    ; beyond(S, P, D2), opposite(D2, E2), diag_dirs(D_to, A, E, E2)
    ).

// A cell that touches the block by side or by corner.
.decl touch(s: Scene, p: Position)
touch(S, P) :- block(S, Q), neighbor(Q, _, P), in(P, _), !block(S, P).

// The grid with the markers lifted off.
.decl cleared(r: Roles, p: Position, col: Color)
cleared(R, P, Col) :- in(P, Col), roles_choice(R), !marker(R, P, _).
cleared(R, P, Col) :- marker(R, P, _), params.background(Col).

// Marker M ends at P.
.decl landed(ch: Choice, m: Position, p: Position)

// Some marker has no end.
.decl unlanded(ch: Choice)
unlanded([A, Bp, R]) :-
    impl_choice([A, Bp, R]), marker(R, M, _), !landed([A, Bp, R], M, _).

.decl settled(ch: Choice)
settled([A, Bp, R]) :- impl_choice([A, Bp, R]), bbox.box([Bp, R], _), !unlanded([A, Bp, R]).

out(P, Col, [A, Bp, R]) :-
    settled([A, Bp, R]),
    ( landed([A, Bp, R], M, P), marker(R, M, Col)
    ; cleared(R, P, Col), !landed([A, Bp, R], _, P)
    ).

// --- $StoredRoles ---
block_color($StoredRoles(), Col) :- params.block_color(Col).

marker($StoredRoles(), P, Col) :- in(P, Col), params.marker_color(Col).

// --- $DeriveRoles ---
// The colors whose cells have a same-colored neighbor by side.
// @claim block
.init clumped = Unanimous<Unit, Color>
clumped.item($U(), Col) :-
    in(P, Col), !params.background(Col), dir_elem(D), neighbor(P, D, Q), in(Q, Col).

block_color($DeriveRoles(), Col) :- clumped.value($U(), Col).

marker($DeriveRoles(), P, Col) :-
    in(P, Col), !params.background(Col), clumped.value($U(), Col2), Col != Col2.

// --- $ColorCells ---
block([$ColorCells(), R], P) :- block_color(R, Col), in(P, Col).

// --- $Last2x2 ---
parse.cell(R, P) :- block_color(R, Col), in(P, Col).
parse.order(C, A) :- params.scan_order(C, A).

// The square every scan order picks.
// @claim block
.init picked = Unanimous<Roles, Box>
picked.item(R, B) :- parse.last_square.box([R, _, _], B).

block([$Last2x2(), R], Q) :- picked.value(R, B), in(Q, _), inside(Q, B).

// --- $Walk ---
// Marker M's walk reaches P after K steps.
// @ignore: head-zero — a walk that takes no step is at its marker after 0
//  steps, the count of steps it took
// @ignore: head-repeat — the start of a walk that takes no step is the cell
//  its marker stands on, and the walk is keyed by that marker
.decl walk_cell(s: Scene, ps: PathShape, m: Position, p: Position, k: number)

// The walk's step counts.
// @claim slide
.init walk_length = Extremes<Track>
walk_length.cand([S, Ps, M], K) :- walk_cell(S, Ps, M, _, K).

// The walk's last cell.
.decl end(s: Scene, ps: PathShape, m: Position, p: Position)
end(S, Ps, M, P) :- walk_cell(S, Ps, M, P, K), walk_length.high([S, Ps, M], K).

// The cell the marker stops at.
.decl arrive(s: Scene, ps: PathShape, m: Position, p: Position)

// --- $Line ---
// The direction of the line from marker M.
.decl aim(s: Scene, m: Position, d: Dir8)
aim(S, M, D) :- S = [_, R], marker(R, M, _), toward(S, M, D).

// Each marker's line toward the block, cut short at the first cell the stop
// rule bars.
// @claim slide
.init lines = Ray<Cast>
lines.dir([S, St], D) :- aim(S, _, D), stop_choice(St).
lines.cell([S, St], P) :- bbox.box(S, _), stop_choice(St), in(P, _).
lines.mark([S, St], M) :- aim(S, M, _), stop_choice(St).

// A walk starts at its marker on the marker's line. A marker with no line
// stays where it is.
walk_cell(S, $Line(St), M, M, 0) :-
    bbox.box(S, _), S = [_, R], marker(R, M, _), !aim(S, M, _), stop_choice(St).

// --- $Touch ---
// The line goes on through the first cell that touches the block, and no
// further.
lines.blocked([S, $Touch()], P) :- touch(S, P).

// A marker that touches the block at the start stays where it is.
walk_cell(S, $Line($Touch()), M, M, 0) :- aim(S, M, _), touch(S, M).

walk_cell(S, $Line($Touch()), M, P, K) :-
    aim(S, M, D), !touch(S, M),
    ( lines.clear([S, $Touch()], P, D, K, M)   // the open line
    ; lines.stop([S, $Touch()], P, D, K, M)    // the touching cell
    ).

arrive(S, $Line($Touch()), M, P) :- end(S, $Line($Touch()), M, P), touch(S, P).

// --- $PassBy ---
// The line goes on up to the block or the grid edge.
lines.blocked([S, $PassBy()], P) :- block(S, P).

walk_cell(S, $Line($PassBy()), M, P, K) :- aim(S, M, D), lines.clear([S, $PassBy()], P, D, K, M).

arrive(S, $Line($PassBy()), M, P) :- end(S, $Line($PassBy()), M, P).

// --- $KingPath ---
// Each marker's walk, each step in the direction that points at the block
// from where it stands, up to the first cell that touches the block.
// @claim slide
.init king = GraphDistance<Track, Position>
king.seed([S, $KingPath(), M], M) :- bbox.box(S, _), S = [_, R], marker(R, M, _).
king.edge([S, $KingPath(), M], P, Q) :-
    king.seed([S, $KingPath(), M], _), in(P, _), !touch(S, P),
    toward(S, P, D), neighbor(P, D, Q).                    // the direction from here

walk_cell(S, $KingPath(), M, P, K) :- king.distance([S, $KingPath(), M], P, K).

arrive(S, $KingPath(), M, P) :- end(S, $KingPath(), M, P).

// --- $Merge ---
landed([$Walk(Ps, $Merge()), Bp, R], M, P) :- arrive([Bp, R], Ps, M, P).

// --- $Stack ---
// Each walk's cells in walking order.
// @claim slide
.init trail = Order<Track, Position>
trail.elem([S, Ps, M], P) :- walk_cell(S, Ps, M, P, _).
trail.before([S, Ps, M], P, Q) :- walk_cell(S, Ps, M, P, K), walk_cell(S, Ps, M, Q, K2), K < K2.

// The markers that stop at one cell, by path length.
// @claim slide
.init pile = Order<Track, Position>
pile.elem([S, Ps, Q], M) :- arrive(S, Ps, M, Q).
pile.before([S, Ps, Q], M1, M2) :-
    arrive(S, Ps, M1, Q), walk_cell(S, Ps, M1, Q, N1),
    arrive(S, Ps, M2, Q), walk_cell(S, Ps, M2, Q, N2), N1 < N2.

// The marker with K shorter paths before it stops K cells back on its path.
landed([$Walk(Ps, $Stack()), Bp, R], M, P) :-
    pile.rank([[Bp, R], Ps, _], M, K), trail.rank_desc([[Bp, R], Ps, M], P, K).

// --- $Clamp ---
// The ring of cells that touch the block, as a box.
// @claim slide
.init ring = Bbox<Scene>
ring.cell(S, P) :- touch(S, P).

// On axis A, Q is on the ring's edge where M lies beyond the block, and
// level with M elsewhere.
.decl clamped(s: Scene, m: Position, q: Position, a: Axis)
clamped(S, M, Q, A) :-
    ring.box(S, B), S = [_, R], marker(R, M, _), in(Q, _), axis_of(D, A),
    ( beyond(S, M, D), dist(B, D, K), dist(Q, D, K)
    ; !beyond_axis(S, M, A), same_dist(D, Q, M)
    ).

landed([$Clamp(), Bp, R], M, Q) :-
    clamped([Bp, R], M, Q, A), perp(A, A2), clamped([Bp, R], M, Q, A2).

.comp Determine {
    .init ex = Parse<Example>
    ex.cell(E, P) :- ex_in(E, P, Col), params.block_color(Col).
    ex.order(C, A) :- diag_dir_elem(C), axis_elem(A).

    // Output marker P touches the square that scan order (C, A) picks, by
    // side or by corner.
    .decl touching(e: Example, c: DiagDir, a: Axis, p: Position)
    touching(E, C, A, P) :-
        ex.last_square.box([E, C, A], B), ex_out(E, P, Col), params.marker_color(Col),
        !inside(P, B), neighbor(P, _, Q), inside(Q, B).

    // Some output marker does not touch that square.
    .decl astray(c: DiagDir, a: Axis)
    astray(C, A) :-
        ex.last_square.box([E, C, A], _), ex_out(E, P, Col), params.marker_color(Col),
        !touching(E, C, A, P).

    .decl scan_order(c: DiagDir, a: Axis)
    scan_order(C, A) :- ex.order(C, A), !astray(C, A).
}
