// 6d58a25d
// draft
// concept: objects markers cast
// A shape of one color sits among scattered markers of another color. Where a
// marker lies past the shape toward params.dir in the shape's line, the
// marker's color fills that line from the shape to the grid edge.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl dir(d: Dir) dir(DIR_B).
}

.init params = Params

// The shape's color forms one object; the marker color scatters into many.
.init objs = Components8<Color>
objs.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl scattered(col: Color)
scattered(Col) :- objs.label(Col, _, Id), objs.label(Col, _, Id2), Id != Id2.

.decl shape_color(col: Color)
shape_color(Col) :- objs.node(Col, _), !scattered(Col).

// From each shape cell toward params.dir, over the cells past the shape.
.init cast = Ray<Unit>
cast.dir($U(), D) :- params.dir(D).
cast.cell($U(), P) :- in(P, Col), !shape_color(Col).
cast.mark($U(), P) :- in(P, Col), shape_color(Col).

// A cast that holds a marker fills with the marker's color.
.decl fill(p: Position, col: Color)
fill(P, Col) :-
    cast.ray($U(), P, D, _, Src),                               // on a cast
    cast.ray($U(), Q, D, _, Src), in(Q, Col), !params.bg(Col).  // its marker

.decl out(p: Position, col: Color)
out(P, Col) :- fill(P, Col).
out(P, Col) :- in(P, Col), !fill(P, _).
