// 320afe60
// draft
// concept: objects enclose move
// A shape that leaves a cell of its box empty and closes no region off from
// the grid edge is open; every other shape — one that closes a region off, or
// that fills its box — is closed. Each shape slides flush to an edge and takes
// its class's color: closed toward params.closed_dir in params.closed_paint, open toward
// the opposite edge in params.open_paint.
//
// Two hypotheses on what stands solid while a shape is judged:
//   $Own   — the shape alone. A gap is a box cell it does not cover, and a
//            hole is a region it closes off by itself.
//   $Joint — all the ink. A gap is a background cell of the box, and a hole is
//            a region the ink closes off together, which counts for every
//            shape on its rim.

#include "../lib.dl"

.type Choice = Own {} | Joint {}

.comp Params {
    .decl bg(col: Color) bg(4).

    // Where the closed shapes go; the open ones go to the opposite edge.
    .decl closed_dir(d: Dir) closed_dir(DIR_L).

    .decl closed_paint(col: Color) closed_paint(2).
    .decl open_paint(col: Color) open_paint(3).
}

.init params = Params

// --- shared ---

.init shapes = Components<Unit>
shapes.node($U(), P) :- in(P, Col), !params.bg(Col).

.decl shape(id: Ident, p: Position)
shape(Id, P) :- shapes.label($U(), P, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- shape(Id, P).

// The shape's box holds a cell its substance does not cover.
.decl gap(id: Ident, ch: Choice)

// The shape closes a region off from the grid edge.
.decl encloses(id: Ident, ch: Choice)

// --- Own ---

// The grid with only this shape solid.
.init off_shape = Closed<Ident>
off_shape.cell(Id, P) :- in(P, _), shape(Id, _), !shape(Id, P).

gap(Id, $Own()) :- bbox.box(Id, B), in(P, _), inside(P, B), !shape(Id, P).
encloses(Id, $Own()) :- off_shape.region(Id, _, _).

// --- Joint ---

// The grid with all the ink solid.
.init off_ink = Closed<Unit>
off_ink.cell($U(), P) :- in(P, Col), params.bg(Col).

gap(Id, $Joint()) :- bbox.box(Id, B), in(P, Col), inside(P, B), params.bg(Col).
encloses(Id, $Joint()) :-
    off_ink.region($U(), P, _),         // cell of a closed region
    dir_elem(D), neighbor(P, D, Q),
    shape(Id, Q).                       // on the shape's rim

// --- output ---

.decl impl_choice(ch: Choice)
impl_choice($Own()). impl_choice($Joint()).

.decl open(id: Ident, ch: Choice)
open(Id, Ch) :- gap(Id, Ch), !encloses(Id, Ch).

.decl dest(id: Ident, d: Dir, col: Color, ch: Choice)
dest(Id, D, Col, Ch) :-
    shape(Id, _), impl_choice(Ch), params.closed_dir(D_closed),      // a shape under a claim
    ( !open(Id, Ch), D = D_closed, params.closed_paint(Col)          // closed: the sort edge
    ; open(Id, Ch), opposite(D_closed, D), params.open_paint(Col)    // open: the far edge
    ).

// Each shape slides until its box touches the destination edge.
.decl paint(p: Position, col: Color, ch: Choice)
paint(Q, Col, Ch) :-
    shape(Id, P), dest(Id, D, Col, Ch),  // shape cell with its destination
    bbox.box(Id, B), dist(B, D, K),      // its box's margin from that edge
    jump(P, D, K, Q).                    // slid flush

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- in(P, _), params.bg(Col), impl_choice(Ch), !paint(P, _, Ch).
