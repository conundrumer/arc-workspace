// 7b0280bc
// @draft
// @keywords: objects markers route
// input: squares of two colors sit on a background, joined by wires of a
//  third color; the color with the fewest squares marks the two ends
// output: the input, with the route between the ends through the fewest
//  pieces recolored; its wires take one fill, its squares another, and the
//  ends keep their color

// what makes a piece a square
.type Choice =
    // a piece that fills a box with equal sides
    Filled {}
    // any piece whose box has equal sides
  | Extents {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl wire_fill(col: Color) wire_fill(5).
    .decl square_fill(col: Color) square_fill(3).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Filled()). impl_choice($Extents()).

// The background is the commonest color.
.init ground = Mode<Unit, Color, Position>
ground.item($U(), Col, P) :- in(P, Col).

// Each color's pieces. A wire runs diagonally, so pieces are 8-connected.
.init piece = Components8<Color>
piece.node(Col, P) :- in(P, Col), !ground.mode($U(), Col).

.decl piece_cell(id: Ident, p: Position)
piece_cell(Id, P) :- piece.label(_, P, Id).

.decl piece_color(id: Ident, col: Color)
piece_color(Id, Col) :- piece.label(Col, _, Id).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- piece_cell(Id, P).

// The piece's box has equal sides.
.decl square_box(id: Ident)
square_box(Id) :-
    bbox.box(Id, B), piece_cell(Id, P),
    box_extent(B, P, A, N), perp(A, A2), box_extent(B, P, A2, N).

// What each case calls a square.
.decl square(ch: Choice, id: Ident)

// The wire color has a piece that is no square.
.decl wire_color(ch: Choice, col: Color)
wire_color(Ch, Col) :- impl_choice(Ch), piece_color(Id, Col), !square(Ch, Id).

// The other colors draw squares, and the one with the fewest marks the ends.
.decl square_color(ch: Choice, col: Color)
square_color(Ch, Col) :- impl_choice(Ch), piece_color(_, Col), !wire_color(Ch, Col).

.type SquareKey = [ch: Choice, col: Color]

.init squares = Tally<SquareKey, Ident>
squares.item([Ch, Col], Id) :- square_color(Ch, Col), piece_color(Id, Col).

.init fewest = ArgExtremes<Choice, Color>
fewest.cand(Ch, Col, N) :- squares.tally([Ch, Col], N).

.decl end_color(ch: Choice, col: Color)
end_color(Ch, Col) :- fewest.low(Ch, Col, _).

.decl end_piece(ch: Choice, id: Ident)
end_piece(Ch, Id) :- piece_color(Id, Col), end_color(Ch, Col).

// Two pieces touch where a cell of one neighbors a cell of the other.
.decl touch(a: Ident, b: Ident)
touch(A, B) :- piece_cell(A, P), dir8_elem(D), neighbor(P, D, Q), piece_cell(B, Q), A != B.

.type EndKey = [ch: Choice, e: Ident]

// Hops over the touch graph from each end.
.init hops = GraphDistance<EndKey, Ident>
hops.edge([Ch, E], A, B) :- end_piece(Ch, E), touch(A, B).
hops.seed([Ch, E], E) :- end_piece(Ch, E).

// The route: traced from the other end back toward the seed along
// fewest-hop predecessors. Each end seeds the same route.
.init back = Propagation<EndKey, Ident>
back.source([Ch, E], E2) :- end_piece(Ch, E), end_piece(Ch, E2), E != E2.   // the other end
back.edge([Ch, E], B, A) :- hops.pred([Ch, E], B, A).

.decl route_cell(ch: Choice, p: Position, col: Color)
route_cell(Ch, P, Col) :-
    back.reached([Ch, _], Id),
    piece_cell(Id, P), piece_color(Id, C),                       // a route piece's cell
    ( wire_color(Ch, C), params.wire_fill(Col)                   // a wire
    ; square_color(Ch, C), !end_color(Ch, C), params.square_fill(Col)  // a square, not an end
    ).

out(P, Col, Ch) :- route_cell(Ch, P, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !route_cell(Ch, P, _).

// --- $Filled ---

// Some cell of the piece's box is off the piece.
.decl gap(id: Ident)
gap(Id) :- bbox.box(Id, B), in(P, _), inside(P, B), !piece_cell(Id, P).

square($Filled(), Id) :- square_box(Id), !gap(Id).

// --- $Extents ---

square($Extents(), Id) :- square_box(Id).
