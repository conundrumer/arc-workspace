// d10ecb37
// Output is the c.diag-anchored sub-frame of input. Input cells project
// into the sub-frame by matching distances to the two corner edges.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl diag(d: DiagDir)
    diag(TOP_LEFT).

    .decl frame(p: Position)
    frame(P) :- helpers.frame_pos([2, 2], P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_grid_in, Col),                                  // input cell
    c.frame(P_grid_out),                                 // output position
    c.diag(D), corner_anchor(D, P_grid_out, P_grid_in).  // corner-anchor match

.output out(IO=stdout)
