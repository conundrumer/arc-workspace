// d10ecb37
// @keywords: decompose crop select
// output: Output is the 2×2 block at the corner params.diag names.
//  Even-dimensioned inputs leave the locate rule underdetermined. A divisor
//  arrangement is defeated: the 12×6 pair's corner tile would be 6×3, not
//  2×2.

// how the corner block is located
.type Choice =
    // a params.window block seated at the corner
    Corner {}
    // grid tiled by params.tile_dim blocks; the corner block
  | Block {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl diag(d: DiagDir)
    diag(DIAG_TL).

    // --- Corner ---
    .decl window_dim(k: number) window_dim(2).
    .decl window(p: Position)
    window(P) :- window_dim(K), helpers.frame_pos([K, K], P).

    // --- Block ---
    .decl tile_dim(k: number) tile_dim(2).
}

.init params = Params

// --- Corner ---
out(P_out, Col, $Corner()) :-
    in(P_in, Col),                                     // input cell
    params.window(P_out),                              // output position
    params.diag(D), corner_anchor(D, P_out, P_in).     // corner-anchor match

// --- Block ---
out(P_intile, Col, $Block()) :-
    in(P_in, Col),                                                             // input cell
    params.tile_dim(K), divide_by_size_2d(P_in, K, 0, P_tile, P_intile),       // tiling
    params.diag(D), corner_anchor(D, P_tile, ZERO).                          // corner block
