// 6e02f1e3
// keywords: lookup count classify
// output: Classify the input by its distinct color count and emit the
//  class's symbol: one color — the top edge row; two — the TL diagonal;
//  three — the TR diagonal.

.type Canvas = Input {} | Fixed {}

// the render: table or rule
.type Choice =
    // select the stored count->grid from a table
    Lookup {}
    // draw the count's figure spec (edge row or corner diagonal) in
    // params.mark on params.bg; the canvas is a second table/rule choice:
    // the input frame ($Input) or a stored dim ($Fixed)
  | Figure {canvas: Canvas}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- Lookup ---
    .decl lookup_grid(n: number, p: Position, col: Color)
    GRID_3x3(lookup_grid, 1,
        5, 5, 5,
        0, 0, 0,
        0, 0, 0)
    GRID_3x3(lookup_grid, 2,
        5, 0, 0,
        0, 5, 0,
        0, 0, 5)
    GRID_3x3(lookup_grid, 3,
        0, 0, 5,
        0, 5, 0,
        5, 0, 0)

    // --- Figure ---
    .decl fig_edge(n: number, d: Dir)
    fig_edge(1, DIR_T).
    .decl fig_diag(n: number, da: DiagAxis)
    fig_diag(2, DAXIS_DG). fig_diag(3, DAXIS_AD).

    .decl mark(c: Color) mark(5).
    .decl bg(c: Color) bg(0).

    // --- Figure/$Fixed canvas ---
    .decl out_dim(n: number) out_dim(3).
    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(N), helpers.frame_pos([N, N], P).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    .init palette = Tally<Key, Color>
    palette.item(K, Col) :- cell(K, _, Col).

    .decl ncolors(k: Key, n: number)
    ncolors(K, N) :- palette.tally(K, N).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// --- Lookup ---
out(P, Col, $Lookup()) :- parse.ncolors($U(), N), params.lookup_grid(N, P, Col).

// --- Figure ---
.decl canvas(p: Position, cv: Canvas)
canvas(P, $Input()) :- in(P, _).
canvas(P, $Fixed()) :- params.out_pos(P).

.decl figure_cell(p: Position, cv: Canvas)
figure_cell(P, Cv) :-
    canvas(P, Cv), parse.ncolors($U(), N),            // canvas cell, its class
    ( params.fig_edge(N, D), dist(P, D, 0)            // class figure: on an edge row
    ; params.fig_diag(N, DA), diag_axis_of(Dg, DA),   // class figure: on a diagonal
      diag_dist(P, Dg, _, K, K)                       // equidistant from its edges
    ).

out(P, Mk, $Figure(Cv)) :- figure_cell(P, Cv), params.mark(Mk).
out(P, Bg, $Figure(Cv)) :- canvas(P, Cv), !figure_cell(P, Cv), params.bg(Bg).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // A class's grid is its example's whole output.
    .decl lookup_grid(n: number, p: Position, col: Color)
    lookup_grid(N, P, Col) :- parse.ncolors(E, N), ex_out(E, P, Col).

    .decl mark_cell(e: Example, p: Position)
    mark_cell(E, P) :- ex_out(E, P, Col), params.mark(Col).

    // A corner diagonal that is exactly the output's mark cells.
    .decl mismatch(e: Example, dg: DiagDir)
    mismatch(E, Dg) :-
        diag_dir_elem(Dg), mark_cell(E, P),
        diag_dist(P, Dg, _, K1, K2), K1 != K2.
    mismatch(E, Dg) :-
        diag_dir_elem(Dg), ex_out(E, P, _),
        diag_dist(P, Dg, _, K, K), !mark_cell(E, P).

    .decl fig_diag(n: number, da: DiagAxis)
    fig_diag(N, DA) :-
        parse.ncolors(E, N), ex_out(E, _, _),    // train pairs only
        diag_dir_elem(Dg), !mismatch(E, Dg), diag_axis_of(Dg, DA).
}
