// 6e02f1e3
// concept: lookup count classify
// Classify the input by its distinct color count and emit the class's
// symbol: one color — the top edge row; two — the TL diagonal; three —
// the TR diagonal.
//
// The render is the data/ops choice:
//   $Lookup — select the stored count->grid from a table (data).
//   $Figure — draw the count's figure spec (edge row or corner diagonal)
//             in c.mark on c.bg (ops). The canvas is a second data/ops
//             node: the input frame ($Input) or a stored dim ($Fixed).

#include "../lib.dl"

.type Canvas = Input {} | Fixed {}
.type Choice = Lookup {} | Figure {canvas: Canvas}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- Lookup ---
    .decl lookup_grid(n: number, p: Position, col: Color)
    GRID_3x3(lookup_grid, 1,
        5, 5, 5,
        0, 0, 0,
        0, 0, 0)
    GRID_3x3(lookup_grid, 2,
        5, 0, 0,
        0, 5, 0,
        0, 0, 5)
    GRID_3x3(lookup_grid, 3,
        0, 0, 5,
        0, 5, 0,
        5, 0, 0)

    // --- Figure ---
    .decl fig_edge(n: number, d: Dir)
    fig_edge(1, DIR_T).
    .decl fig_diag(n: number, da: DiagAxis)
    fig_diag(2, DAXIS_DG). fig_diag(3, DAXIS_AD).

    .decl mark(c: Color) mark(5).
    .decl bg(c: Color) bg(0).

    // --- Figure/$Fixed canvas ---
    .decl out_dim(n: number) out_dim(3).
    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(N), helpers.frame_pos([N, N], P).
}

.init c = Consts

// --- parse ---

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    .decl palette(k: Key, col: Color)
    palette(K, Col) :- cell(K, _, Col).

    .decl ncolors(k: Key, n: number)
    ncolors(K, N) :- cell(K, _, _), N = count : { palette(K, _) }.
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl out(p: Position, col: Color, ch: Choice)

// --- Lookup ---
out(P, Col, $Lookup()) :- parse.ncolors($U(), N), c.lookup_grid(N, P, Col).

// --- Figure ---
.decl canvas(p: Position, cv: Canvas)
canvas(P, $Input()) :- in(P, _).
canvas(P, $Fixed()) :- c.out_pos(P).

.decl figure_cell(p: Position, cv: Canvas)
figure_cell(P, Cv) :-
    canvas(P, Cv),                              // canvas cell
    parse.ncolors($U(), N), c.fig_edge(N, D),   // class figure: edge row
    dist(P, D, 0).                              // on that edge
figure_cell(P, Cv) :-
    canvas(P, Cv),                              // canvas cell
    parse.ncolors($U(), N), c.fig_diag(N, DA),  // class figure: diagonal
    diag_axis_of(Dg, DA),                       // either corner of the axis
    diag_dist(P, Dg, _, K, K).                  // equidistant from its edges

out(P, Mk, $Figure(Cv)) :- figure_cell(P, Cv), c.mark(Mk).
out(P, Bg, $Figure(Cv)) :- canvas(P, Cv), !figure_cell(P, Cv), c.bg(Bg).

// --- fit ---

.comp Fit {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // A class's grid is its example's whole output.
    .decl lookup_grid(n: number, p: Position, col: Color)
    lookup_grid(N, P, Col) :- parse.ncolors(E, N), ex_out(E, P, Col).

    .decl mark_cell(e: Example, p: Position)
    mark_cell(E, P) :- ex_out(E, P, Col), c.mark(Col).

    // A corner diagonal that is exactly the output's mark cells.
    .decl broken(e: Example, dg: DiagDir)
    broken(E, Dg) :-
        diag_dir_elem(Dg), mark_cell(E, P),
        diag_dist(P, Dg, _, K1, K2), K1 != K2.
    broken(E, Dg) :-
        diag_dir_elem(Dg), ex_out(E, P, _),
        diag_dist(P, Dg, _, K, K), !mark_cell(E, P).

    .decl fig_diag(n: number, da: DiagAxis)
    fig_diag(N, DA) :-
        parse.ncolors(E, N), ex_out(E, _, _),    // train pairs only
        diag_dir_elem(Dg), !broken(E, Dg), diag_axis_of(Dg, DA).
}
