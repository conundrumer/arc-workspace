// 7bb29440
// @draft
// @keywords: objects crop count rank select
// input: solid blocks of params.body that sit apart on params.bg, each with a
//  few cells of other colors
// output: The block with the fewest such cells is kept, cropped to its
//  bounding box.

// what counts as one of those cells
.type Choice =
    // a cell of a stored mark color, params.mark
    Marks {}
    // any cell that is not params.body
  | Body {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- $Marks ---
    .decl mark(c: Color)
    mark(4).
    mark(6).

    // --- $Body ---
    .decl body(c: Color) body(1).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Marks()).
impl_choice($Body()).

.init blocks = Components<Unit>
blocks.node($U(), P) :- in(P, Col), !params.bg(Col).

// A cell that counts against its block.
.decl marked(ch: Choice, p: Position)

// --- $Marks ---
marked($Marks(), P) :- in(P, Col), params.mark(Col).

// --- $Body ---
marked($Body(), P) :- in(P, Col), !params.body(Col).

// --- $Marks, $Body ---

// Marked cells per block; a clean block counts 0.
.type BlockKey = [ch: Choice, id: Ident]

.init marks = Tally<BlockKey, Position>
marks.item([Ch, Id], P) :- marked(Ch, P), blocks.label($U(), P, Id).
marks.domain([Ch, Id]) :- impl_choice(Ch), blocks.label($U(), _, Id).

.init cleanest = ArgExtremes<Choice, Ident>
cleanest.cand(Ch, Id, N) :- marks.tally([Ch, Id], N).

// The kept block's box, which the output is cropped to.
.init crop_box = Bbox<Choice>
crop_box.cell(Ch, P) :- cleanest.low(Ch, Id, _), blocks.label($U(), P, Id).

out(P_out, Col, Ch) :- crop_box.box(Ch, B), in(P, Col), crop(P, B, P_out).

.comp Determine {
    // Every color a block shows besides its body.
    .decl mark(c: Color)
    mark(Col) :- ex_in(_, _, Col), !params.bg(Col), !params.body(Col).
}
