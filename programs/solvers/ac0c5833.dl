// ac0c5833
// @draft
// @keywords: markers stamp d4 bbox
// @scene markers: several markers of params.marker_color sit on a background
//  of params.bg. Each marker is three isolated cells at three corners of a
//  square box whose corners are params.marker_stride cells apart. The fourth
//  corner of the box, the marker's empty corner, does not hold the marker
//  color.
// @scene template: one shape of params.template_color has a bounding-box
//  corner at the empty corner of one marker, the template's marker, and lies
//  on the far side of that corner from the marker's three cells.
// @rule copy-per-marker: at each other marker, the template is drawn with its
//  bounding-box corner at that marker's empty corner, extending away from the
//  marker's three cells. Copy cells outside the grid are dropped. Undefined
//  where no marker, or more than one, is the template's marker.
// @rule mirror: the copy is the template mirrored across each axis on which
//  the target marker's empty corner lies on the other side of its box from
//  the template marker's empty corner.
// @rule overlay: only the template's cells are written; every other cell
//  keeps its input color.

// how a marker's box is sized
.type Extent =
    // @claim markers
    StoredStride {}
    // @scene markers: the stride is the one side s at which the marker-color
    //  cells split exactly into three-corner triples of s-sided square boxes.
    //  Undefined where no side gives such a split, or more than one does.
    // @witness stride-three: variant $DerivedStride
    //     @relaxed markers
  | DerivedStride {}
    // @scene markers: a marker is three marker-color cells at three corners
    //  of any axis-aligned rectangle whose sides are each at most
    //  params.marker_max_side, with the fourth corner not of that color.
    //  Undefined unless each marker-color cell lies in exactly one such
    //  triple.
    // @witness squashed-marker: borderline concept
    //     @relaxed markers
  | RectMarker {}

// where the marker color comes from
.type MarkerHue =
    // @claim markers
    StoredMarkerColor {}
    // @scene markers: the marker color is the one non-background color whose
    //  cells split exactly into the marker triples of the extent branch.
    //  Undefined where no such color does, or more than one does.
    // @witness green-markers: variant $DerivedMarkerColor
    //     @relaxed markers
  | DerivedMarkerColor {}

// which cells form the template
.type TemplateHue =
    // @claim template
    StoredTemplateColor {}
    // @scene template: the template is every cell that is neither background
    //  nor marker color.
    // @rule overlay: each template cell is copied in its own color. Undefined
    //  where two copies write different colors to one cell.
    // @witness green-template: variant $AnyColorTemplate
    //     @relaxed template
    // @witness two-color-template: variant $AnyColorTemplate
    //     @relaxed template
  | AnyColorTemplate {}

// how the copy is turned
.type Transform =
    // @claim mirror
    Mirror {}
    // @rule mirror: the copy is the template turned by the rotation that
    //  carries the template marker's corner onto the target marker's corner.
    // @witness asymmetric-template: variant concept
  | Rotate {}

// which cells a copy writes
.type Stamp =
    // @claim overlay
    InkOnly {}
    // @rule overlay: the copy writes the template's whole bounding box, and
    //  its background cells overwrite what they cover. Undefined where one
    //  copy's background meets another copy's template cell.
    // @witness copy-over-marker: borderline concept
  | BoxStamp {}

.type Choice = [extent: Extent, mcolor: MarkerHue, tcolor: TemplateHue, transform: Transform,
                stamp: Stamp]

// A reading of the markers: the extent branch and the marker-color branch.
.type Reader = [extent: Extent, mcolor: MarkerHue]

// A reading of the template: the marker branches and the template branch.
.type TmplKey = [extent: Extent, mcolor: MarkerHue, tcolor: TemplateHue]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $DerivedMarkerColor, $AnyColorTemplate, $BoxStamp ---
    // @derive DominantColor: variant derived
    //     @relaxed markers
    .decl bg(c: Color) bg(0).

    // --- $StoredStride ---
    // The distance between adjacent corners of a marker's box.
    // @derive TileCount: variant derived
    //     @relaxed markers
    // @derive SepTileCount: variant derived
    //     @relaxed markers
    .decl marker_stride(n: number) marker_stride(2).

    // --- $RectMarker ---
    // The longest side a marker's box may have.
    // @derive SepTileCount: borderline concept
    // @derive TileCount: ordinary concept
    // @open
    .decl marker_max_side(n: number)
    marker_max_side(2). marker_max_side(3). marker_max_side(4). marker_max_side(5).
    marker_max_side(6). marker_max_side(7). marker_max_side(8).

    // --- $StoredMarkerColor ---
    .decl marker_color(c: Color) marker_color(4).

    // --- $StoredTemplateColor ---
    // @derive RarestColor: variant derived
    //     @relaxed template
    .decl template_color(c: Color) template_color(2).
}

.init params = Params

// The marker triples of a grid, and whether a family of them splits a color's
// cells exactly.
.comp Parse<Key, Fam> {
    .decl cell(key: Key, p: Position, col: Color)

    // The colors whose triples a family reads.
    .decl hue(key: Key, fam: Fam, col: Color)

    // A family's triples at n are squares of side n.
    .decl square(key: Key, fam: Fam, n: number)

    // A family's triples at n have sides K1 and K2.
    .decl admits(key: Key, fam: Fam, n: number, k1: number, k2: number)

    // A length a side of a marker's box can take.
    .decl side(key: Key, k: number)
    side(Ky, K) :- cell(Ky, P, _), dir_elem(D), dist(P, D, K), K > 0.

    // Cells of color Col at corners C, P and Q of a box whose fourth corner E
    // holds another color. E lies toward X from C; P is K1 from C toward D1,
    // and Q is K2 from C toward D2.
    .decl triple(key: Key, col: Color, e: Position, x: DiagDir, c: Position, p: Position,
                 q: Position, k1: number, k2: number)
    triple(Ky, Col, E, X, C, P, Q, K1, K2) :-
        hue(Ky, _, Col), cell(Ky, C, Col), diag_dirs(X, _, D1, D2),
        side(Ky, K1), jump(C, D1, K1, P), cell(Ky, P, Col),
        side(Ky, K2), jump(C, D2, K2, Q), cell(Ky, Q, Col),
        jump(P, D2, K2, E), cell(Ky, E, _), !cell(Ky, E, Col).

    .decl box_triple(key: Key, fam: Fam, n: number, col: Color, e: Position, x: DiagDir,
                     c: Position, p: Position, q: Position)
    box_triple(Ky, F, N, Col, E, X, C, P, Q) :-
        square(Ky, F, N), hue(Ky, F, Col), triple(Ky, Col, E, X, C, P, Q, N, N).
    box_triple(Ky, F, N, Col, E, X, C, P, Q) :-
        admits(Ky, F, N, K1, K2), hue(Ky, F, Col), triple(Ky, Col, E, X, C, P, Q, K1, K2).

    // A cell of the triple whose empty corner is E and whose opposite corner
    // is C.
    .decl triple_cell(key: Key, fam: Fam, n: number, col: Color, e: Position, c: Position,
                      p: Position)
    triple_cell(Ky, F, N, Col, E, C, P) :-
        box_triple(Ky, F, N, Col, E, _, C, P1, Q1), ( P = C ; P = P1 ; P = Q1 ).

    // A cell of color Col lies in no triple, or in two.
    .decl split_fault(key: Key, fam: Fam, n: number, col: Color)
    split_fault(Ky, F, N, Col) :-
        box_triple(Ky, F, N, Col, _, _, _, _, _), cell(Ky, P, Col),
        !triple_cell(Ky, F, N, Col, _, _, P).
    split_fault(Ky, F, N, Col) :-
        triple_cell(Ky, F, N, Col, E, C, P), triple_cell(Ky, F, N, Col, E2, C2, P),
        ( E != E2 ; C != C2 ).

    // The cells of color Col split exactly into the family's triples at n.
    .decl exact_split(key: Key, fam: Fam, n: number, col: Color)
    exact_split(Ky, F, N, Col) :-
        box_triple(Ky, F, N, Col, _, _, _, _, _), !split_fault(Ky, F, N, Col).
}

// @ignore hue: store — the rows copy hue_cand, whose stored reading has its own line
// @ignore square: store — a side the grid lacks forms no triple, so the stored rows read
//  as the derived ones on every input
.init parse = Parse<Unit, Reader>
parse.cell($U(), P, Col) :- in(P, Col).
parse.hue($U(), [Ext, Mc], Col) :- hue_cand(Mc, Col), extent_choice(Ext).

.decl extent_choice(ext: Extent)
extent_choice($StoredStride()). extent_choice($DerivedStride()). extent_choice($RectMarker()).

.decl marker_hue_choice(mc: MarkerHue)
marker_hue_choice($StoredMarkerColor()). marker_hue_choice($DerivedMarkerColor()).

.decl template_hue_choice(tc: TemplateHue)
template_hue_choice($StoredTemplateColor()). template_hue_choice($AnyColorTemplate()).

.decl transform_choice(tr: Transform)
transform_choice($Mirror()). transform_choice($Rotate()).

.decl stamp_choice(sk: Stamp)
stamp_choice($InkOnly()). stamp_choice($BoxStamp()).

// Every combination of the branches, less those that take both DerivedStride
// and DerivedMarkerColor.
.decl impl_choice(ch: Choice)
impl_choice([Ext, Mc, Tc, Tr, Sk]) :-
    extent_choice(Ext), marker_hue_choice(Mc), template_hue_choice(Tc), transform_choice(Tr),
    stamp_choice(Sk),
    ( Ext != $DerivedStride() ; Mc != $DerivedMarkerColor() ).

// A color the marker-color branch admits as the marker color.
// @store: borderline concept
// @ignore: store $StoredMarkerColor — the stored rows read back params.marker_color, so the
//  model is the one that takes the derived value
.decl hue_cand(mc: MarkerHue, col: Color)

// A marker reading the branches admit: markers of color Col at n, the side
// for StoredStride and DerivedStride and the bound on the sides for
// RectMarker.
.decl reading_cand(ext: Extent, mc: MarkerHue, n: number, col: Color)

// Two readings compete at n.
.decl rival(ext: Extent, mc: MarkerHue, n: number)
rival(Ext, Mc, N) :- reading_cand(Ext, Mc, N, Col), reading_cand(Ext, Mc, N, Col2), Col != Col2.

.decl reading(ext: Extent, mc: MarkerHue, n: number, col: Color)
reading(Ext, Mc, N, Col) :- reading_cand(Ext, Mc, N, Col), !rival(Ext, Mc, N).

.decl marker_at(ext: Extent, mc: MarkerHue, n: number, e: Position, x: DiagDir)
marker_at(Ext, Mc, N, E, X) :-
    reading(Ext, Mc, N, Col), parse.box_triple($U(), [Ext, Mc], N, Col, E, X, _, _, _).

// The readings at two values of n disagree.
.decl split_reading(ext: Extent, mc: MarkerHue)
split_reading(Ext, Mc) :-
    marker_at(Ext, Mc, _, E, X), reading(Ext, Mc, N2, _), !marker_at(Ext, Mc, N2, E, X).

// A marker, by its empty corner E and the corner X of its box that E is.
.decl marker(ext: Extent, mc: MarkerHue, e: Position, x: DiagDir)
marker(Ext, Mc, E, X) :- marker_at(Ext, Mc, _, E, X), !split_reading(Ext, Mc).

.decl hue(ext: Extent, mc: MarkerHue, col: Color)
hue(Ext, Mc, Col) :- reading(Ext, Mc, _, Col), !split_reading(Ext, Mc).

.decl tmpl(k: TmplKey, p: Position, col: Color)

// @claim template
.init tmpl_box = Bbox<TmplKey>
tmpl_box.cell(K, P) :- tmpl(K, P, _).

// A marker whose empty corner is the template box's corner across from X.
.decl source_cand(k: TmplKey, e: Position, x: DiagDir)
source_cand([Ext, Mc, Tc], E, X) :-
    tmpl_box.box([Ext, Mc, Tc], B), marker(Ext, Mc, E, X),
    diag_opposite(X, X_o), box_corner(E, B, X_o).

// More than one marker could be the template's.
.decl source_clash(k: TmplKey)
source_clash(K) :- source_cand(K, E, X), source_cand(K, E2, X2), ( E != E2 ; X != X2 ).

// The template's marker.
.decl source(k: TmplKey, e: Position, x: DiagDir)
source(K, E, X) :- source_cand(K, E, X), !source_clash(K).

// The D4 element that carries the template marker's corner X onto a target
// marker's corner X2.
.decl carry(tr: Transform, x: DiagDir, x2: DiagDir, g: D4)

// The cells a copy writes, as offsets from the template marker's empty corner.
.decl footprint(k: TmplKey, sk: Stamp, v: Offset, col: Color)

// A cell a copy writes at another marker.
.decl copy(k: TmplKey, tr: Transform, sk: Stamp, p: Position, col: Color)
copy([Ext, Mc, Tc], Tr, Sk, P, Col) :-
    source([Ext, Mc, Tc], _, X), marker(Ext, Mc, E2, X2), !source([Ext, Mc, Tc], E2, _),
    carry(Tr, X, X2, G), footprint([Ext, Mc, Tc], Sk, V, Col),
    apply(G, V, V2), compose(E2, V2, P).

out(P, Col, [Ext, Mc, Tc, Tr, Sk]) :-
    source([Ext, Mc, Tc], _, _), impl_choice([Ext, Mc, Tc, Tr, Sk]), in(P, C0),
    ( copy([Ext, Mc, Tc], Tr, Sk, P, Col)
    ; !copy([Ext, Mc, Tc], Tr, Sk, P, _), Col = C0
    ).

// --- $StoredStride ---
parse.square($U(), [$StoredStride(), Mc], S) :- params.marker_stride(S), marker_hue_choice(Mc).

// --- $StoredStride & $StoredMarkerColor ---
reading_cand($StoredStride(), $StoredMarkerColor(), N, Col) :-
    parse.box_triple($U(), [$StoredStride(), $StoredMarkerColor()], N, Col, _, _, _, _, _).

// --- $StoredStride & $DerivedMarkerColor ---
reading_cand($StoredStride(), $DerivedMarkerColor(), N, Col) :-
    parse.exact_split($U(), [$StoredStride(), $DerivedMarkerColor()], N, Col).

// --- $DerivedStride ---
parse.square($U(), [$DerivedStride(), Mc], K) :- parse.side($U(), K), marker_hue_choice(Mc).

reading_cand($DerivedStride(), Mc, N, Col) :-
    parse.exact_split($U(), [$DerivedStride(), Mc], N, Col).

rival($DerivedStride(), Mc, N) :-
    reading_cand($DerivedStride(), Mc, N, _), reading_cand($DerivedStride(), Mc, N2, _), N != N2.

// --- $RectMarker ---
parse.admits($U(), [$RectMarker(), Mc], M, K1, K2) :-
    params.marker_max_side(M), marker_hue_choice(Mc),
    parse.side($U(), K1), K1 <= M, parse.side($U(), K2), K2 <= M.

reading_cand($RectMarker(), Mc, N, Col) :-
    parse.exact_split($U(), [$RectMarker(), Mc], N, Col).

// Some open value of the bound reads no markers.
split_reading($RectMarker(), Mc) :-
    params.marker_max_side(M), marker_hue_choice(Mc), !reading($RectMarker(), Mc, M, _).

// --- $StoredMarkerColor ---
hue_cand($StoredMarkerColor(), Col) :- params.marker_color(Col).

// --- $DerivedMarkerColor ---
hue_cand($DerivedMarkerColor(), Col) :- in(_, Col), !params.bg(Col).

// --- $StoredTemplateColor ---
tmpl([Ext, Mc, $StoredTemplateColor()], P, Col) :-
    hue(Ext, Mc, _), params.template_color(Col), in(P, Col).

// --- $AnyColorTemplate ---
tmpl([Ext, Mc, $AnyColorTemplate()], P, Col) :-
    hue(Ext, Mc, _), in(P, Col), !params.bg(Col), !hue(Ext, Mc, Col).

// --- $Mirror ---
// G carries some direction onto the other axis.
.decl axis_swap(g: D4)
axis_swap(G) :- apply_dir(G, D, D2), axis_of(D, A), !axis_of(D2, A).

carry($Mirror(), X, X2, G) :- apply_diag_dir(G, X, X2), !axis_swap(G).

// --- $Rotate ---
carry($Rotate(), X, X2, G) :- c4_elem(G), apply_diag_dir(G, X, X2).

// --- $InkOnly ---
footprint(K, $InkOnly(), V, Col) :- source(K, E, _), tmpl(K, P, Col), relative(E, P, V).

// --- $BoxStamp ---
footprint(K, $BoxStamp(), V, Col) :-
    source(K, E, _), tmpl_box.box(K, B), in(P, _), inside(P, B), relative(E, P, V),
    ( tmpl(K, P, Col)
    ; !tmpl(K, P, _), params.bg(Col)
    ).

.comp Determine {
    .init parse = Parse<Example, Unit>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).
    parse.hue(E, $U(), Col) :- ex_in(E, _, _), params.marker_color(Col).
    parse.admits(E, $U(), M, K1, K2) :-
        parse.side(E, M), parse.side(E, K1), K1 <= M, parse.side(E, K2), K2 <= M.

    // Some example's marker cells do not split exactly at bound M.
    .decl unsplit(m: number)
    unsplit(M) :-
        parse.side(_, M), ex_out(E, _, _), params.marker_color(Col),
        !parse.exact_split(E, $U(), M, Col).

    .decl marker_max_side(n: number)
    marker_max_side(M) :- parse.exact_split(_, $U(), M, _), !unsplit(M).
}
