// 3f23242b
// @draft
// @keywords: markers stamp cast lookup border occlude
// output: Each mark seats a bracket of ink on itself, and a line runs along one
//  bracket edge across the whole grid. The bracket covers the line where the two
//  meet, and every other cell passes through.

// how the bracket's ink is derived
.type Choice =
    // the bracket is a stored grid
    Lookup {}
    // each bracket edge paints in its own color, one axis's edges take the
    // corners, and the mark casts a stalk
  | Frame {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(col: Color) mark(3).

    // The side of the mark the line runs along, which fixes the bracket's
    // pose, and the line's color.
    .decl ground_dir(d: Dir) ground_dir(DIR_B).
    .decl ground_paint(col: Color) ground_paint(2).

    // The bracket in its own frame.
    RIGID(bracket,
        // The bracket cell that lands on the mark.
        .decl seat(p: Position) seat([2, 2, 2, 2]).

        // The bracket edge the line runs along.
        .decl ground(d: Dir) ground(DIR_B).

        // --- $Lookup ---
        .decl shape(p: Position, col: Color)
        GRID_SPARSE_5x5(shape,
            5, 5, 5, 5, 5,
            2, _, 5, _, 2,
            2, _, 3, _, 2,
            2, _, _, _, 2,
            8, 8, 8, 8, 8)

        // --- $Frame ---
        .decl edge_paint(d: Dir, col: Color)
        edge_paint(DIR_T, 5). edge_paint(DIR_B, 8). edge_paint(DIR_L, 2). edge_paint(DIR_R, 2).

        // The axis whose edges take the corners.
        .decl face_axis(a: Axis) face_axis(AXIS_V).

        // The stalk the mark sends out.
        .decl arm_dir(d: Dir) arm_dir(DIR_T).
    )

    // --- $Frame ---
    // The stalk's color.
    .decl arm_paint(col: Color) arm_paint(5).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Lookup()). impl_choice($Frame()).

// The bracket's own frame, read off the seat, at each pose whose ground edge
// faces the line's side.
.init box = Frame2D<D4>
box.extent(G, A, N) :-
    params.bracket_ground(G, D), params.ground_dir(D),
    params.bracket_seat(G, P), axis_elem(A), axis_dim(P, A, N).

// The bracket seated on each mark: a bracket cell and the grid cell it
// lands on.
.decl placed(g: D4, p_box: Position, p_grid: Position)
placed(G, P_box, P_grid) :-
    in(Q, Col_mark), params.mark(Col_mark), box.cell(G, P_box),    // a mark, a bracket cell
    params.bracket_seat(G, P_seat), relative(P_seat, P_box, Off),  // its offset from the seat
    compose(Q, Off, P_grid), in(P_grid, _).                        // seated on the mark, on-grid

// The line the brackets stand on: the ground edge run out across the grid,
// where no bracket covers it.
.decl line_cell(p: Position)
line_cell(P) :-
    placed(G, P_box, P_ground), params.bracket_ground(G, D), dist(P_box, D, 0),  // a ground-edge cell
    same_dist(D, P_ground, P), in(P, _), !placed(_, _, P).                       // out across the grid

.decl paint(p: Position, col: Color, ch: Choice)
paint(P, Col, Ch) :- line_cell(P), params.ground_paint(Col), impl_choice(Ch).

// --- $Lookup ---
paint(P_grid, Col, $Lookup()) :- placed(G, P_box, P_grid), params.bracket_shape(G, P_box, Col).

// --- $Frame ---
// The stalk the mark casts, which the bracket's edges halt.
.init stalk = Ray<D4>
stalk.cell(G, P) :- box.cell(G, P).
stalk.mark(G, P) :- params.bracket_seat(G, P).
stalk.dir(G, D) :- params.bracket_arm_dir(G, D).
stalk.blocked(G, P) :- on_edge(G, P, _).

.decl on_edge(g: D4, p_box: Position, d: Dir)
on_edge(G, P, D) :- box.cell(G, P), dir_elem(D), dist(P, D, 0).

.decl on_face(g: D4, p_box: Position)
on_face(G, P) :- on_edge(G, P, D), params.bracket_face_axis(G, A), axis_of(D, A).

.decl frame_ink(g: D4, p_box: Position, col: Color)
frame_ink(G, P, Col) :-
    on_edge(G, P, D), params.bracket_edge_paint(G, D, Col), params.bracket_face_axis(G, A),
    ( axis_of(D, A)      // a face edge, corners included
    ; !on_face(G, P)     // a side edge, corners excluded
    ).
frame_ink(G, P, Col) :- stalk.clear(G, P, _, K, _), K != 0, params.arm_paint(Col).

paint(P_grid, Col, $Frame()) :- placed(G, P_box, P_grid), frame_ink(G, P_box, Col).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !paint(P, _, Ch).

.comp Determine {
    .decl mark_at(e: Example, p: Position)
    mark_at(E, P) :- ex_in(E, P, Col), params.mark(Col).

    // What an output paints: the mark's own cell, and every repainted cell.
    .decl painted(e: Example, p: Position, col: Color)
    painted(E, P, Col) :-
        ex_out(E, P, Col),                    // an output cell
        ( mark_at(E, P)                       // the mark's own cell
        ; ex_in(E, P, Col_in), Col_in != Col  // repainted
        ).

    // Paint in a color other than the line's — the bracket's own ink.
    .decl ink(e: Example, p: Position, col: Color)
    ink(E, P, Col) :- painted(E, P, Col), !params.ground_paint(Col).

    .decl cand(off: Offset, col: Color)
    cand(Off, Col) :- ink(E, P, Col), mark_at(E, M), relative(M, P, Off).

    // An offset some mark misses, on-grid or off, is not the bracket's. Only
    // an example with outputs can miss one.
    .decl missed(off: Offset, col: Color)
    missed(Off, Col) :-
        cand(Off, Col), ex_out(E, _, _), mark_at(E, M),  // a mark of an answered example
        compose(M, Off, P), !ink(E, P, Col).             // no such ink under it

    // The bracket's frame is the ink's bounding box, and the mark sits at
    // the offsets' origin.
    .init frame = Bbox<Unit>
    frame.cell($U(), Off) :- cand(Off, Col), !missed(Off, Col).

    .decl bracket_seat(p: Position)
    bracket_seat(P) :- frame.box($U(), B), crop(ZERO, B, P).

    // The bracket, in its own frame: the paint each mark holds under it.
    .decl bracket_shape(p: Position, col: Color)
    bracket_shape(P_box, Col) :-
        painted(E, P, Col), mark_at(E, M), relative(M, P, Off),  // paint, from a mark
        frame.box($U(), B), crop(Off, B, P_box).                 // inside the frame

    .decl corner(p_box: Position)
    corner(P) :- bracket_shape(P, _), diag_dir_elem(Diag), corner_anchor(Diag, P, ZERO).

    // A corner lies on two edges, so an edge's color reads off its other cells.
    .decl bracket_edge_paint(d: Dir, col: Color)
    bracket_edge_paint(D, Col) :-
        bracket_shape(P, Col), dir_elem(D), dist(P, D, 0), !corner(P).

    // The ink off the edges beside the mark.
    .decl arm(d: Dir, col: Color)
    arm(D, Col) :-
        bracket_shape(P, Col), interior(P, ZERO),
        bracket_seat(P_seat), dir_elem(D), neighbor(P_seat, D, P).

    .decl bracket_arm_dir(d: Dir)
    bracket_arm_dir(D) :- arm(D, _).

    .decl arm_paint(col: Color)
    arm_paint(Col) :- arm(_, Col).
}
