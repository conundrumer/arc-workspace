// 8eb1be9a
// @keywords: wallpaper count
// input: A band of patterned rows sits in an otherwise empty grid.
// output: Output tiles the whole grid with the band along the axis, phase
//  preserved: the band's extent is the period along the axis.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl axis(a: Axis) axis(AXIS_V).
}

.init params = Params

// Band rows: the rows carrying pattern cells, as axis-only row positions.
.decl band_row(al: Position)
band_row(Al) :- in(P, Col), !params.bg(Col), params.axis(A), split(P, A, Al, _).

.init period = Tally<Unit, Position>
period.item($U(), Al) :- band_row(Al).

// Each cell takes the color of the band cell on its line at its place
// within the band's extent.
out(Q, Col) :-
    in(P, Col), params.axis(A), split(P, A, Al, _), band_row(Al),   // a band cell
    in(Q, _), same_line(A, P, Q),                                   // a cell on its line
    period.tally($U(), N), axis_of(D, A),
    dist(P, D, T), stride(T, N, 0, _, R),
    dist(Q, D, T2), stride(T2, N, 0, _, R).                         // one place within the period
