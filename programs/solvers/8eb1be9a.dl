// 8eb1be9a
// concept: wallpaper count
// A band of patterned rows sits in an otherwise empty grid.
// Output tiles the whole grid with the band along c.axis, phase preserved:
// colors propagate from the band by jumps of the band's extent in both
// directions.

#include "../lib.dl"

.comp Consts {
    .decl bg(col: Color) bg(0).
    .decl axis(a: Axis) axis(AXIS_V).
}

.init c = Consts

// Band rows: the rows carrying pattern cells, as axis-only row positions.
.decl band_row(al: Position)
band_row(Al) :- in(P, Col), !c.bg(Col), c.axis(A), split(P, A, Al, _).

.init period = Tally<Unit, Position>
period.item($U(), Al) :- band_row(Al).

// Closure under the tiling's translations: band-extent jumps along the axis.
.decl out(p: Position, col: Color)
out(P, Col) :- in(P, Col), c.axis(A), split(P, A, Al, _), band_row(Al).
out(Q, Col) :-
    out(P, Col),
    c.axis(A), axis_of(D, A), period.tally($U(), N),   // the axis's two jump directions
    jump(P, D, N, Q), in(Q, _).
