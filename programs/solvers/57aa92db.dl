// 57aa92db
// draft
// concept: objects markers scale stamp
// Every object carries a mark in the one color they all share, and its own
// color elsewhere. Each object is a copy of one shape drawn in tiles the size
// of its mark: the template is the copy showing the most tiles, the rest
// showing their mark and one tile beside it. The output draws every copy in
// full on the background: the shape at the object's tile size, seated so the
// shape's mark tile covers the object's mark, in the object's own color apart
// from that mark tile, which keeps the shared color.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.init objs = Components8<Unit>
objs.node($U(), P) :- in(P, Col), !params.bg(Col).

.decl obj(id: Ident)
obj(O) :- objs.label($U(), _, O).

.decl obj_cell(id: Ident, p: Position, col: Color)
obj_cell(O, P, Col) :- objs.label($U(), P, O), in(P, Col).

// The mark color: the one color every object carries.
.decl unshared(col: Color)
unshared(Col) :- obj_cell(_, _, Col), obj(O), !obj_cell(O, _, Col).

.decl mark_col(col: Color)
mark_col(Col) :- obj_cell(_, _, Col), !unshared(Col).

// The object's own color — what its copy of the shape is drawn in.
.decl body_col(id: Ident, col: Color)
body_col(O, Col) :- obj_cell(O, _, Col), !mark_col(Col).

// The mark's block: one tile of the object's copy, and so its size.
.init block = BoxFrame<Ident>
block.cell(O, P) :- obj_cell(O, P, Col), mark_col(Col).
block.grid(O, P) :- obj(O), in(P, _).

// Each object as a grid of tiles the size of its mark.
.init obj_box = BoxFrame<Ident>
obj_box.cell(O, P) :- obj_cell(O, P, _).

.init obj_grid = Tile2D<Ident>
obj_grid.cell(P_inner) :- obj_box.inner(_, _, P_inner).
obj_grid.dim(O, A, K) :- block.extent(O, A, K).
obj_grid.gap(0).

// The template: the object showing the most tiles of the shape.
.init fullest = Mode<Unit, Ident, Position>
fullest.item($U(), O, P_tile) :-
    obj_box.inner(O, _, P_inner), obj_grid.tile(O, P_inner, P_tile, _).

// The shape, tile by tile, in the template's own box.
.decl shape_cell(p_tile: Position, col: Color)
shape_cell(P_tile, Col) :-
    fullest.mode($U(), O),                               // the template
    obj_box.inner(O, P_grid, P_inner), in(P_grid, Col),  // its cells, in its own box
    obj_grid.tile(O, P_inner, P_tile, _).                // read at its tile size

// --- program ---

// Where an object's copy sits: the seat carrying the scaled shape's mark tile
// onto the object's mark.
.decl seat(id: Ident, v: Box)
seat(O, V) :-
    shape_cell(P_tile, Col), mark_col(Col),      // the shape's mark tile
    block.inner(O, P_grid, P_intile),            // the object's mark, cell by cell
    concat_2d(P_tile, P_intile, 0, P_stamp),     // that cell of the scaled shape
    relative(P_stamp, P_grid, V).

// A cell of an object's copy, with the color of the shape cell it comes from.
.decl stamp(id: Ident, p_grid: Position, col: Color)
stamp(O, P_grid, C_shape) :-
    seat(O, V), shape_cell(P_tile, C_shape),
    block.inner(O, _, P_intile), concat_2d(P_tile, P_intile, 0, P_stamp),
    compose(P_stamp, V, P_grid), in(P_grid, _).

.decl out(p: Position, col: Color)
out(P_grid, Col) :-
    stamp(O, P_grid, C_shape),
    ( mark_col(C_shape), Col = C_shape       // the mark keeps the shared color
    ; !mark_col(C_shape), body_col(O, Col)   // the shape takes the object's color
    ).
out(P, Col) :- in(P, _), !stamp(_, P, _), params.bg(Col).
