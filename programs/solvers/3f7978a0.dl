// 3f7978a0
// concept: crop markers select
// Two parallel c.bar lines over bg and noise, each end capped one step
// beyond by a c.cap cell. Output is the spanned region cropped, content
// passing through. Two claims of the region's along-axis extent:
//
//   $Cap  — the cap cells bound it: the region is the bbox of bars and caps.
//   $Grow — the bar bbox grows one step along the axis; the caps are noise.

#include "../lib.dl"

.type Choice = Cap {} | Grow {}

.comp Consts {
    // --- shared ---
    .decl bar(c: Color) bar(5).
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Cap ---
    .decl cap(c: Color) cap(8).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Cap()). impl_choice($Grow()).

.decl bar(p: Position)
bar(P) :- in(P, Col), c.bar(Col).

// Cell one step beyond a bar cell along the axis.
.decl stepped(p: Position)
stepped(P2) :- bar(P), c.axis(A), axis_of(D, A), step_delta(D, S), compose(P, S, P2).

.init box = BoxFrame<Choice>
box.grid(Ch, P) :- impl_choice(Ch), in(P, _).
box.cell(Ch, P) :- impl_choice(Ch), bar(P).

// --- $Cap ---
box.cell($Cap(), P) :- stepped(P), in(P, Col), c.cap(Col).

// --- $Grow ---
box.cell($Grow(), P) :- stepped(P).

.decl out(p: Position, col: Color, ch: Choice)
out(P_out, Col, Ch) :- in(P, Col), box.inner(Ch, P, P_out).
