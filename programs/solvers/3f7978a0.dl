// 3f7978a0
// keywords: crop markers select
// input: two parallel params.bar lines over bg and noise, each end capped one
//  step beyond by a params.cap cell
// output: The spanned region crops out, with its content passing through
//  unchanged.

// the region's extent along the axis
.type Choice =
    // the cap cells bound it: the region is the bbox of bars and caps
    Cap {}
    // the bar bbox grows one step along the axis; the caps are noise
  | Grow {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bar(c: Color) bar(5).
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Cap ---
    .decl cap(c: Color) cap(8).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Cap()). impl_choice($Grow()).

.decl bar(p: Position)
bar(P) :- in(P, Col), params.bar(Col).

// Cell one step beyond a bar cell along the axis.
.decl stepped(p: Position)
stepped(P2) :- bar(P), params.axis(A), axis_of(D, A), neighbor(P, D, P2).

.init hull = Bbox<Choice>
hull.cell(Ch, P) :- impl_choice(Ch), bar(P).

// --- $Cap ---
hull.cell($Cap(), P) :- stepped(P), in(P, Col), params.cap(Col).

// --- $Grow ---
hull.cell($Grow(), P) :- stepped(P).

out(P_out, Col, Ch) :- in(P, Col), hull.box(Ch, B), crop(P, B, P_out).
