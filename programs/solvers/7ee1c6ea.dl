// 7ee1c6ea
// @draft
// @keywords: border enclose mapping
// input: A rectangle outline in params.frame sits in a field of params.bg and
//  two ink colors.
// output: Inside the outline, the two ink colors trade places; the outline
//  and everything outside it stay as they are.

// which cells count as inside the outline
.type Inside =
    // the cells strictly inside the frame's bounding box
    Box {}
    // the region the frame cuts off from the grid edge
  | Enclose {}

// which two colors trade places
.type Palette =
    // the two ink colors are those the inside holds
    Held {}
    // the two ink colors are those of the whole grid, less the frame
  | Field {}

// the inside test and the palette rule, chosen independently
.type Choice  = [i: Inside, pal: Palette]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl frame(col: Color) frame(5).
}

.init params = Params

.decl frame_cell(p: Position)
frame_cell(P) :- in(P, Col), params.frame(Col).

.decl inside_choice(i: Inside)
inside_choice($Box()). inside_choice($Enclose()).

.decl palette_choice(pal: Palette)
palette_choice($Held()). palette_choice($Field()).

.decl impl_choice(ch: Choice)
impl_choice([I, Pal]) :- inside_choice(I), palette_choice(Pal).

// --- inside ---

.decl within(p: Position, i: Inside)

.init fbox = Bbox<Unit>
fbox.cell($U(), P) :- frame_cell(P).

within(P, $Box()) :- in(P, _), fbox.box($U(), B), interior(P, B).

.init closed = Closed<Unit>
closed.cell($U(), P) :- in(P, _), !frame_cell(P).

within(P, $Enclose()) :- closed.region($U(), P, _).

// --- palette ---

.decl ink(col: Color, ch: Choice)
ink(Col, [I, $Held()]) :- within(P, I), in(P, Col), !params.bg(Col).
ink(Col, [I, $Field()]) :- inside_choice(I), in(_, Col), !params.bg(Col), !params.frame(Col).

// --- output ---

// Each ink color becomes the other.
.decl swap(col: Color, col2: Color, ch: Choice)
swap(Col, Col2, Ch) :- ink(Col, Ch), ink(Col2, Ch), Col != Col2.

.decl traded(p: Position, col: Color, ch: Choice)
traded(P, Col2, [I, Pal]) :- within(P, I), in(P, Col), swap(Col, Col2, [I, Pal]).

out(P, Col, Ch) :- traded(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !traded(P, _, Ch).
