// e681b708
// @draft
// @keywords: decompose markers rank
// @scene wall-lines: horizontal and vertical lines of params.line_color (1)
//  on a params.background (0) field, each running from a grid edge or another line
//  to a grid edge or another line
// @scene markers: each end of a line and each cell where lines meet holds a
//  marker, a color other than params.line_color and params.background, and no other
//  line cell does
// @scene rooms: the lines cut the grid into rectangular rooms, each a
//  4-connected part of the cells that are not line cells
// @scene loose-dots: each room holds single cells of params.line_color, no
//  two 4-adjacent, none 4-adjacent to a line cell
// @scene clear-majority: among the markers on the walls of each room that
//  holds a dot, one color occurs more often than every other
// @rule dot-recolor: a line cell is a marker, or a params.line_color cell on
//  a straight run of params.line_color cells between two markers in its row
//  or column; every other params.line_color cell is a dot, and takes the
//  color that occurs most often among the markers 8-adjacent to its room
// @rule rest-kept: every other cell keeps its input color

// how non-line cells join into rooms
.type Connect =
    // @claim rooms
    Rooms4 {}
    // @scene rooms: non-line cells join by 8-adjacency, so two walls that
    //  touch only at a corner do not close a room
    // @witness diagonal-pinch: foreign concept
    //     @relaxed wall-lines
  | Rooms8 {}

// which params.line_color cells are dots
.type DotSet =
    // @claim dot-recolor
    RunDots {}
    // @rule dot-recolor: only params.line_color cells whose 4-adjacent cells
    //  are all params.background are dots, and every other params.line_color cell
    //  keeps its color
    // @witness domino-dot: variant concept
    //     @relaxed loose-dots
  | IsolatedDots {}
    // @rule dot-recolor: the dots are the params.line_color cells whose
    //  4-connected part of cells other than params.background holds no marker
    // @witness dot-touching-wall: variant concept
    //     @relaxed loose-dots
  | MarkerFreeParts {}

.type Choice = [rooms: Connect, dots: DotSet]

// A room, under the connectivity that finds it.
.type Room = [conn: Connect, id: Ident]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: borderline concept
    //     @relaxed loose-dots
    .decl background(c: Color) background(0).
    // the color of the lines and of the dots
    .decl line_color(c: Color) line_color(1).
}

.init params = Params

.decl connect_choice(r: Connect)
connect_choice($Rooms4()). connect_choice($Rooms8()).

.decl dot_set_choice(d: DotSet)
dot_set_choice($RunDots()). dot_set_choice($IsolatedDots()). dot_set_choice($MarkerFreeParts()).

.decl impl_choice(ch: Choice)
impl_choice([R, Dt]) :- connect_choice(R), dot_set_choice(Dt).

.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !params.background(Col), !params.line_color(Col).

// Casts from each marker along its row and column through line cells.
// @claim dot-recolor
.init runs = Ray<Unit>
runs.dir($U(), D) :- dir_elem(D).
runs.cell($U(), P) :- in(P, _).
runs.mark($U(), P) :- marker(P, _).
runs.blocked($U(), P) :- in(P, Col), !params.line_color(Col).

.decl line(p: Position)
line(P) :- marker(P, _).
line(P) :- runs.clear(_, P, D, _, S), runs.stop(_, Q, D, _, S), marker(Q, _).   // run ends on a marker

.decl room(r: Connect, p: Position, id: Ident)

.decl dot(dt: DotSet, p: Position)

// The commonest marker color around each room, each marker counted once.
// @claim dot-recolor clear-majority
.init tally = Mode<Room, Color, Position>
tally.item([R, Id], Col, M) :- room(R, P, Id), dir8_elem(D), neighbor(P, D, M), marker(M, Col).

out(P, Col, [R, Dt]) :- dot(Dt, P), room(R, P, Id), tally.mode([R, Id], Col).
out(P, Col, Ch) :- impl_choice(Ch), Ch = [_, Dt], in(P, Col), !dot(Dt, P).

// --- $Rooms4 ---

// @claim rooms
.init rooms4 = Components<Unit>
rooms4.node($U(), P) :- in(P, _), !line(P).

room($Rooms4(), P, Id) :- rooms4.label(_, P, Id).

// --- $Rooms8 ---

// @claim rooms
.init rooms8 = Components8<Unit>
rooms8.node($U(), P) :- in(P, _), !line(P).

room($Rooms8(), P, Id) :- rooms8.label(_, P, Id).

// --- $RunDots ---

dot($RunDots(), P) :- in(P, Col), params.line_color(Col), !line(P).

// --- $IsolatedDots ---

// A cell with a 4-adjacent cell other than params.background.
.decl touched(p: Position)
touched(P) :- in(P, _), dir_elem(D), neighbor(P, D, Q), in(Q, Col), !params.background(Col).

dot($IsolatedDots(), P) :- in(P, Col), params.line_color(Col), !touched(P).

// --- $MarkerFreeParts ---

// @claim dot-recolor
.init parts = Components<Unit>
parts.node($U(), P) :- in(P, Col), !params.background(Col).

.decl marked_part(id: Ident)
marked_part(Id) :- parts.label(_, P, Id), marker(P, _).

dot($MarkerFreeParts(), P) :- parts.label(_, P, Id), !marked_part(Id).

.comp Determine {
    // A cell an output recolors: a dot.
    .decl dot(e: Example, p: Position)
    dot(E, P) :- ex_in(E, P, C), ex_out(E, P, C2), C != C2.

    // The color a dot holds in the input.
    .decl line_color(c: Color)
    line_color(C) :- dot(E, P), ex_in(E, P, C).

    // The field around the dots: a color beside a dot other than the dot's own.
    .decl background(c: Color)
    background(C) :-
        dot(E, P), ex_in(E, P, C_dot),
        dir_elem(D), neighbor(P, D, Q), ex_in(E, Q, C), C != C_dot.
}
