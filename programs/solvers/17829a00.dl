// 17829a00
// draft
// concept: objects move
// A border line caps each end of params.axis, one color per border. The objects
// between them wear those two colors. Each object slides along the axis to
// the border matching its color and stops against it, leaving params.bg behind.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(7).

    // The axis the borders cap at both ends.
    .decl axis(a: Axis) axis(AXIS_V).
}

.init params = Params

// --- the borders and what lies between ---

.decl border_cell(d: Dir, p: Position)
border_cell(D, P) :- params.axis(A), axis_of(D, A), in(P, _), dist(P, D, 0).

.decl inner_cell(p: Position)
inner_cell(P) :- in(P, _), !border_cell(_, P).

// --- the objects ---

.init obj = Components8<Color>
obj.node(Col, P) :- inner_cell(P), in(P, Col), !params.bg(Col).

// --- the slide ---

// An object travels toward the border that shares its color.
.decl move_dir(id: Ident, d: Dir)
move_dir(Id, D) :-
    obj.label(Col, _, Id),          // the object's color
    border_cell(D, P), in(P, Col).  // the border wearing it

// An object fits at a displacement when its every cell lands off its border.
.init fits = Occurrences<Ident, Unit>
fits.cell(Id, P, $U())  :- move_dir(Id, D), in(P, _), !border_cell(D, P).
fits.shape(Id, P, $U()) :- obj.label(_, P, Id).

// Each object travels through the displacements at which it fits.
.init slide = Slide<Ident>
slide.dir(Id, D) :- move_dir(Id, D).
slide.node(Id, Delta) :- fits.occurrence(Id, Delta).

// --- output ---

.decl landed(p: Position, col: Color)
landed(P2, Col) :-
    slide.rest(Id, ZERO, _, Delta),              // the object at rest
    obj.label(Col, P, Id), compose(P, Delta, P2).  // its cells, carried there

.decl out(p: Position, col: Color)
out(P, Col) :- border_cell(_, P), in(P, Col).
out(P, Col) :- landed(P, Col).
out(P, Col) :- inner_cell(P), !landed(P, _), params.bg(Col).
