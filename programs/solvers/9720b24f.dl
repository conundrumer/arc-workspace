// 9720b24f
// @draft
// @keywords: objects enclose color-class select
// @scene container: a container is every cell of one color
// @scene outline-shape: each container is drawn as one 8-connected
//  shape.
// @rule inside: a non-bg cell is erased to bg when it lies inside a
//  container it does not belong to
//     @approximated: a cell lies inside a container when the
//      container's cells are on both sides of it along one axis, and one
//      is to a side of the other axis
//     @witness far-marks: variant $Shape
//     @witness open-chevron: variant other
// @rule pass: every other cell passes through unchanged

// what a container is
.type Choice =
    // @claim container
    ColorClass {}
    // @scene container: a container is one 8-connected shape of non-bg cells
    // @witness broken-ring: variant concept
    //     @relaxed outline-shape
  | Shape {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($ColorClass()). impl_choice($Shape()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// Two cells of one container.
.decl together(ch: Choice, p: Position, q: Position)

// --- $ColorClass ---
together($ColorClass(), P, Q) :- ink(P, Col), ink(Q, Col).

// --- $Shape ---
// @claim container
.init shapes = Components8<Color>
shapes.node(Col, P) :- ink(P, Col).

together($Shape(), P, Q) :- shapes.label(Col, P, Id), shapes.label(Col, Q, Id).

// A cell of Q's container lies toward D from inked cell P.
.decl sees(ch: Choice, p: Position, q: Position, d: Dir)
sees(Ch, P, Q, D) :-
    ink(P, _), together(Ch, Q, Q2),                          // an inked cell, a container cell
    axis_of(D, A), same_line(A, P, Q2), nearer(D, Q2, P).    // on P's line, toward D

// Q's container sits on both sides of P along axis A.
.decl between(ch: Choice, p: Position, q: Position, a: Axis)
between(Ch, P, Q, A) :- sees(Ch, P, Q, D), sees(Ch, P, Q, D2), opposite(D, D2), axis_of(D, A).

// P sits inside Q's container.
.decl surrounded(ch: Choice, p: Position, q: Position)
surrounded(Ch, P, Q) :- between(Ch, P, Q, A), perp(A, A2), axis_of(D, A2), sees(Ch, P, Q, D).

.decl erased(ch: Choice, p: Position)
erased(Ch, P) :- surrounded(Ch, P, Q), !together(Ch, P, Q).

out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !erased(Ch, P).
out(P, Col, Ch) :- erased(Ch, P), params.bg(Col).
