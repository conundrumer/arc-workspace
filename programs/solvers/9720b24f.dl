// 9720b24f
// @draft
// @keywords: objects enclose color-class select
// @scene container: a container is every cell of one color
// @scene outline-shape: each container is drawn as one 8-connected
//  shape.
// @rule inside: a non-bg cell is erased to bg when it lies inside a
//  container it does not belong to, the container closing about two-thirds of
//  the circle around the cell
//     @approximated: a cell lies inside a container when the
//      container's cells are on both sides of it along one axis, and one
//      is to a side of the other axis
//     @witness two-gap-ring: variant other
//         @relaxed outline-shape
// @rule pass: every other cell passes through unchanged

// what a container is
.type Choice =
    // @claim container
    ColorClass {}
    // @scene container: a container is one 8-connected shape of non-bg cells
    // @witness broken-ring: variant concept
    //     @relaxed outline-shape
    // @witness far-marks: variant $Shape
    //     @relaxed outline-shape
  | Shape {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($ColorClass()). impl_choice($Shape()).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// The container a cell belongs to.
.decl container(ch: Choice, p: Position, k: Ident)

// --- $ColorClass ---
// @claim container
.init color_id = IdentOf<Color>
color_id.value(Col) :- ink(_, Col).
container($ColorClass(), P, K) :- ink(P, Col), color_id.id(Col, K).

// --- $Shape ---
// @claim container
.init shapes = Components8<Color>
shapes.node(Col, P) :- ink(P, Col).

container($Shape(), P, Id) :- shapes.label(_, P, Id).

// --- $ColorClass, $Shape ---
// A cell of container K lies toward D from inked cell P.
.decl sees(ch: Choice, p: Position, k: Ident, d: Dir)
sees(Ch, P, K, D) :-
    ink(P, _), container(Ch, Q, K),                         // an inked cell, a container cell
    axis_of(D, A), same_line(A, P, Q), nearer(D, Q, P).     // on P's line, toward D

// Container K sits on both sides of P along axis A.
.decl between(ch: Choice, p: Position, k: Ident, a: Axis)
between(Ch, P, K, A) :- sees(Ch, P, K, D), sees(Ch, P, K, D2), opposite(D, D2), axis_of(D, A).

// P sits inside container K.
.decl surrounded(ch: Choice, p: Position, k: Ident)
surrounded(Ch, P, K) :- between(Ch, P, K, A), perp(A, A2), axis_of(D, A2), sees(Ch, P, K, D).

.decl erased(ch: Choice, p: Position)
erased(Ch, P) :- surrounded(Ch, P, K), !container(Ch, P, K).

out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !erased(Ch, P).
out(P, Col, Ch) :- erased(Ch, P), params.bg(Col).
