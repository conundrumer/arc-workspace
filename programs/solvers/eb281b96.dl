// eb281b96
// concept: tile-arrangement lookup d4 unfold
// 4×1 vertical fold: alternating D4_ID / D4_TB tiles overlap by one
// row (gap −1), so each boundary row is shared; output rows trace a
// triangle wave between the input's first and last rows.
//
// Cases (data-equivalent on this task):
//   $Lookup() — per-tile D4 table
//   $Unfold() — reflection tiling: each tile reflects its neighbor across
//               the shared boundary row, seeded at the anchor tile

#include "../lib.dl"

.type Choice = Lookup {} | Unfold {}

.comp Consts {
    // --- shared ---
    .decl tile_axis(a: Axis) tile_axis(AXIS_V).
    .decl tile_count(n: number) tile_count(4).
    .decl tile_gap(g: number) tile_gap(-1).

    // --- Lookup ---
    .decl tile(p: Position, d: D4)
    GRID_4x1(tile,
        D4_ID,
        D4_TB,
        D4_ID,
        D4_TB)

    // --- Unfold ---
    .decl anchor(d: Dir) anchor(DIR_T).
}

.init c = Consts

// The tile arrangement. $Lookup keys its table by these positions;
// $Unfold walks them.
.init arr = AxisFrame<Unit>
arr.extent($U(), A, N) :- c.tile_axis(A), c.tile_count(N).

.decl out(p: Position, col: Color, c: Choice)

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                      // input cell
    c.tile(P_tile, D), apply(D, P_in, P_intile),        // d4 image at tile
    c.tile_axis(A), c.tile_gap(G),                      // tile params
    concat_slab(P_tile, P_intile, A, G, P_grid).        // recompose with passthrough

// --- Unfold ---
// Tile contents: the input seeds the anchor-end tile; each neighbor
// reflects across the shared boundary.
.decl unfold_val(p_tile: Position, p_intile: Position, col: Color)
unfold_val(T, P, Col) :- in(P, Col), arr.cell($U(), _, T), c.anchor(D), dist(T, D, 0).
unfold_val(T2, P_img, Col) :-
    unfold_val(T, P, Col),                                      // known tile
    axis_of(D, A), step_delta(D, S), compose(T, S, T2),         // neighbor toward d
    arr.cell($U(), A, T2),                                      // still on the arrangement
    flip_of(A, F), apply(F, P, P_img).                          // reflect across the shared edge

out(P_grid, Col, $Unfold()) :-
    unfold_val(T, P_intile, Col),
    c.tile_axis(A), c.tile_gap(G),
    concat_slab(T, P_intile, A, G, P_grid).

// --- fit ---

.comp Fit {
    .decl tile_size(e: Example, k: number)
    tile_size(E, K) :- ex_in(E, P, _), c.tile_axis(A), axis_dim(P, A, K).

    .decl tile_gap(g: number)
    tile_gap(G) :-
        c.tile_axis(A), c.tile_count(N),        // arrangement
        ex_out(E, P_out, _), tile_size(E, K),   // output frame, and the tile extent
        divide_gap(P_out, A, N, K, G).

    // A 1-D arrangement folds within its own axis, so a tile's transform is
    // one that leaves every cell's across coordinate alone.
    .decl across_moved(d: D4)
    across_moved(D) :-
        d4_elem(D), ex_in(_, P, _), c.tile_axis(A),
        apply(D, P, P_img),                                          // the cell's image
        split(P, A, _, P_across), split(P_img, A, _, P_across2),     // across coordinates
        P_across != P_across2.

    .decl axial(d: D4)
    axial(D) :- d4_elem(D), !across_moved(D).

    .decl paired(e: Example)
    paired(E) :- ex_out(E, _, _).

    .decl placed(e: Example, p_tile: Position, d: D4, p_grid: Position, col: Color)
    placed(E, P_tile, D, P_grid, Col) :-
        ex_in(E, P, Col), paired(E),                    // cell of a train input
        axial(D), apply(D, P, P_intile),                // its image under an axial transform
        arr.cell($U(), A, P_tile), tile_gap(G),         // tile position and gap
        concat_slab(P_tile, P_intile, A, G, P_grid).    // recompose with passthrough

    // A transform that lands some cell of its tile off the output's color.
    .decl mismatch(p_tile: Position, d: D4)
    mismatch(P_tile, D) :- placed(E, P_tile, D, P_grid, Col), !ex_out(E, P_grid, Col).

    .decl tile(p: Position, d: D4)
    tile(P_tile, D) :- arr.cell($U(), _, P_tile), axial(D), !mismatch(P_tile, D).
}
