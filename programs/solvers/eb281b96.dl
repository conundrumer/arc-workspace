// eb281b96
// @keywords: tile-arrangement lookup d4
// output: 4×1 vertical fold: alternating D4_ID / D4_TB tiles overlap by one
//  row (gap -1), so each boundary row is shared.

// how each tile's content is produced, data-equivalent on this task
.type Choice =
    // per-tile D4 table
    Lookup {}
    // reflection tiling: each tile reflects its neighbor across the shared
    // boundary row, seeded at the anchor tile
  | Unfold {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl tile_axis(a: Axis) tile_axis(AXIS_V).
    .decl tile_gap(g: number) tile_gap(-1).

    // --- $Lookup ---
    .decl tile(p: Position, d: D4)
    GRID_4x1(tile,
        D4_ID,
        D4_TB,
        D4_ID,
        D4_TB)

    // --- $Unfold ---
    .decl tile_count(n: number) tile_count(4).
    .decl anchor(d: Dir) anchor(DIR_T).
}

.init params = Params

// The tile arrangement.
.init arr = AxisFrame<Unit>
arr.extent($U(), A, N) :- params.tile_axis(A), params.tile_count(N).

// --- $Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                           // input cell
    params.tile(P_tile, D), apply(D, P_in, P_intile),        // d4 image at tile
    params.tile_axis(A), params.tile_gap(G),
    concat_slab(P_tile, P_intile, A, G, P_grid).             // recompose with passthrough

// --- $Unfold ---
// The input reflected across the shared boundary row, once per tile step
// away from the anchor-end tile.
.init reflect = CycleWalk<Unit, Position>
reflect.succ($U(), P, P_img) :-
    in(P, _), params.tile_axis(A), flip_of(A, F), apply(F, P, P_img).
reflect.step($U(), K) :- arr.cell($U(), _, T), params.anchor(D), dist(T, D, K).

out(P_grid, Col, $Unfold()) :-
    arr.cell($U(), A, T), params.anchor(D), dist(T, D, K),   // K tile steps from the anchor end
    reflect.walk($U(), P, K, P_intile), in(P, Col),          // reflected K times
    params.tile_gap(G),
    concat_slab(T, P_intile, A, G, P_grid).                  // recompose with passthrough

.comp Determine {
    .decl tile_size(e: Example, k: number)
    tile_size(E, K) :- ex_in(E, P, _), params.tile_axis(A), axis_dim(P, A, K).

    .decl tile_gap(g: number)
    tile_gap(G) :-
        params.tile_axis(A), params.tile_count(N),   // arrangement
        ex_out(E, P_out, _), tile_size(E, K),        // output frame, and the tile extent
        divide_gap(P_out, A, N, K, G).

    // A 1-D arrangement folds within its own axis, so a tile's transform is
    // one that leaves every cell's across coordinate alone.
    .decl across_moved(d: D4)
    across_moved(D) :-
        d4_elem(D), ex_in(_, P, _), params.tile_axis(A),
        apply(D, P, P_img),                                          // the cell's image
        split(P, A, _, P_across), split(P_img, A, _, P_across2),     // across coordinates
        P_across != P_across2.

    .decl axial(d: D4)
    axial(D) :- d4_elem(D), !across_moved(D).

    .decl placed(e: Example, p_tile: Position, d: D4, p_grid: Position, col: Color)
    placed(E, P_tile, D, P_grid, Col) :-
        ex_in(E, P, Col), ex_out(E, _, _),              // cell of a train pair's input
        axial(D), apply(D, P, P_intile),                // its image under an axial transform
        arr.cell($U(), A, P_tile), tile_gap(G),         // tile position and gap
        concat_slab(P_tile, P_intile, A, G, P_grid).    // recompose with passthrough

    // A transform that lands some cell of its tile off the output's color.
    .decl mismatch(p_tile: Position, d: D4)
    mismatch(P_tile, D) :- placed(E, P_tile, D, P_grid, Col), !ex_out(E, P_grid, Col).

    .decl tile(p: Position, d: D4)
    tile(P_tile, D) :- arr.cell($U(), _, P_tile), axial(D), !mismatch(P_tile, D).
}
