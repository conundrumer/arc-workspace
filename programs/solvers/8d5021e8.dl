// 8d5021e8
// concept: tile-arrangement lookup d4 unfold
// 3×2 tile arrangement of input copies. The anchor tile — centered on the
// anchor edge — is the input; each other tile is the input flipped along
// every axis on which it sits away from the anchor.
//
// Cases (data-equivalent on this task):
//   $Lookup() — per-tile D4 table
//   $Mirror() — per-axis: tiles at the anchor's index pass through, the
//               rest flip
//   $Unfold() — reflection tiling: each tile reflects its neighbor across
//               the shared boundary, seeded at the anchor tile

#include "../lib.dl"

.type Choice = Lookup {} | Mirror {} | Unfold {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- Mirror / Unfold ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 3). arr_dim(AXIS_H, 2).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(AXIS_V, V), arr_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    .decl anchor(d: Dir)
    anchor(DIR_R).

    // --- Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_3x2(tile_d4,
        D4_HT, D4_TB,
        D4_LR, D4_ID,
        D4_HT, D4_TB)
}

.init c = Consts

.decl out(p: Position, col: Color, c: Choice)

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                       // input cell
    c.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).              // recompose

// --- Mirror / Unfold ---
.decl anchor_tile(p: Position)
anchor_tile(T) :-
    c.arr_pos(T), c.anchor(D), dist(T, D, 0),        // on the anchor edge
    axis_of(D, A), perp(A, A2), axis_of(D2, A2),
    dist_pair(T, D2, K, K).                          // centered across

// --- Mirror ---
// Per-axis within-tile image: tiles at the anchor's index pass through,
// the rest flip.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P) :-
    in(P, _), c.arr_pos(T), anchor_tile(Anc),
    axis_of(D, A), same_dist(D, T, Anc).
mirror(A, T, P, P_img) :-
    in(P, _), c.arr_pos(T), anchor_tile(Anc),
    axis_of(D, A), dist(T, D, K), dist(Anc, D, K2), K != K2,
    flip_of(A, F), apply(F, P, P_img).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- Unfold ---
// Tile contents: the input seeds the anchor tile; each neighbor reflects
// across the shared boundary.
.decl unfold_val(p_tile: Position, p_intile: Position, col: Color)
unfold_val(T, P, Col) :- in(P, Col), anchor_tile(T).
unfold_val(T2, P_img, Col) :-
    unfold_val(T, P, Col),                                             // known tile
    axis_of(D, A), step_delta(D, S), compose(T, S, T2), c.arr_pos(T2), // neighbor toward d
    flip_of(A, F), apply(F, P, P_img).                                 // reflect across the shared edge

out(P_grid, Col, $Unfold()) :-
    unfold_val(T, P_intile, Col),
    concat_2d(T, P_intile, 0, P_grid).
