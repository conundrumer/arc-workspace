// 8d5021e8
// @keywords: tile-arrangement lookup d4
// output: 3×2 tile arrangement of input copies. The anchor tile — centered on
//  the anchor edge — is the input; each other tile is the input flipped along
//  every axis on which it sits away from the anchor.

// data-equivalent on this task
.type Choice =
    // per-tile D4 table
    Lookup {}
    // per-axis: tiles at the anchor's index pass through, the rest flip
  | Mirror {}
    // reflection tiling: each tile reflects its neighbor across the shared
    // boundary, seeded at the anchor tile, so a tile flips on each axis it
    // sits an odd count of tiles from the anchor on
  | Unfold {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Mirror, $Unfold ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 3). arr_dim(AXIS_H, 2).
    .decl arr_pos(p: Position)
    arr_pos(P) :- arr_dim(AXIS_V, V), arr_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    .decl anchor(d: Dir)
    anchor(DIR_R).

    // --- $Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_3x2(tile_d4,
        D4_HT, D4_TB,
        D4_LR, D4_ID,
        D4_HT, D4_TB)
}

.init params = Params

// --- $Lookup ---
out(P_grid, Col, $Lookup()) :-
    in(P_in, Col),                                            // input cell
    params.tile_d4(P_tile, D), apply(D, P_in, P_intile),      // d4 image at tile
    concat_2d(P_tile, P_intile, 0, P_grid).                   // recompose

// --- $Mirror, $Unfold ---
.decl anchor_tile(p: Position)
anchor_tile(T) :-
    params.arr_pos(T), params.anchor(D), dist(T, D, 0),  // on the anchor edge
    perp_dir(D, D2), dist_pair(T, D2, K, K).             // centered across

// --- $Mirror ---
// Per-axis within-tile image: tiles at the anchor's index pass through,
// the rest flip.
.decl mirror(a: Axis, p_tile: Position, p: Position, p_img: Position)
mirror(A, T, P, P_img) :-
    in(P, _), params.arr_pos(T), anchor_tile(Anc), axis_of(D, A),   // input cell, tile, axis
    ( same_dist(D, T, Anc), P_img = P                               // at the anchor's index
    ; dist(T, D, K), dist(Anc, D, K2), K != K2,                     // away from it
      flip_of(A, F), apply(F, P, P_img)                             // flipped
    ).

out(P_grid, Col, $Mirror()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    mirror(A1, T, P_in, P1), mirror(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose

// --- $Unfold ---
// Each boundary crossed from the anchor tile reflects the content once, so
// a tile an even count of tiles from the anchor along a passes the input
// through on a: some tile lies midway between the two.
.decl even_off(p_tile: Position, a: Axis)
even_off(T, A) :-
    params.arr_pos(T), anchor_tile(Anc), params.arr_pos(M), axis_elem(A),
    split(T, A, T_a, _), split(Anc, A, Anc_a, _), split(M, A, M_a, _),  // the indices on a
    relative(Anc_a, M_a, V), relative(M_a, T_a, V).                     // M midway

// Per-axis within-tile image: an even count of tiles off the anchor passes
// through, an odd count flips.
.decl unfold(a: Axis, p_tile: Position, p: Position, p_img: Position)
unfold(A, T, P, P_img) :-
    in(P, _), params.arr_pos(T), axis_elem(A),
    ( even_off(T, A), P_img = P                                 // even: passes through
    ; !even_off(T, A), flip_of(A, F), apply(F, P, P_img)        // odd: flips
    ).

out(P_grid, Col, $Unfold()) :-
    in(P_in, Col),                                          // input cell
    perp(A1, A2),
    unfold(A1, T, P_in, P1), unfold(A2, T, P1, P_intile),   // image through both axes
    concat_2d(T, P_intile, 0, P_grid).                      // recompose
