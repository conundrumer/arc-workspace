// 3ac3eb23
// @keywords: markers parity walk lookup stamp
// output: Each marker casts a period-2 trail away from its edge: the marker's
//  own cell at every second step, its two side neighbors at the steps between;
//  all other cells bg.
//  Coincide here: every marker sits on the top edge, the banner and template
//  fills are the parity trail (the template at the grids' full height), and
//  every grid is wider than one column.

// marker edge — the trail extends away from it
.type Seat =
    // params.dir names it
    Dir {}
    // the edge each marker sits on
  | Edge {}

// how each marker's trail is cast
.type Choice =
    // alternation: centers every params.step_cells-th cell from the marker,
    // flanks diagonal from each center
    Parity {s: Seat}
    // two zigzag walks; the side direction flips each step
  | Walk {s: Seat}
    // a stored periodic banner: params.slot the period's slots, params.banner
    // the lit radius at each
  | Banner {s: Seat}
    // params.stamp, the whole trail as one stored shape of offsets, seated on
    // each marker in the pose that aims it away from params.dir
  | Stamp {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(0).

    // --- $Dir, $Stamp ---
    .decl dir(d: Dir) dir(DIR_T).   // the marker edge

    // --- $Parity, $Walk ---
    // The cells one step of the trail crosses: a center and the cell after it.
    .decl step_cells(k: number) step_cells(2).

    // --- $Banner ---
    .decl slot(k: number)
    slot(0). slot(1).
    .decl banner(k: number, r: number) banner(0, 0). banner(1, 1).   // lit radius per slot

    // --- $Stamp ---
    // The trail, in the frame where it runs toward `aim` from its marker.
    RIGID(trail,
        .decl aim(d: Dir) aim(DIR_B).
        .decl template(delta: Offset)   // trail cells, as offsets from the marker
        GRID_STAMP_6x3(template,
            _, @1, _,
            1,  _, 1,
            _,  1, _,
            1,  _, 1,
            _,  1, _,
            1,  _, 1)
    )

    // The template's offsets for a trail that runs toward D: the one rotation
    // that takes the aim there, which keeps the template's hand.
    .decl stamp(d: Dir, delta: Offset)
    stamp(D, Off) :- c4_elem(G), trail_aim(G, D), trail_template(G, Off).
}

.init params = Params

// --- shared ---

.decl marker(p: Position, col: Color)
marker(P, Col) :- in(P, Col), !params.bg(Col).

// Trail cells, per case.
.decl lit(p: Position, col: Color, ch: Choice)

// --- Seat cases ---

.decl seat_choice(s: Seat)
seat_choice($Dir()). seat_choice($Edge()).

// Trail seeds: each marker with the direction its trail runs — away from the
// edge its seat names.
.decl seed(s: Seat, col: Color, d: Dir, p: Position)
seed($Dir(), Col, D, P)  :- marker(P, Col), params.dir(E), opposite(E, D).
seed($Edge(), Col, D, P) :- marker(P, Col), dir_elem(E), dist(P, E, 0), opposite(E, D).

// The trail: the cells from each marker away from its edge.
.init trail = Ray<Seat>
trail.dir(S, D) :- seed(S, _, D, _).
trail.cell(S, P) :- seat_choice(S), in(P, _).
trail.mark(S, P) :- seed(S, _, _, P).

// The trail cell K steps out from the marker.
.decl trail_cell(s: Seat, col: Color, d: Dir, src: Position, p: Position, k: number)
trail_cell(S, Col, D, Src, P, K) :- trail.ray(S, P, D, K, Src), seed(S, Col, D, Src).

// --- $Parity ---

// Centers: the marker and every params.step_cells-th cell along the trail.
.decl center(s: Seat, col: Color, d: Dir, p: Position)
center(S, Col, D, P) :-
    trail_cell(S, Col, D, _, P, K), params.step_cells(N), stride(K, N, 0, _, 0).

lit(P, Col, $Parity(S)) :- center(S, Col, _, P).

// Flanks: the diagonal neighbors of each center, ahead of it.
lit(Q, Col, $Parity(S)) :-
    center(S, Col, D, P),
    dir_of(Diag, _, D),           // the two corners ahead
    neighbor(P, Diag, Q), in(Q, _).

// --- $Walk ---

// Two zigzag walks from the marker, one per side: each step goes one cell on
// and one to the side, and the side flips each step, so a walk stands on the
// trail at the end of each step and to its side between. A walk with no
// room on its side stops at the marker.
lit(P, Col, $Walk(S)) :- seed(S, Col, _, P).
lit(Q, Col, $Walk(S)) :-
    trail_cell(S, Col, D, Src, P, K), perp_dir(D, Ds),
    neighbor(Src, Ds, Q0), in(Q0, _),                     // room on the walk's side
    params.step_cells(N), stride(K, N, 0, _, J),
    ( J = 0, Q = P                                        // on the trail
    ; J != 0, neighbor(P, Ds, Q), in(Q, _)                // to the side
    ).

// --- $Banner ---

.init slots = IndexCycle<Unit>
slots.idx($U(), K) :- params.slot(K).

// The slot cycle, advanced once per step along the trail.
.init slot_walk = CycleWalk<Unit, number>
slot_walk.succ($U(), K, K2) :- slots.succ($U(), K, K2).
slot_walk.step($U(), I) :- trail.ray(_, _, _, I, _).

// Light each slot's radius, both sides of the line: the trail cell K steps
// out takes the slot K steps around the cycle.
lit(Q, Col, $Banner(S)) :-
    trail_cell(S, Col, D, _, P, I), slot_walk.walk($U(), 0, I, K),   // slot cell
    params.banner(K, R),                                              // its lit radius
    perp_dir(D, Ds), jump(P, Ds, R, Q), in(Q, _).                     // out to that radius, each side

// --- $Stamp ---

lit(Q, Col, $Stamp()) :-
    seed($Dir(), Col, D, P), params.stamp(D, Off),   // a marker, a template offset posed to its heading
    compose(P, Off, Q), in(Q, _).                    // seated on the marker, on-grid

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Parity(S)) :- seat_choice(S).
impl_choice($Walk(S))   :- seat_choice(S).
impl_choice($Banner(S)) :- seat_choice(S).
impl_choice($Stamp()).

out(P, Col, Ch) :- lit(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, _), !lit(P, _, Ch), params.bg(Col).

.comp Determine {
    // Markers of the train inputs; the ex_out atom holds the test input out.
    .decl mark(e: Example, p: Position, col: Color)
    mark(E, P, Col) :- ex_in(E, P, Col), !params.bg(Col), ex_out(E, _, _).

    // Each cell the pair paints in a marker's color, as an offset from it.
    .decl offset(e: Example, p: Position, delta: Offset)
    offset(E, P, Delta) :-
        mark(E, P, Col), ex_out(E, Q, Col), relative(P, Q, Delta).

    // An edge some marker sits off.
    .decl off_edge(d: Dir)
    off_edge(D) :- mark(_, P, _), dir_elem(D), !dist(P, D, 0).

    .decl dir(d: Dir)
    dir(D) :- dir_elem(D), !off_edge(D).

    .decl radius(e: Example, p: Position, i: number, r: number)
    radius(E, P, I, R) :-
        offset(E, P, Delta),
        params.dir(D), dist(Delta, D, I),             // steps away from the marker edge
        perp_dir(D, Ds), dist(Delta, Ds, R), R >= 0.  // steps to a side

    // Two steps of one trail whose lit radii differ — never one slot.
    .decl differ(i: number, i2: number)
    differ(I, I2) :- radius(E, P, I, R), radius(E, P, I2, _), !radius(E, P, I2, R).

    // Candidate periods: the step counts the trails reach.
    .decl cand(w: number)
    cand(W) :- radius(_, _, W, _), W != 0.

    .decl mismatch(w: number)
    mismatch(W) :- cand(W), differ(I, I2), stride(I, W, 0, _, K), stride(I2, W, 0, _, K).

    // The shortest period no trail breaks.
    .init unbroken = Extremes<Unit>
    unbroken.cand($U(), W) :- cand(W), !mismatch(W).

    .decl period(n: number)
    period(N) :- unbroken.low($U(), N).

    .decl step_cells(k: number)
    step_cells(N) :- period(N).

    .decl slot(k: number)
    slot(K) :- radius(_, _, K, _), period(N), K < N.

    .decl banner(k: number, r: number)
    banner(K, R) :- radius(_, _, I, R), period(N), stride(I, N, 0, _, K).

    .decl trail_aim(d: Dir)
    trail_aim(D) :- dir(E), opposite(E, D).

    .decl trail_template(delta: Offset)
    trail_template(Delta) :- offset(_, _, Delta).
}
