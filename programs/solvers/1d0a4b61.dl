// 1d0a4b61
// draft
// keywords: wallpaper repair
// input: a wallpaper pattern damaged by holes of one color. The survivors
//  identify the translation lattice: per axis, the shortest witnessed shift
//  no surviving pair contradicts.
// output: each cell takes the color of its lattice orbit.

.decl out(p: Position, col: Color)

.comp Params {
    .decl hole(col: Color) hole(0).
}

.init params = Params

// The pattern the damage spared.
.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- intact(P, Col).

// One lattice step — the identification the orbit closes over.
.decl step(p: Position, q: Position)
step(P, Q) :-
    si.min_period($U(), A, K), axis_of(D, A),  // the period, either direction
    in(P, _), jump(P, D, K, Q), in(Q, _).      // within the frame

out(P, Col) :- intact(P, Col).
out(Q, Col) :- out(P, Col), step(P, Q).
