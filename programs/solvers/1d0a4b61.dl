// 1d0a4b61
// @draft
// @keywords: wallpaper repair color-class
// input: a wallpaper pattern damaged by holes of one color. The survivors
//  identify the translation lattice: per axis, the shortest witnessed shift
//  no surviving pair contradicts.
// output: each cell takes the color of its lattice orbit.

.decl out(p: Position, col: Color)

.comp Params {
    .decl hole(col: Color) hole(0).
}

.init params = Params

// The pattern the damage spared.
.decl intact(p: Position, col: Color)
intact(P, Col) :- in(P, Col), !params.hole(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- intact(P, Col).

// A cell's phase toward edge D: its distance to that edge modulo the
// period on the edge's axis, or the distance itself on an axis with no
// period.
.decl phase(p: Position, d: Dir, k: number)
phase(P, D, Ph) :-
    in(P, _), dir_elem(D), axis_of(D, A), dist(P, D, T),
    ( si.min_period($U(), A, K), stride(T, K, 0, _, Ph)
    ; !si.min_period($U(), A, _), Ph = T
    ).

// Each cell takes the color of an intact cell of its lattice orbit: one in
// phase with it on both axes.
out(Q, Col) :-
    intact(P, Col), in(Q, _),
    axis_of(D, A), perp(A, A2), axis_of(D2, A2),
    phase(P, D, Ph), phase(Q, D, Ph), phase(P, D2, Ph2), phase(Q, D2, Ph2).
