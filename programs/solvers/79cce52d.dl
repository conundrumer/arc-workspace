// 79cce52d
// @keywords: lines markers walk count border
// input: A one-cell border sits on the two edges of params.corner; the rest
//  is the payload. Each border band holds one marker cell.
// output: Per axis, the payload's lines rotate as a cycle so the line
//  beside the corner lands on the marker's line.

// which band cell is the marker
.type Choice =
    // the cell of the designated params.marker_col
    Marked {}
    // the band cell whose color appears params.marker_count times in its band,
    // the color itself unnamed
  | Singleton {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl corner(d: DiagDir) corner(DIAG_TL).   // the border bands meet here

    // --- $Marked ---
    .decl marker_col(c: Color) marker_col(2).

    // --- $Singleton ---
    .decl marker_count(k: number) marker_count(1).
}

.init params = Params

// Payload cells — off both border bands.
.decl kept(p: Position, col: Color)
kept(P, Col) :-
    in(P, Col), params.corner(Diag),
    diag_dirs(Diag, _, D1, D2), !dist(P, D1, 0), !dist(P, D2, 0).

// Line index along axis a: distance from the edge opposite the corner —
// unchanged by the border drop, so input cells and output lines share it.
.decl line_idx(a: Axis, p: Position, k: number) inline
line_idx(A, P, K) :-
    params.corner(Diag), dir_of(Diag, A, D), opposite(D, FE), dist(P, FE, K).

// Each payload line, by index, is a node of the cycle.
.decl line_set(a: Axis, k: number)
line_set(A, K) :- kept(P, _), line_idx(A, P, K).

.init line_cycle = IndexCycle<Axis>
line_cycle.idx(A, K) :- line_set(A, K).

// Marker band for axis a — the band running along a, its corner cell excluded.
.decl band_cell(a: Axis, p: Position, col: Color)
band_cell(A, P, Col) :-
    in(P, Col), params.corner(Diag),
    perp(A, A2), dir_of(Diag, A2, D2), dist(P, D2, 0),   // on the band running along a
    dir_of(Diag, A, D), !dist(P, D, 0).                  // the corner cell excluded

// The marker cell in each band, under each model.
.decl marker(a: Axis, p: Position, ch: Choice)

// --- $Marked ---
marker(A, P, $Marked()) :- band_cell(A, P, Col), params.marker_col(Col).

// --- $Singleton ---
.type BandColor = [a: Axis, col: Color]

.init band_count = Tally<BandColor, Position>
band_count.item([A, Col], P) :- band_cell(A, P, Col).

marker(A, P, $Singleton()) :-
    band_cell(A, P, Col), params.marker_count(N), band_count.tally([A, Col], N).

// --- shared ---
// The payload's lines per axis.
.init line_count = Tally<Axis, number>
line_count.item(A, K) :- line_set(A, K).

// The steps around each axis's cycle of lines, up to one full turn.
.init turns = CycleWalk<Axis, number>
turns.succ(A, K, K2) :- line_cycle.succ(A, K, K2).
turns.step(A, N) :- line_count.tally(A, N).

// The steps that carry the line beside the corner to the marker's line.
.decl shift(a: Axis, n: number, ch: Choice)
shift(A, N, Ch) :-
    in(P_cn, _), params.corner(Diag), corner_dist(P_cn, Diag, 0),      // the corner cell
    dir_of(Diag, A, D), opposite(D, O),                                // inward along a
    neighbor(P_cn, O, P_a), line_idx(A, P_a, K_ca),                    // the line beside it
    marker(A, P_mk, Ch), line_idx(A, P_mk, K_mk),                      // the marker's line
    turns.walk(A, K_ca, N, K_mk).

// The output frame — the payload's per-axis extents.
.init frame = AxisFrame<Unit>
frame.extent($U(), A, N) :- line_count.tally(A, N).

// Along-axis output seat of each payload cell: its line, rotated.
.decl out_along(a: Axis, p: Position, q: Position, ch: Choice)
out_along(A, P, Q, Ch) :-
    kept(P, _), line_idx(A, P, K_in),
    shift(A, N, Ch), turns.walk(A, K_in, N, K_out),     // its line, rotated by the shift
    frame.cell($U(), A, Q), line_idx(A, Q, K_out).   // the output line at that index

out(P_out, Col, Ch) :-
    kept(P, Col),
    perp(A1, A2),
    out_along(A1, P, Q1, Ch), out_along(A2, P, Q2, Ch),
    compose(Q1, Q2, P_out).
