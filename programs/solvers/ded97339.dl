// ded97339
// concept: markers span
// Marks connect: cells between two marks on their row or column
// fill with the mark color. Two claims of what that color is, tagged on
// out's Choice:
//
//   $Ink  — marks are c.ink cells; spans fill c.ink.
//   $Self — marks are any non-bg cells; each color spans separately and
//           fills with itself.

#include "../lib.dl"

.type Choice = Ink {} | Self {}

.comp Consts {
    .decl bg(c: Color)   bg(0).

    // --- $Ink ---
    .decl ink(c: Color)  ink(8).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color, ch: Choice)

// --- $Ink ---

.init ink_spans = Between<Unit>
ink_spans.axis(A)       :- axis_elem(A).
ink_spans.cell(P)       :- in(P, _).
ink_spans.mark($U(), Q) :- in(Q, Ink), c.ink(Ink).

out(P, Ink, $Ink()) :- ink_spans.between($U(), P), c.ink(Ink).
out(P, Col, $Ink()) :- in(P, Col), !ink_spans.between($U(), P).

// --- $Self ---

.init self_spans = Between<Color>
self_spans.axis(A)      :- axis_elem(A).
self_spans.cell(P)      :- in(P, _).
self_spans.mark(Col, Q) :- in(Q, Col), !c.bg(Col).

.decl self_spanned(p: Position)
self_spanned(P) :- self_spans.between(_, P).

out(P, Col, $Self()) :- self_spans.between(Col, P).
out(P, Col, $Self()) :- in(P, Col), !self_spanned(P).

.output out(IO=stdout)
