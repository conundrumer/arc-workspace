// ded97339
// @keywords: markers span
// output: Cells between two marks on their row or column fill with the mark
//  color.

// which cells are marks
.type Choice =
    // the params.ink cells
    Ink {}
    // every non-bg cell; each color spans separately
  | Self {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // --- $Ink ---
    .decl ink(c: Color) ink(8).

    // --- $Self ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// --- $Ink ---

.init ink_spans = Between<Unit>
ink_spans.axis($U(), A) :- axis_elem(A).
ink_spans.cell($U(), P) :- in(P, _).
ink_spans.mark($U(), Q) :- in(Q, Ink), params.ink(Ink).

out(P, Ink, $Ink()) :- ink_spans.between($U(), P), params.ink(Ink).
out(P, Col, $Ink()) :- in(P, Col), !ink_spans.between($U(), P).

// --- $Self ---

.init self_spans = Between<Color>
self_spans.axis(Col, A) :- self_spans.mark(Col, _), axis_elem(A).
self_spans.cell(Col, P) :- self_spans.mark(Col, _), in(P, _).
self_spans.mark(Col, Q) :- in(Q, Col), !params.bg(Col).

out(P, Col, $Self()) :- self_spans.between(Col, P).
out(P, Col, $Self()) :- in(P, Col), !self_spans.between(_, P).
