// 470c91de
// keywords: objects markers move
// input: Each non-background color fills a rectangle with one corner cell
//  taken away.
// output: The rectangle slides one step toward that corner and is painted
//  whole; every other cell becomes params.bg.

// what names the corner
.type Choice =
    // a params.marker cell sits at that corner of the color's box
    Mark {}
    // the color's own cells are its box minus exactly that corner
  | Gap {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).

    // --- Mark ---
    .decl marker(col: Color) marker(8).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Mark()). impl_choice($Gap()).

// --- shared: each color's box ---

.init bx = Bbox<Color>
bx.cell(Col, P) :- in(P, Col), !params.bg(Col).

// The box cell at a corner, whether or not the color occupies it.
.decl corner_cell(col: Color, d: DiagDir, p: Position)
corner_cell(Col, D, P) :- bx.box(Col, B), in(P, _), box_corner(P, B, D).

// The corner each color slides toward.
.decl slide(col: Color, d: DiagDir, ch: Choice)

// --- Mark ---
slide(Col, D, $Mark()) :-
    corner_cell(Col, D, P),                           // a corner of the color's box
    in(P, M), params.marker(M), !params.marker(Col).  // holding a marker

// --- Gap ---
// The bitten corner. Two bites name no single direction, so `value` drops them.
.init gap = Unanimous<Color, DiagDir>
gap.item(Col, D) :- corner_cell(Col, D, P), !bx.cell(Col, P).

// A hole away from the corners: the color's cells are no bitten rectangle.
.decl ragged(col: Color)
ragged(Col) :-
    bx.box(Col, B), in(P, _), inside(P, B),          // a cell of the color's box
    !bx.cell(Col, P), !corner_cell(Col, _, P).       // empty, and off the corners

slide(Col, D, $Gap()) :- gap.value(Col, D), !ragged(Col).

// --- shared: the move ---

.decl painted(p: Position, col: Color, ch: Choice)
painted(Q, Col, Ch) :-
    slide(Col, D, Ch), bx.box(Col, B),          // the sliding box
    in(P, _), inside(P, B),                     // a cell of it
    neighbor(P, D, Q), in(Q, _).                // one step toward D

out(P, Col, Ch) :- painted(P, Col, Ch).
out(P, Bg, Ch) :- in(P, _), impl_choice(Ch), !painted(P, _, Ch), params.bg(Bg).
