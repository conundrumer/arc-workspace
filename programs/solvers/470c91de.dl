// 470c91de
// concept: objects markers move
// Each non-background color fills a rectangle with one corner cell taken away.
// The rectangle slides one step toward that corner and is painted whole; every
// other cell becomes c.bg. Two models of what names the corner:
//
//   $Mark — a c.marker cell sits at that corner of the color's box.
//   $Gap  — the color's own cells are its box minus exactly that corner.

#include "../lib.dl"

.type Choice = Mark {} | Gap {}

.comp Consts {
    // --- shared ---
    .decl bg(col: Color) bg(7).

    // --- Mark ---
    .decl marker(col: Color) marker(8).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Mark()). impl_choice($Gap()).

// --- shared: each color's box ---

.init bx = BoxFrame<Color>
bx.cell(Col, P) :- in(P, Col), !c.bg(Col).
bx.grid(Col, P) :- bx.cell(Col, _), in(P, _).

// The box cell at a corner, whether or not the color occupies it.
.decl corner_cell(col: Color, d: DiagDir, p: Position)
corner_cell(Col, D, P) :- bx.inner(Col, P, P_box), corner_dist(P_box, D, 0).

// The corner each color slides toward.
.decl slide(col: Color, d: DiagDir, ch: Choice)

// --- Mark ---
slide(Col, D, $Mark()) :-
    corner_cell(Col, D, P),                 // a corner of the color's box
    in(P, M), c.marker(M), !c.marker(Col).  // holding a marker

// --- Gap ---
// The bitten corner. Two bites name no single direction, so `value` drops them.
.init gap = Unanimous<Color, DiagDir>
gap.item(Col, D) :- corner_cell(Col, D, P), !bx.cell(Col, P).

// A hole away from the corners: the color's cells are no bitten rectangle.
.decl ragged(col: Color)
ragged(Col) :- bx.inside(Col, P), !bx.cell(Col, P), !corner_cell(Col, _, P).

slide(Col, D, $Gap()) :- gap.value(Col, D), !ragged(Col).

// --- shared: the move ---

.decl painted(p: Position, col: Color, ch: Choice)
painted(Q, Col, Ch) :-
    slide(Col, D, Ch), bx.inside(Col, P),       // a cell of the sliding box
    neighbor(P, D, Q), in(Q, _).                // one step toward D

.decl out(p: Position, col: Color, c: Choice)
out(P, Col, Ch) :- painted(P, Col, Ch).
out(P, Bg, Ch) :- in(P, _), impl_choice(Ch), !painted(P, _, Ch), c.bg(Bg).
