// 712bf12e
// concept: markers walk
// Each marker-colored cell draws a line of its color away from the marker
// edge: it steps through bg; where ink blocks the step, it slides one cell
// toward c.sense and retries; ink at the slide cell or the grid edge stops
// it. Two models of the marker edge:
//
//   $Dir  — c.dir names it.
//   $Edge — the edge each marker sits on.
//
// The models coincide here (every marker is on the bottom edge, which
// c.dir names); they diverge when markers sit elsewhere.

#include "../lib.dl"

.type Choice = Dir {} | Edge {}

.comp Consts {
    // --- shared ---
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(2).           // marker and line color
    .decl sense(s: Sense) sense(SENSE_CW).  // slide: quarter turn from the walk direction

    // --- $Dir ---
    .decl dir(d: Dir) dir(DIR_B).       // marker edge; lines walk away from it
}

.init c = Consts

// The line drawn from a marker cell, walking away from edge d.
.decl line(p: Position, d: Dir, ch: Choice)

// --- $Dir ---
line(P, D, $Dir()) :- in(P, Col), c.mark(Col), c.dir(D).

// --- $Edge ---
line(P, D, $Edge()) :- in(P, Col), c.mark(Col), dir_elem(D), dist(P, D, 0).

line(P2, D, Ch) :-
    line(P, D, Ch), opposite(D, W), step_delta(W, S),       // the step away from d
    ( compose(P, S, P2)                                     // step into the cell ahead
    ; compose(P, S, P_a), in(P_a, Blk), !c.bg(Blk),         // ink ahead — blocked
      c.sense(Sn), turn(Sn, W, SD),
      step_delta(SD, S2), compose(P, S2, P2)                // slide sideways instead
    ),
    in(P2, Bg), c.bg(Bg).                                   // the cell entered is bg

.decl impl_choice(ch: Choice)
impl_choice($Dir()). impl_choice($Edge()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- line(P, _, Ch), c.mark(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !line(P, _, Ch).
