// 712bf12e
// @keywords: markers walk
// output: Each marker-colored cell draws a line of its color away from the
//  marker edge: it steps through bg; where ink blocks the step, it slides one
//  cell toward params.sense and retries; ink at the slide cell or the grid edge
//  stops it.

// two models of the marker edge
.type Choice =
    // params.dir names it
    Dir {}
    // the edge each marker sits on
  | Edge {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl mark(c: Color) mark(2).           // marker and line color
    .decl sense(s: Sense) sense(SENSE_CW).  // slide: quarter turn from the walk direction

    // --- $Dir ---
    .decl dir(d: Dir) dir(DIR_B).       // marker edge; lines walk away from it
}

.init params = Params

// The line drawn from a marker cell, walking away from edge d.
.decl line(p: Position, d: Dir, ch: Choice)

// The models coincide here (every marker is on the bottom edge, which
// params.dir names); they diverge when markers sit elsewhere.

// --- $Dir ---
line(P, D, $Dir()) :- in(P, Col), params.mark(Col), params.dir(D).

// --- $Edge ---
line(P, D, $Edge()) :- in(P, Col), params.mark(Col), dir_elem(D), dist(P, D, 0).

line(P2, D, Ch) :-
    line(P, D, Ch), opposite(D, W),                          // the walk away from d
    neighbor(P, W, P_a),                                     // the cell ahead
    ( P2 = P_a                                               // step into it
    ; in(P_a, Blk), !params.bg(Blk),                         // ink ahead — blocked
      params.sense(Sn), turn(Sn, W, SD), neighbor(P, SD, P2) // slide sideways instead
    ),
    in(P2, Bg), params.bg(Bg).                               // the cell entered is bg

.decl impl_choice(ch: Choice)
impl_choice($Dir()). impl_choice($Edge()).

out(P, Col, Ch) :- line(P, _, Ch), params.mark(Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !line(P, _, Ch).
