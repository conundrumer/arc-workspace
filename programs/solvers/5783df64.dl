// 5783df64
// @keywords: decompose select
// input: a params.divisor × params.divisor tile arrangement, each tile
//  holding one ink cell
// output: The output is that arrangement of the ink colors.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl divisor(n: number) divisor(3).
}

.init params = Params

out(P_tile, Col) :-
    in(P_grid, Col), !params.bg(Col),
    params.divisor(N), divide_2d(P_grid, N, 0, P_tile, _).
