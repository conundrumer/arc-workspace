// 9caf5b84
// concept: count rank select
// Colors rank by cell count; the frequent colors keep their cells, and
// every other cell becomes c.mark. Two claims on where the cut sits,
// data-equivalent on this task — every pair has exactly five colors:
//
//   $Keep — the c.keep_n most frequent colors survive.
//   $Drop — the c.drop_n least frequent colors repaint.

#include "../lib.dl"

.type Choice = Keep {} | Drop {}

.comp Consts {
    // --- shared ---
    .decl mark(c: Color) mark(7).

    // --- Keep ---
    .decl keep_n(n: number) keep_n(2).

    // --- Drop ---
    .decl drop_n(n: number) drop_n(3).
}

.init c = Consts

.init color_count = Tally<Color, Position>
color_count.item(Col, P) :- in(P, Col).

.init by_count = Order<Unit, Color>
by_count.elem($U(), Col) :- color_count.tally(Col, _).
by_count.before($U(), Col, Col2) :-
    color_count.tally(Col, N), color_count.tally(Col2, N2),  // two colors' counts
    N < N2.                                                  // the rarer one comes first

.decl survives(col: Color, ch: Choice)

// --- Keep ---
survives(Col, $Keep()) :- by_count.rank_desc($U(), Col, R), c.keep_n(K), R < K.

// --- Drop ---
survives(Col, $Drop()) :- by_count.rank($U(), Col, R), c.drop_n(K), R >= K.

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Keep()). impl_choice($Drop()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- in(P, Col), survives(Col, Ch).
out(P, Col, Ch) :- in(P, C0), impl_choice(Ch), !survives(C0, Ch), c.mark(Col).
