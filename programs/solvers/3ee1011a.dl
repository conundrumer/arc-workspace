// 3ee1011a
// draft
// keywords: objects count rank
// input: bars lying on the background, one color each
// output: The output is a square of concentric frames; its side is the
//  longest bar's cell count, and each frame takes one bar's color.
//  Every pair's counts step down by 2 from the longest, so the cases agree
//  there; a bar whose count breaks the step splits them.

// which bar each frame's color comes from
.type Choice =
    // the bars in descending order of count, one per frame inward
    Rank {}
    // each bar fills the centered square of its own count, and a smaller square
    // covers a larger one
  | Stamp {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// Each bar: its color, and how many cells it covers.
.init bar = Tally<Color, Position>
bar.item(Col, P) :- in(P, Col), !params.bg(Col).

// The canvas: a square as wide as the longest bar.
.init longest = Extremes<Unit>
longest.cand($U(), N) :- bar.tally(_, N).

.init canvas = Frame2D<Unit>
canvas.extent($U(), A, N) :- axis_elem(A), longest.high($U(), N).

// The concentric frames, counted inward from the canvas border.
.init rim = Rim<Unit>
rim.cell($U(), P) :- canvas.cell($U(), P).

// --- Rank ---

.init size_rank = Ordinal<Unit>
size_rank.idx_set($U(), N) :- bar.tally(_, N).

out(P, Col, $Rank()) :-
    rim.depth($U(), P, K),                                // the frame the cell sits on
    bar.tally(Col, N), size_rank.rank_desc($U(), N, K).   // the Kth longest bar

// --- Stamp ---

// The centered square left after peeling K frames.
.init core = Bbox<number>
core.cell(K, P) :- rim.depth($U(), _, K), rim.depth($U(), P, K2), K <= K2.

// The squares a cell sits in, by side.
.init innermost = Extremes<Position>
innermost.cand(P, N) :-
    core.cell(K, P), core.box(K, B),                   // a square P sits in
    axis_elem(A), perp(A, A2),
    box_extent(B, P, A, N), box_extent(B, P, A2, N),   // of side N
    bar.tally(_, N).                                   // a bar that long fills it

// A cell takes the smallest square covering it.
out(P, Col, $Stamp()) :- innermost.low(P, N), bar.tally(Col, N).
