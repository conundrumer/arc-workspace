// 2b9ef948
// keywords: markers move cast
// input: A box of frame color encloses a cell of the grid's one free color,
//  and a trail of path color lies elsewhere, with a free-colored cell beside
//  one end and a frame-colored cell beside the other.
// output: The box travels by the offset from the free end to the frame end.
//  In the output the free color floods the grid, and the moved box, with
//  the diagonals it casts, shows in frame color.

// what casts the diagonals
.type Choice =
    // the core, so the diagonals cross at the middle of the box
    Core {}
    // each corner of the box, each ray running outward
  | Corner {}

// The cases coincide on a box one cell thick around its core, as in every
// pair here, and diverge on a thicker one, where only Core paints inside it.

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).

    .decl frame(col: Color) frame(4).

    .decl path(col: Color) path(5).
}

.init params = Params

// The one color the task leaves free — the box's core and the trail's free end.
.decl free_color(col: Color)
free_color(Col) :- in(_, Col), !params.bg(Col), !params.frame(Col), !params.path(Col).

// Has a neighbour on the trail: the trail's own cells and what touches them.
.decl beside_trail(p: Position)
beside_trail(P) :- in(P, _), dir_elem(D), neighbor(P, D, Q), in(Q, Col), params.path(Col).

// The trail's ends are the colored cells beside it, and the box travels from
// the free-colored end to the frame-colored one.
.decl travel(v: Offset)
travel(V) :-
    in(P, Col), free_color(Col), beside_trail(P),        // the free end
    in(Q, Col2), params.frame(Col2), beside_trail(Q),    // the frame end
    relative(P, Q, V).

// The box and its core: the frame and free cells away from the trail.
.decl box(p: Position)
box(P) :- in(P, Col), params.frame(Col), !beside_trail(P).

.decl core(p: Position)
core(P) :- in(P, Col), free_color(Col), !beside_trail(P).

.decl moved_box(p: Position)
moved_box(P2) :- box(P), travel(V), compose(P, V, P2).

.decl impl_choice(ch: Choice)
impl_choice($Core()). impl_choice($Corner()).

.decl ink(p: Position, ch: Choice)
ink(P, Ch) :- moved_box(P), impl_choice(Ch).

// --- Core ---

// The moved core casts a diagonal each way.
.init diag = Ray<Unit>
diag.dir($U(), D) :- diag_dir_elem(D).
diag.cell($U(), P) :- in(P, _).
diag.mark($U(), P2) :- core(P), travel(V), compose(P, V, P2).

ink(P, $Core()) :- diag.ray($U(), P, _, K, _), K != 0.  // the core itself stays free

// --- Corner ---

.init bx = Bbox<Unit>
bx.cell($U(), P) :- moved_box(P).

// Each corner of the moved box casts one ray, toward the corner's own side.
.init corner_ray = Ray<DiagDir>
corner_ray.dir(Dg, Dg) :- diag_dir_elem(Dg).
corner_ray.cell(Dg, P) :- diag_dir_elem(Dg), in(P, _).
corner_ray.mark(Dg, P) :- moved_box(P), bx.box($U(), B), box_corner(P, B, Dg).

ink(P, $Corner()) :- corner_ray.ray(_, P, _, _, _).

out(P, Col, Ch) :-
    in(P, _), impl_choice(Ch),
    ( ink(P, Ch), params.frame(Col)    // the moved box and its diagonals
    ; !ink(P, Ch), free_color(Col)     // the free color floods the rest
    ).
