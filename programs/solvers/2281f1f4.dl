// 2281f1f4
// @keywords: lines markers stamp cross
// output: Markers (params.marker) sit on the two header edges of corner
//  params.header; each marks its line. Cells where marked lines cross paint
//  params.fill.

// what a marked line carries off the crossings
.type Choice =
    // nothing: crossings paint, the rest passes through
    Cross {}
    // lines marked from the selector edge re-render as the pattern header (the
    // params.pattern_axis edge of the corner): marker cells params.fill, the
    // rest params.bg
  | Stamp {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl marker(c: Color) marker(5).
    .decl fill(c: Color) fill(2).
    .decl header(d: DiagDir) header(DIAG_TR).

    // --- Stamp ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// Cell in the line of a marker on header edge d.
.decl marked(p: Position, d: Dir)
marked(P, D) :-
    in(P, _), params.header(Diag), dir_of(Diag, A, D),
    params.marker(M), in(Q, M), dist(Q, D, 0),   // marker on edge d
    same_line(A, P, Q).

// --- Cross ---

.decl cross(p: Position)
cross(P) :- params.header(Diag), diag_dirs(Diag, _, D1, D2), marked(P, D1), marked(P, D2).

out(P, F, $Cross())   :- cross(P), params.fill(F).
out(P, Col, $Cross()) :- in(P, Col), !cross(P).

// --- Stamp ---

// Cells of selected lines, keyed by the pattern edge whose partner
// selected them. The marker pattern is symmetric across the header
// corner, so both its edges carry it.
.decl selected(p: Position, dp: Dir)
selected(P, Dp) :-
    params.header(Diag),
    diag_dirs(Diag, _, Dp, Ds),                 // pattern edge, selector edge
    marked(P, Ds), !dist(P, Ds, 0).             // marked from the selector, off it

out(P, F, $Stamp())   :- selected(P, Dp), marked(P, Dp), params.fill(F).
out(P, Bg, $Stamp())  :- selected(P, Dp), !marked(P, Dp), params.bg(Bg).
out(P, Col, $Stamp()) :- in(P, Col), !selected(P, _).
