// 0520fde7
// concept: decompose lookup
// Layout: 1×2 horizontally-side-by-side 3×3 subgrids with 1-col separator.
//
// out's choice column = [d, b]:
//
//   d (decompose):
//     $Tile() — pre-tabulated in the parameters via tile_pos
//     $Div()  — derived in the program via the divide primitive
//
//   b (body):
//     $Lookup() — combine table keyed on (outer pos, color); set-equality match
//     $And()    — AND via non-existence: no BG input contribution

#include "../lib.dl"

.type DecChoice = Tile {} | Div {}
.type Body      = Lookup {} | And {}
.type Choice    = [d: DecChoice, b: Body]

.type CombineMember = [p: Position, col: Color]
.type CombineKey    = [p: Position, dc: DecChoice]

.comp Params {
    .init helpers = ParamsHelpers

    .decl frame_dim(k: number) frame_dim(3).
    .decl frame(p: Position)
    frame(P) :- frame_dim(K), helpers.frame_pos([K, K], P).

    // --- Tile decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 1). arr_dim(AXIS_H, 2).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah), frame_dim(K), gap(G),
        helpers.tile_pos([Av, Ah], [K, K], [0, G], P_grid, P_tile, P_intile).

    // --- Div decompose data ---
    .decl divisor(n: number)
    divisor(2).

    .decl divide_axis(a: Axis)
    divide_axis(AXIS_H).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Lookup body data ---
    .decl combine_member(id: Ident, p_outer: Position, c: Color)
    .decl combine_out(id: Ident, c_out: Color)

    combine_member(0, [0,0,0,1], 0). combine_member(0, [0,0,1,0], 0). combine_out(0, 0).
    combine_member(1, [0,0,0,1], 1). combine_member(1, [0,0,1,0], 0). combine_out(1, 0).
    combine_member(2, [0,0,0,1], 0). combine_member(2, [0,0,1,0], 1). combine_out(2, 0).
    combine_member(3, [0,0,0,1], 1). combine_member(3, [0,0,1,0], 1). combine_out(3, 2).

    // --- And body data ---
    .decl bg(c: Color) bg(0).
    .decl out_fill(c: Color) out_fill(2).
}

.init params = Params

.init combine_match = KeyedSetCompare<CombineKey, Ident, CombineMember>
combine_match.pattern_member(Id, [P_outer, C]) :- params.combine_member(Id, P_outer, C).
combine_match.observed_member([P_grid_out, Dc], [P_tile, C]) :-
    decompose(P_grid_in, P_tile, P_grid_out, Dc), in(P_grid_in, C).

// --- Decompose cases ---

.decl dec_choice(dc: DecChoice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, dc: DecChoice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- params.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                                      // input position
    params.divide_axis(A), params.divisor(N), params.divide_gap(G),     // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- And body: unfilled relation parameterized by decompose choice ---

.decl unfilled(o: Position, dc: DecChoice)
unfilled(P_grid_out, Dc) :-
    in(P_grid_in, Col), params.bg(Col),             // bg input cell
    decompose(P_grid_in, _, P_grid_out, Dc).        // decomposes to output cell

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)
out(P_grid_out, Col_out, [Dc, $Lookup()]) :-
    params.combine_out(Id, Col_out),                             // entry's output color
    combine_match.equals([P_grid_out, Dc], Id).                  // cell's tiles == entry's members

out(P_grid_out, Col, [Dc, $And()]) :-
    dec_choice(Dc), params.frame(P_grid_out),        // choice × cell
    ( !unfilled(P_grid_out, Dc), params.out_fill(Col)    // AND=1: no bg contribution
    ; unfilled(P_grid_out, Dc), params.bg(Col)           // AND=0: some bg contribution
    ).
