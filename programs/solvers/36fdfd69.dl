// 36fdfd69
// draft
// concept: objects markers span
// The grid is a noise field in two colors, one of them params.bg, with cells of
// params.mark scattered on it. Marks with at most one cell between them cluster,
// and each cluster's bounding box takes params.fill. The other noise color changes
// from pair to pair, so no parameter names it and the fill's target is stated by
// exclusion. No box the pairs exhibit holds a params.bg cell, and the cases contest
// what the fill spares:
//
//   $Solid   — every non-mark cell of the box takes params.fill.
//   $Recolor — params.bg is empty ground, not noise: it stays where a box covers it.

#include "../lib.dl"

.type Choice = Solid {} | Recolor {}

.comp Params {
    // --- shared ---
    .decl mark(col: Color) mark(2).
    .decl fill(col: Color) fill(4).

    // --- Recolor ---
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- shared ---

// Marks cluster across a gap of at most one cell: a cluster step is two
// steps in any directions.
.init cluster = Components8<Unit>
cluster.node($U(), P) :- in(P, Col), params.mark(Col).
cluster.step(S) :-
    dir8_elem(D1), step_delta(D1, S1), dir8_elem(D2), step_delta(D2, S2),
    compose(S1, S2, S).

.init box = Bbox<Ident>
box.cell(Id, P) :- cluster.label($U(), P, Id).
box.grid(Id, P) :- box.cell(Id, _), in(P, _).

.decl impl_choice(ch: Choice)
impl_choice($Solid()). impl_choice($Recolor()).

// A box cell that is not a mark.
.decl unmarked(p: Position, col: Color)
unmarked(P, Col) :- box.inside(_, P), in(P, Col), !params.mark(Col).

// The box cells the fill takes.
.decl repaint(p: Position, c: Choice)

// --- Solid ---
repaint(P, $Solid()) :- unmarked(P, _).

// --- Recolor ---
repaint(P, $Recolor()) :- unmarked(P, Col), !params.bg(Col).

.decl out(p: Position, col: Color, c: Choice)
out(P, Col, C) :- repaint(P, C), params.fill(Col).
out(P, Col, C) :- in(P, Col), impl_choice(C), !repaint(P, C).
