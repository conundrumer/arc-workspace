// 36fdfd69
// draft
// keywords: objects markers span
// input: The grid is a noise field in two colors, one of them params.bg,
//  with cells of params.mark scattered on it. Marks with at most one cell
//  between them cluster.
// output: In each cluster's bounding box, the cells that are not marks
//  take params.fill.

// what the fill spares within a box. No box the pairs exhibit covers a
// params.bg cell, so on the pairs the cases agree.
.type Choice =
    // every non-mark cell of the box takes params.fill
    Solid {}
    // params.bg is empty ground, not noise: it stays where a box covers it
  | Recolor {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl mark(col: Color) mark(2).
    .decl fill(col: Color) fill(4).

    // --- Recolor ---
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- shared ---

// Marks cluster across a gap of at most one cell: a cluster step is two
// steps in any directions.
.init cluster = Components8<Unit>
cluster.node($U(), P) :- in(P, Col), params.mark(Col).
cluster.step(S) :-
    dir8_elem(D1), step_offset(D1, S1), dir8_elem(D2), step_offset(D2, S2),
    compose(S1, S2, S).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- cluster.label($U(), P, Id).

.decl impl_choice(ch: Choice)
impl_choice($Solid()). impl_choice($Recolor()).

.decl unmarked(p: Position, col: Color)
unmarked(P, Col) :-
    in(P, Col), !params.mark(Col),   // a cell that is not a mark
    bbox.box(_, B), inside(P, B).    // inside a cluster's box

// The box cells the fill takes.
.decl repaint(p: Position, c: Choice)

// --- Solid ---
repaint(P, $Solid()) :- unmarked(P, _).

// --- Recolor ---
repaint(P, $Recolor()) :- unmarked(P, Col), !params.bg(Col).

out(P, Col, C) :- repaint(P, C), params.fill(Col).
out(P, Col, C) :- in(P, Col), impl_choice(C), !repaint(P, C).
