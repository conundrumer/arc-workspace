// 7c8af763
// draft
// concept: objects decompose markers count
// Lines of one color cut the grid into bg regions. Marks in other colors sit
// on the lines. Each region fills with the color of the majority of the
// marks that touch it. Two parses of the regions:
//
//   $Region — the connected components of bg.
//   $Tile   — the tiles of the lattice of full lines, the lines with no bg
//             cell.

#include "../lib.dl"

.type Choice = Region {} | Tile {}

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl line(c: Color) line(5).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Region()). impl_choice($Tile()).

// The marks beside a cell: its cardinal neighbors in a mark color.
.decl touch(p: Position, q: Position, col: Color)
touch(P, Q, Col) :-
    in(P, _), dir_elem(D), neighbor(P, D, Q),
    in(Q, Col), !params.bg(Col), !params.line(Col).

.decl out(p: Position, col: Color, c: Choice)
out(P, Col, Ch) :- in(P, Col), !params.bg(Col), impl_choice(Ch).

// --- Region ---

.init regions = Components<Unit>
regions.node($U(), P) :- in(P, Col), params.bg(Col).

.init region_vote = Mode<Ident, Color, Position>
region_vote.item(Id, Col, Q) :- regions.label($U(), P, Id), touch(P, Q, Col).

out(P, Col, $Region()) :- regions.label($U(), P, Id), region_vote.mode(Id, Col).

// --- Tile ---

.decl bg_line(l: Position)
bg_line(L) :- in(P, Col), params.bg(Col), axis_elem(A), split(P, A, L, _).

.init tiles = DividerFrame<Unit>
tiles.cell($U(), P) :- in(P, Col), params.bg(Col).
tiles.divider($U(), A, L) :-
    in(P, _), axis_elem(A), split(P, A, L, _),  // a line of the grid
    !bg_line(L).                                // with no bg cell: a full line

.init tile_vote = Mode<Position, Color, Position>
tile_vote.item(P_tile, Col, Q) :- tiles.tile_of($U(), P, P_tile), touch(P, Q, Col).

out(P, Col, $Tile()) :- tiles.tile_of($U(), P, P_tile), tile_vote.mode(P_tile, Col).
