// 868de0fa
// draft
// concept: objects border enclose parity
// Square outlines drawn in one ink color. Each outline's hole fills by the
// parity of the outline's side: an odd side gives a hole with a center cell,
// which takes odd_fill; an even side gives a hole with none, which takes
// even_fill.
//
// $Rect — an outline is a rectangle drawn by four ink runs, and its hole is
//   what the rectangle holds strictly within its edges.
// $Enclose — an outline is any ink wall, and its hole is the region that wall
//   cuts off from the grid edge.

#include "../lib.dl"

.type Choice = Rect {} | Enclose {}

.comp Params {
    // --- shared ---
    .decl ink(col: Color) ink(1).

    .decl odd_fill(col: Color) odd_fill(7).
    .decl even_fill(col: Color) even_fill(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Rect()). impl_choice($Enclose()).

// The fill each hole cell takes.
.decl fill(p: Position, col: Color, ch: Choice)

// --- Rect ---

.init drect = DrawnRect<Unit>
drect.node($U(), P) :- in(P, Col), params.ink(Col).

.init bcells = BoxCells<Position>
bcells.box(B, B) :- drect.rect($U(), B).
bcells.cell(B, P) :- bcells.box(B, _), in(P, _).

// The hole viewed from its own box.
.init rect_hole = BoxFrame<Position>
rect_hole.cell(B, P) :- bcells.hole(B, P).

.decl rect_odd(b: Position)
rect_odd(B) :- rect_hole.inner(B, _, P_inner), centered(P_inner).

fill(P, Col, $Rect()) :-
    bcells.hole(B, P),
    ( rect_odd(B), params.odd_fill(Col)
    ; !rect_odd(B), params.even_fill(Col)
    ).

// --- Enclose ---

// The ink walls the rest of the grid off; a region it closes is a hole.
.init closed = Closed<Unit>
closed.cell($U(), P) :- in(P, Col), !params.ink(Col).

// The region viewed from its own box.
.init region_box = BoxFrame<Ident>
region_box.cell(Id, P) :- closed.region($U(), P, Id).

.decl region_odd(id: Ident)
region_odd(Id) :- region_box.inner(Id, _, P_inner), centered(P_inner).

fill(P, Col, $Enclose()) :-
    closed.region($U(), P, Id),
    ( region_odd(Id), params.odd_fill(Col)
    ; !region_odd(Id), params.even_fill(Col)
    ).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- fill(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !fill(P, _, Ch).
