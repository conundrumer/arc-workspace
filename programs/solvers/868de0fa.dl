// 868de0fa
// draft
// keywords: objects border enclose parity
// input: square outlines drawn in one ink color
// output: each outline's hole fills by the parity of the outline's side: an
//  odd side gives a hole with a center cell, which takes odd_fill; an even
//  side gives a hole with none, which takes even_fill

// how an outline and its hole are found
.type Choice =
    // an outline is a rectangle drawn by four ink runs, and its hole is what
    // the rectangle holds strictly within its edges
    Rect {}
    // an outline is any ink wall, and its hole is the region that wall cuts off
    // from the grid edge
  | Enclose {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl ink(col: Color) ink(1).

    .decl odd_fill(col: Color) odd_fill(7).
    .decl even_fill(col: Color) even_fill(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Rect()). impl_choice($Enclose()).

// The fill each hole cell takes.
.decl fill(p: Position, col: Color, ch: Choice)

// --- Rect ---

.init drect = Outlines<Unit>
drect.node($U(), P) :- in(P, Col), params.ink(Col).

.decl hole(b: Box, p: Position)
hole(B, P) :- drect.box($U(), B), in(P, _), interior(P, B).

// The hole's own box.
.init rect_hole = Bbox<Box>
rect_hole.cell(B, P) :- hole(B, P).

.decl rect_odd(b: Box)
rect_odd(B) :-
    hole(B, P), rect_hole.box(B, B_hole),
    crop(P, B_hole, P_inner), centered(P_inner).  // the hole has a center cell

fill(P, Col, $Rect()) :-
    hole(B, P),
    ( rect_odd(B), params.odd_fill(Col)
    ; !rect_odd(B), params.even_fill(Col)
    ).

// --- Enclose ---

// The ink walls the rest of the grid off; a region it closes is a hole.
.init closed = Closed<Unit>
closed.cell($U(), P) :- in(P, Col), !params.ink(Col).

// The region's own box.
.init region_box = Bbox<Ident>
region_box.cell(Id, P) :- closed.region($U(), P, Id).

.decl region_odd(id: Ident)
region_odd(Id) :-
    closed.region($U(), P, Id), region_box.box(Id, B),
    crop(P, B, P_inner), centered(P_inner).  // the region has a center cell

fill(P, Col, $Enclose()) :-
    closed.region($U(), P, Id),
    ( region_odd(Id), params.odd_fill(Col)
    ; !region_odd(Id), params.even_fill(Col)
    ).

out(P, Col, Ch) :- fill(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !fill(P, _, Ch).
