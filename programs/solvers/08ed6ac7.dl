// 08ed6ac7
// keywords: lines objects rank
// output: Ink bars recolor by size order: the r-th bar takes the r-th color of
//  a stored sequence; all other cells pass through.

// what a bar is
.type Seg =
    // a connected component of ink
    Object {}
    // a grid line along params.axis holding ink
  | Line {}

// which end of the size order is rank 0
.type Anchor =
    // the biggest bar
    Tall {}
    // the smallest bar
  | Short {}

// what a bar is, crossed with which end of the size order is rank 0
.type Choice = [s: Seg, a: Anchor]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl ink(col: Color) ink(5).

    // --- $Line ---
    .decl axis(a: Axis) axis(AXIS_V).

    // --- $Tall ---
    .decl tall_color(r: number, col: Color)
    tall_color(0, 1). tall_color(1, 2). tall_color(2, 3). tall_color(3, 4).

    // --- $Short ---
    .decl short_color(r: number, col: Color)
    short_color(0, 4). short_color(1, 3). short_color(2, 2). short_color(3, 1).
}

.init params = Params

.decl ink(p: Position)
ink(P) :- in(P, Col), params.ink(Col).

// --- $Object segmentation ---

.init objs = Components<Unit>
objs.node($U(), P) :- ink(P).

.init obj_size = Tally<Ident, Position>
obj_size.item(Id, P) :- objs.label($U(), P, Id).

// --- $Line segmentation ---

.decl line_cell(b: Position, p: Position)
line_cell(B, P) :- ink(P), params.axis(A), split(P, A, _, B).

.init line_size = Tally<Position, Position>
line_size.item(B, P) :- line_cell(B, P).

// --- shared: rank the sizes per anchor ---

.decl bar_size(s: Seg, n: number)
bar_size($Object(), N) :- obj_size.tally(_, N).
bar_size($Line(), N)   :- line_size.tally(_, N).

.init seq = Ordinal<Seg>
seq.idx_set(S, N) :- bar_size(S, N).

.decl size_color(s: Seg, a: Anchor, n: number, col: Color)
size_color(S, $Tall(),  N, Col) :- seq.rank_desc(S, N, R), params.tall_color(R, Col).
size_color(S, $Short(), N, Col) :- seq.rank(S, N, R), params.short_color(R, Col).

// --- output ---

.decl seg_choice(s: Seg)
seg_choice($Object()). seg_choice($Line()).

.decl anchor_choice(a: Anchor)
anchor_choice($Tall()). anchor_choice($Short()).

out(P, Col, [$Object(), A]) :-
    objs.label($U(), P, Id), obj_size.tally(Id, N), size_color($Object(), A, N, Col).
out(P, Col, [$Line(), A]) :-
    line_cell(B, P), line_size.tally(B, N), size_color($Line(), A, N, Col).
out(P, Col, [S, A]) :- in(P, Col), !params.ink(Col), seg_choice(S), anchor_choice(A).

.comp Determine {
    .decl line_cell(e: Example, b: Position, p: Position)
    line_cell(E, B, P) :- ex_in(E, P, Col), params.ink(Col), params.axis(A), split(P, A, _, B).

    .type EB = [e: Example, b: Position]

    .init line_size = Tally<EB, Position>
    line_size.item([E, B], P) :- line_cell(E, B, P).

    .decl bar_color(e: Example, n: number, col: Color)
    bar_color(E, N, Col) :- line_size.tally([E, B], N), line_cell(E, B, P), ex_out(E, P, Col).

    .init seq = Ordinal<Example>
    seq.idx_set(E, N) :- line_size.tally([E, _], N).

    .decl tall_color(r: number, col: Color)
    tall_color(R, Col) :- seq.rank_desc(E, N, R), bar_color(E, N, Col).

    .decl short_color(r: number, col: Color)
    short_color(R, Col) :- seq.rank(E, N, R), bar_color(E, N, Col).
}
