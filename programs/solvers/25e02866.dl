// 25e02866
// draft
// concept: objects overlay border
// Solid rectangles of one color sit on the background, all of the same size,
// each carrying a few cells painted in other colors. The output is one such
// rectangle with every painted cell stacked onto it. The cases differ on which
// painted cells a rectangle contributes: $Layer every one of them, $Inside only
// those off its border ring. Every painted cell here sits off the border, so
// the two agree on every pair.
// No task data — the family is fully structural.

#include "../lib.dl"

.type Choice = Layer {} | Inside {}

.comp Params {}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Layer()). impl_choice($Inside()).

// The background covers the grid, and the ink is what is drawn on it. The
// rectangles cover the ink in the same way.
.init bg_mode = Mode<Unit, Color, Position>
bg_mode.item($U(), Col, P) :- in(P, Col).

.decl ink(p: Position)
ink(P) :- in(P, Col), !bg_mode.mode($U(), Col).

.init panel_mode = Mode<Unit, Color, Position>
panel_mode.item($U(), Col, P) :- ink(P), in(P, Col).

// A panel is a connected island of ink: one rectangle with its painted cells.
// Seen from its own box, every panel lands on the same frame — the output frame.
.init comps = Components<Unit>
comps.node($U(), P) :- ink(P).

.init panel = Bbox<Ident>
panel.cell(Id, P) :- comps.label($U(), P, Id).

// A panel's cell, placed in the shared frame.
.decl panel_cell(p: Position, p_frame: Position)
panel_cell(P, P_frame) :- panel.cell(Id, P), panel.box(Id, B), crop(P, B, P_frame).

// A painted cell of a panel, placed in the shared frame.
.decl paint(p_frame: Position, col: Color)
paint(P_frame, Col) :-
    panel_cell(P, P_frame), in(P, Col),  // the panel's cell and its color
    !panel_mode.mode($U(), Col).         // departs from the panel color

// What each panel contributes to the shared frame.
.decl overlay(p_frame: Position, col: Color, ch: Choice)

.decl out(p: Position, col: Color, ch: Choice)
out(P_frame, Col, Ch) :- overlay(P_frame, Col, Ch).
out(P_frame, Col, Ch) :-
    impl_choice(Ch), panel_cell(_, P_frame),                // a cell of the frame
    !overlay(P_frame, _, Ch), panel_mode.mode($U(), Col).   // unpainted: bare panel

// --- Layer ---

overlay(P_frame, Col, $Layer()) :- paint(P_frame, Col).

// --- Inside ---

overlay(P_frame, Col, $Inside()) :- paint(P_frame, Col), interior(P_frame, ZERO).
