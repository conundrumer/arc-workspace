// 2b01abd0
// @draft
// @keywords: lines d4 mapping
// input: A line of params.line cuts the grid, and a two-color figure sits
//  on one side.
// output: The figure stays in place with its two colors exchanged, and its
//  reflection across the line appears on the other side in the original
//  colors.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl line(col: Color) line(1).
}

.init params = Params

.decl line_cell(p: Position)
line_cell(P) :- in(P, Col), params.line(Col).

// The axis the line runs along.
.decl line_axis(a: Axis)
line_axis(A) :-
    line_cell(P), line_cell(Q), P != Q,         // two distinct cells of the line
    axis_elem(A), same_line(A, P, Q).           // both on one line of A

// The line's place across axis a: a line cell's component on the
// perpendicular axis, the same for every line cell.
.decl line_at(a: Axis, l: Position)
line_at(A, L) :- line_cell(F), line_axis(A), perp(A, A2), split(F, A2, L, _).

// The reflection acts across the line: the flip of the perpendicular axis,
// about the line's place. The flip fixes the along-axis.
.decl mirror(p: Position, q: Position)
mirror(P, Q) :-
    in(P, _), line_axis(A), perp(A, A2), flip_of(A2, F4), line_at(A, L),
    relative(L, P, V), apply(F4, V, V2), compose(L, V2, Q),
    in(Q, _).                                   // the image lands on the grid

.decl figure(p: Position, col: Color)
figure(P, Col) :- in(P, Col), !params.bg(Col), !params.line(Col).

// The figure carries two colors, and each becomes the other.
.decl swap(col: Color, col2: Color)
swap(C, C2) :- figure(_, C), figure(_, C2), C != C2.

.decl ink(p: Position, col: Color)
ink(P, C2) :- figure(P, C), swap(C, C2).                // in place, colors exchanged
ink(Q, C) :- figure(P, C), mirror(P, Q).                // reflected, colors kept

out(P, C) :- ink(P, C).
out(P, C) :- in(P, C), !ink(P, _).                      // line and bg stand
