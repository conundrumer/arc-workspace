// e1baa8a4
// concept: decompose
// Unequal rectilinear color blocks in a product arrangement (row bands ×
// col bands). Output is one cell per block: consecutive identical grid
// lines collapse, per axis. No task data — the family is fully structural.

#include "../lib.dl"

.comp Consts {}

.init c = Consts

// Boundary toward d at distance k: some cell on the line at k differs
// from its neighbor one step toward d.
.decl boundary(d: Dir, k: number)
boundary(D, K) :-
    in(P, C1), dir_elem(D), dist(P, D, K),      // cell on line k from d
    neighbor(P, D, P2), in(P2, C2), C1 != C2.   // differs from the cell toward d

// Band index of a distance from edge d: the boundaries at or inside it.
.type EdgeDist = [d: Dir, k: number]
.init bands = Tally<EdgeDist, number>
bands.item([D, K], K2) :- bands.domain([D, K]), boundary(D, K2), K2 <= K.
bands.domain([D, K]) :- in(P, _), dir_elem(D), dist(P, D, K).

// Axis part of the output position: band indices from both edges of a.
.decl axis_band(a: Axis, p: Position, p_axis: Position)
axis_band(A, P, P_axis) :-
    in(P, _), axis_of(D, A), opposite(D, O),           // the axis's edge pair
    dist(P, D, K1), bands.tally([D, K1], I1),          // band index from each
    dist(P, O, K2), bands.tally([O, K2], I2),
    edge_delta(D, I1, P1), edge_delta(O, I2, P2),
    compose(P1, P2, P_axis).

.decl out(p: Position, col: Color)
out(P_out, Col) :-
    in(P, Col),                                          // block cell
    perp(A1, A2),
    axis_band(A1, P, Pa1), axis_band(A2, P, Pa2),        // both axis parts
    compose(Pa1, Pa2, P_out).                            // glue to 2D
