// e1baa8a4
// @keywords: decompose
// output: Unequal rectilinear color blocks in a product arrangement (row bands
//  × col bands). Output is one cell per block: consecutive identical grid lines
//  collapse, per axis. No task data — the family is fully structural.

.decl out(p: Position, col: Color)

.comp Params {}

.init params = Params

// Boundary toward d at distance k: some cell on the line at k differs
// from its neighbor one step toward d.
.decl boundary(d: Dir, k: number)
boundary(D, K) :-
    in(P, C1), dir_elem(D), dist(P, D, K),      // cell on line k from d
    neighbor(P, D, P2), in(P2, C2), C1 != C2.   // differs from the cell toward d

// A line of the grid along either axis, axis-only.
.decl line(l: Position)
line(L) :- in(P, _), axis_elem(A), split(P, A, L, _).

.decl line_dist(l: Position, d: Dir, k: number)
line_dist(L, D, K) :- line(L), dir_elem(D), dist(L, D, K).

// Band index of a distance from edge d: the boundaries at or inside it.
.type EdgeDist = [d: Dir, k: number]
.init bands = Tally<EdgeDist, number>
bands.item([D, K], K2) :- bands.domain([D, K]), boundary(D, K2), K2 <= K.
bands.domain([D, K]) :- line_dist(_, D, K).

// A line's place in the output: its band index from each of the four edges.
.init place = DirPack<Position>
place.edge(L, D, I) :- line_dist(L, D, K), bands.tally([D, K], I).

// A cell's place in the output: the places of its two lines composed.
out(P_out, Col) :-
    in(P, Col), axis_elem(A), split(P, A, L1, L2),   // the cell's two lines
    place.box(L1, B1), place.box(L2, B2), compose(B1, B2, P_out).
