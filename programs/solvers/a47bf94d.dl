// a47bf94d
// @draft
// @keywords: objects walk occlude match lookup
// @scene slots: 3×3 slots stand in two facing rows (top and bottom) or two
//  facing columns (left and right). Each slot holds a solid block of one
//  color, a diamond of one color, an X of one color, or nothing.
// @scene wires: paths of wire cells join each slot to one slot in the facing
//  row. A wire leaves the middle cell of the slot edge that faces the other
//  row. Every slot is on exactly one wire.
// @scene crossings: where two wires cross, both run straight through the
//  crossing cell. The wire that goes under shows a mark cell on each side of
//  the crossing cell.
// @scene occluders: occluder blocks hide stretches of wires. The hidden
//  stretch of a wire joins two of the visible wire ends that touch the block.
// @scene one-filled-end: each wire has at least one filled end, and no wire
//  has two solid ends.
// @rule trace: follow each wire from its slot to the slot at its other end.
//  The wire goes straight through crossings and turns at corners. Under an
//  occluder, a visible end joins the end straight across from it on the same
//  line. An end with no end straight across joins the one remaining end.
// @rule complete: after the rule, each wire has a diamond of its color at one
//  end and an X of that color at the other end. A solid block becomes the
//  diamond. An empty end takes the shape that the other end lacks.
// @rule keep: wires, marks, occluders, and the background are unchanged.

// which lone end under a block an end joins
.type Join =
    // @claim trace
    OneRemaining {}
    // @rule trace: an end with no end straight across joins whichever other
    //  such end of the block is nearest it through the block
    // @witness two-turns: borderline $Nearest
  | Nearest {}

// whether the grid changes when the wire ends spread over more than two lines
.type Grouping =
    // @claim keep
    Ungrouped {}
    // @rule keep: when the wire ends do not lie on exactly two rows or exactly
    //  two columns, the whole grid is unchanged
    // @witness three-rows: foreign concept
    //     @relaxed slots
  | PortGrouping {}

// which end of a wire gets the diamond
.type Roles =
    // @claim complete
    ByShape {}
    // @rule complete: on every wire with a filled end, the end whose slot lies
    //  on the stored side of its axis takes the diamond and the other end the
    //  X, in the filled end's color
    // @witness flipped-test: variant concept
  | SideRoles {}

// what a wire whose ends are a diamond and an empty slot does
.type Lone =
    // @claim complete
    FillX {}
    // @rule complete: a wire whose ends are a diamond and an empty slot stays
    //  unchanged
    // @witness lone-diamond-train0: variant concept
  | LoneDiamond {}

// where the X footprint comes from
.type XShape =
    // @claim complete
    StoredX {}
    // @rule complete: the X footprint is the slot cells that the diamond
    //  footprint leaves empty
    // @witness plus-shapes: variant concept
    //     @reassigned diamond
  | XComplement {}

// how a shape is drawn into a slot
.type Paint =
    // @claim complete
    Replace {}
    // @rule complete: the end across from a solid or a diamond takes the X,
    //  and the end across from an X takes the diamond, whatever the end holds
    //  unless it is solid. A shape is drawn onto the slot's background cells
    //  only, except that a solid block becomes the diamond.
    // @witness solid-diamond: foreign concept
  | Overlay {}

.type Choice = [
    join: Join, grouping: Grouping, roles: Roles, lone: Lone, x_shape: XShape, paint: Paint
]

// A visible wire end at a block, and the side the block lies on.
.type End = [p: Position, e: Dir]

// A wire's start: the join case and the port it leaves.
.type WireStart = [j: Join, p0: Position]

// A place along a wire: the cell and the heading.
.type Walker = [p: Position, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // @derive DominantColor: variant derived
    .decl background(c: Color) background(0).
    .decl wire_color(c: Color) wire_color(8).
    .decl mark_color(c: Color) mark_color(5).
    .decl occluder_color(c: Color) occluder_color(9).
    .decl slot_size(k: number) slot_size(3).

    // The cells of a slot, in the slot's own frame.
    .decl slot_cell(p: Position)
    slot_cell(P) :- slot_size(K), helpers.frame_pos([K, K], P).

    // The footprint a solid block becomes.
    .decl diamond(p: Position)
    GRID_MASK_3x3(diamond,
        _, 1, _,
        1, _, 1,
        _, 1, _)

    // --- $StoredX ---
    // The footprint the other end takes.
    .decl x(p: Position)
    GRID_MASK_3x3(x,
        1, _, 1,
        _, 1, _,
        1, _, 1)

    // --- $SideRoles ---
    // The side, one per axis, whose end takes the diamond.
    .decl diamond_side(d: Dir) diamond_side(DIR_T). diamond_side(DIR_L).
}

.init params = Params

.decl join_choice(j: Join)
join_choice($OneRemaining()). join_choice($Nearest()).

.decl grouping_choice(g: Grouping)
grouping_choice($Ungrouped()). grouping_choice($PortGrouping()).

.decl roles_choice(r: Roles)
roles_choice($ByShape()). roles_choice($SideRoles()).

.decl lone_choice(l: Lone)
lone_choice($FillX()). lone_choice($LoneDiamond()).

.decl x_shape_choice(x: XShape)
x_shape_choice($StoredX()). x_shape_choice($XComplement()).

.decl paint_choice(p: Paint)
paint_choice($Replace()). paint_choice($Overlay()).

.decl impl_choice(ch: Choice)
impl_choice([J, G, R, L, X, Pt]) :-
    join_choice(J), grouping_choice(G), roles_choice(R),
    lone_choice(L), x_shape_choice(X), paint_choice(Pt).

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    // A wire cell: wire color or mark color.
    .decl wire(k: Key, p: Position)
    wire(K, P) :- cell(K, P, Col), ( params.wire_color(Col) ; params.mark_color(Col) ).

    .decl occluder(k: Key, p: Position)
    occluder(K, P) :- cell(K, P, Col), params.occluder_color(Col).

    // The cell beside wire cell P toward D.
    .decl beside(k: Key, p: Position, d: Dir, q: Position)
    beside(K, P, D, Q) :- wire(K, P), dir_elem(D), neighbor(P, D, Q).

    // The wire continues from P toward D.
    .decl wire_link(k: Key, p: Position, d: Dir)
    wire_link(K, P, D) :- beside(K, P, D, Q), wire(K, Q).

    // A wire end at a slot: the slot lies toward D, and nothing but the wire
    // behind touches the end.
    .decl port(k: Key, p: Position, d: Dir)
    port(K, P, D) :-
        beside(K, P, D, Q), !wire(K, Q), !occluder(K, Q), !side_contact(K, P, D).

    // A wire or occluder cell beside P, across D's axis.
    .decl side_contact(k: Key, p: Position, d: Dir)
    side_contact(K, P, D) :-
        beside(K, P, D2, R), perp_dir(D, D2), ( wire(K, R) ; occluder(K, R) ).

    // The slot cell a wire attaches to, for a slot lying toward D: the middle
    // of the slot's edge that faces the wire.
    .decl attach(d: Dir, a: Position)
    attach(D, A) :-
        params.slot_cell(A), opposite(D, D_near), dist(A, D_near, 0),
        perp_dir(D, D1), dist_pair(A, D1, N, N).

    // The slot at port P: slot cell P_inner lies at P_grid.
    .decl slot(k: Key, p: Position, p_inner: Position, p_grid: Position)
    slot(K, P, P_inner, P_grid) :-
        port(K, P, D), attach(D, A), neighbor(P, D, Q),
        params.slot_cell(P_inner), relative(A, P_inner, V), compose(Q, V, P_grid).

    .decl ink(k: Key, p: Position, p_inner: Position, col: Color)
    ink(K, P, P_inner, Col) :-
        slot(K, P, P_inner, P_grid), cell(K, P_grid, Col), !params.background(Col).

    .decl filled(k: Key, p: Position, col: Color)
    filled(K, P, Col) :- ink(K, P, _, Col).

    // Some slot cell holds the background.
    .decl gap(k: Key, p: Position)
    gap(K, P) :- slot(K, P, P_inner, _), !ink(K, P, P_inner, _).

    .decl solid(k: Key, p: Position)
    solid(K, P) :- filled(K, P, _), !gap(K, P).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl empty(p: Position)
empty(P) :- parse.port($U(), P, _), !parse.filled($U(), P, _).

// The X footprint.
.decl x_cell(xs: XShape, p_inner: Position)

// The slot at P holds the diamond.
// @claim complete
.init as_diamond = KeyedSetCompare<Position, Unit, Position>
as_diamond.pattern_member($U(), P_inner) :- params.diamond(P_inner).
as_diamond.observed_member(P, P_inner) :- parse.ink($U(), P, P_inner, _).

// The slot at P holds the X.
// @claim complete
.init as_x = KeyedSetCompare<Position, XShape, Position>
as_x.pattern_member(Xs, P_inner) :- x_cell(Xs, P_inner).
as_x.observed_member(P, P_inner) :- parse.ink($U(), P, P_inner, _).

// @claim occluders
.init blocks = Components<Unit>
blocks.node($U(), P) :- parse.occluder($U(), P).

// A visible wire end at a block: P touches block cell Q toward E, and the
// wire leaves P on at most one side.
.decl occ_end(p: Position, e: Dir, q: Position)
occ_end(P, E, Q) :- parse.beside($U(), P, E, Q), parse.occluder($U(), Q), !branching(P).

.decl branching(p: Position)
branching(P) :- parse.wire_link($U(), P, D1), parse.wire_link($U(), P, D2), D1 != D2.

// @claim trace
.init under = Slide<Unit>
under.node($U(), P) :- parse.occluder($U(), P).
under.dir($U(), D) :- dir_elem(D).

// The end straight across the block from end P, on the same line.
.decl across(p: Position, e: Dir, p2: Position, e2: Dir)
across(P, E, P2, E2) :-
    occ_end(P, E, Q), under.rest($U(), Q, E, Q2), neighbor(Q2, E, P2),
    opposite(E, E2), occ_end(P2, E2, _).

// An end with no end straight across, in block Id.
.decl lone(p: Position, e: Dir, id: Ident)
lone(P, E, Id) :- occ_end(P, E, Q), blocks.label($U(), Q, Id), !across(P, E, _, _).

// The hidden stretch under a block joins end P to end P2.
.decl join(j: Join, p: Position, e: Dir, p2: Position, e2: Dir)
join(J, P, E, P2, E2) :- join_choice(J), across(P, E, P2, E2).

// The wire from port P0, under join case J, reaches cell P heading D.
// @claim trace
.init walk = GraphDistance<WireStart, Walker>
walk.seed([J, P0], [P0, D]) :- join_choice(J), parse.port($U(), P0, D0), opposite(D0, D).
walk.edge([J, P0], [P, D], [Q, D2]) :-
    join_choice(J), parse.port($U(), P0, _), parse.wire($U(), P), dir_elem(D),
    ( parse.wire_link($U(), P, D), D2 = D, neighbor(P, D2, Q)      // straight on
    ; !parse.wire_link($U(), P, D), perp_dir(D, D2),               // a corner
      parse.wire_link($U(), P, D2), neighbor(P, D2, Q)
    ; join(J, P, E, Q, E2), !opposite(D, E), opposite(E2, D2)      // under a block
    ).

// Port P0's wire ends at port P1.
.decl partner(j: Join, p0: Position, p1: Position)
partner(J, P0, P1) :- walk.distance([J, P0], [P1, D], _), parse.port($U(), P1, D), P0 != P1.

// The grid stays as it is.
.decl unchanged(g: Grouping)

// The wire at P stays as it is.
.decl held(l: Lone, j: Join, p: Position)

// The slot at P takes the diamond, or the X, in color Col.
.decl gets_diamond(ch: Choice, p: Position, col: Color)
.decl gets_x(ch: Choice, p: Position, col: Color)

// The footprint cells and color of the shape the slot at P takes.
.decl shape(ch: Choice, p: Position, p_inner: Position, col: Color)
shape(Ch, P, P_inner, Col) :- gets_diamond(Ch, P, Col), params.diamond(P_inner).
shape([J, G, R, L, Xs, Pt], P, P_inner, Col) :-
    gets_x([J, G, R, L, Xs, Pt], P, Col), x_cell(Xs, P_inner).

// The shape replaces the whole content of the slot at P.
.decl redrawn(pt: Paint, p: Position)

// Slot cell P_inner of the slot at P takes color Col.
.decl draw(ch: Choice, p: Position, p_inner: Position, col: Color)
draw([J, G, R, L, Xs, Pt], P, P_inner, Col) :-
    shape([J, G, R, L, Xs, Pt], P, _, _), !unchanged(G), redrawn(Pt, P),
    parse.slot($U(), P, P_inner, _),
    ( shape([J, G, R, L, Xs, Pt], P, P_inner, Col)
    ; !shape([J, G, R, L, Xs, Pt], P, P_inner, _), params.background(Col) ).
draw([J, G, R, L, Xs, Pt], P, P_inner, Col) :-
    shape([J, G, R, L, Xs, Pt], P, P_inner, Col), !unchanged(G), !redrawn(Pt, P),
    !parse.ink($U(), P, P_inner, _).

.decl painted(ch: Choice, p: Position)
painted(Ch, P_grid) :- draw(Ch, P, P_inner, _), parse.slot($U(), P, P_inner, P_grid).

out(P_grid, Col, Ch) :- impl_choice(Ch), in(P_grid, Col), !painted(Ch, P_grid).
out(P_grid, Col, Ch) :- draw(Ch, P, P_inner, Col), parse.slot($U(), P, P_inner, P_grid).

// --- $OneRemaining ---

join($OneRemaining(), P, E, P2, E2) :- lone(P, E, Id), lone(P2, E2, Id), P != P2.

// --- $Nearest ---

// The fewest steps through the block from a lone end's block cell.
// @claim trace
.init under_len = GraphDistance<End, Position>
under_len.seed([P, E], Q) :- lone(P, E, _), occ_end(P, E, Q).
under_len.edge([P, E], Q, Q2) :-
    lone(P, E, _), parse.occluder($U(), Q),
    dir_elem(D), neighbor(Q, D, Q2), parse.occluder($U(), Q2).

// @claim trace
.init nearest = ArgExtremes<End, End>
nearest.cand([P, E], [P2, E2], K) :-
    lone(P, E, Id), lone(P2, E2, Id), P != P2,
    occ_end(P2, E2, Q2), under_len.distance([P, E], Q2, K).

join($Nearest(), P, E, P2, E2) :- nearest.low([P, E], [P2, E2], _).

// --- $PortGrouping ---

// The wire ends lie on at least three lines across D's axis.
.decl spread(d: Dir)
spread(D) :-
    dir_elem(D), parse.port($U(), P1, _), parse.port($U(), P2, _), !same_dist(D, P1, P2),
    parse.port($U(), P3, _), !same_dist(D, P3, P1), !same_dist(D, P3, P2).

// The wire ends lie on exactly two lines across D's axis.
.decl grouped(d: Dir)
grouped(D) :-
    dir_elem(D), parse.port($U(), P1, _), parse.port($U(), P2, _), !same_dist(D, P1, P2),
    !spread(D).

unchanged($PortGrouping()) :- !grouped(_).

// --- $LoneDiamond ---

// A wire with a diamond at one end and an empty slot at the other.
held($LoneDiamond(), J, P) :-
    partner(J, P, P2),
    ( as_diamond.equals(P, $U()), empty(P2)
    ; empty(P), as_diamond.equals(P2, $U()) ).

// --- $StoredX ---

x_cell($StoredX(), P_inner) :- params.x(P_inner).

// --- $XComplement ---

x_cell($XComplement(), P_inner) :- params.slot_cell(P_inner), !params.diamond(P_inner).

// --- $Replace ---

redrawn($Replace(), P) :- parse.port($U(), P, _).

// --- $Overlay ---

redrawn($Overlay(), P) :- parse.solid($U(), P).

// --- $ByShape ---

// End P2 across the wire from filled end P, whose color is Col, takes its
// shape from P.
.decl facing(pt: Paint, j: Join, p: Position, p2: Position, col: Color)

gets_diamond([J, G, $ByShape(), L, Xs, Pt], P, Col) :-
    impl_choice([J, G, $ByShape(), L, Xs, Pt]),
    parse.solid($U(), P), parse.filled($U(), P, Col).
gets_diamond([J, G, $ByShape(), L, Xs, Pt], P2, Col) :-
    impl_choice([J, G, $ByShape(), L, Xs, Pt]), facing(Pt, J, P, P2, Col), as_x.equals(P, Xs).
gets_x([J, G, $ByShape(), L, Xs, Pt], P2, Col) :-
    impl_choice([J, G, $ByShape(), L, Xs, Pt]), facing(Pt, J, P, P2, Col),
    ( parse.solid($U(), P) ; as_diamond.equals(P, $U()), !held(L, J, P) ).

// --- $ByShape & $Replace ---

facing($Replace(), J, P, P2, Col) :-
    partner(J, P, P2), empty(P2), parse.filled($U(), P, Col).

// --- $ByShape & $Overlay ---

facing($Overlay(), J, P, P2, Col) :-
    partner(J, P, P2), !parse.solid($U(), P2), parse.filled($U(), P, Col).

// --- $SideRoles ---

// The wire from P, on the diamond side, to P2 changes, in its filled end's
// color Col.
.decl sided(l: Lone, j: Join, p: Position, p2: Position, col: Color)
sided(L, J, P, P2, Col) :-
    lone_choice(L), partner(J, P, P2), !held(L, J, P),
    parse.port($U(), P, D), params.diamond_side(D),
    ( parse.filled($U(), P, Col) ; parse.filled($U(), P2, Col) ).

gets_diamond([J, G, $SideRoles(), L, Xs, Pt], P, Col) :-
    impl_choice([J, G, $SideRoles(), L, Xs, Pt]), sided(L, J, P, _, Col).
gets_x([J, G, $SideRoles(), L, Xs, Pt], P2, Col) :-
    impl_choice([J, G, $SideRoles(), L, Xs, Pt]), sided(L, J, _, P2, Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // A slot cell that the output inks.
    .decl out_ink(e: Example, p: Position, p_inner: Position)
    out_ink(E, P, P_inner) :-
        parse.slot(E, P, P_inner, P_grid), ex_out(E, P_grid, Col), !params.background(Col).

    // A solid block becomes the diamond.
    .decl diamond(p: Position)
    diamond(P_inner) :- parse.solid(E, P), out_ink(E, P, P_inner).

    // The output slot differs from the diamond somewhere.
    .decl off_diamond(e: Example, p: Position)
    off_diamond(E, P) :-
        parse.slot(E, P, P_inner, _),
        ( diamond(P_inner), !out_ink(E, P, P_inner)
        ; !diamond(P_inner), out_ink(E, P, P_inner) ).

    // Every other filled output slot holds the X.
    .decl x(p: Position)
    x(P_inner) :- out_ink(E, P, P_inner), off_diamond(E, P).

    // The sides the output diamonds stand on.
    .decl diamond_side(d: Dir)
    diamond_side(D) :- parse.port(E, P, D), !off_diamond(E, P).
}
