// 58e15b12
// @draft
// @keywords: objects walk
// output: Each non-bg color draws a pair of one-cell-wide bars along
//  params.bar_axis, of equal extent and aligned with each other. The pair
//  repeats along that axis, both ways: each repeat sits one bar length
//  further on and one cell wider on each side. Where two colors' repeats
//  meet, the cell takes params.overlap.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl bar_axis(a: Axis) bar_axis(AXIS_V).
    .decl overlap(col: Color) overlap(6).
}

.init params = Params

// --- the bar pairs ---

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col), !params.bg(Col).

// --- the repeats ---

// The bar cells and their repeats in frame: the K-th repeat of a bar cell
// sits K bar lengths on along the axis, either way, and K cells further out
// on the side of the pair the cell sits on.
.decl trace(col: Color, p: Position)
trace(Col, Q) :-
    params.bar_axis(A), perp(A, A2),
    bbox.cell(Col, P), bbox.box(Col, B), box_extent(B, P, A, N),
    box_edge(P, B, D_out), axis_of(D_out, A2), opposite(D_out, O_out),  // the side it sits on
    axis_of(D_step, A), opposite(D_step, O_step),                       // either way along the axis
    in(Q, _), relative(P, Q, V),                                        // a frame cell, as an offset
    dist(V, O_out, K),                                                  // K cells further out
    dist(V, O_step, T), stride(T, N, 0, K, 0).                          // K bar lengths on

.init drawn = Unanimous<Position, Color>
drawn.item(P, Col) :- trace(Col, P).

out(P, Col) :-
    in(P, _),
    ( drawn.value(P, Col)                      // one color reaches the cell
    ; drawn.clash(P), params.overlap(Col)      // two colors meet on it
    ; !drawn.item(P, _), params.bg(Col)        // no color reaches it
    ).
