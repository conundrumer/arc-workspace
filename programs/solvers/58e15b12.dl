// 58e15b12
// draft
// keywords: objects walk
// output: Each non-bg color draws a pair of one-cell-wide bars along
//  params.bar_axis, of equal extent and aligned with each other. The pair
//  repeats along that axis, both ways: each repeat sits one bar length
//  further on and one cell wider on each side. Where two colors' repeats
//  meet, the cell takes params.overlap.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl bar_axis(a: Axis) bar_axis(AXIS_V).
    .decl overlap(col: Color) overlap(6).
}

.init params = Params

// --- the bar pairs ---

.init bbox = Bbox<Color>
bbox.cell(Col, P) :- in(P, Col), !params.bg(Col).

// --- the repeats ---

// The bar cells and their repeats, each tagged with the way it runs along the
// axis and the side it widens toward.
.decl trace(col: Color, p: Position, d_step: Dir, d_out: Dir)
trace(Col, P, D_step, D_out) :-
    params.bar_axis(A), perp(A, A2),
    bbox.cell(Col, P), bbox.box(Col, B),
    box_edge(P, B, D_out), axis_of(D_out, A2),               // the side of the pair it sits on
    axis_of(D_step, A).                                      // either way along the axis
trace(Col, Q, D_step, D_out) :-
    trace(Col, P, D_step, D_out),
    params.bar_axis(A), bbox.box(Col, B), box_extent(B, P, A, N),
    jump(P, D_step, N, P_on), neighbor(P_on, D_out, Q),      // a bar length on, a cell wider
    in(Q, _).                                                // while it stays in frame

.init drawn = Unanimous<Position, Color>
drawn.item(P, Col) :- trace(Col, P, _, _).

out(P, Col) :-
    in(P, _),
    ( drawn.value(P, Col)                      // one color reaches the cell
    ; drawn.clash(P), params.overlap(Col)      // two colors meet on it
    ; !drawn.item(P, _), params.bg(Col)        // no color reaches it
    ).
