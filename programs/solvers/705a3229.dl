// 705a3229
// concept: markers cast
// Scattered single-cell marks on bg. Each mark casts a ray in its own
// color to the nearer edge on each axis.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
}

.init c = Consts

.decl mark(col: Color, p: Position)
mark(Col, P) :- in(P, Col), !c.bg(Col).

// The dirs a mark casts toward: the strictly nearer edge on each axis.
.decl cast(col: Color, d: Dir)
cast(Col, D) :- mark(Col, P), dir_elem(D), dist_pair(P, D, K, K2), K < K2.

.init rays = Ray<Color>
rays.dir(Col, D)  :- cast(Col, D).
rays.cell(Col, P) :- mark(Col, _), in(P, _).
rays.mark(Col, P) :- mark(Col, P).

.decl arm(p: Position, col: Color)
arm(P, Col) :- rays.ray(Col, P, _, _, _).

.decl out(p: Position, col: Color)
out(P, Col) :- arm(P, Col).
out(P, Col) :- in(P, Col), !arm(P, _).
