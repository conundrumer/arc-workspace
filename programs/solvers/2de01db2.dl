// 2de01db2
// keywords: lines lookup count
// input: the grid splits into lines along params.axis, one main color per line
// output: a cell on its line's main color takes params.bg, and every other cell
//  takes that main color.

// which model identifies a line's main color
.type Choice =
    // the line's color from the stored main-color set
    Palette {}
    // the commonest color confined to the line: any other color crosses lines
  | Owned {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl axis(a: Axis) axis(AXIS_H).
    .decl bg(c: Color) bg(0).

    // --- $Palette ---
    .decl ink(c: Color)
    ink(4). ink(6). ink(8).
}

.init params = Params

// Cell with its line identity.
.decl cell_line(p: Position, col: Color, p_line: Position)
cell_line(P, Col, P_line) :- in(P, Col), params.axis(A), split(P, A, _, P_line).

// Colors present per line.
.decl line_color(p_line: Position, col: Color)
line_color(P_line, Col) :- cell_line(_, Col, P_line).

.decl main(p_line: Position, col: Color, ch: Choice)

// --- $Palette ---
main(P_line, Col, $Palette()) :- line_color(P_line, Col), params.ink(Col).

// --- $Owned ---

// Color on more than one line — noise.
.decl shared(col: Color)
shared(Col) :- line_color(L1, Col), line_color(L2, Col), L1 != L2.

// The line's own colors, by cell count.
.init own_count = Mode<Position, Color, Position>
own_count.item(P_line, Col, P) :- cell_line(P, Col, P_line), !shared(Col).

main(P_line, Col, $Owned()) :- own_count.mode(P_line, Col).

// --- Output ---

out(P, Col, Ch) :-
    cell_line(P, C_in, P_line),                           // cell, its color, its line
    ( main(P_line, Col, Ch), C_in != Col                  // off the line's main color — takes it
    ; main(P_line, C_in, Ch), params.bg(Col)              // on it — erased
    ).

.comp Determine {
    // The main colors, read off the outputs: an output cell is bg or its
    // line's main.
    .decl ink(c: Color)
    ink(Col) :- ex_out(_, _, Col), !params.bg(Col).
}
