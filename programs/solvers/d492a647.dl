// d492a647
// @keywords: markers walk parity noise
// output: A noise-speckled bg grid holds a single seed cell of a unique
//  color. The seed's color paints every bg cell offset from it by an even
//  count on both axes. Noise cells stay.

// two models of the lattice, tagged on out's Choice; coincide at period 2
.type Choice =
    // the lattice jump is task data in the parameters
    Period {}
    // every-other-cell alternation: two unit steps over a skipped cell, no
    // parameter
  | Parity {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl noise(c: Color) noise(5).

    // --- $Period ---
    .decl period(k: number) period(2).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Period()). impl_choice($Parity()).

// The one cell neither bg nor noise.
.decl seed(p: Position, col: Color)
seed(P, Col) :- in(P, Col), !params.bg(Col), !params.noise(Col).

// The lattice the seed anchors: closure under jumps on the four cardinals.
.decl lattice(p: Position, ch: Choice)
lattice(P, Ch) :- seed(P, _), impl_choice(Ch).

// --- $Period ---
lattice(Q, $Period()) :-
    lattice(P, $Period()),
    params.period(K), dir_elem(D),         // a period jump, any cardinal
    jump(P, D, K, Q), in(Q, _).

// --- $Parity ---
lattice(Q, $Parity()) :-
    lattice(P, $Parity()), dir_elem(D),
    neighbor(P, D, M), in(M, _),      // the skipped cell
    neighbor(M, D, Q), in(Q, _).

.decl painted(p: Position, ch: Choice)
painted(P, Ch) :- lattice(P, Ch), in(P, Col), params.bg(Col).

out(P, Col, Ch) :- painted(P, Ch), seed(_, Col).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !painted(P, Ch).
