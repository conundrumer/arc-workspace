// 5587a8d0
// @draft
// @keywords: objects count rank rings
// input: the non-bg cells
// output: The output is a square of nested rings, one ring per patch: the
//  largest patch draws the outermost ring, and each smaller patch draws a
//  ring one step further in, down to the single center cell.

// what a patch is, data-equivalent on this task since each color forms one
//  blob in every pair; a color lying in two blobs would separate the cases
.type Choice =
    // every cell of one color
    ByColor {}
    // one connected blob
  | ByObject {}

// A cell under a case — patches are classes of these. The case sits in the
// record, so one id space serves both cases and their ids stay apart.
.type Cell = [ch: Choice, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(7).
}

.init params = Params

.decl patch_cell(p: Position, col: Color)
patch_cell(P, Col) :- in(P, Col), !params.bg(Col).

// One id per patch.
.init patch = Canon<Cell>

// --- ByColor ---

patch.equiv([$ByColor(), P], [$ByColor(), Q]) :- patch_cell(P, Col), patch_cell(Q, Col).

// --- ByObject ---

.init blob = Components<Color>
blob.node(Col, P) :- patch_cell(P, Col).

patch.equiv([$ByObject(), P], [$ByObject(), Q]) :- blob.conn(_, P, Q).

// --- the nest ---

.decl patch_of(ch: Choice, p: Position, id: Ident)
patch_of(Ch, P, Id) :- patch.id([Ch, P], Id).

.decl patch_color(ch: Choice, id: Ident, col: Color)
patch_color(Ch, Id, Col) :- patch_of(Ch, P, Id), patch_cell(P, Col).

.init tally = Tally<Ident, Position>
tally.item(Id, P) :- patch_of(_, P, Id).

.decl patch_size(ch: Choice, id: Ident, n: number)
patch_size(Ch, Id, N) :- patch_of(Ch, _, Id), tally.tally(Id, N).

.init nest = Order<Choice, Ident>
nest.elem(Ch, Id) :- patch_size(Ch, Id, _).
nest.before(Ch, Id, Id2) :-
    patch_size(Ch, Id, N), patch_size(Ch, Id2, N2),  // two patches of one case
    N > N2.                                          // the larger one lies further out

// What a patch takes up in the output, as offsets from the center: its ring,
// and everything that ring encloses. The smallest patch encloses nothing and
// takes the center cell alone.
.decl covers(ch: Choice, id: Ident, v: Offset)
.decl within(ch: Choice, id: Ident, v: Offset)
covers(Ch, Id, ZERO) :- nest.last(Ch, Id).
covers(Ch, Id, V) :-
    within(Ch, Id, V2),
    ( V = V2                                // what the ring encloses
    ; dir8_elem(D), neighbor(V2, D, V) ).   // and one step around it
within(Ch, Id, V) :- nest.next(Ch, Id, Id2), covers(Ch, Id2, V).

// The center lies as deep as the innermost ring.
.decl center(ch: Choice, p: Position)
center(Ch, P) :- nest.last(Ch, Id), nest.rank(Ch, Id, R), uniform_inset(R, P).

out(P, Col, Ch) :-
    covers(Ch, Id, V), !within(Ch, Id, V),  // an offset the patch's own ring takes
    center(Ch, C), compose(C, V, P),        // seated at the center
    patch_color(Ch, Id, Col).
