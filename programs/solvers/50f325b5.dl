// 50f325b5
// draft
// concept: markers stamp d4
// The input carries a shape drawn in the mark color. Every D4 image of that
// shape which lands on cells all carrying the field color takes the mark
// color; every other cell keeps its input color.

#include "../lib.dl"

.comp Params {
    .decl mark(col: Color) mark(8).
    .decl field(col: Color) field(3).
}

.init params = Params

// Every D4 image of the drawn shape, sought among the field cells.
.init seek = Occurrences<D4, Unit>
seek.shape(D, P_img, $U()) :-
    in(P, Col), params.mark(Col), d4_elem(D), apply(D, P, P_img).
seek.cell(D, P, $U()) :- in(P, Col), params.field(Col), d4_elem(D).

.decl stamped(p: Position)
stamped(P_out) :-
    seek.occurrence(D, Sh),                              // a landing
    seek.shape(D, P_img, _), compose(Sh, P_img, P_out).  // each of its cells

.decl out(p: Position, col: Color)
out(P, Col) :- stamped(P), params.mark(Col).
out(P, Col) :- in(P, Col), !stamped(P).
