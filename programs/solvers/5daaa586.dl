// 5daaa586
// @draft
// @keywords: crop lines cast
// output: Two full rows and two full columns cross the grid, and the output is
//  the box those four lines bound. A cell inside that box runs out to a border
//  line that matches its color, filling the run.

// what a cell's run matches against
.type Choice =
    // the one border cell where the cell's own row or column ends
    EndMatch {}
    // the color a whole border line holds, so the four lines are colored
    // objects and a cell seeks the line that is its own color
  | LineMatch {}

// A cast is keyed by its case and its direction, so each mark casts only the
// way it matched.
.type CastKey = [ch: Choice, d: Dir]

.decl impl_choice(ch: Choice)
impl_choice($EndMatch()).
impl_choice($LineMatch()).

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color)
    bg(0).
}

.init params = Params

// --- the dividing lines ---

.decl gapped(a: Axis, l: Position)
gapped(A, L) :- in(P, Col), params.bg(Col), axis_elem(A), split(P, A, L, _).

// A line, at position l on axis a, that no background cell breaks.
.decl divider(a: Axis, l: Position)
divider(A, L) :- in(P, _), axis_elem(A), split(P, A, L, _), !gapped(A, L).

// --- the box the dividers bound ---

.init bound = Extremes<Dir>
bound.cand(D, K) :- divider(A, L), axis_of(D, A), dist(L, D, K).    // divider distance toward D

.init bound_box = DirPack<Unit>
bound_box.edge($U(), D, K) :- bound.low(D, K).                      // the nearest divider toward D

// A grid cell on the box's border line toward d.
.decl border(p: Position, d: Dir)
border(P, D) :- bound_box.box($U(), B), in(P, _), box_edge(P, B, D).

// A grid cell strictly inside the box.
.decl inner(p: Position)
inner(P) :- bound_box.box($U(), B), in(P, _), interior(P, B).

// --- marks cast to the border they match ---

.decl mark(p: Position, d: Dir, ch: Choice)

.init cast = Ray<CastKey>
cast.dir([Ch, D], D) :- impl_choice(Ch), dir_elem(D).
cast.cell([Ch, D], P) :- impl_choice(Ch), dir_elem(D), inner(P).
cast.mark([Ch, D], P) :- mark(P, D, Ch).

.decl fill(p: Position, col: Color, ch: Choice)
fill(P, Col, Ch) :- cast.ray([Ch, D], P, D, _, S), in(S, Col).

out(P_crop, Col, Ch) :-
    impl_choice(Ch), bound_box.box($U(), B), in(P, _), crop(P, B, P_crop),
    ( fill(P, Col, Ch)
    ; !fill(P, _, Ch), in(P, Col)
    ).

// --- EndMatch ---

mark(P, D, $EndMatch()) :-
    inner(P), in(P, Col),
    axis_of(D, A), border(Q, D), same_line(A, P, Q),   // where its line meets the border
    in(Q, Col).                                        // the border carries the cell's color

// --- LineMatch ---

// A box corner lies on two border lines, so it states no one line's color.
.decl crossing(p: Position)
crossing(P) :- border(P, D), perp_dir(D, D2), border(P, D2).

.init side = Unanimous<Dir, Color>
side.item(D, Col) :- border(P, D), !crossing(P), in(P, Col).

mark(P, D, $LineMatch()) :- inner(P), in(P, Col), side.value(D, Col).
