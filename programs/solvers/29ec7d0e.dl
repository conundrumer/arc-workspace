// 29ec7d0e
// @keywords: wallpaper repair count noise
// input: A wallpaper — one square tile repeating on both axes — corrupted
//  by noise patches.
// output: The output restores the wallpaper: propagation composes across
//  axes, reaching holes with no clean mate on either of their own lines.

// how the repair finds the period-preserving shift
.type Choice =
    // translation repair, detected: values propagate along shifts unbroken on
    // clean cells
    Shift {}
    // the clean color count is the period: values propagate along jumps of that
    // length
  | Count {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(0).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- clean(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Shift()). impl_choice($Count()).

// Each case's period-preserving shifts. The period varies per pair, so no
// case stores one as a parameter.
.decl shift(ch: Choice, delta: Offset)

// Values propagate from clean cells along each case's shifts.
.decl restored(ch: Choice, p: Position, col: Color)
restored(Ch, P, Col) :- impl_choice(Ch), clean(P, Col).
restored(Ch, P2, Col) :-
    restored(Ch, P, Col), shift(Ch, Delta),
    compose(P, Delta, P2), in(P2, _).

out(P, Col, Ch) :- restored(Ch, P, Col).

// --- $Shift ---

shift($Shift(), Delta) :-
    si.cand($U(), A, K, Delta), !si.mismatch($U(), A, K).

// --- $Count ---

.init period = Tally<Unit, Color>
period.item($U(), Col) :- clean(_, Col).

shift($Count(), Delta) :-
    period.tally($U(), N), dir_elem(D), jump_offset(D, N, Delta).
