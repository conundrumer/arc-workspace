// 29ec7d0e
// @keywords: wallpaper repair count noise
// input: A wallpaper — one square tile repeating on both axes — corrupted
//  by noise patches.
// output: The output restores the wallpaper: each cell takes the value of
//  the clean cells at its place in the tile, whether or not they share one
//  of its lines.

// how the repair finds the period-preserving shift
.type Choice =
    // translation repair, detected: the period on each axis is the shortest
    // shift unbroken on clean cells
    Shift {}
    // the clean color count is the period on both axes
  | Count {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(0).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- clean(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Shift()). impl_choice($Count()).

// Each case's tile period on each axis. The period varies per pair, so no
// case stores one as a parameter.
.decl period(ch: Choice, a: Axis, k: number)

// A cell's place in the tile: its distances to the edges of a corner, each
// within its axis's period.
.decl phase(ch: Choice, dg: DiagDir, a: Axis, p: Position, r: number, r2: number)
phase(Ch, Dg, A, P, R, R2) :-
    in(P, _), diag_dist(P, Dg, A, T, T2), perp(A, A2),
    period(Ch, A, K), stride(T, K, 0, _, R),
    period(Ch, A2, K2), stride(T2, K2, 0, _, R2).

// A cell takes the value of the clean cells at its place in the tile.
out(P, Col, Ch) :-
    phase(Ch, Dg, A, Q, R, R2), clean(Q, Col),
    phase(Ch, Dg, A, P, R, R2).

// --- $Shift ---

period($Shift(), A, K) :- si.min_period($U(), A, K).

// --- $Count ---

.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- clean(_, Col).

period($Count(), A, N) :- palette.tally($U(), N), axis_elem(A).
