// 30f42897
// @keywords: wallpaper parity count perimeter
// input: the grid's border is a cycle of cells, and the input's non-bg cells
//  are one block on that cycle
// output: the input, with the block repeated around the cycle. The sense the
//  cycle runs in is not observable, so the program runs both.

// what spaces the copies
.type Choice =
    // painted and blank stretches alternate around the cycle
    Alternate {}
    // the block recurs every params.period_blocks stretches
  | Period {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(8).

    // --- $Period ---
    // Stretches from one copy of the block to the next.
    .decl period_blocks(k: number) period_blocks(2).
}

.init params = Params

// The block: the input's non-bg cells.
.decl mark(p: Position, col: Color)
mark(P, Col) :- in(P, Col), !params.bg(Col).

.init block = Tally<Unit, Position>
block.item($U(), P) :- mark(P, _).

// The border as a cycle, walked in sense s. At a corner only one of the cell's
// two edges keeps the step on the grid, so each cell has one successor.
.decl ring_step(s: Sense, p: Position, q: Position)
ring_step(S, P, Q) :-
    in(P, _), turn(S, D, D_step), dist(P, D, 0),   // a cell on edge D
    neighbor(P, D_step, Q), in(Q, _).              // the step along that edge

// The distance of each border cell along the cycle from the block's first
// cell in sense s.
.init ring = GraphDistance<Sense, Position>
ring.edge(S, P, Q) :- ring_step(S, P, Q).
ring.seed(S, P) :- mark(P, _), sense_elem(S), !leads(S, P).

// A block cell that another block cell precedes in sense s.
.decl leads(s: Sense, p: Position)
leads(S, P) :- mark(P, _), ring_step(S, Q, P), mark(Q, _).

.decl impl_choice(ch: Choice)
impl_choice($Alternate()).
impl_choice($Period()).

// The cells of each case's copies, under sense s.
.decl paint(s: Sense, p: Position, ch: Choice)

// --- $Alternate ---

// Painted and blank stretches of one block-length alternate from the block.
paint(S, P, $Alternate()) :-
    ring.distance(S, P, T), block.tally($U(), N),
    stride(T, N, N, _, _).                         // in a painted stretch

// --- $Period ---

// The block recurs every K stretches.
paint(S, P, $Period()) :-
    ring.distance(S, P, T), block.tally($U(), N),
    stride(T, N, 0, J, _),                         // in stretch J
    params.period_blocks(K), stride(J, K, 0, _, 0).  // a stretch that starts a period

// --- output ---

out(P, Col, Ch) :- paint(_, P, Ch), mark(_, Col).   // the block's color
out(P, Col, Ch) :-
    impl_choice(Ch), sense_elem(S),      // each case, under each sense
    in(P, Col), !paint(S, P, Ch).        // the cell the pattern leaves alone
