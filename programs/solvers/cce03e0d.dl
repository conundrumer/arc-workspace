// cce03e0d
// family: ad7e01d0
// The second non-bg color is inert noise.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl stamp(c: Color) stamp(2).
}

.init c = Consts

// Output decomposition: tile index × intile position, both input-frame cells.
.decl cell(p_grid: Position, p_tile: Position, p_intile: Position)
cell(P_grid_out, P_tile, P_intile) :-
    in(P_tile, _), in(P_intile, _),
    concat_2d(P_tile, P_intile, 0, P_grid_out).

.decl active(p: Position)
active(P) :- in(P, Col), c.stamp(Col).

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    cell(P_grid_out, P_tile, P_intile), active(P_tile), in(P_intile, Col).
out(P_grid_out, Bg) :-
    cell(P_grid_out, P_tile, _), !active(P_tile), c.bg(Bg).
