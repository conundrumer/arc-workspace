// 39a8645d
// draft
// concept: objects crop count
// Pieces on params.bg, each of one color and 8-connected. Two pieces are copies
// when they hold the same color and the same cells up to translation. The
// output is a piece with the most copies, cropped to its bbox.

#include "../lib.dl"

.comp Params {
    .decl bg(col: Color) bg(0).
}

.init params = Params

// --- pieces ---

.init pieces = Components8<Color>
pieces.node(Col, P) :- in(P, Col), !params.bg(Col).

.init bbox = Bbox<Ident>
bbox.cell(Id, P) :- pieces.label(_, P, Id).

// The piece's cells in its own box — its shape, free of placement.
.decl shape_cell(id: Ident, p_inner: Position)
shape_cell(Id, P_inner) :- bbox.box(Id, B), pieces.label(_, P, Id), crop(P, B, P_inner).

// --- copies ---

.init same_shape = KeyedSetCompare<Ident, Ident, Position>
same_shape.pattern_member(Id, P_inner) :- shape_cell(Id, P_inner).
same_shape.observed_member(Id, P_inner) :- shape_cell(Id, P_inner).

.decl copy(id: Ident, id2: Ident)
copy(Id, Id2) :-
    same_shape.equals(Id, Id2),                             // the same shape
    pieces.label(Col, _, Id), pieces.label(Col, _, Id2).    // in one color

// The pieces with the most copies.
.init commonest = Mode<Unit, Ident, Ident>
commonest.item($U(), Id, Id2) :- copy(Id, Id2).

// --- output ---

.decl out(p: Position, col: Color)
out(P_inner, Col) :-
    commonest.mode($U(), Id),                          // a piece with the most copies
    bbox.box(Id, B), in(P, _), crop(P, B, P_inner),     // its box, cell by cell
    ( pieces.label(Col, P, Id)                          // shape cell
    ; !pieces.label(_, P, Id), params.bg(Col)           // rest of the box
    ).
