// e99362f0
// @draft
// @keywords: overlay decompose rank lookup
// @scene divider-cross: one full row and one full column of the divider color 4 cross and cut
//  the grid into four panels of one size.
// @scene one-color-per-panel: each panel holds marks of one color on the background color 0,
//  and the four panels have four different colors: 7 top-left, 9 top-right, 2 bottom-left,
//  8 bottom-right.
// @rule stack-by-priority: the output has the size of one panel, and each output cell takes,
//  of the colors that the four panels have at that cell, the one highest in the priority, and
//  the background color where no panel has a mark.

// what the stacking order ranks
.type StackKey =
    // @claim stack-by-priority
    ByColor {}
    // @rule stack-by-priority: a stored order of the four panels ranks them, and each output
    //  cell shows the mark of the highest-ranked panel that has a mark there.
    // @witness panels-recolored: variant concept
    //     @relaxed one-color-per-panel
  | OrderByPanel {}

// how the marks at a cell resolve to one
.type StackForm =
    // @claim stack-by-priority
    TotalOrder {}
    // @rule stack-by-priority: a stored table maps the set of marks at a cell to the one the
    //  cell shows; it is undefined where a cell's set is not a key of the table.
    // @witness intransitive-table: ordinary $CombinationTable
    //     @reassigned stack_member
    //     @reassigned stack_out
  | CombinationTable {}

// how the four panels are found
.type PanelParse =
    // @claim divider-cross
    DividerCross {}
    // @scene divider-cross: the panels are the four quadrants around the center row and the
    //  center column, whatever their color; undefined where a grid dimension is even.
    // @witness divider-recolored: variant $CenterHalves
    //     @relaxed divider-cross
  | CenterHalves {}

.type Choice = [k: StackKey, f: StackForm, pa: PanelParse]

.type PanelKey = [pa: PanelParse, p_tile: Position]
.type CellKey = [pa: PanelParse, p: Position]
.type ExampleTile = [e: Example, p_tile: Position]
.type ExampleCell = [e: Example, p: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed one-color-per-panel
    .decl background(c: Color) background(0).

    // --- $ByColor & $TotalOrder ---
    // the order of the panel colors, highest first
    .decl priority(c: Color, r: number)
    priority(8, 0). priority(7, 1). priority(9, 2). priority(2, 3).

    // --- $OrderByPanel & $TotalOrder ---
    // the order of the panels, highest first
    .decl panel_order(p_tile: Position, r: number)
    GRID_2x2(panel_order,
        1, 2,
        3, 0)

    // --- $ByColor & $CombinationTable ---
    // the color shown where the marks at a cell are the members of an entry
    .decl stack_member(id: Ident, c: Color)
    .decl stack_out(id: Ident, c: Color)
    stack_member(0, 2). stack_out(0, 2).
    stack_member(1, 7). stack_out(1, 7).
    stack_member(2, 8). stack_out(2, 8).
    stack_member(3, 9). stack_out(3, 9).
    stack_member(4, 2). stack_member(4, 7). stack_out(4, 7).
    stack_member(5, 2). stack_member(5, 8). stack_out(5, 8).
    stack_member(6, 2). stack_member(6, 9). stack_out(6, 9).
    stack_member(7, 7). stack_member(7, 8). stack_out(7, 8).
    stack_member(8, 7). stack_member(8, 9). stack_out(8, 7).
    stack_member(9, 8). stack_member(9, 9). stack_out(9, 8).
    stack_member(10, 2). stack_member(10, 7). stack_member(10, 8). stack_out(10, 8).
    stack_member(11, 2). stack_member(11, 7). stack_member(11, 9). stack_out(11, 7).
    stack_member(12, 2). stack_member(12, 8). stack_member(12, 9). stack_out(12, 8).
    stack_member(13, 7). stack_member(13, 8). stack_member(13, 9). stack_out(13, 8).
    stack_member(14, 2). stack_member(14, 7). stack_member(14, 8). stack_member(14, 9).
    stack_out(14, 8).

    // --- $OrderByPanel & $CombinationTable ---
    // the panel shown where the panels marked at a cell are the members of an entry
    .decl panel_stack_member(id: Ident, p_tile: Position)
    .decl panel_stack_out(id: Ident, p_tile: Position)
    panel_stack_member(0, [1, 0, 0, 1]). panel_stack_out(0, [1, 0, 0, 1]).
    panel_stack_member(1, [0, 1, 0, 1]). panel_stack_out(1, [0, 1, 0, 1]).
    panel_stack_member(2, [1, 0, 1, 0]). panel_stack_out(2, [1, 0, 1, 0]).
    panel_stack_member(3, [0, 1, 1, 0]). panel_stack_out(3, [0, 1, 1, 0]).
    panel_stack_member(4, [1, 0, 0, 1]). panel_stack_member(4, [0, 1, 0, 1]).
    panel_stack_out(4, [0, 1, 0, 1]).
    panel_stack_member(5, [1, 0, 0, 1]). panel_stack_member(5, [1, 0, 1, 0]).
    panel_stack_out(5, [1, 0, 1, 0]).
    panel_stack_member(6, [1, 0, 0, 1]). panel_stack_member(6, [0, 1, 1, 0]).
    panel_stack_out(6, [0, 1, 1, 0]).
    panel_stack_member(7, [0, 1, 0, 1]). panel_stack_member(7, [1, 0, 1, 0]).
    panel_stack_out(7, [1, 0, 1, 0]).
    panel_stack_member(8, [0, 1, 0, 1]). panel_stack_member(8, [0, 1, 1, 0]).
    panel_stack_out(8, [0, 1, 0, 1]).
    panel_stack_member(9, [1, 0, 1, 0]). panel_stack_member(9, [0, 1, 1, 0]).
    panel_stack_out(9, [1, 0, 1, 0]).
    panel_stack_member(10, [1, 0, 0, 1]). panel_stack_member(10, [0, 1, 0, 1]).
    panel_stack_member(10, [1, 0, 1, 0]). panel_stack_out(10, [1, 0, 1, 0]).
    panel_stack_member(11, [1, 0, 0, 1]). panel_stack_member(11, [0, 1, 0, 1]).
    panel_stack_member(11, [0, 1, 1, 0]). panel_stack_out(11, [0, 1, 0, 1]).
    panel_stack_member(12, [1, 0, 0, 1]). panel_stack_member(12, [1, 0, 1, 0]).
    panel_stack_member(12, [0, 1, 1, 0]). panel_stack_out(12, [1, 0, 1, 0]).
    panel_stack_member(13, [0, 1, 0, 1]). panel_stack_member(13, [1, 0, 1, 0]).
    panel_stack_member(13, [0, 1, 1, 0]). panel_stack_out(13, [1, 0, 1, 0]).
    panel_stack_member(14, [1, 0, 0, 1]). panel_stack_member(14, [0, 1, 0, 1]).
    panel_stack_member(14, [1, 0, 1, 0]). panel_stack_member(14, [0, 1, 1, 0]).
    panel_stack_out(14, [1, 0, 1, 0]).

    // --- $DividerCross ---
    // @ignore: derive SharedColor — fails Subsumption by $CenterHalves: where one color draws the
    //  one full row and the one full column, the panels are equal, so the cross is centered
    // @ignore: derive VanishedColor — on one input with no train outputs it takes every color
    //  of the input, as SharedColor does, and fails Subsumption by $CenterHalves alike
    .decl divider(c: Color) divider(4).
}

.init params = Params

.decl stack_key_choice(k: StackKey)
stack_key_choice($ByColor()). stack_key_choice($OrderByPanel()).

.decl stack_form_choice(f: StackForm)
stack_form_choice($TotalOrder()). stack_form_choice($CombinationTable()).

.decl panel_parse_choice(pa: PanelParse)
panel_parse_choice($DividerCross()). panel_parse_choice($CenterHalves()).

.decl impl_choice(ch: Choice)
impl_choice([K, F, Pa]) :- stack_key_choice(K), stack_form_choice(F), panel_parse_choice(Pa).

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // @input

    // the line along axis a through p holds a color other than p's
    .decl line_break(key: Key, p: Position, a: Axis)
    line_break(K, P, A) :- cell(K, P, C), axis_elem(A), same_line(A, P, Q), cell(K, Q, C2), C2 != C.

    // a line drawn in one color c, which cuts axis a_cut, axis-only on that axis
    .decl full_cut(key: Key, a_cut: Axis, l: Position, c: Color)
    full_cut(K, A_cut, L, C) :-
        cell(K, P, C), axis_elem(A), !line_break(K, P, A),
        perp(A, A_cut), split(P, A_cut, L, _).
}

.init parse = Parse<Unit>
parse.cell($U(), P, C) :- in(P, C).

// the marks of each panel, at their cells in the panel frame
.decl mark(pa: PanelParse, p_tile: Position, p: Position, col: Color)
mark(Pa, T, P, Col) :- panel_cell(Pa, T, P, Col), !params.background(Col).

out(P, Bg, [K, F, Pa]) :-
    impl_choice([K, F, Pa]), panel_cell(Pa, _, P, _), !mark(Pa, _, P, _), params.background(Bg).

// --- $DividerCross, $CenterHalves ---

// the lines that cut the grid into panels, each axis-only on the axis it cuts
// @store: variant concept
//     @relaxed one-color-per-panel
.decl cut(pa: PanelParse, a: Axis, l: Position)

// @claim divider-cross
// @ignore divider: store — `divider` holds the facts of `cut`, so storing it is `cut=stored`
.init panels = DividerTiles<PanelParse>
panels.cell(Pa, P) :- cut(Pa, _, _), in(P, _).
panels.divider(Pa, A, L) :- cut(Pa, A, L).

// @claim divider-cross
.init panel_box = Bbox<PanelKey>
panel_box.cell([Pa, T], P) :- panels.tile_of(Pa, P, T).

// each panel cell, as a cell of its panel's own frame
.decl panel_cell(pa: PanelParse, p_tile: Position, p_intile: Position, col: Color)
panel_cell(Pa, T, P_intile, Col) :-
    in(P, Col), panel_box.box([Pa, T], B), crop(P, B, P_intile).

// --- $DividerCross ---

// a full line of one divider color cuts the axis across it
cut($DividerCross(), A, L) :- parse.full_cut($U(), A, L, C), params.divider(C).

// --- $CenterHalves ---

// the center line of each axis cuts it
cut($CenterHalves(), A, L) :- in(P, _), axis_of(D, A), dist_pair(P, D, K, K), split(P, A, L, _).

// --- $ByColor & $TotalOrder ---

// the highest-priority mark color at each cell
// @claim stack-by-priority
.init front_color = ArgExtremes<CellKey, Color>
front_color.cand([Pa, P], Col, R) :- mark(Pa, _, P, Col), params.priority(Col, R).

.decl unranked_color(pa: PanelParse, p: Position)
unranked_color(Pa, P) :- mark(Pa, _, P, Col), !params.priority(Col, _).

out(P, Col, [$ByColor(), $TotalOrder(), Pa]) :-
    impl_choice([$ByColor(), $TotalOrder(), Pa]),
    front_color.low([Pa, P], Col, _), !unranked_color(Pa, P).

// --- $OrderByPanel & $TotalOrder ---

// the highest-ranked panel marked at each cell
// @claim stack-by-priority
.init front_panel = ArgExtremes<CellKey, Position>
front_panel.cand([Pa, P], T, R) :- mark(Pa, T, P, _), params.panel_order(T, R).

.decl unranked_panel(pa: PanelParse, p: Position)
unranked_panel(Pa, P) :- mark(Pa, T, P, _), !params.panel_order(T, _).

out(P, Col, [$OrderByPanel(), $TotalOrder(), Pa]) :-
    impl_choice([$OrderByPanel(), $TotalOrder(), Pa]),
    front_panel.low([Pa, P], T, _), !unranked_panel(Pa, P), mark(Pa, T, P, Col).

// --- $ByColor & $CombinationTable ---

// @claim stack-by-priority
.init color_table = KeyedSetCompare<CellKey, Ident, Color>
color_table.pattern_member(Id, Col) :- params.stack_member(Id, Col).
color_table.observed_member([Pa, P], Col) :- mark(Pa, _, P, Col).

out(P, Col, [$ByColor(), $CombinationTable(), Pa]) :-
    impl_choice([$ByColor(), $CombinationTable(), Pa]),
    color_table.equals([Pa, P], Id), params.stack_out(Id, Col).

// --- $OrderByPanel & $CombinationTable ---

// @claim stack-by-priority
.init panel_table = KeyedSetCompare<CellKey, Ident, Position>
panel_table.pattern_member(Id, T) :- params.panel_stack_member(Id, T).
panel_table.observed_member([Pa, P], T) :- mark(Pa, T, P, _).

out(P, Col, [$OrderByPanel(), $CombinationTable(), Pa]) :-
    impl_choice([$OrderByPanel(), $CombinationTable(), Pa]),
    panel_table.equals([Pa, P], Id), params.panel_stack_out(Id, T), mark(Pa, T, P, Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, C) :- ex_in(E, P, C).

    // a color that draws a full line in some input and not in another
    .decl uncut(c: Color)
    uncut(C) :- parse.full_cut(_, _, _, C), ex_in(E, _, _), !parse.full_cut(E, _, _, C).

    .decl divider(c: Color)
    divider(C) :- parse.full_cut(_, _, _, C), !uncut(C).

    .init panels = DividerTiles<Example>
    panels.cell(E, P) :- ex_in(E, P, _).
    panels.divider(E, A, L) :- parse.full_cut(E, A, L, C), divider(C).

    .init panel_box = Bbox<ExampleTile>
    panel_box.cell([E, T], P) :- panels.tile_of(E, P, T).

    // a mark of panel t at output cell p
    .decl mark(e: Example, p_tile: Position, p: Position, col: Color)
    mark(E, T, P_intile, Col) :-
        ex_in(E, P, Col), !params.background(Col), panel_box.box([E, T], B), crop(P, B, P_intile).

    // at a cell both mark, the output shows the first over the second
    .decl beats(e: Example, p_tile: Position, p_tile2: Position, col: Color, col2: Color)
    beats(E, T, T2, Col, Col2) :-
        mark(E, T, P, Col), mark(E, T2, P, Col2), Col != Col2, ex_out(E, P, Col).

    .init color_order = Order<Unit, Color>
    color_order.elem($U(), Col) :- mark(_, _, _, Col).
    color_order.before($U(), Col, Col2) :- beats(_, _, _, Col, Col2).

    .decl priority(c: Color, r: number)
    priority(Col, R) :- color_order.rank($U(), Col, R).

    .init panel_rank = Order<Unit, Position>
    panel_rank.elem($U(), T) :- mark(_, T, _, _).
    panel_rank.before($U(), T, T2) :- beats(_, T, T2, _, _).

    .decl panel_order(p_tile: Position, r: number)
    panel_order(T, R) :- panel_rank.rank($U(), T, R).

    // the output cells of each train example whose sets of mark colors are equal
    .init color_set = KeyedSetCompare<ExampleCell, ExampleCell, Color>
    color_set.pattern_member([E, P], Col) :- mark(E, _, P, Col), ex_out(E, P, _).
    color_set.observed_member([E, P], Col) :- mark(E, _, P, Col), ex_out(E, P, _).

    // one id per set of mark colors
    .init color_entry = Canon<ExampleCell>
    color_entry.equiv(X, Y) :- color_set.equals(X, Y).

    .decl stack_member(id: Ident, c: Color)
    stack_member(Id, Col) :- color_entry.id([E, P], Id), mark(E, _, P, Col).

    .decl stack_out(id: Ident, c: Color)
    stack_out(Id, Col) :- color_entry.id([E, P], Id), ex_out(E, P, Col).

    // the output cells of each train example whose sets of marked panels are equal
    .init panel_set = KeyedSetCompare<ExampleCell, ExampleCell, Position>
    panel_set.pattern_member([E, P], T) :- mark(E, T, P, _), ex_out(E, P, _).
    panel_set.observed_member([E, P], T) :- mark(E, T, P, _), ex_out(E, P, _).

    // one id per set of marked panels
    .init panel_entry = Canon<ExampleCell>
    panel_entry.equiv(X, Y) :- panel_set.equals(X, Y).

    .decl panel_stack_member(id: Ident, p_tile: Position)
    panel_stack_member(Id, T) :- panel_entry.id([E, P], Id), mark(E, T, P, _).

    // the panel whose mark color the output shows
    .decl panel_stack_out(id: Ident, p_tile: Position)
    panel_stack_out(Id, T) :- panel_entry.id([E, P], Id), mark(E, T, P, Col), ex_out(E, P, Col).
}
