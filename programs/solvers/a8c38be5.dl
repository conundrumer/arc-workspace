// a8c38be5
// @draft
// @keywords: objects markers tile-arrangement pack count rank
// @scene pieces: the input holds nine params.piece_size squares on a field of
//  params.bg, and every other cell belongs to one square, a piece. Pieces can
//  touch, but no params.piece_size square that crosses two pieces is free of
//  params.bg
// @scene marks: each piece is params.fill except for its marks, cells of one
//  other color. One piece has no marks. In each other piece the marks lie on
//  one side of the piece center: an L of three cells at a corner, or a T of
//  four cells along an edge
// @scene one-per-position: the nine pieces point to the nine blocks of a 3×3
//  arrangement, and the piece with no marks points to the center
// @rule direction: a piece points to the block given by the side, on each
//  axis, whose half of the piece holds more of its marks than the opposite
//  half, a half being the cells nearer that side's edge than the opposite
//  edge; on an axis where the two halves hold equally many, and for a piece
//  with no marks, the middle
// @rule assemble: the output is the 3×3 arrangement of params.piece_size
//  blocks, with no gap. Each piece is copied unchanged into the block it
//  points to

// where a piece with no params.fill cell goes
.type FillFree =
    // @claim direction
    FillFreeCenter {}
    // @rule needs-fill: a piece with no params.fill cell is dropped
    // @witness solid-block: borderline $NeedsFill
    //     @relaxed pieces
    //     @relaxed marks
  | NeedsFill {}

// where a piece with no marks goes
.type Unmarked =
    // @claim direction
    UnmarkedCenter {}
    // @rule skip-unmarked: a piece with no marks is dropped
    // @witness solid-block: borderline $NeedsFill
  | SkipUnmarked {}

// how a piece's marks give the block it points to
.type Direction =
    // @claim direction
    HalfCount {}
    // @rule direction: a piece points to the block given by the side, on each
    //  axis, that the center of its marks' bounding box lies on from the piece
    //  center
    // @witness long-stem: variant concept
    //     @relaxed marks
  | BboxCenter {}
    // @rule direction: a piece points to the block given by the side, on each
    //  axis, whose edge line holds more of its marks than the opposite edge
    //  line
    // @witness bar-four: borderline concept
    //     @relaxed marks
    //     @reassigned piece_size
  | EdgeCount {}
    // @rule direction: a piece points to the block given by the side, on each
    //  axis, whose edge line holds a mark when the opposite edge line holds none
    // @witness long-stem: variant concept
  | EdgeTouch {}

// what fills a block that no piece points to
.type EmptyBlock =
    // @claim assemble
    EmptyUndefined {}
    // @rule fill-default: a block that no piece points to is all params.fill
    // @witness no-center: variant $FillDefault
    //     @relaxed pieces
    //     @relaxed one-per-position
  | FillDefault {}
    // @rule bg-default: a block that no piece points to is all params.bg
    // @witness no-center: variant $FillDefault
  | BgDefault {}

// the color of a piece's unmarked cells
.type FillColor =
    // @claim marks
    StoredFill {}
    // @scene marks: params.fill is the most frequent color of the input other
    //  than params.bg; undefined when two colors tie
    // @witness fill-three: variant $FillDerived
    //     @relaxed marks
  | FillDerived {}

// the side of a piece
.type PieceSize =
    // @claim pieces
    StoredSize {}
    // @scene pieces: params.piece_size is the largest side of a square free of
    //  params.bg
    // @witness four-square: variant $SizeDerived
    //     @relaxed pieces
  | SizeDerived {}

.type Choice = [fill_free: FillFree, unmarked: Unmarked, direction: Direction,
                empty: EmptyBlock, fill: FillColor, size: PieceSize]

// A piece's marks under one fill reading.
.type Marked = [fill: FillColor, b: Box]

// A square side tried under one reading.
.type Trial = [sz: PieceSize, n: number]

// A piece and a side.
.type Lean = [fill: FillColor, b: Box, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // @derive DominantColor: variant derived
    //     @relaxed pieces
    // @ignore: derive concept — wherever it is defined, it gives the output of
    //  the BgDefault copy
    .decl bg(c: Color) bg(0).

    // The blocks on each axis of the arrangement: one at each side, and the
    // middle.
    .decl arrangement(n: number) arrangement(3).

    // The blocks of the output, in the arrangement's frame.
    .decl slot(p: Position)
    slot(P) :- arrangement(N), helpers.frame_pos([N, N], P).

    // --- $StoredFill ---
    .decl fill(c: Color) fill(5).

    // --- $StoredSize ---
    .decl piece_size(k: number) piece_size(3).
}

.init params = Params

.decl fill_free_choice(ff: FillFree)
fill_free_choice($FillFreeCenter()). fill_free_choice($NeedsFill()).

.decl direction_choice(dr: Direction)
direction_choice($HalfCount()). direction_choice($BboxCenter()). direction_choice($EdgeCount()).
direction_choice($EdgeTouch()).

.decl fill_color_choice(fc: FillColor)
fill_color_choice($StoredFill()). fill_color_choice($FillDerived()).

.decl piece_size_choice(sz: PieceSize)
piece_size_choice($StoredSize()). piece_size_choice($SizeDerived()).

// The concept case, and the cases that fill a block no piece points to: with
// params.bg, or with params.fill after dropping the unmarked pieces. Each other
// case fails Fit or is subsumed by one of these.
.decl impl_choice(ch: Choice)
impl_choice([$FillFreeCenter(), $UnmarkedCenter(), $HalfCount(), $EmptyUndefined(),
             $StoredFill(), $StoredSize()]).
impl_choice([Ff, $UnmarkedCenter(), Dr, $BgDefault(), Fc, Sz]) :-
    fill_free_choice(Ff), direction_choice(Dr), fill_color_choice(Fc), piece_size_choice(Sz).
impl_choice([Ff, $SkipUnmarked(), Dr, $FillDefault(), Fc, Sz]) :-
    fill_free_choice(Ff), direction_choice(Dr), fill_color_choice(Fc), piece_size_choice(Sz).

// The sides tried, and the sides a piece is read at.
.decl trial(sz: PieceSize, n: number)
.decl side(sz: PieceSize, n: number)

// The cells of a square of each side, in its own frame.
.init frame = Frame2D<number>
frame.extent(N, A, N) :- trial(_, N), axis_elem(A).

// The squares free of params.bg, each by the box it covers.
// @claim pieces
.init squares = Occurrences<Trial, Unit>
squares.cell([Sz, N], P, $U()) :- trial(Sz, N), in(P, Col), !params.bg(Col).
squares.shape([Sz, N], P, $U()) :- trial(Sz, N), frame.cell(N, P).

.decl window_at(sz: PieceSize, n: number, b: Box)
window_at(Sz, N, B) :- squares.occurrence([Sz, N], B).

// A window's cells, in its own frame.
.decl window_color(sz: PieceSize, b: Box, p: Position, col: Color)
window_color(Sz, B, P_inner, Col) :-
    side(Sz, N), window_at(Sz, N, B), frame.cell(N, P_inner), compose(B, P_inner, P),
    in(P, Col).

// The squares free of params.bg at each reading's piece side.
.decl window(sz: PieceSize, b: Box)
window(Sz, B) :- side(Sz, K), window_at(Sz, K, B).

// The color of a piece's unmarked cells under each reading; undefined when
// the reading gives two.
// @claim marks
.init fill = Unanimous<FillColor, Color>

.decl mark(fc: FillColor, b: Box, p: Position)
mark(Fc, B, P) :- fill.value(Fc, _), window_color(_, B, P, Col), !fill.value(Fc, Col).

// The pieces a case places, before and after it drops the unmarked ones.
.decl candidate(sz: PieceSize, fc: FillColor, ff: FillFree, b: Box)
.decl member(sz: PieceSize, fc: FillColor, ff: FillFree, um: Unmarked, b: Box)

// The sides each reading sends a piece toward.
.decl toward(fc: FillColor, dr: Direction, b: Box, d: Dir)

// The block each reading sends a piece to.
.decl points(fc: FillColor, dr: Direction, b: Box, s: Position)

// A block a reading does not send the piece to: at the edge of a side the
// piece does not lean toward, or off the edge of one it does.
.decl misfit(fc: FillColor, dr: Direction, b: Box, s: Position)
misfit(Fc, Dr, B, S) :-
    fill.value(Fc, _), direction_choice(Dr), window(_, B), params.slot(S), dir_elem(D),
    ( dist(S, D, 0), !toward(Fc, Dr, B, D)
    ; !dist(S, D, 0), toward(Fc, Dr, B, D) ).

points(Fc, Dr, B, S) :-
    fill.value(Fc, _), direction_choice(Dr), window(_, B), params.slot(S), !misfit(Fc, Dr, B, S).

.decl placed(sz: PieceSize, fc: FillColor, ff: FillFree, um: Unmarked, dr: Direction,
             b: Box, s: Position)
placed(Sz, Fc, Ff, Um, Dr, B, S) :- member(Sz, Fc, Ff, Um, B), points(Fc, Dr, B, S).

// The color of a block that no piece points to.
.decl empty_color(e: EmptyBlock, fc: FillColor, col: Color)

// The cells a vacant block shows.
.decl empty_cell(e: EmptyBlock, fc: FillColor, sz: PieceSize, p_inner: Position, col: Color)
empty_cell(E, Fc, Sz, P_inner, Col) :-
    empty_color(E, Fc, Col), side(Sz, K), frame.cell(K, P_inner).

// The blocks no piece is put in.
.decl vacant(sz: PieceSize, fc: FillColor, ff: FillFree, um: Unmarked, dr: Direction,
             s: Position)
vacant(Sz, Fc, Ff, Um, Dr, S) :-
    impl_choice([Ff, Um, Dr, _, Fc, Sz]), params.slot(S), !placed(Sz, Fc, Ff, Um, Dr, _, S).

out(P, Col, [Ff, Um, Dr, E, Fc, Sz]) :-
    impl_choice([Ff, Um, Dr, E, Fc, Sz]),
    ( placed(Sz, Fc, Ff, Um, Dr, B, S), window_color(Sz, B, P_inner, Col)
    ; vacant(Sz, Fc, Ff, Um, Dr, S), empty_cell(E, Fc, Sz, P_inner, Col) ),
    concat_2d(S, P_inner, 0, P).

// --- $FillFreeCenter ---
candidate(Sz, Fc, $FillFreeCenter(), B) :- window(Sz, B), fill.value(Fc, _).

// --- $NeedsFill ---
candidate(Sz, Fc, $NeedsFill(), B) :-
    window(Sz, B), window_color(Sz, B, _, Col), fill.value(Fc, Col).

// --- $UnmarkedCenter ---
member(Sz, Fc, Ff, $UnmarkedCenter(), B) :- candidate(Sz, Fc, Ff, B).

// --- $SkipUnmarked ---
member(Sz, Fc, Ff, $SkipUnmarked(), B) :- candidate(Sz, Fc, Ff, B), mark(Fc, B, _).

// --- $HalfCount ---
// A mark nearer edge d than the opposite edge.
.decl half_mark(fc: FillColor, b: Box, d: Dir, m: Position)
half_mark(Fc, B, D, P) :- mark(Fc, B, P), dir_elem(D), dist_pair(P, D, K1, K2), K1 < K2.

// @claim direction
.init lean = Excess<Lean, Position>
lean.plus([Fc, B, D], P) :- half_mark(Fc, B, D, P).
lean.minus([Fc, B, D], P) :- half_mark(Fc, B, O, P), opposite(D, O).

toward(Fc, $HalfCount(), B, D) :- lean.excess([Fc, B, D], _).

// --- $BboxCenter ---
// @claim direction
.init mark_box = Bbox<Marked>
mark_box.cell([Fc, B], P) :- mark(Fc, B, P).

toward(Fc, $BboxCenter(), B, D) :-
    mark_box.box([Fc, B], B_marks), dist_pair(B_marks, D, K1, K2), K1 < K2.

// --- $EdgeCount, $EdgeTouch ---
// A mark on the piece's edge line toward d.
.decl edge_mark(fc: FillColor, b: Box, d: Dir, m: Position)
edge_mark(Fc, B, D, P) :- mark(Fc, B, P), dir_elem(D), dist(P, D, 0).

// --- $EdgeCount ---
// @claim direction
.init edge_excess = Excess<Lean, Position>
edge_excess.plus([Fc, B, D], P) :- edge_mark(Fc, B, D, P).
edge_excess.minus([Fc, B, D], P) :- edge_mark(Fc, B, O, P), opposite(D, O).

toward(Fc, $EdgeCount(), B, D) :- edge_excess.excess([Fc, B, D], _).

// --- $EdgeTouch ---
toward(Fc, $EdgeTouch(), B, D) :-
    edge_mark(Fc, B, D, _), opposite(D, O), !edge_mark(Fc, B, O, _).

// --- $FillDefault ---
empty_color($FillDefault(), Fc, Col) :- fill.value(Fc, Col).

// --- $BgDefault ---
empty_color($BgDefault(), Fc, Col) :- fill.value(Fc, _), params.bg(Col).

// --- $StoredFill ---
fill.item($StoredFill(), Col) :- params.fill(Col).

// --- $FillDerived ---
// @claim marks
.init commonest = Mode<Unit, Color, Position>
commonest.item($U(), Col, P) :- in(P, Col), !params.bg(Col).

fill.item($FillDerived(), Col) :- commonest.mode($U(), Col).

// --- $StoredSize, $SizeDerived ---
trial($StoredSize(), K) :- params.piece_size(K).
trial($SizeDerived(), K) :-
    in(P, _), axis_elem(A), ( sub_extent(P, A, K) ; axis_dim(P, A, K) ).

// --- $StoredSize ---
side($StoredSize(), K) :- trial($StoredSize(), K).

// --- $SizeDerived ---
// @claim pieces
.init largest = Extremes<Unit>
largest.cand($U(), K) :- window_at($SizeDerived(), K, _).

side($SizeDerived(), K) :- largest.high($U(), K).

.comp Determine {
    // The commonest color of each output, taken as the fill when every output
    // agrees.
    .init out_mode = Mode<Example, Color, Position>
    out_mode.item(E, Col, P) :- ex_out(E, P, Col).

    .decl fill_contradicted(c: Color)
    fill_contradicted(Col) :- out_mode.mode(_, Col), ex_out(E, _, _), !out_mode.mode(E, Col).

    .decl fill(c: Color)
    fill(Col) :- out_mode.mode(_, Col), !fill_contradicted(Col).
}
