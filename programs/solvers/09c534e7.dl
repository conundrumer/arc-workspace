// 09c534e7
// concept: objects markers border
// Ink networks on bg, each holding one seed cell of a non-outline
// color. The seed's color fills the network's interior — the cells with
// all eight neighbors on the ink; everything else passes through.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl outline(c: Color) outline(1).
}

.init c = Consts

.decl ink(p: Position)
ink(P) :- in(P, C), !c.bg(C).

.init comp = Components<Unit>
comp.node($U(), P) :- ink(P).

// Ink cell with a neighbor off the ink — the network's outline.
.decl border(p: Position)
border(P) :- ink(P), dir8_elem(D), step_delta(D, S), compose(P, S, P2), !ink(P2).

.decl interior(p: Position)
interior(P) :- ink(P), !border(P).

.decl seed(id: Ident, col: Color)
seed(Id, Col) :- comp.label($U(), P, Id), in(P, Col), !c.outline(Col).

.decl fill(p: Position, col: Color)
fill(P, Col) :- interior(P), comp.label($U(), P, Id), seed(Id, Col).

.decl out(p: Position, col: Color)
out(P, Col) :- fill(P, Col).
out(P, Col) :- in(P, Col), !fill(P, _).
