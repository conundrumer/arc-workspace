// 337b420f
// @draft
// @keywords: decompose overlay objects select move rank
// input: Separators cut the input into equal panels, and each panel holds
//  one large shape with a smaller decoy.
// output: The output frame is one panel, and every large shape keeps the
//  place it holds in its own panel. Where two shapes would meet, one shape
//  slides along a cardinal direction, by the shortest slide that clears the
//  meeting.

// what the panel cut reads
.type DecChoice =
    // the panels along the axis
    Count {}
    // a panel's extent
  | Size {}

// which shape slides
.type Move =
    // the shape whose clearing slide is shortest
    Least {}
    // the smallest shape that can clear the meeting
  | Yield {}

.type Choice = [d: DecChoice, move: Move]

// A frame cell under one arrangement.
.type Site = [dc: DecChoice, m: Ident, d: Dir, k: number, p: Position]

// A shape under one cut.
.type Piece = [dc: DecChoice, id: Ident]

// A panel under one cut.
.type Panel = [dc: DecChoice, p_panel: Position]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl bg(col: Color) bg(8).
    .decl panel_axis(a: Axis) panel_axis(AXIS_H).
    .decl sep_width(g: number) sep_width(1).

    // --- $Count ---
    .decl panel_count(n: number) panel_count(3).

    // --- $Size ---
    .decl panel_size(k: number) panel_size(5).
}

.init params = Params

.decl dec_choice(dc: DecChoice)
dec_choice($Count()). dec_choice($Size()).

.decl move_choice(mv: Move)
move_choice($Least()). move_choice($Yield()).

.decl impl_choice(ch: Choice)
impl_choice([Dc, Mv]) :- dec_choice(Dc), move_choice(Mv).

// --- panels ---

// A panel cell, with the shared frame cell it stacks onto. Separator cells
// fall in the gap and decompose to nothing.
.decl panel_cell(dc: DecChoice, p_grid: Position, p_panel: Position, p_frame: Position)

// --- $Count ---
panel_cell($Count(), P_grid, P_panel, P_frame) :-
    in(P_grid, _),                                                          // input cell
    params.panel_axis(A), params.panel_count(N), params.sep_width(G),       // panel layout
    divide_slab(P_grid, A, N, G, P_panel, P_frame).                         // panel and frame cell

// --- $Size ---
panel_cell($Size(), P_grid, P_panel, P_frame) :-
    in(P_grid, _),                                                          // input cell
    params.panel_axis(A), params.panel_size(K), params.sep_width(G),        // panel layout
    divide_by_size_slab(P_grid, A, K, G, P_panel, P_frame).                 // panel and frame cell

// --- shared ---

.decl frame(dc: DecChoice, p_frame: Position)
frame(Dc, P_frame) :- panel_cell(Dc, _, _, P_frame).

// --- pieces ---

.init obj = Components<DecChoice>
obj.node(Dc, P_grid) :- panel_cell(Dc, P_grid, _, _), in(P_grid, Col), !params.bg(Col).

.init size = Tally<Piece, Position>
size.item([Dc, Id], P_grid) :- obj.label(Dc, P_grid, Id).

// A panel's piece is the larger of the shapes it holds.
.init largest = ArgExtremes<Panel, Ident>
largest.cand([Dc, P_panel], Id, N) :-
    obj.label(Dc, P_grid, Id), panel_cell(Dc, P_grid, P_panel, _),   // a shape's panel
    size.tally([Dc, Id], N).                                         // its cell count

.decl piece(dc: DecChoice, id: Ident, col: Color)
piece(Dc, Id, Col) :-
    largest.high([Dc, _], Id, _), obj.label(Dc, P_grid, Id), in(P_grid, Col).

.decl piece_cell(dc: DecChoice, id: Ident, p_frame: Position)
piece_cell(Dc, Id, P_frame) :-
    piece(Dc, Id, _), obj.label(Dc, P_grid, Id),   // a piece's cell
    panel_cell(Dc, P_grid, _, P_frame).            // in the shared frame

// --- arrangements ---

// A slide of K cells toward D; K = 0 stays put.
.decl slide(dc: DecChoice, d: Dir, k: number)
slide(Dc, D, K) :- frame(Dc, P), dir_elem(D), dist(P, D, K).

// The frame cells an arrangement covers: piece M slid, every other at rest.
.decl covered(dc: DecChoice, m: Ident, d: Dir, k: number, id: Ident, p_frame: Position)
covered(Dc, M, D, K, Id, Q) :-
    piece(Dc, M, _), slide(Dc, D, K),      // an arrangement
    piece_cell(Dc, Id, P),                 // a piece's cell
    ( Id != M, Q = P                       // at rest
    ; Id = M, jump(P, D, K, Q)             // slid
    ).

// The piece holding a frame cell, absent where two pieces meet.
.init holder = Unanimous<Site, Ident>
holder.item([Dc, M, D, K, P], Id) :- covered(Dc, M, D, K, Id, P).

// An arrangement fails where two pieces meet, or a piece leaves the frame.
.decl clash(dc: DecChoice, m: Ident, d: Dir, k: number)
clash(Dc, M, D, K) :- holder.clash([Dc, M, D, K, _]).
clash(Dc, M, D, K) :- covered(Dc, M, D, K, _, P), !frame(Dc, P).

.decl fits(dc: DecChoice, m: Ident, d: Dir, k: number)
fits(Dc, M, D, K) :- piece(Dc, M, _), slide(Dc, D, K), !clash(Dc, M, D, K).

// The shortest slide each piece can clear the meeting with.
.init least_slide = Extremes<Piece>
least_slide.cand([Dc, M], K) :- fits(Dc, M, _, K).

// The piece that slides.
.decl mover(dc: DecChoice, m: Ident, mv: Move)

// The arrangement: the mover takes its shortest clearing slide.
.decl chosen(dc: DecChoice, m: Ident, d: Dir, k: number, mv: Move)
chosen(Dc, M, D, K, Mv) :-
    mover(Dc, M, Mv), least_slide.low([Dc, M], K), fits(Dc, M, D, K).

// --- $Least ---

.init shortest = ArgExtremes<DecChoice, Ident>
shortest.cand(Dc, M, K) :- least_slide.low([Dc, M], K).

mover(Dc, M, $Least()) :- shortest.low(Dc, M, _).   // the shortest clearing slide

// --- $Yield ---

.init smallest = ArgExtremes<DecChoice, Ident>
smallest.cand(Dc, M, N) :- least_slide.low([Dc, M], _), size.tally([Dc, M], N).

mover(Dc, M, $Yield()) :- smallest.low(Dc, M, _).   // the fewest cells

// --- output ---

.decl paint(p_frame: Position, col: Color, ch: Choice)
paint(P, Col, [Dc, Mv]) :-
    chosen(Dc, M, D, K, Mv), holder.value([Dc, M, D, K, P], Id), piece(Dc, Id, Col).

out(P, Col, Ch) :- paint(P, Col, Ch).
out(P, Bg, [Dc, Mv]) :-
    frame(Dc, P), params.bg(Bg), impl_choice([Dc, Mv]), !paint(P, _, [Dc, Mv]).
