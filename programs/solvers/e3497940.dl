// e3497940
// concept: decompose d4
// Layout: 1×2 horizontally-side-by-side 10×4 subgrids with 1-col separator.
// The far subgrid folds across the separator onto the base subgrid; ink
// keeps its color.
//
// out's choice column (decompose):
//   $Tile() — pre-tabulated in Consts via tile_pos
//   $Div()  — derived in body via the divide primitive

#include "../lib.dl"

.type Choice = Tile {} | Div {}

.comp Consts {
    .init helpers = ConstsHelpers

    .decl frame_dim(a: Axis, n: number)
    frame_dim(AXIS_V, 10). frame_dim(AXIS_H, 4).
    .decl frame(p: Position)
    frame(P) :- frame_dim(AXIS_V, Fv), frame_dim(AXIS_H, Fh), helpers.frame_pos([Fv, Fh], P).

    // --- Tile decompose data ---
    .decl arr_dim(a: Axis, n: number)
    arr_dim(AXIS_V, 1). arr_dim(AXIS_H, 2).
    .decl gap(g: number) gap(1).
    .decl tile_decompose(p: Position, p_outer: Position, p_inner: Position)
    tile_decompose(P_grid, P_tile, P_intile) :-
        arr_dim(AXIS_V, Av), arr_dim(AXIS_H, Ah),
        frame_dim(AXIS_V, Fv), frame_dim(AXIS_H, Fh), gap(G),
        helpers.tile_pos([Av, Ah], [Fv, Fh], [0, G], P_grid, P_tile, P_intile).

    // --- Div decompose data ---
    .decl divisor(n: number)
    divisor(2).

    .decl divide_gap(g: number)
    divide_gap(1).

    // --- Fold data ---
    .decl base(d: Dir) base(DIR_L).   // side kept; the fold axis is its axis
    .decl bg(c: Color) bg(0).
}

.init c = Consts

// --- Decompose cases ---

.decl dec_choice(ch: Choice)
dec_choice($Tile()).
dec_choice($Div()).

.decl decompose(p: Position, p_outer: Position, p_inner: Position, ch: Choice)
decompose(P_grid, P_tile, P_intile, $Tile()) :- c.tile_decompose(P_grid, P_tile, P_intile).
decompose(P_grid, P_tile, P_intile, $Div()) :-
    in(P_grid, _),                                       // input position
    c.base(D), axis_of(D, A),                            // fold axis
    c.divisor(N), c.divide_gap(G),                       // params
    divide_slab(P_grid, A, N, G, P_tile, P_intile).

// --- Fold layers: the base tile passes through; the far tile reflects
// across the separator — in tile coordinates, the flip on the fold axis.

.decl base_ink(p: Position, col: Color, ch: Choice)
base_ink(P_intile, Col, Ch) :-
    in(P_grid, Col), !c.bg(Col),                    // ink cell
    decompose(P_grid, P_tile, P_intile, Ch),
    c.base(D), dist(P_tile, D, 0).                  // base tile

.decl fold_ink(p: Position, col: Color, ch: Choice)
fold_ink(P_out, Col, Ch) :-
    in(P_grid, Col), !c.bg(Col),                    // ink cell
    decompose(P_grid, P_tile, P_intile, Ch),
    c.base(D), opposite(D, O), dist(P_tile, O, 0),  // far tile
    axis_of(D, A), flip_of(A, F),                   // fold axis flip
    apply(F, P_intile, P_out).

// --- Output ---

.decl out(p: Position, col: Color, c: Choice)
out(P, Col, Ch) :- base_ink(P, Col, Ch).
out(P, Col, Ch) :- fold_ink(P, Col, Ch).
out(P, Col, Ch) :-
    dec_choice(Ch), c.frame(P), c.bg(Col),
    !base_ink(P, _, Ch), !fold_ink(P, _, Ch).
