// 447fd412
// draft
// keywords: objects markers scale stamp
// input: a template object sits in the grid: a drawing in the ink color with
//  mark cells attached to it. Elsewhere, blocks of the mark color stand
//  alone, each a square.
// output: a placement sends one template mark to one block. Under it, each
//  step of one cell in the template is a step of K cells in the grid, where K
//  is that block's side, so every template cell covers a KxK box. The
//  placement holds when each template mark's box is a block. A holding
//  placement stamps the template into its boxes, clipped where a box runs off
//  the grid.
// review cite: principles.md Coverage cites this solver on approval.

// What a template cell carries into its box.
.type Carry =
    // the drawing alone, so the blocks stand as they are
    Ink {}
    // the template entire: a block is the scaled image of its mark, and the
    // stamp completes it
  | Whole {}

// Which cells of a covered box the stamp reaches.
.type Cover =
    // every cell of the box
    Box {}
    // the block's own cells: a box carries a cell only where the block does
  | Cells {}

.type Choice = [carry: Carry, cover: Cover]

// The two fields combine freely: what a template cell carries leaves open
// which cells of its box the stamp reaches.
.decl impl_choice(ch: Choice)
impl_choice([$Ink(), $Box()]).
impl_choice([$Ink(), $Cells()]).
impl_choice([$Whole(), $Box()]).
impl_choice([$Whole(), $Cells()]).

.comp Params {
    // The drawing's color.
    .decl ink(col: Color) ink(1).

    // The color of the marks and of the blocks.
    .decl mark(col: Color) mark(2).
}

.init params = Params

.decl ink_cell(p: Position)
ink_cell(P) :- in(P, Col), params.ink(Col).

// --- objects ---

.init obj = Components<Unit>
obj.node($U(), P) :- ink_cell(P).
obj.node($U(), P) :- in(P, Col), params.mark(Col).

.decl object(id: Ident, p: Position)
object(Id, P) :- obj.label($U(), P, Id).

// The template is the object the drawing belongs to; the blocks are the rest.
.decl template(id: Ident)
template(Id) :- object(Id, P), ink_cell(P).

.init block = Bbox<Ident>
block.cell(Id, P) :- object(Id, P), !template(Id).

.decl template_cell(p: Position, col: Color)
template_cell(P, Col) :- template(Id), object(Id, P), in(P, Col).

.decl template_mark(p: Position)
template_mark(P) :- template_cell(P, Col), params.mark(Col).

// --- placement ---

// Placement (T0, Id) sends template mark T0 to block Id. Under it, template
// cell P covers the box B.
.decl carry(t0: Position, id: Ident, p: Position, b: Box)
carry(T0, Id, T0, B) :- template_mark(T0), block.box(Id, B).
carry(T0, Id, P2, B2) :-
    carry(T0, Id, P, B),                                     // known correspondence
    dir_elem(D), neighbor(P, D, P2), template_cell(P2, _),   // one step along the template
    axis_elem(A), perp(A, A2),
    box_extent(B, P, A, K), box_extent(B, P, A2, K),         // K, the block's side
    jump(B, D, K, B2).                                       // K cells in the grid

// A placement that sends some template mark where no block stands.
.decl astray(t0: Position, id: Ident)
astray(T0, Id) :- carry(T0, Id, P, B), template_mark(P), !block.box(_, B).

// The box a template cell covers, under a placement that holds, with the
// block that placement seats on.
.decl covers(id: Ident, p: Position, b: Box)
covers(Id, P, B) :- carry(T0, Id, P, B), !astray(T0, Id).

// --- stamp ---

// The color template cell P carries into its box.
.decl carried(p: Position, col: Color, cr: Carry)

// Grid cell Q, in the box that template cell P covers.
.decl covered_cell(p: Position, q: Position, cv: Cover)

.decl stamped(p: Position, col: Color, ch: Choice)
stamped(Q, Col, [Cr, Cv]) :- covered_cell(P, Q, Cv), carried(P, Col, Cr).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- stamped(P, Col, Ch).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !stamped(P, _, Ch).

// --- $Ink, $Whole ---

carried(P, Col, $Ink())   :- template_cell(P, Col), params.ink(Col).
carried(P, Col, $Whole()) :- template_cell(P, Col).

// --- $Box, $Cells ---

// The block's cells in its own frame.
.decl block_shape(id: Ident, p_inner: Position)
block_shape(Id, P_inner) :- block.cell(Id, P), block.box(Id, B), crop(P, B, P_inner).

covered_cell(P, Q, $Box()) :- covers(_, P, B), in(Q, _), inside(Q, B).  // as far as the grid reaches
covered_cell(P, Q, $Cells()) :-
    covers(Id, P, B), in(Q, _), crop(Q, B, Q_inner),  // as far as the grid reaches
    block_shape(Id, Q_inner).                         // where the block carries a cell
