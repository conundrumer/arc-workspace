// 8abad3cf
// @draft
// @keywords: count rank color-class
// input: Each non-background color's cells number a perfect square.
// output: Each color's cells pack into a solid square, and the squares
//  stand in a row from params.pack_dir in ascending order of side, resting
//  on the edge a quarter turn away, with params.gap background lines
//  between them.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(7).

    .decl pack_dir(d: Dir) pack_dir(DIR_L).
    .decl rest_sense(s: Sense) rest_sense(SENSE_CC).

    .decl rest_dir(d: Dir)
    rest_dir(D_rest) :- pack_dir(D), rest_sense(S), turn(S, D, D_rest).

    // The background lines between neighboring squares.
    .decl gap(n: number) gap(1).
}

.init params = Params

// --- the squares ---

.init ink = Tally<Color, Position>
ink.item(Col, P_grid) :- in(P_grid, Col), !params.bg(Col).

// Candidate sides: every extent the input admits, along either axis.
.decl cand_side(k: number)
cand_side(K) :-
    in(P_grid, _), axis_elem(A),
    ( sub_extent(P_grid, A, K) ; axis_dim(P_grid, A, K) ).

.init square = Frame2D<number>
square.extent(K, A, K) :- cand_side(K), axis_elem(A).

.init area = Tally<number, Position>
area.item(K, P) :- square.cell(K, P).

// A color's square holds as many cells as the color has.
.decl side(col: Color, k: number)
side(Col, K) :- ink.tally(Col, N), area.tally(K, N).

.decl square_cell(col: Color, p_inner: Position)
square_cell(Col, P_inner) :- side(Col, K), square.cell(K, P_inner).

// --- the row ---

.init row = Order<Unit, Color>
row.elem($U(), Col) :- side(Col, _).
row.score($U(), Col, K) :- side(Col, K).  // the smaller side comes first

// --- the places ---

// A square seen from an edge of the row's axis.
.type Side = [d: Dir, col: Color]

// A line of the row that a square or the gap after it takes.
.type Line = [col: Color, p: Position]

// The lines a square and the gap after it take along the row: its side and
// the gap.
.init span = AxisFrame<Color>
span.extent(Col, A, N) :-
    side(Col, K), params.pack_dir(D), axis_of(D, A),
    edge_inset(D, K, B_side), params.gap(G), edge_inset(D, G, B_gap),
    compose(B_side, B_gap, B), dist(B, D, N).

// The lines between a square and edge d: those of every square outward of
// it, each with its gap.
.init lead = Tally<Side, Line>
lead.item([D, Col], [Col2, P]) :-
    params.pack_dir(D0), span.cell(Col2, _, P),               // a line of square col2
    row.rank($U(), Col2, R2), row.rank($U(), Col, R),         // places in the row
    ( D = D0, R2 < R                                          // outward toward the pack edge
    ; opposite(D0, D), R < R2 ).                              // outward toward the far edge
lead.domain([D, Col]) :- side(Col, _), params.pack_dir(D0), axis_of(D0, A), axis_of(D, A).

// A square's box measured from an edge of the row's axis: inset by the
// lines between it and that edge.
.decl edge_box(d: Dir, col: Color, b: Box)
edge_box(D, Col, B) :- lead.tally([D, Col], N), edge_inset(D, N, B).

// The square's place in the row: its box at both edges of the row's axis.
.decl row_box(col: Color, b: Box)
row_box(Col, B) :-
    opposite(D, D2), edge_box(D, Col, B1), edge_box(D2, Col, B2),
    compose(B1, B2, B).

// The output's lines across the row: those of the tallest square, counted
// from the rest edge.
.init rows = DirFrame<Unit>
rows.dir(D) :- params.rest_dir(D).
rows.dist_set($U(), J) :- square_cell(_, P_inner), params.rest_dir(D), dist(P_inner, D, J).

.decl paint(p: Position, col: Color)
paint(P_grid, Col) :-
    square_cell(Col, P_inner),
    params.rest_dir(D_rest), dist(P_inner, D_rest, J), rows.pos($U(), J, P_line),  // its line across the row
    params.pack_dir(D), axis_of(D, A), split(P_inner, A, P_along, _),              // its place along the square
    row_box(Col, B), compose(B, P_along, P_place),                                 // that place in the row
    compose(P_line, P_place, P_grid).

.init canvas = Frame2D<Unit>
canvas.extent($U(), A, N) :- paint(P_grid, _), axis_elem(A), axis_dim(P_grid, A, N).

out(P_grid, Col) :-
    canvas.cell($U(), P_grid),
    ( paint(P_grid, Col)                    // a square's cell
    ; !paint(P_grid, _), params.bg(Col)     // the rest
    ).

.comp Determine {
    .decl reaches(e: Example, col: Color, d: Dir)
    reaches(E, Col, D) :- ex_out(E, P_grid, Col), dir_elem(D), dist(P_grid, D, 0).

    // A square that stops short of edge d.
    .decl short_of(e: Example, d: Dir)
    short_of(E, D) :- ex_out(E, _, Col), !params.bg(Col), dir_elem(D), !reaches(E, Col, D).

    // The squares rest on the edge every one of them reaches.
    .decl rest_sense(s: Sense)
    rest_sense(S) :- params.pack_dir(D), turn(S, D, D_rest), !short_of(_, D_rest).
}
