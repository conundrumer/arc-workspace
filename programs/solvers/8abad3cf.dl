// 8abad3cf
// draft
// concept: count rank
// Each non-background color's cells number a perfect square. The output
// packs each color into a solid square of that many cells, and lays the
// squares in a row from params.pack_dir, resting on the edge a quarter turn
// away, with params.gap background lines between them.
//
// The cases claim what orders the squares in the row:
//   $BySide()  — ascending in side.
//   $ByPlace() — the reverse of the order the colors first appear in, read
//                from params.corner along params.order_axis.

#include "../lib.dl"

.type Choice = BySide {} | ByPlace {}

.comp Params {
    // --- shared ---
    .decl bg(col: Color) bg(7).

    // The row starts at pack_dir; the squares rest on the edge a quarter
    // turn away.
    .decl pack_dir(d: Dir) pack_dir(DIR_L).
    .decl rest_sense(s: Sense) rest_sense(SENSE_CC).

    .decl rest_dir(d: Dir)
    rest_dir(D_rest) :- pack_dir(D), rest_sense(S), turn(S, D, D_rest).

    // The background lines between neighboring squares.
    .decl gap(n: number) gap(1).

    // --- ByPlace ---
    .decl corner(d: DiagDir) corner(DIAG_TL).
    .decl order_axis(a: Axis) order_axis(AXIS_V).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($BySide()). impl_choice($ByPlace()).

// --- the squares ---

.init ink = Tally<Color, Position>
ink.item(Col, P_grid) :- in(P_grid, Col), !params.bg(Col).

// Candidate sides: every extent the input admits, along either axis.
.decl cand_side(k: number)
cand_side(K) :-
    in(P_grid, _), axis_elem(A),
    ( sub_extent(P_grid, A, K) ; axis_dim(P_grid, A, K) ).

.init square = Frame2D<number>
square.extent(K, A, K) :- cand_side(K), axis_elem(A).

.init area = Tally<number, Position>
area.item(K, P) :- square.cell(K, P).

// A color's square holds as many cells as the color has.
.decl side(col: Color, k: number)
side(Col, K) :- ink.tally(Col, N), area.tally(K, N).

.decl square_cell(col: Color, p_inner: Position)
square_cell(Col, P_inner) :- side(Col, K), square.cell(K, P_inner).

// --- the row ---

.init row = Order<Choice, Color>
row.elem(Ch, Col) :- impl_choice(Ch), side(Col, _).

// --- BySide ---
row.before($BySide(), Col, Col2) :- side(Col, K), side(Col2, K2), K < K2.

// --- ByPlace ---
.init reading = LexOrder<Unit>
reading.cell($U(), P_grid) :- ink.item(_, P_grid).
reading.corner($U(), D) :- params.corner(D).
reading.axis($U(), A) :- params.order_axis(A).

// Where a color first appears.
.init debut = Extremes<Color>
debut.cand(Col, R) :- ink.item(Col, P_grid), reading.rank($U(), P_grid, R).

row.before($ByPlace(), Col, Col2) :- debut.low(Col, R), debut.low(Col2, R2), R2 < R.

// --- the offsets ---

// The row read from either edge of its axis: the square one place inward
// of another.
.decl inward(ch: Choice, d: Dir, col: Color, col2: Color)
inward(Ch, D, Col, Col2) :- params.pack_dir(D), row.next(Ch, Col, Col2).
inward(Ch, D2, Col2, Col) :- params.pack_dir(D), opposite(D, D2), row.next(Ch, Col, Col2).

// A square's offset from an edge of the row's axis: zero for the square at
// the edge, and one square's side and one gap past the square outward of it.
.decl edge_off(ch: Choice, d: Dir, col: Color, off: Inset)
edge_off(Ch, D, Col, ZERO) :- params.pack_dir(D), row.first(Ch, Col).
edge_off(Ch, D2, Col, ZERO) :- params.pack_dir(D), opposite(D, D2), row.last(Ch, Col).
edge_off(Ch, D, Col2, Off2) :-
    edge_off(Ch, D, Col, Off), inward(Ch, D, Col, Col2),            // the offset so far
    side(Col, K), edge_delta(D, K, Dk), compose(Off, Dk, Off1),     // past the outward square
    params.gap(G), edge_delta(D, G, Dg), compose(Off1, Dg, Off2).   // and the gap

// The offset at both edges of the row's axis.
.decl row_off(ch: Choice, col: Color, off: Inset)
row_off(Ch, Col, Off) :-
    opposite(D, D2), edge_off(Ch, D, Col, Off1), edge_off(Ch, D2, Col, Off2),
    compose(Off1, Off2, Off).

// The output's lines across the row: those of the tallest square, counted
// from the rest edge.
.init rows = DirFrame<Unit>
rows.dir(D) :- params.rest_dir(D).
rows.dist_set($U(), J) :- square_cell(_, P_inner), params.rest_dir(D), dist(P_inner, D, J).

.decl paint(ch: Choice, p: Position, col: Color)
paint(Ch, P_grid, Col) :-
    square_cell(Col, P_inner),
    params.rest_dir(D_rest), dist(P_inner, D_rest, J), rows.pos($U(), J, P_v),   // its line across the row
    params.pack_dir(D), axis_of(D, A), split(P_inner, A, P_along, _),             // its place along the row
    row_off(Ch, Col, Off), compose(Off, P_along, P_h),
    compose(P_v, P_h, P_grid).

.init canvas = Frame2D<Choice>
canvas.extent(Ch, A, N) :- paint(Ch, P_grid, _), axis_elem(A), axis_dim(P_grid, A, N).

.decl out(p: Position, col: Color, ch: Choice)
out(P_grid, Col, Ch) :-
    canvas.cell(Ch, P_grid),
    ( paint(Ch, P_grid, Col)                    // a square's cell
    ; !paint(Ch, P_grid, _), params.bg(Col)     // the rest
    ).

.comp Determine {
    .decl reaches(e: Example, col: Color, d: Dir)
    reaches(E, Col, D) :- ex_out(E, P_grid, Col), dir_elem(D), dist(P_grid, D, 0).

    // A square that stops short of edge d.
    .decl short_of(e: Example, d: Dir)
    short_of(E, D) :- ex_out(E, _, Col), !params.bg(Col), dir_elem(D), !reaches(E, Col, D).

    // The squares rest on the edge every one of them reaches.
    .decl rest_sense(s: Sense)
    rest_sense(S) :- params.pack_dir(D), turn(S, D, D_rest), !short_of(_, D_rest).
}
