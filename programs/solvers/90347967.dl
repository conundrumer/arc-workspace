// 90347967
// concept: markers d4
// The grid re-seats transformed by params.transform about its params.marker cell;
// uncovered cells are bg. Seating the grid equals seating the ink object:
// transforms are injective, so bg images land clear of the object's.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(5).
    .decl transform(d: D4) transform(D4_HT).
}

.init params = Params

.decl moved(p: Position, col: Color)
moved(P_out, Col) :-
    in(M, C), params.marker(C),                  // the marker cell
    in(P, Col), relative(M, P, V),               // a cell's offset from the marker
    params.transform(D), apply(D, V, V2),
    compose(M, V2, P_out).                       // seated back at the marker

.decl out(p: Position, col: Color)
out(P, Col) :-
    in(P, _),                               // grid cell
    ( moved(P, Col)                         // content lands here
    ; !moved(P, _), params.bg(Col)          // nothing lands — bg
    ).
