// 90347967
// concept: markers d4
// An ink object contains one c.marker cell. The object re-seats transformed
// by c.transform about the marker; all other cells are bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).
    .decl marker(c: Color) marker(5).
    .decl transform(d: D4) transform(D4_HT).
}

.init c = Consts

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !c.bg(Col).

.decl mark(p: Position)
mark(P) :- ink(P, Col), c.marker(Col).

// Each ink cell viewed from the marker, keyed by the cell.
.init markframe = Reframe<Position>
markframe.outer(P, M) :- ink(P, _), mark(M).
markframe.cell(P, P)  :- ink(P, _).

.decl moved(p: Position, col: Color)
moved(P_out, Col) :-
    ink(P, Col), markframe.inner(P, I),       // cell in the marker frame
    c.transform(D), apply(D, I, I2),          // transformed offset
    mark(M), compose(M, I2, P_out).           // seated back at the marker

.decl out(p: Position, col: Color)
out(P, Col) :- in(P, _), moved(P, Col).
out(P, Col) :- in(P, _), !moved(P, _), c.bg(Col).
