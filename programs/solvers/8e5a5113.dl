// 8e5a5113
// concept: tile-arrangement decompose lookup d4 walk
// Three full-height tiles split by separator columns; the pattern tile's
// successive quarter-turn images fill the empty tiles. Flip parses are
// defeated (train 1: the second tile matches no reflection of its pattern).
//
// Cases (data-equivalent on this task):
//   $StepCount() — tiles by count; each tile toward params.flow_dir carries its
//                  neighbor's params.rot image
//   $StepSize()  — the same walk, over tiles by size
//   $Lookup()    — per-tile D4 table applied to the pattern content

#include "../lib.dl"

.type Choice = StepCount {} | StepSize {} | Lookup {}

.comp Params {
    // --- shared ---
    .decl bg(c: Color)
    bg(0).

    .decl axis(a: Axis)
    axis(AXIS_H).

    .decl gap(g: number)
    gap(1).

    // --- StepCount, Lookup ---
    .decl tile_n(n: number)
    tile_n(3).

    // --- StepSize ---
    .decl tile_size(k: number)
    tile_size(3).

    // --- StepCount, StepSize ---
    .decl flow_dir(d: Dir)
    flow_dir(DIR_R).

    .decl rot(d: D4)
    rot(D4_CW).

    // --- Lookup ---
    .decl tile_d4(p: Position, d: D4)
    GRID_1x3(tile_d4, D4_ID, D4_CW, D4_HT)
}

.init params = Params

// The tile arrangement the separators cut, in both readings of the split.
.comp Parse<Key> {
    .decl cell(key: Key, p: Position)  // input

    // Tiles counted off the extent.
    .decl tile(key: Key, p_grid: Position, p_tile: Position, p_intile: Position)
    tile(K, P_grid, P_tile, P_intile) :-
        cell(K, P_grid),
        params.axis(A), params.tile_n(N), params.gap(G),                    // arrangement params
        divide_slab(P_grid, A, N, G, P_tile, P_intile).

    // Tiles of a stored size.
    .decl size_tile(key: Key, p_grid: Position, p_tile: Position, p_intile: Position)
    size_tile(K, P_grid, P_tile, P_intile) :-
        cell(K, P_grid),
        params.axis(A), params.tile_size(Sz), params.gap(G),                // arrangement params
        divide_by_size_slab(P_grid, A, Sz, G, P_tile, P_intile).
}

.init parse = Parse<Unit>
parse.cell($U(), P) :- in(P, _).

.decl impl_choice(ch: Choice)
impl_choice($StepCount()). impl_choice($StepSize()). impl_choice($Lookup()).

// The cases that read the tile count, and the cases that walk the flow.
.decl by_count(ch: Choice)
by_count($StepCount()). by_count($Lookup()).

.decl by_step(ch: Choice)
by_step($StepCount()). by_step($StepSize()).

.decl tile_cell(p_grid: Position, p_tile: Position, p_intile: Position, c: Choice)
tile_cell(P_grid, P_tile, P_intile, C) :-
    by_count(C), parse.tile($U(), P_grid, P_tile, P_intile).
tile_cell(P_grid, P_tile, P_intile, $StepSize()) :-
    parse.size_tile($U(), P_grid, P_tile, P_intile).

.decl src(p_tile: Position, p_intile: Position, col: Color, c: Choice)
src(P_tile, P_intile, Col, C) :-
    tile_cell(P_grid, P_tile, P_intile, C), in(P_grid, Col), !params.bg(Col).

.decl out(p: Position, col: Color, c: Choice)

// Separator passthrough — cells the divide leaves undecomposed.
out(P, Col, C) :- in(P, Col), impl_choice(C), !tile_cell(P, _, _, C).

// --- StepCount, StepSize ---
// The pattern seeds its own tile; each neighbor toward flow_dir carries
// the rotated image.
.decl content(p_tile: Position, p_intile: Position, col: Color, c: Choice)
content(T, P, Col, C) :- by_step(C), src(T, P, Col, C).
content(T2, P2, Col, C) :-
    content(T1, P1, Col, C),                          // known tile
    params.flow_dir(D), neighbor(T1, D, T2),
    tile_cell(_, T2, _, C),                           // stays in the arrangement
    params.rot(R), apply(R, P1, P2).                  // rotated image

out(P_grid, Col, C) :- content(T, P_intile, Col, C), tile_cell(P_grid, T, P_intile, C).

// --- Lookup ---
out(P_grid, Col, $Lookup()) :-
    src(_, P_src, Col, $Lookup()),                            // pattern cell
    params.tile_d4(P_tile, D), apply(D, P_src, P_intile),     // d4 image at tile
    tile_cell(P_grid, P_tile, P_intile, $Lookup()).           // recompose

.comp Determine {
    .init in_parse = Parse<Example>
    in_parse.cell(E, P) :- ex_in(E, P, _).

    .init out_parse = Parse<Example>
    out_parse.cell(E, P) :- ex_out(E, P, _).

    // The pattern: an input tile's non-bg content.
    .decl src(e: Example, p_intile: Position, col: Color)
    src(E, P_intile, Col) :-
        ex_in(E, P_grid, Col), !params.bg(Col), in_parse.tile(E, P_grid, _, P_intile).

    .decl out_cell(e: Example, p_tile: Position, p_intile: Position, col: Color)
    out_cell(E, P_tile, P_intile, Col) :-
        ex_out(E, P_grid, Col), out_parse.tile(E, P_grid, P_tile, P_intile).

    .type TileK = [e: Example, p_tile: Position]

    // The pattern must map onto each tile's content.
    .init lookup = D4Map<TileK, Color>
    lookup.src([E, P_tile], P_src, Col) :- src(E, P_src, Col), out_cell(E, P_tile, _, _).
    lookup.dst([E, P_tile], P, Col)     :- out_cell(E, P_tile, P, Col).

    .decl broken(p_tile: Position, d: D4)
    broken(P_tile, D) :- lookup.mismatch([E, P_tile], D), out_cell(E, P_tile, _, _).

    .decl tile_d4(p: Position, d: D4)
    tile_d4(P_tile, D) :- out_cell(_, P_tile, _, _), d4_elem(D), !broken(P_tile, D).

    // Tiles paired with their neighbor toward the flow.
    .decl flow_pair(e: Example, t1: Position, t2: Position)
    flow_pair(E, T1, T2) :-
        out_cell(E, T1, _, _), params.flow_dir(D), neighbor(T1, D, T2), out_cell(E, T2, _, _).

    // Each tile's content must map onto its flow-neighbor's.
    .init step = D4Map<TileK, Color>
    step.src([E, T1], P, Col) :- flow_pair(E, T1, _), out_cell(E, T1, P, Col).
    step.dst([E, T1], P, Col) :- flow_pair(E, T1, T2), out_cell(E, T2, P, Col).

    .decl step_broken(d: D4)
    step_broken(R) :- step.mismatch([E, T], R), out_cell(E, T, _, _).

    .decl rot(d: D4)
    rot(R) :- out_cell(_, _, _, _), d4_elem(R), !step_broken(R).

    // The tile's extent along the split axis.
    .decl tile_size(k: number)
    tile_size(Sz) :-
        in_parse.tile(_, _, _, P_intile), params.axis(A), axis_dim(P_intile, A, Sz).
}
