// 0e671a1a
// keywords: markers span
// input: Marks, each named by its color.
// output: The marks are joined into a chain. A leg turns once, at the elbow
//  standing with the destination along params.axis and with the source across
//  it, and its two straight halves are drawn in params.path over background.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl path(col: Color) path(5).

    // The chain, leg by leg: the source mark's color, then the destination's.
    .decl leg(src: Color, dst: Color)
        leg(3, 4). leg(4, 2).

    // The axis the half leaving the source runs along.
    .decl axis(a: Axis) axis(AXIS_V).
}

.init params = Params

// A leg, by the colors of the marks it joins.
.type Leg = [src: Color, dst: Color]

.comp Parse<Key> {
    .decl cell(k: Key, p: Position, col: Color)

    // Marks, named by color.
    .decl mark(k: Key, col: Color, p: Position)
    mark(K, Col, P) :- cell(K, P, Col), !params.bg(Col).

    // The elbow of an ordered mark pair: standing with the destination along
    // params.axis and with the source across it.
    .decl elbow(k: Key, src: Color, dst: Color, p: Position)
    elbow(K, S, D, P_elbow) :-
        mark(K, S, P_src), mark(K, D, P_dst), S != D,  // an ordered pair of marks
        params.axis(A), split(P_dst, A, Along, _),     // along the axis, the destination's place
        split(P_src, A, _, Across),                    // across it, the source's
        compose(Along, Across, P_elbow).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

// Each half of a leg spans two of its three points: source to elbow down one
// line, elbow to destination along the other. The domain is background only,
// so every mark keeps its own color.
.init span = Between<Leg>
span.axis([S, D], A) :- params.leg(S, D), axis_elem(A).
span.cell([S, D], P) :- params.leg(S, D), in(P, Col), params.bg(Col).
span.mark([S, D], P) :-
    params.leg(S, D),
    ( parse.mark($U(), S, P)          // the source mark
    ; parse.mark($U(), D, P)          // the destination mark
    ; parse.elbow($U(), S, D, P) ).   // the elbow between them

out(P, Col) :- span.between(_, P), params.path(Col).
out(P, Col) :- in(P, Col), !span.between(_, P).

.comp Determine {
    // Train pairs only — the ex_out atom holds the test inputs out.
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    // A leg's elbow is drawn in every pair: keep the ordered mark pairs no
    // example refutes.
    .decl refuted(src: Color, dst: Color)
    refuted(S, D) :- parse.elbow(E, S, D, P), ex_out(E, P, Col), !params.path(Col).

    .decl leg(src: Color, dst: Color)
    leg(S, D) :- parse.elbow(_, S, D, _), !refuted(S, D).
}
