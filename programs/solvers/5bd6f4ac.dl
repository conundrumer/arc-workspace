// Output is a sub-frame anchored at c.diag. Input cells project into the
// sub-frame by matching distances to the two corner edges.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl diag(d: DiagDir)
    diag(TOP_RIGHT).

    .decl frame(p: Position)
    frame(P) :- helpers.frame_pos([3, 3], P).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    in(P_grid_in, Col),                          // input cell
    c.frame(P_grid_out),                         // output position
    c.diag(D), corner_anchor(D, P_grid_out, P_grid_in).  // corner-anchor match

.output out(IO=stdout)
