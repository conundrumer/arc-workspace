// 5bd6f4ac
// concept: decompose crop select
// Output is the 3×3 block at corner params.diag of a noise grid. The 9×9 inputs
// leave the locate rule underdetermined:
//
//   $Corner() — a params.window block seated at the corner
//   $Count()  — grid divided into a params.divisor arrangement; the corner tile
//   $Block()  — grid tiled by params.tile_dim blocks; the corner block

#include "../lib.dl"

.type Choice = Corner {} | Count {} | Block {}

.comp Params {
    .init helpers = ParamsHelpers

    // --- shared ---
    .decl diag(d: DiagDir)
    diag(DIAG_TR).

    // --- Corner ---
    .decl window_dim(k: number) window_dim(3).
    .decl window(p: Position)
    window(P) :- window_dim(K), helpers.frame_pos([K, K], P).

    // --- Count ---
    .decl divisor(n: number) divisor(3).

    // --- Block ---
    .decl tile_dim(k: number) tile_dim(3).
}

.init params = Params

.decl out(p: Position, col: Color, c: Choice)

// --- Corner ---
out(P_out, Col, $Corner()) :-
    in(P_in, Col),                                     // input cell
    params.window(P_out),                              // output position
    params.diag(D), corner_anchor(D, P_out, P_in).     // corner-anchor match

// --- Count ---
out(P_intile, Col, $Count()) :-
    in(P_in, Col),                                                     // input cell
    params.divisor(N), divide_2d(P_in, N, 0, P_tile, P_intile),        // arrangement
    params.diag(D), corner_anchor(D, P_tile, ZERO).                  // corner tile

// --- Block ---
out(P_intile, Col, $Block()) :-
    in(P_in, Col),                                                             // input cell
    params.tile_dim(K), divide_by_size_2d(P_in, K, 0, P_tile, P_intile),       // tiling
    params.diag(D), corner_anchor(D, P_tile, ZERO).                          // corner block
