// 5bd6f4ac
// concept: decompose crop select
// Output is the 3×3 block at corner c.diag of a noise grid. The 9×9 inputs
// leave the locate rule underdetermined:
//
//   $Corner() — a c.window block seated at the corner
//   $Div()    — grid divided into a c.divisor arrangement; the corner tile
//   $Block()  — grid tiled by c.tile_dim blocks; the corner block

#include "../lib.dl"

.type Choice = Corner {} | Div {} | Block {}

.comp Consts {
    .init helpers = ConstsHelpers

    // --- shared ---
    .decl diag(d: DiagDir)
    diag(DIAG_TR).

    // --- Corner ---
    .decl window_dim(k: number) window_dim(3).
    .decl window(p: Position)
    window(P) :- window_dim(K), helpers.frame_pos([K, K], P).

    // --- Div ---
    .decl divisor(n: number) divisor(3).

    // --- Block ---
    .decl tile_dim(k: number) tile_dim(3).
}

.init c = Consts

.decl out(p: Position, col: Color, c: Choice)

// --- Corner ---
out(P_out, Col, $Corner()) :-
    in(P_in, Col),                                // input cell
    c.window(P_out),                              // output position
    c.diag(D), corner_anchor(D, P_out, P_in).     // corner-anchor match

// --- Div ---
out(P_intile, Col, $Div()) :-
    in(P_in, Col),                                                // input cell
    c.divisor(N), divide_2d(P_in, N, 0, P_tile, P_intile),        // arrangement
    c.diag(D), corner_anchor(D, P_tile, ORIGIN).                  // corner tile

// --- Block ---
out(P_intile, Col, $Block()) :-
    in(P_in, Col),                                                        // input cell
    c.tile_dim(K), divide_by_size_2d(P_in, K, 0, P_tile, P_intile),       // tiling
    c.diag(D), corner_anchor(D, P_tile, ORIGIN).                          // corner block
