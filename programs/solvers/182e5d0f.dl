// 182e5d0f
// draft
// keywords: objects markers move
// input: Wire runs across the grid, ending in a plug — a wire cell flanked
//  along an axis by two caps. The rest of the wire is cord.
// output: A bead beside a cord slides its whole length and comes to rest on
//  the cord cell against the plug; the cord it travelled and the seat it left
//  go to background. A cord no bead touches, and a bead beside no cord, stay
//  as they are.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(7).

    .decl wire(col: Color) wire(3).

    .decl cap(col: Color) cap(0).

    .decl bead(col: Color) bead(5).
}

.init params = Params

.decl plug(p: Position)
plug(P) :-
    in(P, Col_w), params.wire(Col_w),                      // a wire cell
    opposite(D, D2),                                       // the two dirs of an axis
    neighbor(P, D, Q), in(Q, Col_c), params.cap(Col_c),    // capped on one side
    neighbor(P, D2, Q2), in(Q2, Col_c).                    // and on the other

.decl cord(p: Position)
cord(P) :- in(P, Col), params.wire(Col), !plug(P).

.decl entry(p_seat: Position, p_cord: Position)
entry(P, Q) :-
    in(P, Col), params.bead(Col),               // a bead
    dir_elem(D), neighbor(P, D, Q), cord(Q).    // beside a cord cell

// The cords a bead travels.
.init cord_run = Reach<Unit>
cord_run.node($U(), P) :- cord(P).
cord_run.seed($U(), P) :- entry(_, P).

// Cleared as the bead slides: the cord it covers, and the seat it left.
.decl consumed(p: Position)
consumed(P) :- cord_run.reach($U(), P).
consumed(P) :- entry(P, _).

.decl landing(p: Position)
landing(P) :- plug(P0), dir_elem(D), neighbor(P0, D, P), cord_run.reach($U(), P).

out(P, Col) :-
    in(P, Col_in),
    ( landing(P), params.bead(Col)                  // the bead's new seat
    ; consumed(P), !landing(P), params.bg(Col)      // cleared behind it
    ; !consumed(P), Col = Col_in                    // untouched
    ).
