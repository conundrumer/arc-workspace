// ac0a08a4
// @keywords: scale count
// output: Layout: N× scale. Each input cell expands to an N×N block of the same
//  color in the output frame. N is counted from the input's non-bg cells.

// how N is counted
.type Choice =
    // N is the count of non-bg cells
    Cells {}
    // N is the count of distinct non-bg colors
  | Colors {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.decl on(p: Position, col: Color)
on(P, Col) :- in(P, Col), !params.bg(Col).

.init block = Frame2D<Choice>

// --- $Cells ---
.init cell_count = Tally<Unit, Position>
cell_count.item($U(), P) :- on(P, _).

block.extent($Cells(), A, N) :- axis_elem(A), cell_count.tally($U(), N).

// --- $Colors ---
.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- on(_, Col).

block.extent($Colors(), A, N) :- axis_elem(A), palette.tally($U(), N).

out(P_grid_out, Col, Ch) :-
    in(P_tile, Col),                                  // input cell as tile pos
    block.cell(Ch, P_intile),                         // intile pos (N×N frame)
    concat_2d(P_tile, P_intile, 0, P_grid_out).       // 2D recompose
