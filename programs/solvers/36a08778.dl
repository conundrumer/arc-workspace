// 36a08778
// @draft
// @keywords: markers cast walk span flood
// input: Water sits as a two-cell stub on an edge.
// output: The stub pours into the grid. The pour runs on until a block bars
//  the way; there it passes the block's end and pours on. Every cell the
//  water reaches turns the water color, and nothing else changes.

// how the water passes a barring block
.type Flow =
    // a cell at a time across the block's top; a block in the way stops it
    Step {}
    // the struck block's whole top, one cell past each end, turns to water at
    // once
  | Shell {}

// where the pour direction comes from
.type Seat =
    // params.fall names it
    Dir {}
    // the stub's own line, away from the edge it sits on
  | Stub {}

// how the water passes a block, and where its direction comes from
.type Choice = [flow: Flow, seat: Seat]
.type Pour = [p: Position, d: Dir]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl water(col: Color) water(6).
    .decl block(col: Color) block(2).

    // --- $Dir ---
    .decl fall(d: Dir) fall(DIR_B).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice([$Step(), $Dir()]).  impl_choice([$Step(), $Stub()]).
impl_choice([$Shell(), $Dir()]). impl_choice([$Shell(), $Stub()]).

// --- shared ---

.decl source(p: Position)
source(P) :- in(P, Col), params.water(Col).

.decl block(p: Position)
block(P) :- in(P, Col), params.block(Col).

.init stub = Components<Unit>
stub.node($U(), P) :- source(P).

.decl stub_flow(id: Ident, d: Dir)
stub_flow(Id, D) :-
    stub.label($U(), P, Id), opposite(D, E), dist(P, E, 0),  // a stub cell on edge E
    neighbor(P, D, Q), source(Q).                            // the stub runs on from it

// Every stub in this data is a vertical pair on the top edge, so $Dir and
// $Stub agree on the pour direction.
.decl pour(s: Seat, p: Position, d: Dir)
pour($Dir(), P, D)  :- source(P), params.fall(D).
pour($Stub(), P, D) :- stub.label($U(), P, Id), stub_flow(Id, D).

// The course water poured at a cell toward a direction takes: a cast toward
// that direction, halted by a block. Keyed by direction.
.init stream = Ray<Dir>
stream.dir(D, D)     :- dir_elem(D).
stream.cell(D, P)    :- dir_elem(D), in(P, _).
stream.blocked(D, P) :- dir_elem(D), block(P).
stream.mark(D, P)    :- dir_elem(D), in(P, _), !block(P).

// Block B halts the pour from M toward d at cell P.
.decl barred(m: Position, d: Dir, p: Position, b: Position)
barred(M, D, P, B) :-
    stream.clear(D, P, D, _, M), neighbor(P, D, B), stream.stop(D, B, D, _, M).

// The pour from M toward d, once barred, pours on from Q under flow f.
.decl pour_on(f: Flow, m: Position, d: Dir, q: Position)

// The pours the water makes: the stub's pours, and each pour on from a
// barred one.
.init flow = Propagation<Choice, Pour>
flow.source([F, S], [P, D]) :- impl_choice([F, S]), pour(S, P, D).
flow.edge([F, S], [M, D], [Q, D]) :- impl_choice([F, S]), pour_on(F, M, D, Q).

// The cells the water reaches, and the direction it travels there.
.decl wet(ch: Choice, d: Dir, p: Position)
wet(Ch, D, P) :- flow.reached(Ch, [M, D]), stream.clear(D, P, D, _, M).

// --- $Step ---

// A cell to each side, across the flow, pours on.
pour_on($Step(), M, D, Q) :-
    barred(M, D, P, _),
    perp_dir(D, D2), neighbor(P, D2, Q), in(Q, _), !block(Q).

// --- $Shell ---

// A block's maximal run along an axis: a cast over block cells that any
// other cell halts.
.init run = Ray<Axis>
run.dir(A, D)     :- axis_of(D, A).
run.cell(A, P)    :- axis_elem(A), block(P).
run.mark(A, P)    :- axis_elem(A), block(P).
run.blocked(A, P) :- axis_elem(A), in(P, _), !block(P).

.decl span(a: Axis, b: Position, p: Position)
span(A, B, P) :- run.clear(A, P, _, _, B).   // the run through B
span(A, B, P) :- run.stop(A, P, _, _, B).    // the free cell past each end

// The shell block B raises against a pour toward d: the span, one step back.
.decl shell(d: Dir, b: Position, p: Position)
shell(D, B, P) :-
    axis_of(D, A0), perp(A0, A), span(A, B, Q),   // across the flow
    opposite(D, D_back), neighbor(Q, D_back, P),  // one step back
    in(P, _), !block(P).

// Where a block stands on another's shell row (test 1), the water past it
// arrives by another pour, so $Step and $Shell agree there too.
pour_on($Shell(), M, D, Q) :- barred(M, D, _, B), shell(D, B, Q).

// --- output ---

out(P, Col, Ch) :- wet(Ch, _, P), params.water(Col).
out(P, Col, Ch) :- in(P, Col), impl_choice(Ch), !wet(Ch, _, P).
