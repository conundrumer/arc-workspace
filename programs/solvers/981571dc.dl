// 981571dc
// concept: symmetry repair
// A symmetric wallpaper corrupted by noise patches; each noise cell
// restores from a symmetric counterpart. The wallpaper's symmetry center
// is offset from the grid center; its stabilizer is full D4.

#include "../lib.dl"

.comp Consts {
    .decl noise(col: Color) noise(0).

    // Wallpaper symmetry center, as its offset from the grid center.
    .decl center(a: Shift) center([1, -1, 1, -1]).

    .decl sym(d: D4)
    sym(D4_ID). sym(D4_CW). sym(D4_HT). sym(D4_CC).
    sym(D4_LR). sym(D4_TB). sym(D4_DG). sym(D4_AD).
}

.init c = Consts

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !c.noise(Col).

// Grid cells viewed from the wallpaper center.
.init view = Reframe<Position>
view.outer(P, A) :- in(P, _), c.center(A).
view.cell(P, P)  :- in(P, _).

// Symmetric counterpart: cells whose center-frame views are apply-related.
.decl counterpart(p: Position, q: Position)
counterpart(P, Q) :- view.inner(P, P0), c.sym(D), apply(D, P0, Q0), view.inner(Q, Q0).

.decl out(p: Position, col: Color)
out(P, Col) :- clean(P, Col).
out(P, Col) :-
    in(P, N), c.noise(N),            // corrupted cell
    counterpart(P, Q), clean(Q, Col).

// --- fit ---

.type CellKey = [e: Example, p: Position]

.comp Fit {
    // Candidate mirror lines on one axis, as offsets from the grid center.
    .decl cand(a: Axis, delta: Shift)
    cand(A, Delta) :-
        ex_out(_, P, _),
        axis_of(D, A), sub_extent(P, A, K),   // each axis, each distance
        jump_delta(D, K, Delta).

    // Where a candidate's mirror carries each cell: the grid-center flip of
    // the axis, then twice the candidate's offset.
    .decl mirrored(e: Example, a: Axis, delta: Shift, p: Position, q: Position)
    mirrored(E, A, Delta, P, Q) :-
        ex_out(E, P, _), cand(A, Delta),
        flip_of(A, D), apply(D, P, P1),
        compose(Delta, Delta, Twice), compose(P1, Twice, Q).

    // A candidate whose mirror carries some cell onto a different color.
    .decl mirror_mismatch(a: Axis, delta: Shift)
    mirror_mismatch(A, Delta) :-
        mirrored(E, A, Delta, P, Q),
        ex_out(E, P, Col), ex_out(E, Q, C2), C2 != Col.

    // The axis's mirror line: unbroken, and mirroring some cell onto another
    // — an offset past the frame pairs nothing and would pass unbroken.
    .decl axis_center(a: Axis, delta: Shift)
    axis_center(A, Delta) :-
        mirrored(E, A, Delta, _, Q), ex_out(E, Q, _),
        !mirror_mismatch(A, Delta).

    // The symmetry center: the mirror line of each axis, crossed.
    .decl center(a: Shift)
    center(A) :-
        perp(A1, A2),
        axis_center(A1, D1), axis_center(A2, D2), compose(D1, D2, A).

    // Restored cells viewed from the center.
    .init view = Reframe<CellKey>
    view.outer([E, P], A) :- ex_out(E, P, _), center(A).
    view.cell([E, P], P)  :- ex_out(E, P, _).

    // Self-symmetry of each restored grid, read in the center frame.
    .init inv = D4Map<Example, Color>
    inv.src(E, P0, Col) :- view.inner([E, P], P0), ex_out(E, P, Col).
    inv.dst(E, P0, Col) :- view.inner([E, P], P0), ex_out(E, P, Col).

    // A transform no example contradicts.
    .decl sym(d: D4)
    sym(D) :- d4_elem(D), !inv.conflict(_, D).
}
