// 981571dc
// @keywords: symmetry repair noise
// output: The clean cells show a pattern symmetric about a stored center. A
//  noise cell takes the color of a clean cell in its orbit under the pattern's
//  symmetry group.

.decl out(p: Position, col: Color)

.comp Params {
    .decl noise(col: Color) noise(0).

    // The pattern's symmetry center, as its offset from the grid center.
    .decl center(v: Offset) center([1, -1, 1, -1]).

    // The pattern's symmetry group.
    .decl sym(s: Sym) sym(SYM_D4).
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

// A cell's image under one of the stored symmetries.
.decl counterpart(p: Position, q: Position)
counterpart(P, Q) :-
    params.center(V), in(P, _), relative(V, P, P_inner),          // a cell seen from the center
    params.sym(S), sym_member(S, D), apply(D, P_inner, Q_inner),  // its image under a stored symmetry
    compose(V, Q_inner, Q), in(Q, _).                             // that image, back in the grid

out(P, Col) :- clean(P, Col).
out(P, Col) :-
    in(P, N), params.noise(N),            // corrupted cell
    counterpart(P, Q), clean(Q, Col).

.comp Determine {
    // The isometries of each restored grid.
    .init wp = Wallpaper<Example, Color>
    wp.transform(D) :- d4_elem(D).
    wp.cell(E, P, Col) :- ex_out(E, P, Col).
    wp.grid(E, P) :- ex_out(E, P, _).

    // A symmetry of some example that another example lacks.
    .decl unshared(d: D4, v: Offset)
    unshared(D, V) :- wp.symmetry(_, D, V), wp.grid(E, _), !wp.symmetry(E, D, V).

    // Candidate mirror lines of each axis, as offsets from the grid center.
    .decl cand(a: Axis, v: Offset)
    cand(A, V) :-
        ex_out(_, P, _), corner_dist(P, _, 0),   // a frame corner
        axis_of(D, A), sub_extent(P, A, K),      // each axis, each distance
        jump_offset(D, K, V).
    cand(A, ZERO) :- axis_elem(A).      // the grid center line itself

    // The axis's mirror line: every example is symmetric under the axis's
    // flip followed by a shift of twice the line's offset.
    .decl axis_center(a: Axis, v: Offset)
    axis_center(A, V) :-
        flip_of(A, F), wp.symmetry(_, F, V2), !unshared(F, V2),
        cand(A, V), compose(V, V, V2).

    // The symmetry center: the mirror line of each axis, crossed.
    .decl center(v: Offset)
    center(V) :-
        perp(A1, A2),
        axis_center(A1, V1), axis_center(A2, V2), compose(V1, V2, V).

    // A transform some example has no symmetry under.
    .decl unused(d: D4)
    unused(D) :- d4_elem(D), wp.grid(E, _), !wp.transform_used(E, D).

    // The transforms every example uses, named as a subgroup.
    .init named = KeyedSetCompare<Unit, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member($U(), D) :- d4_elem(D), !unused(D).

    .decl sym(s: Sym)
    sym(S) :- named.equals($U(), S).
}
