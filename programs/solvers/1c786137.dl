// 1c786137
// draft
// keywords: crop border objects select enclose
// output: Colored noise fills the grid, and one rectangle outline sits in it,
//  drawn in a color that appears nowhere else. The output is what the outline
//  holds: the cells of its box strictly inside its edges.

// which color and structure count as the outline
.type Choice =
    // the outline is the color whose cells are exactly the edges of their own
    // box
    Rect {}
    // the outline is the color whose cells form a single connected object
  | Solo {}
    // the outline is the rectangle drawn by four same-color runs that holds
    // the most cells
  | Drawn {}
    // the outline is any wall of one color; what it holds is the largest
    // region that such a wall cuts off from the grid edge
  | Enclose {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {}

.init params = Params

.decl color(col: Color)
color(Col) :- in(_, Col).

.init cbox = Bbox<Color>
cbox.cell(Col, P) :- in(P, Col).

// --- outline ---

// The color drawing the outline.
.decl marker(col: Color, ch: Choice)

.decl outline_box(b: Box, ch: Choice)
outline_box(B, Ch) :- marker(Col, Ch), cbox.box(Col, B).

// What the outline holds.
.decl window(p: Position, ch: Choice)
window(P, Ch) :- outline_box(B, Ch), in(P, _), interior(P, B).

.init window_bbox = Bbox<Choice>
window_bbox.cell(Ch, P) :- window(P, Ch).

out(P_inner, Col, Ch) :- window_bbox.box(Ch, B), in(P, Col), crop(P, B, P_inner).

// --- Rect ---

// The color's cells are not exactly the edges of its box: a gap in the edges,
// or a cell in the hole.
.decl misdrawn(col: Color)
misdrawn(Col) :- cbox.box(Col, B), in(P, _), box_edge(P, B, _), !in(P, Col).
misdrawn(Col) :- cbox.box(Col, B), in(P, Col), interior(P, B).

marker(Col, $Rect()) :- color(Col), !misdrawn(Col).

// --- Solo ---

.init parts = Components<Color>
parts.node(Col, P) :- in(P, Col).

.init color_part = Unanimous<Color, Ident>
color_part.item(Col, Id) :- parts.label(Col, _, Id).

marker(Col, $Solo()) :- color(Col), !color_part.clash(Col).

// --- Drawn ---

.init drect = Outlines<Color>
drect.node(Col, P) :- in(P, Col).

.init biggest_hole = Mode<Unit, Box, Position>
biggest_hole.item($U(), B, P) :- drect.box(_, B), in(P, _), interior(P, B).

outline_box(B, $Drawn()) :- biggest_hole.mode($U(), B).

// --- Enclose ---

// Each color walls the rest of the grid off.
.init closed = Closed<Color>
closed.cell(Col, P) :- color(Col), in(P, Col2), Col2 != Col.

.type Region = [col: Color, id: Ident]

.init biggest_region = Mode<Unit, Region, Position>
biggest_region.item($U(), [Col, Id], P) :- closed.region(Col, P, Id).

window(P, $Enclose()) :-
    biggest_region.mode($U(), [Col, Id]), closed.region(Col, P, Id).
