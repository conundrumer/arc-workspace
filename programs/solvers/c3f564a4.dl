// c3f564a4
// @keywords: wallpaper repair lines
// input: a diagonal-stripe wallpaper — one color per stripe, the stripe
//  sequence periodic — corrupted by noise patches
// output: the output restores the wallpaper. The period varies per pair,
//  so no case stores one.

// how a noise cell finds its clean counterpart
.type Choice =
    // translation repair, detected: a shift unbroken on clean cells maps each
    // noise cell to a clean counterpart
    Shift {}
    // line structure: each stripe is one color; a noise cell copies from a
    // clean cell on its own stripe
  | Diag {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(0).

    // --- $Diag ---
    .decl diag(da: DiagAxis) diag(DAXIS_AD).   // stripes run TR-BL
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- clean(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Shift()). impl_choice($Diag()).

// Clean cells pass through under every case.
out(P, Col, Ch) :- impl_choice(Ch), clean(P, Col).

// --- $Shift ---

out(P, Col, $Shift()) :-
    in(P, N), params.noise(N),                         // corrupted cell
    si.cand($U(), A, K, Delta),                     // candidate shift
    !si.mismatch($U(), A, K),                       // unbroken on clean cells
    compose(P, Delta, P2), clean(P2, Col).             // its image

// --- $Diag ---

out(P, Col, $Diag()) :-
    in(P, N), params.noise(N),                              // corrupted cell
    params.diag(DA), same_line(DA, P, Q),                   // its stripe
    clean(Q, Col).                                          // clean stripe-mate
