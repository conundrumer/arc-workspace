// 070dd51e
// @keywords: markers span
// output: Non-bg marks come in same-colored pairs sharing a row or column; a
//  span of the pair's color connects them. Where spans cross, the span along
//  the over axis wins.

// Cases split what a span may paint
.type Choice =
    // it paints every cell it covers
    PaintAll {}
    // it paints only bg cells, so marks persist
  | PaintBg {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color) bg(0).
    .decl over_axis(a: Axis) over_axis(AXIS_V).
}

.init params = Params

.decl mark(col: Color, p: Position)
mark(Col, P) :- in(P, Col), !params.bg(Col).

.init bet = Between<Color>
bet.axis(Col, A) :- mark(Col, _), axis_elem(A).
bet.cell(Col, P) :- mark(Col, _), in(P, _).
bet.mark(Col, P) :- mark(Col, P).

// The axis a color's line runs along.
.decl line_axis(col: Color, a: Axis)
line_axis(Col, A) :-
    mark(Col, P), mark(Col, Q), P != Q,
    axis_elem(A), same_line(A, P, Q).

// Span cells tagged with their line's axis.
.decl span(p: Position, col: Color, a: Axis)
span(P, Col, A) :- bet.between(Col, P), line_axis(Col, A).

// A cell some over-axis span covers.
.decl over_span(p: Position)
over_span(P) :- span(P, _, A), params.over_axis(A).

// The winning span color at each covered cell: over axis beats the other.
.decl top_span(p: Position, col: Color)
top_span(P, Col) :- span(P, Col, A), params.over_axis(A).
top_span(P, Col) :- span(P, Col, _), !over_span(P).

// --- $PaintAll ---
out(P, Col, $PaintAll()) :- top_span(P, Col).
out(P, Col, $PaintAll()) :- in(P, Col), !top_span(P, _).

// --- $PaintBg ---
out(P, Col, $PaintBg()) :-
    in(P, Bg), params.bg(Bg),        // a bg cell
    ( top_span(P, Col)               // a span above paints it
    ; !top_span(P, _), Col = Bg      // no span — stays bg
    ).
out(P, Col, $PaintBg()) :- in(P, Col), !params.bg(Col).
