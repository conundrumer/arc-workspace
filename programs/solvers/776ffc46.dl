// 776ffc46
// @draft
// @keywords: objects border match congruent
// input: Rectangles drawn in the frame color each hold a reference shape in
//  one color.
// output: Loose shapes outside the rectangles that are congruent to a
//  reference, by translation, take that reference's color; the rest of the
//  grid is unchanged.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl frame(c: Color) frame(5).
}

.init params = Params

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col), !params.frame(Col).

// The rectangles drawn in the frame color, and their insides.
.init drect = Outlines<Unit>
drect.node($U(), P) :- in(P, Col), params.frame(Col).

.decl rect_hole(b: Box, p: Position)
rect_hole(B, P) :- drect.box(_, B), in(P, _), interior(P, B).

// Each rectangle's reference shape, with its bounding box.
.init ref = Bbox<Box>
ref.cell(B, P) :- rect_hole(B, P), ink(P, _).

// The loose shapes: ink components outside every rectangle.
.init loose = Components<Unit>
loose.node($U(), P) :- ink(P, _), !rect_hole(_, P).

.init shape = Bbox<Ident>
shape.cell(Id, P) :- loose.label($U(), P, Id).

// A loose shape matches a reference when their box-relative cell sets agree.
.init same_shape = KeyedSetCompare<Ident, Box, Position>
same_shape.pattern_member(B, P_inner) :-
    ref.cell(B, P), ref.box(B, B_ref), crop(P, B_ref, P_inner).
same_shape.observed_member(Id, P_inner) :-
    shape.cell(Id, P), shape.box(Id, B_shape), crop(P, B_shape, P_inner).

.decl recolor(p: Position, col: Color)
recolor(P, Col) :-
    loose.label($U(), P, Id), same_shape.equals(Id, B),  // the loose shape matches rectangle B
    ref.cell(B, P_ref), ink(P_ref, Col).                // B's reference color

out(P, Col) :-
    in(P, C_in),
    ( recolor(P, Col)                 // a matched loose shape takes its reference's color
    ; !recolor(P, _), Col = C_in      // everything else stays
    ).
