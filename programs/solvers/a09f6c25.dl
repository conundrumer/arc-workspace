// a09f6c25
// @draft
// @keywords: objects symmetry noise classify lookup
// @scene field: the grid is one background color, and every other cell has
//  params.figure_color
// @scene figures: the figure cells form 8-connected components. Each
//  component of two or more cells is a shape, and each shape has exactly one
//  mirror class: a mirror across the horizontal axis of its bounding box, a
//  mirror across the vertical axis of its bounding box, or a mirror across
//  both diagonals of its square bounding box
// @rule recolor-by-symmetry: each shape keeps its cells and takes the color
//  params.class_color gives its mirror class
// @rule erase-noise: each component of at most params.noise_size cells takes
//  the background color, the most frequent color of the input; undefined when
//  two colors tie for most frequent
// @rule rest: every other cell keeps its input color

// how figure cells group into components
.type Connectivity =
    // @claim figures
    Conn8 {}
    // @scene figures: the figure cells form 4-connected components
    // @witness diag-chevron: variant concept
    // @witness noise-touch: variant $Conn4
    //     @relaxed figures
  | Conn4 {}

// the color erased cells take
.type Background =
    // @claim erase-noise
    Commonest {}
    // @rule erase-noise: each component of at most params.noise_size cells
    //  takes the background color, the color of the cells at the four grid
    //  corners; undefined when those cells differ
    // @witness corner-noise: ordinary concept
  | CornerBg {}

// which cells are figure cells
.type FigureCells =
    // @claim field
    StoredFigure {}
    // @scene field: the grid is one background color, and every other cell
    //  is a figure cell
    // @rule rest: every background cell keeps its color
    // @witness other-color-shape: borderline $NonbgFigure
    //     @relaxed field
  | NonbgFigure {}

// which components are erased
.type NoiseSelection =
    // @claim erase-noise
    SizeBound {}
    // @rule erase-noise: the components of the smallest size in the input
    //  take the background color
    // @witness no-noise: variant concept
  | MinSizeNoise {}

// the color of a shape that is in no class and has no axis mirror: with the
// stored classes, one that is not mirrored across both diagonals
.type NoAxisShape =
    // @claim recolor-by-symmetry
    NoAxisUndefined {}
    // @rule recolor-by-symmetry: a shape that is in no class and has no axis
    //  mirror takes the color of the class with no axis mirror
    // @witness one-diagonal: variant $NoAxisThird
    //     @relaxed figures
  | NoAxisThird {}
    // @rule recolor-by-symmetry: a shape that is in no class and has no axis
    //  mirror takes the background color
    // @witness one-diagonal: variant $NoAxisThird
  | NoAxisErased {}

// the color of a shape that is in no class and has an axis mirror: with the
// stored classes, one mirrored across both axes
.type TwoAxisShape =
    // @claim recolor-by-symmetry
    TwoAxisUndefined {}
    // @rule recolor-by-symmetry: a shape that is in no class and has an axis
    //  mirror takes the color of the class with no axis mirror
    // @witness plus: borderline any
    //     @relaxed figures
  | TwoAxisThird {}
    // @rule recolor-by-symmetry: a shape that is in no class and has an axis
    //  mirror takes the background color
    // @witness plus: borderline any
  | TwoAxisErased {}

.type Choice = [conn: Connectivity, bg: Background, fig: FigureCells,
                noise: NoiseSelection, no_axis: NoAxisShape, two_axis: TwoAxisShape]

// The figure cells under one background and one figure reading.
.type Figure = [bg: Background, fig: FigureCells]

// The components of one figure reading under one connectivity.
.type Grouping = [fig: Figure, conn: Connectivity]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The color each mirror class takes, keyed by the class's symmetry group.
    .decl class_color(s: Sym, c: Color)
    class_color(SYM_TB, 1). class_color(SYM_LR, 3). class_color(SYM_X, 6).

    // --- $StoredFigure ---
    // @derive RarestColor: variant derived
    //     @relaxed field
    // @ignore: derive concept — wherever it is defined, it gives the output of
    //  the NoAxisThird & TwoAxisThird copy
    .decl figure_color(c: Color) figure_color(2).

    // --- $SizeBound ---
    // The largest component size that is erased.
    .decl noise_size(k: number) noise_size(1).

    // --- $NoAxisThird, $TwoAxisThird ---
    // A class with an axis mirror, and the color of the class with none.
    .decl axis_class(s: Sym)
    axis_class(S) :- class_color(S, _), sym_member(S, D), flip_of(_, D).

    .decl third(c: Color)
    third(Col) :- class_color(S, Col), !axis_class(S).
}

.init params = Params

.decl connectivity_choice(c: Connectivity)
connectivity_choice($Conn8()). connectivity_choice($Conn4()).

.decl background_choice(b: Background)
background_choice($Commonest()). background_choice($CornerBg()).

.decl figure_cells_choice(f: FigureCells)
figure_cells_choice($StoredFigure()). figure_cells_choice($NonbgFigure()).

.decl noise_selection_choice(n: NoiseSelection)
noise_selection_choice($SizeBound()). noise_selection_choice($MinSizeNoise()).

.decl no_axis_shape_choice(na: NoAxisShape)
no_axis_shape_choice($NoAxisUndefined()). no_axis_shape_choice($NoAxisThird()).
no_axis_shape_choice($NoAxisErased()).

.decl two_axis_shape_choice(ta: TwoAxisShape)
two_axis_shape_choice($TwoAxisUndefined()). two_axis_shape_choice($TwoAxisThird()).
two_axis_shape_choice($TwoAxisErased()).

// The concept case, and every case with a non-concept branch at both class
// points. A case with the concept branch at one class point is undefined on
// that point's shapes, and the case that adds a branch there subsumes it.
.decl impl_choice(ch: Choice)
impl_choice([$Conn8(), $Commonest(), $StoredFigure(), $SizeBound(),
             $NoAxisUndefined(), $TwoAxisUndefined()]).
impl_choice([C, B, F, N, NA, TA]) :-
    connectivity_choice(C), background_choice(B), figure_cells_choice(F),
    noise_selection_choice(N),
    no_axis_shape_choice(NA), NA != $NoAxisUndefined(),
    two_axis_shape_choice(TA), TA != $TwoAxisUndefined().

// The components of each key's figure cells, under each connectivity, and
// each component's size and symmetry group.
.comp Parse<Key> {
    .type Obj = [k: Key, c: Connectivity, id: Ident]

    .decl figure(k: Key, p: Position)

    .decl member(k: Key, c: Connectivity, id: Ident, p: Position)

    // @claim erase-noise
    .init size = Tally<Obj, Position>
    size.item([K, C, Id], P) :- member(K, C, Id, P).

    // @claim recolor-by-symmetry
    .init bbox = Bbox<Obj>
    bbox.cell([K, C, Id], P) :- member(K, C, Id, P).

    // The symmetries of each component's cells within its bounding box.
    // @claim recolor-by-symmetry
    .init mirror = D4Map<Obj, Unit>
    mirror.src(O, P_inner, $U()) :- bbox.cell(O, P), bbox.box(O, B), crop(P, B, P_inner).
    mirror.dst(O, P_inner, $U()) :- mirror.src(O, P_inner, _).

    // The component's symmetries, named as a subgroup.
    // @claim recolor-by-symmetry
    .init named = KeyedSetCompare<Obj, Sym, D4>
    named.pattern_member(S, D) :- sym_member(S, D).
    named.observed_member(O, D) :- mirror.map(O, D).

    // A component mirrored across an axis.
    .decl axis_mirrored(k: Key, c: Connectivity, id: Ident)
    axis_mirrored(K, C, Id) :- mirror.map([K, C, Id], D), flip_of(_, D).

    // --- $Conn8 ---
    // @claim figures
    .init conn8 = Components8<Key>
    conn8.node(K, P) :- figure(K, P).

    member(K, $Conn8(), Id, P) :- conn8.label(K, P, Id).

    // --- $Conn4 ---
    // @claim figures
    .init conn4 = Components<Key>
    conn4.node(K, P) :- figure(K, P).

    member(K, $Conn4(), Id, P) :- conn4.label(K, P, Id).
}

.init parse = Parse<Figure>

// The background color under each reading; undefined when the reading gives
// two colors.
// @claim erase-noise
.init background = Unanimous<Background, Color>

// The components each noise reading erases, and the ones it keeps as shapes.
.decl noise(k: Figure, c: Connectivity, id: Ident, n: NoiseSelection)
.decl shape(k: Figure, c: Connectivity, id: Ident, n: NoiseSelection)

// A component in no class.
.decl unclassed(k: Figure, c: Connectivity, id: Ident)
unclassed(K, C, Id) :- parse.named.equals([K, C, Id], S), !params.class_color(S, _).

// An unclassed component with no axis mirror, and one with an axis mirror.
.decl no_axis(k: Figure, c: Connectivity, id: Ident)
.decl two_axis(k: Figure, c: Connectivity, id: Ident)
no_axis(K, C, Id) :- unclassed(K, C, Id), !parse.axis_mirrored(K, C, Id).
two_axis(K, C, Id) :- unclassed(K, C, Id), parse.axis_mirrored(K, C, Id).

// The color an unclassed shape takes under each reading of its class point;
// an erased shape takes the background color.
.decl no_axis_color(k: Figure, c: Connectivity, id: Ident, na: NoAxisShape, col: Color)

// The same, for a shape with an axis mirror.
// @ignore: store — in every variant task the stored color is the one
//  params.third takes from params.class_color, so
//  each stored copy is equivalent to its case
.decl two_axis_color(k: Figure, c: Connectivity, id: Ident, ta: TwoAxisShape, col: Color)

out(P, Col, [C, B, F, N, NA, TA]) :-
    impl_choice([C, B, F, N, NA, TA]), background.value(B, BG), in(P, Col_in),
    ( parse.member([B, F], C, Id, P),
      ( noise([B, F], C, Id, N), Col = BG
      ; shape([B, F], C, Id, N),
        ( parse.named.equals([[B, F], C, Id], S), params.class_color(S, Col)
        ; no_axis_color([B, F], C, Id, NA, Col)
        ; two_axis_color([B, F], C, Id, TA, Col) ) )
    ; !parse.figure([B, F], P), Col = Col_in ).

// --- $Commonest ---
// @claim erase-noise
.init commonest = Mode<Unit, Color, Position>
commonest.item($U(), Col, P) :- in(P, Col).

background.item($Commonest(), Col) :- commonest.mode($U(), Col).

// --- $CornerBg ---
background.item($CornerBg(), Col) :- in(P, Col), diag_dir_elem(D), box_corner(P, ZERO, D).

// --- $StoredFigure ---
parse.figure([B, $StoredFigure()], P) :- background_choice(B), in(P, Col), params.figure_color(Col).

// --- $NonbgFigure ---
parse.figure([B, $NonbgFigure()], P) :-
    background.value(B, _), in(P, Col), !background.value(B, Col).

// --- $SizeBound ---
noise(K, C, Id, $SizeBound()) :- parse.size.tally([K, C, Id], N), params.noise_size(M), N <= M.
shape(K, C, Id, $SizeBound()) :- parse.size.tally([K, C, Id], N), params.noise_size(M), N > M.

// --- $MinSizeNoise ---
// @claim erase-noise
// @store low: variant concept
.init smallest = Extremes<Grouping>
smallest.cand([K, C], N) :- parse.size.tally([K, C, _], N).

noise(K, C, Id, $MinSizeNoise()) :- parse.size.tally([K, C, Id], N), smallest.low([K, C], N).
shape(K, C, Id, $MinSizeNoise()) :- parse.size.tally([K, C, Id], N), !smallest.low([K, C], N).

// --- $NoAxisThird ---
no_axis_color(K, C, Id, $NoAxisThird(), Col) :- no_axis(K, C, Id), params.third(Col).

// --- $NoAxisErased ---
no_axis_color([B, F], C, Id, $NoAxisErased(), BG) :-
    no_axis([B, F], C, Id), background.value(B, BG).

// --- $TwoAxisThird ---
two_axis_color(K, C, Id, $TwoAxisThird(), Col) :- two_axis(K, C, Id), params.third(Col).

// --- $TwoAxisErased ---
two_axis_color([B, F], C, Id, $TwoAxisErased(), BG) :-
    two_axis([B, F], C, Id), background.value(B, BG).

.comp Determine {
    // The input colors of the cells the output changes: every figure cell
    // takes a class color or the background color, and every other cell
    // keeps its color.
    .init changed = Unanimous<Unit, Color>
    changed.item($U(), Col) :- ex_in(E, P, Col), ex_out(E, P, Col_out), Col != Col_out.

    .decl figure_color(c: Color)
    figure_color(Col) :- changed.value($U(), Col).

    // The figure cells under the concept reading.
    .init parse = Parse<Example>
    parse.figure(E, P) :- ex_in(E, P, Col), figure_color(Col).

    // @claim erase-noise
    .init commonest = Mode<Example, Color, Position>
    commonest.item(E, Col, P) :- ex_in(E, P, Col).

    // A component the output keeps, and the color it takes.
    .decl kept(e: Example, id: Ident, col: Color)
    kept(E, Id, Col) :-
        parse.member(E, $Conn8(), Id, P), ex_out(E, P, Col), !commonest.mode(E, Col).

    .decl class_color(s: Sym, c: Color)
    class_color(S, Col) :- kept(E, Id, Col), parse.named.equals([E, $Conn8(), Id], S).
}
