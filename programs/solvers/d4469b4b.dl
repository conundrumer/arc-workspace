// d4469b4b
// concept: lookup classify cross
// Noise in a single ink color keys a fixed 3x3 glyph — plus, T, or
// corner-L. The noise pattern carries nothing; only its color selects.
// Every glyph is a full row and column through one point, so the render
// splits data/ops, tagged on out's Choice:
//
//   $Cross()  — the table stores the cross center; the glyph is the row
//               and column through it, c.mark over c.bg.
//   $Lookup() — the table stores the finished grid.

#include "../lib.dl"

.type Choice = Cross {} | Lookup {}

.comp Consts {
    .init helpers = ConstsHelpers

    .decl bg(col: Color) bg(0).

    // --- $Cross ---
    .decl mark(col: Color) mark(5).
    .decl out_dim(n: number) out_dim(3).

    .decl cross(key: Color, p: Position)
    cross(1, [1, 1, 1, 1]).
    cross(2, [0, 2, 1, 1]).
    cross(3, [2, 0, 2, 0]).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(N), helpers.frame_pos([N, N], P).

    // --- $Lookup ---
    .decl glyph(key: Color, p: Position, col: Color)
    GRID_3x3(glyph, 1,
        0, 5, 0,
        5, 5, 5,
        0, 5, 0)
    GRID_3x3(glyph, 2,
        5, 5, 5,
        0, 5, 0,
        0, 5, 0)
    GRID_3x3(glyph, 3,
        0, 0, 5,
        0, 0, 5,
        5, 5, 5)
}

.init c = Consts

.decl out(p: Position, col: Color, ch: Choice)

// --- $Cross ---
.decl cross_cell(p: Position)
cross_cell(P) :-
    in(_, Key), c.cross(Key, Q),                           // stored center
    c.out_pos(P),
    axis_elem(A), split(P, A, _, Ac), split(Q, A, _, Ac).  // p on q's row or column

out(P, Col, $Cross()) :- cross_cell(P), c.mark(Col).
out(P, Col, $Cross()) :- c.out_pos(P), !cross_cell(P), c.bg(Col).

// --- $Lookup ---
out(P, Col, $Lookup()) :- in(_, Key), c.glyph(Key, P, Col).

// --- fit ---

.comp Fit {
    .decl glyph(key: Color, p: Position, col: Color)
    glyph(Key, P, Col) :-
        ex_in(E, _, Key), !c.bg(Key),    // the example's ink
        ex_out(E, P, Col).               // its whole output

    .decl mismatch(key: Color, p: Position)
    mismatch(Key, P) :-
        glyph(Key, P, _), glyph(Key, Q, Col), !c.mark(Col),    // a non-mark cell
        axis_elem(A), split(P, A, _, Ac), split(Q, A, _, Ac).  // on p's row or column

    .decl cross(key: Color, p: Position)
    cross(Key, P) :- glyph(Key, P, _), !mismatch(Key, P).
}
