// d4469b4b
// @keywords: lookup classify cross
// output: Noise in a single ink color keys a fixed 3x3 glyph. The pattern
//  carries nothing; only its color selects.

// table or rule render of the glyph; every glyph is a full row and column
// through one point, so both stand
.type Choice =
    // the table stores the glyph's center; the glyph is the row and column
    // through it
    Cross {}
    // the table stores the finished grid
  | Lookup {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    // --- $Cross ---
    .decl bg(col: Color) bg(0).
    .decl mark(col: Color) mark(5).
    .decl out_dim(n: number) out_dim(3).

    .decl center(key: Color, p: Position)
    center(1, [1, 1, 1, 1]).
    center(2, [0, 2, 1, 1]).
    center(3, [2, 0, 2, 0]).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(N), helpers.frame_pos([N, N], P).

    // --- $Lookup ---
    .decl glyph(key: Color, p: Position, col: Color)
    GRID_3x3(glyph, 1,
        0, 5, 0,
        5, 5, 5,
        0, 5, 0)
    GRID_3x3(glyph, 2,
        5, 5, 5,
        0, 5, 0,
        0, 5, 0)
    GRID_3x3(glyph, 3,
        0, 0, 5,
        0, 0, 5,
        5, 5, 5)
}

.init params = Params

// --- $Cross ---
.decl cross_cell(p: Position)
cross_cell(P) :-
    in(_, Key), params.center(Key, Q),                     // the ink's center
    params.out_pos(P), axis_elem(A), same_line(A, P, Q).   // P on its row or column

out(P, Col, $Cross()) :-
    params.out_pos(P),
    ( cross_cell(P), params.mark(Col)
    ; !cross_cell(P), params.bg(Col)
    ).

// --- $Lookup ---
out(P, Col, $Lookup()) :- in(_, Key), params.glyph(Key, P, Col).

.comp Determine {
    .decl glyph(key: Color, p: Position, col: Color)
    glyph(Key, P, Col) :-
        ex_in(E, _, Key), !params.bg(Key),    // the example's ink
        ex_out(E, P, Col).                    // its whole output

    .decl mismatch(key: Color, p: Position)
    mismatch(Key, P) :-
        glyph(Key, P, _), glyph(Key, Q, Col), !params.mark(Col),   // a non-mark cell
        axis_elem(A), same_line(A, P, Q).

    .decl center(key: Color, p: Position)
    center(Key, P) :- glyph(Key, P, _), !mismatch(Key, P).
}
