// 3979b1a8
// concept: grow lookup wallpaper cast
// The input becomes one corner of a larger output. Outside it, the
// diagonal through the growth corner continues periodically, and each
// diagonal cell paints two arms one shell out: a step toward the corner,
// then a ray back across.
//   $Scale  — the output is the input scaled up.
//   $Canvas — the output is a fixed canvas.

#include "../lib.dl"

.type Choice = Scale {} | Canvas {}

.comp Consts {
    // --- shared ---
    .decl growth(d: DiagDir) growth(DIAG_BR).
    .decl period(n: number) period(3).

    // --- Scale ---
    .decl scale(s: number) scale(2).
    .decl in_tile(p_tile: Position) in_tile([0, 1, 0, 1]).

    // --- Canvas ---
    .decl out_dim(k: number) out_dim(10).
    .decl anchor(d: DiagDir) anchor(DIAG_TL).
}

.init c = Consts

// Per-case output frame and input placement.
.decl frame_cell(c: Choice, p_grid: Position)
.decl placed(c: Choice, p_grid: Position, p_in: Position)

// --- Scale ---
// The frame is a scale x scale arrangement of input-sized tiles; the
// input occupies its tile.
.init tiles = Frame2D<Unit>
tiles.extent($U(), A, S) :- c.scale(S), axis_elem(A).

.decl tile_cell(p_grid: Position, p_tile: Position, p_in: Position)
tile_cell(P_grid, P_tile, P_in) :-
    tiles.cell($U(), P_tile), in(P_in, _),
    concat_2d(P_tile, P_in, 0, P_grid).

frame_cell($Scale(), P_grid) :- tile_cell(P_grid, _, _).
placed($Scale(), P_grid, P_in) :- c.in_tile(P_tile), tile_cell(P_grid, P_tile, P_in).

// --- Canvas ---
// The frame is a stored canvas; the input sits at the anchor corner.
.init canvas = Frame2D<Unit>
canvas.extent($U(), A, K) :- c.out_dim(K), axis_elem(A).

frame_cell($Canvas(), P_grid) :- canvas.cell($U(), P_grid).
placed($Canvas(), P_grid, P_in) :-
    canvas.cell($U(), P_grid), in(P_in, _),
    c.anchor(Diag), corner_anchor(Diag, P_in, P_grid).

// The region the input occupies.
.decl in_region(c: Choice, p_grid: Position)
in_region(Ch, P_grid) :- placed(Ch, P_grid, _).

// The diagonal through the growth corner.
.decl on_diag(c: Choice, p_grid: Position)
on_diag(Ch, P) :- frame_cell(Ch, P), c.growth(Diag), diag_dist(P, Diag, _, K, K).

// The diagonal advance of one period.
.decl period_jump(delta: Position)
period_jump(Delta) :-
    c.growth(Diag), c.period(N), diag_jump_delta(Diag, N, Delta).

.decl out(p: Position, col: Color, c: Choice)

// The input in place.
out(P_grid, Col, Ch) :- placed(Ch, P_grid, P_in), in(P_in, Col).

// The diagonal continues with the period.
out(P2, Col, Ch) :-
    out(P1, Col, Ch), on_diag(Ch, P1),               // diagonal source
    period_jump(Delta), compose(P1, Delta, P2),      // one period out
    on_diag(Ch, P2), !in_region(Ch, P2).             // lands outside the input

// Each diagonal cell paints two arms one shell out.
out(P, Col, Ch) :-
    out(Q, Col, Ch), on_diag(Ch, Q),                                // diagonal source
    c.growth(Diag), diag_dirs(Diag, _, D1, D2),                     // the corner's dir pair
    step_delta(D1, S), compose(Q, S, M),                            // step off the diagonal
    frame_cell(Ch, P), !in_region(Ch, P),                           // outside the input
    axis_of(D1, A), split(P, A, Along, _), split(M, A, Along, _),   // in the stepped line
    opposite(D2, O), dist(P, O, Kp), dist(M, O, Km), Kp <= Km.      // at or back across

// --- fit ---

.comp Fit {
    // Each train input seated at each corner of its output.
    .decl anchored(e: Example, diag: DiagDir, p_in: Position, p_grid: Position)
    anchored(E, Diag, P_in, P_grid) :-
        ex_in(E, P_in, _), ex_out(E, P_grid, _),
        diag_dir_elem(Diag), corner_anchor(Diag, P_in, P_grid).

    // A corner seating some input cell on a different color.
    .decl anchor_broken(diag: DiagDir)
    anchor_broken(Diag) :-
        anchored(E, Diag, P_in, P_grid),
        ex_in(E, P_in, Col), !ex_out(E, P_grid, Col).

    .decl anchor(d: DiagDir)
    anchor(Diag) :- diag_dir_elem(Diag), !anchor_broken(Diag).

    // The output region the input covers.
    .decl in_region(e: Example, p_grid: Position)
    in_region(E, P_grid) :- anchor(Diag), anchored(E, Diag, _, P_grid).

    // A corner the input reaches an edge of.
    .decl growth_broken(diag: DiagDir)
    growth_broken(Diag) :- in_region(_, P), dir_of(Diag, _, D), dist(P, D, 0).

    // The frame grows toward the corner the input stays clear of.
    .decl growth(d: DiagDir)
    growth(Diag) :- diag_dir_elem(Diag), !growth_broken(Diag).

    .decl diag_cell(e: Example, p: Position)
    diag_cell(E, P) :- ex_out(E, P, _), growth(Diag), diag_dist(P, Diag, _, K, K).

    // Candidate periods, as the diagonal jump back toward the input.
    .decl cand(n: number, delta: Shift)
    cand(N, Delta) :-
        ex_out(_, P, _), axis_elem(A), sub_extent(P, A, N),
        growth(Diag), diag_opposite(Diag, Back), diag_jump_delta(Back, N, Delta).

    // A period whose continued cell and its source disagree.
    .decl broken(n: number)
    broken(N) :-
        cand(N, Delta), diag_cell(E, P), !in_region(E, P),   // continued diagonal cell
        compose(P, Delta, P2),                               // one period back
        ex_out(E, P, Col), ex_out(E, P2, C2), C2 != Col.

    .decl period(n: number)
    period(N) :- cand(N, _), !broken(N).

    // Tiles of the scale arrangement.
    .init tiles = Frame2D<Unit>
    tiles.extent($U(), A, S) :- c.scale(S), axis_elem(A).

    // A tile placing some input cell on a different color.
    .decl tile_broken(p_tile: Position)
    tile_broken(P_tile) :-
        tiles.cell($U(), P_tile),
        ex_in(E, P_in, Col), ex_out(E, _, _),
        concat_2d(P_tile, P_in, 0, P_grid), !ex_out(E, P_grid, Col).

    .decl in_tile(p_tile: Position)
    in_tile(P_tile) :- tiles.cell($U(), P_tile), !tile_broken(P_tile).
}
