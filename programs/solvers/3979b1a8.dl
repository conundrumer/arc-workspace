// 3979b1a8
// @keywords: grow lookup wallpaper cast
// output: The input becomes one corner of a larger output. Outside it, the
//  diagonal through the growth corner continues periodically, and each diagonal
//  cell paints two arms one shell out: a step toward the corner, then a ray
//  back across.

// what the output frame is
.type Choice =
    // the output is the input scaled up
    Scale {}
    // the output is a fixed canvas
  | Canvas {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl growth(d: DiagDir) growth(DIAG_BR).
    .decl period(n: number) period(3).

    // --- $Scale ---
    .decl scale(s: number) scale(2).
    .decl in_tile(p_tile: Position) in_tile([0, 1, 0, 1]).

    // --- $Canvas ---
    .decl out_dim(k: number) out_dim(10).
    .decl anchor(d: DiagDir) anchor(DIAG_TL).
}

.init params = Params

// Per-case output frame and input placement.
.decl frame_cell(c: Choice, p_grid: Position)
.decl placed(c: Choice, p_grid: Position, p_in: Position)

// --- $Scale ---
// The frame is a scale x scale arrangement of input-sized tiles; the
// input occupies its tile.
.init tiles = Frame2D<Unit>
tiles.extent($U(), A, S) :- params.scale(S), axis_elem(A).

.decl tile_cell(p_grid: Position, p_tile: Position, p_in: Position)
tile_cell(P_grid, P_tile, P_in) :-
    tiles.cell($U(), P_tile), in(P_in, _),
    concat_2d(P_tile, P_in, 0, P_grid).

frame_cell($Scale(), P_grid) :- tile_cell(P_grid, _, _).
placed($Scale(), P_grid, P_in) :- params.in_tile(P_tile), tile_cell(P_grid, P_tile, P_in).

// --- $Canvas ---
// The frame is a stored canvas; the input sits at the anchor corner.
.init canvas = Frame2D<Unit>
canvas.extent($U(), A, K) :- params.out_dim(K), axis_elem(A).

frame_cell($Canvas(), P_grid) :- canvas.cell($U(), P_grid).
placed($Canvas(), P_grid, P_in) :-
    canvas.cell($U(), P_grid), in(P_in, _),
    params.anchor(Diag), corner_anchor(Diag, P_in, P_grid).

// The diagonal through the growth corner.
.decl on_diag(c: Choice, p_grid: Position)
on_diag(Ch, P) :- frame_cell(Ch, P), params.growth(Diag), diag_dist(P, Diag, _, K, K).

// The color of each diagonal cell: the input's own inside the input, and
// outside it the diagonal continuing periodically, each cell the color of the
// input's diagonal cell at its place within the period among the input's
// last period of the diagonal.
.decl diag_color(c: Choice, p_grid: Position, col: Color)
diag_color(Ch, P, Col) :-
    on_diag(Ch, P),
    ( placed(Ch, P, P_in), in(P_in, Col)                              // an input diagonal cell
    ; !placed(Ch, P, _),                                              // a continued diagonal cell
      params.growth(Diag), params.period(N),
      diag_dist(P, Diag, _, K, K), stride(K, N, 0, _, R),             // its place within the period
      on_diag(Ch, Q), placed(Ch, Q, Q_in), in(Q_in, Col),             // an input diagonal cell
      diag_dist(Q, Diag, _, Kq, Kq), stride(Kq, N, 0, _, R),          // at that place
      jump(Q, Diag, N, Q2), !placed(Ch, Q2, _)                        // in the input's last period
    ).

// The input in place.
out(P_grid, Col, Ch) :- placed(Ch, P_grid, P_in), in(P_in, Col).

// Outside the input, the diagonal continues, and each diagonal cell paints
// two arms one shell out: a step toward the corner, then a ray back across.
out(P, Col, Ch) :-
    diag_color(Ch, Q, Col),
    ( P = Q                                                           // the diagonal cell itself
    ; params.growth(Diag), diag_dirs(Diag, _, D1, D2),                // the corner's dir pair
      neighbor(Q, D1, M),                                             // step off the diagonal
      frame_cell(Ch, P),                                              // an arm cell
      axis_of(D2, A), same_line(A, P, M),                             // on M's line along D2
      opposite(D2, O), dist(P, O, Kp), dist(M, O, Km), Kp <= Km       // at or back across
    ),
    !placed(Ch, P, _).                                                // outside the input

.comp Determine {
    // Each train input seated at each corner of its output.
    .decl anchored(e: Example, diag: DiagDir, p_in: Position, p_grid: Position)
    anchored(E, Diag, P_in, P_grid) :-
        ex_in(E, P_in, _), ex_out(E, P_grid, _),
        diag_dir_elem(Diag), corner_anchor(Diag, P_in, P_grid).

    // Where each train input occurs in its output, as the box of the input's
    // frame in the output's.
    .init occ = Occurrences<Example, Color>
    occ.cell(E, P, Col) :- ex_out(E, P, Col).
    occ.shape(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    // An occurrence at corner Diag.
    .decl seated(e: Example, diag: DiagDir)
    seated(E, Diag) :- occ.occurrence(E, B), diag_dir_elem(Diag), diag_dist(B, Diag, _, 0, 0).

    // A corner some train output holds no occurrence at.
    .decl anchor_defect(diag: DiagDir)
    anchor_defect(Diag) :- seated(_, Diag), ex_out(E, _, _), !seated(E, Diag).

    .decl anchor(d: DiagDir)
    anchor(Diag) :- seated(_, Diag), !anchor_defect(Diag).

    // The output region the input covers.
    .decl in_region(e: Example, p_grid: Position)
    in_region(E, P_grid) :- anchor(Diag), anchored(E, Diag, _, P_grid).

    // The frame grows toward the corner opposite the input's seat.
    .decl growth(d: DiagDir)
    growth(Diag) :- anchor(A), diag_opposite(A, Diag).

    .decl diag_cell(e: Example, p: Position)
    diag_cell(E, P) :- ex_out(E, P, _), growth(Diag), diag_dist(P, Diag, _, K, K).

    // Candidate periods, as the diagonal jump back toward the input.
    .decl cand(n: number, delta: Offset)
    cand(N, Delta) :-
        ex_out(_, P, _), axis_elem(A), sub_extent(P, A, N),
        growth(Diag), diag_opposite(Diag, Back), jump_offset(Back, N, Delta).

    // A period whose continued cell and its source disagree.
    .decl mismatch(n: number)
    mismatch(N) :-
        cand(N, Delta), diag_cell(E, P), !in_region(E, P),   // continued diagonal cell
        compose(P, Delta, P2),                               // one period back
        ex_out(E, P, Col), ex_out(E, P2, C2), C2 != Col.

    .decl period(n: number)
    period(N) :- cand(N, _), !mismatch(N).

    // Tiles of the scale arrangement.
    .init tiles = Frame2D<Unit>
    tiles.extent($U(), A, S) :- params.scale(S), axis_elem(A).

    // An occurrence that fills tile P_tile of the arrangement.
    .decl tile_seated(e: Example, p_tile: Position)
    tile_seated(E, P_tile) :-
        occ.occurrence(E, B), ex_in(E, P_in, _), compose(B, P_in, P_grid),
        tiles.cell($U(), P_tile), concat_2d(P_tile, P_in, 0, P_grid).

    // A tile some train output holds no occurrence at.
    .decl tile_defect(p_tile: Position)
    tile_defect(P_tile) :- tile_seated(_, P_tile), ex_out(E, _, _), !tile_seated(E, P_tile).

    .decl in_tile(p_tile: Position)
    in_tile(P_tile) :- tile_seated(_, P_tile), !tile_defect(P_tile).
}
