// 746b3537
// keywords: lines
// input: Striped input: lines along one axis are uniform.
// output: The output is the sequence of stripe colors across them, one
//  cell per run, 1 wide.

.type Line = [a: Axis, p_across: Position]

.decl out(p: Position, col: Color)

.comp Params {
    // No task data — siblings vary only the input.
}

.init params = Params

.init line_color = Unanimous<Line, Color>
line_color.item([A, P_across], Col) :- in(P, Col), axis_elem(A), split(P, A, _, P_across).

// A line along axis a shows two colors.
.decl mismatch(a: Axis)
mismatch(A) :- line_color.clash([A, _]).

// The color sequence runs across the axis whose lines are uniform.
.decl seq_axis(a: Axis)
seq_axis(A_seq) :- perp(A, A_seq), !mismatch(A).

// A run: adjacent sequence lines of one color.
.init runs = Components<Color>
runs.node(Col, P_line) :- seq_axis(A), in(P, Col), split(P, A, P_line, _).

// One output cell per run — the frame the runs induce.
.init seq = OrderFrame<Unit, Ident>
seq.axis($U(), A) :- seq_axis(A).
seq.member($U(), Id, P_line) :- runs.label(_, P_line, Id).

out(P_out, Col) :- runs.label(Col, _, Id), seq.pos($U(), Id, P_out).
