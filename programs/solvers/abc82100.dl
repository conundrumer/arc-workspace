// abc82100
// @draft
// @keywords: objects markers bbox mapping stamp
// @scene background: the background is params.bg
// @scene legend-shape: each legend has a shape drawn in params.key, one
//  8-connected component of that color. The key color occurs nowhere else.
// @scene legend-domino: next to each shape, outside its bounding box on the
//  box's center line, sits a domino of two cells in two colors other than the
//  background and the key. The domino lies on the axis that runs out from the
//  box. Its near cell touches the box edge, and its far cell is one step
//  further out.
// @scene legend-pair: the far cell's color is the source color, and the near
//  cell's color is the target color. Each source color belongs to one legend.
// @scene scene-cells: outside the legends, the grid has single cells of source
//  colors, and it can have cells of other colors
// @scene clear-stamps: no two stamps of different target colors write one
//  cell, and no stamp writes a cell that keeps a color other than background
// @rule key-site: a domino is a key of a shape when its near cell lies just
//  outside the shape's bounding box, within the box's row or column span, and
//  its far cell lies one step further out. Every key forms a legend with the
//  shape.
// @rule anchor: the anchor of a legend is the cell one step past the near
//  cell, away from the far cell
// @rule erase: every legend cell (shape, near, far) and every cell of a
//  source color becomes background
// @rule stamp: for each scene cell of a source color, the shape of that
//  color's legend is drawn in the legend's target color, moved so that the
//  anchor lands on that cell. Cells that fall off the grid are dropped. All
//  stamps read the input, so the stamps do not chain.
// @rule keep: every other cell keeps its input color

// whether a domino's two cells can share a color
.type DominoColors =
    // @claim legend-domino
    TwoColors {}
    // @scene legend-domino: the domino's two cells can share a color, which
    //  is then both the source and the target color
    // @witness same-color: borderline concept
    //     @relaxed legend-domino
  | SameColorDomino {}

// which dominoes are keys of a shape
.type KeySite =
    // @claim key-site
    BoxSide {}
    // @rule key-site: a domino is a key of a shape when its anchor is a shape
    //  cell or 8-adjacent to one, and holds the background or the key color.
    //  The domino can point from any side, and it need not touch the box.
    // @witness wide-mouth: variant concept
  | AnchorTouch {}
    // @rule key-site: the near cell also sits on the box's center row or
    //  center column
    // @witness off-center: variant concept
    //     @relaxed legend-domino
  | CenterLine {}

// whether a stamp covers a kept cell
.type StampCover =
    // @claim keep
    StampOver {}
    // @rule keep: a kept cell other than background shows over the stamps
    // @witness stamp-on-ink: variant concept
    //     @relaxed clear-stamps
  | KeepOnTop {}

// what happens to key-colored cells that no domino keys
.type Keyless =
    // @claim erase
    KeepKeyless {}
    // @rule erase: every key-colored cell becomes background, keyed or not
    // @witness keyless-shape: variant any
    //     @relaxed legend-shape
  | EraseKeyColor {}

.type Choice = [colors: DominoColors, site: KeySite, cover: StampCover,
                keyless: Keyless]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed background
    .decl bg(c: Color) bg(0).
    .decl key(c: Color) key(8).
}

.init params = Params

// Every combination of the branches, less the ones that fail a pair: under
// AnchorTouch, a same-color pair next to a shape keys it in train0.
.decl impl_choice(ch: Choice)
impl_choice([$TwoColors(), S, C, Kl]) :-
    key_site_choice(S), stamp_cover_choice(C), keyless_choice(Kl).
impl_choice([$SameColorDomino(), S, C, Kl]) :-
    key_site_choice(S), S != $AnchorTouch(), stamp_cover_choice(C), keyless_choice(Kl).

.decl domino_colors_choice(d: DominoColors)
domino_colors_choice($TwoColors()). domino_colors_choice($SameColorDomino()).

.decl key_site_choice(s: KeySite)
key_site_choice($BoxSide()). key_site_choice($AnchorTouch()). key_site_choice($CenterLine()).

.decl stamp_cover_choice(c: StampCover)
stamp_cover_choice($StampOver()). stamp_cover_choice($KeepOnTop()).

.decl keyless_choice(k: Keyless)
keyless_choice($KeepKeyless()). keyless_choice($EraseKeyColor()).

.decl cleared(dc: DominoColors, s: KeySite, kl: Keyless, p: Position)
cleared(Dc, S, Kl, P) :-
    keyless_choice(Kl),
    ( legend_cell(Dc, S, P)
    ; key_domino(Dc, S, _, _, _, F), in(F, Col), in(P, Col)   // a source color
    ).

// The color a stamp shows at T.
.decl shown(dc: DominoColors, s: KeySite, c: StampCover, kl: Keyless,
            t: Position, col: Color)

out(P, Col, [Dc, S, C, Kl]) :-
    impl_choice([Dc, S, C, Kl]), in(P, Col_in),
    ( shown(Dc, S, C, Kl, P, Col)
    ; !shown(Dc, S, C, Kl, P, _), cleared(Dc, S, Kl, P), params.bg(Col)
    ; !shown(Dc, S, C, Kl, P, _), !cleared(Dc, S, Kl, P), Col = Col_in
    ).

.type Shape = [id: Ident]

// @claim legend-shape
.init shape = Components8<Unit>
shape.node($U(), P) :- in(P, Col), params.key(Col).

// A cell in a domino color: neither the background nor the key.
.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col), !params.key(Col).

// Near cell N and far cell F one step from N toward D, both ink, and the
// anchor A one step from N away from F.
.decl ink_pair(a: Position, n: Position, f: Position, d: Dir)
ink_pair(A, N, F, D) :-
    ink(N), opposite(D, D_back), neighbor(N, D, F), ink(F), neighbor(N, D_back, A).

// The dominoes under each domino-color reading.
.decl domino(dc: DominoColors, a: Position, n: Position, f: Position, d: Dir)

// The dominoes each key-site reading takes as keys of shape Id. Every key
// forms a legend with the shape.
.decl key_domino(dc: DominoColors, s: KeySite,
                 id: Ident, a: Position, n: Position, f: Position)

// The cells a legend holds: its shape, near, and far cells.
.decl legend_cell(dc: DominoColors, s: KeySite, p: Position)
legend_cell(Dc, S, P) :-
    key_domino(Dc, S, Id, _, N, F), ( shape.label($U(), P, Id) ; P = N ; P = F ).

// The target color Tg that a legend writes at T.
.decl write(dc: DominoColors, s: KeySite, t: Position, tg: Color)
write(Dc, S, T, Tg) :-
    key_domino(Dc, S, Id, A, N, F), in(F, Col), in(N, Tg),
    in(P, Col), !legend_cell(Dc, S, P),   // a scene cell of the source color
    shape.label($U(), X, Id), relative(A, X, V), compose(P, V, T).

// --- $TwoColors ---
domino($TwoColors(), A, N, F, D) :-
    ink_pair(A, N, F, D), in(N, Col), in(F, Col_f), Col != Col_f.

// --- $SameColorDomino ---
domino($SameColorDomino(), A, N, F, D) :- ink_pair(A, N, F, D).

// --- $BoxSide, $CenterLine ---
// @claim key-site
.init hull = Bbox<Shape>
hull.cell([Id], P) :- shape.label($U(), P, Id).

// The anchor lies on the box side facing the domino.
.decl side_key(dc: DominoColors, id: Ident,
               a: Position, n: Position, f: Position, d: Dir)
side_key(Dc, Id, A, N, F, D) :-
    domino(Dc, A, N, F, D), hull.box([Id], B), box_edge(A, B, D).

// --- $BoxSide ---
key_domino(Dc, $BoxSide(), Id, A, N, F) :- side_key(Dc, Id, A, N, F, _).

// --- $CenterLine ---
key_domino(Dc, $CenterLine(), Id, A, N, F) :-
    side_key(Dc, Id, A, N, F, D), hull.box([Id], B), crop(A, B, A_rel),
    perp_dir(D, E), dist_pair(A_rel, E, K, K).     // centered across D

// --- $AnchorTouch ---
key_domino(Dc, $AnchorTouch(), Id, A, N, F) :-
    domino(Dc, A, N, F, _), in(A, Col), ( params.bg(Col) ; params.key(Col) ),
    ( shape.label($U(), A, Id) ; shape.label($U(), Q, Id), neighbor(Q, _, A) ).

// --- $EraseKeyColor ---
cleared(Dc, S, $EraseKeyColor(), P) :-
    domino_colors_choice(Dc), key_site_choice(S), shape.label($U(), P, _).

// --- $StampOver ---
shown(Dc, S, $StampOver(), Kl, T, Col) :- write(Dc, S, T, Col), keyless_choice(Kl).

// --- $KeepOnTop ---
// A cell that keeps a color other than background.
.decl kept(dc: DominoColors, s: KeySite, kl: Keyless, p: Position)
kept(Dc, S, Kl, P) :-
    domino_colors_choice(Dc), key_site_choice(S), keyless_choice(Kl),
    in(P, Col), !params.bg(Col), !cleared(Dc, S, Kl, P).

shown(Dc, S, $KeepOnTop(), Kl, T, Col) :-
    write(Dc, S, T, Col), keyless_choice(Kl), !kept(Dc, S, Kl, T).
