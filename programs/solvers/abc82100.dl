// abc82100
// @draft
// @keywords: objects markers bbox mapping stamp rank
// @scene background: the background is params.bg
// @scene legend-shape: each legend has a shape drawn in params.key, one
//  8-connected component of that color. The key color occurs nowhere else.
// @scene legend-domino: next to each shape, outside its bounding box on the
//  box's center line, sits a domino of two cells in two colors other than the
//  background and the key. The domino lies on the axis that runs out from the
//  box. Its near cell touches the box edge, and its far cell is one step
//  further out.
// @scene legend-pair: the far cell's color is the source color, and the near
//  cell's color is the target color. Each source color belongs to one legend.
// @scene scene-cells: outside the legends, the grid has single cells of source
//  colors, and it can have cells of other colors
// @scene clear-stamps: no two stamps of different target colors write one
//  cell, and no stamp writes a cell that keeps a color other than background
// @rule key-site: a domino is a key of a shape when its near cell lies just
//  outside the shape's bounding box, within the box's row or column span, and
//  its far cell lies one step further out. Every key forms a legend with the
//  shape.
// @rule anchor: the anchor of a legend is the cell one step past the near
//  cell, away from the far cell
// @rule erase: every legend cell (shape, near, far) and every cell of a
//  source color becomes background
// @rule stamp: for each scene cell of a source color, the shape of that
//  color's legend is drawn in the legend's target color, moved so that the
//  anchor lands on that cell. Cells that fall off the grid are dropped. All
//  stamps read the input, so the stamps do not chain.
// @rule keep: every other cell keeps its input color

// whether a domino's two cells can share a color
.type DominoColors =
    // @claim legend-domino
    TwoColors {}
    // @scene legend-domino: the domino's two cells can share a color, which
    //  is then both the source and the target color
    // @witness same-color: borderline concept
    //     @relaxed legend-domino
  | SameColorDomino {}

// which dominoes are keys of a shape
.type KeySite =
    // @claim key-site
    BoxSide {}
    // @rule key-site: a domino is a key of a shape when its anchor is a shape
    //  cell or 8-adjacent to one, and holds the background or the key color.
    //  The domino can point from any side, and it need not touch the box.
    // @witness wide-mouth: variant concept
  | AnchorTouch {}
    // @rule key-site: the near cell also sits on the box's center row or
    //  center column
    // @witness off-center: variant concept
    //     @relaxed legend-domino
  | CenterLine {}

// which keys of a shape form legends
.type KeysPerShape =
    // @claim key-site
    EveryKey {}
    // @rule key-site: only the first key of a shape, in params.key_order,
    //  forms a legend. The other dominoes and their source cells keep their
    //  colors.
    // @witness two-keys: borderline concept
    //     @relaxed legend-domino
  | FirstKey {}

// which color a cell takes when stamps of two target colors write it
.type StampOrder =
    // @claim stamp
    Unordered {}
    // @rule stamp: where stamps overlap, the stamp of the legend that comes
    //  later covers the earlier one. Legends are ordered by the first cell of
    //  their shape, then by their near cell, in params.layer_order.
    // @witness stamp-clash: variant any
    //     @relaxed clear-stamps
  | ScanOrder {}

// whether a stamp covers a kept cell
.type StampCover =
    // @claim keep
    StampOver {}
    // @rule keep: a kept cell other than background shows over the stamps
    // @witness stamp-on-ink: variant concept
    //     @relaxed clear-stamps
  | KeepOnTop {}

// what happens to key-colored cells that no domino keys
.type Keyless =
    // @claim erase
    KeepKeyless {}
    // @rule erase: every key-colored cell becomes background, keyed or not
    // @witness keyless-shape: variant any
    //     @relaxed legend-shape
  | EraseKeyColor {}

.type Choice = [colors: DominoColors, site: KeySite, per_shape: KeysPerShape,
                order: StampOrder, cover: StampCover, keyless: Keyless]

.type KeyOrderValue = [c: DiagDir, a: Axis]
.type LayerOrderValue = [c: DiagDir, a: Axis]
.type OpenValue = [key_order: KeyOrderValue, layer_order: LayerOrderValue]

.decl out(p: Position, col: Color, ch: Choice, v: OpenValue)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed background
    // @ignore: derive concept — subsumed by ScanOrder & bg=DominantColor
    .decl bg(c: Color) bg(0).
    .decl key(c: Color) key(8).

    // --- $FirstKey ---
    // The reading order, from corner c along axis a, whose first key of a
    // shape forms the legend. No pair has two keys on one shape, so every
    // order stays open.
    // @open
    .decl key_order(c: DiagDir, a: Axis)
    key_order(DIAG_TL, AXIS_V). key_order(DIAG_TL, AXIS_H). key_order(DIAG_TR, AXIS_V).
    key_order(DIAG_TR, AXIS_H). key_order(DIAG_BL, AXIS_V). key_order(DIAG_BL, AXIS_H).
    key_order(DIAG_BR, AXIS_V). key_order(DIAG_BR, AXIS_H).

    // --- $ScanOrder ---
    // The reading order of the legends, from corner c along axis a. No pair
    // has overlapping stamps, so every order stays open.
    // @open
    .decl layer_order(c: DiagDir, a: Axis)
    layer_order(DIAG_TL, AXIS_V). layer_order(DIAG_TL, AXIS_H). layer_order(DIAG_TR, AXIS_V).
    layer_order(DIAG_TR, AXIS_H). layer_order(DIAG_BL, AXIS_V). layer_order(DIAG_BL, AXIS_H).
    layer_order(DIAG_BR, AXIS_V). layer_order(DIAG_BR, AXIS_H).
}

.init params = Params

// The concept case, and every combination under ScanOrder less the ones that
// fail a pair: under AnchorTouch, a same-color pair next to a shape keys it
// in train0. Where Unordered is defined, ScanOrder gives its output, so
// Unordered is only in the concept case.
.decl impl_choice(ch: Choice)
impl_choice([$TwoColors(), $BoxSide(), $EveryKey(), $Unordered(), $StampOver(), $KeepKeyless()]).
impl_choice([$TwoColors(), S, K, $ScanOrder(), C, Kl]) :-
    key_site_choice(S), keys_per_shape_choice(K), stamp_cover_choice(C), keyless_choice(Kl).
impl_choice([$SameColorDomino(), S, K, $ScanOrder(), C, Kl]) :-
    key_site_choice(S), S != $AnchorTouch(), keys_per_shape_choice(K),
    stamp_cover_choice(C), keyless_choice(Kl).

.decl domino_colors_choice(d: DominoColors)
domino_colors_choice($TwoColors()). domino_colors_choice($SameColorDomino()).

.decl key_site_choice(s: KeySite)
key_site_choice($BoxSide()). key_site_choice($AnchorTouch()). key_site_choice($CenterLine()).

.decl keys_per_shape_choice(k: KeysPerShape)
keys_per_shape_choice($EveryKey()). keys_per_shape_choice($FirstKey()).

.decl stamp_cover_choice(c: StampCover)
stamp_cover_choice($StampOver()). stamp_cover_choice($KeepOnTop()).

.decl keyless_choice(k: Keyless)
keyless_choice($KeepKeyless()). keyless_choice($EraseKeyColor()).

.decl cleared(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue, kl: Keyless,
              p: Position)
cleared(Dc, S, K, Ko, Kl, P) :-
    keyless_choice(Kl),
    ( legend_cell(Dc, S, K, Ko, P)
    ; legend(Dc, S, K, Ko, _, _, _, F), in(F, Col), in(P, Col)   // a source color
    ).

// The open values of the key order each keys-per-shape reading is derived
// at.
.decl key_value(k: KeysPerShape, ko: KeyOrderValue)

// The open values of the layer order each stamp-order reading is derived at.
.decl layer_value(o: StampOrder, lo: LayerOrderValue)

// The color a stamp gives T under each stamp-order reading, at open value V.
.decl paint(dc: DominoColors, s: KeySite, k: KeysPerShape, o: StampOrder, v: OpenValue,
            t: Position, col: Color)

// The color a stamp shows at T.
.decl shown(dc: DominoColors, s: KeySite, k: KeysPerShape, o: StampOrder, c: StampCover,
            kl: Keyless, v: OpenValue, t: Position, col: Color)

out(P, Col, [Dc, S, K, O, C, Kl], [Ko, Lo]) :-
    impl_choice([Dc, S, K, O, C, Kl]), key_value(K, Ko), layer_value(O, Lo), in(P, Col_in),
    ( shown(Dc, S, K, O, C, Kl, [Ko, Lo], P, Col)
    ; !shown(Dc, S, K, O, C, Kl, [Ko, Lo], P, _), cleared(Dc, S, K, Ko, Kl, P), params.bg(Col)
    ; !shown(Dc, S, K, O, C, Kl, [Ko, Lo], P, _), !cleared(Dc, S, K, Ko, Kl, P), Col = Col_in
    ).

// The legends of each reading and the stamps they write, under every key
// order and every reading order.
.type Shape = [id: Ident]
.type KeyScan = [dc: DominoColors, s: KeySite, id: Ident, corner: DiagDir, axis: Axis]
.type Scan = [corner: DiagDir, axis: Axis]

// @claim legend-shape
.init shape = Components8<Unit>
shape.node($U(), P) :- in(P, Col), params.key(Col).

// A cell in a domino color: neither the background nor the key.
.decl ink(p: Position)
ink(P) :- in(P, Col), !params.bg(Col), !params.key(Col).

// Near cell N and far cell F one step from N toward D, both ink, and the
// anchor A one step from N away from F.
.decl ink_pair(a: Position, n: Position, f: Position, d: Dir)
ink_pair(A, N, F, D) :-
    ink(N), opposite(D, D_back), neighbor(N, D, F), ink(F), neighbor(N, D_back, A).

// The dominoes under each domino-color reading.
.decl domino(dc: DominoColors, a: Position, n: Position, f: Position, d: Dir)

// The dominoes each key-site reading takes as keys of shape Id.
.decl key_domino(dc: DominoColors, s: KeySite,
                 id: Ident, a: Position, n: Position, f: Position)

// The legends each reading forms, at open value ko of the key order
// where the reading reads it.
.decl legend(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue,
             id: Ident, a: Position, n: Position, f: Position)

// The cells a legend holds: its shape, near, and far cells.
.decl legend_cell(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue,
                  p: Position)
legend_cell(Dc, S, K, Ko, P) :-
    legend(Dc, S, K, Ko, Id, _, N, F), ( shape.label($U(), P, Id) ; P = N ; P = F ).

// Legend (Id, N) writes its target color Tg at T.
.decl write(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue,
            t: Position, id: Ident, n: Position, tg: Color)
write(Dc, S, K, Ko, T, Id, N, Tg) :-
    legend(Dc, S, K, Ko, Id, A, N, F), in(F, Col), in(N, Tg),
    in(P, Col), !legend_cell(Dc, S, K, Ko, P),   // a scene cell of the source color
    shape.label($U(), X, Id), relative(A, X, V), compose(P, V, T).

// --- $TwoColors ---
domino($TwoColors(), A, N, F, D) :-
    ink_pair(A, N, F, D), in(N, Col), in(F, Col_f), Col != Col_f.

// --- $SameColorDomino ---
domino($SameColorDomino(), A, N, F, D) :- ink_pair(A, N, F, D).

// --- $BoxSide, $CenterLine ---
// @claim key-site
.init hull = Bbox<Shape>
hull.cell([Id], P) :- shape.label($U(), P, Id).

// The anchor lies on the box side facing the domino.
.decl side_key(dc: DominoColors, id: Ident,
               a: Position, n: Position, f: Position, d: Dir)
side_key(Dc, Id, A, N, F, D) :-
    domino(Dc, A, N, F, D), hull.box([Id], B), box_edge(A, B, D).

// --- $BoxSide ---
key_domino(Dc, $BoxSide(), Id, A, N, F) :- side_key(Dc, Id, A, N, F, _).

// --- $CenterLine ---
key_domino(Dc, $CenterLine(), Id, A, N, F) :-
    side_key(Dc, Id, A, N, F, D), hull.box([Id], B), crop(A, B, A_rel),
    perp_dir(D, E), dist_pair(A_rel, E, K, K).     // centered across D

// --- $AnchorTouch ---
key_domino(Dc, $AnchorTouch(), Id, A, N, F) :-
    domino(Dc, A, N, F, _), in(A, Col), ( params.bg(Col) ; params.key(Col) ),
    ( shape.label($U(), A, Id) ; shape.label($U(), Q, Id), neighbor(Q, _, A) ).

// --- $EveryKey ---
legend(Dc, S, $EveryKey(), nil, Id, A, N, F) :- key_domino(Dc, S, Id, A, N, F).

// --- $FirstKey ---
// The near cells of a shape's keys, in each order.
// @claim key-site
.init key_scan = LexOrder<KeyScan>
key_scan.corner([Dc, S, Id, C, A], C) :- key_scan.cell([Dc, S, Id, C, A], _).
key_scan.axis([Dc, S, Id, C, A], A) :- key_scan.cell([Dc, S, Id, C, A], _).
key_scan.cell([Dc, S, Id, C, A], N) :-
    key_domino(Dc, S, Id, _, N, _), diag_dir_elem(C), axis_elem(A).

// The first key of each shape under each key order in use.
legend(Dc, S, $FirstKey(), [C, A_k], Id, A, N, F) :-
    params.key_order(C, A_k), key_scan.first([Dc, S, Id, C, A_k], N),
    key_domino(Dc, S, Id, A, N, F).

// --- $ScanOrder ---
// The grid's cells, in each order.
// @claim stamp
.init layer = LexOrder<Scan>
layer.corner([C, A], C) :- layer.cell([C, A], _).
layer.axis([C, A], A) :- layer.cell([C, A], _).
layer.cell([C, A], P) :- in(P, _), diag_dir_elem(C), axis_elem(A).

// Some cell of shape Id comes before P.
.decl trailing(c: DiagDir, a: Axis, id: Ident, p: Position)
trailing(C, A, Id, P) :-
    shape.label($U(), P, Id), shape.label($U(), Q, Id),
    layer.rank([C, A], Q, R1), layer.rank([C, A], P, R2), R1 < R2.

// The first cell of each shape.
.decl lead(c: DiagDir, a: Axis, id: Ident, p: Position)
lead(C, A, Id, P) :-
    shape.label($U(), P, Id), layer.elem([C, A], P), !trailing(C, A, Id, P).

// A later legend also writes T.
.decl buried(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue,
             c: DiagDir, a: Axis, t: Position, id: Ident, n: Position)
buried(Dc, S, K, Ko, C, A, T, Id, N) :-
    write(Dc, S, K, Ko, T, Id, N, _), write(Dc, S, K, Ko, T, Id2, N2, _),
    lead(C, A, Id, P), lead(C, A, Id2, P2),
    ( layer.rank([C, A], P, R1), layer.rank([C, A], P2, R2), R1 < R2   // a later shape
    ; Id = Id2,                                                         // the same shape,
      layer.rank([C, A], N, R1), layer.rank([C, A], N2, R2), R1 < R2   // a later near cell
    ).

// --- $EveryKey ---
key_value($EveryKey(), nil).

// --- $FirstKey ---
key_value($FirstKey(), [C, A]) :- params.key_order(C, A).

// --- $EraseKeyColor ---
cleared(Dc, S, K, Ko, $EraseKeyColor(), P) :-
    domino_colors_choice(Dc), key_site_choice(S), key_value(K, Ko), shape.label($U(), P, _).

// --- $Unordered ---
layer_value($Unordered(), nil).

paint(Dc, S, K, $Unordered(), [Ko, nil], T, Col) :- write(Dc, S, K, Ko, T, _, _, Col).

// --- $ScanOrder ---
layer_value($ScanOrder(), [C, A]) :- params.layer_order(C, A).

paint(Dc, S, K, $ScanOrder(), [Ko, [C, A]], T, Col) :-
    write(Dc, S, K, Ko, T, Id, N, Col), params.layer_order(C, A),
    !buried(Dc, S, K, Ko, C, A, T, Id, N).

// --- $StampOver ---
shown(Dc, S, K, O, $StampOver(), Kl, V, T, Col) :-
    paint(Dc, S, K, O, V, T, Col), keyless_choice(Kl).

// --- $KeepOnTop ---
// A cell that keeps a color other than background.
.decl kept(dc: DominoColors, s: KeySite, k: KeysPerShape, ko: KeyOrderValue, kl: Keyless,
           p: Position)
kept(Dc, S, K, Ko, Kl, P) :-
    domino_colors_choice(Dc), key_site_choice(S), key_value(K, Ko), keyless_choice(Kl),
    in(P, Col), !params.bg(Col), !cleared(Dc, S, K, Ko, Kl, P).

shown(Dc, S, K, O, $KeepOnTop(), Kl, [Ko, Lo], T, Col) :-
    paint(Dc, S, K, O, [Ko, Lo], T, Col), keyless_choice(Kl), !kept(Dc, S, K, Ko, Kl, T).
