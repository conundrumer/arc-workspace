// 6ea4a07e
// concept: mapping
// Recolor a binary input: bg cells take a fill color derived from the input's
// fg via a fixed mapping; fg cells become bg.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color) bg(0).

    .decl recolor(c_fg: Color, c_fill: Color)
    recolor(3, 1).
    recolor(5, 4).
    recolor(8, 2).
}

.init c = Consts

.decl fill(c: Color)
fill(Out) :- in(_, Col), c.recolor(Col, Out).

.decl out(p: Position, col: Color)
out(P, Fill) :- in(P, Col), c.bg(Col), fill(Fill).
out(P, Bg)   :- in(P, Col), !c.bg(Col), c.bg(Bg).
