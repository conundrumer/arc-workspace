// 6ea4a07e
// keywords: mapping
// output: Recolor a binary input: bg cells take a fill color derived from the
//  input's fg via a fixed mapping; fg cells become bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(c: Color) bg(0).

    .decl recolor(c_fg: Color, c_fill: Color)
    recolor(3, 1).
    recolor(5, 4).
    recolor(8, 2).
}

.init params = Params

.decl fill(c: Color)
fill(Out) :- in(_, Col), params.recolor(Col, Out).

out(P, Fill) :- in(P, Col), params.bg(Col), fill(Fill).
out(P, Bg)   :- in(P, Col), !params.bg(Col), params.bg(Bg).
