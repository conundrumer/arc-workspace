// 77fdfe62
// concept: decompose crop markers classify select
// Corner colors sit in the grid's corner cells; separator lines fence an
// ink-mask interior. The output is the interior alone, each ink cell
// taking the corner color of its quadrant. Two independent nodes, tagged
// on out's Choice:
//
//   interior — $Lines: cells fenced off by full separator lines on all
//              four sides; $Margin: cells at least params.margin inside.
//   blank    — non-ink interior cells: $Pass passes them through; $Bg
//              writes params.bg.

#include "../lib.dl"

.type Interior = Lines {} | Margin {}
.type Blank = Pass {} | Bg {}
.type Choice = [interior: Interior, blank: Blank]

.comp Params {
    // --- shared ---
    .decl ink(c: Color) ink(8).

    // --- $Lines ---
    .decl line(c: Color) line(1).

    // --- $Margin ---
    .decl margin(k: number) margin(2).

    // --- $Bg ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// The four corner colors, keyed by their corner.
.decl corner_color(diag: DiagDir, col: Color)
corner_color(Diag, Col) :- in(P, Col), corner_dist(P, Diag, 0).

// The interior in its own frame; each hypothesis supplies the margins the grid
// keeps outside it.
.init frame = MarginFrame<Interior>

// --- $Lines ---

// A line lies across axis a, at the axis-only position l. Its defect: a cell
// off the separator color.
.decl off_line(a: Axis, l: Position)
off_line(A, L) :- in(P, Col), !params.line(Col), axis_elem(A), split(P, A, L, _).

// The parts the separator lines cut the grid into.
.init cut = DividerFrame<Unit>
cut.cell($U(), P) :- in(P, _).
cut.divider($U(), A, L) :-
    in(P, _), axis_elem(A), split(P, A, L, _),   // a line across axis A
    !off_line(A, L).                             // every cell the separator color

// A separator line stands between p and edge d: p's part is not the
// outermost one toward d.
.decl screened(p: Position, d: Dir)
screened(P, D) :- cut.part_idx($U(), P, D, N), N != 0.

.decl unscreened(p: Position)
unscreened(P) :- in(P, _), dir_elem(D), !screened(P, D).

// The cells a separator line screens from every edge.
.decl fenced(p: Position)
fenced(P) :- in(P, _), !unscreened(P).

.init box = Bbox<Unit>
box.cell($U(), P) :- fenced(P).

frame.cell($Lines(), P) :- fenced(P).
frame.width($Lines(), D, K) :- box.edge_min($U(), D, K).

// --- $Margin ---

frame.cell($Margin(), P) :- in(P, _).
frame.width($Margin(), D, K) :- dir_elem(D), params.margin(K).

// Quadrants of the interior, in its own frame.
.init quad = DiagPlacement<Interior>
quad.cell(Ic, I) :- frame.inner(Ic, _, I).

.decl blank_elem(b: Blank)
blank_elem($Pass()). blank_elem($Bg()).

.decl out(p: Position, col: Color, ch: Choice)

// Ink takes the corner color of its quadrant.
out(I, Col, [Ic, Bl]) :-
    in(P, Ink), params.ink(Ink), frame.inner(Ic, P, I),   // interior ink cell
    quad.quadrant(Ic, I, Diag), corner_color(Diag, Col),
    blank_elem(Bl).                                  // ink reads the same under either blank claim

// --- $Pass ---

out(I, Col, [Ic, $Pass()]) :- in(P, Col), !params.ink(Col), frame.inner(Ic, P, I).

// --- $Bg ---

out(I, Col, [Ic, $Bg()]) :- in(P, C0), !params.ink(C0), frame.inner(Ic, P, I), params.bg(Col).

// --- determination ---

.comp Determine {
    // The line-fenced interior — the boundary both interior hypotheses read.
    .decl off_line(e: Example, a: Axis, l: Position)
    off_line(E, A, L) :-
        ex_in(E, P, Col), !params.line(Col), axis_elem(A), split(P, A, L, _).

    .init cut = DividerFrame<Example>
    cut.cell(E, P) :- ex_in(E, P, _).
    cut.divider(E, A, L) :-
        ex_in(E, P, _), axis_elem(A), split(P, A, L, _),   // a line across axis A
        !off_line(E, A, L).                                // every cell the separator color

    .decl screened(e: Example, p: Position, d: Dir)
    screened(E, P, D) :- cut.part_idx(E, P, D, N), N != 0.

    .decl unscreened(e: Example, p: Position)
    unscreened(E, P) :- ex_in(E, P, _), dir_elem(D), !screened(E, P, D).

    .decl interior(e: Example, p: Position)
    interior(E, P) :- ex_in(E, P, _), !unscreened(E, P).

    .init box = Bbox<Example>
    box.cell(E, P) :- interior(E, P).

    // The fenced interior stands the same depth in from every edge of every
    // example, so that depth is the margin.
    .decl margin(k: number)
    margin(K) :- box.edge_min(_, _, K).
}
