// 77fdfe62
// concept: decompose crop markers classify select
// Corner colors sit in the grid's corner cells; separator lines fence an
// ink-mask interior. The output is the interior alone, each ink cell
// taking the corner color of its quadrant. Two independent nodes, tagged
// on out's Choice:
//
//   interior — $Lines: cells fenced off by full separator lines on all
//              four sides; $Margin: cells at least params.margin inside.
//   blank    — non-ink interior cells: $Pass passes them through; $Bg
//              writes params.bg.

#include "../lib.dl"

.type Interior = Lines {} | Margin {}
.type Blank = Pass {} | Bg {}
.type Choice = [interior: Interior, blank: Blank]

.comp Params {
    // --- shared ---
    .decl ink(c: Color) ink(8).

    // --- $Lines ---
    .decl line(c: Color) line(1).

    // --- $Margin ---
    .decl margin(k: number) margin(2).

    // --- $Bg ---
    .decl bg(c: Color) bg(0).
}

.init params = Params

// The four corner colors, keyed by their corner.
.decl corner_color(diag: DiagDir, col: Color)
corner_color(Diag, Col) :- in(P, Col), corner_dist(P, Diag, 0).

// The interior in its own frame; each hypothesis supplies the margins the grid
// keeps outside it.
.decl interior_cell(ic: Interior, p: Position, p_inner: Position)

// --- $Lines ---

// The line-fenced interior, read the same way from the grid and from an
// example.
.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    // A line lies across axis a, at the axis-only position l. Its defect: a cell
    // off the separator color.
    .decl off_line(key: Key, a: Axis, l: Position)
    off_line(K, A, L) :-
        cell(K, P, Col), !params.line(Col), axis_elem(A), split(P, A, L, _).

    // The parts the separator lines cut the grid into.
    .init cut = DividerTiles<Key>
    cut.cell(K, P) :- cell(K, P, _).
    cut.divider(K, A, L) :-
        cell(K, P, _), axis_elem(A), split(P, A, L, _),   // a line across axis A
        !off_line(K, A, L).                               // every cell the separator color

    // A separator line stands between p and edge d: p's part is not the
    // outermost one toward d.
    .decl screened(key: Key, p: Position, d: Dir)
    screened(K, P, D) :- cut.part_idx(K, P, D, N), N != 0.

    .decl unscreened(key: Key, p: Position)
    unscreened(K, P) :- cell(K, P, _), dir_elem(D), !screened(K, P, D).

    // The cells a separator line screens from every edge.
    .decl fenced(key: Key, p: Position)
    fenced(K, P) :- cell(K, P, _), !unscreened(K, P).

    .init fence_box = Bbox<Key>
    fence_box.cell(K, P) :- fenced(K, P).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

interior_cell($Lines(), P, P_inner) :-
    parse.fenced($U(), P), parse.fence_box.box($U(), B), crop(P, B, P_inner).

// --- $Margin ---

interior_cell($Margin(), P, P_inner) :-
    in(P, _), params.margin(K), uniform_inset(K, B), crop(P, B, P_inner).

// Quadrants of the interior, in its own frame.
.init quad = DiagPlacement<Interior>
quad.cell(Ic, P_inner) :- interior_cell(Ic, _, P_inner).

.decl blank_elem(b: Blank)
blank_elem($Pass()). blank_elem($Bg()).

.decl out(p: Position, col: Color, ch: Choice)

// Ink takes the corner color of its quadrant.
out(P_inner, Col, [Ic, Bl]) :-
    in(P, Ink), params.ink(Ink), interior_cell(Ic, P, P_inner),  // interior ink cell
    quad.quadrant(Ic, P_inner, Diag), corner_color(Diag, Col),
    blank_elem(Bl).                                              // ink reads the same under either blank claim

// --- $Pass ---

out(P_inner, Col, [Ic, $Pass()]) :-
    in(P, Col), !params.ink(Col), interior_cell(Ic, P, P_inner).

// --- $Bg ---

out(P_inner, Col, [Ic, $Bg()]) :-
    in(P, C0), !params.ink(C0), interior_cell(Ic, P, P_inner), params.bg(Col).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).

    // The fenced interior stands the same depth in from every edge of every
    // example, so that depth is the margin.
    .decl margin(k: number)
    margin(K) :- parse.fence_box.box(_, B), dir_elem(D), dist(B, D, K).
}
