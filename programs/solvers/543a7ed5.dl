// 543a7ed5
// @draft
// @keywords: objects enclose border
// input: Shapes of a non-bg color sit on a bg field, and each shape keeps
//  its own cells.
// output: Two classes of bg are repainted: the bg a shape holds inside
//  itself turns params.fill, and the bg just outside a shape turns
//  params.outline.

// which bg counts as inside a shape
.type Fill =
    // the bg that no shape lets reach the grid edge
    Enclosed {}
    // the bg inside a shape's bounding box
  | Boxed {}

// which bg counts as just outside a shape
.type Outline =
    // the outside bg one 8-step off a shape cell
    Band {}
    // the band ring_width out from a shape's bounding box
  | Ring {}

// crosses the two readings: fill, the bg inside; outline, the bg just outside
.type Choice = [fill: Fill, outline: Outline]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(8).
    .decl fill(c: Color) fill(4).
    .decl outline(c: Color) outline(3).

    // --- $Ring ---
    .decl ring_width(k: number) ring_width(1).
}

.init params = Params

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), params.bg(Col).

.decl shape_cell(p: Position)
shape_cell(P) :- in(P, Col), !params.bg(Col).

// The bg the shapes leave open to the grid edge.
.init outside = Reach<Unit>
outside.node($U(), P) :- bg_cell(P).
outside.seed($U(), P) :- bg_cell(P), dir_elem(D), dist(P, D, 0).    // on the grid edge

// Each shape and the box that bounds it.
.init shape = Components<Unit>
shape.node($U(), P) :- shape_cell(P).

.init shape_box = Bbox<Ident>
shape_box.cell(Id, P) :- shape.label($U(), P, Id).

// A grid cell a shape's box covers.
.decl within(id: Ident, p: Position)
within(Id, P) :- in(P, _), shape_box.box(Id, B), inside(P, B).

// --- fill ---

.decl fill_cell(p: Position, f: Fill)
fill_cell(P, $Enclosed()) :- bg_cell(P), !outside.reach($U(), P).
fill_cell(P, $Boxed()) :- bg_cell(P), within(_, P).

// --- outline ---

.decl ring_box(id: Ident, b: Box)
ring_box(Id, B) :-
    shape_box.box(Id, B_shape),
    params.ring_width(K), uniform_outset(K, B_frame),  // the frame let out by the ring's width
    compose(B_frame, B_shape, B).                      // the shape's box seated in it

.decl ring(id: Ident, p: Position)
ring(Id, P) :- in(P, _), ring_box(Id, B), inside(P, B), !within(Id, P).

.decl outline_cell(p: Position, o: Outline)
outline_cell(P, $Band()) :-
    outside.reach($U(), P),                                       // bg outside the shapes
    shape_cell(P_shape), dir8_elem(D), neighbor(P_shape, D, P).   // one step off a shape
outline_cell(P, $Ring()) :- bg_cell(P), ring(_, P).

// --- output ---

// Every shape in the pairs is a rectangle with a solid border, and that
// separates neither class, so $Boxed with $Band is left out: where a box's
// border is not a solid shape, some bg cell on that border is both inside
// the box and one step off the shape, so the two readings claim it for
// different colors. Where the border is solid, that combination agrees with
// $Boxed and $Ring everywhere.
.decl impl_choice(ch: Choice)
impl_choice([$Enclosed(), $Band()]).
impl_choice([$Enclosed(), $Ring()]).
impl_choice([$Boxed(), $Ring()]).

out(P, Col, [F, O]) :- impl_choice([F, O]), fill_cell(P, F), params.fill(Col).
out(P, Col, [F, O]) :- impl_choice([F, O]), outline_cell(P, O), params.outline(Col).
out(P, Col, [F, O]) :-
    impl_choice([F, O]), in(P, Col),
    !fill_cell(P, F), !outline_cell(P, O).    // a cell the model leaves alone
