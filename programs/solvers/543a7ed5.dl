// 543a7ed5
// draft
// concept: objects enclose border
// Shapes of a non-bg color sit on a bg field, and each shape keeps its own
// cells. Two classes of bg are repainted: the bg a shape holds inside itself
// turns params.fill, and the bg just outside a shape turns params.outline.
//
// Every shape in the pairs is a rectangle with a solid border, and that
// separates neither class. Choice crosses the two readings of each:
//
//   fill (the bg inside)
//     $Enclosed() — the bg that no shape lets reach the grid edge.
//     $Boxed()    — the bg inside a shape's bounding box.
//   outline (the bg just outside)
//     $Band()     — the outside bg one 8-step off a shape cell.
//     $Ring()     — the band one cell out from a shape's bounding box.
//
// $Boxed with $Band is left out. Where a box's border is not solid shape,
// some bg cell on that border is both inside the box and one step off the
// shape, so the two readings claim it for different colors. Where the border
// is solid, that combination agrees with $Boxed and $Ring everywhere.

#include "../lib.dl"

.type Fill = Enclosed {} | Boxed {}
.type Outline = Band {} | Ring {}
.type Choice = [fill: Fill, outline: Outline]

.comp Params {
    // --- shared ---
    .decl bg(c: Color) bg(8).
    .decl fill(c: Color) fill(4).
    .decl outline(c: Color) outline(3).

    // --- $Ring ---
    .decl ring_width(k: number) ring_width(1).
}

.init params = Params

.decl bg_cell(p: Position)
bg_cell(P) :- in(P, Col), params.bg(Col).

.decl shape_cell(p: Position)
shape_cell(P) :- in(P, Col), !params.bg(Col).

// The bg the shapes leave open to the grid edge.
.init outside = Reach<Unit>
outside.node($U(), P) :- bg_cell(P).
outside.seed($U(), P) :- bg_cell(P), dir_elem(D), dist(P, D, 0).    // on the grid edge

// Each shape and the box that bounds it.
.init shape = Components<Unit>
shape.node($U(), P) :- shape_cell(P).

.init shape_box = Bbox<Ident>
shape_box.cell(Id, P) :- shape.label($U(), P, Id).
shape_box.grid(Id, P) :- shape.label($U(), _, Id), in(P, _).

// --- fill ---

.decl fill_cell(p: Position, f: Fill)
fill_cell(P, $Enclosed()) :- bg_cell(P), !outside.reach($U(), P).
fill_cell(P, $Boxed()) :- bg_cell(P), shape_box.inside(_, P).

// --- outline ---

.decl ring_box(id: Ident, b: Position)
ring_box(Id, B) :-
    shape_box.margin(Id, M),
    params.ring_width(K), uniform_delta(K, W), displacement(W, M, B).  // the box let out

.decl ring(id: Ident, p: Position)
ring(Id, P) :- in(P, _), ring_box(Id, B), geq(P, B), !shape_box.inside(Id, P).

.decl outline_cell(p: Position, o: Outline)
outline_cell(P, $Band()) :-
    outside.reach($U(), P),                             // bg outside the shapes
    shape_cell(M), dir8_elem(D), neighbor(M, D, P).     // one step off a shape
outline_cell(P, $Ring()) :- bg_cell(P), ring(_, P).

// --- output ---

.decl impl_choice(ch: Choice)
impl_choice([$Enclosed(), $Band()]).
impl_choice([$Enclosed(), $Ring()]).
impl_choice([$Boxed(), $Ring()]).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, [F, O]) :- impl_choice([F, O]), fill_cell(P, F), params.fill(Col).
out(P, Col, [F, O]) :- impl_choice([F, O]), outline_cell(P, O), params.outline(Col).
out(P, Col, [F, O]) :-
    impl_choice([F, O]), in(P, Col),
    !fill_cell(P, F), !outline_cell(P, O).    // a cell the model leaves alone
