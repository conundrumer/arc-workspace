// f5b8619d
// @keywords: tile-arrangement lines markers
// output: One marker color over bg. Bg cells on a marker's params.axis line
//  repaint params.shade; markers pass through. Output is the repainted grid
//  arranged per params.tile.

.decl out(p: Position, col: Color)

.comp Params {
    .init helpers = ParamsHelpers

    .decl bg(c: Color) bg(0).
    .decl shade(c: Color) shade(8).
    .decl axis(a: Axis) axis(AXIS_V).

    // 2×2 tile arrangement.
    .decl tile_dim(k: number) tile_dim(2).
    .decl tile(p: Position)
    tile(P) :- tile_dim(K), helpers.frame_pos([K, K], P).
}

.init params = Params

// Bg cell on a marker's line.
.decl marked(p: Position)
marked(P) :-
    in(P, Col), params.bg(Col),        // bg cell
    in(Q, M), !params.bg(M),           // a marker
    params.axis(A), same_line(A, P, Q).

.decl repainted(p: Position, col: Color)
repainted(P, C)   :- marked(P), params.shade(C).
repainted(P, Col) :- in(P, Col), !marked(P).

out(P_grid_out, Col) :-
    repainted(P_in, Col),                      // repainted-input cell
    params.tile(P_tile),                       // tile-frame pos
    concat_2d(P_tile, P_in, 0, P_grid_out).    // recompose
