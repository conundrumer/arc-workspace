// f5b8619d
// concept: tile-arrangement lines markers
// One marker color over bg. Bg cells on a marker's c.axis line repaint
// c.shade; markers pass through. Output is the repainted grid arranged
// per c.tile.

#include "../lib.dl"

.comp Consts {
    .init helpers = ConstsHelpers

    .decl bg(c: Color) bg(0).
    .decl shade(c: Color) shade(8).
    .decl axis(a: Axis) axis(AXIS_V).

    // 2×2 tile arrangement.
    .decl tile_dim(k: number) tile_dim(2).
    .decl tile(p: Position)
    tile(P) :- tile_dim(K), helpers.frame_pos([K, K], P).
}

.init c = Consts

// Bg cell on a marker's line.
.decl marked(p: Position)
marked(P) :-
    in(P, Col), c.bg(Col),        // bg cell
    in(Q, M), !c.bg(M),           // a marker
    c.axis(A), same_line(A, P, Q).

.decl repainted(p: Position, col: Color)
repainted(P, C)   :- marked(P), c.shade(C).
repainted(P, Col) :- in(P, Col), !marked(P).

.decl out(p: Position, col: Color)
out(P_grid_out, Col) :-
    repainted(P_in, Col),                      // repainted-input cell
    c.tile(P_tile),                            // tile-frame pos
    concat_2d(P_tile, P_in, 0, P_grid_out).    // recompose
