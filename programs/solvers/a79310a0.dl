// a79310a0
// @keywords: move
// output: The ink shape translates params.shift_k toward params.shift_dir and
//  recolors to params.mark; the rest of the grid is params.bg.

.decl out(p: Position, col: Color)

.comp Params {
    .decl ink(c: Color) ink(8).
    .decl mark(c: Color) mark(2).
    .decl bg(c: Color) bg(0).

    .decl shift_dir(d: Dir) shift_dir(DIR_B).
    .decl shift_k(k: number) shift_k(1).
}

.init params = Params

// Image of the ink under the shift, restricted to in-frame positions.
.decl shift_image(p: Position)
shift_image(P_out) :-
    in(P_in, Col), params.ink(Col),
    params.shift_dir(D), params.shift_k(K), jump(P_in, D, K, P_out),
    in(P_out, _).

out(P, Col) :- shift_image(P), params.mark(Col).
out(P, Col) :- in(P, _), !shift_image(P), params.bg(Col).
