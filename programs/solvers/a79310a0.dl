// a79310a0
// concept: move
// The ink shape translates c.shift_k toward c.shift_dir and recolors to
// c.mark; the rest of the grid is c.bg.

#include "../lib.dl"

.comp Consts {
    .decl ink(c: Color) ink(8).
    .decl mark(c: Color) mark(2).
    .decl bg(c: Color) bg(0).

    .decl shift_dir(d: Dir) shift_dir(DIR_B).
    .decl shift_k(k: number) shift_k(1).
}

.init c = Consts

// Image of the ink under the shift, restricted to in-frame positions.
.decl shift_image(p: Position)
shift_image(P_out) :-
    in(P_in, Col), c.ink(Col),
    c.shift_dir(D), c.shift_k(K), jump(P_in, D, K, P_out),
    in(P_out, _).

.decl out(p: Position, col: Color)
out(P, Col) :- shift_image(P), c.mark(Col).
out(P, Col) :- in(P, _), !shift_image(P), c.bg(Col).
