// 15696249
// keywords: tile-arrangement lines markers stamp
// output: an input-shaped arrangement of input-sized tiles: tiles at gate
//  cells hold copies of the input; the rest are bg.

// two models of the gate; they coincide while that color stays on its line,
// and diverge on a stray cell of it
.type Choice =
    // cells of the input's monochrome line (row or column)
    Line {}
    // cells holding the monochrome line's color
  | Color {}

.type LineKey = [a: Axis, p_across: Position]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(c: Color) bg(0).
}

.init params = Params

.init line_color = Unanimous<LineKey, Color>
line_color.item([A, P_across], Col) :- in(P, Col), axis_elem(A), split(P, A, _, P_across).

.decl impl_choice(ch: Choice)
impl_choice($Line()). impl_choice($Color()).

.decl gate(p: Position, ch: Choice)

// --- $Line ---
gate(P, $Line()) :-
    in(P, _), axis_elem(A),
    split(P, A, _, P_across), !line_color.clash([A, P_across]).

// --- $Color ---
gate(P, $Color()) :- in(P, Col), line_color.value(_, Col).

out(P_grid_out, Col, Ch) :-
    impl_choice(Ch), in(P_tile, _), in(P_intile, Col_in),   // tile slot, tile content
    ( gate(P_tile, Ch), Col = Col_in                        // gate open — the input, copied
    ; !gate(P_tile, Ch), params.bg(Col)                     // gate shut — the whole tile bg
    ),
    concat_2d(P_tile, P_intile, 0, P_grid_out).             // tile ⊗ cell → grid
