// 319f2597
// @keywords: markers cast
// input: A mark of params.mark sits in a field of noise.
// output: Every cell sharing a row or a column with the mark is painted, edge
//  to edge; cells holding params.spare resist and keep their color.

// what color the cast paints with
.type Choice =
    // the mark's own color
    Spread {}
    // an independently stored color
  | Paint {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // The mark's color.
    .decl mark(col: Color) mark(0).

    // The color that resists the cast.
    .decl spare(col: Color) spare(2).

    // --- Paint ---
    // The color the cast lays down.
    .decl paint(col: Color) paint(0).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Spread()). impl_choice($Paint()).

// P shares a line with a mark on some axis.
.decl cross(p: Position)
cross(P) :-
    in(Q, Col), params.mark(Col),          // a mark
    in(P, _),                              // any cell
    axis_elem(A), same_line(A, P, Q).

.decl painted(p: Position)
painted(P) :- cross(P), in(P, Col), !params.spare(Col).

out(P, Col, Ch) :- in(P, Col), !painted(P), impl_choice(Ch).

// --- Spread ---
out(P, Col, $Spread()) :- painted(P), params.mark(Col).

// --- Paint ---
out(P, Col, $Paint()) :- painted(P), params.paint(Col).
