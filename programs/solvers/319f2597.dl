// 319f2597
// concept: markers cast
// A mark of c.mark sits in a field of noise. Every cell sharing a row or a
// column with the mark is painted, edge to edge; cells holding c.spare
// resist and keep their color. $Spread paints with the mark's own color;
// $Paint paints with an independently stored color.

#include "../lib.dl"

.type Choice = Spread {} | Paint {}

.comp Consts {
    // --- shared ---
    // The mark's color.
    .decl mark(col: Color) mark(0).

    // The color that resists the cast.
    .decl spare(col: Color) spare(2).

    // --- Paint ---
    // The color the cast lays down.
    .decl paint(col: Color) paint(0).
}

.init c = Consts

.decl impl_choice(ch: Choice)
impl_choice($Spread()). impl_choice($Paint()).

// P shares a line with a mark on some axis.
.decl cross(p: Position)
cross(P) :-
    in(Q, Col), c.mark(Col),          // a mark
    in(P, _),                         // any cell
    axis_elem(A), same_line(A, P, Q).

.decl painted(p: Position)
painted(P) :- cross(P), in(P, Col), !c.spare(Col).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- in(P, Col), !painted(P), impl_choice(Ch).

// --- Spread ---
out(P, Col, $Spread()) :- painted(P), c.mark(Col).

// --- Paint ---
out(P, Col, $Paint()) :- painted(P), c.paint(Col).
