// ca8f78db
// @keywords: wallpaper repair lines noise
// input: a wallpaper: all-bg separator rows alternating with one repeating
//  pattern row
// output: Noise patches corrupt cells of the wallpaper. Each case restores
//  the corrupted cells.

// how a corrupted cell's replacement is found
.type Choice =
    // translation repair, detected: a shift unbroken on clean cells maps each
    // noise cell to a clean counterpart
    Shift {}
    // translation repair, stored: cells a stored period apart along its axis
    // are equal. Only the vertical period is task data; the horizontal one
    // varies per pair, so it has no row.
  | Period {}
    // line structure: rows with a clean non-bg cell are pattern rows and equal
    // each other; the rest are separators, all bg
  | Rows {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl noise(col: Color) noise(0).

    // --- $Period ---
    .decl period(a: Axis, k: number) period(AXIS_V, 2).

    // --- $Rows ---
    .decl bg(col: Color) bg(1).
    .decl axis(a: Axis) axis(AXIS_H).   // lines run along H
}

.init params = Params

.decl clean(p: Position, col: Color)
clean(P, Col) :- in(P, Col), !params.noise(Col).

.init si = OffsetInvariance<Unit, Color>
si.cell($U(), P, Col) :- clean(P, Col).

.decl impl_choice(ch: Choice)
impl_choice($Shift()). impl_choice($Period()). impl_choice($Rows()).

// Clean cells pass through under every case.
out(P, Col, Ch) :- impl_choice(Ch), clean(P, Col).

// --- $Shift ---

out(P, Col, $Shift()) :-
    in(P, N), params.noise(N),                         // corrupted cell
    si.cand($U(), A, K, Delta),                     // candidate shift
    !si.mismatch($U(), A, K),                       // unbroken on clean cells
    compose(P, Delta, P2), clean(P2, Col).             // its image

// --- $Period ---

// A corrupted cell and the clean cells whole stored periods apart from it
// along the period's axis: in line, at the same place within the period.
.decl peer(p: Position, q: Position, col: Color)
peer(P, Q, Col) :-
    in(P, N), params.noise(N), params.period(A, K), axis_of(D, A),
    clean(Q, Col), same_line(A, P, Q),
    dist(P, D, T_p), stride(T_p, K, 0, _, R),
    dist(Q, D, T_q), stride(T_q, K, 0, _, R).

out(P, Col, $Period()) :- peer(P, _, Col).

// --- $Rows ---

// A row is identified by its across component; pattern rows have a clean
// non-bg cell.
.decl pattern_row(across: Position)
pattern_row(Across) :-
    clean(P, Col), !params.bg(Col),
    params.axis(A), split(P, A, _, Across).

out(P, Col, $Rows()) :-
    in(P, N), params.noise(N),                             // corrupted cell
    params.axis(A), split(P, A, Along, Across),            // its row and column
    ( !pattern_row(Across), params.bg(Col)                 // separator row — bg
    ; pattern_row(Across),                                 // pattern row
      clean(Q, Col),                                       // clean source cell
      split(Q, A, Along, Across2), pattern_row(Across2)    // same column, pattern row
    ).

.type LinePos = [e: Example, a: Axis, along: Position]

.comp Determine {
    .init si = OffsetInvariance<Example, Color>
    si.cell(E, P, Col) :- ex_out(E, P, Col).

    .init unbroken = Extremes<Axis>
    unbroken.cand(A, K) :- si.cand(_, A, K, _), !si.mismatch(_, A, K).

    // The period is the smallest shift the wallpaper repeats under.
    .decl period(a: Axis, k: number)
    period(A, K) :- unbroken.low(A, K).

    // Restored cells in line coordinates, on each axis.
    .decl line_cell(e: Example, a: Axis, across: Position, along: Position, col: Color)
    line_cell(E, A, Across, Along, Col) :-
        ex_out(E, P, Col), axis_elem(A), split(P, A, Along, Across).

    .decl pattern_line(e: Example, a: Axis, across: Position)
    pattern_line(E, A, Across) :- line_cell(E, A, Across, _, Col), !params.bg(Col).

    // The colors the pattern lines carry at each position along the line.
    .init pattern_at = Unanimous<LinePos, Color>
    pattern_at.item([E, A, Along], Col) :-
        line_cell(E, A, Across, Along, Col), pattern_line(E, A, Across).

    // Pattern lines of one grid disagreeing at a shared position.
    .decl axis_mismatch(a: Axis)
    axis_mismatch(A) :- pattern_at.clash([_, A, _]).

    // Lines run along the axis whose pattern lines all agree.
    .decl axis(a: Axis)
    axis(A) :- axis_elem(A), !axis_mismatch(A).
}
