// 17b866bd
// keywords: decompose markers stamp
// input: A lattice of params.line-wide lines cuts the grid into
//  params.block-square blocks; line crossings are params.node-colored
//  junctions.
// output: A junction holding any other color is a mark: it restores to
//  params.node, and its color paints the block toward params.corner of it.

// what the paint covers
.type Choice =
    // the block's params.hole cells recolor
    Holes {}
    // a stored footprint stamps over the block
  | Stamp {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl line(k: number) line(1).
    .decl block(k: number) block(4).
    .decl node(col: Color) node(0).
    .decl corner(d: DiagDir) corner(DIAG_BR).

    // --- $Holes ---
    .decl hole(col: Color) hole(0).

    // --- $Stamp ---
    .decl stamp(p: Position)
    GRID_MASK_4x4(stamp,
        _, 1, 1, _,
        1, 1, 1, 1,
        1, 1, 1, 1,
        _, 1, 1, _)
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Holes()). impl_choice($Stamp()).

.comp Parse<Key> {
    .type Blk = [key: Key, id: Ident]

    .decl cell(key: Key, p: Position, col: Color)
    .decl line(k: number)
    .decl gap(k: number)
    .decl node(col: Color)

    // Cells on a lattice line dividing axis a.
    .decl lattice(key: Key, p: Position, a: Axis)
    lattice(K, P, A) :-
        cell(K, P, _), axis_elem(A),
        line(W), gap(G), divide_by_size(P, A, W, G, _, _).

    .decl junction(key: Key, p: Position)
    junction(K, P) :- lattice(K, P, A), perp(A, A2), lattice(K, P, A2).

    .decl mark(key: Key, p: Position, col: Color)
    mark(K, P, Col) :- junction(K, P), cell(K, P, Col), !node(Col).

    // Blocks: connected components of off-lattice cells.
    .init blocks = Components<Key>
    blocks.node(K, P) :- cell(K, P, _), !lattice(K, P, _).

    .decl label(key: Key, p: Position, id: Ident)
    label(K, P, Id) :- blocks.label(K, P, Id).

    // The block toward corner diag of the mark: a line-width diagonal jump
    // lands in it.
    .decl mark_block(key: Key, p: Position, diag: DiagDir, id: Ident)
    mark_block(K, P, Diag, Id) :-
        mark(K, P, _),
        diag_dir_elem(Diag), line(W), jump(P, Diag, W, P0),
        label(K, P0, Id).

    .init bbox = Bbox<Blk>
    bbox.cell([K, Id], P) :- label(K, P, Id).

    .decl box(key: Key, id: Ident, b: Box)
    box(K, Id, B) :- bbox.box([K, Id], B).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).
parse.line(W) :- params.line(W).
parse.gap(G) :- params.block(G).
parse.node(Col) :- params.node(Col).

// The marked block: the one toward params.corner, with its paint color.
.decl painted(id: Ident, col: Color)
painted(Id, Col) :-
    parse.mark($U(), P, Col),
    params.corner(Diag), parse.mark_block($U(), P, Diag, Id).

.decl fill(p: Position, col: Color, ch: Choice)

// --- $Holes ---
fill(Q, Col, $Holes()) :-
    painted(Id, Col), parse.label($U(), Q, Id),
    in(Q, Hole), params.hole(Hole).

// --- $Stamp ---
fill(Q, Col, $Stamp()) :-
    painted(Id, Col), parse.box($U(), Id, B),
    params.stamp(P_inner), compose(B, P_inner, Q).

out(P, Col, Ch) :- fill(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), parse.mark($U(), P, _), params.node(Col).
out(P, Col, Ch) :-
    impl_choice(Ch), in(P, Col), !parse.mark($U(), P, _), !fill(P, _, Ch).

.comp Determine {
    .init parse = Parse<Example>
    parse.cell(E, P, Col) :- ex_in(E, P, Col).
    parse.line(W) :- params.line(W).
    parse.gap(G) :- params.block(G).
    parse.node(Col) :- params.node(Col).

    // Cells a train pair repaints, with the block each sits in.
    .decl repaint(e: Example, p: Position, id: Ident)
    repaint(E, P, Id) :-
        ex_out(E, P, Col), ex_in(E, P, Col2), Col != Col2,
        parse.label(E, P, Id).

    // A corner refuted by a repainted block no mark seats toward it.
    .decl stray(diag: DiagDir)
    stray(Diag) :-
        repaint(E, _, Id), diag_dir_elem(Diag),
        !parse.mark_block(E, _, Diag, Id).

    .decl corner(d: DiagDir)
    corner(Diag) :- diag_dir_elem(Diag), !stray(Diag).

    // Repainted cells in their block's frame.
    .decl stamp(p: Position)
    stamp(P_inner) :-
        repaint(E, P, Id), parse.box(E, Id, B), relative(B, P, P_inner).
}
