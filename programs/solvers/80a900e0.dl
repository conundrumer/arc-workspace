// 80a900e0
// @draft
// @keywords: objects markers cast
// input: Objects, each an 8-connected set of one color, on a two-color
//  checkerboard.
// output: A diagonal segment casts a ray from each end, perpendicular to
//  itself, in its own color, over background cells. In the pairs every
//  segment lies against a diamond of another color, and only the ray leaving
//  the diamond shows.

// which directions each end casts, and where a ray stops
.type Choice =
    // each end casts both perpendicular directions; a ray halts at the first
    // object cell
    Halt {}
    // each end casts only away from the object cell across from the ray; the
    // ray crosses the whole grid
  | Away {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl bg(col: Color)
    bg(0).
    bg(1).
}

.init params = Params

.decl impl_choice(ch: Choice)
impl_choice($Halt()). impl_choice($Away()).

.init objs = Components8<Color>
objs.node(Col, P) :- in(P, Col), !params.bg(Col).

.decl object(id: Ident, p: Position, col: Color)
object(Id, P, Col) :- objs.label(Col, P, Id).

// Two cells of an object on one diagonal line.
.decl aligned(id: Ident, da: DiagAxis, p: Position, q: Position)
aligned(Id, Da, P, Q) :-
    object(Id, P, _), object(Id, Q, _), diag_axis_elem(Da), same_line(Da, P, Q).

// Some pair of the object's cells leaves the line.
.decl bent(id: Ident, da: DiagAxis)
bent(Id, Da) :-
    object(Id, P, _), object(Id, Q, _), diag_axis_elem(Da), !aligned(Id, Da, P, Q).

// A segment: an object of several cells, all on one diagonal line.
.decl segment(id: Ident, da: DiagAxis)
segment(Id, Da) :-
    object(Id, P, _), object(Id, Q, _), P != Q,    // several cells
    diag_axis_elem(Da), !bent(Id, Da).             // none of them off the line

.init rim = Rim8<Ident>
rim.cell(Id, P) :- object(Id, P, _).

// An end of a segment: the segment stops there along its axis.
.decl end(id: Ident, p: Position)
end(Id, P) :- segment(Id, Da), diag_axis_of(D, Da), rim.rim_dir(Id, P, D).

// The directions across a segment's axis.
.decl across(id: Ident, d: DiagDir)
across(Id, D) :- segment(Id, Da), diag_perp(Da, Da2), diag_axis_of(D, Da2).

// --- program ---

// One cast per end, per case.
.type Cast = [p: Position, ch: Choice]

.init rays = Ray<Cast>
rays.cell([P_end, Ch], P) :- end(_, P_end), impl_choice(Ch), in(P, Col), params.bg(Col).
rays.mark([P_end, Ch], P_end) :- end(_, P_end), impl_choice(Ch).

// --- $Halt ---

rays.dir([P_end, $Halt()], D) :- end(Id, P_end), across(Id, D).
rays.blocked([P_end, $Halt()], P) :- end(_, P_end), object(_, P, _).

// --- $Away ---

rays.dir([P_end, $Away()], D) :-
    end(Id, P_end), across(Id, D),
    diag_opposite(D, D_in), neighbor(P_end, D_in, Q), object(_, Q, _).  // an object across from the ray

// --- out ---

.decl painted(p: Position, col: Color, ch: Choice)
painted(P, Col, Ch) :- rays.clear([P_end, Ch], P, _, _, _), object(_, P_end, Col).

out(P, Col, Ch) :- painted(P, Col, Ch).
out(P, Col, Ch) :- impl_choice(Ch), in(P, Col), !painted(P, _, Ch).
