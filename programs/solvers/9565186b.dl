// 9565186b
// keywords: objects count select
// output: the dominant part of the grid keeps its cells; every other cell
//  becomes params.mark.

// what dominates the grid
.type Choice =
    // the color with the most cells
    Count {}
    // the color owning the largest 4-component
  | BlobColor {}
    // the largest 4-component alone; its color's stray cells gray too
  | Blob {}

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    .decl mark(c: Color) mark(5).
}

.init params = Params

.decl keep(p: Position, ch: Choice)

// --- $Count ---

.init commonest = Mode<Unit, Color, Position>
commonest.item($U(), Col, P) :- in(P, Col).

keep(P, $Count()) :- in(P, Col), commonest.mode($U(), Col).

// --- $BlobColor, $Blob ---

.type Comp = [col: Color, id: Ident]

.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col).

// The largest component.
.init biggest = Mode<Unit, Comp, Position>
biggest.item($U(), [Col, Id], P) :- comps.label(Col, P, Id).

.decl comp_wins(col: Color, id: Ident)
comp_wins(Col, Id) :- biggest.mode($U(), [Col, Id]).

keep(P, $BlobColor()) :- in(P, Col), comp_wins(Col, _).

keep(P, $Blob()) :- comp_wins(Col, Id), comps.label(Col, P, Id).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Count()). impl_choice($BlobColor()). impl_choice($Blob()).

out(P, Col, Ch) :- keep(P, Ch), in(P, Col).
out(P, Col, Ch) :- in(P, _), impl_choice(Ch), !keep(P, Ch), params.mark(Col).
