// 9565186b
// concept: objects count select
// The dominant part of the grid keeps its cells; every other cell becomes
// c.mark. Three claims on what dominates, tagged on out's Choice:
//
//   $Count     — the color with the most cells.
//   $BlobColor — the color owning the largest 4-component.
//   $Blob      — the largest 4-component alone; its color's stray cells
//                gray too.

#include "../lib.dl"

.type Choice = Count {} | BlobColor {} | Blob {}

.comp Consts {
    .decl mark(c: Color) mark(5).
}

.init c = Consts

.decl keep(p: Position, ch: Choice)

// --- $Count ---

.decl color_count(col: Color, n: number)
color_count(Col, N) :- in(_, Col), N = count : { in(P, Col) }.

keep(P, $Count()) :-
    in(P, Col), color_count(Col, N),
    N = max N2 : { color_count(_, N2) }.   // the commonest color

// --- $BlobColor / $Blob ---

.init comps = Components<Color>
comps.node(Col, P) :- in(P, Col).

.decl comp_size(col: Color, id: Ident, n: number)
comp_size(Col, Id, N) :- comps.label(Col, _, Id), N = count : { comps.label(Col, P, Id) }.

// The largest component.
.decl comp_wins(col: Color, id: Ident)
comp_wins(Col, Id) :-
    comp_size(Col, Id, N),
    N = max N2 : { comp_size(_, _, N2) }.

keep(P, $BlobColor()) :- in(P, Col), comp_wins(Col, _).

keep(P, $Blob()) :- comp_wins(Col, Id), comps.label(Col, P, Id).

// --- Output ---

.decl impl_choice(ch: Choice)
impl_choice($Count()). impl_choice($BlobColor()). impl_choice($Blob()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- keep(P, Ch), in(P, Col).
out(P, Col, Ch) :- in(P, _), impl_choice(Ch), !keep(P, Ch), c.mark(Col).
