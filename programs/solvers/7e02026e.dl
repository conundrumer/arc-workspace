// 7e02026e
// @representative: 1818057f

// how the plus footprint is found
.type Choice =
    // the plus is stored data; Occurrences finds its placements
    Shape {}
    // a field cell with field cells on all four sides; it and its neighbors
    // recolor
  | Flank {}

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .decl field(c: Color) field(0).
    .decl mark(c: Color) mark(3).

    // --- $Shape ---
    .decl shape(p: Position)
    GRID_MASK_3x3(shape,
        _, 1, _,
        1, 1, 1,
        _, 1, _)
}

.init params = Params

.decl field_at(p: Position)
field_at(P) :- in(P, Col), params.field(Col).

// --- $Shape ---
.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- field_at(P).
occ.shape($U(), P, $U()) :- params.shape(P).

.decl shape_covered(p: Position)
shape_covered(P) :- occ.occurrence($U(), M), params.shape(S), compose(M, S, P).

// --- $Flank ---
.init exposed = Rim<Unit>
exposed.cell($U(), P) :- field_at(P).

.decl flanked(p: Position)
flanked(P) :- field_at(P), !exposed.rim($U(), P).

.decl flank_covered(p: Position)
flank_covered(P) :- flanked(P).
flank_covered(P2) :- flanked(P), dir_elem(D), neighbor(P, D, P2).

out(P, Col, $Shape()) :- shape_covered(P), params.mark(Col).
out(P, Col, $Shape()) :- in(P, Col), !shape_covered(P).

out(P, Col, $Flank()) :- flank_covered(P), params.mark(Col).
out(P, Col, $Flank()) :- in(P, Col), !flank_covered(P).

.comp Determine {
    // Cells the stamp recolored.
    .decl changed(e: Example, p: Position)
    changed(E, P) :- ex_in(E, P, C1), params.field(C1), ex_out(E, P, C2), params.mark(C2).

    .type EI = [e: Example, id: Ident]

    .init comps = Components<Example>
    comps.node(E, P) :- changed(E, P).

    .decl comp_cell(k: EI, p: Position)
    comp_cell([E, Id], P) :- comps.label(E, P, Id).

    .init comp_size = Tally<EI, Position>
    comp_size.item(K, P) :- comp_cell(K, P).

    .init smallest = ArgExtremes<Unit, EI>
    smallest.cand($U(), K, N) :- comp_size.tally(K, N).

    // The smallest changed component is a single stamp.
    .init stamp = Bbox<EI>
    stamp.cell(K, P) :- smallest.low($U(), K, _), comp_cell(K, P).

    .decl shape(p: Position)
    shape(P_inner) :- stamp.cell(K, P), stamp.box(K, B), crop(P, B, P_inner).
}
