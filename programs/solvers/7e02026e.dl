// 7e02026e
// family: 1818057f
// Wherever the plus footprint lands fully on the field color, those cells
// turn c.mark; the rest passes through.

#include "../lib.dl"

.type Choice = Shape {} | Flank {}

.comp Consts {
    .decl field(c: Color) field(0).
    .decl mark(c: Color) mark(3).

    // --- $Shape ---
    .decl shape_grid(p: Position, lit: number)
    GRID_3x3(shape_grid,
        0, 1, 0,
        1, 1, 1,
        0, 1, 0)

    .decl shape(p: Position)
    shape(P) :- shape_grid(P, 1).
}

.init c = Consts

.decl field_at(p: Position)
field_at(P) :- in(P, Col), c.field(Col).

// --- $Shape ---
.init occ = Occurrences<Unit>
occ.cell($U(), P)  :- field_at(P).
occ.shape($U(), P) :- c.shape(P).

.decl shape_covered(p: Position)
shape_covered(P) :- occ.occurrence($U(), M), c.shape(S), compose(M, S, P).

// --- $Flank ---
.decl exposed(p: Position)
exposed(P) :- field_at(P), dir_elem(D), step_delta(D, S), compose(P, S, P2), !field_at(P2).

.decl flanked(p: Position)
flanked(P) :- field_at(P), !exposed(P).

.decl flank_covered(p: Position)
flank_covered(P) :- flanked(P).
flank_covered(P2) :- flanked(P), dir_elem(D), step_delta(D, S), compose(P, S, P2).

.decl out(p: Position, col: Color, c: Choice)

out(P, Col, $Shape()) :- shape_covered(P), c.mark(Col).
out(P, Col, $Shape()) :- in(P, Col), !shape_covered(P).

out(P, Col, $Flank()) :- flank_covered(P), c.mark(Col).
out(P, Col, $Flank()) :- in(P, Col), !flank_covered(P).
