// 1fad071e
// @keywords: objects count stamp noise
// input: squares of params.block_color, params.block_dim on a side, beside a
//  second color's squares and single-cell noise.
// output: Count those squares, then draw the count as a bar in a fixed out_dim
//  grid: the cells within the count of params.bar_edge take the bar's color,
//  the rest params.bg.

// how the block shape's occurrences are found
.type Detect =
    // connected components equal to the shape
    Object {}
    // placements whose footprint lands fully on the color; counts touching
    // squares separately, where $Object merges them
  | Placement {}

// the bar's color
.type Mark =
    // a fixed color
    Fixed {}
    // the counted color
  | Counted {}

// the two decisions are independent, so the cases cross them
.type Choice = [detect: Detect, mark: Mark]

.decl out(p: Position, col: Color, c: Choice)

.comp Params {
    .init helpers = ParamsHelpers

    .decl block_color(c: Color) block_color(1).
    .decl block_dim(k: number) block_dim(2).

    .decl block_shape(p: Position)
    block_shape(P) :- block_dim(N), helpers.frame_pos([N, N], P).

    .decl bg(c: Color) bg(0).

    .decl out_dim(a: Axis, n: number)
    out_dim(AXIS_V, 1). out_dim(AXIS_H, 5).

    .decl bar_edge(d: Dir) bar_edge(DIR_L).

    .decl out_pos(p: Position)
    out_pos(P) :- out_dim(AXIS_V, V), out_dim(AXIS_H, H), helpers.frame_pos([V, H], P).

    // --- $Fixed ---
    // the bar's color
    .decl mark(c: Color) mark(1).
}

.init params = Params

.comp Parse<Key> {
    .type Obj = [k: Key, id: Ident]

    .decl cell(k: Key, p: Position, col: Color)
    .decl color(k: Key, col: Color)
    .decl shape(k: Key, p: Position)    // the block's cells in its own frame

    .decl on(k: Key, p: Position)
    on(K, P) :- cell(K, P, Col), color(K, Col).

    .init comps = Components<Key>
    comps.node(K, P) :- on(K, P).

    .init bbox = Bbox<Obj>
    bbox.cell([K, Id], P) :- comps.label(K, P, Id).

    .init same = KeyedSetCompare<Obj, Key, Position>
    same.pattern_member(K, P) :- shape(K, P).
    same.observed_member(O, P_inner) :- bbox.cell(O, P), bbox.box(O, B), crop(P, B, P_inner).

    .decl block(k: Key, id: Ident)
    block(K, Id) :- same.equals([K, Id], K).

    .init blocks = Tally<Key, Ident>
    blocks.item(K, Id) :- block(K, Id).
    blocks.domain(K) :- cell(K, _, _).
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).
parse.color($U(), Col)   :- params.block_color(Col).
parse.shape($U(), P)     :- params.block_shape(P).

// The count the bar draws.
.decl total(n: number, detect: Detect)

// --- $Object ---
total(N, $Object()) :- parse.blocks.tally($U(), N).

// --- $Placement ---
.init occ = Occurrences<Unit, Unit>
occ.cell($U(), P, $U())  :- parse.on($U(), P).
occ.shape($U(), P, $U()) :- params.block_shape(P).

.init placements = Tally<Unit, Position>
placements.item($U(), P) :- occ.occurrence($U(), P).

total(N, $Placement()) :- placements.tally($U(), N).

// --- $Fixed, $Counted ---
.decl bar_mark(col: Color, mark: Mark)
bar_mark(Col, $Fixed())   :- params.mark(Col).
bar_mark(Col, $Counted()) :- params.block_color(Col).

// --- Output ---

.decl marked(p: Position, detect: Detect)
marked(P, Det) :-
    params.out_pos(P),
    params.bar_edge(D), dist(P, D, K),    // distance from the bar edge
    total(N, Det), K < N.                 // within the count

out(P, Col, [Det, M]) :- marked(P, Det), bar_mark(Col, M).
out(P, BG,  [Det, M]) :-
    params.out_pos(P), total(_, Det), !marked(P, Det), bar_mark(_, M), params.bg(BG).

.comp Determine {
    .type Cand = [e: Example, col: Color, k: number]

    // The bar an output draws: its non-bg cells, and its length.
    .decl bar(e: Example, p: Position, col: Color)
    bar(E, P, Col) :- ex_out(E, P, Col), !params.bg(Col).

    .init bar_len = Tally<Example, Position>
    bar_len.item(E, P) :- bar(E, P, _).

    .decl mark(c: Color)
    mark(Col) :- bar(_, _, Col).

    // An edge the bar does not run from.
    .decl mismatch_edge(d: Dir)
    mismatch_edge(D) :-
        dir_elem(D), bar_len.tally(E, N),
        ex_out(E, P, _), dist(P, D, K), K < N,   // cell within the bar's length
        !bar(E, P, _).                           // that the bar misses

    .decl bar_edge(d: Dir)
    bar_edge(D) :- dir_elem(D), !mismatch_edge(D).

    // Input cells of the train pairs; the test input is held out.
    .decl train_in(e: Example, p: Position, col: Color)
    train_in(E, P, Col) :- ex_in(E, P, Col), ex_out(E, _, _).

    // Candidate block sizes: every size an input frame admits.
    .decl cand_dim(k: number)
    cand_dim(K) :- train_in(_, P, _), axis_elem(A), sub_extent(P, A, K).

    // Candidate blocks: a color a train input shows, at a candidate size.
    .decl cand(col: Color, k: number)
    cand(Col, K) :- train_in(_, _, Col), cand_dim(K).

    // The k x k block shape of each candidate size.
    .init block_frame = Frame2D<number>
    block_frame.extent(K, A, K) :- cand_dim(K), axis_elem(A).

    // Each candidate counted on each train pair.
    .decl trial(e: Example, col: Color, k: number)
    trial(E, Col, K) :- cand(Col, K), ex_out(E, _, _).

    .init parse = Parse<Cand>
    parse.cell([E, Col, K], P, C) :- trial(E, Col, K), ex_in(E, P, C).
    parse.color([E, Col, K], Col) :- trial(E, Col, K).
    parse.shape([E, Col, K], P)   :- trial(E, Col, K), block_frame.cell(K, P).

    // A candidate whose count misses some bar's length.
    .decl mismatch(col: Color, k: number)
    mismatch(Col, K) :- parse.blocks.tally([E, Col, K], N), bar_len.tally(E, M), N != M.

    // The block the bars count.
    .decl block(col: Color, k: number)
    block(Col, K) :- cand(Col, K), !mismatch(Col, K).

    .decl block_color(c: Color)
    block_color(Col) :- block(Col, _).

    .decl block_dim(k: number)
    block_dim(K) :- block(_, K).
}
