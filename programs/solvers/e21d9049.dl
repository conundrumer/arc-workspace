// e21d9049
// @draft
// @keywords: wallpaper lines
// @scene crossing-strips: on a field of bg 0, the non-bg cells form one
//  horizontal strip and one vertical strip, each one cell wide, that share
//  exactly one cell, where they cross.
// @scene distinct-colors-per-strip: no color occurs twice in one strip.
// @scene equal-length: the two strips have the same length.
// @rule repeat-along-line: each cell of a strip's line, its row for the
//  horizontal strip and its column for the vertical strip, takes the color of
//  the strip cell whose distance from it along the line is a multiple of the
//  strip's length, so the strip's color sequence repeats with a period of its
//  length out to both grid edges, and the strip's own cells keep their colors.
// @rule rest-unchanged: every cell on neither line keeps its input color.

// what repeats along each strip's line
.type Repeat =
    // @claim repeat-along-line
    StripLength {}
    // @rule repeat-along-line: the period is the strip's shortest period, the
    //  least p at which the strip's colors repeat.
    // @witness alternating-strip: borderline $ShortestPeriod
    //     @relaxed distinct-colors-per-strip
  | ShortestPeriod {}
    // @rule repeat-along-line: the period is the number of non-bg colors in
    //  the input; undefined where that period exceeds a strip's length or
    //  conflicts with the strip's own colors.
    // @witness count-period: foreign concept
    //     @relaxed distinct-colors-per-strip
    //     @relaxed equal-length
  | ColorCount {}

// how far each line extends
.type Extent =
    // @claim repeat-along-line
    ToEdge {}
    // @rule repeat-along-line: from each end of the strip, the repetition
    //  extends outward until the first non-bg cell, and that cell and every
    //  cell past it keep their input colors.
    // @witness stray-cell: foreign concept
    //     @relaxed crossing-strips
  | StopAtObstacle {}

.type Choice = [u: Repeat, x: Extent]

.decl out(p: Position, col: Color, ch: Choice)

.comp Params {
    // @derive DominantColor: variant derived
    //     @relaxed crossing-strips
    .decl bg(col: Color) bg(0).
}

.init params = Params

.decl repeat_choice(u: Repeat)
repeat_choice($StripLength()). repeat_choice($ShortestPeriod()). repeat_choice($ColorCount()).

.decl extent_choice(x: Extent)
extent_choice($ToEdge()). extent_choice($StopAtObstacle()).

.decl impl_choice(ch: Choice)
impl_choice([U, X]) :- repeat_choice(U), extent_choice(X).

.decl ink(p: Position, col: Color)
ink(P, Col) :- in(P, Col), !params.bg(Col).

// The cell the two strips share: ink on both axes beside it.
.decl crossing(p: Position)
crossing(X) :-
    ink(X, _), neighbor(X, D1, Y1), ink(Y1, _), neighbor(X, D2, Y2), ink(Y2, _),
    axis_of(D1, A1), axis_of(D2, A2), perp(A1, A2).

// @claim crossing-strips
.init run = Slide<Unit>
run.node($U(), P) :- ink(P, _).
run.dir($U(), D) :- dir_elem(D).

// The strip along axis a: the crossing and the ink run on from it.
.decl strip(a: Axis, p: Position, col: Color)
strip(A, X, Col) :- crossing(X), ink(X, Col), axis_elem(A).
strip(A, Q, Col) :- crossing(X), axis_of(D, A), run.run($U(), X, D, Q), ink(Q, Col).

// The strip's end toward d.
.decl strip_end(d: Dir, p: Position)
strip_end(D, E) :- crossing(X), dir_elem(D), run.rest($U(), X, D, E).

// @claim repeat-along-line
.init strip_size = Tally<Axis, Position>
strip_size.item(A, Q) :- strip(A, Q, _).

// The line through the crossing along axis a.
.decl line(a: Axis, p: Position)
line(A, P) :- crossing(X), axis_elem(A), in(P, _), same_line(A, X, P).

// p lies k cells past strip cell q along its line.
.decl along(a: Axis, q: Position, p: Position, k: number)
along(A, Q, P, K) :-
    strip(A, Q, _), line(A, P), axis_of(D, A),
    relative(Q, P, V), opposite(D, O), dist(V, O, K), K >= 0.

// The period each strip repeats with.
.decl period(u: Repeat, a: Axis, k: number)

// The cells a strip's repetition paints.
.decl painted(x: Extent, p: Position)

// The color the repetition gives a line cell.
.decl line_color(u: Repeat, p: Position, col: Color)
line_color(U, P, Col) :-
    period(U, A, K), strip(A, Q, Col), along(A, Q, P, T),
    stride(T, K, 0, _, 0).                                  // a whole number of periods away

out(P, Col, [U, X]) :- painted(X, P), line_color(U, P, Col).
out(P, Col, [U, X]) :- impl_choice([U, X]), in(P, Col), !painted(X, P).

// --- $StripLength ---
period($StripLength(), A, K) :- strip_size.tally(A, K).

// --- $ShortestPeriod ---
// Two cells of the strip k apart differ in color.
.decl broken(a: Axis, k: number)
broken(A, K) :- strip(A, Q, C1), strip(A, Q2, C2), C1 != C2, along(A, Q, Q2, K), K > 0.

// @claim repeat-along-line
.init shortest = Extremes<Axis>
shortest.cand(A, K) :- strip(A, Q2, _), along(A, Q, Q2, K), K > 0, !broken(A, K).
shortest.cand(A, K) :- strip_size.tally(A, K).

period($ShortestPeriod(), A, K) :- shortest.low(A, K).

// --- $ColorCount ---
// @claim repeat-along-line
.init palette = Tally<Unit, Color>
palette.item($U(), Col) :- ink(_, Col).
palette.domain($U()).

period($ColorCount(), A, N) :- strip(A, _, _), palette.tally($U(), N).

// --- $ToEdge ---
painted($ToEdge(), P) :- line(_, P).

// --- $StopAtObstacle ---
// @claim repeat-along-line
.init cast = Ray<Dir>
cast.dir(D, D) :- strip_end(D, _).
cast.cell(D, P) :- strip_end(D, _), in(P, _).
cast.mark(D, E) :- strip_end(D, E).
cast.blocked(D, P) :- strip_end(D, _), ink(P, _).

painted($StopAtObstacle(), P) :- strip(_, P, _).
painted($StopAtObstacle(), P) :- cast.clear(D, P, D, _, _).

.comp Determine {
    .init common = Mode<Example, Color, Position>
    common.item(E, Col, P) :- ex_in(E, P, Col).

    // A color that is not the commonest color of some input.
    .decl uncommon(col: Color)
    uncommon(Col) :- common.tally(_, Col, _), ex_in(E, _, _), !common.mode(E, Col).

    .decl bg(col: Color)
    bg(Col) :- common.mode(_, Col), !uncommon(Col).
}
