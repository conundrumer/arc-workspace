// f8ff0b80
// Output is a 1D layout along axis_of(c.rank_dir): the input's non-bg
// colors, anchored at c.rank_dir, in descending count order. Extent =
// number of distinct non-bg colors.
//
// Flagged: count-vs-count comparison `N2 > N` in `color_rank` — inherent
// to ranking.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)        bg(0).
    .decl rank_dir(d: Dir)    rank_dir(TOP).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Cell count per non-bg color.
.decl color_count(col: Color, n: number)
color_count(Col, N) :-
    in(_, Col), !c.bg(Col),
    N = count : { in(_, Col) }.

// Descending-count rank: number of colors with strictly higher count.
//
// Flagged: ties in N produce duplicate ranks — colliding `out` facts at
// the same Position, and a sparse `dist_set` that breaks DirFrame.
.decl color_rank(col: Color, r: number)
color_rank(Col, R) :-
    color_count(Col, N),
    R = count : { color_count(_, N2), N2 > N }.

// Output frame: 1D axis from c.rank_dir, indexed by rank.
.init col = DirFrame
col.dir(D) :- c.rank_dir(D).
col.dist_set(R) :- color_rank(_, R).

.decl out(p: Position, col: Color)
out(P, Col) :- color_rank(Col, Rk), col.pos(Rk, P).

.output out(IO=stdout)
