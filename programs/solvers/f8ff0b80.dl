// f8ff0b80
// concept: count rank
// Output is a 1D layout along axis_of(params.rank_dir): the input's non-bg
// colors, anchored at params.rank_dir, in descending count order. Extent =
// number of distinct non-bg colors.
//
// Ranking via the Ordinal comp (sparse count set → dense ordinal). Ordinal
// ranks ascending; the descending layout falls out by placing from the edge
// opposite params.rank_dir.
//
// Flagged: colors sharing a count map to one rank — colliding `out` facts at
// the same Position. dist_set stays dense (ranks run over distinct counts),
// so DirFrame's dense-input contract holds.

#include "../lib.dl"

.comp Params {
    .decl bg(c: Color) bg(0).
    .decl rank_dir(d: Dir) rank_dir(DIR_T).
}

.init params = Params

// Cell count per non-bg color.
.init color_count = Tally<Color, Position>
color_count.item(Col, P) :- in(P, Col), !params.bg(Col).

// Dense rank over the distinct counts, ascending (fewest first).
.init o = Ordinal<Unit>
o.idx_set($U(), N) :- color_count.tally(_, N).

.decl color_rank(col: Color, r: number)
color_rank(Col, R) :- color_count.tally(Col, N), o.rank($U(), N, R).

// Output frame: 1D axis anchored at params.rank_dir. Placing ascending rank from
// the opposite edge seats the largest count at the rank_dir edge.
.init col = DirFrame<Unit>
col.dir(D_opp) :- params.rank_dir(D), opposite(D, D_opp).
col.dist_set($U(), R) :- color_rank(_, R).

.decl out(p: Position, col: Color)
out(P, Col) :- color_rank(Col, Rk), col.pos($U(), Rk, P).
