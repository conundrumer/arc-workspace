// f8ff0b80
// Output is a 1D layout along axis_of(c.rank_dir): the input's non-bg
// colors, anchored at c.rank_dir, in descending count order. Extent =
// number of distinct non-bg colors.
//
// Ranking via the Ordinal comp (sparse count set → dense ordinal). Ordinal
// ranks ascending; the descending layout falls out by placing from the edge
// opposite c.rank_dir.
//
// Flagged: colors sharing a count map to one rank — colliding `out` facts at
// the same Position. dist_set stays dense (ranks run over distinct counts),
// so DirFrame's dense-input contract holds.

#include "../lib.dl"

.comp Consts {
    .decl bg(c: Color)        bg(0).
    .decl rank_dir(d: Dir)    rank_dir(TOP).
}

.init c = Consts

.decl in(p: Position, col: Color)
.input in(IO=stdin)

// Cell count per non-bg color.
.decl color_count(col: Color, n: number)
color_count(Col, N) :-
    in(_, Col), !c.bg(Col),
    N = count : { in(_, Col) }.

// Dense rank over the distinct counts, ascending (fewest first).
.init o = Ordinal
o.idx_set(N) :- color_count(_, N).

.decl color_rank(col: Color, r: number)
color_rank(Col, R) :- color_count(Col, N), o.rank(N, R).

// Output frame: 1D axis anchored at c.rank_dir. Placing ascending rank from
// the opposite edge seats the largest count at the rank_dir edge.
.init col = DirFrame
col.dir(D_opp) :- c.rank_dir(D), opposite(D, D_opp).
col.dist_set(R) :- color_rank(_, R).

.decl out(p: Position, col: Color)
out(P, Col) :- color_rank(Col, Rk), col.pos(Rk, P).

.output out(IO=stdout)
