// 66e6c45b
// concept: lookup move
// A 2×2 color block on bg explodes to the grid corners. Hypotheses of the
// motion, tagged on out's Choice:
//
//   $Quad    — each cell relocates to the corner of its grid quadrant.
//   $Stretch — the shape stretches: bbox corners land on grid corners.
//   $Explode — each cell takes one diagonal step away from the shape.
//   $Table   — the position permutation as data: paired labeled grids.

#include "../lib.dl"

.type Choice = Quad {} | Stretch {} | Explode {} | Table {}

.comp Params {
    .decl bg(c: Color) bg(0).

    // --- Table ---
    .decl in_label(p: Position, id: Ident)
    GRID_SPARSE_4x4(in_label,
        _, _, _, _,
        _, 1, 2, _,
        _, 3, 4, _,
        _, _, _, _)

    .decl out_label(p: Position, id: Ident)
    GRID_SPARSE_4x4(out_label,
        1, _, _, 2,
        _, _, _, _,
        _, _, _, _,
        3, _, _, 4)

    .decl map(p_in: Position, p_out: Position)
    map(P_in, P_out) :- in_label(P_in, Id), out_label(P_out, Id).
}

.init params = Params

.decl shape(p: Position, col: Color)
shape(P, Col) :- in(P, Col), !params.bg(Col).

.init gdp = DiagPlacement<Unit>
gdp.cell($U(), P) :- in(P, _).

.decl target(p: Position, col: Color, ch: Choice)

// --- Quad ---

target(P_corner, Col, $Quad()) :-
    shape(P, Col), gdp.quadrant($U(), P, Diag),
    gdp.diag_cell($U(), P_corner, Diag, 0).    // grid corner at that diagonal

// --- Stretch / Explode: the shape's own corner cells ---

.init bb = Bbox<Unit>
bb.cell($U(), P) :- shape(P, _).

// --- Stretch ---

target(P_corner, Col, $Stretch()) :-
    shape(P, Col), bb.box($U(), B), box_corner(P, B, Diag),
    gdp.diag_cell($U(), P_corner, Diag, 0).    // grid corner at that diagonal

// --- Explode ---

target(P_out, Col, $Explode()) :-
    shape(P, Col), bb.box($U(), B), box_corner(P, B, Diag),
    neighbor(P, Diag, P_out).

// --- Table ---

target(P_out, Col, $Table()) :- in(P_in, Col), params.map(P_in, P_out).

.decl impl_choice(ch: Choice)
impl_choice($Quad()). impl_choice($Stretch()). impl_choice($Explode()). impl_choice($Table()).

.decl out(p: Position, col: Color, ch: Choice)
out(P, Col, Ch) :- target(P, Col, Ch).
out(P, Bg, Ch)  :- impl_choice(Ch), in(P, _), params.bg(Bg), !target(P, _, Ch).

.comp Determine {
    // Ink correspondence candidates: same color in and out.
    .decl cand(e: Example, p_in: Position, p_out: Position)
    cand(E, P_in, P_out) :-
        ex_in(E, P_in, C), !params.bg(C), ex_out(E, P_out, C).

    // A within-example color coincidence breaks in some other example.
    .decl broken(p_in: Position, p_out: Position)
    broken(P_in, P_out) :-
        cand(_, P_in, P_out), ex_out(E, _, _), !cand(E, P_in, P_out).

    .decl pair(p_in: Position, p_out: Position)
    pair(P_in, P_out) :- cand(_, P_in, P_out), !broken(P_in, P_out).

    .decl in_label(p: Position, id: Ident)
    in_label(P_in, as(ord(P_in), Ident)) :- pair(P_in, _).

    .decl out_label(p: Position, id: Ident)
    out_label(P_out, as(ord(P_in), Ident)) :- pair(P_in, P_out).
}
