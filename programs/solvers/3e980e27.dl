// 3e980e27
// @draft
// @keywords: objects markers stamp d4
// input: non-bg cells forming 8-connected shapes; a shape of one cell with no
//  neighbor is a bare marker
// output: A bare marker's color also marks a cell inside a shape; that shape
//  stamps onto the marker, marker cell on marker cell, turned by that color's
//  D4.

.decl out(p: Position, col: Color)

.comp Params {
    .decl bg(col: Color) bg(0).

    // Marker color -> the D4 its stamp carries.
    .decl stamp_d4(col: Color, d: D4)
    stamp_d4(2, D4_LR). stamp_d4(3, D4_ID).
}

.init params = Params

.comp Parse<Key> {
    .decl cell(key: Key, p: Position, col: Color)  // input

    .decl ink(key: Key, p: Position, col: Color)
    ink(K, P, Col) :- cell(K, P, Col), !params.bg(Col).

    .init obj = Components8<Key>
    obj.node(K, P) :- ink(K, P, _).

    // Ink with ink beside it: part of a shape.
    .decl joined(key: Key, p: Position)
    joined(K, P) :- ink(K, P, _), dir8_elem(D), neighbor(P, D, Q), ink(K, Q, _).

    // A bare marker: ink with nothing beside it.
    .decl lone(key: Key, p: Position, col: Color)
    lone(K, P, Col) :- ink(K, P, Col), !joined(K, P).

    // A shape's cells as displacements from its marker, keyed by marker color.
    .decl footprint(key: Key, col_mark: Color, v: Offset, col: Color)
    footprint(K, M, V, Col) :-
        lone(K, _, M), ink(K, P0, M), joined(K, P0),  // a marker color, worn inside a shape
        obj.label(K, P0, Id), obj.label(K, P, Id),    // a cell of the same shape
        ink(K, P, Col), relative(P0, P, V).       // its color and offset from the marker
}

.init parse = Parse<Unit>
parse.cell($U(), P, Col) :- in(P, Col).

.decl paint(p: Position, col: Color)
paint(Q, Col) :-
    parse.lone($U(), P, M), params.stamp_d4(M, D),   // a bare marker, and its color's D4
    parse.footprint($U(), M, V, Col),                // a cell of that color's stamp
    apply(D, V, V2), compose(P, V2, Q),              // that cell, laid marker on marker
    in(Q, _).                                        // on the grid

out(P, Col) :- paint(P, Col).
out(P, Col) :- in(P, Col), !paint(P, _).

.comp Determine {
    .init ex = Parse<Example>
    ex.cell(E, P, Col) :- ex_in(E, P, Col).

    .type Marker = [e: Example, p: Position]

    // Each bare marker's stamp, and the output about that marker, both as
    // displacements from the marker.
    .init stamp = D4Map<Marker, Color>
    stamp.src([E, P], V, Col) :- ex.lone(E, P, M), ex.footprint(E, M, V, Col), ex_out(E, _, _).
    stamp.dst([E, P], V, Col) :- ex.lone(E, P, _), ex_out(E, Q, Col), relative(P, Q, V).

    // A D4 that carries a marker's stamp onto the output about that marker.
    .decl carries(col: Color, d: D4)
    carries(M, D) :- ex.lone(E, P, M), stamp.compatible([E, P], D).

    // A marker of that color whose stamp that D4 does not carry.
    .decl uncarried(col: Color, d: D4)
    uncarried(M, D) :-
        carries(M, D), stamp.src([E, P], _, _), ex.lone(E, P, M),   // a solved marker of that color
        !stamp.compatible([E, P], D).

    // The D4 that carries the stamp of every marker of its color.
    .decl stamp_d4(col: Color, d: D4)
    stamp_d4(M, D) :- carries(M, D), !uncarried(M, D).
}
