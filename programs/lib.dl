// Shared types and primitives for ARC solvers in Souffle.
//
// Position: 4 distances from edges, ordered V-first then H — (top, bottom,
// left, right). Dir constants index into Position. Redundant with grid bounds;
// no corner privileged.
//
// Dim: (V-length, H-length) of a frame — ConstsHelpers grouping notation
// only. Task data is scalar (square claim) or axis-tagged rows
// (rectangular claim).
//
// Color, Dir, Axis, DiagDir, DiagAxis, D4, Sense are subtypes of number:
// typed names with no arithmetic intent. Constants are #define'd in disjoint
// ranges so a value's range identifies its namespace.
// Names are <TYPE>_<VAL>, with VAL abbreviated to one length per type.
// Solver bodies pull values from a per-task Consts component rather than
// referencing constants directly.

.type Color <: number

.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sense <: number

// Ident: a label carrying identity and nothing else — entries of a stored
// table, component labels, the endpoints of a correspondence. Numbering is
// arbitrary, so consumers join on equality and never order or count with it.
.type Ident <: number

.type Position = [t: number, b: number, l: number, r: number]
.type Dim = [v: number, h: number]

// Unit: singleton key for keyed components applied to a single set — states
// "exactly one set" in the type instead of a dummy int.
.type Unit = U {}

#define DIR_T 10
#define DIR_B 11
#define DIR_L 12
#define DIR_R 13

#define AXIS_V 20
#define AXIS_H 21

#define DIAG_TL 30
#define DIAG_TR 31
#define DIAG_BL 32
#define DIAG_BR 33

#define DAXIS_DG 40
#define DAXIS_AD 41

// D4 elements as gather permutations of (t, b, l, r). Rotations: quarter CW,
// half turn, quarter CCW. Flips are named by what swaps, not the axis of
// reflection.
#define D4_ID 50
#define D4_CW 51
#define D4_HT 52
#define D4_CC 53
#define D4_LR 54
#define D4_TB 55
#define D4_DG 56
#define D4_AD 57

// Sense of a turn.
#define SENSE_CW 60
#define SENSE_CC 61

// Origin: position with 0 distance to every edge.
#define ORIGIN [0, 0, 0, 0]

// ============================================================
// Runner contract — run_dl.py appends each mode's IO directives
// ============================================================

// The task input grid.
.decl in(p: Position, col: Color)

// ============================================================
// Solver body primitives
// ============================================================

// Dispatch/projection functors (C++, in lib_functors.cpp).
//
// The primitives that dispatch on an orientation value (dist on Dir,
// edge_delta on Dir, split/divide/divide_by_size/concat on Axis, apply on D4)
// are single-clause inlines that call these functors. Keeping each to one
// clause is what bounds IR path count: a multi-clause inline contributes xN to
// every rule that calls it, because the dispatch value comes from a relation
// and Souffle can't prune the impossible combinations. One clause -> one query
// plan.
//
// Functors return `number`, never a Position record; each wrapper reassembles
// its Position as a Datalog record literal, filling slots from number functors
// (`@keep_dir` / `@keep_axis` for keep-when-selector-matches; `@axis_near` /
// `@axis_far` for the two slots along an axis). Guards and arithmetic stay in
// Datalog inside the single clause. lib_functors.cpp covers why functors return
// numbers rather than records.
.functor dist_proj(d: Dir, t: number, b: number, l: number, r: number): number
.functor keep_dir(sel: Dir, target: number, v: number): number
.functor keep_axis(sel: Axis, target: number, v: number): number
.functor axis_near(a: Axis, t: number, b: number, l: number, r: number): number
.functor axis_far(a: Axis, t: number, b: number, l: number, r: number): number
.functor apply_t(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_b(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_l(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_r(d: D4, t: number, b: number, l: number, r: number): number

.decl dir_elem(d: Dir)
dir_elem(DIR_T).
dir_elem(DIR_B).
dir_elem(DIR_L).
dir_elem(DIR_R).

.decl axis_elem(a: Axis)
axis_elem(AXIS_V).
axis_elem(AXIS_H).

.decl diag_dir_elem(d: DiagDir)
diag_dir_elem(DIAG_TL).
diag_dir_elem(DIAG_TR).
diag_dir_elem(DIAG_BL).
diag_dir_elem(DIAG_BR).

.decl d4_elem(d: D4)
d4_elem(D4_ID).
d4_elem(D4_CW).
d4_elem(D4_HT).
d4_elem(D4_CC).
d4_elem(D4_LR).
d4_elem(D4_TB).
d4_elem(D4_DG).
d4_elem(D4_AD).

.decl c4_elem(d: D4)
c4_elem(D4_ID).
c4_elem(D4_CW).
c4_elem(D4_HT).
c4_elem(D4_CC).

// Axis of a Dir.
.decl axis_of(d: Dir, a: Axis)
axis_of(DIR_T, AXIS_V).
axis_of(DIR_B, AXIS_V).
axis_of(DIR_L, AXIS_H).
axis_of(DIR_R, AXIS_H).

// Diagonal axis of a corner.
.decl diag_axis_of(d: DiagDir, da: DiagAxis)
diag_axis_of(DIAG_TL, DAXIS_DG).
diag_axis_of(DIAG_BR, DAXIS_DG).
diag_axis_of(DIAG_TR, DAXIS_AD).
diag_axis_of(DIAG_BL, DAXIS_AD).

// Cardinal Dir of corner d on axis a.
.decl dir_of(d: DiagDir, a: Axis, dir: Dir)
dir_of(DIAG_TL, AXIS_V, DIR_T).
dir_of(DIAG_TL, AXIS_H, DIR_L).
dir_of(DIAG_TR, AXIS_V, DIR_T).
dir_of(DIAG_TR, AXIS_H, DIR_R).
dir_of(DIAG_BL, AXIS_V, DIR_B).
dir_of(DIAG_BL, AXIS_H, DIR_L).
dir_of(DIAG_BR, AXIS_V, DIR_B).
dir_of(DIAG_BR, AXIS_H, DIR_R).

// Opposite Dir on the same axis.
.decl opposite(d: Dir, opp: Dir)
opposite(DIR_T, DIR_B).
opposite(DIR_B, DIR_T).
opposite(DIR_L, DIR_R).
opposite(DIR_R, DIR_L).

// Opposite corner on the same diagonal — the DiagDir half-turn.
.decl diag_opposite(d: DiagDir, opp: DiagDir)
diag_opposite(DIAG_TL, DIAG_BR).
diag_opposite(DIAG_BR, DIAG_TL).
diag_opposite(DIAG_TR, DIAG_BL).
diag_opposite(DIAG_BL, DIAG_TR).

// Perpendicular Axis.
.decl perp(a: Axis, a2: Axis)
perp(AXIS_V, AXIS_H).
perp(AXIS_H, AXIS_V).

// A corner's two dirs, axis-tagged: d1 on axis a, d2 across.
.decl diag_dirs(d: DiagDir, a: Axis, d1: Dir, d2: Dir)
diag_dirs(Diag, A, D1, D2) :- dir_of(Diag, A, D1), perp(A, A2), dir_of(Diag, A2, D2).

// The D4 reflection inverting axis a.
.decl flip_of(a: Axis, d: D4)
flip_of(AXIS_V, D4_TB).
flip_of(AXIS_H, D4_LR).

// Dir reached by a quarter turn in sense s. opposite is the half turn.
.decl turn(s: Sense, d: Dir, d_out: Dir)
turn(SENSE_CW, DIR_T, DIR_R).
turn(SENSE_CW, DIR_R, DIR_B).
turn(SENSE_CW, DIR_B, DIR_L).
turn(SENSE_CW, DIR_L, DIR_T).
turn(SENSE_CC, D2, D) :- turn(SENSE_CW, D, D2).

// Distance from p to edge d.
.decl dist(p: Position, d: Dir, k: number) inline
dist(P, D, K) :- P = [T, B, L, R], K = @dist_proj(D, T, B, L, R).

// Distances to edge d and its opposite. A repeated variable states
// centered; a comparison picks the nearer half.
.decl dist_pair(p: Position, d: Dir, k: number, k2: number) inline
dist_pair(P, D, K, K2) :- dist(P, D, K), opposite(D, O), dist(P, O, K2).

// Distances to the two edges of corner diag, axis-tagged: k1 to the edge
// on axis a, k2 across. On-diagonal is a repeated variable.
.decl diag_dist(p: Position, diag: DiagDir, a: Axis, k1: number, k2: number) inline
diag_dist(P, Diag, A, K1, K2) :-
    diag_dirs(Diag, A, D1, D2), dist(P, D1, K1), dist(P, D2, K2).

// Element-wise sum of two Positions. One operand may be a signed delta.
.decl compose(p1: Position, p2: Position, p3: Position) inline
compose([T1, B1, L1, R1], [T2, B2, L2, R2], [T1+T2, B1+B2, L1+L2, R1+R2]) :- true.

// Pointwise ≥ over edge distances: p is at least q's distance from every
// edge, i.e. p is inside the box that q describes as margins.
.decl geq(p: Position, q: Position) inline
geq([T1, B1, L1, R1], [T2, B2, L2, R2]) :-
    T1 >= T2, B1 >= B2, L1 >= L2, R1 >= R2.

// Edge delta: a Position carrying k at edge d, zero elsewhere.
.decl edge_delta(d: Dir, k: number, p: Position) inline
edge_delta(D, K, [@keep_dir(D, DIR_T, K), @keep_dir(D, DIR_B, K), @keep_dir(D, DIR_L, K), @keep_dir(D, DIR_R, K)]) :- true.

// K-cell displacement toward d: -k at edge d, +k at its opposite.
.decl jump_delta(d: Dir, k: number, delta: Position) inline
jump_delta(D, K, Delta) :-
    opposite(D, O), edge_delta(D, -K, Sd), edge_delta(O, K, So), compose(Sd, So, Delta).

// Unit step toward d — the k = 1 jump_delta.
.decl step_delta(d: Dir, delta: Position) inline
step_delta(D, Step) :- jump_delta(D, 1, Step).

// Unit step toward a corner — the DiagDir peer of step_delta: the corner's
// two cardinal unit steps composed.
.decl diag_step_delta(diag: DiagDir, delta: Position) inline
diag_step_delta(Diag, Delta) :-
    dir_of(Diag, AXIS_V, Dv), dir_of(Diag, AXIS_H, Dh),
    step_delta(Dv, Sv), step_delta(Dh, Sh),
    compose(Sv, Sh, Delta).

// Decompose p by axis: along carries the axis component (perpendicular
// zeroed); across carries the perpendicular (axis zeroed).
.decl split(p: Position, a: Axis, along: Position, across: Position) inline
split(P, A,
      [@keep_axis(A, AXIS_V, T), @keep_axis(A, AXIS_V, B), @keep_axis(A, AXIS_H, L), @keep_axis(A, AXIS_H, R)],
      [@keep_axis(A, AXIS_H, T), @keep_axis(A, AXIS_H, B), @keep_axis(A, AXIS_V, L), @keep_axis(A, AXIS_V, R)]) :-
    P = [T, B, L, R].

// Extent of p's frame along axis a — read off any position in the frame.
.decl axis_dim(p: Position, a: Axis, n: number) inline
axis_dim(P, A, N) :- P = [T, B, L, R],
    N = @axis_near(A, T, B, L, R) + @axis_far(A, T, B, L, R) + 1.

// Wide extent readout of p's frame: n1 along axis a, n2 across. A line is
// (N, 1); a repeated variable states a square; a comparison finds the
// long axis.
.decl axis_dims(p: Position, a: Axis, n1: number, n2: number) inline
axis_dims(P, A, N1, N2) :- axis_dim(P, A, N1), perp(A, A2), axis_dim(P, A2, N2).

// Proper sub-extents of p's frame along a — the sizes a sweeping
// decomposition ranges over: every k with 1 <= k < extent.
.decl sub_extent(p: Position, a: Axis, k: number) inline
sub_extent(P, A, K) :- axis_dim(P, A, N), K = range(1, N).

// Apply a D4 transform to a Position — a pure index permutation.
.decl apply(d: D4, p: Position, p_out: Position) inline
apply(D, P, [@apply_t(D, T, B, L, R), @apply_b(D, T, B, L, R),
             @apply_l(D, T, B, L, R), @apply_r(D, T, B, L, R)]) :- P = [T, B, L, R].

// Divide p's axis-a extent into n equal parts. p_outer is the tile
// index in an n-strip frame; p_inner is the cell within the tile.
// Both axis-only (perpendicular zeroed). Cells in gap rows/cols (gap > 0)
// produce no decomposition. Two divides on different axes compose to 2D.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, A, N, G, P_outer, P_inner) :-
    axis_dim(P, A, Ext),
    (Ext - (N-1)*G) % N = 0,
    K = (Ext - (N-1)*G) / N,
    divide_by_size(P, A, K, G, P_outer, P_inner).

// Like divide, but parameterized by tile size k instead of tile count n.
// Tile count is recovered from p's axis-a extent: n = (extent + gap) /
// (k + gap).
// Asserts: gap-adjusted extent is a multiple of (k + gap).
.decl divide_by_size(p: Position, a: Axis, k: number, gap: number,
                     p_outer: Position, p_inner: Position) inline
divide_by_size(P, A, K, G, P_outer, P_inner) :-
    P = [T, B, L, R],
    Near = @axis_near(A, T, B, L, R), Far = @axis_far(A, T, B, L, R),
    Ext = Near + Far + 1,
    (Ext + G) % (K + G) = 0,
    N = (Ext + G) / (K + G),
    K_cyc = Near % (K + G),
    K_cyc < K,
    O = Near / (K + G),
    P_outer = [@keep_axis(A, AXIS_V, O),     @keep_axis(A, AXIS_V, N-1-O),
               @keep_axis(A, AXIS_H, O),     @keep_axis(A, AXIS_H, N-1-O)],
    P_inner = [@keep_axis(A, AXIS_V, K_cyc), @keep_axis(A, AXIS_V, K-1-K_cyc),
               @keep_axis(A, AXIS_H, K_cyc), @keep_axis(A, AXIS_H, K-1-K_cyc)].

// Distance t along a period of w (with gap g between periods) decomposes
// into period index n and within-period offset k. Per-cell scalar peer of
// `divide_by_size`, without the divisibility assertion.
.decl stride(t: number, w: number, g: number, n: number, k: number) inline
stride(T, W, G, N, K) :-
    T >= 0,
    T_cyc = T % (W + G), T_cyc < W,
    K = T_cyc,
    N = T / (W + G).

// Recompose axis-a tiles into a single extent — inverse of divide. p_outer
// is the tile index in an n-strip frame; p_inner is the cell within the
// tile. Both axis-only (perpendicular zeroed); p_grid is axis-only on the
// same axis. With gap > 0, only filled tile cells appear in p_grid — gap
// rows/cols are absent. Two concats on different axes compose to 2D.
.decl concat(p_outer: Position, p_inner: Position, a: Axis, gap: number,
             p_grid: Position) inline
concat(P_outer, P_inner, A, G, P_grid) :-
    P_outer = [OT, OB, OL, OR], P_inner = [IT, IB, IL, IR],
    ONear = @axis_near(A, OT, OB, OL, OR), OFar = @axis_far(A, OT, OB, OL, OR),
    INear = @axis_near(A, IT, IB, IL, IR), IFar = @axis_far(A, IT, IB, IL, IR),
    Span = INear + IFar + 1,
    GNear = ONear*(Span+G) + INear,
    GFar  = OFar*(Span+G) + IFar,
    P_grid = [@keep_axis(A, AXIS_V, GNear), @keep_axis(A, AXIS_V, GFar),
              @keep_axis(A, AXIS_H, GNear), @keep_axis(A, AXIS_H, GFar)].

// ============================================================
// Composites — recurring solver-body shapes built from primitives
// ============================================================

// Anchors only work on grounded positions.

// Same dist-to-edge D for two positions.
.decl same_dist(d: Dir, p1: Position, p2: Position) inline
same_dist(D, P1, P2) :- dist(P1, D, K), dist(P2, D, K).

// Two positions agree on the distances to the two edges of corner d.
.decl corner_anchor(d: DiagDir, p1: Position, p2: Position) inline
corner_anchor(Diag, P1, P2) :-
    diag_dist(P1, Diag, A, K1, K2),
    diag_dist(P2, Diag, A, K1, K2).

// Two positions agree on dist-to-edge d and on the perpendicular extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2),
    axis_of(D, A),
    split(P1, A, _, Ac), split(P2, A, _, Ac).

// 1D divide along axis a with perpendicular passthrough. p_outer is
// axis-only on a; p_inner is the full 2D within-slab position —
// perpendicular carried from p.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide_slab(p: Position, a: Axis, n: number, gap: number,
                  p_outer: Position, p_inner: Position) inline
divide_slab(P, A, N, G, P_outer, P_inner) :-
    divide(P, A, N, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

// 2D divide, one tile count and gap on both axes — the square claim as a
// repeated scalar. A rectangular claim reads axis-tagged rows through
// per-axis divide, perp-glued. Outputs are full 2D: p_outer indexes an
// n×n tile arrangement; p_inner is the cell within a tile.
.decl divide_2d(p: Position, n: number, gap: number,
                p_outer: Position, p_inner: Position) inline
divide_2d(P, N, G, P_outer, P_inner) :-
    divide(P, AXIS_V, N, G, P_ov, P_iv),
    divide(P, AXIS_H, N, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// Like divide_2d, but parameterized by tile size k.
.decl divide_by_size_2d(p: Position, k: number, gap: number,
                        p_outer: Position, p_inner: Position) inline
divide_by_size_2d(P, K, G, P_outer, P_inner) :-
    divide_by_size(P, AXIS_V, K, G, P_ov, P_iv),
    divide_by_size(P, AXIS_H, K, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// 1D concat along axis a with perpendicular passthrough — inverse of
// divide_slab. p_outer is axis-only on a; p_inner is full 2D
// (within-slab); p_grid is the recomposed full 2D position.
.decl concat_slab(p_outer: Position, p_inner: Position, a: Axis, gap: number,
                  p_grid: Position) inline
concat_slab(P_outer, P_inner, A, G, P_grid) :-
    split(P_inner, A, P_i_axis, Across),
    concat(P_outer, P_i_axis, A, G, P_along),
    compose(P_along, Across, P_grid).

// 2D concat on both axes — inverse of divide_2d / divide_by_size_2d.
// p_outer and p_inner are full 2D; one gap on both axes; p_grid is the
// recomposed full 2D position.
.decl concat_2d(p_outer: Position, p_inner: Position, gap: number,
                p_grid: Position) inline
concat_2d(P_outer, P_inner, G, P_grid) :-
    split(P_outer, AXIS_V, P_outer_v, P_outer_h),
    split(P_inner, AXIS_V, P_inner_v, P_inner_h),
    concat(P_outer_v, P_inner_v, AXIS_V, G, P_grid_v),
    concat(P_outer_h, P_inner_h, AXIS_H, G, P_grid_h),
    compose(P_grid_v, P_grid_h, P_grid).

// ============================================================
// Body components — instantiated at solver-body scope
// ============================================================

// 1D frame defined by an index set and an edge, one frame per key. The
// solver populates `dir(d)` (the edge distances are measured from; the
// instance's parameter, unkeyed) and `dist_set(key, k)` (the indices that
// make up the frame). The component derives extent as the set's size and
// exposes `pos(key, k, p)`, mapping each index to its axis-only Position.
//
// Flagged: assumes each key's dist_set is dense — {0, 1, ..., extent-1}.
// With a sparse set, indices above |dist_set|-1 give invalid Positions
// (`pos` sets the opposite-edge distance to |dist_set|-1-k, which goes
// negative).
.comp DirFrame<Key> {
    .decl dir(d: Dir)
    .decl dist_set(key: Key, k: number)

    .decl extent(key: Key, n: number)
    extent(Ky, N) :- dist_set(Ky, _), N = count : { dist_set(Ky, K) }.

    // Position at distance k from edge dir, axis-only (perpendicular zeroed).
    .decl pos(key: Key, k: number, p: Position) inline
    pos(Ky, K, P) :-
        dist_set(Ky, K), dir(D), opposite(D, D_opp), extent(Ky, N),
        edge_delta(D, K, P_d), edge_delta(D_opp, N-1-K, P_o),
        compose(P_d, P_o, P).
}

// 1D frame from an axis-tagged extent — the n axis-only positions of a
// 1-wide frame, per key and axis. The undirected peer of DirFrame: the
// unindexed cell set, no end privileged (both dirs derive the same set),
// no index map.
.comp AxisFrame<Key> {
    .decl extent(key: Key, a: Axis, n: number)

    .decl cell(key: Key, a: Axis, p: Position)
    cell(Ky, A, P) :-
        extent(Ky, A, N), axis_of(D, A), opposite(D, O),
        K = range(0, N),
        edge_delta(D, K, P_d), edge_delta(O, N-1-K, P_o),
        compose(P_d, P_o, P).
}

// 2D frame from per-axis extents — AxisFrame cells perp-glued into full
// 2D positions, one frame per key. A square frame spreads one extent
// over axis_elem.
.comp Frame2D<Key> {
    .decl extent(key: Key, a: Axis, n: number)

    .init ax = AxisFrame<Key>
    ax.extent(Ky, A, N) :- extent(Ky, A, N).

    .decl cell(key: Key, p: Position)
    cell(Ky, P) :-
        perp(A1, A2), ax.cell(Ky, A1, P1), ax.cell(Ky, A2, P2),
        compose(P1, P2, P).
}

// A corner diagonal, per key — cells equidistant from the corner's two
// edges; ring is that shared distance. The full corner-to-corner diagonal,
// center included. DiagPlacement.diag_cell is this ∩ quadrant — the
// corner→center ray.
.comp Diagonal<Key> {
    .decl cell(key: Key, p: Position)
    .decl corner(key: Key, d: DiagDir)

    .decl diagonal(key: Key, p: Position, ring: number)
    diagonal(Ky, P, K) :- cell(Ky, P), corner(Ky, Diag), diag_dist(P, Diag, _, K, K).
}

// Diagonal placement — the quadrant a cell sits in, and its ring. Solver
// populates `cell` (the position domain, per key).
.comp DiagPlacement<Key> {
    .decl cell(key: Key, p: Position)

    // Strictly nearer edge d than its opposite — which side of the axis midline.
    .decl nearer(key: Key, p: Position, d: Dir)
    nearer(Ky, P, D) :- cell(Ky, P), dir_elem(D), dist_pair(P, D, K, K2), K < K2.

    // The diagonal quadrant a cell sits in: nearer on both of that corner's edges.
    .decl quadrant(key: Key, p: Position, diag: DiagDir)
    quadrant(Ky, P, Diag) :- diag_dirs(Diag, _, D1, D2), nearer(Ky, P, D1), nearer(Ky, P, D2).

    // On the diagonal of its quadrant, at ring K — the shared distance to both
    // edges of that corner.
    .decl diag_cell(key: Key, p: Position, diag: DiagDir, ring: number)
    diag_cell(Ky, P, Diag, K) :- quadrant(Ky, P, Diag), diag_dist(P, Diag, _, K, K).
}

// Keyed marks cast rays toward each `dir`. `ray(k, p, d)`: p is on a
// key-k ray cast toward edge d, i.e. a mark on p's line lies at or beyond
// p on the side away from d. Reach is inclusive: a mark is on its own
// ray, and a domain that excludes marks (bg-only) gets strict semantics
// with no extra rule. Cells between two marks are the overlap of two
// opposite rays; cast both dirs of an axis and fold caller-side. Extent
// only: a ray whose content varies along its length needs a lockstep step
// recursion, not this comp.
.comp Ray<Key> {
    .decl dir(d: Dir)                  // cast directions in use
    .decl cell(p: Position)            // domain tested
    .decl mark(key: Key, p: Position)

    // p on a key-k ray cast toward edge d, in p's line.
    .decl ray(key: Key, p: Position, d: Dir)
    ray(K, P, D) :-
        cell(P), mark(K, Q), dir(D),
        axis_of(D, A), split(P, A, _, Ac), split(Q, A, _, Ac),
        dist(P, D, Kp), dist(Q, D, Kq), Kq >= Kp.
}

// The DiagDir peer of Ray: keyed marks cast rays toward each corner in
// `diag`. Stepping toward a corner drops the distance to both of its edges
// in lockstep, so ray membership is an equal, nonnegative drop on both.
// Same contract as Ray: inclusive reach, extent only.
.comp DiagRay<Key> {
    .decl diag(d: DiagDir)             // cast corners in use
    .decl cell(p: Position)            // domain tested
    .decl mark(key: Key, p: Position)

    .decl ray(key: Key, p: Position, d: DiagDir)
    ray(K, P, Diag) :-
        cell(P), mark(K, Q), diag(Diag),
        diag_dist(P, Diag, A, Pa, Pb), diag_dist(Q, Diag, A, Qa, Qb),
        Qa - Pa = Qb - Pb, Qa >= Pa.
}

// The two-sided fold of Ray: between(k, p) holds when key-k marks lie on
// both sides of p in its line, along a fed axis. `axis` is the instance's
// cast set — feed one axis for single-axis spans, both for row-and-column
// spans. Reach is inclusive: a mark is between under its own key (from
// Ray's inclusive reach), and a mark-free domain (e.g. a bg-only `cell`)
// gives strict semantics with no extra rule.
.comp Between<Key> {
    .decl axis(a: Axis)
    .decl cell(p: Position)            // domain tested
    .decl mark(key: Key, p: Position)

    .init rays = Ray<Key>
    rays.dir(D)     :- axis(A), axis_of(D, A).   // cast both ways
    rays.cell(P)    :- cell(P).
    rays.mark(K, P) :- mark(K, P).

    .decl between(key: Key, p: Position)
    between(K, P) :- rays.ray(K, P, D), opposite(D, O), rays.ray(K, P, O).
}

// Sparse numeric set → dense ordinal position, per key. The solver
// populates `idx_set`; `rank(key, k, r)` gives r = the count of the key's
// elements strictly less than k, so ranks run ascending from 0. For a
// descending layout, place ranks from the opposite edge; negate upstream
// only when the rank value itself flows downstream. idx_set is a set:
// items sharing k share its rank, and the rank set stays dense under ties.
.comp Ordinal<Key> {
    .decl idx_set(key: Key, k: number)

    .decl rank(key: Key, k: number, r: number)
    rank(Ky, K, R) :-
        idx_set(Ky, K),
        R = count : { idx_set(Ky, K2), K2 < K }.
}

// Negative-free difference of two keyed member counts: excess(key, n) is the
// amount by which the `pos` set outnumbers the `neg` set, with no tuple at a
// tie or deficit, so no negative number crosses the interface. Cancellation
// between two disjoint sets has no set-level witness (any member pairing
// invents an order), so the subtraction is irreducible: the comp owns it, and
// bodies consume the count by comparison.
.comp Excess<Key, Member> {
    .decl pos(key: Key, m: Member)
    .decl neg(key: Key, m: Member)

    .decl excess(key: Key, n: number)
    excess(Ky, N) :-
        pos(Ky, _),
        Np = count : { pos(Ky, M1) }, Nn = count : { neg(Ky, M2) },
        Np > Nn, N = Np - Nn.
}

// Lexicographic order over a keyed cell set, given a corner and a primary
// axis (instance parameters, unkeyed); reading order is the top-left,
// V-primary member. `before` compares: strictly nearer the corner's edge
// along the primary axis; or a primary tie and strictly nearer along the
// secondary. `rank` counts predecessors, ascending from 0 at the corner.
.comp LexOrder<Key> {
    .decl corner(d: DiagDir)
    .decl axis(a: Axis)
    .decl cell(key: Key, p: Position)

    .decl before(key: Key, q: Position, p: Position)
    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Diag), axis(A), dir_of(Diag, A, D),   // primary dir
        dist(Q, D, K1), dist(P, D, K2), K1 < K2.     // q strictly nearer
    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Diag), axis(A),
        diag_dirs(Diag, A, D, D2),                   // primary/secondary dirs
        same_dist(D, Q, P),                          // primary tie
        dist(Q, D2, K1), dist(P, D2, K2), K1 < K2.   // q strictly nearer

    .decl rank(key: Key, p: Position, r: number)
    rank(Ky, P, R) :- cell(Ky, P), R = count : { before(Ky, Q, P) }.
}

// Z/N successor over a dense 0-based index set, per key: increment, with
// the max wrapping to 0. Every dense cycle is Z/N up to relabeling; a
// spatial cycle converts through index maps the lib already owns (dist
// reads an index off a position, DirFrame.pos places one back). Consumers
// split by how they advance: a lockstep closure reads succ directly; a
// count advance feeds it to CycleWalk.
.comp IndexCycle<Key> {
    .decl idx(key: Key, k: number)

    .decl succ(key: Key, k: number, k2: number)
    succ(Ky, K, K+1) :- idx(Ky, K), idx(Ky, K+1).
    succ(Ky, K, 0)   :- idx(Ky, K), !idx(Ky, K+1).   // wrap from the max
}

// A directed cycle (succ = edges, with no basepoint) and rotation along
// it: walk advances a start node by n successor steps. succ takes the
// cycle's edges, as explicit data or from a builder like IndexCycle. step
// declares the advance counts in use, as raw solver data; the comp closes
// them downward into the recursion bound. The comp walks a cycle and never
// builds one: a solver whose advance is lockstep with another step
// consumes succ directly and skips this comp.
.comp CycleWalk<Key, T> {
    .decl succ(key: Key, p: T, p_next: T)
    .decl step(key: Key, n: number)     // advance counts in use

    // Downward closure of step — the walk's recursion bound.
    .decl bound(key: Key, n: number)
    bound(Ky, N) :- step(Ky, M), N = range(0, M+1).

    .decl walk(key: Key, p0: T, n: number, p: T)  // p = p0 advanced n steps along succ
    walk(Ky, P0, 0, P0) :- succ(Ky, P0, _).
    walk(Ky, P0, N1, P2) :-
        walk(Ky, P0, N, P1), succ(Ky, P1, P2),
        bound(Ky, N1), N1 = N + 1.      // N1 is the Z/n step count
}

// Keyed set comparison via count equality. The solver populates
// pattern_member (a catalog of known sets, enumerated by `pattern`) and
// observed_member (the observed set at each `observed` key); the component
// exposes `covers` (observed ⊇ pattern), `equals` (set equality), and
// `pattern_size` (members per pattern, for size-ranked selection over
// matches). Member is a single type param: a record for multi-field
// members, a scalar for one-field. Stored catalogs enumerate patterns as
// numbers (Pat = number; single-pattern sites use pattern = 0); a derived
// catalog keys patterns by its own objects.
.comp KeyedSetCompare<Key, Pat, Member> {
    .decl pattern_member(pattern: Pat, m: Member)
    .decl observed_member(observed: Key, m: Member)

    .decl pattern_size(pattern: Pat, n: number)
    pattern_size(Pat, N) :- pattern_member(Pat, _), N = count : { pattern_member(Pat, M) }.

    // observed ⊇ pattern: every pattern member is present in the observed set
    .decl covers(observed: Key, pattern: Pat)
    covers(Obs, Pat) :-
        observed_member(Obs, _),
        pattern_size(Pat, N),
        N = count : { pattern_member(Pat, M), observed_member(Obs, M) }.

    // observed == pattern: covers, and the observed set carries no extra members
    .decl equals(observed: Key, pattern: Pat)
    equals(Obs, Pat) :-
        covers(Obs, Pat),
        pattern_size(Pat, N),
        N = count : { observed_member(Obs, M) }.
}

// Re-express keyed cells relative to a per-key outer origin: inner = cell
// minus outer, the inverse of compose. Outer extent + inner extent = cell
// extent, so one subtraction both resizes and positions across frames.
// `outer` is one origin per key; several origins under one key
// cross-product, so key by the varied thing instead. Key by the cell to
// read `inner` backward. Bbox's `margin` is an `outer`: feeding it in
// views a cell set from its own bounding frame.
.comp Reframe<Key> {
    .decl outer(key: Key, p: Position)
    .decl cell(key: Key, p: Position)

    .decl sub(p: Position, q: Position, d: Position) inline
    sub([T1, B1, L1, R1], [T2, B2, L2, R2], [T1-T2, B1-B2, L1-L2, R1-R2]) :- true.

    .decl inner(key: Key, p: Position)
    inner(K, I) :- cell(K, P), outer(K, O), sub(P, O, I).
}

// Bounding box of a keyed cell set, from the min distance to each edge over
// the set (min-per-edge rather than min/max-per-axis: the four mins are
// already a Position, and the edge choice is unobservable under D4). Two
// readouts: `margin` packs the mins into a Position (the box's placement, a
// Reframe outer); `inside` tests `grid` cells against them.
.comp Bbox<Key> {
    .decl cell(key: Key, p: Position)
    .decl grid(key: Key, p: Position)

    .decl cell_dist(key: Key, d: Dir, k: number)
    cell_dist(K, D, Kd) :- cell(K, P), dir_elem(D), dist(P, D, Kd).

    .decl edge_min(key: Key, d: Dir, m: number)
    edge_min(K, D, M) :- cell_dist(K, D, _), M = min Kd : { cell_dist(K, D, Kd) }.

    // The box as a Position — margin from each edge.
    .decl margin(key: Key, p: Position)
    margin(K, [Mt, Mb, Ml, Mr]) :-
        edge_min(K, DIR_T, Mt), edge_min(K, DIR_B, Mb),
        edge_min(K, DIR_L, Ml), edge_min(K, DIR_R, Mr).

    // Grid cells inside the box — at least the margin from every edge.
    .decl inside(key: Key, p: Position)
    inside(K, P) :- grid(K, P), margin(K, M), geq(P, M).
}

// Connected components of a node set (4-adjacency), per key, each labeled by
// an opaque id from the lowest-ord member cell: ord is arbitrary but stable
// within a run, so the pick carries no geometry. A member cell is an
// injective identity, since distinct components have disjoint cells; a
// bounding box would alias two components that share one (interleaved
// diagonals under 8-adjacency).
.comp Components<Key> {
    .decl node(key: Key, p: Position)

    .decl step(delta: Position)
    step([-1, 1, 0, 0]). step([1, -1, 0, 0]). step([0, 0, -1, 1]). step([0, 0, 1, -1]).

    .decl conn(key: Key, p: Position, q: Position)
    conn(Ky, P, P)  :- node(Ky, P).
    conn(Ky, P, Q2) :- conn(Ky, P, Q1), step(D), compose(Q1, D, Q2), node(Ky, Q2).

    .decl label(key: Key, p: Position, id: Ident)
    label(Ky, P, as(Min, Ident)) :- node(Ky, P), Min = min ord(Q) : { conn(Ky, P, Q) }.
}

// Connected components under 8-adjacency — Components with the four
// diagonal steps added. A wrapper extending Components' step set, so the
// closure rules stay in one place and the name carries the adjacency claim.
.comp Components8<Key> {
    .init c4 = Components<Key>
    c4.step(S) :- diag_dir_elem(Diag), diag_step_delta(Diag, S).

    .decl node(key: Key, p: Position)
    c4.node(K, P) :- node(K, P).

    .decl label(key: Key, p: Position, id: Ident)
    label(K, P, Id) :- c4.label(K, P, Id).
}

// Occurrences of a shape among cells, per key: placements where the key's
// shape footprint lands fully on the key's cell set — the ARC "find this
// shape" operation. Placements derive backward from the data (cell minus
// shape-cell), so no grid bounds are needed and off-grid candidates filter
// themselves out: their footprint cells are not in `cell`, so `covers`
// fails.
.comp Occurrences<Key> {
    .decl cell(key: Key, p: Position)
    .decl shape(key: Key, p: Position)

    // Internal keys pair the solver key with an anchor Position; the
    // matcher's patterns key on the solver key — one pattern per key.
    .type KP = [key: Key, p: Position]

    // Candidate placements — align each shape cell (one origin per pair) to
    // every cell, union over the shape cells.
    .init align = Reframe<KP>
    align.cell([Ky, S], P)  :- shape(Ky, S), cell(Ky, P).
    align.outer([Ky, S], S) :- shape(Ky, S).
    .decl placement(key: Key, p: Position)
    placement(Ky, M) :- align.inner([Ky, _], M).

    // View the cells from each placement and test the shape's footprint.
    .init view = Reframe<KP>
    view.outer([Ky, M], M) :- placement(Ky, M).
    view.cell([Ky, M], P)  :- placement(Ky, M), cell(Ky, P).

    .init matcher = KeyedSetCompare<KP, Key, Position>
    matcher.pattern_member(Ky, S)  :- shape(Ky, S).
    matcher.observed_member(Kp, I) :- view.inner(Kp, I).

    .decl occurrence(key: Key, p: Position)
    occurrence(Ky, M) :- matcher.covers([Ky, M], Ky).
}

// ============================================================
// Consts helpers — instantiated inside Consts; not reachable from body
// ============================================================

.comp ConstsHelpers {
    // All positions of a frame of given Dim.
    .decl frame_pos(dim: Dim, p: Position) inline
    frame_pos([V, H], [T, V-1-T, L, H-1-L]) :- T = range(0, V), L = range(0, H).

    // Decompose a position in an outer×inner tiled frame into outer (which
    // tile) and inner (cell within the tile). Gap rows/cols between tiles
    // produce no entry. Combined-frame dim is
    //   (outer.v*inner.v + (outer.v-1)*gap.v,
    //    outer.h*inner.h + (outer.h-1)*gap.h).
    .decl tile_pos(outer: Dim, inner: Dim, gap: Dim,
                   p: Position, p_outer: Position, p_inner: Position) inline
    tile_pos([Ov, Oh], [Iv, Ih], [Gv, Gh],
             [T, B, L, R],
             [Mt, Ov-1-Mt, Ml, Oh-1-Ml],
             [It, Iv-1-It, Il, Ih-1-Il]) :-
        Mt = range(0, Ov), Ml = range(0, Oh),
        It = range(0, Iv), Il = range(0, Ih),
        T = Mt*(Iv+Gv) + It,
        L = Ml*(Ih+Gh) + Il,
        B = Ov*Iv + (Ov-1)*Gv - 1 - T,
        R = Oh*Ih + (Oh-1)*Gh - 1 - L.
}
