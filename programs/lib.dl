//! Shared types and primitives for ARC solvers in Souffle.
//!
//! Reading a unit:
//!
//! - A relation marked `// @input` is one the caller populates, and the facts
//!   under it are its default. Every other relation derives.
//! - In a keyed unit, the first column of a relation is its key, and each key
//!   is one independent instance of the unit.
//! - A `Requires:` sentence states a precondition the unit does not check,
//!   and what happens when it does not hold.
//!
//! Using a unit:
//!
//! - `ord`, `count`, and `match` are Souffle reserved words, so an instance
//!   cannot take them as its name.
//! - An `inline` relation sits under negation only when its clauses
//!   introduce no variable and the use binds every column. No inline
//!   relation can appear inside an aggregate; a non-inline relation wraps it.
//! - The anchors (`same_dist`, `corner_anchor`, `slab_anchor`, and the other
//!   composites of box.dl) work only on grounded positions.
//!
//! The runner contract: the solver declares `out`, and no other IO relation,
//! total over the expected output grid.

// A name with a leading `_` is private to the lib.

.type Color <: number
.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sym <: number
.type Sense <: number

/// The rotation subgroup of D4.
.type C4 <: D4

.type Dir8 = Dir | DiagDir

.type Axis4 = Axis | DiagAxis

/// An opaque label.
.type Ident <: number

/// Index of a task example.
.type Example <: number

/// The edge-margin record; box.dl holds its algebra.
.type Box = [t: number, b: number, l: number, r: number]

/// (V-length, H-length) of a frame, for ParamsHelpers only.
.type Dim = [v: number, h: number]

/// A cell.
.type Position = Box
/// A translation.
.type Offset = Box

.type Unit = U {}

/// The task input grid.
.decl in(p: Position, col: Color)  // @input

/// Train and test inputs and train outputs, fed in determination mode.
.decl ex_in(e: Example, p: Position, col: Color)  // @input
.decl ex_out(e: Example, p: Position, col: Color)  // @input

// Per-parameter diff between determine.<parameter> and params.<parameter>;
// the runner synthesizes the rules, and a nonempty diff is a violation.
.decl _determination_diff(param: symbol)

#include "lib/sets.dl"
#include "lib/orders.dl"
#include "lib/orientation.dl"
#include "lib/box.dl"
#include "lib/cells.dl"
#include "lib/constraints.dl"
#include "lib/params.dl"
