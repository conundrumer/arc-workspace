//! Shared types and primitives for ARC solvers in Souffle.
//!
//! Box: the edge-margin record (t, b, l, r), ordered V-first then H — a
//! rectangle placed in a frame by its margins from the four edges. A frame of
//! extent (H, W) reads the record as the rows t..H-1-b and the columns
//! l..W-1-r; a negative margin reaches past the frame. The records form a
//! group under componentwise addition, and every spatial operation here is
//! one of four things: the group operations, the pointwise order, the
//! projections onto components, and the D4 action. Dir constants index into
//! a Box.
//!
//! The per-axis sum (t+b, l+r) measures the frame's extent minus the
//! rectangle's, so boxes with one sum are translates of one another. Two
//! subsets have names: a Position is a cell, extent 1 on both axes, which
//! carries its frame; an Offset is a translation, sum 0, which moves any box
//! and keeps its extent. Every other reading — a rectangle, a margin, a
//! change per edge — is a Box read against a frame the reader supplies.
//!
//! Addition composes framings: for a box A in the frame and a box B in A's
//! own frame, A + B is B in the outer frame (`compose`). Subtraction is
//! relative position: B - A is B in A's frame (`relative`). The pointwise
//! order is nesting: A >= B iff A lies inside B (`inside`), and strict is the
//! interior (`interior`). ZERO is the whole frame as a box and no move as an
//! offset. The bounding box is the pointwise minimum over a set (`Bbox`). An
//! axis-only record is a band, the whole row or column through a cell
//! (`split`). The D4 action permutes the components, so every operation is
//! equivariant.
//!
//! Dim: (V-length, H-length) of a frame — ParamsHelpers grouping notation only.
//!
//! The subtypes of number are typed names with no arithmetic intent.
//!
//! The solver declares `out`, and no other IO relation. It must be total
//! over the expected output grid: a variant fails on a missing cell. With a
//! trailing TiebreakResolution column, the runner accepts a pair iff the set
//! of emitted grids equals the expected grid plus its alts, and a tiebreak
//! allows only two distinct grids.
//!
//! Anchors only work on grounded positions.

.type Color <: number

.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sym <: number
.type Sense <: number

/// The rotation subgroup of D4 — how a heading changes.
.type C4 <: D4

.type Dir8 = Dir | DiagDir

.type Axis4 = Axis | DiagAxis

/// A label carrying identity and nothing else: join on equality, never order
/// or count with it.
.type Ident <: number

/// Index of a task example.
.type Example <: number

.type Box = [t: number, b: number, l: number, r: number]
.type Dim = [v: number, h: number]

/// The two subsets the algebra singles out. Souffle equivalence types are
/// interchangeable, so an alias documents a column's reading and checks
/// nothing. A primitive types a column Box unless it reads the frame's
/// extent from the value, which assumes a cell; a column holds Offset when
/// its value is a translation by construction.
/// A cell: extent 1 on both axes, so the frame's extent is readable from it.
.type Position = Box
/// A translation: the two margins cancel on each axis.
.type Offset = Box

/// Singleton key for keyed components applied to a single set.
.type Unit = U {}

/// The task input grid.
.decl in(p: Position, col: Color)  // @input

/// Train and test inputs and train outputs, fed in determination mode. The
/// test examples have no ex_out rows.
.decl ex_in(e: Example, p: Position, col: Color)  // @input
.decl ex_out(e: Example, p: Position, col: Color)  // @input

/// Per-parameter diff between determine.<parameter> and params.<parameter>;
/// the runner synthesizes the rules, and a nonempty diff is a violation.
.decl _determination_diff(param: symbol)

#include "lib/sets.dl"
#include "lib/orders.dl"
#include "lib/orientation.dl"
#include "lib/box.dl"
#include "lib/cells.dl"
#include "lib/constraints.dl"
#include "lib/params.dl"
