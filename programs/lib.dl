// Shared types and primitives for ARC solvers in Souffle.
//
// Position: 4 distances from edges, ordered V-first then H — (top, bottom,
// left, right). Dir constants index into Position. Redundant with grid bounds;
// no corner privileged.
//
// Dim: (V-length, H-length) of a frame. Indexed by Axis.
//
// Color, Dir, Axis, DiagDir, DiagAxis, D4, Sense are subtypes of number —
// typed names with no arithmetic intent. Constants are #define'd in disjoint
// ranges so a value identifies its namespace at a glance: Color 0–9, Dir
// 10–13, Axis 20–21, DiagDir 30–33, DiagAxis 40–41, D4 50–57, Sense 60–61.
// Solver bodies pull values from a per-task Consts component rather than
// referencing constants directly.

.type Color <: number

.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sense <: number

.type Position = [t: number, b: number, l: number, r: number]
.type Dim = [v: number, h: number]

// Unit: singleton key for keyed components applied to a single set — states
// "exactly one set" in the type instead of a dummy int.
.type Unit = U {}

#define TOP    10
#define BOTTOM 11
#define LEFT   12
#define RIGHT  13

#define VERTICAL   20
#define HORIZONTAL 21

#define TOP_LEFT     30
#define TOP_RIGHT    31
#define BOTTOM_LEFT  32
#define BOTTOM_RIGHT 33

#define DIAGONAL     40
#define ANTIDIAGONAL 41

// D4 elements as gather permutations of (t, b, l, r). Naming: what swaps,
// not the axis of reflection.
#define IDENTITY      50
#define ROT_CW        51
#define ROT_180       52
#define ROT_CCW       53
#define FLIP_LR       54
#define FLIP_TB       55
#define FLIP_DIAG     56
#define FLIP_ANTIDIAG 57

// Sense of a turn.
#define CW  60
#define CCW 61

// Origin: position with 0 distance to every edge.
#define ORIGIN [0, 0, 0, 0]

// ============================================================
// Solver body primitives
// ============================================================

// Dispatch/projection functors (C++, in lib_functors.cpp).
//
// The primitives that dispatch on an orientation value (dist on Dir,
// edge_delta on Dir, split/divide/divide_by_size/concat on Axis, apply on D4)
// are single-clause inlines that call these functors. Keeping each to one
// clause is what bounds IR path count: a multi-clause inline contributes xN to
// every rule that calls it, because the dispatch value comes from a relation
// and Souffle can't prune the impossible combinations. One clause -> one query
// plan.
//
// Functors return `number`, never a Position record; each wrapper reassembles
// its Position as a Datalog record literal, filling slots from number functors
// (`@keep_dir` / `@keep_axis` for keep-when-selector-matches; `@axis_near` /
// `@axis_far` for the two slots along an axis). Guards and arithmetic stay in
// Datalog inside the single clause. lib_functors.cpp covers why functors return
// numbers rather than records.
.functor dist_proj(d: Dir, t: number, b: number, l: number, r: number): number
.functor keep_dir(sel: Dir, target: number, v: number): number
.functor keep_axis(sel: Axis, target: number, v: number): number
.functor axis_near(a: Axis, t: number, b: number, l: number, r: number): number
.functor axis_far(a: Axis, t: number, b: number, l: number, r: number): number
.functor apply_t(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_b(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_l(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_r(d: D4, t: number, b: number, l: number, r: number): number

.decl dir_elem(d: Dir)
dir_elem(TOP).
dir_elem(BOTTOM).
dir_elem(LEFT).
dir_elem(RIGHT).

.decl axis_elem(a: Axis)
axis_elem(VERTICAL).
axis_elem(HORIZONTAL).

.decl diag_dir_elem(d: DiagDir)
diag_dir_elem(TOP_LEFT).
diag_dir_elem(TOP_RIGHT).
diag_dir_elem(BOTTOM_LEFT).
diag_dir_elem(BOTTOM_RIGHT).

.decl d4_elem(d: D4)
d4_elem(IDENTITY).
d4_elem(ROT_CW).
d4_elem(ROT_180).
d4_elem(ROT_CCW).
d4_elem(FLIP_LR).
d4_elem(FLIP_TB).
d4_elem(FLIP_DIAG).
d4_elem(FLIP_ANTIDIAG).

// Axis of a Dir.
.decl axis_of(d: Dir, a: Axis)
axis_of(TOP,    VERTICAL).
axis_of(BOTTOM, VERTICAL).
axis_of(LEFT,   HORIZONTAL).
axis_of(RIGHT,  HORIZONTAL).

// Diagonal axis of a corner.
.decl diag_axis_of(d: DiagDir, da: DiagAxis)
diag_axis_of(TOP_LEFT,     DIAGONAL).
diag_axis_of(BOTTOM_RIGHT, DIAGONAL).
diag_axis_of(TOP_RIGHT,    ANTIDIAGONAL).
diag_axis_of(BOTTOM_LEFT,  ANTIDIAGONAL).

// Cardinal Dir of corner d on axis a.
.decl dir_of(d: DiagDir, a: Axis, dir: Dir)
dir_of(TOP_LEFT,     VERTICAL,   TOP).
dir_of(TOP_LEFT,     HORIZONTAL, LEFT).
dir_of(TOP_RIGHT,    VERTICAL,   TOP).
dir_of(TOP_RIGHT,    HORIZONTAL, RIGHT).
dir_of(BOTTOM_LEFT,  VERTICAL,   BOTTOM).
dir_of(BOTTOM_LEFT,  HORIZONTAL, LEFT).
dir_of(BOTTOM_RIGHT, VERTICAL,   BOTTOM).
dir_of(BOTTOM_RIGHT, HORIZONTAL, RIGHT).

// Opposite Dir on the same axis.
.decl opposite(d: Dir, opp: Dir)
opposite(TOP,    BOTTOM).
opposite(BOTTOM, TOP).
opposite(LEFT,   RIGHT).
opposite(RIGHT,  LEFT).

// The D4 reflection inverting axis a.
.decl flip_of(a: Axis, d: D4)
flip_of(VERTICAL,   FLIP_TB).
flip_of(HORIZONTAL, FLIP_LR).

// Dir reached by a quarter turn in sense s. opposite is the half turn.
.decl turn(s: Sense, d: Dir, d_out: Dir)
turn(CW, TOP,    RIGHT).
turn(CW, RIGHT,  BOTTOM).
turn(CW, BOTTOM, LEFT).
turn(CW, LEFT,   TOP).
turn(CCW, D2, D) :- turn(CW, D, D2).

// Distance from p to edge d.
.decl dist(p: Position, d: Dir, k: number) inline
dist(P, D, K) :- P = [T, B, L, R], K = @dist_proj(D, T, B, L, R).

// Element-wise sum of two Positions. One operand may be a signed delta.
.decl compose(p1: Position, p2: Position, p3: Position) inline
compose([T1, B1, L1, R1], [T2, B2, L2, R2], [T1+T2, B1+B2, L1+L2, R1+R2]) :- true.

// Edge delta: a Position carrying k at edge d, zero elsewhere.
.decl edge_delta(d: Dir, k: number, p: Position) inline
edge_delta(D, K, [@keep_dir(D, TOP, K), @keep_dir(D, BOTTOM, K), @keep_dir(D, LEFT, K), @keep_dir(D, RIGHT, K)]) :- true.

// K-cell displacement toward d: -k at edge d, +k at its opposite.
.decl jump_delta(d: Dir, k: number, delta: Position) inline
jump_delta(D, K, Delta) :-
    opposite(D, O), edge_delta(D, -K, Sd), edge_delta(O, K, So), compose(Sd, So, Delta).

// Unit step toward d — the k = 1 jump_delta.
.decl step_delta(d: Dir, delta: Position) inline
step_delta(D, Step) :- jump_delta(D, 1, Step).

// Decompose p by axis: along carries the axis component (perpendicular
// zeroed); across carries the perpendicular (axis zeroed).
.decl split(p: Position, a: Axis, along: Position, across: Position) inline
split(P, A,
      [@keep_axis(A, VERTICAL, T),   @keep_axis(A, VERTICAL, B),   @keep_axis(A, HORIZONTAL, L), @keep_axis(A, HORIZONTAL, R)],
      [@keep_axis(A, HORIZONTAL, T), @keep_axis(A, HORIZONTAL, B), @keep_axis(A, VERTICAL, L),   @keep_axis(A, VERTICAL, R)]) :-
    P = [T, B, L, R].

// Extent of p's frame along axis a — read off any position in the frame.
.decl axis_dim(p: Position, a: Axis, n: number) inline
axis_dim(P, A, N) :- P = [T, B, L, R],
    N = @axis_near(A, T, B, L, R) + @axis_far(A, T, B, L, R) + 1.

// Apply a D4 transform to a Position — a pure index permutation.
.decl apply(d: D4, p: Position, p_out: Position) inline
apply(D, P, [@apply_t(D, T, B, L, R), @apply_b(D, T, B, L, R),
             @apply_l(D, T, B, L, R), @apply_r(D, T, B, L, R)]) :- P = [T, B, L, R].

// Divide p's axis-a extent into n equal parts. p_outer is the tile
// index in an n-strip frame; p_inner is the cell within the tile.
// Both axis-only (perpendicular zeroed). Cells in gap rows/cols (gap > 0)
// produce no decomposition. Two divides on different axes compose to 2D.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, A, N, G, P_outer, P_inner) :-
    P = [T, B, L, R],
    Near = @axis_near(A, T, B, L, R), Far = @axis_far(A, T, B, L, R),
    Ext = Near + Far + 1,
    (Ext - (N-1)*G) % N = 0,
    Sh = (Ext - (N-1)*G) / N,
    K_cyc = Near % (Sh + G),
    K_cyc < Sh,
    O = Near / (Sh + G),
    P_outer = [@keep_axis(A, VERTICAL, O),     @keep_axis(A, VERTICAL, N-1-O),
               @keep_axis(A, HORIZONTAL, O),   @keep_axis(A, HORIZONTAL, N-1-O)],
    P_inner = [@keep_axis(A, VERTICAL, K_cyc), @keep_axis(A, VERTICAL, Sh-1-K_cyc),
               @keep_axis(A, HORIZONTAL, K_cyc), @keep_axis(A, HORIZONTAL, Sh-1-K_cyc)].

// Like divide, but parameterized by tile size k instead of tile count n.
// Tile count is recovered from p's axis-a extent: n = (extent + gap) /
// (k + gap).
// Asserts: gap-adjusted extent is a multiple of (k + gap).
.decl divide_by_size(p: Position, a: Axis, k: number, gap: number,
                     p_outer: Position, p_inner: Position) inline
divide_by_size(P, A, K, G, P_outer, P_inner) :-
    P = [T, B, L, R],
    Near = @axis_near(A, T, B, L, R), Far = @axis_far(A, T, B, L, R),
    Ext = Near + Far + 1,
    (Ext + G) % (K + G) = 0,
    N = (Ext + G) / (K + G),
    K_cyc = Near % (K + G),
    K_cyc < K,
    O = Near / (K + G),
    P_outer = [@keep_axis(A, VERTICAL, O),     @keep_axis(A, VERTICAL, N-1-O),
               @keep_axis(A, HORIZONTAL, O),   @keep_axis(A, HORIZONTAL, N-1-O)],
    P_inner = [@keep_axis(A, VERTICAL, K_cyc), @keep_axis(A, VERTICAL, K-1-K_cyc),
               @keep_axis(A, HORIZONTAL, K_cyc), @keep_axis(A, HORIZONTAL, K-1-K_cyc)].

// Distance t along a period of w (with gap g between periods) decomposes
// into period index n and within-period offset k. Per-cell scalar peer of
// `divide_by_size`, without the divisibility assertion.
.decl stride(t: number, w: number, g: number, n: number, k: number) inline
stride(T, W, G, N, K) :-
    T >= 0,
    T_cyc = T % (W + G), T_cyc < W,
    K = T_cyc,
    N = T / (W + G).

// Recompose axis-a tiles into a single extent — inverse of divide. p_outer
// is the tile index in an n-strip frame; p_inner is the cell within the
// tile. Both axis-only (perpendicular zeroed); p_grid is axis-only on the
// same axis. With gap > 0, only filled tile cells appear in p_grid — gap
// rows/cols are absent. Two concats on different axes compose to 2D.
.decl concat(p_outer: Position, p_inner: Position, a: Axis, gap: number,
             p_grid: Position) inline
concat(P_outer, P_inner, A, G, P_grid) :-
    P_outer = [OT, OB, OL, OR], P_inner = [IT, IB, IL, IR],
    ONear = @axis_near(A, OT, OB, OL, OR), OFar = @axis_far(A, OT, OB, OL, OR),
    INear = @axis_near(A, IT, IB, IL, IR), IFar = @axis_far(A, IT, IB, IL, IR),
    Span = INear + IFar + 1,
    GNear = ONear*(Span+G) + INear,
    GFar  = OFar*(Span+G) + IFar,
    P_grid = [@keep_axis(A, VERTICAL, GNear), @keep_axis(A, VERTICAL, GFar),
              @keep_axis(A, HORIZONTAL, GNear), @keep_axis(A, HORIZONTAL, GFar)].

// ============================================================
// Composites — recurring solver-body shapes built from primitives
// ============================================================

// Anchors only work on grounded positions.

// Same dist-to-edge D for two positions.
.decl same_dist(d: Dir, p1: Position, p2: Position) inline
same_dist(D, P1, P2) :- dist(P1, D, K), dist(P2, D, K).

// Two positions agree on the distances to the two edges of corner d.
.decl corner_anchor(d: DiagDir, p1: Position, p2: Position) inline
corner_anchor(Diag, P1, P2) :-
    dir_of(Diag, VERTICAL,   V_dir),
    dir_of(Diag, HORIZONTAL, H_dir),
    same_dist(V_dir, P1, P2),
    same_dist(H_dir, P1, P2).

// Two positions agree on dist-to-edge d and on the perpendicular extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2),
    axis_of(D, A),
    split(P1, A, _, Ac), split(P2, A, _, Ac).

// 1D divide along axis a with perpendicular passthrough. p_outer is
// axis-only on a; p_inner is the full 2D within-slab position —
// perpendicular carried from p.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide_slab(p: Position, a: Axis, n: number, gap: number,
                  p_outer: Position, p_inner: Position) inline
divide_slab(P, A, N, G, P_outer, P_inner) :-
    divide(P, A, N, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

// 2D divide on both axes. Tile count n and gap as Dim. Outputs are full
// 2D: p_outer indexes an outer.v×outer.h tile arrangement; p_inner is
// the cell within an inner.v×inner.h tile.
.decl divide_2d(p: Position, n: Dim, gap: Dim,
                p_outer: Position, p_inner: Position) inline
divide_2d(P, [Nv, Nh], [Gv, Gh], P_outer, P_inner) :-
    divide(P, VERTICAL,   Nv, Gv, P_ov, P_iv),
    divide(P, HORIZONTAL, Nh, Gh, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// Like divide_2d, but parameterized by tile size — k and gap as Dim.
.decl divide_by_size_2d(p: Position, k: Dim, gap: Dim,
                        p_outer: Position, p_inner: Position) inline
divide_by_size_2d(P, [Kv, Kh], [Gv, Gh], P_outer, P_inner) :-
    divide_by_size(P, VERTICAL,   Kv, Gv, P_ov, P_iv),
    divide_by_size(P, HORIZONTAL, Kh, Gh, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// 1D concat along axis a with perpendicular passthrough — inverse of
// divide_slab. p_outer is axis-only on a; p_inner is full 2D
// (within-slab); p_grid is the recomposed full 2D position.
.decl concat_slab(p_outer: Position, p_inner: Position, a: Axis, gap: number,
                  p_grid: Position) inline
concat_slab(P_outer, P_inner, A, G, P_grid) :-
    split(P_inner, A, P_i_axis, Across),
    concat(P_outer, P_i_axis, A, G, P_along),
    compose(P_along, Across, P_grid).

// 2D concat on both axes — inverse of divide_2d / divide_by_size_2d.
// p_outer and p_inner are full 2D; gap as Dim; p_grid is the recomposed
// full 2D position.
.decl concat_2d(p_outer: Position, p_inner: Position, gap: Dim,
                p_grid: Position) inline
concat_2d(P_outer, P_inner, [Gv, Gh], P_grid) :-
    split(P_outer, VERTICAL, P_outer_v, P_outer_h),
    split(P_inner, VERTICAL, P_inner_v, P_inner_h),
    concat(P_outer_v, P_inner_v, VERTICAL,   Gv, P_grid_v),
    concat(P_outer_h, P_inner_h, HORIZONTAL, Gh, P_grid_h),
    compose(P_grid_v, P_grid_h, P_grid).

// ============================================================
// Body components — instantiated at solver-body scope
// ============================================================

// 1D frame defined by an index set and an edge. Solver populates `dir(d)`
// (the edge distances are measured from) and `dist_set(k)` (the indices
// that make up the frame). Component derives extent as the set's size and
// exposes `pos(k, p)` mapping each index to its axis-only Position.
//
// Flagged: assumes dist_set is dense — {0, 1, ..., extent-1}. With a sparse
// set, indices above |dist_set|-1 give invalid Positions (`pos` sets the
// opposite-edge distance to |dist_set|-1-k, which goes negative).
.comp DirFrame {
    .decl dir(d: Dir)
    .decl dist_set(k: number)

    .decl extent(n: number)
    extent(N) :- N = count : { dist_set(_) }.

    // Position at distance k from edge dir, axis-only (perpendicular zeroed).
    .decl pos(k: number, p: Position) inline
    pos(K, P) :-
        dist_set(K), dir(D), opposite(D, D_opp), extent(N),
        edge_delta(D, K, P_d), edge_delta(D_opp, N-1-K, P_o),
        compose(P_d, P_o, P).
}

// A corner diagonal — cells equidistant from the corner's two edges; ring is
// that shared distance. The full corner-to-corner diagonal, center included.
// DiagPlacement.diag_cell is this ∩ quadrant — the corner→center ray.
.comp Diagonal {
    .decl cell(p: Position)
    .decl corner(d: DiagDir)

    .decl diagonal(p: Position, ring: number)
    diagonal(P, K) :-
        cell(P), corner(Diag),
        dir_of(Diag, VERTICAL,   Dv), dist(P, Dv, K),
        dir_of(Diag, HORIZONTAL, Dh), dist(P, Dh, K).
}

// Diagonal placement — the quadrant a cell sits in, and its ring. Solver
// populates `cell` (the position domain).
.comp DiagPlacement {
    .decl cell(p: Position)

    // Strictly nearer edge d than its opposite — which side of the axis midline.
    .decl nearer(p: Position, d: Dir)
    nearer(P, D) :-
        cell(P), dir_elem(D),
        dist(P, D, K), opposite(D, Opp), dist(P, Opp, K2), K < K2.

    // The diagonal quadrant a cell sits in: nearer on both of that corner's edges.
    .decl quadrant(p: Position, diag: DiagDir)
    quadrant(P, Diag) :-
        dir_of(Diag, VERTICAL,   Dv), nearer(P, Dv),
        dir_of(Diag, HORIZONTAL, Dh), nearer(P, Dh).

    // On the diagonal of its quadrant, at ring K — the shared distance to both
    // edges of that corner.
    .decl diag_cell(p: Position, diag: DiagDir, ring: number)
    diag_cell(P, Diag, K) :-
        quadrant(P, Diag),
        dir_of(Diag, VERTICAL,   Dv), dist(P, Dv, K),
        dir_of(Diag, HORIZONTAL, Dh), dist(P, Dh, K).
}

// Cell between two keyed marks on its line along `axis`. `mark_side` is the
// one-sided reach; `between` folds the two sides. Reach is inclusive (`<=`),
// so a mark is between under its own key; on a mark-free domain, inclusive
// and strict reach coincide, so callers that exclude marks (a bg-only
// domain) get the strict semantics for free. A domain and marks projected
// to axis-only positions share one line, so `between` gives the marks'
// span along the axis.
.comp Between<Key> {
    .decl axis(a: Axis)
    .decl cell(p: Position)            // domain tested
    .decl mark(key: Key, p: Position)

    // A key-K mark at or beyond p toward edge d, in p's line.
    .decl mark_side(key: Key, p: Position, d: Dir)
    mark_side(K, P, D) :-
        cell(P), mark(K, Q),
        axis(A), split(P, A, _, Ac), split(Q, A, _, Ac),
        axis_of(D, A), dist(P, D, Kp), dist(Q, D, Kq), Kq <= Kp.

    .decl between(key: Key, p: Position)
    between(K, P) :- mark_side(K, P, D), opposite(D, O), mark_side(K, P, O).
}

// Sparse numeric set → dense ordinal position. Solver populates `idx_set`;
// `rank(k, r)` gives r = the count of elements strictly less than k, so ranks
// run ascending from 0. A descending layout falls out by placing ranks from
// the opposite edge; negate upstream only when the rank value itself flows
// downstream. idx_set is a set — items sharing k share its rank, and the rank
// set stays dense under ties.
.comp Ordinal {
    .decl idx_set(k: number)

    .decl rank(k: number, r: number)
    rank(K, R) :-
        idx_set(K),
        R = count : { idx_set(K2), K2 < K }.
}

// Keyed set comparison via the count-trick. Solver populates pattern_member
// (a catalog of known sets, enumerated by `pattern`) and observed_member (the
// observed set at each `observed` key); the component exposes `covers`
// (observed ⊇ pattern), `equals` (set equality), and `pattern_size` (members
// per pattern, for size-ranked selection over matches). Member is a single
// type param — a record for multi-field members,
// a scalar for one-field. Single-pattern sites use pattern = 0; a global
// observed set keys on Unit.
.comp KeyedSetCompare<Key, Member> {
    .decl pattern_member(pattern: number, m: Member)
    .decl observed_member(observed: Key, m: Member)

    .decl pattern_size(pattern: number, n: number)
    pattern_size(Pat, N) :- pattern_member(Pat, _), N = count : { pattern_member(Pat, M) }.

    // observed ⊇ pattern: every pattern member is present in the observed set
    .decl covers(observed: Key, pattern: number)
    covers(Obs, Pat) :-
        observed_member(Obs, _),
        pattern_size(Pat, N),
        N = count : { pattern_member(Pat, M), observed_member(Obs, M) }.

    // observed == pattern: covers, and the observed set carries no extra members
    .decl equals(observed: Key, pattern: number)
    equals(Obs, Pat) :-
        covers(Obs, Pat),
        pattern_size(Pat, N),
        N = count : { observed_member(Obs, M) }.
}

// Re-express keyed cells relative to a per-key outer origin: inner = cell
// minus outer, the inverse of compose. Outer extent + inner extent = cell
// extent, so one subtraction both resizes and positions across frames.
// `outer` is one origin per key — several origins under one key
// cross-product; key by the thing varied instead. Bbox's `margin` is an
// `outer`: feeding it views a cell set from its own bounding frame.
.comp Reframe<Key> {
    .decl outer(key: Key, p: Position)
    .decl cell(key: Key, p: Position)

    .decl sub(p: Position, q: Position, d: Position) inline
    sub([T1, B1, L1, R1], [T2, B2, L2, R2], [T1-T2, B1-B2, L1-L2, R1-R2]) :- true.

    .decl inner(key: Key, p: Position)
    inner(K, I) :- cell(K, P), outer(K, O), sub(P, O, I).
}

// Bounding box of a keyed cell set, from the min distance to each edge over
// the set (min-per-edge rather than min/max-per-axis: the four mins are
// already a Position, and the edge choice washes out under D4). Two readouts:
// `margin` packs the mins into a Position — the box's placement, a Reframe
// outer; `inside` tests `grid` cells against them. Single-set sites key
// on Unit.
.comp Bbox<Key> {
    .decl cell(key: Key, p: Position)
    .decl grid(key: Key, p: Position)

    .decl cell_dist(key: Key, d: Dir, k: number)
    cell_dist(K, D, Kd) :- cell(K, P), dir_elem(D), dist(P, D, Kd).

    .decl edge_min(key: Key, d: Dir, m: number)
    edge_min(K, D, M) :- cell_dist(K, D, _), M = min Kd : { cell_dist(K, D, Kd) }.

    // The box as a Position — margin from each edge.
    .decl margin(key: Key, p: Position)
    margin(K, [Mt, Mb, Ml, Mr]) :-
        edge_min(K, TOP, Mt), edge_min(K, BOTTOM, Mb),
        edge_min(K, LEFT, Ml), edge_min(K, RIGHT, Mr).

    // Grid cells inside the box — at least the margin from every edge.
    .decl inside(key: Key, p: Position)
    inside(K, P) :-
        grid(K, P),
        dist(P, TOP, T),    edge_min(K, TOP, Mt),    T >= Mt,
        dist(P, BOTTOM, B), edge_min(K, BOTTOM, Mb), B >= Mb,
        dist(P, LEFT, L),   edge_min(K, LEFT, Ml),   L >= Ml,
        dist(P, RIGHT, R),  edge_min(K, RIGHT, Mr),  R >= Mr.
}

// Opaque component id — sealed so it can't be read as a Position, which would
// leak the representative cell's coordinates in as orientation.
.type CompId = Comp { tag: number }

// Connected components of a node set (4-adjacency), each labeled by an opaque
// id off the lowest-ord member cell: ord is arbitrary but within-run stable,
// so the pick carries no geometry. A member cell is injective identity —
// distinct components have disjoint cells; a bounding box would alias two
// components sharing one (interleaved diagonals under 8-adjacency).
.comp Components {
    .decl node(p: Position)

    .decl step(delta: Position)
    step([-1, 1, 0, 0]). step([1, -1, 0, 0]). step([0, 0, -1, 1]). step([0, 0, 1, -1]).

    .decl conn(p: Position, q: Position)
    conn(P, P)  :- node(P).
    conn(P, Q2) :- conn(P, Q1), step(D), compose(Q1, D, Q2), node(Q2).

    .decl label(p: Position, id: CompId)
    label(P, $Comp(Min)) :- node(P), Min = min ord(Q) : { conn(P, Q) }.
}

// Occurrences of a shape among cells: placements where the shape's footprint
// lands fully on the cell set — the ARC "find this shape" move. Placements
// come backward from the data (cell minus shape-cell), so no grid bounds are
// needed and off-grid candidates self-filter: their footprint cells aren't in
// `cell`, so `covers` fails.
.comp Occurrences {
    .decl cell(p: Position)
    .decl shape(p: Position)

    // Candidate placements — align each shape cell (one origin per key) to
    // every cell, union over the shape cells.
    .init align = Reframe<Position>
    align.cell(S, P)  :- shape(S), cell(P).
    align.outer(S, S) :- shape(S).
    .decl placement(p: Position)
    placement(M) :- align.inner(_, M).

    // View the cells from each placement and test the shape's footprint.
    .init view = Reframe<Position>
    view.outer(M, M) :- placement(M).
    view.cell(M, P)  :- placement(M), cell(P).

    .init matcher = KeyedSetCompare<Position, Position>
    matcher.pattern_member(0, S)  :- shape(S).
    matcher.observed_member(M, I) :- view.inner(M, I).

    .decl occurrence(p: Position)
    occurrence(M) :- matcher.covers(M, 0).
}

// Fold of per-axis images over both axes. Position factors by axis; a
// per-axis map acts on its own factor, so maps on different axes commute
// and the internal axis order washes out. For a body-supplied per-axis map
// — the body cannot name the axes to chain them itself. `img` must be
// total over the fold's domain: a (key, p) missing either axis image drops
// out of `both`. Per-axis flip-or-keep maps land in the Klein subgroup;
// rotations mix the two factors and are out of reach.
.comp AxisChain<Key> {
    .decl img(a: Axis, key: Key, p: Position, p_img: Position)

    .decl both(key: Key, p: Position, p_img: Position)
    both(K, P, P2) :- img(VERTICAL, K, P, P1), img(HORIZONTAL, K, P1, P2).
}

// ============================================================
// Consts helpers — instantiated inside Consts; not reachable from body
// ============================================================

.comp ConstsHelpers {
    // All positions of a frame of given Dim.
    .decl frame_pos(dim: Dim, p: Position) inline
    frame_pos([V, H], [T, V-1-T, L, H-1-L]) :- T = range(0, V), L = range(0, H).

    // Decompose a position in an outer×inner tiled frame into outer (which
    // tile) and inner (cell within the tile). Gap rows/cols between tiles
    // produce no entry. Combined-frame dim is
    //   (outer.v*inner.v + (outer.v-1)*gap.v,
    //    outer.h*inner.h + (outer.h-1)*gap.h).
    .decl tile_pos(outer: Dim, inner: Dim, gap: Dim,
                   p: Position, p_outer: Position, p_inner: Position) inline
    tile_pos([Ov, Oh], [Iv, Ih], [Gv, Gh],
             [T, B, L, R],
             [Mt, Ov-1-Mt, Ml, Oh-1-Ml],
             [It, Iv-1-It, Il, Ih-1-Il]) :-
        Mt = range(0, Ov), Ml = range(0, Oh),
        It = range(0, Iv), Il = range(0, Ih),
        T = Mt*(Iv+Gv) + It,
        L = Ml*(Ih+Gh) + Il,
        B = Ov*Iv + (Ov-1)*Gv - 1 - T,
        R = Oh*Ih + (Oh-1)*Gh - 1 - L.
}
