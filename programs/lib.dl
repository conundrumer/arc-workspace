// Shared types and primitives for ARC solvers in Souffle.
//
// Position: 4 distances from edges, ordered V-first then H — (top, bottom,
// left, right). Dir constants index into Position.
//
// Dim: (V-length, H-length) of a frame — ConstsHelpers grouping notation only.
//
// The subtypes of number are typed names with no arithmetic intent.

.type Color <: number

.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sym <: number
.type Sense <: number

// The rotation subgroup of D4 — how a heading changes.
.type C4 <: D4

.type Dir8 = Dir | DiagDir

.type Axis4 = Axis | DiagAxis

// A label carrying identity and nothing else: join on equality, never order
// or count with it.
.type Ident <: number

// Index of a task example.
.type Example <: number

.type Position = [t: number, b: number, l: number, r: number]
.type Dim = [v: number, h: number]

// A Position slot's nature: a frame cell (bare), a translation (Shift), or
// independent signed edge depths (Inset). A delta is a Shift when its changes
// on each axis sum to zero, and an Inset otherwise.
.type Shift = Position
.type Inset = Position

// Singleton key for keyed components applied to a single set.
.type Unit = U {}

#define DIR_T 10
#define DIR_B 11
#define DIR_L 12
#define DIR_R 13

#define AXIS_V 20
#define AXIS_H 21

#define DIAG_TL 30
#define DIAG_TR 31
#define DIAG_BL 32
#define DIAG_BR 33

#define DAXIS_DG 40
#define DAXIS_AD 41

// Rotations: quarter CW, half turn, quarter CCW. Flips are named by what
// swaps, not the axis of reflection.
#define D4_ID 50
#define D4_CW 51
#define D4_HT 52
#define D4_CC 53
#define D4_LR 54
#define D4_TB 55
#define D4_DG 56
#define D4_AD 57

#define SENSE_CW 60
#define SENSE_CC 61

// The subgroups of D4 — a symmetry group as a closed value. Order-2
// groups are named by their non-identity element; SYM_BOX is the
// axis-aligned Klein group, SYM_X the diagonal one, SYM_C4 the rotations.
#define SYM_1   70
#define SYM_LR  71
#define SYM_TB  72
#define SYM_HT  73
#define SYM_DG  74
#define SYM_AD  75
#define SYM_BOX 76
#define SYM_X   77
#define SYM_C4  78
#define SYM_D4  79

#define ORIGIN [0, 0, 0, 0]

// ============================================================
// Runner contract — run_dl.py appends each mode's IO directives
// ============================================================

// The task input grid.
.decl in(p: Position, col: Color)

// Train and test inputs and train outputs, fed in fit mode.
.decl ex_in(e: Example, p: Position, col: Color)
.decl ex_out(e: Example, p: Position, col: Color)

// Per-slot diff between fit.<slot> and c.<slot>; the runner synthesizes
// the rules.
.decl fit_diff(slot: symbol)

// ============================================================
// Solver body primitives
// ============================================================

// Dispatch/projection functors (C++, in lib_functors.cpp).
.functor dist_proj(d: Dir, t: number, b: number, l: number, r: number): number
.functor keep_dir(sel: Dir8, target: number, v: number): number
.functor keep_axis(sel: Axis, target: number, v: number): number
.functor axis_near(a: Axis, t: number, b: number, l: number, r: number): number
.functor axis_far(a: Axis, t: number, b: number, l: number, r: number): number
.functor apply_t(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_b(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_l(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_r(d: D4, t: number, b: number, l: number, r: number): number

.decl dir_elem(d: Dir)
dir_elem(DIR_T).
dir_elem(DIR_B).
dir_elem(DIR_L).
dir_elem(DIR_R).

.decl axis_elem(a: Axis)
axis_elem(AXIS_V).
axis_elem(AXIS_H).

.decl diag_dir_elem(d: DiagDir)
diag_dir_elem(DIAG_TL).
diag_dir_elem(DIAG_TR).
diag_dir_elem(DIAG_BL).
diag_dir_elem(DIAG_BR).

.decl diag_axis_elem(da: DiagAxis)
diag_axis_elem(DAXIS_DG).
diag_axis_elem(DAXIS_AD).

.decl dir8_elem(d: Dir8)
dir8_elem(D) :- dir_elem(D).
dir8_elem(D) :- diag_dir_elem(D).

.decl axis4_elem(a: Axis4)
axis4_elem(A) :- axis_elem(A).
axis4_elem(A) :- diag_axis_elem(A).

.decl d4_elem(d: D4)
d4_elem(D4_ID).
d4_elem(D4_CW).
d4_elem(D4_HT).
d4_elem(D4_CC).
d4_elem(D4_LR).
d4_elem(D4_TB).
d4_elem(D4_DG).
d4_elem(D4_AD).

.decl d4_inverse(d: D4, d_inv: D4)
d4_inverse(D4_ID, D4_ID).
d4_inverse(D4_CW, D4_CC).
d4_inverse(D4_HT, D4_HT).
d4_inverse(D4_CC, D4_CW).
d4_inverse(D4_LR, D4_LR).
d4_inverse(D4_TB, D4_TB).
d4_inverse(D4_DG, D4_DG).
d4_inverse(D4_AD, D4_AD).

.decl sense_elem(s: Sense)
sense_elem(SENSE_CW).
sense_elem(SENSE_CC).

.decl sym_elem(s: Sym)
sym_elem(SYM_1).
sym_elem(SYM_LR).
sym_elem(SYM_TB).
sym_elem(SYM_HT).
sym_elem(SYM_DG).
sym_elem(SYM_AD).
sym_elem(SYM_BOX).
sym_elem(SYM_X).
sym_elem(SYM_C4).
sym_elem(SYM_D4).

.decl sym_member(s: Sym, d: D4)
sym_member(SYM_1, D4_ID).
sym_member(SYM_LR, D4_ID). sym_member(SYM_LR, D4_LR).
sym_member(SYM_TB, D4_ID). sym_member(SYM_TB, D4_TB).
sym_member(SYM_HT, D4_ID). sym_member(SYM_HT, D4_HT).
sym_member(SYM_DG, D4_ID). sym_member(SYM_DG, D4_DG).
sym_member(SYM_AD, D4_ID). sym_member(SYM_AD, D4_AD).
sym_member(SYM_BOX, D4_ID). sym_member(SYM_BOX, D4_LR).
sym_member(SYM_BOX, D4_TB). sym_member(SYM_BOX, D4_HT).
sym_member(SYM_X, D4_ID). sym_member(SYM_X, D4_DG).
sym_member(SYM_X, D4_AD). sym_member(SYM_X, D4_HT).
sym_member(SYM_C4, D) :- c4_elem(D).
sym_member(SYM_D4, D) :- d4_elem(D).

.decl c4_elem(d: C4)
c4_elem(D4_ID).
c4_elem(D4_CW).
c4_elem(D4_HT).
c4_elem(D4_CC).

.decl axis_of(d: Dir, a: Axis)
axis_of(DIR_T, AXIS_V).
axis_of(DIR_B, AXIS_V).
axis_of(DIR_L, AXIS_H).
axis_of(DIR_R, AXIS_H).

.decl diag_axis_of(d: DiagDir, da: DiagAxis)
diag_axis_of(DIAG_TL, DAXIS_DG).
diag_axis_of(DIAG_BR, DAXIS_DG).
diag_axis_of(DIAG_TR, DAXIS_AD).
diag_axis_of(DIAG_BL, DAXIS_AD).

.decl axis4_of(d: Dir8, a: Axis4)
axis4_of(D, A) :- axis_of(D, A).
axis4_of(D, A) :- diag_axis_of(D, A).

// Cardinal Dir of corner d on axis a.
.decl dir_of(d: DiagDir, a: Axis, dir: Dir)
dir_of(DIAG_TL, AXIS_V, DIR_T).
dir_of(DIAG_TL, AXIS_H, DIR_L).
dir_of(DIAG_TR, AXIS_V, DIR_T).
dir_of(DIAG_TR, AXIS_H, DIR_R).
dir_of(DIAG_BL, AXIS_V, DIR_B).
dir_of(DIAG_BL, AXIS_H, DIR_L).
dir_of(DIAG_BR, AXIS_V, DIR_B).
dir_of(DIAG_BR, AXIS_H, DIR_R).

.decl opposite(d: Dir, opp: Dir)
opposite(DIR_T, DIR_B).
opposite(DIR_B, DIR_T).
opposite(DIR_L, DIR_R).
opposite(DIR_R, DIR_L).

.decl diag_opposite(d: DiagDir, opp: DiagDir)
diag_opposite(DIAG_TL, DIAG_BR).
diag_opposite(DIAG_BR, DIAG_TL).
diag_opposite(DIAG_TR, DIAG_BL).
diag_opposite(DIAG_BL, DIAG_TR).

.decl dir8_opposite(d: Dir8, d2: Dir8)
dir8_opposite(D, D2) :- opposite(D, D2).
dir8_opposite(D, D2) :- diag_opposite(D, D2).

.decl perp(a: Axis, a2: Axis)
perp(AXIS_V, AXIS_H).
perp(AXIS_H, AXIS_V).

// The two Dirs across d; turn picks one by sense.
.decl perp_dir(d: Dir, d2: Dir)
perp_dir(D, D2) :- axis_of(D, A), perp(A, A2), axis_of(D2, A2).

.decl diag_perp(da: DiagAxis, da2: DiagAxis)
diag_perp(DAXIS_DG, DAXIS_AD).
diag_perp(DAXIS_AD, DAXIS_DG).

// A corner's two dirs, axis-tagged: d1 on axis a, d2 across.
.decl diag_dirs(d: DiagDir, a: Axis, d1: Dir, d2: Dir)
diag_dirs(Diag, A, D1, D2) :- dir_of(Diag, A, D1), perp(A, A2), dir_of(Diag, A2, D2).

// The D4 reflection inverting axis a.
.decl flip_of(a: Axis, d: D4)
flip_of(AXIS_V, D4_TB).
flip_of(AXIS_H, D4_LR).

// The D4 reflection across diagonal axis da.
.decl diag_flip_of(da: DiagAxis, d: D4)
diag_flip_of(DAXIS_DG, D4_DG).
diag_flip_of(DAXIS_AD, D4_AD).

// Dir reached by a quarter turn in sense s. opposite is the half turn;
// the eighth turn is the corner diag_dirs puts between d and d_out.
.decl turn(s: Sense, d: Dir, d_out: Dir)
turn(SENSE_CW, DIR_T, DIR_R).
turn(SENSE_CW, DIR_R, DIR_B).
turn(SENSE_CW, DIR_B, DIR_L).
turn(SENSE_CW, DIR_L, DIR_T).
turn(SENSE_CC, D2, D) :- turn(SENSE_CW, D, D2).

// The C4 element of a quarter turn in sense s.
.decl rotation(s: Sense, d: C4)
rotation(SENSE_CW, D4_CW).
rotation(SENSE_CC, D4_CC).

.decl dist(p: Position, d: Dir, k: number) inline
dist(P, D, K) :- P = [T, B, L, R], K = @dist_proj(D, T, B, L, R).

// Distances to edge d and its opposite. A repeated variable states
// centered; a comparison picks the nearer half.
.decl dist_pair(p: Position, d: Dir, k: number, k2: number) inline
dist_pair(P, D, K, K2) :- dist(P, D, K), opposite(D, O), dist(P, O, K2).

// Distances to the two edges of corner diag, axis-tagged: k1 to the edge
// on axis a, k2 across. On-diagonal is a repeated variable.
.decl diag_dist(p: Position, diag: DiagDir, a: Axis, k1: number, k2: number) inline
diag_dist(P, Diag, A, K1, K2) :-
    diag_dirs(Diag, A, D1, D2), dist(P, D1, K1), dist(P, D2, K2).

// Taxicab distance to corner diag: the sum of its two edge distances.
// Level sets are the lines of the perpendicular diagonal axis, so
// equality tests same-diagonal and comparison tests sidedness.
.decl corner_dist(p: Position, diag: DiagDir, k: number) inline
corner_dist(P, Diag, K) :- diag_dist(P, Diag, _, K1, K2), K = K1 + K2.

// Element-wise sum of two Positions. One operand may be a signed delta.
.decl compose(p1: Position, p2: Position, p3: Position) inline
compose([T1, B1, L1, R1], [T2, B2, L2, R2], [T1+T2, B1+B2, L1+L2, R1+R2]) :- true.

// The Shift carrying `from` onto `to` — the inverse read of compose.
.decl displacement(from: Position, to: Position, v: Shift) inline
displacement([T1, B1, L1, R1], [T2, B2, L2, R2],
             [T2-T1, B2-B1, L2-L1, R2-R1]) :- true.

// Pointwise ≥ over edge distances: p is inside the box that q describes as
// margins.
.decl geq(p: Position, q: Position) inline
geq([T1, B1, L1, R1], [T2, B2, L2, R2]) :-
    T1 >= T2, B1 >= B2, L1 >= L2, R1 >= R2.

// Pointwise > over edge distances: p is strictly inside the box that q
// describes as margins. At q = ORIGIN, off the frame's border.
.decl gt(p: Position, q: Position) inline
gt([T1, B1, L1, R1], [T2, B2, L2, R2]) :-
    T1 > T2, B1 > B2, L1 > L2, R1 > R2.

// The delta relations below bind none of their direction: the caller
// supplies d.

// Edge delta: a Position carrying k at edge d, zero elsewhere. At a corner,
// k sits at both of the corner's edges.
.decl edge_delta(d: Dir8, k: number, p: Inset) inline
edge_delta(D, K, [@keep_dir(D, DIR_T, K), @keep_dir(D, DIR_B, K), @keep_dir(D, DIR_L, K), @keep_dir(D, DIR_R, K)]) :- true.

// Axis delta: a Position carrying k1 at edge d and k2 at its opposite, zero
// on the other axis.
.decl axis_delta(d: Dir, k1: number, k2: number, p: Inset) inline
axis_delta(D, K1, K2, P) :-
    opposite(D, O), edge_delta(D, K1, P1), edge_delta(O, K2, P2), compose(P1, P2, P).

// A Position carrying k at every edge.
.decl uniform_delta(k: number, p: Inset) inline
uniform_delta(K, [K, K, K, K]) :- true.

// K-cell displacement toward d: -k at each edge of d, +k at each opposite.
.decl jump_delta(d: Dir8, k: number, delta: Shift) inline
jump_delta(D, K, [B - T, T - B, R - L, L - R]) :- edge_delta(D, K, [T, B, L, R]).

// The unit steps, materialized so the functor chain runs eight times per
// program, not once per calling tuple.
.decl _step(d: Dir8, delta: Shift)
_step(D, Step) :- dir8_elem(D), jump_delta(D, 1, Step).

// Unit step toward d.
.decl step_delta(d: Dir8, delta: Shift) inline
step_delta(D, Step) :- _step(D, Step).

// q is one step from p toward d.
.decl neighbor(p: Position, d: Dir8, q: Position) inline
neighbor(P, D, Q) :- step_delta(D, S), compose(P, S, Q).

// q is k cells from p toward d.
.decl jump(p: Position, d: Dir8, k: number, q: Position) inline
jump(P, D, K, Q) :- jump_delta(D, K, Delta), compose(P, Delta, Q).

// Decompose p by axis: along carries the axis component (perpendicular
// zeroed); across carries the perpendicular (axis zeroed). Cells sharing
// along form a line perpendicular to a; same_line(a, ...) is the line
// along a, the cells sharing across.
.decl split(p: Position, a: Axis, along: Position, across: Position) inline
split(P, A,
      [@keep_axis(A, AXIS_V, T), @keep_axis(A, AXIS_V, B), @keep_axis(A, AXIS_H, L), @keep_axis(A, AXIS_H, R)],
      [@keep_axis(A, AXIS_H, T), @keep_axis(A, AXIS_H, B), @keep_axis(A, AXIS_V, L), @keep_axis(A, AXIS_V, R)]) :-
    P = [T, B, L, R].

// Extent of p's frame along axis a — read off any position in the frame.
.decl axis_dim(p: Position, a: Axis, n: number) inline
axis_dim(P, A, N) :- P = [T, B, L, R],
    N = @axis_near(A, T, B, L, R) + @axis_far(A, T, B, L, R) + 1.

// Wide extent readout of p's frame: n1 along axis a, n2 across. A line is
// (N, 1); a repeated variable states a square; a comparison finds the
// long axis.
.decl axis_dims(p: Position, a: Axis, n1: number, n2: number) inline
axis_dims(P, A, N1, N2) :- axis_dim(P, A, N1), perp(A, A2), axis_dim(P, A2, N2).

// Proper sub-extents of p's frame along a: every k with 1 <= k < extent.
.decl sub_extent(p: Position, a: Axis, k: number) inline
sub_extent(P, A, K) :- axis_dim(P, A, N), K = range(1, N).

// Apply a D4 transform to a Position.
.decl apply(d: D4, p: Position, p_out: Position) inline
apply(D, P, [@apply_t(D, T, B, L, R), @apply_b(D, T, B, L, R),
             @apply_l(D, T, B, L, R), @apply_r(D, T, B, L, R)]) :- P = [T, B, L, R].

// The D4 action on directions, one relation per direction type.
.decl apply_dir(d: D4, dir: Dir, dir_out: Dir)
apply_dir(D, Dir, Dir_out) :-
    d4_elem(D), dir_elem(Dir), dir_elem(Dir_out),
    step_delta(Dir, S), apply(D, S, S2), step_delta(Dir_out, S2).

.decl apply_diag_dir(d: D4, dir: DiagDir, dir_out: DiagDir)
apply_diag_dir(D, Dir, Dir_out) :-
    d4_elem(D), diag_dir_elem(Dir), diag_dir_elem(Dir_out),
    step_delta(Dir, S), apply(D, S, S2), step_delta(Dir_out, S2).

.decl apply_dir8(d: D4, dir: Dir8, dir_out: Dir8)
apply_dir8(D, Dir, Dir_out) :-
    d4_elem(D), dir8_elem(Dir), dir8_elem(Dir_out),
    step_delta(Dir, S), apply(D, S, S2), step_delta(Dir_out, S2).

// Divide p's axis-a extent into n equal parts. p_outer is the tile
// index in an n-strip frame; p_inner is the cell within the tile.
// Both axis-only (perpendicular zeroed). Cells in gap rows/cols (gap > 0)
// produce no decomposition.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, A, N, G, P_outer, P_inner) :-
    axis_dim(P, A, Ext),
    (Ext - (N-1)*G) % N = 0,
    K = (Ext - (N-1)*G) / N,
    divide_by_size(P, A, K, G, P_outer, P_inner).

// Like divide, but parameterized by tile size k instead of tile count n.
// Tile count is recovered from p's axis-a extent.
// Asserts: gap-adjusted extent is a multiple of (k + gap).
.decl divide_by_size(p: Position, a: Axis, k: number, gap: number,
                     p_outer: Position, p_inner: Position) inline
divide_by_size(P, A, K, G, P_outer, P_inner) :-
    P = [T, B, L, R],
    Near = @axis_near(A, T, B, L, R), Far = @axis_far(A, T, B, L, R),
    Ext = Near + Far + 1,
    (Ext + G) % (K + G) = 0,
    N = (Ext + G) / (K + G),
    K_cyc = Near % (K + G),
    K_cyc < K,
    O = Near / (K + G),
    P_outer = [@keep_axis(A, AXIS_V, O),     @keep_axis(A, AXIS_V, N-1-O),
               @keep_axis(A, AXIS_H, O),     @keep_axis(A, AXIS_H, N-1-O)],
    P_inner = [@keep_axis(A, AXIS_V, K_cyc), @keep_axis(A, AXIS_V, K-1-K_cyc),
               @keep_axis(A, AXIS_H, K_cyc), @keep_axis(A, AXIS_H, K-1-K_cyc)].

// Gap from tile count and tile size — the divide family's third reading.
// Asserts: the leftover extent divides evenly by the n-1 gaps.
.decl divide_gap(p: Position, a: Axis, n: number, k: number, g: number) inline
divide_gap(P, A, N, K, G) :-
    axis_dim(P, A, Ext), N > 1,
    (Ext - N*K) % (N-1) = 0,
    G = (Ext - N*K) / (N-1).

// Distance t along a period of w (with gap g between periods) decomposes
// into period index n and within-period offset k. Per-cell scalar peer of
// `divide_by_size`, without the divisibility assertion.
// k pinned to 0 states that t is a whole number of periods.
.decl stride(t: number, w: number, g: number, n: number, k: number) inline
stride(T, W, G, N, K) :-
    T >= 0,
    T_cyc = T % (W + G), T_cyc < W,
    K = T_cyc,
    N = T / (W + G).

// Recompose axis-a tiles into a single extent — the inverse of divide, over
// the same p_outer and p_inner. p_grid is axis-only on the same axis. With
// gap > 0, only filled tile cells appear in p_grid — gap rows/cols are
// absent. The assembled extent reads off any p_grid with `axis_dim`; an
// AxisFrame (Frame2D for the 2D forms) over that extent holds the gap
// cells as the cells no tile fills.
.decl concat(p_outer: Position, p_inner: Position, a: Axis, gap: number,
             p_grid: Position) inline
concat(P_outer, P_inner, A, G, P_grid) :-
    P_outer = [OT, OB, OL, OR], P_inner = [IT, IB, IL, IR],
    ONear = @axis_near(A, OT, OB, OL, OR), OFar = @axis_far(A, OT, OB, OL, OR),
    INear = @axis_near(A, IT, IB, IL, IR), IFar = @axis_far(A, IT, IB, IL, IR),
    Span = INear + IFar + 1,
    GNear = ONear*(Span+G) + INear,
    GFar  = OFar*(Span+G) + IFar,
    P_grid = [@keep_axis(A, AXIS_V, GNear), @keep_axis(A, AXIS_V, GFar),
              @keep_axis(A, AXIS_H, GNear), @keep_axis(A, AXIS_H, GFar)].

// ============================================================
// Composites — recurring solver-body shapes built from primitives
// ============================================================

// Anchors only work on grounded positions.

// Two positions agree on the distance to edge d. A single-edge claim reads
// across frames of different size, where collinearity does not.
.decl same_dist(d: Dir, p1: Position, p2: Position) inline
same_dist(D, P1, P2) :- dist(P1, D, K), dist(P2, D, K).

// p and q on one line of family a — a row, a column, or a diagonal.
.decl same_line(a: Axis4, p: Position, q: Position) inline
same_line(A, P, Q) :- perp(A, A2), axis_of(D, A2), same_dist(D, P, Q).
same_line(DA, P, Q) :-
    diag_perp(DA, DA2), diag_axis_of(Diag, DA2),
    corner_dist(P, Diag, K), corner_dist(Q, Diag, K).

// p strictly nearer d than q. At a DiagDir the compared distances are
// corner_dist. Its clauses introduce the distances, so nearer cannot
// sit under negation.
.decl nearer(d: Dir8, p: Position, q: Position) inline
nearer(D, P, Q) :- dir_elem(D), dist(P, D, K), dist(Q, D, K2), K < K2.
nearer(D, P, Q) :-
    diag_dir_elem(D), corner_dist(P, D, K), corner_dist(Q, D, K2), K < K2.

// Two positions agree on the distances to the two edges of corner d.
.decl corner_anchor(d: DiagDir, p1: Position, p2: Position) inline
corner_anchor(Diag, P1, P2) :-
    diag_dist(P1, Diag, A, K1, K2),
    diag_dist(P2, Diag, A, K1, K2).

// Two positions agree on dist-to-edge d and on the perpendicular extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2),
    axis_of(D, A),
    split(P1, A, _, Ac), split(P2, A, _, Ac).

// The two edge distances agree on each axis. An even extent has no such
// Position.
.decl centered(p: Position) inline
centered([V, V, H, H]) :- true.

// 1D divide along axis a with perpendicular passthrough. p_outer is
// axis-only on a; p_inner is the full 2D within-slab position —
// perpendicular carried from p.
// Asserts: gap-adjusted extent divides evenly by n.
.decl divide_slab(p: Position, a: Axis, n: number, gap: number,
                  p_outer: Position, p_inner: Position) inline
divide_slab(P, A, N, G, P_outer, P_inner) :-
    divide(P, A, N, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

// Like divide_slab, but parameterized by tile size k.
.decl divide_by_size_slab(p: Position, a: Axis, k: number, gap: number,
                          p_outer: Position, p_inner: Position) inline
divide_by_size_slab(P, A, K, G, P_outer, P_inner) :-
    divide_by_size(P, A, K, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

// 2D divide, one tile count and gap on both axes. Outputs are full 2D:
// p_outer indexes an n×n tile arrangement; p_inner is the cell within a tile.
// One scalar over both axes states the square claim; Divide2D makes the
// rectangular one.
.decl divide_2d(p: Position, n: number, gap: number,
                p_outer: Position, p_inner: Position) inline
divide_2d(P, N, G, P_outer, P_inner) :-
    divide(P, AXIS_V, N, G, P_ov, P_iv),
    divide(P, AXIS_H, N, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// Like divide_2d, but parameterized by tile size k.
.decl divide_by_size_2d(p: Position, k: number, gap: number,
                        p_outer: Position, p_inner: Position) inline
divide_by_size_2d(P, K, G, P_outer, P_inner) :-
    divide_by_size(P, AXIS_V, K, G, P_ov, P_iv),
    divide_by_size(P, AXIS_H, K, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

// 1D concat along axis a with perpendicular passthrough — the inverse of
// divide_slab, over the same p_outer and p_inner. p_grid is the recomposed
// full 2D position.
.decl concat_slab(p_outer: Position, p_inner: Position, a: Axis, gap: number,
                  p_grid: Position) inline
concat_slab(P_outer, P_inner, A, G, P_grid) :-
    split(P_inner, A, P_i_axis, Across),
    concat(P_outer, P_i_axis, A, G, P_along),
    compose(P_along, Across, P_grid).

// 2D concat on both axes — the inverse of divide_2d and divide_by_size_2d,
// over the same p_outer and p_inner. p_grid is the recomposed full 2D
// position.
.decl concat_2d(p_outer: Position, p_inner: Position, gap: number,
                p_grid: Position) inline
concat_2d(P_outer, P_inner, G, P_grid) :-
    split(P_outer, AXIS_V, P_outer_v, P_outer_h),
    split(P_inner, AXIS_V, P_inner_v, P_inner_h),
    concat(P_outer_v, P_inner_v, AXIS_V, G, P_grid_v),
    concat(P_outer_h, P_inner_h, AXIS_H, G, P_grid_h),
    compose(P_grid_v, P_grid_h, P_grid).

// ============================================================
// Body components — instantiated at solver-body scope
// ============================================================

// 1D frame defined by an index set and an edge, one frame per key.
//
// Flagged: assumes each key's dist_set is dense — {0, 1, ..., extent-1}. With
// a sparse set, indices above |dist_set|-1 give invalid Positions.
.comp DirFrame<Key> {
    // The edge distances are measured from — the instance's parameter, unkeyed.
    .decl dir(d: Dir)

    // The frame's indices, per key.
    .decl dist_set(key: Key, k: number)

    .decl extent(key: Key, n: number)
    extent(Ky, N) :- dist_set(Ky, _), N = count : { dist_set(Ky, K) }.

    // Position at distance k from edge dir, axis-only (perpendicular zeroed).
    .decl pos(key: Key, k: number, p: Position) inline
    pos(Ky, K, P) :-
        dist_set(Ky, K), dir(D), extent(Ky, N),
        axis_delta(D, K, N-1-K, P).
}

// 1D frame from an axis-tagged extent — the n axis-only positions of a
// 1-wide frame, per key and axis. The undirected peer of DirFrame: no end
// privileged, no index map.
.comp AxisFrame<Key> {
    .decl extent(key: Key, a: Axis, n: number)

    .decl cell(key: Key, a: Axis, p: Position)
    cell(Ky, A, P) :-
        extent(Ky, A, N), axis_of(D, A),
        K = range(0, N),
        axis_delta(D, K, N-1-K, P).
}

// 2D frame from per-axis extents — AxisFrame cells perp-glued into full
// 2D positions, one frame per key. A square frame spreads one extent
// over axis_elem.
.comp Frame2D<Key> {
    .decl extent(key: Key, a: Axis, n: number)

    .init ax = AxisFrame<Key>
    ax.extent(Ky, A, N) :- extent(Ky, A, N).

    .decl cell(key: Key, p: Position)
    cell(Ky, P) :-
        perp(A1, A2), ax.cell(Ky, A1, P1), ax.cell(Ky, A2, P2),
        compose(P1, P2, P).
}

// 2D decomposition from per-axis tile counts — the divide peer of Frame2D:
// per-axis 1D divide, perp-glued. This makes the rectangular claim; the _2d
// composites make the square claim (one scalar, both axes). `cell` and `gap`
// are the instance's parameters.
.comp Divide2D<Key> {
    .decl cell(p: Position)
    .decl dim(key: Key, a: Axis, n: number)
    .decl gap(g: number)

    .decl tile(key: Key, p: Position, p_outer: Position, p_inner: Position)
    tile(Ky, P, P_outer, P_inner) :-
        cell(P), gap(G),
        perp(A1, A2),
        dim(Ky, A1, N1), divide(P, A1, N1, G, Po1, Pi1),
        dim(Ky, A2, N2), divide(P, A2, N2, G, Po2, Pi2),
        compose(Po1, Po2, P_outer), compose(Pi1, Pi2, P_inner).
}

// Like Divide2D, but parameterized by per-axis tile sizes.
.comp Tile2D<Key> {
    .decl cell(p: Position)
    .decl dim(key: Key, a: Axis, k: number)
    .decl gap(g: number)

    .decl tile(key: Key, p: Position, p_outer: Position, p_inner: Position)
    tile(Ky, P, P_outer, P_inner) :-
        cell(P), gap(G),
        perp(A1, A2),
        dim(Ky, A1, K1), divide_by_size(P, A1, K1, G, Po1, Pi1),
        dim(Ky, A2, K2), divide_by_size(P, A2, K2, G, Po2, Pi2),
        compose(Po1, Po2, P_outer), compose(Pi1, Pi2, P_inner).
}

// A corner diagonal, per key — the full corner-to-corner run of cells
// equidistant from the corner's two edges, center included.
// DiagPlacement.diag_cell is this ∩ quadrant — the corner→center ray.
.comp Diagonal<Key> {
    // The position domain, per key.
    .decl cell(key: Key, p: Position)

    // The corner the diagonal runs from, per key.
    .decl corner(key: Key, d: DiagDir)

    // A domain cell on the diagonal, at ring — its shared distance to both
    // edges of the corner.
    .decl diagonal(key: Key, p: Position, ring: number)
    diagonal(Ky, P, K) :- cell(Ky, P), corner(Ky, Diag), diag_dist(P, Diag, _, K, K).
}

// Diagonal placement — the quadrant a cell sits in, and its ring.
.comp DiagPlacement<Key> {
    // The position domain, per key.
    .decl cell(key: Key, p: Position)

    // Strictly nearer edge d than its opposite — which side of the axis midline.
    .decl nearer(key: Key, p: Position, d: Dir)
    nearer(Ky, P, D) :- cell(Ky, P), dir_elem(D), dist_pair(P, D, K, K2), K < K2.

    // The diagonal quadrant a cell sits in: nearer on both of that corner's edges.
    .decl quadrant(key: Key, p: Position, diag: DiagDir)
    quadrant(Ky, P, Diag) :- diag_dirs(Diag, _, D1, D2), nearer(Ky, P, D1), nearer(Ky, P, D2).

    // On the diagonal of its quadrant, at ring K — the shared distance to both
    // edges of that corner.
    .decl diag_cell(key: Key, p: Position, diag: DiagDir, ring: number)
    diag_cell(Ky, P, Diag, K) :- quadrant(Ky, P, Diag), diag_dist(P, Diag, _, K, K).
}

// Keyed marks cast rays toward the key's directions. Reach is inclusive:
// a mark is on its own ray, and a domain that excludes marks (bg-only) gets
// strict semantics with no extra rule. The cast crosses the whole frame; the
// domain decides what is reported, not what the ray passes over. Direction
// columns are Dir8; a cardinal-only caller narrows one with `dir_elem`.
.comp Ray<Key> {
    // The cast directions, per key.
    .decl dir(key: Key, d: Dir8)

    // The position domain tested, per key.
    .decl cell(key: Key, p: Position)

    // The casting positions, per key.
    .decl mark(key: Key, p: Position)

    // Short of the far edge: every edge the cast toward d approaches still
    // lies ahead. A position off the frame across d passes, so a cast that
    // starts outside still walks in.
    .decl onward(p: Position, d: Dir8) inline
    onward(P, D) :- dir_elem(D), dist(P, D, K), K >= 0.
    onward(P, D) :- diag_dir_elem(D), diag_dist(P, D, _, K1, K2), K1 >= 0, K2 >= 0.

    // Frame-wide cast: one cell per step from each mark, marks included.
    .decl cast(key: Key, p: Position, d: Dir8, k: number, src: Position)
    cast(Ky, P, D, 0, P) :- mark(Ky, P), dir(Ky, D).
    cast(Ky, P2, D, K+1, Src) :-
        cast(Ky, P, D, K, Src), step_delta(D, S), compose(P, S, P2), onward(P2, D).

    // p on a key-k ray cast toward d, k cells from the casting mark src.
    // k = 0 at the mark itself, and `ray(Ky, P, D, _, _)` is membership alone.
    .decl ray(key: Key, p: Position, d: Dir8, k: number, src: Position)
    ray(Ky, P, D, K, Src) :- cast(Ky, P, D, K, Src), cell(Ky, P).

    // Cells a cast cannot enter, per key. A blocked mark still casts.
    .decl blocked(key: Key, p: Position)

    // Frame-wide open prefix: the cast short of its first blocked cell.
    .decl clear_cast(key: Key, p: Position, d: Dir8, k: number, src: Position)
    clear_cast(Ky, P, D, 0, P) :- cast(Ky, P, D, 0, P).
    clear_cast(Ky, P, D, K, Src) :- _ahead(Ky, P, D, K, Src), !blocked(Ky, P).

    // The cast cell after the prefix: it extends the prefix or halts the cast.
    .decl _ahead(key: Key, p: Position, d: Dir8, k: number, src: Position)
    _ahead(Ky, P2, D, K, Src) :-
        clear_cast(Ky, P, D, _, Src), neighbor(P, D, P2), cast(Ky, P2, D, K, Src).

    // ray halted before its first blocked cell.
    .decl clear(key: Key, p: Position, d: Dir8, k: number, src: Position)
    clear(Ky, P, D, K, Src) :- clear_cast(Ky, P, D, K, Src), cell(Ky, P).

    // The first blocked cell of each cast, past the mark itself, whether or
    // not it is in the domain.
    .decl stop(key: Key, p: Position, d: Dir8, k: number, src: Position)
    stop(Ky, P, D, K, Src) :- _ahead(Ky, P, D, K, Src), blocked(Ky, P).
}

// The two-sided fold of Ray: between(k, p) holds when key-k marks lie on
// both sides of p in its line, along one of the key's axes. Reach is
// inclusive, as in Ray.
.comp Between<Key> : Ray<Key> {
    // The fold axes, per key.
    .decl axis(key: Key, a: Axis4)

    dir(Ky, D) :- axis(Ky, A), axis4_of(D, A).   // cast both ways

    .decl between(key: Key, p: Position)
    between(K, P) :-
        axis(K, A), axis4_of(D, A), dir8_opposite(D, O),
        ray(K, P, D, _, _), ray(K, P, O, _, _).
}

// The maximal straight run inside a keyed node set. A cast with step
// counts, or from a mark outside the set, is Ray.
.comp Slide<Key> {
    // Where the mover may stand, per key. Positions or Shifts.
    .decl node(key: Key, p: Position)

    // The run directions, per key.
    .decl dir(key: Key, d: Dir8)

    // q is reached from p toward d by steps that stay in the node set.
    .decl run(key: Key, p: Position, d: Dir8, q: Position)
    run(Ky, P, D, Q) :- node(Ky, P), dir(Ky, D), neighbor(P, D, Q), node(Ky, Q).
    run(Ky, P, D, R) :- run(Ky, P, D, Q), neighbor(Q, D, R), node(Ky, R).

    // The mover at p cannot step toward d.
    .decl rim_dir(key: Key, p: Position, d: Dir8)
    rim_dir(Ky, P, D) :- node(Ky, P), dir(Ky, D), neighbor(P, D, Q), !node(Ky, Q).

    // The far end of a run: one more step would leave the node set.
    .decl halt(key: Key, p: Position, d: Dir8, q: Position)
    halt(Ky, P, D, Q) :- run(Ky, P, D, Q), rim_dir(Ky, Q, D).

    // Where the mover from p comes to rest toward d: its halt, or p itself
    // when it cannot step.
    .decl rest(key: Key, p: Position, d: Dir8, q: Position)
    rest(Ky, P, D, Q) :- halt(Ky, P, D, Q).
    rest(Ky, P, D, P) :- rim_dir(Ky, P, D).
}

// Sparse numeric set → dense ordinal position, per key.
// `ord` is a reserved word and cannot be the instance name.
.comp Ordinal<Key> {
    // The numbers to rank, per key. A set: items sharing k share its rank,
    // and the rank set stays dense under ties.
    .decl idx_set(key: Key, k: number)

    // r = the count of the key's elements strictly less than k, so ranks run
    // ascending from 0.
    .decl rank(key: Key, k: number, r: number)
    rank(Ky, K, R) :-
        idx_set(Ky, K),
        R = count : { idx_set(Ky, K2), K2 < K }.

    // The same count, strictly greater. For a descending layout, place ranks
    // from the opposite edge; this is for when the rank value itself flows
    // downstream.
    .decl rank_desc(key: Key, k: number, r: number)
    rank_desc(Ky, K, R) :-
        idx_set(Ky, K),
        R = count : { idx_set(Ky, K2), K2 > K }.
}

// Negative-free difference of two keyed member counts: no tuple at a tie or
// deficit, so no negative number crosses the interface.
.comp Excess<Key, Member> {
    .decl plus(key: Key, m: Member)
    .decl minus(key: Key, m: Member)

    // The amount by which the plus set outnumbers the minus set.
    .decl excess(key: Key, n: number)
    excess(Ky, N) :-
        plus(Ky, _),
        Np = count : { plus(Ky, M1) }, Nn = count : { minus(Ky, M2) },
        Np > Nn, N = Np - Nn.
}

// The commonest member per key. The token column supplies multiplicity;
// ties keep every member at the max.
.comp Mode<Key, Member, Token> {
    .decl item(key: Key, m: Member, t: Token)

    .decl tally(key: Key, m: Member, n: number)
    tally(Ky, M, N) :- item(Ky, M, _), N = count : { item(Ky, M, T) }.

    .decl mode(key: Key, m: Member)
    mode(Ky, M) :- tally(Ky, M, N), N = max N2 : { tally(Ky, _, N2) }.
}

// The one value of each key's item set, absent on disagreement — the strict
// peer of Mode.
.comp Unanimous<Key, Val> {
    .decl item(key: Key, v: Val)

    .decl clash(key: Key)
    clash(Ky) :- item(Ky, V1), item(Ky, V2), V1 != V2.

    .decl value(key: Key, v: Val)
    value(Ky, V) :- item(Ky, V), !clash(Ky).
}

// The extremum score per key, each direction a readout.
.comp Extremes<Key> {
    .decl cand(key: Key, s: number)

    .decl high(key: Key, s: number)
    high(Ky, S) :- cand(Ky, S).
    high(Ky, S) <= high(Ky, S2) :- S < S2.

    .decl low(key: Key, s: number)
    low(Ky, S) :- cand(Ky, S).
    low(Ky, S) <= low(Ky, S2) :- S > S2.
}

// The rows carrying each key's extremum score, each direction a readout;
// ties keep every row at the extremum.
.comp ArgExtremes<Key, Val> {
    .decl cand(key: Key, v: Val, s: number)

    .decl high(key: Key, v: Val, s: number)
    high(Ky, V, S) :- cand(Ky, V, S).
    high(Ky, V, S) <= high(Ky, _, S2) :- S < S2.

    .decl low(key: Key, v: Val, s: number)
    low(Ky, V, S) :- cand(Ky, V, S).
    low(Ky, V, S) <= low(Ky, _, S2) :- S > S2.
}

// The cardinality of each key's member set.
// `count` is a reserved word and cannot be the instance name.
.comp Tally<Key, Member> {
    .decl item(key: Key, m: Member)

    // The keys to count over — feeding it makes the count total, so a key
    // with no items counts 0.
    .decl domain(key: Key)

    .decl tally(key: Key, n: number)
    tally(Ky, N) :- item(Ky, _), N = count : { item(Ky, M) }.
    tally(Ky, 0) :- domain(Ky), !item(Ky, _).
}

// Rank by a caller-supplied strict order: the rank of t counts the
// members before it, ascending from 0.
//
// Flagged: assumes `before` is transitive. It is counted as given and never
// closed, so direct comparisons alone yield predecessor counts, not ranks.
.comp Order<Key, T> {
    .decl elem(key: Key, t: T)
    .decl before(key: Key, a: T, b: T)

    .decl rank(key: Key, t: T, r: number)
    rank(Ky, T, R) :- elem(Ky, T), R = count : { before(Ky, A, T) }.

    // The same count, over the members after t — the order read from its
    // far end.
    .decl rank_desc(key: Key, t: T, r: number)
    rank_desc(Ky, T, R) :- elem(Ky, T), R = count : { before(Ky, T, B) }.

    // The element nothing precedes, and the one nothing follows.
    .decl first(key: Key, t: T)
    first(Ky, T) :- elem(Ky, T), !before(Ky, _, T).

    .decl last(key: Key, t: T)
    last(Ky, T) :- elem(Ky, T), !before(Ky, T, _).

    // Some element lies between a and b.
    .decl _skipped(key: Key, a: T, b: T)
    _skipped(Ky, A, B) :- before(Ky, A, X), before(Ky, X, B).

    // b directly follows a: before, with nothing between. Consumers pair it
    // with `first` to carry state along the chain, one element per step.
    .decl next(key: Key, a: T, b: T)
    next(Ky, A, B) :- before(Ky, A, B), !_skipped(Ky, A, B).
}

// The dense frame a sparse member set induces along an axis, with each
// member's line in it — the order-canonical peer of AxisFrame, which
// realizes a frame from its extent alone. Members are opaque and may span
// several lines; a line fed as its own member is the plain case, and `pos`
// composed with a cell's across component carries the cell into the packed
// frame.
//
// Flagged: assumes each key's member line sets separate cleanly along the
// axis — no shared line, no interleaving. A pair that mixes breaks the
// order and doubles `pos`.
.comp OrderFrame<Key, T> {
    // The axis the frame runs along, per key.
    .decl axis(key: Key, a: Axis)

    // Each member's lines, axis-only on the key's axis.
    .decl member(key: Key, m: T, p: Position)

    // Member m strictly nearer edge d than member m2 — some line of each.
    .decl nearer(key: Key, d: Dir, m: T, m2: T)
    nearer(Ky, D, M, M2) :-
        member(Ky, M, P), member(Ky, M2, Q), M != M2,
        axis(Ky, A), axis_of(D, A),
        dist(P, D, K1), dist(Q, D, K2), K1 < K2.

    .decl mem(key: Key, m: T)
    mem(Ky, M) :- member(Ky, M, _).

    // The member's place in the frame, privileging no end: its distance
    // toward each edge is the count of members nearer that edge.
    .decl pos(key: Key, m: T, p_pos: Position)
    pos(Ky, M, P_pos) :-
        mem(Ky, M), axis(Ky, A), axis_of(D, A), opposite(D, O),
        R1 = count : { nearer(Ky, D, M1, M) },
        R2 = count : { nearer(Ky, O, M2, M) },
        axis_delta(D, R1, R2, P_pos).
}

// The nonuniform tile arrangement a divider set induces — the divider-driven
// peer of Divide2D/Tile2D, which need equal tiles: a cell's tile position
// holds, toward each edge, the count of dividers between the cell and that
// edge. Divider cells get no tile; an axis with no dividers is one part. A
// within-tile position is a Reframe from the tile's box.
.comp DividerFrame<Key> {
    // The position domain, per key.
    .decl cell(key: Key, p: Position)

    // The cutting lines, axis-only on a — detection output or stored data.
    .decl divider(key: Key, a: Axis, l: Position)

    // Divider distances.
    .decl div_dist(key: Key, a: Axis, d: Dir, k: number)
    div_dist(K, A, D, K1) :- divider(K, A, L), axis_of(D, A), dist(L, D, K1).

    // p's line on axis a holds a divider.
    .decl on_divider(key: Key, p: Position, a: Axis)
    on_divider(K, P, A) :- cell(K, P), div_dist(K, A, D, K1), dist(P, D, K1).

    // p's tile index from edge d — the dividers between p and edge d.
    .decl part_idx(key: Key, p: Position, d: Dir, n: number)
    part_idx(K, P, D, N) :-
        cell(K, P), axis_of(D, A), !on_divider(K, P, A), dist(P, D, K1),
        N = count : { div_dist(K, A, D, K2), K2 < K1 }.

    // The part of axis a that p sits in, as an axis-only position: p's
    // tile index from each edge of the axis.
    .decl part_of(key: Key, p: Position, a: Axis, p_part: Position)
    part_of(K, P, A, P_part) :-
        axis_of(D, A), opposite(D, D2),                 // the axis's two dirs
        part_idx(K, P, D, N1), part_idx(K, P, D2, N2),  // index from each
        axis_delta(D, N1, N2, P_part).

    // P's tile, parts on both axes glued.
    .decl tile_of(key: Key, p: Position, p_tile: Position)
    tile_of(K, P, P_tile) :-
        part_of(K, P, A, P1), perp(A, A2), part_of(K, P, A2, P2),  // part on each axis
        compose(P1, P2, P_tile).                                   // glued
}

// One id per class of an equivalence relation; the representative is
// arbitrary but deterministic. A self-paired `rep` member is the class
// representative — with a total equivalence, an arbitrary pick of one
// element of a set.
.comp Canon<T> {
    // An equivalence, reflexive over the domain.
    .decl equiv(a: T, b: T)

    .decl rep(a: T, b: T)
    rep(A, B) :- equiv(A, B).
    rep(A, B) <= rep(A, B2) :- ord(B) > ord(B2).

    .decl id(a: T, id: Ident)
    id(A, as(ord(B), Ident)) :- rep(A, B).
}

// Order's geometric special case: lexicographic order over a keyed cell
// set. Reading order is the top-left, V-primary member.
.comp LexOrder<Key> : Order<Key, Position> {
    // The corner the order runs from, per key.
    .decl corner(key: Key, d: DiagDir)

    // The primary axis, per key.
    .decl axis(key: Key, a: Axis)

    // The cells to order, per key.
    .decl cell(key: Key, p: Position)

    elem(Ky, P) :- cell(Ky, P).

    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Ky, Diag), axis(Ky, A), dir_of(Diag, A, D),  // primary dir
        dist(Q, D, K1), dist(P, D, K2), K1 < K2.            // q strictly nearer
    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Ky, Diag), axis(Ky, A),
        diag_dirs(Diag, A, D, D2),                   // primary/secondary dirs
        same_dist(D, Q, P),                          // primary tie
        dist(Q, D2, K1), dist(P, D2, K2), K1 < K2.   // q strictly nearer
}

// Z/N successor over a dense 0-based index set, per key: increment, with
// the max wrapping to 0. A spatial cycle converts through dist (index off a
// position) and DirFrame.pos (position back). A lockstep closure reads
// succ directly; a count advance feeds it to CycleWalk.
.comp IndexCycle<Key> {
    .decl idx(key: Key, k: number)

    .decl succ(key: Key, k: number, k2: number)
    succ(Ky, K, K+1) :- idx(Ky, K), idx(Ky, K+1).
    succ(Ky, K, 0)   :- idx(Ky, K), !idx(Ky, K+1).   // wrap from the max
}

// A directed cycle (edges, with no basepoint) and rotation along it: walk
// advances a start node by n successor steps.
.comp CycleWalk<Key, T> {
    // The cycle's edges, as explicit data or from a builder like IndexCycle.
    .decl succ(key: Key, p: T, p_next: T)

    // The advance counts in use, as raw solver data; the comp closes them
    // downward into the recursion bound.
    .decl step(key: Key, n: number)

    // Downward closure of step — the walk's recursion bound.
    .decl bound(key: Key, n: number)
    bound(Ky, N) :- step(Ky, M), N = range(0, M+1).

    // p = p0 advanced n steps along succ.
    .decl walk(key: Key, p0: T, n: number, p: T)
    walk(Ky, P0, 0, P0) :- succ(Ky, P0, _).
    walk(Ky, P0, N1, P2) :-
        walk(Ky, P0, N, P1), succ(Ky, P1, P2),
        bound(Ky, N1), N1 = N + 1.      // N1 is the Z/n step count
}

// A partition carried along a walk, one item passing to the taken side per
// step. `step` may be recursive with the outputs, so the state can choose
// the walk. A step that takes several items does not fit.
.comp Take<Key, T, Item> {
    .decl start(key: Key, t: T)               // input
    .decl step(key: Key, t: T, t2: T)         // input

    // The item taken at t.
    .decl take(key: Key, t: T, item: Item)    // input

    // The partition before the first step.
    .decl init_taken(key: Key, item: Item)    // input
    .decl init_untaken(key: Key, item: Item)  // input

    .decl taken(key: Key, t: T, item: Item)
    taken(Ky, T, X) :- start(Ky, T), init_taken(Ky, X).
    taken(Ky, T2, X) :- step(Ky, T, T2), ( taken(Ky, T, X) ; take(Ky, T, X) ).

    .decl untaken(key: Key, t: T, item: Item)
    untaken(Ky, T, X) :- start(Ky, T), init_untaken(Ky, X).
    untaken(Ky, T2, X) :- step(Ky, T, T2), untaken(Ky, T, X), take(Ky, T, Y), X != Y.
}

// Keyed set comparison via count equality. Member is a single type param: a
// record for multi-field members, a scalar for one-field. Stored catalogs
// enumerate patterns as numbers (Pat = number; single-pattern sites use
// pattern = 0); a derived catalog keys patterns by its own objects.
.comp KeyedSetCompare<Key, Pat, Member> {
    // A catalog of known sets, enumerated by `pattern`.
    .decl pattern_member(pattern: Pat, m: Member)

    // The observed set at each `observed` key.
    .decl observed_member(observed: Key, m: Member)

    .decl pattern_size(pattern: Pat, n: number)
    pattern_size(Pat, N) :- pattern_member(Pat, _), N = count : { pattern_member(Pat, M) }.

    // observed ⊇ pattern: every pattern member is present in the observed set
    .decl covers(observed: Key, pattern: Pat)
    covers(Obs, Pat) :-
        observed_member(Obs, _),
        pattern_size(Pat, N),
        N = count : { pattern_member(Pat, M), observed_member(Obs, M) }.

    // observed == pattern: covers, and the observed set carries no extra members
    .decl equals(observed: Key, pattern: Pat)
    equals(Obs, Pat) :-
        covers(Obs, Pat),
        pattern_size(Pat, N),
        N = count : { observed_member(Obs, M) }.
}

// Per-key D4 ops taking one valued cell set onto another, in two readings of
// absence: `mismatch`/`map` read a missing image cell as difference, so `dst`
// must be total over each key's domain; `conflict`/`compatible` compare only
// where both cells exist, so a partial dst keeps its ops. With dst = src the
// maps are the set's symmetries.
.comp D4Map<Key, Val> {
    .decl src(key: Key, p: Position, v: Val)
    .decl dst(key: Key, p: Position, v: Val)

    // A violated op: some src cell whose image under d holds a different dst
    // value.
    .decl mismatch(key: Key, d: D4)
    mismatch(K, D) :- src(K, P, V), d4_elem(D), apply(D, P, P2), !dst(K, P2, V).

    // The ops that hold — the negation of mismatch.
    .decl map(key: Key, d: D4)
    map(K, D) :- src(K, _, _), d4_elem(D), !mismatch(K, D).

    // A contradicted op: some src cell whose image holds a different dst
    // value where both cells exist.
    .decl conflict(key: Key, d: D4)
    conflict(K, D) :- src(K, P, V), d4_elem(D), apply(D, P, P2), dst(K, P2, V2), V2 != V.

    // The ops dst never contradicts — the negation of conflict.
    .decl compatible(key: Key, d: D4)
    compatible(K, D) :- src(K, _, _), d4_elem(D), !conflict(K, D).

    // Invariance under some nontrivial element — the dst = src reading.
    .decl has_sym(key: Key)
    has_sym(K) :- map(K, D), D != D4_ID.
}

// Per-key shift invariance of a valued cell set — the translation peer of
// D4Map (dst = src): which axis-aligned shifts fix each keyed cell set.
// Absence is silent, as in D4Map's `compatible` reading: an image off the
// frame tests nothing, so a shift is compared only where both cells exist.
// Two readings: `mismatch` is exact — a stored period is the smallest
// unbroken shift; `period` reads through sparse damage in ordinary colors.
.comp ShiftInvariance<Key, Val> {
    .decl cell(key: Key, p: Position, v: Val)

    // Internal keys tag a candidate shift; members are its line pairs.
    .type _SK = [key: Key, a: Axis, k: number]
    .type _LP = [l: Position, l2: Position]

    // Candidate shifts: every axis-aligned delta the frame admits, tagged
    // (axis, k), with both directions of a magnitude sharing a tag.
    .decl cand(key: Key, a: Axis, k: number, delta: Shift)
    cand(Ky, A, K, Delta) :-
        cell(Ky, P, _),
        axis_of(D, A), sub_extent(P, A, K),
        jump_delta(D, K, Delta).

    // One delta per magnitude: the other direction pairs the same cells
    // transposed, so the readouts rebuild symmetric rows by transpose. The
    // corner picked is unobservable.
    .decl _cand(key: Key, a: Axis, k: number, delta: Shift)
    _cand(Ky, A, K, Delta) :-
        cell(Ky, P, _),
        dir_of(DIAG_BR, A, D), sub_extent(P, A, K),
        jump_delta(D, K, Delta).

    .decl _pair(key: Key, a: Axis, k: number, p: Position, q: Position)
    _pair(Ky, A, K, P, Q) :-
        cell(Ky, P, _), _cand(Ky, A, K, Delta), compose(P, Delta, Q), cell(Ky, Q, _).

    // A candidate's cell pairings: q is p's image, both in the set.
    .decl pair(key: Key, a: Axis, k: number, p: Position, q: Position)
    pair(Ky, A, K, P, Q) :- _pair(Ky, A, K, P, Q).
    pair(Ky, A, K, Q, P) :- _pair(Ky, A, K, P, Q).

    // A violated shift: some cell whose image holds a different value.
    .decl mismatch(key: Key, a: Axis, k: number)
    mismatch(Ky, A, K) :-
        _pair(Ky, A, K, P, Q), cell(Ky, P, V), cell(Ky, Q, V2), V != V2.

    .decl _line_mismatch(key: Key, a: Axis, k: number, l: Position, l2: Position)
    _line_mismatch(Ky, A, K, L, L2) :-
        _pair(Ky, A, K, P, Q), cell(Ky, P, V), cell(Ky, Q, V2), V != V2,
        split(P, A, L, _), split(Q, A, L2, _).

    // A broken line pair: the shift carries some cell of the line at l
    // onto a differently-valued cell of the line at l2.
    .decl line_mismatch(key: Key, a: Axis, k: number, l: Position, l2: Position)
    line_mismatch(Ky, A, K, L, L2) :- _line_mismatch(Ky, A, K, L, L2).
    line_mismatch(Ky, A, K, L2, L) :- _line_mismatch(Ky, A, K, L, L2).

    // Broken line pairs against whole ones.
    .init _breaks = Excess<_SK, _LP>
    _breaks.plus([Ky, A, K], [L, L2]) :- _line_mismatch(Ky, A, K, L, L2).
    _breaks.minus([Ky, A, K], [L, L2]) :-
        _pair(Ky, A, K, P, Q), split(P, A, L, _), split(Q, A, L2, _),
        !_line_mismatch(Ky, A, K, L, L2).

    // A period of the set's pattern, read through damage: broken line
    // pairs do not outnumber whole ones. Every multiple of a period is a
    // period, and a pair-less candidate is vacuously one.
    .decl period(key: Key, a: Axis, k: number)
    period(Ky, A, K) :- cand(Ky, A, K, _), !_breaks.excess([Ky, A, K], _).

    // The exact reading's minimum: the shortest witnessed shift no cell
    // pair contradicts, per key and axis.
    .decl min_period(key: Key, a: Axis, k: number)
    min_period(Ky, A, K) :- _pair(Ky, A, K, _, _), !mismatch(Ky, A, K).
    min_period(Ky, A, K) <= min_period(Ky, A, K2) :- K > K2.
}

// Re-express keyed cells relative to a per-key outer origin: inner is the
// cell's displacement from outer. Outer extent + inner extent = cell extent,
// so one subtraction both resizes and positions across frames.
//
// Flagged: assumes one origin per key — several origins under one key
// cross-product, so key by the varied thing instead.
.comp Reframe<Key> {
    .decl outer(key: Key, p: Position)
    .decl cell(key: Key, p: Position)

    // Each cell beside its inner position: the read from an inner position
    // back to its cell.
    .decl view(key: Key, p: Position, p_inner: Position)
    view(K, P, I) :- cell(K, P), outer(K, O), displacement(O, P, I).

    .decl inner(key: Key, p: Position)
    inner(K, I) :- view(K, _, I).
}

// A Position packed from per-Dir scalars, keyed: the inverse read of dist.
.comp DirPack<Key> {
    .decl edge(key: Key, d: Dir, k: number)  // input

    .decl axis_pos(key: Key, a: Axis, p: Position)
    axis_pos(Ky, A, P) :-
        axis_of(D, A), opposite(D, O),
        edge(Ky, D, K1), edge(Ky, O, K2),
        axis_delta(D, K1, K2, P).

    .decl pos(key: Key, p: Position)
    pos(Ky, P) :-
        perp(A1, A2), axis_pos(Ky, A1, P1), axis_pos(Ky, A2, P2),
        compose(P1, P2, P).
}

// The frame inside given margins, one per key: each cell at least the
// margin from every edge pairs with its position in the enclosed frame.
.comp MarginFrame<Key> {
    .decl cell(key: Key, p: Position)         // input
    .decl width(key: Key, d: Dir, k: number)  // input

    // An edge with no width has margin zero.
    .decl edge(key: Key, d: Dir, k: number)
    edge(Ky, D, K) :- width(Ky, D, K).
    edge(Ky, D, 0) :- cell(Ky, _), dir_elem(D), !width(Ky, D, _).

    .init pack = DirPack<Key>
    pack.edge(Ky, D, K) :- edge(Ky, D, K).

    .decl margin(key: Key, p: Inset)
    margin(Ky, P) :- pack.pos(Ky, P).

    .init rf = Reframe<Key>
    rf.outer(Ky, M) :- margin(Ky, M).
    rf.cell(Ky, P) :- cell(Ky, P).

    .decl inner(key: Key, p: Position, p_inner: Position)
    inner(Ky, P, P_inner) :-
        margin(Ky, M), geq(P, M),  // clear of the margins
        rf.view(Ky, P, P_inner).
}

// Keyed cells viewed from their own bounding box. `cell` defines the box
// and is viewed; feeding `grid` also views the box's inside, which is what
// a crop reads. `inner` carries the cell alongside the inner position, so
// one key serves the whole set.
.comp BoxFrame<Key> : Bbox<Key> {
    .init mf = MarginFrame<Key>
    mf.width(K, D, M) :- edge_min(K, D, M).
    mf.cell(K, P) :- viewed(K, P).

    // Cells the frame covers — the box's own cells plus the grid cells it
    // encloses. Unfed, `grid` leaves the box's own cells, so a test over
    // `inner` narrows rather than emptying.
    .decl viewed(key: Key, p: Position)
    viewed(K, P) :- cell(K, P).
    viewed(K, P) :- inside(K, P).

    .decl inner(key: Key, p: Position, p_inner: Position)
    inner(K, P, I) :- mf.inner(K, P, I).

    // The box's size, wide: n1 along axis a, n2 across. Every cell of the
    // box shares its frame, so any inner position serves.
    .decl extents(key: Key, a: Axis, n1: number, n2: number)
    extents(K, A, N1, N2) :- inner(K, _, I), axis_dims(I, A, N1, N2).
}

// Bounding box of a keyed cell set, from the min distance to each edge over
// the set. `margin` packs the mins into a Position — the box's placement, and
// a Reframe outer.
.comp Bbox<Key> {
    // The set the box bounds, per key.
    .decl cell(key: Key, p: Position)

    // The grid the box sits in, per key.
    .decl grid(key: Key, p: Position)

    .decl cell_dist(key: Key, d: Dir, k: number)
    cell_dist(K, D, Kd) :- cell(K, P), dir_elem(D), dist(P, D, Kd).

    .decl edge_min(key: Key, d: Dir, m: number)
    edge_min(K, D, M) :- cell_dist(K, D, _), M = min Kd : { cell_dist(K, D, Kd) }.

    .init pack = DirPack<Key>
    pack.edge(K, D, M) :- edge_min(K, D, M).

    // The box as a Position — margin from each edge.
    .decl margin(key: Key, p: Position)
    margin(K, P) :- pack.pos(K, P).

    // Grid cells inside the box — at least the margin from every edge.
    .decl inside(key: Key, p: Position)
    inside(K, P) :- grid(K, P), margin(K, M), geq(P, M).

    // Set cell on the box's d-side boundary.
    .decl edge_cell(key: Key, p: Position, d: Dir)
    edge_cell(K, P, D) :- cell(K, P), dist(P, D, Kd), edge_min(K, D, Kd).

    // Set cell at box corner diag — on both of the corner's edges. A tuple
    // exists only where the set occupies that corner; an L-shape yields three.
    .decl corner(key: Key, p: Position, diag: DiagDir)
    corner(K, P, Diag) :-
        diag_dirs(Diag, _, D1, D2), edge_cell(K, P, D1), edge_cell(K, P, D2).
}

// Connected components of a node set (4-adjacency), per key, each labeled by
// an opaque id from the lowest-ord member cell: ord is arbitrary but stable
// within a run, so the pick carries no geometry. The key does not enter the
// id, so ids separate components under different keys only where their node
// sets are disjoint.
.comp Components<Key> {
    .decl node(key: Key, p: Position)

    .decl step(delta: Position)
    step([-1, 1, 0, 0]). step([1, -1, 0, 0]). step([0, 0, -1, 1]). step([0, 0, 1, -1]).

    // Min-label propagation: every node proposes its own id, and
    // subsumption keeps each component's minimum.
    .decl label(key: Key, p: Position, id: Ident)
    label(Ky, P, as(ord(P), Ident)) :- node(Ky, P).
    label(Ky, Q, Id) :- label(Ky, P, Id), step(D), compose(P, D, Q), node(Ky, Q).
    label(Ky, P, Id) <= label(Ky, P, Id2) :- Id2 < Id.

    .decl conn(key: Key, p: Position, q: Position)
    conn(Ky, P, Q) :- label(Ky, P, Id), label(Ky, Q, Id).
}

// Connected components under 8-adjacency — Components over the full
// Dir8 step set.
.comp Components8<Key> : Components<Key> {
    step(S) :- dir8_elem(D), step_delta(D, S).
}

// Seeded connectivity: reach is the union of the components the seeds
// select. A seed outside the node set selects nothing. reach floods
// directly from the seeds, so reach-only consumers never pay for conn.
.comp Reach<Key> : Components<Key> {
    .decl seed(key: Key, p: Position)

    .decl reach(key: Key, p: Position)
    reach(Ky, P) :- seed(Ky, P), node(Ky, P).
    reach(Ky, Q) :- reach(Ky, P), step(D), compose(P, D, Q), node(Ky, Q).
}

// Boundary and erosion depth of a keyed cell set. The rim is the cells with
// a neighbor outside the set, off-frame counting as outside; depth runs
// inward from the rim, one per step. Neighbors are the four cardinals.
.comp Rim<Key> {
    .decl cell(key: Key, p: Position)  // input

    .decl dir(d: Dir8)
    dir(D) :- dir_elem(D).

    // The outside lies one step toward d.
    .decl rim_dir(key: Key, p: Position, d: Dir8)
    rim_dir(Ky, P, D) :- cell(Ky, P), dir(D), neighbor(P, D, Q), !cell(Ky, Q).

    .decl rim(key: Key, p: Position)
    rim(Ky, P) :- rim_dir(Ky, P, _).

    // The shortest inward walk from the rim.
    .decl depth(key: Key, p: Position, k: number)
    depth(Ky, P, 0) :- rim(Ky, P).
    depth(Ky, P, K2) :-
        depth(Ky, Q, K), K2 = K + 1,
        dir(D), neighbor(Q, D, P), cell(Ky, P).
    depth(Ky, P, K) <= depth(Ky, P, K2) :- K2 < K.
}

// Rim under 8-adjacency.
.comp Rim8<Key> : Rim<Key> {
    dir(D) :- dir8_elem(D).
}

// The regions a keyed cell set closes off from the grid edge — the
// entity-level half of the enclose prior. Reach stays the unit for
// cell-level enclosure and seeded selection.
.comp Closed<Key> {
    .decl cell(key: Key, p: Position)  // input

    // The edge-connected part of the set.
    .init flood = Reach<Key>
    flood.node(Ky, P) :- cell(Ky, P).
    flood.seed(Ky, P) :- cell(Ky, P), dir_elem(D), dist(P, D, 0).

    // Individuate only the closed cells.
    .init regions = Components<Key>
    regions.node(Ky, P) :- cell(Ky, P), !flood.reach(Ky, P).

    .decl region(key: Key, p: Position, id: Ident)
    region(Ky, P, Id) :- regions.label(Ky, P, Id).
}

// Occurrences of a shape among cells, per key: cells and shape members are
// valued, and a placement occurs where every shape member lands on a cell
// carrying that member's value — the ARC "find this shape" operation.
// Positional matching is the unit-valued instantiation. Placements derive
// backward from the data, so no grid bounds are needed and off-grid
// candidates filter themselves out.
// `match` is a reserved word and cannot be the instance name.
.comp Occurrences<Key, Val> {
    .decl cell(key: Key, p: Position, v: Val)
    .decl shape(key: Key, p: Position, v: Val)

    // Internal keys pair the solver key with an anchor Position.
    .type KP = [key: Key, p: Position]

    // Candidate placements — align each shape cell (one origin per pair) to
    // every cell of the same value, union over the shape cells. A true
    // occurrence aligns every member to a same-valued cell, so the
    // restriction loses no placement.
    .init align = Reframe<KP>
    align.cell([Ky, S], P)  :- shape(Ky, S, V), cell(Ky, P, V).
    align.outer([Ky, S], S) :- shape(Ky, S, _).
    .decl placement(key: Key, p: Position)
    placement(Ky, M) :- align.inner([Ky, _], M).

    // A contradicted placement: some member lands on a cell of another
    // value, or off the grid, where no cell carries its value.
    .decl mismatch(key: Key, p: Position)
    mismatch(Ky, M) :-
        placement(Ky, M),                   // a candidate placement
        shape(Ky, S, V), compose(M, S, P),  // where a member lands
        !cell(Ky, P, V).                    // off that member's value

    // The placements no member contradicts.
    .decl occurrence(key: Key, p: Position)
    occurrence(Ky, M) :- placement(Ky, M), !mismatch(Ky, M).
}

// The pieces every exact cover of a keyed cell set must contain, by
// elimination. Pieces are opaque and placements come from the caller. On a
// uniquely packing input the fixpoint is the whole packing; an ambiguous or
// too-hard input leaves `forced` partial and the output fails on totality,
// never wrongly. Forced pieces not ruled out are pairwise disjoint, so
// covering every cell witnesses a partition. With a single footprint it
// forces exactly the greedy reading-order peel.
.comp CoverForcing<Key, Piece> {
    // The candidate pieces and the cells each covers.
    .decl covers(key: Key, piece: Piece, p: Position)  // input

    // Two pieces no cover holds together, beyond overlap.
    .decl conflict(key: Key, piece: Piece, piece2: Piece)  // input

    // Elimination: a cell whose rivals are all ruled out but one forces its
    // last piece, and a piece overlapping or conflicting with a forced piece
    // is ruled out.
    // "Every other rival is ruled out" is a universal inside the recursion —
    // forced and ruled_out are mutually recursive, so no negation across
    // them stratifies. The rivals of a cell close into a cycle in an
    // arbitrary stable ord order, and the universal becomes a positive walk
    // around the cycle.

    // The pieces covering a cell.
    .decl _rival(key: Key, p: Position, piece: Piece)
    _rival(Ky, P, B) :- covers(Ky, B, P).

    // The ord of each rival's successor, materialized so the aggregate runs
    // once per rival rather than once per rival pair.
    .decl _min_after(key: Key, p: Position, piece: Piece, m: number)
    _min_after(Ky, P, B, M) :-
        _rival(Ky, P, B),
        M = min ord(B3) : { _rival(Ky, P, B3), ord(B3) > ord(B) }.

    // Next in ord order.
    .decl _next(key: Key, p: Position, piece: Piece, piece2: Piece)
    _next(Ky, P, B, B2) :-
        _min_after(Ky, P, B, M), _rival(Ky, P, B2), ord(B2) = M.

    // The cycle it closes.
    .decl _succ(key: Key, p: Position, piece: Piece, piece2: Piece)
    _succ(Ky, P, B, B2) :- _next(Ky, P, B, B2).
    _succ(Ky, P, B, B2) :-
        _rival(Ky, P, B), !_next(Ky, P, B, _),    // the last rival
        _rival(Ky, P, B2), !_next(Ky, P, _, B2),  // links back to the first
        B != B2.

    // Every rival from X around to the one before B, all ruled out.
    .decl _run_out(key: Key, p: Position, piece: Piece, piece2: Piece)
    _run_out(Ky, P, B, X) :- ruled_out(Ky, X), _succ(Ky, P, X, B).
    _run_out(Ky, P, B, X) :- ruled_out(Ky, X), _succ(Ky, P, X, X2), _run_out(Ky, P, B, X2).

    // Some cell has no other rival left.
    .decl forced(key: Key, piece: Piece)
    forced(Ky, B) :- _rival(Ky, P, B), !_succ(Ky, P, B, _).
    forced(Ky, B) :- _rival(Ky, P, B), _succ(Ky, P, B, X), _run_out(Ky, P, B, X).

    // Overlaps or conflicts with a forced piece.
    .decl ruled_out(key: Key, piece: Piece)
    ruled_out(Ky, B) :- forced(Ky, B2), covers(Ky, B2, P), covers(Ky, B, P), B != B2.
    ruled_out(Ky, B) :- forced(Ky, B2), conflict(Ky, B2, B).
}

// The candidates a joint placement of the pieces may still hold, by
// refutation — the dual of CoverForcing's elimination, for sites where
// elimination cannot start. A candidate dies when some other piece has no
// candidate that can stand beside it, or some pair of other pieces has no
// conflict-free pair beside it; a kill can expose the next, and dead is the
// fixpoint. alive over-approximates: every joint placement's candidates
// survive, and a caller painting from the survivors fails on cells where
// leftover rivals disagree — never wrongly. A piece takes at most one
// candidate: every test picks one per piece.
.comp PlacementPruning<Key, Cand, Piece> {
    // The candidate placements of each piece.
    .decl cand(key: Key, c: Cand, o: Piece)  // input

    // Two candidates no joint placement holds together.
    .decl conflict(key: Key, c: Cand, c2: Cand)  // input

    .decl _piece(key: Key, o: Piece)
    _piece(K, O) :- cand(K, _, O).

    // Each kill rule's universal ("every candidate of the piece is blocked")
    // would negate alive inside the recursion, so it walks the piece's
    // candidates in an arbitrary stable ord order — the pair rule as an
    // inner walk nested in an outer one.

    // The ord of each candidate's successor, materialized so the aggregate
    // runs once per candidate rather than once per candidate pair.
    .decl _min_after(key: Key, o: Piece, c: Cand, m: number)
    _min_after(K, O, C1, M) :-
        cand(K, C1, O),
        M = min ord(C3) : { cand(K, C3, O), ord(C3) > ord(C1) }.

    // Each piece's candidates, chained in ord order.
    .decl _after(key: Key, o: Piece, c: Cand, c2: Cand)
    _after(K, O, C1, C2) :-
        _min_after(K, O, C1, M), cand(K, C2, O), ord(C2) = M.

    .decl _head(key: Key, o: Piece, c: Cand)
    _head(K, O, C) :- cand(K, C, O), !_after(K, O, _, C).

    .decl _tail(key: Key, o: Piece, c: Cand)
    _tail(K, O, C) :- cand(K, C, O), !_after(K, O, C, _).

    // Piece o2 blocked beside c: every candidate of o2 so far conflicts
    // with c or is dead.
    .decl _blocked(key: Key, c: Cand, o2: Piece, c2: Cand)
    _blocked(K, Cd, O2, C2) :-
        cand(K, Cd, O), _piece(K, O2), O2 != O, _head(K, O2, C2),
        ( conflict(K, Cd, C2) ; dead(K, C2) ).
    _blocked(K, Cd, O2, C2) :-
        _blocked(K, Cd, O2, C1), _after(K, O2, C1, C2),
        ( conflict(K, Cd, C2) ; dead(K, C2) ).

    // The inner walk: c2 of o2 placed beside c, and every candidate of o3
    // so far cannot join them — it conflicts with c or c2, or is dead.
    .decl _pair_blocked(key: Key, c: Cand, c2: Cand, o3: Piece, c3: Cand)
    _pair_blocked(K, Cd, C2, O3, C3) :-
        cand(K, Cd, O), cand(K, C2, O2), O2 != O, !conflict(K, Cd, C2),
        _piece(K, O3), O3 != O, ord(O2) < ord(O3),
        _head(K, O3, C3),
        ( conflict(K, Cd, C3) ; conflict(K, C2, C3) ; dead(K, C3) ).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _pair_blocked(K, Cd, C2, O3, C1), _after(K, O3, C1, C3),
        ( conflict(K, Cd, C3) ; conflict(K, C2, C3) ; dead(K, C3) ).

    // c2 settled for the (piece of c2, o3) pair test beside c: bad in
    // itself, or its inner walk completes.
    .decl _settled(key: Key, c: Cand, o3: Piece, c2: Cand)
    _settled(K, Cd, O3, C2) :-
        cand(K, Cd, O), cand(K, C2, O2), O2 != O,
        _piece(K, O3), O3 != O, ord(O2) < ord(O3),
        ( conflict(K, Cd, C2) ; dead(K, C2) ).
    _settled(K, Cd, O3, C2) :- _pair_blocked(K, Cd, C2, O3, C3), _tail(K, O3, C3).

    // The outer walk: every candidate of c2's piece so far is settled.
    .decl _pair_walk(key: Key, c: Cand, o3: Piece, c2: Cand)
    _pair_walk(K, Cd, O3, C2) :- _head(K, _, C2), _settled(K, Cd, O3, C2).
    _pair_walk(K, Cd, O3, C2) :-
        _pair_walk(K, Cd, O3, C1), _after(K, _, C1, C2), _settled(K, Cd, O3, C2).

    .decl dead(key: Key, c: Cand)
    dead(K, Cd) :- _blocked(K, Cd, O2, C2), _tail(K, O2, C2).
    dead(K, Cd) :- _pair_walk(K, Cd, O3, C2), _tail(K, _, C2).

    .decl alive(key: Key, c: Cand, o: Piece)
    alive(K, Cd, O) :- cand(K, Cd, O), !dead(K, Cd).
}

// The resolutions of a tiebreak: every injective assignment of candidate
// items to slots, one term per assignment, backing a TiebreakResolution out
// column (style: alt outputs). Branch names are program-global, so the
// solver declares the ADT the comp constructs:
//
//   .type TiebreakResolution =
//       End {} | Sit {slot: Slot, item: Item, rest: TiebreakResolution}
.comp TiebreakResolutions<Key, Slot, Item> {
    // The candidate items of each slot.
    .decl cand(key: Key, slot: Slot, item: Item)  // input

    .decl _slot(key: Key, slot: Slot)
    _slot(K, S) :- cand(K, S, _).

    // Slots in an arbitrary fixed order.
    .decl _rank(key: Key, slot: Slot, r: number)
    _rank(K, S, R) :- _slot(K, S), R = count : { _slot(K, S2), ord(S2) < ord(S) }.

    .decl _nslots(key: Key, n: number)
    _nslots(K, N) :- _slot(K, _), N = count : { _slot(K, _) }.

    // One candidate per slot, in rank order.
    .decl _partial(key: Key, r: number, l: TiebreakResolution)
    _partial(K, 0, $End()) :- _slot(K, _).
    _partial(K, R2, $Sit(S, I, L)) :-
        _partial(K, R, L), _rank(K, S, R), cand(K, S, I), R2 = R + 1.

    .decl _combo(key: Key, l: TiebreakResolution)
    _combo(K, L) :- _partial(K, N, L), _nslots(K, N).

    // Suffixes of the combos.
    .decl _sub(key: Key, l: TiebreakResolution)
    _sub(K, L) :- _combo(K, L).
    _sub(K, L) :- _sub(K, $Sit(_, _, L)).

    .decl _mem(key: Key, l: TiebreakResolution, item: Item)
    _mem(K, $Sit(S, I, L), I) :- _sub(K, $Sit(S, I, L)).
    _mem(K, $Sit(S, I, L), I2) :- _sub(K, $Sit(S, I, L)), _mem(K, L, I2).

    .decl _dup(key: Key, l: TiebreakResolution)
    _dup(K, $Sit(S, I, L)) :- _sub(K, $Sit(S, I, L)), _mem(K, L, I).
    _dup(K, $Sit(S, I, L)) :- _sub(K, $Sit(S, I, L)), _dup(K, L).

    // The valid assignments: no item used twice.
    .decl resolution(key: Key, res: TiebreakResolution)
    resolution(K, L) :- _combo(K, L), !_dup(K, L).

    .decl _within(key: Key, res: TiebreakResolution, l: TiebreakResolution)
    _within(K, L, L) :- resolution(K, L).
    _within(K, L0, L) :- _within(K, L0, $Sit(_, _, L)).

    .decl assign(key: Key, res: TiebreakResolution, slot: Slot, item: Item)
    assign(K, L0, S, I) :- _within(K, L0, $Sit(S, I, _)).
}

// ============================================================
// Consts helpers — instantiated inside Consts; not reachable from body
// ============================================================

.comp ConstsHelpers {
    // All positions of a frame of given Dim.
    .decl frame_pos(dim: Dim, p: Position) inline
    frame_pos([V, H], [T, V-1-T, L, H-1-L]) :- T = range(0, V), L = range(0, H).

    // Decompose a position in an outer×inner tiled frame into outer (which
    // tile) and inner (cell within the tile). Gap rows/cols between tiles
    // produce no entry. Combined-frame dim is
    //   (outer.v*inner.v + (outer.v-1)*gap.v,
    //    outer.h*inner.h + (outer.h-1)*gap.h).
    .decl tile_pos(outer: Dim, inner: Dim, gap: Dim,
                   p: Position, p_outer: Position, p_inner: Position) inline
    tile_pos([Ov, Oh], [Iv, Ih], [Gv, Gh],
             [T, B, L, R],
             [Mt, Ov-1-Mt, Ml, Oh-1-Ml],
             [It, Iv-1-It, Il, Ih-1-Il]) :-
        Mt = range(0, Ov), Ml = range(0, Oh),
        It = range(0, Iv), Il = range(0, Ih),
        T = Mt*(Iv+Gv) + It,
        L = Ml*(Ih+Gh) + Il,
        B = Ov*Iv + (Ov-1)*Gv - 1 - T,
        R = Oh*Ih + (Oh-1)*Gh - 1 - L.
}
