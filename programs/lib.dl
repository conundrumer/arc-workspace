// Shared types and primitives for ARC solvers in Souffle.
//
// Position: 4 distances from edges, ordered V-first then H — (top, bottom,
// left, right). Dir constants index into Position. Redundant with grid bounds;
// no corner privileged.
//
// Dim: (V-length, H-length) of a frame. Indexed by Axis.
//
// Color, Dir, Axis, DiagDir are subtypes of number — typed names with no
// arithmetic intent. Constants are #define'd; solver bodies pull values
// from a per-task Consts component rather than referencing constants directly.

.type Color <: number
.type Dir <: number
.type Axis <: number
.type D4 <: number

.type Position = [t: number, b: number, l: number, r: number]
.type Dim = [v: number, h: number]
.type DiagDir = [v_dir: Dir, h_dir: Dir]

#define TOP 0
#define BOTTOM 1
#define LEFT 2
#define RIGHT 3

#define VERTICAL 0
#define HORIZONTAL 1

#define TOP_LEFT     [TOP,    LEFT]
#define TOP_RIGHT    [TOP,    RIGHT]
#define BOTTOM_LEFT  [BOTTOM, LEFT]
#define BOTTOM_RIGHT [BOTTOM, RIGHT]

// D4 elements as gather permutations of (t, b, l, r). Naming: what swaps,
// not the axis of reflection. Values follow lib.py.
#define IDENTITY      0
#define FLIP_LR       1
#define FLIP_TB       2
#define ROT_180       3
#define ROT_CW        4
#define ROT_CCW       5
#define FLIP_DIAG     6
#define FLIP_ANTIDIAG 7

// Origin: position with 0 distance to every edge.
#define ORIGIN [0, 0, 0, 0]

// ============================================================
// Solver body primitives
// ============================================================

// Axis of a Dir.
.decl axis_of(d: Dir, a: Axis)
axis_of(TOP,    VERTICAL).
axis_of(BOTTOM, VERTICAL).
axis_of(LEFT,   HORIZONTAL).
axis_of(RIGHT,  HORIZONTAL).

// Opposite Dir on the same axis.
.decl opposite(d: Dir, opp: Dir)
opposite(TOP,    BOTTOM).
opposite(BOTTOM, TOP).
opposite(LEFT,   RIGHT).
opposite(RIGHT,  LEFT).

// Distance from p to edge d.
.decl dist(p: Position, d: Dir, k: number) inline
dist(P, TOP,    T) :- P = [T, _, _, _].
dist(P, BOTTOM, B) :- P = [_, B, _, _].
dist(P, LEFT,   L) :- P = [_, _, L, _].
dist(P, RIGHT,  R) :- P = [_, _, _, R].

// Element-wise sum of two Positions (signed; one operand may be a delta).
.decl compose(p1: Position, p2: Position, p3: Position) inline
compose([T1, B1, L1, R1], [T2, B2, L2, R2], [T1+T2, B1+B2, L1+L2, R1+R2]) :- true.

// Edge delta: a Position carrying k at edge d, zero elsewhere.
.decl edge_delta(d: Dir, k: number, p: Position) inline
edge_delta(TOP,    K, [K, 0, 0, 0]) :- true.
edge_delta(BOTTOM, K, [0, K, 0, 0]) :- true.
edge_delta(LEFT,   K, [0, 0, K, 0]) :- true.
edge_delta(RIGHT,  K, [0, 0, 0, K]) :- true.

// Decomposition of a Position by axis: along (the axis component, with
// perpendicular zeroed) + across (perpendicular component, axis zeroed).
.decl split(p: Position, a: Axis, along: Position, across: Position) inline
split(P, VERTICAL,   [T, B, 0, 0], [0, 0, L, R]) :- P = [T, B, L, R].
split(P, HORIZONTAL, [0, 0, L, R], [T, B, 0, 0]) :- P = [T, B, L, R].

// Apply a D4 transform to a Position — a pure index permutation.
.decl apply(d: D4, p: Position, p_out: Position) inline
apply(IDENTITY,      [T, B, L, R], [T, B, L, R]) :- true.
apply(FLIP_LR,       [T, B, L, R], [T, B, R, L]) :- true.
apply(FLIP_TB,       [T, B, L, R], [B, T, L, R]) :- true.
apply(ROT_180,       [T, B, L, R], [B, T, R, L]) :- true.
apply(ROT_CW,        [T, B, L, R], [L, R, B, T]) :- true.
apply(ROT_CCW,       [T, B, L, R], [R, L, T, B]) :- true.
apply(FLIP_DIAG,     [T, B, L, R], [L, R, T, B]) :- true.
apply(FLIP_ANTIDIAG, [T, B, L, R], [R, L, B, T]) :- true.

// Divide p's axis-a extent into n equal parts. Both outputs are axis-only
// (perpendicular zeroed): p_outer is the subgrid index in an n-strip frame
// on axis a; p_inner is the cell within the subgrid on axis a. Cells in
// gap rows/cols (when gap > 0) get no decomposition — rule does not fire.
// Symmetric outputs compose cleanly: two divides on different axes can be
// joined via compose for 2D decomposition.
// Asserts: gap-adjusted extent divides evenly by n; cell is not in a gap.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, VERTICAL, N, G,
       [Ot, N-1-Ot, 0, 0],
       [It, Sh-1-It, 0, 0]) :-
    P = [T, B, _, _],
    H = T + B + 1,
    (H - (N-1)*G) % N = 0,
    Sh = (H - (N-1)*G) / N,
    K_cyc = T % (Sh + G),
    K_cyc < Sh,
    Ot = T / (Sh + G),
    It = K_cyc.
divide(P, HORIZONTAL, N, G,
       [0, 0, Ol, N-1-Ol],
       [0, 0, Il, Sh-1-Il]) :-
    P = [_, _, L, R],
    W = L + R + 1,
    (W - (N-1)*G) % N = 0,
    Sh = (W - (N-1)*G) / N,
    K_cyc = L % (Sh + G),
    K_cyc < Sh,
    Ol = L / (Sh + G),
    Il = K_cyc.

// ------------------------------------------------------------
// Patterns — recurring solver-body shapes built from primitives
// ------------------------------------------------------------

// Same dist-to-edge D for two positions. Building block for anchor patterns.
.decl same_dist(d: Dir, p1: Position, p2: Position) inline
same_dist(D, P1, P2) :- dist(P1, D, K), dist(P2, D, K).

// Corner-anchor match: two positions agree on the distances to the two
// edges of corner d. Used to project cells between frames sharing a corner.
.decl corner_anchor(d: DiagDir, p1: Position, p2: Position) inline
corner_anchor([V_dir, H_dir], P1, P2) :-
    same_dist(V_dir, P1, P2),
    same_dist(H_dir, P1, P2).

// Slab-anchor match: two positions agree on dist-to-edge d (anchor) and on
// the perpendicular extent (across-slice match). Used to project cells
// between frames sharing one edge and the perpendicular axis's full extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2),
    axis_of(D, A),
    split(P1, A, _, Ac), split(P2, A, _, Ac).

// ============================================================
// Consts helpers — for declaring CONSTS data, not for solver bodies
// ============================================================

// All positions of a frame of given Dim. Use at call sites where dim is
// bound; range enumerates the cells.
.decl frame_pos(dim: Dim, p: Position) inline
frame_pos([V, H], [T, V-1-T, L, H-1-L]) :- T = range(0, V), L = range(0, H).

// Decomposition of a position in an outer×inner tiled frame (with optional
// gap rows/cols between tiles) into its outer position (which tile) and
// inner position (which cell within the tile). Gap cells get no entry.
// Combined-frame dim is (outer.v*inner.v + (outer.v-1)*gap.v,
//                        outer.h*inner.h + (outer.h-1)*gap.h).
.decl tile_pos(outer: Dim, inner: Dim, gap: Dim,
               p: Position, p_outer: Position, p_inner: Position) inline
tile_pos([Ov, Oh], [Iv, Ih], [Gv, Gh],
         [T, B, L, R],
         [Mt, Ov-1-Mt, Ml, Oh-1-Ml],
         [It, Iv-1-It, Il, Ih-1-Il]) :-
    Mt = range(0, Ov), Ml = range(0, Oh),
    It = range(0, Iv), Il = range(0, Ih),
    T = Mt*(Iv+Gv) + It,
    L = Ml*(Ih+Gh) + Il,
    B = Ov*Iv + (Ov-1)*Gv - 1 - T,
    R = Oh*Ih + (Oh-1)*Gh - 1 - L.
