//! Shared types and primitives for ARC solvers in Souffle. This file holds
//! the types and the runner contract, and includes the modules under
//! `programs/lib/`. Each module opens with a doc that says what it holds.
//!
//! Reading a unit:
//!
//! - A relation marked `// @input` is one the caller populates, and the facts
//!   under it are its default. Every other relation derives.
//! - In a keyed unit, the first column of a relation is its key, and each key
//!   is one independent instance of the unit.
//! - A name with a leading `_` is private to the lib.
//! - A `Requires:` sentence states a precondition the unit does not check,
//!   and what happens when it does not hold.
//!
//! Using a unit:
//!
//! - `ord`, `count`, and `match` are Souffle reserved words, so an instance
//!   cannot take them as its name.
//! - An `inline` relation cannot sit under negation when its clauses
//!   introduce variables, and no inline relation can appear inside an
//!   aggregate; a non-inline relation wraps it.
//! - The anchors (`same_dist`, `corner_anchor`, `slab_anchor`, and the other
//!   composites of box.dl) work only on grounded positions.
//!
//! The runner contract: the solver declares `out`, and no other IO relation.
//! It must be total over the expected output grid: a variant fails on a
//! missing cell. With a trailing TiebreakResolution column, the runner
//! accepts a pair iff the set of emitted grids equals the expected grid plus
//! its alts, and a tiebreak allows only two distinct grids.

/// Typed names with no arithmetic intent: a value of one of these types is
/// joined on, never ordered or computed with.
.type Color <: number
.type Dir <: number
.type Axis <: number
.type DiagDir <: number
.type DiagAxis <: number
.type D4 <: number
.type Sym <: number
.type Sense <: number

/// The rotation subgroup of D4 — how a heading changes.
.type C4 <: D4

.type Dir8 = Dir | DiagDir

.type Axis4 = Axis | DiagAxis

/// A label carrying identity and nothing else: join on equality, never order
/// or count with it.
.type Ident <: number

/// Index of a task example.
.type Example <: number

/// The edge-margin record: a rectangle placed in a frame by its margins from
/// the four edges. box.dl states its algebra.
.type Box = [t: number, b: number, l: number, r: number]

/// (V-length, H-length) of a frame, for ParamsHelpers only.
.type Dim = [v: number, h: number]

/// The two subsets the algebra singles out. Souffle equivalence types are
/// interchangeable, so an alias documents a column's reading and checks
/// nothing. A primitive types a column Box unless it reads the frame's
/// extent from the value, which assumes a cell; a column holds Offset when
/// its value is a translation by construction.
/// A cell: extent 1 on both axes, so the frame's extent is readable from it.
.type Position = Box
/// A translation: the two margins cancel on each axis.
.type Offset = Box

/// Singleton key for keyed components applied to a single set.
.type Unit = U {}

/// The task input grid.
.decl in(p: Position, col: Color)  // @input

/// Train and test inputs and train outputs, fed in determination mode. The
/// test examples have no ex_out rows.
.decl ex_in(e: Example, p: Position, col: Color)  // @input
.decl ex_out(e: Example, p: Position, col: Color)  // @input

/// Per-parameter diff between determine.<parameter> and params.<parameter>;
/// the runner synthesizes the rules, and a nonempty diff is a violation.
.decl _determination_diff(param: symbol)

#include "lib/sets.dl"
#include "lib/orders.dl"
#include "lib/orientation.dl"
#include "lib/box.dl"
#include "lib/cells.dl"
#include "lib/constraints.dl"
#include "lib/params.dl"
