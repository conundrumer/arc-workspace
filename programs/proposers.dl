// Proposers: candidate parameter values derived from a task's examples.
//
// A proposer comp reads ex_in / ex_out (lib.dl's runner contract)
// and emits `propose` — the candidate set for a parameter's value. The final
// column(s) of `propose` are the proposed value; leading columns are
// proposer parameters. The runner probes every proposer against every
// solver's stored values (`run_dl.py determination-plan`); a proposer
// claims no parameter itself.
//
// A claim about inputs alone ranges over every example; a claim about
// the in->out transformation scopes its examples through ex_out.

// Per-example grid extents and coordinate tables. Materialized once so
// joins index on coordinates instead of re-deriving them inline per
// tuple. A helper: no propose relation, so the runner does not probe it.
.comp PairDims {
    .decl in_dim(e: Example, a: Axis, n: number)
    in_dim(E, AXIS_V, T + B + 1) :- ex_in(E, P, _), dist(P, DIR_T, T), dist(P, DIR_B, B).
    in_dim(E, AXIS_H, L + R + 1) :- ex_in(E, P, _), dist(P, DIR_L, L), dist(P, DIR_R, R).

    .decl out_dim(e: Example, a: Axis, n: number)
    out_dim(E, AXIS_V, T + B + 1) :- ex_out(E, P, _), dist(P, DIR_T, T), dist(P, DIR_B, B).
    out_dim(E, AXIS_H, L + R + 1) :- ex_out(E, P, _), dist(P, DIR_L, L), dist(P, DIR_R, R).

    .decl in_at(e: Example, t: number, l: number, c: Color)
    in_at(E, T, L, C) :- ex_in(E, P, C), dist(P, DIR_T, T), dist(P, DIR_L, L).

    .decl out_at(e: Example, t: number, l: number, c: Color)
    out_at(E, T, L, C) :- ex_out(E, P, C), dist(P, DIR_T, T), dist(P, DIR_L, L).
}

// A per-example claim uniform across a scope. Children feed holds and
// scope and declare their own propose over uniform. p is a claim
// parameter propose keeps or drops; Unit when the claim has none. A
// helper: no propose relation.
.comp Uniform<Par, Val> {
    .decl holds(e: Example, p: Par, v: Val)
    .decl scope(e: Example)

    .decl broken(p: Par, v: Val)
    broken(P, V) :- holds(_, P, V), scope(E), !holds(E, P, V).

    .decl uniform(p: Par, v: Val)
    uniform(P, V) :- holds(_, P, V), !broken(P, V).
}

// Per-example color cell counts. A helper: no propose relation.
.comp ColorCounts {
    .type EC = [e: Example, c: Color]
    .init counts = Tally<EC, Position>
    counts.item([E, C], P) :- ex_in(E, P, C).

    .decl color_count(e: Example, c: Color, n: number)
    color_count(E, C, N) :- counts.tally([E, C], N).
}

// A color present in every input.
.comp SharedColor : Uniform<Unit, Color> {
    holds(E, $U(), C) :- ex_in(E, _, C).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color)
    propose(C) :- uniform(_, C).
}

// The most frequent color of every input.
.comp DominantColor : Uniform<Unit, Color> {
    .init counts = ColorCounts
    .init pick = ArgExtremes<Example, Color>
    pick.cand(E, C, N) :- counts.color_count(E, C, N).
    holds(E, $U(), C) :- pick.high(E, C, _).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color)
    propose(C) :- uniform(_, C).
}

// The rarest color of every input.
.comp RarestColor : Uniform<Unit, Color> {
    .init counts = ColorCounts
    .init pick = ArgExtremes<Example, Color>
    pick.cand(E, C, N) :- counts.color_count(E, C, N).
    holds(E, $U(), C) :- pick.low(E, C, _).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color)
    propose(C) :- uniform(_, C).
}

// A color in every train output and no input.
.comp OutNewColor : Uniform<Unit, Color> {
    holds(E, $U(), C) :- ex_out(E, _, C).
    scope(E) :- ex_out(E, _, _).

    .decl propose(c: Color)
    propose(C) :- uniform(_, C), !ex_in(_, _, C).
}

// A color in some train output and no input. The lax form of
// OutNewColor: a paint color triggered conditionally can miss a pair's
// output.
.comp AnyOutNewColor {
    .decl propose(c: Color)
    propose(C) :- ex_out(_, _, C), !ex_in(_, _, C).
}

// A color in every input and no train output.
.comp VanishedColor : Uniform<Unit, Color> {
    holds(E, $U(), C) :- ex_in(E, _, C).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color)
    propose(C) :- uniform(_, C), !ex_out(_, _, C).
}

// A color none of whose cells keeps it in the output. Reads position
// alignment, so it says nothing on shape-changing tasks.
.comp ChangedColor {
    .decl kept(c: Color)
    kept(C) :- ex_in(E, P, C), ex_out(E, P, C).

    .decl propose(c: Color)
    propose(C) :- ex_in(E, _, C), ex_out(E, _, _), !kept(C).
}

// A color all of whose cells keep it in the output. Reads position
// alignment, so it says nothing on shape-changing tasks.
.comp UnchangedColor {
    .decl lost(c: Color)
    lost(C) :- ex_in(E, P, C), ex_out(E, _, _), !ex_out(E, P, C).

    .decl propose(c: Color)
    propose(C) :- ex_in(E, _, C), ex_out(E, _, _), !lost(C).
}

// The color mapping read off aligned cells that change.
.comp ChangedPairs {
    .decl propose(c_from: Color, c_to: Color)
    propose(C1, C2) :- ex_in(E, P, C1), ex_out(E, P, C2), C1 != C2.
}

// The color mapping read off whole examples: each example's vanished
// input color pairs with its new output color. The position-free form of
// ChangedPairs for mappings that recolor by presence, not by cell.
.comp VanishedNewPairs {
    .decl propose(c_from: Color, c_to: Color)
    propose(C1, C2) :-
        ex_in(E, _, C1), !ex_out(E, _, C1),
        ex_out(E, _, C2), !ex_in(E, _, C2).
}

// The factor from input dims to output dims on an axis, uniform across
// pairs.
.comp ScaleRatio : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, No / Ni) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), No % Ni = 0.
    scope(E) :- ex_out(E, _, _).

    .decl propose(k: number)
    propose(K) :- uniform(_, K).
}

// The factor from input dims to output dims per axis, uniform across
// pairs. Stack-ups and mirrors: the factor is the arrangement.
.comp ScaleRatioAxis : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, No / Ni) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), No % Ni = 0.
    scope(E) :- ex_out(E, _, _).

    .decl propose(a: Axis, k: number)
    propose(A, K) :- uniform(A, K).
}

// The factor from output dims to input dims on an axis, uniform across
// pairs. Decomposes and crops.
.comp DivisorRatio : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, Ni / No) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), Ni % No = 0.
    scope(E) :- ex_out(E, _, _).

    .decl propose(k: number)
    propose(K) :- uniform(_, K).
}

// The factor from output dims to input dims per axis, uniform across
// pairs. Gap-0 panel decomposes: the factor is the arrangement.
.comp DivisorRatioAxis : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, Ni / No) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), Ni % No = 0.
    scope(E) :- ex_out(E, _, _).

    .decl propose(a: Axis, k: number)
    propose(A, K) :- uniform(A, K).
}

// The dimension change from input to output on an axis, uniform across
// pairs. Proposed as a magnitude.
.comp DimDiff : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, Ni - No) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), Ni > No.
    holds(E, A, No - Ni) :- dims.in_dim(E, A, Ni), dims.out_dim(E, A, No), No > Ni.
    scope(E) :- ex_out(E, _, _).

    .decl propose(d: number)
    propose(D) :- uniform(_, D).
}

// An input dimension constant across examples.
.comp ConstInDim : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, N) :- dims.in_dim(E, A, N).
    scope(E) :- ex_in(E, _, _).

    .decl propose(n: number)
    propose(N) :- uniform(_, N).
}

// An input dimension constant across pairs, tagged by its axis.
.comp ConstInDimAxis : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, N) :- dims.in_dim(E, A, N).
    scope(E) :- ex_in(E, _, _).

    .decl propose(a: Axis, n: number)
    propose(A, N) :- uniform(A, N).
}

// An output dimension constant across pairs.
.comp ConstOutDim : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, N) :- dims.out_dim(E, A, N).
    scope(E) :- ex_out(E, _, _).

    .decl propose(n: number)
    propose(N) :- uniform(_, N).
}

// An output dimension constant across pairs, tagged by its axis.
.comp ConstOutDimAxis : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, N) :- dims.out_dim(E, A, N).
    scope(E) :- ex_out(E, _, _).

    .decl propose(a: Axis, n: number)
    propose(A, N) :- uniform(A, N).
}

// Tile counts n with dim = n*d + (n-1)*g fitting an input axis of every
// example, over gaps 0..3.
.comp TileCount : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, N) :- dims.in_dim(E, A, Dim), N = range(2, 9), G = range(0, 4),
        Rem = Dim - (N - 1) * G, Rem > 0, Rem % N = 0.
    scope(E) :- ex_in(E, _, _).

    .decl propose(n: number)
    propose(N) :- uniform(_, N).
}

// Tile dims d with dim = n*d + (n-1)*g fitting an input axis of every
// example, over gaps 0..3.
.comp TileDim : Uniform<Axis, number> {
    .init dims = PairDims
    holds(E, A, Rem / N) :- dims.in_dim(E, A, Dim), N = range(2, 9), G = range(0, 4),
        Rem = Dim - (N - 1) * G, Rem > 0, Rem % N = 0.
    scope(E) :- ex_in(E, _, _).

    .decl propose(d: number)
    propose(D) :- uniform(_, D).
}

// The least positive shift under which every input repeats along an
// axis, where both cells exist.
.comp Period : Uniform<Axis, number> {
    .init dims = PairDims

    .decl mismatch(e: Example, a: Axis, k: number)
    mismatch(E, AXIS_H, L2 - L1) :-
        dims.in_at(E, T, L1, C1), dims.in_at(E, T, L2, C2), C1 != C2, L2 > L1.
    mismatch(E, AXIS_V, T2 - T1) :-
        dims.in_at(E, T1, L, C1), dims.in_at(E, T2, L, C2), C1 != C2, T2 > T1.

    holds(E, A, K) :- dims.in_dim(E, A, Dim), K = range(1, Dim), !mismatch(E, A, K).
    scope(E) :- ex_in(E, _, _).

    .init best = Extremes<Axis>
    best.cand(A, K) :- uniform(A, K).

    .decl propose(k: number)
    propose(K) :- best.low(_, K).
}

// Lattice fits whose separator lines are witnessed: (n, d, g) with
// dim = n*d + (n-1)*g on an input axis and every separator line uniform.
// A helper: no propose relation.
.comp SepFits {
    .init dims = PairDims

    // Line at index i along axis a carries more than one color.
    .decl line_multi(e: Example, a: Axis, i: number)
    line_multi(E, AXIS_H, I) :- dims.in_at(E, _, I, C1), dims.in_at(E, _, I, C2), C1 != C2.
    line_multi(E, AXIS_V, I) :- dims.in_at(E, I, _, C1), dims.in_at(E, I, _, C2), C1 != C2.

    .decl mismatch(e: Example, a: Axis, n: number, g: number)
    mismatch(E, A, N, G) :- dims.in_dim(E, A, Dim), N = range(2, 9), G = range(1, 4),
        Rem = Dim - (N - 1) * G, Rem > 0, Rem % N = 0, D = Rem / N,
        K = range(1, N), I = range(K * D + (K - 1) * G, K * (D + G)),
        line_multi(E, A, I).

    .decl fits(e: Example, a: Axis, n: number, d: number, g: number)
    fits(E, A, N, Rem / N, G) :- dims.in_dim(E, A, Dim), N = range(2, 9), G = range(1, 4),
        Rem = Dim - (N - 1) * G, Rem > 0, Rem % N = 0,
        !mismatch(E, A, N, G).
}

// Segment counts of a witnessed separator lattice on every input.
.comp SepTileCount : Uniform<Axis, number> {
    .init sep = SepFits
    holds(E, A, N) :- sep.fits(E, A, N, _, _).
    scope(E) :- ex_in(E, _, _).

    .decl propose(n: number)
    propose(N) :- uniform(_, N).
}

// Segment counts of a witnessed separator lattice on every input, tagged
// by axis. An axis with no lattice beside a witnessed one counts 1.
.comp SepTileCountAxis : Uniform<Axis, number> {
    .init sep = SepFits
    holds(E, A, N) :- sep.fits(E, A, N, _, _).
    scope(E) :- ex_in(E, _, _).

    .decl propose(a: Axis, n: number)
    propose(A, N) :- uniform(A, N).
    propose(A2, 1) :- propose(A, _), perp(A, A2), !holds(_, A2, _).
}

// Segment dims of a witnessed separator lattice on every input.
.comp SepTileDim : Uniform<Axis, number> {
    .init sep = SepFits
    holds(E, A, D) :- sep.fits(E, A, _, D, _).
    scope(E) :- ex_in(E, _, _).

    .decl propose(d: number)
    propose(D) :- uniform(_, D).
}

// Separator thicknesses of a witnessed lattice on every input.
.comp SepThickness : Uniform<Axis, number> {
    .init sep = SepFits
    holds(E, A, G) :- sep.fits(E, A, _, _, G).
    scope(E) :- ex_in(E, _, _).

    .decl propose(g: number)
    propose(G) :- uniform(_, G).
}

// Colors ranked by input cell count, uniform across examples. Rank 0 is
// the rarest; ties share a rank.
.comp CountRankAsc : Uniform<Color, number> {
    .init counts = ColorCounts
    .init ranks = Order<Example, Color>
    ranks.elem(E, C) :- counts.color_count(E, C, _).
    ranks.before(E, C2, C) :-
        counts.color_count(E, C2, N2), counts.color_count(E, C, N), N2 < N.
    holds(E, C, R) :- ranks.rank(E, C, R).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color, r: number)
    propose(C, R) :- uniform(C, R).
}

// Colors ranked by input cell count, uniform across examples. Rank 0 is
// the commonest; ties share a rank.
.comp CountRankDesc : Uniform<Color, number> {
    .init counts = ColorCounts
    .init ranks = Order<Example, Color>
    ranks.elem(E, C) :- counts.color_count(E, C, _).
    ranks.before(E, C2, C) :-
        counts.color_count(E, C2, N2), counts.color_count(E, C, N), N2 > N.
    holds(E, C, R) :- ranks.rank(E, C, R).
    scope(E) :- ex_in(E, _, _).

    .decl propose(c: Color, r: number)
    propose(C, R) :- uniform(C, R).
}

// The D4 seating each output tile from the whole input, for outputs that
// are an arrangement of transformed input copies.
.comp TileD4 : Uniform<Position, D4> {
    .init dims = PairDims

    .decl swaps(t: D4)
    swaps(D4_CW). swaps(D4_CC). swaps(D4_DG). swaps(D4_AD).

    .decl counts(e: Example, nv: number, nh: number, hi: number, wi: number)
    counts(E, Ho / Hi, Wo / Wi, Hi, Wi) :-
        dims.in_dim(E, AXIS_V, Hi), dims.in_dim(E, AXIS_H, Wi),
        dims.out_dim(E, AXIS_V, Ho), dims.out_dim(E, AXIS_H, Wo),
        Ho % Hi = 0, Wo % Wi = 0, Ho * Wo != Hi * Wi.

    // Output cell as arrangement tile x in-frame inner position.
    .decl tile_cell(e: Example, pt: Position, pi: Position, c: Color)
    tile_cell(E, [Tv, Nv - 1 - Tv, Th, Nh - 1 - Th], [Ti, Hi - 1 - Ti, Li, Wi - 1 - Li], C) :-
        counts(E, Nv, Nh, Hi, Wi),
        dims.out_at(E, T, L, C),
        Tv = T / Hi, Ti = T % Hi, Th = L / Wi, Li = L % Wi.

    // A transform whose image frame fits the tile frame.
    .decl shape_ok(e: Example, t: D4)
    shape_ok(E, T) :- counts(E, _, _, Hi, Hi), d4_elem(T).
    shape_ok(E, T) :- counts(E, _, _, _, _), d4_elem(T), !swaps(T).

    .decl mismatch(e: Example, pt: Position, t: D4)
    mismatch(E, Pt, T) :- ex_in(E, P, C), shape_ok(E, T), apply(T, P, Pi),
        tile_cell(E, Pt, Pi, C2), C != C2.

    holds(E, Pt, T) :- tile_cell(E, Pt, _, _), shape_ok(E, T), !mismatch(E, Pt, T).
    scope(E) :- ex_out(E, _, _).

    .decl propose(pt: Position, t: D4)
    propose(Pt, T) :- uniform(Pt, T).
}

// The 2-panel combine table: input splits into two panels along an axis,
// each panel the output's frame; rows map aligned panel color pairs to
// the output color. c1 is the top or left panel.
.comp PanelCombine {
    .init dims = PairDims

    .decl setup(e: Example, a: Axis, d: number, g: number)
    setup(E, A, D, G) :-
        dims.in_dim(E, A, Di), dims.out_dim(E, A, D),
        perp(A, A2), dims.in_dim(E, A2, W), dims.out_dim(E, A2, W),
        G = Di - 2 * D, G >= 0.

    .decl pair_at(e: Example, t: number, l: number, c1: Color, c2: Color)
    pair_at(E, T, L, C1, C2) :-
        setup(E, AXIS_H, D, G),
        dims.in_at(E, T, L, C1), L < D, dims.in_at(E, T, L + D + G, C2).
    pair_at(E, T, L, C1, C2) :-
        setup(E, AXIS_V, D, G),
        dims.in_at(E, T, L, C1), T < D, dims.in_at(E, T + D + G, L, C2).

    .decl propose(c1: Color, c2: Color, c_out: Color)
    propose(C1, C2, Co) :- pair_at(E, T, L, C1, C2), dims.out_at(E, T, L, Co).
}
