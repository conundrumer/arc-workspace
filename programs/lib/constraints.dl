/// The pieces every exact cover of a keyed cell set must contain, by
/// elimination. Pieces are opaque and placements come from the caller.
/// Elimination starts only where a cell has one rival left, so a uniquely
/// packing input whose pieces rival themselves inside their own footprints
/// leaves `forced` partial, as an ambiguous or too-hard input does. A partial
/// `forced` fails the output on totality, never wrongly. Forced pieces not
/// ruled out are pairwise disjoint, so covering every cell witnesses a
/// partition. With a single footprint it forces exactly the greedy
/// reading-order peel.
.comp CoverForcing<Key, Piece> {
    /// The candidate pieces and the cells each covers.
    .decl covers(key: Key, piece: Piece, p: Position)  // @input

    /// Two pieces no cover holds together, beyond overlap.
    .decl conflict(key: Key, piece: Piece, piece2: Piece)  // @input

    // Elimination: a cell whose rivals are all ruled out but one forces its
    // last piece, and a piece overlapping or conflicting with a forced piece
    // is ruled out.
    // "Every other rival is ruled out" is a universal inside the recursion —
    // forced and ruled_out are mutually recursive, so no negation across
    // them stratifies. The rivals of a cell close into a cycle in an
    // arbitrary stable ord order, and the universal becomes a positive walk
    // around the cycle.

    // The pieces covering a cell.
    .decl _rival(key: Key, p: Position, piece: Piece)
    _rival(Ky, P, B) :- covers(Ky, B, P).

    // The ord of each rival's successor, materialized so the aggregate runs
    // once per rival rather than once per rival pair.
    .decl _min_after(key: Key, p: Position, piece: Piece, m: number)
    _min_after(Ky, P, B, M) :-
        _rival(Ky, P, B),
        M = min ord(B3) : { _rival(Ky, P, B3), ord(B3) > ord(B) }.

    // Next in ord order.
    .decl _next(key: Key, p: Position, piece: Piece, piece2: Piece)
    _next(Ky, P, B, B2) :-
        _min_after(Ky, P, B, M), _rival(Ky, P, B2), ord(B2) = M.

    // The cycle it closes.
    .decl _succ(key: Key, p: Position, piece: Piece, piece2: Piece)
    _succ(Ky, P, B, B2) :- _next(Ky, P, B, B2).
    _succ(Ky, P, B, B2) :-
        _rival(Ky, P, B), !_next(Ky, P, B, _),    // the last rival
        _rival(Ky, P, B2), !_next(Ky, P, _, B2),  // links back to the first
        B != B2.

    // Every rival from X around to the one before B, all ruled out.
    .decl _run_out(key: Key, p: Position, piece: Piece, piece2: Piece)
    _run_out(Ky, P, B, X) :- ruled_out(Ky, X), _succ(Ky, P, X, B).
    _run_out(Ky, P, B, X) :- ruled_out(Ky, X), _succ(Ky, P, X, X2), _run_out(Ky, P, B, X2).

    /// Some cell has no other rival left.
    .decl forced(key: Key, piece: Piece)
    forced(Ky, B) :- _rival(Ky, P, B), !_succ(Ky, P, B, _).
    forced(Ky, B) :- _rival(Ky, P, B), _succ(Ky, P, B, X), _run_out(Ky, P, B, X).

    /// Overlaps or conflicts with a forced piece.
    .decl ruled_out(key: Key, piece: Piece)
    ruled_out(Ky, B) :- forced(Ky, B2), covers(Ky, B2, P), covers(Ky, B, P), B != B2.
    ruled_out(Ky, B) :- forced(Ky, B2), conflict(Ky, B2, B).
}

/// The candidates a joint placement of the pieces may still hold, by
/// refutation — the dual of CoverForcing's elimination, for sites where
/// elimination cannot start. A candidate dies when some other piece has no
/// candidate that can stand beside it, or some pair of other pieces has no
/// conflict-free pair beside it, to a fixpoint. alive over-approximates:
/// every joint placement's candidates survive, so a caller painting from the
/// survivors fails on cells where leftover rivals disagree, never wrongly, as
/// long as every piece has a candidate. A piece takes at most one candidate.
/// A piece absent from `cand` kills nothing; the caller guards that case.
///
/// Flagged: assumes each candidate belongs to one piece. A candidate under
/// several pieces kills every candidate.
.comp PlacementPruning<Key, Cand, Piece> {
    /// The candidate placements of each piece.
    .decl cand(key: Key, c: Cand, o: Piece)  // @input

    /// Two candidates no joint placement holds together.
    .decl conflict(key: Key, c: Cand, c2: Cand)  // @input

    // Each kill rule's universal ("every candidate of the piece is
    // blocked") would negate alive inside the recursion, so it walks the
    // piece's candidates in an arbitrary stable ord order — the pair rule
    // as an inner walk nested in an outer one.
    //
    // The room kill's own fixpoint lies below the joint one, so it runs
    // first, in a stratum of its own, over every candidate. The joint
    // fixpoint then grows from it over the survivors alone: a candidate
    // the room kill took is dead, so a universal over a piece's candidates
    // holds exactly when it holds over the piece's survivors. The pair
    // walk's base joins the survivors with themselves, where a join of
    // every candidate with itself would not fit.

    // One chain-and-walk over a candidate set: the chain that puts each
    // piece's candidates in ord order, and the outer walk that finds a
    // piece with no candidate left to stand beside c. The room kill and
    // the joint kill run this same walk over different candidate sets, so
    // each holds an instance of it.
    .comp _Room<K, C, P> {
        // The candidates in play, per piece.
        .decl item(key: K, c: C, o: P)  // @input

        // The conflicts among them.
        .decl conflict(key: K, c: C, c2: C)  // @input

        // The candidates already killed: this walk's own kill, and any
        // kill sharing its fixpoint.
        .decl dead(key: K, c: C)  // @input

        // The ord of each candidate's successor, materialized so the
        // aggregate runs once per candidate rather than once per
        // candidate pair.
        .decl min_after(key: K, o: P, c: C, m: number)
        min_after(Ky, O, C1, M) :-
            item(Ky, C1, O),
            M = min ord(C3) : { item(Ky, C3, O), ord(C3) > ord(C1) }.

        // Each piece's candidates, chained in ord order.
        .decl after(key: K, o: P, c: C, c2: C)
        after(Ky, O, C1, C2) :-
            min_after(Ky, O, C1, M), item(Ky, C2, O), ord(C2) = M.

        .decl head(key: K, o: P, c: C)
        head(Ky, O, C) :- item(Ky, C, O), !after(Ky, O, _, C).

        .decl tail(key: K, o: P, c: C)
        tail(Ky, O, C) :- item(Ky, C, O), !after(Ky, O, C, _).

        // Piece o2 blocked beside c: every candidate of o2 so far
        // conflicts with c or is dead.
        //
        // A walk step whose next candidate must be dead reaches the walk
        // by lookup rather than rescanning it every iteration. The last
        // step rule states that as a `.plan`: version 1, the one driven by
        // new dead tuples, joins the dead atom first, then the chain, then
        // the walk. Souffle numbers the versions by the recursive atoms in
        // the body, so an added atom renumbers them.
        .decl blocked(key: K, c: C, o2: P, c2: C)
        blocked(Ky, Cd, O2, C2) :-
            item(Ky, Cd, O), conflict(Ky, Cd, C2), head(Ky, O2, C2), O2 != O.
        blocked(Ky, Cd, O2, C2) :-
            dead(Ky, C2), head(Ky, O2, C2), item(Ky, Cd, O), O2 != O.
        blocked(Ky, Cd, O2, C2) :-
            blocked(Ky, Cd, O2, C1), after(Ky, O2, C1, C2),
            conflict(Ky, Cd, C2).
        blocked(Ky, Cd, O2, C2) :-
            blocked(Ky, Cd, O2, C1), after(Ky, O2, C1, C2), dead(Ky, C2).
        .plan 1:(3, 2, 1)

        // The kill: some other piece has no candidate that can stand
        // beside c.
        .decl kill(key: K, c: C)
        kill(Ky, Cd) :- blocked(Ky, Cd, O2, C2), tail(Ky, O2, C2).
    }

    // The room kill, over every candidate. Its fixpoint is closed: the
    // only kill it sees is its own.
    .init _room = _Room<Key, Cand, Piece>
    _room.item(K, C, O) :- cand(K, C, O).
    _room.conflict(K, C1, C2) :- conflict(K, C1, C2).
    _room.dead(K, C) :- _room.kill(K, C).

    // The survivors of the room kill.
    .decl _live(key: Key, c: Cand, o: Piece)
    _live(K, C, O) :- cand(K, C, O), !_room.kill(K, C).

    .decl _live_piece(key: Key, o: Piece)
    _live_piece(K, O) :- _live(K, _, O).

    // The joint kill's own walk, over the survivors. Its fixpoint takes
    // every kill of the joint stratum, the pair walk's included.
    .init _joint = _Room<Key, Cand, Piece>
    _joint.item(K, C, O) :- _live(K, C, O).
    _joint.conflict(K, C1, C2) :- conflict(K, C1, C2).
    _joint.dead(K, C) :- dead(K, C).

    // The inner walk: c2 of o2 placed beside c, and every survivor of o3
    // so far cannot join them — it conflicts with c or c2, or is dead.
    .decl _pair_blocked(key: Key, c: Cand, c2: Cand, o3: Piece, c3: Cand)
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _joint.head(K, O3, C3), conflict(K, Cd, C3), _live(K, Cd, O), O != O3,
        _live(K, C2, O2), O2 != O, ord(O2) < ord(O3), !conflict(K, Cd, C2).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _joint.head(K, O3, C3), conflict(K, C2, C3), _live(K, C2, O2),
        ord(O2) < ord(O3),
        _live(K, Cd, O), O != O2, O != O3, !conflict(K, Cd, C2).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        dead(K, C3), _joint.head(K, O3, C3), _live(K, Cd, O), O != O3,
        _live(K, C2, O2), O2 != O, ord(O2) < ord(O3), !conflict(K, Cd, C2).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _pair_blocked(K, Cd, C2, O3, C1), _joint.after(K, O3, C1, C3),
        conflict(K, Cd, C3).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _pair_blocked(K, Cd, C2, O3, C1), _joint.after(K, O3, C1, C3),
        conflict(K, C2, C3).
    _pair_blocked(K, Cd, C2, O3, C3) :-
        _pair_blocked(K, Cd, C2, O3, C1), _joint.after(K, O3, C1, C3),
        dead(K, C3).
    .plan 1:(3, 2, 1)

    // c2 settled for the (piece of c2, o3) pair test beside c: bad in
    // itself, or its inner walk completes.
    .decl _settled(key: Key, c: Cand, o3: Piece, c2: Cand)
    _settled(K, Cd, O3, C2) :-
        conflict(K, Cd, C2), _live(K, Cd, O), _live(K, C2, O2), O2 != O,
        _live_piece(K, O3), O3 != O, ord(O2) < ord(O3).
    _settled(K, Cd, O3, C2) :-
        dead(K, C2), _live(K, C2, O2), _live(K, Cd, O), O2 != O,
        _live_piece(K, O3), O3 != O, ord(O2) < ord(O3).
    _settled(K, Cd, O3, C2) :-
        _pair_blocked(K, Cd, C2, O3, C3), _joint.tail(K, O3, C3).

    // The outer walk: every survivor of c2's piece so far is settled.
    .decl _pair_walk(key: Key, c: Cand, o3: Piece, c2: Cand)
    _pair_walk(K, Cd, O3, C2) :- _settled(K, Cd, O3, C2), _joint.head(K, _, C2).
    _pair_walk(K, Cd, O3, C2) :-
        _pair_walk(K, Cd, O3, C1), _joint.after(K, _, C1, C2),
        _settled(K, Cd, O3, C2).

    /// The refuted candidates.
    .decl dead(key: Key, c: Cand)
    dead(K, Cd) :- _room.kill(K, Cd).
    dead(K, Cd) :- _joint.kill(K, Cd).
    dead(K, Cd) :- _pair_walk(K, Cd, O3, C2), _joint.tail(K, _, C2).

    /// The candidates not refuted, with their pieces.
    .decl alive(key: Key, c: Cand, o: Piece)
    alive(K, Cd, O) :- cand(K, Cd, O), !dead(K, Cd).
}

/// The resolutions of a tiebreak: every injective assignment of candidate
/// items to slots, one term per assignment, backing a TiebreakResolution out
/// column (style: alt outputs). Branch names are program-global, so the
/// solver declares the ADT the comp constructs:
///
///   .type TiebreakResolution =
///       End {} | Sit {slot: Slot, item: Item, rest: TiebreakResolution}
.comp TiebreakResolutions<Key, Slot, Item> {
    /// The candidate items of each slot.
    .decl cand(key: Key, slot: Slot, item: Item)  // @input

    .decl _slot(key: Key, slot: Slot)
    _slot(K, S) :- cand(K, S, _).

    // Slots in an arbitrary fixed order.
    .decl _rank(key: Key, slot: Slot, r: number)
    _rank(K, S, R) :- _slot(K, S), R = count : { _slot(K, S2), ord(S2) < ord(S) }.

    .decl _nslots(key: Key, n: number)
    _nslots(K, N) :- _slot(K, _), N = count : { _slot(K, _) }.

    // One candidate per slot, in rank order.
    .decl _partial(key: Key, r: number, l: TiebreakResolution)
    _partial(K, 0, $End()) :- _slot(K, _).
    _partial(K, R2, $Sit(S, I, L)) :-
        _partial(K, R, L), _rank(K, S, R), cand(K, S, I), R2 = R + 1.

    .decl _combo(key: Key, l: TiebreakResolution)
    _combo(K, L) :- _partial(K, N, L), _nslots(K, N).

    // Suffixes of the combos.
    .decl _sub(key: Key, l: TiebreakResolution)
    _sub(K, L) :- _combo(K, L).
    _sub(K, L) :- _sub(K, $Sit(_, _, L)).

    .decl _mem(key: Key, l: TiebreakResolution, item: Item)
    _mem(K, $Sit(S, I, L), I) :- _sub(K, $Sit(S, I, L)).
    _mem(K, $Sit(S, I, L), I2) :- _sub(K, $Sit(S, I, L)), _mem(K, L, I2).

    .decl _dup(key: Key, l: TiebreakResolution)
    _dup(K, $Sit(S, I, L)) :- _sub(K, $Sit(S, I, L)), _mem(K, L, I).
    _dup(K, $Sit(S, I, L)) :- _sub(K, $Sit(S, I, L)), _dup(K, L).

    /// The valid assignments: no item used twice.
    .decl resolution(key: Key, res: TiebreakResolution)
    resolution(K, L) :- _combo(K, L), !_dup(K, L).

    .decl _within(key: Key, res: TiebreakResolution, l: TiebreakResolution)
    _within(K, L, L) :- resolution(K, L).
    _within(K, L0, L) :- _within(K, L0, $Sit(_, _, L)).

    .decl assign(key: Key, res: TiebreakResolution, slot: Slot, item: Item)
    assign(K, L0, S, I) :- _within(K, L0, $Sit(S, I, _)).
}
