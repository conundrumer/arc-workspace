//! The box algebra: every component whose signature holds a Box, a Position,
//! or an Offset, and that takes no keyed set of cells as input.
//!
//! Box is the edge-margin record (t, b, l, r), ordered V-first then H — a
//! rectangle placed in a frame by its margins from the four edges. In a frame
//! of extent (V, H), the record gives the rows t..V-1-b and the columns
//! l..H-1-r; a negative margin reaches past the frame.
//!
//! The per-axis sum (t+b, l+r) measures the frame's extent minus the
//! rectangle's, so boxes with one sum are translates of one another. A
//! Position is a cell, extent 1 on both axes, which has its frame. An
//! Offset is a translation, sum 0, which moves any box and keeps its extent.
//! In every other role, a Box is interpreted in a frame that the caller
//! supplies, such as the frame of the cell `p` in `box_extent`.

/// The zero box: the whole frame as a box, no move as an offset.
#define ZERO [0, 0, 0, 0]

.functor box_compose(a: Box, b: Box): Box stateful
.functor box_relative(base: Box, x: Box): Box stateful
.functor box_inside(a: Box, b: Box): number stateful
.functor box_interior(a: Box, b: Box): number stateful
.functor box_dist(p: Box, d: Dir): number stateful
.functor box_corner_dist(p: Box, diag: DiagDir): number stateful
.functor box_axis_dim(p: Box, a: Axis): number stateful
.functor box_along(p: Box, a: Axis): Box stateful
.functor box_across(p: Box, a: Axis): Box stateful
.functor box_centered(p: Box): number stateful
.functor box_corner_anchor(diag: DiagDir, p1: Box, p2: Box): number stateful
.functor box_edge_inset(d: Dir8, k: number): Box stateful
.functor box_axis_inset(d: Dir, k1: number, k2: number): Box stateful
.functor box_jump_offset(d: Dir8, k: number): Box stateful
.functor box_apply(d: D4, p: Box): Box stateful
.functor box_tiles(p: Box, a: Axis, k: number, g: number): number stateful
.functor box_tile_outer(p: Box, a: Axis, k: number, g: number): Box stateful
.functor box_tile_inner(p: Box, a: Axis, k: number, g: number): Box stateful
.functor box_concat(outer: Box, inner: Box, a: Axis, g: number): Box stateful

/// Addition: b in a's frame, placed in the outer frame.
.decl compose(a: Box, b: Box, c: Box) inline
compose(A, B, C) :- C = @box_compose(A, B).

/// Subtraction: x relative to base — x in base's frame.
.decl relative(base: Box, x: Box, x_rel: Box) inline
relative(Base, X, X_rel) :- X_rel = @box_relative(Base, X).

/// Pointwise >=: a inside b. At b = ZERO, a lies on the frame.
.decl inside(a: Box, b: Box) inline
inside(A, B) :- @box_inside(A, B) = 1.

/// Pointwise >: a in the interior of b, touching no side. At b = ZERO, off
/// the frame's border.
.decl interior(a: Box, b: Box) inline
interior(A, B) :- @box_interior(A, B) = 1.

/// Cell p of box b, as a cell of b's own frame: the covering test and the
/// relative position.
.decl crop(p: Position, b: Box, p_rel: Position) inline
crop(P, B, P_rel) :- inside(P, B), relative(B, P, P_rel).

/// Distance to edge d; needs d bound.
.decl dist(p: Box, d: Dir, k: number) inline
dist(P, D, K) :- K = @box_dist(P, D).

/// Distances to edge d and its opposite; d need not be bound.
.decl dist_pair(p: Box, d: Dir, k: number, k2: number) inline
dist_pair(P, D, K, K2) :- dist(P, D, K), opposite(D, O), dist(P, O, K2).

/// Distances to the two edges of corner diag, axis-tagged: k1 to the edge
/// on axis a, k2 across.
.decl diag_dist(p: Box, diag: DiagDir, a: Axis, k1: number, k2: number) inline
diag_dist(P, Diag, A, K1, K2) :-
    diag_dirs(Diag, A, D1, D2), dist(P, D1, K1), dist(P, D2, K2).

/// Taxicab distance to corner diag: the sum of its two edge distances.
.decl corner_dist(p: Box, diag: DiagDir, k: number) inline
corner_dist(P, Diag, K) :- diag_dir_elem(Diag), K = @box_corner_dist(P, Diag).

/// p decomposed by axis: along holds the axis component (perpendicular
/// zeroed); across holds the perpendicular (axis zeroed).
.decl split(p: Box, a: Axis, along: Box, across: Box) inline
split(P, A, Along, Across) :- Along = @box_along(P, A), Across = @box_across(P, A).

/// Extent of p's frame along axis a — taken from any position in the frame.
.decl axis_dim(p: Position, a: Axis, n: number) inline
axis_dim(P, A, N) :- N = @box_axis_dim(P, A).

/// Both extents of p's frame: n1 along axis a, n2 across.
.decl axis_dims(p: Position, a: Axis, n1: number, n2: number) inline
axis_dims(P, A, N1, N2) :- axis_dim(P, A, N1), perp(A, A2), axis_dim(P, A2, N2).

/// Proper sub-extents of p's frame along a: every k with 1 <= k < extent.
.decl sub_extent(p: Position, a: Axis, k: number) inline
sub_extent(P, A, K) :- axis_dim(P, A, N), K = range(1, N).

/// Extent of box b along a, in the frame of cell p: the frame's extent less
/// the box's two margins on the axis.
.decl box_extent(b: Box, p: Position, a: Axis, n: number) inline
box_extent(B, P, A, N) :-
    axis_elem(A), axis_dim(P, A, Ext),
    N = Ext + 1 - @box_axis_dim(B, A).  // the functor gives b's margin sum plus 1

/// Box inset from the frame by k on side d, zero elsewhere. At a corner, k
/// sits at both of the corner's edges.
.decl edge_inset(d: Dir8, k: number, b: Box) inline
edge_inset(D, K, B) :- B = @box_edge_inset(D, K).

/// Box inset from the frame by k1 on side d and k2 on its opposite.
.decl axis_inset(d: Dir, k1: number, k2: number, b: Box) inline
axis_inset(D, K1, K2, B) :- B = @box_axis_inset(D, K1, K2).

/// Box inset from the frame by k on every side.
.decl uniform_inset(k: number, b: Box) inline
uniform_inset(K, [K, K, K, K]) :- true.

/// The frame extended by k past side d.
.decl edge_outset(d: Dir8, k: number, b: Box) inline
edge_outset(D, K, B) :- edge_inset(D, -K, B).

/// The frame extended by k1 past side d and k2 past its opposite.
.decl axis_outset(d: Dir, k1: number, k2: number, b: Box) inline
axis_outset(D, K1, K2, B) :- axis_inset(D, -K1, -K2, B).

/// The frame extended by k past every side.
.decl uniform_outset(k: number, b: Box) inline
uniform_outset(K, [-K, -K, -K, -K]) :- true.

/// Translation of k cells toward d: -k at each edge of d, +k at each
/// opposite.
.decl jump_offset(d: Dir8, k: number, v: Offset) inline
jump_offset(D, K, V) :- V = @box_jump_offset(D, K).

/// Unit step toward d: the k = 1 translation.
.decl step_offset(d: Dir8, v: Offset) inline
step_offset(D, V) :- dir8_elem(D), V = @box_jump_offset(D, 1).

/// q is one step from p toward d.
.decl neighbor(p: Box, d: Dir8, q: Box) inline
neighbor(P, D, Q) :- dir8_elem(D), Q = @box_compose(P, @box_jump_offset(D, 1)).

/// q is k cells from p toward d.
.decl jump(p: Box, d: Dir8, k: number, q: Box) inline
jump(P, D, K, Q) :- dir8_elem(D), Q = @box_compose(P, @box_jump_offset(D, K)).

/// The image of a box under a D4 transform.
.decl apply(d: D4, p: Box, p_out: Box) inline
apply(D, P, P_out) :- P_out = @box_apply(D, P).

/// The D4 action on directions, one relation per direction type.
.decl apply_dir(d: D4, dir: Dir, dir_out: Dir)
apply_dir(D, Dir, Dir_out) :-
    d4_elem(D), dir_elem(Dir), dir_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

.decl apply_diag_dir(d: D4, dir: DiagDir, dir_out: DiagDir)
apply_diag_dir(D, Dir, Dir_out) :-
    d4_elem(D), diag_dir_elem(Dir), diag_dir_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

.decl apply_dir8(d: D4, dir: Dir8, dir_out: Dir8)
apply_dir8(D, Dir, Dir_out) :-
    d4_elem(D), dir8_elem(Dir), dir8_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

/// p's axis-a extent cut into n equal parts. p_outer is the tile
/// index in an n-strip frame; p_inner is the cell within the tile.
/// Both axis-only (perpendicular zeroed). A cell in a gap row or column
/// (gap > 0) gets no decomposition, and no cell decomposes unless the
/// gap-adjusted extent divides evenly by n.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, A, N, G, P_outer, P_inner) :-
    axis_dim(P, A, Ext),
    (Ext - (N-1)*G) % N = 0,
    K = (Ext - (N-1)*G) / N,
    divide_by_size(P, A, K, G, P_outer, P_inner).

/// Parameterized by tile size k instead of tile count n. The tile count comes
/// from p's axis-a extent, and no cell decomposes unless the gap-adjusted
/// extent is a multiple of (k + gap).
.decl divide_by_size(p: Position, a: Axis, k: number, gap: number,
                     p_outer: Position, p_inner: Position) inline
divide_by_size(P, A, K, G, P_outer, P_inner) :-
    @box_tiles(P, A, K, G) = 1,
    P_outer = @box_tile_outer(P, A, K, G), P_inner = @box_tile_inner(P, A, K, G).

/// Gap from tile count and tile size. Nothing is derived unless the leftover
/// extent divides evenly by the n-1 gaps.
.decl divide_gap(p: Position, a: Axis, n: number, k: number, g: number) inline
divide_gap(P, A, N, K, G) :-
    axis_dim(P, A, Ext), N > 1,
    (Ext - N*K) % (N-1) = 0,
    G = (Ext - N*K) / (N-1).

/// The period n that distance t falls in, and the index k within that
/// period, along periods of width w separated by gaps of g. A distance in a
/// gap gives none, and no divisibility condition applies.
.decl stride(t: number, w: number, g: number, n: number, k: number) inline
stride(T, W, G, N, K) :-
    T >= 0,
    T_cyc = T % (W + G), T_cyc < W,
    K = T_cyc,
    N = T / (W + G).

/// Axis-a tiles recomposed into a single extent — the inverse of divide, over
/// the same p_outer and p_inner. p_grid is axis-only on the same axis. With
/// gap > 0, only filled tile cells appear in p_grid — gap rows/cols are
/// absent.
.decl concat(p_outer: Position, p_inner: Position, a: Axis, gap: number,
             p_grid: Position) inline
concat(P_outer, P_inner, A, G, P_grid) :- P_grid = @box_concat(P_outer, P_inner, A, G).

/// Two positions agree on the distance to edge d.
.decl same_dist(d: Dir, p1: Box, p2: Box) inline
same_dist(D, P1, P2) :- @box_dist(P1, D) = @box_dist(P2, D).

/// p and q on one line of family a — a row, a column, or a diagonal.
.decl same_line(a: Axis4, p: Position, q: Position) inline
same_line(A, P, Q) :- perp(A, A2), axis_of(D, A2), same_dist(D, P, Q).
same_line(DA, P, Q) :-
    diag_perp(DA, DA2), diag_axis_of(Diag, DA2),
    @box_corner_dist(P, Diag) = @box_corner_dist(Q, Diag).

/// p strictly nearer d than q. At a DiagDir the compared distances are
/// corner_dist.
.decl nearer(d: Dir8, p: Position, q: Position) inline
nearer(D, P, Q) :- dir_elem(D), @box_dist(P, D) < @box_dist(Q, D).
nearer(D, P, Q) :- diag_dir_elem(D), @box_corner_dist(P, D) < @box_corner_dist(Q, D).

/// Two positions agree on the distances to the two edges of corner d.
.decl corner_anchor(d: DiagDir, p1: Box, p2: Box) inline
corner_anchor(Diag, P1, P2) :- diag_dir_elem(Diag), @box_corner_anchor(Diag, P1, P2) = 1.

/// Two positions agree on dist-to-edge d and on the perpendicular extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2), axis_of(D, A), @box_across(P1, A) = @box_across(P2, A).

/// The two edge distances agree on each axis. An even extent has no such
/// Position.
.decl centered(p: Box) inline
centered(P) :- @box_centered(P) = 1.

/// Cell p on box b's d-side edge.
.decl box_edge(p: Position, b: Box, d: Dir) inline
box_edge(P, B, D) :- inside(P, B), dir_elem(D), same_dist(D, P, B).

/// Cell p at box b's corner d.
.decl box_corner(p: Position, b: Box, d: DiagDir) inline
box_corner(P, B, D) :- inside(P, B), corner_anchor(D, P, B).

/// p's axis-a extent cut into n equal slabs, each across the whole
/// perpendicular extent. p_outer is axis-only on a; p_inner is the full 2D
/// within-slab position — perpendicular taken from p.
/// No cell decomposes unless the gap-adjusted extent divides evenly by n.
.decl divide_slab(p: Position, a: Axis, n: number, gap: number,
                  p_outer: Position, p_inner: Position) inline
divide_slab(P, A, N, G, P_outer, P_inner) :-
    divide(P, A, N, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

/// Parameterized by tile size k instead of tile count n. It uses the
/// decomposition condition of divide_by_size.
.decl divide_by_size_slab(p: Position, a: Axis, k: number, gap: number,
                          p_outer: Position, p_inner: Position) inline
divide_by_size_slab(P, A, K, G, P_outer, P_inner) :-
    divide_by_size(P, A, K, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

/// p's frame cut into n by n equal tiles, with one gap width on both axes.
/// Outputs are full 2D:
/// p_outer indexes an n×n tile arrangement; p_inner is the cell within a tile.
.decl divide_2d(p: Position, n: number, gap: number,
                p_outer: Position, p_inner: Position) inline
divide_2d(P, N, G, P_outer, P_inner) :-
    divide(P, AXIS_V, N, G, P_ov, P_iv),
    divide(P, AXIS_H, N, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

/// Parameterized by tile size k instead of tile count n.
.decl divide_by_size_2d(p: Position, k: number, gap: number,
                        p_outer: Position, p_inner: Position) inline
divide_by_size_2d(P, K, G, P_outer, P_inner) :-
    divide_by_size(P, AXIS_V, K, G, P_ov, P_iv),
    divide_by_size(P, AXIS_H, K, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

/// Axis-a slabs recomposed into a single frame — the inverse of divide_slab,
/// over the same p_outer and p_inner. p_grid is the recomposed full 2D
/// position.
.decl concat_slab(p_outer: Position, p_inner: Position, a: Axis, gap: number,
                  p_grid: Position) inline
concat_slab(P_outer, P_inner, A, G, P_grid) :-
    P_grid = @box_compose(@box_concat(P_outer, @box_along(P_inner, A), A, G),
                          @box_across(P_inner, A)).

/// 2D tiles recomposed into a single frame — the inverse of divide_2d and
/// divide_by_size_2d, over the same p_outer and p_inner. p_grid is the
/// recomposed full 2D position.
.decl concat_2d(p_outer: Position, p_inner: Position, gap: number,
                p_grid: Position) inline
concat_2d(P_outer, P_inner, G, P_grid) :-
    P_grid = @box_compose(
        @box_concat(@box_along(P_outer, AXIS_V), @box_along(P_inner, AXIS_V), AXIS_V, G),
        @box_concat(@box_across(P_outer, AXIS_V), @box_across(P_inner, AXIS_V), AXIS_H, G)).

/// The positions of a 1-wide frame laid out from a dense index set, each
/// index at its distance from an edge.
.comp DirFrame<Key> {  // @construction
    /// The edge the distances are measured from.
    .decl dir(d: Dir)  // @input

    /// The frame's indices.
    .decl dist_set(key: Key, k: number)  // @input

    // A key whose index set is not dense: some index has no predecessor, or
    // the largest index is not the count less one. Such a set maps indices
    // to positions outside the frame, so the key gets no extent and no pos.
    .decl _sparse(key: Key)
    _sparse(Ky) :- dist_set(Ky, K), K > 0, !dist_set(Ky, K-1).
    _sparse(Ky) :-
        dist_set(Ky, _),
        Mx = max K : { dist_set(Ky, K) },
        N = count : { dist_set(Ky, K) },
        Mx != N-1.

    /// Size of the key's index set. A key whose set is not dense —
    /// {0, 1, ..., extent-1} — gets no extent and no pos.
    .decl extent(key: Key, n: number)
    extent(Ky, N) :- dist_set(Ky, _), !_sparse(Ky), N = count : { dist_set(Ky, K) }.

    /// Position at distance k from edge dir, axis-only (perpendicular zeroed).
    .decl pos(key: Key, k: number, p: Position) inline
    pos(Ky, K, P) :-
        dist_set(Ky, K), !_sparse(Ky), dir(D), extent(Ky, N),
        axis_inset(D, K, N-1-K, P).
}

/// The cells of a 1-wide frame of a given extent along an axis: n axis-only
/// positions.
.comp AxisFrame<Key> {  // @construction
    .decl extent(key: Key, a: Axis, n: number)  // @input

    .decl cell(key: Key, a: Axis, p: Position)
    cell(Ky, A, P) :-
        extent(Ky, A, N), axis_of(D, A),
        K = range(0, N),
        axis_inset(D, K, N-1-K, P).
}

/// The cells of a frame of a given extent on each axis, as full 2D
/// positions.
.comp Frame2D<Key> {  // @construction
    .decl extent(key: Key, a: Axis, n: number)  // @input

    .decl cell(key: Key, p: Position)

    .init _ax = AxisFrame<Key>
    _ax.extent(Ky, A, N) :- extent(Ky, A, N).

    cell(Ky, P) :-
        perp(A1, A2), _ax.cell(Ky, A1, P1), _ax.cell(Ky, A2, P2),
        compose(P1, P2, P).
}

/// The Box with a given distance to each edge: the inverse of dist. A
/// caller with an edge of no width writes that edge's zero row.
.comp DirPack<Key> {  // @construction
    .decl edge(key: Key, d: Dir, k: number)  // @input

    .decl axis_pos(key: Key, a: Axis, p: Box)
    axis_pos(Ky, A, P) :-
        axis_of(D, A), opposite(D, O),
        edge(Ky, D, K1), edge(Ky, O, K2),
        axis_inset(D, K1, K2, P).

    .decl box(key: Key, b: Box)
    box(Ky, B) :-
        perp(A1, A2), axis_pos(Ky, A1, B1), axis_pos(Ky, A2, B2),
        compose(B1, B2, B).
}
