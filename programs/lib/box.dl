//! The box algebra: every unit whose signature holds a Box, a Position, or an
//! Offset, and that takes no keyed set of cells as input.
//!
//! Box is the edge-margin record (t, b, l, r), ordered V-first then H — a
//! rectangle placed in a frame by its margins from the four edges. A frame of
//! extent (H, W) reads the record as the rows t..H-1-b and the columns
//! l..W-1-r; a negative margin reaches past the frame. Dir constants index
//! into a Box.
//!
//! The per-axis sum (t+b, l+r) measures the frame's extent minus the
//! rectangle's, so boxes with one sum are translates of one another. Two
//! subsets have names. A Position is a cell, extent 1 on both axes, which
//! carries its frame. An Offset is a translation, sum 0, which moves any box
//! and keeps its extent. Every other reading — a rectangle, a margin, a change
//! per edge — is a Box read against a frame the reader supplies.
//!
//! The records form a group under componentwise addition, and every operation
//! here is one of four kinds. Addition composes framings: for a box A in the
//! frame and a box B in A's own frame, A + B is B in the outer frame
//! (`compose`), and subtraction is relative position, B - A is B in A's frame
//! (`relative`). The pointwise order is nesting: A >= B iff A lies inside B
//! (`inside`), and strict is the interior (`interior`). The projections read a
//! single component or one axis pair (`dist`, `split`). The D4 action permutes
//! the components, so every operation is equivariant.
//!
//! The readouts take a box apart into scalars — an edge distance, a pair of
//! them, a corner distance, an extent. The constructors build a box from
//! scalars: an inset moves edges inward, an outset lets the frame out, and an
//! offset moves a box and keeps its extent. A constructor binds none of its
//! direction, so the caller supplies d.
//!
//! A step moves one cell toward a direction. A jump moves k cells, and the
//! step is its k = 1 case.
//!
//! The divide family cuts an extent into equal tiles and reads a cell as a
//! tile index plus the cell within that tile. One reading takes the tile
//! count, one takes the tile size, and one reads the gap from count and size.
//! The same decomposition applies to a distance instead of a position, and
//! the inverse puts a tile index and an inner cell back together.
//!
//! The composites stand on those operations: tests that two positions agree on
//! a distance, and the slab and 2D forms of divide and concat, which carry the
//! perpendicular through or cut both axes at once.
//!
//! The frames realize the cells of a frame from an index set or an extent, and
//! the packer builds a Box from per-Dir scalars.

/// The zero box: the whole frame as a box, no move as an offset.
#define ZERO [0, 0, 0, 0]

// Dispatch/projection functors (C++, in lib_functors.cpp).
.functor dist_proj(d: Dir, t: number, b: number, l: number, r: number): number
.functor keep_dir(sel: Dir8, target: number, v: number): number
.functor keep_axis(sel: Axis, target: number, v: number): number
.functor axis_near(a: Axis, t: number, b: number, l: number, r: number): number
.functor axis_far(a: Axis, t: number, b: number, l: number, r: number): number
.functor apply_t(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_b(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_l(d: D4, t: number, b: number, l: number, r: number): number
.functor apply_r(d: D4, t: number, b: number, l: number, r: number): number

/// Addition: b in a's frame, seated in the outer frame. A cell seated in a
/// box, a box moved by an offset, a frame inset by a margin, a box seated in
/// a let-out frame: one operation.
.decl compose(a: Box, b: Box, c: Box) inline
compose([T1, B1, L1, R1], [T2, B2, L2, R2], [T1+T2, B1+B2, L1+L2, R1+R2]) :- true.

/// Subtraction: x relative to base — x in base's frame. A cell in a box's
/// coordinates, or the offset between two cells of one frame. The inverse
/// read of compose, and the form that binds an unknown addend.
.decl relative(base: Box, x: Box, x_rel: Box) inline
relative([T1, B1, L1, R1], [T2, B2, L2, R2],
         [T2-T1, B2-B1, L2-L1, R2-R1]) :- true.

/// Pointwise >=: a inside b. A cell inside a box is the extent-1 case; at
/// b = ZERO, a lies on the frame.
.decl inside(a: Box, b: Box) inline
inside([T1, B1, L1, R1], [T2, B2, L2, R2]) :-
    T1 >= T2, B1 >= B2, L1 >= L2, R1 >= R2.

/// Pointwise >: a in the interior of b, touching no side. At b = ZERO, off
/// the frame's border.
.decl interior(a: Box, b: Box) inline
interior([T1, B1, L1, R1], [T2, B2, L2, R2]) :-
    T1 > T2, B1 > B2, L1 > L2, R1 > R2.

/// Cell p of box b, as a cell of b's own frame: the covering test and the
/// relative read. A cell outside the box is `relative` alone.
.decl crop(p: Position, b: Box, p_rel: Position) inline
crop(P, B, P_rel) :- inside(P, B), relative(B, P, P_rel).

/// Distance from p's edge d to the frame's edge d: the component the Dir
/// selects.
.decl dist(p: Box, d: Dir, k: number) inline
dist(P, D, K) :- P = [T, B, L, R], K = @dist_proj(D, T, B, L, R).

/// Distances to edge d and its opposite. A repeated variable states
/// centered; a comparison picks the nearer half.
.decl dist_pair(p: Box, d: Dir, k: number, k2: number) inline
dist_pair(P, D, K, K2) :- dist(P, D, K), opposite(D, O), dist(P, O, K2).

/// Distances to the two edges of corner diag, axis-tagged: k1 to the edge
/// on axis a, k2 across. On-diagonal is a repeated variable.
.decl diag_dist(p: Box, diag: DiagDir, a: Axis, k1: number, k2: number) inline
diag_dist(P, Diag, A, K1, K2) :-
    diag_dirs(Diag, A, D1, D2), dist(P, D1, K1), dist(P, D2, K2).

/// Taxicab distance to corner diag: the sum of its two edge distances.
/// Level sets are the lines of the perpendicular diagonal axis, so
/// equality tests same-diagonal and comparison tests sidedness.
.decl corner_dist(p: Box, diag: DiagDir, k: number) inline
corner_dist(P, Diag, K) :- diag_dist(P, Diag, _, K1, K2), K = K1 + K2.

/// Decompose p by axis: along carries the axis component (perpendicular
/// zeroed); across carries the perpendicular (axis zeroed). Cells sharing
/// along form a line perpendicular to a; same_line(a, ...) is the line
/// along a, the cells sharing across.
.decl split(p: Box, a: Axis, along: Box, across: Box) inline
split(P, A,
      [@keep_axis(A, AXIS_V, T), @keep_axis(A, AXIS_V, B), @keep_axis(A, AXIS_H, L), @keep_axis(A, AXIS_H, R)],
      [@keep_axis(A, AXIS_H, T), @keep_axis(A, AXIS_H, B), @keep_axis(A, AXIS_V, L), @keep_axis(A, AXIS_V, R)]) :-
    P = [T, B, L, R].

/// Extent of p's frame along axis a — read off any position in the frame.
.decl axis_dim(p: Position, a: Axis, n: number) inline
axis_dim(P, A, N) :- P = [T, B, L, R],
    N = @axis_near(A, T, B, L, R) + @axis_far(A, T, B, L, R) + 1.

/// Wide extent readout of p's frame: n1 along axis a, n2 across. A line is
/// (N, 1); a repeated variable states a square; a comparison finds the
/// long axis.
.decl axis_dims(p: Position, a: Axis, n1: number, n2: number) inline
axis_dims(P, A, N1, N2) :- axis_dim(P, A, N1), perp(A, A2), axis_dim(P, A2, N2).

/// Proper sub-extents of p's frame along a: every k with 1 <= k < extent.
.decl sub_extent(p: Position, a: Axis, k: number) inline
sub_extent(P, A, K) :- axis_dim(P, A, N), K = range(1, N).

/// Extent of box b along a, in the frame of cell p: the frame's extent less
/// the box's two margins on the axis.
.decl box_extent(b: Box, p: Position, a: Axis, n: number) inline
box_extent(B, P, A, N) :-
    axis_dim(P, A, Ext), axis_of(D, A), opposite(D, O),
    dist(B, D, M1), dist(B, O, M2), N = Ext - M1 - M2.

/// Box inset from the frame by k on side d, zero elsewhere. At a corner, k
/// sits at both of the corner's edges.
.decl edge_inset(d: Dir8, k: number, b: Box) inline
edge_inset(D, K, [@keep_dir(D, DIR_T, K), @keep_dir(D, DIR_B, K), @keep_dir(D, DIR_L, K), @keep_dir(D, DIR_R, K)]) :- true.

/// Box inset from the frame by k1 on side d and k2 on its opposite.
.decl axis_inset(d: Dir, k1: number, k2: number, b: Box) inline
axis_inset(D, K1, K2, B) :-
    opposite(D, O), edge_inset(D, K1, B1), edge_inset(O, K2, B2), compose(B1, B2, B).

/// Box inset from the frame by k on every side.
.decl uniform_inset(k: number, b: Box) inline
uniform_inset(K, [K, K, K, K]) :- true.

/// The frame let out by k on side d. A box seated in it by `compose` is that
/// box let out.
.decl edge_outset(d: Dir8, k: number, b: Box) inline
edge_outset(D, K, [-T, -B, -L, -R]) :- edge_inset(D, K, [T, B, L, R]).

/// The frame let out by k1 on side d and k2 on its opposite.
.decl axis_outset(d: Dir, k1: number, k2: number, b: Box) inline
axis_outset(D, K1, K2, B) :-
    opposite(D, O), edge_outset(D, K1, B1), edge_outset(O, K2, B2), compose(B1, B2, B).

/// The frame let out by k on every side.
.decl uniform_outset(k: number, b: Box) inline
uniform_outset(K, [-K, -K, -K, -K]) :- true.

/// Translation of k cells toward d: -k at each edge of d, +k at each
/// opposite.
.decl jump_offset(d: Dir8, k: number, v: Offset) inline
jump_offset(D, K, [B - T, T - B, R - L, L - R]) :- edge_inset(D, K, [T, B, L, R]).

// The unit steps, materialized so the functor chain runs eight times per
// program, not once per calling tuple.
.decl _step(d: Dir8, v: Offset)
_step(D, Step) :- dir8_elem(D), jump_offset(D, 1, Step).

/// Unit step toward d: the k = 1 translation.
.decl step_offset(d: Dir8, v: Offset) inline
step_offset(D, Step) :- _step(D, Step).

/// q is one step from p toward d.
.decl neighbor(p: Box, d: Dir8, q: Box) inline
neighbor(P, D, Q) :- step_offset(D, S), compose(P, S, Q).

/// q is k cells from p toward d.
.decl jump(p: Box, d: Dir8, k: number, q: Box) inline
jump(P, D, K, Q) :- jump_offset(D, K, V), compose(P, V, Q).

/// Apply a D4 transform to a box.
.decl apply(d: D4, p: Box, p_out: Box) inline
apply(D, P, [@apply_t(D, T, B, L, R), @apply_b(D, T, B, L, R),
             @apply_l(D, T, B, L, R), @apply_r(D, T, B, L, R)]) :- P = [T, B, L, R].

/// The D4 action on a Dir.
.decl apply_dir(d: D4, dir: Dir, dir_out: Dir)
apply_dir(D, Dir, Dir_out) :-
    d4_elem(D), dir_elem(Dir), dir_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

/// The D4 action on a DiagDir.
.decl apply_diag_dir(d: D4, dir: DiagDir, dir_out: DiagDir)
apply_diag_dir(D, Dir, Dir_out) :-
    d4_elem(D), diag_dir_elem(Dir), diag_dir_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

/// The D4 action on a Dir8.
.decl apply_dir8(d: D4, dir: Dir8, dir_out: Dir8)
apply_dir8(D, Dir, Dir_out) :-
    d4_elem(D), dir8_elem(Dir), dir8_elem(Dir_out),
    step_offset(Dir, S), apply(D, S, S2), step_offset(Dir_out, S2).

/// Divide p's axis-a extent into n equal parts. p_outer is the tile
/// index in an n-strip frame; p_inner is the cell within the tile.
/// Both axis-only (perpendicular zeroed). A cell in a gap row or column
/// (gap > 0) gets no decomposition, and no cell decomposes unless the
/// gap-adjusted extent divides evenly by n.
.decl divide(p: Position, a: Axis, n: number, gap: number, p_outer: Position, p_inner: Position) inline
divide(P, A, N, G, P_outer, P_inner) :-
    axis_dim(P, A, Ext),
    (Ext - (N-1)*G) % N = 0,
    K = (Ext - (N-1)*G) / N,
    divide_by_size(P, A, K, G, P_outer, P_inner).

/// Parameterized by tile size k instead of tile count n. The tile count comes
/// from p's axis-a extent, and no cell decomposes unless the gap-adjusted
/// extent is a multiple of (k + gap).
.decl divide_by_size(p: Position, a: Axis, k: number, gap: number,
                     p_outer: Position, p_inner: Position) inline
divide_by_size(P, A, K, G, P_outer, P_inner) :-
    P = [T, B, L, R],
    Near = @axis_near(A, T, B, L, R), Far = @axis_far(A, T, B, L, R),
    Ext = Near + Far + 1,
    (Ext + G) % (K + G) = 0,
    N = (Ext + G) / (K + G),
    K_cyc = Near % (K + G),
    K_cyc < K,
    O = Near / (K + G),
    P_outer = [@keep_axis(A, AXIS_V, O),     @keep_axis(A, AXIS_V, N-1-O),
               @keep_axis(A, AXIS_H, O),     @keep_axis(A, AXIS_H, N-1-O)],
    P_inner = [@keep_axis(A, AXIS_V, K_cyc), @keep_axis(A, AXIS_V, K-1-K_cyc),
               @keep_axis(A, AXIS_H, K_cyc), @keep_axis(A, AXIS_H, K-1-K_cyc)].

/// Gap from tile count and tile size — the gap reading of the divide family.
/// Nothing is derived unless the leftover extent divides evenly by the n-1
/// gaps.
.decl divide_gap(p: Position, a: Axis, n: number, k: number, g: number) inline
divide_gap(P, A, N, K, G) :-
    axis_dim(P, A, Ext), N > 1,
    (Ext - N*K) % (N-1) = 0,
    G = (Ext - N*K) / (N-1).

/// Distance t along a period of w (with gap g between periods) decomposes
/// into period index n and within-period offset k: `divide_by_size` over a
/// distance instead of a position, and without the divisibility condition.
/// k fixed to 0 states that t is a whole number of periods.
.decl stride(t: number, w: number, g: number, n: number, k: number) inline
stride(T, W, G, N, K) :-
    T >= 0,
    T_cyc = T % (W + G), T_cyc < W,
    K = T_cyc,
    N = T / (W + G).

/// Recompose axis-a tiles into a single extent — the inverse of divide, over
/// the same p_outer and p_inner. p_grid is axis-only on the same axis. With
/// gap > 0, only filled tile cells appear in p_grid — gap rows/cols are
/// absent. The assembled extent reads off any p_grid with `axis_dim`; an
/// AxisFrame (Frame2D for the 2D forms) over that extent holds the gap
/// cells as the cells no tile fills.
.decl concat(p_outer: Position, p_inner: Position, a: Axis, gap: number,
             p_grid: Position) inline
concat(P_outer, P_inner, A, G, P_grid) :-
    P_outer = [OT, OB, OL, OR], P_inner = [IT, IB, IL, IR],
    ONear = @axis_near(A, OT, OB, OL, OR), OFar = @axis_far(A, OT, OB, OL, OR),
    INear = @axis_near(A, IT, IB, IL, IR), IFar = @axis_far(A, IT, IB, IL, IR),
    Span = INear + IFar + 1,
    GNear = ONear*(Span+G) + INear,
    GFar  = OFar*(Span+G) + IFar,
    P_grid = [@keep_axis(A, AXIS_V, GNear), @keep_axis(A, AXIS_V, GFar),
              @keep_axis(A, AXIS_H, GNear), @keep_axis(A, AXIS_H, GFar)].

/// Two positions agree on the distance to edge d. A single-edge hypothesis reads
/// across frames of different size, where collinearity does not.
.decl same_dist(d: Dir, p1: Box, p2: Box) inline
same_dist(D, P1, P2) :- dist(P1, D, K), dist(P2, D, K).

/// p and q on one line of family a — a row, a column, or a diagonal.
.decl same_line(a: Axis4, p: Position, q: Position) inline
same_line(A, P, Q) :- perp(A, A2), axis_of(D, A2), same_dist(D, P, Q).
same_line(DA, P, Q) :-
    diag_perp(DA, DA2), diag_axis_of(Diag, DA2),
    corner_dist(P, Diag, K), corner_dist(Q, Diag, K).

/// p strictly nearer d than q. At a DiagDir the compared distances are
/// corner_dist. nearer cannot sit under negation.
.decl nearer(d: Dir8, p: Position, q: Position) inline
nearer(D, P, Q) :- dir_elem(D), dist(P, D, K), dist(Q, D, K2), K < K2.
nearer(D, P, Q) :-
    diag_dir_elem(D), corner_dist(P, D, K), corner_dist(Q, D, K2), K < K2.

/// Two positions agree on the distances to the two edges of corner d.
.decl corner_anchor(d: DiagDir, p1: Box, p2: Box) inline
corner_anchor(Diag, P1, P2) :-
    diag_dist(P1, Diag, A, K1, K2),
    diag_dist(P2, Diag, A, K1, K2).

/// Two positions agree on dist-to-edge d and on the perpendicular extent.
.decl slab_anchor(d: Dir, p1: Position, p2: Position) inline
slab_anchor(D, P1, P2) :-
    same_dist(D, P1, P2),
    axis_of(D, A),
    split(P1, A, _, Ac), split(P2, A, _, Ac).

/// The two edge distances agree on each axis. An even extent has no such
/// Position.
.decl centered(p: Box) inline
centered([V, V, H, H]) :- true.

/// Cell p on box b's d-side edge.
.decl box_edge(p: Position, b: Box, d: Dir) inline
box_edge(P, B, D) :- inside(P, B), dir_elem(D), same_dist(D, P, B).

/// Cell p at box b's corner d.
.decl box_corner(p: Position, b: Box, d: DiagDir) inline
box_corner(P, B, D) :- inside(P, B), corner_anchor(D, P, B).

/// 1D divide along axis a with perpendicular passthrough. p_outer is
/// axis-only on a; p_inner is the full 2D within-slab position —
/// perpendicular carried from p.
/// No cell decomposes unless the gap-adjusted extent divides evenly by n.
.decl divide_slab(p: Position, a: Axis, n: number, gap: number,
                  p_outer: Position, p_inner: Position) inline
divide_slab(P, A, N, G, P_outer, P_inner) :-
    divide(P, A, N, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

/// Parameterized by tile size k instead of tile count n. No cell decomposes
/// unless the gap-adjusted extent is a multiple of k plus the gap.
.decl divide_by_size_slab(p: Position, a: Axis, k: number, gap: number,
                          p_outer: Position, p_inner: Position) inline
divide_by_size_slab(P, A, K, G, P_outer, P_inner) :-
    divide_by_size(P, A, K, G, P_outer, P_i_axis),
    split(P, A, _, Across),
    compose(P_i_axis, Across, P_inner).

/// 2D divide, one tile count and gap on both axes. Outputs are full 2D:
/// p_outer indexes an n×n tile arrangement; p_inner is the cell within a tile.
/// One scalar over both axes states the square hypothesis; Divide2D makes the
/// rectangular one.
.decl divide_2d(p: Position, n: number, gap: number,
                p_outer: Position, p_inner: Position) inline
divide_2d(P, N, G, P_outer, P_inner) :-
    divide(P, AXIS_V, N, G, P_ov, P_iv),
    divide(P, AXIS_H, N, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

/// Parameterized by tile size k instead of tile count n.
.decl divide_by_size_2d(p: Position, k: number, gap: number,
                        p_outer: Position, p_inner: Position) inline
divide_by_size_2d(P, K, G, P_outer, P_inner) :-
    divide_by_size(P, AXIS_V, K, G, P_ov, P_iv),
    divide_by_size(P, AXIS_H, K, G, P_oh, P_ih),
    compose(P_ov, P_oh, P_outer),
    compose(P_iv, P_ih, P_inner).

/// 1D concat along axis a with perpendicular passthrough — the inverse of
/// divide_slab, over the same p_outer and p_inner. p_grid is the recomposed
/// full 2D position.
.decl concat_slab(p_outer: Position, p_inner: Position, a: Axis, gap: number,
                  p_grid: Position) inline
concat_slab(P_outer, P_inner, A, G, P_grid) :-
    split(P_inner, A, P_i_axis, Across),
    concat(P_outer, P_i_axis, A, G, P_along),
    compose(P_along, Across, P_grid).

/// 2D concat on both axes — the inverse of divide_2d and divide_by_size_2d,
/// over the same p_outer and p_inner. p_grid is the recomposed full 2D
/// position.
.decl concat_2d(p_outer: Position, p_inner: Position, gap: number,
                p_grid: Position) inline
concat_2d(P_outer, P_inner, G, P_grid) :-
    split(P_outer, AXIS_V, P_outer_v, P_outer_h),
    split(P_inner, AXIS_V, P_inner_v, P_inner_h),
    concat(P_outer_v, P_inner_v, AXIS_V, G, P_grid_v),
    concat(P_outer_h, P_inner_h, AXIS_H, G, P_grid_h),
    compose(P_grid_v, P_grid_h, P_grid).

/// 1D frame defined by an index set and an edge.
.comp DirFrame<Key> {
    /// The edge the distances are measured from.
    .decl dir(d: Dir)  // @input

    /// The frame's indices.
    .decl dist_set(key: Key, k: number)  // @input

    // A key whose index set is not dense: some index has no predecessor, or
    // the largest index is not the count less one. Such a set maps indices
    // to positions outside the frame, so the key gets no extent and no pos.
    .decl _sparse(key: Key)
    _sparse(Ky) :- dist_set(Ky, K), K > 0, !dist_set(Ky, K-1).
    _sparse(Ky) :-
        dist_set(Ky, _),
        Mx = max K : { dist_set(Ky, K) },
        N = count : { dist_set(Ky, K) },
        Mx != N-1.

    /// Size of the key's index set. A key whose set is not dense —
    /// {0, 1, ..., extent-1} — gets no extent and no pos.
    .decl extent(key: Key, n: number)
    extent(Ky, N) :- dist_set(Ky, _), !_sparse(Ky), N = count : { dist_set(Ky, K) }.

    /// Position at distance k from edge dir, axis-only (perpendicular zeroed).
    .decl pos(key: Key, k: number, p: Position) inline
    pos(Ky, K, P) :-
        dist_set(Ky, K), !_sparse(Ky), dir(D), extent(Ky, N),
        axis_inset(D, K, N-1-K, P).
}

/// 1D frame from an axis-tagged extent — the n axis-only positions of a
/// 1-wide frame. No end is privileged and there is no index map, so the
/// extent alone gives the frame.
.comp AxisFrame<Key> {
    /// The frame's extent on axis a.
    .decl extent(key: Key, a: Axis, n: number)  // @input

    /// The cells of the frame on axis a.
    .decl cell(key: Key, a: Axis, p: Position)
    cell(Ky, A, P) :-
        extent(Ky, A, N), axis_of(D, A),
        K = range(0, N),
        axis_inset(D, K, N-1-K, P).
}

/// 2D frame from per-axis extents — the 1D cells of the two axes perp-glued
/// into full 2D positions. A square frame spreads one extent over axis_elem.
.comp Frame2D<Key> {
    /// The frame's extent on axis a.
    .decl extent(key: Key, a: Axis, n: number)  // @input

    /// The cells of the frame.
    .decl cell(key: Key, p: Position)

    .init _ax = AxisFrame<Key>
    _ax.extent(Ky, A, N) :- extent(Ky, A, N).

    cell(Ky, P) :-
        perp(A1, A2), _ax.cell(Ky, A1, P1), _ax.cell(Ky, A2, P2),
        compose(P1, P2, P).
}

/// A Box packed from per-Dir scalars: the inverse read of dist. A caller with
/// an edge of no width writes that edge's zero row.
.comp DirPack<Key> {
    /// The packed box's margin on side d.
    .decl edge(key: Key, d: Dir, k: number)  // @input

    /// The box from one axis's two margins, the perpendicular zeroed.
    .decl axis_pos(key: Key, a: Axis, p: Box)
    axis_pos(Ky, A, P) :-
        axis_of(D, A), opposite(D, O),
        edge(Ky, D, K1), edge(Ky, O, K2),
        axis_inset(D, K1, K2, P).

    /// The packed box.
    .decl box(key: Key, b: Box)
    box(Ky, B) :-
        perp(A1, A2), axis_pos(Ky, A1, B1), axis_pos(Ky, A2, B2),
        compose(B1, B2, B).
}
