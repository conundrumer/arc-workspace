//! Components whose signature holds no Box, Position, Offset, or orientation
//! type, and that read an order among the values of their input, or follow a
//! relation among them in its direction, from one value to the next.

/// The dense rank of each number of a sparse set.
.comp Ordinal<Key> {
    /// The numbers to rank.
    .decl idx_set(key: Key, k: number)  // @input

    // Each number ordered by itself as its score.
    .init _order = Order<Key, number>
    _order.elem(Ky, K) :- idx_set(Ky, K).
    _order.score(Ky, K, K) :- idx_set(Ky, K).

    /// r = the count of the key's elements strictly less than k, so ranks run
    /// ascending from 0.
    .decl rank(key: Key, k: number, r: number)
    rank(Ky, K, R) :- _order.rank(Ky, K, R).

    /// The same count, strictly greater.
    .decl rank_desc(key: Key, k: number, r: number)
    rank_desc(Ky, K, R) :- _order.rank_desc(Ky, K, R).
}

/// The highest and the lowest score of each key's candidate set.
.comp Extremes<Key> {
    .decl cand(key: Key, s: number)  // @input

    .init _arg = ArgExtremes<Key, Unit>
    _arg.cand(Ky, $U(), S) :- cand(Ky, S).

    .decl high(key: Key, s: number)
    high(Ky, S) :- _arg.high(Ky, _, S).

    .decl low(key: Key, s: number)
    low(Ky, S) :- _arg.low(Ky, _, S).
}

/// The rows that hold each key's highest and lowest score. Ties keep every
/// row at that score.
.comp ArgExtremes<Key, Val> {
    .decl cand(key: Key, v: Val, s: number)  // @input

    .decl high(key: Key, v: Val, s: number)
    high(Ky, V, S) :- cand(Ky, V, S).
    high(Ky, V, S) <= high(Ky, _, S2) :- S < S2.

    .decl low(key: Key, v: Val, s: number)
    low(Ky, V, S) :- cand(Ky, V, S).
    low(Ky, V, S) <= low(Ky, _, S2) :- S > S2.
}

/// Ranking over members of any type, in one of two forms at each key. The
/// rank of t counts the members before it, ascending from 0.
///
/// - The `before` form, at a key with no `score` row: the caller supplies
///   the strict order. `before` is read over `elem`, and a row with an
///   endpoint outside `elem` is ignored.
/// - The score form, at a key with a `score` row: members compare by
///   `score`, and within a tie of `score` by `secondary_score`. A member
///   with a score and no `secondary_score` row precedes each member of its
///   score that has one. Members that tie on both share a rank. A member
///   with no score is related to no other member, and its
///   `secondary_score` row is read nowhere.
///
/// Requires: `before` is transitive; it is never closed, so a `before` that
/// holds direct comparisons alone yields predecessor counts, not ranks.
///
/// Requires: each member has at most one `score` row and at most one
/// `secondary_score` row, and a key gives `before` rows or `score` rows,
/// not both. A member with two such rows takes a rank under each, and a
/// key with both takes the score form, with `first` and `last` cut by
/// `before`.
.comp Order<Key, T> {
    .decl elem(key: Key, t: T)  // @input
    .decl before(key: Key, a: T, b: T)  // @input

    /// A number that orders the members.
    .decl score(key: Key, t: T, s: number)  // @input

    /// A number that orders the members within each tie of `score`.
    .decl secondary_score(key: Key, t: T, s: number)  // @input

    // A key of the score form.
    .decl _scored_key(key: Key)
    _scored_key(Ky) :- score(Ky, _, _).

    // A before row both of whose endpoints are members.
    .decl _edge(key: Key, a: T, b: T)
    _edge(Ky, A, B) :- before(Ky, A, B), elem(Ky, A), elem(Ky, B).

    // A member with score s and no secondary score.
    .decl _plain(key: Key, t: T, s: number)
    _plain(Ky, T, S) :- elem(Ky, T), score(Ky, T, S), !secondary_score(Ky, T, _).

    // A member with score s and secondary score s2.
    .decl _paired(key: Key, t: T, s: number, s2: number)
    _paired(Ky, T, S, S2) :- elem(Ky, T), score(Ky, T, S), secondary_score(Ky, T, S2).

    // A member with score s.
    .decl _scored(key: Key, t: T, s: number)
    _scored(Ky, T, S) :- _plain(Ky, T, S).
    _scored(Ky, T, S) :- _paired(Ky, T, S, _).

    // The count of the key's scored members.
    .decl _total(key: Key, n: number)
    _total(Ky, N) :- _scored_key(Ky), N = count : { _scored(Ky, _, _) }.

    // A scored member's rank, the count of the scored members before it,
    // and the count of the members it ties with on both scores, itself included.
    .decl _rank(key: Key, t: T, below: number, tie: number)
    _rank(Ky, T, R, N) :-
        _plain(Ky, T, S),
        R = count : { _scored(Ky, _, S1), S1 < S },
        N = count : { _plain(Ky, _, S) }.
    _rank(Ky, T, R1 + R2 + R3, N) :-
        _paired(Ky, T, S, S2),
        R1 = count : { _scored(Ky, _, S1), S1 < S },
        R2 = count : { _plain(Ky, _, S) },
        R3 = count : { _paired(Ky, _, S, S3), S3 < S2 },
        N = count : { _paired(Ky, _, S, S2) }.

    // A member of a score-form key with no score.
    .decl _unscored(key: Key, t: T)
    _unscored(Ky, T) :- elem(Ky, T), _scored_key(Ky), !_scored(Ky, T, _).

    .decl rank(key: Key, t: T, r: number)
    rank(Ky, T, R) :- elem(Ky, T), !_scored_key(Ky), R = count : { _edge(Ky, A, T) }.
    rank(Ky, T, R) :- _rank(Ky, T, R, _).
    rank(Ky, T, 0) :- _unscored(Ky, T).

    /// The same count, over the members after t.
    .decl rank_desc(key: Key, t: T, r: number)
    rank_desc(Ky, T, R) :- elem(Ky, T), !_scored_key(Ky), R = count : { _edge(Ky, T, B) }.
    rank_desc(Ky, T, M - R - N) :- _rank(Ky, T, R, N), _total(Ky, M).
    rank_desc(Ky, T, 0) :- _unscored(Ky, T).

    /// The element nothing precedes.
    .decl first(key: Key, t: T)
    first(Ky, T) :- elem(Ky, T), !_scored_key(Ky).
    first(Ky, T) <= first(Ky, T2) :- before(Ky, T2, T).
    first(Ky, T) :- _scored_key(Ky), rank(Ky, T, 0).

    /// The element nothing follows.
    .decl last(key: Key, t: T)
    last(Ky, T) :- elem(Ky, T), !_scored_key(Ky).
    last(Ky, T) <= last(Ky, T2) :- before(Ky, T, T2).
    last(Ky, T) :- _scored_key(Ky), rank_desc(Ky, T, 0).

    // Some element lies between a and b.
    .decl _skipped(key: Key, a: T, b: T)
    _skipped(Ky, A, B) :- _edge(Ky, A, X), _edge(Ky, X, B).

    /// b directly follows a: before, with nothing between. In the score
    /// form, b's rank is the next rank in use after a's.
    .decl next(key: Key, a: T, b: T)
    next(Ky, A, B) :- _edge(Ky, A, B), !_skipped(Ky, A, B), !_scored_key(Ky).
    next(Ky, A, B) :- _rank(Ky, A, R, N), _rank(Ky, B, R + N, _).
}

/// The fewest-hop distance from a seed set over a supplied edge relation,
/// with the edges a fewest-hop walk uses.
.comp GraphDistance<Key, Node> {
    /// The directed edges.
    .decl edge(key: Key, a: Node, b: Node)  // @input

    /// The nodes at distance 0.
    .decl seed(key: Key, n: Node)  // @input

    // A hop count some walk from a seed reaches n with.
    .decl _hops(key: Key, n: Node, k: number)
    _hops(Ky, N, 0) :- seed(Ky, N).
    _hops(Ky, B, K + 1) :- _least.low([Ky, A], K), edge(Ky, A, B).

    .type _KN = [key: Key, n: Node]

    .init _least = Extremes<_KN>
    _least.cand([Ky, N], K) :- _hops(Ky, N, K).

    /// The fewest edges from a seed to n.
    .decl distance(key: Key, n: Node, k: number)
    distance(Ky, N, K) :- _least.low([Ky, N], K).

    /// a is a fewest-hop predecessor of b: an edge some fewest-hop walk uses.
    /// Tied walks all appear.
    .decl pred(key: Key, b: Node, a: Node)
    pred(Ky, B, A) :- edge(Ky, A, B), distance(Ky, A, K), distance(Ky, B, K + 1).
}

/// Forward chaining: the nodes reachable from the sources through `edge`
/// and `join` rows.
.comp Propagation<Key, Node> {  // @construction
    /// The nodes reached at the start.
    .decl source(key: Key, n: Node)  // @input

    /// b is reached once a is.
    .decl edge(key: Key, a: Node, b: Node)  // @input

    /// c is reached once a and b both are.
    .decl join(key: Key, a: Node, b: Node, c: Node)  // @input

    .decl reached(key: Key, n: Node)
    reached(Ky, N) :- source(Ky, N).
    reached(Ky, B) :- edge(Ky, A, B), reached(Ky, A).
    reached(Ky, C) :- join(Ky, A, B, C), reached(Ky, A), reached(Ky, B).
}

/// Z/N successor over a dense 0-based index set: increment, with the max
/// wrapping to 0.
.comp IndexCycle<Key> {
    .decl idx(key: Key, k: number)  // @input

    .decl succ(key: Key, k: number, k2: number)
    succ(Ky, K, K+1) :- idx(Ky, K), idx(Ky, K+1).
    succ(Ky, K, 0)   :- idx(Ky, K), !idx(Ky, K+1).   // wrap from the max
}

/// The member a count of steps around a directed cycle reaches from each
/// member. The cycle has no basepoint, and its members may be of any type.
.comp CycleWalk<Key, T> {
    /// The cycle's edges.
    .decl succ(key: Key, p: T, p_next: T)  // @input

    /// The advance counts in use.
    .decl step(key: Key, n: number)  // @input

    // Downward closure of step — the walk's recursion bound.
    .decl _bound(key: Key, n: number)
    _bound(Ky, N) :- step(Ky, M), N = range(0, M+1).

    /// p = p0 advanced n steps along succ.
    .decl walk(key: Key, p0: T, n: number, p: T)
    walk(Ky, P0, 0, P0) :- succ(Ky, P0, _).
    walk(Ky, P0, N1, P2) :-
        walk(Ky, P0, N, P1), succ(Ky, P1, P2),
        _bound(Ky, N1), N1 = N + 1.      // N1 is the Z/n step count
}

/// The items taken so far and the items left, at each state of a walk. At a
/// state two branches of the walk reach, an item taken on one branch and
/// left untaken on the other is in both `taken` and `untaken`. `step`,
/// `skip` and `take` may be recursive with `taken`, `untaken` and
/// `excluded`.
///
/// Requires: at each t a `step` leaves, `take` gives an item; a `step` with
/// no `take` item empties the untaken side.
///
/// Requires: at each t, `take` gives at most one item; two `take` items at
/// one t both join the taken side and both stay on the untaken side.
///
/// Requires: the `take` item at t is in `untaken` at t; a `take` item not in
/// `untaken` joins the taken side while the untaken side keeps its items,
/// less the items `conflict` gives for it.
///
/// Requires: with `score`, each t has one predecessor; at a t two
/// predecessors reach, `take` may also hold an item above the least score.
.comp Take<Key, T, Item> {
    .decl start(key: Key, t: T)               // @input

    /// The taken side before the first step.
    .decl init_taken(key: Key, item: Item)    // @input

    /// The untaken side before the first step.
    .decl init_untaken(key: Key, item: Item)  // @input

    /// When item is taken, item2 leaves the untaken side without joining
    /// the taken side.
    .decl conflict(key: Key, item: Item, item2: Item)  // @input

    /// Where a caller gives it, `take` holds each `pick` item.
    .decl score(key: Key, t: T, item: Item, s: number)  // @input

    /// A step from t to t2: the item `take` gives at t leaves the untaken
    /// side and joins the taken side.
    .decl step(key: Key, t: T, t2: T)         // @input

    /// A step from t to t2 at which both sides keep their items.
    .decl skip(key: Key, t: T, t2: T)         // @input

    .decl take(key: Key, t: T, item: Item)    // @input
    take(Ky, T, X) :- pick(Ky, T, X, _).

    /// The untaken items of least score at t.
    .decl pick(key: Key, t: T, item: Item, s: number)
    pick(Ky, T, X, S) :- untaken(Ky, T, X), score(Ky, T, X, S).
    pick(Ky, T, X, S) <= pick(Ky, T, _, S2) :- S > S2.

    .decl taken(key: Key, t: T, item: Item)
    taken(Ky, T, X) :- start(Ky, T), init_taken(Ky, X).
    taken(Ky, T2, X) :- step(Ky, T, T2), ( taken(Ky, T, X) ; take(Ky, T, X) ).
    taken(Ky, T2, X) :- skip(Ky, T, T2), taken(Ky, T, X).

    .decl untaken(key: Key, t: T, item: Item)
    untaken(Ky, T, X) :- start(Ky, T), init_untaken(Ky, X).
    untaken(Ky, T2, X) :-
        step(Ky, T, T2), take(Ky, T, Y), untaken(Ky, T, X), X != Y, !conflict(Ky, Y, X).
    untaken(Ky, T2, X) :- skip(Ky, T, T2), untaken(Ky, T, X).

    /// The items `conflict` removed up to t.
    .decl excluded(key: Key, t: T, item: Item)
    excluded(Ky, T2, X) :-
        step(Ky, T, T2), take(Ky, T, Y), conflict(Ky, Y, X), X != Y, untaken(Ky, T, X).
    excluded(Ky, T2, X) :- ( step(Ky, T, T2) ; skip(Ky, T, T2) ), excluded(Ky, T, X).
}
