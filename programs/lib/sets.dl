//! Components over keyed sets: a component belongs here if its signature holds
//! no Box, Position, Offset, or orientation type, and its inputs are keyed sets
//! with no order, no step, and no conflict among them.

/// The size of each key's member set.
.comp Tally<Key, Member> {
    .decl item(key: Key, m: Member)  // @input

    /// The keys to count over. A key with no member counts 0.
    .decl domain(key: Key)  // @input

    .decl tally(key: Key, n: number)
    tally(Ky, N) :- item(Ky, _), N = count : { item(Ky, M) }.
    tally(Ky, 0) :- domain(Ky), !item(Ky, _).
}

/// The amount by which the plus set outnumbers the minus set. A tie or a
/// deficit gives no tuple.
.comp Excess<Key, Member> {
    .decl plus(key: Key, m: Member)  // @input
    .decl minus(key: Key, m: Member)  // @input

    // The keys of the plus set, so each count runs once per key.
    .decl _key(key: Key)
    _key(Ky) :- plus(Ky, _).

    /// The count of the plus set minus the count of the minus set.
    .decl excess(key: Key, n: number)
    excess(Ky, N) :-
        _key(Ky),
        Np = count : { plus(Ky, M1) }, Nn = count : { minus(Ky, M2) },
        Np > Nn, N = Np - Nn.
}

/// The commonest member of each key's set. The token column supplies
/// multiplicity: a member counts once per token. Ties keep every member at
/// the highest count.
.comp Mode<Key, Member, Token> {
    .decl item(key: Key, m: Member, t: Token)  // @input

    .decl tally(key: Key, m: Member, n: number)
    tally(Ky, M, N) :- item(Ky, M, _), N = count : { item(Ky, M, T) }.

    .decl mode(key: Key, m: Member)
    mode(Ky, M) :- tally(Ky, M, N), N = max N2 : { tally(Ky, _, N2) }.
}

/// The one value of each key's member set, absent when the members disagree.
.comp Unanimous<Key, Val> {
    .decl item(key: Key, v: Val)  // @input

    .decl clash(key: Key)
    clash(Ky) :- item(Ky, V1), item(Ky, V2), V1 != V2.

    .decl value(key: Key, v: Val)
    value(Ky, V) :- item(Ky, V), !clash(Ky).
}

/// The highest and the lowest score of each key's candidate set.
.comp Extremes<Key> {
    .decl cand(key: Key, s: number)  // @input

    .decl high(key: Key, s: number)
    high(Ky, S) :- cand(Ky, S).
    high(Ky, S) <= high(Ky, S2) :- S < S2.

    .decl low(key: Key, s: number)
    low(Ky, S) :- cand(Ky, S).
    low(Ky, S) <= low(Ky, S2) :- S > S2.
}

/// The rows that carry each key's highest and lowest score. Ties keep every
/// row at that score.
.comp ArgExtremes<Key, Val> {
    .decl cand(key: Key, v: Val, s: number)  // @input

    .decl high(key: Key, v: Val, s: number)
    high(Ky, V, S) :- cand(Ky, V, S).
    high(Ky, V, S) <= high(Ky, _, S2) :- S < S2.

    .decl low(key: Key, v: Val, s: number)
    low(Ky, V, S) :- cand(Ky, V, S).
    low(Ky, V, S) <= low(Ky, _, S2) :- S > S2.
}

/// The known sets of a catalog that each observed set contains, and those
/// it equals, compared by count. Member is one type parameter: a record for a
/// member of several fields, a scalar for one field.
.comp KeyedSetCompare<Key, Pat, Member> {
    /// A catalog of known sets, enumerated by `pattern`.
    .decl pattern_member(pattern: Pat, m: Member)  // @input

    /// The observed set at each `observed` key.
    .decl observed_member(observed: Key, m: Member)  // @input

    .decl pattern_size(pattern: Pat, n: number)
    pattern_size(Pat, N) :- pattern_member(Pat, _), N = count : { pattern_member(Pat, M) }.

    /// observed ⊇ pattern: the observed set holds every member of the pattern.
    .decl covers(observed: Key, pattern: Pat)
    covers(Obs, Pat) :-
        observed_member(Obs, _),
        pattern_size(Pat, N),
        N = count : { pattern_member(Pat, M), observed_member(Obs, M) }.

    /// observed == pattern: covers, and the observed set holds no other
    /// member.
    .decl equals(observed: Key, pattern: Pat)
    equals(Obs, Pat) :-
        covers(Obs, Pat),
        pattern_size(Pat, N),
        N = count : { observed_member(Obs, M) }.
}

/// The `Ident` of each value of a domain. The id is stable within a run and
/// carries nothing of the value but its identity.
.comp IdentOf<T> {
    .decl value(v: T)  // @input

    .decl id(v: T, id: Ident)
    id(V, as(ord(V), Ident)) :- value(V).
}

/// One id per class of an equivalence relation. The representative is
/// arbitrary but deterministic.
.comp Canon<T> {  // @construction
    /// The equivalence. Requires: `equiv` is transitive, symmetric, and
    /// holds a self pair for every element of the domain; an element outside
    /// `equiv` gets no id, and a gap in transitivity gives two elements of
    /// one class different ids.
    .decl equiv(a: T, b: T)  // @input

    /// The representative of each element's class; a self-paired row marks a
    /// representative.
    .decl rep(a: T, b: T)
    rep(A, B) :- equiv(A, B).
    rep(A, B) <= rep(A, B2) :- ord(B) > ord(B2).

    .init _ident = IdentOf<T>
    _ident.value(B) :- rep(_, B).

    .decl id(a: T, id: Ident)
    id(A, Id) :- rep(A, B), _ident.id(B, Id).
}

/// The alternatives, the entries of a catalog, whose prediction for the first
/// object of a demonstrated pair holds the second object's value at every
/// index of the second object.
.comp DemonstrationConsistency<Demonstrated, Object, Index, Value> {
    /// Each object's value at each index, total over the object's index set.
    .decl value(o: Object, i: Index, v: Value)  // @input

    /// Each alternative's prediction for each object.
    .decl prediction(c: Demonstrated, o: Object, i: Index, v: Value)  // @input

    /// The demonstrated pairs: o is the pair's input, o2 its output.
    .decl demonstration(o: Object, o2: Object)  // @input

    /// Alternative c's prediction for o differs from o2 at some index of o2.
    .decl counterexample(c: Demonstrated, o: Object, o2: Object)
    counterexample(C, O, O2) :-
        demonstration(O, O2), prediction(C, O, I, V),
        value(O2, I, V2), V != V2.                            // a different value
    counterexample(C, O, O2) :-
        demonstration(O, O2), prediction(C, O, _, _),
        value(O2, I, _), !prediction(C, O, I, _).             // an index left out

    /// Alternative c is consistent with the pair: its prediction for o holds o2.
    .decl consistent(c: Demonstrated, o: Object, o2: Object)
    consistent(C, O, O2) :-
        demonstration(O, O2), prediction(C, O, _, _), !counterexample(C, O, O2).
}
