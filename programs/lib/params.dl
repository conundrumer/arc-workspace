//! The helpers a solver's Params comp instantiates as
//! `.init helpers = ParamsHelpers`. A Params comp cannot reach the rest of
//! the program.

.comp ParamsHelpers {  // @construction
    /// All positions of a frame of the given Dim.
    .decl frame_pos(dim: Dim, p: Position) inline
    frame_pos([V, H], [T, V-1-T, L, H-1-L]) :- T = range(0, V), L = range(0, H).

    /// The decomposition of a position in a tiled frame: the outer position
    /// says which tile, and the inner position says which cell in that tile.
    /// A position on a gap row or column between tiles gives no tuple. The
    /// tiled frame has dim
    ///   (outer.v*inner.v + (outer.v-1)*gap.v,
    ///    outer.h*inner.h + (outer.h-1)*gap.h).
    .decl tile_pos(outer: Dim, inner: Dim, gap: Dim,
                   p: Position, p_outer: Position, p_inner: Position) inline
    tile_pos([Ov, Oh], [Iv, Ih], [Gv, Gh],
             [T, B, L, R],
             [Mt, Ov-1-Mt, Ml, Oh-1-Ml],
             [It, Iv-1-It, Il, Ih-1-Il]) :-
        Mt = range(0, Ov), Ml = range(0, Oh),
        It = range(0, Iv), Il = range(0, Ih),
        T = Mt*(Iv+Gv) + It,
        L = Ml*(Ih+Gh) + Il,
        B = Ov*Iv + (Ov-1)*Gv - 1 - T,
        R = Oh*Ih + (Oh-1)*Gh - 1 - L.
}
