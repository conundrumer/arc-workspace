//! Components with a keyed cell-set input: the caller populates the cells of a
//! set under each key, and the component reports what holds of that set.

/// The frame cut into equal tiles, from a tile count on each axis. The counts
/// may differ between the axes.
.comp Divide2D<Key> {
    .decl cell(p: Position)  // @input
    .decl dim(key: Key, a: Axis, n: number)  // @input
    .decl gap(g: number)  // @input

    .decl tile(key: Key, p: Position, p_outer: Position, p_inner: Position)
    tile(Ky, P, P_outer, P_inner) :-
        cell(P), gap(G),
        perp(A1, A2),
        dim(Ky, A1, N1), divide(P, A1, N1, G, Po1, Pi1),
        dim(Ky, A2, N2), divide(P, A2, N2, G, Po2, Pi2),
        compose(Po1, Po2, P_outer), compose(Pi1, Pi2, P_inner).
}

/// Takes a tile size on each axis, in place of a tile count.
.comp Tile2D<Key> {
    .decl cell(p: Position)  // @input
    .decl dim(key: Key, a: Axis, k: number)  // @input
    .decl gap(g: number)  // @input

    .decl tile(key: Key, p: Position, p_outer: Position, p_inner: Position)
    tile(Ky, P, P_outer, P_inner) :-
        cell(P), gap(G),
        perp(A1, A2),
        dim(Ky, A1, K1), divide_by_size(P, A1, K1, G, Po1, Pi1),
        dim(Ky, A2, K2), divide_by_size(P, A2, K2, G, Po2, Pi2),
        compose(Po1, Po2, P_outer), compose(Pi1, Pi2, P_inner).
}

/// The tiles the dividers drawn in the set cut, which may be unequal: a
/// cell's tile position holds, toward each edge, the count of dividers
/// between the cell and that edge. A divider cell gets no tile, and
/// an axis with no divider is one part.
.comp DividerTiles<Key> {
    /// The cell domain.
    .decl cell(key: Key, p: Position)  // @input

    /// The cutting lines, axis-only on a.
    .decl divider(key: Key, a: Axis, l: Position)  // @input

    /// A divider's distance to edge d.
    .decl div_dist(key: Key, a: Axis, d: Dir, k: number)
    div_dist(K, A, D, K1) :- divider(K, A, L), axis_of(D, A), dist(L, D, K1).

    /// p's line on axis a holds a divider.
    .decl on_divider(key: Key, p: Position, a: Axis)
    on_divider(K, P, A) :- cell(K, P), div_dist(K, A, D, K1), dist(P, D, K1).

    /// p's tile index from edge d — the dividers between p and edge d.
    .decl part_idx(key: Key, p: Position, d: Dir, n: number)
    part_idx(K, P, D, N) :-
        cell(K, P), axis_of(D, A), !on_divider(K, P, A), dist(P, D, K1),
        N = count : { div_dist(K, A, D, K2), K2 < K1 }.

    /// The part of axis a that p sits in, as an axis-only position: p's
    /// tile index from each edge of the axis.
    .decl part_of(key: Key, p: Position, a: Axis, p_part: Position)
    part_of(K, P, A, P_part) :-
        axis_of(D, A), opposite(D, D2),                 // the axis's two dirs
        part_idx(K, P, D, N1), part_idx(K, P, D2, N2),  // index from each
        axis_inset(D, N1, N2, P_part).

    /// p's tile, the parts on both axes glued.
    .decl tile_of(key: Key, p: Position, p_tile: Position)
    tile_of(K, P, P_tile) :-
        part_of(K, P, A, P1), perp(A, A2), part_of(K, P, A2, P2),  // part on each axis
        compose(P1, P2, P_tile).                                   // glued
}

/// A corner diagonal: the full corner-to-corner run of cells equidistant from
/// the corner's two edges, the center included.
.comp Diagonal<Key> {
    /// The cell domain.
    .decl cell(key: Key, p: Position)  // @input

    /// The corner the diagonal runs from.
    .decl corner(key: Key, d: DiagDir)  // @input

    /// A domain cell on the diagonal, at ring — its shared distance to both
    /// edges of the corner.
    .decl diagonal(key: Key, p: Position, ring: number)
    diagonal(Ky, P, K) :- cell(Ky, P), corner(Ky, Diag), diag_dist(P, Diag, _, K, K).
}

/// The quadrant each cell sits in, and its ring there.
.comp DiagPlacement<Key> {
    /// The cell domain.
    .decl cell(key: Key, p: Position)  // @input

    /// Strictly nearer edge d than its opposite — which side of the axis midline.
    .decl nearer(key: Key, p: Position, d: Dir)
    nearer(Ky, P, D) :- cell(Ky, P), dir_elem(D), dist_pair(P, D, K, K2), K < K2.

    /// The diagonal quadrant a cell sits in: nearer on both of that corner's edges.
    .decl quadrant(key: Key, p: Position, diag: DiagDir)
    quadrant(Ky, P, Diag) :- diag_dirs(Diag, _, D1, D2), nearer(Ky, P, D1), nearer(Ky, P, D2).

    /// On the diagonal of its quadrant, at ring — its shared distance to both
    /// edges of that corner.
    .decl diag_cell(key: Key, p: Position, diag: DiagDir, ring: number)
    diag_cell(Ky, P, Diag, K) :- quadrant(Ky, P, Diag), diag_dist(P, Diag, _, K, K).
}

/// The cells in line with a mark toward each of the key's directions, and
/// the first blocked cell on each line. A mark is on its own ray.
/// The cast crosses the whole frame, and the domain decides which cells are
/// reported. Direction columns are Dir8.
.comp Ray<Key> {
    /// The cast directions.
    .decl dir(key: Key, d: Dir8)  // @input

    /// The cell domain tested.
    .decl cell(key: Key, p: Position)  // @input

    /// The casting positions. A mark outside the frame casts into it when
    /// the cast direction leads into the frame.
    .decl mark(key: Key, p: Position)  // @input

    /// Cells a cast cannot enter. A blocked mark still casts.
    .decl blocked(key: Key, p: Position)  // @input

    // Short of the far edge: every edge the cast toward d approaches still
    // lies ahead. A position off the frame across d passes.
    .decl _onward(p: Position, d: Dir8) inline
    _onward(P, D) :- dir_elem(D), dist(P, D, K), K >= 0.
    _onward(P, D) :- diag_dir_elem(D), diag_dist(P, D, _, K1, K2), K1 >= 0, K2 >= 0.

    /// Frame-wide cast: one cell per step from each mark, marks included.
    .decl cast(key: Key, p: Position, d: Dir8, k: number, src: Position)
    cast(Ky, P, D, 0, P) :- mark(Ky, P), dir(Ky, D).
    cast(Ky, P2, D, K+1, Src) :-
        cast(Ky, P, D, K, Src), step_offset(D, S), compose(P, S, P2), _onward(P2, D).

    /// p on a ray cast toward d, k cells from the casting mark src. k = 0 at
    /// the mark itself, and `ray(Ky, P, D, _, _)` is membership alone.
    .decl ray(key: Key, p: Position, d: Dir8, k: number, src: Position)
    ray(Ky, P, D, K, Src) :- cast(Ky, P, D, K, Src), cell(Ky, P).

    /// Frame-wide open prefix: the cast short of its first blocked cell.
    .decl clear_cast(key: Key, p: Position, d: Dir8, k: number, src: Position)
    clear_cast(Ky, P, D, 0, P) :- cast(Ky, P, D, 0, P).
    clear_cast(Ky, P, D, K, Src) :- _ahead(Ky, P, D, K, Src), !blocked(Ky, P).

    // The cast cell after the prefix: it extends the prefix or halts the cast.
    .decl _ahead(key: Key, p: Position, d: Dir8, k: number, src: Position)
    _ahead(Ky, P2, D, K, Src) :-
        clear_cast(Ky, P, D, _, Src), neighbor(P, D, P2), cast(Ky, P2, D, K, Src).

    /// ray halted before its first blocked cell.
    .decl clear(key: Key, p: Position, d: Dir8, k: number, src: Position)
    clear(Ky, P, D, K, Src) :- clear_cast(Ky, P, D, K, Src), cell(Ky, P).

    /// The first blocked cell of each cast, past the mark itself, whether or
    /// not it is in the domain.
    .decl stop(key: Key, p: Position, d: Dir8, k: number, src: Position)
    stop(Ky, P, D, K, Src) :- _ahead(Ky, P, D, K, Src), blocked(Ky, P).
}

/// The cells with a mark on each side along one of the key's axes. A mark is
/// on its own ray, as in Ray.
.comp Between<Key> : Ray<Key> {
    /// The fold axes.
    .decl axis(key: Key, a: Axis4)  // @input

    dir(Ky, D) :- axis(Ky, A), axis4_of(D, A).   // cast both ways

    /// Marks of the key lie on both sides of p, along one of the key's axes.
    .decl between(key: Key, p: Position)
    between(K, P) :-
        axis(K, A), axis4_of(D, A), dir8_opposite(D, O),
        ray(K, P, D, _, _), ray(K, P, O, _, _).
}

/// Where a straight slide from each node toward a direction stops: the last
/// node before the slide would leave the node set.
.comp Slide<Key> {
    /// The nodes: Positions or Offsets.
    .decl node(key: Key, p: Position)  // @input

    /// The run directions.
    .decl dir(key: Key, d: Dir8)  // @input

    /// q is reached from p toward d by steps that stay in the node set.
    .decl run(key: Key, p: Position, d: Dir8, q: Position)
    run(Ky, P, D, Q) :- node(Ky, P), dir(Ky, D), neighbor(P, D, Q), node(Ky, Q).
    run(Ky, P, D, R) :- run(Ky, P, D, Q), neighbor(Q, D, R), node(Ky, R).

    /// No node lies one step from p toward d.
    .decl rim_dir(key: Key, p: Position, d: Dir8)
    rim_dir(Ky, P, D) :- node(Ky, P), dir(Ky, D), neighbor(P, D, Q), !node(Ky, Q).

    /// The far end of a run: one more step would leave the node set.
    .decl halt(key: Key, p: Position, d: Dir8, q: Position)
    halt(Ky, P, D, Q) :- run(Ky, P, D, Q), rim_dir(Ky, Q, D).

    /// The end of the run from p toward d: its halt, or p itself when no
    /// step is possible.
    .decl rest(key: Key, p: Position, d: Dir8, q: Position)
    rest(Ky, P, D, Q) :- halt(Ky, P, D, Q).
    rest(Ky, P, D, P) :- rim_dir(Ky, P, D).
}

/// Where rigid bodies falling together toward one heading come to rest: each
/// body travels the least distance that brings one of its cells against the
/// frame edge, a blocked cell, or a cell of another body at that body's
/// resting place.
.comp Gravity<Key, Body> {
    /// The cells of each body.
    .decl cell(key: Key, b: Body, p: Position)  // @input

    /// The heading every body travels, one per key.
    .decl dir(key: Key, d: Dir)  // @input

    /// Cells no body may enter. Requires: no body cell is blocked; a blocked
    /// body cell stops its own body.
    .decl blocked(key: Key, p: Position)  // @input

    // A cell that can stop a body: blocked, or a body's.
    .decl _contact(key: Key, q: Position)
    _contact(Ky, Q) :- blocked(Ky, Q).
    _contact(Ky, Q) :- cell(Ky, _, Q).

    // A cell of body b lies behind contact cell q in a line along the
    // heading, with k cells between them.
    .decl _gap(key: Key, b: Body, q: Position, k: number)
    _gap(Ky, B, Q, K) :-
        cell(Ky, B, P), _contact(Ky, Q),
        dir(Ky, D), axis_of(D, A), same_line(A, P, Q), nearer(D, Q, P),
        dist(P, D, Kp), dist(Q, D, Kq), K = Kp - Kq - 1.

    .type _KB = [key: Key, b: Body]

    // The travel body b allows to the frame edge: the least over its cells.
    .init _edge = Extremes<_KB>
    _edge.cand([Ky, B], K) :- cell(Ky, B, P), dir(Ky, D), dist(P, D, K).

    // Body b travels at most k: a contact ahead stops it there. A bound past
    // the edge travel adds nothing, so the bounds are finite.
    .decl _bound(key: Key, b: Body, k: number)
    _bound(Ky, B, K) :- _edge.low([Ky, B], K).
    _bound(Ky, B, K) :- _gap(Ky, B, Q, K), blocked(Ky, Q).
    _bound(Ky, B, K) :-
        _gap(Ky, B, Q, G), cell(Ky, B2, Q), B != B2, _bound(Ky, B2, K2),
        K = K2 + G, _edge.low([Ky, B], Ke), K < Ke.

    // The least bound.
    .init _least = Extremes<_KB>
    _least.cand([Ky, B], K) :- _bound(Ky, B, K).

    /// The displacement each body takes: the least travel any of its
    /// contacts allows.
    .decl travel(key: Key, b: Body, v: Offset)
    travel(Ky, B, V) :- _least.low([Ky, B], K), dir(Ky, D), jump_offset(D, K, V).
}

/// The rank of each member along an axis, as its line in a dense frame of one
/// line per member. Members are opaque and may span several lines.
///
/// Requires: each key's member line sets separate cleanly along the axis — no
/// shared line, no interleaving. A pair that mixes breaks the order and
/// doubles `pos`.
.comp OrderFrame<Key, T> {
    /// The axis the frame runs along.
    .decl axis(key: Key, a: Axis)  // @input

    /// Each member's lines, axis-only on the key's axis.
    .decl member(key: Key, m: T, p: Position)  // @input

    /// Member m strictly nearer edge d than member m2 — some line of each.
    .decl nearer(key: Key, d: Dir, m: T, m2: T)
    nearer(Ky, D, M, M2) :-
        member(Ky, M, P), member(Ky, M2, Q), M != M2,
        axis(Ky, A), axis_of(D, A),
        dist(P, D, K1), dist(Q, D, K2), K1 < K2.

    .decl mem(key: Key, m: T)
    mem(Ky, M) :- member(Ky, M, _).

    /// The member's place in the frame: its distance toward each edge is the
    /// count of members nearer that edge.
    .decl pos(key: Key, m: T, p_pos: Position)
    pos(Ky, M, P_pos) :-
        mem(Ky, M), axis(Ky, A), axis_of(D, A), opposite(D, O),
        R1 = count : { nearer(Ky, D, M1, M) },
        R2 = count : { nearer(Ky, O, M2, M) },
        axis_inset(D, R1, R2, P_pos).
}

/// Orders the cells lexicographically: the primary axis first, the corner's
/// other axis breaking a tie. Reading order is the top-left corner with the V
/// axis primary. The relations it shares with `Order` mean what they mean
/// there.
.comp LexOrder<Key> {
    /// The corner the order runs from.
    .decl corner(key: Key, d: DiagDir)  // @input

    /// The primary axis.
    .decl axis(key: Key, a: Axis)  // @input

    /// The cells to order.
    .decl cell(key: Key, p: Position)  // @input

    /// The members: the cells.
    .decl elem(key: Key, t: Position)
    elem(Ky, P) :- cell(Ky, P).

    /// The lexicographic order of the cells, as a strict order.
    .decl before(key: Key, a: Position, b: Position)
    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Ky, Diag), axis(Ky, A), dir_of(Diag, A, D),  // primary dir
        nearer(D, Q, P).                                    // q strictly nearer
    before(Ky, Q, P) :-
        cell(Ky, Q), cell(Ky, P),
        corner(Ky, Diag), axis(Ky, A),
        diag_dirs(Diag, A, D, D2),                   // primary/secondary dirs
        same_dist(D, Q, P),                          // primary tie
        nearer(D2, Q, P).                            // q strictly nearer

    .init _order = Order<Key, Position>
    _order.elem(Ky, P) :- elem(Ky, P).
    _order.before(Ky, Q, P) :- before(Ky, Q, P).

    .decl rank(key: Key, t: Position, r: number)
    rank(Ky, P, R) :- _order.rank(Ky, P, R).

    /// The same count, over the members after t.
    .decl rank_desc(key: Key, t: Position, r: number)
    rank_desc(Ky, P, R) :- _order.rank_desc(Ky, P, R).

    // A cell's distance from edge d.
    .decl _dist(key: Key, p: Position, d: Dir, k: number)
    _dist(Ky, P, D, K) :- cell(Ky, P), dir_elem(D), dist(P, D, K).

    // The least and the greatest distance of a cell from the primary edge.
    .decl _lead(key: Key, diag: DiagDir, a: Axis, k: number)
    _lead(Ky, Diag, A, K) :-
        corner(Ky, Diag), axis(Ky, A), dir_of(Diag, A, D),
        K = min K0 : { _dist(Ky, _, D, K0) }.
    .decl _trail(key: Key, diag: DiagDir, a: Axis, k: number)
    _trail(Ky, Diag, A, K) :-
        corner(Ky, Diag), axis(Ky, A), dir_of(Diag, A, D),
        K = max K0 : { _dist(Ky, _, D, K0) }.

    // Among the cells at that distance, the least and the greatest distance
    // from the secondary edge.
    .decl _lead2(key: Key, diag: DiagDir, a: Axis, k: number, k2: number)
    _lead2(Ky, Diag, A, K, K2) :-
        _lead(Ky, Diag, A, K), diag_dirs(Diag, A, D, D2),
        K2 = min K0 : { _dist(Ky, Q, D, K), _dist(Ky, Q, D2, K0) }.
    .decl _trail2(key: Key, diag: DiagDir, a: Axis, k: number, k2: number)
    _trail2(Ky, Diag, A, K, K2) :-
        _trail(Ky, Diag, A, K), diag_dirs(Diag, A, D, D2),
        K2 = max K0 : { _dist(Ky, Q, D, K), _dist(Ky, Q, D2, K0) }.

    // Some cell comes before p in the lexicographic order.
    .decl _preceded(key: Key, p: Position)
    _preceded(Ky, P) :-
        _lead(Ky, Diag, A, K), dir_of(Diag, A, D),
        _dist(Ky, P, D, K1), K1 > K.
    _preceded(Ky, P) :-
        _lead2(Ky, Diag, A, K, K2), diag_dirs(Diag, A, D, D2),
        _dist(Ky, P, D, K), _dist(Ky, P, D2, K1), K1 > K2.

    // Some cell comes after p in the lexicographic order.
    .decl _followed(key: Key, p: Position)
    _followed(Ky, P) :-
        _trail(Ky, Diag, A, K), dir_of(Diag, A, D),
        _dist(Ky, P, D, K1), K1 < K.
    _followed(Ky, P) :-
        _trail2(Ky, Diag, A, K, K2), diag_dirs(Diag, A, D, D2),
        _dist(Ky, P, D, K), _dist(Ky, P, D2, K1), K1 < K2.

    /// The element nothing precedes.
    .decl first(key: Key, t: Position)
    first(Ky, P) :- elem(Ky, P), !_preceded(Ky, P).

    /// The element nothing follows.
    .decl last(key: Key, t: Position)
    last(Ky, P) :- elem(Ky, P), !_followed(Ky, P).

    /// b directly follows a: before, with nothing between.
    .decl next(key: Key, a: Position, b: Position)
    next(Ky, Q, P) :- _order.next(Ky, Q, P).
}

/// Bounding box of a box set: the pointwise minimum over the set, the least
/// margin from each edge.
.comp Bbox<Key> {
    /// The set the box bounds.
    .decl cell(key: Key, p: Box)  // @input

    .decl _cell_dist(key: Key, d: Dir, k: number)
    _cell_dist(K, D, Kd) :- cell(K, P), dir_elem(D), dist(P, D, Kd).

    .decl _edge_min(key: Key, d: Dir, m: number)
    _edge_min(K, D, M) :- _cell_dist(K, D, _), M = min Kd : { _cell_dist(K, D, Kd) }.

    .init _pack = DirPack<Key>
    _pack.edge(K, D, M) :- _edge_min(K, D, M).

    .decl box(key: Key, b: Box)
    box(K, B) :- _pack.box(K, B).
}

/// The rectangle outlines drawn inside a node set, each reported as the box
/// its corners bound. An outline spans at least two cells on each axis.
.comp Outlines<Key> {
    /// The set the outlines are drawn in.
    .decl node(key: Key, p: Position)  // @input

    .init _run = Slide<Key>
    _run.node(K, P) :- node(K, P).
    _run.dir(K, D) :- node(K, _), dir_elem(D).

    // A corner pair whose four runs close a rectangle.
    .decl _ring(key: Key, c1: Position, c4: Position)
    _ring(K, C1, C4) :-
        _run.run(K, C1, D1, C2), _run.run(K, C1, D2, C3),  // two sides from one corner
        perp_dir(D1, D2),                                // at right angles
        _run.run(K, C2, D2, C4), _run.run(K, C3, D1, C4).  // and back to the far corner

    .type _KR = [key: Key, c1: Position, c4: Position]

    .init _box = Bbox<_KR>
    _box.cell([K, C1, C4], C) :- _ring(K, C1, C4), ( C = C1 ; C = C4 ).

    .decl box(key: Key, b: Box)
    box(K, B) :- _box.box([K, _, _], B).
}

/// Connected components of a node set (4-adjacency), each labeled by an opaque
/// id. The id is stable within a run and carries no geometry. The key does
/// not enter the id, so ids separate components under different keys only
/// where their node sets are disjoint.
.comp Components<Key> {
    .decl node(key: Key, p: Position)  // @input

    /// The steps that join nodes: the cardinals, and any a caller adds.
    .decl step(delta: Offset)  // @input
    step([-1, 1, 0, 0]). step([1, -1, 0, 0]). step([0, 0, -1, 1]). step([0, 0, 1, -1]).

    .init _ident = IdentOf<Position>
    _ident.value(P) :- node(_, P).

    /// The id of the component p belongs to.
    .decl label(key: Key, p: Position, id: Ident)
    label(Ky, P, Id) :- node(Ky, P), _ident.id(P, Id).
    label(Ky, Q, Id) :- label(Ky, P, Id), step(D), compose(P, D, Q), node(Ky, Q).
    label(Ky, P, Id) <= label(Ky, P, Id2) :- Id2 < Id.

    .decl conn(key: Key, p: Position, q: Position)
    conn(Ky, P, Q) :- label(Ky, P, Id), label(Ky, Q, Id).
}

/// Joins the diagonal neighbors as well, so a corner contact keeps one
/// component.
.comp Components8<Key> : Components<Key> {
    step(S) :- dir8_elem(D), step_offset(D, S).
}

/// The union of the components that hold a seed. A seed outside the node set
/// selects nothing.
.comp Reach<Key> : Components<Key> {
    .decl seed(key: Key, p: Position)  // @input

    // reach floods from the seeds and does not derive conn.
    .decl reach(key: Key, p: Position)
    reach(Ky, P) :- seed(Ky, P), node(Ky, P).
    reach(Ky, Q) :- reach(Ky, P), step(D), compose(P, D, Q), node(Ky, Q).
}

/// The concentric layers of a cell set, from its boundary inward. The rim is
/// the cells with a neighbor outside the set, off-frame counting as outside;
/// depth runs inward from the rim, one per step. Neighbors are the four
/// cardinals.
.comp Rim<Key> {
    .decl cell(key: Key, p: Position)  // @input

    .decl _dir(d: Dir8)
    _dir(D) :- dir_elem(D).

    /// The outside lies one step toward d.
    .decl rim_dir(key: Key, p: Position, d: Dir8)
    rim_dir(Ky, P, D) :- cell(Ky, P), _dir(D), neighbor(P, D, Q), !cell(Ky, Q).

    .decl rim(key: Key, p: Position)
    rim(Ky, P) :- rim_dir(Ky, P, _).

    /// The shortest inward walk from the rim.
    .decl depth(key: Key, p: Position, k: number)
    depth(Ky, P, 0) :- rim(Ky, P).
    depth(Ky, P, K2) :-
        depth(Ky, Q, K), K2 = K + 1,
        _dir(D), neighbor(Q, D, P), cell(Ky, P).
    depth(Ky, P, K) <= depth(Ky, P, K2) :- K2 < K.
}

/// Counts the diagonal neighbors as well, so a cell that meets the outside at
/// a corner alone is rim.
.comp Rim8<Key> : Rim<Key> {
    _dir(D) :- dir8_elem(D).
}

/// The parts of a cell set that no walk through the set reaches from the
/// frame edge: each connected part under its own id.
.comp Closed<Key> {
    .decl cell(key: Key, p: Position)  // @input

    // The edge-connected part of the set.
    .init _flood = Reach<Key>
    _flood.node(Ky, P) :- cell(Ky, P).
    _flood.seed(Ky, P) :- cell(Ky, P), dir_elem(D), dist(P, D, 0).

    // Components of the closed cells.
    .init _regions = Components<Key>
    _regions.node(Ky, P) :- cell(Ky, P), !_flood.reach(Ky, P).

    .decl region(key: Key, p: Position, id: Ident)
    region(Ky, P, Id) :- _regions.label(Ky, P, Id).
}

/// The D4 ops that take one valued cell set onto another. The outputs treat
/// a missing image cell in two ways: `mismatch`/`map` read it as difference,
/// so `dst` must be total over each key's domain; `conflict`/`compatible`
/// compare only where both cells exist, so a partial dst keeps its ops. With
/// dst = src the maps are the set's symmetries.
.comp D4Map<Key, Val> {
    .decl src(key: Key, p: Position, v: Val)  // @input
    .decl dst(key: Key, p: Position, v: Val)  // @input

    /// A violated op: some src cell whose image under d holds a different dst
    /// value.
    .decl mismatch(key: Key, d: D4)
    mismatch(K, D) :- src(K, P, V), d4_elem(D), apply(D, P, P2), !dst(K, P2, V).

    /// The ops that hold — the negation of mismatch.
    .decl map(key: Key, d: D4)
    map(K, D) :- src(K, _, _), d4_elem(D), !mismatch(K, D).

    /// A contradicted op: some src cell whose image holds a different dst
    /// value where both cells exist.
    .decl conflict(key: Key, d: D4)
    conflict(K, D) :- src(K, P, V), d4_elem(D), apply(D, P, P2), dst(K, P2, V2), V2 != V.

    /// The ops dst never contradicts — the negation of conflict.
    .decl compatible(key: Key, d: D4)
    compatible(K, D) :- src(K, _, _), d4_elem(D), !conflict(K, D).

    /// Invariance under some nontrivial element — the dst = src reading.
    .decl has_sym(key: Key)
    has_sym(K) :- map(K, D), D != D4_ID.
}

/// Translation invariance of a valued cell set: which axis-aligned
/// translations fix the set. Absence is silent: an image off the frame tests
/// nothing, so a translation is compared only where both cells exist. Two
/// readings: `mismatch` is exact; `period` reads through sparse damage.
.comp OffsetInvariance<Key, Val> {
    .decl cell(key: Key, p: Position, v: Val)  // @input

    // Internal keys tag a candidate translation; members are its line pairs.
    .type _SK = [key: Key, a: Axis, k: number]
    .type _LP = [l: Position, l2: Position]

    /// Candidate translations: every axis-aligned one the frame admits, tagged
    /// (axis, k), with both directions of a magnitude sharing a tag.
    .decl cand(key: Key, a: Axis, k: number, delta: Offset)
    cand(Ky, A, K, Delta) :-
        cell(Ky, P, _),
        axis_of(D, A), sub_extent(P, A, K),
        jump_offset(D, K, Delta).

    // One translation per magnitude: the other direction pairs the same cells
    // transposed, so the readouts rebuild symmetric rows by transpose. The
    // corner picked is unobservable.
    .decl _cand(key: Key, a: Axis, k: number, delta: Offset)
    _cand(Ky, A, K, Delta) :-
        cell(Ky, P, _),
        dir_of(DIAG_BR, A, D), sub_extent(P, A, K),
        jump_offset(D, K, Delta).

    .decl _pair(key: Key, a: Axis, k: number, p: Position, q: Position)
    _pair(Ky, A, K, P, Q) :-
        cell(Ky, P, _), _cand(Ky, A, K, Delta), compose(P, Delta, Q), cell(Ky, Q, _).

    /// A candidate translation's cell pairings: q is p's image, both in the set.
    .decl pair(key: Key, a: Axis, k: number, p: Position, q: Position)
    pair(Ky, A, K, P, Q) :- _pair(Ky, A, K, P, Q).
    pair(Ky, A, K, Q, P) :- _pair(Ky, A, K, P, Q).

    /// A violated translation: some cell whose image holds a different value.
    .decl mismatch(key: Key, a: Axis, k: number)
    mismatch(Ky, A, K) :-
        _pair(Ky, A, K, P, Q), cell(Ky, P, V), cell(Ky, Q, V2), V != V2.

    .decl _line_mismatch(key: Key, a: Axis, k: number, l: Position, l2: Position)
    _line_mismatch(Ky, A, K, L, L2) :-
        _pair(Ky, A, K, P, Q), cell(Ky, P, V), cell(Ky, Q, V2), V != V2,
        split(P, A, L, _), split(Q, A, L2, _).

    /// A broken line pair: the translation carries some cell of the line at l
    /// onto a differently-valued cell of the line at l2.
    .decl line_mismatch(key: Key, a: Axis, k: number, l: Position, l2: Position)
    line_mismatch(Ky, A, K, L, L2) :- _line_mismatch(Ky, A, K, L, L2).
    line_mismatch(Ky, A, K, L2, L) :- _line_mismatch(Ky, A, K, L, L2).

    // Broken line pairs against whole ones.
    .init _breaks = Excess<_SK, _LP>
    _breaks.plus([Ky, A, K], [L, L2]) :- _line_mismatch(Ky, A, K, L, L2).
    _breaks.minus([Ky, A, K], [L, L2]) :-
        _pair(Ky, A, K, P, Q), split(P, A, L, _), split(Q, A, L2, _),
        !_line_mismatch(Ky, A, K, L, L2).

    /// A period of the set's pattern, read through damage: broken line
    /// pairs do not outnumber whole ones. Every multiple of a period is a
    /// period, and a pair-less candidate is vacuously one.
    .decl period(key: Key, a: Axis, k: number)
    period(Ky, A, K) :- cand(Ky, A, K, _), !_breaks.excess([Ky, A, K], _).

    /// The exact reading's minimum: the shortest witnessed translation no cell
    /// pair contradicts, per axis.
    .decl min_period(key: Key, a: Axis, k: number)
    min_period(Ky, A, K) :- _pair(Ky, A, K, _, _), !mismatch(Ky, A, K).
    min_period(Ky, A, K) <= min_period(Ky, A, K2) :- K > K2.
}

/// The isometries of a valued cell set interpreted as a periodic pattern,
/// each taken with every translation of its lattice: a candidate is a D4
/// transform composed with each shift of one coset of the lattice, the
/// translations by a multiple of the period on each axis that has a
/// `period` row, and by none on an axis that has none. A candidate is a
/// symmetry when its shifts together take some cell onto another cell and
/// none of them takes a cell onto a cell of another value.
.comp Wallpaper<Key, Val> {
    /// The candidates include those whose transform is d.
    .decl transform(d: D4)  // @input

    /// The cell at p holds v.
    .decl cell(key: Key, p: Position, v: Val)  // @input

    /// p is a position of the frame.
    .decl grid(key: Key, p: Position)  // @input

    /// k is the pattern's translation period along axis a, one per axis. An
    /// axis with no row has no period.
    .decl period(key: Key, a: Axis, k: number)  // @input

    // delta is a shift along axis a that stands for one coset of the
    // lattice on that axis: zero, or, on an axis with a period, less than
    // one period toward the bottom or right edge. The output takes every
    // shift of the coset, so it does not depend on this choice.
    .decl _dom_ax(key: Key, a: Axis, delta: Offset)
    _dom_ax(Key, A, Delta) :-
        grid(Key, P), axis_elem(A),
        ( Delta = ZERO
        ; sub_extent(P, A, K), period(Key, A, Kp), K < Kp,
          dir_of(DIAG_BR, A, D), jump_offset(D, K, Delta)
        ).

    // delta stands for one coset of the lattice.
    .decl _dom(key: Key, delta: Offset)
    _dom(Key, Delta) :-
        _dom_ax(Key, A, D1), _dom_ax(Key, A2, D2), perp(A, A2),
        compose(D1, D2, Delta).

    // The translation s lies in the lattice along axis a: its component on
    // a is a multiple of the period there, or zero where a has none.
    .decl _lat_ax(key: Key, a: Axis, s: Offset) inline
    _lat_ax(Key, A, S) :-
        axis_of(D, A), dist(S, D, K),
        ( period(Key, A, Kp), K % Kp = 0
        ; !period(Key, A, _), K = 0
        ).

    // Transform d followed by the coset of shift delta is a candidate
    // isometry. Where d is its own inverse, the candidate squares to the
    // translations of one coset, which holds the lattice exactly where the
    // square of delta lies in it. Where that square lies along an axis, it
    // must lie in the lattice; where it lies off both axes, the periods do
    // not determine whether the lattice holds it, and the cell tests decide.
    .decl _cand(key: Key, d: D4, delta: Offset)
    _cand(Key, D, Delta) :-
        transform(D), _dom(Key, Delta),
        ( !d4_inverse(D, D)
        ; d4_inverse(D, D),
          apply(D, Delta, DD), compose(Delta, DD, S),
          ( axis_elem(A), perp(A, A2), _lat_ax(Key, A, S), _lat_ax(Key, A2, S)
          ; axis_elem(A), split(S, A, Along, Across),
            Along != ZERO, Across != ZERO
          )
        ).

    // The candidate (d, delta) takes the frame position p onto x, a box of
    // p's extent that may lie off the frame.
    .decl _image(key: Key, d: D4, delta: Offset, p: Position, x: Box)
    _image(Key, D, Delta, P, X) :-
        _cand(Key, D, Delta), grid(Key, P), apply(D, P, P1),
        compose(P1, Delta, X).

    // The class of x under the lattice: on each axis, the margin from the
    // top or left edge modulo the period where the axis has one, and the
    // margin itself where it has none, with the margins' sum. Two boxes are
    // in one class exactly where a translation of the lattice takes one onto
    // the other.
    .decl _class(key: Key, x: Box, rv: number, sv: number, rh: number,
                 sh: number)
    _class(Key, X, Rv, T + B, Rh, L + R) :-
        ( grid(Key, X) ; _image(Key, _, _, _, X) ),
        X = [T, B, L, R],
        ( period(Key, AXIS_V, Kv), Rv = ((T % Kv) + Kv) % Kv
        ; !period(Key, AXIS_V, _), Rv = T
        ),
        ( period(Key, AXIS_H, Kh), Rh = ((L % Kh) + Kh) % Kh
        ; !period(Key, AXIS_H, _), Rh = L
        ).

    // The candidate (d, delta) takes the frame position p into the lattice
    // class (rv, sv, rh, sh).
    .decl _image_class(key: Key, d: D4, delta: Offset, p: Position, rv: number,
                       sv: number, rh: number, sh: number) inline
    _image_class(Key, D, Delta, P, Rv, Sv, Rh, Sh) :-
        _image(Key, D, Delta, P, X), _class(Key, X, Rv, Sv, Rh, Sh).

    // Some shift of the coset of the candidate (d, delta) takes the frame
    // position p onto the frame position q.
    .decl _reach(key: Key, d: D4, delta: Offset, p: Position, q: Position) inline
    _reach(Key, D, Delta, P, Q) :-
        _image_class(Key, D, Delta, P, Rv, Sv, Rh, Sh),
        _class(Key, Q, Rv, Sv, Rh, Sh), grid(Key, Q).

    // The frame position q holds a cell, in the lattice class
    // (rv, sv, rh, sh).
    .decl _class_cell(key: Key, rv: number, sv: number, rh: number,
                      sh: number, q: Position)
    _class_cell(Key, Rv, Sv, Rh, Sh, Q) :-
        cell(Key, Q, _), grid(Key, Q), _class(Key, Q, Rv, Sv, Rh, Sh).

    // A cell of the lattice class (rv, sv, rh, sh) holds v.
    .decl _class_val(key: Key, rv: number, sv: number, rh: number,
                     sh: number, v: Val)
    _class_val(Key, Rv, Sv, Rh, Sh, V) :-
        _class_cell(Key, Rv, Sv, Rh, Sh, Q), cell(Key, Q, V).

    // The lattice class (rv, sv, rh, sh) holds cells at n frame positions.
    .decl _class_n(key: Key, rv: number, sv: number, rh: number, sh: number,
                   n: number)
    _class_n(Key, Rv, Sv, Rh, Sh, N) :-
        _class_cell(Key, Rv, Sv, Rh, Sh, _),
        N = count : { _class_cell(Key, Rv, Sv, Rh, Sh, _) }.

    // The candidate (d, delta) takes some cell onto a cell of another value.
    .decl _mismatch(key: Key, d: D4, delta: Offset)
    _mismatch(Key, D, Delta) :-
        cell(Key, P, V1), _image_class(Key, D, Delta, P, Rv, Sv, Rh, Sh),
        _class_val(Key, Rv, Sv, Rh, Sh, V2), V1 != V2.

    // The candidate (d, delta) takes some cell onto a different cell: the
    // class of the cell's image holds cells at two positions or more, or
    // at one that is not the cell's.
    .decl _witnessed(key: Key, d: D4, delta: Offset)
    _witnessed(Key, D, Delta) :-
        cell(Key, P, _), _image_class(Key, D, Delta, P, Rv, Sv, Rh, Sh),
        _class_n(Key, Rv, Sv, Rh, Sh, N),
        ( N > 1
        ; N = 1, _class_cell(Key, Rv, Sv, Rh, Sh, Q), P != Q
        ).

    // Transform d followed by the coset of shift delta is a symmetry of the
    // pattern.
    .decl _symmetry(key: Key, d: D4, delta: Offset)
    _symmetry(Key, D, Delta) :-
        _witnessed(Key, D, Delta), !_mismatch(Key, D, Delta).

    /// A symmetry, or a translation of the lattice, takes the frame position
    /// p onto the frame position q.
    .decl action(key: Key, p: Position, q: Position)
    action(Key, P, Q) :-
        _symmetry(Key, D, Delta), _reach(Key, D, Delta, P, Q).
    action(Key, P, Q) :-
        grid(Key, P), _class(Key, P, Rv, Sv, Rh, Sh),
        _class(Key, Q, Rv, Sv, Rh, Sh), grid(Key, Q), P != Q.
}

/// Occurrences of one valued cell set, the shape, among another: a placement
/// occurs where every shape member lands on a cell carrying that member's
/// value. A placement that runs off the grid contradicts itself, so the
/// caller supplies no grid bounds.
.comp Occurrences<Key, Val> {
    .decl cell(key: Key, p: Position, v: Val)  // @input
    .decl shape(key: Key, p: Position, v: Val)  // @input

    /// Candidate placements: each shape cell aligned to every cell of the
    /// same value, union over the shape cells. Every occurrence is among
    /// them.
    .decl placement(key: Key, p: Position)
    placement(Ky, M) :- shape(Ky, S, V), cell(Ky, P, V), relative(S, P, M).

    /// A contradicted placement: some member lands on a cell of another
    /// value, or off the grid, where no cell carries its value.
    .decl mismatch(key: Key, p: Position)
    mismatch(Ky, M) :-
        placement(Ky, M),                   // a candidate placement
        shape(Ky, S, V), compose(M, S, P),  // where a member lands
        !cell(Ky, P, V).                    // off that member's value

    /// The placements no member contradicts.
    .decl occurrence(key: Key, p: Position)
    occurrence(Ky, M) :- placement(Ky, M), !mismatch(Ky, M).
}
