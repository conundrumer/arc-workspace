//! The orientation values and the relations over them. A relation belongs
//! here when its signature holds only Dir, Axis, DiagDir, DiagAxis, D4, Sym,
//! and Sense. A relation that also holds a Box is in box.dl.

#define DIR_T 10
#define DIR_B 11
#define DIR_L 12
#define DIR_R 13

#define AXIS_V 20
#define AXIS_H 21

#define DIAG_TL 30
#define DIAG_TR 31
#define DIAG_BL 32
#define DIAG_BR 33

#define DAXIS_DG 40
#define DAXIS_AD 41

/// The eight symmetries of a square: the identity, three rotations — a
/// quarter turn clockwise, a half turn, a quarter turn counterclockwise — and
/// four reflections. A reflection across an axis is named by the two edges it
/// swaps, so D4_LR reflects across the vertical axis. A reflection across a
/// diagonal is named by that diagonal.
#define D4_ID 50
#define D4_CW 51
#define D4_HT 52
#define D4_CC 53
#define D4_LR 54
#define D4_TB 55
#define D4_DG 56
#define D4_AD 57

#define SENSE_CW 60
#define SENSE_CC 61

/// The subgroups of D4 — a symmetry group as a closed value. SYM_1 is the
/// identity alone and SYM_D4 the whole group. An order-2 group is named by
/// its non-identity element. SYM_BOX is the axis-aligned Klein group, SYM_X
/// the diagonal one, and SYM_C4 the rotations.
#define SYM_1   70
#define SYM_LR  71
#define SYM_TB  72
#define SYM_HT  73
#define SYM_DG  74
#define SYM_AD  75
#define SYM_BOX 76
#define SYM_X   77
#define SYM_C4  78
#define SYM_D4  79

.decl dir_elem(d: Dir)
dir_elem(DIR_T).
dir_elem(DIR_B).
dir_elem(DIR_L).
dir_elem(DIR_R).

.decl axis_elem(a: Axis)
axis_elem(AXIS_V).
axis_elem(AXIS_H).

.decl diag_dir_elem(d: DiagDir)
diag_dir_elem(DIAG_TL).
diag_dir_elem(DIAG_TR).
diag_dir_elem(DIAG_BL).
diag_dir_elem(DIAG_BR).

.decl diag_axis_elem(da: DiagAxis)
diag_axis_elem(DAXIS_DG).
diag_axis_elem(DAXIS_AD).

.decl dir8_elem(d: Dir8)
dir8_elem(D) :- dir_elem(D).
dir8_elem(D) :- diag_dir_elem(D).

.decl axis4_elem(a: Axis4)
axis4_elem(A) :- axis_elem(A).
axis4_elem(A) :- diag_axis_elem(A).

.decl d4_elem(d: D4)
d4_elem(D4_ID).
d4_elem(D4_CW).
d4_elem(D4_HT).
d4_elem(D4_CC).
d4_elem(D4_LR).
d4_elem(D4_TB).
d4_elem(D4_DG).
d4_elem(D4_AD).

.decl c4_elem(d: C4)
c4_elem(D4_ID).
c4_elem(D4_CW).
c4_elem(D4_HT).
c4_elem(D4_CC).

.decl sense_elem(s: Sense)
sense_elem(SENSE_CW).
sense_elem(SENSE_CC).

.decl sym_elem(s: Sym)
sym_elem(SYM_1).
sym_elem(SYM_LR).
sym_elem(SYM_TB).
sym_elem(SYM_HT).
sym_elem(SYM_DG).
sym_elem(SYM_AD).
sym_elem(SYM_BOX).
sym_elem(SYM_X).
sym_elem(SYM_C4).
sym_elem(SYM_D4).

.decl sym_member(s: Sym, d: D4)
sym_member(SYM_1, D4_ID).
sym_member(SYM_LR, D4_ID). sym_member(SYM_LR, D4_LR).
sym_member(SYM_TB, D4_ID). sym_member(SYM_TB, D4_TB).
sym_member(SYM_HT, D4_ID). sym_member(SYM_HT, D4_HT).
sym_member(SYM_DG, D4_ID). sym_member(SYM_DG, D4_DG).
sym_member(SYM_AD, D4_ID). sym_member(SYM_AD, D4_AD).
sym_member(SYM_BOX, D4_ID). sym_member(SYM_BOX, D4_LR).
sym_member(SYM_BOX, D4_TB). sym_member(SYM_BOX, D4_HT).
sym_member(SYM_X, D4_ID). sym_member(SYM_X, D4_DG).
sym_member(SYM_X, D4_AD). sym_member(SYM_X, D4_HT).
sym_member(SYM_C4, D) :- c4_elem(D).
sym_member(SYM_D4, D) :- d4_elem(D).

.decl axis_of(d: Dir, a: Axis)
axis_of(DIR_T, AXIS_V).
axis_of(DIR_B, AXIS_V).
axis_of(DIR_L, AXIS_H).
axis_of(DIR_R, AXIS_H).

.decl diag_axis_of(d: DiagDir, da: DiagAxis)
diag_axis_of(DIAG_TL, DAXIS_DG).
diag_axis_of(DIAG_BR, DAXIS_DG).
diag_axis_of(DIAG_TR, DAXIS_AD).
diag_axis_of(DIAG_BL, DAXIS_AD).

.decl axis4_of(d: Dir8, a: Axis4)
axis4_of(D, A) :- axis_of(D, A).
axis4_of(D, A) :- diag_axis_of(D, A).

/// The cardinal direction of corner d on axis a.
.decl dir_of(d: DiagDir, a: Axis, dir: Dir)
dir_of(DIAG_TL, AXIS_V, DIR_T).
dir_of(DIAG_TL, AXIS_H, DIR_L).
dir_of(DIAG_TR, AXIS_V, DIR_T).
dir_of(DIAG_TR, AXIS_H, DIR_R).
dir_of(DIAG_BL, AXIS_V, DIR_B).
dir_of(DIAG_BL, AXIS_H, DIR_L).
dir_of(DIAG_BR, AXIS_V, DIR_B).
dir_of(DIAG_BR, AXIS_H, DIR_R).

/// The two cardinal directions of corner d: d1 on axis a, d2 on the other
/// axis.
.decl diag_dirs(d: DiagDir, a: Axis, d1: Dir, d2: Dir)
diag_dirs(Diag, A, D1, D2) :- dir_of(Diag, A, D1), perp(A, A2), dir_of(Diag, A2, D2).

.decl opposite(d: Dir, opp: Dir)
opposite(DIR_T, DIR_B).
opposite(DIR_B, DIR_T).
opposite(DIR_L, DIR_R).
opposite(DIR_R, DIR_L).

.decl diag_opposite(d: DiagDir, opp: DiagDir)
diag_opposite(DIAG_TL, DIAG_BR).
diag_opposite(DIAG_BR, DIAG_TL).
diag_opposite(DIAG_TR, DIAG_BL).
diag_opposite(DIAG_BL, DIAG_TR).

.decl dir8_opposite(d: Dir8, d2: Dir8)
dir8_opposite(D, D2) :- opposite(D, D2).
dir8_opposite(D, D2) :- diag_opposite(D, D2).

.decl perp(a: Axis, a2: Axis)
perp(AXIS_V, AXIS_H).
perp(AXIS_H, AXIS_V).

.decl diag_perp(da: DiagAxis, da2: DiagAxis)
diag_perp(DAXIS_DG, DAXIS_AD).
diag_perp(DAXIS_AD, DAXIS_DG).

/// The two cardinal directions on the other axis from d.
.decl perp_dir(d: Dir, d2: Dir)
perp_dir(D, D2) :- axis_of(D, A), perp(A, A2), axis_of(D2, A2).

/// The D4 reflection that inverts axis a: it swaps the two cardinal
/// directions on that axis and keeps the other two.
.decl flip_of(a: Axis, d: D4)
flip_of(AXIS_V, D4_TB).
flip_of(AXIS_H, D4_LR).

/// The D4 reflection across diagonal axis da.
.decl diag_flip_of(da: DiagAxis, d: D4)
diag_flip_of(DAXIS_DG, D4_DG).
diag_flip_of(DAXIS_AD, D4_AD).

/// The cardinal direction a quarter turn in sense s reaches from d.
.decl turn(s: Sense, d: Dir, d_out: Dir)
turn(SENSE_CW, DIR_T, DIR_R).
turn(SENSE_CW, DIR_R, DIR_B).
turn(SENSE_CW, DIR_B, DIR_L).
turn(SENSE_CW, DIR_L, DIR_T).
turn(SENSE_CC, D2, D) :- turn(SENSE_CW, D, D2).

/// The C4 element of a quarter turn in sense s.
.decl rotation(s: Sense, d: C4)
rotation(SENSE_CW, D4_CW).
rotation(SENSE_CC, D4_CC).

.decl d4_inverse(d: D4, d_inv: D4)
d4_inverse(D4_ID, D4_ID).
d4_inverse(D4_CW, D4_CC).
d4_inverse(D4_HT, D4_HT).
d4_inverse(D4_CC, D4_CW).
d4_inverse(D4_LR, D4_LR).
d4_inverse(D4_TB, D4_TB).
d4_inverse(D4_DG, D4_DG).
d4_inverse(D4_AD, D4_AD).

/// c is a after b: apply(c, p) is apply(a, apply(b, p)), so a takes the
/// image under b onto the image under c.
.decl d4_compose(a: D4, b: D4, c: D4)
d4_compose(D4_ID, D4_ID, D4_ID).
d4_compose(D4_ID, D4_CW, D4_CW).
d4_compose(D4_ID, D4_HT, D4_HT).
d4_compose(D4_ID, D4_CC, D4_CC).
d4_compose(D4_ID, D4_LR, D4_LR).
d4_compose(D4_ID, D4_TB, D4_TB).
d4_compose(D4_ID, D4_DG, D4_DG).
d4_compose(D4_ID, D4_AD, D4_AD).
d4_compose(D4_CW, D4_ID, D4_CW).
d4_compose(D4_CW, D4_CW, D4_HT).
d4_compose(D4_CW, D4_HT, D4_CC).
d4_compose(D4_CW, D4_CC, D4_ID).
d4_compose(D4_CW, D4_LR, D4_AD).
d4_compose(D4_CW, D4_TB, D4_DG).
d4_compose(D4_CW, D4_DG, D4_LR).
d4_compose(D4_CW, D4_AD, D4_TB).
d4_compose(D4_HT, D4_ID, D4_HT).
d4_compose(D4_HT, D4_CW, D4_CC).
d4_compose(D4_HT, D4_HT, D4_ID).
d4_compose(D4_HT, D4_CC, D4_CW).
d4_compose(D4_HT, D4_LR, D4_TB).
d4_compose(D4_HT, D4_TB, D4_LR).
d4_compose(D4_HT, D4_DG, D4_AD).
d4_compose(D4_HT, D4_AD, D4_DG).
d4_compose(D4_CC, D4_ID, D4_CC).
d4_compose(D4_CC, D4_CW, D4_ID).
d4_compose(D4_CC, D4_HT, D4_CW).
d4_compose(D4_CC, D4_CC, D4_HT).
d4_compose(D4_CC, D4_LR, D4_DG).
d4_compose(D4_CC, D4_TB, D4_AD).
d4_compose(D4_CC, D4_DG, D4_TB).
d4_compose(D4_CC, D4_AD, D4_LR).
d4_compose(D4_LR, D4_ID, D4_LR).
d4_compose(D4_LR, D4_CW, D4_DG).
d4_compose(D4_LR, D4_HT, D4_TB).
d4_compose(D4_LR, D4_CC, D4_AD).
d4_compose(D4_LR, D4_LR, D4_ID).
d4_compose(D4_LR, D4_TB, D4_HT).
d4_compose(D4_LR, D4_DG, D4_CW).
d4_compose(D4_LR, D4_AD, D4_CC).
d4_compose(D4_TB, D4_ID, D4_TB).
d4_compose(D4_TB, D4_CW, D4_AD).
d4_compose(D4_TB, D4_HT, D4_LR).
d4_compose(D4_TB, D4_CC, D4_DG).
d4_compose(D4_TB, D4_LR, D4_HT).
d4_compose(D4_TB, D4_TB, D4_ID).
d4_compose(D4_TB, D4_DG, D4_CC).
d4_compose(D4_TB, D4_AD, D4_CW).
d4_compose(D4_DG, D4_ID, D4_DG).
d4_compose(D4_DG, D4_CW, D4_TB).
d4_compose(D4_DG, D4_HT, D4_AD).
d4_compose(D4_DG, D4_CC, D4_LR).
d4_compose(D4_DG, D4_LR, D4_CC).
d4_compose(D4_DG, D4_TB, D4_CW).
d4_compose(D4_DG, D4_DG, D4_ID).
d4_compose(D4_DG, D4_AD, D4_HT).
d4_compose(D4_AD, D4_ID, D4_AD).
d4_compose(D4_AD, D4_CW, D4_LR).
d4_compose(D4_AD, D4_HT, D4_DG).
d4_compose(D4_AD, D4_CC, D4_TB).
d4_compose(D4_AD, D4_LR, D4_CW).
d4_compose(D4_AD, D4_TB, D4_CC).
d4_compose(D4_AD, D4_DG, D4_HT).
d4_compose(D4_AD, D4_AD, D4_ID).
